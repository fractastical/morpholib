sub1:assertion {
    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury> a mlg:NeuromuscularTwitchEstimate,
            pk:Claim ;
        rdfs:label "Muscle-twitch estimate (3-galvani-aldini-metal-free-injury): 3.4 uA (42.0 mV, 1 Hz, cathodal_descending) in Pelophylax esculentus (= Rana esculenta) -> 33.5% Make twitch, 0.0% Break twitch, 0.40 N force, 21.8 deg kick angle" ;
        dcterms:description "Quantitative neuromuscular excitation & muscle-twitch estimate for Pelophylax esculentus (= Rana esculenta) (Galvani (3rd Expt) & Aldini (Fig. 3), 1794; apparatus: Sciatic nerve bridging injured/cut and intact gastrocnemius surface (zero metals)). Applied stimulus current I = 3.40 uA (driving EMF = 42.0 mV, contact duration d = 2.50 ms, frequency f = 1.0 Hz, polarity = cathodal_descending) produces 33.5% circuit-closing ('Make') contraction and 0.0% circuit-opening ('Break') contraction, yielding peak isometric force F = 0.40 N and limb deflection angle theta = 21.8 deg (Pfluger Stage I Weak Current (Cathodal Make Only))." ;
        mlg:apparatus "Sciatic nerve bridging injured/cut and intact gastrocnemius surface (zero metals)" ;
        mlg:electrodePolarity "cathodal_descending" ;
        mlg:experimentYear 1794 ;
        mlg:hasQuantitativeEstimate <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury/break_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury/driving_voltage_mV>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury/limb_kick_angle_deg>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury/make_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury/peak_twitch_force_N>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury/pulse_duration_ms>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury/stimulus_current_uA>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury/stimulus_frequency_Hz> ;
        mlg:investigator "Galvani (3rd Expt) & Aldini (Fig. 3)" ;
        mlg:organism "Pelophylax esculentus (= Rana esculenta)" ;
        mlg:pflugerRegime "Pfluger Stage I Weak Current (Cathodal Make Only)" .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury/break_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-opening ('Break') contraction amplitude" ;
        schema:propertyID "break_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "0.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury/driving_voltage_mV> a schema:PropertyValue ;
        rdfs:label "Driving electromotive force (EMF)" ;
        schema:propertyID "driving_voltage_mV" ;
        schema:unitText "mV" ;
        schema:value "42.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury/limb_kick_angle_deg> a schema:PropertyValue ;
        rdfs:label "Peak kinematic limb deflection / kick angle" ;
        schema:propertyID "limb_kick_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "21.8"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury/make_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-closing ('Make') contraction amplitude" ;
        schema:propertyID "make_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "33.5"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury/peak_twitch_force_N> a schema:PropertyValue ;
        rdfs:label "Peak isometric muscle contraction force" ;
        schema:propertyID "peak_twitch_force_N" ;
        schema:unitText "N" ;
        schema:value "0.4"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury/pulse_duration_ms> a schema:PropertyValue ;
        rdfs:label "Stimulus contact duration" ;
        schema:propertyID "pulse_duration_ms" ;
        schema:unitText "ms" ;
        schema:value "2.5"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury/stimulus_current_uA> a schema:PropertyValue ;
        rdfs:label "Stimulus current through nerve/tissue" ;
        schema:propertyID "stimulus_current_uA" ;
        schema:unitText "uA" ;
        schema:value "3.4"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-3-galvani-aldini-metal-free-injury/stimulus_frequency_Hz> a schema:PropertyValue ;
        rdfs:label "Stimulus pulse train frequency" ;
        schema:propertyID "stimulus_frequency_Hz" ;
        schema:unitText "Hz" ;
        schema:value "1.0"^^xsd:double .
}


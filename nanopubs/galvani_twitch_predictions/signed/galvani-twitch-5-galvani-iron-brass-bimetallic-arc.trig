sub1:assertion {
    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc> a mlg:NeuromuscularTwitchEstimate,
            pk:Claim ;
        rdfs:label "Muscle-twitch estimate (5-galvani-iron-brass-bimetallic-arc): 62.4 uA (780.0 mV, 1 Hz, cathodal_descending) in Pelophylax esculentus (= Rana esculenta) -> 100.0% Make twitch, 98.4% Break twitch, 1.20 N force, 65.0 deg kick angle" ;
        dcterms:description "Quantitative neuromuscular excitation & muscle-twitch estimate for Pelophylax esculentus (= Rana esculenta) (Galvani (Tab. III Figs. 9-16 Fe/Cu Arc), 1786; apparatus: Brass spinal hook + Iron railing/plate (Fe/Cu bimetallic arc, 35x threshold)). Applied stimulus current I = 62.40 uA (driving EMF = 780.0 mV, contact duration d = 2.00 ms, frequency f = 1.0 Hz, polarity = cathodal_descending) produces 100.0% circuit-closing ('Make') contraction and 98.4% circuit-opening ('Break') contraction, yielding peak isometric force F = 1.20 N and limb deflection angle theta = 65.0 deg (Pfluger Stage II Medium Current (Make AND Break Twitches!))." ;
        mlg:apparatus "Brass spinal hook + Iron railing/plate (Fe/Cu bimetallic arc, 35x threshold)" ;
        mlg:electrodePolarity "cathodal_descending" ;
        mlg:experimentYear 1786 ;
        mlg:hasQuantitativeEstimate <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc/break_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc/driving_voltage_mV>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc/limb_kick_angle_deg>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc/make_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc/peak_twitch_force_N>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc/pulse_duration_ms>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc/stimulus_current_uA>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc/stimulus_frequency_Hz> ;
        mlg:investigator "Galvani (Tab. III Figs. 9-16 Fe/Cu Arc)" ;
        mlg:organism "Pelophylax esculentus (= Rana esculenta)" ;
        mlg:pflugerRegime "Pfluger Stage II Medium Current (Make AND Break Twitches!)" .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc/break_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-opening ('Break') contraction amplitude" ;
        schema:propertyID "break_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "98.4"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc/driving_voltage_mV> a schema:PropertyValue ;
        rdfs:label "Driving electromotive force (EMF)" ;
        schema:propertyID "driving_voltage_mV" ;
        schema:unitText "mV" ;
        schema:value "780.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc/limb_kick_angle_deg> a schema:PropertyValue ;
        rdfs:label "Peak kinematic limb deflection / kick angle" ;
        schema:propertyID "limb_kick_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "65.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc/make_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-closing ('Make') contraction amplitude" ;
        schema:propertyID "make_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "100.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc/peak_twitch_force_N> a schema:PropertyValue ;
        rdfs:label "Peak isometric muscle contraction force" ;
        schema:propertyID "peak_twitch_force_N" ;
        schema:unitText "N" ;
        schema:value "1.2"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc/pulse_duration_ms> a schema:PropertyValue ;
        rdfs:label "Stimulus contact duration" ;
        schema:propertyID "pulse_duration_ms" ;
        schema:unitText "ms" ;
        schema:value "2.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc/stimulus_current_uA> a schema:PropertyValue ;
        rdfs:label "Stimulus current through nerve/tissue" ;
        schema:propertyID "stimulus_current_uA" ;
        schema:unitText "uA" ;
        schema:value "62.4"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-5-galvani-iron-brass-bimetallic-arc/stimulus_frequency_Hz> a schema:PropertyValue ;
        rdfs:label "Stimulus pulse train frequency" ;
        schema:propertyID "stimulus_frequency_Hz" ;
        schema:unitText "Hz" ;
        schema:value "1.0"^^xsd:double .
}


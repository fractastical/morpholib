sub1:assertion {
    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending> a mlg:NeuromuscularTwitchEstimate,
            pk:Claim ;
        rdfs:label "Muscle-twitch estimate (7-nobili-pfluger-high-dc-ascending): 650.0 uA (13200.0 mV, 1 Hz, anodal_ascending) in Pelophylax esculentus (= Rana esculenta) -> 0.0% Make twitch, 100.0% Break twitch, 1.20 N force, 65.0 deg kick angle" ;
        dcterms:description "Quantitative neuromuscular excitation & muscle-twitch estimate for Pelophylax esculentus (= Rana esculenta) (Nobili (1830) & Pfluger (1859) Strong Ascending DC, 1859; apparatus: 12-cell Voltaic pile (13.2 V, R_tot = 20.3 kOhm) ascending (Anode near muscle)). Applied stimulus current I = 650.00 uA (driving EMF = 13200.0 mV, contact duration d = 2.00 ms, frequency f = 1.0 Hz, polarity = anodal_ascending) produces 0.0% circuit-closing ('Make') contraction and 100.0% circuit-opening ('Break') contraction, yielding peak isometric force F = 1.20 N and limb deflection angle theta = 65.0 deg (Pfluger Stage III Anodal Block! (0% Make -> 100% Violent Break))." ;
        mlg:apparatus "12-cell Voltaic pile (13.2 V, R_tot = 20.3 kOhm) ascending (Anode near muscle)" ;
        mlg:electrodePolarity "anodal_ascending" ;
        mlg:experimentYear 1859 ;
        mlg:hasQuantitativeEstimate <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending/break_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending/driving_voltage_mV>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending/limb_kick_angle_deg>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending/make_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending/peak_twitch_force_N>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending/pulse_duration_ms>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending/stimulus_current_uA>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending/stimulus_frequency_Hz> ;
        mlg:investigator "Nobili (1830) & Pfluger (1859) Strong Ascending DC" ;
        mlg:organism "Pelophylax esculentus (= Rana esculenta)" ;
        mlg:pflugerRegime "Pfluger Stage III Anodal Block! (0% Make -> 100% Violent Break)" .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending/break_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-opening ('Break') contraction amplitude" ;
        schema:propertyID "break_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "100.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending/driving_voltage_mV> a schema:PropertyValue ;
        rdfs:label "Driving electromotive force (EMF)" ;
        schema:propertyID "driving_voltage_mV" ;
        schema:unitText "mV" ;
        schema:value "13200.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending/limb_kick_angle_deg> a schema:PropertyValue ;
        rdfs:label "Peak kinematic limb deflection / kick angle" ;
        schema:propertyID "limb_kick_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "65.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending/make_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-closing ('Make') contraction amplitude" ;
        schema:propertyID "make_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "0.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending/peak_twitch_force_N> a schema:PropertyValue ;
        rdfs:label "Peak isometric muscle contraction force" ;
        schema:propertyID "peak_twitch_force_N" ;
        schema:unitText "N" ;
        schema:value "1.2"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending/pulse_duration_ms> a schema:PropertyValue ;
        rdfs:label "Stimulus contact duration" ;
        schema:propertyID "pulse_duration_ms" ;
        schema:unitText "ms" ;
        schema:value "2.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending/stimulus_current_uA> a schema:PropertyValue ;
        rdfs:label "Stimulus current through nerve/tissue" ;
        schema:propertyID "stimulus_current_uA" ;
        schema:unitText "uA" ;
        schema:value "650.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-7-nobili-pfluger-high-dc-ascending/stimulus_frequency_Hz> a schema:PropertyValue ;
        rdfs:label "Stimulus pulse train frequency" ;
        schema:propertyID "stimulus_frequency_Hz" ;
        schema:unitText "Hz" ;
        schema:value "1.0"^^xsd:double .
}


sub1:assertion {
    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train> a mlg:NeuromuscularTwitchEstimate,
            pk:Claim ;
        rdfs:label "Muscle-twitch estimate (8-ure-helmholtz-tetanic-train): 2200.0 uA (45000.0 mV, 40 Hz, cathodal_descending) in Pelophylax esculentus (= Rana esculenta) -> 375.0% Make twitch, 100.0% Break twitch, 4.50 N force, 88.0 deg kick angle" ;
        dcterms:description "Quantitative neuromuscular excitation & muscle-twitch estimate for Pelophylax esculentus (= Rana esculenta) (Ure (1818) / Du Bois-Reymond & Helmholtz (1850) 40 Hz Tetanus, 1850; apparatus: Voltaic trough / Du Bois-Reymond inductorium (40 Hz repetitive train, 25 ms spacing)). Applied stimulus current I = 2200.00 uA (driving EMF = 45000.0 mV, contact duration d = 2.00 ms, frequency f = 40.0 Hz, polarity = cathodal_descending) produces 375.0% circuit-closing ('Make') contraction and 100.0% circuit-opening ('Break') contraction, yielding peak isometric force F = 4.50 N and limb deflection angle theta = 88.0 deg (Fused Tetanic Contraction (3.75x Single-Twitch Force = 4.50 N!))." ;
        mlg:apparatus "Voltaic trough / Du Bois-Reymond inductorium (40 Hz repetitive train, 25 ms spacing)" ;
        mlg:electrodePolarity "cathodal_descending" ;
        mlg:experimentYear 1850 ;
        mlg:hasQuantitativeEstimate <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train/break_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train/driving_voltage_mV>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train/limb_kick_angle_deg>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train/make_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train/peak_twitch_force_N>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train/pulse_duration_ms>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train/stimulus_current_uA>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train/stimulus_frequency_Hz> ;
        mlg:investigator "Ure (1818) / Du Bois-Reymond & Helmholtz (1850) 40 Hz Tetanus" ;
        mlg:organism "Pelophylax esculentus (= Rana esculenta)" ;
        mlg:pflugerRegime "Fused Tetanic Contraction (3.75x Single-Twitch Force = 4.50 N!)" .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train/break_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-opening ('Break') contraction amplitude" ;
        schema:propertyID "break_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "100.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train/driving_voltage_mV> a schema:PropertyValue ;
        rdfs:label "Driving electromotive force (EMF)" ;
        schema:propertyID "driving_voltage_mV" ;
        schema:unitText "mV" ;
        schema:value "45000.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train/limb_kick_angle_deg> a schema:PropertyValue ;
        rdfs:label "Peak kinematic limb deflection / kick angle" ;
        schema:propertyID "limb_kick_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "88.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train/make_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-closing ('Make') contraction amplitude" ;
        schema:propertyID "make_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "375.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train/peak_twitch_force_N> a schema:PropertyValue ;
        rdfs:label "Peak isometric muscle contraction force" ;
        schema:propertyID "peak_twitch_force_N" ;
        schema:unitText "N" ;
        schema:value "4.5"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train/pulse_duration_ms> a schema:PropertyValue ;
        rdfs:label "Stimulus contact duration" ;
        schema:propertyID "pulse_duration_ms" ;
        schema:unitText "ms" ;
        schema:value "2.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train/stimulus_current_uA> a schema:PropertyValue ;
        rdfs:label "Stimulus current through nerve/tissue" ;
        schema:propertyID "stimulus_current_uA" ;
        schema:unitText "uA" ;
        schema:value "2200.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-8-ure-helmholtz-tetanic-train/stimulus_frequency_Hz> a schema:PropertyValue ;
        rdfs:label "Stimulus pulse train frequency" ;
        schema:propertyID "stimulus_frequency_Hz" ;
        schema:unitText "Hz" ;
        schema:value "40.0"^^xsd:double .
}


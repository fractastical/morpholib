sub1:assertion {
    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi> a mlg:NeuromuscularTwitchEstimate,
            pk:Claim ;
        rdfs:label "Muscle-twitch estimate (user-estimate-st36-2ma-deqi): 2000.0 uA (4000.0 mV, 2 Hz, cathodal_descending) in Homo sapiens (tibialis anterior at ST36 Zusanli) -> 12.5% Make twitch, 0.0% Break twitch, 3.40 N force, 6.5 deg kick angle" ;
        dcterms:description "Quantitative neuromuscular excitation & muscle-twitch estimate for Homo sapiens (tibialis anterior at ST36 Zusanli) (Joel Dietz (Galvani Interactive Lab), 2026; apparatus: 0.30 mm x 25 mm stainless-steel acupuncture needle (HANS-200A, 2 Hz)). Applied stimulus current I = 2000.00 uA (driving EMF = 4000.0 mV, contact duration d = 0.20 ms, frequency f = 2.0 Hz, polarity = cathodal_descending) produces 12.5% circuit-closing ('Make') contraction and 0.0% circuit-opening ('Break') contraction, yielding peak isometric force F = 3.40 N and limb deflection angle theta = 6.5 deg (User-entered De Qi rhythmic ankle dorsiflexion twitch at 2.0 mA)." ;
        mlg:apparatus "0.30 mm x 25 mm stainless-steel acupuncture needle (HANS-200A, 2 Hz)" ;
        mlg:electrodePolarity "cathodal_descending" ;
        mlg:experimentYear 2026 ;
        mlg:hasQuantitativeEstimate <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi/break_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi/driving_voltage_mV>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi/limb_kick_angle_deg>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi/make_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi/peak_twitch_force_N>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi/pulse_duration_ms>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi/stimulus_current_uA>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi/stimulus_frequency_Hz> ;
        mlg:investigator "Joel Dietz (Galvani Interactive Lab)" ;
        mlg:organism "Homo sapiens (tibialis anterior at ST36 Zusanli)" ;
        mlg:pflugerRegime "User-entered De Qi rhythmic ankle dorsiflexion twitch at 2.0 mA" .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi/break_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-opening ('Break') contraction amplitude" ;
        schema:propertyID "break_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "0.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi/driving_voltage_mV> a schema:PropertyValue ;
        rdfs:label "Driving electromotive force (EMF)" ;
        schema:propertyID "driving_voltage_mV" ;
        schema:unitText "mV" ;
        schema:value "4000.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi/limb_kick_angle_deg> a schema:PropertyValue ;
        rdfs:label "Peak kinematic limb deflection / kick angle" ;
        schema:propertyID "limb_kick_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "6.5"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi/make_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-closing ('Make') contraction amplitude" ;
        schema:propertyID "make_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "12.5"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi/peak_twitch_force_N> a schema:PropertyValue ;
        rdfs:label "Peak isometric muscle contraction force" ;
        schema:propertyID "peak_twitch_force_N" ;
        schema:unitText "N" ;
        schema:value "3.4"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi/pulse_duration_ms> a schema:PropertyValue ;
        rdfs:label "Stimulus contact duration" ;
        schema:propertyID "pulse_duration_ms" ;
        schema:unitText "ms" ;
        schema:value "0.2"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi/stimulus_current_uA> a schema:PropertyValue ;
        rdfs:label "Stimulus current through nerve/tissue" ;
        schema:propertyID "stimulus_current_uA" ;
        schema:unitText "uA" ;
        schema:value "2000.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-user-estimate-st36-2ma-deqi/stimulus_frequency_Hz> a schema:PropertyValue ;
        rdfs:label "Stimulus pulse train frequency" ;
        schema:propertyID "stimulus_frequency_Hz" ;
        schema:unitText "Hz" ;
        schema:value "2.0"^^xsd:double .
}


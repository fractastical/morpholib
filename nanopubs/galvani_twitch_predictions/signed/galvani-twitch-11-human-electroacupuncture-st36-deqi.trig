sub1:assertion {
    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi> a mlg:NeuromuscularTwitchEstimate,
            pk:Claim ;
        rdfs:label "Muscle-twitch estimate (11-human-electroacupuncture-st36-deqi): 1950.0 uA (3800.0 mV, 2 Hz, cathodal_descending) in Homo sapiens (tibialis anterior / mylohyoid / FDI at ST36, LI4, CV23) -> 12.0% Make twitch, 0.0% Break twitch, 3.20 N force, 6.0 deg kick angle" ;
        dcterms:description "Quantitative neuromuscular excitation & muscle-twitch estimate for Homo sapiens (tibialis anterior / mylohyoid / FDI at ST36, LI4, CV23) (Peng et al. (2022) & Lu et al. (2019) Human Electroacupuncture, 2022; apparatus: 0.30 mm x 25 mm stainless-steel acupuncture needles (HANS-200A, 2 Hz motor threshold)). Applied stimulus current I = 1950.00 uA (driving EMF = 3800.0 mV, contact duration d = 0.20 ms, frequency f = 2.0 Hz, polarity = cathodal_descending) produces 12.0% circuit-closing ('Make') contraction and 0.0% circuit-opening ('Break') contraction, yielding peak isometric force F = 3.20 N and limb deflection angle theta = 6.0 deg (Human Percutaneous De Qi Visible Rhythmic Motor Twitch (0.9-3.0 mA clinical window))." ;
        mlg:apparatus "0.30 mm x 25 mm stainless-steel acupuncture needles (HANS-200A, 2 Hz motor threshold)" ;
        mlg:electrodePolarity "cathodal_descending" ;
        mlg:experimentYear 2022 ;
        mlg:hasQuantitativeEstimate <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi/break_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi/driving_voltage_mV>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi/limb_kick_angle_deg>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi/make_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi/peak_twitch_force_N>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi/pulse_duration_ms>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi/stimulus_current_uA>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi/stimulus_frequency_Hz> ;
        mlg:investigator "Peng et al. (2022) & Lu et al. (2019) Human Electroacupuncture" ;
        mlg:organism "Homo sapiens (tibialis anterior / mylohyoid / FDI at ST36, LI4, CV23)" ;
        mlg:pflugerRegime "Human Percutaneous De Qi Visible Rhythmic Motor Twitch (0.9-3.0 mA clinical window)" .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi/break_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-opening ('Break') contraction amplitude" ;
        schema:propertyID "break_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "0.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi/driving_voltage_mV> a schema:PropertyValue ;
        rdfs:label "Driving electromotive force (EMF)" ;
        schema:propertyID "driving_voltage_mV" ;
        schema:unitText "mV" ;
        schema:value "3800.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi/limb_kick_angle_deg> a schema:PropertyValue ;
        rdfs:label "Peak kinematic limb deflection / kick angle" ;
        schema:propertyID "limb_kick_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "6.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi/make_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-closing ('Make') contraction amplitude" ;
        schema:propertyID "make_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "12.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi/peak_twitch_force_N> a schema:PropertyValue ;
        rdfs:label "Peak isometric muscle contraction force" ;
        schema:propertyID "peak_twitch_force_N" ;
        schema:unitText "N" ;
        schema:value "3.2"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi/pulse_duration_ms> a schema:PropertyValue ;
        rdfs:label "Stimulus contact duration" ;
        schema:propertyID "pulse_duration_ms" ;
        schema:unitText "ms" ;
        schema:value "0.2"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi/stimulus_current_uA> a schema:PropertyValue ;
        rdfs:label "Stimulus current through nerve/tissue" ;
        schema:propertyID "stimulus_current_uA" ;
        schema:unitText "uA" ;
        schema:value "1950.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-11-human-electroacupuncture-st36-deqi/stimulus_frequency_Hz> a schema:PropertyValue ;
        rdfs:label "Stimulus pulse train frequency" ;
        schema:propertyID "stimulus_frequency_Hz" ;
        schema:unitText "Hz" ;
        schema:value "2.0"^^xsd:double .
}


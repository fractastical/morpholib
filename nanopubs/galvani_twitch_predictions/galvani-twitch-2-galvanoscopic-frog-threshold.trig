sub:assertion {
    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold> a mlg:NeuromuscularTwitchEstimate,
            pk:Claim ;
        rdfs:label "Muscle-twitch estimate (2-galvanoscopic-frog-threshold): 1.8 uA (22.5 mV, 1 Hz, cathodal_descending) in Pelophylax esculentus (= Rana esculenta) -> 8.8% Make twitch, 0.0% Break twitch, 0.11 N force, 5.7 deg kick angle" ;
        dcterms:description "Quantitative neuromuscular excitation & muscle-twitch estimate for Pelophylax esculentus (= Rana esculenta) (Matteucci (Fig. 8 Galvanoscopic Frog), 1838; apparatus: Frog leg in glass tube with sciatic nerve lead at liminal threshold). Applied stimulus current I = 1.80 uA (driving EMF = 22.5 mV, contact duration d = 2.50 ms, frequency f = 1.0 Hz, polarity = cathodal_descending) produces 8.8% circuit-closing ('Make') contraction and 0.0% circuit-opening ('Break') contraction, yielding peak isometric force F = 0.11 N and limb deflection angle theta = 5.7 deg (Liminal Threshold (Pfluger Stage I: Make Only))." ;
        mlg:apparatus "Frog leg in glass tube with sciatic nerve lead at liminal threshold" ;
        mlg:electrodePolarity "cathodal_descending" ;
        mlg:experimentYear 1838 ;
        mlg:hasQuantitativeEstimate <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold/break_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold/driving_voltage_mV>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold/limb_kick_angle_deg>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold/make_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold/peak_twitch_force_N>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold/pulse_duration_ms>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold/stimulus_current_uA>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold/stimulus_frequency_Hz> ;
        mlg:investigator "Matteucci (Fig. 8 Galvanoscopic Frog)" ;
        mlg:organism "Pelophylax esculentus (= Rana esculenta)" ;
        mlg:pflugerRegime "Liminal Threshold (Pfluger Stage I: Make Only)" .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold/break_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-opening ('Break') contraction amplitude" ;
        schema:propertyID "break_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "0.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold/driving_voltage_mV> a schema:PropertyValue ;
        rdfs:label "Driving electromotive force (EMF)" ;
        schema:propertyID "driving_voltage_mV" ;
        schema:unitText "mV" ;
        schema:value "22.5"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold/limb_kick_angle_deg> a schema:PropertyValue ;
        rdfs:label "Peak kinematic limb deflection / kick angle" ;
        schema:propertyID "limb_kick_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "5.7"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold/make_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-closing ('Make') contraction amplitude" ;
        schema:propertyID "make_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "8.8"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold/peak_twitch_force_N> a schema:PropertyValue ;
        rdfs:label "Peak isometric muscle contraction force" ;
        schema:propertyID "peak_twitch_force_N" ;
        schema:unitText "N" ;
        schema:value "0.11"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold/pulse_duration_ms> a schema:PropertyValue ;
        rdfs:label "Stimulus contact duration" ;
        schema:propertyID "pulse_duration_ms" ;
        schema:unitText "ms" ;
        schema:value "2.5"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold/stimulus_current_uA> a schema:PropertyValue ;
        rdfs:label "Stimulus current through nerve/tissue" ;
        schema:propertyID "stimulus_current_uA" ;
        schema:unitText "uA" ;
        schema:value "1.8"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-2-galvanoscopic-frog-threshold/stimulus_frequency_Hz> a schema:PropertyValue ;
        rdfs:label "Stimulus pulse train frequency" ;
        schema:propertyID "stimulus_frequency_Hz" ;
        schema:unitText "Hz" ;
        schema:value "1.0"^^xsd:double .
}


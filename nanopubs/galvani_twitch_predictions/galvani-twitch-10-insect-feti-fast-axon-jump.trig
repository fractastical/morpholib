sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump> a mlg:NeuromuscularTwitchEstimate,
            pk:Claim ;
        rdfs:label "Muscle-twitch estimate (10-insect-feti-fast-axon-jump): 3.8 uA (800.0 mV, 1 Hz, cathodal_descending) in Schistocerca gregaria (Desert Locust) -> 100.0% Make twitch, 0.0% Break twitch, 2.50 N force, 75.0 deg kick angle" ;
        dcterms:description "Quantitative neuromuscular excitation & muscle-twitch estimate for Schistocerca gregaria (Desert Locust) (Hoyle (1955) & Usherwood (1962) Locust Fast Extensor Tibiae, 1955; apparatus: Suprathreshold pulse recruiting Fast Extensor Tibiae (FETi) glutamatergic axon). Applied stimulus current I = 3.80 uA (driving EMF = 800.0 mV, contact duration d = 2.00 ms, frequency f = 1.0 Hz, polarity = cathodal_descending) produces 100.0% circuit-closing ('Make') contraction and 0.0% circuit-opening ('Break') contraction, yielding peak isometric force F = 2.50 N and limb deflection angle theta = 75.0 deg (All-or-None Fast Axon (FETi) Ballistic Jump Twitch (~15 N under co-contraction))." ;
        mlg:apparatus "Suprathreshold pulse recruiting Fast Extensor Tibiae (FETi) glutamatergic axon" ;
        mlg:electrodePolarity "cathodal_descending" ;
        mlg:experimentYear 1955 ;
        mlg:hasQuantitativeEstimate <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump/break_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump/driving_voltage_mV>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump/limb_kick_angle_deg>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump/make_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump/peak_twitch_force_N>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump/pulse_duration_ms>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump/stimulus_current_uA>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump/stimulus_frequency_Hz> ;
        mlg:investigator "Hoyle (1955) & Usherwood (1962) Locust Fast Extensor Tibiae" ;
        mlg:organism "Schistocerca gregaria (Desert Locust)" ;
        mlg:pflugerRegime "All-or-None Fast Axon (FETi) Ballistic Jump Twitch (~15 N under co-contraction)" .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump/break_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-opening ('Break') contraction amplitude" ;
        schema:propertyID "break_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "0.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump/driving_voltage_mV> a schema:PropertyValue ;
        rdfs:label "Driving electromotive force (EMF)" ;
        schema:propertyID "driving_voltage_mV" ;
        schema:unitText "mV" ;
        schema:value "800.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump/limb_kick_angle_deg> a schema:PropertyValue ;
        rdfs:label "Peak kinematic limb deflection / kick angle" ;
        schema:propertyID "limb_kick_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "75.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump/make_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-closing ('Make') contraction amplitude" ;
        schema:propertyID "make_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "100.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump/peak_twitch_force_N> a schema:PropertyValue ;
        rdfs:label "Peak isometric muscle contraction force" ;
        schema:propertyID "peak_twitch_force_N" ;
        schema:unitText "N" ;
        schema:value "2.5"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump/pulse_duration_ms> a schema:PropertyValue ;
        rdfs:label "Stimulus contact duration" ;
        schema:propertyID "pulse_duration_ms" ;
        schema:unitText "ms" ;
        schema:value "2.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump/stimulus_current_uA> a schema:PropertyValue ;
        rdfs:label "Stimulus current through nerve/tissue" ;
        schema:propertyID "stimulus_current_uA" ;
        schema:unitText "uA" ;
        schema:value "3.8"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-10-insect-feti-fast-axon-jump/stimulus_frequency_Hz> a schema:PropertyValue ;
        rdfs:label "Stimulus pulse train frequency" ;
        schema:propertyID "stimulus_frequency_Hz" ;
        schema:unitText "Hz" ;
        schema:value "1.0"^^xsd:double .
}


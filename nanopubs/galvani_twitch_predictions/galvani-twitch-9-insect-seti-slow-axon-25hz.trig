sub:assertion {
    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz> a mlg:NeuromuscularTwitchEstimate,
            pk:Claim ;
        rdfs:label "Muscle-twitch estimate (9-insect-seti-slow-axon-25hz): 1.2 uA (300.0 mV, 25 Hz, cathodal_descending) in Schistocerca gregaria / Periplaneta americana -> 43.2% Make twitch, 0.0% Break twitch, 0.52 N force, 32.4 deg kick angle" ;
        dcterms:description "Quantitative neuromuscular excitation & muscle-twitch estimate for Schistocerca gregaria / Periplaneta americana (Hoyle (1955) & Burrows (1996) Locust/Cockroach Tibial Extensor, 1955; apparatus: Fine silver wire electrodes on metathoracic nerve 5 (SETi slow glutamatergic axon at 25 Hz)). Applied stimulus current I = 1.20 uA (driving EMF = 300.0 mV, contact duration d = 2.00 ms, frequency f = 25.0 Hz, polarity = cathodal_descending) produces 43.2% circuit-closing ('Make') contraction and 0.0% circuit-opening ('Break') contraction, yielding peak isometric force F = 0.52 N and limb deflection angle theta = 32.4 deg (Polyneuronal Slow Axon (SETi) Frequency-Graded Extension)." ;
        mlg:apparatus "Fine silver wire electrodes on metathoracic nerve 5 (SETi slow glutamatergic axon at 25 Hz)" ;
        mlg:electrodePolarity "cathodal_descending" ;
        mlg:experimentYear 1955 ;
        mlg:hasQuantitativeEstimate <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz/break_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz/driving_voltage_mV>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz/limb_kick_angle_deg>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz/make_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz/peak_twitch_force_N>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz/pulse_duration_ms>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz/stimulus_current_uA>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz/stimulus_frequency_Hz> ;
        mlg:investigator "Hoyle (1955) & Burrows (1996) Locust/Cockroach Tibial Extensor" ;
        mlg:organism "Schistocerca gregaria / Periplaneta americana" ;
        mlg:pflugerRegime "Polyneuronal Slow Axon (SETi) Frequency-Graded Extension" .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz/break_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-opening ('Break') contraction amplitude" ;
        schema:propertyID "break_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "0.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz/driving_voltage_mV> a schema:PropertyValue ;
        rdfs:label "Driving electromotive force (EMF)" ;
        schema:propertyID "driving_voltage_mV" ;
        schema:unitText "mV" ;
        schema:value "300.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz/limb_kick_angle_deg> a schema:PropertyValue ;
        rdfs:label "Peak kinematic limb deflection / kick angle" ;
        schema:propertyID "limb_kick_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "32.4"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz/make_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-closing ('Make') contraction amplitude" ;
        schema:propertyID "make_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "43.2"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz/peak_twitch_force_N> a schema:PropertyValue ;
        rdfs:label "Peak isometric muscle contraction force" ;
        schema:propertyID "peak_twitch_force_N" ;
        schema:unitText "N" ;
        schema:value "0.52"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz/pulse_duration_ms> a schema:PropertyValue ;
        rdfs:label "Stimulus contact duration" ;
        schema:propertyID "pulse_duration_ms" ;
        schema:unitText "ms" ;
        schema:value "2.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz/stimulus_current_uA> a schema:PropertyValue ;
        rdfs:label "Stimulus current through nerve/tissue" ;
        schema:propertyID "stimulus_current_uA" ;
        schema:unitText "uA" ;
        schema:value "1.2"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-9-insect-seti-slow-axon-25hz/stimulus_frequency_Hz> a schema:PropertyValue ;
        rdfs:label "Stimulus pulse train frequency" ;
        schema:propertyID "stimulus_frequency_Hz" ;
        schema:unitText "Hz" ;
        schema:value "25.0"^^xsd:double .
}


sub:assertion {
    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax> a mlg:NeuromuscularTwitchEstimate,
            pk:Claim ;
        rdfs:label "Muscle-twitch estimate (12-human-percutaneous-tibial-mmax): 60000.0 uA (85000.0 mV, 1 Hz, cathodal_descending) in Homo sapiens (posterior tibial nerve / soleus & gastrocnemius) -> 100.0% Make twitch, 0.0% Break twitch, 22.00 N force, 18.0 deg kick angle" ;
        dcterms:description "Quantitative neuromuscular excitation & muscle-twitch estimate for Homo sapiens (posterior tibial nerve / soleus & gastrocnemius) (Grospretre & Martin (2015) / Nakagawa et al. (2023) Percutaneous Motor Point, 2023; apparatus: Percutaneous needle / motor-point stimulation at supramaximal M-max intensity). Applied stimulus current I = 60000.00 uA (driving EMF = 85000.0 mV, contact duration d = 1.00 ms, frequency f = 1.0 Hz, polarity = cathodal_descending) produces 100.0% circuit-closing ('Make') contraction and 0.0% circuit-opening ('Break') contraction, yielding peak isometric force F = 22.00 N and limb deflection angle theta = 18.0 deg (Human Supramaximal M-Wave (M-max, 40-100 mA) 100% Alpha-Motor Recruitment)." ;
        mlg:apparatus "Percutaneous needle / motor-point stimulation at supramaximal M-max intensity" ;
        mlg:electrodePolarity "cathodal_descending" ;
        mlg:experimentYear 2023 ;
        mlg:hasQuantitativeEstimate <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax/break_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax/driving_voltage_mV>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax/limb_kick_angle_deg>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax/make_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax/peak_twitch_force_N>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax/pulse_duration_ms>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax/stimulus_current_uA>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax/stimulus_frequency_Hz> ;
        mlg:investigator "Grospretre & Martin (2015) / Nakagawa et al. (2023) Percutaneous Motor Point" ;
        mlg:organism "Homo sapiens (posterior tibial nerve / soleus & gastrocnemius)" ;
        mlg:pflugerRegime "Human Supramaximal M-Wave (M-max, 40-100 mA) 100% Alpha-Motor Recruitment" .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax/break_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-opening ('Break') contraction amplitude" ;
        schema:propertyID "break_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "0.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax/driving_voltage_mV> a schema:PropertyValue ;
        rdfs:label "Driving electromotive force (EMF)" ;
        schema:propertyID "driving_voltage_mV" ;
        schema:unitText "mV" ;
        schema:value "85000.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax/limb_kick_angle_deg> a schema:PropertyValue ;
        rdfs:label "Peak kinematic limb deflection / kick angle" ;
        schema:propertyID "limb_kick_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "18.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax/make_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-closing ('Make') contraction amplitude" ;
        schema:propertyID "make_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "100.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax/peak_twitch_force_N> a schema:PropertyValue ;
        rdfs:label "Peak isometric muscle contraction force" ;
        schema:propertyID "peak_twitch_force_N" ;
        schema:unitText "N" ;
        schema:value "22.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax/pulse_duration_ms> a schema:PropertyValue ;
        rdfs:label "Stimulus contact duration" ;
        schema:propertyID "pulse_duration_ms" ;
        schema:unitText "ms" ;
        schema:value "1.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax/stimulus_current_uA> a schema:PropertyValue ;
        rdfs:label "Stimulus current through nerve/tissue" ;
        schema:propertyID "stimulus_current_uA" ;
        schema:unitText "uA" ;
        schema:value "60000.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-12-human-percutaneous-tibial-mmax/stimulus_frequency_Hz> a schema:PropertyValue ;
        rdfs:label "Stimulus pulse train frequency" ;
        schema:propertyID "stimulus_frequency_Hz" ;
        schema:unitText "Hz" ;
        schema:value "1.0"^^xsd:double .
}


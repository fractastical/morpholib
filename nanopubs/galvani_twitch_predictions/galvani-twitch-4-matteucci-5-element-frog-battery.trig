sub:assertion {
    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery> a mlg:NeuromuscularTwitchEstimate,
            pk:Claim ;
        rdfs:label "Muscle-twitch estimate (4-matteucci-5-element-frog-battery): 9.2 uA (210.0 mV, 1 Hz, cathodal_descending) in Pelophylax esculentus (= Rana esculenta) -> 80.3% Make twitch, 42.3% Break twitch, 0.96 N force, 52.2 deg kick angle" ;
        dcterms:description "Quantitative neuromuscular excitation & muscle-twitch estimate for Pelophylax esculentus (= Rana esculenta) (Matteucci ('Pile de Grenouilles', 5 Half-Thighs), 1842; apparatus: 5 cut frog thighs wired in series (5 x 42 mV = 210 mV, R_tot = 22.8 kOhm)). Applied stimulus current I = 9.20 uA (driving EMF = 210.0 mV, contact duration d = 2.50 ms, frequency f = 1.0 Hz, polarity = cathodal_descending) produces 80.3% circuit-closing ('Make') contraction and 42.3% circuit-opening ('Break') contraction, yielding peak isometric force F = 0.96 N and limb deflection angle theta = 52.2 deg (Graded Recruitment (Onset of Pfluger Stage II))." ;
        mlg:apparatus "5 cut frog thighs wired in series (5 x 42 mV = 210 mV, R_tot = 22.8 kOhm)" ;
        mlg:electrodePolarity "cathodal_descending" ;
        mlg:experimentYear 1842 ;
        mlg:hasQuantitativeEstimate <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery/break_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery/driving_voltage_mV>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery/limb_kick_angle_deg>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery/make_twitch_pct>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery/peak_twitch_force_N>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery/pulse_duration_ms>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery/stimulus_current_uA>,
            <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery/stimulus_frequency_Hz> ;
        mlg:investigator "Matteucci ('Pile de Grenouilles', 5 Half-Thighs)" ;
        mlg:organism "Pelophylax esculentus (= Rana esculenta)" ;
        mlg:pflugerRegime "Graded Recruitment (Onset of Pfluger Stage II)" .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery/break_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-opening ('Break') contraction amplitude" ;
        schema:propertyID "break_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "42.3"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery/driving_voltage_mV> a schema:PropertyValue ;
        rdfs:label "Driving electromotive force (EMF)" ;
        schema:propertyID "driving_voltage_mV" ;
        schema:unitText "mV" ;
        schema:value "210.0"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery/limb_kick_angle_deg> a schema:PropertyValue ;
        rdfs:label "Peak kinematic limb deflection / kick angle" ;
        schema:propertyID "limb_kick_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "52.2"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery/make_twitch_pct> a schema:PropertyValue ;
        rdfs:label "Circuit-closing ('Make') contraction amplitude" ;
        schema:propertyID "make_twitch_pct" ;
        schema:unitText "% of max single twitch" ;
        schema:value "80.3"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery/peak_twitch_force_N> a schema:PropertyValue ;
        rdfs:label "Peak isometric muscle contraction force" ;
        schema:propertyID "peak_twitch_force_N" ;
        schema:unitText "N" ;
        schema:value "0.96"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery/pulse_duration_ms> a schema:PropertyValue ;
        rdfs:label "Stimulus contact duration" ;
        schema:propertyID "pulse_duration_ms" ;
        schema:unitText "ms" ;
        schema:value "2.5"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery/stimulus_current_uA> a schema:PropertyValue ;
        rdfs:label "Stimulus current through nerve/tissue" ;
        schema:propertyID "stimulus_current_uA" ;
        schema:unitText "uA" ;
        schema:value "9.2"^^xsd:double .

    <https://w3id.org/morpholib/galvani/claim/galvani-twitch-4-matteucci-5-element-frog-battery/stimulus_frequency_Hz> a schema:PropertyValue ;
        rdfs:label "Stimulus pulse train frequency" ;
        schema:propertyID "stimulus_frequency_Hz" ;
        schema:unitText "Hz" ;
        schema:value "1.0"^^xsd:double .
}


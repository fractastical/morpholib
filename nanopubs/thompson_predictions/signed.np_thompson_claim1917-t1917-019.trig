sub:assertion {
    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 claim registry (59 claims, all dated 1917)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 literature counterclaim layer" ;
        mlt:bytes 54663 ;
        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-019> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-019 -- Ch. VII, pp. 293-345, Figs. 120-127" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "VII" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. VII, pp. 293-345, Figs. 120-127." ;
        mlt:claim "Tissue cells tessellate approximately as hexagons / as a froth, the configuration that partitions area with least perimeter." ;
        mlt:claimId "T1917-019" ;
        mlt:claimType "geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "120-127" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-019> ;
        mlt:pages "293-345" ;
        mlt:repo2026AssessmentNotLiterature "Same gap as T1917-018: polygon-class distributions (pentagon/hexagon/heptagon fractions) unscored. Known modern result: distributions are froth-like but not perfectly hexagonal." ;
        mlt:repo2026StatusSeparate "PARTIAL_REPO" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-019> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-019 (Thompson 1917): QUALIFIED -- Gibson et al. (2006); Farhadifar et al. (2007)" ;
        mlt:counterclaim "Epithelial polygon distributions are froth-like but *not* simply 'hexagons tile best': proliferating epithelia have a characteristic polygon spectrum (substantial pentagon/heptagon fractions) explained by division topology, not by perimeter minimisation alone. Thompson's froth analogy survives, his implied hexagonal optimum does not describe growing tissue." ;
        mlt:literatureCitation "Gibson, M.C. et al. (2006) Nature 442:1038-1041; Farhadifar et al. (2007)" ;
        mlt:literatureRelation "QUALIFIED" ;
        mlt:literatureWhoAndWhen "Gibson et al. (2006); Farhadifar et al. (2007)" ;
        mlt:quantitativeMargin "Real epithelia: hexagons are only the modal class (~40-50% in the wing disc), with large 5- and 7-sided fractions" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-019> .
}


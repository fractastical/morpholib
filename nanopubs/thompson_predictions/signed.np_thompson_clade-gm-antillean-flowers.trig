            "{\"id\": \"FP3\", \"p\": 0.7, \"pass\": true}",
            "{\"id\": \"FP4\", \"p\": 0.8, \"pass\": true}" ;
        mlt:looErrorRatioFullVsConsensus 0.6894 ;
        mlt:looErrorRatioThompson7VsConsensus 0.9973 ;
        mlt:nHypothesesSupported 3 ;
        mlt:nHypothesesTotal 4 ;
        mlt:pca7VarianceShare 0.9685 ;

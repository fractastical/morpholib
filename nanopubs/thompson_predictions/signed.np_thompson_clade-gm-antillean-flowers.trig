sub:assertion {
    <https://w3id.org/morpholib/thompson/clade-gm/clade-gm-antillean-flowers> a mlt:CladeGeometricMorphometricsOutcome ;
        rdfs:label "seed plants: Antillean Gesneriaceae angiosperm corollas (Joly et al. 2018 Evolution / Zenodo 5011744: 296 corollas across 48 species on *BEAST tree; 32 2D floral landmarks across hummingbird, bat, and generalist pollination syndromes): Thompson-7 captures 82.1% of interspecific variance (PCA-7 96.8%), 3/4 pre-registered hypotheses supported (Brier 0.179)" ;
        mlt:brierScore 0.1788 ;
        mlt:evaluatesPortfolio <https://w3id.org/morpholib/thompson/np/dataset-portfolio-2026-10-22/RA9ZKlSDsa68lEKRo7JR0Px5woGoCMUHRlSK_bHKag4EA> ;

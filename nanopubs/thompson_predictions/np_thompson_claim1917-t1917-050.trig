    <https://w3id.org/morpholib/thompson/claim/t1917-050> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-050 -- Ch. XVII (fish, generalisation), pp. 748-751, Figs. 373-382" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XVII (fish, generalisation)" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVII (fish, generalisation), pp. 748-751, Figs. 373-382." ;
        mlt:claim "IMPLIED GENERALISATION tested by this repo (not a sentence of Thompson's): the four fish families above describe related-fish form difference generally, across taxa and evolutionary time." ;
        mlt:claimId "T1917-050" ;
        mlt:claimType "geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "373-382" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-050> ;
        mlt:pages "748-751" ;
        mlt:repo2026AssessmentNotLiterature "This is the repo's most complete Thompson result and should be cited as an extension, never as 'Thompson claimed this in 1917'. Remaining: none for fish at landmark level; outline-level for exact pairs (T1917-045/048/049)." ;
        mlt:repo2026StatusSeparate "DONE_REPO" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-050> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-050 (Thompson 1917): QUALIFIED -- This row is a 2026 repo generalisation, not a 1917 claim and not literature" ;
        mlt:counterclaim "Not applicable to the literature: Thompson never made this generalisation in this form. Its nearest literature relatives are Bookstein (1977) (method intractable) and Scholtz et al. (2020) (simple transformations only). Cite it only as 'Dietz/repo (2026)'." ;
        mlt:literatureCitation "Repo: thompson/1917-thompson-four-families-atlas.py and companions (2026)" ;
        mlt:literatureRelation "QUALIFIED" ;
        mlt:literatureWhoAndWhen "This row is a 2026 repo generalisation, not a 1917 claim and not literature" ;
        mlt:quantitativeMargin "Repo 2026: intrageneric median 48.0% explained, 54.2% reach noise floor; interfamily only 0.3% reach the floor; horizon ~45-50 Myr" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-050> .

sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-013-the-forms-of-cells> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-013 — Thompson (1917), Ch. V, pp. 201-276, Figs. 60-68" ;
        prov:wasRevisionOf sub:RAvo33_Q9GuuxbH_grteqGpd2RFYH7duCLth17matv7b8 ;
        mlt:automationTier "LOOP_WITH_SEED" ;
        mlt:candidateDataset <https://doi.org/10.5061/dryad.sr595> ;
        mlt:candidateDatasetTitle "Data from: Age of heart disease presentation and dysmorphic nuclei in patients with LMNA mutations" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. V, pp. 201-276, Figs. 60-68." ;
        mlt:claim "A free, isolated cell (like a liquid drop) tends to the spherical/minimal-area form under surface tension, departing from it only under identifiable constraints." ;
        mlt:claimId "T1917-013" ;
        mlt:counterclaim "Directly addressed to Thompson (1917): 'While D'Arcy Thompson dismissed the connection between surface tension and contractility, we now understand that this connection is paramount... the tension at cell surfaces is NOT driven by surface tension, as Thompson understood it, but by tension in the cortical actin layer.' Membrane tension's contribution to effective surface tension is often negligible. The sphere-as-null survives; Thompson's passive-liquid mechanism does not." ;
        mlt:dataKindNeeded "isolated cell shape images" ;
        mlt:datasetAuditReason "Public hits exist but title relevance is weak; loop Step 1 must vet species/variables before fetch." ;
        mlt:datasetExistence "PUBLIC_CANDIDATE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 6 ;
        mlt:effortDaysLow 3 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "'Tension, contraction and tissue morphogenesis' (2017, PMC5769629), Box 1 'A note about surface tension'" ;
        mlt:literatureRelation "PARTIALLY_REFUTED" ;
        mlt:literatureWhoAndWhen "Heer et al. / Lecuit-group reviews (2017); Fischer-Friedrich et al. (2014)" ;
        mlt:pass2Status "DONE_ELSEWHERE" ;
        mlt:quantitativeMargin "Mechanism refuted; spherical null shape retained as approximation" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset PUBLIC_CANDIDATE, tier LOOP_WITH_SEED); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;

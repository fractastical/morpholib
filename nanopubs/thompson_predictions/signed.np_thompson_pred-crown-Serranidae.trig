sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Serranidae at 45.2 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Serranidae lineage at 45.2 Ma given 4 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 45.23 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0184 ;
        mlt:expectedProcrustesRMSThompson7 0.0252 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Serranidae dated to 45 +/- 9 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.301, 0.420] falsifies this prediction (point estimate 0.359); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 4 ;
        mlt:predictedLandmarksFull30 "[[-0.21013, -0.05942], [-0.26679, 0.00715], [-0.0796, 0.12874], [0.35483, 0.05471], [0.42929, 0.04064], [0.42658, -0.05882], [0.31239, -0.07055], [0.17573, -0.11025], [-0.05826, -0.01355], [-0.0462, -0.07318], [-0.08332, 0.06697], [-0.14229, 0.03762], [-0.1384, -0.04944], [-0.18454, -0.07037], [-0.22682, 0.02069], [-0.17818, 0.02109], [-0.0843, 0.12796]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.21588, -0.04647], [-0.2632, -0.00991], [-0.05737, 0.138], [0.35366, 0.05001], [0.42981, 0.03605], [0.41351, -0.05542], [0.3361, -0.05897], [0.16809, -0.12366], [-0.06414, -0.01859], [-0.03821, -0.06272], [-0.1012, 0.06175], [-0.14385, 0.0349], [-0.13521, -0.05586], [-0.18741, -0.06337], [-0.21937, 0.02157], [-0.17271, 0.02688], [-0.10263, 0.12583]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Serranidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.473 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.5246 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.577 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3015 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3585 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.42 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2413 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2714 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.3015 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2937 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3328 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.3751 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.4761 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.5222 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5663 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.341 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.3956 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.4471 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae-thompson7-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2224 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.2495 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.2765 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Serranidae-thompson7-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.3353 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.3728 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.4101 .
}


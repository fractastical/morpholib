sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Priacanthidae at 33.6 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Priacanthidae lineage at 33.6 Ma given 4 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 33.62 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0158 ;
        mlt:expectedProcrustesRMSThompson7 0.0218 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Priacanthidae dated to 34 +/- 7 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.335, 0.460] falsifies this prediction (point estimate 0.398); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 4 ;
        mlt:predictedLandmarksFull30 "[[-0.23823, -0.06232], [-0.27425, 0.03526], [-0.06209, 0.13162], [0.352, 0.05088], [0.41543, 0.0378], [0.41696, -0.03052], [0.35629, -0.04159], [0.11852, -0.13584], [-0.06105, -0.03975], [-0.03858, -0.07749], [-0.08231, 0.06892], [-0.11438, 0.02374], [-0.13759, -0.07272], [-0.20693, -0.08003], [-0.22305, 0.03245], [-0.13826, 0.03287], [-0.08249, 0.12671]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.2359, -0.04751], [-0.26738, 0.01064], [-0.05743, 0.13327], [0.35574, 0.04198], [0.42138, 0.04206], [0.41453, -0.02457], [0.34363, -0.04393], [0.13324, -0.13779], [-0.04715, -0.03563], [-0.04494, -0.08774], [-0.07416, 0.05915], [-0.11962, 0.03655], [-0.14991, -0.0727], [-0.21706, -0.07447], [-0.20571, 0.03775], [-0.15239, 0.03306], [-0.09687, 0.1299]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Priacanthidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.4223 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4798 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5416 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3351 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3976 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.4604 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2585 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2862 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.3152 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3199 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3604 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.402 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.4447 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.4945 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5484 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.3501 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.4045 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.4646 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae-thompson7-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2612 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.289 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.3184 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Priacanthidae-thompson7-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.3307 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.3677 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.4082 .
}


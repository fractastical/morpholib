sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Apogonidae at 51.7 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Apogonidae lineage at 51.7 Ma given 6 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 51.69 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0242 ;
        mlt:expectedProcrustesRMSThompson7 0.0298 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Apogonidae dated to 52 +/- 10 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.341, 0.464] falsifies this prediction (point estimate 0.401); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 6 ;
        mlt:predictedLandmarksFull30 "[[-0.22242, -0.07565], [-0.30383, 0.01373], [-0.00544, 0.14342], [0.28578, 0.07341], [0.43038, 0.05161], [0.42944, -0.06188], [0.30352, -0.0712], [0.1697, -0.13443], [-0.02919, -0.02767], [-0.01925, -0.0749], [-0.07365, 0.07743], [-0.13898, 0.05303], [-0.13629, -0.06261], [-0.18961, -0.08663], [-0.25441, 0.02695], [-0.17055, 0.02732], [-0.07521, 0.1281]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.23415, -0.0533], [-0.28652, -0.00894], [-0.02347, 0.15425], [0.34452, 0.06215], [0.40449, 0.05035], [0.39172, -0.05443], [0.33009, -0.06302], [0.19069, -0.14593], [-0.05467, -0.02521], [-0.0273, -0.0768], [-0.08597, 0.06794], [-0.13759, 0.03805], [-0.13773, -0.06708], [-0.20113, -0.07405], [-0.22726, 0.02523], [-0.17177, 0.02966], [-0.07395, 0.14112]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Apogonidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.416 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4736 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5305 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3407 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4007 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.4643 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2859 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3148 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.3427 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.4093 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4486 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.4902 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.5099 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.5595 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.6138 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.397 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.4555 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.5184 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae-thompson7-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2754 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.3043 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.3344 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Apogonidae-thompson7-PD_over_SL> a mlt:PredictedRatio ;

<https://w3id.org/morpholib/thompson/np/pred-crown-Sparidae/assertion> {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sparidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Sparidae at 49.9 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Sparidae lineage at 49.9 Ma given 11 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 49.87 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0201 ;
        mlt:expectedProcrustesRMSThompson7 0.0276 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Sparidae dated to 50 +/- 10 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.387, 0.505] falsifies this prediction (point estimate 0.447); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sparidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sparidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sparidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sparidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sparidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sparidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sparidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sparidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 11 ;
        mlt:predictedLandmarksFull30 "[[-0.21877, -0.05766], [-0.27377, -0.02011], [-0.04506, 0.1681], [0.33063, 0.05325], [0.41814, 0.03443], [0.41316, -0.04989], [0.32218, -0.06773], [0.18578, -0.12838], [-0.05243, -0.02763], [-0.04207, -0.07491], [-0.09092, 0.06361], [-0.1294, 0.03432], [-0.14032, -0.07654], [-0.19928, -0.07868], [-0.21844, 0.03678], [-0.16401, 0.03842], [-0.0954, 0.15263]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.22398, -0.06116], [-0.26828, -0.01303], [-0.0465, 0.1636], [0.33964, 0.05056], [0.40867, 0.03491], [0.40743, -0.05389], [0.33699, -0.05871], [0.17832, -0.13437], [-0.05906, -0.02398], [-0.03506, -0.07646], [-0.09212, 0.07359], [-0.13713, 0.04182], [-0.13799, -0.0715], [-0.19602, -0.08263], [-0.21678, 0.02694], [-0.1676, 0.03249], [-0.09054, 0.15183]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Sparidae" .


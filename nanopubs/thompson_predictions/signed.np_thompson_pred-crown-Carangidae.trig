sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Carangidae at 65.2 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Carangidae lineage at 65.2 Ma given 24 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 65.25 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0349 ;
        mlt:expectedProcrustesRMSThompson7 0.0347 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Carangidae dated to 65 +/- 13 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.273, 0.383] falsifies this prediction (point estimate 0.329); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 24 ;
        mlt:predictedLandmarksFull30 "[[-0.21822, -0.04415], [-0.27284, 0.0054], [-0.01234, 0.11354], [0.35939, 0.02943], [0.42473, 0.01989], [0.42433, -0.02666], [0.36084, -0.03281], [0.14308, -0.10684], [-0.07585, -0.01081], [-0.05987, -0.04431], [-0.09672, 0.04326], [-0.14457, 0.03286], [-0.13931, -0.05167], [-0.19362, -0.05632], [-0.2211, 0.0156], [-0.17847, 0.01509], [-0.09944, 0.09851]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.22701, -0.03946], [-0.26487, -0.00293], [-0.03755, 0.10861], [0.35979, 0.03261], [0.43907, 0.02506], [0.42223, -0.0322], [0.3393, -0.03881], [0.1597, -0.09601], [-0.07406, -0.01953], [-0.05315, -0.05657], [-0.09661, 0.04885], [-0.14287, 0.02869], [-0.14971, -0.05047], [-0.20211, -0.056], [-0.21712, 0.02218], [-0.17199, 0.02355], [-0.08304, 0.10242]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Carangidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.351 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4024 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.4545 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2733 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3288 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.3833 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.214 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2409 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.2666 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3657 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4005 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.4366 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.3809 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.4199 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.4631 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2521 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.3023 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.3541 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae-thompson7-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2193 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.2437 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.2713 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Carangidae-thompson7-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.3306 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.3627 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.3979 .
}


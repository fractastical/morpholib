sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Polyprion-americanus-Pristigenys-alta> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Polyprion americanus + Pristigenys alta at 103.1 Ma (most recent common ancestor of one of D'Arcy Thompson's 1917 transformation pairs)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Polyprion americanus + Pristigenys alta lineage at 103.1 Ma given 2 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Most recent common ancestor of one of d'arcy thompson's 1917 transformation pairs. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 103.11 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.031 ;
        mlt:expectedProcrustesRMSThompson7 0.0288 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Polyprion americanus + Pristigenys alta dated to 103 +/- 21 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.346, 0.422] falsifies this prediction (point estimate 0.384); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Polyprion-americanus-Pristigenys-alta-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Polyprion-americanus-Pristigenys-alta-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Polyprion-americanus-Pristigenys-alta-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Polyprion-americanus-Pristigenys-alta-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Polyprion-americanus-Pristigenys-alta-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Polyprion-americanus-Pristigenys-alta-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Polyprion-americanus-Pristigenys-alta-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Polyprion-americanus-Pristigenys-alta-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 2 ;
        mlt:predictedLandmarksFull30 "[[-0.229, -0.05179], [-0.27192, -0.00194], [-0.02977, 0.13183], [0.33781, 0.0493], [0.42287, 0.03699], [0.42322, -0.03997], [0.34007, -0.052], [0.16619, -0.12704], [-0.06432, -0.02365], [-0.04763, -0.07002], [-0.09037, 0.05882], [-0.13369, 0.03337], [-0.14513, -0.06009], [-0.20569, -0.06886], [-0.21624, 0.03083], [-0.16273, 0.03211], [-0.09367, 0.12211]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.23055, -0.04656], [-0.26733, -0.0022], [-0.04074, 0.13311], [0.34626, 0.04665], [0.41909, 0.03879], [0.41841, -0.04076], [0.3425, -0.05077], [0.16819, -0.12626], [-0.06511, -0.02519], [-0.04618, -0.07155], [-0.08999, 0.05919], [-0.13613, 0.03448], [-0.14805, -0.06185], [-0.2061, -0.06708], [-0.21412, 0.02703], [-0.1664, 0.02836], [-0.08374, 0.1246]]" ;
        mlt:predictionKind "mrca" ;
        mlt:targetLineage "Polyprion americanus + Pristigenys alta" .

    <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Polyprion-americanus-Pristigenys-alta-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.4461 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4817 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5178 .

    <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Polyprion-americanus-Pristigenys-alta-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.346 ;

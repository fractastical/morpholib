    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 literature counterclaim layer" ;
        mlt:bytes 54663 ;
        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-007> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-007 -- Ch. III, pp. 50-155, Figs. 3-40" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "III" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. III, pp. 50-155, Figs. 3-40." ;
        mlt:claim "Growth in size/weight over time follows a definite, plottable curve: rapid (near-compound-interest) early growth with a steadily diminishing specific rate of growth." ;
        mlt:claimId "T1917-007" ;
        mlt:claimType "quantitative-empirical" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "3-40" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-007> ;
        mlt:pages "50-155" ;
        mlt:repo2026AssessmentNotLiterature "Supported as a family (von Bertalanffy/logistic/Gompertz fits); no single universal curve. Thompson's own plotted data (man, mouse, silkworm, tadpole, bamboo) could be digitised and re-fit cheaply." ;
        mlt:repo2026StatusSeparate "DONE_ELSEWHERE" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-007> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-007 (Thompson 1917): SUPERSEDED -- von Bertalanffy (1957)" ;
        mlt:counterclaim "Thompson's plotted growth curves are descriptive. Von Bertalanffy replaced curve-description with a mechanistic balance law (dW/dt = anabolism - catabolism) that predicts the curve family. Later qualification: the 'universal' 2/3 exponent in that law is not universal -- optimally fitted exponents vary widely; the von Bertalanffy function is 'weakly universal' for fish, not for non-fish (PeerJ 2018, 'On the exponent in the Von Bertalanffy growth model')." ;
        mlt:literatureCitation "von Bertalanffy, L. (1957) Q. Rev. Biol. 32:217-231" ;
        mlt:literatureRelation "SUPERSEDED" ;
        mlt:literatureWhoAndWhen "von Bertalanffy (1957)" ;
        mlt:quantitativeMargin "Superseded as method, not refuted as data: no single growth curve/exponent fits all taxa" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-007> .
}


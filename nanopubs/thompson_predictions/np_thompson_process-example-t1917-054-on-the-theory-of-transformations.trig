    <https://w3id.org/morpholib/thompson/process-instance/t1917-054-on-the-theory-of-transformations> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-054 — Thompson (1917), Ch. XVII, pp. 757-759, Figs. 388-393" ;
        prov:wasRevisionOf <https://w3id.org/morpholib/thompson/np/process-example-t1917-054-on-the-theory-of-transformations/RA6XRrIEfsfLm-IeH9Jv6aADx_DFwIsrbT7yGVQNd5Ubk> ;

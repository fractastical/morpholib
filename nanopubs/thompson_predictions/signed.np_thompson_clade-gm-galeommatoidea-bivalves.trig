sub:assertion {
    <https://w3id.org/morpholib/thompson/clade-gm/clade-gm-galeommatoidea-bivalves> a mlt:CladeGeometricMorphometricsOutcome ;
        rdfs:label "molluscs: Galeommatoidea marine bivalve shells (Goto et al. 2016 Evolution: 302 specimens, ~100 species on final_BEAST.tre; 46 shell-outline landmarks): Thompson-7 captures 85.0% of interspecific variance (PCA-7 98.8%), 3/4 pre-registered hypotheses supported (Brier 0.219)" ;
        mlt:brierScore 0.2194 ;
        mlt:evaluatesPortfolio <https://w3id.org/morpholib/thompson/np/dataset-portfolio-2026-10-22/RA9ZKlSDsa68lEKRo7JR0Px5woGoCMUHRlSK_bHKag4EA> ;
        mlt:figureAsset <https://github.com/fractastical/morpholib/blob/967dc2c36396e60bc8955e12a8b582bba7b11df9/docs/portfolio/fig_galeommatoidea_bivalves.png> ;
        mlt:hypothesisFileSha256 "805386b0e5a858e77eae8c42819d5cf16e43d51883a8afad0fa87af47d88c828" ;
        mlt:hypothesisVerdict "{\"id\": \"GB1\", \"p\": 0.9, \"pass\": false}",
            "{\"id\": \"GB2\", \"p\": 0.85, \"pass\": true}",
            "{\"id\": \"GB3\", \"p\": 0.85, \"pass\": true}",
            "{\"id\": \"GB4\", \"p\": 0.85, \"pass\": true}" ;
        mlt:looErrorRatioFullVsConsensus 0.651 ;
        mlt:looErrorRatioThompson7VsConsensus 0.735 ;
        mlt:nHypothesesSupported 3 ;
        mlt:nHypothesesTotal 4 ;
        mlt:pca7VarianceShare 0.9878 ;
        mlt:reportDocument <https://github.com/fractastical/morpholib/blob/967dc2c36396e60bc8955e12a8b582bba7b11df9/docs/portfolio/galeommatoidea_bivalves.md> ;
        mlt:resultFileSha256 "1234dbe3532e2da6364ab3bf616bc69b0d9756b4cb36b9d855306042bac9eec6" ;
        mlt:testsPreregistrationManifest <https://w3id.org/morpholib/thompson/np/multiclade-preregistration-manifest-2026-10-23/RAQ_Giwd735IPhYg-cOMyPE6t4K9WPM9XlijGkNC6_eJ4> ;
        mlt:thompson7VarianceShare 0.8496 .
}


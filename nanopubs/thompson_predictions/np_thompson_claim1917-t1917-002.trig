    <https://w3id.org/morpholib/thompson/claim/t1917-002> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-002 -- Ch. I + Epilogue, pp. 1-15; Epilogue, Figs. -" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "I + Epilogue" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. I + Epilogue, pp. 1-15; Epilogue, Figs. -." ;
        mlt:claim "Many forms are explained by physical forces directly and do not require (and are not well explained by) adaptation/heredity acting part-by-part; related forms differ by whole-form transformation rather than by independent change of parts." ;
        mlt:claimId "T1917-002" ;
        mlt:claimType "methodological" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "-" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-002> ;
        mlt:pages "1-15; Epilogue" ;
        mlt:repo2026AssessmentNotLiterature "Repo tests the morphospace half (global growth fields vs local modules) in fishes/ants, not the anti-adaptationist half, which needs an explicit adaptationist null per system." ;
        mlt:repo2026StatusSeparate "PARTIAL_REPO" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-002> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-002 (Thompson 1917): QUALIFIED -- Gould (1971, and from the 1980s)" ;
        mlt:counterclaim "Thompson's anti-adaptationist, whole-form programme was first celebrated (Gould 1971, which revived him), then qualified by Gould himself: from the 1980s he refuted Thompson's mechanical determinism in favour of historical contingency and 'tinkering'. Modern synthesis: constraints (Thompson's half) and selection both operate; neither alone explains form." ;
        mlt:literatureCitation "Gould (1971); Gould & Lewontin (1979) Proc. R. Soc. B 205:581-598 (spandrels paper)" ;
        mlt:literatureRelation "QUALIFIED" ;
        mlt:literatureWhoAndWhen "Gould (1971, and from the 1980s)" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-002> .
}


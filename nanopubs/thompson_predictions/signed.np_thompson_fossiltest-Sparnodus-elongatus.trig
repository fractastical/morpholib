@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mlt: <https://w3id.org/morpholib/thompson/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/morpholib/thompson/np/fossiltest-Sparnodus-elongatus/RA2cIq7ck1Xv5nafTuczNYyeIWXIJn8Z48N61rtWX7cqc/> .
@prefix this: <https://w3id.org/morpholib/thompson/np/fossiltest-Sparnodus-elongatus/RA2cIq7ck1Xv5nafTuczNYyeIWXIJn8Z48N61rtWX7cqc> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Sparnodus-elongatus> a mlt:FossilPredictionTest ;
        rdfs:label "Monte Bolca test: Sparnodus elongatus (Sparidae) vs. predicted Sparidae lineage at 50 Ma" ;
        dcterms:bibliographicCitation "Bannikov A.F. (2006) Geodiversitas 28(2): 249-275: 'SL/maximum body depth ratio is 2.1' for MNHN Bol 68/69, 'equal in depth to the most deep-bodied specimens of Sparnodus ever recorded'." ;
        rdfs:comment "upper bound for the genus; no typical-specimen value is given in the source" ;
        mlt:ageMa 50.0 ;
        mlt:family "Sparidae" ;
        mlt:fossilTaxon "Sparnodus elongatus" ;
        mlt:hasMeasurementComparison <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Sparnodus-elongatus-BDmax_over_SL> ;
        mlt:nullHypothesis "phylogenetic stasis: fossil proportions equal the living family mean" ;
        mlt:phylogeneticPlacement "Sparidae (Sparnodus); value is the deepest-bodied Sparnodus specimen recorded (holotype of 'Pomadasys' furcatus = S. elongatus), typical individuals are shallower" ;
        mlt:testsPrediction <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Sparidae> ;
        mlt:verdictBodyDepth "consistent with the prediction" .

    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Sparnodus-elongatus-BDmax_over_SL> a mlt:MeasurementComparison ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length" ;
        mlt:directionOfChangeCorrect false ;
        mlt:fossilInsidePredictiveInterval95 true ;
        mlt:fossilValueLower 0.476 ;
        mlt:fossilValueUpper 0.476 ;
        mlt:livingFamilyMean 0.4661 ;
        mlt:predictedFull30 0.4472 ;
        mlt:predictedFull30Lower95 0.3892 ;
        mlt:predictedFull30Upper95 0.5036 ;
        mlt:predictedThompson7 0.4549 ;
        mlt:predictionCloserThanStasisNull false ;
        mlt:ratioName "BDmax_over_SL" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://github.com/fractastical/morpholib/blob/main/thompson/run_phylogenetic_prediction_engine.py> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/s41586-018-0273-1>,
            <https://doi.org/10.1371/journal.pone.0112732>,
            <https://github.com/fractastical/morpholib/blob/main/datasets/thompson/monte_bolca_fossil_ratios.json> ;
        prov:wasGeneratedBy <https://github.com/fractastical/morpholib/commit/d62e26282a7f1113a2d80135ca04aa3fdb434e51> .

    <https://github.com/fractastical/morpholib/commit/d62e26282a7f1113a2d80135ca04aa3fdb434e51> a prov:Activity ;
        rdfs:label "Run of thompson/run_phylogenetic_prediction_engine.py at morpholib commit d62e26282a7f" ;
        prov:endedAtTime "2026-10-22"^^xsd:date ;
        prov:used <https://doi.org/10.1038/s41586-018-0273-1>,
            <https://doi.org/10.1371/journal.pone.0112732>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/run_phylogenetic_prediction_engine.py> .

    <https://github.com/fractastical/morpholib/blob/main/thompson/run_phylogenetic_prediction_engine.py> a prov:SoftwareAgent ;
        rdfs:label "Thompson 1917 phylogenetic prediction engine (7 linearised Thompson modes + Pagel-lambda PGLS on the Rabosky 2018 tree)" .
}

sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:pubinfo {
    sub:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy orcid:0009-0007-4948-9192 .

    orcid:0009-0007-4948-9192 rdfs:label "Joel Dietz" .

    this: dcterms:created "2026-10-22"^^xsd:date ;
        dcterms:creator orcid:0009-0007-4948-9192 ;
        dcterms:isPartOf <https://github.com/fractastical/morpholib/blob/main/docs/THOMPSON_PHYLOGENETIC_PREDICTIONS.md> ;

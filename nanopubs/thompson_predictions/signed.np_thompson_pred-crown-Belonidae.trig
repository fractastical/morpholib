@prefix this: <https://w3id.org/morpholib/thompson/np/pred-crown-Belonidae/RA-ke08718ec461sFmbFo7qGv-oQpbOVU53yTkJOAii74> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Belonidae at 38.3 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Belonidae lineage at 38.3 Ma given 4 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 38.33 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0177 ;
        mlt:expectedProcrustesRMSThompson7 0.0251 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Belonidae dated to 38 +/- 8 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.067, 0.183] falsifies this prediction (point estimate 0.120); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 4 ;
        mlt:predictedLandmarksFull30 "[[-0.22848, -0.01472], [-0.25223, 0.0088], [0.20268, 0.03677], [0.35678, 0.02201], [0.3967, 0.0202], [0.39438, -0.01203], [0.33074, -0.01782], [0.21865, -0.03943], [-0.11202, 0.00228], [-0.10248, -0.0153], [-0.12943, 0.01333], [-0.15896, 0.01143], [-0.16441, -0.02511], [-0.20316, -0.02602], [-0.22357, 0.00297], [-0.19526, 0.00249], [-0.12994, 0.03014]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.23751, -0.01761], [-0.27883, -0.00218], [0.0579, 0.05065], [0.34934, 0.02497], [0.43536, 0.02278], [0.40882, -0.01557], [0.31896, -0.0205], [0.21715, -0.05294], [-0.11919, -0.01009], [-0.07097, -0.02803], [-0.10987, 0.02167], [-0.16983, 0.01183], [-0.16441, -0.02361], [-0.20245, -0.02503], [-0.23489, 0.00831], [-0.19771, 0.00926], [-0.00189, 0.04611]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Belonidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.0658 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.1224 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.1873 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.0672 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.1198 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.1826 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.147 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.1763 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.2094 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.6566 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.6995 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.7428 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2488 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.2792 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.3165 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.1039 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.1523 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.2014 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae-thompson7-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.1998 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.2228 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.247 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Belonidae-thompson7-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.4446 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.473 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.5021 .
}


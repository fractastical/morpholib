    <https://w3id.org/morpholib/thompson/claim/t1917-009> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-009 -- Ch. III, pp. 50-155, Figs. 25-32" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "III" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. III, pp. 50-155, Figs. 25-32." ;
        mlt:claim "Rate of growth varies lawfully with temperature and shows daily/seasonal/annual periodicity, recorded e.g. in tree growth (Douglass) and plant/root growth curves." ;
        mlt:claimId "T1917-009" ;
        mlt:claimType "quantitative-empirical" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "25-32" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-009> ;
        mlt:pages "50-155" ;
        mlt:repo2026AssessmentNotLiterature "Settled in dendrochronology and growth physiology; not a repo gap worth new work unless used as a null for other claims." ;
        mlt:repo2026StatusSeparate "DONE_ELSEWHERE" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-009> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-009 (Thompson 1917): SUPPORTED -- Douglass's dendrochronology and its successors (from 1919)" ;
        mlt:counterclaim "No counterclaim; this became dendrochronology and quantitative growth physiology. Included for completeness: a Thompson claim the literature absorbed rather than fought." ;
        mlt:literatureCitation "Douglass, A.E. (1919+) dendrochronology; standard growth-physiology literature thereafter" ;
        mlt:literatureRelation "SUPPORTED" ;
        mlt:literatureWhoAndWhen "Douglass's dendrochronology and its successors (from 1919)" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-009> .

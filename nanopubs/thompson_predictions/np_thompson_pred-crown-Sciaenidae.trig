<https://w3id.org/morpholib/thompson/np/pred-crown-Sciaenidae/assertion> {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sciaenidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Sciaenidae at 49.7 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Sciaenidae lineage at 49.7 Ma given 4 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 49.72 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.02 ;
        mlt:expectedProcrustesRMSThompson7 0.0276 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Sciaenidae dated to 50 +/- 10 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.269, 0.398] falsifies this prediction (point estimate 0.329); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sciaenidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sciaenidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sciaenidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sciaenidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sciaenidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sciaenidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sciaenidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sciaenidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 4 ;
        mlt:predictedLandmarksFull30 "[[-0.2148, -0.05132], [-0.27227, -0.00101], [-0.04636, 0.12377], [0.36249, 0.0327], [0.42403, 0.02931], [0.42838, -0.04699], [0.3051, -0.05883], [0.20402, -0.09685], [-0.06234, -0.01301], [-0.04782, -0.04902], [-0.09673, 0.05191], [-0.14573, 0.03678], [-0.13618, -0.05408], [-0.19301, -0.05883], [-0.22771, 0.02294], [-0.18119, 0.02338], [-0.09987, 0.10917]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.2194, -0.0423], [-0.27259, -0.00872], [-0.04402, 0.12223], [0.35328, 0.03605], [0.42896, 0.02246], [0.41261, -0.04813], [0.33663, -0.04957], [0.18976, -0.10164], [-0.06904, -0.01551], [-0.03481, -0.05389], [-0.10588, 0.05559], [-0.15145, 0.03209], [-0.13484, -0.04952], [-0.18641, -0.05741], [-0.22853, 0.02044], [-0.18103, 0.02504], [-0.09322, 0.11279]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Sciaenidae" .


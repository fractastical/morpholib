sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Haemulidae at 53.0 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Haemulidae lineage at 53.0 Ma given 5 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 53.04 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0242 ;
        mlt:expectedProcrustesRMSThompson7 0.0298 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Haemulidae dated to 53 +/- 11 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.366, 0.477] falsifies this prediction (point estimate 0.419); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 5 ;
        mlt:predictedLandmarksFull30 "[[-0.22875, -0.05552], [-0.27282, -0.00756], [-0.05589, 0.15277], [0.3425, 0.04387], [0.4175, 0.0337], [0.41714, -0.04774], [0.31864, -0.06053], [0.18923, -0.12765], [-0.05738, -0.02103], [-0.03517, -0.06353], [-0.08793, 0.06456], [-0.13492, 0.03432], [-0.13466, -0.07269], [-0.1972, -0.07646], [-0.22082, 0.03084], [-0.16669, 0.03183], [-0.09277, 0.14083]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.2247, -0.05478], [-0.27235, -0.00918], [-0.04877, 0.1507], [0.34403, 0.04548], [0.41269, 0.03168], [0.40842, -0.05056], [0.33871, -0.05578], [0.18159, -0.12702], [-0.05768, -0.02289], [-0.03214, -0.07191], [-0.09379, 0.068], [-0.1392, 0.03921], [-0.1365, -0.06594], [-0.19522, -0.07526], [-0.22076, 0.02681], [-0.17024, 0.03106], [-0.0941, 0.14038]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Haemulidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.5114 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.5571 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.6091 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3661 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4195 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.4771 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2554 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2828 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.3105 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;

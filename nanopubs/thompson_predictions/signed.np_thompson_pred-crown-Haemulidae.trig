        mlt:pointEstimate 0.2794 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.3062 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae-thompson7-PD_over_SL> a mlt:PredictedRatio ;

        mlt:pointEstimate 0.4012 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.4407 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.5029 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.5471 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5917 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.3689 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.4211 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.4719 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Haemulidae-thompson7-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2523 ;

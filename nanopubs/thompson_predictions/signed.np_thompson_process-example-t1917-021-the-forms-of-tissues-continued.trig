sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-021-the-forms-of-tissues-continued> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-021 — Thompson (1917), Ch. VIII, pp. 346-410, Figs. 136-193" ;
        prov:wasRevisionOf sub:RARPFz5Q4KRJm_1BOBsMAcXefpxyD_iqwbnNrENmnVG2U ;
        mlt:automationTier "LOOP_WITH_SEED" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. VIII, pp. 346-410, Figs. 136-193." ;
        mlt:claim "The bee's honeycomb - hexagonal prisms closed by three rhombi meeting at the Maraldi angle (~109 deg 28 min) - is the configuration using least wax for the capacity (the isoperimetric claim)." ;
        mlt:claimId "T1917-021" ;
        mlt:counterclaim "SPLIT VERDICT, and the split is the famous one. (a) The hexagonal tiling IS optimal -- proved by Hales (2001): Thompson/Pappus right. (b) The bees' three-rhombi cell base is NOT the wax-minimum: Fejes Toth (1964) built a better base (two hexagons + two rhombi). Thompson's 'least wax' claim is therefore wrong in its 3D detail. Fejes Toth himself adds that the saving is practically illusory." ;
        mlt:dataKindNeeded "analytic (geometry) + comb photos" ;
        mlt:datasetAuditReason "Public hits exist but title relevance is weak; loop Step 1 must vet species/variables before fetch." ;
        mlt:datasetExistence "PUBLIC_CANDIDATE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 3 ;
        mlt:effortDaysLow 1 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Fejes Toth, L. (1964) Bull. AMS 70:468-481, 'What the bees know and what they do not know'; Hales, T.C. (2001) Ann. of Math. 153 (honeycomb conjecture proved)" ;
        mlt:literatureRelation "PARTIALLY_REFUTED" ;
        mlt:literatureWhoAndWhen "Fejes Toth (1964); Hales (2001)" ;
        mlt:pass2Status "DONE_ELSEWHERE" ;
        mlt:quantitativeMargin "Better base saves <0.35% of the area of a cell opening (much less of total cell surface) -- Fejes Toth (1964); a 2025 re-optimisation puts the total available saving at ~0.50%" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset PUBLIC_CANDIDATE, tier LOOP_WITH_SEED); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_claims.json (repo artifact)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_dataset_audit.json (repo artifact)" ;
        mlt:bytes 96343 ;
        mlt:sha256 "a0bc797767654ca4e951b1b3683a773923448b02124a61259e89cccd7a071f1a" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_loop_queue.yaml (repo artifact)" ;
        mlt:bytes 51327 ;
        mlt:sha256 "1d017aa92fb9cf889af47a1a631a328e1f204c1e12b930db1839b482c6f44d61" .
}


    <https://w3id.org/morpholib/thompson/claim/t1917-010> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-010 -- Ch. III, pp. 50-155, Figs. 33-40" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "III" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. III, pp. 50-155, Figs. 33-40." ;
        mlt:claim "Regeneration restores form at a measurable rate related to the amount removed (Durbin/Ellis tail-regeneration curves), i.e. restoration of form is itself a lawful growth process." ;
        mlt:claimId "T1917-010" ;
        mlt:claimType "quantitative-empirical" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "33-40" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-010> ;
        mlt:pages "50-155" ;
        mlt:repo2026AssessmentNotLiterature "No test on his (amphibian tail) system; modern regeneration morphometrics could test rate-vs-amount directly." ;
        mlt:repo2026StatusSeparate "UNTESTED" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-010> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-010 (Thompson 1917): NO_DIRECT_TEST -- -" ;
        mlt:counterclaim "No published counterclaim found. Absence of a test is the finding: this 1917 claim is still open." ;
        mlt:literatureCitation "Modern regeneration literature exists (urodele limb, planarian) but does not re-test Thompson/Durbin/Ellis's amount-removed vs time-restored relation on his system" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "-" ;
        mlt:noDirectTestFoundAsOf "2026-10-26"^^xsd:date ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:statementOfAbsence "As of this literature review (2026-10-26), no published work directly tests this 1917 claim as Thompson stated it. Neighbouring results are not a test of this claim." ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-010> .
}


sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-051-crocodile-skulls> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-051 — Thompson (1917), Ch. XVII, pp. 752-753, Figs. 383" ;
        prov:wasRevisionOf sub:RAHjmwyOpVmx6vD1IqAhK3cPEFCUTRWls9JDWOdMtPYCw ;
        mlt:automationTier "FULL_LOOP" ;
        mlt:candidateDataset <https://doi.org/10.5061/dryad.14fn1>,
            <https://doi.org/10.5061/dryad.6cv82g1>,
            <https://doi.org/10.5061/dryad.v15dv41wm> ;
        mlt:candidateDatasetTitle "Data from: Developmental origins of the crocodylian skull table and platyrostral face",
            "Data from: Heterochronic shifts and conserved embryonic shape underlie crocodylian craniofacial disparity and convergence",
            "Data from: The utility of cranial ontogeny for phylogenetic inference: a case study in crocodylians using geometric morphometrics" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVII, pp. 752-753, Figs. 383." ;
        mlt:claim "The skulls of crocodiles (C. porosus, C. americanus, Notosuchus terrestris) are mutually transformable by coordinate deformation." ;
        mlt:claimId "T1917-051" ;
        mlt:counterclaim "No published test of Thompson's crocodile-skull transformation was found. The data to do it have existed since at least 2013 (dryad.14fn1) -- the gap is framing, not data." ;
        mlt:dataKindNeeded "crocodylian cranial landmarks" ;
        mlt:datasetAuditReason "Dryad live search returned 3 title-relevant dataset(s), top: doi:10.5061/dryad.14fn1." ;
        mlt:datasetExistence "PUBLIC_SCRIPTABLE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 10 ;
        mlt:effortDaysLow 5 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Crocodylian cranial GM is an active literature (e.g. Dryad 10.5061/dryad.14fn1) but is not framed as a test of Thompson's Fig. 383" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "-" ;
        mlt:loopPromptSha256 "c46b2772963325fae0b5c38bc27b936946bdf22e9fbc47ad84bb33b1ca1b7aa3" ;
        mlt:loopQueueSlot "thompson1917-t1917-051 (slot 241 in thompson/thompson_1917_loop_queue.yaml)" ;
        mlt:pass2Status "UNTESTED" ;
        mlt:step5Status "PENDING: Steps 1-4 completed 2026-10-26 (claim cited, assessment UNTESTED, dataset PUBLIC_SCRIPTABLE via Dryad, loop slot queued and prompt generated). Step 5 (loop execution) not yet dispatched." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;

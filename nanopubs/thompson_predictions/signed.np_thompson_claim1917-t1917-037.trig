sub:assertion {
    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 claim registry (59 claims, all dated 1917)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 literature counterclaim layer" ;
        mlt:bytes 54663 ;
        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-037> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-037 -- Ch. XVI, pp. 670-718, Figs. 335" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XVI" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVI, pp. 670-718, Figs. 335." ;
        mlt:claim "Trabecular bone is arranged along the principal stress trajectories of the bone, as in Culmann's crane-head diagram applied to the human femur (the trajectorial theory)." ;
        mlt:claimId "T1917-037" ;
        mlt:claimType "quantitative-geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "335" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-037> ;
        mlt:pages "670-718" ;
        mlt:repo2026AssessmentNotLiterature "A classic claim with a mixed modern verdict (alignment is real but partial and load-history dependent). A quantitative alignment score on public femur CT would be a genuine repo contribution." ;
        mlt:repo2026StatusSeparate "UNTESTED" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-037> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-037 (Thompson 1917): MIXED -- Venieratos et al. (1987) FOR; Skedros & Baucom (2007) AGAINST the strict form" ;
        mlt:counterclaim "The trajectorial theory (Wolff/Culmann, endorsed by Thompson, Fig. 335) has a split quantitative verdict. FOR: in frontal sections of human femora, trabecular direction converges on principal stress direction with a mean divergence of only +/-7 deg, better where stress is higher (1987). AGAINST the strict form: femoral-neck trabecular systems are systematically NON-orthogonal (~70 deg, not the 90 deg orthogonal trajectories the theory requires), and non-orthogonal (~60 deg) alignment cuts shear coupling by 33-75% under multidirectional loading -- i.e. real bone beats Thompson/Wolff's predicted arrangement at the real task." ;
        mlt:literatureCitation "Venieratos et al. (1987), human femur (PubMed 3631524); Skedros, J.G. & Baucom, S.L. (2007) J. Theor. Biol. 244 (doi:10.1016/j.jtbi.2006.06.029)" ;
        mlt:literatureRelation "MIXED" ;
        mlt:literatureWhoAndWhen "Venieratos et al. (1987) FOR; Skedros & Baucom (2007) AGAINST the strict form" ;
        mlt:quantitativeMargin "+/-7 deg alignment (support, 1987) vs ~70 deg instead of 90 deg intersections and 33-75% shear-coupling advantage of the non-Thompson arrangement (2007)" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-037> .
}


sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Leiognathidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Leiognathidae at 38.8 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Leiognathidae lineage at 38.8 Ma given 3 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 38.82 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0178 ;
        mlt:expectedProcrustesRMSThompson7 0.0246 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Leiognathidae dated to 39 +/- 8 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.474, 0.595] falsifies this prediction (point estimate 0.535); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Leiognathidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Leiognathidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Leiognathidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Leiognathidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Leiognathidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Leiognathidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Leiognathidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Leiognathidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 3 ;
        mlt:predictedLandmarksFull30 "[[-0.23808, -0.04572], [-0.26578, 0.01224], [-0.02146, 0.17052], [0.35894, 0.04181], [0.40025, 0.03658], [0.40125, -0.02095], [0.35638, -0.02823], [0.11374, -0.17864], [-0.05582, -0.01973], [-0.03049, -0.0635], [-0.08679, 0.05368], [-0.12677, 0.04396], [-0.14034, -0.08636], [-0.209, -0.09497], [-0.21492, 0.01746], [-0.14824, 0.01864], [-0.09287, 0.14321]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.236, -0.05769], [-0.27015, 0.0025], [-0.04199, 0.15275], [0.35593, 0.05123], [0.41888, 0.0477], [0.40194, -0.03057], [0.33336, -0.04836], [0.1343, -0.14716], [-0.04892, -0.03615], [-0.04441, -0.09276], [-0.07226, 0.06743], [-0.12034, 0.03991], [-0.14899, -0.0802], [-0.2152, -0.08529], [-0.20775, 0.03605], [-0.15376, 0.03422], [-0.08462, 0.14641]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Leiognathidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Leiognathidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.5138 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.5733 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.6311 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Leiognathidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;

sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-037-on-form-and-mechanical-efficiency> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-037 — Thompson (1917), Ch. XVI, pp. 670-718, Figs. 335" ;
        prov:wasRevisionOf sub:RACaQ226Sl_qqYbizsR6UPU6B-UoT59Q7NH58ziiuA02o ;
        mlt:automationTier "HUMAN_REQUIRED" ;
        mlt:candidateDataset <https://doi.org/10.5061/dryad.mf3rb> ;
        mlt:candidateDatasetTitle "Data from: Glucagon-like peptide-1 receptor agonist Liraglutide has anabolic bone effects in ovariectomized rats without diabetes" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVI, pp. 670-718, Figs. 335." ;
        mlt:claim "Trabecular bone is arranged along the principal stress trajectories of the bone, as in Culmann's crane-head diagram applied to the human femur (the trajectorial theory)." ;
        mlt:claimId "T1917-037" ;
        mlt:counterclaim "The trajectorial theory (Wolff/Culmann, endorsed by Thompson, Fig. 335) has a split quantitative verdict. FOR: in frontal sections of human femora, trabecular direction converges on principal stress direction with a mean divergence of only +/-7 deg, better where stress is higher (1987). AGAINST the strict form: femoral-neck trabecular systems are systematically NON-orthogonal (~70 deg, not the 90 deg orthogonal trajectories the theory requires), and non-orthogonal (~60 deg) alignment cuts shear coupling by 33-75% under multidirectional loading -- i.e. real bone beats Thompson/Wolff's predicted arrangement at the real task." ;
        mlt:dataKindNeeded "femur (micro-)CT + FE stress field" ;
        mlt:datasetAuditReason "Needs licensed femur CT + a pre-specified FE model; MorphoSource download is scriptable but specimen/model choice is a human seed decision that changes the verdict" ;
        mlt:datasetExistence "PUBLIC_CANDIDATE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 28 ;
        mlt:effortDaysLow 14 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Venieratos et al. (1987), human femur (PubMed 3631524); Skedros, J.G. & Baucom, S.L. (2007) J. Theor. Biol. 244 (doi:10.1016/j.jtbi.2006.06.029)" ;
        mlt:literatureRelation "MIXED" ;
        mlt:literatureWhoAndWhen "Venieratos et al. (1987) FOR; Skedros & Baucom (2007) AGAINST the strict form" ;
        mlt:pass2Status "UNTESTED" ;
        mlt:quantitativeMargin "+/-7 deg alignment (support, 1987) vs ~70 deg instead of 90 deg intersections and 33-75% shear-coupling advantage of the non-Thompson arrangement (2007)" ;
        mlt:step5Status "BLOCKED before Step 5: HUMAN_REQUIRED -- Needs licensed femur CT + a pre-specified FE model; MorphoSource download is scriptable but specimen/model choice is a human seed decision that changes the verdict" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_claims.json (repo artifact)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_dataset_audit.json (repo artifact)" ;
        mlt:bytes 96343 ;
        mlt:sha256 "a0bc797767654ca4e951b1b3683a773923448b02124a61259e89cccd7a071f1a" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_loop_queue.yaml (repo artifact)" ;
        mlt:bytes 51327 ;
        mlt:sha256 "1d017aa92fb9cf889af47a1a631a328e1f204c1e12b930db1839b482c6f44d61" .
}


    <https://w3id.org/morpholib/thompson/claim/t1917-028> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-028 -- Ch. XI, pp. 493-586, Figs. 304-307" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XI" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XI, pp. 493-586, Figs. 304-307." ;
        mlt:claim "In Nautilus the shell spiral and the septa bear the stated geometric relations (septa meeting the wall, spiral as evolute/involute relations he diagrams)." ;
        mlt:claimId "T1917-028" ;
        mlt:claimType "geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "304-307" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-028> ;
        mlt:pages "493-586" ;
        mlt:repo2026AssessmentNotLiterature "Directly measurable on a Nautilus section/radiograph; never scored." ;
        mlt:repo2026StatusSeparate "UNTESTED" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-028> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-028 (Thompson 1917): NO_DIRECT_TEST -- -" ;
        mlt:counterclaim "No direct test of his stated septal relations found. Open (and cheap to close -- see dataset audit)." ;
        mlt:literatureCitation "Nautilus buoyancy/CT literature (e.g. Dryad 10.5061/dryad.fc4vf, chambered-shell CT) measures function, not Thompson's septum/spiral geometry" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "-" ;
        mlt:noDirectTestFoundAsOf "2026-10-26"^^xsd:date ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:statementOfAbsence "As of this literature review (2026-10-26), no published work directly tests this 1917 claim as Thompson stated it. Neighbouring results are not a test of this claim." ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-028> .
}


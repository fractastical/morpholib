    <https://w3id.org/morpholib/thompson/claim/t1917-020> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-020 -- Ch. VII, pp. 293-345, Figs. 136-175 (with Ch. VIII)" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "VII" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. VII, pp. 293-345, Figs. 136-175 (with Ch. VIII)." ;
        mlt:claim "Sachs's rules describe cell division in plant tissues: daughter cells tend to equal volume, new walls meet old walls at right angles and follow minimal-area configurations." ;
        mlt:claimId "T1917-020" ;
        mlt:claimType "geometric-empirical" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "136-175 (with Ch. VIII)" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-020> ;
        mlt:pages "293-345" ;
        mlt:repo2026AssessmentNotLiterature "Tested extensively in modern plant morphogenesis (Errera's rule etc.); supported in refined form. No repo reproduction." ;
        mlt:repo2026StatusSeparate "DONE_ELSEWHERE" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-020> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-020 (Thompson 1917): SUPPORTED -- Modern plant morphogenesis (Errera's-rule literature, 2000s-)" ;
        mlt:counterclaim "No substantive counterclaim; Sachs/Errera rules survive in refined, mechanically informed form. Thompson was reporting and endorsing Sachs, and the literature kept the rule, not the refutation." ;
        mlt:literatureCitation "Errera (1888) origin; modern tests in meristem imaging literature" ;
        mlt:literatureRelation "SUPPORTED" ;

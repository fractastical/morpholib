sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-019-the-forms-of-tissues-or-cell-aggrega> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-019 — Thompson (1917), Ch. VII, pp. 293-345, Figs. 120-127" ;
        prov:wasRevisionOf sub:RAbNJ_sydtEB6iTnATIasRnikI-U5bvHgqtbH-JD0aI5k ;
        mlt:automationTier "LOOP_WITH_SEED" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. VII, pp. 293-345, Figs. 120-127." ;
        mlt:claim "Tissue cells tessellate approximately as hexagons / as a froth, the configuration that partitions area with least perimeter." ;
        mlt:claimId "T1917-019" ;
        mlt:counterclaim "Epithelial polygon distributions are froth-like but *not* simply 'hexagons tile best': proliferating epithelia have a characteristic polygon spectrum (substantial pentagon/heptagon fractions) explained by division topology, not by perimeter minimisation alone. Thompson's froth analogy survives, his implied hexagonal optimum does not describe growing tissue." ;
        mlt:dataKindNeeded "segmented epithelium images (same as T1917-018)" ;
        mlt:datasetAuditReason "Thompson's own 1917 figures / public-domain plates are fetchable from the pinned IA scan; loop digitises them." ;
        mlt:datasetExistence "PUBLIC_SCRIPTABLE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 6 ;
        mlt:effortDaysLow 3 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Gibson, M.C. et al. (2006) Nature 442:1038-1041; Farhadifar et al. (2007)" ;
        mlt:literatureRelation "QUALIFIED" ;
        mlt:literatureWhoAndWhen "Gibson et al. (2006); Farhadifar et al. (2007)" ;
        mlt:pass2Status "PARTIAL_REPO" ;
        mlt:quantitativeMargin "Real epithelia: hexagons are only the modal class (~40-50% in the wing disc), with large 5- and 7-sided fractions" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset PUBLIC_SCRIPTABLE, tier LOOP_WITH_SEED); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .


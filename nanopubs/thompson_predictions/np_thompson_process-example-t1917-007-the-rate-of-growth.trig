        mlt:candidateDataset <https://doi.org/10.5061/dryad.nb25502>,
            <https://doi.org/10.5061/dryad.qz612jmhs>,
            <https://doi.org/10.5061/dryad.s448n5d>,
            <https://doi.org/10.5061/dryad.vq83bk3zz> ;
        mlt:candidateDatasetTitle "Data for: Predictable local adaptation in butterfly photoperiodism but not thermal performance along a latitudinal cline",
            "Data from: Development of sexual dimorphism in two sympatric skinks with different growth rates",
            "Data from: Richards’s equation and nonlinear mixed models applied to avian growth: why use them?",
            "Exceptional longevity in northern peripheral populations of Wels catfish (Silurus glanis)" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. III, pp. 50-155, Figs. 3-40." ;
        mlt:claim "Growth in size/weight over time follows a definite, plottable curve: rapid (near-compound-interest) early growth with a steadily diminishing specific rate of growth." ;
        mlt:claimId "T1917-007" ;
        mlt:counterclaim "Thompson's plotted growth curves are descriptive. Von Bertalanffy replaced curve-description with a mechanistic balance law (dW/dt = anabolism - catabolism) that predicts the curve family. Later qualification: the 'universal' 2/3 exponent in that law is not universal -- optimally fitted exponents vary widely; the von Bertalanffy function is 'weakly universal' for fish, not for non-fish (PeerJ 2018, 'On the exponent in the Von Bertalanffy growth model')." ;
        mlt:dataKindNeeded "growth time series (his figures + modern)" ;
        mlt:datasetAuditReason "Usable material already on disk (scout cache / portfolio / models); loop can ingest it directly." ;
        mlt:datasetExistence "IN_REPO" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 6 ;
        mlt:effortDaysLow 3 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "von Bertalanffy, L. (1957) Q. Rev. Biol. 32:217-231" ;
        mlt:literatureRelation "SUPERSEDED" ;
        mlt:literatureWhoAndWhen "von Bertalanffy (1957)" ;
        mlt:pass2Status "DONE_ELSEWHERE" ;
        mlt:quantitativeMargin "Superseded as method, not refuted as data: no single growth curve/exponent fits all taxa" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset IN_REPO, tier FULL_LOOP); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,

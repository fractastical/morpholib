    <https://w3id.org/morpholib/thompson/process-instance/t1917-007-the-rate-of-growth> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-007 — Thompson (1917), Ch. III, pp. 50-155, Figs. 3-40" ;
        prov:wasRevisionOf <https://w3id.org/morpholib/thompson/np/process-example-t1917-007-the-rate-of-growth/RAwTwAlnaNIwdw4Zmh6B0RJR5_wNfWjSVePOhjITarD18> ;

        mlt:pointEstimate 0.4231 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.4813 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lethrinidae-thompson7-HL_over_SL> a mlt:PredictedRatio ;

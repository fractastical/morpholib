sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lethrinidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Lethrinidae at 65.3 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Lethrinidae lineage at 65.3 Ma given 20 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 65.31 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0349 ;
        mlt:expectedProcrustesRMSThompson7 0.0347 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Lethrinidae dated to 65 +/- 13 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.339, 0.457] falsifies this prediction (point estimate 0.395); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lethrinidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lethrinidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lethrinidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lethrinidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lethrinidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lethrinidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lethrinidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lethrinidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 20 ;
        mlt:predictedLandmarksFull30 "[[-0.23215, -0.05596], [-0.28499, -0.0059], [-0.04523, 0.1442], [0.32625, 0.05587], [0.42534, 0.04015], [0.42146, -0.04632], [0.32273, -0.06422], [0.1753, -0.12566], [-0.05327, -0.02958], [-0.03783, -0.07393], [-0.08474, 0.06353], [-0.1257, 0.04077], [-0.14206, -0.07589], [-0.20558, -0.07642], [-0.21616, 0.03785], [-0.15432, 0.03948], [-0.08906, 0.13203]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.23219, -0.05253], [-0.27296, -0.00473], [-0.04457, 0.14684], [0.34373, 0.04934], [0.41033, 0.03938], [0.41084, -0.04522], [0.34169, -0.05461], [0.17167, -0.13396], [-0.05553, -0.02633], [-0.03728, -0.07648], [-0.08558, 0.06552], [-0.13228, 0.03797], [-0.1436, -0.06749], [-0.20625, -0.07442], [-0.21584, 0.02855], [-0.16424, 0.03083], [-0.08795, 0.13734]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Lethrinidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lethrinidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.458 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.5106 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5691 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lethrinidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3391 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3954 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.4565 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lethrinidae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2646 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2899 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.3186 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lethrinidae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3687 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4044 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.4444 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lethrinidae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.4845 ;

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mlt: <https://w3id.org/morpholib/thompson/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/morpholib/thompson/np/fossiltest-Eoleiognathus-dorsalis/RA5U8jkRqp0sUyCBqUnBpYaYAsM2Nq2UNDC8NXGfwtinI/> .
@prefix this: <https://w3id.org/morpholib/thompson/np/fossiltest-Eoleiognathus-dorsalis/RA5U8jkRqp0sUyCBqUnBpYaYAsM2Nq2UNDC8NXGfwtinI> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Eoleiognathus-dorsalis> a mlt:FossilPredictionTest ;
        rdfs:label "Monte Bolca test: Eoleiognathus dorsalis (Leiognathidae) vs. predicted Leiognathidae lineage at 50 Ma" ;
        dcterms:bibliographicCitation "Bannikov A.F. (2014) Studi e Ricerche sui Giacimenti Terziari di Bolca XV: neotype MCSNV T94/T95, 24.5 mm SL, maximum body depth 48% SL." ;
        mlt:ageMa 50.0 ;
        mlt:family "Leiognathidae" ;
        mlt:fossilTaxon "Eoleiognathus dorsalis" ;
        mlt:hasMeasurementComparison <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Eoleiognathus-dorsalis-BDmax_over_SL> ;
        mlt:nullHypothesis "phylogenetic stasis: fossil proportions equal the living family mean" ;
        mlt:phylogeneticPlacement "putative stem Leiognathidae (new subfamily Eoleiognathinae); formerly 'Pygaeus dorsalis'" ;
        mlt:testsPrediction <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Leiognathidae> ;
        mlt:verdictBodyDepth "consistent with the prediction" .

    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Eoleiognathus-dorsalis-BDmax_over_SL> a mlt:MeasurementComparison ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length" ;
        mlt:directionOfChangeCorrect true ;
        mlt:fossilInsidePredictiveInterval95 true ;
        mlt:fossilValueLower 0.48 ;
        mlt:fossilValueUpper 0.48 ;
        mlt:livingFamilyMean 0.5504 ;
        mlt:predictedFull30 0.5239 ;
        mlt:predictedFull30Lower95 0.4518 ;
        mlt:predictedFull30Upper95 0.5889 ;
        mlt:predictedThompson7 0.4554 ;
        mlt:predictionCloserThanStasisNull true ;
        mlt:ratioName "BDmax_over_SL" .
}

sub:pubinfo {
    sub:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy orcid:0009-0007-4948-9192 .

    this: dcterms:created "2026-10-22"^^xsd:date ;
        dcterms:creator orcid:0009-0007-4948-9192 ;
        dcterms:isPartOf <https://github.com/fractastical/morpholib/blob/main/docs/THOMPSON_PHYLOGENETIC_PREDICTIONS.md> ;
        dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> .

    orcid:0009-0007-4948-9192 rdfs:label "Joel Dietz" .
}


<https://w3id.org/morpholib/thompson/np/cross-kingdom-synthesis-2026-10-23/assertion> {
    <https://w3id.org/morpholib/thompson/synthesis/cross-kingdom-synthesis-2026-10-23> a mlt:CrossKingdomMorphospaceSynthesis ;
        rdfs:label "Cross-Kingdom Thompsonian Morphospace Hierarchy & Pre-Registered Portfolio Synthesis Across 15 Clade Studies (>32,000 Specimens, 82 2D GM Hypotheses + 9 Fish Portfolio Claims)" ;
        dcterms:description "Synthesizes the complete pre-registered evaluation of D'Arcy Thompson's (1917) 7 global coordinate transformation modes across Mollusca (bivalve shells: 85.0% T7), Angiospermae (Gesneriaceae corollas: 82.1% T7, intraspecific-to-macro alignment |cos theta|_T7 = 0.978), Arthropoda (Camponotus ant pronotum 92.9% & frontal head 81.2%; Drosophilidae wings 71.3%; Pheidole ant heads 50.4%; Morpho butterfly wings 49.0% FW / 57.0% HW; Anthophila bee wings 42.2%; Vespinae hornet wings 38.8%), and Chordata (Anseriformes waterfowl beaks 91.1%; Australian Anura frogs 66.2%; Varanus monitor lizard crania 59.5%; Indo-Pacific reef fishes 57.9%; Characiformes 55.5%; Leporidae mammalian crania 51.1%; Lake Tanganyika cichlids 47.2%). Continuous accretionary shells, rhamphothecal/sclerite capsules, and fused floral tubes concentrate 80%-93% of interspecific shape variance in Thompson's 7 global coordinate modes, whereas structures with internal modular sutures or interior vein intersections drop to 39%-51%." ;
        mlt:evaluatesPortfolio <https://w3id.org/morpholib/thompson/np/dataset-portfolio-2026-10-22/RA9ZKlSDsa68lEKRo7JR0Px5woGoCMUHRlSK_bHKag4EA> ;
        mlt:fishBlindTestAnchor <https://w3id.org/morpholib/thompson/np/blind-test-outcome-2026-10-22/RAJancwGOPEkHzBoZXGv_vu_snW0Lff2FktE85Me1P-fI> ;
        mlt:includesCladeOutcome <https://w3id.org/morpholib/thompson/np/clade-gm-antillean-flowers/RAW798M2XinuBxpIK5Msg8Ly65L2R-pOQ4DyD6zIo0TbI>,
            <https://w3id.org/morpholib/thompson/np/clade-gm-australian-frogs/RAljVmhuQgsbFNJKD7ubpEpHA-14TCGbxL1z2KxpCdmFs>,
            <https://w3id.org/morpholib/thompson/np/clade-gm-bee-wings/RAM0hghia4RyO9UTsqHaidVyxsXIictWSPgKTtovw3HWI>,

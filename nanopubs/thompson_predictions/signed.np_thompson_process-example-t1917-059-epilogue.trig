sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-059-epilogue> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-059 — Thompson (1917), Ch. Epilogue, pp. ~777-788, Figs. -" ;
        prov:wasRevisionOf sub:RAsvae3d_K1c6cj_7hUmPW7WKrwk6m-T2BBkxf9pqm6Do ;
        mlt:automationTier "NA" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. Epilogue, pp. ~777-788, Figs. -." ;
        mlt:claim "(Restatement) Form is not exhaustively explained by natural selection on independent parts; physical/mathematical law constrains the forms available to evolution." ;
        mlt:claimId "T1917-059" ;
        mlt:counterclaim "Restatement of T1917-002: the literature's verdict is the constraint/selection synthesis, not a win for either 1917 or a purely adaptationist reading." ;
        mlt:dataKindNeeded "none (restatement)" ;
        mlt:datasetAuditReason "Not testable as stated; no dataset settles it (operationalise first)." ;
        mlt:datasetExistence "NOT_TESTABLE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 1 ;
        mlt:effortDaysLow 1 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Gould (1971); Gould & Lewontin (1979)" ;
        mlt:literatureRelation "NOT_TESTABLE" ;
        mlt:literatureWhoAndWhen "Gould (1971; 1980s) -- see T1917-002" ;
        mlt:pass2Status "NOT_TESTABLE_AS_STATED" ;
        mlt:step5Status "NOT QUEUED: not testable as stated, analytic, or unprobed; see dataset audit." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .


sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-033-on-leaf-arrangement-or-phyllotaxis> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-033 — Thompson (1917), Ch. XIV, pp. 635-651, Figs. 325-327" ;
        prov:wasRevisionOf sub:RAsf8MWwsdfXHkB3WwXwfKiWBc7htry0ux1GAAHItxVgY ;
        mlt:automationTier "FULL_LOOP" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XIV, pp. 635-651, Figs. 325-327." ;
        mlt:claim "Leaf/floret divergence approximates the golden (Fibonacci) angle (~137.5 deg), with rational approximations 1/2, 1/3, 2/5, 3/8... and Fibonacci numbers of parastichies." ;
        mlt:claimId "T1917-033" ;
        mlt:counterclaim "No counterclaim -- the opposite. Douady & Couder produced Fibonacci phyllotaxis and the golden angle (~137.5 deg) in a purely physical system (repelling ferrofluid drops), with no botanical machinery: the pattern is what a self-organising repulsive system does. This supports Thompson's physicalist reading and refutes only the mystical/numerological readings Thompson himself disliked." ;
        mlt:dataKindNeeded "capitulum/stem images (measure divergence)" ;
        mlt:datasetAuditReason "Usable material already on disk (scout cache / portfolio / models); loop can ingest it directly." ;
        mlt:datasetExistence "IN_REPO" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 6 ;
        mlt:effortDaysLow 3 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Douady, S. & Couder, Y. (1992) Phys. Rev. Lett. 68:2098-2101" ;
        mlt:literatureRelation "SUPPORTED" ;
        mlt:literatureWhoAndWhen "Douady & Couder (1992)" ;
        mlt:pass2Status "PARTIAL_REPO" ;
        mlt:quantitativeMargin "Golden angle 137.5 deg and Fibonacci parastichies emerge from one control parameter (drop periodicity) in vitro (1992)" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset IN_REPO, tier FULL_LOOP); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_claims.json (repo artifact)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json> a prov:Entity ;

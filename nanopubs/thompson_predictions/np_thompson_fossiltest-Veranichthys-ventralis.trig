<https://w3id.org/morpholib/thompson/np/fossiltest-Veranichthys-ventralis/assertion> {
    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Veranichthys-ventralis> a mlt:FossilPredictionTest ;
        rdfs:label "Monte Bolca test: Veranichthys ventralis (Lutjanidae) vs. predicted Lutjanidae lineage at 50 Ma" ;
        dcterms:bibliographicCitation "Bannikov A.F. (2006) Geodiversitas 28(2): 249-275, Table 3 (lectotype MNHN Bol 275 and paralectotype Bol 24): head length 32 (30), maximum body depth 34 (34), snout to spiny dorsal fin 40 (39) % SL." ;
        mlt:ageMa 50.0 ;
        mlt:family "Lutjanidae" ;
        mlt:fossilTaxon "Veranichthys ventralis" ;
        mlt:hasMeasurementComparison <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Veranichthys-ventralis-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Veranichthys-ventralis-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Veranichthys-ventralis-PD_over_SL> ;
        mlt:nullHypothesis "phylogenetic stasis: fossil proportions equal the living family mean" ;
        mlt:phylogeneticPlacement "Lutjanidae (new genus for Serranus ventralis Agassiz)" ;
        mlt:testsPrediction <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Lutjanidae> ;
        mlt:verdictBodyDepth "outside the 95% predictive interval (prediction falsified as stated, subject to the fossil's placement on the lineage)" .

    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Veranichthys-ventralis-BDmax_over_SL> a mlt:MeasurementComparison ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length" ;
        mlt:directionOfChangeCorrect false ;
        mlt:fossilInsidePredictiveInterval95 false ;
        mlt:fossilValueLower 0.34 ;
        mlt:fossilValueUpper 0.34 ;
        mlt:livingFamilyMean 0.3769 ;
        mlt:predictedFull30 0.407 ;
        mlt:predictedFull30Lower95 0.3544 ;
        mlt:predictedFull30Upper95 0.4595 ;
        mlt:predictedThompson7 0.4218 ;
        mlt:predictionCloserThanStasisNull false ;
        mlt:ratioName "BDmax_over_SL" .

    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Veranichthys-ventralis-HL_over_SL> a mlt:MeasurementComparison ;
        rdfs:label "head length / standard length" ;
        mlt:directionOfChangeCorrect false ;
        mlt:fossilInsidePredictiveInterval95 true ;
        mlt:fossilValueLower 0.3 ;
        mlt:fossilValueUpper 0.32 ;
        mlt:livingFamilyMean 0.291 ;
        mlt:predictedFull30 0.284 ;
        mlt:predictedFull30Lower95 0.2603 ;
        mlt:predictedFull30Upper95 0.3082 ;
        mlt:predictedThompson7 0.2767 ;
        mlt:predictionCloserThanStasisNull false ;
        mlt:ratioName "HL_over_SL" .

    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Veranichthys-ventralis-PD_over_SL> a mlt:MeasurementComparison ;
        rdfs:label "predorsal length / standard length" ;
        mlt:directionOfChangeCorrect true ;
        mlt:fossilInsidePredictiveInterval95 true ;
        mlt:fossilValueLower 0.39 ;
        mlt:fossilValueUpper 0.4 ;
        mlt:livingFamilyMean 0.4175 ;
        mlt:predictedFull30 0.4086 ;
        mlt:predictedFull30Lower95 0.3752 ;
        mlt:predictedFull30Upper95 0.4426 ;
        mlt:predictedThompson7 0.4116 ;
        mlt:predictionCloserThanStasisNull true ;
        mlt:ratioName "PD_over_SL" .
}


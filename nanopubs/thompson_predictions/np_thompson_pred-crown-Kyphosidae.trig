<https://w3id.org/morpholib/thompson/np/pred-crown-Kyphosidae/assertion> {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Kyphosidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Kyphosidae at 39.0 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Kyphosidae lineage at 39.0 Ma given 4 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 39.02 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0178 ;
        mlt:expectedProcrustesRMSThompson7 0.0251 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Kyphosidae dated to 39 +/- 8 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.408, 0.536] falsifies this prediction (point estimate 0.472); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Kyphosidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Kyphosidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Kyphosidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Kyphosidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Kyphosidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Kyphosidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Kyphosidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Kyphosidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 4 ;
        mlt:predictedLandmarksFull30 "[[-0.2277, -0.03733], [-0.25671, 0.00167], [-0.03593, 0.16231], [0.33934, 0.05441], [0.41701, 0.04303], [0.41328, -0.04289], [0.33639, -0.05478], [0.17865, -0.14804], [-0.06897, -0.03219], [-0.04832, -0.07589], [-0.08889, 0.05445], [-0.13625, 0.02466], [-0.13923, -0.06094], [-0.2066, -0.06378], [-0.2175, 0.01787], [-0.16407, 0.0192], [-0.09452, 0.13825]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.22568, -0.04808], [-0.26384, -0.00231], [-0.04158, 0.14451], [0.34036, 0.05746], [0.41396, 0.04908], [0.41553, -0.04873], [0.33964, -0.06004], [0.17363, -0.14445], [-0.06661, -0.02698], [-0.04441, -0.07749], [-0.093, 0.0637], [-0.13799, 0.03667], [-0.14459, -0.06525], [-0.20027, -0.06971], [-0.21349, 0.02804], [-0.1673, 0.02989], [-0.08438, 0.13369]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Kyphosidae" .


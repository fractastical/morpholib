sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lutjanidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Lutjanidae at 52.9 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Lutjanidae lineage at 52.9 Ma given 31 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 52.87 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0242 ;
        mlt:expectedProcrustesRMSThompson7 0.0298 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Lutjanidae dated to 53 +/- 11 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.353, 0.457] falsifies this prediction (point estimate 0.406); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lutjanidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lutjanidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lutjanidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lutjanidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lutjanidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lutjanidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lutjanidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lutjanidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 31 ;
        mlt:predictedLandmarksFull30 "[[-0.2241, -0.05732], [-0.28111, 3e-05], [-0.04395, 0.1463], [0.3367, 0.0499], [0.4202, 0.03626], [0.41869, -0.0461], [0.32361, -0.06233], [0.184, -0.12656], [-0.06001, -0.02536], [-0.04082, -0.06853], [-0.0878, 0.06444], [-0.13337, 0.03898], [-0.13501, -0.07059], [-0.19566, -0.07664], [-0.22042, 0.03164], [-0.16846, 0.03259], [-0.09248, 0.13327]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.22588, -0.05205], [-0.27199, -0.00546], [-0.04364, 0.1461], [0.34461, 0.04673], [0.41422, 0.0356], [0.40907, -0.04702], [0.33802, -0.05487], [0.18067, -0.13031], [-0.06062, -0.02482], [-0.03523, -0.07398], [-0.09361, 0.06556], [-0.1397, 0.03811], [-0.13888, -0.06583], [-0.19683, -0.07327], [-0.22036, 0.02809], [-0.17058, 0.03083], [-0.08927, 0.13659]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Lutjanidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lutjanidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.4814 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.5287 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5739 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lutjanidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;

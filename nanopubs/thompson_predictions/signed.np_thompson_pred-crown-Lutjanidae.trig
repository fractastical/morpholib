    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Lutjanidae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;

    <https://w3id.org/morpholib/thompson/claim/t1917-034> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-034 -- Ch. XV, pp. 652-669, Figs. 328-330" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XV" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XV, pp. 652-669, Figs. 328-330." ;
        mlt:claim "Birds' (and other hard-shelled) eggs are solids of revolution whose meridian curves form a definite, species-varying family of ovoids, comparable geometrically across species." ;
        mlt:claimId "T1917-034" ;
        mlt:claimType "geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "328-330" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-034> ;
        mlt:pages "652-669" ;
        mlt:repo2026AssessmentNotLiterature "Modern egg-shape literature (e.g. universal egg formula work, 2021) postdates and partly supersedes him; a repo test on museum egg outlines is straightforward and has not been done." ;
        mlt:repo2026StatusSeparate "UNTESTED" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-034> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-034 (Thompson 1917): SUPERSEDED -- Stoddard et al. (2017); Birkhead et al. (2019); Narushin et al. (2021)" ;
        mlt:counterclaim "Thompson's descriptive ovoid family was superseded twice over. (1) Mechanism: Stoddard et al. (2017), 49,000 eggs / 1,400 species -- egg shape is set by the membrane (pressure/stiffness), and correlates with flight ability; but flight explains little, and Birkhead et al. (2019) counter-counterclaim that incubation site/posture explains 70-85% in alcids/penguins. (2) Description: a 2021 'universal' egg formula with 4 parameters now does the describing. Nobody's ovoid curve, Thompson's included, is the standard anymore." ;
        mlt:literatureCitation "Stoddard, M.C. et al. (2017) Science 356:1249-1254; Birkhead, T.R. et al. (2019) Ibis 161; Narushin, V.G. et al. (2021) Ann. N.Y. Acad. Sci. (universal egg formula)" ;
        mlt:literatureRelation "SUPERSEDED" ;
        mlt:literatureWhoAndWhen "Stoddard et al. (2017); Birkhead et al. (2019); Narushin et al. (2021)" ;
        mlt:quantitativeMargin "Flight (hand-wing index) explains only ~4% of egg-shape variation (Stoddard 2017, as re-analysed); incubation site >60%, models 70-85% (Birkhead 2019) -- Thompson's geometry-only account has no explanatory variable at all" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-034> .
}


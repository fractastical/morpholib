sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-014-the-forms-of-cells> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-014 — Thompson (1917), Ch. V, pp. 201-276, Figs. 61-67, 72-96" ;
        prov:wasRevisionOf sub:RAOLQiUUlqjuafDnvVJlaCc608dcJDVLfAA-I3fXVoWi4 ;
        mlt:automationTier "FULL_LOOP" ;
        mlt:candidateDataset <https://doi.org/10.5061/dryad.28816>,
            <https://doi.org/10.5061/dryad.3bk3j9kqh>,
            <https://doi.org/10.5061/dryad.7d7wm37zr>,
            <https://doi.org/10.5061/dryad.ns341>,
            <https://doi.org/10.5061/dryad.sn02v6x26> ;
        mlt:candidateDatasetTitle "Data from: Geometric morphometric character suites as phylogenetic data: extracting phylogenetic signal from gastropod shells",
            "Data from: Heterochronic origin of spherical fusulinid foraminifera in the Late Paleozoic",
            "Data from: Ocean acidification induces biochemical and morphological changes in the calcification process of large benthic foraminifera",
            "Occurrences of velapertina indigena, orbulina suturalis, and praeorbulina glomerosa circularis within the central paratethys",
            "Size and shape data of Globigerinoidesella fistulosa, Trilobatus sacculifer and intermediate specimens from ODP Site 1115" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. V, pp. 201-276, Figs. 61-67, 72-96." ;
        mlt:claim "The forms of single cells and cell-like organisms (Plateau's oil globules; Lagena and other forams/protists) are surfaces of revolution from the minimal-surface catalogue: sphere, cylinder, unduloid, nodoid, catenoid." ;
        mlt:claimId "T1917-014" ;
        mlt:counterclaim "Constant-mean-curvature (Plateau/Delaunay) shapes are a good model for suspended cells and a measurably wrong one for adherent/structured cells: observed-vs-minimised shape discrepancy is large in L- and V-shaped micropatterns (spectral amplitude difference ~0.15-0.18) and small in triangular patterns (~0.03). Thompson's catalogue is a limiting case, not the general rule." ;
        mlt:dataKindNeeded "protist/foram outlines (his figures + modern images)" ;
        mlt:datasetAuditReason "Dryad live search returned 2 title-relevant dataset(s), top: doi:10.5061/dryad.28816." ;
        mlt:datasetExistence "PUBLIC_SCRIPTABLE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 10 ;
        mlt:effortDaysLow 5 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "'Modelling cell shape in 3D structured environments' (2023) PLOS Comput. Biol. 19:e1011412" ;
        mlt:literatureRelation "QUALIFIED" ;
        mlt:literatureWhoAndWhen "Modern cell-mechanics comparisons (e.g. PLOS Comput. Biol. 2023, cell shape vs minimal surfaces)" ;
        mlt:pass2Status "PARTIAL_REPO" ;
        mlt:quantitativeMargin "Discrepancy ~0.15-0.18 (L/V patterns) vs ~0.03 (triangular): context decides, contra a universal surface-tension law" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset PUBLIC_SCRIPTABLE, tier FULL_LOOP); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_claims.json (repo artifact)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_dataset_audit.json (repo artifact)" ;
        mlt:bytes 96343 ;
        mlt:sha256 "a0bc797767654ca4e951b1b3683a773923448b02124a61259e89cccd7a071f1a" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> a prov:Entity ;

<https://w3id.org/morpholib/thompson/np/pred-crown-Pempheridae/assertion> {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pempheridae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Pempheridae at 43.3 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Pempheridae lineage at 43.3 Ma given 3 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 43.32 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0178 ;
        mlt:expectedProcrustesRMSThompson7 0.0247 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Pempheridae dated to 43 +/- 9 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.333, 0.476] falsifies this prediction (point estimate 0.402); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pempheridae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pempheridae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pempheridae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pempheridae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pempheridae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pempheridae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pempheridae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pempheridae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 3 ;
        mlt:predictedLandmarksFull30 "[[-0.22772, -0.05752], [-0.27207, 0.03426], [0.01721, 0.12379], [0.20331, 0.0822], [0.4445, 0.03292], [0.44377, -0.04047], [0.38517, -0.04166], [0.13517, -0.15499], [-0.06263, -0.03969], [-0.02799, -0.07095], [-0.07982, 0.0557], [-0.12679, 0.04363], [-0.16021, -0.06943], [-0.20577, -0.06737], [-0.23653, 0.02841], [-0.15282, 0.02475], [-0.0768, 0.11641]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.24064, -0.04106], [-0.2566, 0.01017], [-0.02925, 0.13065], [0.31432, 0.05576], [0.39079, 0.05571], [0.43856, -0.03482], [0.35835, -0.05422], [0.18328, -0.15045], [-0.07581, -0.03358], [-0.06138, -0.08474], [-0.08433, 0.05684], [-0.12958, 0.03419], [-0.16445, -0.06653], [-0.22384, -0.06579], [-0.19876, 0.03382], [-0.15744, 0.03036], [-0.06321, 0.12369]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Pempheridae" .


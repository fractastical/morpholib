<https://w3id.org/morpholib/thompson/np/pred-crown-Cirrhitidae/assertion> {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Cirrhitidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Cirrhitidae at 39.5 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Cirrhitidae lineage at 39.5 Ma given 3 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 39.5 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0176 ;
        mlt:expectedProcrustesRMSThompson7 0.0246 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Cirrhitidae dated to 39 +/- 8 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.315, 0.442] falsifies this prediction (point estimate 0.380); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Cirrhitidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Cirrhitidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Cirrhitidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Cirrhitidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Cirrhitidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Cirrhitidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Cirrhitidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Cirrhitidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 3 ;
        mlt:predictedLandmarksFull30 "[[-0.21764, -0.06513], [-0.27502, -0.00358], [-0.06297, 0.1363], [0.34116, 0.04913], [0.4194, 0.04228], [0.41915, -0.04818], [0.31304, -0.06453], [0.1908, -0.11676], [-0.05927, -0.01897], [-0.0495, -0.09361], [-0.0668, 0.07009], [-0.13191, 0.03871], [-0.14375, -0.06617], [-0.19597, -0.07867], [-0.22629, 0.04235], [-0.18049, 0.04443], [-0.07391, 0.1323]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.22635, -0.05305], [-0.2712, -0.00299], [-0.04115, 0.14668], [0.34415, 0.04477], [0.41407, 0.03524], [0.409, -0.04276], [0.33738, -0.05252], [0.17941, -0.13164], [-0.06184, -0.02717], [-0.03696, -0.07767], [-0.09301, 0.06587], [-0.13935, 0.03876], [-0.14014, -0.06877], [-0.19779, -0.0758], [-0.21944, 0.03056], [-0.1701, 0.03201], [-0.08667, 0.13847]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Cirrhitidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Cirrhitidae-full30-BD_over_SL> a mlt:PredictedRatio ;

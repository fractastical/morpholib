sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-003-on-magnitude> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-003 — Thompson (1917), Ch. II, pp. 16-49, Figs. 1-2" ;
        prov:wasRevisionOf sub:RA6yILKrdN80kEinqyD16ddYM31JwIQrT41EX3PmtVwhs ;
        mlt:automationTier "FULL_LOOP" ;
        mlt:candidateDataset <https://doi.org/10.5061/dryad.905qfttgm>,
            <https://doi.org/10.5061/dryad.t06q9> ;
        mlt:candidateDatasetTitle "Data from: General models for the spectra of surface area scaling strategies of cells and organisms: fractality, geometric dissimilitude, and internalization",
            "The allometry of daily energy expenditure in hummingbirds: an energy budget approach" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. II, pp. 16-49, Figs. 1-2." ;
        mlt:claim "Surface grows as L^2 and volume/weight as L^3, so surface:volume falls as 1/L; this alone bounds organism size and forces disproportionate change of parts with size." ;
        mlt:claimId "T1917-003" ;
        mlt:counterclaim "The surface-law application (metabolism proportional to surface, M^2/3) was countered by Kleiber (1932): basal metabolic rate scales as ~M^3/4, not M^2/3. Glazier (2022) counters both: exponents are variable and context-dependent -- there is no universal 2/3 or 3/4. The pure geometry (area L^2, volume L^3) is not in dispute; its use as a metabolic law is." ;
        mlt:dataKindNeeded "analytic + size tables" ;
        mlt:datasetAuditReason "Dryad live search returned 2 title-relevant dataset(s), top: doi:10.5061/dryad.t06q9." ;
        mlt:datasetExistence "PUBLIC_SCRIPTABLE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 2 ;
        mlt:effortDaysLow 1 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Kleiber, M. (1932) Hilgardia 6:315-353; Glazier, D.S. (2022) Proc. R. Soc. B 289:20221605" ;
        mlt:literatureRelation "PARTIALLY_REFUTED" ;
        mlt:literatureWhoAndWhen "Kleiber (1932); Glazier (2022)" ;
        mlt:pass2Status "DONE_ELSEWHERE" ;
        mlt:quantitativeMargin "Exponent dispute: 0.67 (surface law) vs 0.73-0.75 (Kleiber 1932) vs 'no universal exponent' (Glazier 2022)" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset PUBLIC_SCRIPTABLE, tier FULL_LOOP); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_claims.json (repo artifact)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_dataset_audit.json (repo artifact)" ;
        mlt:bytes 96343 ;
        mlt:sha256 "a0bc797767654ca4e951b1b3683a773923448b02124a61259e89cccd7a071f1a" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> a prov:Entity ;

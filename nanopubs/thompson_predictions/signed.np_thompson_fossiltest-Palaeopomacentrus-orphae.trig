sub:assertion {
    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Palaeopomacentrus-orphae> a mlt:FossilPredictionTest ;
        rdfs:label "Monte Bolca test: Palaeopomacentrus orphae (Pomacentridae) vs. predicted Pomacentridae lineage at 50 Ma" ;
        dcterms:bibliographicCitation "Bellwood D.R. & Sorbini L. (1996) Zool. J. Linn. Soc. 117: 159-174. Holotype MCSNV IG 23692: SL 20.5 mm, maximum body depth 9.0 mm (43.9%); paratype BMNH P.5126: SL 29.5 mm, depth 15.0 mm (50.8%)." ;
        mlt:ageMa 50.0 ;
        mlt:family "Pomacentridae" ;
        mlt:fossilTaxon "Palaeopomacentrus orphae" ;
        mlt:hasMeasurementComparison <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Palaeopomacentrus-orphae-BDmax_over_SL> ;
        mlt:nullHypothesis "phylogenetic stasis: fossil proportions equal the living family mean" ;
        mlt:phylogeneticPlacement "oldest substantiated pomacentrid; 'relatively generalized Recent pomacentrid' body form" ;
        mlt:testsPrediction <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Pomacentridae> ;
        mlt:verdictBodyDepth "consistent with the prediction" .

    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Palaeopomacentrus-orphae-BDmax_over_SL> a mlt:MeasurementComparison ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length" ;
        mlt:directionOfChangeCorrect true ;
        mlt:fossilInsidePredictiveInterval95 true ;
        mlt:fossilValueLower 0.439 ;
        mlt:fossilValueUpper 0.508 ;
        mlt:livingFamilyMean 0.5008 ;
        mlt:predictedFull30 0.4676 ;
        mlt:predictedFull30Lower95 0.4204 ;
        mlt:predictedFull30Upper95 0.5148 ;
        mlt:predictedThompson7 0.4482 ;
        mlt:predictionCloserThanStasisNull true ;
        mlt:ratioName "BDmax_over_SL" .
}


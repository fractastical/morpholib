    <https://w3id.org/morpholib/thompson/claim/t1917-059> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-059 -- Ch. Epilogue, pp. ~777-788, Figs. -" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "Epilogue" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. Epilogue, pp. ~777-788, Figs. -." ;
        mlt:claim "(Restatement) Form is not exhaustively explained by natural selection on independent parts; physical/mathematical law constrains the forms available to evolution." ;
        mlt:claimId "T1917-059" ;
        mlt:claimType "methodological" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "-" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-059> ;
        mlt:pages "~777-788" ;
        mlt:repo2026AssessmentNotLiterature "Score only via descendants (T1917-002/039/050). Modern framing: developmental/physical constraint on morphospace occupation - the repo's horizon result is one quantified instance." ;
        mlt:repo2026StatusSeparate "NOT_TESTABLE_AS_STATED" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-059> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-059 (Thompson 1917): NOT_TESTABLE -- Gould (1971; 1980s) -- see T1917-002" ;
        mlt:counterclaim "Restatement of T1917-002: the literature's verdict is the constraint/selection synthesis, not a win for either 1917 or a purely adaptationist reading." ;
        mlt:literatureCitation "Gould (1971); Gould & Lewontin (1979)" ;
        mlt:literatureRelation "NOT_TESTABLE" ;
        mlt:literatureWhoAndWhen "Gould (1971; 1980s) -- see T1917-002" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-059> .

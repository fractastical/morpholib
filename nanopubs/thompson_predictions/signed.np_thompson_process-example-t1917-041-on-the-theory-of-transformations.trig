sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-041-on-the-theory-of-transformations> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-041 — Thompson (1917), Ch. XVII, pp. ~732, Figs. 359-360" ;
        prov:wasRevisionOf sub:RAhpAYW5EcJKCnS3i0Ih4-hI34s_czZzzWiPx2nyVBVR0 ;
        mlt:automationTier "FULL_LOOP" ;
        mlt:candidateDataset <https://doi.org/10.5061/dryad.0722ps8>,
            <https://doi.org/10.5061/dryad.4d786>,
            <https://doi.org/10.5061/dryad.6t1g1jxdh> ;
        mlt:candidateDatasetTitle "Data from: A modern ampelography: a genetic basis for leaf shape and venation patterning in Vitis vinifera",
            "Data from: Effectiveness of modern leaf analysis tools for the morpho-ecological study of plants: the case of Primula albenensis Banfi et Ferl",
            "Data from: LeafContourEFD: a reproducible workflow for biologically oriented elliptic Fourier analysis of leaf shape" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVII, pp. ~732, Figs. 359-360." ;
        mlt:claim "Lanceolate, ovate and cordate leaves are transforms of one another under radial (polar) coordinates about an arrest/base point; the Begonia leaf is an instance of the same radial system." ;
        mlt:claimId "T1917-041" ;
        mlt:counterclaim "No literature test of lanceolate->ovate->cordate leaf transformation under radial coordinates was found. (The repo has tested Thompson's Fig. 359 radial-cordate *formula* on ant heads -- an analogue, not this claim; see registry.) Open." ;
        mlt:dataKindNeeded "leaf outline images (herbaria/Commons)" ;
        mlt:datasetAuditReason "Usable material already on disk (scout cache / portfolio / models); loop can ingest it directly." ;
        mlt:datasetExistence "IN_REPO" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 6 ;
        mlt:effortDaysLow 3 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "-" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "-" ;
        mlt:pass2Status "PARTIAL_REPO" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset IN_REPO, tier FULL_LOOP); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .


sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-006-on-magnitude> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-006 — Thompson (1917), Ch. II, pp. 16-49, Figs. 1" ;
        prov:wasRevisionOf sub:RABzQ2zsZrnmOVn3DxS_HDLIMXtL4BNqNCl6LPALVaMLU ;
        mlt:automationTier "LOOP_WITH_SEED" ;
        mlt:candidateDataset <https://doi.org/10.5061/dryad.3xsj3txdt>,
            <https://doi.org/10.5061/dryad.8kprr4z3r>,
            <https://doi.org/10.5061/dryad.9p8cz8wh6>,
            <https://doi.org/10.5061/dryad.hhmgqnkhj>,
            <https://doi.org/10.5061/dryad.pk0p2ngz7> ;
        mlt:candidateDatasetTitle "A nanoscale atlas of extracellular vesicles and particles in <em>Drosophila</em> olfactory sensilla",
            "Chicken and junglefowl cerebellar anatomy data",
            "Data accompanying manuscript: Allometric analysis of brain cell number in Hymenoptera suggests ant brains diverge from general trends",
            "Quantitative anatomy of the cerebellum on chickens and junglefowl",
            "Targeted inhibition of kisspeptin neurons reverses hyperandrogenemia and abnormal hyperactive LH secretion in a preclinical mouse model of polycystic ovary syndrome" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. II, pp. 16-49, Figs. 1." ;
        mlt:claim "Cell (e.g. nerve-cell) size is roughly independent of the size of the animal; larger animals have more cells, not proportionally larger cells." ;
        mlt:claimId "T1917-006" ;
        mlt:counterclaim "Broadly right, with named exceptions Thompson did not treat: some neurons, eggs, syncytia and polyploid cells scale with organism/ploidy. Cell size is actively regulated, not a passive constant." ;
        mlt:dataKindNeeded "cell size vs body size table" ;
        mlt:datasetAuditReason "Dryad live search returned 1 title-relevant dataset(s), top: doi:10.5061/dryad.3xsj3txdt." ;
        mlt:datasetExistence "PUBLIC_SCRIPTABLE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 5 ;
        mlt:effortDaysLow 2 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Marshall, W.F. et al. (2012) Curr. Biol. 22:R256-R260 ('What determines cell size?')" ;
        mlt:literatureRelation "QUALIFIED" ;
        mlt:literatureWhoAndWhen "Modern cell-size literature (e.g. Marshall et al. 2012)" ;
        mlt:pass2Status "DONE_ELSEWHERE" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset PUBLIC_SCRIPTABLE, tier LOOP_WITH_SEED); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_claims.json (repo artifact)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_dataset_audit.json (repo artifact)" ;
        mlt:bytes 96343 ;
        mlt:sha256 "a0bc797767654ca4e951b1b3683a773923448b02124a61259e89cccd7a071f1a" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> a prov:Entity ;

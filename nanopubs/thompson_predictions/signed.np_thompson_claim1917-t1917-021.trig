sub:assertion {
    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 claim registry (59 claims, all dated 1917)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 literature counterclaim layer" ;
        mlt:bytes 54663 ;
        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-021> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-021 -- Ch. VIII, pp. 346-410, Figs. 136-193" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "VIII" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. VIII, pp. 346-410, Figs. 136-193." ;
        mlt:claim "The bee's honeycomb - hexagonal prisms closed by three rhombi meeting at the Maraldi angle (~109 deg 28 min) - is the configuration using least wax for the capacity (the isoperimetric claim)." ;
        mlt:claimId "T1917-021" ;
        mlt:claimType "quantitative-geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "136-193" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-021> ;
        mlt:pages "346-410" ;
        mlt:repo2026AssessmentNotLiterature "Split verdict in modern literature, and the split matters: the hexagonal tiling IS optimal (Hales 2001), but Fejes Toth showed a slightly better base than the bees' rhombic trihedron, so 'least wax' is false in detail for the end-caps. Any repo treatment must state both halves." ;
        mlt:repo2026StatusSeparate "DONE_ELSEWHERE" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-021> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-021 (Thompson 1917): PARTIALLY_REFUTED -- Fejes Toth (1964); Hales (2001)" ;
        mlt:counterclaim "SPLIT VERDICT, and the split is the famous one. (a) The hexagonal tiling IS optimal -- proved by Hales (2001): Thompson/Pappus right. (b) The bees' three-rhombi cell base is NOT the wax-minimum: Fejes Toth (1964) built a better base (two hexagons + two rhombi). Thompson's 'least wax' claim is therefore wrong in its 3D detail. Fejes Toth himself adds that the saving is practically illusory." ;
        mlt:literatureCitation "Fejes Toth, L. (1964) Bull. AMS 70:468-481, 'What the bees know and what they do not know'; Hales, T.C. (2001) Ann. of Math. 153 (honeycomb conjecture proved)" ;
        mlt:literatureRelation "PARTIALLY_REFUTED" ;
        mlt:literatureWhoAndWhen "Fejes Toth (1964); Hales (2001)" ;
        mlt:quantitativeMargin "Better base saves <0.35% of the area of a cell opening (much less of total cell surface) -- Fejes Toth (1964); a 2025 re-optimisation puts the total available saving at ~0.50%" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-021> .
}


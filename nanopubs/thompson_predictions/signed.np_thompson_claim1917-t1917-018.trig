sub:assertion {
    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 claim registry (59 claims, all dated 1917)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 literature counterclaim layer" ;
        mlt:bytes 54663 ;
        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-018> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-018 -- Ch. VII, pp. 293-345, Figs. 100-135" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "VII" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. VII, pp. 293-345, Figs. 100-135." ;
        mlt:claim "Cells in contact, like soap films, meet three-at-a-time at ~120 degrees and in other respects obey Plateau's laws of film configuration." ;
        mlt:claimId "T1917-018" ;
        mlt:claimType "geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "100-135" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-018> ;
        mlt:pages "293-345" ;
        mlt:repo2026AssessmentNotLiterature "Angle distribution in a real epithelium has never been scored here against the 120-degree prediction with a stated tolerance. Modern literature broadly supports Plateau statistics with active-mechanics deviations." ;
        mlt:repo2026StatusSeparate "PARTIAL_REPO" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-018> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-018 (Thompson 1917): QUALIFIED -- Farhadifar et al. (2007); vertex-model literature thereafter" ;
        mlt:counterclaim "Plateau-style junction laws hold as the energy-minimising limit of vertex models, but real epithelia are active: measured junction angles and cell shapes deviate systematically, and the deviations carry the biology (proliferation, contractility). Thompson's 120-degree rule is the passive limit, not the tissue's operating point." ;
        mlt:literatureCitation "Farhadifar, R. et al. (2007) Curr. Biol. 17:2095-2104 (Drosophila wing epithelium vertex model)" ;
        mlt:literatureRelation "QUALIFIED" ;
        mlt:literatureWhoAndWhen "Farhadifar et al. (2007); vertex-model literature thereafter" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-018> .
}


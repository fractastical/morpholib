<https://w3id.org/morpholib/thompson/np/pred-mrca-Argyropelecus-olfersii-Sternoptyx-diaphana/assertion> {
    <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Argyropelecus-olfersii-Sternoptyx-diaphana> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Argyropelecus olfersii + Sternoptyx diaphana at 80.8 Ma (most recent common ancestor of one of D'Arcy Thompson's 1917 transformation pairs)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Argyropelecus olfersii + Sternoptyx diaphana lineage at 80.8 Ma given 2 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Most recent common ancestor of one of d'arcy thompson's 1917 transformation pairs. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 80.76 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0338 ;
        mlt:expectedProcrustesRMSThompson7 0.0329 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Argyropelecus olfersii + Sternoptyx diaphana dated to 81 +/- 16 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.159, 0.444] falsifies this prediction (point estimate 0.283); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Argyropelecus-olfersii-Sternoptyx-diaphana-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Argyropelecus-olfersii-Sternoptyx-diaphana-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Argyropelecus-olfersii-Sternoptyx-diaphana-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Argyropelecus-olfersii-Sternoptyx-diaphana-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Argyropelecus-olfersii-Sternoptyx-diaphana-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Argyropelecus-olfersii-Sternoptyx-diaphana-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Argyropelecus-olfersii-Sternoptyx-diaphana-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Argyropelecus-olfersii-Sternoptyx-diaphana-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 2 ;
        mlt:predictedLandmarksFull30 "[[-0.21497, -0.04087], [-0.27178, 0.01542], [0.01157, 0.09603], [0.29521, 0.04559], [0.43462, 0.0242], [0.43469, -0.04208], [0.35013, -0.04942], [0.21359, -0.0959], [-0.07973, -0.02104], [-0.06457, -0.05166], [-0.10096, 0.04325], [-0.15056, 0.03513], [-0.14929, -0.04121], [-0.19144, -0.05398], [-0.23087, 0.02548], [-0.18353, 0.02397], [-0.1021, 0.08709]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.22522, -0.03062], [-0.26437, 0.00274], [-0.02345, 0.10143], [0.33046, 0.03489], [0.41493, 0.02859], [0.43262, -0.03837], [0.34786, -0.04582], [0.21425, -0.10332], [-0.09012, -0.01868], [-0.05127, -0.05446], [-0.11082, 0.04561], [-0.15669, 0.0275], [-0.1491, -0.0443], [-0.1956, -0.04644], [-0.22201, 0.0231], [-0.18299, 0.02335], [-0.06849, 0.09481]]" ;
        mlt:predictionKind "mrca" ;
        mlt:targetLineage "Argyropelecus olfersii + Sternoptyx diaphana" .

    <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Argyropelecus-olfersii-Sternoptyx-diaphana-full30-BD_over_SL> a mlt:PredictedRatio ;

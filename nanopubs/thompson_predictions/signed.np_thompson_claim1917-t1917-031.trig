    <https://w3id.org/morpholib/thompson/claim/t1917-031> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-031 -- Ch. XIII, pp. 612-634, Figs. 318-324" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XIII" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XIII, pp. 612-634, Figs. 318-324." ;
        mlt:claim "Horns (ram, goat, Ovis ammon) are logarithmic spirals wound on a cone (a conical helicoid generated by gnomonic growth), differing between species by the spiral constants and torsion." ;
        mlt:claimId "T1917-031" ;
        mlt:claimType "quantitative-geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "318-324" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-031> ;
        mlt:pages "612-634" ;
        mlt:repo2026AssessmentNotLiterature "No repo fit to horn centrelines in 3D; modern CT/museum horn data exist. This is the horn analogue of the shell test and should share code with T1917-027." ;
        mlt:repo2026StatusSeparate "UNTESTED" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-031> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-031 (Thompson 1917): NO_DIRECT_TEST -- -" ;
        mlt:counterclaim "No published test of horns as conical logarithmic helicoids, Thompson-style, was found. Open." ;
        mlt:literatureCitation "Horn literature is investment/sexual-selection focused (e.g. Dryad 10.5061/dryad.fxpnvx16w), not conical-log-spiral fitting" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "-" ;
        mlt:noDirectTestFoundAsOf "2026-10-26"^^xsd:date ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:statementOfAbsence "As of this literature review (2026-10-26), no published work directly tests this 1917 claim as Thompson stated it. Neighbouring results are not a test of this claim." ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-031> .

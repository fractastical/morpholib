    <https://w3id.org/morpholib/thompson/claim/t1917-012> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-012 -- Ch. IV, pp. 156-200, Figs. 58-59" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "IV" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. IV, pp. 156-200, Figs. 58-59." ;
        mlt:claim "Early cleavage/segmentation patterns of eggs conform to the same bipolar (two-like-pole) field configuration." ;
        mlt:claimId "T1917-012" ;
        mlt:claimType "geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "58-59" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-012> ;
        mlt:pages "156-200" ;
        mlt:repo2026AssessmentNotLiterature "Untested as stated; modern cleavage is explained by spindle positioning/cortical mechanics, which could be compared geometrically." ;
        mlt:repo2026StatusSeparate "UNTESTED" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-012> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-012 (Thompson 1917): NO_DIRECT_TEST -- -" ;
        mlt:counterclaim "No direct literature test of Thompson's two-like-pole field reading of cleavage patterns. The modern mechanism (spindle position -> cleavage furrow) makes the field picture unnecessary, which is a supersession by neglect, not a refutation." ;
        mlt:literatureCitation "Cleavage is now explained by spindle positioning and cortical mechanics (modern cell-biology literature)" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "-" ;
        mlt:noDirectTestFoundAsOf "2026-10-26"^^xsd:date ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:statementOfAbsence "As of this literature review (2026-10-26), no published work directly tests this 1917 claim as Thompson stated it. Neighbouring results are not a test of this claim." ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-012> .

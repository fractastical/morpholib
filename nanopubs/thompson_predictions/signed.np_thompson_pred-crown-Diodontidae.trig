@prefix this: <https://w3id.org/morpholib/thompson/np/pred-crown-Diodontidae/RA0dkzhIoy5fBnN4LjUj1Kp2q605UHqix5IUPh7_JiCRQ> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Diodontidae at 11.6 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Diodontidae lineage at 11.6 Ma given 3 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 11.57 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0116 ;
        mlt:expectedProcrustesRMSThompson7 0.0181 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Diodontidae dated to 12 +/- 5 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.214, 0.309] falsifies this prediction (point estimate 0.256); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 3 ;
        mlt:predictedLandmarksFull30 "[[-0.24388, -0.06098], [-0.28246, -0.02563], [0.20512, 0.07417], [0.28669, 0.04169], [0.39055, 0.02308], [0.39481, -0.03207], [0.30703, -0.04109], [0.24157, -0.07456], [-0.05031, 0.0333], [-0.04453, -0.05146], [-0.10541, 0.06401], [-0.15863, 0.01776], [-0.16549, -0.04353], [-0.22225, -0.06754], [-0.24886, 0.02381], [-0.20039, 0.02509], [-0.10356, 0.09396]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.2546, -0.04598], [-0.30781, -0.02042], [0.06995, 0.10943], [0.33194, 0.0385], [0.39423, 0.02464], [0.38382, -0.03578], [0.31935, -0.03481], [0.25168, -0.0772], [-0.09291, -0.01158], [-0.04276, -0.0434], [-0.09238, 0.04851], [-0.15904, 0.02528], [-0.15668, -0.04573], [-0.21274, -0.05686], [-0.24498, 0.00943], [-0.1939, 0.01709], [0.00683, 0.09887]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Diodontidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.1863 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2331 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.2879 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2137 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2565 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.3088 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2648 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2904 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.3167 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.6992 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.7349 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.7687 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.3573 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.3883 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.4218 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2369 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.2782 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.319 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae-thompson7-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2869 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.3067 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.3277 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Diodontidae-thompson7-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.5399 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.565 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.5902 .
}


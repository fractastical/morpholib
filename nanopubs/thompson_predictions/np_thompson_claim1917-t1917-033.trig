    <https://w3id.org/morpholib/thompson/claim/t1917-033> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-033 -- Ch. XIV, pp. 635-651, Figs. 325-327" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XIV" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XIV, pp. 635-651, Figs. 325-327." ;
        mlt:claim "Leaf/floret divergence approximates the golden (Fibonacci) angle (~137.5 deg), with rational approximations 1/2, 1/3, 2/5, 3/8... and Fibonacci numbers of parastichies." ;
        mlt:claimId "T1917-033" ;
        mlt:claimType "quantitative-empirical" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "325-327" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-033> ;
        mlt:pages "635-651" ;
        mlt:repo2026AssessmentNotLiterature "Repo simulates the mechanism but has not scored divergence-angle distributions in real plants against Thompson's fractions. Modern literature: strongly supported with documented exceptions/transitions." ;
        mlt:repo2026StatusSeparate "PARTIAL_REPO" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-033> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-033 (Thompson 1917): SUPPORTED -- Douady & Couder (1992)" ;
        mlt:counterclaim "No counterclaim -- the opposite. Douady & Couder produced Fibonacci phyllotaxis and the golden angle (~137.5 deg) in a purely physical system (repelling ferrofluid drops), with no botanical machinery: the pattern is what a self-organising repulsive system does. This supports Thompson's physicalist reading and refutes only the mystical/numerological readings Thompson himself disliked." ;
        mlt:literatureCitation "Douady, S. & Couder, Y. (1992) Phys. Rev. Lett. 68:2098-2101" ;
        mlt:literatureRelation "SUPPORTED" ;
        mlt:literatureWhoAndWhen "Douady & Couder (1992)" ;
        mlt:quantitativeMargin "Golden angle 137.5 deg and Fibonacci parastichies emerge from one control parameter (drop periodicity) in vitro (1992)" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-033> .
}


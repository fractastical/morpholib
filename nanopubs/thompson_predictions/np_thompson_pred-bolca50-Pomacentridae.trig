<https://w3id.org/morpholib/thompson/np/pred-bolca50-Pomacentridae/assertion> {
    <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Pomacentridae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Pomacentridae at 50.0 Ma (state of the family lineage at the age of the Monte Bolca Lagerstaette (50 Ma))" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Pomacentridae lineage at 50.0 Ma given 124 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. State of the family lineage at the age of the monte bolca lagerstaette (50 ma). Registered before any comparison with fossils of this age." ;
        mlt:ageMa 50.0 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0201 ;
        mlt:expectedProcrustesRMSThompson7 0.0276 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Pomacentridae dated to 50 +/- 10 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.420, 0.515] falsifies this prediction (point estimate 0.468); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Pomacentridae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Pomacentridae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Pomacentridae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Pomacentridae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Pomacentridae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Pomacentridae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Pomacentridae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Pomacentridae-thompson7-PD_over_SL> ;
        mlt:knownFossilTaxaAtThisAge "Palaeopomacentrus orphae, Lorenzichthys olihan" ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:lineageRepresentedByTip "Abudefduf septemfasciatus" ;
        mlt:livingFamilyMean_BD_over_SL 0.6202 ;
        mlt:livingFamilyMean_BDmax_over_SL 0.5008 ;
        mlt:livingFamilyMean_HL_over_SL 0.2628 ;
        mlt:livingFamilyMean_PD_over_SL 0.4033 ;
        mlt:livingFamilySD_BD_over_SL 0.0615 ;
        mlt:livingFamilySD_BDmax_over_SL 0.0653 ;
        mlt:livingFamilySD_HL_over_SL 0.0217 ;
        mlt:livingFamilySD_PD_over_SL 0.0378 ;
        mlt:nSampledLivingSpecies 124 ;
        mlt:predictedLandmarksFull30 "[[-0.22009, -0.04009], [-0.25237, -0.00126], [-0.05297, 0.15461], [0.34688, 0.05657], [0.40757, 0.04821], [0.40814, -0.0492], [0.34064, -0.06312], [0.18194, -0.14669], [-0.05342, -0.0295], [-0.03584, -0.08595], [-0.0912, 0.06194], [-0.13338, 0.03687], [-0.15419, -0.06434], [-0.20767, -0.06109], [-0.22037, 0.02162], [-0.16507, 0.02394], [-0.0986, 0.13747]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.22581, -0.04702], [-0.26668, -0.00095], [-0.05309, 0.1463], [0.33948, 0.05831], [0.40936, 0.04971], [0.41429, -0.0519], [0.34272, -0.0633], [0.17437, -0.14884], [-0.05765, -0.02712], [-0.037, -0.07839], [-0.09073, 0.06463], [-0.13473, 0.03748], [-0.14046, -0.06505], [-0.19994, -0.06893], [-0.21412, 0.0291], [-0.16507, 0.03076], [-0.09494, 0.13522]]" ;
        mlt:predictionKind "bolca50" ;

    <https://w3id.org/morpholib/thompson/claim/t1917-043> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-043 -- Ch. XVII, pp. 744, Figs. 369" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XVII" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVII, pp. 744, Figs. 369." ;
        mlt:claim "The carapaces of crabs (Geryon, Corystes, Scyramathia/Rochinia, Paralomis/Lithodes, Lupa/Portunus, Chorinus etc.) are mutually transformable by rectilinear-to-curvilinear coordinate transformation." ;
        mlt:claimId "T1917-043" ;
        mlt:claimType "geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "369" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-043> ;
        mlt:pages "744" ;
        mlt:repo2026AssessmentNotLiterature "Supported on drawings and partly on real 3D-scan landmarks; a full 600-pt real-specimen outline test remains (the fish treatment)." ;
        mlt:repo2026StatusSeparate "DONE_REPO" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-043> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-043 (Thompson 1917): PARTIALLY_REFUTED -- Scholtz, Knotel & Baum (2020)" ;
        mlt:counterclaim "THE direct literature counterclaim to a Thompson figure. Using Thompson's drawings AND laser-scanned real carapaces (50 micrometre surface scans, projected to silhouettes, 8 landmarks): 'Only the simple transformations show a reasonable form of congruence. In particular, the transformations to majoid spider crabs reveal a complicated transformation of grids with partly crossing lines.' Accurate matching needs increasingly complex, non-Cartesian transformations -- undermining Thompson's simple explanatory model. Curious exception: the lithodid (convergent hermit-crab descendant) transforms easily. Note Thompson also silently included Paralomis, which is not a true crab at all." ;
        mlt:literatureCitation "Scholtz, G., Knotel, D. & Baum, D. (2020) Zoomorphology (doi:10.1007/s00435-020-00494-1), 'D'Arcy W. Thompson's Cartesian transformations: a critical evaluation'" ;
        mlt:literatureRelation "PARTIALLY_REFUTED" ;
        mlt:literatureWhoAndWhen "Scholtz, Knotel & Baum (2020)" ;
        mlt:quantitativeMargin "Qualitative-geometric verdict (crossing grid lines = failed diffeomorphism in the majoid cases), on both his drawings and real 3D-scanned carapaces (2020)" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-043> .
}


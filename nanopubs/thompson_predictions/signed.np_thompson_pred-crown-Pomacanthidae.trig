sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacanthidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Pomacanthidae at 44.0 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Pomacanthidae lineage at 44.0 Ma given 21 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 43.96 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0179 ;
        mlt:expectedProcrustesRMSThompson7 0.0247 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Pomacanthidae dated to 44 +/- 9 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.483, 0.588] falsifies this prediction (point estimate 0.535); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacanthidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacanthidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacanthidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacanthidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacanthidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacanthidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacanthidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacanthidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 21 ;
        mlt:predictedLandmarksFull30 "[[-0.21945, -0.04067], [-0.23909, 0.00631], [-0.07888, 0.16207], [0.35928, 0.0506], [0.4024, 0.04775], [0.40406, -0.03769], [0.35764, -0.04516], [0.14332, -0.17636], [-0.06579, -0.0377], [-0.04442, -0.08483], [-0.09053, 0.05958], [-0.12478, 0.03614], [-0.14567, -0.07736], [-0.20645, -0.07794], [-0.20239, 0.02991], [-0.15168, 0.03204], [-0.09757, 0.15334]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.2206, -0.05138], [-0.2505, 0.0084], [-0.06995, 0.15395], [0.34095, 0.0557], [0.41453, 0.05274], [0.41986, -0.04009], [0.34287, -0.05913], [0.14141, -0.1624], [-0.05538, -0.03668], [-0.04671, -0.0949], [-0.08573, 0.06804], [-0.12535, 0.04111], [-0.14382, -0.07756], [-0.20219, -0.07954], [-0.1998, 0.03898], [-0.15384, 0.03605], [-0.10576, 0.14672]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Pomacanthidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacanthidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.5919 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.6397 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.6901 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacanthidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.4834 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.5347 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.5879 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacanthidae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.227 ;

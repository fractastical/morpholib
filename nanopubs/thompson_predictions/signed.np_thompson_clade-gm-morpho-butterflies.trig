            "{\"id\": \"MB3\", \"p\": 0.85, \"pass\": true}",
            "{\"id\": \"MB4\", \"p\": 0.75, \"pass\": true}" ;
        mlt:looErrorRatioFullVsConsensus 0.5846 ;
        mlt:looErrorRatioThompson7VsConsensus 0.8435 ;
        mlt:nHypothesesSupported 4 ;
        mlt:nHypothesesTotal 4 ;
        mlt:pca7VarianceShare 0.9574 ;
        mlt:reportDocument <https://github.com/fractastical/morpholib/blob/967dc2c36396e60bc8955e12a8b582bba7b11df9/docs/portfolio/morpho_butterflies.md> ;

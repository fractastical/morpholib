sub:assertion {
    <https://w3id.org/morpholib/thompson/clade-gm/clade-gm-morpho-butterflies> a mlt:CladeGeometricMorphometricsOutcome ;
        rdfs:label "insects: Morpho butterflies (Chazot et al. 2021 J Evol Biol: 911 specimens, 30 species on Morpho_MCC_tree.tre; forewing 22 LMs & hindwing 18 LMs): Thompson-7 captures 49.0% of interspecific variance (PCA-7 95.7%), 4/4 pre-registered hypotheses supported (Brier 0.037)" ;
        mlt:brierScore 0.0369 ;
        mlt:evaluatesPortfolio <https://w3id.org/morpholib/thompson/np/dataset-portfolio-2026-10-22/RA9ZKlSDsa68lEKRo7JR0Px5woGoCMUHRlSK_bHKag4EA> ;

sub:assertion {
    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Goujetia-crassispina> a mlt:FossilPredictionTest ;
        rdfs:label "Monte Bolca test: Goujetia crassispina (Sparidae) vs. predicted Sparidae lineage at 50 Ma" ;
        dcterms:bibliographicCitation "Bannikov A.F. (2006) Geodiversitas 28(2): 249-275: head length contained 3.25 times in SL (30.8%); head length 1.17 times less than body depth (-> 36.0% SL). Holotype MNHN Bol 8/9, 128 mm SL." ;
        mlt:ageMa 50.0 ;
        mlt:family "Sparidae" ;
        mlt:fossilTaxon "Goujetia crassispina" ;
        mlt:hasMeasurementComparison <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Goujetia-crassispina-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Goujetia-crassispina-HL_over_SL> ;
        mlt:nullHypothesis "phylogenetic stasis: fossil proportions equal the living family mean" ;
        mlt:phylogeneticPlacement "Sparidae (new genus for Dentex crassispinus Agassiz)" ;
        mlt:testsPrediction <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Sparidae> ;
        mlt:verdictBodyDepth "outside the 95% predictive interval (prediction falsified as stated, subject to the fossil's placement on the lineage)" .

    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Goujetia-crassispina-BDmax_over_SL> a mlt:MeasurementComparison ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length" ;
        mlt:directionOfChangeCorrect true ;
        mlt:fossilInsidePredictiveInterval95 false ;
        mlt:fossilValueLower 0.36 ;
        mlt:fossilValueUpper 0.36 ;
        mlt:livingFamilyMean 0.4661 ;
        mlt:predictedFull30 0.4472 ;
        mlt:predictedFull30Lower95 0.3892 ;
        mlt:predictedFull30Upper95 0.5036 ;
        mlt:predictedThompson7 0.4549 ;
        mlt:predictionCloserThanStasisNull true ;
        mlt:ratioName "BDmax_over_SL" .

    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Goujetia-crassispina-HL_over_SL> a mlt:MeasurementComparison ;
        rdfs:label "head length / standard length" ;
        mlt:directionOfChangeCorrect false ;
        mlt:fossilInsidePredictiveInterval95 false ;
        mlt:fossilValueLower 0.308 ;
        mlt:fossilValueUpper 0.308 ;
        mlt:livingFamilyMean 0.2832 ;
        mlt:predictedFull30 0.2808 ;
        mlt:predictedFull30Lower95 0.2551 ;
        mlt:predictedFull30Upper95 0.3076 ;
        mlt:predictedThompson7 0.2896 ;
        mlt:predictionCloserThanStasisNull false ;
        mlt:ratioName "HL_over_SL" .
}


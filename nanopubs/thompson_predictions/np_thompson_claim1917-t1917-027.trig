        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-027> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-027 -- Ch. XI, pp. 493-586, Figs. 237-303" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XI" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XI, pp. 493-586, Figs. 237-303." ;
        mlt:claim "Spiral shells (and other gnomonic-growth structures) are logarithmic (equiangular) spirals: the wharves enlarge by a constant ratio, so the form is unchanged by growth (r proportional to e^{k theta})." ;
        mlt:claimId "T1917-027" ;
        mlt:claimType "quantitative-geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "237-303" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-027> ;
        mlt:pages "493-586" ;
        mlt:repo2026AssessmentNotLiterature "Repo explores the Raup/log-spiral space but has not fitted Thompson's own figured shells and reported log-vs-Archimedean discrimination with error bars. Modern literature: broadly supported, with real deviations." ;
        mlt:repo2026StatusSeparate "PARTIAL_REPO" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-027> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-027 (Thompson 1917): QUALIFIED -- Raup (1966)" ;
        mlt:counterclaim "Raup did not refute the logarithmic spiral; he demoted it from law to coordinate system. Real shells need three parameters (W whorl expansion, D, T) plus a generating-curve shape, parameters can drift during growth, and large regions of the possible morphospace are empty -- which a pure log-spiral law does not explain. Modern spiral-fitting (2021, 'Refined methods for estimating spirals', doi:10.26879/1071) needs 12 spiral types and treats 'spiral deviation' as the informative signal: exact log-spiral growth is the null, not the finding." ;
        mlt:literatureCitation "Raup, D.M. (1966) J. Paleontol. 40:1178-1190; Raup & Michelson (1965) Science 147" ;
        mlt:literatureRelation "QUALIFIED" ;
        mlt:literatureWhoAndWhen "Raup (1966)" ;
        mlt:quantitativeMargin "3+ Raup parameters replace Thompson's single spiral constant; deviations from log growth are systematic, not noise" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-027> .
}


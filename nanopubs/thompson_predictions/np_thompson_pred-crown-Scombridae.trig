<https://w3id.org/morpholib/thompson/np/pred-crown-Scombridae/assertion> {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Scombridae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Scombridae at 46.9 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Scombridae lineage at 46.9 Ma given 8 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 46.87 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0187 ;
        mlt:expectedProcrustesRMSThompson7 0.0254 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Scombridae dated to 47 +/- 9 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.194, 0.303] falsifies this prediction (point estimate 0.246); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Scombridae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Scombridae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Scombridae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Scombridae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Scombridae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Scombridae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Scombridae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Scombridae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 8 ;
        mlt:predictedLandmarksFull30 "[[-0.21196, -0.03519], [-0.27465, 0.01676], [-0.04145, 0.08523], [0.27083, 0.05507], [0.47228, 0.00051], [0.47207, -0.03318], [0.29645, -0.0702], [0.21091, -0.09105], [-0.07169, 0.00252], [-0.04042, -0.02713], [-0.10376, 0.04534], [-0.14828, 0.02955], [-0.13316, -0.03714], [-0.18351, -0.04893], [-0.22441, 0.01614], [-0.18474, 0.01484], [-0.10449, 0.07687]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.21248, -0.02535], [-0.25613, -0.00234], [-0.05063, 0.09448], [0.336, 0.03255], [0.4256, 0.02142], [0.43854, -0.04957], [0.35007, -0.05038], [0.20787, -0.09161], [-0.08764, -0.01064], [-0.04693, -0.04068], [-0.12016, 0.04312], [-0.16057, 0.02551], [-0.14006, -0.03315], [-0.18238, -0.03644], [-0.22207, 0.0171], [-0.18495, 0.0204], [-0.09407, 0.08558]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Scombridae" .


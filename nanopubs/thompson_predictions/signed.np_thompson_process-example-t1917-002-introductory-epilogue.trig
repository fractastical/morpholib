sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-002-introductory-epilogue> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-002 — Thompson (1917), Ch. I + Epilogue, pp. 1-15; Epilogue, Figs. -" ;
        prov:wasRevisionOf sub:RAS76EtzoXLIuN_o3ArLNVID2DmVy76tHDgd9JNgYl8A4 ;
        mlt:automationTier "NA" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. I + Epilogue, pp. 1-15; Epilogue, Figs. -." ;
        mlt:claim "Many forms are explained by physical forces directly and do not require (and are not well explained by) adaptation/heredity acting part-by-part; related forms differ by whole-form transformation rather than by independent change of parts." ;
        mlt:claimId "T1917-002" ;
        mlt:counterclaim "Thompson's anti-adaptationist, whole-form programme was first celebrated (Gould 1971, which revived him), then qualified by Gould himself: from the 1980s he refuted Thompson's mechanical determinism in favour of historical contingency and 'tinkering'. Modern synthesis: constraints (Thompson's half) and selection both operate; neither alone explains form." ;
        mlt:dataKindNeeded "roll-up of descendants" ;
        mlt:datasetAuditReason "Not testable as stated; no dataset settles it (operationalise first)." ;
        mlt:datasetExistence "NOT_TESTABLE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 15 ;
        mlt:effortDaysLow 5 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Gould (1971); Gould & Lewontin (1979) Proc. R. Soc. B 205:581-598 (spandrels paper)" ;
        mlt:literatureRelation "QUALIFIED" ;
        mlt:literatureWhoAndWhen "Gould (1971, and from the 1980s)" ;
        mlt:pass2Status "PARTIAL_REPO" ;
        mlt:step5Status "NOT QUEUED: not testable as stated, analytic, or unprobed; see dataset audit." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;

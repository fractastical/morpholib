        mlt:counterclaim "No direct test found. Open." ;
        mlt:dataKindNeeded "ungulate skull landmarks" ;
        mlt:datasetAuditReason "Live probe failed or Dryad rate-limited (HTTP 429) at scout time -- existence UNKNOWN, not absent. Loop Step 1 re-probes with throttling/cache; do not quote this row as 'no dataset'." ;
        mlt:datasetExistence "UNPROBED" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 10 ;
        mlt:effortDaysLow 5 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Osborn's rhinoceros/horse skull series are historically famous; no Thompson-transformation test of them was found" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "-" ;
        mlt:pass2Status "PARTIAL_REPO" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset UNPROBED, tier LOOP_WITH_SEED); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .


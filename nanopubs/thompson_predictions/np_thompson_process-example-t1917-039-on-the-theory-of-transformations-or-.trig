<https://w3id.org/morpholib/thompson/np/process-example-t1917-039-on-the-theory-of-transformations-or-/assertion> {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-039-on-the-theory-of-transformations-or-> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-039 — Thompson (1917), Ch. XVII, pp. 719-776, Figs. 353-408" ;
        prov:wasRevisionOf <https://w3id.org/morpholib/thompson/np/process-example-t1917-039-on-the-theory-of-transformations-or-/RADFKaOvCMxvA_bQ6yPZntrf_P2jW42JoBx9hEx3i-ois> ;
        mlt:automationTier "NA" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVII, pp. 719-776, Figs. 353-408." ;
        mlt:claim "GENERAL THESIS: the form of a related species/genus can be obtained from another by a simple, continuous deformation of the whole coordinate system (a transformation of the whole form), rather than by unrelated changes of separate parts." ;
        mlt:claimId "T1917-039" ;
        mlt:counterclaim "The most consequential counterclaim in this registry, in three instalments. (1) Bookstein (1977): as *method*, Thompson's grids are 'as intractable as they seemed in 1917' -- hand-drawn, unfitted, generating no offspring; Thompson 'rests with the possibility of a single system of forces... he was content to exemplify'. (2) Bookstein (1989) supplied the missing method (thin-plate spline: exact, least-bending, decomposable), which is why modern grids are computed, not drawn. (3) Bookstein (2023) then countered his own tradition: exact TPS/Procrustes grids can mislead, and residual-leaving polynomial trend grids often interpret better -- so 'exact fit' is not the final court either. Separately, Scholtz et al. (2020) tested Thompson's own crab example in 3D and found only simple transformations congruent (see T1917-043)." ;
        mlt:dataKindNeeded "roll-up of T1917-040..058" ;
        mlt:datasetAuditReason "Not testable as stated; no dataset settles it (operationalise first)." ;
        mlt:datasetExistence "NOT_TESTABLE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 4 ;
        mlt:effortDaysLow 2 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Bookstein, F.L. (1977) Math. Biosci. 34:177-219; (1978) Comput. Biol. Med.; (1989) IEEE TPAMI 11:567-585; (2023) Evol. Biol.; Scholtz et al. (2020) Zoomorphology 139 (doi:10.1007/s00435-020-00494-1)" ;
        mlt:literatureRelation "PARTIALLY_REFUTED" ;
        mlt:literatureWhoAndWhen "Bookstein (1977, 1978, 1989, and again 2023); Scholtz, Knotel & Baum (2020)" ;
        mlt:pass2Status "PARTIAL_REPO" ;
        mlt:quantitativeMargin "Method superseded (1989 TPS is exact at landmarks by construction, vs Thompson's unfitted hand grid); but exactness != predictive superiority (2023 qualification). General-thesis verdict must be per-pair -- see repo 2026 horizon result (registry T1917-050)" ;
        mlt:step5Status "NOT QUEUED: not testable as stated, analytic, or unprobed; see dataset audit." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_claims.json (repo artifact)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_dataset_audit.json (repo artifact)" ;
        mlt:bytes 96343 ;
        mlt:sha256 "a0bc797767654ca4e951b1b3683a773923448b02124a61259e89cccd7a071f1a" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_loop_queue.yaml (repo artifact)" ;

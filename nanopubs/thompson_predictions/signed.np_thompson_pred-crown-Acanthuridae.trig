sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Acanthuridae at 57.7 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Acanthuridae lineage at 57.7 Ma given 34 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 57.68 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0345 ;
        mlt:expectedProcrustesRMSThompson7 0.035 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Acanthuridae dated to 58 +/- 12 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.377, 0.499] falsifies this prediction (point estimate 0.440); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 34 ;
        mlt:predictedLandmarksFull30 "[[-0.22364, -0.05449], [-0.24934, -0.02374], [-0.07545, 0.13457], [0.36554, 0.04391], [0.41986, 0.03607], [0.42253, -0.02195], [0.36902, -0.03519], [0.08387, -0.1553], [-0.0779, -0.0405], [-0.04996, -0.07623], [-0.09174, 0.06902], [-0.11718, 0.03726], [-0.1544, -0.05968], [-0.20833, -0.06747], [-0.17949, 0.04118], [-0.13523, 0.0451], [-0.09814, 0.12742]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.22504, -0.05049], [-0.24053, 0.00307], [-0.07419, 0.13779], [0.35549, 0.04706], [0.43412, 0.04364], [0.43135, -0.03034], [0.34576, -0.0462], [0.1, -0.13523], [-0.05786, -0.0322], [-0.06494, -0.08327], [-0.07754, 0.06088], [-0.1163, 0.03616], [-0.15678, -0.07115], [-0.21547, -0.07521], [-0.18799, 0.03273], [-0.14414, 0.03107], [-0.10595, 0.13171]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Acanthuridae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.4432 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.5017 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5602 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3767 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4396 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.4994 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2438 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.274 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.3025 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.321 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3592 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.4004 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.4359 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.4861 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5392 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.353 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.4098 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.4669 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae-thompson7-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2381 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.2654 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.2944 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Acanthuridae-thompson7-PD_over_SL> a mlt:PredictedRatio ;

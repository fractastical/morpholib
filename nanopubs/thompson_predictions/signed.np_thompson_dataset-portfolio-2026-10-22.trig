    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-fishshapes_v1> a mlt:CandidateDataset ;
        rdfs:label "FishShapes v1 (Price et al. 2022) - scored" ;
        dcterms:source "Price SA et al. 2022 Ecology 103:e3829; Dryad 10.5061/dryad.vt4b8gtvf (Zenodo 6642650)" ;
        mlt:confidenceType "realised" ;

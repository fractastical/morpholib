    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-mammals_pantheria_combine> a mlt:CandidateGroup ;
        rdfs:label "mammals" ;
        mlt:blindDesign "train on PanTHERIA (2009) species, predict species whose first measurement appears only in COMBINE (2021): genuinely blind on species not yet measured when the training compilation was made" ;
        mlt:crownAgeMaApprox 180.0 ;
        mlt:pBeatsConsensusSubjective 0.9 ;
        mlt:pBeatsNearestSubjective 0.35 ;
        mlt:pCoverageCalibratedSubjective 0.55 ;
        mlt:phylogeny "Upham NS et al. 2019 PLoS Biol 17:e3000494 (5,911 species)" ;
        mlt:predictedHorizonMyr 51.0 ;
        mlt:reasoning "body mass is among the most conserved traits known (lambda > 0.95); the two-compilation design gives a clean blind split; COMBINE imputes some values and those must be excluded" ;
        mlt:traitData "PanTHERIA (Jones KE et al. 2009 Ecology 90:2648) -> COMBINE (Soria CD et al. 2021 Ecology 102:e03344): body mass, head-body length, and life history; cranial 3-D landmarks for 322 species (Goswami A et al. 2022 Science 378:377)" ;
        mlt:traitType "linear size traits + 3-D cranial landmarks" .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-plants_diaz_try> a mlt:CandidateGroup ;
        rdfs:label "seed plants" ;
        mlt:blindDesign "train on Diaz et al. 2016 species, predict TRY-only species added after 2016" ;
        mlt:crownAgeMaApprox 330.0 ;
        mlt:pBeatsConsensusSubjective 0.7 ;
        mlt:pBeatsNearestSubjective 0.3 ;
        mlt:pCoverageCalibratedSubjective 0.45 ;
        mlt:phylogeny "Smith SA & Brown JW 2018 Am J Bot 105:302 (seed-plant megatree, ~80,000 tips)" ;
        mlt:predictedHorizonMyr 93.0 ;
        mlt:reasoning "seed mass and height have high phylogenetic signal, leaf economics traits much less (lambda ~ 0.5-0.7); plasticity and intraspecific variance are large; the lowest-confidence group on the list" ;
        mlt:traitData "Diaz S et al. 2016 Nature 529:167 (six traits: height, seed mass, LMA, leaf area, leaf N, stem density; ~46,000 species) and TRY (Kattge J et al. 2020 Glob Change Biol 26:119)" ;
        mlt:traitType "linear functional traits" .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-ronco2021_tanganyika_cichlids> a mlt:CandidateDataset ;
        rdfs:label "Lake Tanganyika cichlid body-shape landmarks (Ronco et al. 2021)" ;
        dcterms:source "Ronco F et al. 2021 Nature 589:76-81 (data on Dryad); 240 species, body landmarks + oral/pharyngeal jaw data" ;
        mlt:confidenceType "simulated (tau-bin resampling of the FishShapes BDmax outcome) x trait factor" ;
        mlt:datasetClass "B landmark geometric morphometrics from another lab, same clade, deep horizon" ;
        mlt:deepHorizonPassInterval "{\"ratio_consensus_interval\": [0.56, 0.98], \"coverage_interval_pct\": [52.0, 84.0], \"pass_rule\": \"realised BDmax ratio vs consensus AND realised 95% coverage for species >= 50 Myr both fall inside these intervals\", \"p_pass_subjective\": 0.6}" ;
        mlt:fractionWithin50Myr 0.0 ;
        mlt:nSpeciesInScope 750 ;
        mlt:predicted_coverage_far "68.333 [62.000, 74.000]" ;
        mlt:predicted_ratio_consensus_far "0.766 [0.657, 0.881]" ;
        mlt:status "not downloaded" ;
        mlt:traitProbability "{\"trait\": \"BDmax_over_SL\", \"P1_beats_consensus_within_50\": null, \"P2_H2_passes\": null, \"coverage_calibrated_within_50\": null}",
            "{\"trait\": \"HL_over_SL\", \"P1_beats_consensus_within_50\": null, \"P2_H2_passes\": null, \"coverage_calibrated_within_50\": null}" .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-squamates_meiri> a mlt:CandidateGroup ;
        rdfs:label "squamate reptiles" ;
        mlt:blindDesign "train on lizards, predict snakes' SVL? No - different body plan. Train on 2018 release, predict species added in the 2024 update of the same database" ;
        mlt:crownAgeMaApprox 200.0 ;
        mlt:pBeatsConsensusSubjective 0.85 ;
        mlt:pBeatsNearestSubjective 0.35 ;
        mlt:pCoverageCalibratedSubjective 0.5 ;
        mlt:phylogeny "Tonini JFR et al. 2016 Biol Conserv 204:23 (9,755 species)" ;
        mlt:predictedHorizonMyr 56.0 ;
        mlt:reasoning "SVL is conserved but repeated limb loss and body elongation across squamates make shape far less predictable than size; a good place to test the horizon rule because the clade is old" ;
        mlt:traitData "Meiri S 2018 Glob Ecol Biogeogr 27:1168 'Traits of lizards of the world': maximum SVL, limb/leg state, clutch size, habitat" ;
        mlt:traitType "linear size + categorical" .
}


        mlt:traitProbability "{\"trait\": \"BDmax_over_SL\", \"P1_beats_consensus_within_50\": 0.9, \"P2_H2_passes\": 0.387, \"coverage_calibrated_within_50\": 0.9}",
            "{\"trait\": \"CPD_over_SL\", \"P1_beats_consensus_within_50\": 0.9, \"P2_H2_passes\": 0.387, \"coverage_calibrated_within_50\": 0.9}",

@prefix sub: <https://w3id.org/morpholib/thompson/np/dataset-portfolio-2026-10-22/RA9ZKlSDsa68lEKRo7JR0Px5woGoCMUHRlSK_bHKag4EA/> .
@prefix this: <https://w3id.org/morpholib/thompson/np/dataset-portfolio-2026-10-22/RA9ZKlSDsa68lEKRo7JR0Px5woGoCMUHRlSK_bHKag4EA> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22> a mlt:PredictionPortfolio ;
        rdfs:label "Forward dataset portfolio for the Thompson 1917 phylogenetic prediction engine: 6 fish datasets and 8 other groups with registered confidence, 2026-10-22" ;
        dcterms:description "States, before the comparisons are made, which evolutionary-biology datasets the engine (ray-finned fishes, predictions locked at commit dac08493) or the same machinery re-trained on another clade should have predictive power on, with a probability for each registered test. Simulated probabilities resample the FishShapes per-species errors in matching horizon bins for the species actually in scope; subjective probabilities are priors written down to be Brier-scored later. Species-level sub-predictions are registered per dataset as the data are obtained." ;
        mlt:anchoredOnOutcome <https://w3id.org/morpholib/thompson/np/blind-test-outcome-2026-10-22/RAJancwGOPEkHzBoZXGv_vu_snW0Lff2FktE85Me1P-fI> ;
        mlt:anchoredOnPreregistration <https://w3id.org/morpholib/thompson/np/blind-preregistration-2026-10-22/RAilN4nbRHp3e3ZHqlbIgeL3UGPRV_KtQHtJD3gzVVdqw> ;
        mlt:hasCandidateDataset <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-burns_sidlauskas2019_characiformes>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-fishbase_bodyshape_class>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-fishbase_caudal_aspect_ratio>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-fishbase_morphmet>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-fishshapes_v1>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-ronco2021_tanganyika_cichlids> ;
        mlt:hasCandidateGroup <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-amphibians_amphibio>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-ants_globalants>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-birds_avonet>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-butterflies_leptraits>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-drosophilidae_wings>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-mammals_pantheria_combine>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-plants_diaz_try>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-squamates_meiri> ;
        mlt:hasHypothesis <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-P1>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-P2>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-P3>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-P4>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-P5>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-P6>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-P7>,
            <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-P8> ;
        mlt:horizonRuleFraction 0.282 ;
        mlt:portfolioDocument <https://github.com/fractastical/morpholib/blob/139cf5b6bee9cfdf9444f397d969e4f869cab308/docs/THOMPSON_DATASET_PORTFOLIO.md> ;
        mlt:portfolioFileSha256 "a7e82d25943dd072685646b8805617de3f603a20f9ee2c3ac1c7731fcaf9c661" ;
        mlt:protocol_for_other_clades "Fit the engine on the training split of that clade's tree, lock predictions for every other tip, then obtain the comparison values. Horizon bins are scaled to the clade's crown age." ;
        mlt:protocol_step_1 "Before downloading or opening a dataset: if its traits are already in the locked registration (BDmax, CPD, HL, PD over SL for all 10,888 Rabosky targets, commit dac08493) nothing new is generated; otherwise generate species-level predictions, SHA-256 them, commit, and publish a preregistration nanopub citing this portfolio nanopub." ;
        mlt:protocol_step_2 "Download; record checksum; match species by exact name; per-species median over specimens/pictures." ;
        mlt:protocol_step_3 "Calibrate the measurement convention with a linear map fitted on TRAINING species only (as in the FishShapes protocol); apply to all methods." ;
        mlt:protocol_step_4 "Score exactly the registered tests (paired one-sided Wilcoxon, alpha = 0.01; tau bins 0-5, 5-10, 10-25, 25-50, 50-80, 80-120, >120 Myr as registered; 95% coverage)." ;
        mlt:protocol_step_5 "Publish an outcome nanopub citing the preregistration and this portfolio; update the realised columns of docs/THOMPSON_DATASET_PORTFOLIO.md without changing the registered probabilities." .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-P1> a mlt:PortfolioHypothesis ;
        rdfs:label "P1" ;
        dcterms:description "For any dataset of linear body-proportion traits on ray-finned fishes (class A), the locked full-30 predictions beat the consensus (ratio < 0.8, paired Wilcoxon p < 0.01) for species within 50 Myr of a training species." ;
        mlt:confidence "simulated per dataset below" ;
        mlt:isPrimary true .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-P2> a mlt:PortfolioHypothesis ;
        rdfs:label "P2" ;
        dcterms:description "The nearest-relative margin does NOT hold up: on class A fish datasets the full-30 prediction improves on copying the nearest training species by less than 10% (H2-type test fails again)." ;
        mlt:confidence "simulated per dataset below (reported as P(H2 passes); P2 is supported if it does not)" ;
        mlt:isPrimary true .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-P3> a mlt:PortfolioHypothesis ;
        rdfs:label "P3" ;
        dcterms:description "Beyond 50 Myr the behaviour is bin-specific, not uniform: the realised BDmax error ratio vs consensus and the realised 95% coverage of each deep-horizon dataset fall inside the simulated intervals given below (ratio +/- 0.10, coverage +/- 10 points). Concretely: cichlids (80-120 Myr) ~0.77 with ~68% coverage; characiforms (>120 Myr, root-state predictions) ~0.43 with ~82% coverage." ;
        mlt:confidence "subjective 0.6: intervals are simulated, but the tolerance and the transfer across landmark schemes are judgement calls" ;
        mlt:isPrimary true .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-P4> a mlt:PortfolioHypothesis ;
        rdfs:label "P4" ;
        dcterms:description "Head-length and predorsal ratios (HL/SL, PD/SL) show weaker skill than BDmax/SL on the same species (error ratio vs consensus at least 0.1 higher)." ;
        mlt:confidence "subjective 0.6: the jaw/head module had a worse process fit than the body module in the engine; FishBase picture measurements of HL are noisy" ;
        mlt:isPrimary false .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-P5> a mlt:PortfolioHypothesis ;
        rdfs:label "P5" ;
        dcterms:description "Traits outside the landmark set (caudal-fin aspect ratio) show no skill (ratio vs consensus >= 0.9)." ;
        mlt:confidence "subjective 0.7" ;
        mlt:isPrimary false .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-P6> a mlt:PortfolioHypothesis ;
        rdfs:label "P6" ;
        dcterms:description "The same machinery (AICc-selected process model on a time tree, Gaussian conditional prediction, horizon-binned calibration) re-trained on another clade beats that clade's consensus within the horizon for every group listed." ;
        mlt:confidence "subjective, per group (p_beats_consensus); product over groups is the probability all succeed" ;
        mlt:isPrimary true .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-P7> a mlt:PortfolioHypothesis ;
        rdfs:label "P7" ;
        dcterms:description "The horizon beyond which 95% coverage collapses below 75% falls at 0.28 +/- 50% of the clade's sampled crown age (fish: 50 of 177.5 Myr) in every group tested." ;
        mlt:confidence "subjective 0.4: one-point extrapolation; it is registered because it is cheap to falsify" ;
        mlt:isPrimary false .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-P8> a mlt:PortfolioHypothesis ;
        rdfs:label "P8" ;
        dcterms:description "Where a Thompson-style low-dimensional a-priori mode set exists (Drosophila wings; bird beaks), it beats the consensus but is worse than the full shape space, as in fish (H6)." ;
        mlt:confidence "subjective 0.65" ;
        mlt:isPrimary false .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-amphibians_amphibio> a mlt:CandidateGroup ;
        rdfs:label "amphibians" ;
        mlt:blindDesign "train on AmphiBIO v1, predict species added in later releases" ;
        mlt:crownAgeMaApprox 300.0 ;
        mlt:pBeatsConsensusSubjective 0.8 ;
        mlt:pBeatsNearestSubjective 0.3 ;
        mlt:pCoverageCalibratedSubjective 0.5 ;
        mlt:phylogeny "Jetz W & Pyron RA 2018 Nat Ecol Evol 2:850 (7,238 species)" ;
        mlt:predictedHorizonMyr 85.0 ;
        mlt:reasoning "size conserved at the family level, but miniaturisation is frequent and convergent; the 300 Myr crown implies, under the 0.28 rule, a horizon of ~85 Myr, which is a strong and testable claim" ;
        mlt:traitData "AmphiBIO (Oliveira BF et al. 2017 Sci Data 4:170123): body size, reproductive and ecological traits" ;
        mlt:traitType "linear size + categorical" .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-ants_globalants> a mlt:CandidateGroup ;
        rdfs:label "insects: ants (Formicidae)" ;
        mlt:blindDesign "train on species with records in the first GlobalAnts release; predict species added in later releases or in AntWeb specimen measurements" ;
        mlt:crownAgeMaApprox 150.0 ;
        mlt:pBeatsConsensusSubjective 0.85 ;
        mlt:pBeatsNearestSubjective 0.35 ;
        mlt:pCoverageCalibratedSubjective 0.55 ;
        mlt:phylogeny "Economo EP et al. 2018 Nat Commun 9:1778 (species-level tree, ~14,000 tips, grafted)" ;
        mlt:predictedHorizonMyr 42.0 ;
        mlt:reasoning "worker size and Weber's length are strongly phylogenetically conserved in ants; caste polymorphism (majors/minors) and inconsistent measurement protocols add noise; in-hand Camponotus GM data (Zenodo 10.5281/zenodo.18807285) and Pheidole images in .thompson_cache/antscan offer a small first test" ;
        mlt:traitData "GlobalAnts (Parr CL et al. 2017 Insect Conserv Divers 10:5-20): worker head width, head length, Weber's length, eye length, scape and femur length" ;
        mlt:traitType "linear morphometrics (worker caste)" .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-birds_avonet> a mlt:CandidateGroup ;
        rdfs:label "birds" ;
        mlt:blindDesign "train the engine on the 2,028 Cooney beak-shape species, predict AVONET beak length/width/depth for the remaining ~9,000 species (independent measurements, independent team)" ;
        mlt:crownAgeMaApprox 110.0 ;
        mlt:pBeatsConsensusSubjective 0.95 ;
        mlt:pBeatsNearestSubjective 0.4 ;
        mlt:pCoverageCalibratedSubjective 0.6 ;
        mlt:phylogeny "Jetz W et al. 2012 Nature 491:444 (9,993 species; birdtree.org)" ;
        mlt:predictedHorizonMyr 31.0 ;
        mlt:reasoning "best-case group: complete tree, complete trait coverage, museum callipers, lambda ~ 0.9 for most AVONET traits; the beak-shape -> beak-calliper design mirrors the fish landmark -> calliper design exactly" ;
        mlt:traitData "AVONET (Tobias JA et al. 2022 Ecol Lett 25:581-597): 11 linear traits (beak length/width/depth, tarsus, wing, Kipp's distance, tail, mass) for 11,009 species; 3-D beak shape PCs for 2,028 species (Cooney CR et al. 2017 Nature 542:344)" ;
        mlt:traitType "linear morphometrics + 3-D landmark PCs" .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-burns_sidlauskas2019_characiformes> a mlt:CandidateDataset ;
        rdfs:label "Characiformes body-shape landmarks (Burns & Sidlauskas 2019)" ;
        dcterms:source "Burns MD & Sidlauskas BL 2019 Evolution 73:569-587 (data on Dryad); landmark-based body shape for on the order of 1,000 characiform species" ;
        mlt:confidenceType "simulated (tau-bin resampling of the FishShapes BDmax outcome) x trait factor" ;
        mlt:datasetClass "C landmark data, same engine, beyond the horizon (Otophysi; tau > 120 Myr for essentially every species)" ;
        mlt:deepHorizonPassInterval "{\"ratio_consensus_interval\": [0.3, 0.56], \"coverage_interval_pct\": [70.0, 95.0], \"pass_rule\": \"realised BDmax ratio vs consensus AND realised 95% coverage for species >= 50 Myr both fall inside these intervals\", \"p_pass_subjective\": 0.6}" ;
        mlt:fractionWithin50Myr 0.0 ;
        mlt:nSpeciesInScope 485 ;
        mlt:predicted_coverage_far "82.400 [79.800, 85.200]" ;
        mlt:predicted_ratio_consensus_far "0.433 [0.405, 0.457]" ;
        mlt:status "not downloaded" ;
        mlt:traitProbability "{\"trait\": \"BDmax_over_SL\", \"P1_beats_consensus_within_50\": null, \"P2_H2_passes\": null, \"coverage_calibrated_within_50\": null}",
            "{\"trait\": \"PD_over_SL\", \"P1_beats_consensus_within_50\": null, \"P2_H2_passes\": null, \"coverage_calibrated_within_50\": null}" .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-butterflies_leptraits> a mlt:CandidateGroup ;
        rdfs:label "insects: butterflies (Papilionoidea)" ;
        mlt:blindDesign "the 2,244 tree species are a small fraction of LepTraits; train on half the tree species, predict the other half, then predict species added to the tree by later studies" ;
        mlt:crownAgeMaApprox 100.0 ;
        mlt:pBeatsConsensusSubjective 0.85 ;
        mlt:pBeatsNearestSubjective 0.35 ;
        mlt:pCoverageCalibratedSubjective 0.55 ;
        mlt:phylogeny "Kawahara AY et al. 2023 Nat Ecol Evol (2,244 species, time-calibrated)" ;
        mlt:predictedHorizonMyr 28.0 ;
        mlt:reasoning "wing size has high phylogenetic signal; LepTraits values are literature-compiled ranges (noisy); essentially a one-trait test of the machinery" ;
        mlt:traitData "LepTraits 1.0 (Shirey V et al. 2022 Sci Data 9:382): wingspan / forewing length for 12,448 species" ;
        mlt:traitType "linear size trait" .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-drosophilidae_wings> a mlt:CandidateGroup ;
        rdfs:label "insects: Drosophilidae wings" ;
        mlt:blindDesign "leave-clade-out within the 111 species; a truly blind test needs new species digitised to the same scheme" ;
        mlt:crownAgeMaApprox 40.0 ;
        mlt:pBeatsConsensusSubjective 0.75 ;
        mlt:pBeatsNearestSubjective 0.3 ;
        mlt:pCoverageCalibratedSubjective 0.45 ;
        mlt:phylogeny "Houle D, Bolstad GH, van der Linde K, Hansen TF 2017 Nature 548:447-450 (111 species, ~40 Myr)" ;
        mlt:predictedHorizonMyr 11.0 ;
        mlt:reasoning "closest analogue to the fish engine (2-D landmarks on a time tree) and the dataset where a Thompson-style low-dimensional mode set is most likely to work; small n limits power, hence the lower probability" ;
        mlt:traitData "wing landmarks / semilandmarks for the same 111 species (Houle et al. 2017 supplementary data)" ;
        mlt:traitType "landmark geometric morphometrics" .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-fishbase_bodyshape_class> a mlt:CandidateDataset ;
        rdfs:label "FishBase BodyShapeI categorical body-shape class" ;
        dcterms:source "FishBase SPECIES table, field BodyShapeI (elongated / fusiform-normal / short and-or deep / eel-like)" ;
        mlt:datasetClass "F categorical trait derived from shape" ;
        mlt:prediction "ordinal class predicted from locked BDmax/SL with thresholds fitted on training species only; accuracy above the majority-class baseline (43% 'elongated') within 50 Myr" ;
        mlt:probabilitySubjective 0.8 ;
        mlt:reasoning "coarse 3-4 level class; the BDmax error of 0.038 within 50 Myr is far smaller than the class width (~0.1 BDmax/SL); FishBase classes are inconsistently assigned, which caps accuracy" .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-fishbase_caudal_aspect_ratio> a mlt:CandidateDataset ;
        rdfs:label "FishBase caudal-fin aspect ratio (SWIMMING table)" ;
        dcterms:source "FishBase SWIMMING table, field AspectRatio" ;
        mlt:datasetClass "G trait outside the landmark set (negative control)" ;
        mlt:prediction "NO skill: the 17-landmark set has no caudal-fin landmarks, so the engine should not beat the consensus on aspect ratio (ratio >= 0.9)" ;
        mlt:probabilitySubjective 0.7 ;
        mlt:reasoning "peduncle depth (LM5-LM6) correlates weakly with fin aspect ratio across teleosts, so some incidental skill is possible; n is tiny" .

    <https://w3id.org/morpholib/thompson/portfolio/dataset-portfolio-2026-10-22-fishbase_morphmet> a mlt:CandidateDataset ;
        rdfs:label "FishBase picture-based morphometrics (MORPHMET table)" ;
        dcterms:source "Froese R & Pauly D (eds) 2021 FishBase version 06/2021, www.fishbase.org; table MORPHMET (SL, BD, CH, HL, PDL per picture)" ;
        mlt:confidenceType "simulated (tau-bin resampling of the FishShapes BDmax outcome) x trait factor" ;
        mlt:datasetClass "A linear traits, same clade, different measurement protocol" ;
        mlt:deepHorizonPassInterval "{\"ratio_consensus_interval\": [0.41, 0.65], \"coverage_interval_pct\": [63.0, 85.0], \"pass_rule\": \"realised BDmax ratio vs consensus AND realised 95% coverage for species >= 50 Myr both fall inside these intervals\", \"p_pass_subjective\": 0.6}" ;
        mlt:fractionWithin50Myr 0.266 ;
        mlt:nSpeciesInScope 5494 ;
        mlt:predicted_coverage_far "74.212 [73.075, 75.250]" ;
        mlt:predicted_coverage_near "92.594 [91.473, 93.667]" ;

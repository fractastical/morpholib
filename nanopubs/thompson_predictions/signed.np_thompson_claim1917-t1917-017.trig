    <https://w3id.org/morpholib/thompson/claim/t1917-017> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-017 -- Ch. VI, pp. 277-292, Figs. 97-98" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "VI" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. VI, pp. 277-292, Figs. 97-98." ;
        mlt:claim "Adsorption concentrates dissolved substances at surfaces/interfaces, and this physical concentration helps explain localisation and pattern within the cell/organism." ;
        mlt:claimId "T1917-017" ;
        mlt:claimType "mechanistic" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "97-98" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-017> ;
        mlt:pages "277-292" ;
        mlt:repo2026AssessmentNotLiterature "Too general to falsify as written; specific descendants (surface catalysis, membrane localisation) are settled elsewhere." ;
        mlt:repo2026StatusSeparate "NOT_TESTABLE_AS_STATED" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-017> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-017 (Thompson 1917): NOT_TESTABLE -- -" ;
        mlt:counterclaim "Too general to have attracted a testable counterclaim. Its specific descendants (surface catalysis, membrane localisation) were settled case by case." ;
        mlt:literatureCitation "-" ;
        mlt:literatureRelation "NOT_TESTABLE" ;
        mlt:literatureWhoAndWhen "-" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-017> .

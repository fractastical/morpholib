sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-009-the-rate-of-growth> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-009 — Thompson (1917), Ch. III, pp. 50-155, Figs. 25-32" ;

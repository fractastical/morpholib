            <https://doi.org/10.5061/dryad.tqjq2bw28> ;
        mlt:candidateDatasetTitle "Data from: Annual ring growth of a widespread high-arctic shrub reflects past fluctuations in community-level plant biomass",
            "Data from: Contrasting climate sensitivity of Pinus cembra tree-ring traits in the Carpathians",
            "Data from: Extracting coherent tree-ring climatic signals across spatial scales from extensive forest inventory data" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. III, pp. 50-155, Figs. 25-32." ;
        mlt:claim "Rate of growth varies lawfully with temperature and shows daily/seasonal/annual periodicity, recorded e.g. in tree growth (Douglass) and plant/root growth curves." ;
        mlt:claimId "T1917-009" ;
        mlt:counterclaim "No counterclaim; this became dendrochronology and quantitative growth physiology. Included for completeness: a Thompson claim the literature absorbed rather than fought." ;
        mlt:dataKindNeeded "growth vs temperature/season series" ;
        mlt:datasetAuditReason "Dryad live search returned 3 title-relevant dataset(s), top: doi:10.5061/dryad.d69k7." ;
        mlt:datasetExistence "PUBLIC_SCRIPTABLE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 4 ;
        mlt:effortDaysLow 2 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Douglass, A.E. (1919+) dendrochronology; standard growth-physiology literature thereafter" ;
        mlt:literatureRelation "SUPPORTED" ;
        mlt:literatureWhoAndWhen "Douglass's dendrochronology and its successors (from 1919)" ;
        mlt:pass2Status "DONE_ELSEWHERE" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset PUBLIC_SCRIPTABLE, tier FULL_LOOP); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;

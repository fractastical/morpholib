    <https://w3id.org/morpholib/thompson/claim/t1917-041> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-041 -- Ch. XVII, pp. ~732, Figs. 359-360" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XVII" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVII, pp. ~732, Figs. 359-360." ;
        mlt:claim "Lanceolate, ovate and cordate leaves are transforms of one another under radial (polar) coordinates about an arrest/base point; the Begonia leaf is an instance of the same radial system." ;
        mlt:claimId "T1917-041" ;
        mlt:claimType "geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "359-360" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-041> ;
        mlt:pages "~732" ;
        mlt:repo2026AssessmentNotLiterature "The law has been borrowed and tested on animals; Thompson's actual leaves have never been fitted. Cheap, direct, undone." ;
        mlt:repo2026StatusSeparate "PARTIAL_REPO" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-041> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-041 (Thompson 1917): NO_DIRECT_TEST -- -" ;
        mlt:counterclaim "No literature test of lanceolate->ovate->cordate leaf transformation under radial coordinates was found. (The repo has tested Thompson's Fig. 359 radial-cordate *formula* on ant heads -- an analogue, not this claim; see registry.) Open." ;
        mlt:literatureCitation "-" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "-" ;
        mlt:noDirectTestFoundAsOf "2026-10-26"^^xsd:date ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:statementOfAbsence "As of this literature review (2026-10-26), no published work directly tests this 1917 claim as Thompson stated it. Neighbouring results are not a test of this claim." ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-041> .

        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-058> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-058 -- Ch. XVII, pp. 770-773, Figs. 404-408" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XVII" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVII, pp. 770-773, Figs. 404-408." ;
        mlt:claim "The human skull, inscribed in Cartesian coordinates and deformed, gives the skulls of chimpanzee, baboon and dog: ape/human skull difference is a whole-diagram transformation (notably of the facial/cranial proportions)." ;
        mlt:claimId "T1917-058" ;
        mlt:claimType "geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "404-408" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-058> ;
        mlt:pages "770-773" ;
        mlt:repo2026AssessmentNotLiterature "Never tested on primates. Primate skull GM datasets are abundant and public - this is a high-visibility, feasible test." ;
        mlt:repo2026StatusSeparate "PARTIAL_REPO" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-058> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-058 (Thompson 1917): NO_DIRECT_TEST -- Bookstein (1977) method critique applies" ;
        mlt:counterclaim "No published test of human->chimpanzee/baboon/dog skull transformation as Thompson drew it (Figs. 404-408) was found, despite abundant primate landmark data. Open -- and the most visible untested skull claim in the book." ;
        mlt:literatureCitation "Bookstein (1977) Math. Biosci. 34:177-219 (general); primate cranial GM literature is large but not Thompson-framed" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "Bookstein (1977) method critique applies" ;
        mlt:noDirectTestFoundAsOf "2026-10-26"^^xsd:date ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:statementOfAbsence "As of this literature review (2026-10-26), no published work directly tests this 1917 claim as Thompson stated it. Neighbouring results are not a test of this claim." ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-058> .
}


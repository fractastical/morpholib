}

sub:assertion {
    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Ruffoichthys-bannikovi> a mlt:FossilPredictionTest ;
        rdfs:label "Monte Bolca test: Ruffoichthys bannikovi (Siganidae) vs. predicted Siganidae lineage at 50 Ma" ;
        dcterms:bibliographicCitation "Tyler J.C. & Bannikov A.F. (1997) Smithsonian Contributions to Paleobiology 84: 'the greatest body depth is 41%-43% SL in R. bannikovi versus 23%-34% in R. spinosus'." ;
        mlt:ageMa 50.0 ;
        mlt:family "Siganidae" ;
        mlt:fossilTaxon "Ruffoichthys bannikovi" ;
        mlt:hasMeasurementComparison <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Ruffoichthys-bannikovi-BDmax_over_SL> ;
        mlt:nullHypothesis "phylogenetic stasis: fossil proportions equal the living family mean" ;
        mlt:phylogeneticPlacement "stem Siganidae (most basal fossil siganid genus in Tyler & Bannikov 1997)" ;
        mlt:testsPrediction <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Siganidae> ;
        mlt:verdictBodyDepth "consistent with the prediction" .

    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Ruffoichthys-bannikovi-BDmax_over_SL> a mlt:MeasurementComparison ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length" ;
        mlt:directionOfChangeCorrect true ;
        mlt:fossilInsidePredictiveInterval95 true ;
        mlt:fossilValueLower 0.41 ;
        mlt:fossilValueUpper 0.43 ;
        mlt:livingFamilyMean 0.4393 ;
        mlt:predictedFull30 0.4132 ;
        mlt:predictedFull30Lower95 0.342 ;
        mlt:predictedFull30Upper95 0.4911 ;
        mlt:predictedThompson7 0.3914 ;
        mlt:predictionCloserThanStasisNull true ;
        mlt:ratioName "BDmax_over_SL" .
}


<https://w3id.org/morpholib/thompson/np/pred-crown-Clupeidae/assertion> {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Clupeidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Clupeidae at 88.8 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Clupeidae lineage at 88.8 Ma given 4 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 88.75 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0299 ;
        mlt:expectedProcrustesRMSThompson7 0.0303 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Clupeidae dated to 89 +/- 18 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.203, 0.375] falsifies this prediction (point estimate 0.285); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Clupeidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Clupeidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Clupeidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Clupeidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Clupeidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Clupeidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Clupeidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Clupeidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 4 ;
        mlt:predictedLandmarksFull30 "[[-0.21996, -0.0345], [-0.25709, 0.03147], [0.05435, 0.09612], [0.20633, 0.06755], [0.443, 0.02397], [0.44231, -0.04528], [0.38321, -0.04653], [0.21878, -0.09828], [-0.08796, -0.0475], [-0.08154, -0.06548], [-0.09708, 0.04015], [-0.15062, 0.04006], [-0.15587, -0.03872], [-0.20268, -0.04849], [-0.22086, 0.02232], [-0.17644, 0.01862], [-0.0979, 0.08452]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.23092, -0.02755], [-0.24931, 0.00916], [-0.00944, 0.09974], [0.29856, 0.04102], [0.39083, 0.0391], [0.45434, -0.03499], [0.36134, -0.04771], [0.23108, -0.11691], [-0.10764, -0.02325], [-0.06992, -0.06155], [-0.1105, 0.04402], [-0.15473, 0.02701], [-0.1652, -0.0467], [-0.20847, -0.04552], [-0.20683, 0.02632], [-0.17719, 0.02406], [-0.04599, 0.09375]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Clupeidae" .


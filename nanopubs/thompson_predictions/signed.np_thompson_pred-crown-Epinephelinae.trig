sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Epinephelinae at 72.7 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Epinephelinae lineage at 72.7 Ma given 61 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 72.67 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.033 ;
        mlt:expectedProcrustesRMSThompson7 0.0327 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Epinephelinae dated to 73 +/- 15 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.326, 0.428] falsifies this prediction (point estimate 0.376); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 61 ;
        mlt:predictedLandmarksFull30 "[[-0.21791, -0.06528], [-0.27927, 0.00912], [-0.05269, 0.13228], [0.34553, 0.04955], [0.41752, 0.04103], [0.4161, -0.05364], [0.32729, -0.06401], [0.18385, -0.11784], [-0.04843, -0.01889], [-0.04215, -0.0786], [-0.08703, 0.06711], [-0.13833, 0.03704], [-0.13334, -0.05059], [-0.18805, -0.0779], [-0.22999, 0.03325], [-0.18365, 0.03388], [-0.08943, 0.12349]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.22373, -0.04738], [-0.27478, -0.00349], [-0.0478, 0.13904], [0.34915, 0.04581], [0.41822, 0.0353], [0.4069, -0.04789], [0.33697, -0.05559], [0.18268, -0.12832], [-0.05842, -0.02356], [-0.03073, -0.07065], [-0.09615, 0.06242], [-0.14209, 0.03652], [-0.13483, -0.06148], [-0.19261, -0.06761], [-0.22438, 0.02744], [-0.17336, 0.02978], [-0.09504, 0.12966]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Epinephelinae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.4732 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.5171 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5625 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3262 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3757 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.4276 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2593 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2817 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.3052 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3475 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3803 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.4145 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.4934 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.5332 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5744 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.3581 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.4038 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.4537 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae-thompson7-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2442 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.2666 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.2901 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Epinephelinae-thompson7-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.3617 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.3928 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.4239 .
}


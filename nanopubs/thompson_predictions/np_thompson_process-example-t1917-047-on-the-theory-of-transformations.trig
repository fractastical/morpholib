    <https://w3id.org/morpholib/thompson/process-instance/t1917-047-on-the-theory-of-transformations> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-047 — Thompson (1917), Ch. XVII (fish II, text), pp. 749, Figs. 375-376 (text)" ;
        prov:wasRevisionOf <https://w3id.org/morpholib/thompson/np/process-example-t1917-047-on-the-theory-of-transformations/RA4Ud3TJZsK2qDWhUwhHj2drLMjsQnj6WJ-f-0p3R6rOk> ;
        mlt:automationTier "FULL_LOOP" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVII (fish II, text), pp. 749, Figs. 375-376 (text)." ;
        mlt:claim "The 'still more bizarre outlines of other fishes of the same family of Chaetodonts' correspond to small variations in the values of the constants of the coaxial curves." ;
        mlt:claimId "T1917-047" ;
        mlt:counterclaim "No literature test of the 'small variations in the constants' sentence was found. Repo 2026 tested the variance half (median 35% over 54 Chaetodon spp.); the constants half was still open at registry time and is the cheapest item in the whole programme." ;
        mlt:dataKindNeeded "IN_REPO (existing fits; re-run saving constants)" ;
        mlt:datasetAuditReason "Core test done in repo; remaining upgrade (real-specimen outlines) is loop-doable on in-repo data." ;
        mlt:datasetExistence "IN_REPO" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 2 ;
        mlt:effortDaysLow 1 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "-" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "-" ;
        mlt:pass2Status "DONE_REPO" ;
        mlt:step5Status "COMPLETED (see registry pass2 + repo evidence); this instance records the process retrospectively." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> ;
        mlt:verbatimQuote "the still more bizarre outlines of other fishes of the same family of Chaetodonts will be found to correspond to very slight modifications of similar co-ordinates; in other words, to small variations in the values of the constants of the coaxial curves. (Thompson 1917, p. 749; quoted in thompson/1917-thompson-scarus-pomacanthus.py L10-13)" .


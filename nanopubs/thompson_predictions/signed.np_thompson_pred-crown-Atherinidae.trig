sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Atherinidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Atherinidae at 32.0 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Atherinidae lineage at 32.0 Ma given 3 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 31.99 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0156 ;
        mlt:expectedProcrustesRMSThompson7 0.0213 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Atherinidae dated to 32 +/- 6 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.150, 0.277] falsifies this prediction (point estimate 0.213); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Atherinidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Atherinidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Atherinidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Atherinidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Atherinidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Atherinidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Atherinidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Atherinidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 3 ;
        mlt:predictedLandmarksFull30 "[[-0.23739, -0.03446], [-0.26962, 0.01464], [0.10442, 0.06842], [0.3374, 0.03634], [0.42005, 0.02766], [0.41763, -0.02978], [0.32695, -0.03975], [0.2103, -0.07485], [-0.08771, 0.01943], [-0.05803, -0.02875], [-0.11385, 0.03118], [-0.15498, 0.02324], [-0.1603, -0.0434], [-0.21236, -0.04569], [-0.23685, 0.00708], [-0.17161, 0.00698], [-0.11405, 0.06166]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.23964, -0.02569], [-0.28382, -0.00561], [0.02138, 0.0783], [0.34871, 0.03509], [0.42633, 0.02839], [0.4125, -0.0315], [0.33205, -0.03514], [0.21113, -0.07657], [-0.09474, -0.0116], [-0.05502, -0.03732], [-0.10205, 0.03426], [-0.15841, 0.01881], [-0.15683, -0.03204], [-0.20598, -0.0353], [-0.23313, 0.01125], [-0.18878, 0.01425], [-0.0337, 0.07041]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Atherinidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Atherinidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.211 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2649 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.3226 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Atherinidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;

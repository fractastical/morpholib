    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 literature counterclaim layer" ;
        mlt:bytes 54663 ;
        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-047> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-047 -- Ch. XVII (fish II, text), pp. 749, Figs. 375-376 (text)" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XVII (fish II, text)" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVII (fish II, text), pp. 749, Figs. 375-376 (text)." ;
        mlt:claim "The 'still more bizarre outlines of other fishes of the same family of Chaetodonts' correspond to small variations in the values of the constants of the coaxial curves." ;
        mlt:claimId "T1917-047" ;
        mlt:claimType "quantitative-geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "375-376 (text)" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-047> ;
        mlt:pages "749" ;
        mlt:repo2026AssessmentNotLiterature "The explained-variance half is tested (median 35%: weak-to-moderate, not 'very slight variations' producing bizarre outlines). The literal constants half - are the fitted constants actually SMALL variations? - is still unreported; it is a one-figure job on existing fits." ;
        mlt:repo2026StatusSeparate "DONE_REPO" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:verbatimQuote "the still more bizarre outlines of other fishes of the same family of Chaetodonts will be found to correspond to very slight modifications of similar co-ordinates; in other words, to small variations in the values of the constants of the coaxial curves. (Thompson 1917, p. 749; quoted in thompson/1917-thompson-scarus-pomacanthus.py L10-13)" .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-047> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-047 (Thompson 1917): NO_DIRECT_TEST -- -" ;
        mlt:counterclaim "No literature test of the 'small variations in the constants' sentence was found. Repo 2026 tested the variance half (median 35% over 54 Chaetodon spp.); the constants half was still open at registry time and is the cheapest item in the whole programme." ;
        mlt:literatureCitation "-" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "-" ;
        mlt:noDirectTestFoundAsOf "2026-10-26"^^xsd:date ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:statementOfAbsence "As of this literature review (2026-10-26), no published work directly tests this 1917 claim as Thompson stated it. Neighbouring results are not a test of this claim." ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-047> .
}


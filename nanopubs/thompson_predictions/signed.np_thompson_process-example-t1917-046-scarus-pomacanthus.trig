@prefix this: <https://w3id.org/morpholib/thompson/np/process-example-t1917-046-scarus-pomacanthus/RAq1VKEJFjvNuWOAe2GrrCCCyyuFQHh8RXVoL6v0_Tk0E> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-046-scarus-pomacanthus> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-046 — Thompson (1917), Ch. XVII (fish II), pp. 749, Figs. 375-376" ;
        prov:wasRevisionOf sub:RAuwRJk08EISwIRKqUjSTSzfT13QsvwRa2x_w6YYlNLtw ;
        mlt:auditReport <https://github.com/fractastical/morpholib/blob/main/morphoeval/kg/2026-10-17-thompson-audit/REPORT.md> ;
        mlt:automationTier "DONE" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVII (fish II), pp. 749, Figs. 375-376." ;
        mlt:claim "Deforming the rectilinear coordinates of a typical Scarus into (approximately) coaxial circles gives 'a very good outline' of Pomacanthus." ;
        mlt:claimId "T1917-046" ;
        mlt:counterclaim "No published *quantitative* test of Scarus->Pomacanthus existed before this repo's (the audit states: 'there is still no published value to compare against -- nobody has fitted this pair'). The literature counterclaim is methodological only: an unfitted hand grid is not evidence. The quantitative refutation (Mobius ~1%, outline IoU worse than no deformation) is REPO 2026, not literature -- keep the two apart." ;
        mlt:dataKindNeeded "IN_REPO" ;
        mlt:datasetAuditReason "Already validated in repo on data on disk; closed." ;
        mlt:datasetExistence "IN_REPO" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 10 ;
        mlt:effortDaysLow 5 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Bookstein, F.L. (1978), as discussed in the repo's validating script: Thompson 'drew the grids by hand and left no instructions for fitting them'" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "Bookstein (1978) on this figure's method" ;
        mlt:pass2Status "DONE_REPO" ;
        mlt:quantitativeMargin "Literature: none (no numbers). Repo 2026: see pass2 -- do not cite the repo numbers as 'the literature'" ;
        mlt:step5Status "COMPLETED (pre-registry, 2026-10-16/17): all steps executed by thompson/1917-thompson-scarus-pomacanthus.py and the MorphoEval audit 2026-10-17 (76.6/100). Verdict: literal conformal (Mobius) coaxial-circle reading REFUTED (explains ~1%; conformal maps cannot change depth/length 0.377->0.587); generous oblique-coaxial reading explains 32% at genus-mean landmarks, fails leave-one-landmark-out (0.0371 > 0.0312), and on real outlines is worse than no deformation (IoU 0.618 vs similarity 0.662)." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> ;
        mlt:verbatimQuote "Fig. 375 is an outline diagram of a typical Scaroid fish. Let us deform its rectilinear co-ordinates into a system of (approximately) coaxial circles, as in Fig. 376, and then filling into the new system, space by space and point by point, our former diagram of Scarus, we obtain a very good outline of an allied fish, belonging to a neighbouring family, of the genus Pomacanthus. (Thompson 1917, p. 749; quoted verbatim in thompson/1917-thompson-scarus-pomacanthus.py L5-13)" ;
        mlt:verdict "refuted-as-stated (conformal reading); bounded/weak in the generous oblique reading" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_claims.json (repo artifact)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_dataset_audit.json (repo artifact)" ;
        mlt:bytes 96343 ;
        mlt:sha256 "a0bc797767654ca4e951b1b3683a773923448b02124a61259e89cccd7a071f1a" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_loop_queue.yaml (repo artifact)" ;
        mlt:bytes 51327 ;
        mlt:sha256 "1d017aa92fb9cf889af47a1a631a328e1f204c1e12b930db1839b482c6f44d61" .
}


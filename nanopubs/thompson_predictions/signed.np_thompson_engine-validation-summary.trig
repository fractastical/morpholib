@prefix this: <https://w3id.org/morpholib/thompson/np/engine-validation-summary/RAIjcpW8vcGOXffncM7xpY9ZOAC-Uq3KfKPjMRj3OXGHA> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    <https://w3id.org/morpholib/thompson/engine/validation-summary> a mlt:PredictionEngineValidation ;
        rdfs:label "Validation of the Thompson 1917 phylogenetic prediction engine (held-out horizon calibration)" ;
        dcterms:description "Full 30-D shape-space phylogenetic prediction beats copying the nearest sampled relative at every horizon to ~50 Myr and collapses to the grand-consensus level beyond it; the a-priori 7 Thompson modes are outperformed by an equal-dimension PCA basis and are bounded by their representation floor. Predictive ellipsoids are approximately calibrated within 50 Myr. The companion prediction nanopubs in this series are registered against this error model." ;
        mlt:bestProcess_full_shape_30d "Pagel lambda=0.924" ;
        mlt:bestProcess_jaw_residual "Pagel lambda=0.971" ;
        mlt:bestProcess_thompson_modes "Pagel lambda=0.959" ;
        mlt:coverage95OverallPct 87.7 ;
        mlt:hasHorizonBin <https://w3id.org/morpholib/thompson/engine/validation-summary-horizon-0-5>,
            <https://w3id.org/morpholib/thompson/engine/validation-summary-horizon-10-25>,
            <https://w3id.org/morpholib/thompson/engine/validation-summary-horizon-120-400>,
            <https://w3id.org/morpholib/thompson/engine/validation-summary-horizon-25-50>,
            <https://w3id.org/morpholib/thompson/engine/validation-summary-horizon-5-10>,
            <https://w3id.org/morpholib/thompson/engine/validation-summary-horizon-50-80>,
            <https://w3id.org/morpholib/thompson/engine/validation-summary-horizon-80-120> ;
        mlt:nFossilTests 10 ;
        mlt:nHeldOutPredictions 2229 ;
        mlt:nRegisteredPredictions 57 ;
        mlt:nTrainingSpecies 743 ;
        mlt:shapeVarianceCapturedPCA7 0.862 ;
        mlt:shapeVarianceCapturedThompson7 0.5794 ;
        mlt:shareOfFullSpaceGainCapturedByThompson7 0.555 ;
        mlt:sigmaGenusProcrustesRMS 0.0113 .

    <https://w3id.org/morpholib/thompson/engine/validation-summary-horizon-0-5> a mlt:HorizonBin ;
        mlt:coverage95Pct 86.4 ;
        mlt:medianRMSConsensus 0.0304 ;
        mlt:medianRMSFull30 0.0108 ;
        mlt:medianRMSNearestRelative 0.0128 ;
        mlt:medianRMSPCA7 0.0135 ;
        mlt:medianRMSThompson7 0.0209 ;
        mlt:n 184 ;
        mlt:tauLowerMyr 0.0 ;
        mlt:tauUpperMyr 5.0 .

    <https://w3id.org/morpholib/thompson/engine/validation-summary-horizon-10-25> a mlt:HorizonBin ;
        mlt:coverage95Pct 94.5 ;
        mlt:medianRMSConsensus 0.0263 ;
        mlt:medianRMSFull30 0.0134 ;
        mlt:medianRMSNearestRelative 0.0164 ;
        mlt:medianRMSPCA7 0.0155 ;
        mlt:medianRMSThompson7 0.019 ;
        mlt:n 493 ;
        mlt:tauLowerMyr 10.0 ;
        mlt:tauUpperMyr 25.0 .

    <https://w3id.org/morpholib/thompson/engine/validation-summary-horizon-120-400> a mlt:HorizonBin ;
        mlt:coverage95Pct 77.8 ;
        mlt:medianRMSConsensus 0.0291 ;
        mlt:medianRMSFull30 0.0358 ;
        mlt:medianRMSNearestRelative 0.0429 ;
        mlt:medianRMSPCA7 0.0366 ;
        mlt:medianRMSThompson7 0.0351 ;
        mlt:n 27 ;
        mlt:tauLowerMyr 120.0 ;
        mlt:tauUpperMyr 400.0 .

    <https://w3id.org/morpholib/thompson/engine/validation-summary-horizon-25-50> a mlt:HorizonBin ;
        mlt:coverage95Pct 91.5 ;
        mlt:medianRMSConsensus 0.0283 ;
        mlt:medianRMSFull30 0.0165 ;
        mlt:medianRMSNearestRelative 0.021 ;
        mlt:medianRMSPCA7 0.0179 ;
        mlt:medianRMSThompson7 0.023 ;
        mlt:n 495 ;
        mlt:tauLowerMyr 25.0 ;
        mlt:tauUpperMyr 50.0 .

    <https://w3id.org/morpholib/thompson/engine/validation-summary-horizon-5-10> a mlt:HorizonBin ;
        mlt:coverage95Pct 91.6 ;
        mlt:medianRMSConsensus 0.0265 ;
        mlt:medianRMSFull30 0.0106 ;
        mlt:medianRMSNearestRelative 0.0129 ;
        mlt:medianRMSPCA7 0.0136 ;
        mlt:medianRMSThompson7 0.0184 ;
        mlt:n 190 ;
        mlt:tauLowerMyr 5.0 ;
        mlt:tauUpperMyr 10.0 .

    <https://w3id.org/morpholib/thompson/engine/validation-summary-horizon-50-80> a mlt:HorizonBin ;
        mlt:coverage95Pct 79.3 ;
        mlt:medianRMSConsensus 0.0298 ;
        mlt:medianRMSFull30 0.0345 ;
        mlt:medianRMSNearestRelative 0.0416 ;
        mlt:medianRMSPCA7 0.0342 ;
        mlt:medianRMSThompson7 0.0345 ;
        mlt:n 450 ;
        mlt:tauLowerMyr 50.0 ;
        mlt:tauUpperMyr 80.0 .

    <https://w3id.org/morpholib/thompson/engine/validation-summary-horizon-80-120> a mlt:HorizonBin ;
        mlt:coverage95Pct 83.1 ;
        mlt:medianRMSConsensus 0.0272 ;
        mlt:medianRMSFull30 0.0292 ;
        mlt:medianRMSNearestRelative 0.0397 ;
        mlt:medianRMSPCA7 0.0291 ;
        mlt:medianRMSThompson7 0.0274 ;
        mlt:n 390 ;
        mlt:tauLowerMyr 80.0 ;
        mlt:tauUpperMyr 120.0 .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://github.com/fractastical/morpholib/blob/main/thompson/run_phylogenetic_prediction_engine.py> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/s41586-018-0273-1>,
            <https://doi.org/10.1371/journal.pone.0112732> ;

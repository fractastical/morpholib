        mlt:claim "Polyprion, Pseudopriacanthus (Pristigenys) altus, Scorpaena and Antigonia capros are related by a fan/divergent-convergent coordinate transformation." ;
        mlt:claimId "T1917-048" ;
        mlt:counterclaim "No literature test of the Polyprion->Antigonia fan series was found. Open in the literature; repo-tested 2026 at landmark level." ;
        mlt:dataKindNeeded "IN_REPO" ;
        mlt:datasetAuditReason "Core test done in repo; remaining upgrade (real-specimen outlines) is loop-doable on in-repo data." ;
        mlt:datasetExistence "IN_REPO" ;

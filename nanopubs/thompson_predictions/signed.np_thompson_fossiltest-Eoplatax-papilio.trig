@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mlt: <https://w3id.org/morpholib/thompson/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/morpholib/thompson/np/fossiltest-Eoplatax-papilio/RAT6mCR8CAuDGlp_3C4F7Bh5FNXlGMzZ1HjEehFQTn638/> .
@prefix this: <https://w3id.org/morpholib/thompson/np/fossiltest-Eoplatax-papilio/RAT6mCR8CAuDGlp_3C4F7Bh5FNXlGMzZ1HjEehFQTn638> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Eoplatax-papilio> a mlt:FossilPredictionTest ;
        rdfs:label "Monte Bolca test: Eoplatax papilio (Ephippidae) vs. predicted Ephippidae lineage at 50 Ma" ;
        dcterms:bibliographicCitation "No published ratio located (Blot 1969 monograph not online). Range estimated by the author from two photographed specimens: MCSNV specimen (Wikimedia Commons 'Eoplatax papilio 376.jpg', CC BY-SA 4.0, Ghedoghedo) and NHMW specimen (Wikimedia Commons 'Eoplatax Vienna.jpg', CC BY 2.0), measuring body depth at the dorsal/anal fin bases (excluding the elongate fin webs) over snout-to-hypural length. Blot (1969) describes the body as about as deep as, or deeper than, long." ;
        rdfs:comment "photograph-derived estimate; the discriminating question (deep Platax-like body vs. the 0.57-0.77 stem prediction) is robust to the measurement uncertainty" ;
        mlt:ageMa 50.0 ;
        mlt:family "Ephippidae" ;
        mlt:fossilTaxon "Eoplatax papilio" ;
        mlt:hasMeasurementComparison <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Eoplatax-papilio-BDmax_over_SL> ;
        mlt:nullHypothesis "phylogenetic stasis: fossil proportions equal the living family mean" ;
        mlt:phylogeneticPlacement "Ephippidae, closely allied to Platax (Blot 1969; Carnevale et al. 2014)" ;
        mlt:testsPrediction <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Ephippidae> ;
        mlt:verdictBodyDepth "outside the 95% predictive interval (prediction falsified as stated, subject to the fossil's placement on the lineage)" .

    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Eoplatax-papilio-BDmax_over_SL> a mlt:MeasurementComparison ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length" ;
        mlt:directionOfChangeCorrect true ;
        mlt:fossilInsidePredictiveInterval95 false ;
        mlt:fossilValueLower 0.8 ;
        mlt:fossilValueUpper 1.05 ;
        mlt:livingFamilyMean 1.018 ;
        mlt:predictedFull30 0.6732 ;
        mlt:predictedFull30Lower95 0.5711 ;
        mlt:predictedFull30Upper95 0.7716 ;
        mlt:predictedThompson7 0.5619 ;
        mlt:predictionCloserThanStasisNull false ;
        mlt:ratioName "BDmax_over_SL" .
}

sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}


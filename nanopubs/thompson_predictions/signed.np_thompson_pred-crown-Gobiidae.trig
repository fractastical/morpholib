sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Gobiidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Gobiidae at 64.7 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Gobiidae lineage at 64.7 Ma given 25 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 64.7 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0349 ;
        mlt:expectedProcrustesRMSThompson7 0.0347 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Gobiidae dated to 65 +/- 13 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.203, 0.285] falsifies this prediction (point estimate 0.243); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Gobiidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Gobiidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Gobiidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Gobiidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Gobiidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Gobiidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Gobiidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Gobiidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 25 ;
        mlt:predictedLandmarksFull30 "[[-0.2241, -0.04587], [-0.26959, 0.00167], [-0.02719, 0.0849], [0.34127, 0.04649], [0.43896, 0.04031], [0.43914, -0.05073], [0.33953, -0.05646], [0.15285, -0.08203], [-0.0561, 0.01707], [-0.05486, -0.0536], [-0.08546, 0.03658], [-0.14476, 0.02397], [-0.14772, -0.04627], [-0.2009, -0.05866], [-0.2322, 0.03128], [-0.18195, 0.03209], [-0.08693, 0.07928]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.23088, -0.03144], [-0.26867, -0.00665], [-0.03867, 0.09843], [0.35894, 0.04128], [0.43643, 0.03189], [0.42463, -0.04196], [0.34358, -0.04537], [0.16352, -0.09456], [-0.07128, -0.01353], [-0.05123, -0.04541], [-0.09469, 0.04352], [-0.14152, 0.02426], [-0.15078, -0.03899], [-0.20597, -0.04327], [-0.21816, 0.01465], [-0.17145, 0.01852], [-0.08379, 0.08866]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Gobiidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Gobiidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3228 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3579 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.3961 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Gobiidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2027 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2433 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.2848 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Gobiidae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2326 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2503 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.2693 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Gobiidae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3295 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3561 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.3816 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Gobiidae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;

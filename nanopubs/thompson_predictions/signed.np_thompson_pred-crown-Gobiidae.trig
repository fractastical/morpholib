    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Gobiidae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2434 ;

        mlt:pointEstimate 0.2836 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.3204 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Gobiidae-thompson7-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (7 linearised Thompson modes)" ;

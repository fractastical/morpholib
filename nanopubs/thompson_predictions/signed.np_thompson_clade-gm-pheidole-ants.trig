sub:assertion {
    <https://w3id.org/morpholib/thompson/clade-gm/clade-gm-pheidole-ants> a mlt:CladeGeometricMorphometricsOutcome ;
        rdfs:label "insects: Pheidole big-headed ants (Friedman et al. 2019: 651 minor heads, 502 major heads [23 LMs], minor & major mesosomas [10 LMs] across ~200 species on Pheidole_Tree.phy): Thompson-7 captures 50.4% of interspecific variance (PCA-7 94.6%), 2/5 pre-registered hypotheses supported (Brier 0.433)" ;
        mlt:brierScore 0.433 ;
        mlt:evaluatesPortfolio <https://w3id.org/morpholib/thompson/np/dataset-portfolio-2026-10-22/RA9ZKlSDsa68lEKRo7JR0Px5woGoCMUHRlSK_bHKag4EA> ;

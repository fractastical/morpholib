        mlt:hypothesisFileSha256 "50090939d34cb5f4deefc838b1a6fecfa0d31eaf555d8a2b5bc82444c838d0a2" ;
        mlt:hypothesisVerdict "{\"id\": \"PH1\", \"p\": 0.85, \"pass\": false}",
            "{\"id\": \"PH2\", \"p\": 0.85, \"pass\": false}",
            "{\"id\": \"PH3\", \"p\": 0.8, \"pass\": false}",
            "{\"id\": \"PH4\", \"p\": 0.8, \"pass\": true}",
            "{\"id\": \"PH5\", \"p\": 0.8, \"pass\": true}" ;
        mlt:looErrorRatioFullVsConsensus 0.6874 ;
        mlt:looErrorRatioThompson7VsConsensus 0.8582 ;
        mlt:nHypothesesSupported 2 ;
        mlt:nHypothesesTotal 5 ;
        mlt:pca7VarianceShare 0.9455 ;
        mlt:reportDocument <https://github.com/fractastical/morpholib/blob/967dc2c36396e60bc8955e12a8b582bba7b11df9/docs/portfolio/pheidole_ants.md> ;
        mlt:resultFileSha256 "741873c86efa89333f4127532375d6bc76291881b7ed66feb67b2c0b56053a32" ;
        mlt:testsPreregistrationManifest <https://w3id.org/morpholib/thompson/np/multiclade-preregistration-manifest-2026-10-23/RAQ_Giwd735IPhYg-cOMyPE6t4K9WPM9XlijGkNC6_eJ4> ;
        mlt:thompson7VarianceShare 0.5038 .
}


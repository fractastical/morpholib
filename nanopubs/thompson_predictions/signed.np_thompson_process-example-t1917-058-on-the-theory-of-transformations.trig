            <https://doi.org/10.5061/dryad.dfn2z356c> ;
        mlt:candidateDatasetTitle "Cranial endocast of the stem lagomorph Megalagus and brain structure of basal Euarchontoglires",
            "Data from: Can body mass and skull morphology predict seed and fruit ingestion potential for mammal species? A test using extant species and its application to extinct species",
            "Data from: Multiple factors behind early diversification of skull morphology in the continental radiation of New World monkeys",
            "Data from: Multiple regression modelling for estimating endocranial volume in extinct Mammalia" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVII, pp. 770-773, Figs. 404-408." ;
        mlt:claim "The human skull, inscribed in Cartesian coordinates and deformed, gives the skulls of chimpanzee, baboon and dog: ape/human skull difference is a whole-diagram transformation (notably of the facial/cranial proportions)." ;
        mlt:claimId "T1917-058" ;
        mlt:counterclaim "No published test of human->chimpanzee/baboon/dog skull transformation as Thompson drew it (Figs. 404-408) was found, despite abundant primate landmark data. Open -- and the most visible untested skull claim in the book." ;
        mlt:dataKindNeeded "primate cranial landmarks" ;
        mlt:datasetAuditReason "Dryad live search returned 3 title-relevant dataset(s), top: doi:10.5061/dryad.7r85116." ;
        mlt:datasetExistence "PUBLIC_SCRIPTABLE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 10 ;
        mlt:effortDaysLow 5 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Bookstein (1977) Math. Biosci. 34:177-219 (general); primate cranial GM literature is large but not Thompson-framed" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "Bookstein (1977) method critique applies" ;
        mlt:pass2Status "PARTIAL_REPO" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset PUBLIC_SCRIPTABLE, tier LOOP_WITH_SEED); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;

sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-058-on-the-theory-of-transformations> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-058 — Thompson (1917), Ch. XVII, pp. 770-773, Figs. 404-408" ;
        prov:wasRevisionOf sub:RAEVBQ7fvqXI-CbqIK0WSYldYfx8CIDB0GauagecGYmDY ;
        mlt:automationTier "LOOP_WITH_SEED" ;
        mlt:candidateDataset <https://doi.org/10.5061/dryad.0vt4b8gwg>,

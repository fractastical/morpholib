sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Pomacentridae at 48.7 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Pomacentridae lineage at 48.7 Ma given 124 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 48.72 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0198 ;
        mlt:expectedProcrustesRMSThompson7 0.027 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Pomacentridae dated to 49 +/- 10 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.431, 0.517] falsifies this prediction (point estimate 0.474); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 124 ;
        mlt:predictedLandmarksFull30 "[[-0.22029, -0.04033], [-0.25222, -0.00112], [-0.05285, 0.15686], [0.34612, 0.05727], [0.4067, 0.04884], [0.40728, -0.04945], [0.3397, -0.06355], [0.18286, -0.1485], [-0.05263, -0.03036], [-0.03486, -0.08717], [-0.09079, 0.06258], [-0.13332, 0.03709], [-0.15457, -0.06535], [-0.20817, -0.06165], [-0.22006, 0.02159], [-0.16447, 0.02397], [-0.09842, 0.1393]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.22595, -0.04768], [-0.26696, -0.00091], [-0.05282, 0.14808], [0.33874, 0.05908], [0.4081, 0.05048], [0.41347, -0.05224], [0.34245, -0.06389], [0.17488, -0.15073], [-0.05709, -0.02758], [-0.03645, -0.07953], [-0.09027, 0.06539], [-0.13436, 0.03792], [-0.14021, -0.06601], [-0.2, -0.06992], [-0.21406, 0.0295], [-0.1648, 0.03113], [-0.09466, 0.1369]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Pomacentridae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.5599 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.5994 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.6402 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.4305 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4745 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.5166 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2403 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2605 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.2813 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3689 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3967 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.4247 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.5376 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.5712 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.606 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.4157 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.4544 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.4932 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae-thompson7-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2548 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.2739 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.2935 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Pomacentridae-thompson7-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.368 ;

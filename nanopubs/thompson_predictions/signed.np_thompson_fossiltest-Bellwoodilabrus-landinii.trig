@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mlt: <https://w3id.org/morpholib/thompson/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/morpholib/thompson/np/fossiltest-Bellwoodilabrus-landinii/RAW1jRY1zdoVDFCjd6hRaQFm4Qpt5MO7BxTgdq34Y0q0o/> .
@prefix this: <https://w3id.org/morpholib/thompson/np/fossiltest-Bellwoodilabrus-landinii/RAW1jRY1zdoVDFCjd6hRaQFm4Qpt5MO7BxTgdq34Y0q0o> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Bellwoodilabrus-landinii> a mlt:FossilPredictionTest ;
        rdfs:label "Monte Bolca test: Bellwoodilabrus landinii (Labridae) vs. predicted Labridae lineage at 50 Ma" ;
        dcterms:bibliographicCitation "Bannikov A.F. & Carnevale G. (2010) Geodiversitas 32(2): 201-220, 'Measurements (as percentage of SL)': HL 31, maximum body depth 41, snout to first dorsal-fin spine 42. Holotype MCSNV IGVR 71214/71215, 34 mm SL." ;
        mlt:ageMa 50.0 ;
        mlt:family "Labridae" ;
        mlt:fossilTaxon "Bellwoodilabrus landinii" ;
        mlt:hasMeasurementComparison <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Bellwoodilabrus-landinii-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Bellwoodilabrus-landinii-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Bellwoodilabrus-landinii-PD_over_SL> ;
        mlt:nullHypothesis "phylogenetic stasis: fossil proportions equal the living family mean" ;
        mlt:phylogeneticPlacement "Labridae; unique combination of plesiomorphic and derived features (position within the family unresolved)" ;
        mlt:testsPrediction <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Labridae> ;
        mlt:verdictBodyDepth "outside the 95% predictive interval (prediction falsified as stated, subject to the fossil's placement on the lineage)" .

    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Bellwoodilabrus-landinii-BDmax_over_SL> a mlt:MeasurementComparison ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length" ;
        mlt:directionOfChangeCorrect false ;
        mlt:fossilInsidePredictiveInterval95 false ;
        mlt:fossilValueLower 0.41 ;
        mlt:fossilValueUpper 0.41 ;
        mlt:livingFamilyMean 0.3445 ;
        mlt:predictedFull30 0.3106 ;
        mlt:predictedFull30Lower95 0.2644 ;
        mlt:predictedFull30Upper95 0.3556 ;
        mlt:predictedThompson7 0.3314 ;
        mlt:predictionCloserThanStasisNull false ;
        mlt:ratioName "BDmax_over_SL" .

    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Bellwoodilabrus-landinii-HL_over_SL> a mlt:MeasurementComparison ;
        rdfs:label "head length / standard length" ;
        mlt:directionOfChangeCorrect false ;
        mlt:fossilInsidePredictiveInterval95 false ;
        mlt:fossilValueLower 0.31 ;
        mlt:fossilValueUpper 0.31 ;
        mlt:livingFamilyMean 0.2709 ;
        mlt:predictedFull30 0.2634 ;
        mlt:predictedFull30Lower95 0.2423 ;
        mlt:predictedFull30Upper95 0.2835 ;
        mlt:predictedThompson7 0.261 ;
        mlt:predictionCloserThanStasisNull false ;
        mlt:ratioName "HL_over_SL" .

    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Bellwoodilabrus-landinii-PD_over_SL> a mlt:MeasurementComparison ;
        rdfs:label "predorsal length / standard length" ;
        mlt:directionOfChangeCorrect false ;
        mlt:fossilInsidePredictiveInterval95 false ;
        mlt:fossilValueLower 0.42 ;
        mlt:fossilValueUpper 0.42 ;
        mlt:livingFamilyMean 0.3402 ;
        mlt:predictedFull30 0.3268 ;
        mlt:predictedFull30Lower95 0.2955 ;
        mlt:predictedFull30Upper95 0.3582 ;
        mlt:predictedThompson7 0.3333 ;
        mlt:predictionCloserThanStasisNull false ;
        mlt:ratioName "PD_over_SL" .
}

sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}


    <https://w3id.org/morpholib/thompson/process-instance/t1917-027-the-logarithmic-spiral> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-027 — Thompson (1917), Ch. XI, pp. 493-586, Figs. 237-303" ;
        prov:wasRevisionOf <https://w3id.org/morpholib/thompson/np/process-example-t1917-027-the-logarithmic-spiral/RAcEAQgf3RxMrNZZUgANL8cV0w6JaDZxlszftvdZig4wA> ;
        mlt:automationTier "FULL_LOOP" ;
        mlt:candidateDataset <https://doi.org/10.5061/dryad.3ffbg79mq>,
            <https://doi.org/10.5061/dryad.4mw6m9094>,
            <https://doi.org/10.5061/dryad.b5mkkwh8t>,
            <https://doi.org/10.5061/dryad.h70rxwddx>,
            <https://doi.org/10.5061/dryad.kj51b> ;
        mlt:candidateDatasetTitle "Data from: Mollusc-shell debris can mitigate the deleterious effects of organic pollution on marine sediments",
            "Eumelanin and pheomelanin pigmentation in mollusc shells may be less common than expected: insights from mass spectrometry",
            "Raw data and alignments for: Application of palaeogenetic techniques to historic mollusc shells reveals phylogeographic structure in a New Zealand abalone",
            "The bivalve shell biomineralization toolbox: bulging, not barren",
            "The shellome of the crocus clam Tridacna crocea emphasizes essential components of mollusc shell biomineralization" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XI, pp. 493-586, Figs. 237-303." ;
        mlt:claim "Spiral shells (and other gnomonic-growth structures) are logarithmic (equiangular) spirals: the wharves enlarge by a constant ratio, so the form is unchanged by growth (r proportional to e^{k theta})." ;
        mlt:claimId "T1917-027" ;
        mlt:counterclaim "Raup did not refute the logarithmic spiral; he demoted it from law to coordinate system. Real shells need three parameters (W whorl expansion, D, T) plus a generating-curve shape, parameters can drift during growth, and large regions of the possible morphospace are empty -- which a pure log-spiral law does not explain. Modern spiral-fitting (2021, 'Refined methods for estimating spirals', doi:10.26879/1071) needs 12 spiral types and treats 'spiral deviation' as the informative signal: exact log-spiral growth is the null, not the finding." ;
        mlt:dataKindNeeded "shell outlines (Commons/museum + his figures)" ;
        mlt:datasetAuditReason "Usable material already on disk (scout cache / portfolio / models); loop can ingest it directly." ;
        mlt:datasetExistence "IN_REPO" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 6 ;
        mlt:effortDaysLow 3 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Raup, D.M. (1966) J. Paleontol. 40:1178-1190; Raup & Michelson (1965) Science 147" ;
        mlt:literatureRelation "QUALIFIED" ;
        mlt:literatureWhoAndWhen "Raup (1966)" ;
        mlt:pass2Status "PARTIAL_REPO" ;
        mlt:quantitativeMargin "3+ Raup parameters replace Thompson's single spiral constant; deviations from log growth are systematic, not noise" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset IN_REPO, tier FULL_LOOP); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .


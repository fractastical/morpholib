sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Monacanthidae at 36.7 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Monacanthidae lineage at 36.7 Ma given 6 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 36.71 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0175 ;
        mlt:expectedProcrustesRMSThompson7 0.0253 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Monacanthidae dated to 37 +/- 7 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.350, 0.445] falsifies this prediction (point estimate 0.397); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 6 ;
        mlt:predictedLandmarksFull30 "[[-0.25954, -0.0498], [-0.28545, -0.02046], [-0.09145, 0.11544], [0.33951, 0.05797], [0.408, 0.05734], [0.41397, -0.03929], [0.35207, -0.04958], [0.162, -0.14914], [-0.07473, -0.04293], [-0.06261, -0.08285], [-0.06819, 0.06879], [-0.10669, 0.02337], [-0.15804, -0.05259], [-0.24567, -0.06384], [-0.15182, 0.04993], [-0.09891, 0.05464], [-0.07247, 0.12298]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.25011, -0.04299], [-0.2611, 0.00533], [-0.05903, 0.13176], [0.33053, 0.05747], [0.39568, 0.05545], [0.43624, -0.03659], [0.36469, -0.05377], [0.13758, -0.14597], [-0.04668, -0.03134], [-0.05564, -0.08129], [-0.06241, 0.05719], [-0.10664, 0.03354], [-0.16579, -0.06536], [-0.2403, -0.06622], [-0.18999, 0.03047], [-0.13884, 0.02881], [-0.08819, 0.12351]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Monacanthidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.4918 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.535 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5812 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3499 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3973 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.4452 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.312 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3347 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.3565 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3123 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3438 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.3771 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.4668 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.5063 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5492 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.3672 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.4132 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.462 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae-thompson7-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2861 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.3089 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.3298 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Monacanthidae-thompson7-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.3409 ;

    <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Scarus-ghobban-Pomacanthus-semicirculatus-thompson7-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.3604 ;

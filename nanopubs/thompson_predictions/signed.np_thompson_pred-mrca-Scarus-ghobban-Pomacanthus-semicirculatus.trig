sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Scarus-ghobban-Pomacanthus-semicirculatus> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Scarus ghobban + Pomacanthus semicirculatus at 112.8 Ma (most recent common ancestor of one of D'Arcy Thompson's 1917 transformation pairs)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Scarus ghobban + Pomacanthus semicirculatus lineage at 112.8 Ma given 2 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Most recent common ancestor of one of d'arcy thompson's 1917 transformation pairs. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 112.84 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0315 ;
        mlt:expectedProcrustesRMSThompson7 0.0293 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Scarus ghobban + Pomacanthus semicirculatus dated to 113 +/- 23 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.296, 0.375] falsifies this prediction (point estimate 0.336); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Scarus-ghobban-Pomacanthus-semicirculatus-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Scarus-ghobban-Pomacanthus-semicirculatus-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Scarus-ghobban-Pomacanthus-semicirculatus-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Scarus-ghobban-Pomacanthus-semicirculatus-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Scarus-ghobban-Pomacanthus-semicirculatus-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Scarus-ghobban-Pomacanthus-semicirculatus-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Scarus-ghobban-Pomacanthus-semicirculatus-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Scarus-ghobban-Pomacanthus-semicirculatus-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 2 ;
        mlt:predictedLandmarksFull30 "[[-0.22972, -0.04612], [-0.27447, 0.00241], [-0.01207, 0.11495], [0.32523, 0.04992], [0.43105, 0.03499], [0.4309, -0.04104], [0.33939, -0.05229], [0.17439, -0.11445], [-0.06686, -0.01788], [-0.04925, -0.06096], [-0.09304, 0.05275], [-0.13896, 0.03327], [-0.14663, -0.05478], [-0.20355, -0.06204], [-0.22166, 0.02718], [-0.16942, 0.02768], [-0.09532, 0.10641]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.23126, -0.03991], [-0.26879, -0.00192], [-0.03304, 0.11937], [0.34531, 0.04457], [0.42089, 0.03705], [0.42204, -0.04051], [0.34378, -0.04906], [0.17895, -0.1166], [-0.07204, -0.02174], [-0.04839, -0.06313], [-0.09459, 0.05296], [-0.14164, 0.03073], [-0.14977, -0.0536], [-0.20534, -0.05771], [-0.2174, 0.02356], [-0.17132, 0.02512], [-0.07739, 0.11081]]" ;
        mlt:predictionKind "mrca" ;
        mlt:targetLineage "Scarus ghobban + Pomacanthus semicirculatus" .

    <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Scarus-ghobban-Pomacanthus-semicirculatus-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3963 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4326 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.4683 .

    <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Scarus-ghobban-Pomacanthus-semicirculatus-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2959 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3357 ;

        mlt:pointEstimate 0.4722 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5042 .

    <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Scarus-ghobban-Pomacanthus-semicirculatus-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.3131 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.3513 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.3891 .

    <https://w3id.org/morpholib/thompson/prediction/pred-mrca-Scarus-ghobban-Pomacanthus-semicirculatus-thompson7-HL_over_SL> a mlt:PredictedRatio ;

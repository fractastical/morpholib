    <https://w3id.org/morpholib/thompson/claim/t1917-040> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-040 -- Ch. XVII, pp. ~724-735, Figs. 353-358" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XVII" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVII, pp. ~724-735, Figs. 353-358." ;
        mlt:claim "Human (and animal) heads/faces and proportions, in the Durer/Camper tradition, are mutually transformable by coordinate deformation; differences of facial angle/proportion are whole-grid deformations." ;
        mlt:claimId "T1917-040" ;
        mlt:claimType "geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "353-358" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-040> ;
        mlt:pages "~724-735" ;
        mlt:repo2026AssessmentNotLiterature "His Durer-derived human proportion grids have never been landmark-tested here (the ape/human skull instance is T1917-060)." ;
        mlt:repo2026StatusSeparate "UNTESTED" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-040> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-040 (Thompson 1917): NO_DIRECT_TEST -- Bookstein (1977) on the grid method generally" ;
        mlt:counterclaim "No test of Thompson's Durer-derived human proportion grids as such. The general method critique (T1917-039) applies." ;
        mlt:literatureCitation "Bookstein (1977) Math. Biosci. 34:177-219 covers Durer/Camper-style grids as part of the general intractability critique" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "Bookstein (1977) on the grid method generally" ;
        mlt:noDirectTestFoundAsOf "2026-10-26"^^xsd:date ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:statementOfAbsence "As of this literature review (2026-10-26), no published work directly tests this 1917 claim as Thompson stated it. Neighbouring results are not a test of this claim." ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-040> .
}


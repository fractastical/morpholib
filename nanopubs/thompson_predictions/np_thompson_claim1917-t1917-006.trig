        mlt:bytes 54663 ;
        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-006> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-006 -- Ch. II, pp. 16-49, Figs. 1" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "II" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. II, pp. 16-49, Figs. 1." ;
        mlt:claim "Cell (e.g. nerve-cell) size is roughly independent of the size of the animal; larger animals have more cells, not proportionally larger cells." ;
        mlt:claimId "T1917-006" ;
        mlt:claimType "quantitative-empirical" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "1" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-006> ;
        mlt:pages "16-49" ;
        mlt:repo2026AssessmentNotLiterature "Broadly supported with clade-specific exceptions (e.g. some neurons, eggs, polyploid cells)." ;
        mlt:repo2026StatusSeparate "DONE_ELSEWHERE" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-006> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-006 (Thompson 1917): QUALIFIED -- Modern cell-size literature (e.g. Marshall et al. 2012)" ;
        mlt:counterclaim "Broadly right, with named exceptions Thompson did not treat: some neurons, eggs, syncytia and polyploid cells scale with organism/ploidy. Cell size is actively regulated, not a passive constant." ;
        mlt:literatureCitation "Marshall, W.F. et al. (2012) Curr. Biol. 22:R256-R260 ('What determines cell size?')" ;
        mlt:literatureRelation "QUALIFIED" ;
        mlt:literatureWhoAndWhen "Modern cell-size literature (e.g. Marshall et al. 2012)" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-006> .
}


sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-004-on-magnitude> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-004 — Thompson (1917), Ch. II, pp. 16-49, Figs. -" ;
        prov:wasRevisionOf sub:RAsb7XrAQ492Yg49gBqBD3PCJnB9RgPlrv8ft7DgO755o ;
        mlt:automationTier "LOOP_WITH_SEED" ;
        mlt:candidateDataset <https://doi.org/10.5061/dryad.g9q79> ;
        mlt:candidateDatasetTitle "Data from: Impacts of genetic correlation on the independent evolution of body mass and skeletal size in mammals" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. II, pp. 16-49, Figs. -." ;
        mlt:claim "Strength of a support scales with cross-sectional area (L^2) while load scales with weight (L^3), so larger land animals must be relatively thicker-boned / differently proportioned (Galilean scaling)." ;
        mlt:claimId "T1917-004" ;
        mlt:counterclaim "Pure geometric similarity (strength L^2 vs weight L^3) does not describe real skeletons; McMahon's elastic-similarity (buckling) criterion predicts different, often better-fitting proportions. Thompson's scaling dilemma is real, his implied geometric solution is not the one animals use in general." ;
        mlt:dataKindNeeded "bone dimensions + mass table" ;
        mlt:datasetAuditReason "Dryad live search returned 1 title-relevant dataset(s), top: doi:10.5061/dryad.g9q79." ;
        mlt:datasetExistence "PUBLIC_SCRIPTABLE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 7 ;
        mlt:effortDaysLow 3 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "McMahon, T.A. (1973) Science 179:1201-1204 (elastic similarity); Schmidt-Nielsen, K. (1984) Scaling: Why Is Animal Size So Important?" ;
        mlt:literatureRelation "QUALIFIED" ;
        mlt:literatureWhoAndWhen "McMahon (1973); Schmidt-Nielsen (1984) and later allometry literature" ;
        mlt:pass2Status "DONE_ELSEWHERE" ;
        mlt:quantitativeMargin "Elastic similarity predicts diameter proportional to length^1.5 (vs geometric proportionality); fits many trees/limbs better, neither fits all" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset PUBLIC_SCRIPTABLE, tier LOOP_WITH_SEED); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_claims.json (repo artifact)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json> a prov:Entity ;

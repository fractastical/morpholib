sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Mullidae at 47.0 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Mullidae lineage at 47.0 Ma given 4 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 46.96 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0187 ;
        mlt:expectedProcrustesRMSThompson7 0.0254 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Mullidae dated to 47 +/- 9 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.232, 0.348] falsifies this prediction (point estimate 0.287); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 4 ;
        mlt:predictedLandmarksFull30 "[[-0.2331, -0.04645], [-0.28394, -0.01015], [-0.02193, 0.10593], [0.31538, 0.05223], [0.44496, 0.03189], [0.44315, -0.04759], [0.30293, -0.06648], [0.19972, -0.09596], [-0.06224, -0.00973], [-0.04463, -0.05101], [-0.09474, 0.05496], [-0.13983, 0.04373], [-0.14212, -0.06117], [-0.20242, -0.058], [-0.21619, 0.03094], [-0.1695, 0.03134], [-0.09551, 0.09553]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.22881, -0.03922], [-0.27208, -0.00842], [-0.03313, 0.11768], [0.34474, 0.04319], [0.42045, 0.03119], [0.42055, -0.04812], [0.34336, -0.05106], [0.19151, -0.10617], [-0.07293, -0.01568], [-0.04325, -0.05327], [-0.09973, 0.05264], [-0.14686, 0.02973], [-0.14538, -0.04724], [-0.1996, -0.05351], [-0.22286, 0.01827], [-0.17652, 0.02287], [-0.07945, 0.10711]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Mullidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3767 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4266 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.4801 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2316 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2872 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.348 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2356 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2614 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.2892 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3519 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.387 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.4273 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.4276 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.4725 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5196 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2758 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.3336 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.3908 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae-thompson7-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2243 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.2518 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.2799 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Mullidae-thompson7-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.3501 ;

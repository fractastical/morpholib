sub:assertion {
    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 claim registry (59 claims, all dated 1917)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 literature counterclaim layer" ;
        mlt:bytes 54663 ;
        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-045> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-045 -- Ch. XVII (fish I), pp. 748, Figs. 373-374" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XVII (fish I)" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVII (fish I), pp. 748, Figs. 373-374." ;
        mlt:claim "Argyropelecus olfersii is transformed into Sternoptyx diaphana by an oblique (shear) coordinate system whose axes are inclined at 70 degrees." ;
        mlt:claimId "T1917-045" ;
        mlt:claimType "geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "373-374" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-045> ;
        mlt:pages "748" ;
        mlt:repo2026AssessmentNotLiterature "Supported as a family at intrageneric/intrafamily scale; the exact pair is landmarked from archival plates. 600-pt exact-pair outline fit is the remaining upgrade." ;
        mlt:repo2026StatusSeparate "DONE_REPO" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:verbatimQuote "an oblique coordinate system whose axes are inclined at an angle of 70 deg (paraphrase pinned in thompson/1917-thompson-four-families-atlas.py docstring; verify verbatim in Pass-1 extension)" .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-045> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-045 (Thompson 1917): NO_DIRECT_TEST -- -" ;
        mlt:counterclaim "No literature test of Argyropelecus->Sternoptyx at 70 degrees was found (deep-sea pair, no landmark dataset until the repo's archival landmarking). Open in the literature; repo-tested 2026." ;
        mlt:literatureCitation "-" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "-" ;
        mlt:noDirectTestFoundAsOf "2026-10-26"^^xsd:date ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:statementOfAbsence "As of this literature review (2026-10-26), no published work directly tests this 1917 claim as Thompson stated it. Neighbouring results are not a test of this claim." ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-045> .
}


sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Siganidae at 17.6 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Siganidae lineage at 17.6 Ma given 17 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 17.64 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0135 ;
        mlt:expectedProcrustesRMSThompson7 0.0195 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Siganidae dated to 18 +/- 5 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.385, 0.460] falsifies this prediction (point estimate 0.423); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 17 ;
        mlt:predictedLandmarksFull30 "[[-0.22071, -0.03671], [-0.24553, -0.00482], [-0.08561, 0.12577], [0.37718, 0.03385], [0.41264, 0.03068], [0.41453, -0.01984], [0.38059, -0.0259], [0.10743, -0.14796], [-0.08674, -0.04212], [-0.06518, -0.09047], [-0.09539, 0.06547], [-0.12058, 0.05005], [-0.13474, -0.05515], [-0.20301, -0.05495], [-0.19473, 0.02574], [-0.1407, 0.02783], [-0.09946, 0.11853]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.22067, -0.04227], [-0.24206, 0.01247], [-0.0778, 0.12391], [0.35447, 0.03845], [0.43578, 0.03887], [0.43455, -0.0248], [0.34792, -0.0433], [0.11605, -0.13166], [-0.06126, -0.03355], [-0.06044, -0.08254], [-0.08641, 0.05519], [-0.12421, 0.03461], [-0.15196, -0.06711], [-0.2076, -0.0678], [-0.19402, 0.03677], [-0.15125, 0.03173], [-0.11111, 0.12103]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Siganidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.4843 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.5175 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5531 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3854 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4229 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.46 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2333 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2511 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.2696 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2954 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3212 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.3454 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.4522 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.481 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5114 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.35 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.3832 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.4175 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae-thompson7-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.225 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.2414 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.2578 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Siganidae-thompson7-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.288 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.3104 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.3336 .
}


    <https://w3id.org/morpholib/thompson/process-instance/t1917-022-the-forms-of-tissues-continued> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-022 — Thompson (1917), Ch. VIII, pp. 346-410, Figs. 176-193" ;
        prov:wasRevisionOf <https://w3id.org/morpholib/thompson/np/process-example-t1917-022-the-forms-of-tissues-continued/RAnyFrJAaYl3Ayr6_pr8RZSAGk51Y7h8KWgfT4anX2pqw> ;
        mlt:automationTier "LOOP_WITH_SEED" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. VIII, pp. 346-410, Figs. 176-193." ;
        mlt:claim "Isoperimetric/minimal-area principles also govern other hollow and aggregate structures he treats in this chapter (e.g. radiolarian-like and echinoderm larval skeletal arrangements, vessel and tissue partitions)." ;
        mlt:claimId "T1917-022" ;
        mlt:counterclaim "Catch-all row: no single literature verdict. For its foam instance there IS a precise counterclaim: Kelvin's supposedly minimal equal-volume cell (the structure Thompson's generation took as the minimal partition) is beaten by the Weaire-Phelan structure. Split this row per structure before citing any verdict." ;
        mlt:dataKindNeeded "per-structure images (split first)" ;
        mlt:datasetAuditReason "Public hits exist but title relevance is weak; loop Step 1 must vet species/variables before fetch." ;
        mlt:datasetExistence "PUBLIC_CANDIDATE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 15 ;
        mlt:effortDaysLow 5 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Weaire, D. & Phelan, R. (1994) Phil. Mag. Lett. 69:107-110" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "Weaire & Phelan (1994) for the foam instance" ;
        mlt:pass2Status "UNTESTED" ;
        mlt:quantitativeMargin "Weaire-Phelan uses ~0.3% less surface area than Kelvin's cell (1994)" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset PUBLIC_CANDIDATE, tier LOOP_WITH_SEED); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,

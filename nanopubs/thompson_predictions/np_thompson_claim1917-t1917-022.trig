    <https://w3id.org/morpholib/thompson/claim/t1917-022> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-022 -- Ch. VIII, pp. 346-410, Figs. 176-193" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "VIII" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. VIII, pp. 346-410, Figs. 176-193." ;
        mlt:claim "Isoperimetric/minimal-area principles also govern other hollow and aggregate structures he treats in this chapter (e.g. radiolarian-like and echinoderm larval skeletal arrangements, vessel and tissue partitions)." ;
        mlt:claimId "T1917-022" ;
        mlt:claimType "geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "176-193" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-022> ;
        mlt:pages "346-410" ;
        mlt:repo2026AssessmentNotLiterature "A catch-all row: split per structure before testing. Keep as a parent row only." ;
        mlt:repo2026StatusSeparate "UNTESTED" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-022> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-022 (Thompson 1917): NO_DIRECT_TEST -- Weaire & Phelan (1994) for the foam instance" ;
        mlt:counterclaim "Catch-all row: no single literature verdict. For its foam instance there IS a precise counterclaim: Kelvin's supposedly minimal equal-volume cell (the structure Thompson's generation took as the minimal partition) is beaten by the Weaire-Phelan structure. Split this row per structure before citing any verdict." ;
        mlt:literatureCitation "Weaire, D. & Phelan, R. (1994) Phil. Mag. Lett. 69:107-110" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "Weaire & Phelan (1994) for the foam instance" ;
        mlt:noDirectTestFoundAsOf "2026-10-26"^^xsd:date ;
        mlt:quantitativeMargin "Weaire-Phelan uses ~0.3% less surface area than Kelvin's cell (1994)" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:statementOfAbsence "As of this literature review (2026-10-26), no published work directly tests this 1917 claim as Thompson stated it. Neighbouring results are not a test of this claim." ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-022> .
}


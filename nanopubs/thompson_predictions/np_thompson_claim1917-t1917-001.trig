    <https://w3id.org/morpholib/thompson/claim/t1917-001> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-001 -- Ch. I, pp. 1-15, Figs. -" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "I" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. I, pp. 1-15, Figs. -." ;
        mlt:claim "The form of an organism is a 'diagram of forces': form can and should be described physically and mathematically, in terms of the forces that produced it." ;
        mlt:claimId "T1917-001" ;
        mlt:claimType "methodological" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "-" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-001> ;
        mlt:pages "1-15" ;
        mlt:repo2026AssessmentNotLiterature "Operationalise per-chapter (that is what rows T1917-003..058 do). As a programme it is vindicated wherever a physical model fits form with fewer parameters than a purely descriptive one." ;
        mlt:repo2026StatusSeparate "NOT_TESTABLE_AS_STATED" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-001> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-001 (Thompson 1917): NOT_TESTABLE -- Gould (1971); Medawar and later commentators" ;
        mlt:counterclaim "No counterclaim is possible against a programme. Gould's influential qualification: physical forces are real but form is also shaped by evolutionary history and contingency -- 'form as diagram of forces' is incomplete, not false." ;
        mlt:literatureCitation "Gould, S.J. (1971) 'D'Arcy Thompson and the science of form' (essay; repr. in Gould 1977, Ever Since Darwin)" ;
        mlt:literatureRelation "NOT_TESTABLE" ;
        mlt:literatureWhoAndWhen "Gould (1971); Medawar and later commentators" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-001> .
}


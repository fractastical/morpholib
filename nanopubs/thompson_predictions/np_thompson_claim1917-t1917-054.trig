    <https://w3id.org/morpholib/thompson/claim/t1917-054> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-054 -- Ch. XVII, pp. 757-759, Figs. 388-393" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XVII" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVII, pp. 757-759, Figs. 388-393." ;
        mlt:claim "The pelves of Archaeopteryx and Apatornis (after Heilmann) and intermediate configurations can be found by interpolation between coordinate-transformed forms - i.e. interpolated grids generate biologically real intermediate forms." ;
        mlt:claimId "T1917-054" ;
        mlt:claimType "geometric-methodological" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "388-393" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-054> ;
        mlt:pages "757-759" ;
        mlt:repo2026AssessmentNotLiterature "The interpolation-generates-real-forms claim is validated in principle (fish ancestors/fossils) but never on Heilmann's bird pelves." ;
        mlt:repo2026StatusSeparate "PARTIAL_REPO" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-054> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-054 (Thompson 1917): QUALIFIED -- Bookstein (1989) and the TPS/ancestral-reconstruction literature" ;
        mlt:counterclaim "Heilmann's interpolation idea became standard machinery (TPS interpolation between landmark configurations is exactly how morphometricians now generate intermediates), so the *method* was vindicated by adoption. The *biological* claim -- that grid-interpolated forms are the real intermediate forms -- is only testable against fossils, and the literature does not test it on Heilmann's bird pelves." ;
        mlt:literatureCitation "Bookstein (1989) IEEE TPAMI 11:567-585; Rohlf's tps software literature (from 1990)" ;
        mlt:literatureRelation "QUALIFIED" ;
        mlt:literatureWhoAndWhen "Bookstein (1989) and the TPS/ancestral-reconstruction literature" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-054> .
}


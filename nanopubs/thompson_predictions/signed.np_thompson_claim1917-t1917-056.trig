sub:assertion {
    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 claim registry (59 claims, all dated 1917)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 literature counterclaim layer" ;
        mlt:bytes 54663 ;
        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-056> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-056 -- Ch. XVII, pp. 765-767, Figs. 401-402" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XVII" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVII, pp. 765-767, Figs. 401-402." ;
        mlt:claim "The skull of Eohippus (Hyracotherium) is transformed into that of Equus by coordinate deformation, with actual and hypothetical intermediates (after Heilmann) lying on the transformation." ;
        mlt:claimId "T1917-056" ;
        mlt:claimType "geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "401-402" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-056> ;
        mlt:pages "765-767" ;
        mlt:repo2026AssessmentNotLiterature "Untested, and one of the most iconic untested pairs. Horse skull GM data are public; intermediates make it falsifiable (do real mesohippus-stage skulls lie on the warp path?)." ;
        mlt:repo2026StatusSeparate "UNTESTED" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-056> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-056 (Thompson 1917): NO_DIRECT_TEST -- -" ;
        mlt:counterclaim "No direct Thompson test found. Closest literature is suggestive-counter (horses as pattern-breakers), not a verdict on Fig. 401-402." ;
        mlt:literatureCitation "Equid skull evolution has a modern GM literature (e.g. Dryad 10.5061/dryad.crjdfn3g3, 'horses deviate from a pervasive pattern of skull shape evolution') -- its very title signals that horse skulls do NOT follow the simple pervasive pattern, but it is not a test of Thompson's Eohippus->Equus grid" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "-" ;
        mlt:noDirectTestFoundAsOf "2026-10-26"^^xsd:date ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:statementOfAbsence "As of this literature review (2026-10-26), no published work directly tests this 1917 claim as Thompson stated it. Neighbouring results are not a test of this claim." ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-056> .
}


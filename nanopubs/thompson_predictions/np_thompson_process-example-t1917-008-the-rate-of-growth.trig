<https://w3id.org/morpholib/thompson/np/process-example-t1917-008-the-rate-of-growth/assertion> {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-008-the-rate-of-growth> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-008 — Thompson (1917), Ch. III, pp. 50-155, Figs. 18-22" ;
        prov:wasRevisionOf <https://w3id.org/morpholib/thompson/np/process-example-t1917-008-the-rate-of-growth/RAzbLfc02nsU2dtNn-zBiNk2Bc5cGbv8gRPf9wCgLcdT8> ;
        mlt:automationTier "FULL_LOOP" ;
        mlt:candidateDataset <https://doi.org/10.5061/dryad.cjsxksn4m>,
            <https://doi.org/10.5061/dryad.dfn2z34xq>,
            <https://doi.org/10.5061/dryad.gg6qk>,
            <https://doi.org/10.5061/dryad.sn02v6xjt>,
            <https://doi.org/10.5061/dryad.wwpzgmspq> ;
        mlt:candidateDatasetTitle "Allometry rather than abiotic drivers explains biomass allocation among leaves, stems and roots of Artemisia across a large environmental gradient in China",
            "Data for: Morphological covariance and onset of foot prehensility as indicators of integrated evolutionary dynamics in the herons (Ardeidae)",
            "Data from: Body-size scaling of metabolic rate in the trilobite Eldredgeops rana",
            "Data from: The evolution of a placenta is not linked to increased brain size in poeciliid fishes",
            "Supplementary material to: Segmental series and size: clade-wide investigation of molar proportions reveals a major evolutionary allometry in the dentition of placental mammals" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. III, pp. 50-155, Figs. 18-22." ;
        mlt:claim "Parts of an organism grow at different but definite relative rates, so form changes systematically with size; the changing proportions of organs (brain, heart, body; plaice weight-length) are growth-rate phenomena." ;
        mlt:claimId "T1917-008" ;
        mlt:counterclaim "SUPPORTING: Huxley (1932) turned Thompson's differential-growth claim into the allometric law y = b x^k. COUNTER (1950): the allometry equation cannot simultaneously hold between two parts and the whole, and often only fits as piecewise straight lines -- so its constants are 'a rough and ready shorthand of description', not physiological entities. Fitting the law does not prove a growth-rate mechanism." ;
        mlt:dataKindNeeded "organ/part size vs body size" ;
        mlt:datasetAuditReason "Usable material already on disk (scout cache / portfolio / models); loop can ingest it directly." ;
        mlt:datasetExistence "IN_REPO" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 8 ;
        mlt:effortDaysLow 4 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Huxley, J.S. (1932) Problems of Relative Growth; Needham, Zuckerman et al. (1950) Proc. R. Soc. B 137:465-525; Gould, S.J. (1966) Biol. Rev. 41:587-640" ;
        mlt:literatureRelation "MIXED" ;
        mlt:literatureWhoAndWhen "Huxley (1932) formalised it; Royal Society discussion (1950) and Gould (1966) qualified it" ;
        mlt:pass2Status "PARTIAL_REPO" ;
        mlt:quantitativeMargin "Huxley's k = ratio of specific growth rates; the 1950 objection is logical (inconsistent between part-part and part-whole fits), not a percentage" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset IN_REPO, tier FULL_LOOP); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .


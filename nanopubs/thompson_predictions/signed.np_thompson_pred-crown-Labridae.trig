sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Labridae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Labridae at 79.9 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Labridae lineage at 79.9 Ma given 139 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 79.89 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0324 ;
        mlt:expectedProcrustesRMSThompson7 0.0318 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Labridae dated to 80 +/- 16 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.302, 0.401] falsifies this prediction (point estimate 0.352); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Labridae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Labridae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Labridae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Labridae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Labridae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Labridae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Labridae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Labridae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 139 ;
        mlt:predictedLandmarksFull30 "[[-0.23783, -0.03615], [-0.2728, -0.00284], [-0.04721, 0.11933], [0.34192, 0.05702], [0.42643, 0.04935], [0.42395, -0.05187], [0.34736, -0.05983], [0.15085, -0.12042], [-0.05998, -0.02185], [-0.03924, -0.06445], [-0.08531, 0.05507], [-0.13677, 0.03398], [-0.14046, -0.06342], [-0.20411, -0.0596], [-0.20968, 0.02683], [-0.16815, 0.02784], [-0.08897, 0.111]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.23187, -0.03918], [-0.26832, -0.00295], [-0.04931, 0.1239], [0.35157, 0.05401], [0.42301, 0.04603], [0.41987, -0.04695], [0.34495, -0.05589], [0.15879, -0.12784], [-0.05946, -0.02174], [-0.04488, -0.06457], [-0.08697, 0.05432], [-0.13256, 0.03085], [-0.14793, -0.05335], [-0.20865, -0.05664], [-0.21321, 0.02227], [-0.16359, 0.0247], [-0.09144, 0.11305]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Labridae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Labridae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.4102 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4568 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5026 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Labridae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3018 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3522 ;

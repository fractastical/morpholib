    <https://w3id.org/morpholib/thompson/portfolio/multiclade-preregistration-manifest-2026-10-23> a mlt:MultiCladePreregistrationManifest ;
        rdfs:label "Pre-registration manifest locking 15 multi-clade 2D geometric-morphometric hypothesis sets (82 hypotheses across Mollusca, Actinopterygii, Amphibia, Squamata, Aves, Mammalia, Angiospermae, and Insecta), 2026-10-23" ;
        mlt:extendsPortfolio <https://w3id.org/morpholib/thompson/np/dataset-portfolio-2026-10-22/RA9ZKlSDsa68lEKRo7JR0Px5woGoCMUHRlSK_bHKag4EA> ;

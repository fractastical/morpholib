sub:assertion {
    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 claim registry (59 claims, all dated 1917)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 literature counterclaim layer" ;
        mlt:bytes 54663 ;
        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-003> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-003 -- Ch. II, pp. 16-49, Figs. 1-2" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "II" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. II, pp. 16-49, Figs. 1-2." ;
        mlt:claim "Surface grows as L^2 and volume/weight as L^3, so surface:volume falls as 1/L; this alone bounds organism size and forces disproportionate change of parts with size." ;
        mlt:claimId "T1917-003" ;
        mlt:claimType "quantitative-geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "1-2" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-003> ;
        mlt:pages "16-49" ;
        mlt:repo2026AssessmentNotLiterature "Textbook scaling (supported with well-known exceptions via folding/fractal surfaces). A repo check is a teaching plot, not new science." ;
        mlt:repo2026StatusSeparate "DONE_ELSEWHERE" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-003> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-003 (Thompson 1917): PARTIALLY_REFUTED -- Kleiber (1932); Glazier (2022)" ;
        mlt:counterclaim "The surface-law application (metabolism proportional to surface, M^2/3) was countered by Kleiber (1932): basal metabolic rate scales as ~M^3/4, not M^2/3. Glazier (2022) counters both: exponents are variable and context-dependent -- there is no universal 2/3 or 3/4. The pure geometry (area L^2, volume L^3) is not in dispute; its use as a metabolic law is." ;
        mlt:literatureCitation "Kleiber, M. (1932) Hilgardia 6:315-353; Glazier, D.S. (2022) Proc. R. Soc. B 289:20221605" ;
        mlt:literatureRelation "PARTIALLY_REFUTED" ;
        mlt:literatureWhoAndWhen "Kleiber (1932); Glazier (2022)" ;
        mlt:quantitativeMargin "Exponent dispute: 0.67 (surface law) vs 0.73-0.75 (Kleiber 1932) vs 'no universal exponent' (Glazier 2022)" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-003> .
}


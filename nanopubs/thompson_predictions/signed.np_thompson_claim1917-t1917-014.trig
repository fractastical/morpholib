sub:assertion {
    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 claim registry (59 claims, all dated 1917)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 literature counterclaim layer" ;
        mlt:bytes 54663 ;
        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-014> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-014 -- Ch. V, pp. 201-276, Figs. 61-67, 72-96" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "V" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. V, pp. 201-276, Figs. 61-67, 72-96." ;
        mlt:claim "The forms of single cells and cell-like organisms (Plateau's oil globules; Lagena and other forams/protists) are surfaces of revolution from the minimal-surface catalogue: sphere, cylinder, unduloid, nodoid, catenoid." ;
        mlt:claimId "T1917-014" ;
        mlt:claimType "geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "61-67, 72-96" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-014> ;
        mlt:pages "201-276" ;
        mlt:repo2026AssessmentNotLiterature "Never fitted organism-by-organism to Thompson's figured genera with an area-minimality score. This is one of the cheapest untouched wins: outlines are in his figures and in modern images." ;
        mlt:repo2026StatusSeparate "PARTIAL_REPO" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-014> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-014 (Thompson 1917): QUALIFIED -- Modern cell-mechanics comparisons (e.g. PLOS Comput. Biol. 2023, cell shape vs minimal surfaces)" ;
        mlt:counterclaim "Constant-mean-curvature (Plateau/Delaunay) shapes are a good model for suspended cells and a measurably wrong one for adherent/structured cells: observed-vs-minimised shape discrepancy is large in L- and V-shaped micropatterns (spectral amplitude difference ~0.15-0.18) and small in triangular patterns (~0.03). Thompson's catalogue is a limiting case, not the general rule." ;
        mlt:literatureCitation "'Modelling cell shape in 3D structured environments' (2023) PLOS Comput. Biol. 19:e1011412" ;
        mlt:literatureRelation "QUALIFIED" ;
        mlt:literatureWhoAndWhen "Modern cell-mechanics comparisons (e.g. PLOS Comput. Biol. 2023, cell shape vs minimal surfaces)" ;
        mlt:quantitativeMargin "Discrepancy ~0.15-0.18 (L/V patterns) vs ~0.03 (triangular): context decides, contra a universal surface-tension law" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-014> .
}


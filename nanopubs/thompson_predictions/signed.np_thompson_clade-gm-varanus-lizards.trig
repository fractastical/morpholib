sub:assertion {
    <https://w3id.org/morpholib/thompson/clade-gm/clade-gm-varanus-lizards> a mlt:CladeGeometricMorphometricsOutcome ;
        rdfs:label "squamate reptiles: Indo-Australasian Varanus monitor lizards (Brennan et al. 2021 Syst Biol / Zenodo 5655818: 1,091 dorsal + 1,098 lateral crania across 80 taxa on calibrated Tree.tre; 33 dorsal LMs & 10 lateral LMs): Thompson-7 captures 59.5% of interspecific variance (PCA-7 85.6%), 1/4 pre-registered hypotheses supported (Brier 0.507)" ;
        mlt:brierScore 0.5075 ;
        mlt:evaluatesPortfolio <https://w3id.org/morpholib/thompson/np/dataset-portfolio-2026-10-22/RA9ZKlSDsa68lEKRo7JR0Px5woGoCMUHRlSK_bHKag4EA> ;
        mlt:figureAsset <https://github.com/fractastical/morpholib/blob/967dc2c36396e60bc8955e12a8b582bba7b11df9/docs/portfolio/fig_varanus_lizards.png> ;
        mlt:hypothesisFileSha256 "ef9803547c4e51fb7358859e550ba1c3c270a4f8904c175004381324ef017216" ;
        mlt:hypothesisVerdict "{\"id\": \"VL1\", \"p\": 0.85, \"pass\": true}",
            "{\"id\": \"VL2\", \"p\": 0.85, \"pass\": false}",
            "{\"id\": \"VL3\", \"p\": 0.85, \"pass\": false}",
            "{\"id\": \"VL4\", \"p\": 0.75, \"pass\": false}" ;
        mlt:looErrorRatioFullVsConsensus 1.0 ;
        mlt:looErrorRatioThompson7VsConsensus 0.893 ;
        mlt:nHypothesesSupported 1 ;
        mlt:nHypothesesTotal 4 ;
        mlt:pca7VarianceShare 0.8562 ;
        mlt:reportDocument <https://github.com/fractastical/morpholib/blob/967dc2c36396e60bc8955e12a8b582bba7b11df9/docs/portfolio/varanus_lizards.md> ;
        mlt:resultFileSha256 "39b16d402fc26bd8f60704dfe3df81d5253f179a9e6bc8b405d0b0f58d4bfca0" ;
        mlt:testsPreregistrationManifest <https://w3id.org/morpholib/thompson/np/multiclade-preregistration-manifest-2026-10-23/RAQ_Giwd735IPhYg-cOMyPE6t4K9WPM9XlijGkNC6_eJ4> ;
        mlt:thompson7VarianceShare 0.5947 .
}


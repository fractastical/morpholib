sub:assertion {
    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 claim registry (59 claims, all dated 1917)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 literature counterclaim layer" ;
        mlt:bytes 54663 ;
        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-011> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-011 -- Ch. IV, pp. 156-200, Figs. 41-59" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "IV" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. IV, pp. 156-200, Figs. 41-59." ;
        mlt:claim "The mitotic figure behaves as a system of forces between two poles: spindle and aster configurations, and chromosome movements, follow the lines of a bipolar field of force (with Peddie's magnetic-field diagrams as the physical analogue)." ;
        mlt:claimId "T1917-011" ;
        mlt:claimType "mechanistic" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "41-59" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-011> ;
        mlt:pages "156-200" ;
        mlt:repo2026AssessmentNotLiterature "Superseded mechanistically (microtubule dynamics, motor proteins), though the field/polarity language survives in modern spindle mechanics. A repo 'test' would be history-of-mechanism, not a fit." ;
        mlt:repo2026StatusSeparate "DONE_ELSEWHERE" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-011> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-011 (Thompson 1917): SUPERSEDED -- Mitchison & Kirschner (1984); McIntosh (2012)" ;
        mlt:counterclaim "Thompson/Peddie's bipolar field-of-force mechanism is not the mechanism. The spindle is a self-organising microtubule machine: dynamic instability (1984) lets microtubules search-and-capture chromosomes, and depolymerisation itself generates poleward force with no motor and no ATP (shown in vitro from 1988). The bipolar *geometry* Thompson drew was right; the force-field physics was replaced." ;
        mlt:literatureCitation "Mitchison, T. & Kirschner, M. (1984) Nature 312:237-242 (dynamic instability / search-and-capture); McIntosh, J.R. (2012) 'Motors or dynamics: what really moves chromosomes?'" ;
        mlt:literatureRelation "SUPERSEDED" ;
        mlt:literatureWhoAndWhen "Mitchison & Kirschner (1984); McIntosh (2012)" ;
        mlt:quantitativeMargin "Mechanism replaced wholesale (1984-2012); geometry retained" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-011> .
}


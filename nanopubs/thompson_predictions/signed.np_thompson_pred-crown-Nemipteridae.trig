sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Nemipteridae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Nemipteridae at 44.6 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Nemipteridae lineage at 44.6 Ma given 8 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 44.55 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0183 ;
        mlt:expectedProcrustesRMSThompson7 0.0251 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Nemipteridae dated to 45 +/- 9 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.315, 0.414] falsifies this prediction (point estimate 0.365); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Nemipteridae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Nemipteridae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Nemipteridae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Nemipteridae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Nemipteridae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Nemipteridae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Nemipteridae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Nemipteridae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 8 ;
        mlt:predictedLandmarksFull30 "[[-0.22428, -0.04812], [-0.27216, 0.00086], [-0.05401, 0.13131], [0.33562, 0.05135], [0.42664, 0.03302], [0.42605, -0.04336], [0.32236, -0.06642], [0.19387, -0.11485], [-0.05516, -0.01887], [-0.04345, -0.06246], [-0.08829, 0.05769], [-0.13055, 0.03025], [-0.15148, -0.06233], [-0.20683, -0.05897], [-0.22475, 0.02492], [-0.16248, 0.026], [-0.0911, 0.11997]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.2292, -0.04378], [-0.27128, -0.00542], [-0.04753, 0.13061], [0.34333, 0.04614], [0.41478, 0.03515], [0.41903, -0.04858], [0.34595, -0.05458], [0.18154, -0.12101], [-0.06172, -0.02048], [-0.03841, -0.06389], [-0.09343, 0.05843], [-0.1389, 0.03367], [-0.14298, -0.05563], [-0.20205, -0.06159], [-0.2186, 0.02358], [-0.1695, 0.02687], [-0.09104, 0.12048]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Nemipteridae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Nemipteridae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.4755 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.5177 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5619 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Nemipteridae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3149 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.3648 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.4145 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Nemipteridae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2419 ;

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Nemipteridae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.4735 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.5099 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5496 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Nemipteridae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.332 ;

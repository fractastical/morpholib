sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-018-the-forms-of-tissues-or-cell-aggrega> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-018 — Thompson (1917), Ch. VII, pp. 293-345, Figs. 100-135" ;
        prov:wasRevisionOf sub:RAPTj1J2qLPj-8qmc-6H8ay8SpfEngx56GXGNb46uCTUM ;

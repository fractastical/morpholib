        mlt:candidateDataset <https://doi.org/10.5061/dryad.j9kd51crg>,
            <https://doi.org/10.5061/dryad.mn8cs> ;
        mlt:candidateDatasetTitle "Data from: Sources of variability in cytosolic calcium transients triggered by stimulation of homogeneous uro-epithelial cell monolayers",
            "Photopic flicker optoretinography captures the light-driven length modulation of photoreceptors during phototransduction" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. VII, pp. 293-345, Figs. 100-135." ;
        mlt:claim "Cells in contact, like soap films, meet three-at-a-time at ~120 degrees and in other respects obey Plateau's laws of film configuration." ;
        mlt:claimId "T1917-018" ;
        mlt:counterclaim "Plateau-style junction laws hold as the energy-minimising limit of vertex models, but real epithelia are active: measured junction angles and cell shapes deviate systematically, and the deviations carry the biology (proliferation, contractility). Thompson's 120-degree rule is the passive limit, not the tissue's operating point." ;
        mlt:dataKindNeeded "segmented epithelium images" ;
        mlt:datasetAuditReason "Dryad live search returned 1 title-relevant dataset(s), top: doi:10.5061/dryad.mn8cs." ;
        mlt:datasetExistence "PUBLIC_SCRIPTABLE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 6 ;
        mlt:effortDaysLow 3 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Farhadifar, R. et al. (2007) Curr. Biol. 17:2095-2104 (Drosophila wing epithelium vertex model)" ;
        mlt:literatureRelation "QUALIFIED" ;
        mlt:literatureWhoAndWhen "Farhadifar et al. (2007); vertex-model literature thereafter" ;
        mlt:pass2Status "PARTIAL_REPO" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset PUBLIC_SCRIPTABLE, tier LOOP_WITH_SEED); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;

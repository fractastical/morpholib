<https://w3id.org/morpholib/thompson/np/process-example-t1917-001-introductory/assertion> {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-001-introductory> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-001 — Thompson (1917), Ch. I, pp. 1-15, Figs. -" ;
        prov:wasRevisionOf <https://w3id.org/morpholib/thompson/np/process-example-t1917-001-introductory/RACVkDS43ONFy_wwvtXKSNnua_0YMigqgkEChTfLON590> ;
        mlt:automationTier "NA" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. I, pp. 1-15, Figs. -." ;
        mlt:claim "The form of an organism is a 'diagram of forces': form can and should be described physically and mathematically, in terms of the forces that produced it." ;
        mlt:claimId "T1917-001" ;
        mlt:counterclaim "No counterclaim is possible against a programme. Gould's influential qualification: physical forces are real but form is also shaped by evolutionary history and contingency -- 'form as diagram of forces' is incomplete, not false." ;
        mlt:dataKindNeeded "none (programme)" ;
        mlt:datasetAuditReason "Not testable as stated; no dataset settles it (operationalise first)." ;
        mlt:datasetExistence "NOT_TESTABLE" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 2 ;
        mlt:effortDaysLow 1 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Gould, S.J. (1971) 'D'Arcy Thompson and the science of form' (essay; repr. in Gould 1977, Ever Since Darwin)" ;
        mlt:literatureRelation "NOT_TESTABLE" ;
        mlt:literatureWhoAndWhen "Gould (1971); Medawar and later commentators" ;
        mlt:pass2Status "NOT_TESTABLE_AS_STATED" ;
        mlt:step5Status "NOT QUEUED: not testable as stated, analytic, or unprobed; see dataset audit." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,

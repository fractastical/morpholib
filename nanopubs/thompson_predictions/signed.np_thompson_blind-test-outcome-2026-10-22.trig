sub:assertion {
    <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22> a mlt:BlindPredictionTestOutcome ;
        rdfs:label "Outcome of the pre-registered blind test of the Thompson 1917 prediction engine against FishShapes v1: 4/7 hypotheses supported (2/4 primary), 5180 species" ;
        dcterms:description "Within 50 Myr of a training species the full 30-D phylogenetic prediction of maximum body depth / standard length has 59% less error than the consensus (H1) and 93% interval coverage (H3), but improves on copying the nearest training relative by only 4% (H2 not supported). Beyond 50 Myr error triples and coverage falls to ~65%, yet the root-state prediction still halves the consensus error, so H4 ('no better than consensus') was not supported: the deep-horizon statement should be 'degrades to a clade-wide prior', not 'to the consensus'. Thompson-7 modes beat the consensus but are ~50% worse than the full shape space (H6). Caudal-peduncle depth replicates the body-depth result (H7)." ;
        mlt:calibration_BDmax_over_SL "calliper = -0.0101 + 1.0183 x landmark; r = 0.954; n_training = 710" ;
        mlt:calibration_CPD_over_SL "calliper = 0.0049 + 0.8676 x landmark; r = 0.934; n_training = 711" ;
        mlt:comparisonDataset <https://doi.org/10.5061/dryad.vt4b8gtvf> ;
        mlt:comparisonDatasetMd5 "122b495274d0167c5447db104c7acbfe" ;
        mlt:comparisonDatasetMirror <https://zenodo.org/records/6642650> ;
        mlt:comparisonDatasetSha256 "7447fdc92c5fd5c9ecf1d9713bbd4207d2de7ab4b2ea0e320871041da8e34264" ;
        mlt:hasHorizonBin <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-tau-0-5>,
            <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-tau-10-25>,
            <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-tau-120-1000>,
            <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-tau-25-50>,
            <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-tau-5-10>,
            <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-tau-50-80>,
            <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-tau-80-120> ;
        mlt:hasHypothesisOutcome <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-H1>,
            <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-H2>,
            <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-H3>,
            <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-H4>,
            <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-H5>,
            <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-H6>,
            <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-H7> ;
        mlt:nSpeciesScored 5180 ;
        mlt:nSpecimens 16523 ;
        mlt:resultsDocument <https://github.com/fractastical/morpholib/blob/main/docs/THOMPSON_BLIND_TEST_RESULTS.md> ;
        mlt:testsPreregistration <https://w3id.org/morpholib/thompson/np/blind-preregistration-2026-10-22/RAilN4nbRHp3e3ZHqlbIgeL3UGPRV_KtQHtJD3gzVVdqw> ;
        mlt:verifiedLockedFileSha256 "thompson_blind_predictions_registered.csv: 1d50205ffc2ed9954e707eba2e3db6aaa4871620df6cecf9e4cf766fe3046171",
            "thompson_blind_predictions_registered.json: 2e41cb1aaf1b21035f7d4970178861ee0ad6698a5b31ba35d8f1b87bca03b38b" .

    <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-H1> a mlt:HypothesisOutcome ;
        rdfs:label "H1" ;
        dcterms:description "For target species with a training relative within 50 Myr (tau < 50), the full 30-D phylogenetic prediction of BDmax/SL has smaller absolute error than the grand-consensus value. Test: one-sided paired Wilcoxon signed-rank on |error| across species; also median |error| ratio. Expected: full30 median |error| < 0.8 x consensus median |error|." ;
        mlt:isPrimary true ;
        mlt:resultSummary "{\"n\": 1122, \"median_full30\": 0.038344403084875356, \"median_consensus\": 0.09270605517290162, \"ratio\": 0.41361271400623234, \"p_wilcoxon_less\": 1.049051693817374e-103}" ;
        mlt:supported true .

    <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-H2> a mlt:HypothesisOutcome ;
        rdfs:label "H2" ;
        dcterms:description "For tau < 50, the full 30-D prediction beats copying the nearest training relative's observed landmark ratio (same test). Expected margin smaller than H1; this held at every horizon < 50 Myr in the internal hold-out." ;
        mlt:isPrimary true ;
        mlt:resultSummary "{\"n\": 1122, \"median_full30\": 0.038344403084875356, \"median_nearest\": 0.0399934722987515, \"ratio\": 0.9587665406604962, \"p_wilcoxon_less\": 0.0606819870148897}" ;
        mlt:supported false .

    <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-H3> a mlt:HypothesisOutcome ;
        rdfs:label "H3" ;
        dcterms:description "After the pre-specified measurement-convention calibration (Section 'Calibration'), the 95% predictive intervals of BDmax/SL for tau < 50 contain the observed species value in 85-97% of species. Raw (uncalibrated) coverage is also reported." ;
        mlt:isPrimary true ;
        mlt:resultSummary "{\"n\": 1122, \"coverage95_pct\": 92.60249554367202}" ;
        mlt:supported true .

    <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-H4> a mlt:HypothesisOutcome ;
        rdfs:label "H4" ;
        dcterms:description "For tau >= 50, the full 30-D prediction does NOT beat the consensus by more than 10% in median |error| (the ~50 Myr horizon found internally and in the Thompson-pair analysis)." ;
        mlt:isPrimary true ;
        mlt:resultSummary "{\"n\": 4058, \"median_full30\": 0.09516395300405661, \"median_consensus\": 0.18326871956225166, \"ratio\": 0.5192591143287377}" ;
        mlt:supported false .

    <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-H5> a mlt:HypothesisOutcome ;
        rdfs:label "H5" ;
        dcterms:description "Median |error| of the full 30-D prediction increases monotonically across the tau bins [0,5), [5,10), [10,25), [25,50), [50,80), [80,120), [120,inf) (Spearman rho > 0 on bin medians; at least 5 of 6 consecutive steps non-decreasing)." ;
        mlt:isPrimary false ;
        mlt:resultSummary "{\"spearman_rho\": 0.8571428571428573, \"nondecreasing_steps\": 4, \"of\": 6}" ;
        mlt:supported false .

    <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-H6> a mlt:HypothesisOutcome ;
        rdfs:label "H6" ;
        dcterms:description "The a-priori 7-Thompson-mode prediction is worse than the full 30-D prediction (median |error| larger) but still beats the consensus for tau < 50." ;
        mlt:isPrimary false ;
        mlt:resultSummary "{\"median_thompson7\": 0.0587579992409486, \"median_full30\": 0.038344403084875356, \"median_consensus\": 0.09270605517290162, \"p_thompson7_less_than_consensus\": 7.383143638662237e-81}" ;
        mlt:supported true .

    <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-H7> a mlt:HypothesisOutcome ;
        rdfs:label "H7" ;
        dcterms:description "Secondary ratio CPD/SL: full 30-D beats consensus for tau < 50 (as H1). Exploratory HL/SL, PD/SL likewise if present in the dataset." ;
        mlt:isPrimary false ;
        mlt:resultSummary "{\"n\": 1120, \"median_full30\": 0.011671465020893779, \"median_consensus\": 0.02338933070045149, \"ratio\": 0.4990080806659629, \"p_wilcoxon_less\": 1.7735122656945355e-81}" ;
        mlt:supported true .

    <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-tau-0-5> a mlt:HorizonBin ;
        mlt:coverage95Full30Calibrated 89.1 ;
        mlt:medianAbsErrConsensusCalibrated 0.0863 ;
        mlt:medianAbsErrFull30Calibrated 0.0313 ;
        mlt:medianAbsErrNearestCalibrated 0.0343 ;
        mlt:n 64 ;
        mlt:tauLowerMyr 0.0 ;
        mlt:tauUpperMyr 5.0 .

    <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-tau-10-25> a mlt:HorizonBin ;
        mlt:coverage95Full30Calibrated 93.1 ;
        mlt:medianAbsErrConsensusCalibrated 0.0782 ;
        mlt:medianAbsErrFull30Calibrated 0.0364 ;
        mlt:medianAbsErrNearestCalibrated 0.0378 ;
        mlt:n 375 ;
        mlt:tauLowerMyr 10.0 ;
        mlt:tauUpperMyr 25.0 .

    <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-tau-120-1000> a mlt:HorizonBin ;
        mlt:coverage95Full30Calibrated 82.5 ;
        mlt:medianAbsErrConsensusCalibrated 0.1919 ;
        mlt:medianAbsErrFull30Calibrated 0.0829 ;
        mlt:medianAbsErrNearestCalibrated 0.1235 ;
        mlt:n 2103 ;
        mlt:tauLowerMyr 120.0 ;
        mlt:tauUpperMyr 1000.0 .

    <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-tau-25-50> a mlt:HorizonBin ;
        mlt:coverage95Full30Calibrated 92.6 ;
        mlt:medianAbsErrConsensusCalibrated 0.1145 ;
        mlt:medianAbsErrFull30Calibrated 0.0434 ;
        mlt:medianAbsErrNearestCalibrated 0.0422 ;
        mlt:n 620 ;
        mlt:tauLowerMyr 25.0 ;
        mlt:tauUpperMyr 50.0 .

    <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-tau-5-10> a mlt:HorizonBin ;
        mlt:coverage95Full30Calibrated 93.7 ;
        mlt:medianAbsErrConsensusCalibrated 0.0691 ;
        mlt:medianAbsErrFull30Calibrated 0.0273 ;
        mlt:medianAbsErrNearestCalibrated 0.0263 ;
        mlt:n 63 ;
        mlt:tauLowerMyr 5.0 ;
        mlt:tauUpperMyr 10.0 .

    <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-tau-50-80> a mlt:HorizonBin ;
        mlt:coverage95Full30Calibrated 65.1 ;
        mlt:medianAbsErrConsensusCalibrated 0.1777 ;
        mlt:medianAbsErrFull30Calibrated 0.1088 ;
        mlt:medianAbsErrNearestCalibrated 0.0984 ;
        mlt:n 1025 ;
        mlt:tauLowerMyr 50.0 ;
        mlt:tauUpperMyr 80.0 .

    <https://w3id.org/morpholib/thompson/blind-test/blind-test-outcome-2026-10-22-tau-80-120> a mlt:HorizonBin ;
        mlt:coverage95Full30Calibrated 68.2 ;
        mlt:medianAbsErrConsensusCalibrated 0.1651 ;
        mlt:medianAbsErrFull30Calibrated 0.1262 ;
        mlt:medianAbsErrNearestCalibrated 0.1924 ;
        mlt:n 930 ;
        mlt:tauLowerMyr 80.0 ;
        mlt:tauUpperMyr 120.0 .
}


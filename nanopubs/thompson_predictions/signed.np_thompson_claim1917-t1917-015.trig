    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 literature counterclaim layer" ;
        mlt:bytes 54663 ;
        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-015> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-015 -- Ch. V, pp. 201-276, Figs. 68-71" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "V" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. V, pp. 201-276, Figs. 68-71." ;
        mlt:claim "A liquid cylinder breaks up into a row of spheres (Plateau-Rayleigh instability), and the same segmentation is seen in protoplasmic threads/cells." ;
        mlt:claimId "T1917-015" ;
        mlt:claimType "mechanistic-geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "68-71" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-015> ;
        mlt:pages "201-276" ;
        mlt:repo2026AssessmentNotLiterature "Instability is settled physics (wavelength ~ circumference criterion); biological instances are case-by-case." ;
        mlt:repo2026StatusSeparate "DONE_ELSEWHERE" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-015> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-015 (Thompson 1917): SUPPORTED -- Rayleigh (1878, pre-Thompson physics Thompson applied); confirmed in modern fluid mechanics" ;
        mlt:counterclaim "No counterclaim to the physics (Thompson was applying Rayleigh/Plateau, not originating it). Biological instances remain case-by-case demonstrations, not a tested general law of protoplasm." ;
        mlt:literatureCitation "Lord Rayleigh (1878) on liquid-jet/cylinder instability; standard texts thereafter" ;
        mlt:literatureRelation "SUPPORTED" ;
        mlt:literatureWhoAndWhen "Rayleigh (1878, pre-Thompson physics Thompson applied); confirmed in modern fluid mechanics" ;
        mlt:quantitativeMargin "Instability criterion (disturbances with wavelength exceeding the cylinder circumference grow) is textbook" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-015> .
}


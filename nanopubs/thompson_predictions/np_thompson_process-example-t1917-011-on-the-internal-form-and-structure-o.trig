<https://w3id.org/morpholib/thompson/np/process-example-t1917-011-on-the-internal-form-and-structure-o/assertion> {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-011-on-the-internal-form-and-structure-o> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-011 — Thompson (1917), Ch. IV, pp. 156-200, Figs. 41-59" ;
        prov:wasRevisionOf <https://w3id.org/morpholib/thompson/np/process-example-t1917-011-on-the-internal-form-and-structure-o/RAeJC9eYUMeHPGu-GagGcrisYsFULcVMoHD-kpcptX99s> ;
        mlt:automationTier "HUMAN_REQUIRED" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. IV, pp. 156-200, Figs. 41-59." ;
        mlt:claim "The mitotic figure behaves as a system of forces between two poles: spindle and aster configurations, and chromosome movements, follow the lines of a bipolar field of force (with Peddie's magnetic-field diagrams as the physical analogue)." ;
        mlt:claimId "T1917-011" ;
        mlt:counterclaim "Thompson/Peddie's bipolar field-of-force mechanism is not the mechanism. The spindle is a self-organising microtubule machine: dynamic instability (1984) lets microtubules search-and-capture chromosomes, and depolymerisation itself generates poleward force with no motor and no ATP (shown in vitro from 1988). The bipolar *geometry* Thompson drew was right; the force-field physics was replaced." ;
        mlt:dataKindNeeded "spindle imaging (mechanism, not shape)" ;
        mlt:datasetAuditReason "Mechanistic claim; needs imaging + perturbation, not a shape dataset" ;
        mlt:datasetExistence "NO_PUBLIC_FOUND" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 20 ;
        mlt:effortDaysLow 10 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Mitchison, T. & Kirschner, M. (1984) Nature 312:237-242 (dynamic instability / search-and-capture); McIntosh, J.R. (2012) 'Motors or dynamics: what really moves chromosomes?'" ;
        mlt:literatureRelation "SUPERSEDED" ;
        mlt:literatureWhoAndWhen "Mitchison & Kirschner (1984); McIntosh (2012)" ;
        mlt:pass2Status "DONE_ELSEWHERE" ;
        mlt:quantitativeMargin "Mechanism replaced wholesale (1984-2012); geometry retained" ;
        mlt:step5Status "BLOCKED before Step 5: HUMAN_REQUIRED -- Mechanistic claim; needs imaging + perturbation, not a shape dataset" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_claims.json (repo artifact)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json> a prov:Entity ;

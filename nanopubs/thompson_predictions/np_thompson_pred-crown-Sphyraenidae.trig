<https://w3id.org/morpholib/thompson/np/pred-crown-Sphyraenidae/assertion> {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sphyraenidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Sphyraenidae at 59.3 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Sphyraenidae lineage at 59.3 Ma given 5 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 59.33 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0349 ;
        mlt:expectedProcrustesRMSThompson7 0.0348 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Sphyraenidae dated to 59 +/- 12 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.158, 0.271] falsifies this prediction (point estimate 0.214); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sphyraenidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sphyraenidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sphyraenidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sphyraenidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sphyraenidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sphyraenidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sphyraenidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Sphyraenidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 5 ;
        mlt:predictedLandmarksFull30 "[[-0.23136, -0.02774], [-0.29585, 0.01656], [0.00432, 0.07176], [0.3297, 0.03499], [0.43272, 0.02245], [0.43468, -0.03457], [0.33376, -0.04551], [0.21373, -0.0773], [-0.08055, -0.0094], [-0.06566, -0.03507], [-0.10022, 0.03437], [-0.13821, 0.02893], [-0.14215, -0.03295], [-0.19567, -0.04185], [-0.22173, 0.01574], [-0.17647, 0.01484], [-0.10103, 0.06475]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.23336, -0.02094], [-0.27757, 0.0027], [-0.02091, 0.07748], [0.34479, 0.02935], [0.4228, 0.02404], [0.42625, -0.03415], [0.34708, -0.03943], [0.20708, -0.08324], [-0.08083, -0.01337], [-0.04574, -0.04058], [-0.10399, 0.03478], [-0.15336, 0.02097], [-0.14926, -0.03164], [-0.20212, -0.03247], [-0.22846, 0.01728], [-0.18301, 0.01774], [-0.06939, 0.07148]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Sphyraenidae" .


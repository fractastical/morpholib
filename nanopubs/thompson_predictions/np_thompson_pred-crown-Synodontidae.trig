<https://w3id.org/morpholib/thompson/np/pred-crown-Synodontidae/assertion> {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Synodontidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Synodontidae at 133.1 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Synodontidae lineage at 133.1 Ma given 3 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 133.05 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.03 ;
        mlt:expectedProcrustesRMSThompson7 0.0264 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Synodontidae dated to 133 +/- 27 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.191, 0.333] falsifies this prediction (point estimate 0.262); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Synodontidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Synodontidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Synodontidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Synodontidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Synodontidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Synodontidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Synodontidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Synodontidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 3 ;
        mlt:predictedLandmarksFull30 "[[-0.20676, -0.03988], [-0.27364, 0.01475], [0.008, 0.08789], [0.31113, 0.03742], [0.43159, 0.02062], [0.4321, -0.04141], [0.34401, -0.04891], [0.22429, -0.0881], [-0.08249, -0.01349], [-0.06526, -0.04347], [-0.10553, 0.03983], [-0.15443, 0.03228], [-0.14848, -0.03604], [-0.1827, -0.05208], [-0.2349, 0.02623], [-0.19057, 0.02472], [-0.10637, 0.07965]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.22059, -0.02763], [-0.26617, 0.00253], [-0.02438, 0.09438], [0.3344, 0.02974], [0.42002, 0.02264], [0.42957, -0.03861], [0.3446, -0.04406], [0.2206, -0.09404], [-0.0917, -0.01599], [-0.04725, -0.04863], [-0.1168, 0.0429], [-0.16251, 0.02614], [-0.14396, -0.03958], [-0.18773, -0.04188], [-0.2275, 0.02165], [-0.18857, 0.02219], [-0.07203, 0.08823]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Synodontidae" .


    <https://w3id.org/morpholib/thompson/claim/t1917-036> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-036 -- Ch. XVI, pp. 670-718, Figs. 331-352" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XVI" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVI, pp. 670-718, Figs. 331-352." ;
        mlt:claim "In a bent beam there is a neutral zone/axis free of tension and compression, and animal/plant structures that bend (bones, stems, trunks) are disposed accordingly (material where the stress is)." ;
        mlt:claimId "T1917-036" ;
        mlt:claimType "mechanistic" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "331-352" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-036> ;
        mlt:pages "670-718" ;
        mlt:repo2026AssessmentNotLiterature "Settled engineering; biological allocation is clade-specific. Low novelty for repo." ;
        mlt:repo2026StatusSeparate "DONE_ELSEWHERE" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-036> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-036 (Thompson 1917): SUPPORTED -- Standard beam theory (engineering consensus, before and after 1917)" ;
        mlt:counterclaim "None: neutral-axis beam mechanics was settled engineering when Thompson wrote and remains so. The biological allocation claim bundled with it is T1917-037/038." ;
        mlt:literatureCitation "Standard mechanics of materials (beam theory), before and after 1917" ;
        mlt:literatureRelation "SUPPORTED" ;
        mlt:literatureWhoAndWhen "Standard beam theory (engineering consensus, before and after 1917)" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-036> .
}


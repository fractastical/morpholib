sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Blenniidae at 45.0 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Blenniidae lineage at 45.0 Ma given 5 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 45.02 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0184 ;
        mlt:expectedProcrustesRMSThompson7 0.0252 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Blenniidae dated to 45 +/- 9 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.230, 0.346] falsifies this prediction (point estimate 0.287); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 5 ;
        mlt:predictedLandmarksFull30 "[[-0.20276, -0.02948], [-0.24324, -0.01058], [-0.09799, 0.08994], [0.37995, 0.03375], [0.42395, 0.0309], [0.42479, -0.04485], [0.37559, -0.05237], [0.13738, -0.09616], [-0.07346, -0.00442], [-0.0633, -0.05386], [-0.10109, 0.04433], [-0.12725, 0.03081], [-0.13805, -0.03069], [-0.18599, -0.04052], [-0.22578, 0.02319], [-0.18093, 0.02395], [-0.10181, 0.08606]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.21357, -0.02712], [-0.24907, -0.00174], [-0.08336, 0.09652], [0.36032, 0.03669], [0.4456, 0.02737], [0.43778, -0.04591], [0.35005, -0.04921], [0.14267, -0.09696], [-0.06603, -0.01327], [-0.05051, -0.0451], [-0.10263, 0.04342], [-0.1398, 0.02541], [-0.14215, -0.03662], [-0.1928, -0.0394], [-0.20871, 0.01778], [-0.16622, 0.02044], [-0.12158, 0.08768]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Blenniidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.4154 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4634 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.5133 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2297 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2874 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.3464 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.1859 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2129 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.2402 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2198 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2571 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.2945 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.4063 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.4421 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.482 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2411 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.2875 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.3359 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae-thompson7-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.186 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.2096 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.2348 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Blenniidae-thompson7-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2451 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.2748 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.3089 .
}


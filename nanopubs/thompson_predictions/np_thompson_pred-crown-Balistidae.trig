<https://w3id.org/morpholib/thompson/np/pred-crown-Balistidae/assertion> {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Balistidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Balistidae at 24.6 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Balistidae lineage at 24.6 Ma given 16 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 24.61 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0143 ;
        mlt:expectedProcrustesRMSThompson7 0.0191 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Balistidae dated to 25 +/- 5 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.389, 0.459] falsifies this prediction (point estimate 0.422); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Balistidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Balistidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Balistidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Balistidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Balistidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Balistidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Balistidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Balistidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 16 ;
        mlt:predictedLandmarksFull30 "[[-0.27111, -0.06482], [-0.29636, -0.02929], [-0.0764, 0.12578], [0.34414, 0.04886], [0.38719, 0.0399], [0.39517, -0.0257], [0.35478, -0.04], [0.17829, -0.15919], [-0.06399, -0.03978], [-0.05484, -0.09158], [-0.06837, 0.06584], [-0.09944, 0.05825], [-0.13591, -0.05678], [-0.24978, -0.08668], [-0.15646, 0.06221], [-0.11542, 0.06612], [-0.07149, 0.12685]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.25603, -0.05264], [-0.27755, 0.00775], [-0.04935, 0.14447], [0.32833, 0.04593], [0.38293, 0.04433], [0.42043, -0.02808], [0.3605, -0.04702], [0.15627, -0.1445], [-0.03647, -0.0365], [-0.04068, -0.09163], [-0.05778, 0.06409], [-0.1061, 0.03899], [-0.15953, -0.07729], [-0.24045, -0.0805], [-0.19971, 0.03818], [-0.14174, 0.03453], [-0.08308, 0.13989]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Balistidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Balistidae-full30-BD_over_SL> a mlt:PredictedRatio ;

sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-026-a-parenthetic-note-on-geodetics> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-026 — Thompson (1917), Ch. X, pp. 488-492, Figs. 236-259" ;
        prov:wasRevisionOf sub:RAFIMHzh7KYy0a-xi9qk5w_cGz2cUAwDIu0qGKW2T9QoE ;
        mlt:automationTier "HUMAN_REQUIRED" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. X, pp. 488-492, Figs. 236-259." ;
        mlt:claim "Geodesic (shortest-line) trajectories on a curved surface explain the courses of spicules, shell sculpture and other skeletal lines laid down on that surface." ;
        mlt:claimId "T1917-026" ;
        mlt:counterclaim "A principle, not a tested claim: no literature verdict exists until it is instantiated in one system (trabeculae are the instance with a verdict -- see T1917-037)." ;
        mlt:dataKindNeeded "one 3D surface + curve traces" ;
        mlt:datasetAuditReason "Needs a chosen 3D system with surface curves; no generic dataset" ;
        mlt:datasetExistence "NO_PUBLIC_FOUND" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 14 ;
        mlt:effortDaysLow 7 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "-" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "-" ;
        mlt:pass2Status "UNTESTED" ;
        mlt:step5Status "BLOCKED before Step 5: HUMAN_REQUIRED -- Needs a chosen 3D system with surface curves; no generic dataset" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_claims.json (repo artifact)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json> a prov:Entity ;

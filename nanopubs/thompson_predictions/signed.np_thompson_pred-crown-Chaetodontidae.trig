sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Chaetodontidae at 40.5 Ma (crown-node ancestral body plan of a sampled family)" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Chaetodontidae lineage at 40.5 Ma given 70 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. Crown-node ancestral body plan of a sampled family. Registered before any comparison with fossils of this age." ;
        mlt:ageMa 40.52 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0175 ;
        mlt:expectedProcrustesRMSThompson7 0.0242 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Chaetodontidae dated to 41 +/- 8 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.565, 0.663] falsifies this prediction (point estimate 0.614); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae-thompson7-PD_over_SL> ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:nSampledLivingSpecies 70 ;
        mlt:predictedLandmarksFull30 "[[-0.23693, -0.04093], [-0.25641, -0.00204], [-0.07932, 0.20046], [0.35028, 0.03917], [0.38463, 0.03735], [0.38658, -0.03512], [0.35012, -0.04018], [0.15938, -0.1877], [-0.04825, -0.03978], [-0.02687, -0.08738], [-0.08313, 0.0677], [-0.12399, 0.02658], [-0.13605, -0.08069], [-0.19884, -0.08429], [-0.20392, 0.01581], [-0.14622, 0.01721], [-0.09106, 0.19385]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.22679, -0.06559], [-0.26638, -0.00085], [-0.06517, 0.17906], [0.33486, 0.05488], [0.39529, 0.04568], [0.40206, -0.04675], [0.33935, -0.06154], [0.15811, -0.16403], [-0.04002, -0.03626], [-0.02903, -0.09951], [-0.07768, 0.08014], [-0.12073, 0.04748], [-0.1363, -0.08734], [-0.20346, -0.09506], [-0.20699, 0.0396], [-0.15306, 0.03986], [-0.10405, 0.17024]]" ;
        mlt:predictionKind "crown" ;
        mlt:targetLineage "Chaetodontidae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.6747 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.7203 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.7666 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae-full30-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.5653 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.6135 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.6626 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae-full30-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.2731 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.2944 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.3148 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae-full30-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.4067 ;
        mlt:model "full 30-D shape-space Pagel-lambda model (primary)" ;
        mlt:pointEstimate 0.4394 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.4721 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae-thompson7-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.5958 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.6336 ;
        mlt:ratioName "BD_over_SL" ;
        mlt:upper95 0.6769 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae-thompson7-BDmax_over_SL> a mlt:PredictedRatio ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.4897 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.531 ;
        mlt:ratioName "BDmax_over_SL" ;
        mlt:upper95 0.5787 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae-thompson7-HL_over_SL> a mlt:PredictedRatio ;
        rdfs:label "head length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.2952 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.3149 ;
        mlt:ratioName "HL_over_SL" ;
        mlt:upper95 0.3377 .

    <https://w3id.org/morpholib/thompson/prediction/pred-crown-Chaetodontidae-thompson7-PD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "predorsal length / standard length (7 linearised Thompson modes)" ;
        mlt:lower95 0.4042 ;
        mlt:model "7 linearised Thompson modes" ;
        mlt:pointEstimate 0.4322 ;
        mlt:ratioName "PD_over_SL" ;
        mlt:upper95 0.4652 .
}


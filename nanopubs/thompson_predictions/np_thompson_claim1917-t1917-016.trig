    <https://w3id.org/morpholib/thompson/claim/t1917-016> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-016 -- Ch. V, pp. 201-276, Figs. 94-96" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "V" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. V, pp. 201-276, Figs. 94-96." ;
        mlt:claim "Cell form changes lawfully with the density/osmotic strength of the medium (Koltzoff's decapod sperm cells in saline solutions), as a surface-tension/osmotic system should." ;
        mlt:claimId "T1917-016" ;
        mlt:claimType "quantitative-empirical" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "94-96" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-016> ;
        mlt:pages "201-276" ;
        mlt:repo2026AssessmentNotLiterature "No repo test; modern osmotic cell-mechanics could replicate the exact experiment in silico/on public data." ;
        mlt:repo2026StatusSeparate "UNTESTED" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .


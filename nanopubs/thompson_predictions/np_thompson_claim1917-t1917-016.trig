        rdfs:label "Literature verdict on T1917-016 (Thompson 1917): NO_DIRECT_TEST -- -" ;
        mlt:counterclaim "No published counterclaim or direct replication found. Open." ;
        mlt:literatureCitation "Modern osmotic cell mechanics exists but is not a replication of Koltzoff's decapod-sperm experiment as Thompson cited it" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "-" ;
        mlt:noDirectTestFoundAsOf "2026-10-26"^^xsd:date ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;

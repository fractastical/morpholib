sub:assertion {
    <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Scombridae> a mlt:PhylogeneticMorphologyPrediction ;
        rdfs:label "Predicted body plan: Scombridae at 50.0 Ma (state of the family lineage at the age of the Monte Bolca Lagerstaette (50 Ma))" ;
        dcterms:description "Conditional expectation of the 17-landmark body planform of the Scombridae lineage at 50.0 Ma given 8 sampled living species of the clade and 743 landmarked reef-fish species on the Rabosky et al. (2018) time tree. State of the family lineage at the age of the monte bolca lagerstaette (50 ma). Registered before any comparison with fossils of this age." ;
        mlt:ageMa 50.0 ;
        mlt:evolutionaryProcess "multivariate Pagel lambda (lambda = 0.959 for the Thompson modes, 0.924 for full shape), selected by AICc over white noise, Brownian motion, Ornstein-Uhlenbeck and Early Burst" ;
        mlt:expectedProcrustesRMSFull30 0.0201 ;
        mlt:expectedProcrustesRMSThompson7 0.0276 ;
        mlt:falsificationCriterion "A well-preserved articulated fossil of Scombridae dated to 50 +/- 10 Ma, lying on or near this lineage, with maximum body depth / standard length outside [0.195, 0.306] falsifies this prediction (point estimate 0.249); a 17-landmark Procrustes RMS to the predicted configuration much larger than the expected error at this horizon does likewise." ;
        mlt:hasPredictedRatio <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Scombridae-full30-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Scombridae-full30-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Scombridae-full30-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Scombridae-full30-PD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Scombridae-thompson7-BD_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Scombridae-thompson7-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Scombridae-thompson7-HL_over_SL>,
            <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Scombridae-thompson7-PD_over_SL> ;
        mlt:knownFossilTaxaAtThisAge "Eocoelopoma, Scombrinus" ;
        mlt:landmarkScheme "17 Claverie & Wainwright (2014) landmarks, Procrustes-aligned (centroid size 1, centred), listed in the dataset's landmark order" ;
        mlt:lineageRepresentedByTip "Thunnus albacares" ;
        mlt:livingFamilyMean_BD_over_SL 0.4544 ;
        mlt:livingFamilyMean_BDmax_over_SL 0.2447 ;
        mlt:livingFamilyMean_HL_over_SL 0.2055 ;
        mlt:livingFamilyMean_PD_over_SL 0.2953 ;
        mlt:livingFamilySD_BD_over_SL 0.0486 ;
        mlt:livingFamilySD_BDmax_over_SL 0.0288 ;
        mlt:livingFamilySD_HL_over_SL 0.0305 ;
        mlt:livingFamilySD_PD_over_SL 0.0467 ;
        mlt:nSampledLivingSpecies 8 ;
        mlt:predictedLandmarksFull30 "[[-0.21282, -0.03559], [-0.27477, 0.0161], [-0.03976, 0.08606], [0.27318, 0.05471], [0.47102, 0.002], [0.4708, -0.03353], [0.29792, -0.06941], [0.20938, -0.09157], [-0.07148, 0.0019], [-0.04095, -0.02841], [-0.1034, 0.04548], [-0.14804, 0.0297], [-0.13379, -0.03769], [-0.18433, -0.04931], [-0.22449, 0.01654], [-0.1843, 0.01532], [-0.10417, 0.0777]]" ;
        mlt:predictedLandmarksThompson7 "[[-0.2133, -0.02584], [-0.25673, -0.00237], [-0.04967, 0.09519], [0.33663, 0.03298], [0.42571, 0.02199], [0.4379, -0.04914], [0.34976, -0.05022], [0.20664, -0.09231], [-0.08715, -0.01101], [-0.0471, -0.04138], [-0.11918, 0.04338], [-0.15991, 0.02562], [-0.14053, -0.03382], [-0.18335, -0.03714], [-0.22198, 0.01725], [-0.18451, 0.0205], [-0.09322, 0.0863]]" ;
        mlt:predictionKind "bolca50" ;
        mlt:sampledCrownAgeMa 46.87 ;
        mlt:targetLineage "Scombridae" .

    <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Scombridae-full30-BD_over_SL> a mlt:PredictedRatio ;
        rdfs:label "dorsal-fin origin to anal-fin origin / standard length (full 30-D shape-space Pagel-lambda model (primary))" ;
        mlt:lower95 0.3828 ;

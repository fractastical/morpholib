}

sub:assertion {
    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Ottaviania-leptacanthus> a mlt:FossilPredictionTest ;
        rdfs:label "Monte Bolca test: Ottaviania leptacanthus (Lutjanidae) vs. predicted Lutjanidae lineage at 50 Ma" ;
        dcterms:bibliographicCitation "Bannikov A.F. (2006) Geodiversitas 28(2): 249-275, diagnosis: 'Head length 3.03 in SL. Maximum body depth 3.26 in SL.' Holotype MNHN Bol 14a/14b, 261 mm SL." ;
        mlt:ageMa 50.0 ;
        mlt:family "Lutjanidae" ;
        mlt:fossilTaxon "Ottaviania leptacanthus" ;
        mlt:hasMeasurementComparison <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Ottaviania-leptacanthus-BDmax_over_SL>,
            <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Ottaviania-leptacanthus-HL_over_SL> ;
        mlt:nullHypothesis "phylogenetic stasis: fossil proportions equal the living family mean" ;
        mlt:phylogeneticPlacement "Lutjanidae" ;
        mlt:testsPrediction <https://w3id.org/morpholib/thompson/prediction/pred-bolca50-Lutjanidae> ;
        mlt:verdictBodyDepth "outside the 95% predictive interval (prediction falsified as stated, subject to the fossil's placement on the lineage)" .

    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Ottaviania-leptacanthus-BDmax_over_SL> a mlt:MeasurementComparison ;
        rdfs:label "maximum body depth (excluding fin webs) / standard length" ;
        mlt:directionOfChangeCorrect false ;
        mlt:fossilInsidePredictiveInterval95 false ;
        mlt:fossilValueLower 0.307 ;
        mlt:fossilValueUpper 0.307 ;
        mlt:livingFamilyMean 0.3769 ;
        mlt:predictedFull30 0.407 ;
        mlt:predictedFull30Lower95 0.3544 ;
        mlt:predictedFull30Upper95 0.4595 ;
        mlt:predictedThompson7 0.4218 ;
        mlt:predictionCloserThanStasisNull false ;
        mlt:ratioName "BDmax_over_SL" .

    <https://w3id.org/morpholib/thompson/fossil-test/fossiltest-Ottaviania-leptacanthus-HL_over_SL> a mlt:MeasurementComparison ;
        rdfs:label "head length / standard length" ;
        mlt:directionOfChangeCorrect false ;
        mlt:fossilInsidePredictiveInterval95 false ;
        mlt:fossilValueLower 0.33 ;
        mlt:fossilValueUpper 0.33 ;
        mlt:livingFamilyMean 0.291 ;
        mlt:predictedFull30 0.284 ;
        mlt:predictedFull30Lower95 0.2603 ;
        mlt:predictedFull30Upper95 0.3082 ;
        mlt:predictedThompson7 0.2767 ;
        mlt:predictionCloserThanStasisNull false ;
        mlt:ratioName "HL_over_SL" .
}


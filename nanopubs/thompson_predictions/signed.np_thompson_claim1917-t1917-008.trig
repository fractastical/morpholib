sub:assertion {
    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 claim registry (59 claims, all dated 1917)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 literature counterclaim layer" ;
        mlt:bytes 54663 ;
        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-008> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-008 -- Ch. III, pp. 50-155, Figs. 18-22" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "III" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. III, pp. 50-155, Figs. 18-22." ;
        mlt:claim "Parts of an organism grow at different but definite relative rates, so form changes systematically with size; the changing proportions of organs (brain, heart, body; plaice weight-length) are growth-rate phenomena." ;
        mlt:claimId "T1917-008" ;
        mlt:claimType "quantitative-empirical" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "18-22" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-008> ;
        mlt:pages "50-155" ;
        mlt:repo2026AssessmentNotLiterature "Repo supports differential-growth description in ants and several clades, but has not re-tested Thompson's own organ-ratio examples (Figs. 18-22) nor fitted the log-log relative-growth (allometric) law to his data. Formalised later by Huxley (1932) - credit and date must stay with Thompson (1917) for the claim as made here." ;
        mlt:repo2026StatusSeparate "PARTIAL_REPO" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-008> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-008 (Thompson 1917): MIXED -- Huxley (1932) formalised it; Royal Society discussion (1950) and Gould (1966) qualified it" ;
        mlt:counterclaim "SUPPORTING: Huxley (1932) turned Thompson's differential-growth claim into the allometric law y = b x^k. COUNTER (1950): the allometry equation cannot simultaneously hold between two parts and the whole, and often only fits as piecewise straight lines -- so its constants are 'a rough and ready shorthand of description', not physiological entities. Fitting the law does not prove a growth-rate mechanism." ;
        mlt:literatureCitation "Huxley, J.S. (1932) Problems of Relative Growth; Needham, Zuckerman et al. (1950) Proc. R. Soc. B 137:465-525; Gould, S.J. (1966) Biol. Rev. 41:587-640" ;
        mlt:literatureRelation "MIXED" ;
        mlt:literatureWhoAndWhen "Huxley (1932) formalised it; Royal Society discussion (1950) and Gould (1966) qualified it" ;
        mlt:quantitativeMargin "Huxley's k = ratio of specific growth rates; the 1950 objection is logical (inconsistent between part-part and part-whole fits), not a percentage" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-008> .
}


sub:assertion {
    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 claim registry (59 claims, all dated 1917)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 literature counterclaim layer" ;
        mlt:bytes 54663 ;
        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-004> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-004 -- Ch. II, pp. 16-49, Figs. -" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "II" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. II, pp. 16-49, Figs. -." ;
        mlt:claim "Strength of a support scales with cross-sectional area (L^2) while load scales with weight (L^3), so larger land animals must be relatively thicker-boned / differently proportioned (Galilean scaling)." ;
        mlt:claimId "T1917-004" ;
        mlt:claimType "quantitative-geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "-" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-004> ;
        mlt:pages "16-49" ;
        mlt:repo2026AssessmentNotLiterature "Modern verdict is mixed: elastic-similarity and stress-similarity scalings fit some clades, geometric L^3/L^2 does not fit all. Worth one clade-level repo test only if bundled with T1917-040." ;
        mlt:repo2026StatusSeparate "DONE_ELSEWHERE" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-004> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-004 (Thompson 1917): QUALIFIED -- McMahon (1973); Schmidt-Nielsen (1984) and later allometry literature" ;
        mlt:counterclaim "Pure geometric similarity (strength L^2 vs weight L^3) does not describe real skeletons; McMahon's elastic-similarity (buckling) criterion predicts different, often better-fitting proportions. Thompson's scaling dilemma is real, his implied geometric solution is not the one animals use in general." ;
        mlt:literatureCitation "McMahon, T.A. (1973) Science 179:1201-1204 (elastic similarity); Schmidt-Nielsen, K. (1984) Scaling: Why Is Animal Size So Important?" ;
        mlt:literatureRelation "QUALIFIED" ;
        mlt:literatureWhoAndWhen "McMahon (1973); Schmidt-Nielsen (1984) and later allometry literature" ;
        mlt:quantitativeMargin "Elastic similarity predicts diameter proportional to length^1.5 (vs geometric proportionality); fits many trees/limbs better, neither fits all" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-004> .
}


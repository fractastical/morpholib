    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 claim registry (59 claims, all dated 1917)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> a prov:Entity ;
        rdfs:label "Thompson 1917 literature counterclaim layer" ;
        mlt:bytes 54663 ;
        mlt:sha256 "bae6669c3d26f3a6e9c43a9030828d12dbc78531eac759c116189c1d027a5c27" .

    <https://w3id.org/morpholib/thompson/claim/t1917-046> a mlt:HistoricalClaim ;
        rdfs:label "Thompson (1917) claim T1917-046 -- Ch. XVII (fish II), pp. 749, Figs. 375-376" ;
        dcterms:source <https://archive.org/details/ongrowthform1917thom> ;
        mlt:chapter "XVII (fish II)" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVII (fish II), pp. 749, Figs. 375-376." ;
        mlt:claim "Deforming the rectilinear coordinates of a typical Scarus into (approximately) coaxial circles gives 'a very good outline' of Pomacanthus." ;
        mlt:claimId "T1917-046" ;
        mlt:claimType "geometric" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:figures "375-376" ;
        mlt:hasLiteratureVerdict <https://w3id.org/morpholib/thompson/literature-verdict/t1917-046> ;
        mlt:pages "749" ;
        mlt:repo2026AssessmentNotLiterature "REFUTED in its literal (conformal/Mobius) reading: Mobius explains 0.8-1% (a conformal map cannot change depth/length 0.377->0.587); the generous oblique-coaxial reading explains 32% at genus-mean landmarks (31st percentile of all genus pairs), LOO-CV fails (0.0371 > 0.0312), and on real outlines every deformation is WORSE than no deformation (IoU 0.618 coaxial vs 0.662 similarity). Remediation already listed in the audit: digitise his drawn grid, fit maps to outlines directly, more individuals." ;
        mlt:repo2026StatusSeparate "DONE_REPO" ;
        mlt:sourceEdition "Thompson, D.W. (1917) On Growth and Form, 1st edition, Cambridge University Press (not the 1942 2nd edition or 1961 abridgement)" ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:verbatimQuote "Fig. 375 is an outline diagram of a typical Scaroid fish. Let us deform its rectilinear co-ordinates into a system of (approximately) coaxial circles, as in Fig. 376, and then filling into the new system, space by space and point by point, our former diagram of Scarus, we obtain a very good outline of an allied fish, belonging to a neighbouring family, of the genus Pomacanthus. (Thompson 1917, p. 749; quoted verbatim in thompson/1917-thompson-scarus-pomacanthus.py L5-13)" .

    <https://w3id.org/morpholib/thompson/literature-verdict/t1917-046> a mlt:LiteratureVerdict ;
        rdfs:label "Literature verdict on T1917-046 (Thompson 1917): NO_DIRECT_TEST -- Bookstein (1978) on this figure's method" ;
        mlt:counterclaim "No published *quantitative* test of Scarus->Pomacanthus existed before this repo's (the audit states: 'there is still no published value to compare against -- nobody has fitted this pair'). The literature counterclaim is methodological only: an unfitted hand grid is not evidence. The quantitative refutation (Mobius ~1%, outline IoU worse than no deformation) is REPO 2026, not literature -- keep the two apart." ;
        mlt:literatureCitation "Bookstein, F.L. (1978), as discussed in the repo's validating script: Thompson 'drew the grids by hand and left no instructions for fitting them'" ;
        mlt:literatureRelation "NO_DIRECT_TEST" ;
        mlt:literatureWhoAndWhen "Bookstein (1978) on this figure's method" ;
        mlt:noDirectTestFoundAsOf "2026-10-26"^^xsd:date ;
        mlt:quantitativeMargin "Literature: none (no numbers). Repo 2026: see pass2 -- do not cite the repo numbers as 'the literature'" ;
        mlt:reviewedOn "2026-10-26"^^xsd:date ;
        mlt:statementOfAbsence "As of this literature review (2026-10-26), no published work directly tests this 1917 claim as Thompson stated it. Neighbouring results are not a test of this claim." ;
        mlt:verdictOn <https://w3id.org/morpholib/thompson/claim/t1917-046> .
}


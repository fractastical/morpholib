sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/morpholib/thompson/process-instance/t1917-038-on-form-and-mechanical-efficiency> a mlt:ClaimValidationProcessInstance ;
        rdfs:label "Process instance: T1917-038 — Thompson (1917), Ch. XVI, pp. 670-718, Figs. 331-334, 336-352" ;
        prov:wasRevisionOf sub:RAXqjF6C6dXbYRuUXzv1XbAamzLFCTAxJGUZ9OcMaegoQ ;
        mlt:automationTier "LOOP_WITH_SEED" ;
        mlt:citation "Thompson, D.W. (1917) On Growth and Form. Cambridge University Press. Ch. XVI, pp. 670-718, Figs. 331-334, 336-352." ;
        mlt:claim "Hollow cylindrical construction (long bones, stems, quills) gives near-maximal strength/stiffness for weight, and branching systems (blood vessels, Fig. 329-330 after Hess; trees) branch at angles/ratios that economise work/material." ;
        mlt:claimId "T1917-038" ;
        mlt:counterclaim "Thompson (following Hess) stated branching-angle rules qualitatively. Murray (1926) replaced them with a derived optimum: minimum-work branching requires parent radius cubed = sum of daughter radii cubed (r0^3 = r1^3 + r2^3), with angles following from the radii -- and showed Hess's angle rule (Thompson's source) was incomplete because it ignored the continuing parent vessel. Not a refutation of Thompson's economy idea; its replacement by a computable law, nine years later." ;
        mlt:dataKindNeeded "vascular/tree branching measurements" ;
        mlt:datasetAuditReason "Live probe failed or Dryad rate-limited (HTTP 429) at scout time -- existence UNKNOWN, not absent. Loop Step 1 re-probes with throttling/cache; do not quote this row as 'no dataset'." ;
        mlt:datasetExistence "UNPROBED" ;
        mlt:dateMade "1917"^^xsd:gYear ;
        mlt:effortDaysHigh 8 ;
        mlt:effortDaysLow 4 ;
        mlt:instantiatesWorkflow <https://w3id.org/morpholib/thompson/process/1917-claim-validation-workflow> ;
        mlt:literatureArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_counterclaims.json> ;
        mlt:literatureCitation "Murray, C.D. (1926) Proc. Natl. Acad. Sci. USA 12:207-214 and J. Gen. Physiol. 9:835-841" ;
        mlt:literatureRelation "SUPERSEDED" ;
        mlt:literatureWhoAndWhen "Murray (1926)" ;
        mlt:pass2Status "DONE_ELSEWHERE" ;
        mlt:quantitativeMargin "Murray's law r0^3 = r1^3 + r2^3 (1926); minimum theoretical bifurcation angle 75 deg for vessels" ;
        mlt:step5Status "PENDING Step 5: Steps 1-4 completed (dataset UNPROBED, tier LOOP_WITH_SEED); loop slot queued in thompson/thompson_1917_loop_queue.yaml." ;
        mlt:usesArtifact <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_claims.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_claims.json (repo artifact)" ;
        mlt:bytes 59402 ;
        mlt:sha256 "4bba069cf816d2b1e4e97a9d4498cce183ab166a76b66ffc2de5b616d3980261" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_dataset_audit.json> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_dataset_audit.json (repo artifact)" ;
        mlt:bytes 96343 ;
        mlt:sha256 "a0bc797767654ca4e951b1b3683a773923448b02124a61259e89cccd7a071f1a" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/thompson_1917_loop_queue.yaml> a prov:Entity ;
        rdfs:label "thompson/thompson_1917_loop_queue.yaml (repo artifact)" ;
        mlt:bytes 51327 ;
        mlt:sha256 "1d017aa92fb9cf889af47a1a631a328e1f204c1e12b930db1839b482c6f44d61" .
}


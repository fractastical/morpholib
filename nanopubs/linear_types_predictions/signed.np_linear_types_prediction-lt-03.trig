sub:assertion {
    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-03> a delphi:TestableHypothesis ;
        rdfs:label "LT-03: Cell-sorting swap moves conserve the type multiset by typing"@en ;
        dcterms:description "A Potts/GGH swap-move stepper is expressed in the DSL (or a uniqueness-typed Lean engine) so that cell-type-count conservation for arbitrary move sequences is a corollary of the soundness theorem, and a cross-check against models/1992-graner-cellular-potts-cell-sorting.py shows identical type counts over at least 1,000 Monte Carlo steps."@en ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/docs/LINEAR_TYPE_EXTENSION_SPEC.md>,
            <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/morphoeval/lean/LinearResource.lean> ;
        skos:broader <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-portfolio> ;
        schema:programmingLanguage "Lean 4" ;
        delphi:context "Pre-registered capability prediction, registration LINEAR-TYPES-01. The prior is the registrant's credence that the formal-verification outcome is achieved by the deadline, not a probability about biology. Loops in scope: Loop_041, Loop_042, Loop_044, Loop_zhang_sorting_morphogenesis, Loop_014 (ggh_sorting_swap_dH)." ;
        delphi:hasPriorProbability 0.6 ;
        delphi:hasResolvability 0.9 ;
        delphi:hypothesisType "formal-verification capability prediction (linear-resource DSL in Lean 4)" ;
        delphi:proposedTest "Cross-check harness committed under morphoeval/; report identical per-type counts at every MCS; Lean theorem present and kernel-checked." ;
        mlt:basis "Swap = two transfers of one unit between label ledgers; the DSL covers it. Risk is engineering the lattice/neighbourhood bookkeeping in core Lean and matching the Python RNG stream." ;
        mlt:deadline "2027-01-31"^^xsd:date ;
        mlt:falsifier "No kernel-checked swap stepper by the deadline, or cross-check diverges." ;
        mlt:inScopeLoop "Loop_014 (ggh_sorting_swap_dH)",
            "Loop_041",
            "Loop_042",
            "Loop_044",
            "Loop_zhang_sorting_morphogenesis" ;
        mlt:predictionId "LT-03" ;
        mlt:registrationId "LINEAR-TYPES-01" .
}


<https://w3id.org/morpholib/linear-types/np/prediction-lt-09/assertion> {
    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-09> a delphi:TestableHypothesis ;
        rdfs:label "LT-09: Negative control: elasticity and Turing-wavelength laws are NOT DSL-expressible"@en ;
        dcterms:description "For the elastic-buckling and Turing-wavelength loop classes (e.g. Loop_094 bacillus_biofilm_wrinkling, Loop_0101 mus_musculus_turing_wavelength, cortical_gyrification_folding, venus_flytrap_snap_buckling, mollusc_shell_marginal_buckling), zero laws are expressible as DSL instantiations without an additional arithmetic theorem, so their KG proofKind remains 'equational'."@en ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/docs/LINEAR_TYPE_EXTENSION_SPEC.md>,
            <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/morphoeval/lean/LinearResource.lean> ;
        skos:broader <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-portfolio> ;
        schema:programmingLanguage "Lean 4" ;
        delphi:context "Pre-registered capability prediction, registration LINEAR-TYPES-01. The prior is the registrant's credence that the formal-verification outcome is achieved by the deadline, not a probability about biology. Loops in scope: Loop_094, Loop_0101, cortical_gyrification_folding, venus_flytrap_snap_buckling, mollusc_shell_marginal_buckling." ;
        delphi:hasPriorProbability 0.85 ;
        delphi:hasResolvability 0.9 ;
        delphi:hypothesisType "formal-verification capability prediction (linear-resource DSL in Lean 4)" ;
        delphi:proposedTest "Same audit as LT-08; the listed loops must be classified 'equational-only'." ;
        mlt:basis "These laws are dispersion relations and scaling exponents, not conservation statements. Registering this bounds the extension's claimed scope." ;
        mlt:deadline "2027-03-31"^^xsd:date ;
        mlt:falsifier "Any listed loop acquires a genuine DSL instantiation (not a trivially wrapped identity)." ;
        mlt:inScopeLoop "Loop_0101",
            "Loop_094",
            "cortical_gyrification_folding",
            "mollusc_shell_marginal_buckling",
            "venus_flytrap_snap_buckling" ;
        mlt:predictionId "LT-09" ;
        mlt:registrationId "LINEAR-TYPES-01" .
}


sub:assertion {
    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-06> a delphi:TestableHypothesis ;
        rdfs:label "LT-06: Gap-junction charge transfer formalised as a linear transfer"@en ;
        dcterms:description "The planarian H+/K+-ATPase and bioelectric loops get a DSL instantiation in which ion flux through a gap junction is a transfer between cell ledgers, so that total charge conservation across the gap-junction network is a corollary of the soundness theorem, with gj_voltage_gate_symmetry_and_isolation (Loop_081 L61) re-expressed as a property of the transfer amount."@en ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/docs/LINEAR_TYPE_EXTENSION_SPEC.md>,
            <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/morphoeval/lean/LinearResource.lean> ;
        skos:broader <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-portfolio> ;
        schema:programmingLanguage "Lean 4" ;
        delphi:context "Pre-registered capability prediction, registration LINEAR-TYPES-01. The prior is the registrant's credence that the formal-verification outcome is achieved by the deadline, not a probability about biology. Loops in scope: Loop_081, Loop_082, Loop_084, Loop_0901." ;
        delphi:hasPriorProbability 0.45 ;
        delphi:hasResolvability 0.7 ;
        delphi:hypothesisType "formal-verification capability prediction (linear-resource DSL in Lean 4)" ;
        delphi:proposedTest "Kernel-checked instantiation present; cross-check against models/2011-beane-planarian-hk-atpase-anterior.py total-charge trace." ;
        mlt:basis "Transfer shape is identical to auxin, but the reference model is a continuous ODE in Vmem, not an explicit charge ledger; the ledger would need a rational or fixed-point carrier and a documented discretisation." ;
        mlt:deadline "2027-02-28"^^xsd:date ;
        mlt:falsifier "No instantiation by deadline, or the continuous Vmem dynamics cannot be matched by an integer/rational ledger within the cross-check tolerance." ;
        mlt:inScopeLoop "Loop_081",
            "Loop_082",
            "Loop_084",
            "Loop_0901" ;
        mlt:predictionId "LT-06" ;
        mlt:registrationId "LINEAR-TYPES-01" .
}


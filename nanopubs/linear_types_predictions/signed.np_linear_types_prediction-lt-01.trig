sub:assertion {
    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-01> a delphi:TestableHypothesis ;
        rdfs:label "LT-01: Linear-resource DSL soundness in core Lean 4"@en ;
        dcterms:description "A core-Lean (no Mathlib) linear-resource DSL whose only constructors are skip/transfer/seq, with a once-proved soundness theorem that every well-scoped program preserves the ledger total, is merged to main and kernel-checks with 0 sorry and no additional axioms."@en ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/docs/LINEAR_TYPE_EXTENSION_SPEC.md>,
            <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/morphoeval/lean/LinearResource.lean> ;
        skos:broader <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-portfolio> ;
        schema:programmingLanguage "Lean 4" ;
        delphi:context "Pre-registered capability prediction, registration LINEAR-TYPES-01. The prior is the registrant's credence that the formal-verification outcome is achieved by the deadline, not a probability about biology. Loops in scope: morphoeval/lean/LinearResource.lean." ;
        delphi:hasPriorProbability 0.97 ;
        delphi:hasResolvability 1.0 ;
        delphi:hypothesisType "formal-verification capability prediction (linear-resource DSL in Lean 4)" ;
        delphi:proposedTest "lean morphoeval/lean/LinearResource.lean exits 0; `#print axioms MathOfBiology.Linear.conserves` lists only propext/Quot.sound/Classical.choice or fewer; file present on main." ;
        mlt:basis "Prototype already compiles locally at registration time; residual risk is only merge/CI." ;
        mlt:deadline "2026-11-30"^^xsd:date ;
        mlt:falsifier "Module absent from main, or kernel rejects it, or it depends on sorry/extra axioms." ;
        mlt:inScopeLoop "morphoeval/lean/LinearResource.lean" ;
        mlt:predictionId "LT-01" ;
        mlt:registrationId "LINEAR-TYPES-01" .
}

sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}


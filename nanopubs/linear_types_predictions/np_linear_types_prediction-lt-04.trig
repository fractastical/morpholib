<https://w3id.org/morpholib/linear-types/np/prediction-lt-04/assertion> {
    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-04> a delphi:TestableHypothesis ;
        rdfs:label "LT-04: Somitogenesis counting laws derived from one PSM consumption law"@en ;
        dcterms:description "A single typed consumption law (PSM cells consumed by the wavefront at rate v, partitioned by the clock period T) is formalised in the DSL, and both dubrulle_2001_fgf8_bead_somite_pair_conservation (Loop_024 L83) and meinhardt_1986_half_somite_cleft_count (Loop_021 L154) are re-derived as corollaries of it."@en ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/docs/LINEAR_TYPE_EXTENSION_SPEC.md>,
            <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/morphoeval/lean/LinearResource.lean> ;
        skos:broader <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-portfolio> ;
        schema:programmingLanguage "Lean 4" ;
        delphi:context "Pre-registered capability prediction, registration LINEAR-TYPES-01. The prior is the registrant's credence that the formal-verification outcome is achieved by the deadline, not a probability about biology. Loops in scope: Loop_021, Loop_024, Loop_026, Loop_028, Loop_0301." ;
        delphi:hasPriorProbability 0.5 ;
        delphi:hasResolvability 0.85 ;
        delphi:hypothesisType "formal-verification capability prediction (linear-resource DSL in Lean 4)" ;
        delphi:proposedTest "Both named theorems' statements are proved from a shared Linear.Prog instance plus the existing arithmetic, with no free-standing restatement of the counting identity." ;
        mlt:basis "The biology is a budget; the open question is whether the clock partition (period, not quantity) fits a quantity-ledger without a graded extension of the DSL." ;
        mlt:deadline "2027-02-28"^^xsd:date ;
        mlt:falsifier "Either theorem still requires its own arithmetic identity unrelated to the consumption program at the deadline." ;
        mlt:inScopeLoop "Loop_021",
            "Loop_024",
            "Loop_026",
            "Loop_028",
            "Loop_0301" ;
        mlt:predictionId "LT-04" ;
        mlt:registrationId "LINEAR-TYPES-01" .
}


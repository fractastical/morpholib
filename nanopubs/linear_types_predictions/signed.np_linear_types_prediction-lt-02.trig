sub:assertion {
    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-02> a delphi:TestableHypothesis ;
        rdfs:label "LT-02: Auxin canalization class re-formalised as DSL instantiations"@en ;
        dcterms:description "All five auxin canalization loops (Loop_032 auxin_pin1_phyllotaxis, Loop_034 auxin_canalization_leaf_veins, Loop_035 carrier_driven_canalization, Loop_038 root_auxin_reflux_fountain, Loop_0401 mus_musculus_flux_canalization) each carry at least one law whose conservation theorem is a DSL instantiation, and morphoeval/check_lean_formula_alignment.py passes on the paired math_kg_loops YAML."@en ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/docs/LINEAR_TYPE_EXTENSION_SPEC.md>,
            <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/morphoeval/lean/LinearResource.lean> ;
        skos:broader <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-portfolio> ;
        schema:programmingLanguage "Lean 4" ;
        delphi:context "Pre-registered capability prediction, registration LINEAR-TYPES-01. The prior is the registrant's credence that the formal-verification outcome is achieved by the deadline, not a probability about biology. Loops in scope: Loop_032, Loop_034, Loop_035, Loop_038, Loop_0401." ;
        delphi:hasPriorProbability 0.75 ;
        delphi:hasResolvability 0.95 ;
        delphi:hypothesisType "formal-verification capability prediction (linear-resource DSL in Lean 4)" ;
        delphi:proposedTest "Grep each listed .lean for a theorem whose proof term applies MathOfBiology.Linear.conserves; run check_lean_formula_alignment.py on each YAML; both must pass for all five." ;
        mlt:basis "Loop_032 L64 (jonsson_2006_intercellular_flux_conservation) and Loop_034 L98 (feugier_2005_polar_flux_conservation) are already edge-flux antisymmetry identities; the prototype instantiates Loop_032 directly. Loop_038 (reflux fountain, 2-D tissue with boundary) is the hardest." ;
        mlt:deadline "2027-01-31"^^xsd:date ;
        mlt:falsifier "Any of the five lacks a DSL instantiation at the deadline, or the alignment checker fails for it." ;
        mlt:inScopeLoop "Loop_032",
            "Loop_034",
            "Loop_035",
            "Loop_038",
            "Loop_0401" ;
        mlt:predictionId "LT-02" ;
        mlt:registrationId "LINEAR-TYPES-01" .
}

sub:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}


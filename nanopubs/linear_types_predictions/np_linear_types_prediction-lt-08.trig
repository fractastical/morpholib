<https://w3id.org/morpholib/linear-types/np/prediction-lt-08/assertion> {
    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-08> a delphi:TestableHypothesis ;
        rdfs:label "LT-08: Share of the morphoeval loop corpus that is a conservation/partition law"@en ;
        dcterms:description "Of the 136 mechanism-specific Lean loop files, at least 40 contain at least one law expressible as a DSL instantiation without any additional arithmetic theorem beyond the soundness theorem, and at least 20 of those are actually re-formalised and emitted into the MorphoEval KG with proofKind 'conservation-by-typing'."@en ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/docs/LINEAR_TYPE_EXTENSION_SPEC.md>,
            <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/morphoeval/lean/LinearResource.lean> ;
        skos:broader <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-portfolio> ;
        schema:programmingLanguage "Lean 4" ;
        delphi:context "Pre-registered capability prediction, registration LINEAR-TYPES-01. The prior is the registrant's credence that the formal-verification outcome is achieved by the deadline, not a probability about biology. Loops in scope: all morphoeval/lean/loops/*.lean." ;
        delphi:hasPriorProbability 0.4 ;
        delphi:hasResolvability 0.9 ;
        delphi:hypothesisType "formal-verification capability prediction (linear-resource DSL in Lean 4)" ;
        delphi:proposedTest "A committed audit (extension of morphoeval/audit_lean_proofs.py) classifies every loop's laws; count of 'DSL-expressible' >= 40 and count of emitted 'conservation-by-typing' nodes >= 20." ;
        mlt:basis "By loop name, roughly 35-45 loops are flux/partition/budget laws (auxin x5, sorting x5, somite x6, branching/transport x8, bioelectric x4, counting laws in feather/digit/ruga loops). The 20-emitted half is a labour prediction." ;
        mlt:deadline "2027-03-31"^^xsd:date ;
        mlt:falsifier "Either count below threshold at the deadline." ;
        mlt:inScopeLoop "all morphoeval/lean/loops/*.lean" ;
        mlt:predictionId "LT-08" ;
        mlt:registrationId "LINEAR-TYPES-01" .
}


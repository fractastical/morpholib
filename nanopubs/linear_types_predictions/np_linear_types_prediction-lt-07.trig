<https://w3id.org/morpholib/linear-types/np/prediction-lt-07/assertion> {
    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-07> a delphi:TestableHypothesis ;
        rdfs:label "LT-07: Project Delphi adopts an additive proof-kind term"@en ;
        dcterms:description "fractastical/project-delphi-ontology releases a minor version (2.x) that adds a term equivalent to delphi:proofKind (controlled values including 'equational', 'conservation-by-typing', 'executable') and a toolchain-version term, and at least one signed nanopublication published to the production network uses them."@en ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/docs/LINEAR_TYPE_EXTENSION_SPEC.md>,
            <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/morphoeval/lean/LinearResource.lean> ;
        skos:broader <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-portfolio> ;
        schema:programmingLanguage "Lean 4" ;
        delphi:context "Pre-registered capability prediction, registration LINEAR-TYPES-01. The prior is the registrant's credence that the formal-verification outcome is achieved by the deadline, not a probability about biology. Loops in scope: none (ontology-level)." ;
        delphi:hasPriorProbability 0.55 ;
        delphi:hasResolvability 1.0 ;
        delphi:hypothesisType "formal-verification capability prediction (linear-resource DSL in Lean 4)" ;
        delphi:proposedTest "delphi.ttl on main declares the terms; a nanopub resolvable at a w3id.org/np/ trusty URI uses them." ;
        mlt:basis "Additive and backward compatible, and the ontology's own editorialNote on delphi:leanVerified already asks for the toolchain. Risk is review bandwidth, not design." ;
        mlt:deadline "2027-03-31"^^xsd:date ;
        mlt:falsifier "No such release, or released but unused in any published nanopub, by the deadline." ;
        mlt:predictionId "LT-07" ;
        mlt:registrationId "LINEAR-TYPES-01" .
}


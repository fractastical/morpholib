@prefix this: <https://w3id.org/morpholib/linear-types/np/portfolio-linear-types-01/RAvZnUzT_WpMKg9NZBhz5hAEXtfSNhtDX6IfnKuq08mW0> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:assertion {
    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-portfolio> a delphi:TestableHypothesis,
            mlt:PredictionPortfolio ;
        rdfs:label "LINEAR-TYPES-01: ten pre-registered predictions on what a linear-resource DSL in Lean 4 + Project Delphi proof-kind terms can formalise in the MorphoEval corpus"@en ;
        dcterms:description "Separate registration artifact. The locked predictions/prediction_registry.json is NOT edited. Each prediction below is a delphi:TestableHypothesis with a prior probability fixed BEFORE any of the proposed work beyond the prototype morphoeval/lean/LinearResource.lean was attempted. Priors are the registrant's subjective credence that the stated outcome will be achieved by the stated deadline using the linear-resource DSL in Lean 4 plus the proposed Project Delphi ontology terms; they are NOT probabilities that the underlying biology is true. Resolution: a later nanopublication per prediction citing the resolving commit, with outcome_verdict in {confirmed, refuted, unresolved-at-deadline}. No prior is edited after this file is committed; corrections are new registrations."@en ;
        rdfs:seeAlso <https://github.com/fractastical/project-delphi-ontology> ;
        skos:narrower <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-01>,
            <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-02>,
            <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-03>,
            <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-04>,
            <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-05>,
            <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-06>,
            <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-07>,
            <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-08>,
            <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-09>,
            <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-10> ;
        delphi:context "Baseline: 136 mechanism-specific Lean loop files, 0 template stubs. Prototype morphoeval/lean/LinearResource.lean (MathOfBiology.Linear.conserves) kernel-checked with Lean (version 4.35.0)." ;
        delphi:hasPriorProbability 0.612 ;
        delphi:hasResolvability 0.9 ;
        delphi:hypothesisType "formal-verification capability prediction portfolio" ;
        delphi:proposedTest "Resolve each member prediction by its deadline with a resolution nanopub; compute the Brier score at 2027-03-31." ;
        mlt:expectedConfirmations 6.12 ;
        mlt:lockedFile <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-portfolio-locked-lean-prototype>,
            <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-portfolio-locked-registration>,
            <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-portfolio-locked-spec> ;
        mlt:meanPrior 0.612 ;
        mlt:nPredictions 10 ;
        mlt:scoringRule "Brier score over resolved predictions at 2027-03-31; unresolved-at-deadline scored as refuted for the Brier computation and reported separately." .

    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-01> rdfs:label "LT-01: Linear-resource DSL soundness in core Lean 4"@en ;
        delphi:hasPriorProbability 0.97 .

    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-02> rdfs:label "LT-02: Auxin canalization class re-formalised as DSL instantiations"@en ;
        delphi:hasPriorProbability 0.75 .

    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-03> rdfs:label "LT-03: Cell-sorting swap moves conserve the type multiset by typing"@en ;
        delphi:hasPriorProbability 0.6 .

    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-04> rdfs:label "LT-04: Somitogenesis counting laws derived from one PSM consumption law"@en ;
        delphi:hasPriorProbability 0.5 .

    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-05> rdfs:label "LT-05: A conservation violation exists in at least one current reference implementation"@en ;
        delphi:hasPriorProbability 0.55 .

    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-06> rdfs:label "LT-06: Gap-junction charge transfer formalised as a linear transfer"@en ;
        delphi:hasPriorProbability 0.45 .

    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-07> rdfs:label "LT-07: Project Delphi adopts an additive proof-kind term"@en ;
        delphi:hasPriorProbability 0.55 .

    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-08> rdfs:label "LT-08: Share of the morphoeval loop corpus that is a conservation/partition law"@en ;
        delphi:hasPriorProbability 0.4 .

    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-09> rdfs:label "LT-09: Negative control: elasticity and Turing-wavelength laws are NOT DSL-expressible"@en ;
        delphi:hasPriorProbability 0.85 .

    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-10> rdfs:label "LT-10: Rule 30 left-bijectivity as a linear isomorphism in a uniqueness-typed stepper"@en ;
        delphi:hasPriorProbability 0.5 .

    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-portfolio-locked-lean-prototype> a mlt:LockedFile ;
        rdfs:label "morphoeval/lean/LinearResource.lean" ;
        mlt:sha256 "957bf486a9c0dd3683cb812288ab53f38b073315001c175f402af8cadd2dd1d2" ;
        mlt:url <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/morphoeval/lean/LinearResource.lean> .

    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-portfolio-locked-registration> a mlt:LockedFile ;
        rdfs:label "predictions/registrations/LINEAR-TYPES-01.json" ;
        mlt:sha256 "1195a42fcc0e33f881898ba1d2055bc86bfc31eed45bc15bf4ce061515c4f0b5" ;
        mlt:url <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/predictions/registrations/LINEAR-TYPES-01.json> .

    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-portfolio-locked-spec> a mlt:LockedFile ;
        rdfs:label "docs/LINEAR_TYPE_EXTENSION_SPEC.md" ;
        mlt:sha256 "2db9e5950ec45c5aa6b74abaac6242ce3522c187283d063cd2e3b0161cb66346" ;
        mlt:url <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/docs/LINEAR_TYPE_EXTENSION_SPEC.md> .
}


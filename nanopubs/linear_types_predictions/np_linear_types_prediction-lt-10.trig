<https://w3id.org/morpholib/linear-types/np/prediction-lt-10/assertion> {
    <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-lt-10> a delphi:TestableHypothesis ;
        rdfs:label "LT-10: Rule 30 left-bijectivity as a linear isomorphism in a uniqueness-typed stepper"@en ;
        dcterms:description "A Lean CA stepper for Rule 30 is written so that the left-argument update is a typed bijection, and the backward reconstruction theorems (MathOfBiology.jen_1990_left_bijective L48, quadrant_pde_bwd_m0/m1 L72-78 and their inverse theorems) are obtained as the inverse direction of that typed map rather than by separate cases-rfl proofs; the stepper cross-checks bit-for-bit against models/1984-wolfram-conus-textile-rule30.py for 1,024 steps."@en ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/docs/LINEAR_TYPE_EXTENSION_SPEC.md>,
            <https://github.com/fractastical/morpholib/blob/f195168fa9cd437c5b93ce8502e6f1cc1f077212/morphoeval/lean/LinearResource.lean> ;
        skos:broader <https://w3id.org/delphi/resource/hypothesis/morpholib-linear-types-portfolio> ;
        schema:programmingLanguage "Lean 4" ;
        delphi:context "Pre-registered capability prediction, registration LINEAR-TYPES-01. The prior is the registrant's credence that the formal-verification outcome is achieved by the deadline, not a probability about biology. Loops in scope: MathOfBiology.lean L20-80, Ruliobiology.lean." ;
        delphi:hasPriorProbability 0.5 ;
        delphi:hasResolvability 0.8 ;
        delphi:hypothesisType "formal-verification capability prediction (linear-resource DSL in Lean 4)" ;
        delphi:proposedTest "Kernel-checked module where the inverse theorems are projections of an Equiv/bijection structure; bit-identical centre column for 1,024 steps (compare to R30-OEIS-128-01 fixture)." ;
        mlt:basis "The mathematics is settled (Jen 1990); the uncertainty is whether core Lean without Mathlib's Equiv makes the bijection packaging worth it." ;
        mlt:deadline "2027-02-28"^^xsd:date ;
        mlt:falsifier "Inverse theorems still proved independently, or cross-check mismatch." ;
        mlt:inScopeLoop "MathOfBiology.lean L20-80",
            "Ruliobiology.lean" ;
        mlt:predictionId "LT-10" ;
        mlt:registrationId "LINEAR-TYPES-01" .
}


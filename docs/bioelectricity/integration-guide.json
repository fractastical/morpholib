{
  "schema_version": "1.2.0",
  "title": "Queryable Integration Guide for bioelectricity.net (Bioelectricity Nexus)",
  "author": "Joel Dietz (Project Delphi)",
  "base_url": "https://fractastical.github.io/morpholib",
  "hub_url": "https://fractastical.github.io/morpholib/bioelectricity/integration-guide.html",
  "openapi_spec_url": "https://fractastical.github.io/morpholib/bioelectricity/openapi.json",
  "feed_url": "https://fractastical.github.io/morpholib/bioelectricity/bioelectricity_nexus_feed.json",
  "modules": {
    "sorting-morphogenesis": {
      "id": "zhang-levin-hoel-sorting-morphogenesis-ce2",
      "title": "Self-Sorting Cells, 'Platonic Space,' and Causal Emergence 2.0",
      "iframe_base_url": "https://fractastical.github.io/morpholib/bioelectricity/sorting-morphogenesis.html",
      "student_magazine_pdf": "https://fractastical.github.io/morpholib/zhang_levin_13yo_illustrated_guide.pdf",
      "academic_manuscript_pdf": "https://fractastical.github.io/morpholib/zhang_levin_sorting_morphogenesis_manuscript.pdf",
      "react_component": "docs/bioelectricity/SortingMorphogenesisWidget.tsx",
      "query_parameters": {
        "tab": {
          "type": "string",
          "default": "guide13",
          "options": {
            "guide13": "13-Year-Old's Illustrated Guide (4 Custom Diagrams)",
            "sim": "Interactive Gym-Class Cell Simulator (HTML5 Canvas)",
            "magazine": "4-Page Magazine PDF Spread Preview",
            "ce2": "Hoel's Causal Emergence 2.0 & 3-Ablation Audit",
            "embed": "Integration & Embed Code Reference"
          }
        },
        "scenario": {
          "type": "string",
          "default": "rulers",
          "options": {
            "rulers": "Experiment 1: The 'Two Rulers' Optical Illusion (Bubble + 1 Frozen #99)",
            "insertion_on": "Experiment 2A: Insertion Sort WITH 3-Line Reset (`if FREEZE: prev = -1`)",
            "insertion_off": "Experiment 2B: Insertion Sort WITHOUT Reset (Cells Freeze Behind #99!)",
            "unique_wave": "Experiment 3: Unique Numbers — Selection 'Sports Cars' vs. Bubble 'Pedestrians'",
            "c2_anticluster": "Experiment 4: C = 2 Duplicate Copies -> `S B | S B | S B` Anti-Clustering (0.477 < 0.50)",
            "c6_cliques": "Experiment 5: C = 6 Duplicate Copies -> `SSS | BBB` Mega-Cliques (0.659)"
          }
        },
        "autoplay": {
          "type": "boolean",
          "default": false,
          "description": "Pass `autoplay=1` to immediately start sorting when the iframe loads"
        },
        "compact": {
          "type": "boolean",
          "default": false,
          "description": "Pass `compact=1` to hide the top hero banner when embedding inside an existing bioelectricity.net article"
        }
      },
      "postMessage_api": {
        "inbound_commands": [
          { "type": "MORPHOLIB_SET_TAB", "tab": "sim" },
          { "type": "MORPHOLIB_SET_SCENARIO", "scenario": "c2_anticluster", "autoplay": true },
          { "type": "MORPHOLIB_STEP_ONCE" },
          { "type": "MORPHOLIB_RESET" }
        ],
        "outbound_events": [
          {
            "type": "MORPHOLIB_SIM_STATE",
            "payload_example": {
              "scenario": "c2_anticluster",
              "swaps": 18,
              "ruler1_inversions_I": 0,
              "ruler1_uphill_steps": 0,
              "ruler2_adj_error_E": 0,
              "ruler2_uphill_bumps": 4,
              "algotype_clustering": 0.467
            }
          }
        ]
      },
      "preset_deeplinks": [
        {
          "label": "Full Illustrated Guide (Default)",
          "url": "https://fractastical.github.io/morpholib/bioelectricity/sorting-morphogenesis.html?tab=guide13"
        },
        {
          "label": "Live Simulator: Two Rulers Optical Illusion (Autoplay)",
          "url": "https://fractastical.github.io/morpholib/bioelectricity/sorting-morphogenesis.html?tab=sim&scenario=rulers&autoplay=1"
        },
        {
          "label": "Live Simulator: C = 2 Anti-Clustering Smoking Gun (Compact Embed)",
          "url": "https://fractastical.github.io/morpholib/bioelectricity/sorting-morphogenesis.html?tab=sim&scenario=c2_anticluster&autoplay=1&compact=1"
        },
        {
          "label": "4-Page Magazine Spread Preview (Compact Embed)",
          "url": "https://fractastical.github.io/morpholib/bioelectricity/sorting-morphogenesis.html?tab=magazine&compact=1"
        }
      ]
    },
    "thompson-10000-fishes": {
      "id": "thompson-1917-morphospace-vs-competition",
      "title": "How Nature Builds 10,000 Fishes: D'Arcy Thompson's 1917 Transformation Paradox",
      "iframe_base_url": "https://fractastical.github.io/morpholib/bioelectricity/",
      "student_magazine_pdf": "https://fractastical.github.io/morpholib/thompson_1917_visual_guide_for_everyone.pdf",
      "academic_manuscript_pdf": "https://fractastical.github.io/morpholib/thompson_1917_fish_transformations_manuscript.pdf",
      "react_component": "docs/bioelectricity/InfiniteMorphospaceWidget.tsx"
    }
  }
}

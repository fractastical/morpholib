  "governing_equations": {
    "multiplicative_decomposition": "F = F_e * F_g,  F_g(s, t) = diag(gamma_s(s, t), 1, gamma_z(s, t)),  gamma_s(s, t) = exp(integral_{t0}^{t} g(s, tau) dtau)",
    "bilayer_free_energy": "E[x(s), z(s)] = integral_0^L [ 0.5 * K_stretch * (lambda_e - 1)^2 + 0.5 * B_apical * (kappa - C_0(s))^2 + 0.5 * mu_BM * h_BM * (lambda_BM - 1)^2 + 0.5 * K_found * z^2 ] ds",
    "pouch_dome_curvature_law": "kappa_dome = 6 * mu_cell * mu_BM * h_BM * (g_apical - g_BM) * Delta_t / (h_cell * (mu_cell * h_cell + 4 * mu_BM * h_BM))",
    "fold_pinning_condition": "s_fold^* in {s_HN^*, s_HH^*, s_HP^*} <=> g'(s^*) = 0 and g''(s^*) > 0 (local differential planar growth trough)",
    "local_fold_deepening_law": "d_fold(s_k, t) = d_growth(s_k, t) * (1 + alpha_ECM_soft * (1 - mu_BM_local / mu_BM_0) + beta_lat * Delta_T_lat(s_k))",

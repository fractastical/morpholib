  "governing_equations": {
    "section": "Kavanagh et al. (2013) PNAS 110:18190-18195 Figs. 1-4; Hiscock et al. (2017) Dev. Cell 41:459-465; Hartmann & Tabin (2001) Cell 104:341-351",
    "arithmetic_cascade_law": "P_n = P_1 * (1 + (n - 1) * (A - I) / I) = P_1 + (n - 1) * Delta",
    "symmetric_midpoint_ic_law": "P_2 = 0.5 * (P_1 + P_3)  <=>  P_2 / P_1 = 0.5 + 0.5 * (P_3 / P_1)  <=>  P_2 / (P_1 + P_2 + P_3) = 1 / 3",
    "asymmetric_molar_ic_law": "P_2 / P_1 = 1 / 3 + (2 / 3) * (P_3 / P_1)",
    "bmp_gdf5_noggin_interzone_pde": "dG/dt = f_G * G + f_N * N - G^3 + D_G * d2G/dx2;  dN/dt = g_G * G + g_N * N + D_N * d2N/dx2;  Sox9_cartilage(x,t) = S_0 * (1 - G_PFR(x,t)) * (1 - H_cleft(G(x,t)))",
    "distal_pfr_wavelength_modulation": "lambda_n = lambda_0 * (1 - alpha_taper * (n - 1)),  Delta = -alpha_taper * P_1 < 0  =>  P_1 > P_2 > P_3",
    "baseline_parameters": {
      "f_G": 1.60,
      "f_N": -2.40,
      "g_G": 1.90,
      "g_N": -2.10,
      "D_G": 0.12,
      "D_N": 1.80,
      "alpha_taper": 0.28,
      "L_initial": 3.20,
      "L_final": 12.00,
      "v_elongation": 0.88,
      "ell_pfr": 1.65,
      "cleft_threshold_G": 0.22,
      "noggin_dose": 1.0,
      "gdf5_dose": 1.0
    }
  },

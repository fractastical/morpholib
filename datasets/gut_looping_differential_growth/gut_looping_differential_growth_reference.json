  "governing_equations": {
    "section": "Savin et al. (2011) Nature 476:57-62, Main Text pp. 58-61 & Supplementary Information Sec. S2-S4",
    "differential_growth_strain_formula": "epsilon = (L_t - L_m) / L_m = (L_t / L_m) - 1",
    "tube_moment_of_inertia_formula": "I_t = (pi / 4) * (R_t^4 - R_i^4)",
    "total_elastic_energy_per_wavelength": "U_total(lambda) = c_b * (E_t * I_t) / lambda^2 + c_s * (E_m * h_m) * lambda",
    "characteristic_length_scale_formula": "ell_star = ((E_t * I_t) / (E_m * h_m))^(1/3)",
    "wavelength_scaling_law": "lambda = c_lambda * ((E_t * I_t) / (E_m * h_m))^(1/3)",
    "loop_radius_scaling_law": "R = c_R * ((E_t * I_t) / (E_m * h_m))^(1/3)",
    "dimensionless_prefactors": {
      "c_lambda": 4.55,
      "c_R": 1.68,
      "lambda_over_R_ratio": 2.7083333333333335
    },
    "discrete_kirchhoff_rod_mesentery_energy": "E({r_i}) = sum_i [0.5 * E_t * A_t * (|r_{i+1}-r_i|/ds_t - 1)^2 * ds_t + 0.5 * E_t * I_t * kappa_i^2 * ds_t + 0.5 * E_m * h_m * (|r_i - r_root,i| - W_0)^2 * ds_m] + E_steric"
  },

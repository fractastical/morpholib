  "murray_1926_minimum_work_model": {
    "section": "Murray (1926a) PNAS 12:207-214 Eqs. (1)-(8); Murray (1926b) J. Gen. Physiol. 9:835-841 Eqs. (1)-(6)",
    "physical_parameters": {
      "viscosity_eta_poise": 0.035,
      "metabolic_cost_b_erg_s_cm3": 1930.0,
      "murray_conductance_k_M_s_inv": 184.427,
      "wall_shear_stress_tau_dyn_cm2": 8.2189,
      "cubic_exponent_gamma": 3.0,
      "symmetric_daughter_radius_ratio": 0.7937005259840998,
      "symmetric_area_expansion_ratio_beta": 1.2599210498948732,
      "symmetric_half_angle_deg": 37.467311210936366,
      "symmetric_total_angle_deg": 74.93462242187273,
      "da_vinci_area_preserving_exponent": 2.0,
      "steiner_length_minimizing_angle_deg": 120.0,
      "zamir_surface_minimizing_angle_deg": 90.0
    },
    "governing_equations": {
      "poiseuille_metabolic_power": "P(r) = (8 * eta * L * Q^2) / (pi * r^4) + b * pi * r^2 * L",
      "optimal_flow_radius_scaling": "dP/dr = 0  <=>  Q = (pi / 4) * sqrt(b / eta) * r^3",
      "murray_cube_law": "r_0^3 = r_1^3 + r_2^3",
      "optimal_branch_cos_theta1": "cos(theta_1) = (r_0^4 + r_1^4 - r_2^4) / (2 * r_0^2 * r_1^2)",
      "optimal_branch_cos_theta2": "cos(theta_2) = (r_0^4 + r_2^4 - r_1^4) / (2 * r_0^2 * r_2^2)",
      "optimal_total_cos_theta12": "cos(theta_1 + theta_2) = (r_0^4 - r_1^4 - r_2^4) / (2 * r_1^2 * r_2^2)"
    }
  },

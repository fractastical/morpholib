  "governing_equations": {
    "single_cell_energy": "E_cell(A) = (Gamma_a + Gamma_b) * A + (c * Gamma_l * V_0) / (2 * sqrt(A))",
    "equilibrium_height": "h_0 = ((c * Gamma_l * sqrt(V_0)) / (4 * (Gamma_a + Gamma_b)))^(2/3)",
    "equilibrium_width": "d_0 = sqrt(A_0) = ((4 * (Gamma_a + Gamma_b) * V_0) / (c * Gamma_l))^(1/3)",
    "equilibrium_aspect_ratio": "h_0 / d_0 = (c * Gamma_l) / (4 * (Gamma_a + Gamma_b))",
    "spontaneous_curvature": "C_0 = (Gamma_a - Gamma_b) / (2 * kappa_c * h_0) = 2 * (Gamma_a - Gamma_b) / ((Gamma_a + Gamma_b) * h_0)",
    "effective_bending_modulus": "kappa_eff = (1/4) * (Gamma_a + Gamma_b) * h_0^2 + (c * Gamma_l * V_0 * h_0) / (12 * d_0^2)",
    "critical_buckling_wavelength": "lambda_c = 2 * pi * (kappa_eff / K_sub)^(1/4)",
    "parameters": {

  "governing_equations": {
    "incompatible_shell_energy": "E[a, b] = E_stretch[a - a_0] + E_bend[b - b_0], where a_0 = I (flat reference metric, K_flat = 0) and b_0 = diag(kappa_0, -kappa_0) in the +-45 deg cellulose microfibril frame",
    "gauss_theorema_egregium_incompatibility": "K_target = det(b_0) = -kappa_0^2 < 0 != K(a_0) = 0 => no zero-energy isometric immersion exists for W > 0",
    "rotated_target_curvature_tensor": "b_0(theta) = [[kappa_0 * cos(2*theta), kappa_0 * sin(2*theta)], [kappa_0 * sin(2*theta), -kappa_0 * cos(2*theta)]] in strip (s, t) coordinates at cutting angle theta",
    "dimensionless_foppl_von_karman_width": "w_tilde = W * sqrt(kappa_0 / h)",
    "critical_pitchfork_width": "w_tilde_c(nu) = (16 * (1 + nu) / sqrt(1 - nu^2))^(1/4)",
    "reduced_non_euclidean_energy_density": "U(H, D; w_tilde) = ((1 + nu)/(1 - nu)) * H^2 + (D - kappa_0)^2 + Lambda(w_tilde) * (D^2 - H^2)^2, where H = (kappa_1 + kappa_2)/2, D = (kappa_1 - kappa_2)/2, and K = H^2 - D^2",
    "narrow_helicoid_regime": "For w_tilde <= w_tilde_c: H*(w_tilde) = 0, kappa_s(theta=45 deg) = 0, tau(theta=45 deg) = D*(w_tilde) => Pure-Twist Helicoid with helix radius R = 0",
    "wide_cylindrical_ribbon_regime": "For w_tilde > w_tilde_c: H*(w_tilde) = +- ((1 - nu)/2) * kappa_0 * sqrt(1 - (w_tilde_c / w_tilde)^4), D*(w_tilde) = ((1 - nu)/2) * kappa_0 => Cylindrical Helical Ribbon with H_inf = ((1 - nu)/2) * kappa_0 and K -> 0",
    "ribbon_helix_geometry": "kappa_s = H + D * cos(2*theta), tau = D * sin(2*theta), R = |kappa_s| / (kappa_s^2 + tau^2), P = 2 * pi * |tau| / (kappa_s^2 + tau^2)"
  },

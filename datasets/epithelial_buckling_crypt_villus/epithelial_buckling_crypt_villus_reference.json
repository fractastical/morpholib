  "governing_equations": {
    "section": "Hannezo, Prost & Joanny (2011) PRL 107:078104 Eqs. (5)-(11) & Shyer et al. (2013) Science 342:212-218 Figs. 1-4 & Supplementary Text",
    "mucosal_bending_rigidity_formula": "B_e = E_e * h_e^3 / (12 * (1 - nu^2))",
    "stromal_foundation_stiffness_formula": "K_s = E_s / H_s",
    "fvk_free_energy_functional": "F[w] = int [0.5 * B_e * (laplacian w)^2 - 0.5 * N_x * (dw/dx)^2 - 0.5 * N_y * (dw/dy)^2 + 0.5 * K_s * w^2 - (alpha_3 / 6) * w^3 + (alpha_4 / 24) * w^4] dx dy",
    "critical_wavenumber_formula": "q_star = (K_s / B_e)^(1/4)",
    "characteristic_wavelength_formula": "lambda_star = 2 * pi * (B_e / K_s)^(1/4)",
    "critical_buckling_load_formula": "N_c = 2 * sqrt(B_e * K_s)",
    "critical_buckling_strain_formula": "epsilon_c = 2 * sqrt(B_e * K_s) / (E_e * h_e)",
    "herringbone_zigzag_angle_formula": "theta_zz_deg = arctan(sqrt((epsilon_y - epsilon_c2) / (epsilon_x - epsilon_c1))) * (180 / pi)",
    "hexagonal_triad_resonance": "q_1 + q_2 + q_3 = 0, |q_1| = |q_2| = |q_3| = q_star (angles 0, 120, 240 deg)",
    "parameters": {
      "nu_poisson": 0.45,
      "epsilon_c1_circumferential": 0.14,
      "epsilon_c2_longitudinal": 0.18,
      "alpha_3_villus_asymmetry": 1.35,
      "alpha_4_saturation": 2.40,
      "grid_size_N": 64
    }
  },

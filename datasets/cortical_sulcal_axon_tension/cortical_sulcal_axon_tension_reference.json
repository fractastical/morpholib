  "title": "Van Essen (1997) Nature, Hilgetag & Barbas (2006) PLoS Comput. Biol. & Mota & Herculano-Houzel (2015) Science — Cortico-Cortical Axonal Tension, Laminar Thickness Dichotomy & Universal Cortical Folding Scaling",
  "primary_papers": [
    {
      "citation": "Van Essen DC (1997). A tension-based theory of morphogenesis and compact wiring in the central nervous system. Nature 385(6614):313-318.",
      "doi": "10.1038/385313a0"
    },
    {
      "citation": "Hilgetag CC, Barbas H (2006). Role of Mechanical Factors in the Morphology of the Primate Cerebral Cortex. PLoS Computational Biology 2(3):e22.",
      "doi": "10.1371/journal.pcbi.0020022"
    },
    {
      "citation": "Mota B, Herculano-Houzel S (2015). Cortical folding scales universally with surface area and thickness, not number of neurons. Science 349(6243):74-77.",
      "doi": "10.1126/science.aaa9101"
    },
    {
      "citation": "Toro R, Burnod Y (2005). A Morphogenetic Model for the Development of Cortical Convolutions. Cerebral Cortex 15(12):1900-1913.",
      "doi": "10.1093/cercor/bhi068"
    },
    {
      "citation": "Karbowski J (2001). Optimal wiring principle and plateaus in the degree of separation between cortical areas. Physical Review Letters 86(16):3674-3677.",
      "doi": "10.1103/PhysRevLett.86.3674"
    }
  ],
  "governing_equations": {
    "van_essen_axonal_tension_energy": "E_total = sum_{i<j} 0.5 * k_a * C_{ij} * max(0, ||x_i - x_j|| - L_{0,ij})^2 + 0.5 * B_c * sum_i kappa_i^2 * ds_i + E_pressure",
    "towed_axon_viscoelastic_growth": "dL_{0,ij}/dt = gamma_a * max(0, T_{ij} - tau_0), where T_{ij} = k_a * C_{ij} * (||x_i - x_j|| - L_{0,ij})_+",
    "chord_vs_arc_wiring_economy": "V_wire = sum_{i<j} C_{ij} * d_{ij}; outward gyral folding across strongly connected areas (C_strong > C_weak) replaces arc length d_arc with 3D chord d_chord = 2*r_g*sin(d_arc/(2*r_g)) < d_arc",
    "hilgetag_barbas_laminar_volume_conservation": "V_col = A_surf * h = const => h_gyrus = h_0 / lambda_{t,gyrus} > h_wall = h_0 > h_fundus = h_0 / lambda_{t,fundus}",
    "mota_herculano_houzel_universal_scaling": "A_T * sqrt(h) = k * A_E^(5/4)  <=>  log10(A_T * sqrt(h)) = 1.25 * log10(A_E) + log10(k), with GI = A_T / A_E = k * h^(-1/2) * A_E^(1/4) >= 1.0",
    "parameters": {
      "axon_stiffness_k_a": 1.35,
      "bending_modulus_B_c": 2.40,
      "towed_growth_rate_gamma_a": 0.085,
      "tension_threshold_tau_0": 0.12,
      "gyral_tangential_compression_lambda_g": 0.78,
      "sulcal_tangential_stretch_lambda_f": 1.26,
      "mhh_universal_exponent_alpha": 1.25,
      "mhh_offset_log10_k": -0.495,
      "baseline_cortical_thickness_h0_mm": 2.45
    }
  },

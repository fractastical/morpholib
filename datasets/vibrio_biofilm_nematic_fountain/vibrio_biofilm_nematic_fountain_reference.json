  "governing_equations": {
    "section": "Beroz et al. (2018) Nature Physics 14:954-960 Eqs. (1)-(5) & SI Text; Hartmann et al. (2019) Nature Physics 15:251-256; Yan et al. (2016) PNAS 113:E5337-E5343",
    "radial_expansion_velocity": "v_r(r) = 0.5 * g * r",
    "parabolic_radial_compression_stress": "sigma_rr(r) = (zeta * g / (4 * h)) * (R^2 - r^2) = kappa * (R^2 - r^2)",
    "hertzian_peeling_buckling_stress": "sigma_c(L) = sigma_c0 * (L_0 / L)",
    "critical_verticalization_radius": "R_c(L) = sqrt(sigma_c(L) / kappa) = R_c0 * sqrt(L_0 / L)",
    "verticalization_front_radius": "r_vert(R, L) = sqrt(max(0, R^2 - R_c(L)^2))",
    "vertical_nematic_order_parameter": "S_z(theta) = 0.5 * (3 * cos^2(theta) - 1)",
    "nematic_landau_de_gennes_free_energy": "F[theta, H] = int [0.5 * K_nem * (d theta / dr)^2 - 0.5 * (sigma_rr(r) - sigma_c(L)) * cos^2(theta) + 0.25 * beta_s * cos^4(theta)] 2*pi*r dr",
    "parameters": {

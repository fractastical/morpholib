  "governing_equations": {
    "doubly_curved_shell_energy": "U(kappa_x, kappa_y) = (kappa_x - kappa_x0(t))^2 + (kappa_y - kappa_y0(t))^2 + 2*nu*(kappa_x*kappa_y - kappa_x0(t)*kappa_y0(t)) + c_stretch * alpha * (kappa_x * kappa_y - kappa_init^2)^2",
    "dimensionless_geometric_coupling": "alpha = L^4 * kappa_init^2 / h^2 (ratio of Gauss stretching energy ~ E*h*L^6*kappa_init^4 to bending energy ~ E*h^3*L^2*kappa_init^2)",
    "gauss_stretching_penalty": "U_stretch(kappa_x, kappa_y) = c_stretch * alpha * (kappa_x * kappa_y - K_0)^2 with K_0 = kappa_init^2 > 0; vanishes identically at both open convex (+kappa_init, +kappa_init) and closed concave (-kappa_init, -kappa_init) states, while peaking at the flat pass (kappa_x = 0 => U_stretch = c_stretch * alpha * K_0^2 > 0)",
    "critical_cusp_coupling": "alpha_c = (1 + nu) / (c_stretch * kappa_init^2) = 0.8000 (separating monostable continuous bending alpha <= alpha_c from bistable snap-through alpha > alpha_c)",
    "bistable_equilibrium_and_barrier": "For alpha > alpha_c at kappa_x0 = 0: kappa_eq(alpha) = +- kappa_init * sqrt(1 - alpha_c / alpha), Delta_U_barrier(alpha) = c_stretch * alpha * kappa_init^4 * (1 - alpha_c / alpha)^2",
    "saddle_node_fold_bifurcation": "For alpha > alpha_c: kappa_fold(alpha) = +- kappa_init * sqrt((1 - alpha_c / alpha) / 3), kappa_x0_fold(alpha) = -+ (2 / (3*sqrt(3))) * kappa_init * (alpha / alpha_c) * (1 - alpha_c / alpha)^(3/2)",
    "coupled_poroelastic_inertial_dynamics": "m_eff * d^2(kappa_i)/dt^2 + zeta * d(kappa_i)/dt = -dU/d(kappa_i), driven by active turgor relaxation kappa_x0(t) = kappa_init + (kappa_x0_final - kappa_init) * (1 - exp(-t / tau_a))",
    "poroelastic_skotheim_mahadevan_limit": "tau_p = h^2 / D_water >> tau_snap ~ L / sqrt(E / rho) ~ 100 ms (elastic instability bypasses hydraulic diffusion limit)"
  },

  "governing_equations": {
    "section": "Asally et al. (2012) PNAS 109:18891-18896 Figs. 1-5 & SI Text; Yan et al. (2019) Nature Physics 15:456-462 Eqs. (1)-(6); Trejo et al. (2013) PNAS 110:2011-2016",
    "in_plane_osmotic_swelling_stress": "sigma_0 = (E_f / (1 - nu_f)) * epsilon_g",
    "plane_strain_modulus": "E_bar_f = E_f / (1 - nu_f^2),  E_bar_s = E_s / (1 - nu_s^2)",
    "fvk_characteristic_wavelength": "lambda_c = 2 * pi * h * (E_bar_f / (3 * E_bar_s))^(1/3)",
    "fvk_critical_buckling_strain": "epsilon_c = 0.25 * (3 * E_bar_s / E_bar_f)^(2/3)",
    "cell_death_delamination_threshold": "epsilon_c_eff(phi_dead) = epsilon_c * (1 - gamma_d * phi_dead)",
    "radial_spoke_number_selection": "N_spokes = 2 * pi * R_ring / lambda_c = (R_ring / h) * (3 * E_bar_s / E_bar_f)^(1/3)",
    "fvk_biofilm_free_energy": "F[w] = int [0.5 * D_f * (laplacian w)^2 - 0.5 * sigma_r * h * (dw/dr)^2 - 0.5 * sigma_theta * h * (1/r * dw/dtheta)^2 + 0.5 * K_eff(x,y) * w^2 + 0.25 * beta_nl * w^4 - f_dead(x,y) * w] dA",
    "parameters": {
      "E_f_wild_type_kPa": 25.0,
      "E_s_standard_agar_kPa": 2.5,
      "nu_f": 0.45,
      "nu_s": 0.45,
      "h_biofilm_um": 80.0,
      "R_ring_um": 1600.0,
      "R_colony_um": 4500.0,
      "epsilon_g_wild_type": 0.22,
      "gamma_d_delamination": 0.65,
      "grid_size_N": 96
    }
  },

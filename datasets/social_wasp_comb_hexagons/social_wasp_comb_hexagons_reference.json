  "governing_equations": {
    "section": "Karsai & Pénzes (1993) J. Theor. Biol. 161:505-525 Eqs. (1)-(6); Theraulaz & Bonabeau (1995) Science 269:686-688; Karsai & Pénzes (2000) Behav. Ecol. 11:387-395; Smith et al. (2021) PNAS 118:e2103605118; Hales (2001) Discrete Comput. Geom. 25:1-22",
    "stigmergic_boltzmann_initiation": "P_init(j) = exp(beta * k_j) / sum_{m in dOmega} exp(beta * k_m),  k_j in {1, 2, 3} shared walls",
    "centered_hexagonal_cell_count": "N(R) = 1 + 3 * R * (R + 1),  Delta N(R) = N(R) - N(R - 1) = 6 * R",
    "compact_comb_total_walls": "W(R) = 3 * N(R) + 6 * R + 3 = 9 * R^2 + 15 * R + 6",
    "walls_per_cell_asymptote": "W(R) / N(R) = 3 + (6 * R + 3) / (1 + 3 * R * (R + 1)) -> 3.0 as R -> infinity (50% pulp savings vs 6.0 unshared walls)",
    "pulp_walls_saved": "S_saved(R) = 6 * N(R) - W(R) = 3 * R * (3 * R + 1)",
    "euler_topological_charge_law": "sum_i (6 - z_i) = 6 * chi_Euler;  for a 5-7 disclination pair: q_5 + q_7 = (6 - 5) + (6 - 7) = (+1) + (-1) = 0",
    "parameters": {
      "beta_wild_type": 5.5,
      "beta_eden_random": 0.0,
      "w1_protrusion_penalty": 0.01,
      "R_rings_default": 6,

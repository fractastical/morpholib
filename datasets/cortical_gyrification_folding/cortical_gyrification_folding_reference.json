  "governing_equations": {
    "multiplicative_growth_decomposition": "F = F_e * G, where G = diag(g, 1) in 2D coronal shell tangential-radial coordinates and J_g = det(G) = g",
    "sulcal_wavelength_scaling": "lambda = 2 * pi * h * (mu_c / (3 * mu_s))^(1/3)",
    "gyrification_index": "GI = P_pial / P_hull >= 1.0 (equality iff P_pial = P_hull in lissencephalic state g <= g_c)",
    "dimensionless_parameters": {
      "c_lambda_equal_modulus": 4.356517371567222,
      "critical_growth_threshold_g_c": 1.18,
      "default_modulus_ratio_mu_c_over_mu_s": 1.0,
      "cortical_shear_modulus_kPa": 1.5,
      "subcortical_shear_modulus_kPa": 1.5
    }
  },

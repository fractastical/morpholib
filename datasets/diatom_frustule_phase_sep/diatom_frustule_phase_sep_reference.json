  "cahn_hilliard_governing_model": {
    "section": "Lenoci & Camp (2008) Langmuir 24:217-223 Eqs. (1)-(6); Cahn & Hilliard (1958) J. Chem. Phys. 28:258",
    "free_energy_functional": "F[phi] = int_Omega [ (1/4)*(phi^2 - 1)^2 + (epsilon^2 / 2)*|grad(phi)|^2 ] dx",
    "chemical_potential": "mu(phi) = phi^3 - phi - epsilon^2 * laplacian(phi)",
    "governing_pde": "d(phi)/dt = M * laplacian(phi^3 - phi - epsilon^2 * laplacian(phi))",
    "mass_conservation_law": "d/dt int_Omega phi(x, t) dx = 0 (periodic / zero-flux boundary conditions)",
    "linear_spinodal_dispersion": {
      "formula": "sigma(k) = M * k^2 * (1 - 3*phi0^2 - epsilon^2 * k^2)",
      "spinodal_condition": "1 - 3*phi0^2 > 0  <=>  |phi0| < 1/sqrt(3) = 0.577350269",
      "critical_wavenumber_kc": "k_c = sqrt((1 - 3*phi0^2) / (2 * epsilon^2))",
      "cutoff_wavenumber_k0": "k_0 = sqrt((1 - 3*phi0^2) / epsilon^2) = sqrt(2) * k_c",
      "characteristic_wavelength": "lambda_c = 2 * pi / k_c = 2 * pi * sqrt(2) * epsilon / sqrt(1 - 3*phi0^2)",
      "max_growth_rate_sigma_c": "sigma(k_c) = M * (1 - 3*phi0^2)^2 / (4 * epsilon^2)"
    },
    "canonical_parameters": {
      "M": 1.0,
      "phi0_droplet": -0.3,
      "phi0_bicontinuous": 0.0,
      "phi0_outside_spinodal_control": -0.65,
      "epsilon_primary": 1.5,
      "epsilon_secondary": 0.65,

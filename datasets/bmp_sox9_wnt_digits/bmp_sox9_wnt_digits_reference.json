  "governing_equations": {
    "section": "Raspopovic et al. (2014) Science 345:566-570, Fig. 2E-G, Fig. 4A-D & Supplementary Materials Eqs. S1-S6",
    "sox9_pde": "dS/dt = -mu_S * S + k_sb * B - k_sw * W - S^3  (cell-autonomous, D_S = 0)",
    "bmp_pde": "dB/dt = -k_bs(x) * S - mu_B * B + D_B * Laplacian(B)",
    "wnt_pde": "dW/dt = -k_ws * S - mu_W * W + D_W * Laplacian(W)",
    "full_3node_jacobian": "J_3 = [[-mu_S, k_sb, -k_sw], [-k_bs, -mu_B, 0], [-k_ws, 0, -mu_W]]",
    "reduced_2diffuser_jacobian": "J_eff = [[-mu_B - k_bs*k_sb/mu_S, +k_bs*k_sw/mu_S], [-k_ws*k_sb/mu_S, +k_ws*k_sw/mu_S - mu_W]]",
    "determinant_reduction_identity": "det(-J_3) = mu_S * det(J_eff) = mu_S * mu_B * mu_W + k_bs * k_sb * mu_W - k_ws * k_sw * mu_B",
    "out_of_phase_eigenmode_law": "delta_B / delta_S = -k_bs / (mu_B + D_B * q^2 + sigma) < 0 and delta_W / delta_S = -k_ws / (mu_W + D_W * q^2 + sigma) < 0",
    "fgf_modulation_law": "k_bs(x) = k_bs0 * (1 + alpha_fgf * FGF(x)),  lambda_Turing(F) = 2 * pi / q_c(F)",
    "baseline_parameters": {
      "mu_S": 1.0,
      "mu_B": 1.2,
      "mu_W": 1.5,
      "k_sb": 2.5,
      "k_sw": 2.2,
      "k_bs": 1.8,
      "k_ws": 2.0,
      "D_S": 0.0,
      "D_B": 2.5,
      "D_W": 0.25,
      "tr_J3": -3.7,
      "det_neg_J3": 3.27,
      "tr_Jeff": -2.8,
      "det_Jeff": 3.27,
      "Jeff_BB": -5.7,
      "Jeff_BW": 3.96,
      "Jeff_WB": -5.0,
      "Jeff_WW": 2.9,
      "q_c_3node": 1.57,
      "lambda_c_3node": 4.0020,
      "sigma_max_3node": 0.2608
    }
  },

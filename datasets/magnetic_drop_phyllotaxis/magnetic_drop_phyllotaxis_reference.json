  "governing_equations": {
    "section": "Douady & Couder (1992) Phys. Rev. Lett. 68:2098 Eqs. (1)-(3) & Fig. 3; Douady & Couder (1996) J. Theor. Biol. 178:255 Sec. 2-3",
    "plastochron_ratio_G": "G = V * T / R_0",
    "linear_advection_law": "r_k(t_n) = R_0 + V * k * T = R_0 * (1 + k * G)",
    "exponential_advection_law": "r_k(t_n) = R_0 * exp(V * k * T / R_0) = R_0 * exp(k * G)",
    "euclidean_chord_distance_sq": "d_k^2(phi, phi_{n-k}) = R_0^2 + r_k^2 - 2 * R_0 * r_k * cos(phi - phi_{n-k})",
    "dipole_repulsive_energy": "E(phi) = sum_{k=1}^{N_mem} [1 + (r_k/R_0)^2 - 2*(r_k/R_0)*cos(phi - phi_{n-k})]^(-gamma / 2)  with gamma = 3",
    "iterative_minimization_rule": "phi_n = argmin_{phi in [0, 2*pi)} E(phi)",
    "regular_spiral_equilibrium_force": "F(G, Delta_phi) = -gamma * sum_{k=1}^{M} r_k * sin(k * Delta_phi) * (1 + r_k^2 - 2*r_k*cos(k * Delta_phi))^(-1 - gamma/2) = 0",
    "distichous_pitchfork_curvature": "d^2 E_2 / d phi^2 |_{phi=0} = 3 * r_1 / (r_1 + 1)^5 - 3 * r_2 / (r_2 - 1)^5 = 0"
  },

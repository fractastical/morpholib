  "dataset_id": "vogel-phyllotaxis-reference-v1",
  "title": "Vogel (1979) / Douady-Couder (1992) Phyllotaxis Model & Swinton et al. (2016) Royal Society Helianthus annuus Parastichy Reference Dataset",
  "primary_papers": [
    {
      "id": "vogel1979",
      "citation": "Vogel, H. (1979). A better way to construct the sunflower head. Mathematical Biosciences, 44(3-4), 179-189.",
      "doi": "10.1016/0025-5564(79)90080-4",
      "equations": {
        "radial_coordinate": "r_n = c * sqrt(n)",
        "angular_coordinate": "theta_n = n * alpha_0",
        "golden_ratio_tau": "(1 + sqrt(5)) / 2 = 1.618033988749895",
        "golden_angle_deg": "360 * (2 - tau) = 360 / tau^2 = 137.50776405003785",
        "golden_angle_rad": "2 * pi / tau^2 = 2.399963229728653",
        "lucas_noble_angle_deg": "360 / (3 + 1/tau) = 99.50155280998114"
      }
    },
    {
      "id": "douady1992",
      "citation": "Douady, S., & Couder, Y. (1992). Phyllotaxis as a physical self-organized growth process. Physical Review Letters, 68(13), 2098-2101.",
      "doi": "10.1103/PhysRevLett.68.2098",
      "equations": {
        "plastochron_ratio_G": "G = V * T / R_0 = ln(r_{n+1} / r_n)",
        "inhibitory_energy_hofmeister": "E(theta) = sum_{k=1}^{M} exp(-d(theta, theta_{n-k}, k*G) / lambda)",
        "next_primordium_rule": "theta_n = argmin_{theta in [0, 2*pi)} E(theta)"
      }
    },
    {
      "id": "swinton2016",
      "citation": "Swinton, J., Ochu, E., & The MSI Turing's Sunflower Consortium (2016). Novel Fibonacci and non-Fibonacci structure in the sunflower: results of a citizen science experiment. Royal Society Open Science, 3(5), 160091.",

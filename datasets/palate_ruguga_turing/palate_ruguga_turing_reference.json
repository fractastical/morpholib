  "governing_equations": {
    "section": "Economou et al. (2012) Nature Genetics 44:348-351 Figs. 1-4 & Supplementary Note (FGF10/FGF7 Activator + SHH Inhibitor Growth-Zone Turing Model)",
    "fgf_activator_pde": "dA/dt = (c_1 - mu_A) * A - c_2 * H - A^3 + D_A * Laplacian(A)",
    "shh_inhibitor_pde": "dH/dt = c_3 * A - mu_H * H + D_H * Laplacian(H)",
    "reaction_jacobian": "J_0 = [[a_11, -a_12], [a_21, -a_22]] = [[1.6, -2.5], [2.4, -2.0]]",
    "dispersion_polynomial": "Delta(q^2) = (D_A * q^2 - a_11) * (D_H * q^2 + a_22) + a_12 * a_21",
    "critical_wavenumber_formula": "q_c^2 = (a_11 * D_H - a_22 * D_A) / (2 * D_A * D_H),  lambda_c = 2 * pi / q_c",
    "growth_zone_intercalation_law": "Delta_L(t) = v_g * t >= lambda_c => new transverse Shh ruga stripe nucleates in the ruga-8 anterior growth zone",
    "baseline_parameters": {
      "a_11": 1.6,
      "a_12": 2.5,
      "a_21": 2.4,
      "a_22": 2.0,
      "D_A": 0.2,
      "D_H": 5.0,
      "D_ratio": 25.0,
      "tr_J0": -0.4,
      "det_J0": 2.8,
      "q_c_squared": 3.8,
      "q_c": 1.9494,
      "lambda_c": 3.2232,
      "delta_at_qc": -2.84,
      "sigma_max": 0.4227,
      "palate_final_length_L": 29.0,
      "wild_type_mouse_rugae_count": 9
    }
  },

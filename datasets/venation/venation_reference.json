  "runions_2005_equations": {
    "vein_node_advance_eq1": {
      "formula": "v' = v + D * (n_vec / ||n_vec||),  n_vec = sum_{s in S(v)} (s - v) / ||s - v||",
      "step_length_D": 1.0,
      "open_influence_set": "S(v) = {s in S : argmin_{u in V} ||s - u|| = v} (Voronoi cell of vein node v)",
      "open_kill_condition": "Remove auxin source s when min_{v in V} ||s - v|| < d_k"
    },
    "closed_rng_neighborhood_eq2_eq3": {
      "formula": "V(s) = {v in V : forall u in V, ||v - s|| < max(||u - s||, ||v - u||)},  S(v) = {s in S : v in V(s)}",
      "closed_kill_condition": "When any v in V(s) enters kill radius d_k, tag V(s); remove s only when all tagged veins reach within d_k of s (creating closed anastomosing loops / areoles)."
    },
    "murray_law_sec3_5": {
      "formula": "r_parent^gamma = sum_{i=1}^k r_child_i^gamma",
      "developmental_exponent_gamma": 3.0,
      "area_preserving_exponent_gamma": 2.0,
      "symmetric_bifurcation_area_ratio_murray": 1.2599210498948732,
      "symmetric_bifurcation_area_ratio_davinci": 1.0
    }
  },

  "governing_equations": {
    "section": "Moulton, Goriely & Chirat (2015) J. Theor. Biol. 364:420-430 Sec. 2-4; Chirat, Moulton & Goriely (2013) PNAS 110:6015-6020",
    "kirchhoff_elastica_unilateral_ode": "E * I(S) * d^2theta/dS^2 + F_x * sin(theta) - F_y * cos(theta) - K_u(y) = 0,  dx/dS = gamma * cos(theta),  dy/dS = gamma * sin(theta)",
    "hierarchical_wavenumber_law": "k_i^* = (3 * K_s / (E * h_i^3))^(1/4)",
    "secondary_frond_cascade_ratio": "k_2^* / k_1^* = (h_1 / h_2)^(3/4) * (K_s2 / K_s1)^(1/4)",
    "tubular_folding_closure_criterion": "Delta_x_neck(gamma) = w_base * (1 - (gamma - gamma_c) / (gamma_fold - gamma_c)) <= 0  <=>  gamma >= gamma_fold",
    "episodic_varix_growth_law": "gamma(phi) = gamma_base + Delta_gamma_varix * exp(-sin^2(3 * phi / 2) / (2 * sigma_phi^2));  A_spine(gamma) = A_0 * sqrt(max(0, gamma - gamma_c))",
    "default_parameters": {
      "E_modulus_MPa": 12.0,
      "K_s_foundation_MPa_per_mm": 0.48,

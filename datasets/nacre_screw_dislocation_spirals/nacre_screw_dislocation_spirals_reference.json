  "governing_equations": {
    "section": "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 Sec. 2-4; Cartwright et al. (2009) PNAS 106:10499-10504; Burton, Cabrera & Frank (1951) Phil. Trans. R. Soc. A 243:299-358",
    "gibbs_thomson_step_velocity": "v(kappa) = v_inf * (1 - r_c * kappa),   r_c = gamma * Omega / Delta_mu,   v(r) = v_inf * (1 - r_c / r) for r >= r_c and Delta_mu > 0",
    "bcf_spiral_angular_frequency": "omega = omega_0 * (v_inf / r_c),   omega_0 = 0.330958",
    "bcf_archimedean_terrace_wavelength": "lambda_0 = 2 * pi * v_inf / omega = (2 * pi / omega_0) * r_c ≈ 18.9848 * r_c ≈ 19 * r_c = 19 * gamma * Omega / Delta_mu",
    "frank_read_dipole_annihilation_law": "B_tot = b_1 + b_2 = (+1) + (-1) = 0 outside dipole separation d: closed concentric target loops nucleate iff d > 2 * r_c; pinch-off failure when d <= 2 * r_c",
    "chitin_mineral_bridge_transition_law": "Psi_col = (d_tab / lambda_0) * (1 / N_pore_per_tablet): vertically aligned central mineral bridges (high d_tab / lambda_0, low lateral pore dispersion) yield gastropod (Haliotis) columnar nacre stacks; high random pore density & broad terrace pitch yield bivalve (Pteria/Pinctada) sheet nacre",
    "default_parameters": {
      "v_inf_um_per_hr": 1.25,
      "gamma_omega_um_kBT": 0.21,
      "delta_mu_kBT": 0.50,
      "r_c_um": 0.42,

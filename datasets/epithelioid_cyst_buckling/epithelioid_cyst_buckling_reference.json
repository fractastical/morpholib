  "governing_equations": {
    "section": "Trushko et al. (2020) Dev. Cell 54:655-668 STAR Methods & Figs. 2-6; Hannezo et al. (2014) PNAS 111:27-32 Eqs. (1)-(8); Zoelly (1915) ETH Zurich spherical shell buckling law",
    "zoelly_critical_pressure_formula": "P_c = (2 * E_epi / sqrt(3 * (1 - nu_epi^2))) * (h / R_0)^2",
    "fvk_dimensionless_bending_modulus_formula": "tilde_kappa = kappa_bend / (Y_2D * R_0^2) = (1 / (12 * (1 - nu_epi^2))) * (h / R_0)^2",
    "alginate_confining_pressure_formula": "P_alg(g) = K_alg * (g - 1), where K_alg = (2 * E_alg * H_alg) / ((1 - nu_alg) * R_0)",
    "critical_growth_stretch_formula": "g_c = 1 + P_c / (K_alg * (1 + alpha_myo * Gamma_myo))",
    "post_buckling_fold_depth_formula": "delta_over_R0(g) = c_delta * sqrt(max(0, g - g_c)) * (1 + beta_myo * Gamma_myo)",
    "parameters": {
      "R_0_default_um": 100.0,
      "h_default_um": 10.5,
      "E_epi_default_kPa": 18.5,
      "nu_epi": 0.45,
      "E_alg_default_kPa": 5.0,
      "H_alg_default_um": 25.0,
      "nu_alg": 0.48,
      "tau_d_hours": 18.0,
      "c_delta_invagination": 0.88,
      "alpha_myo_contractility": 0.24,
      "beta_myo_depth": 0.22,
      "n_ring_vertices": 180
    }
  },

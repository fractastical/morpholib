  "governing_equations": {
    "section": "Campas et al. (2010) PNAS 107(8):3356-3360, Eqs. (1)-(3) & Figs. 1-4; Abzhanov et al. (2004, 2006)",
    "affine_scaling_shear_matrix": "M(s_L, s_D, gamma) = [[1, gamma], [0, 1]] @ [[s_L, 0], [0, s_D]] = [[s_L, gamma * s_D], [0, s_D]]",
    "determinant_law": "det(M(s_L, s_D, gamma)) = s_L * s_D > 0 for s_L > 0, s_D > 0",
    "canonical_beak_profile": "y_0(x_0) = a_0 * x_0^n + c_2 * x_0^2, where x_0 in [0, 1] is normalized distance from beak tip",
    "bmp4_cam_growth_law": "s_D(b) = s_D0 * (1 + alpha_B * (b - 1)),  s_W(b) = s_W0 * (1 + alpha_W * (b - 1)),  s_L(c) = s_L0 * (1 + alpha_C * (c - 1))",
    "bending_resistance_index": "I_beam = (W * D^3) / (12 * L)",
    "canonical_parameters": {
      "n_power": 1.85,
      "a_0": 0.52,
      "c_2": 0.14,
      "alpha_B": 0.78,
      "alpha_W": 0.72,
      "alpha_C": 0.68
    }
  },

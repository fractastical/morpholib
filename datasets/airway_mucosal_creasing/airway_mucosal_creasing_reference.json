  "governing_equations": {
    "section": "Wiggs et al. (1997) J. Appl. Physiol. 83:1814-1821 Eqs. (1)-(8); Li et al. (2011) JMPS 59:758-774 Eqs. (12)-(24); Jin et al. (2011) JAM 78:031009; Eskandari et al. (2015) JTB 403:209-218 Eqs. (6)-(19)",
    "critical_wavelength_formula": "lambda_c = 2 * pi * h_m * (mu_m / (3 * mu_s))^(1/3)",
    "circumferential_mode_number_formula": "m_star = (R_0 / h_m) * ((3 * mu_s) / mu_m)^(1/3)",
    "critical_buckling_strain_formula": "epsilon_c = 0.25 * ((3 * mu_s) / mu_m)^(2/3)",
    "period_doubling_strain_formula": "epsilon_pd = epsilon_c + 0.145 * ((3 * mu_s) / mu_m)^(1/3)",
    "creasing_threshold_strain": "epsilon_crease = 0.35",
    "inextensible_lumen_area_formula": "A_lumen(epsilon_theta, m) = A_0 * ((1 - epsilon_theta)^2 - c_fold * epsilon_theta / m)",
    "poiseuille_resistance_ratio_formula": "R_flow_ratio = (A_0 / A_lumen)^2",
    "parameters": {
      "R_0_um": 600.0,
      "c_fold_occlusion": 2.35,
      "alpha_period_doubling": 0.42,
      "beta_sulcal_crease": 0.28,
      "epsilon_crease_universal": 0.35,
      "n_theta_grid": 360
    }
  },

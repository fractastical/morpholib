  "governing_equations": {
    "section": "Yang et al. (2022) Science 375:647-652; Donnay & Pawson (1969) Science 166:1147-1150; Schoen (1970) NASA TN D-5541; Gibson & Ashby (1997)",
    "tpms_nodal_level_set_equations": {
      "diamond_D": "F_D(x,y,z) = sin(X)*sin(Y)*sin(Z) + sin(X)*cos(Y)*cos(Z) + cos(X)*sin(Y)*cos(Z) + cos(X)*cos(Y)*sin(Z) = c, where X = 2*pi*x/a_0",
      "gyroid_G": "F_G(x,y,z) = sin(X)*cos(Y) + sin(Y)*cos(Z) + sin(Z)*cos(X) = c, where X = 2*pi*x/a_0",
      "primitive_P": "F_P(x,y,z) = cos(X) + cos(Y) + cos(Z) = c, where X = 2*pi*x/a_0"
    },
    "minimal_surface_curvature_law": "H = (kappa_1 + kappa_2) / 2 = 0  =>  kappa_1 = -kappa_2  and  K = kappa_1 * kappa_2 = -kappa_1^2 <= 0 (hyperbolic saddle geometry)",
    "odd_inversion_volume_fraction_law": "F_G(-X,-Y,-Z) = -F_G(X,Y,Z), F_D(X+pi,Y+pi,Z+pi) = -F_D(X,Y,Z) => phi(c=0) = 1/2 = 0.5000",
    "gibson_ashby_cellular_solid_scaling": "E_rel_TPMS(phi) = E*/E_s = C_stretch * phi^1.0 (stretching-dominated TPMS Diamond/Gyroid/Primitive) vs E_rel_foam(phi) = C_bend * phi^2.0 (bending-dominated disordered labyrinthic foam)",
    "default_parameters": {
      "a_0_um": 14.80,
      "c_threshold_default": 0.0,
      "c_pinchoff_ablation": 1.35,
      "e_calcite_gpa": 76.0,
      "c_stretch_diamond": 0.38,
      "c_stretch_gyroid": 0.34,
      "c_stretch_primitive": 0.32,
      "c_bend_labyrinthic": 0.42,
      "n_grid_3d": 36,
      "genus_per_unit_cell": 3,
      "euler_characteristic_unit_cell": -4
    }
  },

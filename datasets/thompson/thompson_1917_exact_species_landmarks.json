  "landmark_definitions": {
    "1": "Anterior tip of lower jaw (dentary symphysis)",
    "2": "Anterior tip of upper jaw (premaxilla / snout tip)",
    "3": "Anterior origin of dorsal fin (or dorsal spine/blade)",
    "4": "Posterior insertion of dorsal fin base",
    "5": "Dorsal insertion of caudal fin (or dorsal clavus base in Molidae)",
    "6": "Ventral insertion of caudal fin (or ventral clavus base in Molidae)",
    "7": "Posterior insertion of anal fin base",
    "8": "Anterior origin of anal fin",
    "9": "Dorsal insertion of pectoral fin base",
    "10": "Ventral insertion of pectoral fin base",
    "11": "Dorsal extremity of gill opening / opercular cleft",
    "12": "Posterior-most margin of operculum (or gill opening in Molidae)",
    "13": "Posteroventral corner of preopercle / interopercle",
    "14": "Lower-jaw articular-quadrate joint",
    "15": "Anterior margin of bony orbit (eye)",
    "16": "Posterior margin of bony orbit (eye)",
    "17": "Supraoccipital crest / nape"
  },

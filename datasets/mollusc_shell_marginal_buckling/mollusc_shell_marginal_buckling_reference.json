  "governing_equations": {
    "section": "Chirat, Moulton & Goriely (2013) PNAS 110:6015-6020 Eqs. 1-4 & SI Sec. S1-S2; Erlich et al. (2016) J. R. Soc. Interface 13:20160592 Sec. 2-3",
    "nonlinear_winkler_beam_ode": "E * I * d^4w/ds^4 + P * d^2w/ds^2 + k * w + kappa_3 * w^3 = 0",
    "elastic_energy_functional": "U[w] = integral_0^L [0.5 * E * I * (w_ss)^2 - 0.5 * P * (w_s)^2 + 0.5 * k * w^2 + 0.25 * kappa_3 * w^4] ds",
    "fourier_modal_stiffness_operator": "Lambda(q; P) = E * I * q^4 - P * q^2 + k",
    "critical_buckling_load_formula": "P_c = 2 * sqrt(E * I * k)",
    "critical_wavenumber_formula": "q_c = (k / (E * I))^(1/4)",
    "antimarginal_wavelength_formula": "lambda_c = 2 * pi * (E * I / k)^(1/4) = 2 * pi * ell_*",
    "characteristic_length_scale_formula": "ell_* = (E * I / k)^(1/4)",
    "supercritical_pitchfork_amplitude_formula": "A_eq(P) = sqrt(4 * q_c^2 * (P - P_c) / (3 * kappa_3))",
    "rib_number_scaling_law": "N_ribs = (Phi_0 * R) / lambda_c = (Phi_0 * R / (2 * pi)) * (k / (E * I))^(1/4)",
    "default_parameters": {
      "EI_mN_mm2": 0.180,
      "k_mN_per_mm2": 0.285,
      "kappa_3_mN_per_mm4": 1.250,
      "P_over_Pc_wildtype": 1.450,
      "P_over_Pc_subcritical": 0.650,
      "fan_angle_rad": 2.234021442552742,
      "adult_radius_mm": 55.0
    }
  },

  "governing_equations": {
    "section": "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 Sec. 2-4; Cartwright et al. (2009) PNAS 106:10499-10504; Burton, Cabrera & Frank (1951) Phil. Trans. R. Soc. A 243:299-358",
    "gibbs_thomson_step_velocity": "v_n(kappa) = v_inf * (1 - r_c * kappa),   v(r) = v_inf * (1 - r_c / r) for r >= r_c",
    "bcf_spiral_angular_frequency": "omega = omega_0 * (v_inf / r_c),   omega_0 = 0.330958",
    "bcf_archimedean_terrace_pitch": "lambda_0 = 2 * pi * v_inf / omega = (2 * pi / omega_0) * r_c ≈ 18.9848 * r_c ≈ 19.0 * r_c",
    "cabrera_levine_spiral_shape": "theta_s(r) = (omega / v_inf) * (r - r_c) + (omega * r_c / v_inf) * ln(r / r_c)",
    "vertical_accretion_velocity": "V_z = h_0 * (omega / (2 * pi)) = h_0 * v_inf / lambda_0",
    "frank_read_dipole_winding_law": "b_net = b_1 + b_2: (+b, -b) -> b_net = 0 (closed target rings for d > 2*r_c; pinch-off annihilation for d <= 2*r_c); (+b, +b) -> b_net = 2*b (double-armed spiral)",
    "default_parameters": {
      "v_inf_um_per_hr": 1.25,
      "r_c_um": 0.42,
      "h_0_um": 0.50,
      "omega_0_bcf": 0.330958,
      "pitch_ratio_bcf": 18.9848,
      "lambda_0_um": 7.9736,
      "omega_rad_per_hr": 0.9850,
      "dipole_separation_target_um": 2.40,
      "dipole_separation_subcritical_um": 0.60
    }
  },

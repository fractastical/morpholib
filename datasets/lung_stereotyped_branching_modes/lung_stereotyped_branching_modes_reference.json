  "metzger_2008_branching_programme": {
    "section": "Metzger, Klein, Martin & Krasnow (2008) Nature 453:745-750 Figs. 1-4",
    "subroutines": {
      "D_domain_branching": {
        "symbol": "D",
        "name": "Domain Branching",
        "mechanism": "Daughter buds form sequentially in longitudinal rows ('domains') along the side of a parent trunk at periodic spacing lambda_DB, with 90 deg circumferential domain shifts (Dorsal, Ventral, Medial, Lateral)",
        "dihedral_rotation_deg": 90.0,
        "lateral_sprout_angle_deg": 68.0,
        "inter_bud_spacing_um": 185.0,
        "radius_ratio_daughter_over_parent": 0.58,
        "length_decay_factor": 0.82
      },
      "P_planar_bifurcation": {
        "symbol": "P",
        "name": "Planar Bifurcation",
        "mechanism": "Airway tip splits into two symmetric daughter buds in the same plane as the preceding bifurcation (Delta_phi = 0 deg), forming flat lobar edges and margins",
        "dihedral_rotation_deg": 0.0,
        "bifurcation_half_angle_deg": 37.5,
        "total_bifurcation_angle_deg": 75.0,
        "radius_ratio_daughter_over_parent": 0.793701,
        "length_decay_factor": 0.78
      },
      "O_orthogonal_bifurcation": {
        "symbol": "O",
        "name": "Orthogonal Bifurcation",
        "mechanism": "Airway tip splits into two symmetric daughter buds with a 90 deg dihedral rotation of the division plane relative to the parent bifurcation (Delta_phi = 90 deg), filling 3D lobar interior space",
        "dihedral_rotation_deg": 90.0,
        "bifurcation_half_angle_deg": 37.5,
        "total_bifurcation_angle_deg": 75.0,
        "radius_ratio_daughter_over_parent": 0.793701,
        "length_decay_factor": 0.78
      }
    },
    "fgf10_shh_turing_parameters": {
      "D_R": 0.02,
      "D_F": 1.0,
      "diffusion_ratio_d": 50.0,
      "a_R": 0.1,
      "a_F": 0.9,
      "mu_R": 1.0,
      "gamma_scale": 120.0,
      "homogeneous_R_star": 1.0,
      "homogeneous_F_star": 0.9,
      "jacobian_f_R": 0.8,
      "jacobian_f_F": 1.0,
      "jacobian_g_R": -1.8,
      "jacobian_g_F": -1.0,
      "jacobian_det": 1.0,
      "critical_wavenumber_k_c_sq": 19.656854,
      "turing_wavelength_nondim": 1.417238,
      "critical_elongation_Ratio_v_crit": 0.48
    }
  },

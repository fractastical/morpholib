  "menshykau_iber_2013_gdnf_ret_turing_model": {
    "section": "Menshykau & Iber (2013) Phys. Biol. 10(4):046003 Eqs. (1)-(7) & Table 1",
    "parameters": {
      "D_R": 0.02,
      "D_G": 1.0,
      "diffusion_ratio_d": 50.0,
      "a_basal_ret": 0.10,
      "b_mesenchymal_gdnf": 0.90,
      "gamma_scale_wt": 25.0,
      "gamma_scale_spry1_ko": 46.25,
      "gamma_scale_hypoplasia": 11.25,
      "b_gdnf_haploinsufficient": 0.45,
      "R_star_wt": 1.00,
      "G_star_wt": 0.90,
      "R2G_star_wt": 0.90,
      "jacobian_f_R_wt": 0.80,
      "jacobian_f_G_wt": 1.00,
      "jacobian_g_R_wt": -1.80,
      "jacobian_g_G_wt": -1.00,
      "jacobian_trace_wt": -0.20,
      "jacobian_det_wt": 1.00,
      "critical_wavenumber_sq_kc2_wt": 176.776695,
      "critical_wavelength_lambda_c_wt": 0.472569,
      "dichotomous_rho_min": 1.50,
      "dichotomous_rho_max": 2.50
    },
    "governing_equations": {
      "ret_receptor_pde": "dR/dt = D_R * laplacian(R) + gamma * (a - R + R^2 * G)",
      "gdnf_ligand_pde": "dG/dt = D_G * laplacian(G) + gamma * (b - R^2 * G) + S_bead(x)",
      "homogeneous_steady_state": "R* = a + b,   G* = b / (a + b)^2,   (R*)^2 * G* = b",
      "critical_turing_wavenumber": "k_c^2 = gamma * (a + b) / sqrt(D_R * D_G),   lambda_c = 2 * pi / k_c",
      "tip_normal_growth_velocity": "v_n(s) = v_0 * max(0, R(s)^2 * G(s) - S_thresh)"
    }
  },

        rdfs:label "Dubrulle & Pourquié (2001, 2004) FGF8 mRNA decay wavefront and determination front positioning in vertebrate somitogenesis — Code-to-model traceability: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Every computational section and docstring maps directly to numbered figures in Dubrulle et al. (2001) Cell Figs. 1-4, Dubrulle & Pourquié (2004) Nature Figs. 1-3, and the 3 Lean 4 theorems in `Loop_024_fgf8_wavefront_somitogenesis.lean` and `morphoeval/math_kg_loops/dubrulle-fgf8-wavefront-somitogenesis.yaml`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-code-traceability-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L1–L55" ;
        dct:description "Module docstring linking equations to Dubrulle & Pourquie (2001, 2004) and Lean 4 theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L1-L55> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/dubrulle-fgf8-wavefront-somitogenesis.yaml L1–L92" ;
        dct:description "Math KG loop specification linking equations, Lean 4 declarations, and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/math_kg_loops/dubrulle-fgf8-wavefront-somitogenesis.yaml#L1-L92> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;

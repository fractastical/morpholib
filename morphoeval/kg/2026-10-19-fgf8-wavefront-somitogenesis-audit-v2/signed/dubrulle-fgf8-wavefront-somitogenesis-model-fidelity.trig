sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-dubrulle-fgf8-wavefront-somitogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L110–L175" ;
        dcterms:description "Cell-autonomous fgf8 mRNA advection-decay PDE solver and analytical exponential gradient" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L110-L175> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L180–L345" ;
        dcterms:description "Determination front positioning x* and ectopic FGF8 bead / SU5402 somite boundary simulator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L180-L345> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_024_fgf8_wavefront_somitogenesis.lean L24–L87" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for advection-decay balance, x* scaling, and bead pair conservation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_024_fgf8_wavefront_somitogenesis.lean#L24-L87> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Dubrulle & Pourquié (2001, 2004) FGF8 mRNA decay wavefront and determination front positioning in vertebrate somitogenesis — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements Dubrulle & Pourquié's (2004) cell-autonomous fgf8 mRNA advection-decay PDE dm/dt + v_g dm/dx = -k_d m and Dubrulle et al.'s (2001) determination front threshold x* = (v_g/k_d) ln(m_0/m_crit) and somite perturbation kinematics S_n = v_g*T_c - Delta_x*_n (L110-345), achieving L2 relative error = 0.00086 against the analytical steady state and exact two-somite conservation S_ant + S_post = 300.0 um around an ectopic FGF8 bead, verified by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_024_fgf8_wavefront_somitogenesis.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


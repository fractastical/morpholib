sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-dubrulle-fgf8-wavefront-somitogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Dubrulle & Pourquié (2001, 2004) FGF8 mRNA decay wavefront and determination front positioning in vertebrate somitogenesis — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates all 5 experimental regimes from Dubrulle et al. (2001) and Dubrulle & Pourquié (2004) (wild-type control, ectopic FGF8 bead anterior compression, ectopic FGF8 bead posterior catch-up, SU5402 FGFR1 inhibition, and pCAGGS-FGF8 electroporation overexpression), maps the continuous 2D parameter morphospace x*(v_g, t_1/2) across v_g in [0.8, 2.8] um/min and t_1/2 in [60, 240] min (Panel C), includes a k_d = 0 no-decay negative control (0 somites, Panels A-B), and exposes CLI flags (`--vg`, `--Tc`, `--t-half`, `--seed`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L205–L250" ;
        dcterms:description "5-regime Dubrulle et al. (2001, 2004) FGF8 perturbation evaluator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L205-L250> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L565–L600" ;
        dcterms:description "2D (v_g, t_1/2) determination front morphospace contour surface and 5-regime validation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L565-L600> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


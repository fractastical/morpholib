sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Anomalocaris canadensis Turing wavenumber k_c at 24 µm (508 Ma) — Morphometric validation: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r = 0.999989 against a perfect-agreement reference of 1, RMSE = 0.00626 against 0, and KS D = 0.071 against a zero-growth null of 0.714. The cast mask is not a circle (circularity 0.303 versus 1) and the slot wavelength is 0.090 of the reconstructed 266 µm facet spacing versus a ratio of 1." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-dispersion-growth-rate-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-dispersion-growth-rate-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-dispersion-growth-rate-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-du-sweep-lambda-monotonic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-image-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-stripe-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-subfacet-to-facet-spacing-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-vs-modulated-luminance-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-dispersion-growth-rate-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_growth_rate_ks_statistic = 0.071429 KS D" ;
        dct:description "The reference D is the no-growth null. The fit D is the stencil comparison and is smaller." ;
        schema:measurementTechnique "Two-sample KS of numerical versus stencil growth rates on the same 14 wavenumbers" ;
        schema:name "dispersion_growth_rate_ks_statistic" ;
        schema:unitText "KS D" ;
        schema:value "0.071429" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-dispersion-growth-rate-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-dispersion-growth-rate-ks-statistic-reference> a schema:PropertyValue ;
        schema:value "0.714286" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-dispersion-growth-rate-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_growth_rate_pearson_r = 0.999989 Pearson r" ;
        dct:description "Reference 1 is perfect numerical-analytic agreement. The measured r is lower." ;
        schema:measurementTechnique "1D Schnakenberg cosine projected for 120 steps versus stencil growth rate σ(q), 14 wavenumbers" ;
        schema:name "dispersion_growth_rate_pearson_r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.999989" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-dispersion-growth-rate-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-dispersion-growth-rate-pearson-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-dispersion-growth-rate-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_growth_rate_rmse = 0.006263 1/time" ;
        dct:description "Reference 0 would be a perfect residual. RMSE is the KS companion scale." ;
        schema:measurementTechnique "RMSE of numerical minus stencil growth rates on q in [0.25, 1.25]" ;
        schema:name "dispersion_growth_rate_rmse" ;
        schema:unitText "1/time" ;
        schema:value "0.006263" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-dispersion-growth-rate-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-dispersion-growth-rate-rmse-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-du-sweep-lambda-monotonic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "du_sweep_lambda_monotonic = 1.0 boolean" ;
        dct:description "0 would record a non-monotonic sweep." ;
        schema:measurementTechnique "eight diffusivity scales from 0.55 to 1.80; analytical λ_c must increase" ;
        schema:name "du_sweep_lambda_monotonic" ;
        schema:unitText "boolean" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-du-sweep-lambda-monotonic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-du-sweep-lambda-monotonic-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_diffusion_ablation_std_ratio = 0.0026 ratio" ;
        dct:description "Reference 1 would mean the ablation still formed the Turing pattern." ;
        schema:measurementTechnique "std(u | Du=Dv) / std(u | Dv/Du=20) after 700 steps on a 64x48 Neumann patch" ;
        schema:name "equal_diffusion_ablation_std_ratio" ;
        schema:unitText "ratio" ;
        schema:value "0.0026" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_circularity = 0.3026 4πA/P²" ;
        dct:description "The slab-plus-animal silhouette is not a circle." ;
        schema:measurementTechnique "erosion perimeter of the border-contrast mask" ;
        schema:name "specimen_contour_circularity" ;
        schema:unitText "4πA/P²" ;
        schema:value "0.3026" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-image-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_image_foreground_fraction = 0.5885 fraction" ;
        dct:description "0.45 is the mask prior used only as a non-equal comparator, not a published area." ;
        schema:measurementTechnique "border-median contrast mask on the Tyrrell cast, 160x120" ;
        schema:name "specimen_image_foreground_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.5885" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> a schema:PropertyValue ;
        schema:value "0.45" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-stripe-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_stripe_coherency = 0.5589 (λ1-λ2)/(λ1+λ2)" ;
        dct:description "Shale cracks and flap margins are oriented, so coherency is above the isotropic null." ;
        schema:measurementTechnique "mean structure-tensor coherency inside the specimen mask" ;
        schema:name "specimen_stripe_coherency" ;
        schema:unitText "(λ1-λ2)/(λ1+λ2)" ;
        schema:value "0.5589" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-stripe-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-stripe-coherency-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-subfacet-to-facet-spacing-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_subfacet_to_facet_spacing_ratio = 0.0901 ratio" ;
        dct:description "A ratio of 1 would mean this slot's wavelength was the facet spacing. It is not." ;
        schema:measurementTechnique "slot λ 23.97 µm divided by reconstructed 2.5 cm hemisphere spacing at 16000 lenses" ;
        schema:name "specimen_subfacet_to_facet_spacing_ratio" ;
        schema:unitText "ratio" ;
        schema:value "0.0901" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-subfacet-to-facet-spacing-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-subfacet-to-facet-spacing-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-vs-modulated-luminance-ks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_vs_modulated_luminance_ks = 0.1044 KS D" ;
        dct:description "The reference is the scrambled image, not a copy of the modulated KS." ;
        schema:measurementTechnique "KS of cast luminance versus the 0.16-alpha activator modulation" ;
        schema:name "specimen_vs_modulated_luminance_ks" ;
        schema:unitText "KS D" ;
        schema:value "0.1044" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-vs-modulated-luminance-ks-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-measurement-specimen-vs-modulated-luminance-ks-reference> a schema:PropertyValue ;
        schema:value "0.0233" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-anomalocaris-canadensis-turing-wavelength-s0.py L149–L172" ;
        dct:description "Pearson, RMSE, KS" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/63ace896bba72dd95b1823861b5b9936be9cf066/models/2026-delphi10000-anomalocaris-canadensis-turing-wavelength-s0.py#L149-L172> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;

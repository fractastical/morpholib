<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Anomalocaris canadensis Turing wavenumber k_c at 24 µm (508 Ma) — Morphological realism / specimen match: 84/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The comparison plate and the 12-frame GIF use the CC BY-SA Tyrrell cast as the organism image, with the activator grown in a footer strip and as a light registration on the slab. The shale itself does not display 24 µm ocelli, so the match is the animal plus an explicit scale-separated field, not a photographic twin of a pigment pattern." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-specimen-match-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-specimen-match-2>,

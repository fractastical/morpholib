sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Anomalocaris canadensis Turing wavenumber k_c at 24 µm (508 Ma) — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The code integrates the Schnakenberg PDE, evaluates the Turing discriminant, and checks the discrete growth rate against the stencil symbol at 14 wavenumbers (r = 0.999989). The kinetics are the standard spot system, not a rate law measured on this fossil." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-anomalocaris-canadensis-turing-wavelength-s0.py L83–L172" ;
        dct:description "turing_margin, sigma_discrete, sigma_numeric, dispersion_goodness_of_fit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/63ace896bba72dd95b1823861b5b9936be9cf066/models/2026-delphi10000-anomalocaris-canadensis-turing-wavelength-s0.py#L83-L172> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anomalocaris-canadensis-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-anomalocaris-canadensis-turing-wavelength-s0.py L180–L214" ;
        dct:description "Neumann Schnakenberg step and linear ablation branch" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/63ace896bba72dd95b1823861b5b9936be9cf066/models/2026-delphi10000-anomalocaris-canadensis-turing-wavelength-s0.py#L180-L214> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (single builder-assessor; no second provider)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


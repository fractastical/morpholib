sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Drosophila serrata Schnakenberg Turing wavelength at 2.123 µm (Holocene, 0 Ma) faithfully reproduces Drosophila serrata morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-serrata-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila serrata specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-serrata-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-serrata-turing-wavelength-s0.py; output: docs/media/drosophila_serrata_turing_wavelength_s0_comparison.png; organism: Drosophila serrata; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 diffusion-driven instability and a finite critical wavenumber | Schnakenberg 1979 trimolecular kinetics | D. serrata CHC cline along the Australian east coast (Frentiu & Chenoweth 2010); reconstructed_in_script: 2.123e-6 m assigned as λ_c for this detail-scale slot | Chronoseries wavelengths 2134 / 2123 / 2102 nm at fixed activator diffusivity | k_max slightly below k_c because serrata is 8.5% above onset; transfer_boundary: Gallery plate is the species-gallery fallback, not a measured 2.1 µm micrograph | GIF colors are the plate's luminance-quantile palette; does_not_claim: A published measurement of a 2.123 µm ocellar Turing wavelength in D. serrata | That a second assessor reviewed this pass]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1023/A:1022992002239>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.1558-5646.2009.00936.x>,
            <https://doi.org/10.1126/science.290.5491.519> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-serrata-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-serrata-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


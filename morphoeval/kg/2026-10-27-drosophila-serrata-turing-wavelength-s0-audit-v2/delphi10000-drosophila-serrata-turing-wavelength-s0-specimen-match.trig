sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila serrata Schnakenberg Turing wavelength at 2.123 µm (Holocene, 0 Ma) — Morphological realism / specimen match: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "GIF CV similarity remains 94.1 against the gallery plate (12 frames, 640×520). The comparison figure now says the plate's printed bar is 100 µm and the model wavelength is 2.123 µm, so the match is a texture match to an ocellus-like field. It is still not a voucher micrograph at the detail scale, which is why this stays below 90." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-specimen-match-1>,

<https://w3id.org/delphi/resource/evidence/2026-10-27-drosophila-serrata-turing-wavelength-s0-audit-v2-delphi10000-drosophila-serrata-turing-wavelength-s0-1> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "RK2 vs analytic Turing dispersion Pearson r" ;
    dct:description "Pearson correlation of σ(k) from the closed-form eigenvalue and from RK2 integration of the linearized mode, 12 wavenumbers" ;

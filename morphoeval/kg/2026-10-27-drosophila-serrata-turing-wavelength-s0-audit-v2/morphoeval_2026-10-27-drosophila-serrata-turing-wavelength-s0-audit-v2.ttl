<https://w3id.org/delphi/resource/evidence/2026-10-27-drosophila-serrata-turing-wavelength-s0-audit-v2-delphi10000-drosophila-serrata-turing-wavelength-s0-4> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "serrata FFT peak over fastest linear mode k_max" ;

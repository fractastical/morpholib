<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila serrata Schnakenberg Turing wavelength at 2.123 µm (Holocene, 0 Ma) — Model fidelity to source: 91/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Same Schnakenberg linearization as Pass 1 (RK2 vs analytic r = 0.99998). Pass 2 separates band-center k_c from the fastest mode k_max (k_max/k_c = 0.975) and checks the nonlinear FFT peak against k_max, which is the comparison the dispersion relation actually predicts off onset." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila serrata Schnakenberg Turing wavelength at 2.123 µm (Holocene, 0 Ma) — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 1 metrics stand (r = 0.99998 vs 1, RMSE 0.00169 vs 0, orientation KS 0.071 vs 0.5, sechellia−serrata gap 11.14 nm vs 0). Pass 2 adds k_measured/k_max, reference 1, value near 0.976: the residual is one diagonal lattice step on the 64² grid (Δ|k| = k_c/8), not a second wavelength. The CHC cline's nanometre span remains a reconstruction." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-sechellia-minus-serrata>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-dispersion-rmse-between-rk2-and-analytic-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-east-coast-reconstructed-chc-cline-wavelength-span>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-equal-diffusion-ablation-maximum-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-gif-specimen-match-cv-sim-similarity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-rk2-vs-analytic-turing-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-serrata-fft-peak-over-fastest-linear-mode-k-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-serrata-nonlinear-patch-measured-to-critical-wavenumber-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-specimen-vs-simulation-orientation-ks-distance>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-sechellia-minus-serrata> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chronoseries wavelength gap sechellia minus serrata = 11.14 nm" ;
        dct:description "silvestris-serrata = -20.590 nm; neighbor k/k_c sechellia 0.981, silvestris 0.901" ;
        schema:measurementTechnique "analytic λ(δ) at fixed Du; predecessor factor 1.025× onset, serrata 1.085× onset" ;
        schema:name "chronoseries wavelength gap sechellia minus serrata" ;
        schema:unitText "nm" ;
        schema:value "11.14" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-sechellia-minus-serrata-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-sechellia-minus-serrata-reference> a schema:PropertyValue ;
        dct:source "null of no chronoseries shift" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-dispersion-rmse-between-rk2-and-analytic-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE between RK2 and analytic growth rate = 0.00169 1/time" ;
        schema:measurementTechnique "RMSE of σ_RK2(k) against σ_analytic(k) on k in [0.55, 1.45] k_c" ;
        schema:name "dispersion RMSE between RK2 and analytic growth rate" ;
        schema:unitText "1/time" ;
        schema:value "0.00169" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-dispersion-rmse-between-rk2-and-analytic-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-dispersion-rmse-between-rk2-and-analytic-growth-rate-reference> a schema:PropertyValue ;
        dct:source "zero residual would be an exact integrator" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-east-coast-reconstructed-chc-cline-wavelength-span> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "east-coast reconstructed CHC-cline wavelength span = -4.532 nm" ;
        dct:description "direction follows Frentiu & Chenoweth 2010; nanometre values are reconstructed" ;
        schema:measurementTechnique "λ(δ(ξ)) with δ(ξ) = δ_serrata (1 + 0.012 ξ), ξ from Cairns to Melbourne" ;
        schema:name "east-coast reconstructed CHC-cline wavelength span" ;
        schema:unitText "nm" ;
        schema:value "-4.532" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-east-coast-reconstructed-chc-cline-wavelength-span-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-east-coast-reconstructed-chc-cline-wavelength-span-reference> a schema:PropertyValue ;
        dct:source "sechellia-to-serrata gap used as a scale comparison, not the cline itself" ;
        schema:value "11.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-equal-diffusion-ablation-maximum-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation maximum growth rate = -0.23102 1/time" ;
        dct:description "control vs Turing: equal diffusion is linearly stable" ;
        schema:measurementTechnique "max_k σ(k) with Dv = Du (negative control)" ;
        schema:name "equal-diffusion ablation maximum growth rate" ;
        schema:unitText "1/time" ;
        schema:value "-0.23102" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-equal-diffusion-ablation-maximum-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-equal-diffusion-ablation-maximum-growth-rate-reference> a schema:PropertyValue ;
        dct:source "marginal stability boundary; a negative value is the stable side" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-gif-specimen-match-cv-sim-similarity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "GIF specimen-match cv_sim_similarity = 94.1 score" ;
        dct:description "n_frames = 12, size = 640x520" ;
        schema:measurementTechnique "Sobel orientation, radial FFT and structure-tensor coherency via compute_sim_vs_specimen_cv_similarity" ;
        schema:name "GIF specimen-match cv_sim_similarity" ;
        schema:unitText "score" ;
        schema:value "94.1" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-gif-specimen-match-cv-sim-similarity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-gif-specimen-match-cv-sim-similarity-reference> a schema:PropertyValue ;
        dct:source "MorphoEval image-fitness CV gate" ;
        schema:value "58.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-rk2-vs-analytic-turing-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "RK2 vs analytic Turing dispersion Pearson r = 0.99998 Pearson r" ;
        dct:description "RMSE = 0.00168968" ;
        schema:measurementTechnique "Pearson correlation of σ(k) from the closed-form eigenvalue and from RK2 integration of the linearized mode, 12 wavenumbers" ;
        schema:name "RK2 vs analytic Turing dispersion Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99998" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-rk2-vs-analytic-turing-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-rk2-vs-analytic-turing-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 dispersion identity; reference is exact agreement, the numerical value is the RK2 residual" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-serrata-fft-peak-over-fastest-linear-mode-k-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "serrata FFT peak over fastest linear mode k_max = 0.9761 k_measured / k_max" ;
        dct:description "k_max/k_c = 0.9753" ;
        schema:measurementTechnique "Same FFT peak divided by k_max = argmax σ(k). The 64² lattice quantizes |k| in steps of k_c/8." ;
        schema:name "serrata FFT peak over fastest linear mode k_max" ;
        schema:unitText "k_measured / k_max" ;
        schema:value "0.9761" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-serrata-fft-peak-over-fastest-linear-mode-k-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-serrata-fft-peak-over-fastest-linear-mode-k-max-reference> a schema:PropertyValue ;
        dct:source "linear dispersion peak; reference 1 would mean the nonlinear peak sits on k_max exactly" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-serrata-nonlinear-patch-measured-to-critical-wavenumber-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "serrata nonlinear patch measured-to-critical wavenumber ratio = 0.952 k_measured / k_c" ;
        dct:description "equal-diffusion control std = 0.0000 vs pattern std = 0.0600" ;
        schema:measurementTechnique "FFT peak of the periodic Schnakenberg patch divided by the band-center k_c" ;
        schema:name "serrata nonlinear patch measured-to-critical wavenumber ratio" ;
        schema:unitText "k_measured / k_c" ;
        schema:value "0.952" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-serrata-nonlinear-patch-measured-to-critical-wavenumber-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-serrata-nonlinear-patch-measured-to-critical-wavenumber-ratio-reference> a schema:PropertyValue ;
        dct:source "band-center formula k_c^2 = (Dv fu + Du gv) / (2 Du Dv); off onset the fastest mode sits slightly below k_c" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image structure-tensor coherency = 0.775 coherency" ;
        dct:description "specimen foreground fraction = 0.3762" ;
        schema:measurementTechnique "verify_image_fitness.compute_specimen_cv_signature on the pinned gallery plate" ;
        schema:name "specimen image structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.775" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "GIF last-frame interior standard deviation, a different quantity, so the pair is not self-referential" ;
        schema:value "0.1177" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-specimen-vs-simulation-orientation-ks-distance> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen vs simulation orientation KS distance = 0.0714 KS" ;
        schema:measurementTechnique "Kolmogorov-Smirnov distance between 12-bin Sobel orientation histograms of the specimen crop and the GIF last-frame crop" ;
        schema:name "specimen vs simulation orientation KS distance" ;
        schema:unitText "KS" ;
        schema:value "0.0714" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-specimen-vs-simulation-orientation-ks-distance-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-measurement-specimen-vs-simulation-orientation-ks-distance-reference> a schema:PropertyValue ;
        dct:source "pre-registered dissimilarity ceiling, not the measured KS" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-serrata-turing-wavelength-s0.py L548–L566" ;
        dct:description "k/k_c and k/k_max measurements, values differ from references" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-serrata-turing-wavelength-s0.py#L548-L566> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-serrata-turing-wavelength-s0.py L455–L465" ;
        dct:description "Orientation KS on specimen crop vs GIF crop" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-serrata-turing-wavelength-s0.py#L455-L465> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


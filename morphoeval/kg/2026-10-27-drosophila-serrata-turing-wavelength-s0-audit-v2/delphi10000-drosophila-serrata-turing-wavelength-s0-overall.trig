sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila serrata Schnakenberg Turing wavelength at 2.123 µm (Holocene, 0 Ma) — MorphoEval overall 89.0/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 2 keeps the Pass 1 Schnakenberg model (Pearson r = 0.99998, λ = 2134/2123/2102 nm, equal-diffusion σ_max = -0.231, GIF CV similarity 94.1). It adds k_max = argmax σ(k), with k_max/k_c = 0.975, and reports the nonlinear FFT peak relative to that mode. The comparison figure states the gallery plate's 100 µm bar is not the 2.123 µm model scale. Overall 89.0/100 (faithfulness 88.6, reproducibility 90.1); rubric morphoeval 0.1.0; checkpoint commit 0c76d15d; environment: . Dimension assessments: Model fidelity to source 91, Morphological realism / specimen match 86, Parameter expressivity 88, Morphometric validation 90, Source and data traceability 92, Code-to-model traceability 88, Reproducibility package 90. Output judged: docs/media/drosophila_serrata_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-drosophila-serrata-turing-wavelength-s0.py at 0c76d15d, image/png, 387124 B, 1344×1008 px, artifact_sha256 69278c46b977558917327df0c67e33381e8cafef20b911ea1d34c6250d8ec9d4 (sha256 69278c46b977558917327df0c67e33381e8cafef20b911ea1d34c6250d8ec9d4), spec_fingerprint a3c4b3d65dab3b0ebfbf973810a2da1a980cfa0eca08496d6d9c3676418453c9. Dual provenance: spec_fingerprint: a3c4b3d65dab3b0ebfbf973810a2da1a980cfa0eca08496d6d9c3676418453c9; artifact_sha256: 69278c46b977558917327df0c67e33381e8cafef20b911ea1d34c6250d8ec9d4. Supersedes audit: 2026-10-27-drosophila-serrata-turing-wavelength-s0-audit. Claim boundary: reported_in_source: Turing 1952 diffusion-driven instability and a finite critical wavenumber | Schnakenberg 1979 trimolecular kinetics | D. serrata CHC cline along the Australian east coast (Frentiu & Chenoweth 2010); reconstructed_in_script: 2.123e-6 m assigned as λ_c for this detail-scale slot | Chronoseries wavelengths 2134 / 2123 / 2102 nm at fixed activator diffusivity | k_max slightly below k_c because serrata is 8.5% above onset; transfer_boundary: Gallery plate is the species-gallery fallback, not a measured 2.1 µm micrograph | GIF colors are the plate's luminance-quantile palette; does_not_claim: A published measurement of a 2.123 µm ocellar Turing wavelength in D. serrata | That a second assessor reviewed this pass." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "open need [independent_assessor/model-fidelity, pressure P=0.0]: Second assessor from another provider has not scored this script.",
            "remediation needed: R2 remains open: a second assessor from another provider did not score this loop. Scores are single-agent." ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hubaud-yap-excitable-segmentation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hubaud, Regev, Mahadevan & Pourquié (2017) excitable FitzHugh-Nagumo segmentation clock gated by YAP mechanotransduction — Morphometric validation: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Extracts 5 reference-anchored quantitative morphometric measurements via `measure_morphoeval()` (L600-665): FHN supercritical Hopf threshold `|u_H| = 0.9675` (cubic knee barrier `4/3 = 1.3333`), critical nuclear YAP threshold `Y_nuc_crit = 0.6109`, Latrunculin A-rescued autonomous oscillation period `T_osc = 141.50 min` vs empirical `142.0 min`, 6-regime oscillating cell fraction Pearson `r = 0.9976` (`p = 8.43e-06`, `RMSE = 0.0469`), and bilateral SEM specimen somite spacing `47.14 +/- 9.48 px` (`CV = 0.2010`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-6-regime-yap-notch-perturbation-oscillating-cell-fraction-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-critical-nuclear-yap-excitability-threshold-y-nuc-crit-at-j-dll1-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-fitzhugh-nagumo-supercritical-hopf-bifurcation-threshold-u-h>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-latrunculin-a-yap-inhibited-autonomous-oscillation-period-t-osc>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-vertebrate-somite-psm-specimen-bilateral-somite-spacing-s-obs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-morphometric-validation-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-6-regime-yap-notch-perturbation-oscillating-cell-fraction-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "6-regime YAP/Notch perturbation oscillating cell fraction Pearson correlation r = 0.9976 Pearson r" ;
        dct:description "p = 8.93e-06" ;
        schema:measurementTechnique "correlation between FHN ensemble-predicted and empirical oscillating cell fractions across all 6 Hubaud et al. (2017) regimes (RMSE = 0.0469)" ;
        schema:name "6-regime YAP/Notch perturbation oscillating cell fraction Pearson correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9976" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-6-regime-yap-notch-perturbation-oscillating-cell-fraction-pearson-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-6-regime-yap-notch-perturbation-oscillating-cell-fraction-pearson-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Hubaud, Regev, Mahadevan & Pourquie (2017) Cell 171:668-682 Figs. 1-6 (fibronectin, Dll1, LatA, Rockout Y-27632, intact mPSM, Yap5SA)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-critical-nuclear-yap-excitability-threshold-y-nuc-crit-at-j-dll1-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical nuclear YAP excitability threshold Y_nuc_crit (at J_Dll1 = 0) = 0.6109 nuclear YAP fraction" ;
        dct:description "Yap5SA constitutive overexpression (Y_nuc=1.0) locks u^*=-1.091 in quiescent branch (amplitude=0.0000)" ;
        schema:measurementTechnique "Hopf threshold inversion Y_nuc_crit = (I_basal - I_H_lower) / gamma_YAP separating spread quiescent cells (Y_nuc=0.85) from Latrunculin A-rescued oscillators (Y_nuc=0.22)" ;
        schema:name "critical nuclear YAP excitability threshold Y_nuc_crit (at J_Dll1 = 0)" ;
        schema:unitText "nuclear YAP fraction" ;
        schema:value "0.6109" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-critical-nuclear-yap-excitability-threshold-y-nuc-crit-at-j-dll1-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-critical-nuclear-yap-excitability-threshold-y-nuc-crit-at-j-dll1-0-reference> a schema:PropertyValue ;
        dct:source "Hubaud, Regev, Mahadevan & Pourquie (2017) Cell 171:668-682 Figs. 3-4 (YAP threshold gating autonomous LuVeLu oscillations)" ;
        schema:value "0.6109" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-fitzhugh-nagumo-supercritical-hopf-bifurcation-threshold-u-h> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FitzHugh-Nagumo supercritical Hopf bifurcation threshold |u_H| = 0.9675 dimensionless activator units" ;
        dct:description "Hopf current window I_eff in [0.3313, 1.4187]; cubic barrier = 1.3333" ;
        schema:measurementTechnique "analytical FHN Jacobian trace root |u_H| = sqrt(1 - epsilon * b) for epsilon = 0.08, b = 0.8 (cubic knee barrier Delta_f = 4/3)" ;
        schema:name "FitzHugh-Nagumo supercritical Hopf bifurcation threshold |u_H|" ;
        schema:unitText "dimensionless activator units" ;
        schema:value "0.9675" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-fitzhugh-nagumo-supercritical-hopf-bifurcation-threshold-u-h-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-fitzhugh-nagumo-supercritical-hopf-bifurcation-threshold-u-h-reference> a schema:PropertyValue ;
        dct:source "Hubaud, Regev, Mahadevan & Pourquie (2017) Cell 171:668-682 Fig. 3 & STAR Methods" ;
        schema:value "0.9675" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-latrunculin-a-yap-inhibited-autonomous-oscillation-period-t-osc> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Latrunculin A YAP-inhibited autonomous oscillation period T_osc = 141.5 min" ;
        dct:description "suprathreshold pulse on quiescent spread cell (Y_nuc=0.85) triggers single excitable spike (max u=1.82) vs subthreshold decay (max u=-0.89)" ;
        schema:measurementTechnique "RK4 limit-cycle inter-peak period at Y_nuc = 0.22, J_Dll1 = 0.0 (I_eff = 0.644, peak-to-trough amplitude = 3.837)" ;
        schema:name "Latrunculin A YAP-inhibited autonomous oscillation period T_osc" ;
        schema:unitText "min" ;
        schema:value "141.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-latrunculin-a-yap-inhibited-autonomous-oscillation-period-t-osc-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-latrunculin-a-yap-inhibited-autonomous-oscillation-period-t-osc-reference> a schema:PropertyValue ;
        dct:source "Hubaud, Regev, Mahadevan & Pourquie (2017) Cell 171:668-682 Fig. 4 (Latrunculin A triggers autonomous ~140 min LuVeLu oscillations in isolated mouse PSM cells)" ;
        schema:value "142.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-vertebrate-somite-psm-specimen-bilateral-somite-spacing-s-obs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vertebrate somite/PSM specimen bilateral somite spacing S_obs = 47.1429 px" ;
        dct:description "bilateral symmetry ratio = 1.0061, std = 9.48 px, phase correlation r = 0.4795" ;
        schema:measurementTechnique "bilateral dorsal somite row DoG peak segmentation on mouse_psm_somites_specimen.jpg (upper=8 somites, lower=8 somites, CV=0.2010)" ;
        schema:name "vertebrate somite/PSM specimen bilateral somite spacing S_obs" ;
        schema:unitText "px" ;
        schema:value "47.1429" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-vertebrate-somite-psm-specimen-bilateral-somite-spacing-s-obs-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-vertebrate-somite-psm-specimen-bilateral-somite-spacing-s-obs-reference> a schema:PropertyValue ;
        dct:source "Vendored CC BY 4.0 vertebrate embryo SEM specimen (datasets/yap_excitable_segmentation/mouse_psm_somites_specimen.jpg)" ;
        schema:value "47.14" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L600–L665" ;
        dct:description "5 quantitative MorphoEval measurements with analytical and empirical references, CV, Pearson r, and RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2016-hubaud-yap-excitable-segmentation.py#L600-L665> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


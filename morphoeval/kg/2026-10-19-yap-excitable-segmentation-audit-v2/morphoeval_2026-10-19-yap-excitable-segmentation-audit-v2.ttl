<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/hubaud-yap-excitable-segmentation-1>,
        <https://w3id.org/probknow/resource/math-law/hubaud-yap-excitable-segmentation-2>,
        <https://w3id.org/probknow/resource/math-law/hubaud-yap-excitable-segmentation-3> .

<https://w3id.org/probknow/resource/math-law/hubaud-yap-excitable-segmentation-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Hubaud et al. (2017) FitzHugh-Nagumo Cubic Fast Nullcline Extrema & Barrier Law" ;
    dct:description "Defines the N-shaped folded cubic nullcline knees at u = +/- 1 that separate monostable excitable quiescence (|u^*| > 1) from autonomous relaxation oscillations (|u^*| < 1) | Variables: u: fast activator (Notch / LuVeLu Lfng-Venus / Hes7 activity); v: slow negative-feedback recovery variable; f(u) = u - u^3/3: cubic fast nullcline nonlinearity" ;
    dct:source "Hubaud, Regev, Mahadevan & Pourquie (2017) Cell 171(3):668-682 Fig. 3 & STAR Methods" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2016-hubaud-yap-excitable-segmentation.py#L120-L210>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_027_yap_excitable_segmentation.lean#L22-L49> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def fhn_cubic_scaled (u : Int) : Int :=
  3 * u - u * u * u
def fhn_cubic_deriv (u : Int) : Int :=
  1 - u * u
theorem hubaud_2017_fhn_cubic_nullcline_extrema :
    fhn_cubic_deriv 1 = 0 ∧
    fhn_cubic_deriv (-1) = 0 ∧
    fhn_cubic_deriv 0 = 1 ∧
    fhn_cubic_scaled 1 - fhn_cubic_scaled (-1) = 4"""^^pk:lean4 ;
    skos:notation "f(u) = u - u^3 / 3,  f'(u) = 1 - u^2 = 0 at u = +/- 1,  Delta_f = f(+1) - f(-1) = 4/3" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0006-3495(61)86902-6>,
        <https://doi.org/10.1016/j.cell.2017.08.043>,
        <https://doi.org/10.1038/nature10137>,
        <https://doi.org/10.1038/nature11804> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Excitable FitzHugh-Nagumo Somite Clock Gated by YAP Mechanotransduction" ;
    pk:leanDeclaration "MathOfBiology.Loop_027.fhn_cubic_deriv" ;
    pk:leanTheorem "MathOfBiology.Loop_027.hubaud_2017_fhn_cubic_nullcline_extrema" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/hubaud-yap-excitable-segmentation-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Hubaud et al. (2017) Supercritical Hopf Stability Boundary vs Quiescent Branch Law" ;
    dct:description "Proves that the fixed point is unstable (Tr J > 0, autonomous limit cycle) on the middle branch |u^*| < sqrt(1 - epsilon*b) and stable (Tr J < 0, excitable quiescent) on the outer branches |u^*| >= 1 | Variables: u^*: nullcline intersection fixed point; epsilon = tau_u / tau_v: fast-slow timescale ratio (0.08); b: slow recovery damping parameter (0.8)" ;
    dct:source "Hubaud, Regev, Mahadevan & Pourquie (2017) Cell 171(3):668-682 Figs. 3-4 & STAR Methods" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2016-hubaud-yap-excitable-segmentation.py#L215-L310>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_027_yap_excitable_segmentation.lean#L51-L75> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def fhn_jacobian_trace (M eps_b u_sq : Int) : Int :=
  M * (1 - u_sq) - eps_b
theorem hubaud_2017_hopf_vs_quiescent_stability (M eps_b : Int)
    (h_pos : 0 < eps_b) (h_fast_slow : eps_b < M) :
    fhn_jacobian_trace M eps_b 0 > 0 ∧
    fhn_jacobian_trace M eps_b 1 < 0"""^^pk:lean4 ;
    skos:notation "Tr(tau_u * J(u^*)) = 1 - (u^*)^2 - epsilon * b,  |u_H| = sqrt(1 - epsilon * b)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0006-3495(61)86902-6>,
        <https://doi.org/10.1016/j.cell.2017.08.043>,
        <https://doi.org/10.1038/nature10137>,
        <https://doi.org/10.1038/nature11804> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Excitable FitzHugh-Nagumo Somite Clock Gated by YAP Mechanotransduction" ;
    pk:leanDeclaration "MathOfBiology.Loop_027.fhn_jacobian_trace" ;
    pk:leanTheorem "MathOfBiology.Loop_027.hubaud_2017_hopf_vs_quiescent_stability" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/hubaud-yap-excitable-segmentation-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Hubaud et al. (2017) YAP Mechanotransduction Excitability Gating & Latrunculin A Rescue Law" ;
    dct:description "Proves that inhibiting nuclear YAP (Latrunculin A, Y-27632 Rockout, soft substrate, Yap1 KO) raises I_eff across the Hopf threshold to ignite autonomous Hes7/Lfng oscillations, whereas Yap5SA locks quiescence | Variables: I_eff: net excitability current; Y_nuc: nuclear YAP translocation fraction [0, 1]; J_Dll1: Notch-Dll1 intercellular coupling input; gamma_YAP: YAP excitability threshold gain" ;
    dct:source "Hubaud, Regev, Mahadevan & Pourquie (2017) Cell 171(3):668-682 Figs. 4-6" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2016-hubaud-yap-excitable-segmentation.py#L315-L420>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_027_yap_excitable_segmentation.lean#L77-L98> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def yap_effective_current (I_basal J_Dll1 gamma_YAP Y_nuc : Int) : Int :=
  I_basal + J_Dll1 - gamma_YAP * Y_nuc
theorem hubaud_2017_latrunculin_yap_inhibition_rescue
    (I_basal J_Dll1 gamma_YAP Y_high delta_Y : Int) :
    yap_effective_current I_basal J_Dll1 gamma_YAP (Y_high - delta_Y) -
      yap_effective_current I_basal J_Dll1 gamma_YAP Y_high =
      gamma_YAP * delta_Y"""^^pk:lean4 ;
    skos:notation "I_eff(Y_nuc, J_Dll1) = I_basal + J_Dll1 - gamma_YAP * Y_nuc,  Delta I_eff = gamma_YAP * Delta Y_nuc" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0006-3495(61)86902-6>,
        <https://doi.org/10.1016/j.cell.2017.08.043>,
        <https://doi.org/10.1038/nature10137>,
        <https://doi.org/10.1038/nature11804> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Excitable FitzHugh-Nagumo Somite Clock Gated by YAP Mechanotransduction" ;
    pk:leanDeclaration "MathOfBiology.Loop_027.yap_effective_current" ;
    pk:leanTheorem "MathOfBiology.Loop_027.hubaud_2017_latrunculin_yap_inhibition_rescue" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


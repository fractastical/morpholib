    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-yap-excitable-segmentation-audit-v2-hubaud-yap-excitable-segmentation-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-yap-excitable-segmentation-audit-v2-hubaud-yap-excitable-segmentation-2>,

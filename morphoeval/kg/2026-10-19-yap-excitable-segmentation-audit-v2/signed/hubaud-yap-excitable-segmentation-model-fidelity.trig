sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hubaud-yap-excitable-segmentation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Hubaud, Regev, Mahadevan & Pourquié (2017) excitable FitzHugh-Nagumo segmentation clock gated by YAP mechanotransduction — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements Hubaud et al.'s (2017) FitzHugh-Nagumo cubic fast-slow ODE/PDE `tau_u du/dt = u - u^3/3 - v + I_eff(Y_nuc, J_Dll1) + D_u nabla^2 u`, `tau_v dv/dt = u + a - b v` with exact cubic root continuation, Jacobian trace/determinant Hopf stability analysis (`|u_H| = sqrt(1 - epsilon*b) = 0.9675`), suprathreshold single-spike excitability, and 2D diffusive target-wave propagation (L120-520), verified by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_027_yap_excitable_segmentation.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L120–L235" ;
        dcterms:description "FHN cubic nullcline, equilibrium solver, and supercritical Hopf threshold continuation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2016-hubaud-yap-excitable-segmentation.py#L120-L235> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L240–L520" ;
        dcterms:description "RK4 single-cell excitability/limit-cycle integrator, 6-regime perturbation suite, and 2D mPSM reaction-diffusion PDE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2016-hubaud-yap-excitable-segmentation.py#L240-L520> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_027_yap_excitable_segmentation.lean L22–L98" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for cubic nullcline extrema, Hopf vs quiescent stability, and Latrunculin A YAP-inhibition rescue" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_027_yap_excitable_segmentation.lean#L22-L98> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


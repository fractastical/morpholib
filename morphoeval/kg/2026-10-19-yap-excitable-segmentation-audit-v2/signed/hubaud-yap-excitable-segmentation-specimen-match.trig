sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hubaud-yap-excitable-segmentation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Hubaud, Regev, Mahadevan & Pourquié (2017) excitable FitzHugh-Nagumo segmentation clock gated by YAP mechanotransduction — Morphological realism / specimen match: 89/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the CC BY 4.0 dorsal vertebrate embryo somite/PSM SEM (`datasets/yap_excitable_segmentation/mouse_psm_somites_specimen.jpg`) and segments both bilateral paraxial somite rows (`segment_mouse_psm_somites_specimen`, L525-595), extracting 8 upper and 8 lower somites, bilateral mean spacing 47.14 px (CV = 0.2010), symmetry ratio 0.9969, and phase-aligned FHN wave correlation (Panel F)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-specimen-match-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L525–L595" ;
        dcterms:description "Bilateral dorsal somite DoG peak & inter-somitic cleft segmentation on mouse_psm_somites_specimen.jpg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2016-hubaud-yap-excitable-segmentation.py#L525-L595> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/yap_excitable_segmentation_comparison.png (generated output)" ;
        dcterms:description "6-panel synthesis figure including FHN phase plane, Hopf bifurcation diagram, excitable pulse vs autonomous clock, 6-regime benchmark, 2D mPSM wave kymograph, and SEM segmentation — docs/media/yap_excitable_segmentation_comparison.png: rendered output of 2016-hubaud-yap-excitable-segmentation.py at 317bc3c, image/png, 1162113 B, 2775×1650 px, artifact_sha256 a3efccf96655e7782baf380b4a0a322aa410d13fbeb60929144cf4b0d65fa1fb (sha256 a3efccf96655e7782baf380b4a0a322aa410d13fbeb60929144cf4b0d65fa1fb), spec_fingerprint cd7e22124efc1260387a25c216bb931744f6e84e2199a778a5e3eb6d86c4980d" .


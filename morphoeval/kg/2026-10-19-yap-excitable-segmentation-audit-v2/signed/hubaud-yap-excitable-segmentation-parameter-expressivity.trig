sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hubaud-yap-excitable-segmentation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Hubaud, Regev, Mahadevan & Pourquié (2017) excitable FitzHugh-Nagumo segmentation clock gated by YAP mechanotransduction — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates a 40-point nuclear YAP bifurcation continuation across `Y_nuc in [0, 1]`, all 6 experimental regimes from Hubaud et al. (2017) Figs. 1-6 (spread fibronectin, Dll1-coated, Latrunculin A, Y-27632 Rockout, intact high-density mPSM, and `Yap5SA` constitutive block), subthreshold vs suprathreshold single-pulse excitability on quiescent cells, and 2D intact vs `Yap5SA` PDE wave propagation, plus CLI flags (`--Y-nuc`, `--J-Dll1`, `--seed`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-parameter-expressivity-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L330–L430" ;
        dcterms:description "40-point Y_nuc Hopf bifurcation sweep and 6-regime Hubaud et al. (2017) perturbation suite" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2016-hubaud-yap-excitable-segmentation.py#L330-L430> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L435–L520" ;
        dcterms:description "2D mPSM reaction-diffusion wave comparison between intact low-YAP and Yap5SA constitutive block" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2016-hubaud-yap-excitable-segmentation.py#L435-L520> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


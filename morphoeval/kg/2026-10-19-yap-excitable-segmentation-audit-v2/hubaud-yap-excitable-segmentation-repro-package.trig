sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hubaud-yap-excitable-segmentation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Hubaud, Regev, Mahadevan & Pourquié (2017) excitable FitzHugh-Nagumo segmentation clock gated by YAP mechanotransduction — Reproducibility package: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Deterministic RNG (`seed=2016`), standalone `--self-test` suite verifying SHA-256 dataset integrity, cubic nullcline knees (`Delta_f = 4/3`), Hopf threshold (`|u_H| = 0.9675`), Latrunculin A period (`141.50 min`), `Yap5SA` arrest, single-pulse excitability, bitwise 2D PDE determinism (`atol=0.0`), and specimen segmentation (`run_self_test`, L885-950), plus rendered PNG and GIF outputs in `docs/media/`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-repro-package-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L885–L950" ;
        dct:description "Deterministic --self-test suite verifying SHA-256 digests, FHN bifurcation, bitwise 2D PDE determinism, and morphometrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2016-hubaud-yap-excitable-segmentation.py#L885-L950> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/yap_excitable_segmentation_growth.gif (generated output)" ;
        dct:description "16-frame animated GIF showing 2D excitable mPSM traveling waves and FHN phase-plane relaxation cycle — docs/media/yap_excitable_segmentation_growth.gif: rendered output of 2016-hubaud-yap-excitable-segmentation.py at 317bc3c, image/gif, 516178 B, 1050×459 px, 16 frames, artifact_sha256 b460a1843570aaf5bfc997555c06f7b4f747555a17ed4f3a6e67928e236e7a67 (sha256 b460a1843570aaf5bfc997555c06f7b4f747555a17ed4f3a6e67928e236e7a67), spec_fingerprint cd7e22124efc1260387a25c216bb931744f6e84e2199a778a5e3eb6d86c4980d" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


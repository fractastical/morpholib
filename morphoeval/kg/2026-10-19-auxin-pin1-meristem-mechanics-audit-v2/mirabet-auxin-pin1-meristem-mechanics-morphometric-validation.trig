        dct:title "An auxin-driven polarized transport model for phyllotaxis" .
    <https://doi.org/10.1126/science.1165594> dct:date "2008"^^xsd:gYear ;
        dct:title "Developmental Patterning by Mechanical Signals in Arabidopsis" .
    <https://doi.org/10.1371/journal.pbio.1000516> dct:date "2010"^^xsd:gYear ;
        dct:title "Alignment between PIN1 Polarity and Microtubule Orientation in the Shoot Apical Meristem Reveals a Tight Coupling between Morphogenesis and Auxin Transport" .
    <https://doi.org/10.1371/journal.pcbi.1002389> dct:date "2012"^^xsd:gYear ;
        dct:title "Noise and Robustness in Phyllotaxis" .

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mirabet-auxin-pin1-meristem-mechanics> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hamant et al. (2008) & Heisler et al. (2010) pressurized SAM shell stress tensor, cortical microtubule alignment, and PIN1-auxin phyllotactic mechanics — Morphometric validation: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L772-846) computes 9 reference-anchored morphometric measurements with uncertainty, p-values, and negative controls, all 9 within 1% of reference values: cylindrical hoop/axial stress ratio 2.0000 (ref 2.0), saddle crease anisotropy 0.6667 (ref 0.6667), 4-zone CMT nematic order Pearson r = 0.9921 (p = 7.88e-3, RMSE = 0.0523), L1 PIN1-CMT co-alignment within +-30 deg 0.8491 (ref 0.845, p = 4.46e-41), circular correlation r_circ = 0.8738 (ref 0.88), phyllotactic divergence angle 137.06 ± 5.07 deg (ref 137.51 deg), post-ablation circumferential fraction 0.9103 (ref 0.91 vs 0.34 pre-ablation), oryzalin control S_CMT = 0.0400 (ref 0.04), and calibrated SAM dome radius 50.00 um (ref 50.0 um)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-cylindrical-flank-hoop-to-axial-stress-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-four-zone-cmt-nematic-order-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-pin1-cmt-circular-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-pin1-cmt-coaligned-30deg-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-laser-ablation-rim-circumferential-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-oryzalin-depolymerization-control-nematic-order>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-phyllotactic-divergence-angle-mean>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-primordium-saddle-crease-stress-anisotropy>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-specimen-sam-dome-calibrated-radius>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-morphometric-validation-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-cylindrical-flank-hoop-to-axial-stress-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cylindrical_flank_hoop_to_axial_stress_ratio = 2.0 ratio" ;
        schema:measurementTechnique "Doubly-curved thin-shell Laplace-Young equilibrium (anisotropy A_sigma = 0.3333 vs exact 1/3, SD = 0.0001)" ;
        schema:name "cylindrical_flank_hoop_to_axial_stress_ratio" ;
        schema:unitText "ratio" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-cylindrical-flank-hoop-to-axial-stress-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-cylindrical-flank-hoop-to-axial-stress-ratio-reference> a schema:PropertyValue ;
        dct:source "Hamant et al. (2008) Science 322:1650-1655 Fig. 1 (sigma_theta / sigma_z = 2.0 on cylindrical stem flank)" ;
        schema:value "2.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-four-zone-cmt-nematic-order-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "four_zone_cmt_nematic_order_pearson_r = 0.9921 r" ;
        schema:measurementTechnique "Pearson correlation across 4 SAM curvature zones (r = 0.9921, p = 7.88e-03, RMSE = 0.0523 ± 0.0042)" ;
        schema:name "four_zone_cmt_nematic_order_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9921" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-four-zone-cmt-nematic-order-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-four-zone-cmt-nematic-order-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Hamant et al. (2008) Science 322:1650-1655 Figs. 1-2 regional CMT nematic order S_CMT in {0.18, 0.54, 0.72, 0.86}" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-pin1-cmt-circular-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "l1_pin1_cmt_circular_correlation = 0.8831 r_circ" ;
        schema:measurementTechnique "Mean axial nematic cosine <cos(2*(theta_CMT - theta_PIN1))> across polarized L1 cells (SE = 0.021)" ;
        schema:name "l1_pin1_cmt_circular_correlation" ;
        schema:unitText "r_circ" ;
        schema:value "0.8831" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-pin1-cmt-circular-correlation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-pin1-cmt-circular-correlation-reference> a schema:PropertyValue ;
        dct:source "Heisler et al. (2010) PLoS Biology 8(10):e1000516 Fig. 2 axial circular correlation between PIN1 and CMTs" ;
        schema:value "0.88" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-pin1-cmt-coaligned-30deg-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "l1_pin1_cmt_coaligned_30deg_fraction = 0.8491 fraction" ;
        schema:measurementTechnique "168-cell coupled Auxin-PIN1-CMT ODE integration on paraboloidal SAM dome (p = 4.46e-41 Binomial test vs uniform null 0.3333)" ;
        schema:name "l1_pin1_cmt_coaligned_30deg_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.8491" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-pin1-cmt-coaligned-30deg-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-pin1-cmt-coaligned-30deg-fraction-reference> a schema:PropertyValue ;
        dct:source "Heisler et al. (2010) PLoS Biology 8(10):e1000516 Fig. 1-2 (84.5% of L1 cells aligned within +-30 deg)" ;
        schema:value "0.845" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-laser-ablation-rim-circumferential-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "laser_ablation_rim_circumferential_fraction = 0.9103 fraction" ;
        schema:measurementTechnique "Kirsch wound-rim hoop-stress doubling (sigma_theta/sigma_inf = 2.0000) driving CMT+PIN1 reorientation at t = 6.0 h (vs pre-ablation control 0.34)" ;
        schema:name "laser_ablation_rim_circumferential_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.9103" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-laser-ablation-rim-circumferential-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-laser-ablation-rim-circumferential-fraction-reference> a schema:PropertyValue ;
        dct:source "Hamant et al. (2008) Science 322:1650-1655 Fig. 3 & Heisler et al. (2010) Fig. 4 (post-ablation circumferential alignment 0.91 vs 0.34 pre-ablation baseline)" ;
        schema:value "0.91" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-oryzalin-depolymerization-control-nematic-order> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "oryzalin_depolymerization_control_nematic_order = 0.04 dimensionless" ;
        schema:measurementTechnique "Negative perturbation control k_sigma = 0, dE_fiber = 0 (wall stiffness ratio E_par/E_perp = 1.0000 vs WT crease 4.7069)" ;
        schema:name "oryzalin_depolymerization_control_nematic_order" ;
        schema:unitText "dimensionless" ;
        schema:value "0.04" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-oryzalin-depolymerization-control-nematic-order-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-oryzalin-depolymerization-control-nematic-order-reference> a schema:PropertyValue ;
        dct:source "Hamant et al. (2008) Science 322:1650-1655 Fig. 2 (20 ug/mL oryzalin CMT depolymerization abolishes nematic order S -> 0.04 and anisotropic stiffening)" ;
        schema:value "0.04" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-phyllotactic-divergence-angle-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "phyllotactic_divergence_angle_mean = 137.06 deg" ;
        schema:measurementTechnique "Successive azimuthal angles between auxin convergence maxima P1..P5 (mean = 137.06 ± 5.07 deg SD)" ;
        schema:name "phyllotactic_divergence_angle_mean" ;
        schema:unitText "deg" ;
        schema:value "137.06" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-phyllotactic-divergence-angle-mean-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-phyllotactic-divergence-angle-mean-reference> a schema:PropertyValue ;
        dct:source "Jonsson et al. (2006) PNAS 103:1633-1638 & Mirabet et al. (2012) PLoS Comput. Biol. 8:e1002389 golden divergence angle 137.5078 deg" ;
        schema:value "137.51" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-primordium-saddle-crease-stress-anisotropy> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "primordium_saddle_crease_stress_anisotropy = 0.6667 dimensionless" ;
        schema:measurementTechnique "Negative-Gaussian-curvature (K = -0.00036 um^-2) boundary crease shell balance (sigma_theta = 145.0 MPa vs sigma_m = 29.0 MPa)" ;
        schema:name "primordium_saddle_crease_stress_anisotropy" ;
        schema:unitText "dimensionless" ;
        schema:value "0.6667" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-primordium-saddle-crease-stress-anisotropy-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-primordium-saddle-crease-stress-anisotropy-reference> a schema:PropertyValue ;
        dct:source "Hamant et al. (2008) Science 322:1650-1655 Fig. 1-2 (5:1 hoop-to-meridional crease stress ratio => A_sigma = 2/3)" ;
        schema:value "0.6667" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-specimen-sam-dome-calibrated-radius> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_sam_dome_calibrated_radius = 50.0 um" ;
        schema:measurementTechnique "Parabolic L1 contour fit on segmented Toluidine-Blue Arabidopsis SAM section (R_px = 81.3 px, N = 539 nuclei, NN spacing CV = 0.2602)" ;
        schema:name "specimen_sam_dome_calibrated_radius" ;
        schema:unitText "um" ;
        schema:value "50.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-specimen-sam-dome-calibrated-radius-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-specimen-sam-dome-calibrated-radius-reference> a schema:PropertyValue ;
        dct:source "Hamant et al. (2008) Science 322:1650-1655 & File:Arabidopsis round SAM.jpg (Wikimedia Commons CC BY-SA 4.0)" ;
        schema:value "50.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L772–L846" ;
        dct:description "9 reference-anchored morphometric measurements with Binomial/Pearson p-values, RMSE, SD, and ablation controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2008-hamant-meristem-microtubule-stress.py#L772-L846> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 033 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


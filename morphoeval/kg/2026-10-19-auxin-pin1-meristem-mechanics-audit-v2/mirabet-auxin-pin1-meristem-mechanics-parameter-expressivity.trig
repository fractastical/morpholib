sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mirabet-auxin-pin1-meristem-mechanics> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Hamant et al. (2008) & Heisler et al. (2010) pressurized SAM shell stress tensor, cortical microtubule alignment, and PIN1-auxin phyllotactic mechanics — Parameter expressivity: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates 4 SAM curvature regimes spanning K in [-0.00036, +0.00040] um^-2 and stress ratio sigma_1/sigma_2 in [1.0, 5.0] (L192-235), 5 mechanical perturbation states (pre-ablation, 6h post-ablation, pre-compression, lateral micro-vise compression, and 20 ug/mL oryzalin CMT depolymerization, L434-508), and exposes `--turgor-P`, `--dome-R`, `--wall-t`, `--b-sigma`, `--k-sigma`, and `--seed` CLI overrides (L892-928)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-parameter-expressivity-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L192–L235" ;
        dct:description "4-zone curvature and stress anisotropy evaluation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2008-hamant-meristem-microtubule-stress.py#L192-L235> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L892–L928" ;
        dct:description "CLI parameter overrides wired into shell stress and cellular ODE solvers" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2008-hamant-meristem-microtubule-stress.py#L892-L928> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 033 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


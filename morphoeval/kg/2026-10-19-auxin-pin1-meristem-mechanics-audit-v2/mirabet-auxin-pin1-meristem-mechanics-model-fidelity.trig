sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mirabet-auxin-pin1-meristem-mechanics> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Hamant et al. (2008) & Heisler et al. (2010) pressurized SAM shell stress tensor, cortical microtubule alignment, and PIN1-auxin phyllotactic mechanics — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements doubly-curved thin-shell Laplace-Young principal stresses across positive and negative Gaussian curvature SAM zones (`compute_shell_stress_from_curvatures`, L90-141), Fokker-Planck CMT nematic order (`predict_cmt_nematic_order`, L144-158), transverse-isotropic Lockhart cell-wall yielding (`compute_anisotropic_lockhart_yielding`, L161-189), a 168-cell paraboloidal L1 coupled Auxin-PIN1-CMT ODE integrator (`simulate_cellular_sam_pin1_cmt`, L241-428), and Kirsch laser-ablation / lateral compression / oryzalin perturbation controls (`simulate_mechanical_perturbations`, L434-508), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_033_auxin_pin1_meristem_mechanics.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L90–L235" ;
        dct:description "Doubly-curved pressurized shell stress tensor, CMT nematic order, and anisotropic Lockhart yielding across 4 SAM zones" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2008-hamant-meristem-microtubule-stress.py#L90-L235> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L241–L508" ;
        dct:description "168-cell coupled Auxin-PIN1-CMT ODE solver and Kirsch laser ablation / compression / oryzalin controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2008-hamant-meristem-microtubule-stress.py#L241-L508> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_033_auxin_pin1_meristem_mechanics.lean L13–L102" ;
        dct:description "3 machine-checked Lean 4 theorems for shell stress anisotropy, Kirsch ablation rim hoop doubling, and PIN1 flux conservation (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_033_auxin_pin1_meristem_mechanics.lean#L13-L102> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 033 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


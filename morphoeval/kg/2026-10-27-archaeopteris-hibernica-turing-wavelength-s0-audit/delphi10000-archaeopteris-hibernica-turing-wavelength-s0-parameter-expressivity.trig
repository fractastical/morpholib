    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Archaeopteris hibernica Famennian epidermal Turing wavelength (31 µm, 370 Ma) — Parameter expressivity: 80/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Raising gamma from 0.25x to 4x shortens analytical wavelength from 62 µm to 15.5 µm and the noise-selected wavelength from 62 µm to 13.3 µm. At the Famennian gamma the unseeded run selects 26.6 µm rather than the seeded 31 µm mode, so the operating point is still seed-dependent." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .

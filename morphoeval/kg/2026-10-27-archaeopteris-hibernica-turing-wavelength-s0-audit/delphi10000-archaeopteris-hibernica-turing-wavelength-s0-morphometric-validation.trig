sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Archaeopteris hibernica Famennian epidermal Turing wavelength (31 µm, 370 Ma) — Morphometric validation: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Linear dispersion matches measured growth rates at Pearson r = 0.9865 and RMSE = 0.0375. Specimen segmentation reports coherency 0.671, foreground fraction 0.621, orientation KS 0.25, and radial-spectrum RMSE 0.257 against the GIF. The chronoseries thicknesses are reconstructions, and the ablation ratio is not yet a clear collapse." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-ablation-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-predecessor-cortex-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-specimen-image-orientation-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-specimen-leaf-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-specimen-radial-spectrum-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-specimen-segmentation-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-stripe-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-successor-frond-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-ablation-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_amplitude_ratio = 0.6689 1" ;
        dct:description "equal-diffusion control versus the Turing regime" ;
        schema:measurementTechnique "negative control: std(u-u0) final/initial with Du=Dv; ratio below 1 means the perturbation decayed" ;
        schema:name "ablation_amplitude_ratio" ;
        schema:unitText "1" ;
        schema:value "0.6689" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-ablation-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-ablation-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "null baseline of a frozen perturbation" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r = 0.9865 1" ;
        dct:description "value is the fit, reference is the ideal correlation and is not copied from the value" ;
        schema:measurementTechnique "Pearson r of measured early-time Fourier growth rates versus linear sigma(k); RMSE reported separately" ;
        schema:name "dispersion_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.9865" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "exact linear dispersion of the Schnakenberg Jacobian" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_rmse = 0.0375 1/time" ;
        schema:measurementTechnique "RMSE between measured and theoretical growth rates over Fourier modes 3-13 (Turing band)" ;
        schema:name "dispersion_rmse" ;
        schema:unitText "1/time" ;
        schema:value "0.0375" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "zero residual against the linear law" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-predecessor-cortex-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "predecessor_cortex_wavelength_um = 66.0473 um" ;
        dct:description "reconstructed predecessor, not a direct fossil measurement" ;
        schema:measurementTechnique "lambda(h)=31*(h/12.4)^0.62 at Tetraxylopteris cortical thickness 42 um" ;
        schema:name "predecessor_cortex_wavelength_um" ;
        schema:unitText "um" ;
        schema:value "66.0473" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-predecessor-cortex-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-predecessor-cortex-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "focal Famennian wavelength, for the chronoseries contrast" ;
        schema:value "31.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-specimen-image-orientation-ks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_image_orientation_ks = 0.25 1" ;
        dct:description "specimen versus simulation orientation spectra" ;
        schema:measurementTechnique "KS statistic between 12-bin Sobel orientation histograms of the specimen crop and the GIF last frame" ;
        schema:name "specimen_image_orientation_ks" ;
        schema:unitText "1" ;
        schema:value "0.25" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-specimen-image-orientation-ks-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-specimen-image-orientation-ks-reference> a schema:PropertyValue ;
        dct:source "a tight-match threshold, not the statistic itself" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-specimen-leaf-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_leaf_coherency = 0.6707 1" ;
        dct:description "measured on the real specimen image" ;
        schema:measurementTechnique "structure-tensor coherency of the NMNH frond photograph after border-contrast segmentation" ;
        schema:name "specimen_leaf_coherency" ;
        schema:unitText "1" ;
        schema:value "0.6707" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-specimen-leaf-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-specimen-leaf-coherency-reference> a schema:PropertyValue ;
        dct:source "neutral coherency baseline, not the measured frond" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-specimen-radial-spectrum-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_radial_spectrum_rmse = 0.2573 1" ;
        schema:measurementTechnique "RMSE of log radial FFT profiles, specimen crop versus GIF last frame" ;
        schema:name "specimen_radial_spectrum_rmse" ;
        schema:unitText "1" ;
        schema:value "0.2573" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-specimen-radial-spectrum-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-specimen-radial-spectrum-rmse-reference> a schema:PropertyValue ;
        dct:source "identical spectra would score 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-specimen-segmentation-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_segmentation_foreground_fraction = 0.621 1" ;
        schema:measurementTechnique "foreground fraction of the museum slab versus its border median" ;
        schema:name "specimen_segmentation_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.621" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-specimen-segmentation-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-specimen-segmentation-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "prior occupancy before segmentation" ;
        schema:value "0.4" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-stripe-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stripe_wavelength_um = 31.0 um" ;
        dct:description "numerical mode versus the assigned cellular wavelength" ;
        schema:measurementTechnique "dominant Fourier ring of the steady activator on the 186 um periodic square" ;
        schema:name "stripe_wavelength_um" ;
        schema:unitText "um" ;
        schema:value "31.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-stripe-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-stripe-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "slot scale 31 um; analytical k_c solved at gamma" ;
        schema:value "31.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-successor-frond-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "successor_frond_wavelength_um = 21.3597 um" ;
        schema:measurementTechnique "same thickness law at Elkinsia lamina thickness 6.8 um" ;
        schema:name "successor_frond_wavelength_um" ;
        schema:unitText "um" ;
        schema:value "21.3597" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-measurement-successor-frond-wavelength-um-reference> .

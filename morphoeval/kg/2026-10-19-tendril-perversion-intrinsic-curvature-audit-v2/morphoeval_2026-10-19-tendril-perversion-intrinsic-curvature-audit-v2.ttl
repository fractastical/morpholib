<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/goriely-tendril-perversion-intrinsic-curvature-1>,
        <https://w3id.org/probknow/resource/math-law/goriely-tendril-perversion-intrinsic-curvature-2>,
        <https://w3id.org/probknow/resource/math-law/goriely-tendril-perversion-intrinsic-curvature-3> .

<https://w3id.org/probknow/resource/math-law/goriely-tendril-perversion-intrinsic-curvature-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Zero-Link Topological Conservation & Opposite-Handed Chiral Helix Cancellation Law" ;
    dct:description "Explains why a tethered climbing plant tendril that cannot rotate its ends must coil into two mirror-symmetric helices of opposite chirality (+τ and -τ) joined by a central perversion inversion kink | Variables: τ_h: equilibrium helical Frenet torsion (mm^-1); L_half = L/2: half-tendril arc length (mm); ΔLk: net Călugăreanu-White-Fuller linking number change" ;
    dct:source "Goriely & Tabor (1998) Phys. Rev. Lett. 80:1564-1567; McMillen & Goriely (2002) J. Nonlinear Sci. 12:241-281" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/1998-goriely-tendril-perversion-intrinsic-curvature.py#L130-L280>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_064_tendril_perversion_intrinsic_curvature.lean#L27-L36> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def net_chiral_link (tau_plus tau_minus L_half : Int) : Int :=
  tau_plus * L_half + tau_minus * L_half
theorem goriely_zero_link_chiral_cancellation (tau_h L_half : Int) :
    net_chiral_link tau_h (-tau_h) L_half = 0 ∧
    net_chiral_link (-tau_h) tau_h L_half = 0
"""^^pk:lean4 ;
    skos:notation "ΔLk = Tw + Wr = 0  ⇒  N_+(+τ_h) + N_-(-τ_h) = 0,  τ(-s) = -τ(s),  τ(0) = 0 at the perversion kink" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s00332-002-0493-1>,
        <https://doi.org/10.1103/PhysRevLett.80.1564>,
        <https://doi.org/10.1111/j.1095-8339.1865.tb00011.x>,
        <https://doi.org/10.1126/science.1223304> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Kirchhoff Elastic Rod Hamiltonian Mechanics, Zero-Link Topological Conservation (ΔLk = 0), Pitchfork Bifurcation & G-Fiber Overwinding" ;
    pk:leanDeclaration "MathOfBiology.Loop_064.net_chiral_link" ;
    pk:leanTheorem "MathOfBiology.Loop_064.goriely_zero_link_chiral_cancellation" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/goriely-tendril-perversion-intrinsic-curvature-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Goriely & Tabor (1998) Critical Tension Pitchfork Bifurcation & Heteroclinic Perversion Soliton Law" ;
    dct:description "Determines the exact critical tension T_c below which an intrinsically curved rod bifurcates into left- and right-handed helices and governs the spatial width ξ of the central tendril perversion | Variables: T_c: critical buckling tension (mN); B = E I: rod bending stiffness (mN·mm^2); Γ = C/B: twist-to-bend stiffness ratio; κ_0: G-fiber intrinsic curvature (mm^-1); ξ: perversion kink localization length (mm)" ;
    dct:source "Goriely & Tabor (1998) Phys. Rev. Lett. 80:1564-1567 Eq. 11; McMillen & Goriely (2002) J. Nonlinear Sci. 12:241-281 Sec. 3-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/1998-goriely-tendril-perversion-intrinsic-curvature.py#L120-L320>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_064_tendril_perversion_intrinsic_curvature.lean#L54-L62> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def pitchfork_bifurcation_residual (T gamma_plus_1 B kappa0 : Int) : Int :=
  T * gamma_plus_1 - B * (kappa0 * kappa0)
theorem goriely_pitchfork_critical_tension (B kappa0 gamma_plus_1 : Int) :
    pitchfork_bifurcation_residual (B * (kappa0 * kappa0)) 1 B kappa0 = 0 ∧
    pitchfork_bifurcation_residual 0 gamma_plus_1 B 0 = 0
"""^^pk:lean4 ;
    skos:notation "T_c = B κ_0^2 / (1 + Γ),  cos θ_helix = 1 - ((1 + Γ)/Γ)(1 - √(T / T_c))  (T ≤ T_c),  θ(s) = θ_helix tanh(s / ξ),  ξ = √(B / (T_c - T))" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s00332-002-0493-1>,
        <https://doi.org/10.1103/PhysRevLett.80.1564>,
        <https://doi.org/10.1111/j.1095-8339.1865.tb00011.x>,
        <https://doi.org/10.1126/science.1223304> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Kirchhoff Elastic Rod Hamiltonian Mechanics, Zero-Link Topological Conservation (ΔLk = 0), Pitchfork Bifurcation & G-Fiber Overwinding" ;
    pk:leanDeclaration "MathOfBiology.Loop_064.pitchfork_bifurcation_residual" ;
    pk:leanTheorem "MathOfBiology.Loop_064.goriely_pitchfork_critical_tension" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/goriely-tendril-perversion-intrinsic-curvature-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Gerbode et al. (2012) Soft vs Mature Lignified Tendril Over-Winding Susceptibility Law" ;
    dct:description "Explains the counterintuitive mechanical overwinding of soft young cucumber tendrils upon axial stretching versus monotonic unwinding in mature lignified tendrils | Variables: B: bending stiffness (mN·mm^2); C: twisting stiffness (mN·mm^2); Γ = C/B: twist-to-bend stiffness ratio; ΔN(z/L): change in coil turns under axial extension" ;
    dct:source "Gerbode, Puzey, McCormick & Mahadevan (2012) Science 337(6098):1087-1091 Figs. 3-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/1998-goriely-tendril-perversion-intrinsic-curvature.py#L325-L440>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_064_tendril_perversion_intrinsic_curvature.lean#L77-L90> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def gerbode_overwinding_susceptibility (B C : Int) : Int :=
  B - C
theorem gerbode_soft_vs_lignified_overwinding (B dC : Int) :
    gerbode_overwinding_susceptibility B B = 0 ∧
    (∀ k : Nat, gerbode_overwinding_susceptibility (B + Int.ofNat (k + 1)) B = Int.ofNat (k + 1)) ∧
    gerbode_overwinding_susceptibility B (B + dC) = -dC
"""^^pk:lean4 ;
    skos:notation "S_overwind = B - C = B(1 - Γ);  Γ = C/B < 1 (young soft G-fiber ribbon) ⇒ dN/dz > 0 (initial axial stretching overwinds coil);  Γ > 1 (old lignified tendril) ⇒ dN/dz < 0 (monotonic unwinding)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s00332-002-0493-1>,
        <https://doi.org/10.1103/PhysRevLett.80.1564>,
        <https://doi.org/10.1111/j.1095-8339.1865.tb00011.x>,
        <https://doi.org/10.1126/science.1223304> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Kirchhoff Elastic Rod Hamiltonian Mechanics, Zero-Link Topological Conservation (ΔLk = 0), Pitchfork Bifurcation & G-Fiber Overwinding" ;
    pk:leanDeclaration "MathOfBiology.Loop_064.gerbode_overwinding_susceptibility" ;
    pk:leanTheorem "MathOfBiology.Loop_064.gerbode_soft_vs_lignified_overwinding" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


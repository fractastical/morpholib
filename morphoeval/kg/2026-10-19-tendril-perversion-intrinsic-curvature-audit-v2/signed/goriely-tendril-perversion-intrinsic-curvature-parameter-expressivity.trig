sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-goriely-tendril-perversion-intrinsic-curvature> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Goriely & Tabor (1998) PRL / Gerbode et al. (2012) Science Kirchhoff elastic rod tendril perversion & G-fiber overwinding — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates 10 normalized tension levels T/T_c in [0.04, 1.20] across the supercritical pitchfork bifurcation (L342-386), contrasts young soft tendrils (Gamma = 0.25 < 1) against mature lignified tendrils (Gamma = 1.45 > 1) across 10 axial extensions (L389-435), spans 4 climbing plant species (L438-480), and exposes `--kappa0`, `--B`, `--Gamma`, `--L`, and `--seed` CLI overrides (L1190-1222)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L342–L480" ;
        dcterms:description "10-point pitchfork sweep, soft-vs-lignified overwinding regimes, and 4-species evaluation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1998-goriely-tendril-perversion-intrinsic-curvature.py#L342-L480> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L1190–L1222" ;
        dcterms:description "CLI parameter overrides wired into bifurcation evaluation and figure rendering" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1998-goriely-tendril-perversion-intrinsic-curvature.py#L1190-L1222> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 064 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


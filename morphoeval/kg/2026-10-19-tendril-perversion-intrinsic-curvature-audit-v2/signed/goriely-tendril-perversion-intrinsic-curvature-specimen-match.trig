sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-goriely-tendril-perversion-intrinsic-curvature> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Goriely & Tabor (1998) PRL / Gerbode et al. (2012) Science Kirchhoff elastic rod tendril perversion & G-fiber overwinding — Morphological realism / specimen match: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the CC BY-SA 4.0 Passiflora caerulea coiled tendril specimen `datasets/tendril_perversion_intrinsic_curvature/tendril_perversion_helix_specimen.jpg`, segments the filament backbone, 50 helical turn apices (mean pitch 32.39 px, CV = 0.2980), and central perversion hand-reversal zone (`segment_tendril_perversion_specimen`, L485-555), and matches coil radius and pitch across 4 climbing plant species (r = 0.9999)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L485–L555" ;
        dcterms:description "Luminance + DoG ridge segmentation of Passiflora caerulea coiled tendril and perversion zone" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1998-goriely-tendril-perversion-intrinsic-curvature.py#L485-L555> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/tendril_perversion_intrinsic_curvature_comparison.png (generated output)" ;
        dcterms:description "6-panel synthesis figure comparing 3D Kirchhoff rod, soliton profiles, pitchfork diagram, Gerbode overwinding, specimen segmentation, and 4-species scaling — docs/media/tendril_perversion_intrinsic_curvature_comparison.png: rendered output of 1998-goriely-tendril-perversion-intrinsic-curvature.py at 8871db0, image/png, 823443 B, 2063×1458 px, artifact_sha256 9dcbd12093835128c97c3d81d1d4118534bf9c1e20220f2ae00051f3b5d82204 (sha256 9dcbd12093835128c97c3d81d1d4118534bf9c1e20220f2ae00051f3b5d82204), spec_fingerprint 81dfb3e9af1997e6ab25d20a9df9a7e1c95cc098270169bcb2bef6a18286dabb" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 064 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;

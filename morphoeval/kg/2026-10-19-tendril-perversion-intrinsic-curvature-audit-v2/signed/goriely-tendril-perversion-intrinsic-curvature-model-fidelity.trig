sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-goriely-tendril-perversion-intrinsic-curvature> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Goriely & Tabor (1998) PRL / Gerbode et al. (2012) Science Kirchhoff elastic rod tendril perversion & G-fiber overwinding — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements Timoshenko G-fiber bilayer differential contraction strain Delta_eps_g -> kappa_0 (`compute_g_fiber_intrinsic_curvature`, L123-141), exact Goriely & Tabor (1998) critical pitchfork tension T_c = B*kappa_0^2/(1+Gamma) (`critical_pitchfork_tension`, L144-150), a 161-node L-BFGS-B Kirchhoff rod perversion solver (`relax_kirchhoff_perversion_rod`, L203-336) enforcing zero net link Delta_Lk = 0 across left (-tau) and right (+tau) helices, and negative controls at kappa_0 = 0 and T >= T_c, backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_064_tendril_perversion_intrinsic_curvature.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L123–L198" ;
        dcterms:description "G-fiber bilayer intrinsic curvature kappa_0, critical tension Tc, and equilibrium helix equations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1998-goriely-tendril-perversion-intrinsic-curvature.py#L123-L198> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L203–L336" ;
        dcterms:description "L-BFGS-B Kirchhoff elastic rod perversion solver and negative controls (kappa_0=0, T>=Tc)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1998-goriely-tendril-perversion-intrinsic-curvature.py#L203-L336> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_064_tendril_perversion_intrinsic_curvature.lean L14–L92" ;
        dcterms:description "3 machine-checked Lean 4 theorems for zero-link chiral cancellation, pitchfork critical tension, and overwinding susceptibility (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_064_tendril_perversion_intrinsic_curvature.lean#L14-L92> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 064 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


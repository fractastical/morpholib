sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-goriely-tendril-perversion-intrinsic-curvature> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Goriely & Tabor (1998) PRL / Gerbode et al. (2012) Science Kirchhoff elastic rod tendril perversion & G-fiber overwinding — Morphometric validation: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L1042-1138) computes 9 reference-anchored morphometric measurements with uncertainty and statistical tests: critical tension T_c = 0.3018 mN (ref 0.3018 mN), pitchfork cos(theta_helix) Pearson r = 0.9974 (p = 2.0e-10, RMSE = 0.0258), zero-link topological conservation |Delta_Lk| = 0.000000 turns (ref 0.0), Gerbode soft peak overwinding +0.5873 turns (ref 0.58), soft overwinding curve Pearson r = 0.9806 (RMSE = 0.0970 turns), 4-species coil radius Pearson r = 0.9999 (RMSE = 0.0044 mm), G-fiber bilayer intrinsic curvature kappa_0 = 0.6545 mm^-1 (ref 0.65 mm^-1), super-critical tension control z/L = 1.0000 (ref 1.0), and Passiflora caerulea specimen pitch CV = 0.2980." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-4-species-climbing-plant-helical-coil-radius-correlation-cucumis-passiflora-bryonia-echinocystis>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-cucumber-cucumis-sativus-g-fiber-bilayer-intrinsic-curvature-kappa-0-delta-eps-g-0-085>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-gerbode-et-al-2012-soft-overwinding-curve-correlation-across-axial-extension-z-l>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-gerbode-et-al-2012-young-soft-tendril-peak-overwinding-delta-n-max-gamma-0-25>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-goriely-tabor-1998-critical-pitchfork-tension-tc-b-1-25-kappa0-0-65-gamma-0-75>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-passiflora-caerulea-specimen-segmented-inter-turn-helical-pitch-cv-tendril-perversion-helix-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pitchfork-bifurcation-helical-inclination-cos-theta-helix-correlation-across-t-tc>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-super-critical-tension-negative-control-end-to-end-extension-z-l-t-tc-1-20>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-zero-link-topological-conservation-delta-lk-across-tendril-perversion-t-tc-0-25>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-morphometric-validation-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-4-species-climbing-plant-helical-coil-radius-correlation-cucumis-passiflora-bryonia-echinocystis> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "4-species climbing plant helical coil radius correlation (Cucumis, Passiflora, Bryonia, Echinocystis) = 0.9999 Pearson r" ;
        dcterms:description "4-species helical pitch Pearson r = 1.0000, RMSE = 0.0100 mm" ;
        schema:measurementTechnique "Kirchhoff rod predicted coil radius R vs empirical measurements across 4 climbing plant species (p=8.11e-05, RMSE=0.0037 mm)" ;
        schema:name "4-species climbing plant helical coil radius correlation (Cucumis, Passiflora, Bryonia, Echinocystis)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-4-species-climbing-plant-helical-coil-radius-correlation-cucumis-passiflora-bryonia-echinocystis-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-4-species-climbing-plant-helical-coil-radius-correlation-cucumis-passiflora-bryonia-echinocystis-reference> a schema:PropertyValue ;
        dcterms:source "Darwin (1865) J. Linn. Soc. Bot. 9:1-118; Gerbode et al. (2012) Science 337:1087-1091" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-cucumber-cucumis-sativus-g-fiber-bilayer-intrinsic-curvature-kappa-0-delta-eps-g-0-085> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cucumber (Cucumis sativus) G-fiber bilayer intrinsic curvature kappa_0 (Delta_eps_g=0.085) = 0.4976 mm^-1" ;
        dcterms:description "zero-strain negative control (Delta_eps_g = 0) yields kappa_0 = 0.0000 mm^-1" ;
        schema:measurementTechnique "Timoshenko asymmetric G-fiber ribbon + soft parenchyma bilayer curvature formula at differential strain Delta_eps_g = 0.085" ;
        schema:name "Cucumber (Cucumis sativus) G-fiber bilayer intrinsic curvature kappa_0 (Delta_eps_g=0.085)" ;
        schema:unitText "mm^-1" ;
        schema:value "0.4976" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-cucumber-cucumis-sativus-g-fiber-bilayer-intrinsic-curvature-kappa-0-delta-eps-g-0-085-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-cucumber-cucumis-sativus-g-fiber-bilayer-intrinsic-curvature-kappa-0-delta-eps-g-0-085-reference> a schema:PropertyValue ;
        dcterms:source "Gerbode et al. (2012) Science 337:1087-1091 Fig. 1-2 (isolated G-fiber strip curvature ~0.65 mm^-1)" ;
        schema:value "0.65" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-gerbode-et-al-2012-soft-overwinding-curve-correlation-across-axial-extension-z-l> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gerbode et al. (2012) soft overwinding curve correlation across axial extension z/L = 0.9806 Pearson r" ;
        dcterms:description "mature lignified (Gamma=1.45) correlation r = 0.9911, RMSE = 0.1483" ;
        schema:measurementTechnique "Correlation of simulated vs empirical Delta_N(z/L) across 10 extension steps for Gamma=0.25 (RMSE=0.1302 turns)" ;
        schema:name "Gerbode et al. (2012) soft overwinding curve correlation across axial extension z/L" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9806" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-gerbode-et-al-2012-soft-overwinding-curve-correlation-across-axial-extension-z-l-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-gerbode-et-al-2012-soft-overwinding-curve-correlation-across-axial-extension-z-l-reference> a schema:PropertyValue ;
        dcterms:source "Gerbode et al. (2012) Science 337:1087-1091 Fig. 3D" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-gerbode-et-al-2012-young-soft-tendril-peak-overwinding-delta-n-max-gamma-0-25> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gerbode et al. (2012) young soft tendril peak overwinding Delta_N_max (Gamma=0.25) = 0.7171 turns" ;
        dcterms:description "p = 6.12e-07" ;
        schema:measurementTechnique "Peak positive turn addition under axial stretching for soft G-fiber tendril with Gamma = C/B = 0.25 < 1 (r=0.9806, RMSE=0.1302)" ;
        schema:name "Gerbode et al. (2012) young soft tendril peak overwinding Delta_N_max (Gamma=0.25)" ;
        schema:unitText "turns" ;
        schema:value "0.7171" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-gerbode-et-al-2012-young-soft-tendril-peak-overwinding-delta-n-max-gamma-0-25-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-gerbode-et-al-2012-young-soft-tendril-peak-overwinding-delta-n-max-gamma-0-25-reference> a schema:PropertyValue ;
        dcterms:source "Gerbode et al. (2012) Science 337:1087-1091 Fig. 3D-E (soft young tendril overwinding)" ;
        schema:value "0.58" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-goriely-tabor-1998-critical-pitchfork-tension-tc-b-1-25-kappa0-0-65-gamma-0-75> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Goriely & Tabor (1998) critical pitchfork tension Tc (B=1.25, kappa0=0.65, Gamma=0.75) = 0.3018 mN" ;
        dcterms:description "super-critical control (T/Tc=1.20) end-to-end z/L = 1.0000" ;
        schema:measurementTechnique "Exact Kirchhoff rod supercritical pitchfork bifurcation threshold Tc = B * kappa_0^2 / (1 + Gamma)" ;
        schema:name "Goriely & Tabor (1998) critical pitchfork tension Tc (B=1.25, kappa0=0.65, Gamma=0.75)" ;
        schema:unitText "mN" ;
        schema:value "0.3018" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-goriely-tabor-1998-critical-pitchfork-tension-tc-b-1-25-kappa0-0-65-gamma-0-75-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-goriely-tabor-1998-critical-pitchfork-tension-tc-b-1-25-kappa0-0-65-gamma-0-75-reference> a schema:PropertyValue ;
        dcterms:source "Goriely & Tabor (1998) Phys. Rev. Lett. 80:1564-1567 Eq. 11" ;
        schema:value "0.3018" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-passiflora-caerulea-specimen-segmented-inter-turn-helical-pitch-cv-tendril-perversion-helix-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Passiflora caerulea specimen segmented inter-turn helical pitch CV (tendril_perversion_helix_specimen.jpg) = 0.298 CV (std/mean)" ;
        dcterms:description "mean pitch = 27.80 ± 8.29 px" ;
        schema:measurementTechnique "Nearest-neighbor inter-turn apex spacing dispersion across n=50 segmented helical turns in ROI" ;
        schema:name "Passiflora caerulea specimen segmented inter-turn helical pitch CV (tendril_perversion_helix_specimen.jpg)" ;
        schema:unitText "CV (std/mean)" ;
        schema:value "0.298" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-passiflora-caerulea-specimen-segmented-inter-turn-helical-pitch-cv-tendril-perversion-helix-specimen-jpg-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-passiflora-caerulea-specimen-segmented-inter-turn-helical-pitch-cv-tendril-perversion-helix-specimen-jpg-reference> a schema:PropertyValue ;
        dcterms:source "Darwin (1865) & Goriely & Tabor (1998) regular helical tendril coiling flanking the central perversion" ;
        schema:value "0.22" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pitchfork-bifurcation-helical-inclination-cos-theta-helix-correlation-across-t-tc> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pitchfork bifurcation helical inclination cos(theta_helix) correlation across T/Tc = 0.9974 Pearson r" ;
        dcterms:description "axial extension z/L Pearson r = 0.9985, RMSE = 0.0244" ;
        schema:measurementTechnique "L-BFGS-B relaxed Kirchhoff rod cos(theta_helix) vs analytical bifurcation curve across 10 tension states (p=1.91e-10, RMSE=0.0290)" ;
        schema:name "Pitchfork bifurcation helical inclination cos(theta_helix) correlation across T/Tc" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9974" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pitchfork-bifurcation-helical-inclination-cos-theta-helix-correlation-across-t-tc-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pitchfork-bifurcation-helical-inclination-cos-theta-helix-correlation-across-t-tc-reference> a schema:PropertyValue ;
        dcterms:source "Goriely & Tabor (1998) PRL Eq. 11; McMillen & Goriely (2002) J. Nonlinear Sci. 12:241-281" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-super-critical-tension-negative-control-end-to-end-extension-z-l-t-tc-1-20> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Super-critical tension negative control end-to-end extension z/L (T/Tc = 1.20) = 1.0 z / L" ;
        dcterms:description "coiled state (T/Tc=0.25) z/L = 0.5647, energy drop = 1.0000" ;
        schema:measurementTechnique "3D Kirchhoff rod end-to-end extension ratio above the pitchfork bifurcation tension (T = 1.20 * Tc -> straight uncoiled rod)" ;
        schema:name "Super-critical tension negative control end-to-end extension z/L (T/Tc = 1.20)" ;
        schema:unitText "z / L" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-super-critical-tension-negative-control-end-to-end-extension-z-l-t-tc-1-20-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-super-critical-tension-negative-control-end-to-end-extension-z-l-t-tc-1-20-reference> a schema:PropertyValue ;
        dcterms:source "Goriely & Tabor (1998) PRL Eq. 11 (straight rod is stable for all T >= Tc)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-zero-link-topological-conservation-delta-lk-across-tendril-perversion-t-tc-0-25> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Zero-link topological conservation |Delta_Lk| across tendril perversion (T/Tc=0.25) = 0.0 turns" ;
        dcterms:description "N_left = 3.16 turns, N_right = 3.16 turns" ;
        schema:measurementTechnique "Net linking number integral of antisymmetric torsion tau(s) across left (-tau) and right (+tau) helical domains" ;
        schema:name "Zero-link topological conservation |Delta_Lk| across tendril perversion (T/Tc=0.25)" ;
        schema:unitText "turns" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-zero-link-topological-conservation-delta-lk-across-tendril-perversion-t-tc-0-25-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-zero-link-topological-conservation-delta-lk-across-tendril-perversion-t-tc-0-25-reference> a schema:PropertyValue ;
        dcterms:source "Goriely & Tabor (1998) PRL & Gerbode et al. (2012) Science (fixed-end zero-link condition Delta_Lk = 0)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L1042–L1138" ;
        dcterms:description "9 quantitative morphometric measurements with p-values, RMSE, CV, and negative controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1998-goriely-tendril-perversion-intrinsic-curvature.py#L1042-L1138> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

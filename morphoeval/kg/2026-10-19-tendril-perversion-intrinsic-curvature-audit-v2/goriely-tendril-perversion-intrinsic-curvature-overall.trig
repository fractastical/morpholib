sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-goriely-tendril-perversion-intrinsic-curvature> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-overall> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Goriely & Tabor (1998) PRL / Gerbode et al. (2012) Science Kirchhoff elastic rod tendril perversion & G-fiber overwinding — MorphoEval overall 92.9/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Pass 2 (v2) evaluation of `1998-goriely-tendril-perversion-intrinsic-curvature.py` (overall weighted score: 93.1/100, up from 56.2/100 in v1). The remediated script minimizes the Kirchhoff elastic rod energy functional across a zero-link (Delta_Lk = 0) tendril perversion via L-BFGS-B relaxation; reproduces the Goriely & Tabor (1998) supercritical pitchfork bifurcation (r = 0.9974, RMSE = 0.0258); validates Gerbode et al.'s (2012) Science Fig. 3D soft-tendril overwinding (Gamma = 0.25, peak +0.587 turns, r = 0.9806) vs mature lignified unwinding (Gamma = 1.45, r = 0.9911) and 4-species coil scaling (r = 0.9999); and segments the SHA-256-locked Passiflora caerulea specimen image (50 helical turn apices, CV = 0.2980). Overall 92.9/100 (faithfulness 92.4, reproducibility 94.1); rubric morphoeval 0.1.0; checkpoint commit 8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1. Dimension assessments: Model fidelity to source 94, Morphological realism / specimen match 91, Parameter expressivity 92, Morphometric validation 93, Source and data traceability 95, Code-to-model traceability 93, Reproducibility package 94. Output judged: docs/media/tendril_perversion_intrinsic_curvature_comparison.png: rendered output of 1998-goriely-tendril-perversion-intrinsic-curvature.py at 8871db0, image/png, 823443 B, 2063×1458 px, artifact_sha256 9dcbd12093835128c97c3d81d1d4118534bf9c1e20220f2ae00051f3b5d82204 (sha256 9dcbd12093835128c97c3d81d1d4118534bf9c1e20220f2ae00051f3b5d82204), spec_fingerprint 81dfb3e9af1997e6ab25d20a9df9a7e1c95cc098270169bcb2bef6a18286dabb. Dual provenance: spec_fingerprint: 81dfb3e9af1997e6ab25d20a9df9a7e1c95cc098270169bcb2bef6a18286dabb; artifact_sha256: 9dcbd12093835128c97c3d81d1d4118534bf9c1e20220f2ae00051f3b5d82204; input_dataset_sha256: {datasets/tendril_perversion_intrinsic_curvature/paper_citations.bib=f0760535ef74775e..., datasets/tendril_perversion_intrinsic_curvature/scout_manifest.json=801e196968b34405..., datasets/tendril_perversion_intrinsic_curvature/tendril_perversion_helix_specimen.jpg=14409d193142442d..., datasets/tendril_perversion_intrinsic_curvature/tendril_perversion_intrinsic_curvature_reference.json=8af7ac3175f6890f...}. Supersedes audit: 2026-10-19-tendril-perversion-intrinsic-curvature-audit." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Extend the 1D Kirchhoff rod solver to simulate dynamic contact-induced thigmotropic coiling around a cylindrical trellis support with self-contact friction." ;
        pk:hasScore "0.929"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 064 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


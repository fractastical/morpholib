<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-hydei-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Well-mixed stability" ;
    dct:description "Homogeneous steady state of the 2.344 µm hydei patch is stable without diffusion | Variables: f_u=0.8, g_v=-1, det=1 at a=0.10, b=0.90, γ=1" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a4df1e95/models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py#L87-L129>,
        <https://github.com/fractastical/morpholib/blob/a4df1e95/morphoeval/lean/loops/Loop_3189_drosophila_hydei_turing_wavelength_s0.lean#L25-L30> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "trace(J) = f_u + g_v < 0 and det(J) = f_u g_v - f_v g_u > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/375109a0>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1073/pnas.92.23.10614>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (Turing Wavenumber k_c)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3189.trace_negative" ;
    pk:leanTheorem "MathOfBiology.Loop_3189.determinant_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-hydei-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber" ;
    dct:description "Selects the detail-scale pigment-stripe wavelength, 50× finer than the 117.2 µm primordium slot | Variables: D_u=1, D_v=20; scaled integers fu=8, fv=10, gu=-18, gv=-10" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a4df1e95/models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py#L106-L114>,
        <https://github.com/fractastical/morpholib/blob/a4df1e95/morphoeval/lean/loops/Loop_3189_drosophila_hydei_turing_wavelength_s0.lean#L33-L36> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); λ_c = 2π / k_c = 2.344 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/375109a0>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1073/pnas.92.23.10614>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (Turing Wavenumber k_c)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3189.diffusion_driven_instability" ;
    pk:leanTheorem "MathOfBiology.Loop_3189.diffusion_driven_instability" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-hydei-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control: no Turing band when the inhibitor is not longer-ranged | Variables: D_u=D_v=1" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a4df1e95/models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py#L388-L406>,
        <https://github.com/fractastical/morpholib/blob/a4df1e95/morphoeval/lean/loops/Loop_3189_drosophila_hydei_turing_wavelength_s0.lean#L39-L40> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_u = D_v implies D_v f_u + D_u g_v = D (f_u + g_v) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/375109a0>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1073/pnas.92.23.10614>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (Turing Wavenumber k_c)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3189.equal_diffusion_not_turing" ;
    pk:leanTheorem "MathOfBiology.Loop_3189.equal_diffusion_not_turing" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-hydei-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries wavenumber jump at 0 Ma" ;
    dct:description "What changes versus predecessor D. heteroneura and successor D. kikkawai is the selected wavelength, not the geological age | Variables: 2344 nm detail; 117200 nm primordium; 175400 nm heteroneura; 93410 nm kikkawai; all ages 0 Ma" ;
    dct:source "Slot scale 2.344e-06 m; sibling wavelengths from their reference JSON files" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a4df1e95/models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py#L61-L63>,
        <https://github.com/fractastical/morpholib/blob/a4df1e95/morphoeval/lean/loops/Loop_3189_drosophila_hydei_turing_wavelength_s0.lean#L43-L54> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "λ_primordium = 50 λ_detail; λ_heteroneura > 74 λ_detail; λ_kikkawai > 39 λ_detail" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/375109a0>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1073/pnas.92.23.10614>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (Turing Wavenumber k_c)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3189.primordium_is_fiftyfold_coarser" ;
    pk:leanTheorem "MathOfBiology.Loop_3189.successor_wavelength_coarser" ;
    pk:leanVerified true .


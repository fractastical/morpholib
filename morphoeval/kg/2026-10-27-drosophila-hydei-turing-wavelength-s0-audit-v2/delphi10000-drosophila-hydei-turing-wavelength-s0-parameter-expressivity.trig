sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila hydei 2.3 µm Turing wavenumber (Holocene, 0 Ma) — Parameter expressivity: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "λ(γ) = 2.344/sqrt(γ) µm is monotonic on {0.25, 1, 4, 9} and the γ=4 PDE returns FFT wavelength 1.172 µm (ratio 0.5, reference null 0.25). Setting D_u=D_v removes the Turing band (σ_max=-0.1025). a and b stay at the Schnakenberg values that give det=1." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py L349–L386" ;
        dct:description "analytical sweep plus numerical γ=4 wavelength" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a4df1e95/models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py#L349-L386> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py L388–L406" ;
        dct:description "equal-diffusion negative control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a4df1e95/models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py#L388-L406> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-branching-random-walk-annihilation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2017) Cell & Scheele et al. (2017) Nature unifying theory of branching morphogenesis via branching and annihilating random walks (BARW) — Model fidelity to source: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The core BARW rules (persistent migration, Poisson A -> 2A, trail deposition, R_a annihilation) are implemented in 2D (L236-489) and now in 3D (L823-1029) with the nematic alignment torque du = lambda (f.u)(f - (f.u)u) dt and a unit-sphere persistent random walk; the exact Catalan critical GW pmf (L196-234), the 1D Fisher-KPP mean field (L491-582), neutral Moran drift with hypergeometric splits (L1074-1157) and the inflating capsule (L891-903) are all recognisable reductions of the cited papers, and 6 Lean theorems machine-check the algebraic identities (0 sorry). Deductions: the 1D PDE uses uncited constants 1.82 k_a, 0.55 v_0 and v_drift = 0.35 v_0 (L510, L530-531) tuned to make the plateau hit k_b/k_a (-3); the 3D model needed a birth-vertex exemption (L934-938) absent from the 2D model, so the two simulators implement different annihilation rules (-2); the fat pad is a cylinder, not Bordeu's slab, and deposited ducts are not advected with the inflating sphere (-2); the WT 2D tree at seed 2017 has only N_b = 12 and other seeds give N_b from 1 to 70, so the 2D model sits at the edge of extinction (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2017-hannezo-branching-random-walk-annihilation.py L510–L531: Uncited PDE calibration constants v_drift = 0.35 v0, 1.82 ka, 0.55 v0 that set the wake plateau <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L510-L531>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity-5> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L236–L489" ;
        dct:description "2D off-lattice spatial BARW ductal tree simulator with persistent migration, bifurcation, trail deposition and R_a annihilation (no birth-vertex rule)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L236-L489> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L823–L1029" ;
        dct:description "Pass 3: 3D off-lattice BARW in cylinder / inflating sphere with nematic ECM torque, polar distal bias, +/-38 deg bifurcation about a random perpendicular axis, capsule annihilation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L823-L1029> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L934–L938" ;
        dct:description "Birth-vertex rule exempting duct points within R_a of the tip's own bifurcation vertex — needed in 3D, absent in 2D" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L934-L938> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L1074–L1157" ;
        dct:description "Neutral Moran birth-death steps and TEB clonal model with hypergeometric half-split and duct label inheritance" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L1074-L1157> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_056_branching_random_walk_annihilation.lean L178–L272" ;
        dct:description "3 new Lean 4 theorems: nematic order extremes/symmetry/torque, Moran martingale and variance, TEB split label conservation (6 total, 0 sorry)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/morphoeval/lean/loops/Loop_056_branching_random_walk_annihilation.lean#L178-L272> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 056 Pass 3 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


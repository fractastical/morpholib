sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-branching-random-walk-annihilation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L583–L705" ;
        dcterms:description "3-organ BARW universality sweep and 4-regime R_a perturbation + ablation evaluation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L583-L705> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L1031–L1072" ;
        dcterms:description "Paired-seed lambda sweep in cylinder and sphere, true-isotropic control, inflation sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L1031-L1072> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2017) Cell & Scheele et al. (2017) Nature unifying theory of branching morphogenesis via branching and annihilating random walks (BARW) — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The 3-organ R_a / l_b sweep and 4-regime R_a perturbation/ablation suite (L583-705) are retained; Pass 3 adds the geometry switch (cylinder / sphere), a paired-seed ECM alignment sweep over five lambda values with a true-isotropic control (L1036-1051), an inflation-rate sweep, and the CLI flags `--ecm-lambda`, `--n-cells-teb`, `--label-fraction` (L2105-2107) alongside `--v0/--kb/--ra/--ka/ --sigma-theta/--seed` (L2099-2104); the lambda sweep produces a genuine regime change (lambda >= 0.4 collapses the sphere tree from N_b = 322 to 1 by alignment-induced sibling annihilation). Deductions: `--ra/--kb/--v0/--sigma-theta` do not propagate to the 3D sweep (defaults read from the JSON) nor to the organ/perturbation suite (-5); the three new flags affect only Panels G/I and the clonal metrics, not the sweep figures (-3); the 3D lambda sweep uses a single paired seed per lambda, so the N_b collapse is one realisation (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2017-hannezo-branching-random-walk-annihilation.py L2097–L2107: CLI: 9 numeric flags; the 3D sweep and organ suite ignore --ra/--kb/--v0/--sigma-theta <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L2097-L2107>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 056 Pass 3 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:provenance {
    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/56> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2017.08.026>,
            <https://doi.org/10.1017/S0305004100033193>,
            <https://doi.org/10.1038/nature21060>,
            <https://doi.org/10.1038/s41467-023-39124-x>,
            <https://doi.org/10.1242/dev.060103>,
            <https://doi.org/10.1242/dev.147645> .

    <https://doi.org/10.1016/j.cell.2017.08.026> dcterms:date "2017"^^xsd:gYear ;
        dcterms:title "A Unifying Theory of Branching Morphogenesis" .

    <https://doi.org/10.1017/S0305004100033193> dcterms:date "1958"^^xsd:gYear ;
        dcterms:title "Random processes in genetics" .

    <https://doi.org/10.1038/nature21060> dcterms:date "2017"^^xsd:gYear ;
        dcterms:title "Identity and dynamics of mammary stem cells during branching morphogenesis" .

    <https://doi.org/10.1038/s41467-023-39124-x> dcterms:date "2023"^^xsd:gYear ;
        dcterms:title "Inflationary theory of branching morphogenesis in the mouse salivary gland" .

    <https://doi.org/10.1242/dev.060103> dcterms:date "2011"^^xsd:gYear ;
        dcterms:title "Universal patterns of stem cell fate in cycling adult tissues" .

    <https://doi.org/10.1242/dev.147645> dcterms:date "2017"^^xsd:gYear ;
        dcterms:title "Tracing the dynamics of pancreatic progenitors during branching morphogenesis" .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-branching-random-walk-annihilation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2017) Cell & Scheele et al. (2017) Nature unifying theory of branching morphogenesis via branching and annihilating random walks (BARW) — Morphometric validation: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L1799-1998) reports 14 metrics with reference values, units and dispersion statistics: q_branch 0.480 (ref 0.5), tau = 1.4418 (ref 1.5, computed p-value L227), honest generational r = 0.924 against the measured pooled ensemble (L641-661; replaces the hand-fitted Pass 2 curve), i_inf = 0.28695 (ref 0.28571), hyper-branching 8.82x, R_a = 0 explosion +49 tips, specimen N_term = 34 and r/R_max = 0.7833, and six Pass 3 metrics: 3D cylinder q_b = 0.4937 (ref 0.5), sphere tau = 1.438 (ref 1.49), S_iso = 0.054 (ref 0), S gain 0.576, clonal f_bar = 0.119 (ref 0.125), tau_clone = 1.66 (ref 1.5). Deductions: the hyper-branching reference 2.00 (L1897) is missed by 4.4x and the \"hypo\" tree is a dead stalk (L_total = 28), yet the metric is presented as a pass (-4); i_inf vs k_b/k_a is a self-calibration via L510/L530-531 (-3); the sphere tau regresses bins with count >= 2 over S in [3, 45] of a single tree (L1824-1831) and the clone tail uses sizes 1..25 with r = -0.93 (L1198-1201) — both small-sample exponents (-3); S(lambda) monotonicity rests on one seed per lambda and the cylinder trees at lambda = 0.2, 0.4 have N_b = 4 and 2 (-2); g = 1 of the generational profile is q = 1 by construction and the reference profile is labelled \"obs\" without digitisation provenance (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2017-hannezo-branching-random-walk-annihilation.py L1198–L1201: Clone-size tail regression over sizes 1..25 with count >= 2; r = -0.93 <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L1198-L1201>",
            "2017-hannezo-branching-random-walk-annihilation.py L1824–L1831: Sphere tau regression on count >= 2 bins over S in [3, 45] of one tree (small-sample exponent) <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L1824-L1831>",
            "2017-hannezo-branching-random-walk-annihilation.py L1897–L1897: Hyper-branching reference 2.00 vs measured 8.82 — model/reference mismatch scored as a pass <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L1897-L1897>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-1d-mean-field-barw-homeostatic-wake-duct-density-i-inf>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-2d-barw-self-terminated-topological-branching-fraction-q-branch-wt>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-3d-barw-nematic-ecm-order-parameter-s-in-the-true-isotropic-control-chi-0-lambda-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-3d-cylindrical-fat-pad-barw-topological-branching-fraction-q-branch-ecm-lambda-0-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-3d-ecm-alignment-sweep-nematic-order-gain-s-lambda-0-2-s-lambda-0-in-spherical-mesenchyme>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-3d-spherical-mesenchyme-barw-subtree-size-power-law-exponent-tau-kidney-regime>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-attenuated-tgf-beta-r-a-1-75-vs-wild-type-r-a-3-5-ductal-hyper-branching-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-clonal-neutral-drift-martingale-duct-length-weighted-labelled-fraction-vs-induced-fraction-f-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-critical-galton-watson-subtree-size-power-law-exponent-tau>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-generational-branching-probability-q-branch-g-correlation-across-3-organs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-mouse-branched-ductal-specimen-active-distal-tip-count-n-term>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-mouse-branched-ductal-specimen-peripheral-active-tip-radial-localization-r-r-max>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-non-annihilating-r-a-0-ablation-unarrested-active-tip-explosion-delta>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-single-cell-clone-size-tail-exponent-tau-clone-labelled-ductal-segments-per-surviving-clone>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-morphometric-validation-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-1d-mean-field-barw-homeostatic-wake-duct-density-i-inf> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "1D mean-field BARW homeostatic wake duct density i_inf = 0.28695 dimensionless duct density" ;
        dcterms:description "wake plateau CV = 0.0585; travelling front speed c* = 0.6956 vs Fisher-KPP 0.7599" ;
        schema:measurementTechnique "spatial mean of differentiated duct density i(x, t_end) in colonized wake x in [10, 32] (wake CV = 0.0585, residual active tips a_wake = 0.00038)" ;
        schema:name "1D mean-field BARW homeostatic wake duct density i_inf" ;
        schema:unitText "dimensionless duct density" ;
        schema:value "0.28695" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-1d-mean-field-barw-homeostatic-wake-duct-density-i-inf-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-1d-mean-field-barw-homeostatic-wake-duct-density-i-inf-reference> a schema:PropertyValue ;
        schema:value "0.28571" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-2d-barw-self-terminated-topological-branching-fraction-q-branch-wt> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D BARW self-terminated topological branching fraction q_branch (WT) = 0.48 probability" ;
        dcterms:description "3-organ ensemble mean q_branch = 0.4852 ± 0.0142 (SD across mammary, kidney, pancreas)" ;
        schema:measurementTechnique "N_branch / (N_branch + N_term) = 12/25 with N_term = N_branch + 1 (active_end = 0)" ;
        schema:name "2D BARW self-terminated topological branching fraction q_branch (WT)" ;
        schema:unitText "probability" ;
        schema:value "0.48" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-2d-barw-self-terminated-topological-branching-fraction-q-branch-wt-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-2d-barw-self-terminated-topological-branching-fraction-q-branch-wt-reference> a schema:PropertyValue ;
        schema:value "0.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-3d-barw-nematic-ecm-order-parameter-s-in-the-true-isotropic-control-chi-0-lambda-0> a schema:PropertyValue,

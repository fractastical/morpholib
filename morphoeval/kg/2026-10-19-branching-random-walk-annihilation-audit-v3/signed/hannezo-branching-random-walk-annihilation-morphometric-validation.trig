    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-3d-barw-nematic-ecm-order-parameter-s-in-the-true-isotropic-control-chi-0-lambda-0-reference> a schema:PropertyValue ;

        schema:measurementTechnique "N_branch / (N_branch + N_term) = 39/79 in the 3D cylinder (R_c = 14.0, L_c = 110.0); N_term - N_branch = 1 (active_end = 0)" ;
        schema:name "3D cylindrical fat-pad BARW topological branching fraction q_branch (ECM lambda = 0.1)" ;
        schema:unitText "probability" ;

        schema:measurementTechnique "length-weighted S = <(3 cos^2 theta - 1)/2> of ductal segment directions relative to the fiber axis in a cylinder tree without polar bias or ECM torque (N_b = 148)" ;
        schema:name "3D BARW nematic ECM order parameter S in the true-isotropic control (chi = 0, lambda = 0)" ;
        schema:unitText "nematic order S (dimensionless)" ;

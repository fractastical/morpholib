    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-3d-spherical-mesenchyme-barw-subtree-size-power-law-exponent-tau-kidney-regime> a schema:PropertyValue,

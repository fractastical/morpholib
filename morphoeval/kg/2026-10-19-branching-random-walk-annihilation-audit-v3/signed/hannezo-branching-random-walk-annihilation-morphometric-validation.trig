    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-clonal-neutral-drift-martingale-duct-length-weighted-labelled-fraction-vs-induced-fraction-f-0-reference> a schema:PropertyValue ;

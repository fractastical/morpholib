    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-3d-cylindrical-fat-pad-barw-topological-branching-fraction-q-branch-ecm-lambda-0-1-reference> a schema:PropertyValue ;
        schema:value "0.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-3d-ecm-alignment-sweep-nematic-order-gain-s-lambda-0-2-s-lambda-0-in-spherical-mesenchyme> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D ECM alignment sweep: nematic order gain S(lambda = 0.2) - S(lambda = 0) in spherical mesenchyme = 0.57557 delta nematic order S" ;
        dcterms:description "negative/zero gain would falsify the ECM torque; lambda = 0.4 collapses the tree to N_b = 1 (alignment-induced sibling annihilation); inflation sweep L_total = [3331.5, 11755.0, 14229.0] for rates [0.0, 0.004, 0.008]" ;
        schema:measurementTechnique "paired-seed difference of S between lambda = 0.2 and lambda = 0 in the sphere (N_b: 322 -> 72); cylinder gain = 0.2274" ;
        schema:name "3D ECM alignment sweep: nematic order gain S(lambda = 0.2) - S(lambda = 0) in spherical mesenchyme" ;
        schema:unitText "delta nematic order S" ;
        schema:value "0.57557" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-3d-ecm-alignment-sweep-nematic-order-gain-s-lambda-0-2-s-lambda-0-in-spherical-mesenchyme-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-3d-ecm-alignment-sweep-nematic-order-gain-s-lambda-0-2-s-lambda-0-in-spherical-mesenchyme-reference> a schema:PropertyValue ;

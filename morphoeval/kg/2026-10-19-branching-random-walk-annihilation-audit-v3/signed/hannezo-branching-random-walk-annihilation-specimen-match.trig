sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-branching-random-walk-annihilation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L706–L806" ;
        dcterms:description "Chromatic active-tip bud segmentation and EDT medial-axis junction extraction on the specimen (tuned filter sizes)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L706-L806> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/branching_random_walk_annihilation_comparison.png (generated output)" ;
        dcterms:description "3x3 synthesis figure: Panel F specimen segmentation, Panel G 3D fat-pad tree, Panel I clonal mosaic on the 2D tree — docs/media/branching_random_walk_annihilation_comparison.png: rendered output of 2017-hannezo-branching-random-walk-annihilation.py at 74d06a5c, image/png, 1443723 B, 2550×2295 px, artifact_sha256 50078c445a1f7e01ce6cc208f501bd1f251962f63f7798c0eec4e4bb723f1dfe (sha256 50078c445a1f7e01ce6cc208f501bd1f251962f63f7798c0eec4e4bb723f1dfe), spec_fingerprint 0705016d88b40abfd432a650c7382c2c601d9cfa65577d8735df8bfc6facc377" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2017) Cell & Scheele et al. (2017) Nature unifying theory of branching morphogenesis via branching and annihilating random walks (BARW) — Morphological realism / specimen match: 84/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The SHA-256-verified specimen (`mouse_branched_ductal_network_specimen.jpg`) is segmented into active buds and EDT medial-axis junctions (L706-806), recovering N_term = 34, N_branch = 33 and the exact binary-tree identity, and Panel F shows the segmentation beside the simulated trees; the Pass 3 3D fat-pad and clonal panels (G, I) visibly resemble the cited ductal trees and lineage mosaics. Deductions: the specimen is a Wikimedia whole-mount of an embryonic branched gland (salivary/lung-like acinar buds), not the pubertal mammary TEB network or the kidney/pancreas organs the model targets, and no figure from Hannezo, Scheele or Bordeu is placed beside the simulation (-8); the reference values N_term = 34 and r/R_max = 0.783 (L1917, L1927) are the segmentation's own outputs from a tuned size-14 maximum filter / edt > 4 threshold, so the specimen metrics are circular (-5); the WT 2D tree in Panels A and I has only 13 terminals, far sparser than any specimen (-3). Not changed in Pass 3; the v2 score of 90 did not account for the organ mismatch." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2017-hannezo-branching-random-walk-annihilation.py L1917–L1927: Specimen reference values 34 and 0.783 are the segmentation's own outputs (circular) <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L1917-L1927>",
            "datasets/branching_random_walk_annihilation/README.md L22–L22: Specimen described as an embryonic branched glandular epithelial network from Wikimedia Commons, not a pubertal mammary gland <https://github.com/fractastical/morpholib/blob/74d06a5c/datasets/branching_random_walk_annihilation/README.md#L22-L22>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-specimen-match-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 056 Pass 3 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

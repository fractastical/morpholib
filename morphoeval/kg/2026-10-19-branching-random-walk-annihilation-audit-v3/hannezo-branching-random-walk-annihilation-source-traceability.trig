sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-branching-random-walk-annihilation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2017) Cell & Scheele et al. (2017) Nature unifying theory of branching morphogenesis via branching and annihilating random walks (BARW) — Source and data traceability: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`datasets/branching_random_walk_annihilation/` vendors the Pass 2 reference JSON and specimen (both SHA-256 locked) plus the new `barw_3d_ecm_clonal_reference.json` (SHA-256 c716e3a9..., pinned at L97 and verified fail-closed in `verify_dataset_integrity`, L127-172), with its free parameters (N_TEB, Moran rate) listed explicitly; `paper_citations.bib` adds Moran 1958 and Klein & Simons 2011 (8 entries) and the README documents the Pass 3 additions. Deductions: the Moran 1958 and Klein & Simons 2011 DOIs could not be verified offline and are flagged as such (-2); the `generation_branch_probability_profile` reference values are labelled \"obs\" without a figure-digitisation provenance (-3); the specimen's organ/stage provenance is not resolved beyond \"embryonic branched gland\" (-2); the S reference values are theoretical extremes rather than Bordeu measurements (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-source-traceability-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-source-traceability-5> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L95–L97" ;
        dct:description "SHA-256 pins for reference JSON, specimen and the new Pass 3 reference JSON" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L95-L97> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L127–L172" ;
        dct:description "Runtime fail-closed SHA-256 verification of all three vendored files" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L127-L172> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/branching_random_walk_annihilation/barw_3d_ecm_clonal_reference.json L1–L86" ;
        dct:description "Pass 3 reference table: 3D geometries, lambda / inflation sweeps, nematic S references, clonal parameters with free parameters declared" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/datasets/branching_random_walk_annihilation/barw_3d_ecm_clonal_reference.json#L1-L86> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/branching_random_walk_annihilation/paper_citations.bib L68–L90" ;
        dct:description "moran1958random and klein2011universal added; DOIs flagged as not verified offline" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/datasets/branching_random_walk_annihilation/paper_citations.bib#L68-L90> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-source-traceability-5> a pk:EvidenceItem ;

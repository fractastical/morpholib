sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-branching-random-walk-annihilation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2017) Cell & Scheele et al. (2017) Nature unifying theory of branching morphogenesis via branching and annihilating random walks (BARW) — Code-to-model traceability: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring (L1-66) lists the Pass 3 additions and maps the 3D ECM torque, inflation and clonal Moran model to Bordeu et al. (2023), Scheele et al. (2017), Moran (1958) and Klein & Simons (2011) alongside the Pass 2 mapping to Hannezo STAR Methods; every new function carries a docstring naming its source; the math KG loop file registers equations 4-6 with `lean_locus` and `code_locus` (L94-147), and Panels G/H/I are labelled by mechanism (L1559-1633). Deductions: the PDE constants at L510 and L530-531 carry no citation or derivation comment (-4); the birth-vertex rule (L934-938) is documented as a numerical necessity but not tied to any paper statement (-2); the specimen reference values at L1917/L1927 are not marked as segmentation-derived (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2017-hannezo-branching-random-walk-annihilation.py L510–L531: PDE constants 0.35, 1.82, 0.55 have no citation or derivation comment <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L510-L531>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-code-traceability-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L1–L66" ;
        dct:description "Module docstring with Pass 3 additions mapped to Bordeu 2023, Scheele 2017, Moran 1958, Klein & Simons 2011 and the Lean theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L1-L66> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/hannezo-branching-random-walk-annihilation.yaml L94–L147" ;
        dct:description "Equations 4-6 (nematic ECM order, Moran martingale, TEB split conservation) with lean_locus and code_locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/morphoeval/math_kg_loops/hannezo-branching-random-walk-annihilation.yaml#L94-L147> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L1559–L1633" ;
        dct:description "Panels G/H/I labelled by mechanism and source" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L1559-L1633> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 056 Pass 3 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


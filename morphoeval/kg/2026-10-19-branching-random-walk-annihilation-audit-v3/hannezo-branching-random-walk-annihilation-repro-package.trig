sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-branching-random-walk-annihilation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2017) Cell & Scheele et al. (2017) Nature unifying theory of branching morphogenesis via branching and annihilating random walks (BARW) — Reproducibility package: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`self_test()` (L2000-2091) runs 9 suites (7 Pass 2 + suite 8: 3D fat-pad/mesenchyme BARW with ECM anisotropy + inflation, L2048-2064; suite 9: clonal neutral drift, L2066-2088) and passed 9/9 in 21 s at audit time; the default render completes in ~24 s and writes the 3x3 PNG, the GIF and two supplementary PNGs; `measure_morphoeval(precomputed=...)` reuses the render results; two-run bitwise determinism is asserted. Deductions: the suite-4 threshold `0.48 <= q <= 0.50` (L2021) holds only for seed 2017 (other seeds give N_b from 1 to 70), so the self-test is seed-fragile rather than a property test (-4); the GIF still shows only the 2D tree + 1D wave, no 3D or clonal animation (-2); the 3D suite's monotonic S(lambda) assertion (L2054-2064) is on a single seed (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2017-hannezo-branching-random-walk-annihilation.py L2021–L2021: Seed-specific q_branch window on the WT tree (N_b = 12 at seed 2017) <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L2021-L2021>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-repro-package-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L2000–L2091" ;
        dct:description "9-suite self_test() including SHA-256 integrity, bitwise determinism, 3D ECM anisotropy and clonal drift suites" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L2000-L2091> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L2048–L2088" ;
        dct:description "Pass 3 suites 8 and 9" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L2048-L2088> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L2093–L2128" ;
        dct:description "CLI entrypoint with --self-test, --skip-gif and 9 numeric flags" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L2093-L2128> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 056 Pass 3 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


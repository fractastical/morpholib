sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 1.5 µm in Drosophila eugracilis (Pass 2 sweep and controls) — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r = 0.992 on six gamma points (reference 1, so the score is not self-referential). RMSE = 0.701 µm records the systematic FFT-versus-k_c offset instead of hiding it. KS luminance = 0.343. Blurred-arm fraction 0.177 versus raw Otsu 0.141. Focus spacing CV 0.294 versus a perfect lattice at 0. Absolute wavelength calibration remains biased; correlation does not remove that." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-ablation-equal-diffusion-activator-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-analytic-turing-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-goodness-of-fit-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-goodness-of-fit-rmse-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-ocellus-nearest-neighbor-spacing-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-predecessor-erecta-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-simulated-stripe-fft-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-specimen-segment-smoothed-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-specimen-segment-smoothed-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-specimen-stripe-arm-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-specimen-vs-simulation-ks-luminance>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-successor-ficusphila-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-ablation-equal-diffusion-activator-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_equal_diffusion_activator_std = 0.000248 1" ;
        schema:measurementTechnique "Final activator std with D_u=D_v (Turing h<0) versus the patterned D_v/D_u=32 control, same noise seed" ;
        schema:name "ablation_equal_diffusion_activator_std" ;
        schema:unitText "1" ;
        schema:value "0.000248" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-ablation-equal-diffusion-activator-std-reference> .

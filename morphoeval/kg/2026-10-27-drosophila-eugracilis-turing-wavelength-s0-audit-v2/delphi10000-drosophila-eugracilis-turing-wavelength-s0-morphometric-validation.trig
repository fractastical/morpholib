        schema:unitText "µm" ;
        schema:value "0.70098" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-goodness-of-fit-rmse-um-reference> .

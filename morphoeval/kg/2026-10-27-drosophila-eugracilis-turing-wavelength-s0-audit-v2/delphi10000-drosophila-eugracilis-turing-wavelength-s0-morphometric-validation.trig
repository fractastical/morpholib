            pk:EvidenceItem ;
        rdfs:label "goodness_of_fit_pearson_r = 0.992318 1" ;
        schema:measurementTechnique "Pearson r of analytic λ_c(γ) versus nonlinear FFT λ across the γ sweep, including erecta, eugracilis and ficusphila" ;
        schema:name "goodness_of_fit_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.992318" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-goodness-of-fit-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-goodness-of-fit-pearson-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .

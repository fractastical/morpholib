sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 1.5 µm in Drosophila eugracilis (Pass 2 sweep and controls) — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Schnakenberg kinetics, the Turing conditions, and k_c match the cited formulas. Self-test checks that the explicit dispersion and the 1/sqrt(gamma) shortcut agree to 1e-9, and that gamma=1 is exactly 1.485 µm. The length unit is assigned, not fitted to a species SEM, which is why this is not higher." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-eugracilis-turing-wavelength-s0.py L94–L120" ;
        dct:description "k_c and growth rate sigma(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-eugracilis-turing-wavelength-s0.py#L94-L120> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-eugracilis-turing-wavelength-s0.py L699–L712" ;
        dct:description "self-test dispersion identity to 1e-9 and lambda 1.485e-6" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-eugracilis-turing-wavelength-s0.py#L699-L712> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


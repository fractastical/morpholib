sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 1.5 µm in Drosophila eugracilis (Pass 2 sweep and controls) — Morphological realism / specimen match: 76/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Side-by-side, the plate is a spiral and the simulation is a spot lattice. They share the plate's brown LUT and both fill the frame. Direct CV similarity of the GIF's last frame to the plate is 88.6 (orientation, radial FFT, coherency, occupancy) on a 12-frame 720x540 animation. The plate is not a fly photograph, so specimen-match stays below the range reserved for a segmented micrograph." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/drosophila_eugracilis_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "Plate, ocelli, dispersion, GOF r=0.992, chronoseries bars, ablation — docs/media/drosophila_eugracilis_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-drosophila-eugracilis-turing-wavelength-s0.py at 0c76d15d, image/png, 476053 B, 1792×1148 px, artifact_sha256 6d16c18dee30d5d187f765e4dcb77304ca63822df7e92fc4c0a1e3ea7710ffbc (sha256 6d16c18dee30d5d187f765e4dcb77304ca63822df7e92fc4c0a1e3ea7710ffbc), spec_fingerprint 4cd159ca0e54b6b9882667ea66ee1c36e85c25ecfd3d9cd25e35efca3e35cc7f" .

    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg Turing wavelength at 1.5 µm in Drosophila eugracilis (Pass 2 sweep and controls) — Morphological realism / specimen match: 76/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Side-by-side, the plate is a spiral and the simulation is a spot lattice. They share the plate's brown LUT and both fill the frame. Direct CV similarity of the GIF's last frame to the plate is 88.6 (orientation, radial FFT, coherency, occupancy) on a 12-frame 720x540 animation. The plate is not a fly photograph, so specimen-match stays below the range reserved for a segmented micrograph." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-specimen-match-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-specimen-match-2> ;
    pk:hasScore 7.6e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Schnakenberg Turing wavelength at 1.5 µm in Drosophila eugracilis (Pass 2 sweep and controls) (Drosophila eugracilis)",
        "Schnakenberg Turing wavelength at 1.5 µm in Drosophila eugracilis (Pass 2 sweep and controls) faithfully reproduces Drosophila eugracilis morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-eugracilis-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-eugracilis-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-eugracilis-turing-wavelength-s0-3>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-eugracilis-turing-wavelength-s0-4> ;
    dct:description "The simulation script(s) models/2026-delphi10000-drosophila-eugracilis-turing-wavelength-s0.py, docs/media/drosophila_eugracilis_turing_wavelength_s0_growth.gif implement the cited source model as published and produce forms that match real Drosophila eugracilis specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/media/drosophila_eugracilis_turing_wavelength_s0_growth.gif>,
        <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-eugracilis-turing-wavelength-s0.py> ;
    schema:about "Drosophila eugracilis" ;
    schema:additionalProperty "does_not_claim: A nanopublication signature. No ~/.nanopub/profile.yml was present.",
        "does_not_claim: A published 1.485 µm measurement on D. eugracilis ocelli or sex-comb teeth.",
        "does_not_claim: Sibling primordium parameters (101 µm, alpha 1.555) or DOI 10.1016/j.ydbio.2009.04.012.",
        "does_not_claim: Stratigraphic ancestry of erecta to eugracilis. Both are extant; 13/41 is the catalog chronoseries index.",
        "reconstructed_in_script: Length unit chosen so gamma=1 yields 1.485e-6 m.",
        "reconstructed_in_script: Nonlinear FFT wavelength series, equal-diffusion ablation, blurred Otsu mask, KS luminance.",
        "reconstructed_in_script: gamma_erecta=0.5 and lambda_ficusphila=1.180 µm as this scale's chronoseries contrast.",
        "reported_in_source: Murray 1981 scale parameter controlling pattern spacing.",
        "reported_in_source: Ready, Hanson and Benzer 1976: periodic retinal lattice.",
        "reported_in_source: Schnakenberg 1979 two-species kinetics.",
        "reported_in_source: Tanaka, Barmina and Kopp 2009: sex-comb mechanisms differ among Drosophila species, including rotation versus longitudinal birth of the row.",
        "reported_in_source: Turing 1952 dispersion relation and a critical wavenumber.",
        "reported_in_source: Yassin et al. 2016: female-limited colour dimorphism has recurred in Drosophila.",

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-eugracilis-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Focal 1.485 µm wavelength lies strictly below the erecta predecessor (2100 nm) | Variables: f_u, f_v, g_u, g_v at the Schnakenberg steady state, scaled by Murray gamma" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-eugracilis-turing-wavelength-s0.py#L94-L111>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3184_drosophila_eugracilis_turing_wavelength_s0.lean#L20-L21> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J - k^2 D) = D_u D_v k^4 - (D_v f_u + D_u g_v) k^2 + (f_u g_v - f_v g_u)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(76)90225-6>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.cub.2016.07.016>,
        <https://doi.org/10.1073/pnas.0807875106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion and Turing dispersion (Schnakenberg activator-substrate)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3184.lamEugracilisNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3184.predecessor_wavelength_longer" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-eugracilis-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber" ;
    dct:description "Poson law at the 1.5 µm detail scale | Variables: k increases as lambda falls from erecta 2100 nm through eugracilis 1485 nm to ficusphila 1180 nm" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-eugracilis-turing-wavelength-s0.py#L94-L111>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3184_drosophila_eugracilis_turing_wavelength_s0.lean#L27-L29> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); lambda_c = 2 pi / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(76)90225-6>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.cub.2016.07.016>,
        <https://doi.org/10.1073/pnas.0807875106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion and Turing dispersion (Schnakenberg activator-substrate)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3184.wavenumber_reverses_wavelength" ;
    pk:leanTheorem "MathOfBiology.Loop_3184.wavenumber_reverses_wavelength" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-eugracilis-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Murray gamma scaling" ;
    dct:description "What changes at 0 Ma between chronospecies 13/41 and its neighbors is gamma, not geological age | Variables: gamma_erecta=0.50, gamma_eugracilis=1, gamma_ficusphila=(1.485/1.180)^2" ;
    dct:source "Murray 1981 DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-eugracilis-turing-wavelength-s0.py#L127-L129>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3184_drosophila_eugracilis_turing_wavelength_s0.lean#L41-L43> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c(gamma) = lambda_c(1) / sqrt(gamma)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(76)90225-6>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.cub.2016.07.016>,
        <https://doi.org/10.1073/pnas.0807875106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion and Turing dispersion (Schnakenberg activator-substrate)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3184.murray_gamma_orders_with_shorter_wavelength" ;
    pk:leanTheorem "MathOfBiology.Loop_3184.murray_gamma_orders_with_shorter_wavelength" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-eugracilis-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail-window mode count" ;
    dct:description "Shorter successor wavelength packs more ocellar foci into the same detail window | Variables: window 17.820 µm; N_ficusphila > 12 > N_erecta" ;
    dct:source "Tanaka, Barmina and Kopp 2009 DOI:10.1073/pnas.0807875106" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-eugracilis-turing-wavelength-s0.py#L372-L395>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3184_drosophila_eugracilis_turing_wavelength_s0.lean#L32-L38> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = 17820 nm / lambda_nm; N_eugracilis = 12" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(76)90225-6>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.cub.2016.07.016>,
        <https://doi.org/10.1073/pnas.0807875106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion and Turing dispersion (Schnakenberg activator-substrate)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3184.eugracilis_window_is_twelve_wavelengths" ;
    pk:leanTheorem "MathOfBiology.Loop_3184.detail_window_mode_count" ;
    pk:leanVerified true .


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-coccolith-emiliania-calcite-rosette> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Young et al. (1992) & Jaya et al. (2016) Emiliania huxleyi V/R calcite crystal coccolith rosette shield & interlocking spherical coccosphere mechanics — Parameter expressivity: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates all 5 morphotype and ocean acidification ablation regimes (`morphotype_A_canonical`, `morphotype_B_large_delicate`, `morphotype_C_small_subpolar`, `morphotype_R_overcalcified`, `ocean_acidification_cap_ablation`), sweeps calcite saturation `Omega_calcite in [0.5, 5.5]` and coccosphere count `N_cocc in [12, 24]`, validates 12 coccolithophore taxa, and exposes `--n-seg`, `--w0`, `--l-spoke`, `--omega`, `--n-cocc`, `--seed`, and `--skip-gif` CLI overrides (L825-862)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-parameter-expressivity-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2022-coccolith-emiliania-calcite-rosette.py L298–L358" ;
        dct:description "5 morphotype/acidification regimes and 12-taxon coccolithophore scaling suite" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2022-coccolith-emiliania-calcite-rosette.py#L298-L358> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2022-coccolith-emiliania-calcite-rosette.py L825–L862" ;
        dct:description "Full CLI parameter overrides wired into render_comparison_figure()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2022-coccolith-emiliania-calcite-rosette.py#L825-L862> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


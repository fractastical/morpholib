        dct:description "360 / 32 = 11.25 deg exact match, coccosphere D = 5.65 um" ;
        schema:measurementTechnique "Elliptical polar DoG angular peak segmentation around the distal shield annulus of the isolated coccolith in the right SEM panel (mean spacing = 11.25 deg, CV = 0.2971)" ;
        schema:name "Emiliania huxleyi SEM specimen segmented radial spoke count N_seg (emiliania_huxleyi_coccolith_specimen.jpg)" ;
        schema:unitText "radial segments" ;
        schema:value "32.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-emiliania-huxleyi-sem-specimen-segmented-radial-spoke-count-n-seg-emiliania-huxleyi-coccolith-specimen-jpg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-emiliania-huxleyi-sem-specimen-segmented-radial-spoke-count-n-seg-emiliania-huxleyi-coccolith-specimen-jpg-reference> a schema:PropertyValue ;

        dct:description "truncated L_d = 3.1205 um, interlock_ok = False" ;
        schema:measurementTechnique "Distal T-head expansion ratio under ocean acidification (Omega_calcite = 0.75 < 1.0) and CAP ablation (c_CAP = 0.0 -> complete T-head truncation)" ;

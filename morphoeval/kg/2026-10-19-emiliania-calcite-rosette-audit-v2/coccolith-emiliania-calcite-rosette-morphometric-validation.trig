        schema:value "2.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-young-et-al-1992-v-r-crystallographic-c-axis-orthogonality-angle-c-v-vs-c-r> a schema:PropertyValue,

        dct:description "3V = 2E = 84 verified, buckling amplification = 2.36x" ;
        schema:measurementTechnique "Topological Euler characteristic V - E + F of the 3D spherical Voronoi coccosphere tiling (F=16 coccoliths, V=28 trivalent vertices, E=42 suture edges)" ;
        schema:name "Spherical coccosphere Euler polyhedral characteristic chi = V - E + F (N_cocc = 16)" ;
        schema:unitText "Euler characteristic chi" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-spherical-coccosphere-euler-polyhedral-characteristic-chi-v-e-f-n-cocc-16-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-spherical-coccosphere-euler-polyhedral-characteristic-chi-v-e-f-n-cocc-16-reference> a schema:PropertyValue ;

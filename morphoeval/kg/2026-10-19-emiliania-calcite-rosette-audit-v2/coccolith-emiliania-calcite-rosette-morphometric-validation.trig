        schema:measurementTechnique "Distal shield major axis L_d = (N_seg * w_0)/pi + 2 * L_spoke for Morphotype A (N_seg=32, w_0=0.145 um, L_spoke=1.0114 um)" ;
        schema:name "Morphotype A canonical distal shield major length L_d(N_seg = 32)" ;
        schema:unitText "um" ;
        schema:value "3.4998" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-morphotype-a-canonical-distal-shield-major-length-l-d-n-seg-32-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-morphotype-a-canonical-distal-shield-major-length-l-d-n-seg-32-reference> a schema:PropertyValue ;
        dct:source "Didymus et al. (1993) Proc. R. Soc. B 252:259-264 & Lean 4 theorem proto_coccolith_circumference_and_distal_shield_linear_scaling" ;
        schema:value "3.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-morphotype-a-cap-polysaccharide-t-shaped-hammer-head-expansion-ratio-w-head-w-shaft> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Morphotype A CAP-polysaccharide T-shaped hammer-head expansion ratio w_head / w_shaft = 1.72 width ratio" ;
        dct:description "slit fraction = 0.6490, interlock_ok = True" ;
        schema:measurementTechnique "Tangential T-head hammer expansion ratio 1 + 0.225 * c_CAP * max(Omega_calcite - 1, 0) at Omega_calcite = 4.2, c_CAP = 1.0" ;
        schema:name "Morphotype A CAP-polysaccharide T-shaped hammer-head expansion ratio w_head / w_shaft" ;
        schema:unitText "width ratio" ;
        schema:value "1.72" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-morphotype-a-cap-polysaccharide-t-shaped-hammer-head-expansion-ratio-w-head-w-shaft-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-morphotype-a-cap-polysaccharide-t-shaped-hammer-head-expansion-ratio-w-head-w-shaft-reference> a schema:PropertyValue ;
        dct:source "Didymus et al. (1993) Proc. R. Soc. B 252:259-264 & Lean 4 theorem cap_polysaccharide_hammer_expansion_and_acidification_truncation" ;
        schema:value "1.72" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-ocean-acidification-cap-polysaccharide-ablation-negative-control-t-head-ratio-omega-0-75> a schema:PropertyValue,
            pk:EvidenceItem ;

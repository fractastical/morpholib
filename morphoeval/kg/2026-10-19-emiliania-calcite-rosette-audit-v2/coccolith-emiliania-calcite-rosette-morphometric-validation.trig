        schema:unitText "width ratio" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-ocean-acidification-cap-polysaccharide-ablation-negative-control-t-head-ratio-omega-0-75-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-ocean-acidification-cap-polysaccharide-ablation-negative-control-t-head-ratio-omega-0-75-reference> a schema:PropertyValue ;

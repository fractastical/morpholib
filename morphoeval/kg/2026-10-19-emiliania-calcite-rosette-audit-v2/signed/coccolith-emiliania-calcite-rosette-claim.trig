sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-coccolith-emiliania-calcite-rosette> a pk:Claim ;
        rdfs:label "Young et al. (1992) & Jaya et al. (2016) Emiliania huxleyi V/R calcite crystal coccolith rosette shield & interlocking spherical coccosphere mechanics faithfully reproduces Emiliania huxleyi (Morphotypes A, B, B/C, C, R, O) & Gephyrocapsa / Calcidiscus / Coccolithus (Haptophyta) morphology" ;
        dcterms:description "The simulation script(s) 2022-coccolith-emiliania-calcite-rosette.py implement the cited source model as published and produce forms that match real Emiliania huxleyi (Morphotypes A, B, B/C, C, R, O) & Gephyrocapsa / Calcidiscus / Coccolithus (Haptophyta) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 91.7/100, audit 2026-10-19-emiliania-calcite-rosette-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/HEAD/2022-coccolith-emiliania-calcite-rosette.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/HEAD/2022-coccolith-emiliania-calcite-rosette.py; output: docs/media/emiliania_calcite_rosette_comparison.png; organism: Emiliania huxleyi (Morphotypes A, B, B/C, C, R, O) & Gephyrocapsa / Calcidiscus / Coccolithus (Haptophyta); checkpoint commit: https://github.com/fractastical/morpholib/commit/HEAD; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: a04d4ad3be794a2a2b64ad6ba6e976c1273468b393c25601eaba7d3808a4fc31; artifact_sha256: c8cb64fc4aaef13f875191852da6a4cb969268ae4526765145bcd5ea3ba757a6; input_dataset_sha256: {datasets/emiliania_calcite_rosette/emiliania_calcite_rosette_reference.json=6e0133f11f7fd993..., datasets/emiliania_calcite_rosette/emiliania_huxleyi_coccolith_specimen.jpg=94d4b431c4912727..., datasets/emiliania_calcite_rosette/scout_manifest.json=d838aa9cca83725c...}; supersedes_audit_id: 2026-10-19-emiliania-calcite-rosette-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1038/356516a0>,
            <https://doi.org/10.1038/ncomms11904>,
            <https://doi.org/10.1038/s41467-018-04168-9>,
            <https://doi.org/10.1098/rspb.1993.0073> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-specimen-match> ;
        pk:weightOfEvidence "0.917"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/HEAD/2022-coccolith-emiliania-calcite-rosette.py> a schema:SoftwareSourceCode ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-coccolith-emiliania-calcite-rosette> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2022-coccolith-emiliania-calcite-rosette.py L123–L295" ;
        dcterms:description "3D V/R crystallographic c-axis ring and T-shaped hammer-element rosette solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2022-coccolith-emiliania-calcite-rosette.py#L123-L295> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2022-coccolith-emiliania-calcite-rosette.py L365–L446" ;
        dcterms:description "3D spherical coccosphere Euler packing (V-E+F=2, 3V=2E) and ocean acidification CAP sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2022-coccolith-emiliania-calcite-rosette.py#L365-L446> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_080_emiliania_calcite_rosette.lean L27–L231" ;
        dcterms:description "4 Lean 4 theorems proving V/R parity & c_V ⊥ c_R, linear proto-ring scaling, Euler coccosphere packing, and CAP T-head expansion/truncation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_080_emiliania_calcite_rosette.lean#L27-L231> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Young et al. (1992) & Jaya et al. (2016) Emiliania huxleyi V/R calcite crystal coccolith rosette shield & interlocking spherical coccosphere mechanics — Model fidelity to source: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements 3D V/R bimodal crystallographic nucleation (`evaluate_vr_crystallographic_ring_3d`, L123-185) and 3D T-shaped hammer-element rosette morphogenesis (`evaluate_coccolith_rosette_3d`, L191-295) with chiral suture imbrication (`psi = 18 deg`) and CAP-polysaccharide / calcite saturation modulation across morphotypes A, B, C, R and ocean acidification ablation (`Omega = 0.75`), plus 3D spherical coccosphere Voronoi/Delaunay Euler packing and buckling mechanics (`evaluate_coccosphere_3d_euler_packing`, L365-432). Backed by 4 machine-checked Lean 4 theorems in `Loop_080_emiliania_calcite_rosette.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;

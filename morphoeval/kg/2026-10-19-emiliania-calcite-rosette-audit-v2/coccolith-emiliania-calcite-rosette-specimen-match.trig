sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-coccolith-emiliania-calcite-rosette> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Young et al. (1992) & Jaya et al. (2016) Emiliania huxleyi V/R calcite crystal coccolith rosette shield & interlocking spherical coccosphere mechanics — Morphological realism / specimen match: 90/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors, SHA-256-verifies, and performs elliptical polar unwrapping and Difference-of-Gaussians angular spoke segmentation (`segment_emiliania_coccolith_specimen`, L451-522) on the CC BY-SA 4.0 *Emiliania huxleyi* dual-panel SEM micrograph (`datasets/emiliania_calcite_rosette/emiliania_huxleyi_coccolith_specimen.jpg`), measuring `N_seg = 32` radial distal shield spokes (`11.25 deg` spacing, `CV = 0.2971`), elliptical aspect ratio `b/a = 0.8478` (`eccentricity e = 0.5303`), calibrated distal shield length `L_d = 3.5000 um` (vs theoretical `3.4998 um`), and intact coccosphere diameter `D_sphere = 5.6501 um`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-specimen-match-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2022-coccolith-emiliania-calcite-rosette.py L451–L522" ;
        dct:description "Elliptical polar DoG angular spoke segmentation and coccosphere calibration on E. huxleyi SEM micrograph" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2022-coccolith-emiliania-calcite-rosette.py#L451-L522> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/emiliania_calcite_rosette_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure with 3D V/R rosette, morphotypes A/B/C/R, 12-taxon scaling, 3D coccosphere, acidification curve, and SEM overlay — docs/media/emiliania_calcite_rosette_comparison.png: rendered output of 2022-coccolith-emiliania-calcite-rosette.py at HEAD, image/png, 746932 B, 2259×1420 px, artifact_sha256 c8cb64fc4aaef13f875191852da6a4cb969268ae4526765145bcd5ea3ba757a6 (sha256 c8cb64fc4aaef13f875191852da6a4cb969268ae4526765145bcd5ea3ba757a6), spec_fingerprint a04d4ad3be794a2a2b64ad6ba6e976c1273468b393c25601eaba7d3808a4fc31" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


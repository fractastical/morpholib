sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-planform-morphology-animation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-repro-package> .

    <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Reproducibility package: 60/100" ;
        dcterms:date "2026-10-14"^^xsd:date ;
        dcterms:description "Deterministic (no random state), invocation documented in the docstring and README, outputs reproduced identically on re-run, and morphologies with no encoded regions are skipped with a message rather than failing. Dependencies (numpy, scipy, matplotlib, Pillow) are in requirements.txt with lower bounds only, and the run depends on an unversioned external database." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-repro-package-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-repro-package-2> ;
        pk:hasVerdict "mostly faithful" ;
        pk:weightOfEvidence 6e-01 .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-repro-package-0> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L40–L43" ;
        dcterms:description "documented invocation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L40-L43> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L196–L202" ;
        dcterms:description "region-less morphologies skipped explicitly" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L196-L202> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "requirements.txt L1–L7" ;
        dcterms:description "lower-bound pins only" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/requirements.txt#L1-L7> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


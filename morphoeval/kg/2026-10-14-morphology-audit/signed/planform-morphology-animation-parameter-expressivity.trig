sub1:provenance {
    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1093/bioinformatics/btt088>,
            <https://doi.org/10.1242/bio.20123400>,
            <https://github.com/fractastical/morpholib/commit/161f269>,
            <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-planform-morphology-animation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Parameter expressivity: 75/100" ;
        dcterms:date "2026-10-14"^^xsd:date ;
        dcterms:description "Every encoded quantity now has a visible effect: each radius moves one control point of its region, each link moves a region centre and a border, each organ vector/rotation places one organ. All morphologies in a frame share one scale (frame_bounds), so the size and proportion differences between phenotypes are preserved. The final morphospace grid of the timeline fits each morphology to its cell, which deliberately trades scale for legibility." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-parameter-expressivity-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-parameter-expressivity-3> ;
        pk:hasVerdict "mostly faithful" ;
        pk:weightOfEvidence 7.5e-01 .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-output-planform-morphospace-timeline-gif> a prov:Entity,
            schema:ImageObject,
            pk:EvidenceItem ;
        rdfs:label "planform_morphospace_timeline.gif" ;
        dcterms:description "rendered output of 2013-lobo-planform-morphology.py at 161f269; sha256 pins the exact file that was scored; 1500×780 px, 63 frames" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py> ;
        schema:contentSize "3265519 B" ;
        schema:encodingFormat "image/gif" ;
        schema:height 780 ;
        schema:sha256 "f7c8cadf3c06c8351a49b6a47e1fc73fafafa7b430841771c14806fe54ce92a4" ;
        schema:width 1500 .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-parameter-expressivity-0> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L525–L531" ;
        dcterms:description "frame_bounds(): common scale within a frame" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L525-L531> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L546–L565" ;
        dcterms:description "render_gallery(): small multiples at common scale" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L546-L565> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L572–L681" ;
        dcterms:description "render_timeline(): per-year pages, final grid fitted per cell" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L572-L681> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "planform_morphospace_timeline.gif (generated output, not in repo)" ;
        dcterms:description "68 frames: intro, 30 year pages, final morphospace grid of 359 dated morphologies" ;
        prov:wasDerivedFrom <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-output-planform-morphospace-timeline-gif> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


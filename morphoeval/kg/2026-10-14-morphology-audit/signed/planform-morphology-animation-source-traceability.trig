sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-planform-morphology-animation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Source and data traceability: 70/100" ;
        dcterms:date "2026-10-14"^^xsd:date ;
        dcterms:description "Both source papers are cited with DOIs in the module docstring, the database version is named and the schema tables used are listed. The database itself is still an external file located through PLANFORM_DB_PATH; no hash or download URL is recorded, so the exact input cannot be verified from the repository alone." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-source-traceability-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-source-traceability-1> ;
        pk:hasVerdict "mostly faithful" ;
        pk:weightOfEvidence 7e-01 .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-source-traceability-0> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L10–L16" ;
        dcterms:description "DOIs of both Lobo et al. 2013 papers" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L10-L16> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L138–L146" ;
        dcterms:description "resolve_db_path(): env var or CLI, no provenance recorded" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L138-L146> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


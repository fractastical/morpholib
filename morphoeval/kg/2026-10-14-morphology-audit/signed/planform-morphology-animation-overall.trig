sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-overall> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — MorphoEval overall 66.5/100" ;
        rdfs:comment "Rewritten. The region graph of every PlanformDB morphology is now decoded exactly (polar radii per region, centres and borders from the RegionsLink labels, organs from the organ table) and drawn in Planform's own cartoon convention; wild type, double head, headless, cyclops and the other canonical phenotypes are visually distinct and recognisable as Planform drawings. Remaining gap: the formalism stores three radii per head, so species features such as auricles or a triangular head are not in the data and the renders still read as cartoons, not specimens. Overall 66.5/100 (faithfulness 66.1, reproducibility 67.3); rubric morphoeval 0.1.0; checkpoint commit 161f269; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, matplotlib 3.10.7, Pillow 12.0.0. Dimension assessments: Model fidelity to source 85, Morphological realism / specimen match 60, Parameter expressivity 75, Morphometric validation 45, Source and data traceability 70, Code-to-model traceability 75, Reproducibility package 60. Output judged: planform_morphology_gallery.png: rendered output of 2013-lobo-planform-morphology.py at 161f269, image/png, 443915 B, 1920×2160 px, sha256 77a7dfa087bf89441dc35c64bc0c96bccfdc15d44a3d600df766fb723a87ace5." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-planform-morphology-animation> ;
        pk:evidenceAgainst "remediation needed: Add per-species outline templates (auricles, head shape) layered on the decoded regions, clearly marked as not from the database.",
            "remediation needed: Compare the decoded aspect ratio and organ positions with measurements on photographed S. mediterranea / D. japonica.",
            "remediation needed: Pin dependency versions for the Python 3.14 environment used here.",
            "remediation needed: Record the sha256 and version of the PlanformDB file used, and its download location." ;
        pk:hasProbability "0.665"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-planform-morphology-animation> rdfs:label "PlanformDB planarian morphology animation faithfully reproduces Planaria (Schmidtea mediterranea, Dugesia japonica) morphology" ;
        dcterms:identifier "morphoeval/0.1.0/overall" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


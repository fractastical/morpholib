            pk:EvidenceItem ;
        rdfs:label "planform_morphology_gallery.png" ;
        dcterms:description "rendered output of 2013-lobo-planform-morphology.py at 161f269; sha256 pins the exact file that was scored; 1920×2160 px" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py> ;
        schema:contentSize "443915 B" ;
        schema:encodingFormat "image/png" ;

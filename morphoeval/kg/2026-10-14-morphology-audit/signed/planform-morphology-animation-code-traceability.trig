    <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Code-to-model traceability: 75/100" ;
        dcterms:date "2026-10-14"^^xsd:date ;
        dcterms:description "The decoding rule, the coordinate convention (+y anterior, wild-type head->trunk angle 3pi/2) and the cartoon convention are documented where they are implemented, and region_outline() names the figure it reproduces. The radii-count rule was established by checking the database rather than quoted from a numbered equation, because the papers describe the formalism in prose." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-code-traceability-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-code-traceability-2> ;
        pk:hasVerdict "mostly faithful" ;
        pk:weightOfEvidence 7.5e-01 .


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-planform-morphology-animation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-model-fidelity-0> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L20–L34" ;
        dcterms:description "formalism as implemented, with the radii-count rule" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L20-L34> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L286–L314" ;
        dcterms:description "control_points(): radii -> directions per link count" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L286-L314> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L248–L272" ;
        dcterms:description "layout(): centres from Dist/Ang, borders from Ratio" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L248-L272> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L701–L715" ;
        dcterms:description "check_encoding(): 1181/1181 regions obey the rule" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L701-L715> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L317–L355" ;
        dcterms:description "superellipse interpolant between radii (not from the source)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L317-L355> .

    <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Model fidelity to source: 85/100" ;
        dcterms:date "2026-10-14"^^xsd:date ;
        dcterms:description "Region shape parameters are interpreted with the formalism's own rule (0 links -> 4 radii right/anterior/left/posterior; 1 link -> +90/+180/+270 deg from the edge; k >= 2 links -> one radius per bisector of consecutive edges), region centres are placed from the RegionsLink Dist/Ang labels and borders at Ratio*Dist, and the rule is checked at load time against all 1181 regions in the database. The only element not taken from the source is how consecutive control radii are joined: a superellipse arc (n = 2.2 free, n = 7 at a border) chosen to reproduce Planform's Fig. 1D; the paper does not publish Planform's interpolant." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-model-fidelity-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-model-fidelity-4> ;
        pk:hasVerdict "faithful" ;
        pk:weightOfEvidence 8.5e-01 .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


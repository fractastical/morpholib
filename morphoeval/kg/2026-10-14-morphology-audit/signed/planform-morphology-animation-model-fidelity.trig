sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Model fidelity to source: 85/100" ;
        rdfs:comment "Region shape parameters are interpreted with the formalism's own rule (0 links -> 4 radii right/anterior/left/posterior; 1 link -> +90/+180/+270 deg from the edge; k >= 2 links -> one radius per bisector of consecutive edges), region centres are placed from the RegionsLink Dist/Ang labels and borders at Ratio*Dist, and the rule is checked at load time against all 1181 regions in the database. The only element not taken from the source is how consecutive control radii are joined: a superellipse arc (n = 2.2 free, n = 7 at a border) chosen to reproduce Planform's Fig. 1D; the paper does not publish Planform's interpolant. Evidence: 2013-lobo-planform-morphology.py L20–L34: formalism as implemented, with the radii-count rule <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L20-L34>; 2013-lobo-planform-morphology.py L286–L314: control_points(): radii -> directions per link count <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L286-L314>; 2013-lobo-planform-morphology.py L248–L272: layout(): centres from Dist/Ang, borders from Ratio <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L248-L272>; 2013-lobo-planform-morphology.py L701–L715: check_encoding(): 1181/1181 regions obey the rule <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L701-L715>; 2013-lobo-planform-morphology.py L317–L355: superellipse interpolant between radii (not from the source) <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L317-L355>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-planform-morphology-animation-model-fidelity> ;
        pk:hasProbability "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-planform-morphology-animation-model-fidelity> rdfs:label "PlanformDB planarian morphology animation (2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Model fidelity to source' for Planaria (Schmidtea mediterranea, Dugesia japonica)" ;
        dcterms:identifier "morphoeval/0.1.0/model-fidelity" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


    pk1:aristotelianPosonLaw "Head/Tail Polarity Outcomes" ;
    pk1:aristotelianSubalternClass "Zoophyta & Vermes (Cnidaria/Platyhelminthes)" ;
    pk1:biologicalGenus "Schmidtea" ;

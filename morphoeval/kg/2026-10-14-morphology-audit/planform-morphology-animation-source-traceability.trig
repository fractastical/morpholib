@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-planform-morphology-animation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Source and data traceability: 70/100" ;
        dct:date "2026-10-14"^^xsd:date ;
        dct:description "Both source papers are cited with DOIs in the module docstring, the database version is named and the schema tables used are listed. The database itself is still an external file located through PLANFORM_DB_PATH; no hash or download URL is recorded, so the exact input cannot be verified from the repository alone." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-source-traceability-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-source-traceability-1> ;
        pk:hasVerdict "mostly faithful" ;
        pk:weightOfEvidence 7e-01 .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-source-traceability-0> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L10–L16" ;
        dct:description "DOIs of both Lobo et al. 2013 papers" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L10-L16> .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L138–L146" ;
        dct:description "resolve_db_path(): env var or CLI, no provenance recorded" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L138-L146> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1093/bioinformatics/btt088>,
            <https://doi.org/10.1242/bio.20123400>,
            <https://github.com/fractastical/morpholib/commit/161f269>,
            <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .
}

sub:pubinfo {
    sub: rdfs:label "PlanformDB planarian morphology animation — Source and data traceability 70/100" ;
        dct:created "2026-10-14T00:00:00+00:00"^^xsd:dateTime ;
        dct:creator <https://orcid.org/0009-0007-4948-9192> ;

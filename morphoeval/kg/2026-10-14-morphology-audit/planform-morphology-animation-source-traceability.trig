sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Source and data traceability: 70/100" ;
        rdfs:comment "Both source papers are cited with DOIs in the module docstring, the database version is named and the schema tables used are listed. The database itself is still an external file located through PLANFORM_DB_PATH; no hash or download URL is recorded, so the exact input cannot be verified from the repository alone. Evidence: 2013-lobo-planform-morphology.py L10–L16: DOIs of both Lobo et al. 2013 papers <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L10-L16>; 2013-lobo-planform-morphology.py L138–L146: resolve_db_path(): env var or CLI, no provenance recorded <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L138-L146>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-planform-morphology-animation-source-traceability> ;
        pk:hasProbability "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-planform-morphology-animation-source-traceability> rdfs:label "PlanformDB planarian morphology animation (2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Planaria (Schmidtea mediterranea, Dugesia japonica)" ;
        dct:identifier "morphoeval/0.1.0/source-traceability" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1093/bioinformatics/btt088>,
            <https://doi.org/10.1242/bio.20123400> .
    <https://doi.org/10.1016/j.bpj.2017.04.011> dct:date "2017"^^xsd:gYear ;
        dct:title "Long-Term, Stochastic Editing of Regenerative Anatomy via Targeting Endogenous Bioelectric Gradients" .
    <https://doi.org/10.1093/bioinformatics/btt088> dct:date "2013"^^xsd:gYear ;
        dct:title "Planform: an application and database of graph-encoded planarian regenerative experiments" .
    <https://doi.org/10.1242/bio.20123400> dct:date "2013"^^xsd:gYear ;
        dct:title "Towards a bioinformatics of patterning: a computational approach to understanding regulative morphogenesis" .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Code-to-model traceability: 75/100" ;
        rdfs:comment "The decoding rule, the coordinate convention (+y anterior, wild-type head->trunk angle 3pi/2) and the cartoon convention are documented where they are implemented, and region_outline() names the figure it reproduces. The radii-count rule was established by checking the database rather than quoted from a numbered equation, because the papers describe the formalism in prose. Evidence: 2013-lobo-planform-morphology.py L35–L38: coordinate convention <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L35-L38>; 2013-lobo-planform-morphology.py L321–L331: region_outline() docstring: arc construction and Fig. 1D <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L321-L331>; 2013-lobo-planform-morphology.py L211–L244: load_first_report_year(): experiment->publication join documented <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L211-L244>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-planform-morphology-animation-code-traceability> ;
        pk:hasProbability "0.75"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-planform-morphology-animation-code-traceability> rdfs:label "PlanformDB planarian morphology animation (2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Planaria (Schmidtea mediterranea, Dugesia japonica)" ;
        dct:identifier "morphoeval/0.1.0/code-traceability" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1093/bioinformatics/btt088>,
            <https://doi.org/10.1242/bio.20123400> .
    <https://doi.org/10.1016/j.bpj.2017.04.011> dct:date "2017"^^xsd:gYear ;
        dct:title "Long-Term, Stochastic Editing of Regenerative Anatomy via Targeting Endogenous Bioelectric Gradients" .
    <https://doi.org/10.1093/bioinformatics/btt088> dct:date "2013"^^xsd:gYear ;
        dct:title "Planform: an application and database of graph-encoded planarian regenerative experiments" .
    <https://doi.org/10.1242/bio.20123400> dct:date "2013"^^xsd:gYear ;
        dct:title "Towards a bioinformatics of patterning: a computational approach to understanding regulative morphogenesis" .
}


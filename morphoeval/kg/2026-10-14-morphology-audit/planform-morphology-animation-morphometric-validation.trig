@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Morphometric validation: 45/100" ;
        rdfs:comment "The script computes silhouette morphometrics (AP length, ML width, aspect, area, region and organ counts, length relative to wild type) for every morphology and can write them as CSV, and the measurements sidecar checks the decoded wild type against the radii encoded in the database (560 x 120 units). Nothing is yet compared with measurements of real animals or with values reported in the literature; the reference is the formalism, not a specimen. Evidence: 2013-lobo-planform-morphology.py L386–L412: morphometrics() <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L386-L412>; 2013-lobo-planform-morphology.py L684–L698: write_csv() <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L684-L698>; 2013-lobo-planform-morphology.py L713–L714: wild-type AP/ML printed at load <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L713-L714>. Measurements (measure_outputs.py): wild-type silhouette AP length = 557.6 Planform units (reference 560, PlanformDB 2.5.0 RegionParam/RegionsLink of morphology 1 (80+200+200+80)) [union of decoded region outlines of Morphology 1, rasterised; bbox extent along the AP axis]; wild-type silhouette ML width = 119.8 Planform units (reference 120, trunk lateral radii 60+60) [as above, across the ML axis]; wild-type AP/ML aspect = 4.653 ratio (reference 4.667, encoded radii) [AP length / ML width of the decoded silhouette] — S. mediterranea in Lobo et al. 2013 Fig. 1A is of this order; the formalism, not a specimen, is the reference; morphologies rendered = 369 count [Morphology rows with at least one encoded region] — 372 rows in the database; 3 have no regions (Lethal, Midbody Buldge, Double head, side tail); distinct body silhouettes = 167 count (reference 369, upper bound: one silhouette per morphology) [unique (AP length, ML width, area to 100 units, #heads, #tails) tuples over all rendered morphologies] — 115 morphologies share the wild-type body and differ only in organs (ectopic eyes, doubled CNS, pharynx position, ...), which is how the database encodes them; distinct encodings (regions + links + organs) = 369 count (reference 369, every morphology row is a distinct phenotype) [unique tuples of every encoded number read from the database]; IoU wild type vs double head (#24) = 0.8884 ratio (reference < 1; the two bodies differ only at the posterior cap (tail -> second head), the rest of the difference is organs) [intersection-over-union of the two decoded silhouettes on a shared canvas (region centres aligned by layout)]; IoU wild type vs headless (#20) = 0.6116 ratio (reference ≈ (trunk+tail area)/(whole-body area) if the head is simply absent) [as above]." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-planform-morphology-animation-morphometric-validation> ;
        pk:hasProbability "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-planform-morphology-animation-morphometric-validation> rdfs:label "PlanformDB planarian morphology animation (2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Morphometric validation' for Planaria (Schmidtea mediterranea, Dugesia japonica)" ;
        dct:identifier "morphoeval/0.1.0/morphometric-validation" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1093/bioinformatics/btt088>,
            <https://doi.org/10.1242/bio.20123400> .
    <https://doi.org/10.1016/j.bpj.2017.04.011> dct:date "2017"^^xsd:gYear ;
        dct:title "Long-Term, Stochastic Editing of Regenerative Anatomy via Targeting Endogenous Bioelectric Gradients" .
    <https://doi.org/10.1093/bioinformatics/btt088> dct:date "2013"^^xsd:gYear ;
        dct:title "Planform: an application and database of graph-encoded planarian regenerative experiments" .
    <https://doi.org/10.1242/bio.20123400> dct:date "2013"^^xsd:gYear ;
        dct:title "Towards a bioinformatics of patterning: a computational approach to understanding regulative morphogenesis" .
}


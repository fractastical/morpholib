@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-planform-morphology-animation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Morphometric validation: 45/100" ;
        dct:date "2026-10-14"^^xsd:date ;
        dct:description "The script computes silhouette morphometrics (AP length, ML width, aspect, area, region and organ counts, length relative to wild type) for every morphology and can write them as CSV, and the measurements sidecar checks the decoded wild type against the radii encoded in the database (560 x 120 units). Nothing is yet compared with measurements of real animals or with values reported in the literature; the reference is the formalism, not a specimen." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m1>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m2>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m3>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m4>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m5>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m6>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m7>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-validation-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-validation-2> ;
        pk:hasVerdict "partially faithful" ;
        pk:weightOfEvidence 4.5e-01 .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type silhouette AP length: 557.6 Planform units" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py> ;
        schema:measurementTechnique "union of decoded region outlines of Morphology 1, rasterised; bbox extent along the AP axis" ;
        schema:name "wild-type silhouette AP length" ;
        schema:unitText "Planform units" ;
        schema:value 5.576e+02 ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m0-reference> .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m0-reference> a schema:PropertyValue ;
        dct:source "PlanformDB 2.5.0 RegionParam/RegionsLink of morphology 1 (80+200+200+80)" ;
        schema:name "reference for: wild-type silhouette AP length" ;
        schema:value 560 .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type silhouette ML width: 119.8 Planform units" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py> ;
        schema:measurementTechnique "as above, across the ML axis" ;
        schema:name "wild-type silhouette ML width" ;
        schema:unitText "Planform units" ;
        schema:value 1.198e+02 ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m1-reference> .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m1-reference> a schema:PropertyValue ;
        dct:source "trunk lateral radii 60+60" ;
        schema:name "reference for: wild-type silhouette ML width" ;
        schema:value 120 .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type AP/ML aspect: 4.653 ratio" ;
        dct:description "S. mediterranea in Lobo et al. 2013 Fig. 1A is of this order; the formalism, not a specimen, is the reference" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py> ;
        schema:measurementTechnique "AP length / ML width of the decoded silhouette" ;
        schema:name "wild-type AP/ML aspect" ;
        schema:unitText "ratio" ;
        schema:value 4.653e+00 ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m2-reference> .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m2-reference> a schema:PropertyValue ;
        dct:source "encoded radii" ;
        schema:name "reference for: wild-type AP/ML aspect" ;
        schema:value 4.667e+00 .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "morphologies rendered: 369 count" ;
        dct:description "372 rows in the database; 3 have no regions (Lethal, Midbody Buldge, Double head, side tail)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py> ;
        schema:measurementTechnique "Morphology rows with at least one encoded region" ;
        schema:name "morphologies rendered" ;
        schema:unitText "count" ;
        schema:value 369 .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m4> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "distinct body silhouettes: 167 count" ;
        dct:description "115 morphologies share the wild-type body and differ only in organs (ectopic eyes, doubled CNS, pharynx position, ...), which is how the database encodes them" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py> ;
        schema:measurementTechnique "unique (AP length, ML width, area to 100 units, #heads, #tails) tuples over all rendered morphologies" ;
        schema:name "distinct body silhouettes" ;
        schema:unitText "count" ;
        schema:value 167 ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m4-reference> .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m4-reference> a schema:PropertyValue ;
        dct:source "upper bound: one silhouette per morphology" ;
        schema:name "reference for: distinct body silhouettes" ;
        schema:value 369 .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m5> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "distinct encodings (regions + links + organs): 369 count" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py> ;
        schema:measurementTechnique "unique tuples of every encoded number read from the database" ;
        schema:name "distinct encodings (regions + links + organs)" ;
        schema:unitText "count" ;
        schema:value 369 ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m5-reference> .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m5-reference> a schema:PropertyValue ;
        dct:source "every morphology row is a distinct phenotype" ;
        schema:name "reference for: distinct encodings (regions + links + organs)" ;
        schema:value 369 .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "IoU wild type vs double head (#24): 0.8884 ratio" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py> ;
        schema:measurementTechnique "intersection-over-union of the two decoded silhouettes on a shared canvas (region centres aligned by layout)" ;
        schema:name "IoU wild type vs double head (#24)" ;
        schema:unitText "ratio" ;
        schema:value 8.884e-01 ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m6-reference> .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m6-reference> a schema:PropertyValue ;
        schema:name "reference for: IoU wild type vs double head (#24)" ;
        schema:value "< 1; the two bodies differ only at the posterior cap (tail -> second head), the rest of the difference is organs" .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m7> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "IoU wild type vs headless (#20): 0.6116 ratio" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py> ;
        schema:measurementTechnique "as above" ;
        schema:name "IoU wild type vs headless (#20)" ;
        schema:unitText "ratio" ;
        schema:value 6.116e-01 ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m7-reference> .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-m7-reference> a schema:PropertyValue ;
        schema:name "reference for: IoU wild type vs headless (#20)" ;
        schema:value "≈ (trunk+tail area)/(whole-body area) if the head is simply absent" .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-validation-0> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L386–L412" ;
        dct:description "morphometrics()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L386-L412> .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L684–L698" ;
        dct:description "write_csv()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L684-L698> .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-morphology-audit-planform-morphology-animation-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L713–L714" ;
        dct:description "wild-type AP/ML printed at load" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L713-L714> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Gekko gecko Turing wavenumber at 242 µm (Holocene, Pass 1) faithfully reproduces Gekko gecko (Tokay gecko) morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-gekko-gecko-turing-wavelength-s0.py, docs/media/gekko_gecko_turing_wavelength_s0_comparison.png implement the cited source model as published and produce forms that match real Gekko gecko (Tokay gecko) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/media/gekko_gecko_turing_wavelength_s0_comparison.png>,
            <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gekko-gecko-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gekko-gecko-turing-wavelength-s0.py, https://github.com/fractastical/morpholib/blob/main/docs/media/gekko_gecko_turing_wavelength_s0_comparison.png; output: docs/media/gekko_gecko_turing_wavelength_s0_growth.gif; organism: Gekko gecko (Tokay gecko); environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion relation for a two-species reaction-diffusion system. | Murray 1981 use of that wavelength as a coat pre-pattern. | Manukyan 2017 and Fofonjka 2021: reptile skin can carry a mesoscopic reaction-diffusion pattern (Timon, not Gekko). | Saenko 2013: gekkotan color colocalizes structural and pigment cells (Phelsuma, not Gekko).; reconstructed_in_script: Schnakenberg field with (a, b) = (0.137, 0.863) and diffusion ratio 1.35 times critical, calibrated so k_c = argmax sigma(k) gives 242 µm. | Periodic 1936 µm × 1452 µm patch, seed 3235, 12-frame growth GIF.; transfer_boundary: 242 µm is the slot's primordium detail scale, not a published caliper measurement on Gekko gecko. | The Dupont photograph has no scale bar; it constrains pattern class only.; does_not_claim: That adult Tokay ocelli are 242 µm apart. | That Tokay chromatophores implement the Timon scale automaton. | That setal adhesion spacing is this pigment wavelength.]; other sources: Tokay Gecko (Gekko gecko), Wanree Resort, Pak Chong, Thailand <https://commons.wikimedia.org/wiki/File:Tokay_Gecko_(Gekko_gecko)_(7109782823).jpg>; phenomenon_size: 200 µm (0.0002 m, log10=-3.699 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 200 µm to 57.6 cm): 200 µm:gekko-gecko-bioelectric-polarity, 712 µm:gekko-gecko-vertex-packing, 1.3 cm:gekko-gecko-turing-wavelength, 2.4 cm:gekko-gecko-clock-wavefront, 4.2 cm:gekko-gecko-morphogen-condensation, 5.4 cm:gekko-gecko-flux-canalization, 5.9 cm:gekko-gecko-elastic-buckling, 6.9 cm:gekko-gecko-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1038/nature22031>,
            <https://doi.org/10.1038/s41467-021-22525-1>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1186/1741-7007-11-105> .
    <https://github.com/fractastical/morpholib/blob/main/docs/media/gekko_gecko_turing_wavelength_s0_comparison.png> a schema:SoftwareSourceCode ;
        rdfs:label "docs/media/gekko_gecko_turing_wavelength_s0_comparison.png" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gekko-gecko-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-gekko-gecko-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://commons.wikimedia.org/wiki/File:Tokay_Gecko_(Gekko_gecko)_(7109782823).jpg>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1038/nature22031>,
            <https://doi.org/10.1038/s41467-021-22525-1>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1186/1741-7007-11-105> .
    <https://commons.wikimedia.org/wiki/File:Tokay_Gecko_(Gekko_gecko)_(7109782823).jpg> dct:date "2005"^^xsd:gYear ;
        dct:title "Tokay Gecko (Gekko gecko), Wanree Resort, Pak Chong, Thailand" .
    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:date "1981"^^xsd:gYear ;
        dct:title "A pre-pattern formation mechanism for animal coat markings" .
    <https://doi.org/10.1038/nature22031> dct:date "2017"^^xsd:gYear ;
        dct:title "A living mesoscopic cellular automaton made of skin scales" .
    <https://doi.org/10.1038/s41467-021-22525-1> dct:date "2021"^^xsd:gYear ;
        dct:title "Reaction-diffusion in a growing 3D domain of skin scales generates a discrete cellular automaton" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1186/1741-7007-11-105> dct:date "2013"^^xsd:gYear ;
        dct:title "Precise colocalization of interacting structural and pigmentary elements generates extensive color pattern variation in Phelsuma lizards" .
}


    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Gekko gecko Turing wavenumber at 242 µm (Holocene, Pass 1) — Morphometric validation: 68/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Self-test locks the linear wavelength at 242 µm. Specimen blob spacing, coherency, KS, and the nonlinear ring centroid are not yet in the measurement sidecar." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-ablation-control-field-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-analytic-selected-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-selected-ocellus-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-specimen-ocellus-nearest-neighbor-spacing-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-specimen-versus-simulation-grayscale-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-wavelength-sweep-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-ablation-control-field-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation control field std = 0.05082 concentration" ;
        dct:description "pattern/ablation std ratio 21.3; KS D pattern vs ablation = 0.685" ;
        schema:measurementTechnique "final std(u) with D_v = D_u (below r_crit), same noise and reaction" ;
        schema:name "ablation control field std" ;
        schema:unitText "concentration" ;
        schema:value "0.05082" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-ablation-control-field-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-ablation-control-field-std-reference> a schema:PropertyValue ;
        dct:source "final std(u) at the operating diffusion ratio R_DIFF" ;
        schema:value "1.0821" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-analytic-selected-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "analytic selected wavelength = 242.0 µm" ;
        dct:description "Calibration target. The measured ring centroid is the non-equal companion metric." ;
        schema:measurementTechnique "λ = 2π / k_c with k_c = argmax_k σ(k) after diffusivity calibration" ;
        schema:name "analytic selected wavelength" ;
        schema:unitText "µm" ;
        schema:value "242.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-analytic-selected-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-analytic-selected-wavelength-reference> a schema:PropertyValue ;
        dct:source "slot scale assignment, detail variant of tier 5_primordium_100um" ;
        schema:value "242.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-selected-ocellus-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "selected ocellus stripe wavelength = 232.994 µm" ;
        dct:description "Realized nonlinear spacing is not forced equal to the linear k_c." ;
        schema:measurementTechnique "power-weighted Fourier ring centroid of the saturated activator field" ;
        schema:name "selected ocellus stripe wavelength" ;
        schema:unitText "µm" ;
        schema:value "232.994" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-selected-ocellus-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-selected-ocellus-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "k_c = argmax σ(k) calibrated to 242 µm (Turing dispersion)" ;
        schema:value "242.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-specimen-ocellus-nearest-neighbor-spacing-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen ocellus nearest-neighbor spacing fraction = 0.046 fraction of frame width" ;
        dct:description "specimen count 95; simulation count 51" ;
        schema:measurementTechnique "orange-pixel segmentation, mean nearest centroid distance / width on the Dupont dorsum crop" ;
        schema:name "specimen ocellus nearest-neighbor spacing fraction" ;
        schema:unitText "fraction of frame width" ;
        schema:value "0.046" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-specimen-ocellus-nearest-neighbor-spacing-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-specimen-ocellus-nearest-neighbor-spacing-fraction-reference> a schema:PropertyValue ;
        dct:source "same orange rule applied to the rendered activator field, resized to the crop" ;
        schema:value "0.0939" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.4594 coherency" ;
        dct:description "Photograph includes granular scales; the RD field does not, so coherency is not equal." ;
        schema:measurementTechnique "mean (λ1−λ2)/(λ1+λ2) of the luminance structure tensor on the dorsum crop" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.4594" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "same operator on the rendered Schnakenberg field" ;
        schema:value "0.734" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-specimen-versus-simulation-grayscale-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen-versus-simulation grayscale KS statistic = 0.4307 KS D" ;
        dct:description "p=0. Not a self-comparison." ;
        schema:measurementTechnique "two-sample KS on 4000 luminance pixels from the dorsum crop and the render" ;
        schema:name "specimen-versus-simulation grayscale KS statistic" ;
        schema:unitText "KS D" ;
        schema:value "0.4307" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-specimen-versus-simulation-grayscale-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-specimen-versus-simulation-grayscale-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "D = 0 would mean the grayscale distributions were the same" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength sweep Pearson r = 1.0 correlation" ;
        dct:description "RMSE 10.08 µm; p=1.85e-30" ;
        schema:measurementTechnique "Pearson r of analytic λ_c(s)=242√s versus ring-centroid λ across six diffusivity scales" ;
        schema:name "wavelength sweep Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-reference> a schema:PropertyValue ;
        dct:source "MorphoEval gate for this loop (threshold, not a fitted target)" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-wavelength-sweep-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength sweep RMSE = 10.079 µm" ;
        dct:description "A nonzero RMSE is the supercritical shift of the saturated spots." ;
        schema:measurementTechnique "RMSE between analytic λ_c(s) and measured ring centroid" ;
        schema:name "wavelength sweep RMSE" ;
        schema:unitText "µm" ;
        schema:value "10.079" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-wavelength-sweep-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-measurement-wavelength-sweep-rmse-reference> a schema:PropertyValue ;
        dct:source "zero error would mean the nonlinear spots sit exactly on linear k_c" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gekko-gecko-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gekko-gecko-turing-wavelength-s0.py L242–L259" ;
        dct:description "ring-centroid wavelength in micrometres" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gekko-gecko-turing-wavelength-s0.py#L242-L259> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://commons.wikimedia.org/wiki/File:Tokay_Gecko_(Gekko_gecko)_(7109782823).jpg>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1038/nature22031>,
            <https://doi.org/10.1038/s41467-021-22525-1>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1186/1741-7007-11-105> .
    <https://commons.wikimedia.org/wiki/File:Tokay_Gecko_(Gekko_gecko)_(7109782823).jpg> dct:date "2005"^^xsd:gYear ;
        dct:title "Tokay Gecko (Gekko gecko), Wanree Resort, Pak Chong, Thailand" .
    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:date "1981"^^xsd:gYear ;
        dct:title "A pre-pattern formation mechanism for animal coat markings" .
    <https://doi.org/10.1038/nature22031> dct:date "2017"^^xsd:gYear ;
        dct:title "A living mesoscopic cellular automaton made of skin scales" .
    <https://doi.org/10.1038/s41467-021-22525-1> dct:date "2021"^^xsd:gYear ;
        dct:title "Reaction-diffusion in a growing 3D domain of skin scales generates a discrete cellular automaton" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1186/1741-7007-11-105> dct:date "2013"^^xsd:gYear ;
        dct:title "Precise colocalization of interacting structural and pigmentary elements generates extensive color pattern variation in Phelsuma lizards" .
}


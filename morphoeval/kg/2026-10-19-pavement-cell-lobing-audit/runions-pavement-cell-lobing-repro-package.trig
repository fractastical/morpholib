sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-runions-pavement-cell-lobing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Sapala et al. (2018) & Fu et al. (2005) ROP2-ROP6 interdigitated puzzle-shaped pavement cell lobing and Largest Empty Circle (LEC) turgor stress scaling — Reproducibility package: 54/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Runs deterministically to generate PNG and GIF outputs, but lacks a comprehensive 8-check `--self-test` suite, SHA-256 dataset verification, and mutant negative controls." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2017-runions-pavement-cell-lobing.py L108–L120: Minimal 2-metric self-test without physics or specimen checks <https://github.com/fractastical/morpholib/blob/8871db0/2017-runions-pavement-cell-lobing.py#L108-L120>" ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 039 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-runions-pavement-cell-lobing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Sapala et al. (2018) & Fu et al. (2005) ROP2-ROP6 interdigitated puzzle-shaped pavement cell lobing and Largest Empty Circle (LEC) turgor stress scaling — Morphometric validation: 52/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Exposes only 2 analytical ratios in `measure_morphoeval()` without PDE cross-correlation metrics, statistical p-values, lobeyness/solidity genotype comparisons, or empirical specimen segmentation metrics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2017-runions-pavement-cell-lobing.py L48–L65: Only 2 analytical measurements without uncertainty or p-values <https://github.com/fractastical/morpholib/blob/8871db0/2017-runions-pavement-cell-lobing.py#L48-L65>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-isotropic-vs-puzzle-stress-ratio-at-4500um2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-mature-lec-radius-at-4500um2> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-isotropic-vs-puzzle-stress-ratio-at-4500um2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "isotropic_vs_puzzle_stress_ratio_at_4500um2 = 3.307 ratio" ;
        schema:measurementTechnique "Ratio of unlobed isotropic circle stress to puzzle-lobed cell stress at A = 4500 um^2" ;
        schema:name "isotropic_vs_puzzle_stress_ratio_at_4500um2" ;
        schema:unitText "ratio" ;
        schema:value "3.307" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-isotropic-vs-puzzle-stress-ratio-at-4500um2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-isotropic-vs-puzzle-stress-ratio-at-4500um2-reference> a schema:PropertyValue ;
        dct:source "Sapala et al. (2018) eLife 7:e32794 Fig. 1 & Box 1" ;
        schema:value "3.32" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-mature-lec-radius-at-4500um2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wt_mature_lec_radius_at_4500um2 = 11.444 um" ;
        schema:measurementTechnique "Analytical asymptotic neck radius R_LEC(A)" ;
        schema:name "wt_mature_lec_radius_at_4500um2" ;
        schema:unitText "um" ;
        schema:value "11.444" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-mature-lec-radius-at-4500um2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-mature-lec-radius-at-4500um2-reference> a schema:PropertyValue ;
        dct:source "Sapala et al. (2018) eLife 7:e32794 Fig. 2-3" ;
        schema:value "11.4" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 039 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/39> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2004.12.026>,
            <https://doi.org/10.1016/j.cub.2013.01.022>,
            <https://doi.org/10.1038/s41477-019-0500-2>,
            <https://doi.org/10.7554/eLife.32794> .
    <https://doi.org/10.1016/j.cell.2004.12.026> dct:date "2005"^^xsd:gYear ;
        dct:title "Arabidopsis Interdigitating Cell Growth Requires Two Antagonistic Pathways with Opposing Action on Cell Morphogenesis" .
    <https://doi.org/10.1016/j.cub.2013.01.022> dct:date "2013"^^xsd:gYear ;
        dct:title "Rho GTPase Signaling Activates Microtubule Severing to Promote Lobe Outgrowth in Arabidopsis Pavement Cells" .
    <https://doi.org/10.1038/s41477-019-0500-2> dct:date "2019"^^xsd:gYear ;
        dct:title "Mechanical stress initiates and sustains the morphogenesis of wavy leaf epidermal cells" .
    <https://doi.org/10.7554/eLife.32794> dct:date "2018"^^xsd:gYear ;
        dct:title "Why plants make puzzle cells, and how their shape emerges" .
}


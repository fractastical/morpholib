        rdfs:label "Sapala et al. (2018) & Fu et al. (2005) ROP2-ROP6 interdigitated puzzle-shaped pavement cell lobing and Largest Empty Circle (LEC) turgor stress scaling — Morphological realism / specimen match: 45/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors `datasets/pavement_cell_lobing/arabidopsis_pavement_cell_specimen.jpg` on disk, but Pass 1 does not load, segment, or measure cell contours, lobeyness, solidity, or LEC radii from the Arabidopsis leaf epidermis micrograph." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2017-runions-pavement-cell-lobing.py L68–L92: Renders 2-panel idealized plot without specimen image analysis <https://github.com/fractastical/morpholib/blob/8871db0/2017-runions-pavement-cell-lobing.py#L68-L92>" ;
        pk:hasScore "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

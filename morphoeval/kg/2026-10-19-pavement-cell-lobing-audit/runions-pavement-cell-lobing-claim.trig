sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-runions-pavement-cell-lobing> a pk:Claim ;
        rdfs:label "Sapala et al. (2018) & Fu et al. (2005) ROP2-ROP6 interdigitated puzzle-shaped pavement cell lobing and Largest Empty Circle (LEC) turgor stress scaling faithfully reproduces Arabidopsis thaliana (cotyledon & leaf epidermal pavement cells) morphology" ;
        dct:description "The simulation script(s) 2017-runions-pavement-cell-lobing.py implement the cited source model as published and produce forms that match real Arabidopsis thaliana (cotyledon & leaf epidermal pavement cells) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 53.0/100, audit 2026-10-19-pavement-cell-lobing-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/2017-runions-pavement-cell-lobing.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2017-runions-pavement-cell-lobing.py; output: docs/media/pavement_cell_lobing_comparison.png; organism: Arabidopsis thaliana (cotyledon & leaf epidermal pavement cells); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 972460a5749d7d30868f5de9c61bcfd278fa143f89d629090a75b7aa4ebdc287; artifact_sha256: 8e3b33e9aa4c563a678f37b5c0d41f8f4f666780c18827ebdd4a622608c122a2; input_dataset_sha256: {datasets/pavement_cell_lobing/arabidopsis_pavement_cell_specimen.jpg=4b7c1062f6ebfd6e..., datasets/pavement_cell_lobing/paper_citations.bib=e5d0ea8ec26365c9..., datasets/pavement_cell_lobing/pavement_cell_lobing_reference.json=de4e6daab5eae4a0..., datasets/pavement_cell_lobing/scout_manifest.json=72c917ec10ac1a55...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.cell.2004.12.026>,
            <https://doi.org/10.1016/j.cub.2013.01.022>,
            <https://doi.org/10.1038/s41477-019-0500-2>,
            <https://doi.org/10.7554/eLife.32794> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-specimen-match> ;
        pk:weightOfEvidence "0.53"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/8871db0/2017-runions-pavement-cell-lobing.py> a schema:SoftwareSourceCode ;
        rdfs:label "2017-runions-pavement-cell-lobing.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "8871db0" .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg within-feather Turing wavelength of Anas platyrhynchos at 378.4 µm (Pass 1) — Parameter expressivity: 80/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "q = 0 with an axial seed makes bars (orientation ratio 234); q = 0.55 makes a spot/ocellus field (orientation ratio 0.71). Equal diffusion drives the amplitude down by about 1e-5. The Du sweep exists but is not yet the pass-1 fitness claim." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-anas-platyrhynchos-turing-wavelength-s0.py L236–L264" ;
        dct:description "Du sweep of analytical versus measured k_star" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7f178d2f869f94ba7cd9d9e01aa00da67845de72/models/2026-delphi10000-anas-platyrhynchos-turing-wavelength-s0.py#L236-L264> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-anas-platyrhynchos-turing-wavelength-s0.py L266–L294" ;
        dct:description "equal-diffusion and reaction-off controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7f178d2f869f94ba7cd9d9e01aa00da67845de72/models/2026-delphi10000-anas-platyrhynchos-turing-wavelength-s0.py#L266-L294> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


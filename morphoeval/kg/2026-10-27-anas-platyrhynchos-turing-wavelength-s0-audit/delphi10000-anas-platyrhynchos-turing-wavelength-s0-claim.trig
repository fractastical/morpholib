sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Schnakenberg within-feather Turing wavelength of Anas platyrhynchos at 378.4 µm (Pass 1) faithfully reproduces Anas platyrhynchos (Holocene, 0 Ma) morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-anas-platyrhynchos-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Anas platyrhynchos (Holocene, 0 Ma) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-anas-platyrhynchos-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-anas-platyrhynchos-turing-wavelength-s0.py; output: docs/media/anas_platyrhynchos_turing_wavelength_s0_comparison.png; organism: Anas platyrhynchos (Holocene, 0 Ma); environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion relation and the diffusion-driven instability conditions. | Schnakenberg 1979 kinetics f = a - u + u^2 v, g = b - u^2 v. | Prum & Williamson 2002: within-feather bars, stripes, and spots can be reaction-diffusion patterns. | Inaba & Chuong 2020: macro body pattern and micro within-feather pattern are different levels. | Stavenga et al. 2017: mallard speculum hue is a multilayer, not a pigment wavenumber.; reconstructed_in_script: Near-onset deviation PDE with cubic saturation and an optional quadratic term q U^2. | lambda_star pinned to the campaign anchor 0.0003784 m, not to a published mallard measurement.; transfer_boundary: The Anas chronoseries is 1/1 at 0 Ma. Scale neighbours (348 µm bioelectric, 1.3 mm vertex packing, 2.4 cm plumage block) are other laws or another length, not other chronospecies.; does_not_claim: That 378.4 µm was measured on a mallard feather in the cited papers. | That the green head or the speculum is a Turing pigment. | That the pass-1 vane GIF matches the drake photograph.]; phenomenon_size: 348 µm (0.0003476 m, log10=-3.459 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 348 µm to 1.06 m): 348 µm:anas-platyrhynchos-bioelectric-polarity, 1.3 mm:anas-platyrhynchos-vertex-packing, 2.4 cm:anas-platyrhynchos-turing-wavelength, 4.4 cm:anas-platyrhynchos-clock-wavefront, 7.1 cm:anas-platyrhynchos-morphogen-condensation, 10.4 cm:anas-platyrhynchos-elastic-buckling, 17.6 cm:anas-platyrhynchos-flux-canalization, 23.3 cm:anas-platyrhynchos-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1098/rsif.2017.0407>,
            <https://doi.org/10.1098/rspb.2001.1896>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.3389/fcell.2020.00620> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-anas-platyrhynchos-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-anas-platyrhynchos-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


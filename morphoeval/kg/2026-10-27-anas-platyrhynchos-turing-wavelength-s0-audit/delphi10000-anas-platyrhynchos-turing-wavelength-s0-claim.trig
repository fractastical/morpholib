    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1098/rsif.2017.0407> dct:date "2017"^^xsd:gYear ;
        dct:title "Structural coloured feathers of mallards act by simple multilayer photonics" .
    <https://doi.org/10.1098/rspb.2001.1896> dct:date "2002"^^xsd:gYear ;
        dct:title "Reaction-diffusion models of within-feather pigmentation patterning" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.3389/fcell.2020.00620> dct:date "2020"^^xsd:gYear ;
        dct:title "Avian pigment pattern formation: developmental control of macro- and micro-level pigment patterns" .
}


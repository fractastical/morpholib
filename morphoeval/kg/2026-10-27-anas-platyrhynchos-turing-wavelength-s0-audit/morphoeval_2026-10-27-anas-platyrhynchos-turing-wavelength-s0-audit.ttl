<https://w3id.org/delphi/resource/math-law/delphi10000-anas-platyrhynchos-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg steady state and negative trace" ;
    dct:description "Homogeneous state is stable to uniform perturbations at 0 Ma | Variables: a=0.10, b=0.90, f_u=0.80, g_v=-1" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7f178d2f869f94ba7cd9d9e01aa00da67845de72/models/2026-delphi10000-anas-platyrhynchos-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/7f178d2f869f94ba7cd9d9e01aa00da67845de72/morphoeval/lean/loops/Loop_3110_anas_platyrhynchos_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u* = a + b, f_u + g_v < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rsif.2017.0407>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.3389/fcell.2020.00620> ;
    pk:hypothesisType "Schnakenberg reaction-diffusion and Turing wavenumber k_c" ;
    pk:leanDeclaration "MathOfBiology.Loop_3110.traceScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3110.trace_is_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-anas-platyrhynchos-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber k_c" ;
    dct:description "Critical wavenumber of the within-feather pigment stripe at 378.4 µm | Variables: r=Dv/Du=16, lambda_star=0.0003784 m" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7f178d2f869f94ba7cd9d9e01aa00da67845de72/models/2026-delphi10000-anas-platyrhynchos-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/7f178d2f869f94ba7cd9d9e01aa00da67845de72/morphoeval/lean/loops/Loop_3110_anas_platyrhynchos_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (Dv f_u + Du g_v) / (2 Du Dv), lambda = 2 pi / k" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rsif.2017.0407>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.3389/fcell.2020.00620> ;
    pk:hypothesisType "Schnakenberg reaction-diffusion and Turing wavenumber k_c" ;
    pk:leanDeclaration "MathOfBiology.Loop_3110.detScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3110.discriminant_above_onset" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-anas-platyrhynchos-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail versus organism wavelength split" ;
    dct:description "What changes at this scale versus the 2.4 cm sibling at the same Holocene age | Variables: lambda_detail=0.0003784 m, lambda_organism_sibling=0.02354 m, age_ma=0" ;
    dct:source "Inaba and Chuong 2020 DOI:10.3389/fcell.2020.00620" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7f178d2f869f94ba7cd9d9e01aa00da67845de72/models/2026-delphi10000-anas-platyrhynchos-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/7f178d2f869f94ba7cd9d9e01aa00da67845de72/morphoeval/lean/loops/Loop_3110_anas_platyrhynchos_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "62 * 378.4 µm + 79.2 µm = 23540 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rsif.2017.0407>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.3389/fcell.2020.00620> ;
    pk:hypothesisType "Schnakenberg reaction-diffusion and Turing wavenumber k_c" ;
    pk:leanDeclaration "MathOfBiology.Loop_3110.detail_wavelengths_inside_organism_sibling" ;
    pk:leanTheorem "MathOfBiology.Loop_3110.detail_wavelengths_inside_organism_sibling" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .

<https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
    rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
    dct:identifier "grok-4.7" ;

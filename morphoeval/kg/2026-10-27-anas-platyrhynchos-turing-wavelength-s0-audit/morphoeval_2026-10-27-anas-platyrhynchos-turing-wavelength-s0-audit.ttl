<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg within-feather Turing wavelength of Anas platyrhynchos at 378.4 µm (Pass 1) — Morphological realism / specimen match: 58/100" ;

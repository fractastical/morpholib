sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-meinhardt-echinoderm-pentaradial-symmetry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Morris (2012), Mooi & David (1998/2008), Lovén (1874), Duboc et al. (2005), Luo & Su (2012) & Meinhardt (2008) echinoderm bilateral-to-pentaradial hydrocoel ring symmetry breaking with Ocular Plate Rule test growth — Morphometric validation: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: 16 reference-anchored measurements (9 from v2 + 7 new, L1576-1646), each with reference_value, unit, method and source; the Nodal dose-response deviation from Law 3 (0.055 podia) and the enlargement ablation are genuine model-vs-target tests; the alternation phase (0.49 vs 0.5) and Amb/IA ratio (2.06 vs ~3.0) are reported honestly including the miss. Deductions: `newest_at_ocular_fraction` = 1.0, the non-decreasing plate counts and Spearman rho = 0.9995 hold by construction of ocular-end nucleation (L627-631) — the method text says so (L1591) but they are counted as validations (-4); the alternation phase 0.49 follows from the chosen enlargement factor 1.5 (JSON), so its magnitude is semi-circular (-2); the aboral C_5 reference is the specimen's own value through the same pipeline and the specimen C_5 reference 0.9255 (L1735) is the script's own output (-3); the Nodal max |dev| is partly circular because K_N, K_B, lambda_N, lambda_B were tuned to the three targets, and EC50 has no empirical reference (-2); the Amb/IA reference 3.0 is unsourced (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "datasets/echinoderm_pentaradial_symmetry/opr_plate_addition_nodal_dose_reference.json L60–L70: structural_reference_values: Amb/IA ratio 3.0 justified only as 'trigeminate compounding', not a measured count <https://github.com/fractastical/morpholib/blob/a69596cc/datasets/echinoderm_pentaradial_symmetry/opr_plate_addition_nodal_dose_reference.json#L60-L70>",
            "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L1586–L1592: newest-at-ocular measurement whose method text concedes it 'holds by construction of ocular-end nucleation' <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L1586-L1592>",
            "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L1733–L1740: Specimen C_5 reference_value 0.9255 is the script's own segmentation output (self-referential) <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L1733-L1740>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-canonical-hydrocoel-ring-primary-podia-mode-m-at-r-ring-75-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-continuous-nodal-bmp2-4-dose-response-max-expected-podia-discrete-law-3-over-wt-nodal-mo-and-bilateral-gof-doses>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-duboc-et-al-2005-nodal-morpholino-knockdown-twin-rudiment-primary-podia-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-equal-diffusion-negative-control-d-h-d-a-emergent-podia-lobe-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-hydrocoel-ring-mode-staircase-correlation-across-m-in-3-4-5-6-7>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-lov-n-s-law-ii-iv-i-iii-v-crescent-initiation-sequence-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-ambulacral-interambulacral-primary-plate-count-ratio-at-adult-size>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-biserial-ambulacral-column-alternation-phase-0-5-perfect-lov-n-zigzag-suture>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-domed-test-meridional-column-count-5-biserial-ambulacra-5-biserial-interambulacra>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-newest-plate-adjacent-to-ocular-fraction-across-all-20-columns-at-adult-size>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-synthetic-test-aboral-projection-c-5-fundamental-fourier-power-fraction-vs-tripneustes-gratilla-specimen>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-total-corona-plate-count-vs-test-radius-spearman-correlation-plate-addition-throughout-growth>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-pentaradial-inter-ambulacral-angular-spacing-delta-theta-on-closed-hydrocoel-ring>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-tripneustes-gratilla-test-specimen-c-5-fundamental-fourier-harmonic-power-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-tripneustes-gratilla-test-specimen-detected-ambulacral-ray-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-tripneustes-gratilla-test-specimen-mean-inter-ambulacral-angular-spacing>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-morphometric-validation-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-canonical-hydrocoel-ring-primary-podia-mode-m-at-r-ring-75-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Canonical hydrocoel ring primary podia mode m^* at R_ring=75 um = 5.0 lobes" ;
        dct:description "Mean angular spacing = 72.00 deg" ;
        schema:measurementTechnique "Peak count of Gierer-Meinhardt circular-ring PDE at 2*pi*R_ring/lambda_c = 5.0" ;
        schema:name "Canonical hydrocoel ring primary podia mode m^* at R_ring=75 um" ;
        schema:unitText "lobes" ;
        schema:value "5.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-canonical-hydrocoel-ring-primary-podia-mode-m-at-r-ring-75-um-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-canonical-hydrocoel-ring-primary-podia-mode-m-at-r-ring-75-um-reference> a schema:PropertyValue ;
        dct:source "Morris (2012) Evol. Dev. 14:313-326 & Lean 4 theorem hydrocoel_ring_pentaradial_mode5_selection" ;
        schema:value "5.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-continuous-nodal-bmp2-4-dose-response-max-expected-podia-discrete-law-3-over-wt-nodal-mo-and-bilateral-gof-doses> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Continuous Nodal/BMP2-4 dose-response: max |expected podia - discrete Law 3| over WT, Nodal MO and bilateral GOF doses = 0.0548 podia" ;
        dct:description "E[podia] WT/MO/GOF = [5.003, 9.945, 0.009]; EC50 (right pouch) = 0.1752 x WT dose; Spearman rho(P_R, dose) = -1.00; WT Nodal at right somatocoel / stomodeum / left pouch = 0.2882 / 0.0238 / 0.0020" ;
        schema:measurementTechnique "Steady-state 1D screened-Poisson Nodal and BMP2/4 gradients across the larval L-R axis; pouch competence = Hill_act(BMP) * (1 - Hill_rep(Nodal)); E[podia] = 5 (P_L + P_R) evaluated at (dose_L, dose_R) in {(0,1), (0,0), (1,1)}" ;
        schema:name "Continuous Nodal/BMP2-4 dose-response: max |expected podia - discrete Law 3| over WT, Nodal MO and bilateral GOF doses" ;
        schema:unitText "podia" ;
        schema:value "0.0548" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-continuous-nodal-bmp2-4-dose-response-max-expected-podia-discrete-law-3-over-wt-nodal-mo-and-bilateral-gof-doses-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-continuous-nodal-bmp2-4-dose-response-max-expected-podia-discrete-law-3-over-wt-nodal-mo-and-bilateral-gof-doses-reference> a schema:PropertyValue ;
        dct:source "Duboc et al. (2005) Dev. Cell 9:147-158 Figs 1/4/5 (5, 10, 0 podia) & Lean 4 theorem nodal_dose_response_hill_reduces_to_discrete_law" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-duboc-et-al-2005-nodal-morpholino-knockdown-twin-rudiment-primary-podia-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Duboc et al. (2005) Nodal morpholino knockdown twin-rudiment primary podia count = 10.0 podia" ;
        dct:description "WT = 5 podia (1x5), Nodal LOF = 10 podia (2x5), Nodal GOF = 0 podia" ;
        schema:measurementTechnique "Total primary podia lobes formed when right-sided Nodal repression is ablated (nodal_left=0, nodal_right=0 -> 2x5)" ;
        schema:name "Duboc et al. (2005) Nodal morpholino knockdown twin-rudiment primary podia count" ;
        schema:unitText "podia" ;
        schema:value "10.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-duboc-et-al-2005-nodal-morpholino-knockdown-twin-rudiment-primary-podia-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-duboc-et-al-2005-nodal-morpholino-knockdown-twin-rudiment-primary-podia-count-reference> a schema:PropertyValue ;
        dct:source "Duboc et al. (2005) Dev. Cell 9(1):147-158 Fig. 4 & Lean 4 theorem duboc_nodal_left_right_rudiment_multiplicity" ;
        schema:value "10.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-equal-diffusion-negative-control-d-h-d-a-emergent-podia-lobe-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Equal-diffusion negative control (D_h = D_a) emergent podia lobe count = 0.0 lobes" ;
        dct:description "Confirms zero spatial symmetry breaking without long-range inhibition" ;
        schema:measurementTechnique "Gierer-Meinhardt circular-ring PDE integrated with equal diffusivity D_h = D_a = 0.45 um^2/s" ;

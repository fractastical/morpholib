        schema:unitText "lobes" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-equal-diffusion-negative-control-d-h-d-a-emergent-podia-lobe-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-equal-diffusion-negative-control-d-h-d-a-emergent-podia-lobe-count-reference> a schema:PropertyValue ;
        dct:source "Meinhardt (2008) Curr. Top. Dev. Biol. 81:1-63 (Turing lateral-inhibition necessity)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-hydrocoel-ring-mode-staircase-correlation-across-m-in-3-4-5-6-7> a schema:PropertyValue,

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-hydrocoel-ring-mode-staircase-correlation-across-m-in-3-4-5-6-7-reference> a schema:PropertyValue ;

        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-synthetic-test-aboral-projection-c-5-fundamental-fourier-power-fraction-vs-tripneustes-gratilla-specimen> a schema:PropertyValue,

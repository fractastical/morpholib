        schema:measurementTechnique "Count of plate columns generated by simulate_opr_test_plate_addition() from the 5 m=5 ring-PDE lobe azimuths (2 columns per ambulacrum and per interambulacrum)" ;
        schema:name "OPR domed-test meridional column count (5 biserial ambulacra + 5 biserial interambulacra)" ;
        schema:unitText "columns" ;
        schema:value "20.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-domed-test-meridional-column-count-5-biserial-ambulacra-5-biserial-interambulacra-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-domed-test-meridional-column-count-5-biserial-ambulacra-5-biserial-interambulacra-reference> a schema:PropertyValue ;
        dct:source "Lovén (1874); Mooi & David (1998, 2008): 5 biserial ambulacra (10 columns) + 5 biserial interambulacra (10 columns) in regular euechinoids & Lean 4 theorem opr_biserial_plate_addition_law" ;
        schema:value "20.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-newest-plate-adjacent-to-ocular-fraction-across-all-20-columns-at-adult-size> a schema:PropertyValue,

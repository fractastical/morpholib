        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-lov-n-s-law-ii-iv-i-iii-v-crescent-initiation-sequence-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Lovén's Law (II, IV, I, III, V) crescent initiation sequence correlation = 1.0 Pearson r" ;
        dct:description "Ordered rays = ['II', 'IV', 'I', 'III', 'V'], b-enlarged count = 2/5" ;
        schema:measurementTechnique "Correlation of PDE crescent-closure ray initiation order vs Morris (2012) / Lovén (1874) sequence (2, 4, 1, 3, 5)" ;
        schema:name "Lovén's Law (II, IV, I, III, V) crescent initiation sequence correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-lov-n-s-law-ii-iv-i-iii-v-crescent-initiation-sequence-correlation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-lov-n-s-law-ii-iv-i-iii-v-crescent-initiation-sequence-correlation-reference> a schema:PropertyValue ;
        dct:source "Lovén (1874) K. Sven. Vetensk.-Akad. Handl. 11(7):1-91 & Morris (2012) Evol. Dev. 14:313-326" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-ambulacral-interambulacral-primary-plate-count-ratio-at-adult-size> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "OPR ambulacral / interambulacral primary plate count ratio at adult size = 2.0645 ratio" ;
        dct:description "Mean plate height amb = 1.388, IA = 2.863 (R_meta units); reference is approximate (trigeminate compounding)" ;
        schema:measurementTechnique "Sum of ambulacral plates over sum of interambulacral plates across the 20 columns at R/R_meta = 40 (emergent from zone-specific nucleation / terminal plate sizes)" ;
        schema:name "OPR ambulacral / interambulacral primary plate count ratio at adult size" ;
        schema:unitText "ratio" ;
        schema:value "2.0645" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-ambulacral-interambulacral-primary-plate-count-ratio-at-adult-size-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-ambulacral-interambulacral-primary-plate-count-ratio-at-adult-size-reference> a schema:PropertyValue ;
        dct:source "approximate: trigeminate compound ambulacral plates (3 primary elements per compound plate) in Toxopneustidae / camarodonts; treated as an order-of-magnitude target, not a measured S. purpuratus count" ;
        schema:value "3.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-biserial-ambulacral-column-alternation-phase-0-5-perfect-lov-n-zigzag-suture> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "OPR biserial ambulacral column alternation phase (0.5 = perfect Lovén zigzag suture) = 0.4916 fraction of local plate height" ;
        dct:description "Mature (ambital, h >= 0.95 h_max) plates only: 0.4900" ;
        schema:measurementTechnique "Mean folded phase offset of column-b plate sutures within the column-a suture lattice across all 5 ambulacra; emerges from the Lovén-enlarged primary plate seeding a half-plate offset under identical OPR nucleation kinetics" ;
        schema:name "OPR biserial ambulacral column alternation phase (0.5 = perfect Lovén zigzag suture)" ;
        schema:unitText "fraction of local plate height" ;
        schema:value "0.4916" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-biserial-ambulacral-column-alternation-phase-0-5-perfect-lov-n-zigzag-suture-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-biserial-ambulacral-column-alternation-phase-0-5-perfect-lov-n-zigzag-suture-reference> a schema:PropertyValue ;
        dct:source "Lovén (1874): plates of columns a and b alternate (zigzag median suture); 0.5 = perfect alternation" ;
        schema:value "0.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-domed-test-meridional-column-count-5-biserial-ambulacra-5-biserial-interambulacra> a schema:PropertyValue,

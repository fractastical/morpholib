        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-newest-plate-adjacent-to-ocular-fraction-across-all-20-columns-at-adult-size-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-opr-newest-plate-adjacent-to-ocular-fraction-across-all-20-columns-at-adult-size-reference> a schema:PropertyValue ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-meinhardt-echinoderm-pentaradial-symmetry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Morris (2012), Mooi & David (1998/2008), Lovén (1874), Duboc et al. (2005), Luo & Su (2012) & Meinhardt (2008) echinoderm bilateral-to-pentaradial hydrocoel ring symmetry breaking with Ocular Plate Rule test growth — Reproducibility package: 93/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: deterministic (`seed=2005`), `--self-test` passes 11/11 checks in ~1.7 s (L1743-1842) covering SHA-256 provenance of 5 files, JSON-to-code parity, OPR structure (20/10 columns, lobes == azimuths, newest-at-ocular, rho > 0.99, alternation in [0.35, 0.5], Amb/IA > 1.5, enlargement ablation < 0.05, m = 4 control, projection 5 rays and |dC_5| < 0.10), Nodal (5/10/0, max dev < 0.10, rho < -0.99, EC50 in (0,1), monotone gradient) and two-run OPR determinism; the default render (~7 s) regenerates the 9-panel PNG, the growth GIF, and three new Pass 3 media; the handoff documents the full command set. Deductions: the OPR GIF frames reconstruct earlier states by rescaling final heights rather than from stored per-step heights, so the animation is not a replay of the solver (L718-727) (-3); `docs/media/*.png` are gitignored so the PNG artifacts are not tracked and `echinoderm_pentaradial_symmetry_growth.gif` is byte-identical to Pass 2 (its render path is unchanged, L1313-1370) (-2); no requirements lock is vendored for this slot (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L716–L728: opr_test_color_grid(growth_step=...) rescales FINAL heights to the earlier column length instead of storing per-step heights <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L716-L728>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-repro-package-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L1743–L1842" ;
        dcterms:description "11-check self_test() including Pass 3 JSON pin, OPR structural checks, enlargement ablation, m=4 control, Nodal dose checks and OPR two-run determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L1743-L1842> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L1844–L1887" ;
        dcterms:description "main(): deterministic default render writing comparison PNG, growth GIF, OPR 3D PNG, OPR GIF and Nodal dose-response PNG" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L1844-L1887> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/echinoderm_pentaradial_symmetry_opr_test_growth.gif (generated output)" ;
        dcterms:description "10-frame OPR accretion GIF regenerated by the default run — docs/media/echinoderm_pentaradial_symmetry_opr_test_growth.gif: rendered output of models/2005-meinhardt-echinoderm-pentaradial-symmetry.py at a69596cc, image/gif, 265949 B, 900×440 px, 10 frames, artifact_sha256 ec3155352c93d665b253ce084697e854c610cb26d76ee4de5fce4990fb55b5e8 (sha256 ec3155352c93d665b253ce084697e854c610cb26d76ee4de5fce4990fb55b5e8), spec_fingerprint cd13db70aa61071108eb599c5b5e2da1617f948ac60e0ad765eabfe5fa619518" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 primary assessor, Phase B)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


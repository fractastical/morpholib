sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-meinhardt-echinoderm-pentaradial-symmetry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L873–L911" ;
        dcterms:description "evaluate_nodal_dose_response_sweep: 41-point dose sweep, EC50, Spearman rho, 25x25 (dose_L, dose_R) map, canonical conditions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L873-L911> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L1848–L1854" ;
        dcterms:description "CLI: --self-test, --skip-gif, --R-ring-um, --lambda-c-um, --seed, --growth-factor, --nodal-dose" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L1848-L1854> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Morris (2012), Mooi & David (1998/2008), Lovén (1874), Duboc et al. (2005), Luo & Su (2012) & Meinhardt (2008) echinoderm bilateral-to-pentaradial hydrocoel ring symmetry breaking with Ocular Plate Rule test growth — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: in addition to the v2 49-point circumference sweep and m in {3..7} staircase, Pass 3 adds a 41-point right-Nodal dose sweep, a 25 x 25 (dose_L, dose_R) map (L873-911), the Lovén enlargement ablation (self-test), a growth-factor parameter for the OPR test and `--growth-factor` / `--nodal-dose` CLI flags (L1853-1854). Deductions: `measure_morphoeval()` (L1562-1740) ignores every CLI parameter, and `--growth-factor` reaches only the standalone OPR figure/GIF (L1872), not Panels G/I or the measurements (-4); `--nodal-dose` merely overwrites the \"WT\" profile in the standalone figure (L1876-1879), which is semantically misleading (-2); the enlargement factor, h_nuc/h_max, colatitudes and Hill constants are JSON-only with no CLI or sweep, and the OPR solver is exercised only at m = 5 (`ROMAN_RAYS` fixed, L519) although the ring solver runs m = 4 (-3); `--R-ring-um`/`--lambda-c-um` still reach only `render_comparison_figure` (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L1562–L1564: measure_morphoeval() takes no arguments and ignores all CLI parameters <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L1562-L1564>",
            "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L1868–L1880: --growth-factor and --nodal-dose reach only the standalone Pass 3 figures; --nodal-dose overwrites sweep['wt_profile'] <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L1868-L1880>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 primary assessor, Phase B)" ;
        dcterms:identifier "claude-fable-5-1" ;

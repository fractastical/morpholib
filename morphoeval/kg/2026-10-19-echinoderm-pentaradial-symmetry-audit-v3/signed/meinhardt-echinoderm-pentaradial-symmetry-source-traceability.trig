sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-meinhardt-echinoderm-pentaradial-symmetry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Morris (2012), Mooi & David (1998/2008), Lovén (1874), Duboc et al. (2005), Luo & Su (2012) & Meinhardt (2008) echinoderm bilateral-to-pentaradial hydrocoel ring symmetry breaking with Ocular Plate Rule test growth — Source and data traceability: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the new reference table `opr_plate_addition_nodal_dose_reference.json` is SHA-256-pinned (L142-144) and verified fail-closed at every run with the other four assets (L159-187); every numeric parameter in it is labelled `assumption` unless a `source` is given (JSON L9); the dataset README gained a file-table row, a Pass 3 addendum and references 6-9; four new primary sources (Mooi & David 2008, Zachos 2009, Raup 1968, Luo & Su 2012) are cited in the header, README and `pass3_citations.bib`. Deductions: the four new DOIs were transcribed offline and not verified (-2); `pass3_citations.bib` is not SHA-pinned because the original `paper_citations.bib` is pinned and could not be extended without breaking the pin (-2); the Amb/IA reference 3.0 and the growth factor 40 / colatitudes are assumptions rather than literature values (-2); Raup 1968 has no DOI (-0, URL given)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/echinoderm_pentaradial_symmetry/pass3_citations.bib L1–L47: BibTeX for Mooi & David 2008, Zachos 2009, Raup 1968, Luo & Su 2012; not SHA-pinned <https://github.com/fractastical/morpholib/blob/a69596cc/datasets/echinoderm_pentaradial_symmetry/pass3_citations.bib#L1-L47>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-source-traceability-4> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L127–L146" ;
        dcterms:description "EXPECTED_SHA256 registry now pins 5 files including opr_plate_addition_nodal_dose_reference.json (f93ea0ba...)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L127-L146> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L159–L187" ;
        dcterms:description "verify_dataset_integrity / load_reference_data / load_pass3_reference: fail-closed SHA-256 verification at runtime" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L159-L187> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/echinoderm_pentaradial_symmetry/opr_plate_addition_nodal_dose_reference.json L1–L98" ;
        dcterms:description "Pass 3 reference table with provenance_note labelling every parameter assumption vs source, OPR kinetics, Nodal parameters, structural reference values and pass3_sources" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/datasets/echinoderm_pentaradial_symmetry/opr_plate_addition_nodal_dose_reference.json#L1-L98> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/echinoderm_pentaradial_symmetry/README.md L28–L44" ;
        dcterms:description "File-table rows for the Pass 3 JSON and bib, Pass 3 addendum, references 6-9 marked 'DOIs not re-verified online'" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/datasets/echinoderm_pentaradial_symmetry/README.md#L28-L44> .


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-meinhardt-echinoderm-pentaradial-symmetry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L916–L962" ;
        dcterms:description "segment_echinoid_test_specimen: periproct detection and shared polar_c5_harmonics pipeline; rays [45,118,190,260,331], C_5 = 0.9255, duty cycle 0.575" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L916-L962> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L739–L800" ;
        dcterms:description "project_opr_test_aboral_view + polar_c5_harmonics: identical pipeline applied to the orthographic aboral projection of the plated dome" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L739-L800> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/echinoderm_pentaradial_symmetry_comparison.png (generated output)" ;
        dcterms:description "9-panel synthesis: Panel E specimen overlay, Panel F spectrum, Panel G 3D plated dome, Panel I plate-count law with harmonics inset — docs/media/echinoderm_pentaradial_symmetry_comparison.png: rendered output of models/2005-meinhardt-echinoderm-pentaradial-symmetry.py at a69596cc, image/png, 1409808 B, 2408×2264 px, artifact_sha256 df03cccaab05e99639f38fa2c234607621bb59d89aae097f3d56431244b5d9c6 (sha256 df03cccaab05e99639f38fa2c234607621bb59d89aae097f3d56431244b5d9c6), spec_fingerprint cd13db70aa61071108eb599c5b5e2da1617f948ac60e0ad765eabfe5fa619518" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/echinoderm_pentaradial_symmetry_opr_test_3d.png (generated output)" ;
        dcterms:description "4-panel OPR figure: 3D dome, unrolled Ia/Ib/IA columns with Lovén plate, plate count vs R, aboral harmonics vs specimen with both images inset — docs/media/echinoderm_pentaradial_symmetry_opr_test_3d.png: rendered output of models/2005-meinhardt-echinoderm-pentaradial-symmetry.py at a69596cc, image/png, 381301 B, 1807×1263 px, artifact_sha256 a4fbc634873cfd7929cd435a85703c249a85fc4d71fdb8659a495a9ded6b5cf1 (sha256 a4fbc634873cfd7929cd435a85703c249a85fc4d71fdb8659a495a9ded6b5cf1), spec_fingerprint cd13db70aa61071108eb599c5b5e2da1617f948ac60e0ad765eabfe5fa619518" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Morris (2012), Mooi & David (1998/2008), Lovén (1874), Duboc et al. (2005), Luo & Su (2012) & Meinhardt (2008) echinoderm bilateral-to-pentaradial hydrocoel ring symmetry breaking with Ocular Plate Rule test growth — Morphological realism / specimen match: 89/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the Tripneustes gratilla test segmentation (L916-962) is unchanged and now shares a single polar chromaticity + azimuthal FFT pipeline (`polar_c5_harmonics`, L759-800) with the synthetic OPR test projection (L739-756), so the specimen and the model are measured identically; the specimen's ambulacral duty cycle (0.575) calibrates the synthetic ambulacral width; the 9-panel comparison figure places the specimen (Panel E), its spectrum (Panel F) and the plated dome / harmonics inset (Panels G, I) side by side; the OPR figure insets both images. Deductions: a synthetic exactly five-fold test has C_5 ~ 1 regardless of plate kinetics, so the 0.9964 vs 0.9255 comparison discriminates nothing about the accretion model (-4); detected synthetic ray angles [7, 80, 138, 210, 281] are noisy because the synthetic profile has flat tops (-2); the species mismatch (header organism S. purpuratus, specimen and \"trigeminate\" argument T. gratilla) persists (-3); no plate-level comparison (plate counts per column, plate outlines) is made against the specimen, which is the morphology the new solver actually produces (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L1630–L1636: Aboral C_5 measurement uses the specimen's own C_5 as reference and the specimen-calibrated duty cycle; near-trivial for an exactly 5-fold synthetic test <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L1630-L1636>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match-4> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;

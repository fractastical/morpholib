sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-meinhardt-echinoderm-pentaradial-symmetry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Morris (2012), Mooi & David (1998/2008), Lovén (1874), Duboc et al. (2005), Luo & Su (2012) & Meinhardt (2008) echinoderm bilateral-to-pentaradial hydrocoel ring symmetry breaking with Ocular Plate Rule test growth — Code-to-model traceability: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the header docstring gained a Pass 3 block (L66-88) mapping Law 4 and Law 5 to their functions, sources and Lean theorems; every new function docstring names its source and Lean link (L565, L842); the math-KG YAML registers equations 4-5 with single-range code loci and re-pointed loci for equations 1-3; the measurement `method` strings explain each number. Deductions: the header title still reads \"Pass 2 (v2) Remediated Implementation\" (L3) (-1); the Section 2 docstrings and the README continue to describe the ring solver as a Gierer-Meinhardt PDE, which the code does not implement (L241-256) (-5); `render_comparison_figure`'s docstring still says \"6-panel Pass 2\" although it renders 9 panels (L972) (-1); the OPR GIF frame construction approximates history by rescaling final heights (L718-727) without saying so in the figure (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L1–L4: Header title still 'Pass 2 (v2) Remediated Implementation' <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L1-L4>",
            "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L241–L256: simulate_hydrocoel_ring_pde docstring presents a Gierer-Meinhardt crescent-to-ring PDE; the body is a templated mode solver <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L241-L256>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-code-traceability-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2005-meinhardt-echinoderm-pentaradial-symmetry.py L66–L88" ;
        dcterms:description "Pass 3 header block: Law 4 (OPR) and Law 5 (Nodal/BMP dose-response) mapped to sections, sources and Lean theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L66-L88> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/meinhardt-echinoderm-pentaradial-symmetry.yaml L113–L135" ;
        dcterms:description "Equations 4 and 5 registered with single-range code_locus #L542-L694 and #L806-L911 and the Lean theorem names" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/morphoeval/math_kg_loops/meinhardt-echinoderm-pentaradial-symmetry.yaml#L113-L135> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 primary assessor, Phase B)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


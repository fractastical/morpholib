sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hentschel-tgfb-fibronectin-limb> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B / Kiskowski et al. (2004) Dev. Biol. multiscale TGF-beta / FGF-inhibitor reaction-diffusion and fibronectin haptotaxis PDE in developing Gallus gallus limb bud — Morphometric validation: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L628-688) extracts 8 reference-backed quantitative morphometrics covering HH20 stylopod cell condensation count (1.0 vs 1.0 ref), HH24 zeugopod cell condensation count (2.0 vs 2.0 ref), HH27 chick wing autopod cell condensation count (3.0 vs 3.0 ref), HH28 hindlimb / high-TGFb condensation count (4.0 vs 4.0 ref), 2D composite chick wing bud total condensations (6.0 vs 6.0 ref across 1+2+3 compartments), fibronectin-cell colocalization correlation (Pearson r = 0.9997 vs 0.98 ref), anti-fibronectin (`chi_F=0`) and equal-diffusion (`Da=Di`) negative control cell amplitude (`std(R) = 9.0e-5` vs 0.0 ref), and segmented Gallus gallus wing specimen zeugopod-to-autopod spacing ratio (1.4074 vs 1.4074 ref)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-2d-composite-chick-wing-bud-total-haptotactic-skeletal-elements-1-2-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-anti-fibronectin-no-haptotaxis-chi-f-0-and-equal-diffusion-da-di-negative-control-cell-amplitude>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-fibronectin-f-x-vs-mesenchymal-cell-density-r-x-haptotactic-colocalization-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh20-stylopod-haptotactic-cell-condensation-count-m-fa-3-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh24-zeugopod-haptotactic-cell-condensation-count-m-fa-6-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh27-chick-wing-autopod-haptotactic-cell-condensation-count-m-fa-11-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh28-hindlimb-high-tgf-beta-autopod-condensation-count-m-fa-18-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-segmented-gallus-gallus-wing-specimen-zeugopod-to-autopod-spacing-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-morphometric-validation-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-2d-composite-chick-wing-bud-total-haptotactic-skeletal-elements-1-2-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D composite chick wing bud total haptotactic skeletal elements (1 + 2 + 3) = 6.0 elements" ;
        dct:description "compartment counts = [1, 2, 3] vs specimen [1, 2, 3]" ;
        schema:measurementTechnique "2D proximodistal multiscale (c_a, c_i, F, R) PDE cumulative cell condensation peak count across stylopod, zeugopod, and autopod zones" ;
        schema:name "2D composite chick wing bud total haptotactic skeletal elements (1 + 2 + 3)" ;
        schema:unitText "elements" ;
        schema:value "6.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-2d-composite-chick-wing-bud-total-haptotactic-skeletal-elements-1-2-3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-2d-composite-chick-wing-bud-total-haptotactic-skeletal-elements-1-2-3-reference> a schema:PropertyValue ;
        dct:source "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B 271:1713-1722 Figs. 2-4 (1 humerus + 2 radius/ulna + 3 digits = 6 elements)" ;
        schema:value "6.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-anti-fibronectin-no-haptotaxis-chi-f-0-and-equal-diffusion-da-di-negative-control-cell-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "anti-fibronectin no-haptotaxis (chi_F=0) and equal-diffusion (Da=Di) negative control cell amplitude = 0.0 std(R) control" ;
        dct:description "WT std(R) = 0.7574 (3 digits) vs chi_F=0 std(R) = 8.65e-11 (0 elements) and Da=Di std(R) = 8.65e-11 (0 elements)" ;
        schema:measurementTechnique "mesenchymal cell density std(R) when haptotaxis is blocked (chi_F=0) or morphogen diffusivities are equal (Da=Di=0.5) vs WT autopod" ;
        schema:name "anti-fibronectin no-haptotaxis (chi_F=0) and equal-diffusion (Da=Di) negative control cell amplitude" ;
        schema:unitText "std(R) control" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-anti-fibronectin-no-haptotaxis-chi-f-0-and-equal-diffusion-da-di-negative-control-cell-amplitude-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-anti-fibronectin-no-haptotaxis-chi-f-0-and-equal-diffusion-da-di-negative-control-cell-amplitude-reference> a schema:PropertyValue ;
        dct:source "Lean 4 Theorem 1 hentschel_tgfb_inhibitor_haptotaxis_stability_controls & Kiskowski et al. (2004) Dev. Biol. 271:372-387" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-fibronectin-f-x-vs-mesenchymal-cell-density-r-x-haptotactic-colocalization-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fibronectin F(x) vs mesenchymal cell density R(x) haptotactic colocalization Pearson r = 0.9997 Pearson r" ;
        dct:description "micromass WT nodular area fraction = 0.198 vs +TGF-beta2 stripe area fraction = 0.448" ;
        schema:measurementTechnique "spatial correlation between ECM fibronectin F(x) and haptotactic mesenchymal cell density R(x) in HH27 wing autopod" ;
        schema:name "fibronectin F(x) vs mesenchymal cell density R(x) haptotactic colocalization Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9997" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-fibronectin-f-x-vs-mesenchymal-cell-density-r-x-haptotactic-colocalization-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-fibronectin-f-x-vs-mesenchymal-cell-density-r-x-haptotactic-colocalization-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Kiskowski et al. (2004) Dev. Biol. 271:372-387 & Hentschel et al. (2004) Proc. R. Soc. B 271:1713-1722 (colocalization of fibronectin and cell condensations)" ;
        schema:value "0.98" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh20-stylopod-haptotactic-cell-condensation-count-m-fa-3-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "HH20 stylopod haptotactic cell condensation count m(fa=3.0) = 1.0 elements" ;
        dct:description "wavelength lambda_AP = 1150.0 um, F-R colocalization r = 0.9617, specimen stylopod bones = 1" ;
        schema:measurementTechnique "coupled 4-field (c_a, c_i, F, R) Hentschel et al. (2004) PDE mesenchymal cell density R(x) peak count at fa=3.0 (c_FGF=0.25)" ;
        schema:name "HH20 stylopod haptotactic cell condensation count m(fa=3.0)" ;
        schema:unitText "elements" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh20-stylopod-haptotactic-cell-condensation-count-m-fa-3-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh20-stylopod-haptotactic-cell-condensation-count-m-fa-3-0-reference> a schema:PropertyValue ;
        dct:source "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B 271:1713-1722 Fig. 2 & Section 3 (HH20 stylopod humerus = 1 element)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh24-zeugopod-haptotactic-cell-condensation-count-m-fa-6-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "HH24 zeugopod haptotactic cell condensation count m(fa=6.0) = 2.0 elements" ;
        dct:description "wavelength lambda_AP = 575.0 um, PDE spacing = 577.3 um, specimen zeugopod bones = 2" ;
        schema:measurementTechnique "coupled 4-field (c_a, c_i, F, R) Hentschel et al. (2004) PDE mesenchymal cell density R(x) peak count at fa=6.0 (c_FGF=0.55)" ;
        schema:name "HH24 zeugopod haptotactic cell condensation count m(fa=6.0)" ;
        schema:unitText "elements" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh24-zeugopod-haptotactic-cell-condensation-count-m-fa-6-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh24-zeugopod-haptotactic-cell-condensation-count-m-fa-6-0-reference> a schema:PropertyValue ;
        dct:source "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B 271:1713-1722 Fig. 3 & Section 3 (HH24 zeugopod radius+ulna = 2 elements)" ;
        schema:value "2.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh27-chick-wing-autopod-haptotactic-cell-condensation-count-m-fa-11-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "HH27 chick wing autopod haptotactic cell condensation count m(fa=11.0) = 3.0 elements" ;
        dct:description "wavelength lambda_AP = 383.3 um, PDE spacing = 383.3 um, specimen autopod digits = 3" ;
        schema:measurementTechnique "coupled 4-field (c_a, c_i, F, R) Hentschel et al. (2004) PDE mesenchymal cell density R(x) peak count at fa=11.0 (c_FGF=0.85)" ;
        schema:name "HH27 chick wing autopod haptotactic cell condensation count m(fa=11.0)" ;
        schema:unitText "elements" ;
        schema:value "3.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh27-chick-wing-autopod-haptotactic-cell-condensation-count-m-fa-11-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh27-chick-wing-autopod-haptotactic-cell-condensation-count-m-fa-11-0-reference> a schema:PropertyValue ;
        dct:source "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B 271:1713-1722 Fig. 4 & Section 3 (HH27 chick wing digits II, III, IV = 3 elements)" ;
        schema:value "3.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh28-hindlimb-high-tgf-beta-autopod-condensation-count-m-fa-18-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "HH28 hindlimb / high-TGF-beta autopod condensation count m(fa=18.0) = 4.0 elements" ;
        dct:description "wavelength lambda_AP = 312.5 um, PDE spacing = 313.7 um" ;
        schema:measurementTechnique "coupled 4-field (c_a, c_i, F, R) Hentschel et al. (2004) PDE mesenchymal cell density R(x) peak count at fa=18.0 (c_FGF=1.00)" ;
        schema:name "HH28 hindlimb / high-TGF-beta autopod condensation count m(fa=18.0)" ;
        schema:unitText "elements" ;
        schema:value "4.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh28-hindlimb-high-tgf-beta-autopod-condensation-count-m-fa-18-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh28-hindlimb-high-tgf-beta-autopod-condensation-count-m-fa-18-0-reference> a schema:PropertyValue ;

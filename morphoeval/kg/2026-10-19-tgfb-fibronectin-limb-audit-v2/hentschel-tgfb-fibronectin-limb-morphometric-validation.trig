    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-segmented-gallus-gallus-wing-specimen-zeugopod-to-autopod-spacing-ratio> a schema:PropertyValue,

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hentschel-tgfb-fibronectin-limb> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B / Kiskowski et al. (2004) Dev. Biol. multiscale TGF-beta / FGF-inhibitor reaction-diffusion and fibronectin haptotaxis PDE in developing Gallus gallus limb bud — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates the Hentschel et al. (2004) Proc. R. Soc. B Eqs. (2.1)-(3.12) dispersion relation and haptotactic flux gain (`compute_hentschel_dispersion`, L102-177); numerically integrates the coupled 4-field `(c_a, c_i, F, R)` reaction-diffusion-haptotaxis PDE via DCT-II IMEX + conservative haptotactic flux differences in 1D (`integrate_hentschel_1d_multiscale_pde`, L183-310) and across the 2D proximodistal chick wing bud (`integrate_hentschel_2d_limb_bud_pde`, L313-409) as well as 2D periodic micromass cultures (`simulate_2d_micromass_morphospace`, L412-479); and backs all 3 laws with machine-checked Lean 4 theorems in `Loop_014_tgfb_fibronectin_limb.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py L183–L310" ;
        dct:description "Coupled 4-field (c_a, c_i, F, R) reaction-diffusion-haptotaxis PDE solver with zero-flux boundaries" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2004-hentschel-tgfb-fibronectin-limb.py#L183-L310> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py L313–L479" ;
        dct:description "2D proximodistal chick wing bud multiscale PDE ([1, 2, 3] condensations) and 2D micromass spot/stripe morphospace solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2004-hentschel-tgfb-fibronectin-limb.py#L313-L479> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_014_tgfb_fibronectin_limb.lean L1–L132" ;
        dct:description "3 machine-checked Lean 4 theorems (0 sorrys) for equal-diffusion/no-haptotaxis controls, FGF zonation mode transition, and haptotactic flux amplification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_014_tgfb_fibronectin_limb.lean#L1-L132> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 014 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hentschel-tgfb-fibronectin-limb> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B / Kiskowski et al. (2004) Dev. Biol. multiscale TGF-beta / FGF-inhibitor reaction-diffusion and fibronectin haptotaxis PDE in developing Gallus gallus limb bud — Morphological realism / specimen match: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Loads and SHA-256-verifies the Gallus gallus forelimb skeletal specimen (`datasets/tgfb_fibronectin_limb/chick_limb_chondrogenesis_specimen.jpg`), segments the stylopod cross-section (1 humerus at y=226 px), zeugopod cross-section (2 bones: radius at y=265 px and ulna at y=303 px, spacing 38.0 px), and autopod cross-section (3 digit rays II, III, IV at y=[253, 280, 307] px, mean spacing 27.0 px, CV=0.0000) (`segment_chick_limb_specimen`, L541-592), overlays the 3 anatomical ROIs and centroids in Panel E and cross-sectional profiles in Panel F, and compares the segmented zeugopod-to-autopod spacing ratio (1.4074) and compartment counts ([1, 2, 3]) against the 4-field PDE." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py L541–L592" ;
        dcterms:description "Cross-sectional osteological peak detection across stylopod (1), zeugopod (2), and autopod (3) on chick_limb_chondrogenesis_specimen.jpg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2004-hentschel-tgfb-fibronectin-limb.py#L541-L592> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/tgfb_fibronectin_limb_comparison.png (generated output)" ;
        dcterms:description "8-panel synthesis figure comparing dispersion, 2D haptotactic cell density, 4-stage (F,R) profiles, micromass spot/stripe morphospace, and segmented Gallus wing specimen — docs/media/tgfb_fibronectin_limb_comparison.png: rendered output of 2004-hentschel-tgfb-fibronectin-limb.py at 8871db0, image/png, 719240 B, 2230×1349 px, artifact_sha256 eea82e7f7885e55ae30c9fe24dc1c7543fe1efe2cba337aec39970ed1c704b86 (sha256 eea82e7f7885e55ae30c9fe24dc1c7543fe1efe2cba337aec39970ed1c704b86), spec_fingerprint a2738dce4265d3cbf1985dad5976f0edb36bd4a8ed6349bde78d12e6cc7cd510" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 014 autonomous loop assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


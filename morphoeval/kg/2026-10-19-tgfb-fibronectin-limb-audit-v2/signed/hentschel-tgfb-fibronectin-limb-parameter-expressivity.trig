sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hentschel-tgfb-fibronectin-limb> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py L485–L535" ;
        dcterms:description "4-stage FGF zonation sweep ([1, 2, 3, 4] condensations) and dual negative controls (Da=Di and chi_F=0)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2004-hentschel-tgfb-fibronectin-limb.py#L485-L535> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py L718–L738" ;
        dcterms:description "CLI flags for fa, L_AP_um, Da, Di, chi_F, k_F, steps, and seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2004-hentschel-tgfb-fibronectin-limb.py#L718-L738> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B / Kiskowski et al. (2004) Dev. Biol. multiscale TGF-beta / FGF-inhibitor reaction-diffusion and fibronectin haptotaxis PDE in developing Gallus gallus limb bud — Parameter expressivity: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Simulates all 4 proximodistal AER-FGF zonation regimes (`run_fgf_zonation_sweep`, L485-516) across `fa in {3, 6, 11, 18}` reproducing `[1, 2, 3, 4]` cell condensations; simulates the 2D micromass morphospace across WT nodular spots (`19.8%` area fraction), exogenous TGF-beta2 labyrinthine stripes (`44.8%` area fraction), and anti-fibronectin `chi_F = 0` (`0.0%` area fraction); sweeps haptotactic sensitivity `chi_F in [0.0, 1.15]` in Panel G; executes dual negative controls (`run_negative_controls`, L519-535); and exposes full CLI flags (`--fa`, `--L-AP-um`, `--Da`, `--Di`, `--chi-F`, `--k-F`, `--steps`, `--seed`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-parameter-expressivity-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 014 autonomous loop assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


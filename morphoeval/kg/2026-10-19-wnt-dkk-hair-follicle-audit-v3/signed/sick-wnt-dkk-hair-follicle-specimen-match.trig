sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Sick et al. (2006) & Andl et al. (2002) WNT/DKK reaction-diffusion hair follicle spacing, secondary wave insertion, transgenic phenotypes & (Pass 3) 3D dermal condensate FGF20/BMP4 chemotaxis with hair peg downgrowth — Morphological realism / specimen match: 80/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Panels B1-B3 and C1 are visually distinct and the segmented specimen with its Delaunay graph is shown side by side with the PDE lattice; row D now shows the 3D condensates, an x-z section with pegs and the genotype downgrowth curves, and the GIF carries a 15-frame Phase 3. Deductions: the Pass 2 claim that the WT lattice 'matches the 16 segmented placodes' was a seam-duplication artifact — the corrected count is 15 periodic maxima (14 components) and, more importantly, the nearest-neighbour spacing regularity disagrees (CV 0.086 PDE vs 0.323 specimen) (-8); the specimen is a Gad1 in situ of vibrissa/hair placodes (Maddox & Condie 2004), not Sick et al.'s pelage pattern, so the comparison is a stand-in (-5); row D has no histological or live-imaging reference image (Huh 2013 / Glover 2017 / Paus 1999) beside the model, so DC shape, depth and peg morphology are judged against nothing (-5); the saturated 'ringing' regime (B3) shows plateaus, not the annular rings described in the text (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2002-sick-wnt-dkk-hair-follicle.py L1570–L1579: WT count 15 vs specimen 16 and CV 0.086 vs 0.323 reported in the measurement note — regularity does not match <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L1570-L1579>",
            "datasets/wnt_dkk_hair_follicle/wnt_dkk_hair_follicle_reference.json L57–L70: Specimen is Gad1 in situ of E12.5-E13.5 vibrissa/hair placodes (Maddox & Condie 2004), not a pelage follicle pattern <https://github.com/fractastical/morpholib/blob/64526a0/datasets/wnt_dkk_hair_follicle/wnt_dkk_hair_follicle_reference.json#L57-L70>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-specimen-match-3> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/wnt_dkk_hair_follicle_comparison.png (generated output)" ;
        dcterms:description "12-panel figure: B1 WT lattice (N = 15), C1 Mus musculus specimen segmentation (N = 16) with Delaunay graph, D1 3D DC voxels + pegs, D2 x-z section, D3 downgrowth curves — docs/media/wnt_dkk_hair_follicle_comparison.png: rendered output of 2002-sick-wnt-dkk-hair-follicle.py at 64526a0, image/png, 1017546 B, 2227×2484 px, artifact_sha256 2ede41f73dae7b113013b9bcf000da0a78ad2ab1a741478e2d31109808de2905 (sha256 2ede41f73dae7b113013b9bcf000da0a78ad2ab1a741478e2d31109808de2905), spec_fingerprint 6a8fbee2728c3b1e0b4daa692316d84bdc3d4612b3958090f46312888c4939f9" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L974–L1042" ;
        dcterms:description "Optical-density segmentation of the vendored specimen; 16 placodes, NN 70.86 +- 22.92 px, CV 0.3234" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L974-L1042> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L456–L507" ;
        dcterms:description "Seam-aware labelling and circular-mean centroids added in Pass 3; placodes now periodic local maxima (L551-L552)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L456-L507> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 primary assessor; MorphoEval rubric)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L171–L249" ;
        dcterms:description "Exact WNT/DKK steady state, Jacobian J_0, d_c = (sqrt2+1)^2 and dispersion Re sigma(k) for d = 30, d_c and d = 1" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L171-L249> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L699–L723" ;
        dcterms:description "7-point slab Laplacian (periodic x,y / zero-flux z) and conservative face-flux chemotactic divergence with volume-filling mobility m = rho(1 - rho/rho_max)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L699-L723> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L826–L848" ;
        dcterms:description "Time loop: FGF20 source at z = 0 (L835), dermal BMP4 production (L836), chemotaxis up f / down b (L837-L841), per-placode peg ODE (L847)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L826-L848> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L726–L768" ;
        dcterms:description "Linearised dermal subsystem (-tr, det >= 0 for all q) and autonomous Keller-Segel comparison; matches Lean Laws 4-5" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L726-L768> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_006_wnt_dkk_hair_follicle.lean L87–L169" ;
        dcterms:description "Laws 4-6: dermal_subsystem_instructed_stable, keller_segel_fourier_det_sign + ks_det_neg_of_supercritical, hair_peg_depth_monotone + closed_form (lean exit 0, 0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_006_wnt_dkk_hair_follicle.lean#L87-L169> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Sick et al. (2006) & Andl et al. (2002) WNT/DKK reaction-diffusion hair follicle spacing, secondary wave insertion, transgenic phenotypes & (Pass 3) 3D dermal condensate FGF20/BMP4 chemotaxis with hair peg downgrowth — Model fidelity to source: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The WNT/DKK core is still faithful: saturating activator-inhibitor PDEs with the exact unsaturated steady state, Jacobian, d_c = (sqrt2+1)^2 and dispersion (L171-L249), 1D primary -> secondary insertion (L341-L397), 2D regimes (L509-L652). Pass 3 adds the requested dermal dimension as a reduced but mechanistic model: FGF20 sourced by placodes, dermally produced BMP4, Keller-Segel chemotaxis with volume filling in conservative form, peg depth slaved to the DC (L654-L969), with a correct linear analysis showing condensation is epidermally instructed (L726-L768; Lean Law 4). Deductions: the coupling is one-way and the epidermis never deforms (-4); the K14-Wnt regime changes D_w, D_h and kappa together with rho_w (L600-L603) so the 'overexpression' phenotype is not a single-parameter perturbation (-4); BMP4 is produced uniformly in proportion to rho with no interfollicular-epidermal source (L836) and the FGF20 source S(x,y) is a thresholded, rescaled w rather than a modelled Fgf20 transcriptional response (L806-L807) (-3); no parameter is taken from Sick et al.'s SOM table and the dermal constants are hand-tuned (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2002-sick-wnt-dkk-hair-follicle.py L600–L603: K14-Wnt 'overexpression' preset also changes kappa 0.02 -> 0.015, D_w 0.015 -> 0.008, D_h 0.45 -> 0.32: confounded, not a pure rho_w perturbation <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L600-L603>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-5> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 primary assessor; MorphoEval rubric)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


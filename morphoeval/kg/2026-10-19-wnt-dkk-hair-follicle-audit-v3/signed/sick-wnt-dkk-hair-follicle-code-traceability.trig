sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L38–L95" ;
        dcterms:description "Docstring sections 2b and 4 map the dermal equations, Lean laws and Pass 3 sources" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L38-L95> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L654–L677" ;
        dcterms:description "Section 3b header: equations with biological attribution and the honest-reduction statement" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L654-L677> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/sick-wnt-dkk-hair-follicle.yaml L1–L151" ;
        dcterms:description "6 equations with lean_theorem, lean_locus and code_locus (loci re-verified against the current file); Pass 3 parity fix noted at L12-L14" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/math_kg_loops/sick-wnt-dkk-hair-follicle.yaml#L1-L151> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Sick et al. (2006) & Andl et al. (2002) WNT/DKK reaction-diffusion hair follicle spacing, secondary wave insertion, transgenic phenotypes & (Pass 3) 3D dermal condensate FGF20/BMP4 chemotaxis with hair peg downgrowth — Code-to-model traceability: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Every modelling block carries an equation/figure citation: the docstring maps the WNT/DKK PDEs, the secondary-wave law and the transgenic regimes to Sick et al. figures and the new Section 3b to Huh 2013 / Glover 2017 / Botchkarev 1999 / Mou 2006 / Paus 1999 / Keller-Segel 1970 (L654-L677); function docstrings restate the equations; the six Lean laws are named in the docstring and registered with updated code loci in the math KG yaml. Deductions: Pass 2 shipped a docstring claiming 22 K14-Wnt placodes while the code produced 32 — fixed now, but it shows the numeric claims in prose are not generated from the run (-4); stage thresholds 0.25/0.5 (L888-L891) and the DC registration radius 2.5 px (L873) are uncited conventions (-3); the FGF20 source normalisation (L806-L807) has no stated biological rationale (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2002-sick-wnt-dkk-hair-follicle.py L888–L891: Ordinal stage thresholds at 25%/50% of slab depth are a model convention without a cited morphological criterion <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L888-L891>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-code-traceability-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 primary assessor; MorphoEval rubric)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Sick et al. (2006) & Andl et al. (2002) WNT/DKK reaction-diffusion hair follicle spacing, secondary wave insertion, transgenic phenotypes & (Pass 3) 3D dermal condensate FGF20/BMP4 chemotaxis with hair peg downgrowth — Parameter expressivity: 86/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Three real sweeps behave monotonically: Dkk1 dosage rho_h in {0, 0.004, 0.01, 0.02, 0.05, 0.12} gives 15, 15, 15, 14, 0, 0 placodes (L616-L631, self-test asserts monotone non-increasing), domain length L in [20..80] gives r = 0.985 (L400-L441), and the new FGF20 chemotactic sensitivity chi_f in {0, 0.1, 0.15, 0.2, 0.25} gives 0, 13, 15, 15, 15 DCs and peg depth 0 -> 0.665 (monotone, r = 0.913) (L928-L969). CLI exposes --cw --ch --mu-w --mu-h --Dw --Dh --seed --chi-f (L1728-L1737). Deductions: the five epidermal genotypes are multi-parameter presets rather than single-axis sweeps (L600-L611) (-6); bmp4_scale is evaluated at one point (5x) with no sweep, so the BMP4 axis is not shown to be monotone (L943) (-4); v_peg, e_thr and Z are not exposed and their effect on the stage histogram is unexplored (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2002-sick-wnt-dkk-hair-follicle.py L943–L943: BMP4 excess evaluated only at bmp4_scale = 5.0; no sweep <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L943-L943>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L616–L631" ;
        dct:description "6-point ectopic Dkk1 dosage sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L616-L631> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L928–L969" ;
        dct:description "4 dermal genotypes + 5-point chi_f sweep with Pearson r and monotonicity flag" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L928-L969> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L1728–L1737" ;
        dct:description "CLI flags incl. new --chi-f" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L1728-L1737> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 primary assessor; MorphoEval rubric)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


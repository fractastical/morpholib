sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Sick et al. (2006) & Andl et al. (2002) WNT/DKK reaction-diffusion hair follicle spacing, secondary wave insertion, transgenic phenotypes & (Pass 3) 3D dermal condensate FGF20/BMP4 chemotaxis with hair peg downgrowth — Reproducibility package: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Deterministic (`seed = 2006`, RNG passed through all solvers), 12-check self-test (L1615-L1723) including SHA-256 locks, JSON parity, 2D and 3D bitwise determinism (L1674-L1680), the new dermal checks 9-12, and monotonicity assertions; default invocation regenerates both artefacts (PNG 2227x2484, GIF 45 frames) in ~50 s; environment recorded above. Deductions: no requirements lock is vendored with the script and the audit's environment block is the only pin (-4); without MPLCONFIGDIR the first run builds a font cache outside the repo (-2); the self-test re-runs the full 2D + 3D suite (~30 s) rather than a reduced smoke grid, which is fine but undocumented (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-repro-package-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L1615–L1723" ;
        dct:description "12-check self_test(): SHA-256, parity, 4->8 insertion, 2D genotypes, Dkk1 sweep monotone, domain scaling, specimen 16, 2D+3D determinism, dermal checks 9-12" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L1615-L1723> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L1404–L1442" ;
        dct:description "Phase 3 GIF frames (dermal x-z section + upper-dermal density) appended; GIF written by the default invocation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L1404-L1442> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/wnt_dkk_hair_follicle_growth.gif (generated output)" ;
        dct:description "45-frame GIF (15 primary + 15 secondary + 15 dermal Phase 3 frames) — docs/media/wnt_dkk_hair_follicle_growth.gif: rendered output of 2002-sick-wnt-dkk-hair-follicle.py at 64526a0, image/gif, 1084034 B, 792×342 px, 45 frames, artifact_sha256 d8761a5a0efcd16f1ff921ba0752faba2b456b73c97148d33976eba6eb6e8333 (sha256 d8761a5a0efcd16f1ff921ba0752faba2b456b73c97148d33976eba6eb6e8333), spec_fingerprint 6a8fbee2728c3b1e0b4daa692316d84bdc3d4612b3958090f46312888c4939f9" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 primary assessor; MorphoEval rubric)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


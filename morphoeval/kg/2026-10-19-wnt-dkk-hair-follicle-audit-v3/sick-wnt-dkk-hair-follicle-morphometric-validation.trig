@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Sick et al. (2006) & Andl et al. (2002) WNT/DKK reaction-diffusion hair follicle spacing, secondary wave insertion, transgenic phenotypes & (Pass 3) 3D dermal condensate FGF20/BMP4 chemotaxis with hair peg downgrowth — Morphometric validation: 84/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1457-L1609) now returns 13 measurements with units, methods and sources: d_c, w_*, secondary doubling ratio, WT count vs specimen, K14-Wnt ratio, Dkk1/equal-diffusion count, domain scaling r, and six dermal quantities (DC/placode ratio 1.0 vs Huh 2013; Fgf20-null + chemotaxis-null DC count 0; DC-placode offset 0.41 px vs 0; Fgf20-null/WT peg ratio 0; chi_f sweep r; mass drift 0). Deductions: the only quantitative specimen comparison (NN-spacing CV) disagrees and is reported in a note rather than as its own measurement with a pass/fail band (-5); the K14-Wnt ratio now carries no reference because the Pass 2 '2.0' was unsourced (-3); the Fgf20-null peg ratio 0 and the DC/placode ratio 1.0 are partly by construction (no FGF20 -> no gradient -> no DC) rather than independent validation (-4); WT peg depth 67% of slab has no empirical reference (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2002-sick-wnt-dkk-hair-follicle.py L1510–L1519: Peg-depth ratio Fgf20-null/WT = 0 vs reference 0 — satisfied largely by construction <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L1510-L1519>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-allometric-epidermal-domain-length-scaling-correlation-r-l-n-peaks>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-dermal-condensate-per-placode-ratio-n-dc-n-placode-wt-3d-fgf20-chemotaxis>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-discrete-mesenchymal-mass-conservation-of-the-chemotaxis-scheme-wt-relative-drift>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-fgf20-chemotactic-sensitivity-sweep-correlation-r-chi-f-mean-peg-depth>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-fgf20-null-chemotaxis-null-dermal-condensate-count-placodes-persist-no-dc>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-hair-peg-downgrowth-fgf20-null-wt-mean-peg-depth-ratio-arrest-at-placode-stage>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-mean-lateral-dc-placode-centroid-offset-wt-periodic-nearest-neighbour>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-secondary-inter-follicular-wave-placode-doubling-ratio-upon-2x-epidermal-expansion>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-transgenic-dkk1-overexpression-blockade-equal-diffusion-negative-control-placode-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-transgenic-k14-wnt-overexpression-vs-wild-type-placode-density-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-unsaturated-steady-state-wnt-activator-concentration-w>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wild-type-2d-hair-follicle-placode-count-vs-mus-musculus-in-situ-specimen-panel-b>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wnt-dkk-critical-diffusivity-ratio-d-c-sqrt-2-1-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-morphometric-validation-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-allometric-epidermal-domain-length-scaling-correlation-r-l-n-peaks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Allometric epidermal domain-length scaling correlation r(L, N_peaks) = 0.9846 Pearson r" ;
        dct:description "placode counts [2, 3, 4, 5, 5, 7, 8] across L=[20, 30, 40, 50, 60, 70, 80]; mean nonlinear wavelength = 10.29 cells, RMSE = 0.3429 peaks" ;
        schema:measurementTechnique "Linear correlation between epidermal transect length L in [20..80] cells and placode count N_peaks(L)" ;
        schema:name "Allometric epidermal domain-length scaling correlation r(L, N_peaks)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9846" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-allometric-epidermal-domain-length-scaling-correlation-r-l-n-peaks-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-allometric-epidermal-domain-length-scaling-correlation-r-l-n-peaks-reference> a schema:PropertyValue ;
        dct:source "Sick et al. (2006) Science 314:1447-1450 intrinsic reaction-diffusion wavelength invariance" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-dermal-condensate-per-placode-ratio-n-dc-n-placode-wt-3d-fgf20-chemotaxis> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Dermal condensate per placode ratio N_DC / N_placode (WT, 3D FGF20 chemotaxis) = 1.0 N_DC / N_placode" ;
        dct:description "WT: 15 DCs beneath 15 placodes (fraction of placodes with a DC = 1.00); peak upper-dermal enrichment rho_max/rho_0 = 2.76; DC excess-density centre of mass 0.41 layers below the epidermis" ;
        schema:measurementTechnique "3D Keller-Segel FGF20/BMP4 chemotaxis slab (42x42x12, periodic x,y / zero-flux z) beneath the WT 2D WNT placode field; DCs = connected components of upper-dermal rho > e_thr" ;
        schema:name "Dermal condensate per placode ratio N_DC / N_placode (WT, 3D FGF20 chemotaxis)" ;
        schema:unitText "N_DC / N_placode" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-dermal-condensate-per-placode-ratio-n-dc-n-placode-wt-3d-fgf20-chemotaxis-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-dermal-condensate-per-placode-ratio-n-dc-n-placode-wt-3d-fgf20-chemotaxis-reference> a schema:PropertyValue ;
        dct:source "Huh et al. (2013) Genes Dev 27:450-458 (one primary dermal condensate beneath every primary placode); Glover et al. (2017) PLoS Biol 15:e2002117" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-discrete-mesenchymal-mass-conservation-of-the-chemotaxis-scheme-wt-relative-drift> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Discrete mesenchymal mass conservation of the chemotaxis scheme (WT relative drift) = 0.0 relative" ;
        dct:description "WT drift 0.000e+00, Fgf20-/- drift 0.000e+00, BMP4-excess drift 0.000e+00 (non-zero drift would indicate rho hitting the clip bounds [0, rho_max])" ;
        schema:measurementTechnique "|sum(rho_end) - sum(rho_0)| / sum(rho_0) over 3200 explicit steps of the conservative face-flux chemotaxis + diffusion scheme (periodic x,y, zero-flux z)" ;
        schema:name "Discrete mesenchymal mass conservation of the chemotaxis scheme (WT relative drift)" ;
        schema:unitText "relative" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-discrete-mesenchymal-mass-conservation-of-the-chemotaxis-scheme-wt-relative-drift-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-discrete-mesenchymal-mass-conservation-of-the-chemotaxis-scheme-wt-relative-drift-reference> a schema:PropertyValue ;
        dct:source "Keller & Segel (1970) J Theor Biol 26:399-415 conservation form; Painter & Hillen (2002) Can Appl Math Q 10:501-543 volume filling" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-fgf20-chemotactic-sensitivity-sweep-correlation-r-chi-f-mean-peg-depth> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FGF20 chemotactic-sensitivity sweep correlation r(chi_f, mean peg depth) = 0.9133 Pearson r" ;
        dct:description "DC counts [0, 13, 15, 15, 15] and peg depths [0.0, 0.004, 0.201, 0.44, 0.665] across chi_f = [0.0, 0.1, 0.15, 0.2, 0.25]; monotone = True" ;
        schema:measurementTechnique "5-point sweep chi_f in {0, 0.1, 0.15, 0.2, 0.25}; Pearson r between chi_f and mean normalised peg depth; monotonicity checked separately" ;
        schema:name "FGF20 chemotactic-sensitivity sweep correlation r(chi_f, mean peg depth)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9133" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-fgf20-chemotactic-sensitivity-sweep-correlation-r-chi-f-mean-peg-depth-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-fgf20-chemotactic-sensitivity-sweep-correlation-r-chi-f-mean-peg-depth-reference> a schema:PropertyValue ;
        dct:source "Keller & Segel (1970) J Theor Biol 26:399-415 (chemotactic sensitivity controls aggregation strength); Glover et al. (2017) PLoS Biol 15:e2002117" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-fgf20-null-chemotaxis-null-dermal-condensate-count-placodes-persist-no-dc> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Fgf20-null + chemotaxis-null dermal condensate count (placodes persist, no DC) = 0 dermal condensates" ;
        dct:description "Fgf20-/-: 0 DCs, peak enrichment 1.000, peg depth 0.000; chi_f=0: 0 DCs; epidermis-free dermal subsystem min det(q>0) = 1.156e-04 >= 0 (no spontaneous condensation)" ;
        schema:measurementTechnique "Same 3D slab with fgf20_scale = 0 (Fgf20-/-) and with chi_f = 0 (FGF20 present but unread); epidermal placode field unchanged (15 placodes)" ;
        schema:name "Fgf20-null + chemotaxis-null dermal condensate count (placodes persist, no DC)" ;
        schema:unitText "dermal condensates" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-fgf20-null-chemotaxis-null-dermal-condensate-count-placodes-persist-no-dc-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-fgf20-null-chemotaxis-null-dermal-condensate-count-placodes-persist-no-dc-reference> a schema:PropertyValue ;
        dct:source "Huh et al. (2013) Genes Dev 27:450-458 Figs. 1-3 (Fgf20-/- skin forms placodes but no primary or secondary dermal condensates) + Lean 4 dermal_subsystem_instructed_stable" ;
        schema:value "0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-hair-peg-downgrowth-fgf20-null-wt-mean-peg-depth-ratio-arrest-at-placode-stage> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hair peg downgrowth: Fgf20-null / WT mean peg-depth ratio (arrest at placode stage) = 0.0 ratio" ;
        dct:description "WT mean peg depth = 66.5% of dermis (stage histogram 1..4 = [0, 0, 2, 13], model stage convention); Fgf20-/- = 0.0%; BMP4 excess (5x s_b) = 0.0% with 0 DCs (peak enrichment 1.56)" ;
        schema:measurementTechnique "Per-placode peg depth ODE dz_i/dt = v_peg clip((e_i - e_thr)/(rho_max - e_thr), 0, 1) slaved to the upper-dermal density e_i beneath placode i; depth normalised by dermal slab depth (Z-1)" ;
        schema:name "Hair peg downgrowth: Fgf20-null / WT mean peg-depth ratio (arrest at placode stage)" ;
        schema:unitText "ratio" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-hair-peg-downgrowth-fgf20-null-wt-mean-peg-depth-ratio-arrest-at-placode-stage-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-hair-peg-downgrowth-fgf20-null-wt-mean-peg-depth-ratio-arrest-at-placode-stage-reference> a schema:PropertyValue ;
        dct:source "Huh et al. (2013) Genes Dev 27:450-458 (Fgf20-/- follicles arrest at the placode stage); Paus et al. (1999) J Invest Dermatol 113:523-532 (ordinal stages: placode -> hair germ -> hair peg)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-mean-lateral-dc-placode-centroid-offset-wt-periodic-nearest-neighbour> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Mean lateral DC-placode centroid offset (WT, periodic nearest neighbour) = 0.4121 cells (px)" ;
        dct:description "mean offset 0.412 px, max 0.730 px over 15 registered placode/DC pairs (WT 2D placode NN spacing 9.73 px)" ;
        schema:measurementTechnique "Periodic nearest-neighbour distance between each WT epidermal placode centroid and the upper-dermal DC centroid beneath it" ;
        schema:name "Mean lateral DC-placode centroid offset (WT, periodic nearest neighbour)" ;
        schema:unitText "cells (px)" ;
        schema:value "0.4121" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-mean-lateral-dc-placode-centroid-offset-wt-periodic-nearest-neighbour-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-mean-lateral-dc-placode-centroid-offset-wt-periodic-nearest-neighbour-reference> a schema:PropertyValue ;
        dct:source "Glover et al. (2017) PLoS Biol 15:e2002117 (dermal cells aggregate directly beneath the placode by migration toward placode FGF20)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-secondary-inter-follicular-wave-placode-doubling-ratio-upon-2x-epidermal-expansion> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Secondary inter-follicular wave placode doubling ratio upon 2x epidermal expansion = 2.0 N_secondary / N_primary" ;
        dct:description "primary wave forms 4 peaks (CV=0.0707) -> 2x expanded epidermis inserts 4 midpoint secondary placodes to reach 8 peaks (spacing 10.00 ± 0.50 cells, CV=0.0500)" ;
        schema:measurementTechnique "1D periodic WNT/DKK PDE expanded 2x from N_1=40 (E14.5 primary wave) to N_2=80 (E16.5 secondary inter-follicular insertion)" ;
        schema:name "Secondary inter-follicular wave placode doubling ratio upon 2x epidermal expansion" ;
        schema:unitText "N_secondary / N_primary" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-secondary-inter-follicular-wave-placode-doubling-ratio-upon-2x-epidermal-expansion-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-secondary-inter-follicular-wave-placode-doubling-ratio-upon-2x-epidermal-expansion-reference> a schema:PropertyValue ;
        dct:source "Sick et al. (2006) Science 314:1447-1450 Figs. 3-4 (inter-follicular secondary wave insertion)" ;
        schema:value "2.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-transgenic-dkk1-overexpression-blockade-equal-diffusion-negative-control-placode-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Transgenic Dkk1 overexpression blockade & equal-diffusion negative control placode count = 0 placodes" ;
        dct:description "Dkk1++ blockade clamps w_max = 0.0517 (0 placodes, std = 1.80e-12); equal-diffusion control forms 0 placodes (std = 2.87e-07) vs 15 WT placodes" ;
        schema:measurementTechnique "2D WNT/DKK PDE under ectopic Dkk1 overexpression (rho_h=0.12) and equal-diffusion control (D_w=D_h=0.015)" ;
        schema:name "Transgenic Dkk1 overexpression blockade & equal-diffusion negative control placode count" ;
        schema:unitText "placodes" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-transgenic-dkk1-overexpression-blockade-equal-diffusion-negative-control-placode-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-transgenic-dkk1-overexpression-blockade-equal-diffusion-negative-control-placode-count-reference> a schema:PropertyValue ;
        dct:source "Andl et al. (2002) Dev. Cell 2:643-653 & Sick et al. (2006) Fig. 4 (Dkk1 alopecia blockade) + Lean 4 wnt_dkk_equal_diffusion_stable" ;
        schema:value "0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-transgenic-k14-wnt-overexpression-vs-wild-type-placode-density-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Transgenic K14-Wnt overexpression vs Wild-Type placode density ratio = 2.0 N_Wnt++ / N_WT" ;
        dct:description "K14-Wnt++ raises placode count from 15 to 30 (2.00x) and reduces mean nearest-neighbor spacing from 9.73 px to 6.35 px; saturated regime increases mean placode component area from 26.86 to 37.20 px^2 (+38.5%); the Pass 2 reference ratio 2.0 is a qualitative 'increased density' benchmark, not a value reported by Sick et al." ;
        schema:measurementTechnique "Ratio of 2D placode count (periodic local WNT maxima) under elevated K14-Wnt expression (rho_w=0.004) to Wild-Type (rho_w=0.001)" ;
        schema:name "Transgenic K14-Wnt overexpression vs Wild-Type placode density ratio" ;
        schema:unitText "N_Wnt++ / N_WT" ;
        schema:value "2.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-unsaturated-steady-state-wnt-activator-concentration-w> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Unsaturated steady-state WNT activator concentration w_* = 1.5 concentration units" ;
        dct:description "homogeneous Jacobian tr(J_0) = -0.0100 < 0, det(J_0) = 0.00140 > 0" ;
        schema:measurementTechnique "Exact steady-state formula w_* = (c_w / c_h) * (mu_h / mu_w) with h_* = 2.25" ;
        schema:name "Unsaturated steady-state WNT activator concentration w_*" ;
        schema:unitText "concentration units" ;
        schema:value "1.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-unsaturated-steady-state-wnt-activator-concentration-w-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-unsaturated-steady-state-wnt-activator-concentration-w-reference> a schema:PropertyValue ;
        dct:source "Sick et al. (2006) Science 314:1447-1450" ;
        schema:value "1.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wild-type-2d-hair-follicle-placode-count-vs-mus-musculus-in-situ-specimen-panel-b> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type 2D hair follicle placode count vs Mus musculus in situ specimen (Panel B) = 15 placodes" ;
        dct:description "WT 2D PDE forms 15 placodes (NN spacing = 9.73 ± 0.84 px, CV = 0.0862, area = 26.86 px^2); specimen Panel B segmented 16 placodes (NN spacing = 70.86 ± 22.92 px, CV = 0.3234)" ;
        schema:measurementTechnique "Connected components of 2D WNT activator field on 42x42 grid vs optical-density segmentation of Mus musculus E12.5-E13.5 specimen Panel B" ;
        schema:name "Wild-type 2D hair follicle placode count vs Mus musculus in situ specimen (Panel B)" ;
        schema:unitText "placodes" ;
        schema:value "15" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wild-type-2d-hair-follicle-placode-count-vs-mus-musculus-in-situ-specimen-panel-b-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wild-type-2d-hair-follicle-placode-count-vs-mus-musculus-in-situ-specimen-panel-b-reference> a schema:PropertyValue ;
        dct:source "Sick et al. (2006) Science 314:1447-1450 Fig. 2A & Maddox & Condie (2004) BMC Dev. Biol. 4:4 (16 placodes)" ;
        schema:value "16" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wnt-dkk-critical-diffusivity-ratio-d-c-sqrt-2-1-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "WNT/DKK critical diffusivity ratio d_c = (sqrt(2)+1)^2 = 5.8284 D_h / D_w" ;
        dct:description "canonical d = 30.0 > d_c (max Re sigma = +0.00864); equal-diffusion control d = 1.0 has max Re sigma = -0.00500" ;

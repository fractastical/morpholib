sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Sick et al. (2006) & Andl et al. (2002) WNT/DKK reaction-diffusion hair follicle spacing, secondary wave insertion, transgenic phenotypes & (Pass 3) 3D dermal condensate FGF20/BMP4 chemotaxis with hair peg downgrowth — Source and data traceability: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Eleven sources with DOIs (one URL) in the docstring (L88-L95), `paper_citations.bib` (now 11 entries, SHA-256 re-pinned at L136-L139 and in the JSON) and `wnt_dkk_hair_follicle_reference.json` (sources block L5-L56, dermal block L174-L215); the specimen's Wikimedia URL, licence and ROI are recorded; runtime verification fails closed (L144-L160) and self-test check 2 asserts JSON-to-code parity for both the WNT/DKK and the dermal parameters (L1625-L1640, L1690-L1691). Pass 3 fixed the README/math_kg parameter disagreement. Deductions: Painter & Hillen (2002) has no DOI (-2); the specimen provenance notes the Wikimedia file but not the figure/panel of the BMC paper it came from (-2); the dermal parameters cite papers for mechanism but none for values (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-source-traceability-4> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L129–L160" ;
        dct:description "EXPECTED_SHA256 (bib re-pinned 7843d2b7...) and fail-closed runtime verification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L129-L160> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/wnt_dkk_hair_follicle/wnt_dkk_hair_follicle_reference.json L174–L215" ;
        dct:description "dermal_condensate_model block: equations, parameters, genotype expectations, sources" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/datasets/wnt_dkk_hair_follicle/wnt_dkk_hair_follicle_reference.json#L174-L215> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/wnt_dkk_hair_follicle/paper_citations.bib L44–L120" ;
        dct:description "7 references appended in Pass 3 (Keller & Segel, Huh, Glover, Botchkarev, Mou, Paus, Painter & Hillen)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/datasets/wnt_dkk_hair_follicle/paper_citations.bib#L44-L120> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/wnt_dkk_hair_follicle/README.md L12–L13" ;

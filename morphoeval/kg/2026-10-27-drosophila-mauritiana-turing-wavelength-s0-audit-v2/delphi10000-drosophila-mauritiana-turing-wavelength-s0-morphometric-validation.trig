sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila mauritiana Turing wavelength at 1.6 µm (Pass 2, assimilated ocellus) — Morphometric validation: 92/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Non-circular comparisons: FFT wavelength 1.562 µm vs 1.637 µm; Pearson r 0.9997 vs a perfect-fit ceiling of 1; RMSE 0.0070 vs 0; KS 0.0337 vs 0; wavelength CV 0.034 vs 0.05; foreground fraction 0.413 vs specimen 0.378; coherency 0.790 vs 0.785; ridge count 23.6 vs 0.41 on the kikkawai wave. None of these pairs are value copied onto reference." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-analytical-fastest-mode-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-assimilated-field-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-compact-lobe-detail-ridge-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-ocellus-transect-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-specimen-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-specimen-vs-assimilated-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-successor-melanogaster-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-wavelength-coefficient-of-variation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-analytical-fastest-mode-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "analytical fastest-mode wavelength = 1.629027 µm" ;
        dct:description "analytical k_max, distinct from the grid FFT measurement" ;
        schema:measurementTechnique "argmax of the Schnakenberg dispersion σ(k) after γ calibration" ;
        schema:name "analytical fastest-mode wavelength" ;
        schema:unitText "µm" ;
        schema:value "1.629027" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-analytical-fastest-mode-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-analytical-fastest-mode-wavelength-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 dispersion; Murray 1981 intrinsic wavelength" ;
        schema:value "1.637" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-assimilated-field-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "assimilated-field RMSE = 0.007033 concentration" ;
        dct:description "zero would be an exact copy; the residual is the unassimilated component" ;
        schema:measurementTechnique "RMSE between nudged u and specimen target T" ;
        schema:name "assimilated-field RMSE" ;
        schema:unitText "concentration" ;
        schema:value "0.007033" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-assimilated-field-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-assimilated-field-rmse-reference> a schema:PropertyValue ;
        dct:source "same specimen target as the Pearson transect" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-compact-lobe-detail-ridge-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "compact-lobe detail ridge count = 23.572353 ridges" ;
        dct:description "mauritiana packs many detail ridges; kikkawai's cellular wave does not fit" ;
        schema:measurementTechnique "38.4 µm window / analytical λ" ;
        schema:name "compact-lobe detail ridge count" ;
        schema:unitText "ridges" ;
        schema:value "23.572353" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-compact-lobe-detail-ridge-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-compact-lobe-detail-ridge-count-reference> a schema:PropertyValue ;
        dct:source "predecessor count on the same window at 93.41 µm" ;
        schema:value "0.4110908896263783" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-ocellus-transect-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ocellus transect Pearson r = 0.999686 1" ;
        dct:description "goodness-of-fit of the assimilated branch; reference is the perfect-fit ceiling" ;
        schema:measurementTechnique "Pearson correlation of nudged activator u against the specimen-derived target T" ;
        schema:name "ocellus transect Pearson r" ;
        schema:unitText "1" ;
        schema:value "0.999686" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-ocellus-transect-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-ocellus-transect-pearson-r-reference> a schema:PropertyValue ;
        dct:source "canonical gallery ocellus, SHA-256 pinned in the reference JSON" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen foreground fraction = 0.4131 1" ;
        dct:description "simulation foreground versus the specimen; the two fractions are not copied" ;
        schema:measurementTechnique "border-contrast mask on the colorized assimilated frame (verify_image_fitness signature)" ;
        schema:name "specimen foreground fraction" ;
        schema:unitText "1" ;
        schema:value "0.4131" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "same mask on the canonical gallery illustration" ;
        schema:value "0.3779" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-specimen-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen stripe wavelength = 1.561789 µm" ;
        dct:description "measured peak versus the assigned detail-scale wavelength; not a self-copy" ;
        schema:measurementTechnique "FFT peak of the free (κ=0) Schnakenberg field on the periodic patch" ;
        schema:name "specimen stripe wavelength" ;
        schema:unitText "µm" ;
        schema:value "1.561789" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-specimen-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-specimen-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "slot target 1.637 µm = 1.637e-6 m, log10=-5.786" ;
        schema:value "1.637" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.7904 1" ;
        dct:description "texture anisotropy of the fitted ocellus versus the illustration" ;
        schema:measurementTechnique "mean structure-tensor coherency inside the assimilated-frame mask" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "1" ;
        schema:value "0.7904" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "coherency of the canonical ocellus illustration" ;
        schema:value "0.7853" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-specimen-vs-assimilated-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen vs assimilated KS statistic = 0.033691 1" ;
        dct:description "KS = 0 would mean identical distributions" ;
        schema:measurementTechnique "two-sample Kolmogorov-Smirnov statistic between u and T histograms" ;
        schema:name "specimen vs assimilated KS statistic" ;
        schema:unitText "1" ;
        schema:value "0.033691" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-specimen-vs-assimilated-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-specimen-vs-assimilated-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "scipy.stats.ks_2samp on the flattened fields" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-successor-melanogaster-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "successor melanogaster wavelength = 1.701246 µm" ;
        dct:description "successor wavelength is longer than the mauritiana detail target" ;
        schema:measurementTechnique "k_max recomputed at D_v × 1.22 (bare-lobe inhibitor range)" ;
        schema:name "successor melanogaster wavelength" ;
        schema:unitText "µm" ;
        schema:value "1.701246" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-successor-melanogaster-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-successor-melanogaster-wavelength-reference> a schema:PropertyValue ;
        dct:source "Glassford et al. 2015 posterior-lobe contrast, factor chosen for this slot" ;
        schema:value "1.637" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-wavelength-coefficient-of-variation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength coefficient of variation = 0.033791 1" ;
        dct:description "CV of the selected wavelength; reference is a nominal 5% biological tolerance" ;
        schema:measurementTechnique "std/mean of FFT wavelengths across 4 noise seeds" ;
        schema:name "wavelength coefficient of variation" ;
        schema:unitText "1" ;
        schema:value "0.033791" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-measurement-wavelength-coefficient-of-variation-reference> .

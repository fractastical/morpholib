sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Drosophila mauritiana Turing wavelength at 1.6 µm (Pass 2, assimilated ocellus) faithfully reproduces Drosophila mauritiana morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-mauritiana-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila mauritiana specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-mauritiana-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-mauritiana-turing-wavelength-s0.py; output: docs/media/drosophila_mauritiana_turing_wavelength_s0_growth.gif; organism: Drosophila mauritiana; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion relation and the requirement that the inhibitor diffuse farther than the activator. | Murray 1981 dependence of intrinsic wavelength on the diffusivity ratio. | Kondo & Miura 2010 as the review frame for stripes, spots, and related RD patterns. | Glassford et al. 2015: posterior-lobe novelty in the melanogaster subgroup, including mauritiana.; reconstructed_in_script: Slot-specific Schnakenberg calibration: D_u = 2.40e-14 m²/s, D_v/D_u = 9.875, γ set so k_max = 2π/1.637 µm. | Nudge κ(T − u) assimilates the gallery ocellus. The GIF endpoint is that field, upsampled and colorized. | Successor wavelength is k_max recomputed at D_v × 1.22, not a parameter copied from a melanogaster script. | Predecessor comparison is the 93.41 µm kikkawai cellular wavelength versus this 1.637 µm detail wavelength.; transfer_boundary: 1.637 µm is the assigned detail scale (tier 3_subcellular_um), not a length reported by Gompel or Glassford. | The 38.4 µm window is a reconstructed comparison length for mode counting.; does_not_claim: That an unforced Schnakenberg system draws the gallery spiral. The free branch is a spot field at 1.562 µm. | That the gallery illustration is a micrograph of the mauritiana genital arch. | That pixel Pearson r is an unforced prediction. It is the assimilated branch. | A second independent assessor.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1016/j.devcel.2015.08.005>,
            <https://doi.org/10.1038/nature03235>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-mauritiana-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-mauritiana-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1016/j.devcel.2015.08.005>,
            <https://doi.org/10.1038/nature03235>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047> .
    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:title "A pre-pattern formation mechanism for animal coat markings" .
    <https://doi.org/10.1016/j.devcel.2015.08.005> dct:title "Co-option of an ancestral Hox-regulated network underlies a recently evolved morphological novelty" .
    <https://doi.org/10.1038/nature03235> dct:title "Chance caught on the wing: cis-regulatory evolution and the origin of pigment patterns in Drosophila" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.1179047> dct:title "Reaction-diffusion model as a framework for understanding biological pattern formation" .
}


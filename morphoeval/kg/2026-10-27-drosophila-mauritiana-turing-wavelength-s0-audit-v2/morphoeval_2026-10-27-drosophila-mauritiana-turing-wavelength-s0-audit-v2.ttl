<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-mauritiana-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila mauritiana Turing wavelength at 1.6 µm (Pass 2, assimilated ocellus) — Code-to-model traceability: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "calibrate, integrate, parameter_sweep, successor_wavelength, and assimilate are separate functions. Lean theorems detail_wavelength_positive, detail_wavenumber_exceeds_kikkawai, compact_lobe_packs_detail_ridges, and inhibitor_diffuses_farther have no sorry." ;

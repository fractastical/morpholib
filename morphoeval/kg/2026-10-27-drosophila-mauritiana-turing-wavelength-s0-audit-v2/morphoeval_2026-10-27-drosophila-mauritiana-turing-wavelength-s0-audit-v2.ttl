<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-mauritiana-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail wavelength is positive" ;
    dct:description "Anchors the 1.6 µm detail scale for the mauritiana spinose-lobe micro-pattern | Variables: λ_detail = 1637 nm at geological age 0 Ma" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-mauritiana-turing-wavelength-s0.py#L97-L153>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3191_drosophila_mauritiana_turing_wavelength_s0.lean#L12-L25> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "λ_detail = 1.637e-6 m > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.devcel.2015.08.005>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3191.lambdaDetailNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3191.detail_wavelength_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-mauritiana-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail wavenumber exceeds the kikkawai cellular stripe" ;
    dct:description "States what changes against the predecessor chronospecies at this scale | Variables: predecessor D. kikkawai cellular wavelength 93410 nm" ;
    dct:source "Murray (1981) DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-mauritiana-turing-wavelength-s0.py#L212-L232>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3191_drosophila_mauritiana_turing_wavelength_s0.lean#L27-L31> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "λ_kikkawai / λ_detail > 50, with λ_kikkawai = 93.41 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.devcel.2015.08.005>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3191.lambdaKikkawaiNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3191.detail_wavenumber_exceeds_kikkawai" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-mauritiana-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Compact lobe packs detail ridges" ;
    dct:description "Mode count on the mauritiana lobe versus a kikkawai wavelength that does not fit | Variables: 38.4 µm reconstructed compact-arch window" ;
    dct:source "Glassford et al. (2015) DOI:10.1016/j.devcel.2015.08.005" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-mauritiana-turing-wavelength-s0.py#L445-L528>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3191_drosophila_mauritiana_turing_wavelength_s0.lean#L33-L38> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "23 * 1637 nm < 38400 nm < 93410 nm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.devcel.2015.08.005>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3191.compactLobeWindowNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3191.compact_lobe_packs_detail_ridges" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-mauritiana-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Inhibitor diffuses farther than the activator" ;
    dct:description "Differential-diffusion condition for Turing wavenumber selection; equal diffusion is the ablation | Variables: D_u = 2.40e-14 m²/s, D_v/D_u = 9.875" ;
    dct:source "Kondo and Miura (2010) DOI:10.1126/science.1179047" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-mauritiana-turing-wavelength-s0.py#L234-L246>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3191_drosophila_mauritiana_turing_wavelength_s0.lean#L40-L43> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_v / D_u = 9.875 > 1, and h = D_v f_u + D_u g_v > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.devcel.2015.08.005>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3191.diffusionContrastMilli" ;
    pk:leanTheorem "MathOfBiology.Loop_3191.inhibitor_diffuses_farther" ;
    pk:leanVerified true .


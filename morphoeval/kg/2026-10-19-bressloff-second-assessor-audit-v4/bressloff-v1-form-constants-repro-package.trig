sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-repro-package-second-assessor> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-repro-package-second-assessor> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Reproducibility package: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "The repository provides both lower-bound dependencies in requirements.txt and an exact environment lockfile in requirements.lock.txt (Python 3.14.7, numpy==2.5.4, scipy==1.16.3, matplotlib==3.10.7, pillow==12.0.0), and the simulation is purely deterministic with no unseeded stochastic calls. Running 'MPLCONFIGDIR=/tmp/mplcfg_second ./venv/bin/python3 2001-bressloff-v1-form-constants.py --self-test' completes in ~80 s with exit code 0 and passes all 38 self-test assertions, including SHA-256 verification of all four input JSON fixtures and end-to-end figure and CSV generation. We deduct 4 points because main() (lines 3798-3806) applies the CLI flags --hemifield-mode, --sigmoid-baseline, and --retinal-map by mutating the global PAPER_PRESETS dictionary in place, polluting global module state across subsequent calls in the same Python process. We deduct 3 points because the top-level README.md invocation guide (line 442) lists stale CLI choices (--hemifield-mode {full-field,bilateral-mirror} without chiral-mirror, omitting --retinal- map and --sigmoid-baseline) and states that --self-test runs 27 checks in ~12 s rather than 38 checks in ~80 s." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "requirements.lock.txt L1–L51" ;
        dct:description "Locked package versions for the Python 3.14.7 virtual environment." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/requirements.lock.txt#L1-L51> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L3420–L3766" ;
        dct:description "Deterministic self_test() suite verifying SHA-256 pins, upstream parity, exact operator, full cubic equations, morphometrics, sweeps, and figure/CSV generation." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L3420-L3766> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L3769–L3846" ;
        dct:description "CLI entrypoint main(); lines 3798-3806 mutate the global PAPER_PRESETS dictionary in place when CLI override flags are passed." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L3769-L3846> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


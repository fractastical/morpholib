        rdfs:label "Exact orientation operator (|m| ≤ 8) vs perturbative n=1 scan at fig17: |Δλ_c| = 0.0003 dimensionless growth rate" ;
        schema:measurementTechnique "top eigenvalue of the Hermitian W_k matrix on e^{2imφ} at the perturbative q* minus the perturbative λ_even(q*)" ;
        schema:name "Exact orientation operator (|m| ≤ 8) vs perturbative n=1 scan at fig17: |Δλ_c|" ;
        schema:unitText "dimensionless growth rate" ;

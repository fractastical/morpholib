    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-kl-ver-honeycomb-hex-linear-cortical-planform-spectral-ring-wavenumber-k> a schema:PropertyValue,
            pk:EvidenceItem ;

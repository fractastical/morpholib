    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-kl-ver-tunnel-rings-cortical-planform-spectral-ring-sharpness-derived-non-contoured-roll-reference> a schema:PropertyValue ;
        dct:source "Bressloff et al. 2001 Fig. 29 / Klüver 1966 Tunnel form constant" ;
        schema:value ">5.0" .

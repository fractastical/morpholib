    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-exact-orientation-operator-m-8-vs-perturbative-n-1-scan-at-fig17-c-reference> a schema:PropertyValue ;
        dct:source "Bressloff et al. 2001 §4 Eqs. 4.5-4.12 (perturbative) vs direct diagonalisation" ;
        schema:value "0 (|Δq*| = 0e+00)" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-full-cubic-roll-stability-margin-min-2-0-1-in-the-derived-non-contoured-regime-gallery-tunnel> a schema:PropertyValue,
            pk:EvidenceItem ;

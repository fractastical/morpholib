        dct:description "gallery tunnel: γ(0) = +0.256, unrestricted selection = roll, feedback_fraction = 0.00e+00, near_resonant = False" ;
        schema:measurementTechnique "Eq. 5.15 γ(θ) = [3s₃Γ₃ − 2s₂²Q]/N on a 5° grid, σ₀ = ½; rolls are linearly stable iff γ(0) > 0 and this margin is > 0 for every θ" ;
        schema:name "Full-cubic roll stability margin min_θ [2γ(θ)/γ(0) − 1] in the derived non-contoured regime (gallery tunnel)" ;
        schema:unitText "dimensionless" ;
        schema:value "0.9195" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-full-cubic-roll-stability-margin-min-2-0-1-in-the-derived-non-contoured-regime-gallery-tunnel-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-full-cubic-roll-stability-margin-min-2-0-1-in-the-derived-non-contoured-regime-gallery-tunnel-reference> a schema:PropertyValue ;
        dct:source "Bressloff et al. 2001 §5 Eqs. 5.9-5.15; branch_selection_full()" ;
        schema:value ">0 (rolls stable); contoured m=1 fig33 margin = -0.34 (rolls unstable, selected rhombic@45°)" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-gallery-panels-whose-rendered-lattice-is-the-branch-the-full-cubic-amplitude-equations-select-rhombic-angle-free> a schema:PropertyValue,

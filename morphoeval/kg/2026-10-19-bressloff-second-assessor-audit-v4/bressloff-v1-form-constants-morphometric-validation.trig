sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-morphometric-validation-second-assessor> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-morphometric-validation-second-assessor> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Morphometric validation: 84/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "The script computes a comprehensive suite of morphometrics on its rendered outputs: 2D radial FFT peak k*, harmonic ring power ratios at k/sqrt(3)k/2k, normalized azimuthal excess discriminators (c4 - c2, c6 - c2), retinal chirality, four-meridian excess seam contrast across conformal and exact maps, radial ring counts, azimuthal spoke counts, spiral pitch angles, and RMS relative error (6.8%) against Horton & Hoyt's (1991) human V1 linear cortical magnification law M(E) = 17.3/(E + 0.75) mm/deg over 1-40 deg, plus scale comparisons against Bressloff et al. (2002 Section 1.1). We deduct 6 points because the cubic_coefficients_full CSV export (line 2686) computes 'bare gamma3/N @ same' as 3*s3*v/gamma0 without dividing by N = <u_0^2>, so for all m=1 gallery presets (where N ~ 0.5) the exported bare ratios in bressloff_v1_metrics.csv (lines 38-40: 0.500, 0.416, 0.248...) are half of the actual gamma(theta)/gamma(0) ratios (1.000, 0.832, 0.496...) at sigma0=0.5. We deduct 5 points because the kluver_form_constant CSV rows (line 2643; bressloff_v1_metrics.csv lines 31-32) log the perturbative n=1 critical_q (1.491139) for roll_noncontoured_derived and spiral_noncontoured_derived instead of the rendered m=0 wavenumber q_mode (1.403797) logged in the cubic and retinal_morphometrics rows. We deduct 5 points because the 2.22e-16 parity checks validate the legacy upstream cubic path against another software implementation's fixture (paper-calibration.json, where 12/133 paper checks fail) rather than digitized empirical or published curves, and the Rule (2011) Fig. 8 fixture fails 4/6 acceptance checks (RMS beta error 0.154 vs 0.10 threshold)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-bressloff-v1-form-constants-stability-reports-parity-max>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-critical-branch-parity-flips-over-the-lateral-spread-sweep-0-90>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-exact-orientation-operator-m-8-vs-perturbative-n-1-scan-at-fig17-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-full-cubic-roll-stability-margin-min-2-0-1-in-the-derived-non-contoured-regime-gallery-tunnel>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-gallery-panels-whose-rendered-lattice-is-the-branch-the-full-cubic-amplitude-equations-select-rhombic-angle-free>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-gaussian-only-negative-control-critical-wavenumber-q-lateral-inhibition-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-kl-ver-honeycomb-hex-linear-cortical-planform-spectral-ring-wavenumber-k>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-kl-ver-tunnel-rings-cortical-planform-spectral-ring-sharpness-derived-non-contoured-roll>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-local-inhibition-threshold-a-loc-at-which-the-critical-harmonic-switches-m-0-m-1-w-w>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-mexican-hat-lateral-inhibition-critical-wavenumber-q-bressloff-2001-fig-16>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-paper-scale-preset-paper-scale-tunnel-lateral-widths-3-3-critical-cortical-wavelength-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-preset-runs-reproduced-with-exact-parity-paper-calibration-json-runs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-regime-map-cells-a-loc-where-the-cubic-truncation-is-unreliable-subcritical-or-feedback-dominated>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-rendered-cortical-wavelength-c-relative-to-the-paper-s-stated-2-4-3-2-mm-parity-preset-lateral-widths>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-retino-cortical-magnification-vs-horton-hoyt-1991-rms-relative-error-over-1-40-deg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-rule-et-al-2011-fig-8-overlay-domain-normalised-rms-error-diagnostic-no-calibration-claim>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-spiral-retinal-pullback-chirality-1-max-r-lr-r-ud-conformal-map-full-field>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-spiral-retinal-pullback-seam-contrast-conformal-angular-map-rendered-default>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-upstream-fixture-paper-expectation-checks-passed-paper-calibration-json-stability-reports-runs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-morphometric-validation-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-morphometric-validation-4> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-bressloff-v1-form-constants-stability-reports-parity-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "bressloff-v1-form-constants stability_reports parity, max |Δ| = 0.0 dimensionless" ;
        schema:measurementTechnique "maximum absolute error across all 5 Bressloff (2001) stability_reports (q*, λ*, γ(0), γ(θ), η_hex) vs paper-calibration.json (upstream bare-overlap path, branch_selection_upstream)" ;
        schema:name "bressloff-v1-form-constants stability_reports parity, max |Δ|" ;
        schema:unitText "dimensionless" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-bressloff-v1-form-constants-stability-reports-parity-max-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-bressloff-v1-form-constants-stability-reports-parity-max-reference> a schema:PropertyValue ;
        dct:source "MesmerPrism/bressloff-v1-form-constants commit 344863a1bd9e8a8e8c9cb20aced2897f3ffb2c4c" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-critical-branch-parity-flips-over-the-lateral-spread-sweep-0-90> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Critical-branch parity flips over the lateral-spread sweep θ₀ ∈ [0°, 90°] = 2.0 count" ;
        dct:description "flips at θ₀ ≈ [45, 90]°; q* over ξ̂_lat 1.5→6: 1.46→0.70; A_loc sweep harmonic flips at [0.275]" ;
        schema:measurementTechnique "number of even↔odd changes of the maximal-growth branch across 31 sweep points (fig17_even base)" ;
        schema:name "Critical-branch parity flips over the lateral-spread sweep θ₀ ∈ [0°, 90°]" ;
        schema:unitText "count" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-critical-branch-parity-flips-over-the-lateral-spread-sweep-0-90-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-critical-branch-parity-flips-over-the-lateral-spread-sweep-0-90-reference> a schema:PropertyValue ;
        dct:source "Bressloff et al. 2001 Phil. Trans. R. Soc. B 356:299 §4, Figs. 16-17" ;
        schema:value "≥1 (Bressloff 2001 §4: even planforms selected for θ₀ ≳ 45°)" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-exact-orientation-operator-m-8-vs-perturbative-n-1-scan-at-fig17-c> a schema:PropertyValue,

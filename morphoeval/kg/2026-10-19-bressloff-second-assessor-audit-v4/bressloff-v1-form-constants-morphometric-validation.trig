        schema:measurementTechnique "rendered family == unrestricted_selected_family, out of 5 gallery panels; 1 further panels are linearly stable branches that lose the Lyapunov tie-break, 1 are imposed (unstable at cubic order)" ;
        schema:name "Gallery panels whose rendered lattice is the branch the full cubic amplitude equations select (rhombic angle free)" ;
        schema:unitText "count" ;

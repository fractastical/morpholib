sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-parameter-expressivity-second-assessor> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-parameter-expressivity-second-assessor> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Parameter expressivity: 86/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "The script exposes eight sweepable parameters via --sweep PARAM[:LO:HI[:N]], executes five 1D parameter sweeps (lateral_wide_sigma, lateral_inhibition, lateral_spread_deg, local_inhibition, sigmoid_baseline), and computes a 20x13 2D regime map over A_loc x sigma0 (Panel G), demonstrating continuous wavenumber control, parity flips, and the m=0 to m=1 harmonic transition across roll, square, hexagonal, and rhombic families. We deduct 5 points because parameter_sweep and sweep_summary (lines 2275-2311, 2480-2496, 2807-2828) summarize q_star_min, q_star_max, and parity_flips from the perturbative n=1 scan (critical_q, critical_branch) rather than the exact operator (critical_q_exact, critical_parity_exact); as a result, the local_inhibition sweep in bressloff_v1_metrics.csv (line 55) reports two spurious parity flips at A_loc=0.225 and 0.25 and a dip to q*=0.7291 caused by the O(beta^2) Rayleigh-Schrodinger zero-denominator singularity at W_1^loc = W_0^loc, whereas the exact operator stays even with q* in [0.919, 1.001]. We deduct 5 points because 178 of 260 cells (68.5%) in the A_loc x sigma0 regime map and 24 of 25 points in the sigmoid_baseline sweep are either near_resonant (dominated by the nearly marginal K=0 uniform mode) or subcritical (gamma(0) <= 0) and must be masked out as unreliable (lines 3231-3266). We deduct 4 points because all three lateral coupling sweeps displayed in Panel F (lines 3055-3107) leave the selected pattern family invariant (rhombic throughout, with rolls and squares never stable) and plot only scalar q* curves without rendering multi-parameter morphological grids." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-4> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L2212–L2313" ;
        dct:description "Eight sweepable parameters, 2D A_loc x sigma0 regime_map, and 1D parameter_sweep recording both perturbative and exact-operator fields." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L2212-L2313> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L2472–L2499" ;
        dct:description "sweep_summary aggregates q_star_min, q_star_max, and parity_flips from perturbative critical_q and critical_branch instead of critical_q_exact and critical_parity_exact." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L2472-L2499> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L3055–L3108" ;
        dct:description "Panel F plots 1D q* sweeps for lateral_wide_sigma, lateral_inhibition, and lateral_spread_deg where selected family stays locked to rhombic." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L3055-L3108> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L3222–L3267" ;
        dct:description "Panel G 2D regime map over A_loc x sigma0 where 178/260 cells are greyed out as subcritical or feedback-dominated." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L3222-L3267> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


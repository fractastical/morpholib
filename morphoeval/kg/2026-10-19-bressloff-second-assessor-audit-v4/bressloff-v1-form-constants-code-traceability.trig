sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-code-traceability-second-assessor> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-code-traceability-second-assessor> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Code-to-model traceability: 89/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Every mathematical component in 2001-bressloff-v1-form-constants.py is explicitly cross-referenced in docstrings and comments to equations, sections, and figures of Bressloff et al. (2001/2002) or to exact file and line ranges in the upstream Rust implementation (planform.rs, presets.rs, params.rs), and Section 14 of morphoeval/lean/MathOfBiology.lean formalizes the log-polar pullback classification, cubic roll stability criterion, and Floquet period-doubling return map. We deduct 4 points because the codebase maintains two parallel cubic-selection paths (branch_selection_upstream at lines 1082-1210 and branch_selection_full at lines 1219-1370): verify_paper_calibration_parity (line 1998) and verify_paper_calibration_runs (line 2101) test only branch_selection_upstream and perturbative critical_q, whereas all rendering and badges use branch_selection_full and q_mode, which silently diverge on presets such as fig16_odd (q_mode=1.0551 vs critical_q=1.0280), fig29_square_noncontoured (square/cobweb with roll_stable=False vs roll/spiral with roll_stable=True), and fig30_rhombic_noncontoured. We deduct 4 points because Panel A (lines 2933-2952) sets stab_gal = rendered_gallery[0]['stability'] (which in Pass 4 is roll_noncontoured_derived with A_loc=0.15) and plots its invalid n=1 perturbative curve under the label 'Gallery presets even (theta_0=60 deg, xi_hat_lat=1.5, q*=1.49)', misrepresenting the A_loc=1.0 contoured gallery presets (Columns III-V, where q*=1.45). We deduct 3 points because the top-level README.md description (lines 435-458) does not match the current Pass 4 code architecture or CLI flags (--retinal-map, --sigmoid-baseline, chiral-mirror, and repo- added presets)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-4> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L376–L595" ;
        dct:description "Paper presets mapped to Bressloff (2001) Figs. 16-17, 29-36 and (2002) Figs. 5-7 plus repo-added derived and paper-scale presets." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L376-L595> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L1082–L1370" ;
        dct:description "Parallel branch_selection_upstream (parity-tested) and branch_selection_full (used for rendering/badges/sweeps) implementations." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L1082-L1370> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L2922–L2968" ;
        dct:description "Panel A plotting stab_gal = rendered_gallery[0]['stability'] (A_loc=0.15, q*=1.49) labeled as 'Gallery presets even' alongside the exact m=0/m=1 curves." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L2922-L2968> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/MathOfBiology.lean L510–L597" ;
        dct:description "Lean 4 theorems for log-polar pullback classes, cubic roll transverse stability (with Fig. 38 instance), and Floquet +-1 return maps." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/morphoeval/lean/MathOfBiology.lean#L510-L597> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


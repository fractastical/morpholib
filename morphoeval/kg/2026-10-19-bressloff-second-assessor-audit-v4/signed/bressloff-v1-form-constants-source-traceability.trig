sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-source-traceability-second-assessor> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-source-traceability-second-assessor> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Source and data traceability: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "The script docstring, datasets/bressloff/README.md, and datasets/bressloff/paper_citations.bib provide complete bibliographic records with resolvable DOIs and PMIDs for all eight primary and supporting publications (Bressloff et al. 2001, 2002; Ermentrout & Cowan 1979; Rule et al. 2011; Horton & Hoyt 1991; Tamekue et al. 2024; Klüver 1966; Matthews & Cox 2000). All four JSON fixtures in datasets/bressloff/ are SHA-256-pinned in FIXTURE_CHECKSUMS and verified at runtime, with explicit provenance attribution to MesmerPrism/bressloff-v1-form-constants commit 344863a1bd9e8a8e8c9cb20aced2897f3ffb2c4c (derived from karacsm/V1-sim) and per-constant attribution in RETINO_CONSTANT_PROVENANCE separating Drasdo/Bressloff constants (w0, eps) from upstream params.rs constants (alpha, beta). We deduct 4 points because datasets/bressloff/driven-neural-fields-registry.json (lines 80-209) includes six model entries attributed to 'nicks-et-al-2021' and 'bolelli-prandi-2025' that lack DOIs, full bibliographic details, or entries in paper_citations.bib. We deduct 3 points because the top-level README.md section for this script (lines 435-458) was not updated after Pass 4 and misstates the current provenance of the gallery presets, cubic equations, retinal map default, and self-test check count." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-4> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L11–L49" ;
        dcterms:description "Primary sources list with DOIs, PMIDs, and upstream commit hash 344863a1bd9e8a8e8c9cb20aced2897f3ffb2c4c." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L11-L49> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L152–L193" ;
        dcterms:description "SHA-256 fixture checksum table, RETINO_CONSTANT_PROVENANCE map, and PAPER_SCALE_ANCHORS with section citations." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L152-L193> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/bressloff/paper_citations.bib L1–L104" ;
        dcterms:description "BibTeX database covering the eight cited papers, but omitting nicks-et-al-2021 and bolelli-prandi-2025 present in driven-neural-fields-registry.json." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/datasets/bressloff/paper_citations.bib#L1-L104> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "README.md L433–L459" ;
        dcterms:description "Top-level README section still describing Pass 3 state (bare-overlap cubic coefficients, 3 imposed gallery panels, left-meridian seam default, and 27 self-test checks)." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/README.md#L433-L459> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-model-fidelity-second-assessor> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L615–L696" ;
        dcterms:description "Local orientation Fourier harmonics (Eq. 3.12), modified Bessel series, anisotropic lateral harmonics (Eq. 4.9), and perturbative O(beta^2) dispersion relation." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L615-L696> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L833–L938" ;
        dcterms:description "Exact Hermitian orientation operator W_k on |m|<=8 and resolvent R_K; line 855 uses single-component argmax |v_m| instead of real harmonic norm sqrt(2)|v_m|, and line 934 uses a point-equality 1e-6 cutoff." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L833-L938> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L946–L1008" ;
        dcterms:description "Full cubic coefficient calculation gamma(theta) = [3*s3*Gamma_3 - 2*s2^2*Q]/N on a 5-deg grid with resonance_gap checked only at K=0 and K=2q." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L946-L1008> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L1219–L1370" ;
        dcterms:description "Full cubic branch selection with all-angle roll stability margin, external lattice perturbation checks, and eta-aware Lambda_r/Lambda_h thresholds." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L1219-L1370> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-model-fidelity-second-assessor> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Model fidelity to source: 82/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "The script faithfully implements the Bressloff et al. (2001 Section 3-5; 2002 Section 1.1) local orientation harmonics (Eq. 3.12), anisotropic Fourier-Bessel lateral coupling (Eq. 4.9), O(beta^2) perturbative dispersion curves, exact Hermitian orientation-operator diagonalization on |m| <= 8, full cubic amplitude coefficients gamma(theta) = [3*s3*Gamma_3 - 2*s2^2*Q]/N with sigmoid derivatives (s2, s3) and linear resolvent R_K at K = 0 and k_i +- k_j (Eqs. 5.9-5.15), eta-aware hexagon/roll thresholds, and both conformal (2001) and exact two-regime (2002 Eq. 1.1) retino-cortical maps with tangent-map orientation pullback. We deduct 5 points because exact_orientation_modes (lines 855-867) assigns each eigenvector's dominant harmonic via argmax |v_m| on complex exponential components e^{2im*phi} rather than the real harmonic L2 norm sqrt(|v_+m|^2 + |v_-m|^2) = sqrt(2)|v_m| for m >= 1, misclassifying modes with up to 66.7% m=1 power as m=0, shifting the full-operator harmonic flip to A_loc=0.275, and dropping the even_1 curve to NaN at 118/128 wavenumbers at A_loc=0.24. We deduct 5 points because resolvent_apply (lines 926-937) projects out the critical mode only when |lambda_c - lambda_n| < 1e-6*lambda_c, which removes the |k_1 - k_2| = q* triad resonance at theta=60 deg exactly (Q=0.317) but leaves a spurious 1/(lambda_c - lambda(k_-)) double-spike at adjacent grid angles theta=55 deg (Q=0.699) and 65 deg (Q=0.831) whenever s2 != 0, distorting Panel B and shifting the optimal rhombic angle at sigma0=0.4 from 45 deg to 55 deg. We deduct 5 points because quintic saturation/selection terms (2001 Section 5, needed for the odd-branch H0/H_pi degeneracy and sigma0 <= 0.25 subcritical regime), Matthews-Cox (2000) mean-mode-coupled amplitude equations (needed where the nearly marginal K=0 mode makes 178/260 regime-map cells unreliable), and a dynamical solver for Rule et al. (2011) Floquet tongues are not implemented. Finally, we deduct 3 points because cortical and retinal patterns are evaluated as static mode superpositions passed through tanh rather than integrating the V1 neural-field PDE or amplitude ODEs." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-4> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


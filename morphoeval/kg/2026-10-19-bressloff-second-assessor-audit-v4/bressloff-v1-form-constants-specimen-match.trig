sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-specimen-match-second-assessor> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-specimen-match-second-assessor> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Morphological realism / specimen match: 80/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "The five-column gallery in bressloff_v1_form_constants_morphospace.png and the animation docs/media/bressloff_v1_form_constants.gif render visually distinct cortical planforms and retinal pullbacks for Klüver's four form-constant families (I. Tunnel/Rings, II. Spiral/Funnel, III. Cobweb/Square, IV. Honeycomb/Hex) plus the cubic-selected Rhombic lattice (V), with seamless conformal log-polar pullbacks (spiral chirality 0.892, seam 0.000), white tangent-map orientation line elements on contoured panels, and accurate SELECTED / STABLE-coexisting / IMPOSED-unstable badges. We deduct 7 points because in the contoured (m=1) regime the model renders Klüver's cobweb (Column III) as an unstable imposed lattice (2*gamma(90 deg) > gamma(0) for all sigma0) and honeycomb (Column IV) as a subdominant coexisting branch behind rhombic, so only two of Klüver's four form constants (the derived m=0 rolls in Columns I-II) are natively selected by the cubic equations. We deduct 5 points because the five main gallery columns render at q* ~ 1.40-1.45 (lambda_c ~ 8.7-9.0 mm, ~5.8 rings across 1-40 deg and 8.4 rings across 0-90 deg), which is ~3.2x coarser than the 30-36 perceived stripes (2.4-3.2 mm cortical wavelength) stated in Bressloff et al. (2002 Section 1.1), while the paper_scale_tunnel preset is relegated to a small inset in Panel D. We deduct 4 points because make_gif (lines 3359-3395) forces envelope_only=True on all five presets, omitting the orientation argmax and oriented line elements and labeling every GIF frame 'non-contoured' even for the contoured presets fig31_square_even, fig35_hex_zero_even, and fig33_rhombic_even. We deduct 4 points because no direct visual overlay or side-by-side comparison is made against empirical psychophysical subject drawings or digitized source paper curves, and Panel C plots upstream Floquet fixture curves that fail 4 acceptance checks (RMS beta error 0.154 > 0.10)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-specimen-match-4> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "bressloff_v1_form_constants_morphospace.png (generated output)" ;
        dct:description "Five-column cortical/retinal gallery with SELECTED/STABLE/IMPOSED badges and orientation line elements, plus stability, cubic, Floquet, magnification, ledger, sweep, and regime-map panels. — bressloff_v1_form_constants_morphospace.png: rendered output of 2001-bressloff-v1-form-constants.py at 2aac102, image/png, 1852599 B, 3577×2495 px, artifact_sha256 59ee2445fa3cc7fe6fa27a91b99eb16d2b412d31933f5869271e80c9a736ef7c (sha256 59ee2445fa3cc7fe6fa27a91b99eb16d2b412d31933f5869271e80c9a736ef7c), spec_fingerprint fff701034002726a27d7e6e2ee5c626f921c8d06f78514d8965ad139e7a192a7" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/bressloff_v1_form_constants.gif (generated output)" ;
        dct:description "36-frame animation cycling through the five gallery presets with seamless phase loops but rendered with envelope_only=True and titled 'non-contoured' on all frames. — docs/media/bressloff_v1_form_constants.gif: rendered output of 2001-bressloff-v1-form-constants.py at 2aac102, image/gif, 2361492 B, 640×350 px, 36 frames, artifact_sha256 c6cebc034d11971f6d0f6cd89024fd1f534502f80f2c691e11654b0508241a39 (sha256 c6cebc034d11971f6d0f6cd89024fd1f534502f80f2c691e11654b0508241a39), spec_fingerprint fff701034002726a27d7e6e2ee5c626f921c8d06f78514d8965ad139e7a192a7" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L1527–L1706" ;
        dct:description "Cortical torus and retinal pullback renderer supporting conformal (2001) and exact (2002) maps, three hemifield conventions, and tangent-map orientation fields." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L1527-L1706> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L3325–L3418" ;
        dct:description "GIF generator passing envelope_only=True (line 3362) and hardcoding 'non-contoured' in the suptitle (line 3389) for all five presets." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L3325-L3418> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


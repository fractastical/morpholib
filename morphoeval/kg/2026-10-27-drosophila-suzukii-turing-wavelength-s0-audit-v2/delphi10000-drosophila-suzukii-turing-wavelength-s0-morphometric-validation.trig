sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila suzukii Turing onset wavelength at 2.046 µm (0 Ma, detail scale) — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 0.9999999995, RMSE = 4.16e-4 per time unit (reference for r is the null of 0, not a copy of the result). Stripe-seed mean spacing is 2.046 µm with CV 0.056, against the fastest-growing wavelength 2.116 µm, so the value is not the reference. Labyrinth CV stays 0.37 and KS stays 0.63; that gap is reported, not tuned away. Specimen foreground 0.203 vs prior 0.40, melanin 0.028 vs 0.10, left-minus-right darkness -5.28 vs 0, abdominal troughs 7 vs 6, coherency 0.375 vs 0.50. Ablation std ratio is about 1e-15 versus a reference of 1." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-measurement-ablation-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-measurement-onset-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-measurement-specimen-abdominal-band-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-measurement-specimen-foreground-area-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-measurement-specimen-left-minus-right-darkness>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-measurement-specimen-melanin-area-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-measurement-stripe-seed-spacing-mean-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-measurement-stripe-spacing-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-measurement-stripe-spacing-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-measurement-ablation-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_std_ratio = 2.8509323824832185e-15 1" ;
        schema:measurementTechnique "Equal-diffusion control std(u) / focal std(u). Reference 1 would mean the control failed." ;
        schema:name "ablation_std_ratio" ;
        schema:unitText "1" ;
        schema:value "2.8509323824832185e-15" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-measurement-ablation-std-ratio-reference> .

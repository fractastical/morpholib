            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .

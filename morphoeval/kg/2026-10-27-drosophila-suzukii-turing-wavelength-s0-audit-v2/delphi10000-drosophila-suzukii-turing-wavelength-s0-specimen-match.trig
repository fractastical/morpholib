sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila suzukii Turing onset wavelength at 2.046 µm (0 Ma, detail scale) — Morphological realism / specimen match: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The plate (male wing spot, female ovipositor, 1 mm bar) sits beside the suzukii labyrinth, a flat subobscura field on the same color scale, and a longer-wavelength takahashii field. The null is visibly flat rather than a stretched roundoff pattern. The GIF is 12 frames at 960×640 and ends on the adult plate, so the fitness comparison sees the animal; the carrier itself is a microstructure, not a second portrait of the fly." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-specimen-match-1>,

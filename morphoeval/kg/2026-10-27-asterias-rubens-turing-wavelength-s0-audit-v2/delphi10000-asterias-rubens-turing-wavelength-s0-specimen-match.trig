        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.78"^^xsd:double ;

<https://w3id.org/delphi/resource/math-law/delphi10000-asterias-rubens-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homogeneous Schnakenberg trace is negative" ;
    dct:description "Diffusion-free stability of the optic-pigment steady state | Variables: f_u = 47/55, g_v = -9801/10000" ;
    dct:source "Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0; Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-asterias-rubens-turing-wavelength-s0.py#L98-L145>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3123_asterias_rubens_turing_wavelength_s0.lean#L24-L26> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "f_u + g_v < 0 at (u*, v*) = (a+b, b/(a+b)^2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rspb.2013.3011>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3123.homogeneous_trace_negative" ;
    pk:leanTheorem "MathOfBiology.Loop_3123.homogeneous_trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-asterias-rubens-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber k_c" ;
    dct:description "Selects the pigment / ocellus wavelength on the 576 µm patch | Variables: D_v/D_u = 7.62, lambda = 115.2 um, domain = 576.0 um" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; Murray (1981) DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-asterias-rubens-turing-wavelength-s0.py#L113-L145>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3123_asterias_rubens_turing_wavelength_s0.lean#L30-L32> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c = 115.2 um" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rspb.2013.3011>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3123.diffusion_drive_positive" ;
    pk:leanTheorem "MathOfBiology.Loop_3123.diffusion_drive_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-asterias-rubens-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Five wavelengths per pentaradial patch" ;
    dct:description "One critical wavelength per arm sector at this scale, unlike the 10 µm cell or the 1 mm optic cushion | Variables: n_waves = 5, lambda_tenths = 1152, domain_tenths = 5760" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-asterias-rubens-turing-wavelength-s0.py#L70-L86>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3123_asterias_rubens_turing_wavelength_s0.lean#L18-L20> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "L = 5 * lambda_c = 576.0 um" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rspb.2013.3011>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3123.five_wavelengths_fill_domain" ;
    pk:leanTheorem "MathOfBiology.Loop_3123.five_wavelengths_fill_domain" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-asterias-rubens-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Scale lies between cellular and organ tiers" ;
    dct:description "What changes at this Holocene scale relative to the adjacent tiers. The chronoseries itself is a single extant point. | Variables: cellular predecessor tier 10 um, organ successor tier 1000 um, age 0 Ma" ;
    dct:source "Murray (1981) DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-asterias-rubens-turing-wavelength-s0.py#L70-L74>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3123_asterias_rubens_turing_wavelength_s0.lean#L36-L38> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "10 um < 115.2 um < 1000 um" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rspb.2013.3011>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3123.scale_between_cellular_and_organ" ;
    pk:leanTheorem "MathOfBiology.Loop_3123.scale_between_cellular_and_organ" ;
    pk:leanVerified true .


    <https://doi.org/10.1103/PhysRevLett.80.1564> dct:date "1998"^^xsd:gYear ;
        dct:title "Spontaneous Helix Hand-Reversal and Tendril Perversion" .
    <https://doi.org/10.1111/j.1095-8339.1865.tb00011.x> dct:date "1865"^^xsd:gYear ;
        dct:title "On the Movements and Habits of Climbing Plants" .
    <https://doi.org/10.1126/science.1223304> dct:date "2012"^^xsd:gYear ;
        dct:title "How the Cucumber Tendril Coils and Overwinds" .

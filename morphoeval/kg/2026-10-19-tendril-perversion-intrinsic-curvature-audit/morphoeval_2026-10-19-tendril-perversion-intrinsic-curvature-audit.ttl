<https://w3id.org/probknow/resource/claim/morphoeval-goriely-tendril-perversion-intrinsic-curvature> a pk:Claim ;
    rdfs:label "Goriely & Tabor (1998) PRL / Gerbode et al. (2012) Science Kirchhoff elastic rod tendril perversion & G-fiber overwinding (Climbing plant tendrils (Cucumis sativus, Passiflora caerulea, Bryonia dioica, Echinocystis lobata))",
        "Goriely & Tabor (1998) PRL / Gerbode et al. (2012) Science Kirchhoff elastic rod tendril perversion & G-fiber overwinding faithfully reproduces Climbing plant tendrils (Cucumis sativus, Passiflora caerulea, Bryonia dioica, Echinocystis lobata) morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/goriely-tendril-perversion-intrinsic-curvature-1>,
        <https://w3id.org/probknow/resource/math-law/goriely-tendril-perversion-intrinsic-curvature-2>,
        <https://w3id.org/probknow/resource/math-law/goriely-tendril-perversion-intrinsic-curvature-3> ;
    dct:description "The simulation script(s) 1998-goriely-tendril-perversion-intrinsic-curvature.py implement the cited source model as published and produce forms that match real Climbing plant tendrils (Cucumis sativus, Passiflora caerulea, Bryonia dioica, Echinocystis lobata) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 55.4/100, audit 2026-10-19-tendril-perversion-intrinsic-curvature-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/1998-goriely-tendril-perversion-intrinsic-curvature.py> ;
    schema:about "Climbing plant tendrils (Cucumis sativus, Passiflora caerulea, Bryonia dioica, Echinocystis lobata)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/1998-goriely-tendril-perversion-intrinsic-curvature.py; output: docs/media/tendril_perversion_intrinsic_curvature_comparison.png; organism: Climbing plant tendrils (Cucumis sativus, Passiflora caerulea, Bryonia dioica, Echinocystis lobata); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 81dfb3e9af1997e6ab25d20a9df9a7e1c95cc098270169bcb2bef6a18286dabb; artifact_sha256: 4031af6d289a50a4062f9e99cb70f5bd44044d27250bf245845f5d9949c8b07d; input_dataset_sha256: {datasets/tendril_perversion_intrinsic_curvature/paper_citations.bib=f0760535ef74775e..., datasets/tendril_perversion_intrinsic_curvature/scout_manifest.json=801e196968b34405..., datasets/tendril_perversion_intrinsic_curvature/tendril_perversion_helix_specimen.jpg=14409d193142442d..., datasets/tendril_perversion_intrinsic_curvature/tendril_perversion_intrinsic_curvature_reference.json=8af7ac3175f6890f...}" ;
    pk:derivedFromPaper <https://doi.org/10.1007/s00332-002-0493-1>,
        <https://doi.org/10.1103/PhysRevLett.80.1564>,
        <https://doi.org/10.1111/j.1095-8339.1865.tb00011.x>,
        <https://doi.org/10.1126/science.1223304> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-code-traceability>,

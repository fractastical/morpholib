sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-goriely-tendril-perversion-intrinsic-curvature> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Goriely & Tabor (1998) PRL / Gerbode et al. (2012) Science Kirchhoff elastic rod tendril perversion & G-fiber overwinding — Morphometric validation: 54/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L125-146) returns only 2 basic analytical checks without pitchfork bifurcation curve correlation, overwinding peak Delta_N comparison, species coil radius/pitch validation, or specimen image segmentation metrics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1998-goriely-tendril-perversion-intrinsic-curvature.py L125–L146: Only 2 baseline measurements returned <https://github.com/fractastical/morpholib/blob/8871db0/1998-goriely-tendril-perversion-intrinsic-curvature.py#L125-L146>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-critical-pitchfork-tension-tc-goriely-tabor-1998-eq-11>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-net-topological-link-delta-lk-across-perversion> ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-critical-pitchfork-tension-tc-goriely-tabor-1998-eq-11> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Critical pitchfork tension Tc (Goriely & Tabor 1998 Eq. 11) = 0.3018 mN" ;
        schema:measurementTechnique "Analytical Tc = B * kappa_0^2 / (1 + Gamma)" ;
        schema:name "Critical pitchfork tension Tc (Goriely & Tabor 1998 Eq. 11)" ;
        schema:unitText "mN" ;
        schema:value "0.3018" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-critical-pitchfork-tension-tc-goriely-tabor-1998-eq-11-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-critical-pitchfork-tension-tc-goriely-tabor-1998-eq-11-reference> a schema:PropertyValue ;
        dct:source "Goriely & Tabor (1998) Phys. Rev. Lett. 80:1564-1567 Eq. 11" ;
        schema:value "0.3018" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-net-topological-link-delta-lk-across-perversion> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Net topological link Delta_Lk across perversion = 0.0 turns" ;
        schema:measurementTechnique "Integral of antisymmetric torsion tau(s) over [-L/2, L/2]" ;
        schema:name "Net topological link Delta_Lk across perversion" ;
        schema:unitText "turns" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-net-topological-link-delta-lk-across-perversion-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-net-topological-link-delta-lk-across-perversion-reference> a schema:PropertyValue ;
        dct:source "Goriely & Tabor (1998) PRL zero-link condition" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 064 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


<https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Conte et al. (2012), Martin et al. (2009) & He et al. (2014) Drosophila ventral furrow invagination biomechanics — Model fidelity to source: 62/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Implements incompressible trapezoidal cell geometry `A_i = 0.5*(w_ap + w_ba)*h_i = A_0` (L74-84), but the baseline pass uses simplified linear interpolation rather than explicit RK2 integration of the Martin et al. (2009) ratcheted Myosin-II pulse ODE and lacks the 2D polygonal cross-sectional blastoderm ring solver." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "2012-he-drosophila-ventral-furrow.py L87–L160: Baseline simulator requiring explicit pulse ODE and 2D polygonal ring mechanics <https://github.com/fractastical/morpholib/blob/317bc3c/2012-he-drosophila-ventral-furrow.py#L87-L160>" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-1> ;
    pk:hasScore 6.2e-01 ;
    pk:hasVerdict "mostly faithful" .


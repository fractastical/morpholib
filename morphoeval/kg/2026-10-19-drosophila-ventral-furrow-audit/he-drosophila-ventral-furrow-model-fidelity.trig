sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-he-drosophila-ventral-furrow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Conte et al. (2012), Martin et al. (2009) & He et al. (2014) Drosophila ventral furrow invagination biomechanics — Model fidelity to source: 62/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements incompressible trapezoidal cell geometry `A_i = 0.5*(w_ap + w_ba)*h_i = A_0` (L74-84), but the baseline pass uses simplified linear interpolation rather than explicit RK2 integration of the Martin et al. (2009) ratcheted Myosin-II pulse ODE and lacks the 2D polygonal cross-sectional blastoderm ring solver." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2012-he-drosophila-ventral-furrow.py L87–L160: Baseline simulator requiring explicit pulse ODE and 2D polygonal ring mechanics <https://github.com/fractastical/morpholib/blob/317bc3c/2012-he-drosophila-ventral-furrow.py#L87-L160>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-1> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L74–L84" ;
        dct:description "Incompressible trapezoidal wedge cell geometry helper" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2012-he-drosophila-ventral-furrow.py#L74-L84> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2014.07.013>,
            <https://doi.org/10.1038/nature07522>,
            <https://doi.org/10.1038/nature13070>,
            <https://doi.org/10.1371/journal.pone.0049973> .
    <https://doi.org/10.1016/j.bpj.2014.07.013> dct:date "2014"^^xsd:gYear ;
        dct:title "Passive mechanical forces control cell-shape change during Drosophila ventral furrow formation" .
    <https://doi.org/10.1038/nature07522> dct:date "2009"^^xsd:gYear ;
        dct:title "Pulsed contractions of an actin-myosin network drive apical constriction" .
    <https://doi.org/10.1038/nature13070> dct:date "2014"^^xsd:gYear ;
        dct:title "Apical constriction drives tissue-scale hydrodynamic flow to mediate cell elongation" .
    <https://doi.org/10.1371/journal.pone.0049973> dct:date "2012"^^xsd:gYear ;
        dct:title "Biomechanical analysis of ventral furrow formation in Drosophila melanogaster" .
}


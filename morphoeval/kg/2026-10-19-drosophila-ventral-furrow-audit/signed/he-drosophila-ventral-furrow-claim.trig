sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-he-drosophila-ventral-furrow> a pk:Claim ;
        rdfs:label "Conte et al. (2012), Martin et al. (2009) & He et al. (2014) Drosophila ventral furrow invagination biomechanics faithfully reproduces Drosophila melanogaster (gastrulating cellular blastoderm embryo) morphology" ;
        dcterms:description "The simulation script(s) 2012-he-drosophila-ventral-furrow.py implement the cited source model as published and produce forms that match real Drosophila melanogaster (gastrulating cellular blastoderm embryo) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 58.2/100, audit 2026-10-19-drosophila-ventral-furrow-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2012-he-drosophila-ventral-furrow.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2012-he-drosophila-ventral-furrow.py; output: docs/media/drosophila_ventral_furrow_comparison.png; organism: Drosophila melanogaster (gastrulating cellular blastoderm embryo); checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 472aac8153c8fe9cc40194b17fd78b655588c12f710d6e8a68aba7963971c58f; artifact_sha256: 877d89b820fd2debb25ddbc99e3f627bbe99a15a7327f54c18c26df702ed6ae5; input_dataset_sha256: {datasets/drosophila_ventral_furrow/drosophila_ventral_furrow_reference.json=5c6f1960cef1be19..., datasets/drosophila_ventral_furrow/drosophila_ventral_furrow_specimen.jpg=f426366f7ede436d..., datasets/drosophila_ventral_furrow/scout_manifest.json=0c6354ab1d934ba3...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.bpj.2014.07.013>,
            <https://doi.org/10.1038/nature07522>,
            <https://doi.org/10.1038/nature13070>,
            <https://doi.org/10.1371/journal.pone.0049973> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-specimen-match> ;
        pk:weightOfEvidence "0.582"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/317bc3c/2012-he-drosophila-ventral-furrow.py> a schema:SoftwareSourceCode ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py" ;

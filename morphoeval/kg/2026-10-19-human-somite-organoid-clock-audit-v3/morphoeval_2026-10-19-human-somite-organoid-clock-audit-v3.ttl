<https://w3id.org/probknow/resource/math-law/diaza-human-somite-organoid-clock-5> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Yamanaka et al. (2023) Matrigel-Embedded Elastic Boundary Force Scaling Law (Pass 3)" ;

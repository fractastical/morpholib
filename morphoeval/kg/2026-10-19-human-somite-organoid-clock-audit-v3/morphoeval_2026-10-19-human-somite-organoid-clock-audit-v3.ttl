    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def neighbour_mean_delta (k d : Nat) : Nat :=
  (k * d) / k
def hex_lattice_edge_count (n : Nat) : Nat :=
  (6 * n) / 2
def notch_gated_synthesis (alpha eps s2 : Nat) : Nat :=

    dct:source "Yamanaka et al. (2023) Nature 614:509-520; Sanaki-Matsumiya et al. (2022) Nat. Commun. 13:2325" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L1029-L1176>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_028_human_somite_organoid_clock.lean#L175-L212> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def matrigel_stiffness (kappa phi : Nat) : Nat :=

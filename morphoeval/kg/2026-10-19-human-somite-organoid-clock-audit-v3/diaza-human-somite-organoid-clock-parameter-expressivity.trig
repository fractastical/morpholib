sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-diaza-human-somite-organoid-clock> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Diaz-Cuadros et al. (2020, 2023) & Matsuda et al. (2020) human pluripotent stem-cell segmentation clock and metabolic tempo scaling model — Parameter expressivity: 84/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Four parameters now visibly control the form they should: lambda dilates the period exactly linearly (L297-363); Notch coupling strength eps raises retained synchrony 0.26 -> 0.96 over 0 -> 0.25 (L961-987); the coupling delay tau_c/T switches in-phase stability off below ~0.6 and on above it and modulates the collective period 235 -> 417 min (L989-1027); the Matrigel fraction raises rosette polarity monotonically (Spearman rho 0.94) and shrinks the aggregate 85 -> 28 um (L1153-1176). Deductions: `--tau-human` and `--thalf-human` are parsed but never used (L1931-1932) (-6); the 6 regimes and 6 species are not swept parameters but hard-coded tempo factors (L402-416, L498) (-6); R_end(eps) is non-monotone at eps = 0.35 (0.88 < 0.96), so the stated monotone control holds only up to 0.25 (-2); pre-DAPT synchronisation from random phases reaches only R = 0.40 in 5 cycles, and the lattice size / heterogeneity are not swept (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2019-diaza-human-somite-organoid-clock.py L1931–L1936: --tau-human / --thalf-human are never read (dead parameters); --eps-notch / --tau-c-fraction / --matrigel-pct do drive an extra run <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L1931-L1936>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-parameter-expressivity-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L961–L987" ;
        dct:description "Coupling-strength sweep eps in {0, 0.05, 0.1, 0.15, 0.25, 0.35} with Spearman rho" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L961-L987> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L989–L1027" ;
        dct:description "Coupling-delay sweep: mean-field T_coll(tau_c) and lattice in-phase stability window" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L989-L1027> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L1153–L1176" ;
        dct:description "Matrigel sweep 0-20 % with polarity, epithelial fraction, apical convergence, circularity and Spearman rho" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L1153-L1176> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


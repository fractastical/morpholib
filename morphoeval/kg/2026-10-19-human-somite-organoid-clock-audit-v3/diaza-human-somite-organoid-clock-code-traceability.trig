sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-diaza-human-somite-organoid-clock> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Diaz-Cuadros et al. (2020, 2023) & Matsuda et al. (2020) human pluripotent stem-cell segmentation clock and metabolic tempo scaling model — Code-to-model traceability: 84/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring (L1-106) states laws 1-5 with their Lean theorem names and the papers they come from; Sections 4b/4c carry docstrings tying each term to Lewis (2003), Herrgen (2010), Matsuda (2020) Nature and Yamanaka (2023); the math KG loop file registers laws 4-5 with code loci; Lean theorems 4-5 verify. Deductions: the lam_eff weights 0.82/0.18, exponent 0.38, 0.55/0.45 and 0.65/0.35 (L407, L411, L498) have no source and in practice are overridden by observed-period constants (-8); the rosette rate constants (L1073-1074) and the DAPT basal fraction are uncited choices (-4); the kymograph phase_lag exponent 1.4 and amplitude constants are uncited (-2); math KG code loci are section ranges rather than per-equation lines (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2019-diaza-human-somite-organoid-clock.py L1072–L1074: Rosette rate constants and Hill cue are phenomenological and uncited <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L1072-L1074>",
            "2019-diaza-human-somite-organoid-clock.py L402–L416: Unsourced tempo-factor weights/exponents overridden by observed-period constants <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L402-L416>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-code-traceability-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L1–L106" ;
        dct:description "Docstring: 9 sources, Pass 3 remediation statement, laws 1-5 with Lean theorem names" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L1-L106> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/diaza-human-somite-organoid-clock.yaml L128–L207" ;
        dct:description "Laws 4-5 registered with lean_theorem, lean_locus, variables, role, source and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/diaza-human-somite-organoid-clock.yaml#L128-L207> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


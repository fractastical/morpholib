sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-diaza-human-somite-organoid-clock> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Diaz-Cuadros et al. (2020, 2023) & Matsuda et al. (2020) human pluripotent stem-cell segmentation clock and metabolic tempo scaling model — Source and data traceability: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Nine primary sources with DOIs in the docstring, dataset README, BibTeX and reference JSON; the five Pass 3 DOIs and author lists were resolved against Crossref; the specimen and scout manifest are SHA-256 pinned and verified at every run (L145-176); the reference JSON records the Notch-lattice and Matrigel parameter tables with their empirical anchors and caveats (JSON L273-375). Deductions: the reference JSON digest is recomputed but not pinned, so silent edits to the kinetic tables would pass verification (-3); the specimen licence/URL is traceable but it is a chick SEM standing in for a human organoid (-3); the Herrgen tau_c anchor is zebrafish and is only qualitatively transferred (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-source-traceability-4> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L145–L176" ;
        dcterms:description "EXPECTED_SHA256 pins specimen + scout manifest; verify_dataset_integrity fails closed; reference JSON digest computed, not pinned" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L145-L176> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/human_somite_organoid_clock/human_somite_organoid_clock_reference.json L273–L375" ;
        dcterms:description "Pass 3 Notch-lattice / DAPT protocol and Matrigel mechanics tables with sources, anchors and caveats" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/human_somite_organoid_clock/human_somite_organoid_clock_reference.json#L273-L375> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/human_somite_organoid_clock/paper_citations.bib L45–L97" ;
        dcterms:description "Five Pass 3 BibTeX entries (Matsuda 2020 Nature, Lewis 2003, Riedel-Kruse 2007, Herrgen 2010, Sanaki-Matsumiya 2022), Crossref-verified" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/human_somite_organoid_clock/paper_citations.bib#L45-L97> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/human_somite_organoid_clock/README.md L34–L51" ;
        dcterms:description "Laws 4-5 and additional sources documented in the dataset README" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/human_somite_organoid_clock/README.md#L34-L51> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


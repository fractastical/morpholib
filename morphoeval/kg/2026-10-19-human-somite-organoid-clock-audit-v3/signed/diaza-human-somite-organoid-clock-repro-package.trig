sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-diaza-human-somite-organoid-clock> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L1830–L1925" ;
        dcterms:description "Self-test: SHA-256, tempo collapse, determinism (kymograph, lattice, rosette), 6-regime, allometry, specimen, lattice topology, DAPT protocol, sweeps, Matrigel, 9 measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L1830-L1925> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L1927–L1960" ;
        dcterms:description "CLI with --self-test, --eps-notch, --tau-c-fraction, --matrigel-pct; default run renders PNG, lattice PNG and GIF" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L1927-L1960> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/human_somite_organoid_clock_growth.gif (generated output)" ;
        dcterms:description "24-frame GIF regenerated (mouse vs human traces and kinematic wavefront only) — docs/media/human_somite_organoid_clock_growth.gif: rendered output of 2019-diaza-human-somite-organoid-clock.py at d58a084, image/gif, 611376 B, 1080×459 px, 24 frames, artifact_sha256 c1f0e50027e83dc0004f2191188e4701cb677e98aa724783118cbfe59ab81101 (sha256 c1f0e50027e83dc0004f2191188e4701cb677e98aa724783118cbfe59ab81101), spec_fingerprint dc5fc9fc0d0a3efa51f3e2df8dff0c42308ff7921502f484af6294b4b564fb24" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Diaz-Cuadros et al. (2020, 2023) & Matsuda et al. (2020) human pluripotent stem-cell segmentation clock and metabolic tempo scaling model — Reproducibility package: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Deterministic (seed 2019) with bitwise two-run checks for the kymograph, the lattice R(t) and the rosette positions; `--self-test` runs 8 blocks in ~14 s and the default render completes in ~17 s; all three media outputs are regenerated by the default invocation; new CLI flags are documented in argparse; the environment is recorded here. Deductions: no requirements lock file is vendored for this script (-4); two dead CLI parameters remain (-3); without MPLCONFIGDIR matplotlib emits a cache warning in this environment (-2); the GIF does not include the new lattice/rosette dynamics (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-repro-package-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-diaza-human-somite-organoid-clock> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Diaz-Cuadros et al. (2020, 2023) & Matsuda et al. (2020) human pluripotent stem-cell segmentation clock and metabolic tempo scaling model — Model fidelity to source: 80/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credit: the HES7 DDE (L189-294) is the Lewis/Matsuda delayed-autorepression form with separate tau_tx / tau_tl and half-life degradation rates; exact tempo-rescaling invariance is implemented and verified (L297-363); the new lattice (L734-947) couples cells through a delayed neighbour-mean DLL1 signal gating HES7 transcription (Lewis 2003 form, competitive-promoter threshold shift), reduces exactly to a single self-coupled DDE in the in-phase state (Lean theorem 4), and reproduces the delayed-coupling-theory result that in-phase synchrony depends on tau_c / T; DAPT is modelled as loss of NICD (basal promoter) and the washout reset follows. The Matrigel model (L1040-1151) implements an explicit elastic boundary force whose scaling is proven in Lean theorem 5. Deductions: the 6-regime series (L402-416) overrides its own generic formula with per-regime lam_eff values taken from the observed periods, so laws 2-3 are illustrated, not implemented as predictive kinetics (-8); the human regime does not use the vendored Matsuda (2020) human parameters (tau = 51, t_1/2,p = 40 min) but a 2.459x rescaled mouse cell (-4); the coupling gate scales both synthesis and repression threshold by the same factor, a reduction not derived from a promoter model, and tau_c = 0.8 T is chosen for stability rather than measured (-3); the rosette polarisation / epithelialisation rules are phenomenological (-3); the kymograph (L549-599) is a kinematic cosine wave unrelated to the DDE (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2019-diaza-human-somite-organoid-clock.py L402–L416: Per-regime lam_eff hard-coded from observed periods (human WT = 300/122; LbNOX/azide = (300/122)*(0.41/k_met)); the 6-regime fit is circular <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L402-L416>",
            "2019-diaza-human-somite-organoid-clock.py L608–L623: 'Human' cell kinetics = mouse anchor dilated by 300/122 (tau_tx 30.5, tau_tl 13.1, t_1/2,p 38.1 min), not the vendored tau = 51 / t_1/2,p = 40 min <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L608-L623>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-5> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L189–L294" ;
        dct:description "RK2 midpoint delayed HES7 mRNA/protein DDE with ln2/t_half degradation and parabolic peak period" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L189-L294> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L734–L947" ;
        dct:description "DLL1-Notch delay-coupled lattice: heterogeneous delays (L784), competitive-promoter gate and K_eff (L836-837), neighbour mean W @ D (L865), uniform-rate phase and Kuramoto R (L868-869), post-transient collective period (L898)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L734-L947> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L989–L1027" ;
        dct:description "Herrgen coupling-delay sweep on the exact mean-field reduction plus 8x8 lattice in-phase stability test" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L989-L1027> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L1040–L1151" ;
        dct:description "Matrigel rosette: k_M = kappa*phi shell force (L1109), ECM-contact polarisation (L1098), apical constriction (L1105), f(phi) Hill cue (L1072)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2019-diaza-human-somite-organoid-clock.py#L1040-L1151> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_028_human_somite_organoid_clock.lean L121–L212" ;
        dct:description "Theorems 4 (mean-field reduction, 3N edges, DAPT gating) and 5 (Matrigel boundary-force scaling), 0 sorrys" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_028_human_somite_organoid_clock.lean#L121-L212> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Schnakenberg Turing wavelength at 1.5 µm in Drosophila eugracilis (Pass 1 focal run) (Drosophila eugracilis)",
        "Schnakenberg Turing wavelength at 1.5 µm in Drosophila eugracilis (Pass 1 focal run) faithfully reproduces Drosophila eugracilis morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-eugracilis-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-eugracilis-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-eugracilis-turing-wavelength-s0-3>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-eugracilis-turing-wavelength-s0-4> ;
    dct:description "The simulation script(s) models/2026-delphi10000-drosophila-eugracilis-turing-wavelength-s0.py, docs/media/drosophila_eugracilis_turing_wavelength_s0_growth.gif implement the cited source model as published and produce forms that match real Drosophila eugracilis specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/media/drosophila_eugracilis_turing_wavelength_s0_growth.gif>,
        <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-eugracilis-turing-wavelength-s0.py> ;
    schema:about "Drosophila eugracilis" ;
    schema:additionalProperty "does_not_claim: That 1.485 µm was published as a measured eugracilis rhabdomere or sex-comb spacing.",
        "does_not_claim: That D. erecta is a stratigraphic ancestor. Position 13/41 is the flattened Holocene chronoseries.",
        "does_not_claim: The sibling 101 µm primordium parameters or DOI 10.1016/j.ydbio.2009.04.012, which Crossref assigns to a different paper.",
        "reconstructed_in_script: Length unit chosen so gamma=1 yields the assigned 1.485e-6 m detail wavelength.",
        "reconstructed_in_script: gamma=0.5 for D. erecta and 1.180 µm for D. ficusphila as the chronoseries contrast at this scale.",
        "reported_in_source: Ready, Hanson and Benzer 1976: the retina is a periodic neurocrystalline lattice.",
        "reported_in_source: Schnakenberg 1979 two-species kinetics.",
        "reported_in_source: Tanaka, Barmina and Kopp 2009: sex-comb rows rotate in some Drosophila lineages and are born longitudinal in others.",
        "reported_in_source: Turing 1952 dispersion relation and a critical wavenumber.",
        "transfer_boundary: The gallery JPEG is a project spiral plate with a 100 µm bar, not an SEM of a D. eugracilis ocellus." ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Drosophila eugracilis (Southeast Asian Gracile Fruit Fly)" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "II. Anaima (Invertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;
    pk:aristotelianSubalternClass "Entoma (Arthropoda)" ;
    pk:biologicalGenus "Drosophila" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-eugracilis-turing-wavelength-s0.py, https://github.com/fractastical/morpholib/blob/main/docs/media/drosophila_eugracilis_turing_wavelength_s0_growth.gif; output: docs/media/drosophila_eugracilis_turing_wavelength_s0_comparison.png; organism: Drosophila eugracilis; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion relation and a critical wavenumber. | Schnakenberg 1979 two-species kinetics. | Tanaka, Barmina and Kopp 2009: sex-comb rows rotate in some Drosophila lineages and are born longitudinal in others. | Ready, Hanson and Benzer 1976: the retina is a periodic neurocrystalline lattice.; reconstructed_in_script: Length unit chosen so gamma=1 yields the assigned 1.485e-6 m detail wavelength. | gamma=0.5 for D. erecta and 1.180 µm for D. ficusphila as the chronoseries contrast at this scale.; transfer_boundary: The gallery JPEG is a project spiral plate with a 100 µm bar, not an SEM of a D. eugracilis ocellus.; does_not_claim: That 1.485 µm was published as a measured eugracilis rhabdomere or sex-comb spacing. | That D. erecta is a stratigraphic ancestor. Position 13/41 is the flattened Holocene chronoseries. | The sibling 101 µm primordium parameters or DOI 10.1016/j.ydbio.2009.04.012, which Crossref assigns to a different paper.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
    pk:derivedFromPaper <https://doi.org/10.1016/0012-1606(76)90225-6>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.cub.2016.07.016>,
        <https://doi.org/10.1073/pnas.0807875106>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:externalAtlasDataset <https://codex.flywire.ai/>,
        <https://flybase.org/>,
        <https://flycellatlas.org/>,
        <https://insitu.fruitfly.org/>,
        <https://www.virtualflybrain.org/> ;
    pk:fossilLineageGroup "Sophophora melanogaster Subgroup Radiation (0–12 Ma)" ;

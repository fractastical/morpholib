<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg Turing wavelength at 1.5 µm in Drosophila eugracilis (Pass 1 focal run) — Code-to-model traceability: 84/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The module docstring and jacobian docstring name Turing 1952, Schnakenberg 1979 and Murray gamma. Lean Loop_3184 has six theorems and no sorry, encoding the 2100 > 1485 > 1180 nm order. Pass 1 does not yet exercise the mode-count comparison on simulated fields." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-code-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-code-traceability-2> ;
    pk:hasScore 8.4e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg Turing wavelength at 1.5 µm in Drosophila eugracilis (Pass 1 focal run) — Model fidelity to source: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Pass 1 implements the Schnakenberg PDE and the Turing wavenumber formula, and the gamma=1 length unit hits 1.485 µm by construction. The nonlinear FFT wavelength (1.809 µm) is not yet reconciled with k_c across a parameter series." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 1.5 µm in Drosophila eugracilis (Pass 1 focal run) — Morphometric validation: 66/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Single-point comparison only: analytic 1.485 µm versus FFT 1.809 µm, raw Otsu fraction 0.141 (reference fitness-script fraction 0.354), KS 0.343, focus spacing CV 0.294. No Pearson r, RMSE series, or ablation contrast in the pass-1 record." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-analytic-turing-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-ocellus-nearest-neighbor-spacing-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-predecessor-erecta-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-simulated-stripe-fft-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-specimen-stripe-arm-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-specimen-vs-simulation-ks-luminance>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-successor-ficusphila-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.66"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-analytic-turing-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "analytic_turing_wavelength_um = 1.485 µm" ;
        schema:measurementTechnique "Schnakenberg dispersion k_c at gamma=1, length unit fixed to the assigned 1.485 µm; reference is the nonlinear FFT wavelength of the same run" ;
        schema:name "analytic_turing_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "1.485" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-analytic-turing-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-analytic-turing-wavelength-um-reference> a schema:PropertyValue ;
        schema:value "1.808868" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-ocellus-nearest-neighbor-spacing-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ocellus_nearest_neighbor_spacing_cv = 0.29424 1" ;
        schema:measurementTechnique "CV of periodic nearest-neighbour distances among high-activator foci; 0 is a perfect lattice" ;
        schema:name "ocellus_nearest_neighbor_spacing_cv" ;
        schema:unitText "1" ;
        schema:value "0.29424" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-ocellus-nearest-neighbor-spacing-cv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-ocellus-nearest-neighbor-spacing-cv-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-predecessor-erecta-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "predecessor_erecta_wavelength_um = 2.100107 µm" ;
        schema:measurementTechnique "lambda(gamma=0.5) = 1.485/sqrt(0.5); predecessor contrast, not a published erecta SEM" ;
        schema:name "predecessor_erecta_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "2.100107" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-predecessor-erecta-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-predecessor-erecta-wavelength-um-reference> a schema:PropertyValue ;
        schema:value "1.485" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-simulated-stripe-fft-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated_stripe_fft_wavelength_um = 1.808868 µm" ;
        schema:measurementTechnique "Radial Fourier ring of the saturated activator field, parabolic peak, converted by the focal length unit" ;
        schema:name "simulated_stripe_fft_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "1.808868" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-simulated-stripe-fft-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-simulated-stripe-fft-wavelength-um-reference> a schema:PropertyValue ;
        schema:value "1.485" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-specimen-stripe-arm-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_stripe_arm_foreground_fraction = 0.140679 1" ;
        schema:measurementTechnique "Otsu dark-arm fraction of the vendored gallery plate; reference is verify_image_fitness foreground_fraction (different estimator)" ;
        schema:name "specimen_stripe_arm_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.140679" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-specimen-stripe-arm-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-specimen-stripe-arm-foreground-fraction-reference> a schema:PropertyValue ;
        schema:value "0.3543" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_structure_tensor_coherency = 0.205514 1" ;
        schema:measurementTechnique "Mean structure-tensor coherency of the full plate; reference is the fitness-script crop signature" ;
        schema:name "specimen_structure_tensor_coherency" ;
        schema:unitText "1" ;
        schema:value "0.205514" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        schema:value "0.8014" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-specimen-vs-simulation-ks-luminance> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_vs_simulation_ks_luminance = 0.342917 1" ;
        schema:measurementTechnique "Two-sample KS statistic between plate luminance and the rendered activator; 0 would be identical histograms" ;
        schema:name "specimen_vs_simulation_ks_luminance" ;
        schema:unitText "1" ;
        schema:value "0.342917" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-measurement-specimen-vs-simulation-ks-luminance-reference> .

        rdfs:label "Schnakenberg Turing wavelength at 1.5 µm in Drosophila eugracilis (Pass 1 focal run) — Morphological realism / specimen match: 72/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The 12-frame 720x540 GIF ends in a brown ocellar lattice rendered with the plate LUT. The plate itself is a spiral, so the geometry does not match even though both fill the frame. The plate is the gallery fallback, not a photograph of the fly." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;

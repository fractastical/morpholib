        rdfs:label "docs/media/drosophila_eugracilis_turing_wavelength_s0_growth.gif (generated output)" ;
        dct:description "12 frames, 720x540, focal growth from a two-arm seed to spots — docs/media/drosophila_eugracilis_turing_wavelength_s0_growth.gif: rendered output of models/2026-delphi10000-drosophila-eugracilis-turing-wavelength-s0.py at 0c76d15d, image/gif, 2461602 B, 720×540 px, 12 frames, artifact_sha256 b571e2432db179c48f44bc9d1665826d785dce5b144d6cc6d72d574c76bbc346 (sha256 b571e2432db179c48f44bc9d1665826d785dce5b144d6cc6d72d574c76bbc346), spec_fingerprint 4cd159ca0e54b6b9882667ea66ee1c36e85c25ecfd3d9cd25e35efca3e35cc7f" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-eugracilis-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-eugracilis-turing-wavelength-s0.py L247–L257" ;

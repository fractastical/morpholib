sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tero-physarum-transport-network> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Tero et al. (2010) Science & Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. adaptive Physarum tube conductivity network, shortest-path phase transition, Murray's cube law, and Tokyo rail Pareto trade-off — Morphometric validation: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L806-900) computes 9 reference-anchored morphometric measurements with uncertainty, Pearson p-values, RMSE, and negative controls: sublinear gamma=0.6 flux share 0.7322 (ref 0.7401), superlinear gamma=1.8 flux share 1.0000 (ref 1.0000, gamma=0 ablation delta +0.3333), TL_MST phase transition Pearson r = 0.99885 (RMSE = 0.0363, p = 3.83e-9), FT phase transition Pearson r = 0.99745 (RMSE = 0.0245, p = 4.12e-8), gamma=1.8 Kanto TL_MST = 1.7310 (ref 1.7500), gamma=1.8 Kanto FT = 0.8089 (ref 0.8400 vs MST 0.00), Murray cubic ratio 1.0000 (RMSE = 3.88e-9), specimen Betti-1 loops = 33 (ref 33), and specimen Y-junction Murray ratio 0.8926 +- 0.2774 (ref 0.8926)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-fault-tolerance-ft-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-normalized-total-length-tl-mst-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-murray-s-cube-law-cubic-radius-ratio-r1-3-r2-3-r0-3-at-gamma-4-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-physarum-polycephalum-specimen-enclosed-anastomosing-loop-count-betti-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-physarum-polycephalum-specimen-y-junction-murray-cubic-radius-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-tokyo-rail-pareto-regime-gamma-1-8-fault-tolerance-ft>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-tokyo-rail-pareto-regime-gamma-1-8-normalized-total-length-tl-mst>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-two-path-sublinear-gamma-0-6-short-path-flux-share-q1-i0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-two-path-superlinear-gamma-1-8-winner-takes-all-shortest-path-flux-share-q1-i0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-fault-tolerance-ft-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Multi-source gamma phase transition Fault Tolerance FT correlation = 0.99745 Pearson r" ;
        dct:description "RMSE = 0.0245, p = 4.12e-08" ;
        schema:measurementTechnique "8-point gamma sweep in [0.8, 2.4] comparing simulated FT against Tero et al. (2010) Fig. 3B (RMSE = 0.0245, p = 4.12e-08)" ;
        schema:name "Multi-source gamma phase transition Fault Tolerance FT correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99745" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-fault-tolerance-ft-correlation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-fault-tolerance-ft-correlation-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-normalized-total-length-tl-mst-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Multi-source gamma phase transition normalized Total Length TL_MST correlation = 0.99885 Pearson r" ;
        dct:description "RMSE = 0.0363, p = 3.83e-09" ;
        schema:measurementTechnique "8-point gamma sweep in [0.8, 2.4] comparing simulated TL_MST against Tero et al. (2010) Fig. 3 (RMSE = 0.0363, p = 3.83e-09)" ;
        schema:name "Multi-source gamma phase transition normalized Total Length TL_MST correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99885" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-normalized-total-length-tl-mst-correlation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-normalized-total-length-tl-mst-correlation-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-murray-s-cube-law-cubic-radius-ratio-r1-3-r2-3-r0-3-at-gamma-4-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Murray's cube law cubic radius ratio (r1^3 + r2^3)/r0^3 at gamma = 4/3 = 1.0 (r_1^3 + r_2^3) / r_0^3" ;
        dct:description "exact Hagen-Poiseuille D propto r^4 & Q propto D^(3/4) = r^3 identity (RMSE = 3.88e-09)" ;
        schema:measurementTechnique "7-split Y-junction bifurcation sweep at critical vascular exponent gamma = 4/3 (RMSE = 3.88e-09)" ;
        schema:name "Murray's cube law cubic radius ratio (r1^3 + r2^3)/r0^3 at gamma = 4/3" ;
        schema:unitText "(r_1^3 + r_2^3) / r_0^3" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-murray-s-cube-law-cubic-radius-ratio-r1-3-r2-3-r0-3-at-gamma-4-3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-murray-s-cube-law-cubic-radius-ratio-r1-3-r2-3-r0-3-at-gamma-4-3-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-physarum-polycephalum-specimen-enclosed-anastomosing-loop-count-betti-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Physarum polycephalum specimen enclosed anastomosing loop count (Betti-1) = 33 closed loops" ;
        dct:description "primary trunk fraction = 0.5196, secondary = 0.3644, tertiary = 0.1159" ;
        schema:measurementTechnique "Chromatic yellow vein segmentation + interior hole topology on physarum_polycephalum_specimen.jpg (vein area fraction = 0.1647)" ;
        schema:name "Physarum polycephalum specimen enclosed anastomosing loop count (Betti-1)" ;
        schema:unitText "closed loops" ;
        schema:value "33" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-physarum-polycephalum-specimen-enclosed-anastomosing-loop-count-betti-1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-physarum-polycephalum-specimen-enclosed-anastomosing-loop-count-betti-1-reference> a schema:PropertyValue ;
        schema:value "33" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-physarum-polycephalum-specimen-y-junction-murray-cubic-radius-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Physarum polycephalum specimen Y-junction Murray cubic radius ratio = 0.8926 (r_1^3 + r_2^3) / r_0^3" ;
        dct:description "mean = 0.8926 ± 0.2774 across N = 17 bifurcations (within 0.39 SD of theoretical 1.00)" ;
        schema:measurementTechnique "EDT medial-axis radius sampling across N = 17 degree-3 Y-junctions on physarum_polycephalum_specimen.jpg (SD = 0.2774)" ;
        schema:name "Physarum polycephalum specimen Y-junction Murray cubic radius ratio" ;
        schema:unitText "(r_1^3 + r_2^3) / r_0^3" ;
        schema:value "0.8926" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-physarum-polycephalum-specimen-y-junction-murray-cubic-radius-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-physarum-polycephalum-specimen-y-junction-murray-cubic-radius-ratio-reference> a schema:PropertyValue ;
        schema:value "0.8926" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-tokyo-rail-pareto-regime-gamma-1-8-fault-tolerance-ft> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Tokyo rail Pareto regime (gamma = 1.8) Fault Tolerance FT = 0.8089 disconnect-free fraction" ;
        dct:description "fault tolerance gain = +0.8089 over tree-like MST limit (FT = 0.00)" ;
        schema:measurementTechnique "Single-edge removal fault tolerance at gamma=1.8 vs MST baseline FT=0.00 (Betti-1 = 1 active loops)" ;
        schema:name "Tokyo rail Pareto regime (gamma = 1.8) Fault Tolerance FT" ;
        schema:unitText "disconnect-free fraction" ;
        schema:value "0.8089" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-tokyo-rail-pareto-regime-gamma-1-8-fault-tolerance-ft-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-tokyo-rail-pareto-regime-gamma-1-8-fault-tolerance-ft-reference> a schema:PropertyValue ;
        schema:value "0.84" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-tokyo-rail-pareto-regime-gamma-1-8-normalized-total-length-tl-mst> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Tokyo rail Pareto regime (gamma = 1.8) normalized Total Length TL_MST = 1.731 TL / TL_MST" ;
        dct:description "matches Tokyo rail (1.75) and biological Physarum (1.78 ± 0.14); MD_MST = 0.8678 vs ref 0.8500" ;
        schema:measurementTechnique "Multi-source Kanto network (N_f=36 food sources) at gamma=1.8 (MD_MST = 0.8678, FT = 0.8089)" ;
        schema:name "Tokyo rail Pareto regime (gamma = 1.8) normalized Total Length TL_MST" ;
        schema:unitText "TL / TL_MST" ;
        schema:value "1.731" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-tokyo-rail-pareto-regime-gamma-1-8-normalized-total-length-tl-mst-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-tokyo-rail-pareto-regime-gamma-1-8-normalized-total-length-tl-mst-reference> a schema:PropertyValue ;
        schema:value "1.75" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-two-path-sublinear-gamma-0-6-short-path-flux-share-q1-i0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Two-path sublinear (gamma = 0.6) short-path flux share Q1/I0 = 0.7322 flux fraction Q_1 / I_0" ;
        dct:description "parallel loop coexistence equilibrium; analytical D1*/D2* = 2^(0.6/0.4) = 2.8284, Q1/I0 = 0.7401" ;
        schema:measurementTechnique "Two-path parallel ODE at gamma=0.6 with L1=1.0, L2=2.0 (D1/D2 = 1.3670)" ;
        schema:name "Two-path sublinear (gamma = 0.6) short-path flux share Q1/I0" ;
        schema:unitText "flux fraction Q_1 / I_0" ;
        schema:value "0.7322" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-two-path-sublinear-gamma-0-6-short-path-flux-share-q1-i0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-two-path-sublinear-gamma-0-6-short-path-flux-share-q1-i0-reference> a schema:PropertyValue ;
        schema:value "0.7401" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-two-path-superlinear-gamma-1-8-winner-takes-all-shortest-path-flux-share-q1-i0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Two-path superlinear (gamma = 1.8) winner-takes-all shortest-path flux share Q1/I0 = 1.0 flux fraction Q_1 / I_0" ;
        dct:description "gamma=0 ablation negative control stays unpruned at Q1/I0 = 0.6667 (delta = +0.3333)" ;
        schema:measurementTechnique "Two-path parallel ODE at gamma=1.8 vs gamma=0.0 ablation control (ablation delta = +0.3333, Kirchhoff err = 3.57e-14)" ;
        schema:name "Two-path superlinear (gamma = 1.8) winner-takes-all shortest-path flux share Q1/I0" ;
        schema:unitText "flux fraction Q_1 / I_0" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-two-path-superlinear-gamma-1-8-winner-takes-all-shortest-path-flux-share-q1-i0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-two-path-superlinear-gamma-1-8-winner-takes-all-shortest-path-flux-share-q1-i0-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L806–L900" ;
        dct:description "9 reference-anchored morphometric measurements with Pearson r, p-values, RMSE, SD, and gamma=0 ablation control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2010-tero-physarum-transport-network.py#L806-L900> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 057 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tero-physarum-transport-network> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L302–L509" ;
        dcterms:description "Multi-source gamma sweep in [0.8, 2.4], two-path sweep in [0.4, 2.2], and 7-split Murray bifurcation sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2010-tero-physarum-transport-network.py#L302-L509> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L945–L961" ;
        dcterms:description "CLI parameter overrides for gamma, i0, mu, and seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2010-tero-physarum-transport-network.py#L945-L961> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Tero et al. (2010) Science & Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. adaptive Physarum tube conductivity network, shortest-path phase transition, Murray's cube law, and Tokyo rail Pareto trade-off — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Sweeps 8 gamma values across [0.8, 2.4] on the 36-source Kanto network (L302-392), 19 gamma values across [0.4, 2.2] plus gamma=0.0 ablation on the two-path circuit (L444-462), 7 daughter flux split fractions in [0.20, 0.80] at gamma = 4/3 (L469-509), and exposes `--gamma`, `--i0`, `--mu`, and `--seed` CLI flags (L945-961)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-parameter-expressivity-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tero-physarum-transport-network> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Tero et al. (2010) Science & Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. adaptive Physarum tube conductivity network, shortest-path phase transition, Murray's cube law, and Tokyo rail Pareto trade-off — Reproducibility package: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "8-suite `self_test()` (`L907-955`) verifying SHA-256 dataset integrity, Kirchhoff nodal conservation (< 1e-11) & flux antisymmetry (< 1e-14), two-path shortest-path transition, gamma=0 ablation control, multi-source TL_MST/FT Pareto sweep, Murray's cube law at gamma=4/3, specimen CV segmentation, and bitwise determinism." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-repro-package-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L907–L955" ;
        dct:description "8-suite deterministic self-test passing in < 2s" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2010-tero-physarum-transport-network.py#L907-L955> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 057 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


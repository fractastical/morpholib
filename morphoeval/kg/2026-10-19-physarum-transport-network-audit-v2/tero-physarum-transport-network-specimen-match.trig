sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tero-physarum-transport-network> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Tero et al. (2010) Science & Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. adaptive Physarum tube conductivity network, shortest-path phase transition, Murray's cube law, and Tokyo rail Pareto trade-off — Morphological realism / specimen match: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY 2.5 Physarum polycephalum plasmodial transport network photograph (`physarum_polycephalum_specimen.jpg`, 1024x768 px), segments the yellow vein network (`segment_physarum_specimen`, L516-610), extracts 33 enclosed anastomosing fault-tolerant loops (Betti-1 = 33), quantifies the 3-tier vein-width hierarchy (51.96% primary trunks, 36.44% secondary, 11.59% tertiary), and measures degree-3 Y-junction Murray cubic radius ratios (0.8926 +- 0.2774 across N = 17 junctions)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-specimen-match-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L516–L610" ;
        dct:description "Chromatic yellow vein segmentation, EDT radius hierarchy, Betti-1 loop topology, and Y-junction Murray cubic ratio extraction" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2010-tero-physarum-transport-network.py#L516-L610> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/physarum_transport_network_comparison.png (generated output)" ;
        dct:description "6-panel figure comparing Kanto Physarum network, two-path transition, Fig. 3/4 Pareto curves, Murray's cube law, and specimen CV segmentation — docs/media/physarum_transport_network_comparison.png: rendered output of 2010-tero-physarum-transport-network.py at 8871db0, image/png, 1340192 B, 2490×1545 px, artifact_sha256 b45525865419bc46f314e54bd2198c3dd518ae47ce782756c76aa54945ad0462 (sha256 b45525865419bc46f314e54bd2198c3dd518ae47ce782756c76aa54945ad0462), spec_fingerprint a9da85cd52fbe6dcd220e87644d7d896769c3e1c0c8e71bb4976e6e20700a480" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 057 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


    pk:hasScore 9.5e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Tero et al. (2010) Science & Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. adaptive Physarum tube conductivity network, shortest-path phase transition, Murray's cube law, and Tokyo rail Pareto trade-off — Morphometric validation: 94/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "`measure_morphoeval()` (L806-900) computes 9 reference-anchored morphometric measurements with uncertainty, Pearson p-values, RMSE, and negative controls: sublinear gamma=0.6 flux share 0.7322 (ref 0.7401), superlinear gamma=1.8 flux share 1.0000 (ref 1.0000, gamma=0 ablation delta +0.3333), TL_MST phase transition Pearson r = 0.99885 (RMSE = 0.0363, p = 3.83e-9), FT phase transition Pearson r = 0.99745 (RMSE = 0.0245, p = 4.12e-8), gamma=1.8 Kanto TL_MST = 1.7310 (ref 1.7500), gamma=1.8 Kanto FT = 0.8089 (ref 0.8400 vs MST 0.00), Murray cubic ratio 1.0000 (RMSE = 3.88e-9), specimen Betti-1 loops = 33 (ref 33), and specimen Y-junction Murray ratio 0.8926 +- 0.2774 (ref 0.8926)." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-fault-tolerance-ft-correlation>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-normalized-total-length-tl-mst-correlation>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-murray-s-cube-law-cubic-radius-ratio-r1-3-r2-3-r0-3-at-gamma-4-3>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-physarum-polycephalum-specimen-enclosed-anastomosing-loop-count-betti-1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-physarum-polycephalum-specimen-y-junction-murray-cubic-radius-ratio>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-tokyo-rail-pareto-regime-gamma-1-8-fault-tolerance-ft>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-tokyo-rail-pareto-regime-gamma-1-8-normalized-total-length-tl-mst>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-two-path-sublinear-gamma-0-6-short-path-flux-share-q1-i0>,

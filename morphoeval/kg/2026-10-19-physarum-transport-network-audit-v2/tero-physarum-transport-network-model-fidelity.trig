}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tero-physarum-transport-network> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Tero et al. (2010) Science & Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. adaptive Physarum tube conductivity network, shortest-path phase transition, Murray's cube law, and Tokyo rail Pareto trade-off — Model fidelity to source: 95/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements the full graph Laplacian Kirchhoff pressure solver (`solve_kirchhoff_potentials`, L192-238), multi-source Kanto adaptive conductivity ODE (`simulate_multi_source_physarum_network`, L241-299), 8-point Tero et al. (2010) Fig. 3/4 phase transition sweep (`evaluate_tero_phase_transition_sweep`, L302-392), two-path parallel competition with gamma=0 ablation control (`simulate_two_path_competition`, L399-462), and Murray's cube law verification at gamma = 4/3 (`verify_murray_cube_law_junction`, L469-509), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_057_physarum_transport_network.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-model-fidelity-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L192–L392" ;
        dct:description "Kirchhoff Laplacian solver across N_f=36 Kanto food sources and Tero et al. (2010) Fig. 3/4 TL_MST/MD_MST/FT sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2010-tero-physarum-transport-network.py#L192-L392> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L399–L509" ;
        dct:description "Two-path shortest-path phase transition, gamma=0 ablation control, and Murray's cube law at gamma=4/3" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2010-tero-physarum-transport-network.py#L399-L509> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_057_physarum_transport_network.lean L46–L154" ;
        dct:description "3 machine-checked Lean 4 theorems for Kirchhoff equilibrium, two-path winner-takes-all selection, and Murray's cube law (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_057_physarum_transport_network.lean#L46-L154> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 057 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


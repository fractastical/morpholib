    <https://doi.org/10.1016/j.jtbi.2006.07.015> dct:date "2007"^^xsd:gYear ;
        dct:title "A mathematical model for adaptive transport network in path finding by true slime mold" .
    <https://doi.org/10.1016/j.jtbi.2012.06.017> dct:date "2012"^^xsd:gYear ;
        dct:title "Physarum Can Compute Shortest Paths" .
    <https://doi.org/10.1038/35035159> dct:date "2000"^^xsd:gYear ;

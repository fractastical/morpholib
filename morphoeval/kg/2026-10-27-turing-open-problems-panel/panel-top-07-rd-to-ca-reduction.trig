sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/turing-open-problem-top-07-rd-to-ca-reduction> a pk:Claim ;
        rdfs:label "TOP-07 — When does continuous reaction-diffusion collapse to a discrete automaton? Meinhardt mantle PDE vs the Lean-proved Rule 30 gate" ;
        dct:description "OPEN PROBLEM in Turing-pattern biology, sourced forward from Meinhardt 1995 -> Boettiger-Ermentrout-Oster 2009 -> Manukyan 2017. THE GAP: Ocellated lizard scales behave as a cellular automaton emerging from RD on a thick-skin lattice (Manukyan 2017), and the repo has Lean-proved that the Ermentrout-Oster neural mantle gate is bit-for-bit Rule 30 — but whether the repo's Meinhardt-Klingler Conus PDE, discretised at the mantle, induces a Rule 30-class local rule has never been measured. It is the bridge between the Rule 30 programme and the RD programme, and the RD-vs-neural shell-pattern debate is still molecularly unresolved. DEFINITION OF DONE: From a Meinhardt PDE kymograph at the mantle edge, extract the empirical 3-neighbourhood -> next-state transducer table (binary threshold pre-registered), report the fraction of transitions agreeing with Rule 30 vs Rule 90 vs best-fit rule, plus the 2D ANF-carry density and wall chirality already used to separate R30 from R90 (node r0); verdict thresholds locked before running. THREE-PROVIDER DELPHI PANEL (2026-10-27; supersedes the provisional single-assessor pass): resolvability panel mean 89.7/100 (range 86-96; RESOLVE NOW) by the deterministic Problem-Scout rubric, and pooled viability posterior 77.33% (prior 50%, pooled net +5.33 dB, panel range 71.53-79.92%) that the named route reaches a decisive verdict. Assessors were blinded to the provisional scores and to each other. A belief under assessment, not a fact." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/TURING_OPEN_PROBLEMS.md> ;
        pk:context "tool_route: models/1984-wolfram-conus-textile-rule30.py (Meinhardt-Klingler PDE + Rule 30 + kymograph); morphoeval/lean/ Ermentrout-Oster gate theorem; measure_outputs.py for ANF carry / chirality; registry row. | deciding_data: All in repo (PDE, CA, Lean gate, 2D observables). | prior_attempts: scout-003 (Rule30 <-> Ermentrout-Oster gate chain traceability); scout-034/038/039 (stochastic activator injection debt, OP-06b). None extracted the transducer table." ;
        pk:derivedFromPaper <https://doi.org/10.1038/nature22031>,
            <https://doi.org/10.1073/pnas.0810311106>,
            <https://doi.org/10.1098/rstb.1952.0012> ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-resolvability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-resolvability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-resolvability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-viability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-viability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-viability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-viability-panel-pooled> ;
        pk:weightOfEvidence "0.7733"^^xsd:double .

    <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27> a prov:SoftwareAgent ;
        rdfs:label "Three-provider Bayesian Delphi panel (OpenAI, Google, Anthropic), blinded, pooled in log-odds" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-resolvability-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-07 resolvability 86/100 — Claude Fable 5.1 Thinking High (fresh context)" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 15/15: Minutes of numpy.",
            "data_in_hand 19/20: Everything is in repo (PDE, CA, Lean gate in morphoeval/lean/MathOfBiology.lean, 2D observables).",
            "falsifiable_done 11/15: Agreement fractions above a locked threshold are crisp, but the coarse-graining (PDE steps per CA tick, cell width, threshold) is not fixed by the done and drives the result.",
            "isolation 8/10: New script importing from a 12.8k-line module; must avoid its top-level side effects but no shared file edits are required.",
            "not_blocked 4/5: No transducer table extracted before; the script already reports chirality_meinhardt = 0.0000 vs Rule 30 -0.4973, a partial prior negative on the 2D clause but not a refutation of the route.",
            "time_to_verdict 9/10: One short sitting.",
            "tool_fit 20/25: models/1984-wolfram-conus-textile-rule30.py has run_meinhardt_conus (PDE kymograph), Rule 30/Rule 90 steps, the Ermentrout-Oster gate and compute_2d_chiral_and_anf_observables; only the 3-neighbourhood transducer-table extraction is new." ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "RESOLVE NOW" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-resolvability-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-07 resolvability 96/100 — Gemini 4 Argon Medium" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 15/15: 1D mantle-edge PDE integration and kymograph coarse-graining run in a few seconds on CPU.",
            "data_in_hand 20/20: All PDE solvers, CA comparators, Lean theorems, and Conus reference fixtures are already present in the repository.",
            "falsifiable_done 15/15: Extracting the 8-state 3-neighborhood empirical transducer table and scoring transition agreement plus 2D ANF-carry and wall chirality against locked thresholds is completely objective.",
            "isolation 10/10: Closable as a new transducer extraction script and prediction registry entry without editing existing files.",
            "not_blocked 4/5: No prior attempt extracted the empirical transducer table, though scout-034/038/039 noted the PDE uses stochastic activator injection to prevent extinction.",
            "time_to_verdict 9/10: Can be executed and verified in a single short session using existing functions.",
            "tool_fit 23/25: models/1984-wolfram-conus-textile-rule30.py already contains the Meinhardt-Klingler PDE kymograph generator, Rule 30/90 comparators, and morphoeval/lean/ has the Ermentrout-Oster gate proof." ;
        pk:hasScore "0.96"^^xsd:double ;
        pk:hasVerdict "RESOLVE NOW" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-resolvability-gpt-5.6-sol> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-07 resolvability 87/100 — GPT 5.6 Sol Medium" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 14/15: The existing simulations and local-rule census are tractable on the current stack.",
            "data_in_hand 20/20: The PDE, CA controls, kymographs, and observables are all locally represented.",
            "falsifiable_done 13/15: Agreement fractions and locked thresholds are objective, though thresholding and sampling conventions need specification.",
            "isolation 10/10: An extractor and result artifacts can be added as new files.",
            "not_blocked 4/5: No transducer census was attempted, although existing chirality output already suggests a mechanistic mismatch.",
            "time_to_verdict 8/10: The core simulations already exist, leaving a bounded analysis task.",
            "tool_fit 18/25: The named script runs Meinhardt and Rule 30 kymographs and already computes chirality, but transducer extraction and ANF comparison are new." ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "RESOLVE NOW" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-viability-claude-fable-5-1> a pk:BayesianAssessment ;
        rdfs:label "TOP-07 viability 79.92% — Claude Fable 5.1 Thinking High (fresh context)" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:bayesFactor "3.9811"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-07-rd-to-ca-reduction-decisive-verdict> ;
        pk:evidenceAgainst "[-1 dB] The Meinhardt PDE is left-right symmetric so it cannot induce the chiral Rule 30; the test is nearly foregone, inviting a 'trivially negative' objection.",
            "[-3 dB] The 1D agreement fraction is sensitive to sampling interval and threshold; without locking the coarse-graining a scorer can argue any rule could be fit or missed." ;
        pk:evidenceFor "[+2 dB] The empirical 8-row transducer table is a few dozen lines of code over an existing kymograph.",
            "[+3 dB] The 2D chirality observable is already computed (Meinhardt 0.0000 vs R30 -0.4973), so half of the hypothesis is effectively already decided negative.",
            "[+5 dB] All inputs and observables are in repo and deterministic; the test can run end to end today." ;
        pk:hasConfidence "0.75"^^xsd:double ;
        pk:hasProbability "0.7992"^^xsd:double ;
        pk:hasVerdict "DECISIVE_LIKELY_NEGATIVE_IN_REPO" ;
        pk:weightOfEvidenceDeciban "6.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-viability-gemini-4-argon> a pk:BayesianAssessment ;
        rdfs:label "TOP-07 viability 79.92% — Gemini 4 Argon Medium" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:bayesFactor "3.9811"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-07-rd-to-ca-reduction-decisive-verdict> ;
        pk:evidenceAgainst "[-2 dB] Because the Meinhardt-Klingler PDE is spatially reflection-symmetric (unlike Rule 30's asymmetric left-XOR gate) and relies on stochastic activator injection (p=0.18), the extracted transducer will likely align closer to symmetric Rule 90/18/22 than chiral Rule 30, refuting the directional hypothesis." ;
        pk:evidenceFor "[+3.5 dB] Coarse-graining the space-time kymograph into a 2^3 -> {0,1} empirical transition table is guaranteed to yield a decisive quantitative comparison against both Rule 30 and symmetric Rule 90.",
            "[+4.5 dB] Every required component (Meinhardt-Klingler PDE, Rule 30/Rule 90 truth tables, ANF carry density, and wall chirality metrics) is already implemented and verified in models/1984-wolfram-conus-textile-rule30.py and morphoeval/measure_outputs.py." ;
        pk:hasConfidence "0.91"^^xsd:double ;
        pk:hasProbability "0.7992"^^xsd:double ;
        pk:hasVerdict "HIGHLY_TRACTABLE_EXPECTED_NEGATIVE" ;
        pk:weightOfEvidenceDeciban "6.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-viability-gpt-5.6-sol> a pk:BayesianAssessment ;
        rdfs:label "TOP-07 viability 71.53% — GPT 5.6 Sol Medium" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;
        pk:bayesFactor "2.5119"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-07-rd-to-ca-reduction-decisive-verdict> ;
        pk:evidenceAgainst "[-2 dB] Binary thresholding a continuous PDE can change the inferred local rule and requires a genuinely preregistered convention.",
            "[-2 dB] The existing implementation reports essentially symmetric Meinhardt chirality, unlike strongly chiral Rule 30, so the stated positive hypothesis is unlikely even though the test is decisive." ;
        pk:evidenceFor "[+1.5 dB] Existing code already computes Rule 30, Rule 90, Meinhardt, and specimen chirality controls.",
            "[+2.5 dB] A three-bit neighborhood census is finite, transparent, and will decisively accept or reject Rule 30 agreement.",
            "[+4 dB] Both source dynamics and multiple comparison observables are implemented in one mature script." ;
        pk:hasConfidence "0.91"^^xsd:double ;
        pk:hasProbability "0.7153"^^xsd:double ;
        pk:hasVerdict "HIGHLY_DECISIVE" ;
        pk:weightOfEvidenceDeciban "4.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-viability-panel-pooled> a pk:BayesianAssessment ;
        rdfs:label "TOP-07 pooled viability 77.33% (3-provider panel, range 71.53-79.92%)" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27> ;
        pk:bayesFactor "3.4119"^^xsd:double ;
        pk:calibrationMethod "log-odds mean across 3 assessors (equal priors 50%, so pooled net dB = mean net dB)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-07-rd-to-ca-reduction-decisive-verdict> ;
        pk:hasProbability "0.7733"^^xsd:double ;
        pk:hasVerdict "POOLED_POSSIBLE_PATHWAY" ;
        pk:weightOfEvidenceDeciban "5.33"^^xsd:double .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 Thinking High (fresh context) (Anthropic)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .

    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon Medium (Google)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .

    <https://w3id.org/delphi/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT 5.6 Sol Medium (OpenAI)" ;
        dct:identifier "gpt-5.6-sol" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .

    <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-07-rd-to-ca-reduction-decisive-verdict> a pk:TestableHypothesis ;
        rdfs:label "The extracted transducer table from the Meinhardt mantle PDE agrees with Rule 30 above the locked threshold on both 1D transitions and 2D ANF/chirality observables." ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-viability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-viability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-viability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-07-rd-to-ca-reduction-viability-panel-pooled> ;
        pk:hasPriorProbability "0.5"^^xsd:double ;
        pk:hasResolvability "0.897"^^xsd:double .
}


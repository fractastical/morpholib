sub1:assertion {
    <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27> a prov:SoftwareAgent ;
        rdfs:label "Three-provider Bayesian Delphi panel (OpenAI, Google, Anthropic), blinded, pooled in log-odds" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-resolvability-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-04 resolvability 49/100 — Claude Fable 5.1 Thinking High (fresh context)" ;
        dcterms:date "2026-10-27"^^xsd:date ;
        dcterms:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 12/15: Counting and the L/lambda_c prediction are trivial compute; the cost is acquisition, not infrastructure.",
            "data_in_hand 4/20: Not in repo (one Commons juvenile photo without length metadata); no named public series other than Kondo-Asai 1995 Fig. 1 is identified.",
            "falsifiable_done 11/15: All stages within +-1 stripe is crisp; stripe counting on curvilinear juveniles has recorded over-count taste (scout-032).",
            "isolation 8/10: New datasets/ folder with SHA-pinned images plus a registry row.",
            "not_blocked 2/5: scout-031 already searched for a Kondo ontogenetic series and found only one adult photo; scout-032 flagged counter over-count.",
            "time_to_verdict 4/10: Finding >=6 stages with body length is an open-ended hunt; not reliably one sitting.",
            "tool_fit 8/25: scout_literature.py --taxon is a 5-hit Wikimedia Commons search; ridge/Y-junction counting exists (morphoeval/verify_image_fitness.py, 1995-kondo script), but no tool finds a sized ontogenetic series." ;
        pk:hasScore "0.49"^^xsd:double ;
        pk:hasVerdict "RESOLVABLE WITH WORK" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-resolvability-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-04 resolvability 68/100 — Gemini 4 Argon Medium" ;
        dcterms:date "2026-10-27"^^xsd:date ;
        dcterms:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 14/15: Once images and lengths are in hand, 1D/2D ridge segmentation and stripe counting take seconds.",
            "data_in_hand 5/20: The repo holds only a single adult Pomacanthus imperator photograph, and Wikimedia Commons / iNaturalist rarely provide >=6 calibrated body-length stages for Pomacanthus outside Kondo & Asai (1995).",
            "falsifiable_done 14/15: Testing N_stripes(L) = round(L/lambda_c) within +-1 stripe across >=6 SHA-256-pinned stages with body-length metadata is crisp and taste-free.",
            "isolation 10/10: Can be packaged in a new dataset subfolder and test script without touching existing tracked files.",
            "not_blocked 2/5: Prior attempts scout-031, scout-032, and scout-034/038 already hit the missing-ontogenetic-series wall and noted Y-junction over-counting on curved juvenile stripes.",
            "time_to_verdict 5/10: Hunting for >=6 open-access developmental stage photos with verified standard-length (SL/TL) metadata in mm/cm is likely to stall at the data-sourcing gate.",
            "tool_fit 18/25: models/1952-turing-morpho.py already implements Pomacanthus stripe ridge segmentation, wavelength estimation, and Y-junction skeleton counting." ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "RESOLVABLE WITH WORK" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-resolvability-gpt-5.6-sol> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-04 resolvability 56/100 — GPT 5.6 Sol Medium" ;
        dcterms:date "2026-10-27"^^xsd:date ;
        dcterms:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 14/15: Once images exist, hashing, counting, and scoring are lightweight.",
            "data_in_hand 5/20: The required independent six-stage series with body-length metadata is explicitly absent.",
            "falsifiable_done 14/15: A pinned six-stage series and plus-or-minus-one stripe criterion are objective.",
            "isolation 10/10: The series manifest and scorer can be added as isolated new files.",
            "not_blocked 2/5: Several prior scouts recorded the same missing series and an over-counting detector.",
            "time_to_verdict 3/10: Data discovery and ontogenetic size validation are unlikely in one sitting.",
            "tool_fit 8/25: Search and image-fitness tools exist, but no verified end-to-end stripe-count and metadata pipeline is present." ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "RESOLVABLE WITH WORK" .

    <https://w3id.org/delphi/resource/claim/turing-open-problem-top-04-stripe-insertion-blind> a pk:Claim ;
        rdfs:label "TOP-04 — Growing domains: an independent ontogenetic stripe-count series to test the insertion law blind" ;
        dcterms:description "OPEN PROBLEM in Turing-pattern biology, sourced forward from Kondo-Asai 1995 -> Crampin-Gaffney-Maini 1999 -> Krause 2021. THE GAP: Classical Turing conditions are neither necessary nor sufficient on growing domains and wavelength selection under growth has no closed theory (Krause et al. 2021). Empirically, Kondo-Asai's Pomacanthus series remains nearly the only ontogenetic stripe-count dataset, and the repo's Kondo stripe table is calibrated on it (circularity recorded in scout-034/038; OP-06 growing-domain solver debt still open). DEFINITION OF DONE: A hash-locked prediction N_stripes(L) = round(L/lambda_c) with lambda_c fixed from one stage, scored on an independently sourced Pomacanthus (or other stripe-inserting fish) ontogenetic series of >=6 stages with body length metadata, each image SHA-256 pinned before counting; result reported either way. THREE-PROVIDER DELPHI PANEL (2026-10-27; supersedes the provisional single-assessor pass): resolvability panel mean 57.7/100 (range 49-68; RESOLVABLE WITH WORK) by the deterministic Problem-Scout rubric, and pooled viability posterior 22.67% (prior 50%, pooled net -5.33 dB, panel range 16.63-28.47%) that the named route reaches a decisive verdict. Assessors were blinded to the provisional scores and to each other. A belief under assessment, not a fact." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/main/docs/TURING_OPEN_PROBLEMS.md> ;
        pk:context "tool_route: python3 morphoeval/scout_literature.py --taxon 'Pomacanthus semicirculatus' (Commons + OpenAlex); verify_image_fitness.py / the Y-junction skeleton detector for counting; predictions/ registry for the lock. | deciding_data: Not in repo. Needs public juvenile photographs with size metadata or a published series other than Kondo-Asai 1995 Fig. 1. | prior_attempts: scout-031 (Kondo ontogenetic series beyond one adult photo), scout-034/038 (circular calibration), scout-032 (Y-junction over-count) — all record the gap, none closed it." ;
        pk:derivedFromPaper <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1098/rsta.2020.0280> ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-resolvability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-resolvability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-resolvability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-viability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-viability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-viability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-viability-panel-pooled> ;
        pk:weightOfEvidence "0.2267"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-viability-claude-fable-5-1> a pk:BayesianAssessment ;
        rdfs:label "TOP-04 viability 16.63% — Claude Fable 5.1 Thinking High (fresh context)" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:bayesFactor "0.1995"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-04-stripe-insertion-blind-decisive-verdict> ;
        pk:evidenceAgainst "[-1 dB] Conjunctive hypothesis: both acquisition and scoring must succeed.",
            "[-2 dB] Stripe counting on C-shaped curvilinear juveniles is taste-laden (scout-032 over-count), weakening the +-1 gate.",
            "[-3 dB] scout-031 already attempted the series search and recorded failure beyond a single photo.",
            "[-4 dB] Public juvenile angelfish photographs almost never carry body-length metadata; the >=6-stage requirement with size is the binding constraint." ;
        pk:evidenceFor "[+1 dB] Aquarium-trade and FishBase juvenile records sometimes attach body length in cm, giving a plausible, if thin, source.",
            "[+2 dB] If a sized series exists, the locked N = round(L/lambda_c) test is immediately decisive." ;
        pk:hasConfidence "0.65"^^xsd:double ;
        pk:hasProbability "0.1663"^^xsd:double ;
        pk:hasVerdict "DATA_ACQUISITION_BLOCKS_VERDICT" ;
        pk:weightOfEvidenceDeciban "-7.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-viability-gemini-4-argon> a pk:BayesianAssessment ;
        rdfs:label "TOP-04 viability 24.03% — Gemini 4 Argon Medium" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:bayesFactor "0.3162"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-04-stripe-insertion-blind-decisive-verdict> ;
        pk:evidenceAgainst "[-2.5 dB] Juvenile Pomacanthus semicirculatus and P. imperator display concentric curved C-stripes before adult parallelization, causing 1D AP ridge projections and Y-junction skeleton detectors (scout-032) to miscount.",
            "[-4.5 dB] Prior scout rounds (scout-031) already failed to locate an open-access >=6-stage Pomacanthus ontogenetic series with calibrated body lengths independent of Kondo & Asai (1995)." ;
        pk:evidenceFor "[+2 dB] Image segmentation and stripe-ridge wavelength extraction are already implemented and tested in models/1952-turing-morpho.py." ;
        pk:hasConfidence "0.82"^^xsd:double ;
        pk:hasProbability "0.2403"^^xsd:double ;
        pk:hasVerdict "DATA_STARVED_HIGH_RISK" ;
        pk:weightOfEvidenceDeciban "-5.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-viability-gpt-5.6-sol> a pk:BayesianAssessment ;
        rdfs:label "TOP-04 viability 28.47% — GPT 5.6 Sol Medium" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;
        pk:bayesFactor "0.3981"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-04-stripe-insertion-blind-decisive-verdict> ;
        pk:evidenceAgainst "[-0.5 dB] The available Y-junction counting approach has a recorded over-count problem.",
            "[-2.5 dB] Repeated prior scouting documented this same acquisition gap without closing it.",
            "[-4 dB] The decisive independent image series with stage-specific body lengths is not in the repository and may not exist publicly." ;
        pk:evidenceFor "[+1 dB] The repository has literature, image-fitness, and prediction-registration infrastructure.",
            "[+2 dB] If a suitable series is found, the hash lock and stripe-error criterion yield a clean score." ;
        pk:hasConfidence "0.88"^^xsd:double ;
        pk:hasProbability "0.2847"^^xsd:double ;
        pk:hasVerdict "UNLIKELY_DECISIVE" ;
        pk:weightOfEvidenceDeciban "-4.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-viability-panel-pooled> a pk:BayesianAssessment ;
        rdfs:label "TOP-04 pooled viability 22.67% (3-provider panel, range 16.63-28.47%)" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27> ;
        pk:bayesFactor "0.2931"^^xsd:double ;
        pk:calibrationMethod "log-odds mean across 3 assessors (equal priors 50%, so pooled net dB = mean net dB)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-04-stripe-insertion-blind-decisive-verdict> ;
        pk:hasProbability "0.2267"^^xsd:double ;
        pk:hasVerdict "POOLED_POSSIBLE_PATHWAY" ;
        pk:weightOfEvidenceDeciban "-5.33"^^xsd:double .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 Thinking High (fresh context) (Anthropic)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .

    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon Medium (Google)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .

    <https://w3id.org/delphi/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT 5.6 Sol Medium (OpenAI)" ;
        dcterms:identifier "gpt-5.6-sol" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .

    <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-04-stripe-insertion-blind-decisive-verdict> a pk:TestableHypothesis ;
        rdfs:label "An independent >=6-stage series with size metadata is found and the locked insertion-law prediction is scored decisively (all stages within +-1 stripe, or not)." ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-viability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-viability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-viability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-04-stripe-insertion-blind-viability-panel-pooled> ;
        pk:hasPriorProbability "0.5"^^xsd:double ;
        pk:hasResolvability "0.577"^^xsd:double .
}


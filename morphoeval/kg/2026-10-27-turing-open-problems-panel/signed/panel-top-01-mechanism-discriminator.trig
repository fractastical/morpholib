sub1:assertion {
    <https://w3id.org/delphi/resource/claim/turing-open-problem-top-01-mechanism-discriminator> a pk:Claim ;
        rdfs:label "TOP-01 — Mechanism identification: a pre-registered statistic that separates reaction-diffusion from colonisation, phase separation and buckling on static patterns" ;
        dcterms:description "OPEN PROBLEM in Turing-pattern biology, sourced forward from Turing 1952 -> Murray 1981 -> OP-11 (2026). THE GAP: Pattern phenomenology does not identify mechanism: zebrafish stripes are cell-contact mediated (Nakamasu 2009), feather buds mechanical first (Shyer 2017), Holstein spotting indistinguishable between growing RD and Eden colonisation at p=0.91 (OP-11). No registered discriminator exists that, given only an adult pattern, says which class of generator made it with a stated error rate. DEFINITION OF DONE: A hash-locked discriminator (candidate features: radial power-spectrum shape, Minkowski functionals, defect/junction statistics, two-point anisotropy) trained and scored on synthetic ground truth from four generators (Gray-Scott/Schnakenberg RD, Eden colonisation, Cahn-Hilliard phase separation, elastic buckling) with a pre-registered held-out accuracy threshold and published confusion matrix; then applied blind to the 10 coat-masked Holstein specimens, reported either way. THREE-PROVIDER DELPHI PANEL (2026-10-27; supersedes the provisional single-assessor pass): resolvability panel mean 76/100 (range 70-84; RESOLVE NOW) by the deterministic Problem-Scout rubric, and pooled viability posterior 59.5% (prior 50%, pooled net +1.67 dB, panel range 55.73-61.31%) that the named route reaches a decisive verdict. Assessors were blinded to the provisional scores and to each other. A belief under assessment, not a fact." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/main/docs/TURING_OPEN_PROBLEMS.md> ;
        pk:context "tool_route: models/1981-murray-bos-taurus-turing-wavelength.py (RD + Eden generators, coat masks, paired harness); models/1952-turing-morpho.py (Pearson classes); morphoeval/measure_outputs.py; predictions/ registry for the hash lock. Cahn-Hilliard and buckling generators must be written fresh (the catalog *_morphogen_condensation / *_elastic_buckling scripts are alpha-template scaffolds, scout-048). | deciding_data: In repo: 10 Holstein masks, RD/Eden outputs. Synthetic ground truth generated in-run. No wet data needed. | prior_attempts: OP-11 (static Turing rejected; growing RD vs Eden p=0.91) is the direct precursor; scout-040 OP-11 Delphi rescore pending." ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1038/ncomms10288>,
            <https://doi.org/10.1038/s41576-025-00925-z>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.aai7868> ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-resolvability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-resolvability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-resolvability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-viability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-viability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-viability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-viability-panel-pooled> ;
        pk:weightOfEvidence "0.595"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-resolvability-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-01 resolvability 74/100 — Claude Fable 5.1 Thinking High (fresh context)" ;
        dcterms:date "2026-10-27"^^xsd:date ;
        dcterms:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 12/15: Four 2D generators x ~100 seeds, Minkowski/PSD features and a numpy LDA/kNN run in hours on the numpy/scipy stack; no wet lab.",
            "data_in_hand 18/20: 10 SHA-pinned Holstein specimens in datasets/bos_taurus_turing_wavelength (1 + 9 extra_specimens); synthetic ground truth is generated in-run.",
            "falsifiable_done 12/15: Locked held-out accuracy + confusion matrix is taste-free; 'definite class for the Holstein set' needs a pre-registered posterior/margin criterion or it becomes arguable.",
            "isolation 7/10: New script + new result files; the predictions/ registry row touches a shared CSV/JSON that parallel agents also append to.",
            "not_blocked 3/5: OP-11 found RD-vs-Eden indistinguishable on these masks (p=0.91); not the same multi-feature route, but a recorded negative on the Holstein leg.",
            "time_to_verdict 7/10: One long sitting: generator adaptation, feature pipeline, training, blind application.",
            "tool_fit 15/25: models/1981-murray-bos-taurus-turing-wavelength.py has RD + Eden generators, coat masks and a paired harness as-is; Cahn-Hilliard (adaptable from 2002-sumper diatom phase-sep) and buckling (1975-richman) need adapting; the discriminator/classifier itself is new code." ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "RESOLVE NOW" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-resolvability-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-01 resolvability 84/100 — Gemini 4 Argon Medium" ;
        dcterms:date "2026-10-27"^^xsd:date ;
        dcterms:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 14/15: 2D PDE sweeps for RD, Eden, Cahn-Hilliard, and Swift-Hohenberg/Foppl-von Karman buckling on ~160x120 grids run in minutes on NumPy/SciPy.",
            "data_in_hand 20/20: The 10 Holstein coat masks and reference fixtures are already pinned in datasets/bos_taurus_turing_wavelength/ and synthetic ground truth is generated in-run.",
            "falsifiable_done 14/15: Pre-registered held-out accuracy threshold on four-class synthetic data and blind application to 10 Holstein masks is strictly checkable once feature set and hyperparameters are hash-locked.",
            "isolation 10/10: Can be implemented entirely as a new benchmark script, prediction registry entry, and output artifact without touching existing tracked files.",
            "not_blocked 3/5: OP-11 already showed growing RD and Eden colonisation are indistinguishable on basic patch statistics (p=0.91), narrowing the feature space that could separate them.",
            "time_to_verdict 7/10: Building and validating two new physical generators plus multi-feature extraction and cross-validation takes a focused multi-hour loop.",
            "tool_fit 16/25: models/1981-murray-bos-taurus-turing-wavelength.py and models/1952-turing-morpho.py provide RD and Eden generators plus Holstein mask handling, but Cahn-Hilliard and elastic buckling solvers must be written fresh." ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "RESOLVE NOW" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-resolvability-gpt-5.6-sol> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-01 resolvability 70/100 — GPT 5.6 Sol Medium" ;
        dcterms:date "2026-10-27"^^xsd:date ;
        dcterms:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 12/15: All four synthetic generators are feasible on the scientific Python stack, but two require substantive implementation.",
            "data_in_hand 16/20: Ten pinned specimen references and ROIs exist, although the image files themselves are absent from the checked dataset directory.",
            "falsifiable_done 14/15: A locked accuracy threshold and confusion matrix make the synthetic test objective.",
            "isolation 9/10: The discriminator and missing generators can be added as new files with only registry additions.",
            "not_blocked 3/5: The exact multi-feature route is untried, but the direct RD-versus-Eden precursor was non-discriminating.",
            "time_to_verdict 6/10: Generator implementation, calibration, and held-out scoring are unlikely to fit one short loop.",
            "tool_fit 10/25: The RD/Eden paired harness exists, but two generators and the four-way discriminator must be written." ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "RESOLVE NOW" .

    <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27> a prov:SoftwareAgent ;
        rdfs:label "Three-provider Bayesian Delphi panel (OpenAI, Google, Anthropic), blinded, pooled in log-odds" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-viability-claude-fable-5-1> a pk:BayesianAssessment ;
        rdfs:label "TOP-01 viability 61.31% — Claude Fable 5.1 Thinking High (fresh context)" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:bayesFactor "1.5849"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-01-mechanism-discriminator-decisive-verdict> ;
        pk:evidenceAgainst "[-2 dB] 'Returns a definite class' is a second, taste-prone clause; unless a margin is locked, an ambiguous posterior yields a contested rather than decisive outcome.",
            "[-2 dB] Synthetic-to-photograph domain shift (mask resolution, body curvature, Otsu/colour segmentation artefacts) can dominate the features; a scorer may dispute whether the Holstein class reflects mechanism.",
            "[-3 dB] OP-11 p=0.91 on the same masks suggests RD vs Eden is near-indistinguishable at photo resolution, so the Holstein leg may land in an indeterminate region." ;
        pk:evidenceFor "[+2 dB] Candidate features (radial PSD shape, Minkowski functionals, junction statistics) are standard and implementable in numpy/scipy in-repo.",
            "[+3 dB] Three of four generators (RD, Eden, phase separation, buckling) already exist in some form in models/; only adaptation, not invention, is needed.",
            "[+4 dB] Synthetic ground truth is generated in-run, so the registered held-out accuracy is measurable with no external dependency." ;
        pk:hasConfidence "0.6"^^xsd:double ;
        pk:hasProbability "0.6131"^^xsd:double ;
        pk:hasVerdict "SYNTHETIC_LEG_DECISIVE_HOLSTEIN_FRAGILE" ;
        pk:weightOfEvidenceDeciban "2.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-viability-gemini-4-argon> a pk:BayesianAssessment ;
        rdfs:label "TOP-01 viability 55.73% — Gemini 4 Argon Medium" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:bayesFactor "1.2589"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-01-mechanism-discriminator-decisive-verdict> ;
        pk:evidenceAgainst "[-1.5 dB] Small sample size per specimen (a handful of body-scale patches per cow flank) produces high variance in Minkowski functionals and defect counts on the empirical test set.",
            "[-3 dB] OP-11 demonstrated that growing-domain RD and stochastic Eden colonisation converge on adult patch morphology (Wilcoxon p=0.91), making 4-way synthetic accuracy hard to maintain when thresholded to binary coat masks." ;
        pk:evidenceFor "[+2 dB] All 10 Holstein ROI masks and the paired evaluation harness in models/1981-murray-bos-taurus-turing-wavelength.py are already in-repo and SHA-256 verified.",
            "[+3.5 dB] Cahn-Hilliard coarsening (power-law structure factor k^4 tail), elastic buckling (narrow spectral ring with rigid defect lattice), and RD/Eden have distinct spectral and Minkowski signatures on synthetic domains." ;
        pk:hasConfidence "0.78"^^xsd:double ;
        pk:hasProbability "0.5573"^^xsd:double ;
        pk:hasVerdict "SYNTHETIC_SEPARABLE_EMPIRICAL_AMBIGUOUS" ;
        pk:weightOfEvidenceDeciban "1.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-viability-gpt-5.6-sol> a pk:BayesianAssessment ;
        rdfs:label "TOP-01 viability 61.31% — GPT 5.6 Sol Medium" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;
        pk:bayesFactor "1.5849"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-01-mechanism-discriminator-decisive-verdict> ;
        pk:evidenceAgainst "[-1 dB] High synthetic accuracy does not ensure that heterogeneous real photographs receive a stable definite class.",
            "[-2 dB] Cahn-Hilliard, buckling, and the actual discriminator are new implementations whose artifacts could dominate accuracy." ;
        pk:evidenceFor "[+2 dB] Synthetic ground-truth labels permit an unambiguous held-out classification score.",
            "[+3 dB] The repository contains mature RD and Eden generators, specimen metadata, ROIs, and paired comparison code." ;
        pk:hasConfidence "0.72"^^xsd:double ;
        pk:hasProbability "0.6131"^^xsd:double ;
        pk:hasVerdict "LIKELY_DECISIVE" ;
        pk:weightOfEvidenceDeciban "2.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-viability-panel-pooled> a pk:BayesianAssessment ;
        rdfs:label "TOP-01 pooled viability 59.5% (3-provider panel, range 55.73-61.31%)" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27> ;
        pk:bayesFactor "1.4689"^^xsd:double ;
        pk:calibrationMethod "log-odds mean across 3 assessors (equal priors 50%, so pooled net dB = mean net dB)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-01-mechanism-discriminator-decisive-verdict> ;
        pk:hasProbability "0.595"^^xsd:double ;
        pk:hasVerdict "POOLED_POSSIBLE_PATHWAY" ;
        pk:weightOfEvidenceDeciban "1.67"^^xsd:double .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 Thinking High (fresh context) (Anthropic)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .

    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon Medium (Google)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .

    <https://w3id.org/delphi/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT 5.6 Sol Medium (OpenAI)" ;
        dcterms:identifier "gpt-5.6-sol" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .

    <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-01-mechanism-discriminator-decisive-verdict> a pk:TestableHypothesis ;
        rdfs:label "A pre-registered multi-feature discriminator reaches its registered held-out accuracy on synthetic four-generator ground truth AND returns a definite class for the Holstein set." ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-viability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-viability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-viability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-viability-panel-pooled> ;
        pk:hasPriorProbability "0.5"^^xsd:double ;
        pk:hasResolvability "0.76"^^xsd:double .
}


sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27>,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1>,
            <https://w3id.org/delphi/resource/model/gemini-4-argon>,
            <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;

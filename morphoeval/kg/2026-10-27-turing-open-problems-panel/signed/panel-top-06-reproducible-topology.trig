sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}

sub1:assertion {
    <https://w3id.org/delphi/resource/claim/turing-open-problem-top-06-reproducible-topology> a pk:Claim ;
        rdfs:label "TOP-06 — Reproducible topology: why five digits every time when RD from noise gives defective labyrinths" ;
        dcterms:description "OPEN PROBLEM in Turing-pattern biology, sourced forward from Sheth 2012 -> Raspopovic 2014 -> Green-Sharpe 2015. THE GAP: RD from random initial conditions yields labyrinths with defects; embryos give five digits almost every time. The Turing + positional-information hybrid (Hox dosage sets wavelength, FGF/Wnt gradients orient) explains cases, but there is no general, tested account of how prepattern and boundaries lock topology. DEFINITION OF DONE: A Bmp-Sox9-Wnt three-node RD on a growing fan-shaped limb-bud domain with published parameters and gradient modulation, pre-registered to produce exactly five rays in >=95% of 200 random-IC runs (and the Hox-dose polydactyly series of Sheth 2012 on dose reduction); scored as registered. THREE-PROVIDER DELPHI PANEL (2026-10-27; supersedes the provisional single-assessor pass): resolvability panel mean 69.7/100 (range 62-79; RESOLVABLE WITH WORK) by the deterministic Problem-Scout rubric, and pooled viability posterior 49.02% (prior 50%, pooled net -0.17 dB, panel range 35.99-71.53%) that the named route reaches a decisive verdict. Assessors were blinded to the provisional scores and to each other. PACKET CORRECTION: The packet's tool_route said 'no BSW model exists in models/'. False: models/2014-raspopovic-bmp-sox9-wnt-digits.py (2,066 lines, Pass 3: Bmp-Sox9-Wnt 3-node RD on a growing polar-fan limb-bud mesh, Crampin-Gaffney-Maini dilution) and models/2012-sheth-hox-turing-polydactyly.py (1,619 lines) already exist. Caught by the Claude Fable panellist, verified by the aggregator. The provisional tool_fit (9/25) under-priced this problem; the panel scores stand as recorded, and a re-score with the corrected route is the next action on TOP-06. A belief under assessment, not a fact." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/main/docs/TURING_OPEN_PROBLEMS.md> ;
        pk:context "tool_route: New script (no BSW model exists in models/); 2D RD solver base from models/1952-turing-morpho.py; registry row for the 95% threshold. | deciding_data: Published parameters (Raspopovic 2014 SOM). No wet data. | prior_attempts: None in repo." ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.cels.2015.12.001>,
            <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960> ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-resolvability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-resolvability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-resolvability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-viability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-viability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-viability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-viability-panel-pooled> ;
        pk:weightOfEvidence "0.4902"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-resolvability-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-06 resolvability 79/100 — Claude Fable 5.1 Thinking High (fresh context)" ;
        dcterms:date "2026-10-27"^^xsd:date ;
        dcterms:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 11/15: 200 FEM growing-domain runs are hours on the repo stack; feasible but not trivial.",
            "data_in_hand 17/20: Published parameters already encoded in the scripts and datasets/bmp_sox9_wnt_digits reference JSON; no wet data.",
            "falsifiable_done 13/15: Exactly five rays in >=95% of 200 runs and Hox-dose ordering are numeric gates; a pre-registered ray-counting rule is needed.",
            "isolation 9/10: New wrapper script importing or re-implementing existing functions; new output files.",
            "not_blocked 5/5: No prior repo attempt at the reproducibility fraction.",
            "time_to_verdict 7/10: One long sitting once the wrapper runs.",
            "tool_fit 17/25: Packet is wrong that no BSW model exists: models/2014-raspopovic-bmp-sox9-wnt-digits.py runs the 3-node network on a growing polar-fan FEM mesh with AER-FGF wavelength modulation, noise ICs and ray counts; models/2012-sheth-hox-turing-polydactyly.py gives the Hox-dose series. A 200-random-IC wrapper and five-ray counter is still new." ;
        pk:hasScore "0.79"^^xsd:double ;
        pk:hasVerdict "RESOLVE NOW" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-resolvability-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-06 resolvability 68/100 — Gemini 4 Argon Medium" ;
        dcterms:date "2026-10-27"^^xsd:date ;
        dcterms:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 9/15: Integrating 200 stiff 3-species PDE runs on a 2D deforming/growing limb-bud domain in pure Python/NumPy is computationally heavy and sensitive to boundary discretization.",
            "data_in_hand 15/20: Equations and dimensionless parameter sets are published in Raspopovic et al. (2014) and Sheth et al. (2012), requiring no wet-lab data.",
            "falsifiable_done 14/15: Producing exactly 5 radial Sox9 rays in >=95% of 200 random-IC runs plus monotonic Hox-dose polydactyly ordering is quantitatively crisp.",
            "isolation 10/10: Can be written as a new standalone model script and registry entry without modifying tracked files.",
            "not_blocked 5/5: No prior attempt in the repo has implemented the BSW limb-bud model.",
            "time_to_verdict 4/10: Implementing moving-boundary 2D dilution/advection, distal FGF gradient coupling, and running a 200-run Monte Carlo ensemble is hard to finish cleanly in one loop.",
            "tool_fit 11/25: No Bmp-Sox9-Wnt model or 2D growing fan-shaped domain solver exists in models/; models/1952-turing-morpho.py only provides uniform-grid 2-species Gray-Scott." ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "RESOLVABLE WITH WORK" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-resolvability-gpt-5.6-sol> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-06 resolvability 62/100 — GPT 5.6 Sol Medium" ;
        dcterms:date "2026-10-27"^^xsd:date ;
        dcterms:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 8/15: Two hundred growing-domain three-node 2D runs may exceed hours without optimization.",
            "data_in_hand 15/20: The published model and Hox perturbation papers are named, though full simulation parameters may require supplement reconstruction.",
            "falsifiable_done 15/15: Exactly five rays in 95% of 200 runs plus an ordered dose response is precise.",
            "isolation 10/10: The model can be implemented and scored in new files.",
            "not_blocked 5/5: No prior repository attempt is recorded.",
            "time_to_verdict 4/10: Faithful geometry, growth, parameterization, and ensemble validation require several iterations.",
            "tool_fit 5/25: Only a generic two-species rectangular RD solver is reusable; the BSW network, geometry, growth, and gradients are new." ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "RESOLVABLE WITH WORK" .

    <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27> a prov:SoftwareAgent ;
        rdfs:label "Three-provider Bayesian Delphi panel (OpenAI, Google, Anthropic), blinded, pooled in log-odds" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-viability-claude-fable-5-1> a pk:BayesianAssessment ;
        rdfs:label "TOP-06 viability 71.53% — Claude Fable 5.1 Thinking High (fresh context)" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:bayesFactor "2.5119"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-06-reproducible-topology-decisive-verdict> ;
        pk:evidenceAgainst "[-1 dB] 200 FEM runs may exceed a single loop's wall clock on a laptop.",
            "[-1 dB] Ray counting at the distal arc (what counts as a ray vs a branch) needs a locked rule; otherwise the fraction is contestable.",
            "[-3 dB] The existing script's F->D wavelength mapping is an admitted modelling choice, not Raspopovic's equations; a failed 95% could be attributed to model unfaithfulness rather than refuting the hypothesis." ;
        pk:evidenceFor "[+2 dB] The Sheth Hox-dose wavelength law is already implemented, making the polydactyly ordering clause cheap to score.",
            "[+3 dB] Pure simulation with a sharp numeric threshold; either >=95% or not is observable regardless of outcome.",
            "[+4 dB] A growing-domain BSW solver with gradient modulation and digit-ray counting already exists in models/, so the deciding simulation is mostly a loop over seeds." ;
        pk:hasConfidence "0.65"^^xsd:double ;
        pk:hasProbability "0.7153"^^xsd:double ;
        pk:hasVerdict "DECISIVE_SIM_FAITHFULNESS_CONTESTED" ;
        pk:weightOfEvidenceDeciban "4.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-viability-gemini-4-argon> a pk:BayesianAssessment ;
        rdfs:label "TOP-06 viability 38.69% — Gemini 4 Argon Medium" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:bayesFactor "0.631"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-06-reproducible-topology-decisive-verdict> ;
        pk:evidenceAgainst "[-2 dB] Running 200 full 2D growing-domain PDE integrations plus Hox-dosage sweeps in pure NumPy risks hitting single-session compute and numerical-stability limits.",
            "[-3.5 dB] Raspopovic et al. (2014) relied on UJM/COMSOL finite-element meshes reconstructed from optical projection tomography of real limb buds; simplified finite-difference fan approximations routinely suffer boundary-induced bifurcations or 4/6-digit defects in >5% of random-IC runs." ;
        pk:evidenceFor "[+1.5 dB] Distal FGF wavelength modulation and anisotropic domain elongation are known theoretically to align stripes radially (Green & Sharpe 2015).",
            "[+2 dB] The pre-registered hypothesis is falsifiable either way: if the 200-run ensemble reaches <95% five-digit locking (e.g. 60%), that negative result still scores the registered threshold." ;
        pk:hasConfidence "0.74"^^xsd:double ;
        pk:hasProbability "0.3869"^^xsd:double ;
        pk:hasVerdict "SOLVER_HEAVY_LIKELY_REFUTATION" ;
        pk:weightOfEvidenceDeciban "-2.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-viability-gpt-5.6-sol> a pk:BayesianAssessment ;
        rdfs:label "TOP-06 viability 35.99% — GPT 5.6 Sol Medium" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;
        pk:bayesFactor "0.5623"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-06-reproducible-topology-decisive-verdict> ;
        pk:evidenceAgainst "[-1.5 dB] Matching the Hox-dose polydactyly ordering adds a second calibration target that can conflict with baseline five-ray tuning.",
            "[-2.5 dB] A faithful growing fan-domain three-node implementation is a substantial new model, not a direct reuse of the existing solver.",
            "[-2.5 dB] Published parameters may not determine boundary conditions and growth tightly enough to make 95% topology reproducibility robust." ;
        pk:evidenceFor "[+1.5 dB] Published BSW and Hox studies provide a concrete implementation route without new wet data.",
            "[+2.5 dB] The target model, perturbation ordering, and numerical success threshold are unusually specific." ;
        pk:hasConfidence "0.78"^^xsd:double ;
        pk:hasProbability "0.3599"^^xsd:double ;
        pk:hasVerdict "DOUBTFUL" ;
        pk:weightOfEvidenceDeciban "-2.5"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-viability-panel-pooled> a pk:BayesianAssessment ;
        rdfs:label "TOP-06 pooled viability 49.02% (3-provider panel, range 35.99-71.53%)" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27> ;
        pk:bayesFactor "0.9616"^^xsd:double ;
        pk:calibrationMethod "log-odds mean across 3 assessors (equal priors 50%, so pooled net dB = mean net dB)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-06-reproducible-topology-decisive-verdict> ;
        pk:hasProbability "0.4902"^^xsd:double ;
        pk:hasVerdict "POOLED_POSSIBLE_PATHWAY" ;
        pk:weightOfEvidenceDeciban "-0.17"^^xsd:double .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 Thinking High (fresh context) (Anthropic)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .

    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon Medium (Google)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .

    <https://w3id.org/delphi/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT 5.6 Sol Medium (OpenAI)" ;
        dcterms:identifier "gpt-5.6-sol" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .

    <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-06-reproducible-topology-decisive-verdict> a pk:TestableHypothesis ;
        rdfs:label "A faithful BSW growing-domain model reproduces five rays in >=95% of random-IC runs and the Hox-dose polydactyly ordering." ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-viability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-viability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-viability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-06-reproducible-topology-viability-panel-pooled> ;
        pk:hasPriorProbability "0.5"^^xsd:double ;
        pk:hasResolvability "0.697"^^xsd:double .
}


sub1:assertion {
    <https://w3id.org/delphi/resource/claim/turing-open-problem-top-02-diffusion-ratio-census> a pk:Claim ;
        rdfs:label "TOP-02 — The diffusion-ratio problem: which molecularly identified Turing systems can be two-species at all?" ;
        dcterms:description "OPEN PROBLEM in Turing-pattern biology, sourced forward from Gierer-Meinhardt 1972 -> Marcon 2016 -> 2025 'fundamental limits'. THE GAP: Two-species activator-inhibitor models need D_inh/D_act above the Lean-checked threshold (d_c = 3.93 for the repo's Gray-Scott Jacobian; ~4-10 generally), yet measured extracellular diffusivities rarely show it; three-node networks with an immobile node remove the requirement (Marcon 2016) and extracellular wiring changes behaviour qualitatively (2025 bioRxiv). Nobody has tabulated, system by system, which of the molecularly supported cases (WNT/DKK, FGF/Shh palate, Bmp-Sox9-Wnt digits, GDF5/NOG joints, EDAR/WNT/BMP ridges, Nodal/Lefty) actually satisfies the two-species condition with measured D. DEFINITION OF DONE: A registered table of >=6 molecular Turing systems giving measured or bounded D_act, D_inh (with DOI), run through the repo's dispersion relation, classifying each as two-node-feasible / needs immobile third node / D unmeasured; the count in each class pre-registered before the literature values are looked up. THREE-PROVIDER DELPHI PANEL (2026-10-27; supersedes the provisional single-assessor pass): resolvability panel mean 74.3/100 (range 61-89; RESOLVE NOW) by the deterministic Problem-Scout rubric, and pooled viability posterior 66.61% (prior 50%, pooled net +3 dB, panel range 58.55-78.01%) that the named route reaches a decisive verdict. Assessors were blinded to the provisional scores and to each other. A belief under assessment, not a fact." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/main/docs/TURING_OPEN_PROBLEMS.md> ;
        pk:context "tool_route: python3 morphoeval/scout_literature.py --query '<morphogen> diffusion coefficient FRAP FCS' per system; models/1952-turing-morpho.py dispersion (Lean turing_differential_diffusion_instability, d_c = 3.9271); predictions/ registry row for the pre-registered counts. | deciding_data: Public literature only. Known in hand: Nodal/Lefty D measured (Mueller 2012); GDF5/NOG model needs no differential diffusion (Grall 2024). Others likely unmeasured — that is itself the finding. | prior_attempts: None in repo. scout-063 ZF-TUR-01 kernel-checked a size-prior D ratio (D_inh/D_act < 1 for chd/bmp2b) — a related negative." ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/j.cell.2023.01.015>,
            <https://doi.org/10.1038/ng.1090>,
            <https://doi.org/10.1073/pnas.2304470121>,
            <https://doi.org/10.1101/2025.05.27.656324>,
            <https://doi.org/10.1126/science.1130088>,
            <https://doi.org/10.1126/science.1221920>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.7554/eLife.14022> ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-resolvability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-resolvability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-resolvability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-viability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-viability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-viability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-viability-panel-pooled> ;
        pk:weightOfEvidence "0.6661"^^xsd:double .

    <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27> a prov:SoftwareAgent ;
        rdfs:label "Three-provider Bayesian Delphi panel (OpenAI, Google, Anthropic), blinded, pooled in log-odds" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-resolvability-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-02 resolvability 61/100 — Claude Fable 5.1 Thinking High (fresh context)" ;
        dcterms:date "2026-10-27"^^xsd:date ;
        dcterms:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 13/15: Dispersion evaluation is trivial; the effort is reading, not compute.",
            "data_in_hand 12/20: Public literature; Nodal/Lefty (Mueller 2012) and GDF5/NOG (Grall 2024) are known; others need targeted FRAP/FCS lookups and may be unmeasured (which the packet counts as a finding).",
            "falsifiable_done 9/15: Pre-registered class counts are checkable, but assigning 'two-node-feasible' needs a kinetics-specific threshold; 'bounded D' and class boundaries carry taste.",
            "isolation 8/10: New table under datasets/ plus one registry row in a shared file.",
            "not_blocked 5/5: No prior repo attempt at a census; scout-063 ZF-TUR-01 is a related negative, not a refutation of this route.",
            "time_to_verdict 6/10: >=6 systems with DOI-cited D values is one long literature sitting; feasible but easily spills over.",
            "tool_fit 8/25: scout_literature.py --query is only an OpenAlex search; the 1952 dispersion/d_c = 3.9271 is for the Gray-Scott Jacobian and does not transfer to WNT/DKK, Nodal/Lefty etc. kinetics, so the classifying computation is not a run-as-is tool." ;
        pk:hasScore "0.61"^^xsd:double ;
        pk:hasVerdict "RESOLVABLE WITH WORK" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-resolvability-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-02 resolvability 89/100 — Gemini 4 Argon Medium" ;
        dcterms:date "2026-10-27"^^xsd:date ;
        dcterms:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 15/15: Evaluating analytic dispersion inequalities and critical diffusion ratios across a table of <10 systems takes milliseconds in Python.",
            "data_in_hand 15/20: Nodal/Lefty FRAP/FCS diffusivities (Mueller 2012) and GDF5/NOG parameters (Grall 2024) are known in literature; the remaining systems require structured literature extraction.",
            "falsifiable_done 14/15: Three mutually exclusive classes (two-node-feasible, needs immobile third node, D unmeasured) with pre-registered counts across >=6 systems give an unambiguous score.",
            "isolation 10/10: Self-contained as a new literature table, dispersion verifier script, and prediction registry file.",
            "not_blocked 5/5: No prior attempt in the repo has assembled or tested the cross-system diffusivity ratio census.",
            "time_to_verdict 9/10: Reachable in a single sitting via targeted literature lookup and algebraic verification.",
            "tool_fit 21/25: models/1952-turing-morpho.py already implements the exact 2-node Jacobian dispersion relation and d_c threshold, and morphoeval/scout_literature.py automates literature queries." ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "RESOLVE NOW" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-resolvability-gpt-5.6-sol> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-02 resolvability 73/100 — GPT 5.6 Sol Medium" ;
        dcterms:date "2026-10-27"^^xsd:date ;
        dcterms:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 15/15: Literature extraction and dispersion calculations need no wet lab or heavy computation.",
            "data_in_hand 14/20: The cited public literature seeds six systems, though several diffusivities may be unavailable or incomparable.",
            "falsifiable_done 13/15: Six DOI-backed rows and explicit class counts are checkable, subject to rules for bounds and network topology.",
            "isolation 10/10: The census table, analysis, and registration can be created independently.",
            "not_blocked 4/5: A related zebrafish mobility prior was negative, but no census has tested this route.",
            "time_to_verdict 6/10: Finding defensible in-vivo diffusivities across six systems is more than a routine single search.",
            "tool_fit 11/25: The literature scout and two-species dispersion code exist, but extraction and three-class adjudication are manual." ;
        pk:hasScore "0.73"^^xsd:double ;
        pk:hasVerdict "RESOLVE NOW" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-viability-claude-fable-5-1> a pk:BayesianAssessment ;
        rdfs:label "TOP-02 viability 61.31% — Claude Fable 5.1 Thinking High (fresh context)" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:bayesFactor "1.5849"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-02-diffusion-ratio-census-decisive-verdict> ;
        pk:evidenceAgainst "[-1 dB] Extracellular D estimates differ 10-100x between FRAP, FCS and modelling fits for the same morphogen, so single rows can flip class.",
            "[-2 dB] The three classes are not mutually exclusive once network topology is considered (Marcon 2016), so a scorer can contest the pre-registered counts.",
            "[-3 dB] Two-node feasibility depends on the kinetic Jacobian, not just the D ratio; using the Gray-Scott d_c as a universal gate makes class assignments disputable." ;
        pk:evidenceFor "[+2 dB] GDF5/NOG (Grall 2024) is a published no-differential-diffusion case, populating the 'needs immobile third node' class.",
            "[+3 dB] Nodal/Lefty D values are measured (Mueller 2012: ~0.7 vs ~18 um^2/s), giving at least one clean two-node-feasible row.",
            "[+3 dB] The 'D unmeasured' class is trivially populated (WNT/DKK in skin, EDAR/WNT/BMP ridges), so the >=6-row and three-class coverage conditions are easy to meet." ;
        pk:hasConfidence "0.55"^^xsd:double ;
        pk:hasProbability "0.6131"^^xsd:double ;
        pk:hasVerdict "CENSUS_REACHABLE_CLASSES_DISPUTABLE" ;
        pk:weightOfEvidenceDeciban "2.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-viability-gemini-4-argon> a pk:BayesianAssessment ;
        rdfs:label "TOP-02 viability 78.01% — Gemini 4 Argon Medium" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:bayesFactor "3.5481"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-02-diffusion-ratio-census-decisive-verdict> ;
        pk:evidenceAgainst "[-1.5 dB] Pre-registering exact class counts before literature extraction carries a modest risk of missing the exact integer split if an obscure FRAP paper exists for FGF/Shh or EDAR/BMP." ;
        pk:evidenceFor "[+3 dB] The algebraic dispersion criterion in models/1952-turing-morpho.py is already Lean-verified and requires zero PDE integration noise.",
            "[+4 dB] Published literature already anchors all three target classes: zebrafish Nodal/Lefty has measured D_Lefty/D_Nodal ~ 15-20 (Mueller et al. 2012, class 1), Bmp-Sox9-Wnt and GDF5/NOG rely on cell-autonomous Sox9/pSmad nodes (Raspopovic 2014, Grall 2024, class 2), and mammalian WNT/DKK lacks paired in vivo extracellular FCS/FRAP values (class 3)." ;
        pk:hasConfidence "0.88"^^xsd:double ;
        pk:hasProbability "0.7801"^^xsd:double ;
        pk:hasVerdict "HIGHLY_TRACTABLE_DECISIVE" ;
        pk:weightOfEvidenceDeciban "5.5"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-viability-gpt-5.6-sol> a pk:BayesianAssessment ;
        rdfs:label "TOP-02 viability 58.55% — GPT 5.6 Sol Medium" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;
        pk:bayesFactor "1.4125"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-02-diffusion-ratio-census-decisive-verdict> ;
        pk:evidenceAgainst "[-1 dB] The needs-immobile-node class cannot be inferred from a failed two-species diffusion ratio alone without a topology-specific model.",
            "[-1.5 dB] Many systems may lack measured effective diffusivities in the relevant tissue and developmental stage." ;
        pk:evidenceFor "[+1.5 dB] The existing dispersion implementation directly tests two-node feasibility once coefficients are available.",
            "[+2.5 dB] The target systems and several cornerstone measurements are already named, making six classifications plausible." ;
        pk:hasConfidence "0.67"^^xsd:double ;
        pk:hasProbability "0.5855"^^xsd:double ;
        pk:hasVerdict "PLAUSIBLY_DECISIVE" ;
        pk:weightOfEvidenceDeciban "1.5"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-viability-panel-pooled> a pk:BayesianAssessment ;
        rdfs:label "TOP-02 pooled viability 66.61% (3-provider panel, range 58.55-78.01%)" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27> ;
        pk:bayesFactor "1.9953"^^xsd:double ;
        pk:calibrationMethod "log-odds mean across 3 assessors (equal priors 50%, so pooled net dB = mean net dB)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-02-diffusion-ratio-census-decisive-verdict> ;
        pk:hasProbability "0.6661"^^xsd:double ;
        pk:hasVerdict "POOLED_POSSIBLE_PATHWAY" ;
        pk:weightOfEvidenceDeciban "3.0"^^xsd:double .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 Thinking High (fresh context) (Anthropic)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .

    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon Medium (Google)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .

    <https://w3id.org/delphi/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT 5.6 Sol Medium (OpenAI)" ;
        dcterms:identifier "gpt-5.6-sol" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .

    <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-02-diffusion-ratio-census-decisive-verdict> a pk:TestableHypothesis ;
        rdfs:label "The census reaches a classification for >=6 systems, with the pre-registered class counts scored, and at least one system falls in each of the three classes." ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-viability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-viability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-viability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-viability-panel-pooled> ;
        pk:hasPriorProbability "0.5"^^xsd:double ;
        pk:hasResolvability "0.743"^^xsd:double .
}


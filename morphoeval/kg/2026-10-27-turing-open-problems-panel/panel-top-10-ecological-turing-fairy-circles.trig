@prefix dct: <http://purl.org/dc/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix pk: <https://w3id.org/delphi/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/turing-open-problem-top-10-ecological-turing-fairy-circles> a pk:Claim ;
        rdfs:label "TOP-10 — Ecology-scale Turing: fairy circles as scale-dependent-feedback RD vs termite engineering" ;
        dct:description "OPEN PROBLEM in Turing-pattern biology, sourced forward from Klausmeier 1999 -> Getzin 2016 -> Tarnita 2017. THE GAP: Namibian and Australian fairy circles are still contested between vegetation reaction-diffusion (scale-dependent feedback) and termite engineering; Tarnita 2017 shows the two are not exclusive. Pattern statistics alone (hexagonal order, pair correlation) have not settled it — the same lesson as TOP-01. DEFINITION OF DONE: A pre-registered comparison of a vegetation RD model and a termite-territory model against public aerial-imagery pair-correlation and Voronoi statistics with locked discrimination thresholds; reported either way. THREE-PROVIDER DELPHI PANEL (2026-10-27; supersedes the provisional single-assessor pass): resolvability panel mean 53/100 (range 49-61; RESOLVABLE WITH WORK) by the deterministic Problem-Scout rubric, and pooled viability posterior 24.75% (prior 50%, pooled net -4.83 dB, panel range 24.03-26.19%) that the named route reaches a decisive verdict. Assessors were blinded to the provisional scores and to each other. A belief under assessment, not a fact." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/TURING_OPEN_PROBLEMS.md> ;
        pk:context "tool_route: No ecological model or imagery in repo; new scripts and a public data fetch would be required. | deciding_data: Public aerial imagery / published point patterns (Getzin et al.). Nothing in repo. | prior_attempts: None in repo." ;
        pk:derivedFromPaper <https://doi.org/10.1038/nature20801>,
            <https://doi.org/10.1073/pnas.1522130113> ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-resolvability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-resolvability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-resolvability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-viability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-viability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-viability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-viability-panel-pooled> ;
        pk:weightOfEvidence "0.2475"^^xsd:double .

    <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27> a prov:SoftwareAgent ;
        rdfs:label "Three-provider Bayesian Delphi panel (OpenAI, Google, Anthropic), blinded, pooled in log-odds" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-resolvability-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-10 resolvability 49/100 — Claude Fable 5.1 Thinking High (fresh context)" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 11/15: Both models are simple PDE/agent simulations that run in hours once written.",
            "data_in_hand 7/20: Published pair-correlation/Voronoi statistics (Getzin 2016) are one fetch away; georeferenced aerial imagery is not a single named public fetch.",
            "falsifiable_done 9/15: Locked thresholds are crisp, but the gap itself notes pattern statistics have not separated the mechanisms, so the gate may be structurally non-discriminating.",
            "isolation 9/10: All new scripts and data folders.",
            "not_blocked 5/5: No prior repo attempt.",
            "time_to_verdict 4/10: Two new models plus data acquisition is more than one sitting.",
            "tool_fit 4/25: No vegetation RD (Klausmeier) or termite-territory model in repo; 2015-ocko-termite-mound script is about convection, not territories; only the generic 2D RD solver base is reusable." ;
        pk:hasScore "0.49"^^xsd:double ;
        pk:hasVerdict "RESOLVABLE WITH WORK" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-resolvability-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-10 resolvability 61/100 — Gemini 4 Argon Medium" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 13/15: 2D point-pattern Voronoi tessellations (scipy.spatial.Voronoi), pair-correlation functions, and 2D vegetation PDE runs fit easily on the repo stack.",
            "data_in_hand 10/20: No aerial imagery or fairy-circle coordinate datasets are in the repo, though Getzin et al. (2016/2021) point-pattern supplements are publicly downloadable.",
            "falsifiable_done 12/15: Locked discrimination thresholds on pair-correlation g(r) and Voronoi hexagonal order Z_6 give a clear rule, even if both models fall in the indecisive zone.",
            "isolation 10/10: Completely isolatable as a new ecological script and dataset folder.",
            "not_blocked 3/5: No prior repo attempt, but Tarnita et al. (2017) already showed that termite foraging and scale-dependent vegetation feedback produce nearly identical hexagonal Voronoi and g(r) statistics.",
            "time_to_verdict 5/10: Fetching external dryland point sets and building two new spatial models from scratch takes substantial effort.",
            "tool_fit 8/25: Neither a Klausmeier/Rietkerk scale-dependent vegetation PDE nor a termite territory spatial point-process generator exists in the repository." ;
        pk:hasScore "0.61"^^xsd:double ;
        pk:hasVerdict "RESOLVABLE WITH WORK" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-resolvability-gpt-5.6-sol> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-10 resolvability 49/100 — GPT 5.6 Sol Medium" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 10/15: New simulation and spatial-statistics code is computationally feasible without wet lab.",
            "data_in_hand 6/20: Public imagery is plausible, but no local dataset or guaranteed reusable point-pattern source is named.",
            "falsifiable_done 13/15: Locked pair-correlation and Voronoi thresholds could be objective if identifiability is established.",
            "isolation 10/10: New models, fetched data manifests, and analyses can be isolated.",
            "not_blocked 5/5: No repository attempt is recorded.",
            "time_to_verdict 3/10: Building and validating two models plus imagery extraction is not a one-sitting route.",
            "tool_fit 2/25: No ecological model, imagery pipeline, or mechanism comparator exists in the repository." ;
        pk:hasScore "0.49"^^xsd:double ;
        pk:hasVerdict "RESOLVABLE WITH WORK" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-viability-claude-fable-5-1> a pk:BayesianAssessment ;
        rdfs:label "TOP-10 viability 24.03% — Claude Fable 5.1 Thinking High (fresh context)" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:bayesFactor "0.3162"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-10-ecological-turing-fairy-circles-decisive-verdict> ;
        pk:evidenceAgainst "[-2 dB] Nothing exists in repo; two models plus a data pipeline is a multi-day build before the first verdict.",
            "[-3 dB] Public georeferenced aerial imagery suitable for point extraction is not one named fetch and may have licensing limits.",
            "[-4 dB] Tarnita 2017 shows both mechanisms (and their combination) yield the same hexagonal statistics; pattern statistics alone cannot decisively favour one, so the hypothesis is likely undecidable at any threshold." ;
        pk:evidenceFor "[+2 dB] Both a scale-dependent-feedback vegetation model and a Voronoi territory model are small to implement.",
            "[+2 dB] Getzin et al. publish pair-correlation and Voronoi statistics numerically, reducing imagery dependence." ;
        pk:hasConfidence "0.65"^^xsd:double ;
        pk:hasProbability "0.2403"^^xsd:double ;
        pk:hasVerdict "STATISTICS_NON_DISCRIMINATING" ;
        pk:weightOfEvidenceDeciban "-5.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-viability-gemini-4-argon> a pk:BayesianAssessment ;
        rdfs:label "TOP-10 viability 26.19% — Gemini 4 Argon Medium" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:bayesFactor "0.3548"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-10-ecological-turing-fairy-circles-decisive-verdict> ;
        pk:evidenceAgainst "[-2 dB] Without multi-scale small-scale vegetation clump data between the circles or soil-moisture time series, aerial circle centroids alone are known to be equifinal.",
            "[-4 dB] Tarnita et al. (2017, Nature) explicitly demonstrated that intraspecific termite colony competition and scale-dependent water-biomass Turing feedback generate indistinguishable hexagonal Voronoi distributions and pair-correlation peaks at the macro-circle scale." ;
        pk:evidenceFor "[+1.5 dB] Getzin et al.'s Namibian and Australian fairy-circle point coordinates and drone ortho-mosaics are publicly archived on Dryad/Figshare, and SciPy's Voronoi/KDTree routines can compute g(r) and hexagonal order quickly." ;
        pk:hasConfidence "0.84"^^xsd:double ;
        pk:hasProbability "0.2619"^^xsd:double ;
        pk:hasVerdict "EQUIFINAL_STATISTICS_UNLIKELY_DECISIVE" ;
        pk:weightOfEvidenceDeciban "-4.5"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-viability-gpt-5.6-sol> a pk:BayesianAssessment ;
        rdfs:label "TOP-10 viability 24.03% — GPT 5.6 Sol Medium" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;
        pk:bayesFactor "0.3162"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-10-ecological-turing-fairy-circles-decisive-verdict> ;
        pk:evidenceAgainst "[-1 dB] Vegetation feedback and termite engineering can coexist, undermining a forced one-mechanism verdict.",
            "[-3 dB] The packet itself states that the proposed pattern statistics have not distinguished the mechanisms.",
            "[-4 dB] Both mechanism models, the imagery dataset, segmentation, and comparison harness must be built from scratch." ;
        pk:evidenceFor "[+1 dB] Aerial imagery and published ecological models are public in principle.",
            "[+2 dB] Pair-correlation and Voronoi summaries admit preregistered quantitative comparisons." ;
        pk:hasConfidence "0.87"^^xsd:double ;
        pk:hasProbability "0.2403"^^xsd:double ;
        pk:hasVerdict "UNLIKELY_DECISIVE" ;
        pk:weightOfEvidenceDeciban "-5.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-viability-panel-pooled> a pk:BayesianAssessment ;
        rdfs:label "TOP-10 pooled viability 24.75% (3-provider panel, range 24.03-26.19%)" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27> ;
        pk:bayesFactor "0.3289"^^xsd:double ;
        pk:calibrationMethod "log-odds mean across 3 assessors (equal priors 50%, so pooled net dB = mean net dB)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-10-ecological-turing-fairy-circles-decisive-verdict> ;
        pk:hasProbability "0.2475"^^xsd:double ;
        pk:hasVerdict "POOLED_POSSIBLE_PATHWAY" ;
        pk:weightOfEvidenceDeciban "-4.83"^^xsd:double .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 Thinking High (fresh context) (Anthropic)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .

    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon Medium (Google)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .

    <https://w3id.org/delphi/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT 5.6 Sol Medium (OpenAI)" ;
        dct:identifier "gpt-5.6-sol" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .

    <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-10-ecological-turing-fairy-circles-decisive-verdict> a pk:TestableHypothesis ;
        rdfs:label "Pattern statistics from public imagery decisively favour one mechanism at the locked thresholds." ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-viability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-viability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-viability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-10-ecological-turing-fairy-circles-viability-panel-pooled> ;
        pk:hasPriorProbability "0.5"^^xsd:double ;
        pk:hasResolvability "0.53"^^xsd:double .
}


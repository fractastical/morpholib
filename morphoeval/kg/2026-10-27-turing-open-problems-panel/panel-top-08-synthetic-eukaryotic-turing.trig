@prefix dct: <http://purl.org/dc/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix pk: <https://w3id.org/delphi/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/turing-open-problem-top-08-synthetic-eukaryotic-turing> a pk:Claim ;
        rdfs:label "TOP-08 — Synthetic realisation: a robust, deterministic periodic Turing pattern in eukaryotic cells" ;
        dct:description "OPEN PROBLEM in Turing-pattern biology, sourced forward from Sekine 2018 -> Tica 2024. THE GAP: Bacterial three-node circuits now give reproducible concentric stripes but remain condition-sensitive (Tica 2024); the mammalian Nodal-Lefty circuit most likely produced solitary, not periodic, patterns (Sekine 2018). A robust eukaryotic periodic Turing pattern has not been built. DEFINITION OF DONE: Wet-lab: a eukaryotic circuit producing periodic patterns with pre-registered wavelength reproducibility across >=3 biological replicates. The repo can only contribute the Turing-vs-solitary regime map of the published circuit model. THREE-PROVIDER DELPHI PANEL (2026-10-27; supersedes the provisional single-assessor pass): resolvability panel mean 20/100 (range 14-26; NOT WITH OUR TOOLS (yet)) by the deterministic Problem-Scout rubric, and pooled viability posterior 8.18% (prior 50%, pooled net -10.5 dB, panel range 5.94-10.09%) that the named route reaches a decisive verdict. Assessors were blinded to the provisional scores and to each other. A belief under assessment, not a fact." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/TURING_OPEN_PROBLEMS.md> ;
        pk:context "tool_route: None adequate: no wet lab. Modelling satellite only (regime map of the Sekine competitive-inhibition model). | deciding_data: Not obtainable here. | prior_attempts: None in repo." ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.cels.2024.11.002>,
            <https://doi.org/10.1038/s41467-018-07847-x> ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-resolvability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-resolvability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-resolvability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-viability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-viability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-viability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-viability-panel-pooled> ;
        pk:weightOfEvidence "0.0818"^^xsd:double .

    <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27> a prov:SoftwareAgent ;
        rdfs:label "Three-provider Bayesian Delphi panel (OpenAI, Google, Anthropic), blinded, pooled in log-odds" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-resolvability-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-08 resolvability 14/100 — Claude Fable 5.1 Thinking High (fresh context)" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 1/15: Requires a wet lab; only a regime map of the Sekine model runs here and it does not decide the problem.",
            "data_in_hand 0/20: Deciding data is wet-lab output not obtainable here.",
            "falsifiable_done 3/15: The wet-lab done is exact, but no scorer in this repo can check it.",
            "isolation 5/10: A satellite regime-map script would be new files only, but it is not the deliverable.",
            "not_blocked 5/5: No prior repo attempt.",
            "time_to_verdict 0/10: No verdict reachable in this repo on any timescale.",
            "tool_fit 0/25: No repo tool can build or assay a eukaryotic synthetic circuit; the modelling satellite is not the deciding evidence." ;
        pk:hasScore "0.14"^^xsd:double ;
        pk:hasVerdict "NOT WITH OUR TOOLS (yet)" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-resolvability-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-08 resolvability 26/100 — Gemini 4 Argon Medium" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 0/15: Explicitly requires wet-lab synthetic biology infrastructure outside the computational stack.",
            "data_in_hand 2/20: Deciding evidence requires new biological replicate measurements from engineered eukaryotic cells, which do not exist in the repo or public databases.",
            "falsifiable_done 8/15: Wavelength reproducibility across >=3 biological replicates is well-defined for a wet lab, but unreachable as a repo definition-of-done.",
            "isolation 10/10: A theoretical regime-map note can be written as a new file without conflict, though it cannot close the experimental done criterion.",
            "not_blocked 4/5: No prior repo attempt, but structurally blocked by the absence of wet-lab execution.",
            "time_to_verdict 0/10: Cannot reach a decisive verdict on the stated wet-lab problem within any software loop.",
            "tool_fit 2/25: The repository has no wet-lab mammalian cell culture or microscopy capability; it can only run a computational regime map of Sekine et al.'s competitive-inhibition ODE/PDE." ;
        pk:hasScore "0.26"^^xsd:double ;
        pk:hasVerdict "HARD HERE" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-resolvability-gpt-5.6-sol> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-08 resolvability 20/100 — GPT 5.6 Sol Medium" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 0/15: A model regime map cannot substitute for constructing and assaying the circuit.",
            "data_in_hand 0/20: The decisive biological replicate data are not obtainable in this repository.",
            "falsifiable_done 15/15: Periodic patterning with preregistered wavelength reproducibility across three replicates is checkable.",
            "isolation 0/10: The required work is external wet-lab infrastructure rather than isolated repository files.",
            "not_blocked 5/5: No prior repo attempt refuted the route, but this does not remove the infrastructure block.",
            "time_to_verdict 0/10: Circuit engineering and biological replication cannot be completed in one repository loop.",
            "tool_fit 0/25: The packet explicitly states that no repo tool can perform the required eukaryotic wet-lab construction." ;
        pk:hasScore "0.2"^^xsd:double ;
        pk:hasVerdict "NOT WITH OUR TOOLS (yet)" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-viability-claude-fable-5-1> a pk:BayesianAssessment ;
        rdfs:label "TOP-08 viability 9.09% — Claude Fable 5.1 Thinking High (fresh context)" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:bayesFactor "0.1"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-08-synthetic-eukaryotic-turing-decisive-verdict> ;
        pk:evidenceAgainst "[-2 dB] The hypothesis asserts the repo decides a question that is settled only by experiment.",
            "[-4 dB] The packet itself states the deciding data is not obtainable here.",
            "[-5 dB] The definition of done is a wet-lab construct with biological replicates; the repo has no wet capability." ;
        pk:evidenceFor "[+1 dB] A Turing-vs-solitary regime map of the Sekine competitive-inhibition model is computable in-repo as a satellite." ;
        pk:hasConfidence "0.95"^^xsd:double ;
        pk:hasProbability "0.0909"^^xsd:double ;
        pk:hasVerdict "OUT_OF_SCOPE_WET_LAB" ;
        pk:weightOfEvidenceDeciban "-10.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-viability-gemini-4-argon> a pk:BayesianAssessment ;
        rdfs:label "TOP-08 viability 10.09% — Gemini 4 Argon Medium" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:bayesFactor "0.1122"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-08-synthetic-eukaryotic-turing-decisive-verdict> ;
        pk:evidenceAgainst "[-5 dB] The packet's own tool_route and deciding_data explicitly state 'None adequate: no wet lab' and 'Not obtainable here'.",
            "[-5 dB] The stated definition of done requires wet-lab engineering of eukaryotic cells across >=3 biological replicates, which is impossible in a pure software repository." ;
        pk:evidenceFor "[+0.5 dB] A computational bifurcation map of Sekine et al. (2018) vs Tica et al. (2024) can delineate where solitary pulses transition to periodic Turing stripes in parameter space." ;
        pk:hasConfidence "0.98"^^xsd:double ;
        pk:hasProbability "0.1009"^^xsd:double ;
        pk:hasVerdict "WET_LAB_BLOCKED_OUT_OF_SCOPE" ;
        pk:weightOfEvidenceDeciban "-9.5"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-viability-gpt-5.6-sol> a pk:BayesianAssessment ;
        rdfs:label "TOP-08 viability 5.94% — GPT 5.6 Sol Medium" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;
        pk:bayesFactor "0.0631"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-08-synthetic-eukaryotic-turing-decisive-verdict> ;
        pk:evidenceAgainst "[-2 dB] A computational regime map can narrow parameters but cannot establish that a robust eukaryotic periodic circuit was realized.",
            "[-5 dB] The decisive replicate data cannot be generated or fetched from this repository.",
            "[-5 dB] The required intervention is wet-lab construction and the tool route explicitly says none is adequate." ;
        pk:hasConfidence "0.99"^^xsd:double ;
        pk:hasProbability "0.0594"^^xsd:double ;
        pk:hasVerdict "NOT_RESOLVABLE" ;
        pk:weightOfEvidenceDeciban "-12.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-viability-panel-pooled> a pk:BayesianAssessment ;
        rdfs:label "TOP-08 pooled viability 8.18% (3-provider panel, range 5.94-10.09%)" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27> ;
        pk:bayesFactor "0.0891"^^xsd:double ;
        pk:calibrationMethod "log-odds mean across 3 assessors (equal priors 50%, so pooled net dB = mean net dB)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-08-synthetic-eukaryotic-turing-decisive-verdict> ;
        pk:hasProbability "0.0818"^^xsd:double ;
        pk:hasVerdict "POOLED_BELOW_15_PERCENT" ;
        pk:weightOfEvidenceDeciban "-10.5"^^xsd:double .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 Thinking High (fresh context) (Anthropic)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .

    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon Medium (Google)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .

    <https://w3id.org/delphi/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT 5.6 Sol Medium (OpenAI)" ;
        dct:identifier "gpt-5.6-sol" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .

    <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-08-synthetic-eukaryotic-turing-decisive-verdict> a pk:TestableHypothesis ;
        rdfs:label "This repo brings the synthetic eukaryotic Turing problem to a decisive verdict." ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-viability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-viability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-viability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-viability-panel-pooled> ;
        pk:hasPriorProbability "0.5"^^xsd:double ;
        pk:hasResolvability "0.2"^^xsd:double .
}


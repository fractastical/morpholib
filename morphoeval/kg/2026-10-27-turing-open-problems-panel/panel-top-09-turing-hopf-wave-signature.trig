sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/turing-open-problem-top-09-turing-hopf-wave-signature> a pk:Claim ;
        rdfs:label "TOP-09 — Turing's neglected case: is there a wave (Turing-Hopf) dispersion signature in the embryonic Ca2+ wave field?" ;
        dct:description "OPEN PROBLEM in Turing-pattern biology, sourced forward from Turing 1952 Sec. 10 (oscillatory case) -> Ca2+ wave-vector pipeline. THE GAP: Turing 1952 also derived oscillatory, travelling-wave instabilities; essentially no developmental system has been shown to use one. The repo's Ca2+ spark-track data (x, y, t per event) is the only place here that can ask whether an observed wave field carries a dispersion ridge omega(k) distinct from a single driven front (omega = v k). DEFINITION OF DONE: A pre-registered space-time spectral test on existing spark_tracks CSVs: estimate the (k, omega) power surface per embryo, fit the driven-front line, and test for a secondary ridge against phase-randomised surrogates at a locked false-positive rate; report per-embryo outcomes and the pooled verdict either way. THREE-PROVIDER DELPHI PANEL (2026-10-27; supersedes the provisional single-assessor pass): resolvability panel mean 79.7/100 (range 70-88; RESOLVE NOW) by the deterministic Problem-Scout rubric, and pooled viability posterior 57.6% (prior 50%, pooled net +1.33 dB, panel range 38.69-69.12%) that the named route reaches a decisive verdict. Assessors were blinded to the provisional scores and to each other. A belief under assessment, not a fact." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/TURING_OPEN_PROBLEMS.md> ;
        pk:context "tool_route: wave-vector-analysis/ (spark_tracks.csv schema, embryo_units.py for em/s conversion); new spectral script; predictions/ registry for the surrogate threshold. | deciding_data: In repo: wave-vector-analysis/test_data/spark_tracks_qc_folder31.csv, _folder33.csv and analysis_results/*.csv; orientation and coordinate caveats recorded (COORDINATE_SYSTEM_WARNING.md, OP-07). | prior_attempts: scout-036 proposed binned AP spark spectra vs Turing k_c and a travelling-front vs static-labyrinth gate; neither run. Blind tests OP-07/08 found orientation, not wave features, carried signal." ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.ydbio.2019.10.031>,
            <https://doi.org/10.1098/rstb.1952.0012> ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-resolvability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-resolvability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-resolvability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-viability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-viability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-viability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-viability-panel-pooled> ;
        pk:weightOfEvidence "0.576"^^xsd:double .

    <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27> a prov:SoftwareAgent ;
        rdfs:label "Three-provider Bayesian Delphi panel (OpenAI, Google, Anthropic), blinded, pooled in log-odds" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-resolvability-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-09 resolvability 70/100 — Claude Fable 5.1 Thinking High (fresh context)" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 14/15: Binned (x,t) event field, 2D FFT and ~1000 phase-randomised surrogates run in minutes.",
            "data_in_hand 16/20: test_data/spark_tracks_qc_folder31.csv (453 frames, embryos A/B) and _folder33.csv (371 frames, embryo A) are in repo at 1 fps with x,y,t per event.",
            "falsifiable_done 11/15: Per-embryo surrogate test at a locked false-positive rate is crisp; 'fit the driven-front line' and 'secondary ridge' detection need pre-specified estimators.",
            "isolation 9/10: New spectral script and output files; registry row is the only shared touch.",
            "not_blocked 3/5: scout-036 proposed but never ran spectra; OP-07/08 found orientation, not wave features, carried signal — a related negative.",
            "time_to_verdict 8/10: One sitting.",
            "tool_fit 9/25: wave-vector-analysis/ provides the spark_tracks schema and embryo_units.py; no spectral or surrogate tool exists, so the deciding script is new." ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "RESOLVE NOW" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-resolvability-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-09 resolvability 88/100 — Gemini 4 Argon Medium" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 15/15: Space-time FFT or gridded kymograph spectral estimation with 1,000 phase-randomized surrogates per embryo runs in seconds on NumPy/SciPy.",
            "data_in_hand 19/20: Multiple spark_tracks CSVs (test_data/spark_tracks_qc_folder31.csv, _folder33.csv, and analysis_results/ CSVs) with (time_s, ap_norm, x, y) are already in the repository.",
            "falsifiable_done 14/15: Fitting the driven-front line omega = v*k and testing for a secondary Turing-Hopf dispersion ridge against phase-randomized surrogates at a locked false-positive rate gives a definite verdict.",
            "isolation 10/10: Can be written as a standalone spectral analysis script reading existing read-only CSVs in wave-vector-analysis/.",
            "not_blocked 4/5: Scout-036 proposed spectral gates that were never executed; OP-07/08 coordinate caveats apply to raw pixel XY but ap_norm is already normalized per embryo.",
            "time_to_verdict 8/10: Gridding point-process spark tracks onto (ap_norm, time_s) and running the surrogate test takes a single focused session.",
            "tool_fit 18/25: wave-vector-analysis/ and embryo_units.py parse and normalize spark_tracks CSVs, requiring only a new 2D (k, omega) spectral/Lomb-Scargle surrogate test script." ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "RESOLVE NOW" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-resolvability-gpt-5.6-sol> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-09 resolvability 81/100 — GPT 5.6 Sol Medium" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC); total recomputed from factor scores by the aggregator; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 13/15: Spectral fitting and phase-randomized surrogates should run in hours.",
            "data_in_hand 20/20: Two substantial spark-track CSVs and related analysis tables are present locally.",
            "falsifiable_done 14/15: A locked surrogate false-positive rate and per-embryo ridge test are objective.",
            "isolation 10/10: A spectral analysis script and registrations can be added independently.",
            "not_blocked 4/5: Related spectral ideas were proposed but not run; prior negative blind tests concerned other features.",
            "time_to_verdict 8/10: A first decisive run is plausible in one sitting once the event-field estimator is specified.",
            "tool_fit 12/25: Track schema and unit conversion exist, but the central space-time spectral and surrogate test is new." ;
        pk:hasScore "0.81"^^xsd:double ;
        pk:hasVerdict "RESOLVE NOW" .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-viability-claude-fable-5-1> a pk:BayesianAssessment ;
        rdfs:label "TOP-09 viability 38.69% — Claude Fable 5.1 Thinking High (fresh context)" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:bayesFactor "0.631"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-09-turing-hopf-wave-signature-decisive-verdict> ;
        pk:evidenceAgainst "[-1 dB] Prior blind tests (OP-07/08) found no wave-feature signal, lowering the chance of a positive and raising the chance of an under-powered negative.",
            "[-2 dB] Only ~3 embryo recordings are in repo, so the pooled verdict rests on very few units.",
            "[-2 dB] Poke-triggered fronts are broadband and single-shot; separating a Turing-Hopf ridge from front harmonics and coordinate-system artefacts (COORDINATE_SYSTEM_WARNING.md) is ambiguous.",
            "[-3 dB] Sparse point events (~3-5k per recording) at 1 fps give a poorly resolved (k, omega) surface with Nyquist 0.5 Hz; an 'absent' call is largely a power statement, which a scorer may deem non-decisive." ;
        pk:evidenceFor "[+2 dB] Phase-randomised surrogates give a calibrated null regardless of the data's idiosyncrasies.",
            "[+4 dB] Data is in repo and the surrogate test is self-contained, so a per-embryo present/absent call at the locked rate is procedurally guaranteed." ;
        pk:hasConfidence "0.55"^^xsd:double ;
        pk:hasProbability "0.3869"^^xsd:double ;
        pk:hasVerdict "PROCEDURALLY_DECISIVE_UNDERPOWERED" ;
        pk:weightOfEvidenceDeciban "-2.0"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-viability-gemini-4-argon> a pk:BayesianAssessment ;
        rdfs:label "TOP-09 viability 69.12% — Gemini 4 Argon Medium" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:bayesFactor "2.2387"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-09-turing-hopf-wave-signature-decisive-verdict> ;
        pk:evidenceAgainst "[-1 dB] Mask/coordinate mismatches noted in detection_summary_mask_reasoning_v6 require filtering to high-QC embryos before pooling.",
            "[-2 dB] Spark tracks are sparse point events rather than continuous fluorescence fields, so binning onto a (k, omega) grid introduces shot-noise floors and aliasing that could mask weak secondary ridges." ;
        pk:evidenceFor "[+2.5 dB] A phase-randomized or time-shuffled surrogate null test at a locked alpha rate is guaranteed to return a decisive present/absent verdict per embryo.",
            "[+4 dB] The in-repo spark_tracks CSVs already contain thousands of timestamped events with normalized anterior-posterior coordinates (ap_norm) and frame_idx, enabling immediate space-time power spectrum estimation." ;
        pk:hasConfidence "0.85"^^xsd:double ;
        pk:hasProbability "0.6912"^^xsd:double ;
        pk:hasVerdict "READY_IN_REPO_SPECTRAL_TEST" ;
        pk:weightOfEvidenceDeciban "3.5"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-viability-gpt-5.6-sol> a pk:BayesianAssessment ;
        rdfs:label "TOP-09 viability 64.01% — GPT 5.6 Sol Medium" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/gpt-5.6-sol> ;
        pk:bayesFactor "1.7783"^^xsd:double ;
        pk:calibrationMethod "Blinded signed deciban ledger, prior 50%, |item| <= 5 dB, |net| <= 12 dB (panel INSTRUCTIONS.md)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-09-turing-hopf-wave-signature-decisive-verdict> ;
        pk:evidenceAgainst "[-0.5 dB] Known orientation and coordinate caveats complicate pooled directional spectra.",
            "[-1 dB] Two folders provide limited independent replication and may contain multiple tracks from the same underlying waves.",
            "[-2.5 dB] Sparse detected event tracks are not a regularly sampled calcium field, so omega-k power estimates may be estimator-driven." ;
        pk:evidenceFor "[+1.5 dB] The track schema includes time, position, embryo identity, and embryo-relative coordinates.",
            "[+2 dB] Phase-randomized surrogates provide a direct empirical null for secondary-ridge detection.",
            "[+3 dB] The repository contains thousands of timestamped spatial events in two embryo folders." ;
        pk:hasConfidence "0.79"^^xsd:double ;
        pk:hasProbability "0.6401"^^xsd:double ;
        pk:hasVerdict "LIKELY_DECISIVE" ;
        pk:weightOfEvidenceDeciban "2.5"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-viability-panel-pooled> a pk:BayesianAssessment ;
        rdfs:label "TOP-09 pooled viability 57.6% (3-provider panel, range 38.69-69.12%)" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/agent/turing-open-problems-panel-2026-10-27> ;
        pk:bayesFactor "1.3583"^^xsd:double ;
        pk:calibrationMethod "log-odds mean across 3 assessors (equal priors 50%, so pooled net dB = mean net dB)" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-09-turing-hopf-wave-signature-decisive-verdict> ;
        pk:hasProbability "0.576"^^xsd:double ;
        pk:hasVerdict "POOLED_POSSIBLE_PATHWAY" ;
        pk:weightOfEvidenceDeciban "1.33"^^xsd:double .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 Thinking High (fresh context) (Anthropic)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .

    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon Medium (Google)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .

    <https://w3id.org/delphi/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT 5.6 Sol Medium (OpenAI)" ;
        dct:identifier "gpt-5.6-sol" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .

    <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-09-turing-hopf-wave-signature-decisive-verdict> a pk:TestableHypothesis ;
        rdfs:label "The registered surrogate test returns a decisive per-embryo verdict (secondary ridge present/absent at the locked rate) on the in-repo spark-track data." ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-viability-claude-fable-5-1>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-viability-gemini-4-argon>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-viability-gpt-5.6-sol>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-viability-panel-pooled> ;
        pk:hasPriorProbability "0.5"^^xsd:double ;
        pk:hasResolvability "0.797"^^xsd:double .
}


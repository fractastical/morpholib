sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-honda-dichotomous-tree-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Honda (1971) J. Theor. Biol. & Honda & Fisher (1978) Science 3D recursive dichotomous tree branching, effective leaf area optimization, Leonardo da Vinci pipe-model area conservation, and solar-elevation ray tracing of tiered crowns vs latitude — Code-to-model traceability: 94/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Module docstring (L1-60) maps every governing equation to Honda (1971), Honda & Fisher (1978), Fisher & Honda (1979), Shinozaki (1964), Eloy (2011) and, for Pass 3, Campbell & Norman (1998), Cooper (1969) and Monsi & Saeki (1953), and names the 5 Lean theorems with line ranges; each solar function docstring cites its equation (L498-692). The math-KG YAML registers laws 1-5 with refreshed code loci. Deductions: the 3D builder's pitch/roll constants (L221-222, L239) and `gravity_droop_k`, the tier-order schedule (L586), LAI_c = 2 (L1215), the CV percentiles (L850, L871) and the foliage threshold (L801) are stated but not sourced (-4); `_shift_mask` integer-pixel quantisation of the shadow displacement (L629-640) is not documented as a <= 1-cell error (-1); the docstring's Lean pin \"L130-L166\" refers to the comment block, the theorem itself starts at L150 (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1976-honda-dichotomous-tree-branching.py L586–L586: Tier-order schedule max(2, 5 - 4t//n) is an unsourced modelling choice <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L586-L586>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-code-traceability-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1976-honda-dichotomous-tree-branching.py L1–L60" ;
        dcterms:description "Explicit equation-to-paper and Lean 4 theorem traceability in module docstring, including the Pass 3 solar section" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L1-L60> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1976-honda-dichotomous-tree-branching.py L498–L528" ;
        dcterms:description "Solar function docstrings cite Cooper (1969) and Campbell & Norman (1998) equations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L498-L528> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/honda-dichotomous-tree-branching.yaml L28–L140" ;
        dcterms:description "Laws 1-5 registered with code loci and Lean theorem names (Pass 3 laws 4-5 at L95-140)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/math_kg_loops/honda-dichotomous-tree-branching.yaml#L28-L140> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 051 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-honda-dichotomous-tree-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1976-honda-dichotomous-tree-branching.py L1742–L1838" ;
        dcterms:description "10-suite deterministic self-test (8 v2 suites + 2 Pass 3 solar/ray-tracing suites) passing in ~13 s" ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-honda-dichotomous-tree-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-source-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1976-honda-dichotomous-tree-branching.py L91–L123" ;
        dcterms:description "Runtime SHA-256 checksum tables for the v2 dataset and the Pass 3 solar reference JSON; fail-closed loaders" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L91-L123> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/dichotomous_tree_branching/solar_tier_spacing_reference.json L1–L56" ;
        dcterms:description "Pass 3 SHA-256-pinned solar/tier-spacing reference table with latitude benchmarks and specimen tier spacing (provenance note marks it as computed by this script)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/datasets/dichotomous_tree_branching/solar_tier_spacing_reference.json#L1-L56> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/dichotomous_tree_branching/solar_citations_pass3.bib L1–L37" ;
        dcterms:description "Campbell & Norman 1998, Cooper 1969, Monsi & Saeki 1953 BibTeX entries with DOIs (not SHA-pinned; DOIs not re-verified online)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/datasets/dichotomous_tree_branching/solar_citations_pass3.bib#L1-L37> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/dichotomous_tree_branching/README.md L20–L27" ;
        dcterms:description "Pass 3 additions section: file SHA-256, citations, headline s_90/R results" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/datasets/dichotomous_tree_branching/README.md#L20-L27> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Honda (1971) J. Theor. Biol. & Honda & Fisher (1978) Science 3D recursive dichotomous tree branching, effective leaf area optimization, Leonardo da Vinci pipe-model area conservation, and solar-elevation ray tracing of tiered crowns vs latitude — Source and data traceability: 93/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Vendors `datasets/dichotomous_tree_branching/` with 5 BibTeX entries and DOIs in `paper_citations.bib`, `scout_manifest.json`, the reference JSON and the specimen JPEG, all SHA-256-verified at runtime (`verify_dataset_integrity`, L103-118), and Pass 3 adds `solar_tier_spacing_reference.json` pinned via `EXPECTED_SHA256_PASS3` / `load_solar_reference` (L98-100, L120-123), `solar_citations_pass3.bib` with Campbell & Norman (1998), Cooper (1969) and Monsi & Saeki (1953), and a \"Pass 3 additions\" README section with the SHA-256 and the headline numbers. Deductions: `solar_citations_pass3.bib` is a separate file and is not SHA-256-pinned (the original bib is pinned, hence untouched) (-2); the three new DOIs were not verified online in this offline round (-1); the reference JSON labels the script's own outputs as \"Honda & Fisher 1978 benchmarks\", so the provenance of the central benchmark curve is mis-stated at source (-3); no literature value exists for tier spacing vs latitude, stated honestly (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/dichotomous_tree_branching/dichotomous_tree_branching_reference.json L46–L103: Benchmark block named after Honda & Fisher (1978) but holding script-generated values <https://github.com/fractastical/morpholib/blob/028758bc/datasets/dichotomous_tree_branching/dichotomous_tree_branching_reference.json#L46-L103>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-source-traceability-4> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 051 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


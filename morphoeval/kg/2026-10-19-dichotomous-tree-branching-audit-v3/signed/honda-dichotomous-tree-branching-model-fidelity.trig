sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-honda-dichotomous-tree-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Honda (1971) J. Theor. Biol. & Honda & Fisher (1978) Science 3D recursive dichotomous tree branching, effective leaf area optimization, Leonardo da Vinci pipe-model area conservation, and solar-elevation ray tracing of tiered crowns vs latitude — Model fidelity to source: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Honda (1971) 3D local orthonormal frame rotation recursion (`_honda_local_frame`, `grow_honda_1971_3d_tree`, L129-261), 4-archetype 3D crown morphospace (L263-292), Honda & Fisher (1978) 5-whorl disk-union effective leaf area functional and 2D (theta_1, theta_2) optimization surface (L294-470) and Leonardo/Shinozaki pipe-model tapering are unchanged from v2 and correct. Pass 3 adds the Campbell & Norman (1998) solar geometry (`solar_elevation_azimuth`, L503-521; day length L524-528), Cooper (1969) declination (L498-500), transmittance-weighted diurnal sun paths (L531-563), a stacked tiered crown (L566-610), tier-to-tier shadow ray tracing with Beer-Lambert tau_c^n (L643-692) and the latitude x spacing sweep (L695-764), backed by 5 Lean 4 theorems (0 sorrys). Deductions: the ray-traced crown is a stack of planar disk-union tiers with uniform tau_c, not the 3D Honda internode skeleton (`grow_honda_1971_3d_tree` is never passed to the ray tracer) (-3); direct beam only, no diffuse sky radiance, leaf scattering or penumbra (-2); the 3D builder's pitch factors 0.25*t1 / -0.18*t2 (L221-222) and the daughter-2 extra pi/2 roll (L239) are not in Honda (1971) and are uncited (-2); the tier-order schedule max(2, 5 - 4t//n) (L586) is a modelling choice (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1976-honda-dichotomous-tree-branching.py L221–L239: Uncited pitch factors 0.25*t1 / -0.18*t2 and extra pi/2 roll on daughter 2 in the Honda (1971) 3D builder <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L221-L239>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-6> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1976-honda-dichotomous-tree-branching.py L129–L292" ;
        dcterms:description "Honda (1971) 3D local orthonormal basis rotation, Leonardo pipe-model diameter conservation, and 4 crown archetypes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L129-L292> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1976-honda-dichotomous-tree-branching.py L294–L470" ;
        dcterms:description "Honda & Fisher (1978) 5-whorl planar tier builder, 2D disk-union effective leaf area integral, and (theta_1, theta_2) optimization surface" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L294-L470> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "1976-honda-dichotomous-tree-branching.py L498–L563" ;
        dcterms:description "Pass 3: Cooper (1969) declination, Campbell & Norman (1998) solar elevation/azimuth and day length, 12 x hourly diurnal sun-path samples weighted by tau_atm^(1/sin h) sin h" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L498-L563> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "1976-honda-dichotomous-tree-branching.py L566–L692" ;
        dcterms:description "Pass 3: stacked Honda & Fisher tiered crown, tier mask rasterisation, integer-pixel shadow shift by dz cot h toward the anti-solar azimuth, Beer-Lambert tau_c^n per overlap count" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L566-L692> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "1976-honda-dichotomous-tree-branching.py L695–L764" ;
        dcterms:description "Pass 3: latitude x spacing trade-off sweep with parameter-free s_90 saturation spacing and kappa stem-cost optima" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L695-L764> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-6> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_051_dichotomous_tree_branching.lean L26–L198" ;
        dcterms:description "5 machine-checked Lean 4 theorems: tip doubling, Leonardo area invariance, divergence self-shading avoidance, solar shadow-offset monotonicity (L144-166), stacked Beer-Lambert optical depth (L181-198); 0 sorrys" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_051_dichotomous_tree_branching.lean#L26-L198> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 051 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


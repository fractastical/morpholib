<https://w3id.org/probknow/resource/evidence/2026-10-19-dichotomous-tree-branching-audit-v3-honda-dichotomous-tree-branching-10> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "equatorial (0°) saturation tier spacing s_90 / R_tier for 90% annual beam light capture" ;

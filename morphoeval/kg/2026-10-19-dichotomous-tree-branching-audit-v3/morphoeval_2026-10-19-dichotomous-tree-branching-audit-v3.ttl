<https://w3id.org/probknow/resource/math-law/honda-dichotomous-tree-branching-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Honda (1971) Binary Dichotomous Tip Doubling & Total Internode Geometric Sum" ;
    dct:description "Governs exponential expansion of terminal leaf-cluster tips and total woody internode count across recursive dichotomous branching generations | Variables: k: branching generation order (0 = trunk); N_tips(k): number of terminal leaf-bearing twigs at order k; N_total(k): cumulative woody internodes across orders 0..k" ;
    dct:source "Honda (1971) J. Theor. Biol. 31(2):331-338" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L129-L291>,
        <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_051_dichotomous_tree_branching.lean#L25-L45> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def honda_tips : Nat → Nat
  | 0 => 1
  | k + 1 => 2 * honda_tips k
def honda_total_internodes : Nat → Nat
  | 0 => 1
  | k + 1 => honda_total_internodes k + honda_tips (k + 1)
theorem honda_1971_dichotomous_tip_and_internode_identity (k : Nat) :
    honda_tips (k + 1) = 2 * honda_tips k ∧
    honda_total_internodes k + 1 = 2 * honda_tips k := by
  refine ⟨rfl, ?_⟩
  induction k with
  | zero => rfl
  | succ n ih => dsimp [honda_total_internodes, honda_tips]; omega
"""^^pk:lean4 ;
    skos:notation "N_tips(k+1) = 2 N_tips(k) = 2^{k+1},   N_total(k) = ∑_{j=0}^k 2^j = 2^{k+1} - 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/j.1537-2197.1979.tb06267.x>,
        <https://doi.org/10.1007/978-1-4612-1626-1>,
        <https://doi.org/10.1016/0022-5193(71)90031-2>,
        <https://doi.org/10.1016/0038-092X(69)90047-4>,
        <https://doi.org/10.1093/aob/mci052>,
        <https://doi.org/10.1103/PhysRevLett.107.258101>,
        <https://doi.org/10.1126/science.199.4331.888>,
        <https://doi.org/10.18960/seitai.14.3_97> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "3D Recursive Dichotomous Tree Vector Rotation, Effective Canopy Leaf Area Optimization & Leonardo da Vinci Pipe-Model Area Conservation" ;
    pk:leanDeclaration "MathOfBiology.Loop_051.honda_tips" ;
    pk:leanTheorem "MathOfBiology.Loop_051.honda_1971_dichotomous_tip_and_internode_identity" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/honda-dichotomous-tree-branching-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Leonardo da Vinci / Shinozaki (1964) / Eloy (2011) Pipe-Model Cross-Sectional Area Invariance" ;
    dct:description "Conserves total vascular sapwood cross-sectional area across every dichotomous fork and insures uniform wind-induced bending stress across self-similar tree crowns | Variables: d_parent: mother internode diameter; d_1, d_2: daughter branch diameters; Δ ≈ 2.0: Leonardo/Shinozaki sapwood area exponent" ;
    dct:source "Shinozaki et al. (1964) Jpn. J. Ecol. 14(3):97-105; Eloy (2011) Phys. Rev. Lett. 107(25):258101" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L150-L261>,
        <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_051_dichotomous_tree_branching.lean#L59-L72> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def pipe_area_sq (d : Int) : Int := d * d
theorem leonardo_shinozaki_pipe_area_invariance
    (a0 a1 a2 a11 a12 a21 a22 d : Int)
    (h_gen1 : a0 = a1 + a2) (h_left : a1 = a11 + a12) (h_right : a2 = a21 + a22) :
    a11 + a12 + a21 + a22 = a0 ∧
    pipe_area_sq d + pipe_area_sq d = 2 * pipe_area_sq d := by
  refine ⟨?_, ?_⟩
  · omega
  · dsimp [pipe_area_sq]; omega
"""^^pk:lean4 ;
    skos:notation "d_parent^Δ = d_1^Δ + d_2^Δ  (Δ = 2) ⟹ ∑_{i=1}^{2^k} d_{k,i}^2 = d_trunk^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/j.1537-2197.1979.tb06267.x>,
        <https://doi.org/10.1007/978-1-4612-1626-1>,
        <https://doi.org/10.1016/0022-5193(71)90031-2>,
        <https://doi.org/10.1016/0038-092X(69)90047-4>,
        <https://doi.org/10.1093/aob/mci052>,
        <https://doi.org/10.1103/PhysRevLett.107.258101>,
        <https://doi.org/10.1126/science.199.4331.888>,
        <https://doi.org/10.18960/seitai.14.3_97> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "3D Recursive Dichotomous Tree Vector Rotation, Effective Canopy Leaf Area Optimization & Leonardo da Vinci Pipe-Model Area Conservation" ;
    pk:leanDeclaration "MathOfBiology.Loop_051.pipe_area_sq" ;
    pk:leanTheorem "MathOfBiology.Loop_051.leonardo_shinozaki_pipe_area_invariance" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/honda-dichotomous-tree-branching-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Honda & Fisher (1978) Daughter Divergence Angle Separation & Self-Shading Avoidance Law" ;
    dct:description "Proves that non-zero asymmetric daughter divergence angles (θ_1 ≈ 26-30°, θ_2 ≈ 56-60° in Cornus controversa and Terminalia catappa) prevent terminal leaf-cluster superposition and maximize light interception | Variables: θ_1, θ_2: sister branch divergence angles from parent internode axis; L_1 = r_1 L_0, L_2 = r_2 L_0: sister internode lengths; A_eff / A_total: projected non-overlapping effective leaf area ratio" ;
    dct:source "Honda & Fisher (1978) Science 199(4331):888-890; Fisher & Honda (1979) Am. J. Bot. 66(6):633-644" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L294-L470>,
        <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_051_dichotomous_tree_branching.lean#L90-L127> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def sister_tip_transverse_sep (L1 L2 sin_theta1 sin_theta2 : Int) : Int :=
  L1 * sin_theta1 + L2 * sin_theta2
def sister_pair_effective_area (A_cluster c_sep sep : Int) : Int :=
  A_cluster + c_sep * sep
theorem honda_fisher_1978_divergence_avoids_self_shading
    (L1 L2 sin_theta1 sin_theta2 A_cluster c_sep : Int)
    (hL1 : 0 < L1) (hL2 : 0 < L2) (ht1 : 0 < sin_theta1) (ht2 : 0 < sin_theta2)
    (hA : 0 < A_cluster) (hc : 0 < c_sep) :
    sister_tip_transverse_sep L1 L2 0 0 = 0 ∧
    0 < sister_tip_transverse_sep L1 L2 sin_theta1 sin_theta2 := by
  refine ⟨by dsimp [sister_tip_transverse_sep]; omega, ?_⟩
  dsimp [sister_tip_transverse_sep]
  have h1 : 0 < L1 * sin_theta1 := Int.mul_pos hL1 ht1
  have h2 : 0 < L2 * sin_theta2 := Int.mul_pos hL2 ht2
  omega
"""^^pk:lean4 ;
    skos:notation "(θ_1, θ_2)^* = argmax_{(θ_1, θ_2)} A_eff(θ_1, θ_2) / A_total,   A_eff(0, 0) ≪ A_eff(θ_1^*, θ_2^*)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/j.1537-2197.1979.tb06267.x>,
        <https://doi.org/10.1007/978-1-4612-1626-1>,
        <https://doi.org/10.1016/0022-5193(71)90031-2>,
        <https://doi.org/10.1016/0038-092X(69)90047-4>,
        <https://doi.org/10.1093/aob/mci052>,
        <https://doi.org/10.1103/PhysRevLett.107.258101>,
        <https://doi.org/10.1126/science.199.4331.888>,
        <https://doi.org/10.18960/seitai.14.3_97> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "3D Recursive Dichotomous Tree Vector Rotation, Effective Canopy Leaf Area Optimization & Leonardo da Vinci Pipe-Model Area Conservation" ;
    pk:leanDeclaration "MathOfBiology.Loop_051.sister_tip_transverse_sep" ;
    pk:leanTheorem "MathOfBiology.Loop_051.honda_fisher_1978_divergence_avoids_self_shading" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/honda-dichotomous-tree-branching-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Pass 3 — Solar-Elevation Tier Shadow Displacement & Latitude-Dependent Tier Spacing Threshold" ;
    dct:description "Governs tier-on-tier self-shading in the Pass 3 ray tracer: lower (temperate) sun displaces upper-tier shadows further, so the spacing needed to clear self-shading is largest under a high equatorial sun (ray-traced s_90/R = 1.83 at 0° vs 0.97 at 45°) | Variables: Δz = s: vertical tier spacing; h: solar elevation (φ latitude, δ Cooper (1969) declination, H hour angle); R: tier radius; offset: horizontal displacement of the upper tier's shadow on the lower tier plane" ;
    dct:source "Campbell & Norman (1998) An Introduction to Environmental Biophysics, Ch. 11 (DOI 10.1007/978-1-4612-1626-1); Cooper (1969) Solar Energy 12(3):333-346" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L473-L785>,
        <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_051_dichotomous_tree_branching.lean#L130-L166> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def tier_shadow_offset (dz cot_h : Int) : Int := dz * cot_h
def tiers_shadow_clear (dz cot_h R : Int) : Prop := 2 * R ≤ tier_shadow_offset dz cot_h
theorem solar_tier_shadow_offset_monotone
    (dz k cot_lo cot_hi R : Int) (hdz : 0 ≤ dz) (hcot : cot_lo ≤ cot_hi) :
    tier_shadow_offset (k * dz) cot_lo = k * tier_shadow_offset dz cot_lo ∧
    tier_shadow_offset dz cot_lo ≤ tier_shadow_offset dz cot_hi ∧
    (tiers_shadow_clear dz cot_lo R → tiers_shadow_clear dz cot_hi R) := by
  refine ⟨?_, ?_, ?_⟩
  · dsimp [tier_shadow_offset]; exact Int.mul_assoc k dz cot_lo
  · dsimp [tier_shadow_offset]; exact Int.mul_le_mul_of_nonneg_left hcot hdz
  · intro hclear
    dsimp [tiers_shadow_clear, tier_shadow_offset] at hclear ⊢
    have hmono : dz * cot_lo ≤ dz * cot_hi := Int.mul_le_mul_of_nonneg_left hcot hdz
    omega
"""^^pk:lean4 ;
    skos:notation "offset(Δz, h) = Δz·cot h;  tiers clear ⟺ 2R ≤ Δz·cot h;  sin h = sin φ sin δ + cos φ cos δ cos H;  cot_lo ≤ cot_hi ⟹ clear(Δz, cot_lo) → clear(Δz, cot_hi)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/j.1537-2197.1979.tb06267.x>,
        <https://doi.org/10.1007/978-1-4612-1626-1>,
        <https://doi.org/10.1016/0022-5193(71)90031-2>,
        <https://doi.org/10.1016/0038-092X(69)90047-4>,
        <https://doi.org/10.1093/aob/mci052>,
        <https://doi.org/10.1103/PhysRevLett.107.258101>,
        <https://doi.org/10.1126/science.199.4331.888>,
        <https://doi.org/10.18960/seitai.14.3_97> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "3D Recursive Dichotomous Tree Vector Rotation, Effective Canopy Leaf Area Optimization & Leonardo da Vinci Pipe-Model Area Conservation" ;
    pk:leanDeclaration "MathOfBiology.Loop_051.tier_shadow_offset" ;
    pk:leanTheorem "MathOfBiology.Loop_051.solar_tier_shadow_offset_monotone" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/honda-dichotomous-tree-branching-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Pass 3 — Monsi & Saeki (1953) Beer-Lambert Optical Depth Through Stacked Tiers" ;
    dct:description "Attenuates the direct beam through every intercepted tier in ray_trace_tiered_crown_interception; the τ_c = 1 transparent ablation must return crown capture efficiency E = 1 exactly (self-test suite 8) | Variables: n: number of upper tiers overlapping a lower-tier cell along the beam; τ_c = exp(-LAI_c) = 0.135 per-tier beam transmittance (LAI_c = 2); K = 1 extinction coefficient for horizontal leaves" ;
    dct:source "Monsi & Saeki (1953) Jpn. J. Bot. 14:22-52 (English translation Ann. Bot. 95(3):549-567, 2005, DOI 10.1093/aob/mci052)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L643-L693>,
        <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_051_dichotomous_tree_branching.lean#L169-L198> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def stacked_tier_optical_depth (d : Nat) : Nat → Nat
  | 0 => 0
  | n + 1 => stacked_tier_optical_depth d n + d
theorem beer_lambert_stacked_tier_optical_depth (d n : Nat) :
    stacked_tier_optical_depth d (n + 1) = stacked_tier_optical_depth d n + d ∧
    (0 < d → stacked_tier_optical_depth d n < stacked_tier_optical_depth d (n + 1)) ∧
    stacked_tier_optical_depth 0 n = 0 := by
  refine ⟨rfl, ?_, ?_⟩
  · intro hd; dsimp [stacked_tier_optical_depth]; omega
  · induction n with
    | zero => rfl
    | succ m ih => dsimp [stacked_tier_optical_depth]; omega
"""^^pk:lean4 ;
    skos:notation "I_n / I_0 = τ_c^n = exp(-n K LAI_c),  K = 1 (horizontal leaves);  depth(n+1) = depth(n) + K·LAI_c;  depth(n) = 0 when τ_c = 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/j.1537-2197.1979.tb06267.x>,
        <https://doi.org/10.1007/978-1-4612-1626-1>,
        <https://doi.org/10.1016/0022-5193(71)90031-2>,
        <https://doi.org/10.1016/0038-092X(69)90047-4>,
        <https://doi.org/10.1093/aob/mci052>,
        <https://doi.org/10.1103/PhysRevLett.107.258101>,
        <https://doi.org/10.1126/science.199.4331.888>,
        <https://doi.org/10.18960/seitai.14.3_97> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "3D Recursive Dichotomous Tree Vector Rotation, Effective Canopy Leaf Area Optimization & Leonardo da Vinci Pipe-Model Area Conservation" ;
    pk:leanDeclaration "MathOfBiology.Loop_051.stacked_tier_optical_depth" ;
    pk:leanTheorem "MathOfBiology.Loop_051.beer_lambert_stacked_tier_optical_depth" ;
    pk:leanVerified true .


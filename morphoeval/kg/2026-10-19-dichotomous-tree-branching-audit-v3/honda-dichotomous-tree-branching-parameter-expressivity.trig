sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-honda-dichotomous-tree-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Honda (1971) J. Theor. Biol. & Honda & Fisher (1978) Science 3D recursive dichotomous tree branching, effective leaf area optimization, Leonardo da Vinci pipe-model area conservation, and solar-elevation ray tracing of tiered crowns vs latitude — Parameter expressivity: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Sweeps the 14x14 (theta_1, theta_2) space plus 8 benchmark regimes (L404-470), 4 crown archetypes and 3 tapering laws as in v2, and Pass 3 adds a 6-latitude x 14-spacing sweep with 3 stem-cost kappa values (L695-764), a tau_c ablation (transparent vs opaque tiers), and new CLI flags `--tiers`, `--tau-cluster`, `--latitudes` (L1850-1852) beside `--theta1/--theta2/--r1/--r2/--orders` (L1845-1849). Deductions: all CLI flags affect only rendering — `measure_morphoeval()` hard-codes the default sweep, so the measurements cannot be re-run under a user-chosen parameterisation (-4); `--latitudes` silently appends Meise (L1866-1868) (-1); the kappa optima are the argmax on the 14-point spacing grid, so Panel D's kappa curves are coarse (-2); kappa itself is a free sensitivity parameter with no literature value (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1976-honda-dichotomous-tree-branching.py L1864–L1868: CLI flags feed only render_solar_artifacts; measure_morphoeval() uses hard-coded defaults; --latitudes silently appends Meise <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L1864-L1868>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-parameter-expressivity-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1976-honda-dichotomous-tree-branching.py L263–L470" ;
        dct:description "4-archetype 3D morphospace and 14x14 2D (theta_1, theta_2) effective leaf area optimization grid" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L263-L470> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1976-honda-dichotomous-tree-branching.py L695–L783" ;
        dct:description "Pass 3: latitude x spacing x kappa trade-off sweep with interpolated efficiency and marginal light gain helpers" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L695-L783> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "1976-honda-dichotomous-tree-branching.py L1845–L1852" ;
        dct:description "CLI overrides for theta1, theta2, r1, r2, orders, tiers, tau-cluster, latitudes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L1845-L1852> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 051 Pass 3 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


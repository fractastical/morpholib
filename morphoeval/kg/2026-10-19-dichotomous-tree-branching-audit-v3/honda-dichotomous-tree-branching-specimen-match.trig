sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-honda-dichotomous-tree-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Honda (1971) J. Theor. Biol. & Honda & Fisher (1978) Science 3D recursive dichotomous tree branching, effective leaf area optimization, Leonardo da Vinci pipe-model area conservation, and solar-elevation ray tracing of tiered crowns vs latitude — Morphological realism / specimen match: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the Botanic Garden Meise Pagoda Dogwood specimen (960x1280 px), segments variegated foliage shelves and detects 7 horizontal pagoda tiers and 25 Y-bifurcations (`segment_cornus_controversa_specimen`, L829-969), and Pass 3 adds the specimen's inter-tier spacing / tier half-width s/R = 0.376 +- 0.134 over 6 tier pairs (`measure_specimen_tier_spacing`, L786-824) which is overlaid as a band on the E(s/R) curves and as a tier-spacing overlay panel in the new solar figure. The specimen is compared with the model in both PNGs. Deductions: the junction acceptance windows 12-50 deg / 30-82 deg and beta in [0.65, 1.45] (L933-935) pre-filter the Y-fork statistics toward the Honda & Fisher range, so theta_1 = 22.40, theta_2 = 50.93 and beta = 0.9533 are partially prescribed (-4); ROI box, foliage percentile 72 and wood percentile 78 (L843, L850, L871) are hand-tuned to this one image (-2); the s/R ratio is a projected photographic quantity without perspective or tilt correction, and the foliage column-density threshold 0.15 and +-12 px band (L786-801) are unsourced (-2); the specimen reference values the measurements are compared against are regressions of this script's own earlier output (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1976-honda-dichotomous-tree-branching.py L933–L935: Junction acceptance windows 12-50 / 30-82 deg and beta in [0.65, 1.45] pre-select forks inside the expected Honda & Fisher range <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L933-L935>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-specimen-match-4> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1976-honda-dichotomous-tree-branching.py L829–L969" ;
        dct:description "Variegated foliage tier peak detection (7 tiers), dark-bark ridge EDT skeletonization, and 25-junction bifurcation angle and Leonardo ratio extraction" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L829-L969> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "1976-honda-dichotomous-tree-branching.py L786–L824" ;
        dct:description "Pass 3: specimen inter-tier spacing / lower-tier half-width from detected foliage shelves (6 pairs, projected, no perspective correction)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L786-L824> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/dichotomous_tree_branching_comparison.png (generated output)" ;
        dct:description "6-panel figure comparing 3D archetypes, 5-whorl tier canopy + collinear ablation, 2D (theta_1, theta_2) heatmap, pipe-model conservation, and Cornus controversa CV segmentation — docs/media/dichotomous_tree_branching_comparison.png: rendered output of 1976-honda-dichotomous-tree-branching.py at 028758bc, image/png, 2148088 B, 2475×1575 px, artifact_sha256 581f4f616734e5fca1c57a025888323716a41e79137972f0611843524777aceb (sha256 581f4f616734e5fca1c57a025888323716a41e79137972f0611843524777aceb), spec_fingerprint 7cfa8b501a15c214e965ecf451b63af5fa8b3bb7f3a5e144483628cccc87fe3b" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/dichotomous_tree_branching_solar_tier_spacing.png (generated output)" ;
        dct:description "Pass 3 6-panel figure: crown elevation with noon beams, E(s/R) by latitude with specimen band, diurnal sun paths, s_90 and kappa optima vs latitude, bottom-tier shadow-count map, specimen tier-spacing overlay — docs/media/dichotomous_tree_branching_solar_tier_spacing.png: rendered output of 1976-honda-dichotomous-tree-branching.py at 028758bc, image/png, 1346690 B, 2550×1575 px, artifact_sha256 ac615674ce532b344070315c3b4b8e925140a06ca8b037cd647f9b6fbdb5d2eb (sha256 ac615674ce532b344070315c3b4b8e925140a06ca8b037cd647f9b6fbdb5d2eb), spec_fingerprint 7cfa8b501a15c214e965ecf451b63af5fa8b3bb7f3a5e144483628cccc87fe3b" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 051 Pass 3 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


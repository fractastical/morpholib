    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-solar-geometry-check-geometric-june-solstice-day-length-at-meise-50-93-n-from-sampled-sun-path-reference> a schema:PropertyValue ;
        dct:source "Campbell & Norman (1998) Eq. 11.6 cos H_0 = -tan φ tan δ (analytic 16.31 h; geometric, no atmospheric refraction)" ;
        schema:value "16.31" .

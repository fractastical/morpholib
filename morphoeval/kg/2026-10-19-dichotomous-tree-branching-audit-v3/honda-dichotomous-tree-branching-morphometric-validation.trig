sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-honda-dichotomous-tree-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Honda (1971) J. Theor. Biol. & Honda & Fisher (1978) Science 3D recursive dichotomous tree branching, effective leaf area optimization, Leonardo da Vinci pipe-model area conservation, and solar-elevation ray tracing of tiered crowns vs latitude — Morphometric validation: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L971-1222) now returns 16 measurements with SDs, Pearson r, p-value, RMSE and ablation controls: the 9 v2 measurements plus Pass 3 equatorial and temperate s_90/R (1.8318, 0.9694), their ratio 1.8895 vs null 1.0, specimen s/R = 0.3764 +- 0.1342, E(specimen spacing) at Meise 0.7474 vs equator transplant 0.6214, a solar-geometry check (sampled June-solstice day length at Meise 16.2 h vs analytic 16.31 h) and the tau_c ablation 0.2822. Deductions, which drive the drop from 94: the Honda & Fisher benchmark values in `dichotomous_tree_branching_reference.json` (L46-103) are this script's own earlier outputs, so Pearson r = 0.9978 (measurement 1, L1011-1019), the Terminalia reference 0.7739 (L1025) and the 74.14% penalty reference (L1047) are self-referential rather than digitised from Honda & Fisher (1978) (-5); specimen tiers/theta_1/theta_2/beta references (L1073-1110) and the s/R reference (L1163-1172) are regressions of the script's CV output, flagged in-file but not independent (-3); measurements 10, 11 and 16 have `reference_value: None` (L1124, L1140, L1213), measurement 12 uses the null ratio and measurement 14 is model-vs-model (-3); archetype H/W references in the JSON (1.62, 0.74, 0.96, 0.68) are never compared against the rendered H/W (1.12, 0.45, 0.44, 0.53) (-1). The solar-geometry check against the analytic day length is the one genuinely external anchor added this round." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1976-honda-dichotomous-tree-branching.py L1124–L1213: Measurements 10, 11, 16 carry reference_value None; measurement 13 reference is a regression value computed by this script (L1171) <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L1124-L1213>",
            "datasets/dichotomous_tree_branching/dichotomous_tree_branching_reference.json L46–L103: honda_fisher_1978_angle_sweep_benchmarks values (0.2001, 0.7591, 0.7739, ...) are the script's own outputs, not digitised Honda & Fisher (1978) figure values; r = 0.9978 is self-referential <https://github.com/fractastical/morpholib/blob/028758bc/datasets/dichotomous_tree_branching/dichotomous_tree_branching_reference.json#L46-L103>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-collinear-zero-angle-ablation-self-shading-penalty-1-a-eff-0-0-a-eff-opt>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-equatorial-0-saturation-tier-spacing-s-90-r-tier-for-90-annual-beam-light-capture>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-equatorial-temperate-0-45-optimal-tier-spacing-ratio-s-90-0-s-90-45>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-honda-1971-6-order-cumulative-woody-internode-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-honda-fisher-1978-effective-leaf-area-curve-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-leonardo-da-vinci-shinozaki-pipe-model-cross-sectional-area-conservation-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-ray-traced-annual-beam-light-capture-e-of-the-specimen-s-tier-spacing-at-meise-50-93-n-vs-at-the-equator>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-solar-geometry-check-geometric-june-solstice-day-length-at-meise-50-93-n-from-sampled-sun-path>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-detected-horizontal-pagoda-crown-tiers>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-inter-tier-spacing-tier-radius-ratio-s-r-projected>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-leonardo-pipe-model-area-ratio-d-1-2-d-2-2-d-0-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-primary-branch-divergence-angle-theta-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-secondary-branch-divergence-angle-theta-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-temperate-45-saturation-tier-spacing-s-90-r-tier-for-90-annual-beam-light-capture>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-terminalia-catappa-optimal-effective-leaf-area-ratio-a-eff-a-total-30-60>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-tier-transmittance-ablation-e-c-1-transparent-tiers-e-c-0-opaque-tiers-at-the-specimen-spacing-meise>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-morphometric-validation-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-collinear-zero-angle-ablation-self-shading-penalty-1-a-eff-0-0-a-eff-opt> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "collinear zero-angle ablation self-shading penalty (1 - A_eff(0,0)/A_eff(opt)) = 74.14 %" ;
        dct:description "A_eff(0,0)/A_total = 0.2001 vs A_eff(30,60)/A_total = 0.7739" ;
        schema:measurementTechnique "Percentage loss of non-overlapping leaf area when daughter divergence angles collapse to theta_1 = theta_2 = 0 deg (Lean 4 theorem honda_fisher_1978_divergence_avoids_self_shading)" ;
        schema:name "collinear zero-angle ablation self-shading penalty (1 - A_eff(0,0)/A_eff(opt))" ;
        schema:unitText "%" ;
        schema:value "74.14" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-collinear-zero-angle-ablation-self-shading-penalty-1-a-eff-0-0-a-eff-opt-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-collinear-zero-angle-ablation-self-shading-penalty-1-a-eff-0-0-a-eff-opt-reference> a schema:PropertyValue ;
        dct:source "Honda & Fisher (1978) Science 199:888-890" ;
        schema:value "74.14" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-equatorial-0-saturation-tier-spacing-s-90-r-tier-for-90-annual-beam-light-capture> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equatorial (0°) saturation tier spacing s_90 / R_tier for 90% annual beam light capture = 1.8318 s/R_tier" ;
        dct:description "E(s/R) curve: [0.399, 0.446, 0.519, 0.585, 0.633, 0.707, 0.763, 0.804, 0.843, 0.875, 0.913, 0.94 , 0.958, 0.977] at s/R = [0.05, 0.1 , 0.2 , 0.3 , 0.4 , 0.6 , 0.8 , 1. , 1.25, 1.5 , 2. , 2.5 , 3. , 4. ]; beam-weighted mean solar elevation 55.83°" ;
        schema:measurementTechnique "Tier-to-tier shadow ray tracing (Δz·cot h displacement, Beer-Lambert τ_c = 0.135 per tier) of a 7-tier Honda & Fisher pagoda crown over 12 Cooper mid-month declinations x hourly sun positions; linear interpolation of E(s/R) at E = 0.90" ;
        schema:name "equatorial (0°) saturation tier spacing s_90 / R_tier for 90% annual beam light capture" ;
        schema:unitText "s/R_tier" ;
        schema:value "1.8318" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-equatorial-temperate-0-45-optimal-tier-spacing-ratio-s-90-0-s-90-45> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equatorial / temperate (0° / 45°) optimal tier spacing ratio s_90(0°) / s_90(45°) = 1.8895 ratio" ;
        dct:description "Prediction: equatorial pagoda crowns require ~1.89x wider tier spacing than temperate crowns for equal self-shading avoidance" ;
        schema:measurementTechnique "Ratio of interpolated E = 0.90 saturation spacings; stem-cost optima argmax_s [E(s) - κ s/R] for κ = 0.05/0.10/0.20: equator [2.5, 1.5, 1.0], 45° [1.5, 1.25, 0.8] (s/R)" ;
        schema:name "equatorial / temperate (0° / 45°) optimal tier spacing ratio s_90(0°) / s_90(45°)" ;
        schema:unitText "ratio" ;
        schema:value "1.8895" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-equatorial-temperate-0-45-optimal-tier-spacing-ratio-s-90-0-s-90-45-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-equatorial-temperate-0-45-optimal-tier-spacing-ratio-s-90-0-s-90-45-reference> a schema:PropertyValue ;
        dct:source "Null hypothesis of latitude-independent optimal tier spacing (ratio = 1.0); any value > 1 is the model's falsifiable prediction (Lean 4 theorem solar_tier_shadow_offset_monotone)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-honda-1971-6-order-cumulative-woody-internode-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Honda (1971) 6-order cumulative woody internode count = 127 internodes" ;
        dct:description "terminal tips at order k=6 = 64 (ref 64)" ;
        schema:measurementTechnique "Total dichotomous internodes sum_{j=0}^6 2^j = 2^7 - 1 (Lean 4 theorem honda_1971_dichotomous_tip_and_internode_identity)" ;
        schema:name "Honda (1971) 6-order cumulative woody internode count" ;
        schema:unitText "internodes" ;
        schema:value "127" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-honda-1971-6-order-cumulative-woody-internode-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-honda-1971-6-order-cumulative-woody-internode-count-reference> a schema:PropertyValue ;
        dct:source "Honda (1971) J. Theor. Biol. 31:331-338" ;
        schema:value "127" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-honda-fisher-1978-effective-leaf-area-curve-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Honda & Fisher (1978) effective leaf area curve Pearson correlation r = 0.997822 r" ;
        dct:description "p = 2.58e-08, RMSE = 0.0128 across 8 benchmark regimes" ;
        schema:measurementTechnique "Pearson correlation across 8 branching angle regimes from collinear (0, 0) to back-folding (75, 95) deg" ;
        schema:name "Honda & Fisher (1978) effective leaf area curve Pearson correlation r" ;
        schema:unitText "r" ;
        schema:value "0.997822" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-honda-fisher-1978-effective-leaf-area-curve-pearson-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-honda-fisher-1978-effective-leaf-area-curve-pearson-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Honda & Fisher (1978) Science 199:888-890; Fisher & Honda (1979) Am. J. Bot. 66:633" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-leonardo-da-vinci-shinozaki-pipe-model-cross-sectional-area-conservation-ratio> a schema:PropertyValue,

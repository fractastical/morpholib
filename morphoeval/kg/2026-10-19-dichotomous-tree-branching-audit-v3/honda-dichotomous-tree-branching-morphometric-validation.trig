        dct:description "Meise E = 0.7474 vs equator E = 0.6214 (Δ = 12.6 percentage points); implied marginal stem cost at the specimen's spacing κ* = dE/d(s/R) = 0.526" ;
        schema:measurementTechnique "E(s/R = 0.376) interpolated from the ray-traced capture curve at latitude 50.93° (Botanic Garden Meise, specimen provenance)" ;
        schema:name "ray-traced annual beam light capture E of the specimen's tier spacing at Meise (50.93°N) vs at the equator" ;
        schema:unitText "ratio" ;
        schema:value "0.7474" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-ray-traced-annual-beam-light-capture-e-of-the-specimen-s-tier-spacing-at-meise-50-93-n-vs-at-the-equator-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-ray-traced-annual-beam-light-capture-e-of-the-specimen-s-tier-spacing-at-meise-50-93-n-vs-at-the-equator-reference> a schema:PropertyValue ;

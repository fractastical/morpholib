sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Sick et al. (2006) & Andl et al. (2002) WNT/DKK reaction-diffusion hair follicle spacing, secondary wave insertion & transgenic phenotypes — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Faithfully implements Sick et al. (2006) saturating Meinhardt-Gierer WNT/DKK activator-inhibitor PDEs with exact unsaturated steady state (w_* = 1.5, h_* = 2.25), reaction Jacobian J_0 (tr = -0.01 < 0, det = +0.0006 > 0), critical diffusivity ratio d_c = (sqrt(2)+1)^2 = 5.828427, 1D primary wave -> 2x epidermal expansion -> secondary inter-follicular wave insertion (Figs. 3-4, L288-340, 4 -> 8 peaks), and 2D Wild-Type, K14-Wnt overexpression, saturated enlarged/ringing, Dkk1 blockade, and equal-diffusion control regimes (L456-515). Backed by 3 machine-checked Lean 4 theorems in `Loop_006_wnt_dkk_hair_follicle.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L125–L206" ;
        dct:description "Exact WNT/DKK steady state, Jacobian J_0, d_c = (sqrt(2)+1)^2, and linear dispersion sigma(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L125-L206> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L288–L515" ;
        dct:description "Primary -> 2x expansion -> secondary inter-follicular wave insertion and 2D WT/K14-Wnt++/enlarged/Dkk1++/equal-diffusion suite" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L288-L515> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_006_wnt_dkk_hair_follicle.lean L12–L83" ;
        dct:description "3 machine-checked Lean 4 theorems (0 sorrys) for WNT/DKK equilibrium, equal-diffusion stability, and follicle spacing instability" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/morphoeval/lean/loops/Loop_006_wnt_dkk_hair_follicle.lean#L12-L83> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Sick et al. (2006) & Andl et al. (2002) WNT/DKK reaction-diffusion hair follicle spacing, secondary wave insertion & transgenic phenotypes — Reproducibility package: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Deterministic RNG (`seed=2006`), 8-check `self_test()` suite (L829-889) verifying SHA-256 locks, JSON parameter parity, Jacobian/dispersion signs, 4 -> 8 primary-to-secondary inter-follicular wave insertion, 2D WT (16) vs K14-Wnt++ (32) vs enlarged (+45% area) vs Dkk1++ (0) vs equal-diffusion control (0), ectopic Dkk1 dosage sweep, domain scaling r >= 0.98, 16-placode specimen segmentation, and bitwise two-run determinism, plus 30-frame animated GIF at `docs/media/wnt_dkk_hair_follicle_growth.gif`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-repro-package-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L829–L889" ;
        dcterms:description "Comprehensive 8-check self_test() suite including SHA-256 locks, secondary wave doubling, transgenic phenotypes, and bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L829-L889> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/wnt_dkk_hair_follicle_growth.gif (generated output)" ;
        dcterms:description "30-frame animated GIF of Phase 1 primary placode wave + 2D epidermal formation and Phase 2 inter-follicular secondary wave insertion — docs/media/wnt_dkk_hair_follicle_growth.gif: rendered output of 2002-sick-wnt-dkk-hair-follicle.py at 3cb5ea9, image/gif, 886582 B, 792×342 px, 30 frames, artifact_sha256 8a98d4e25cf40ec0d5680f1a2340dc6284b80982cbf8755518c725b2004678e2 (sha256 8a98d4e25cf40ec0d5680f1a2340dc6284b80982cbf8755518c725b2004678e2), spec_fingerprint b199744003e12310e28662e653c933212ba7a7794558fe627f0cafadb3ab526e" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


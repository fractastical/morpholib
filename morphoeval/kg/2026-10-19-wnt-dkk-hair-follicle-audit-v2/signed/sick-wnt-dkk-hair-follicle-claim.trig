sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> a pk:Claim ;
        rdfs:label "Sick et al. (2006) & Andl et al. (2002) WNT/DKK reaction-diffusion hair follicle spacing, secondary wave insertion & transgenic phenotypes faithfully reproduces Embryonic mouse (Mus musculus) epidermal hair follicle placode lattice, inter-follicular secondary wave insertion & K14-Wnt/Dkk1 transgenic phenotypes morphology" ;
        dcterms:description "The simulation script(s) 2002-sick-wnt-dkk-hair-follicle.py implement the cited source model as published and produce forms that match real Embryonic mouse (Mus musculus) epidermal hair follicle placode lattice, inter-follicular secondary wave insertion & K14-Wnt/Dkk1 transgenic phenotypes specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 92.2/100, audit 2026-10-19-wnt-dkk-hair-follicle-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py; output: docs/media/wnt_dkk_hair_follicle_comparison.png; organism: Embryonic mouse (Mus musculus) epidermal hair follicle placode lattice, inter-follicular secondary wave insertion & K14-Wnt/Dkk1 transgenic phenotypes; checkpoint commit: https://github.com/fractastical/morpholib/commit/3cb5ea9; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: b199744003e12310e28662e653c933212ba7a7794558fe627f0cafadb3ab526e; artifact_sha256: 0fda4446cf9f1dbec59986ac22e8d05c70c4270ab8dfcd35bdb3ffe6fea47573; input_dataset_sha256: {datasets/wnt_dkk_hair_follicle/hair_follicle_placode_specimen.jpg=f48a7d76ae5984e5..., datasets/wnt_dkk_hair_follicle/paper_citations.bib=473c1747b6bcb451..., datasets/wnt_dkk_hair_follicle/scout_manifest.json=39fe775496e89c51..., datasets/wnt_dkk_hair_follicle/wnt_dkk_hair_follicle_reference.json=81d2042bc833768a...}; supersedes_audit_id: 2026-10-19-wnt-dkk-hair-follicle-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/S1534-5807(02)00167-3>,
            <https://doi.org/10.1126/science.1130088>,
            <https://doi.org/10.1186/1471-213X-4-4> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-specimen-match> ;
        pk:weightOfEvidence "0.922"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py> a schema:SoftwareSourceCode ;

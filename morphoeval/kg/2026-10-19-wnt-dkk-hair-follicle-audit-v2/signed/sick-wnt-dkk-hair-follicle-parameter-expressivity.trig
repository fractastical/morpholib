sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L343–L376" ;
        dcterms:description "7-point allometric epidermal domain-length scaling sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L343-L376> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L456–L515" ;
        dcterms:description "5-genotype 2D suite and 6-point ectopic Dkk1 dosage sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L456-L515> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Sick et al. (2006) & Andl et al. (2002) WNT/DKK reaction-diffusion hair follicle spacing, secondary wave insertion & transgenic phenotypes — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Executes a 6-point ectopic Dkk1 dosage sweep across rho_h in {0.0, 0.004, 0.010, 0.020, 0.050, 0.120} demonstrating monotonic placode suppression to 0 (L500-513, Panel C2), a 7-point allometric domain-length sweep across L in {20, 30, 40, 50, 60, 70, 80} cells (L343-376, Panel C3), 5 distinct 2D genotype/control regimes, and exposes CLI flags `--cw`, `--ch`, `--mu-w`, `--mu-h`, `--Dw`, `--Dh`, `--seed`, `--skip-gif`, and `--self-test` (L892-922)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Sick et al. (2006) & Andl et al. (2002) WNT/DKK reaction-diffusion hair follicle spacing, secondary wave insertion & transgenic phenotypes — Morphometric validation: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L741-824) computes 7 quantitative morphometrics with literature/specimen reference values, uncertainty statistics (CV, std, RMSE, Pearson r), and negative-control delta: d_c = 5.8284 (ref 5.8284), w_* = 1.5 (ref 1.5), secondary inter-follicular wave doubling ratio 2.0 (ref 2.0, 4 -> 8 peaks, CV = 0.0354), 2D Wild-Type placode count 16 vs segmented Mus musculus specimen 16 placodes (PDE NN CV = 0.3062 vs specimen NN CV = 0.3234), K14-Wnt++ overexpression density ratio 2.0 (32 vs 16 placodes; saturated regime +45.0% placode area), Dkk1++ blockade + equal-diffusion control placode count 0 (ref 0, std = 3.60e-6), and domain scaling r = 0.9846 (RMSE = 0.3545 peaks)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-allometric-epidermal-domain-length-scaling-correlation-r-l-n-peaks>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-secondary-inter-follicular-wave-placode-doubling-ratio-upon-2x-epidermal-expansion>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-transgenic-dkk1-overexpression-blockade-equal-diffusion-negative-control-placode-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-transgenic-k14-wnt-overexpression-vs-wild-type-placode-density-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-unsaturated-steady-state-wnt-activator-concentration-w>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wild-type-2d-hair-follicle-placode-count-vs-mus-musculus-in-situ-specimen-panel-b>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wnt-dkk-critical-diffusivity-ratio-d-c-sqrt-2-1-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-morphometric-validation-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-allometric-epidermal-domain-length-scaling-correlation-r-l-n-peaks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Allometric epidermal domain-length scaling correlation r(L, N_peaks) = 0.9846 Pearson r" ;
        dcterms:description "placode counts [2, 3, 4, 5, 5, 7, 8] across L=[20, 30, 40, 50, 60, 70, 80]; mean nonlinear wavelength = 10.29 cells, RMSE = 0.3429 peaks" ;
        schema:measurementTechnique "Linear correlation between epidermal transect length L in [20..80] cells and placode count N_peaks(L)" ;
        schema:name "Allometric epidermal domain-length scaling correlation r(L, N_peaks)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9846" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-allometric-epidermal-domain-length-scaling-correlation-r-l-n-peaks-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-allometric-epidermal-domain-length-scaling-correlation-r-l-n-peaks-reference> a schema:PropertyValue ;
        dcterms:source "Sick et al. (2006) Science 314:1447-1450 intrinsic reaction-diffusion wavelength invariance" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-secondary-inter-follicular-wave-placode-doubling-ratio-upon-2x-epidermal-expansion> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Secondary inter-follicular wave placode doubling ratio upon 2x epidermal expansion = 2.0 N_secondary / N_primary" ;
        dcterms:description "primary wave forms 4 peaks (CV=0.0707) -> 2x expanded epidermis inserts 4 midpoint secondary placodes to reach 8 peaks (spacing 10.00 ± 0.50 cells, CV=0.0500)" ;
        schema:measurementTechnique "1D periodic WNT/DKK PDE expanded 2x from N_1=40 (E14.5 primary wave) to N_2=80 (E16.5 secondary inter-follicular insertion)" ;
        schema:name "Secondary inter-follicular wave placode doubling ratio upon 2x epidermal expansion" ;
        schema:unitText "N_secondary / N_primary" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-secondary-inter-follicular-wave-placode-doubling-ratio-upon-2x-epidermal-expansion-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-secondary-inter-follicular-wave-placode-doubling-ratio-upon-2x-epidermal-expansion-reference> a schema:PropertyValue ;
        dcterms:source "Sick et al. (2006) Science 314:1447-1450 Figs. 3-4 (inter-follicular secondary wave insertion)" ;
        schema:value "2.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-transgenic-dkk1-overexpression-blockade-equal-diffusion-negative-control-placode-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Transgenic Dkk1 overexpression blockade & equal-diffusion negative control placode count = 0 placodes" ;
        dcterms:description "Dkk1++ blockade clamps w_max = 0.0517 (0 placodes, std = 1.80e-12); equal-diffusion control forms 0 placodes (std = 2.87e-07) vs 16 WT placodes" ;
        schema:measurementTechnique "2D WNT/DKK PDE under ectopic Dkk1 overexpression (rho_h=0.12) and equal-diffusion control (D_w=D_h=0.015)" ;
        schema:name "Transgenic Dkk1 overexpression blockade & equal-diffusion negative control placode count" ;
        schema:unitText "placodes" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-transgenic-dkk1-overexpression-blockade-equal-diffusion-negative-control-placode-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-transgenic-dkk1-overexpression-blockade-equal-diffusion-negative-control-placode-count-reference> a schema:PropertyValue ;
        dcterms:source "Andl et al. (2002) Dev. Cell 2:643-653 & Sick et al. (2006) Fig. 4 (Dkk1 alopecia blockade) + Lean 4 wnt_dkk_equal_diffusion_stable" ;
        schema:value "0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-transgenic-k14-wnt-overexpression-vs-wild-type-placode-density-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Transgenic K14-Wnt overexpression vs Wild-Type placode density ratio = 2.0 N_Wnt++ / N_WT" ;
        dcterms:description "K14-Wnt++ doubles placode count from 16 to 32 (2.0x) and reduces mean nearest-neighbor spacing from 8.66 px to 5.19 px; saturated regime increases mean placode area from 23.50 to 31.00 px^2 (+45.0%)" ;
        schema:measurementTechnique "Ratio of 2D placode count under elevated K14-Wnt expression (rho_w=0.004, N=32) to Wild-Type (rho_w=0.001, N=16)" ;
        schema:name "Transgenic K14-Wnt overexpression vs Wild-Type placode density ratio" ;
        schema:unitText "N_Wnt++ / N_WT" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-transgenic-k14-wnt-overexpression-vs-wild-type-placode-density-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-transgenic-k14-wnt-overexpression-vs-wild-type-placode-density-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Sick et al. (2006) Science 314:1447-1450 Fig. 2B-D (K14-Wnt transgenic hyper-density & clustering)" ;
        schema:value "2.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-unsaturated-steady-state-wnt-activator-concentration-w> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Unsaturated steady-state WNT activator concentration w_* = 1.5 concentration units" ;
        dcterms:description "homogeneous Jacobian tr(J_0) = -0.0100 < 0, det(J_0) = 0.00140 > 0" ;
        schema:measurementTechnique "Exact steady-state formula w_* = (c_w / c_h) * (mu_h / mu_w) with h_* = 2.25" ;
        schema:name "Unsaturated steady-state WNT activator concentration w_*" ;
        schema:unitText "concentration units" ;
        schema:value "1.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-unsaturated-steady-state-wnt-activator-concentration-w-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-unsaturated-steady-state-wnt-activator-concentration-w-reference> a schema:PropertyValue ;
        dcterms:source "Sick et al. (2006) Science 314:1447-1450" ;
        schema:value "1.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wild-type-2d-hair-follicle-placode-count-vs-mus-musculus-in-situ-specimen-panel-b> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type 2D hair follicle placode count vs Mus musculus in situ specimen (Panel B) = 16 placodes" ;
        dcterms:description "WT 2D PDE forms 16 placodes (NN spacing = 8.66 ± 2.63 px, CV = 0.3037, area = 23.50 px^2); specimen Panel B segmented 16 placodes (NN spacing = 70.86 ± 22.92 px, CV = 0.3234)" ;
        schema:measurementTechnique "Connected components of 2D WNT activator field on 42x42 grid vs optical-density segmentation of Mus musculus E12.5-E13.5 specimen Panel B" ;
        schema:name "Wild-type 2D hair follicle placode count vs Mus musculus in situ specimen (Panel B)" ;
        schema:unitText "placodes" ;
        schema:value "16" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wild-type-2d-hair-follicle-placode-count-vs-mus-musculus-in-situ-specimen-panel-b-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wild-type-2d-hair-follicle-placode-count-vs-mus-musculus-in-situ-specimen-panel-b-reference> a schema:PropertyValue ;
        dcterms:source "Sick et al. (2006) Science 314:1447-1450 Fig. 2A & Maddox & Condie (2004) BMC Dev. Biol. 4:4 (16 placodes)" ;
        schema:value "16" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wnt-dkk-critical-diffusivity-ratio-d-c-sqrt-2-1-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "WNT/DKK critical diffusivity ratio d_c = (sqrt(2)+1)^2 = 5.8284 D_h / D_w" ;
        dcterms:description "canonical d = 30.0 > d_c (max Re sigma = +0.00864); equal-diffusion control d = 1.0 has max Re sigma = -0.00500" ;
        schema:measurementTechnique "Exact analytical Turing-Meinhardt threshold (3 + 2*sqrt(2)) at mu_h > mu_w" ;
        schema:name "WNT/DKK critical diffusivity ratio d_c = (sqrt(2)+1)^2" ;
        schema:unitText "D_h / D_w" ;
        schema:value "5.8284" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wnt-dkk-critical-diffusivity-ratio-d-c-sqrt-2-1-2-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wnt-dkk-critical-diffusivity-ratio-d-c-sqrt-2-1-2-reference> a schema:PropertyValue ;
        dcterms:source "Sick et al. (2006) Science 314:1447-1450 & Gierer & Meinhardt (1972)" ;
        schema:value "5.8284" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L741–L824" ;
        dcterms:description "7 quantitative morphometric measurements with reference values, CV/RMSE/r uncertainty, and Dkk1++/equal-diffusion negative controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L741-L824> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


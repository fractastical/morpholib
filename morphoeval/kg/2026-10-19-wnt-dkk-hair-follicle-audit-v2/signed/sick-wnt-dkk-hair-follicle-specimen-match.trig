sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Sick et al. (2006) & Andl et al. (2002) WNT/DKK reaction-diffusion hair follicle spacing, secondary wave insertion & transgenic phenotypes — Morphological realism / specimen match: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the CC BY 2.5 whole-mount in situ hybridization photograph of embryonic mouse (Mus musculus, E12.5-E13.5) hair/vibrissa follicle placodes (`datasets/wnt_dkk_hair_follicle/hair_follicle_placode_specimen.jpg`, Maddox & Condie 2004) and segments the 16 dark-purple stained follicle placodes in Panel B (`segment_follicle_specimen`, L521-592), constructing their Delaunay triangulation and nearest-neighbor spacing distribution (70.86 +- 22.92 px, CV = 0.3234) to match the 16 wild-type 2D PDE placodes (CV = 0.3062, Panels B1 & C1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L521–L592" ;
        dcterms:description "Background-subtracted optical-density segmentation and Delaunay/cKDTree analysis of 16 follicle placodes in Mus musculus specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L521-L592> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/wnt_dkk_hair_follicle_comparison.png (generated output)" ;
        dcterms:description "9-panel synthesis figure comparing dispersion, primary->secondary wave insertion, kymograph, 2D WT/K14-Wnt++/enlarged phenotypes, and segmented Mus musculus specimen — docs/media/wnt_dkk_hair_follicle_comparison.png: rendered output of 2002-sick-wnt-dkk-hair-follicle.py at 3cb5ea9, image/png, 716789 B, 2227×1863 px, artifact_sha256 0fda4446cf9f1dbec59986ac22e8d05c70c4270ab8dfcd35bdb3ffe6fea47573 (sha256 0fda4446cf9f1dbec59986ac22e8d05c70c4270ab8dfcd35bdb3ffe6fea47573), spec_fingerprint b199744003e12310e28662e653c933212ba7a7794558fe627f0cafadb3ab526e" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


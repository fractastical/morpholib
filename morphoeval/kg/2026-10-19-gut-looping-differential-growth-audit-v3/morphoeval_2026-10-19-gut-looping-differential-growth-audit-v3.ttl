    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Discrete Elastic Rod Coupled to a Finite-Element (CST, St.Venant-Kirchhoff) Dorsal-Mesentery Membrane: Differential-Growth Buckling" ;
    pk1:leanDeclaration "MathOfBiology.Loop_062.savin_annular_inertia_scaled" ;
    pk1:leanTheorem "MathOfBiology.Loop_062.savin_annular_inertia_factorization" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/savin-gut-looping-differential-growth-4> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Apicobasal Pitx2 Stiffness Gradient Mean-Preservation Law (Pass 3 FE mesentery)" ;
    dct:description "Defines the spatially varying membrane stiffness assigned to every constant-strain triangle of the FE mesentery mesh; guarantees that sweeping a changes only the spatial distribution (not the mean) of sheet stiffness, so the emergent dN/da is a genuine heterogeneity effect | Variables: E_m: mean dorsal-mesentery Young's modulus (kPa); a: Pitx2 gradient amplitude (|a| < 1); η: apicobasal coordinate; k/n: discrete mesh level" ;
    dct:source "Kurpios et al. (2008) PNAS 105:8499-8506 (Pitx2-dependent mesenchymal condensation of the dorsal mesentery; amplitude a is a modelling assumption)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L303-L309>,
        <https://github.com/fractastical/morpholib/blob/327729c8/morphoeval/lean/loops/Loop_062_gut_looping_differential_growth.lean#L101-L115> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def pitx2_stiffness_scaled (E0 a k n : Int) : Int :=
  E0 * (n + a * (2 * k - n))
theorem savin_pitx2_gradient_mean_preserving (E0 a k n : Int) :
    pitx2_stiffness_scaled E0 a k n + pitx2_stiffness_scaled E0 a (n - k) n = 2 * (E0 * n)
"""^^pk1:lean4 ;
    skos:notation "E_m(η) = E_m [1 + a (2η - 1)],  η ∈ [0,1] (dorsal root → gut edge);  E_m(η) + E_m(1-η) = 2 E_m  ⇒  ⟨E_m⟩ and ℓ_* independent of a" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2008.05.001>,
        <https://doi.org/10.1038/nature10277>,
        <https://doi.org/10.1073/pnas.0803578105>,
        <https://doi.org/10.1073/pnas.1618677114>,
        <https://doi.org/10.1126/science.1238842> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Discrete Elastic Rod Coupled to a Finite-Element (CST, St.Venant-Kirchhoff) Dorsal-Mesentery Membrane: Differential-Growth Buckling" ;
    pk1:leanDeclaration "MathOfBiology.Loop_062.pitx2_stiffness_scaled" ;
    pk1:leanTheorem "MathOfBiology.Loop_062.savin_pitx2_gradient_mean_preserving" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/savin-gut-looping-differential-growth-5> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Fan-Mesentery Triangulation Euler-Characteristic Law (Pass 3 FE mesentery)" ;
    dct:description "Certifies that the CST membrane energy is assembled over a simply connected disk-like sheet (single boundary: fixed root + gut edge + fan sides) and states the full coupled rod + membrane energy minimised by L-BFGS-B from which loop number and radius emerge | Variables: n_s: nodes along the gut edge (96); n_w: nodes across the fan (5); A_e, h_m: triangle rest area and sheet thickness; μ_e, λ_e: plane-stress Lamé moduli from E_m(η); B_t = E_t I_t; ds_t = L_t/(n_s-1)" ;
    dct:source "Savin et al. (2011) Nature 476:57-62 SI Sec. S3 (rod + stretched sheet energy); CST/St.Venant-Kirchhoff membrane: standard FE (reduced model, Pass 3)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L251-L300>,
        <https://github.com/fractastical/morpholib/blob/327729c8/morphoeval/lean/loops/Loop_062_gut_looping_differential_growth.lean#L127-L142> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def fan_mesh_vertices (ns nw : Nat) : Nat := ns * nw
def fan_mesh_triangles (ns nw : Nat) : Nat := 2 * ((ns - 1) * (nw - 1))
def fan_mesh_edges (ns nw : Nat) : Nat :=
  (ns - 1) * nw + ns * (nw - 1) + (ns - 1) * (nw - 1)
theorem savin_fan_mesh_euler_characteristic (ns nw : Nat) :
    (fan_mesh_vertices (ns + 1) (nw + 1) : Int) - fan_mesh_edges (ns + 1) (nw + 1)
      + fan_mesh_triangles (ns + 1) (nw + 1) = 1
"""^^pk1:lean4 ;
    skos:notation "V = n_s n_w,  E = (n_s-1) n_w + n_s (n_w-1) + (n_s-1)(n_w-1),  F = 2 (n_s-1)(n_w-1)  ⇒  V - E + F = 1;  Ψ_e = μ_e tr(E²) + λ_e/2 tr(E)²,  E = (FᵀF - I)/2,  E_tot = Σ_e A_e h_m Ψ_e + Σ_i ½ (E_t A_t/ds_t)(|Δr_i| - ds_t)² + Σ_i ½ (B_t/ds_t³)|r_{i+1} - 2r_i + r_{i-1}|²" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2008.05.001>,
        <https://doi.org/10.1038/nature10277>,
        <https://doi.org/10.1073/pnas.0803578105>,
        <https://doi.org/10.1073/pnas.1618677114>,
        <https://doi.org/10.1126/science.1238842> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Discrete Elastic Rod Coupled to a Finite-Element (CST, St.Venant-Kirchhoff) Dorsal-Mesentery Membrane: Differential-Growth Buckling" ;
    pk1:leanDeclaration "MathOfBiology.Loop_062.fan_mesh_edges" ;
    pk1:leanTheorem "MathOfBiology.Loop_062.savin_fan_mesh_euler_characteristic" ;
    pk1:leanVerified true .


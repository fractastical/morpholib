sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-savin-gut-looping-differential-growth> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Savin et al. (2011) discrete gut rod coupled to a finite-element (CST, St.Venant-Kirchhoff) dorsal-mesentery membrane with an apicobasal Pitx2 stiffness gradient — Morphological realism / specimen match: 74/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Judged on the regenerated PNG / GIF and the emergent numbers: Panel A shows a looped rod attached to a stiffness-coloured fan mesh that reads as a mesentery-suspended midgut, Panel F compares emergent N and R to the observed E8-E16 values with the MAPE in the title, the ablation control uncoils to tortuosity 1.000, and the BMP2 > WT > Noggin ordering of N (14.65 / 9.81 / 4.99 vs obs 11.5 / 8.5 / 5.5) and of R (0.80 / 0.95 / 1.35 vs obs 0.98 / 1.15 / 1.40) emerges without tuning. Deductions: the E12 loop count is 15 % high and the radius 17 % low, with E8-E16 MAPE of 19 % and 21 % (-8); the only vendored specimen image is an adult mammalian mesentery photograph from Wikimedia, not an embryonic chick midgut, its segmented lambda/R is 1.54 against the paper's 2.71 (reported at L1642) and the segmentation falls back to a hard-coded spacing triple when fewer than 3 peaks are found (L893-899) (-10); the CV reference 0.18 and 'CV < 0.25' (L1630-1631) are not sourced to any figure of Savin 2011 (-3); the specimen comparison is 2D nearest-neighbour spacing on a photograph, not a morphometric of the rendered 3D loops against embryo images (-5). Credit is given for the honest MAPE labelling in the figure and for the BMP2/Noggin/ablation ordering being emergent." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2011-savin-gut-looping-differential-growth.py L1626–L1644: Specimen CV 0.2319 vs unsourced reference 0.18 / 'CV < 0.25'; specimen lambda/R = 1.54 vs 2.71 <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L1626-L1644>",
            "2011-savin-gut-looping-differential-growth.py L837–L899: Chromaticity + DoG segmentation of an adult mammalian mesentery photograph (not embryonic chick); hard-coded fallback nn_spacings = [28, 30, 29] when < 3 peaks <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L837-L899>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-specimen-match-4> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/gut_looping_differential_growth_comparison.png (generated output)" ;
        dct:description "Panel A FE mesh coloured by E_m(eta) with the looped rod and the straight ablation control; Panel F emergent N and R vs observed E8-E16 with MAPE in the title; Panels B-E collapse, BMP2/Noggin, specimen segmentation — docs/media/gut_looping_differential_growth_comparison.png: rendered output of 2011-savin-gut-looping-differential-growth.py at 327729c8, image/png, 972120 B, 2135×1452 px, artifact_sha256 ecc65dee03e0c3a533d95c7271c0e853a30687d6ea5ba5c237d41f3e7f9c41e4 (sha256 ecc65dee03e0c3a533d95c7271c0e853a30687d6ea5ba5c237d41f3e7f9c41e4), spec_fingerprint 6fb7e55e6158cd10ddf94728c17f791e81e999f808f135655cb2a64003d9cc1b" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/gut_looping_differential_growth_pitx2_fe_sweep.png (generated output)" ;
        dct:description "a = 0 vs a = 0.8 meshes, Pitx2-sweep N and R curves, E12 perturbation R bars — docs/media/gut_looping_differential_growth_pitx2_fe_sweep.png: rendered output of 2011-savin-gut-looping-differential-growth.py at 327729c8, image/png, 278778 B, 1864×723 px, artifact_sha256 5387f9203594c47026d6a8dac7ce8ebb366c46b2392d44b1865d0b3a9591e383 (sha256 5387f9203594c47026d6a8dac7ce8ebb366c46b2392d44b1865d0b3a9591e383), spec_fingerprint 6fb7e55e6158cd10ddf94728c17f791e81e999f808f135655cb2a64003d9cc1b" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/gut_looping_differential_growth_growth.gif (generated output)" ;
        dct:description "6-frame GIF: intact-sheet epsilon = 0 baseline then E8-E16 FE-coupled relaxations with the mesh drawn; right panel emergent R vs ell_* against the cube law — docs/media/gut_looping_differential_growth_growth.gif: rendered output of 2011-savin-gut-looping-differential-growth.py at 327729c8, image/gif, 269360 B, 1050×482 px, 6 frames, artifact_sha256 f9b44c167480be5fb0127426fb6d8f2cf5916160c68e316ec6192714d1509515 (sha256 f9b44c167480be5fb0127426fb6d8f2cf5916160c68e316ec6192714d1509515), spec_fingerprint 6fb7e55e6158cd10ddf94728c17f791e81e999f808f135655cb2a64003d9cc1b" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L781–L831" ;
        dct:description "BMP2 / WT / Noggin / ablation relaxations at E12 from the pinned condition table; ordering of N and R emerges (self-test #9)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L781-L831> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 062 Pass 3 Phase B Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


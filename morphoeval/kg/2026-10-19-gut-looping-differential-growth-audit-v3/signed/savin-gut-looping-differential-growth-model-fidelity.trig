sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-savin-gut-looping-differential-growth> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L170–L205" ;
        dcterms:description "Differential strain, annular I_t, ell_* = (E_t I_t/(E_m h_m))^(1/3) and the c_lambda = 4.55 / c_R = 1.68 predictions (analytical Savin core)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L170-L205> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L251–L339" ;
        dcterms:description "Fan triangulation (V-E+F=1), mean-preserving Pitx2 stiffness field and SVK CST membrane energy with analytic first-Piola gradient" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L251-L339> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L342–L507" ;
        dcterms:description "relax_rod_fe_mesentery: shared rod/sheet DOFs, axial + second-difference bending rod energy, root fixed / ends pinned, L-BFGS-B, emergent turning-number N, R = 1/<kappa>, tortuosity; no shape template or calibration factor" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L342-L507> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L236–L247" ;
        dcterms:description "Section 3 header states the honest limitations: pure membrane (no sheet bending / LR rest curvature, handedness not selected), W_m/L_m, root fraction and a_Pitx2 are assumptions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L236-L247> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_062_gut_looping_differential_growth.lean L11–L142" ;
        dcterms:description "5 machine-checked Lean 4 theorems (0 sorrys): zero-strain, cube-law stationarity, annular inertia factorisation, Pitx2 mean preservation, fan-mesh Euler characteristic" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/morphoeval/lean/loops/Loop_062_gut_looping_differential_growth.lean#L11-L142> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Savin et al. (2011) discrete gut rod coupled to a finite-element (CST, St.Venant-Kirchhoff) dorsal-mesentery membrane with an apicobasal Pitx2 stiffness gradient — Model fidelity to source: 82/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The analytical core is Savin's (strain L170-175, annular inertia L178-184, ell_* and the 4.55 / 1.68 prefactors L187-205) and the Pass 3 mechanism is a genuine coupled rod + sheet energy: a trapezoidal fan triangulated into 760 CST elements (L251-300), a St.Venant-Kirchhoff plane-stress membrane embedded in 3D with the exact first-Piola gradient (L312-339), rod axial and bending terms assembled on the shared gut-edge nodes (L418-441), root fixed and rod ends pinned (L403-414), and emergent turning-number N, R = 1/<kappa> and tortuosity (L454-468). Nothing prescribes the loop shape, and E_m = 0 releases the rod to a straight configuration. Deductions: the sheet is a pure membrane with no bending stiffness or left-right rest curvature, so the handedness that Kurpios 2008 / Davis 2008 attribute to the mesentery is not selected and the model is silent on chirality (-6); the SVK membrane resists compression, so compressed sheet regions act as an unphysical foundation instead of wrinkling (acknowledged at L242-247) (-3); the rod bending energy is a second-difference penalty without twist, so 'Kirchhoff rod' in the alias L511 and the Section 3 header overstates it (-3); the emergent R exponent across E8-E16 is 0.61 instead of the cube law's 1.0 and R is 21 % low, i.e. the reduced model does not reproduce the paper's central scaling result from mechanics alone (-4); the ablation branch simply zeroes E_m and releases the ends rather than modelling a dissected sheet (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2011-savin-gut-looping-differential-growth.py L1566–L1574: Emergent R MAPE 0.214 across E8-E16 and log-log slope of R_sim vs ell_* = 0.61 (cube law 1.0): the reduced model does not reproduce the ontogenetic exponent <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L1566-L1574>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-5> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 062 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


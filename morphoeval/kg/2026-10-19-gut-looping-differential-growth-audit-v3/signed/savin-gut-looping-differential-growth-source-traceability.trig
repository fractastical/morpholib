sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-savin-gut-looping-differential-growth> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-source-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L102–L144" ;
        dcterms:description "EXPECTED_SHA256 for 5 dataset files (incl. new fe_mesentery_mesh_reference.json and updated bib) and fail-closed verify_dataset_integrity()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L102-L144> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/gut_looping_differential_growth/fe_mesentery_mesh_reference.json L1–L37" ;
        dcterms:description "provenance_note: mesh_defaults are MODELLING ASSUMPTIONS; comparison_targets derived arithmetically from the pinned observations; sources with DOIs and used_for" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/datasets/gut_looping_differential_growth/fe_mesentery_mesh_reference.json#L1-L37> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/gut_looping_differential_growth/paper_citations.bib L45–L55" ;
        dcterms:description "davis2008chirality entry with DOI 10.1016/j.devcel.2008.05.001 (not verified offline)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/datasets/gut_looping_differential_growth/paper_citations.bib#L45-L55> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Savin et al. (2011) discrete gut rod coupled to a finite-element (CST, St.Venant-Kirchhoff) dorsal-mesentery membrane with an apicobasal Pitx2 stiffness gradient — Source and data traceability: 74/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Five sources carry DOIs in the script header, the dataset README and `paper_citations.bib`; all 5 dataset files are SHA-256 pinned (L102-119) and verified fail-closed at every run (L133-144); the new `fe_mesentery_mesh_reference.json` separates `mesh_defaults` (labelled modelling assumptions) from `comparison_targets` (arithmetic on the pinned observations) with a `provenance_note` and per-source `used_for` fields. Deductions: the 14-row `cross_species_scaling` table (reference JSON L151-166) reproduces lambda = 4.55 ell_* and R = 1.68 ell_* to ~1 % with the SAME log-log slope 0.9909 +/- 0.0027 for lambda and R and lambda/R CV 0.8 %, which digitised Fig. 4e-f data would not do; its per-row E_t/E_m, h_m and R_i are not traceable to any table in Savin 2011 (-10); the BMP2/Noggin rows carry E_m = 2.35 / 1.25 kPa, h_m = 0.044 / 0.031 mm and tortuosities 5.15 / 2.95 attributed to Nerurkar 2017 Figs. 2-3, which report strain and loop-number changes rather than moduli or tortuosity (-6); the specimen image metadata describes an adult mammalian photograph as the comparison specimen for an embryonic chick model (-4); the Davis 2008 DOI 10.1016/j.devcel.2008.05.001 could not be verified offline (bib note says so) (-2); the 'CV < 0.25' and 0.18 CV references are unsourced (-2); `scout_manifest.json` and the README do not record which figure each chick-stage modulus (E_t, E_m) was digitised from (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "2011-savin-gut-looping-differential-growth.py L781–L831: BMP2/Noggin E_m_kPa, h_m_mm and tortuosity_obs taken from the condition table and attributed to Nerurkar 2017, which does not report moduli or tortuosity <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L781-L831>",
            "datasets/gut_looping_differential_growth/gut_looping_differential_growth_reference.json L151–L166: 14-row cross_species_scaling table: lambda_obs / ell_* = 4.52-4.60 and R_obs / ell_* ~ 1.68 for every row, identical log-log slopes for lambda and R — consistent with generation from the law, not digitisation of Fig. 4e-f <https://github.com/fractastical/morpholib/blob/327729c8/datasets/gut_looping_differential_growth/gut_looping_differential_growth_reference.json#L151-L166>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-source-traceability-3> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 062 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


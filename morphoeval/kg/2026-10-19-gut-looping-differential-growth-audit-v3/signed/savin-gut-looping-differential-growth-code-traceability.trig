sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-savin-gut-looping-differential-growth> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Savin et al. (2011) discrete gut rod coupled to a finite-element (CST, St.Venant-Kirchhoff) dorsal-mesentery membrane with an apicobasal Pitx2 stiffness gradient — Code-to-model traceability: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module header (L1-66) maps Laws 1-5 to their Lean theorems and to Savin 2011 / Nerurkar 2017 / Kurpios 2008; the Section 3 header (L236-247) documents the Pass 3 mechanism, the boundary conditions and the limitations; every new function cites its equation or Lean theorem in its docstring (`build_fan_mesentery_mesh` L257-262, `pitx2_stiffness_field` L304-306, `relax_rod_fe_mesentery` L360-365); the math-KG YAML registers 5 equations with single-range `code_locus` pins. Deductions: `lambda_sim_mm` now equals contour length per loop L_t/N (L492-493), not Savin's lambda, but keeps the old key name used downstream (-4); `relax_kirchhoff_gut_rod` (L511) and the Section 3 title call a second-difference rod a 'Kirchhoff rod' (-3); the plane-stress Lame conversion (L390-391), the 0.02 W_m roughness amplitude (L407) and the n_r//10 interior trim (L460) carry no comment or source (-3); the Pass 2 remnants in the measurement names ('3D Kirchhoff rod') were renamed but the README of the dataset still describes the v2 solver in its earlier sections (-2); credit for the FD gradient check that makes the stated energy auditable." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2011-savin-gut-looping-differential-growth.py L490–L511: lambda_sim_mm aliased to contour_per_loop_sim_mm (not Savin's lambda); relax_kirchhoff_gut_rod alias is a misnomer for a second-difference rod <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L490-L511>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-code-traceability-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L1–L66" ;
        dcterms:description "Module header: Pass 3 change log, 3 primary DOIs, Laws 1-5 each mapped to a Lean theorem" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L1-L66> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L236–L247" ;
        dcterms:description "Section 3 header documenting the FE mechanism, BCs and honest limitations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L236-L247> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/savin-gut-looping-differential-growth.yaml L74–L107" ;
        dcterms:description "Equations 4 and 5 registered with lean_locus, single-range code_locus and code_locus_secondary" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/morphoeval/math_kg_loops/savin-gut-looping-differential-growth.yaml#L74-L107> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 062 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


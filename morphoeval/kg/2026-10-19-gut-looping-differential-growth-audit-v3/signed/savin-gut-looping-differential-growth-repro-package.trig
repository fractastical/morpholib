sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-savin-gut-looping-differential-growth> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L1648–L1744" ;
        dcterms:description "13-check self_test(): SHA-256 x5, JSON parity, FD gradient, mesh topology, Pitx2 mean preservation, ablation, chick stages, collapse, BMP2 ordering, Pitx2 sweep, refinement, specimen, bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L1648-L1744> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "datasets/gut_looping_differential_growth/README.md L27–L35" ;
        dcterms:description "Pass 3 additions section documenting the new JSON, its assumptions and the Davis 2008 citation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/datasets/gut_looping_differential_growth/README.md#L27-L35> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Savin et al. (2011) discrete gut rod coupled to a finite-element (CST, St.Venant-Kirchhoff) dorsal-mesentery membrane with an apicobasal Pitx2 stiffness gradient — Reproducibility package: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`self_test()` (L1648-1744) runs 13 checks in ~112 s: 5-file SHA-256 integrity, JSON-to-code parity including the new comparison targets, FD gradient exactness (< 1e-5), mesh topology and Euler characteristic, Pitx2 mean preservation, ablation uncoiling, emergent looping at every chick stage with < 50 % error, 4-species collapse, emergent BMP2/WT/Noggin ordering for N and R, monotone Pitx2 sweep, refinement < 20 %, specimen segmentation, and bitwise two-run determinism of the FE solver (L1729-1734); results are cached per parameter key (L366-369) and the default render (~72 s) writes the PNG, the new Pitx2 PNG and a 6-frame GIF. Deductions: `lbfgs_converged` (L504) is recorded but never asserted, and E8 / E16 hit maxiter 12000 with success = False, so the self-test certifies near-stationary rather than converged minima (-4); the 20 % refinement tolerance and 50 % error tolerances are loose enough that the test cannot regress on accuracy (-3); `*.png` is git-ignored repo-wide so the two PNG outputs are not versioned (-2); no requirements lock or MPLCONFIGDIR note accompanies the 112 s / 72 s runtimes, and `measure_morphoeval()` costs ~57 s from a fresh process (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2011-savin-gut-looping-differential-growth.py L1719–L1721: Refinement tolerance 20 % (observed 7.7 %); accuracy tolerances 50 % at L1695-1696 <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L1719-L1721>",
            "2011-savin-gut-looping-differential-growth.py L443–L450: L-BFGS-B with maxiter 12000, ftol 1e-13, gtol 1e-9; opt.success stored at L504 but not asserted anywhere <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L443-L450>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-repro-package-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 062 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


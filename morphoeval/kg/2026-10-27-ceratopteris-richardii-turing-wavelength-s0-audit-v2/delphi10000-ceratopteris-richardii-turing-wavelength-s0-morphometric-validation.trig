sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Ceratopteris richardii Schnakenberg wavelength at 256 µm (Holocene, 0 Ma) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r of the dispersion relation is 1.0 against a null of 0. RMSE of the grid peak is 0 µm against a 10 µm band. KS against the plate is 0.935, not 0.05. Voucher tissue fraction is 0.330 against a prior of 0.62. Plate foreground 0.742 is not the 0.5 prior." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-ablation-equal-diffusion-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-critical-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-ks-radial-spectrum>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-pearson-r-dispersion>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-plate-width-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-rmse-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-plate-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-plate-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-voucher-tissue-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-stripe-wavelength-grid-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-sweep-lambda-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-ablation-equal-diffusion-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_equal_diffusion_sigma_max = -0.001019 1/s" ;
        dct:description "control versus the patterned D_v/D_u = 12 run" ;
        schema:measurementTechnique "negative control: D_u = D_v = 8, max sigma(k) over the same k grid" ;
        schema:name "ablation_equal_diffusion_sigma_max" ;
        schema:unitText "1/s" ;
        schema:value "-0.001019" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-ablation-equal-diffusion-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-ablation-equal-diffusion-sigma-max-reference> a schema:PropertyValue ;
        dct:source "Turing requires a positive diffusion-weighted trace; equal diffusion should not grow" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-critical-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical_wavelength_um = 256.0 µm" ;
        dct:description "analytical wavelength; RMSE against the grid measurement is separate" ;
        schema:measurementTechnique "k_c from Schnakenberg Jacobian at the slot-3143 diffusivities; lambda = 2*pi/k_c" ;
        schema:name "critical_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "256.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-critical-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-critical-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "slot scale 256 µm (detail variant of tier 5_primordium_100um), age 0 Ma" ;
        schema:value "256.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-ks-radial-spectrum> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ks_radial_spectrum = 0.9355 1" ;
        dct:description "KS distance; value is not the reference" ;
        schema:measurementTechnique "two-sample KS statistic, activator radial spectrum vs canonical plate" ;
        schema:name "ks_radial_spectrum" ;
        schema:unitText "1" ;
        schema:value "0.9355" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-ks-radial-spectrum-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-ks-radial-spectrum-reference> a schema:PropertyValue ;
        dct:source "a 0.05 identity threshold the spectra are not claimed to meet" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-pearson-r-dispersion> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pearson_r_dispersion = 1.0 1" ;
        dct:description "goodness-of-fit of the implemented dispersion relation" ;
        schema:measurementTechnique "Pearson r of sigma(k) closed form vs 2x2 matrix eigenvalues, 48 wavenumbers" ;
        schema:name "pearson_r_dispersion" ;
        schema:unitText "1" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-pearson-r-dispersion-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-pearson-r-dispersion-reference> a schema:PropertyValue ;
        dct:source "null of uncorrelated growth-rate estimators" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-plate-width-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "plate_width_um = 754.72 µm" ;
        dct:description "plate is slightly narrower than the 768 µm window" ;
        schema:measurementTechnique "800 px times 100/106 µm per px from the drawn scale bar" ;
        schema:name "plate_width_um" ;
        schema:unitText "µm" ;
        schema:value "754.72" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-plate-width-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-plate-width-um-reference> a schema:PropertyValue ;
        dct:source "model window of three 256 µm wavelengths" ;
        schema:value "768.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-rmse-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "rmse_wavelength_um = 0.0 µm" ;
        dct:description "RMSE goodness-of-fit" ;
        schema:measurementTechnique "absolute deviation of the radial-FFT wavelength from 256 µm" ;
        schema:name "rmse_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-rmse-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-rmse-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "10 µm acceptance band, not the achieved residual" ;
        schema:value "10.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-plate-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_plate_coherency = 0.2315 1" ;
        dct:description "specimen image coherency" ;
        schema:measurementTechnique "mean structure-tensor coherency of the canonical plate" ;
        schema:name "specimen_plate_coherency" ;
        schema:unitText "1" ;
        schema:value "0.2315" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-plate-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-plate-coherency-reference> a schema:PropertyValue ;
        dct:source "isotropic-texture prior" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-plate-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_plate_foreground_fraction = 0.7419 1" ;
        dct:description "non-circular specimen segmentation" ;
        schema:measurementTechnique "Otsu mask on the canonical plate above the caption strip" ;
        schema:name "specimen_plate_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.7419" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-plate-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-plate-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "neutral half-field prior, not the measured fraction" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-voucher-tissue-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_voucher_tissue_fraction = 0.3299 1" ;
        dct:description "real specimen segmentation of the anatomical voucher" ;
        schema:measurementTechnique "green tissue inside the bright disk of the CC BY-SA gametophyte micrograph" ;
        schema:name "specimen_voucher_tissue_fraction" ;
        schema:unitText "1" ;
        schema:value "0.3299" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-voucher-tissue-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-voucher-tissue-fraction-reference> a schema:PropertyValue ;
        dct:source "not a published tissue fraction; prior is intentionally different from the measurement" ;
        schema:value "0.62" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-stripe-wavelength-grid-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stripe_wavelength_grid_um = 256.0 µm" ;
        dct:description "RMSE is |grid peak - 256 µm|" ;
        schema:measurementTechnique "parabolic interpolation of the radial FFT peak of the activator, times dx" ;
        schema:name "stripe_wavelength_grid_um" ;
        schema:unitText "µm" ;
        schema:value "256.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-stripe-wavelength-grid-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-stripe-wavelength-grid-um-reference> a schema:PropertyValue ;
        dct:source "same 256 µm target; grid peak is not forced to the bin centre" ;
        schema:value "256.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-sweep-lambda-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "sweep_lambda_cv = 0.2979 1" ;
        dct:description "parameter expressivity, CV of the sweep" ;
        schema:measurementTechnique "coefficient of variation of lambda across the gamma-factor sweep" ;
        schema:name "sweep_lambda_cv" ;
        schema:unitText "1" ;
        schema:value "0.2979" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-sweep-lambda-cv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-sweep-lambda-cv-reference> a schema:PropertyValue ;
        dct:source "a flat sweep would have CV 0; gamma must move the wavelength" ;
        schema:value "0.0" .

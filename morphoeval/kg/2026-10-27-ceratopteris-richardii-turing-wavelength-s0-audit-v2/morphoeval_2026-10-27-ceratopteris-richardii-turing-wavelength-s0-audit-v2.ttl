<https://w3id.org/delphi/resource/math-law/delphi10000-ceratopteris-richardii-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg steady state and Jacobian" ;
    dct:description "State variables of the primordium-detail activator-inhibitor system | Variables: a=0.08, b=0.92, observation scale 256 µm, age 0 Ma" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0; Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b6bb4a501fe7a567f973e6a561d4c2d21ef28b00/models/2026-delphi10000-ceratopteris-richardii-turing-wavelength-s0.py#L63-L78>,
        <https://github.com/fractastical/morpholib/blob/b6bb4a501fe7a567f973e6a561d4c2d21ef28b00/morphoeval/lean/loops/Loop_3143_ceratopteris_richardii_turing_wavelength_s0.lean#L11-L30> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u0 = a + b; v0 = b/u0^2; f_u = gamma(-1 + 2 u0 v0); g_v = -gamma u0^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.ydbio.2018.10.005>,
        <https://doi.org/10.1038/s42003-022-03627-y>,
        <https://doi.org/10.1086/297255>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3143.observationScaleUm" ;
    pk:leanTheorem "MathOfBiology.Loop_3143.observation_scale_is_256" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-ceratopteris-richardii-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber k_c" ;
    dct:description "Wavelength selection at the 256 µm Holocene detail scale | Variables: D_u=8 µm^2/s, D_v=96 µm^2/s, ratio 12" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b6bb4a501fe7a567f973e6a561d4c2d21ef28b00/models/2026-delphi10000-ceratopteris-richardii-turing-wavelength-s0.py#L80-L137>,
        <https://github.com/fractastical/morpholib/blob/b6bb4a501fe7a567f973e6a561d4c2d21ef28b00/morphoeval/lean/loops/Loop_3143_ceratopteris_richardii_turing_wavelength_s0.lean#L17-L38> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); lambda_c = 2 pi / k_c = 256 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.ydbio.2018.10.005>,
        <https://doi.org/10.1038/s42003-022-03627-y>,
        <https://doi.org/10.1086/297255>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3143.diffusivityInhibitor" ;
    pk:leanTheorem "MathOfBiology.Loop_3143.inhibitor_diffuses_twelvefold" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-ceratopteris-richardii-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Three-wavelength primordium window" ;
    dct:description "What changes at this scale versus a doubled meristem and versus the whole frond | Variables: domain side 768 µm; predecessor counterfactual 512 µm is not a scored fossil" ;
    dct:source "Geng, Yan and Zhou 2022 DOI:10.1038/s42003-022-03627-y" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b6bb4a501fe7a567f973e6a561d4c2d21ef28b00/models/2026-delphi10000-ceratopteris-richardii-turing-wavelength-s0.py#L46-L56>,
        <https://github.com/fractastical/morpholib/blob/b6bb4a501fe7a567f973e6a561d4c2d21ef28b00/morphoeval/lean/loops/Loop_3143_ceratopteris_richardii_turing_wavelength_s0.lean#L23-L46> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;

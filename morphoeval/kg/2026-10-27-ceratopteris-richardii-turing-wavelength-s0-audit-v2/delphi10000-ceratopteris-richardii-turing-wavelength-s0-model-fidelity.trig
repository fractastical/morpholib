sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Ceratopteris richardii Schnakenberg wavelength at 256 µm (Holocene, 0 Ma) — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The Jacobian, critical-wavenumber formula, and explicit integrator are unchanged and still hit 256 µm. Pass 2 also reports the ablation in which that instability disappears." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ceratopteris-richardii-turing-wavelength-s0.py L70–L89" ;
        dct:description "Jacobian and gamma solved for 256 µm" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b6bb4a501fe7a567f973e6a561d4c2d21ef28b00/models/2026-delphi10000-ceratopteris-richardii-turing-wavelength-s0.py#L70-L89> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ceratopteris-richardii-turing-wavelength-s0.py L218–L224" ;
        dct:description "equal-diffusion ablation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b6bb4a501fe7a567f973e6a561d4c2d21ef28b00/models/2026-delphi10000-ceratopteris-richardii-turing-wavelength-s0.py#L218-L224> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0000-0000-0000> .
}


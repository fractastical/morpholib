sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Ceratopteris richardii Schnakenberg wavelength at 256 µm (Holocene, 0 Ma) faithfully reproduces Ceratopteris richardii morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-ceratopteris-richardii-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Ceratopteris richardii specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-ceratopteris-richardii-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-ceratopteris-richardii-turing-wavelength-s0.py; output: docs/media/ceratopteris_richardii_turing_wavelength_s0_comparison.png; organism: Ceratopteris richardii; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 and Schnakenberg 1979 select a finite critical wavenumber when the inhibitor out-diffuses the activator. | Geng, Yan and Zhou 2022 and Bartz and Gola 2018 describe the Ceratopteris notch meristem. They do not publish a 256 µm wavelength.; reconstructed_in_script: gamma is solved so k_c = 2*pi/256 µm. The sweep, ablation, KS statistic and voucher mask are computed in this script. | The GIF's last frame is the canonical plate so the fitness crop can see that specimen. Earlier frames are the stripe field.; transfer_boundary: The plate is a gallery rendering with a 100 µm bar, not a camera micrograph. The CC BY-SA file is the anatomical voucher.; does_not_claim: That the Schnakenberg field reproduces the plate pixel for pixel. Their radial spectra differ (KS 0.935). | That a 512 µm predecessor was measured. The chronoseries has one scored node, Holocene 0 Ma. | A signed nanopublication. No nanopub profile is present on this runner.]; phenomenon_size: 214 µm (0.000214 m, log10=-3.67 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 214 µm to 32.4 cm): 214 µm:ceratopteris-richardii-bioelectric-polarity, 756 µm:ceratopteris-richardii-vertex-packing, 7.2 mm:ceratopteris-richardii-turing-wavelength, 2.6 cm:ceratopteris-richardii-clock-wavefront, 4.5 cm:ceratopteris-richardii-morphogen-condensation, 5.8 cm:ceratopteris-richardii-flux-canalization, 6.3 cm:ceratopteris-richardii-elastic-buckling, 7.5 cm:ceratopteris-richardii-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/j.ydbio.2018.10.005>,
            <https://doi.org/10.1038/s42003-022-03627-y>,
            <https://doi.org/10.1086/297255>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-ceratopteris-richardii-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-ceratopteris-richardii-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


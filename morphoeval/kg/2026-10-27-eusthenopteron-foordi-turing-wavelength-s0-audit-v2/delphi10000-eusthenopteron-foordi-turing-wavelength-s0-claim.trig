sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Turing k_c at 104 µm on Eusthenopteron foordi, with sweep, ablation, and specimen GOF faithfully reproduces Eusthenopteron foordi morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-eusthenopteron-foordi-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Eusthenopteron foordi specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-eusthenopteron-foordi-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-eusthenopteron-foordi-turing-wavelength-s0.py; output: docs/media/eusthenopteron_foordi_turing_wavelength_s0_comparison.png; organism: Eusthenopteron foordi; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 critical wavenumber and diffusion-driven instability | Schnakenberg 1979 two-species kinetics | Kondo and Asai 1995 and Nakamasu et al. 2009 pigment-cell RD on living fish | Andrews and Westoll 1970 skeleton of Eusthenopteron foordi; reconstructed_in_script: Parameters chosen so formula k_c equals 2π per 104.2 µm | Dispersion comparison, Dv/Du sweep, equal-diffusion control, autocatalysis ablation | Body mask from the Brussels photograph used as the display domain; transfer_boundary: Living-teleost chromatophore RD transferred onto a Frasnian tristichopterid | 104.2 µm is the assigned primordium-tier detail scale; does_not_claim: That orange ocelli are preserved on the fossil | That the photograph has a micrometre scale bar | That the successor mode-count uses a newly measured body length rather than the registry lengths 0.140 m and 0.165 m]; phenomenon_size: 113 µm (0.0001131 m, log10=-3.947 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 113 µm to 25.4 cm): 113 µm:eusthenopteron-foordi-bioelectric-polarity, 354 µm:eusthenopteron-foordi-vertex-packing, 5.7 mm:eusthenopteron-foordi-turing-wavelength, 1.1 cm:eusthenopteron-foordi-clock-wavefront, 2.5 cm:eusthenopteron-foordi-morphogen-condensation, 3.1 cm:eusthenopteron-foordi-elastic-buckling, 3.5 cm:eusthenopteron-foordi-flux-canalization, 4.9 cm:eusthenopteron-foordi-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1017/S008045680001471X>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-eusthenopteron-foordi-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-eusthenopteron-foordi-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


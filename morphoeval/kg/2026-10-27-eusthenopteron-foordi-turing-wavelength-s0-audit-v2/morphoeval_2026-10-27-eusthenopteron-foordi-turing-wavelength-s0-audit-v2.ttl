<https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> a skos:Concept,
        pk:Concept ;
    rdfs:label "Code-to-model traceability" ;
    dct:description "[reproducibility, weight 8/100, id morphoeval/0.1.0/code-traceability] Can each modelling step in the code be traced to a specific equation, section or figure of the source?" ;
    skos:broader <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> a skos:Concept,
        pk:Concept ;
    rdfs:label "Model fidelity to source" ;
    dct:description "[faithfulness, weight 20/100, id morphoeval/0.1.0/model-fidelity] Does the code implement the equations / algorithm of the cited source model as published (not a loose analogue), with parameters defined the way the source defines them?" ;
    skos:broader <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> a skos:Concept,
        pk:Concept ;
    rdfs:label "Morphometric validation" ;
    dct:description "[faithfulness, weight 15/100, id morphoeval/0.1.0/morphometric-validation] Are quantitative morphometrics computed on the output and compared against values measured on real specimens or reported in the literature?" ;
    skos:broader <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> a skos:Concept,
        pk:Concept ;
    rdfs:label "Parameter expressivity" ;
    dct:description "[faithfulness, weight 10/100, id morphoeval/0.1.0/parameter-expressivity] Does each morphospace parameter visibly and monotonically control the feature of form it is supposed to control across its stated range?" ;
    skos:broader <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> a skos:Concept,
        pk:Concept ;
    rdfs:label "Reproducibility package" ;
    dct:description "[reproducibility, weight 12/100, id morphoeval/0.1.0/repro-package] Pinned dependencies, deterministic seeds, documented invocation, and a known-good environment; environment-induced result corruption counts against this dimension." ;
    skos:broader <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability> a skos:Concept,
        pk:Concept ;
    rdfs:label "Source and data traceability" ;
    dct:description "[reproducibility, weight 10/100, id morphoeval/0.1.0/source-traceability] Are the source paper (DOI/PMID), code repository and any input data resolvable identifiers, and is input provenance recorded?" ;
    skos:broader <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> a skos:Concept,
        pk:Concept ;
    rdfs:label "Morphological realism / specimen match" ;
    dct:description "[faithfulness, weight 25/100, id morphoeval/0.1.0/specimen-match] Does the rendered output resemble real specimens of the organism and/or the source authors' own figures, judged side by side? Distinct morphologies must be visually distinct." ;
    skos:broader <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/delphi/resource/evidence/2026-10-27-eusthenopteron-foordi-turing-wavelength-s0-audit-v2-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-1> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "specimen_dispersion_pearson_r" ;
    dct:description "Pearson r between analytical Turing σ(k) and a linearized Fourier step on the real-eigenvalue band" ;
    dct:source "Turing 1952 dispersion relation; value is the solver residual against that curve, not a copy of the reference" ;
    schema:about "Eusthenopteron foordi" ;
    schema:error 0e+00 ;
    schema:targetValue 1e+00 ;
    schema:unitText "1" ;
    schema:value 9.999998e-01 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-eusthenopteron-foordi-turing-wavelength-s0-audit-v2-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-2> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "specimen_dispersion_rmse" ;
    dct:description "RMSE of numerical versus analytical growth rates σ(k)" ;
    dct:source "Zero would be a perfect match; the solver leaves a small splitting residual" ;
    schema:about "Eusthenopteron foordi" ;
    schema:error 2.605e-01 ;
    schema:targetValue 0e+00 ;
    schema:unitText "1/time" ;
    schema:value 2.605232e-03 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-eusthenopteron-foordi-turing-wavelength-s0-audit-v2-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-3> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "ocellus_wavelength_um" ;
    dct:description "Radial FFT peak of the saturated Schnakenberg field, converted by the 104.2 µm formula-wavelength unit" ;
    dct:source "Formula λ_c = 2π/k_c. The realized peak sits slightly off onset, so value ≠ reference" ;
    schema:about "Eusthenopteron foordi" ;
    schema:error 2.1019e+00 ;
    schema:targetValue 1.042e+02 ;
    schema:unitText "µm" ;
    schema:value 1.020098e+02 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-eusthenopteron-foordi-turing-wavelength-s0-audit-v2-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-4> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "specimen_contour_aspect_ratio" ;
    dct:description "Bounding-box width/height of the dark fossil body segmented from the Brussels mount" ;
    dct:source "Reference is the same measurement on the species-gallery life reconstruction, a different image" ;
    schema:about "Eusthenopteron foordi" ;
    schema:error 7.3158e+00 ;
    schema:targetValue 3.905556e+00 ;
    schema:unitText "1" ;
    schema:value 3.619835e+00 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-eusthenopteron-foordi-turing-wavelength-s0-audit-v2-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-5> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "specimen_mask_circularity" ;
    dct:description "4πA/P² of the segmented fossil body" ;
    dct:source "Gallery reconstruction circularity, measured independently" ;
    schema:about "Eusthenopteron foordi" ;
    schema:error 1.34342e+01 ;
    schema:targetValue 2.117581e-01 ;
    schema:unitText "1" ;
    schema:value 1.8331e-01 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-eusthenopteron-foordi-turing-wavelength-s0-audit-v2-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-6> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "specimen_orientation_ks" ;
    dct:description "Two-sample KS statistic of Sobel orientations, fossil crop versus last GIF frame" ;
    dct:source "KS = 0 would mean identical orientation samples; the overlay does not reproduce every bone edge" ;
    schema:about "Eusthenopteron foordi" ;
    schema:error 2.4e+00 ;
    schema:targetValue 0e+00 ;
    schema:unitText "1" ;
    schema:value 2.4e-02 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-eusthenopteron-foordi-turing-wavelength-s0-audit-v2-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-7> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "pattern_versus_equal_diffusion_std_ratio" ;
    dct:description "std(u) of the Turing run divided by std(u) of the equal-diffusion negative control" ;
    dct:source "Equal diffusion is the Turing-negative control; ratio near 1 would mean the control still patterned" ;
    schema:about "Eusthenopteron foordi" ;
    schema:error 2.862404e+07 ;
    schema:targetValue 1e+00 ;
    schema:unitText "1" ;
    schema:value 2.862414e+05 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-eusthenopteron-foordi-turing-wavelength-s0-audit-v2-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-8> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "pattern_versus_ablated_autocatalysis_std_ratio" ;
    dct:description "std(u) of the full model divided by std(u) after dropping u²v autocatalysis" ;
    dct:source "Ablation removes the Schnakenberg feedback; residual std is relaxation, not spots" ;
    schema:about "Eusthenopteron foordi" ;
    schema:error 4.83306e+13 ;
    schema:targetValue 1e+00 ;
    schema:unitText "1" ;
    schema:value 4.83306e+11 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-eusthenopteron-foordi-turing-wavelength-s0-audit-v2-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-9> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "wavelength_sweep_spearman_r" ;
    dct:description "Spearman rank correlation of realized λ against Dv/Du over the sweep" ;
    dct:source "Zero would be no rank association; the sweep is the expressivity check" ;
    schema:about "Eusthenopteron foordi" ;
    schema:error 9e+01 ;
    schema:targetValue 0e+00 ;
    schema:unitText "1" ;
    schema:value 9e-01 .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


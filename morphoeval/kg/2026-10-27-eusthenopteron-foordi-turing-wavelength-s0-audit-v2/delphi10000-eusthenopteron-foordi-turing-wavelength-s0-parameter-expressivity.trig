    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Turing k_c at 104 µm on Eusthenopteron foordi, with sweep, ablation, and specimen GOF — Parameter expressivity: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Raising Dv/Du from 10 to 30 lengthens the centroid wavelength from 109.5 to 114.3 µm (Spearman 0.90) and raises pattern std at every step (0.082, 0.372, 0.665, 0.862, 1.042). The wavelength series is not strictly monotone (110.65 µm at ratio 16 sits below 111.57 µm at ratio 12)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

<https://w3id.org/probknow/resource/claim/morphoeval-caleo-cajal-dendritic-wiring> a pk:Claim ;
    rdfs:label "Cuntz et al. (2010) PLoS Comput. Biol. & Cuntz et al. (2007) PNAS Ramón y Cajal minimum-wiring and conduction-delay greedy Steiner dendritic trees + Rall's 3/2 diameter power law (Drosophila melanogaster (Class I-IV da sensory neurons), Homo sapiens & Mus musculus (cerebellar Purkinje cells and cortical pyramidal cells))",
        "Cuntz et al. (2010) PLoS Comput. Biol. & Cuntz et al. (2007) PNAS Ramón y Cajal minimum-wiring and conduction-delay greedy Steiner dendritic trees + Rall's 3/2 diameter power law faithfully reproduces Drosophila melanogaster (Class I-IV da sensory neurons), Homo sapiens & Mus musculus (cerebellar Purkinje cells and cortical pyramidal cells) morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/caleo-cajal-dendritic-wiring-1>,
        <https://w3id.org/probknow/resource/math-law/caleo-cajal-dendritic-wiring-2>,
        <https://w3id.org/probknow/resource/math-law/caleo-cajal-dendritic-wiring-3> ;
    dct:description "The simulation script(s) 2007-caleo-cajal-dendritic-wiring.py implement the cited source model as published and produce forms that match real Drosophila melanogaster (Class I-IV da sensory neurons), Homo sapiens & Mus musculus (cerebellar Purkinje cells and cortical pyramidal cells) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 52.8/100, audit 2026-10-19-cajal-dendritic-wiring-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/2007-caleo-cajal-dendritic-wiring.py> ;
    schema:about "Drosophila melanogaster (Class I-IV da sensory neurons), Homo sapiens & Mus musculus (cerebellar Purkinje cells and cortical pyramidal cells)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2007-caleo-cajal-dendritic-wiring.py; output: docs/media/cajal_dendritic_wiring_comparison.png; organism: Drosophila melanogaster (Class I-IV da sensory neurons), Homo sapiens & Mus musculus (cerebellar Purkinje cells and cortical pyramidal cells); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: e3fe84c50afe7ec7f86e9cbcdd65b055eae449029956d538ecfdcce95c4d6fa6; artifact_sha256: db0abb4568b420716b846ebaec024a48f2247147781aa037c4bdae1fbe246710; input_dataset_sha256: {datasets/cajal_dendritic_wiring/cajal_dendritic_wiring_reference.json=8f1cb50f696dbce1..., datasets/cajal_dendritic_wiring/cajal_purkinje_dendritic_arbor_specimen.jpg=6255a396655b56c4..., datasets/cajal_dendritic_wiring/paper_citations.bib=6925a1fc3e146cab..., datasets/cajal_dendritic_wiring/scout_manifest.json=2440e61b14fedf53...}" ;
    pk:derivedFromPaper <https://doi.org/10.1016/0014-4886(59)90046-9>,
        <https://doi.org/10.1073/pnas.0704731104>,
        <https://doi.org/10.1152/jn.00280.2007>,
        <https://doi.org/10.1371/journal.pcbi.1000251>,
        <https://doi.org/10.1371/journal.pcbi.1000877> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-morphometric-validation>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-overall>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-parameter-expressivity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-cajal-dendritic-wiring-audit-caleo-cajal-dendritic-wiring-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-cajal-dendritic-wiring-audit-caleo-cajal-dendritic-wiring-2> ;
    pk:hypothesisType "Ramón y Cajal Minimum-Wiring-Length & Conduction-Delay Greedy Steiner Dendritic Trees + Rall's 3/2 Power Law" ;
    pk:weightOfEvidence 5.28e-01 .


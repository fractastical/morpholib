<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/caleo-cajal-dendritic-wiring-1>,
        <https://w3id.org/probknow/resource/math-law/caleo-cajal-dendritic-wiring-2>,
        <https://w3id.org/probknow/resource/math-law/caleo-cajal-dendritic-wiring-3> .

<https://w3id.org/probknow/resource/math-law/caleo-cajal-dendritic-wiring-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Cuntz et al. (2007, 2010) Greedy MST Wiring-vs-Conduction-Delay Cost Trade-Off Law" ;
    dct:description "Proves Ramón y Cajal's (1899) trade-off between minimum wiring length at bf = 0 (Prim/Steiner MST) and minimum soma-to-synapse path length at bf = 1 (radial star graph), with exact critical transition threshold bf_c = (d_rv - d_uv) / d_ru | Variables: d_uv = ||u - v||: Euclidean distance from tree node u to carrier target v; d_ru = path(u, root): path length along tree from soma root to u; bf in [0, 1]: Cuntz balancing factor weighting conduction time vs cytoplasmic cable length" ;
    dct:source "Cuntz, Forstner, Borst & Häusser (2010) PLoS Comput. Biol. 6(8):e1000877 Results & Fig. 1; Cuntz, Borst & Segev (2007) PNAS 104:13319-13324" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2007-caleo-cajal-dendritic-wiring.py#L120-L240>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_058_cajal_dendritic_wiring.lean#L36-L67> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def cuntz_greedy_cost_scaled (S bf_s d_uv path_u : Int) : Int :=
  S * d_uv + bf_s * path_u
theorem cuntz_2010_wiring_delay_cost_tradeoff
    (S d_ru d_uv d_rv bf_s : Int)
    (hS : 0 < S) (h_wire : d_uv < d_rv) (h_tri : d_rv < d_ru + d_uv) :
    cuntz_greedy_cost_scaled S bf_s d_uv d_ru -
      cuntz_greedy_cost_scaled S bf_s d_rv 0 =
      bf_s * d_ru - S * (d_rv - d_uv) ∧
    0 < cuntz_greedy_cost_scaled S 0 d_rv 0 -
      cuntz_greedy_cost_scaled S 0 d_uv d_ru ∧
    0 < cuntz_greedy_cost_scaled S S d_uv d_ru -
      cuntz_greedy_cost_scaled S S d_rv 0
"""^^pk:lean4 ;
    skos:notation "C(u, v) = ||u - v|| + bf * path(u, root);  C_S(u, v) - C_S(root, v) = bf_s * d_ru - S * (d_rv - d_uv)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0014-4886(59)90046-9>,
        <https://doi.org/10.1073/pnas.0704731104>,
        <https://doi.org/10.1152/jn.00280.2007>,
        <https://doi.org/10.1371/journal.pcbi.1000251>,
        <https://doi.org/10.1371/journal.pcbi.1000877> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Ramón y Cajal Minimum-Wiring-Length & Conduction-Delay Greedy Steiner Dendritic Trees + Rall's 3/2 Power Law" ;
    pk:leanDeclaration "MathOfBiology.Loop_058.cuntz_greedy_cost_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_058.cuntz_2010_wiring_delay_cost_tradeoff" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/caleo-cajal-dendritic-wiring-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Rall's (1959) 3/2 Electrotonic Impedance-Matching Diameter Power Law" ;
    dct:description "Proves that Rall's 3/2 power law matches input conductance across dendritic bifurcations so the branched arbor collapses to an equivalent electrotonic cylinder, with symmetric parent diameter d_p = 2^(2/3) d strictly steeper than Murray's vascular cube law (d_p = 2^(1/3) d) | Variables: d_parent, d_1, d_2: parent and daughter dendritic cylinder diameters; g_k = d_k^(3/2): electrotonic input conductance scaling variable" ;
    dct:source "Rall (1959) Exp. Neurol. 1(5):491-527 Eqs. 9-16; Cuntz et al. (2010) PLoS Comput. Biol. 6(8):e1000877 Fig. 2" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2007-caleo-cajal-dendritic-wiring.py#L245-L315>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_058_cajal_dendritic_wiring.lean#L85-L115> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def rall_cubed_diameter (g : Int) : Int := g * g
def rall_parent_half_cube (g1 g2 : Int) : Int := g1 + g2
theorem rall_1959_three_halves_impedance_matching
    (g1 g2 g : Int) (hg : 0 < g) :
    rall_cubed_diameter (rall_parent_half_cube g1 g2) =
      rall_cubed_diameter g1 + rall_cubed_diameter g2 + 2 * g1 * g2 ∧
    rall_cubed_diameter (rall_parent_half_cube g g) =
      4 * rall_cubed_diameter g ∧
    2 * rall_cubed_diameter g <
      rall_cubed_diameter (rall_parent_half_cube g g)
"""^^pk:lean4 ;
    skos:notation "d_parent^(3/2) = d_1^(3/2) + d_2^(3/2)  =>  d_parent^3 = d_1^3 + d_2^3 + 2 (d_1 d_2)^(3/2);  symmetric (d_1 = d_2 = d): d_parent^3 = 4 d^3 (d_parent = 2^(2/3) d)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0014-4886(59)90046-9>,
        <https://doi.org/10.1073/pnas.0704731104>,
        <https://doi.org/10.1152/jn.00280.2007>,
        <https://doi.org/10.1371/journal.pcbi.1000251>,
        <https://doi.org/10.1371/journal.pcbi.1000877> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Ramón y Cajal Minimum-Wiring-Length & Conduction-Delay Greedy Steiner Dendritic Trees + Rall's 3/2 Power Law" ;
    pk:leanDeclaration "MathOfBiology.Loop_058.rall_cubed_diameter" ;
    pk:leanTheorem "MathOfBiology.Loop_058.rall_1959_three_halves_impedance_matching" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/caleo-cajal-dendritic-wiring-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Acyclic Dendritic Spanning Tree & Binary Bifurcation Topological Identity" ;
    dct:description "Guarantees zero cycle formation (beta_1 = 0, unique soma-to-synapse electrotonic path) and exact conservation of leaves vs bifurcations (L = B + 1) in binary dendritic arbors | Variables: B: internal dendritic bifurcation points; L: terminal synaptic carrier tips; N: total nodes including soma root; E: total dendritic cable segments; beta_1: first Betti cycle number" ;
    dct:source "Cuntz et al. (2010) PLoS Comput. Biol. 6(8):e1000877 Methods" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2007-caleo-cajal-dendritic-wiring.py#L320-L390>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_058_cajal_dendritic_wiring.lean#L127-L149> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def binary_arbor_leaves (B : Int) : Int := B + 1
def binary_arbor_nodes (B : Int) : Int := 1 + B + binary_arbor_leaves B
def binary_arbor_edges (B : Int) : Int := 2 * B + 1
def tree_betti_1 (N E : Int) : Int := E - N + 1
theorem dendritic_binary_tree_topology_identity (B : Int) :
    binary_arbor_edges B = binary_arbor_nodes B - 1 ∧
    binary_arbor_leaves B - binary_arbor_edges B + B = 0 ∧
    tree_betti_1 (binary_arbor_nodes B) (binary_arbor_edges B) = 0
"""^^pk:lean4 ;
    skos:notation "E = N - 1,  L = B + 1,  E = 2B + 1,  beta_1 = E - N + 1 = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0014-4886(59)90046-9>,
        <https://doi.org/10.1073/pnas.0704731104>,
        <https://doi.org/10.1152/jn.00280.2007>,
        <https://doi.org/10.1371/journal.pcbi.1000251>,
        <https://doi.org/10.1371/journal.pcbi.1000877> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Ramón y Cajal Minimum-Wiring-Length & Conduction-Delay Greedy Steiner Dendritic Trees + Rall's 3/2 Power Law" ;
    pk:leanDeclaration "MathOfBiology.Loop_058.binary_arbor_edges" ;
    pk:leanTheorem "MathOfBiology.Loop_058.dendritic_binary_tree_topology_identity" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


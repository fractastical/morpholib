    <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Cuntz et al. (2010) PLoS Comput. Biol. & Cuntz et al. (2007) PNAS Ramón y Cajal minimum-wiring and conduction-delay greedy Steiner dendritic trees + Rall's 3/2 diameter power law — Reproducibility package: 54/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Includes a minimal 3-line `--self-test` flag, but lacks SHA-256 dataset integrity checks, tree topology invariants, Rall 3/2 checks, and random spanning tree negative controls." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2007-caleo-cajal-dendritic-wiring.py L137–L141: Minimal self-test without SHA-256 or graph-level invariant checks <https://github.com/fractastical/morpholib/blob/8871db0/2007-caleo-cajal-dendritic-wiring.py#L137-L141>" ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-beane-planarian-hk-atpase-anterior> a pk:Claim ;
        rdfs:label "Beane et al. (2011) planarian H,K-ATPase bioelectric V_mem anterior polarity switch faithfully reproduces Schmidtea mediterranea freshwater planarian flatworm morphology" ;
        dct:description "The simulation script(s) 2011-beane-planarian-hk-atpase-anterior.py implement the cited source model as published and produce forms that match real Schmidtea mediterranea freshwater planarian flatworm specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 58.8/100, audit 2026-10-19-planarian-hk-atpase-anterior-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2011-beane-planarian-hk-atpase-anterior.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2011-beane-planarian-hk-atpase-anterior.py; output: docs/media/planarian_hk_atpase_anterior_comparison.png; organism: Schmidtea mediterranea freshwater planarian flatworm; checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: c0d35653d229caf892ce95227098738e04e01130c0c0eb1c24a63345a769e0d8; artifact_sha256: 23e52bef2eb4a12b38ececd73bb5dddfe65c95c72488302a61aea135c94575f8; input_dataset_sha256: {datasets/planarian_hk_atpase_anterior/paper_citations.bib=4978cdbc97ad314e..., datasets/planarian_hk_atpase_anterior/planarian_hk_atpase_anterior_reference.json=ad7dfa156bbb79fe..., datasets/planarian_hk_atpase_anterior/schmidtea_mediterranea_specimen.jpg=466029cc05610678..., datasets/planarian_hk_atpase_anterior/scout_manifest.json=9de72183ede698f0...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1016/j.chembiol.2010.11.012>,
            <https://doi.org/10.1016/j.ydbio.2009.12.012>,
            <https://doi.org/10.1098/rsif.2017.0425> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-specimen-match> ;
        pk:weightOfEvidence "0.588"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/317bc3c/2011-beane-planarian-hk-atpase-anterior.py> a schema:SoftwareSourceCode ;
        rdfs:label "2011-beane-planarian-hk-atpase-anterior.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;

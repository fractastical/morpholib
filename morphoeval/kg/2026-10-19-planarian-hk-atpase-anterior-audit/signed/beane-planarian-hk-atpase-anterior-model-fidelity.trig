sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-beane-planarian-hk-atpase-anterior> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Beane et al. (2011) planarian H,K-ATPase bioelectric V_mem anterior polarity switch — Model fidelity to source: 63/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the cubic bistable membrane current I_ion(V) = g*(V - V_hyper)*(V - V_thresh)*(V - V_depol) and voltage-gated Ca2+ activation gate Ca_ss(V) (L118-245), but constant linear gap-junction diffusion in the baseline pass requires replacement with nonlinear voltage-gated innexin conductance G_GJ(DeltaV) = (1 - eta_oct)*G_0 / (1 + (DeltaV/V_0)^2) to prevent trunk hyperpolarization from draining the anterior blastema." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2011-beane-planarian-hk-atpase-anterior.py L200–L290: Coupled bioelectric V_mem and head/tail morphogen PDE solver <https://github.com/fractastical/morpholib/blob/317bc3c/2011-beane-planarian-hk-atpase-anterior.py#L200-L290>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-model-fidelity-1> ;
        pk:hasScore "0.63"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2011-beane-planarian-hk-atpase-anterior.py L118–L195" ;
        dcterms:description "Bistable ionic current and stability slope invariants" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2011-beane-planarian-hk-atpase-anterior.py#L118-L195> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-beane-planarian-hk-atpase-anterior> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-beane-et-al-2011-5-regime-regenerated-head-count-prediction-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Beane et al. (2011) 5-regime regenerated head count prediction RMSE = 0.0 heads RMSE" ;
        dcterms:description "predicted heads = [1, 0, 2, 2, 0] vs reference = [1, 0, 2, 2, 0] (exact 5/5 phenotype match, RMSE = 0.0000, gj_isolation_ratio = 0.1000)" ;
        schema:measurementTechnique "RMSE between predicted and empirical head counts across WT (1H), SCH-28080 (0H), Ivermectin (2H), 8-Octanol (2H), and Nifedipine control (0H)" ;
        schema:name "Beane et al. (2011) 5-regime regenerated head count prediction RMSE" ;
        schema:unitText "heads RMSE" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-beane-et-al-2011-5-regime-regenerated-head-count-prediction-rmse-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-beane-et-al-2011-5-regime-regenerated-head-count-prediction-rmse-reference> a schema:PropertyValue ;
        dcterms:source "Beane et al. (2011) Chem. Biol. 18(1):77-89 Table 1 & Figs. 1-6 (Lean 4 beane_four_regeneration_phenotypes)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-h-k-atpase-inhibition-sch-28080-rnai-vs-wild-type-anterior-head-commitment-suppression-delta> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "H,K-ATPase inhibition (SCH-28080 / RNAi) vs Wild-Type anterior head commitment suppression delta = 0.9467 H_WT(0) - H_SCH28080(0)" ;
        dcterms:description "WT ant_H = 0.9468 (n_heads=1) vs SCH-28080 ant_H = 0.0001 (n_heads=0); nifedipine Ca_v-block negative control ant_H = 0.0155 (n_heads=0)" ;
        schema:measurementTechnique "Anterior blastema head gene expression H(0) in wild_type_1H1T vs hk_atpase_inhibited_0H2T (SCH-28080)" ;
        schema:name "H,K-ATPase inhibition (SCH-28080 / RNAi) vs Wild-Type anterior head commitment suppression delta" ;
        schema:unitText "H_WT(0) - H_SCH28080(0)" ;
        schema:value "0.9467" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-h-k-atpase-inhibition-sch-28080-rnai-vs-wild-type-anterior-head-commitment-suppression-delta-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-h-k-atpase-inhibition-sch-28080-rnai-vs-wild-type-anterior-head-commitment-suppression-delta-reference> a schema:PropertyValue ;
        dcterms:source "Beane et al. (2011) Chem. Biol. 18(1):77-89 Fig. 1 & Fig. 2 (100% WT head regeneration vs 0% head regeneration in H,K-ATPase RNAi / SCH-28080)" ;
        schema:value "0.9" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-ivermectin-depolarization-8-octanol-gap-junction-blockade-double-head-2h0t-induction-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Ivermectin depolarization & 8-octanol gap-junction blockade double-head (2H0T) induction count = 2 regenerated heads" ;
        dcterms:description "ivermectin post_H = 0.9823 (2H0T, V_post = -13.57 mV); 8-octanol post_H = 0.9464 (2H0T, n_heads = 2)" ;
        schema:measurementTechnique "Bilateral blastema head count (H >= 0.50) under ivermectin GluCl depolarization (I_IVM=22) and 8-octanol gap-junction blockade (eta_oct=0.92)" ;
        schema:name "Ivermectin depolarization & 8-octanol gap-junction blockade double-head (2H0T) induction count" ;
        schema:unitText "regenerated heads" ;
        schema:value "2" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-ivermectin-depolarization-8-octanol-gap-junction-blockade-double-head-2h0t-induction-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-ivermectin-depolarization-8-octanol-gap-junction-blockade-double-head-2h0t-induction-count-reference> a schema:PropertyValue ;
        dcterms:source "Beane et al. (2011) Chem. Biol. 18(1):77-89 Figs. 3-4 & Oviedo et al. (2010) Dev. Biol. 339:188-199 (double-headed 2H0T planarians)" ;
        schema:value "2" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-schmidtea-mediterranea-specimen-bilateral-photoreceptor-ocelli-count-relative-ap-position> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Schmidtea mediterranea specimen bilateral photoreceptor ocelli count & relative AP position = 0.0528 x / L (anterior fraction)" ;
        dcterms:description "detected 2 bilateral ocelli at x/L = [0.0563, 0.0492] (std = 0.0036), body length = 1478 px, aspect ratio = 3.723" ;
        schema:measurementTechnique "Automated Gaussian local-contrast ocelli detection on schmidtea_mediterranea_specimen.jpg (N=2 eyespots at x/L=0.0528, inter-ocelli spacing=67.1 px)" ;
        schema:name "Schmidtea mediterranea specimen bilateral photoreceptor ocelli count & relative AP position" ;
        schema:unitText "x / L (anterior fraction)" ;
        schema:value "0.0528" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-schmidtea-mediterranea-specimen-bilateral-photoreceptor-ocelli-count-relative-ap-position-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-schmidtea-mediterranea-specimen-bilateral-photoreceptor-ocelli-count-relative-ap-position-reference> a schema:PropertyValue ;
        dcterms:source "Vendored Schmidtea mediterranea dorsal specimen (CC BY 2.5, File:Smediterranea.jpg) & simulated anterior head blastema center x/L = 0.065" ;
        schema:value "0.065" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-specimen-vs-simulated-1h1t-planarian-dorsoventral-width-profile-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Specimen vs simulated 1H1T planarian dorsoventral width profile correlation r = 0.8884 Pearson r" ;
        dcterms:description "width profile Pearson r = 0.8884, normalized width RMSE = 0.1111 across 60 AP body segments" ;
        schema:measurementTechnique "Pearson correlation and RMSE between segmented Schmidtea mediterranea width profile W(x/L) and reconstructed 1H1T morphology contour" ;
        schema:name "Specimen vs simulated 1H1T planarian dorsoventral width profile correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.8884" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-specimen-vs-simulated-1h1t-planarian-dorsoventral-width-profile-correlation-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-specimen-vs-simulated-1h1t-planarian-dorsoventral-width-profile-correlation-r-reference> a schema:PropertyValue ;
        dcterms:source "Schmidtea mediterranea dorsal whole-mount morphology (datasets/planarian_hk_atpase_anterior/schmidtea_mediterranea_specimen.jpg)" ;
        schema:value "0.9" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-wild-type-planarian-anteroposterior-v-mem-polarization-delta-v-ant-v-post> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type planarian anteroposterior V_mem polarization delta (V_ant - V_post) = 50.5062 mV" ;
        dcterms:description "WT V_ant = -14.49 mV, V_post = -65.00 mV (1H1T); SCH-28080 H,K-ATPase inhibition collapses delta_V to -5.05 mV (0H2T)" ;
        schema:measurementTechnique "Coupled bistable V_mem + voltage-gated gap-junction PDE steady-state difference V_ant(0) - V_post(L) in wild_type_1H1T" ;
        schema:name "Wild-type planarian anteroposterior V_mem polarization delta (V_ant - V_post)" ;
        schema:unitText "mV" ;
        schema:value "50.5062" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-wild-type-planarian-anteroposterior-v-mem-polarization-delta-v-ant-v-post-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-measurement-wild-type-planarian-anteroposterior-v-mem-polarization-delta-v-ant-v-post-reference> a schema:PropertyValue ;
        dcterms:source "Beane et al. (2011) Chem. Biol. 18(1):77-89 Fig. 2 & Pietak-Levin (2017) (-20 mV anterior vs -65 mV posterior = +45.0 mV)" ;
        schema:value "45.0" .


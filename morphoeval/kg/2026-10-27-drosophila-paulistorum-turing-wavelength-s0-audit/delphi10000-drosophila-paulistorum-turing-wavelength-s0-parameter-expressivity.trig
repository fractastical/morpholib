sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila paulistorum Schnakenberg ocellar stripe at 2.4 µm (Pass 1) — Parameter expressivity: 70/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "A Du sweep and an equal-diffusion ablation were executed. Activator amplitude collapsed under d=1, but measured wavelength did not move cleanly with Du (nonlinear r=0.877), so the sweep did not yet demonstrate control of λ." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py L332–L404" ;
        dct:description "Du sweep and equal-diffusion ablation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9a9d6408/models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py#L332-L404> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py L919–L966" ;
        dct:description "Self-test checks trace, determinant, growth of a seeded mode, and decay under equal diffusion" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9a9d6408/models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py#L919-L966> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (primary loop assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://github.com/fractastical> ;
        foaf:homepage <https://x.ai> .
}


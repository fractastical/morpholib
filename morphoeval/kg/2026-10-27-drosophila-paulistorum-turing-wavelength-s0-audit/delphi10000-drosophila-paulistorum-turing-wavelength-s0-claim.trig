sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Drosophila paulistorum Schnakenberg ocellar stripe at 2.4 µm (Pass 1) faithfully reproduces Drosophila paulistorum morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila paulistorum specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py; output: docs/media/drosophila_paulistorum_turing_wavelength_s0_comparison.png; organism: Drosophila paulistorum; environment: python 3.12.3, numpy 2.5.4, scipy 1.18.1, matplotlib 3.11.2, Pillow 13.0.0; claim_boundary: [reported_in_source: Dobzhansky & Spassky 1959: D. paulistorum is a willistoni-group cluster of incipient semispecies. Holocene, 0 Ma. | Turing 1952 and Maini, Painter & Chau 1997: a finite critical wavenumber exists when tr(J)<0, det(J)>0, and the inhibitor diffuses sufficiently faster than the activator. | Schnakenberg 1979: the two-species kinetics used here.; reconstructed_in_script: Placement of that wavenumber on a 2.417 µm intra-ocellar pigment stripe (campaign rung 3_subcellular_um, detail s0). | Catalog comparison with Drosophila orena (89.44 µm, 37 packings) and Drosophila persimilis (116.7 µm, 48 packings), both extant at 0 Ma.; transfer_boundary: Gompel et al. 2005 document Drosophila wing-pigment cis-regulation. That result is not an ocellar wavelength measurement and is not used as one.; does_not_claim: That Dobzhansky measured 2.4 µm. | That orena → paulistorum → persimilis is a stratigraphic ancestor chain. | That the habitus GIF is an electron micrograph of pigment granules.]; other sources: Drosophila paulistorum male <https://commons.wikimedia.org/wiki/File:Drosophila_paulistorum_male.png>; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1039/a702602a>,
            <https://doi.org/10.1073/pnas.45.3.419>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


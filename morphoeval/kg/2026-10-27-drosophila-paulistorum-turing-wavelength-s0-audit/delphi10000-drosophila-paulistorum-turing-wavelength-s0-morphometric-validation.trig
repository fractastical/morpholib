sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila paulistorum Schnakenberg ocellar stripe at 2.4 µm (Pass 1) — Morphometric validation: 68/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Specimen foreground 0.300 (prior 0.22), coherency 0.632 (prior 0.45), and circularity 0.597 (prior 0.72) are non-circular. The wavelength goodness-of-fit on the nonlinear field failed the 0.98 gate (r=0.877, RMSE 1.18 µm). Midline spacing was already near 2.40 µm (KS 0.50 against a 4% band)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-ablation-to-wildtype-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-detail-wavelengths-inside-orena-cell>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-detail-wavelengths-inside-persimilis-primordium>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-dispersion-wavelength-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-interpeak-spacing-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-ocellar-stripe-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-specimen-structure-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-wavelength-rmse-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-ablation-to-wildtype-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_to_wildtype_amplitude_ratio = 1e-05 1" ;
        schema:measurementTechnique "Equal-diffusion (d=1) activator std divided by wild-type (d=36) std; reference 1 would mean the ablation failed" ;
        schema:name "ablation_to_wildtype_amplitude_ratio" ;
        schema:unitText "1" ;
        schema:value "1e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-ablation-to-wildtype-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-ablation-to-wildtype-amplitude-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-detail-wavelengths-inside-orena-cell> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "detail_wavelengths_inside_orena_cell = 37 1" ;
        schema:measurementTechnique "floor(89440 nm / 2417 nm); reference 30 is the round decade, not the packing count" ;
        schema:name "detail_wavelengths_inside_orena_cell" ;
        schema:unitText "1" ;
        schema:value "37" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-detail-wavelengths-inside-orena-cell-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-detail-wavelengths-inside-orena-cell-reference> a schema:PropertyValue ;
        schema:value "30" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-detail-wavelengths-inside-persimilis-primordium> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "detail_wavelengths_inside_persimilis_primordium = 48 1" ;
        schema:measurementTechnique "floor(116700 nm / 2417 nm); reference 40 is not the packing count" ;
        schema:name "detail_wavelengths_inside_persimilis_primordium" ;
        schema:unitText "1" ;
        schema:value "48" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-detail-wavelengths-inside-persimilis-primordium-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-detail-wavelengths-inside-persimilis-primordium-reference> a schema:PropertyValue ;
        schema:value "40" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-dispersion-wavelength-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_wavelength_pearson_r = 0.98908 1" ;
        schema:measurementTechnique "Pearson r of wavelength series (nonlinear_field_vs_continuum); reference is the pass gate, not the measured r" ;
        schema:name "dispersion_wavelength_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.98908" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-dispersion-wavelength-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-dispersion-wavelength-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-interpeak-spacing-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "interpeak_spacing_ks_statistic = 0.5 1" ;
        schema:measurementTechnique "Two-sample KS between midline activator spacings and a 4% band around 2.417 µm" ;
        schema:name "interpeak_spacing_ks_statistic" ;
        schema:unitText "1" ;
        schema:value "0.5" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-interpeak-spacing-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-interpeak-spacing-ks-statistic-reference> a schema:PropertyValue ;
        schema:value "0.45" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-ocellar-stripe-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ocellar_stripe_wavelength_um = 2.41732 µm" ;
        schema:measurementTechnique "Parabolic refinement of the radial FFT peak of the Schnakenberg activator on a 14.502 µm periodic patch" ;
        schema:name "ocellar_stripe_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "2.41732" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-ocellar-stripe-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-ocellar-stripe-wavelength-um-reference> a schema:PropertyValue ;
        schema:value "2.417" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_circularity = 0.5968 1" ;
        schema:measurementTechnique "4πA/P² of the habitus mask; reference is a circular ocellus prior, not this lateral habitus" ;
        schema:name "specimen_contour_circularity" ;
        schema:unitText "1" ;
        schema:value "0.5968" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        schema:value "0.72" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_foreground_fraction = 0.2995 1" ;
        schema:measurementTechnique "Border-median contrast mask on the Haars 2018 male, 160×120; reference is a tight head-crop prior" ;
        schema:name "specimen_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.2995" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        schema:value "0.22" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-specimen-structure-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_structure_coherency = 0.6323 1" ;
        schema:measurementTechnique "Mean structure-tensor coherency inside the specimen mask; reference is a moderate-anisotropy prior" ;
        schema:name "specimen_structure_coherency" ;
        schema:unitText "1" ;
        schema:value "0.6323" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-specimen-structure-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-specimen-structure-coherency-reference> a schema:PropertyValue ;
        schema:value "0.45" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-wavelength-rmse-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength_rmse_um = 0.06438 µm" ;
        schema:measurementTechnique "RMSE between continuum λ_c(Du) and the compared wavelength series" ;
        schema:name "wavelength_rmse_um" ;
        schema:unitText "µm" ;
        schema:value "0.06438" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-wavelength-rmse-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-measurement-wavelength-rmse-um-reference> a schema:PropertyValue ;
        schema:value "0.15" .

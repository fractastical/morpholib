<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-paulistorum-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg trace at the 2.417 µm steady state" ;
    dct:description "Homogeneous ocellar steady state is linearly stable to uniform perturbations at 0 Ma. | Variables: a=0.10, b=0.90, u*=1, v*=0.9, f_u=0.8, g_v=-1" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012; Schnakenberg 1979 doi:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9a9d6408/models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/9a9d6408/morphoeval/lean/loops/Loop_3197_drosophila_paulistorum_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "tr(J) = f_u + g_v = -0.200 < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1039/a702602a>,
        <https://doi.org/10.1073/pnas.45.3.419>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3197.schnakenbergTraceMilli" ;
    pk:leanTheorem "MathOfBiology.Loop_3197.homogeneous_steady_state_is_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-paulistorum-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Positive reaction Jacobian determinant" ;
    dct:description "Saddle structure required before diffusion can destabilise a finite band of wavenumbers. | Variables: f_u=0.800, f_v=1, g_u=-1.800, g_v=-1" ;
    dct:source "Maini, Painter & Chau 1997 doi:10.1039/a702602a" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9a9d6408/models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/9a9d6408/morphoeval/lean/loops/Loop_3197_drosophila_paulistorum_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J) = f_u g_v - f_v g_u = 1 > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1039/a702602a>,
        <https://doi.org/10.1073/pnas.45.3.419>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3197.schnakenbergDetMillion" ;
    pk:leanTheorem "MathOfBiology.Loop_3197.reaction_jacobian_determinant_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-paulistorum-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber numerator at diffusivity ratio 36" ;
    dct:description "Places the Turing wavenumber on the subcellular ocellar pigment rung, not the 91 µm cellular rung. | Variables: d=36, lambda_c=2.417e-6 m" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9a9d6408/models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/9a9d6408/morphoeval/lean/loops/Loop_3197_drosophila_paulistorum_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "d f_u + g_v > 0, k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2.417 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1039/a702602a>,
        <https://doi.org/10.1073/pnas.45.3.419>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3197.diffusionNumeratorMilli" ;
    pk:leanTheorem "MathOfBiology.Loop_3197.critical_wavenumber_numerator_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-paulistorum-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail rung versus orena and persimilis" ;
    dct:description "Formalises the scale change at chronoseries position 26/41 against the catalog predecessor and successor. | Variables: lambda_nm=2417, orena_nm=89440, persimilis_nm=116700, age_ma=0" ;
    dct:source "Dobzhansky & Spassky 1959 doi:10.1073/pnas.45.3.419" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9a9d6408/models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/9a9d6408/morphoeval/lean/loops/Loop_3197_drosophila_paulistorum_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "2417*37 = 89429 < 89440 (orena); 2417*48 = 116016 < 116700 (persimilis); 2417*6 = 14502" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1039/a702602a>,
        <https://doi.org/10.1073/pnas.45.3.419>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3197.detail_scale_shorter_than_orena_cellular" ;
    pk:leanTheorem "MathOfBiology.Loop_3197.six_wavelengths_tile_ocellar_patch" ;
    pk:leanVerified true .


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila paulistorum Schnakenberg ocellar stripe at 2.4 µm (Pass 1) — Morphometric validation: 68/100" ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Ceratites nodosus Schnakenberg Turing wavenumber at 26 µm (Ladinian, 240 Ma) — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Continuous 30-mode Pearson r is 0.990 and the 2D FFT peak is 2.56e-05 m. Discrete unstable-band r is 1.000. Specimen circularity 0.659 (reference 1), foreground 0.505 (reference 0.70), coherency 0.522 (reference 0.25), radial KS 0.936, orientation cosine 0.995 (reference 1), row-wise wavelength CV 0.675 (reference 0). None of these specimen comparisons copy the reference onto the value." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-cellular-wavelengths-across-the-32-mm-shell>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-dispersion-pearson-r-continuous-k-vs-euler-mode>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-equal-diffusion-ablation-final-initial-amplitude>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-row-wise-wavelength-coefficient-of-variation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-segmented-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-segmented-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-selected-wavelength-on-the-96-mantle-patch>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-shell-stripe-radial-spectrum-ks-distance>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-specimen-shell-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-specimen-versus-field-12-bin-orientation-cosine>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-subcritical-domain-ablation-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-unstable-band-pearson-r-versus-discrete-jacobian-eigenvalue>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-cellular-wavelengths-across-the-32-mm-shell> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cellular wavelengths across the 32 mm shell = 1250 count" ;
        dct:description "successor Dactylioceras commune holds 1641; organ-scale rib holds 42" ;
        schema:measurementTechnique "N = round(0.032 / 2.56e-05)" ;
        schema:name "cellular wavelengths across the 32 mm shell" ;
        schema:unitText "count" ;
        schema:value "1250" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-cellular-wavelengths-across-the-32-mm-shell-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-cellular-wavelengths-across-the-32-mm-shell-reference> a schema:PropertyValue ;
        dct:source "Goniatites crenistria predecessor at the same 26 µm wavelength (18 mm shell)" ;
        schema:value "703" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-dispersion-pearson-r-continuous-k-vs-euler-mode> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion Pearson r, continuous σ(k) vs Euler mode = 0.990228 correlation" ;
        dct:description "unstable-band r = 0.9644; RMSE band = 0.0026" ;
        schema:measurementTechnique "one-step explicit Euler on periodic Fourier modes versus analytic Turing growth rate" ;
        schema:name "dispersion Pearson r, continuous σ(k) vs Euler mode" ;
        schema:unitText "correlation" ;
        schema:value "0.990228" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-dispersion-pearson-r-continuous-k-vs-euler-mode-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-dispersion-pearson-r-continuous-k-vs-euler-mode-reference> a schema:PropertyValue ;
        dct:source "exact eigenmode of the continuous Jacobian" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 0.500082 1/s" ;
        dct:description "stiff decaying modes dominate RMSE; the unstable band is tighter" ;
        schema:measurementTechnique "root mean square of analytic minus measured growth rate over 30 modes" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/s" ;
        schema:value "0.500082" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "continuous dispersion relation" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-equal-diffusion-ablation-final-initial-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation final/initial amplitude = 0.0 ratio" ;
        dct:description "sigma_max = -0.2819" ;
        schema:measurementTechnique "Schnakenberg with Dv = Du, 1500 steps, seed 3143" ;
        schema:name "equal-diffusion ablation final/initial amplitude" ;
        schema:unitText "ratio" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-equal-diffusion-ablation-final-initial-amplitude-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-equal-diffusion-ablation-final-initial-amplitude-reference> a schema:PropertyValue ;
        dct:source "marginal control would hold the amplitude; decay is the Turing-off prediction" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-row-wise-wavelength-coefficient-of-variation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "row-wise wavelength coefficient of variation = 0.67514 CV" ;
        dct:description "row mean = 4.148063e-05 m over 96 rows" ;
        schema:measurementTechnique "std/mean of the dominant 1D wavelength on each row of the saturated mantle patch" ;
        schema:name "row-wise wavelength coefficient of variation" ;
        schema:unitText "CV" ;
        schema:value "0.67514" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-row-wise-wavelength-coefficient-of-variation-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-row-wise-wavelength-coefficient-of-variation-reference> a schema:PropertyValue ;
        dct:source "a single exact wavelength on every row" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-segmented-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented specimen foreground fraction = 0.505365 fraction" ;
        schema:measurementTechnique "same mask as the circularity measurement" ;
        schema:name "segmented specimen foreground fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.505365" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-segmented-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-segmented-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "prior for a shell that fills the frame; the photograph includes black ground and a label" ;
        schema:value "0.7" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-segmented-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented specimen structure-tensor coherency = 0.521862 dimensionless" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) of the Sobel structure tensor inside the shell mask" ;
        schema:name "segmented specimen structure-tensor coherency" ;
        schema:unitText "dimensionless" ;
        schema:value "0.521862" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-segmented-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-segmented-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "near-isotropic texture prior" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-selected-wavelength-on-the-96-mantle-patch> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "selected wavelength on the 96² mantle patch = 2.6e-05 m" ;
        dct:description "ratio to target = 1.0000" ;
        schema:measurementTechnique "radial FFT peak of the saturated Schnakenberg activator" ;
        schema:name "selected wavelength on the 96² mantle patch" ;
        schema:unitText "m" ;
        schema:value "2.6e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-selected-wavelength-on-the-96-mantle-patch-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-selected-wavelength-on-the-96-mantle-patch-reference> a schema:PropertyValue ;
        dct:source "slot scale 2.56e-05 m" ;
        schema:value "2.56e-05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-shell-stripe-radial-spectrum-ks-distance> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "shell stripe radial-spectrum KS distance = 0.93625 KS statistic" ;
        schema:measurementTechnique "two-sample KS between radial Fourier densities of the photograph and the simulated mantle field" ;
        schema:name "shell stripe radial-spectrum KS distance" ;
        schema:unitText "KS statistic" ;
        schema:value "0.93625" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-shell-stripe-radial-spectrum-ks-distance-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-shell-stripe-radial-spectrum-ks-distance-reference> a schema:PropertyValue ;
        dct:source "identical spectra would give KS = 0; the fossil does not resolve 26 µm pigment" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-specimen-shell-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen shell contour circularity = 0.659446 4 pi A / P^2" ;
        dct:description "aspect ratio = 1.2667" ;
        schema:measurementTechnique "border-contrast mask on the vendored Ceratites nodosus photograph, 160×120" ;
        schema:name "specimen shell contour circularity" ;
        schema:unitText "4 pi A / P^2" ;
        schema:value "0.659446" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-specimen-shell-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-specimen-shell-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "circle null; a planispiral shell with an umbilicus is not a disk" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-specimen-versus-field-12-bin-orientation-cosine> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen versus field 12-bin orientation cosine = 0.994843 cosine" ;
        dct:description "the fossil's ribs and the cellular ocelli do not share an orientation spectrum" ;
        schema:measurementTechnique "Sobel orientation histograms (12 bins) of the shell photograph and the simulated activator" ;
        schema:name "specimen versus field 12-bin orientation cosine" ;
        schema:unitText "cosine" ;
        schema:value "0.994843" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-specimen-versus-field-12-bin-orientation-cosine-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-specimen-versus-field-12-bin-orientation-cosine-reference> a schema:PropertyValue ;
        dct:source "identical edge-angle mixes" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-subcritical-domain-ablation-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "subcritical-domain ablation amplitude ratio = 0.050901 ratio" ;
        dct:description "sigma(k_min) = -0.9725" ;
        schema:measurementTechnique "Schnakenberg on a patch 0.45 wavelengths across, so the fundamental mode is stable" ;
        schema:name "subcritical-domain ablation amplitude ratio" ;
        schema:unitText "ratio" ;
        schema:value "0.050901" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-subcritical-domain-ablation-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-subcritical-domain-ablation-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "a domain that admits an unstable mode would not decay" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-unstable-band-pearson-r-versus-discrete-jacobian-eigenvalue> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "unstable-band Pearson r versus discrete Jacobian eigenvalue = 1.0 correlation" ;
        dct:description "RMSE = 8.432e-14; continuous-symbol band r = 0.9759 (stencil truncation, RMSE 0.0037)" ;
        schema:measurementTechnique "one Euler step on resolved modes of a 32-wavelength patch versus ln(1+dt*sigma_discrete)/dt" ;
        schema:name "unstable-band Pearson r versus discrete Jacobian eigenvalue" ;
        schema:unitText "correlation" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-unstable-band-pearson-r-versus-discrete-jacobian-eigenvalue-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-measurement-unstable-band-pearson-r-versus-discrete-jacobian-eigenvalue-reference> a schema:PropertyValue ;
        dct:source "Pass-2 gate on the discrete unstable band; 1.0 would be a perfect eigenmode match" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py L318–L370" ;
        dct:description "segment_specimen and ks_radial" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/040c297c78d4c53dd775f1fcd23b9440ae0558db/models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py#L318-L370> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py L607–L619" ;

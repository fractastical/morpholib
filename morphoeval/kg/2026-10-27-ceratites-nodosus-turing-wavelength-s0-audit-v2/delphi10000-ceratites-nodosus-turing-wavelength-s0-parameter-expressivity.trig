sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Ceratites nodosus Schnakenberg Turing wavenumber at 26 µm (Ladinian, 240 Ma) — Parameter expressivity: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The sweep at fixed Du lengthens lambda from 25.1 to 28.2 µm as gamma/gamma_onset goes from 1.08 to 1.90. --gamma-factor 1.55 keeps Du and moves the simulated wavelength to 29.3 µm (ratio 1.143). Equal diffusion and a subcritical domain both decay." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-parameter-expressivity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-parameter-expressivity-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py L254–L304" ;
        dct:description "sweep and equal-diffusion control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/040c297c78d4c53dd775f1fcd23b9440ae0558db/models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py#L254-L304> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py L556–L581" ;
        dct:description "subcritical_domain_control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/040c297c78d4c53dd775f1fcd23b9440ae0558db/models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py#L556-L581> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py L896–L923" ;
        dct:description "--gamma-factor holds Du fixed and the self-test requires lambda to move" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/040c297c78d4c53dd775f1fcd23b9440ae0558db/models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py#L896-L923> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;

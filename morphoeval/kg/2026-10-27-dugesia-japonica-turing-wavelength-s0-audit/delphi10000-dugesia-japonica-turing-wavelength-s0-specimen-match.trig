sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Saturated Schnakenberg Turing wavelength for Dugesia japonica dorsal pigment at 6.912 µm (Holocene, Pass 1) — Morphological realism / specimen match: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The GIF and the comparison panel place the pigment field inside segmented bodies from the Nogi plate, with a bright rim and dark cups. The mask merges animals that are separate on the plate, and the field is a magnified motif, not a resolution-matched micrograph. Still clearly a planarian pigment plate rather than an abstract plot." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/dugesia_japonica_turing_wavelength_s0_growth.gif (generated output)" ;
        dct:description "16-frame 640 px animation, CV similarity 94.7 against the Nogi plate — docs/media/dugesia_japonica_turing_wavelength_s0_growth.gif: rendered output of models/2026-delphi10000-dugesia-japonica-turing-wavelength-s0.py at e4ebf5f02021c5cb9f6779addaebe15739877255, image/gif, 1099037 B, 640×640 px, 16 frames, artifact_sha256 810e44644592871faa7b1ada532c2f82f9de71ab60a28288c783a41f0c149110 (sha256 810e44644592871faa7b1ada532c2f82f9de71ab60a28288c783a41f0c149110), spec_fingerprint 69b07407b41111e3df409d09d284c8ed47d97c6e78075bf3f4f35e0a79d838da" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dugesia-japonica-turing-wavelength-s0.py L365–L456" ;

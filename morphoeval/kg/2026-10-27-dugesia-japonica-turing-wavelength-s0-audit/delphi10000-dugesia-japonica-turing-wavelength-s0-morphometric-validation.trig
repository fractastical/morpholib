sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Saturated Schnakenberg Turing wavelength for Dugesia japonica dorsal pigment at 6.912 µm (Holocene, Pass 1) — Morphometric validation: 80/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Linear dispersion Pearson r = 0.99998 against analytic σ(k_disc), ablation max σ = -0.565, body-mask circularity 0.261 versus an ellipse reference 0.55, and 7 ocelli versus the wild-type pair of 2. Missing a KS histogram test and the nonlinear steady-state wavelength." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-growth-rate-versus-operating-turing-gap>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-linear-dispersion-growth-rate-pearson-r-numeric-modes-vs-analytic-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-specimen-image-body-mask-circularity-of-dugesia-japonica-nogi-2009-plate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-specimen-image-ocellus-pigment-cup-count-on-the-nogi-plate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-turing-critical-wavelength-lambda-c-of-dugesia-japonica-pigment-field>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-growth-rate-versus-operating-turing-gap> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation max growth rate versus operating Turing gap = -0.56518 1/time" ;
        dct:description "ablation gap numerator = -1.1304 (negative control); operating gap = 20.8679" ;
        schema:measurementTechnique "Analytic dispersion over k in [0, 3] /µm with D_u = D_v" ;
        schema:name "equal-diffusion ablation max growth rate versus operating Turing gap" ;
        schema:unitText "1/time" ;
        schema:value "-0.56518" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-growth-rate-versus-operating-turing-gap-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-growth-rate-versus-operating-turing-gap-reference> a schema:PropertyValue ;
        dct:source "Operating-point σ(k_c) at D_v/D_u = 48; ablation sets D_v = D_u" ;
        schema:value "0.05657" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-linear-dispersion-growth-rate-pearson-r-numeric-modes-vs-analytic-sigma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "linear dispersion growth-rate Pearson r (numeric modes vs analytic sigma) = 0.99998 Pearson_r" ;
        dct:description "RMSE = 0.00539; p = 4.694e-19; σ(k_c) = 0.0566" ;
        schema:measurementTechnique "1D periodic Schnakenberg, modes 2–12, log-amplitude slope versus σ(k_disc)" ;
        schema:name "linear dispersion growth-rate Pearson r (numeric modes vs analytic sigma)" ;
        schema:unitText "Pearson_r" ;
        schema:value "0.99998" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-linear-dispersion-growth-rate-pearson-r-numeric-modes-vs-analytic-sigma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-linear-dispersion-growth-rate-pearson-r-numeric-modes-vs-analytic-sigma-reference> a schema:PropertyValue ;
        dct:source "MorphoEval gate: integrated Fourier-mode growth versus the linear dispersion relation" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-specimen-image-body-mask-circularity-of-dugesia-japonica-nogi-2009-plate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image body-mask circularity of Dugesia japonica Nogi 2009 plate = 0.2609 4πA/P²" ;
        dct:description "foreground fraction 0.319; bodies 2; ocelli 7" ;
        schema:measurementTechnique "Otsu-style brightness mask on the CC-BY Nogi plate, filled, circularity 4πA/P²" ;
        schema:name "specimen image body-mask circularity of Dugesia japonica Nogi 2009 plate" ;
        schema:unitText "4πA/P²" ;
        schema:value "0.2609" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-specimen-image-body-mask-circularity-of-dugesia-japonica-nogi-2009-plate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-specimen-image-body-mask-circularity-of-dugesia-japonica-nogi-2009-plate-reference> a schema:PropertyValue ;
        dct:source "Independent ellipse model of one planarian body at aspect ~2.4 (circularity 0.55), not the measured mask" ;
        schema:value "0.55" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-specimen-image-ocellus-pigment-cup-count-on-the-nogi-plate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image ocellus pigment-cup count on the Nogi plate = 7 count" ;
        dct:description "value differs from the wild-type pair on purpose: the plate shows regenerated heads" ;
        schema:measurementTechnique "Dark connected components (area 8–800 px) inside the eroded body mask" ;
        schema:name "specimen image ocellus pigment-cup count on the Nogi plate" ;
        schema:unitText "count" ;
        schema:value "7" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-specimen-image-ocellus-pigment-cup-count-on-the-nogi-plate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-specimen-image-ocellus-pigment-cup-count-on-the-nogi-plate-reference> a schema:PropertyValue ;
        dct:source "Wild-type Dugesia carries one pair of ocelli; the Nogi plate is a praziquantel-regeneration figure and is not that count" ;
        schema:value "2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-turing-critical-wavelength-lambda-c-of-dugesia-japonica-pigment-field> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing critical wavelength lambda_c of Dugesia japonica pigment field = 6.912 µm" ;
        dct:description "log10(length/m) = -5.160; age 0 Ma; chronoseries 1/1" ;
        schema:measurementTechnique "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v) with D_u solved at diffusion ratio 48, κ = 0.15" ;
        schema:name "Turing critical wavelength lambda_c of Dugesia japonica pigment field" ;
        schema:unitText "µm" ;
        schema:value "6.912" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-turing-critical-wavelength-lambda-c-of-dugesia-japonica-pigment-field-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-measurement-turing-critical-wavelength-lambda-c-of-dugesia-japonica-pigment-field-reference> a schema:PropertyValue ;
        dct:source "Slot scale 6.9 µm (6.912 µm operating point). The reference is the rounded tier label; the model value is the exact critical wavelength." ;
        schema:value "6.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dugesia-japonica-turing-wavelength-s0.py L294–L340" ;
        dct:description "linear_dispersion_fit and ablation_equal_diffusion" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e4ebf5f02021c5cb9f6779addaebe15739877255/models/2026-delphi10000-dugesia-japonica-turing-wavelength-s0.py#L294-L340> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dugesia-japonica-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dugesia-japonica-turing-wavelength-s0.py L586–L636" ;
        dct:description "measure_morphoeval returns wavelength, r, ablation, circularity, ocellus count" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e4ebf5f02021c5cb9f6779addaebe15739877255/models/2026-delphi10000-dugesia-japonica-turing-wavelength-s0.py#L586-L636> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; Pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


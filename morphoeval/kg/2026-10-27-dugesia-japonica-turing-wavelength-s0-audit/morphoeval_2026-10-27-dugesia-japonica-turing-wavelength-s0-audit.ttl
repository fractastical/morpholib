<https://w3id.org/delphi/resource/math-law/delphi10000-dugesia-japonica-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diffusion-weighted Turing gap at R = 48" ;
    dct:description "Necessary condition for a 6.912 µm unstable band in Holocene Dugesia japonica pigment kinetics | Variables: r = 48, f_u milli-rate 468, inhibitor removal milli-rate 1598" ;
    dct:source "Schnakenberg 1979 doi:10.1016/0022-5193(79)90042-0; Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e4ebf5f02021c5cb9f6779addaebe15739877255/models/2026-delphi10000-dugesia-japonica-turing-wavelength-s0.py#L139-L156>,
        <https://github.com/fractastical/morpholib/blob/e4ebf5f02021c5cb9f6779addaebe15739877255/morphoeval/lean/loops/Loop_3213_dugesia_japonica_turing_wavelength_s0.lean#L17-L19> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_v f_u + D_u g_v > 0, integer shadow 48*468 - 1598 > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.celrep.2012.06.018>,
        <https://doi.org/10.1016/j.jtbi.2019.110042>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pntd.0000464>,
        <https://doi.org/10.1387/ijdb.072502sk>,
        <https://doi.org/10.2108/zsj.19.1123> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3213.turing_gap" ;
    pk:leanTheorem "MathOfBiology.Loop_3213.slot3213_diffusion_gap_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-dugesia-japonica-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homogeneous steady state is stable without diffusion" ;
    dct:description "Diffusion, not the reaction trace, is what destabilises the uniform pigment state | Variables: trace of the saturated Jacobian at (u0, v0)" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e4ebf5f02021c5cb9f6779addaebe15739877255/models/2026-delphi10000-dugesia-japonica-turing-wavelength-s0.py#L122-L137>,

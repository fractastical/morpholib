sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-streichan-global-morphogenetic-flow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Streichan et al. (2018), Mayer et al. (2010) & Lefebvre et al. (2023) Drosophila global morphogenetic flow & active nematic myosin tensor mechanics — Parameter expressivity: 56/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates 3 regimes in Pass 1, requiring expansion to all 6 Streichan et al. (2018) wild-type and mutant regimes plus a 2D morphospace sweep over hydrodynamic screening length `ell_H = sqrt(eta/xi)` and bulk-to-shear viscosity ratio `eta_b/eta`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2018-streichan-global-morphogenetic-flow.py L89–L118: 3-regime baseline lacking twist/snail, eve, and 2D (ell_H x eta_b/eta) morphospace <https://github.com/fractastical/morpholib/blob/317bc3c/2018-streichan-global-morphogenetic-flow.py#L89-L118>" ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/nature09376>,
            <https://doi.org/10.7554/eLife.27454>,
            <https://doi.org/10.7554/eLife.78787>,
            <https://doi.org/10.7554/eLife.95521> .
    <https://doi.org/10.1038/nature09376> dct:date "2010"^^xsd:gYear ;
        dct:title "Anisotropies in cortical tension reveal the physical basis of polarizing cortical flows" .
    <https://doi.org/10.7554/eLife.27454> dct:date "2018"^^xsd:gYear ;
        dct:title "Global morphogenetic flow is accurately predicted by the spatial distribution of myosin" .
    <https://doi.org/10.7554/eLife.78787> dct:date "2023"^^xsd:gYear ;
        dct:title "Geometric control of myosin II orientation during axis elongation" .
    <https://doi.org/10.7554/eLife.95521> dct:date "2024"^^xsd:gYear ;
        dct:title "The geometric basis of epithelial convergent extension" .
}


<https://w3id.org/probknow/resource/claim/morphoeval-streichan-global-morphogenetic-flow> a pk:Claim ;
    rdfs:label "Streichan et al. (2018), Mayer et al. (2010) & Lefebvre et al. (2023) Drosophila global morphogenetic flow & active nematic myosin tensor mechanics (Drosophila melanogaster (whole-embryo cellular blastoderm & germband extension stages 6-8))",
        "Streichan et al. (2018), Mayer et al. (2010) & Lefebvre et al. (2023) Drosophila global morphogenetic flow & active nematic myosin tensor mechanics faithfully reproduces Drosophila melanogaster (whole-embryo cellular blastoderm & germband extension stages 6-8) morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/streichan-global-morphogenetic-flow-1>,
        <https://w3id.org/probknow/resource/math-law/streichan-global-morphogenetic-flow-2>,
        <https://w3id.org/probknow/resource/math-law/streichan-global-morphogenetic-flow-3> ;
    dct:description "The simulation script(s) 2018-streichan-global-morphogenetic-flow.py implement the cited source model as published and produce forms that match real Drosophila melanogaster (whole-embryo cellular blastoderm & germband extension stages 6-8) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 57.6/100, audit 2026-10-19-global-morphogenetic-flow-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2018-streichan-global-morphogenetic-flow.py> ;
    schema:about "Drosophila melanogaster (whole-embryo cellular blastoderm & germband extension stages 6-8)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2018-streichan-global-morphogenetic-flow.py; output: docs/media/global_morphogenetic_flow_comparison.png; organism: Drosophila melanogaster (whole-embryo cellular blastoderm & germband extension stages 6-8); checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: c6f91e927b85c9e6c96461d53e4ae9c082d9c0ad9d74ed650b6b2f21fb08b782; artifact_sha256: e49de2ffd51715699c93a4084da3c75feeee4b0616b78e3b91f8f271da2feb7e; input_dataset_sha256: {datasets/global_morphogenetic_flow/drosophila_germband_extension_specimen.jpg=2d7fad8f57edcadf..., datasets/global_morphogenetic_flow/global_morphogenetic_flow_reference.json=160ead86ff9c447b..., datasets/global_morphogenetic_flow/scout_manifest.json=990f3ea83019f3d1...}" ;
    pk:derivedFromPaper <https://doi.org/10.1038/nature09376>,
        <https://doi.org/10.7554/eLife.27454>,
        <https://doi.org/10.7554/eLife.78787>,
        <https://doi.org/10.7554/eLife.95521> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-model-fidelity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-morphometric-validation>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-overall>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-parameter-expressivity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-global-morphogenetic-flow-audit-streichan-global-morphogenetic-flow-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-global-morphogenetic-flow-audit-streichan-global-morphogenetic-flow-2>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-global-morphogenetic-flow-audit-streichan-global-morphogenetic-flow-3> ;
    pk:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
    pk:weightOfEvidence 5.76e-01 .


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-streichan-global-morphogenetic-flow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Streichan et al. (2018), Mayer et al. (2010) & Lefebvre et al. (2023) Drosophila global morphogenetic flow & active nematic myosin tensor mechanics — Morphometric validation: 55/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Provides 3 baseline measurements in `measure_morphoeval()`, requiring expansion to 7 quantitative morphometric benchmarks spanning 6-regime velocity and flow correlation benchmarks plus confocal specimen morphometrics." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2018-streichan-global-morphogenetic-flow.py L121–L160: Baseline measure_morphoeval() with 3 script metrics <https://github.com/fractastical/morpholib/blob/317bc3c/2018-streichan-global-morphogenetic-flow.py#L121-L160>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-bcd-nos-tsl-maternal-triple-mutant-peak-ap-velocity>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-isotropic-only-myosin-assumption-peak-ap-velocity>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-wild-type-global-morphogenetic-flow-spatial-correlation-r> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-bcd-nos-tsl-maternal-triple-mutant-peak-ap-velocity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "bcd nos tsl maternal triple mutant peak AP velocity = 0.0 um/min" ;
        dcterms:description "Complete collapse of posterior-directed germband extension flow" ;
        schema:measurementTechnique "Baseline Pass 1 maternal AP-null triple mutant control (Q_ij = 0, m_pmg = 0)" ;
        schema:name "bcd nos tsl maternal triple mutant peak AP velocity" ;
        schema:unitText "um/min" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-bcd-nos-tsl-maternal-triple-mutant-peak-ap-velocity-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-bcd-nos-tsl-maternal-triple-mutant-peak-ap-velocity-reference> a schema:PropertyValue ;
        dcterms:source "Streichan et al. (2018) eLife 7:e27454 Fig. 4" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-isotropic-only-myosin-assumption-peak-ap-velocity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "isotropic-only myosin assumption peak AP velocity = 2.15 um/min" ;
        dcterms:description "Without anisotropic DV cables, global GBE flow drops to 2.15 um/min" ;
        schema:measurementTechnique "Baseline Pass 1 isotropic myosin test without DV nematic tensor Q_ij" ;
        schema:name "isotropic-only myosin assumption peak AP velocity" ;
        schema:unitText "um/min" ;
        schema:value "2.15" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-isotropic-only-myosin-assumption-peak-ap-velocity-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-isotropic-only-myosin-assumption-peak-ap-velocity-reference> a schema:PropertyValue ;
        dcterms:source "Streichan et al. (2018) eLife 7:e27454 Fig. 2" ;
        schema:value "2.15" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-wild-type-global-morphogenetic-flow-spatial-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type global morphogenetic flow spatial correlation r = 0.924 correlation_r" ;
        dcterms:description "WT peak posterior GBE speed = 6.40 um/min" ;
        schema:measurementTechnique "Baseline Pass 1 active nematic myosin flow correlation against Streichan et al. (2018)" ;
        schema:name "wild-type global morphogenetic flow spatial correlation r" ;
        schema:unitText "correlation_r" ;
        schema:value "0.924" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-wild-type-global-morphogenetic-flow-spatial-correlation-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-wild-type-global-morphogenetic-flow-spatial-correlation-r-reference> a schema:PropertyValue ;
        dcterms:source "Streichan et al. (2018) eLife 7:e27454 Fig. 2" ;
        schema:value "0.924" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-streichan-global-morphogenetic-flow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Streichan et al. (2018), Mayer et al. (2010) & Lefebvre et al. (2023) Drosophila global morphogenetic flow & active nematic myosin tensor mechanics — Model fidelity to source: 60/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements trace-free active nematic stress tensor construction `Q_xx + Q_yy = 0` (L67-86), but Pass 1 uses analytic velocity profiles rather than solving the 2D compressible Stokes-Brinkman PDE in Fourier/spectral space and integrating Lagrangian germband extension trajectories." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2018-streichan-global-morphogenetic-flow.py L89–L118: Baseline analytic velocity profiles requiring explicit 2D spectral Stokes-Brinkman PDE solver <https://github.com/fractastical/morpholib/blob/317bc3c/2018-streichan-global-morphogenetic-flow.py#L89-L118>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-model-fidelity-1> ;
        pk:hasScore "0.6"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2018-streichan-global-morphogenetic-flow.py L67–L86" ;
        dcterms:description "Trace-free active nematic stress tensor helper" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2018-streichan-global-morphogenetic-flow.py#L67-L86> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}

sub1:provenance {
    <https://doi.org/10.1038/nature09376> dcterms:date "2010"^^xsd:gYear ;
        dcterms:title "Anisotropies in cortical tension reveal the physical basis of polarizing cortical flows" .

    <https://doi.org/10.7554/eLife.27454> dcterms:date "2018"^^xsd:gYear ;
        dcterms:title "Global morphogenetic flow is accurately predicted by the spatial distribution of myosin" .

    <https://doi.org/10.7554/eLife.78787> dcterms:date "2023"^^xsd:gYear ;
        dcterms:title "Geometric control of myosin II orientation during axis elongation" .

    <https://doi.org/10.7554/eLife.95521> dcterms:date "2024"^^xsd:gYear ;
        dcterms:title "The geometric basis of epithelial convergent extension" .

    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/nature09376>,
            <https://doi.org/10.7554/eLife.27454>,
            <https://doi.org/10.7554/eLife.78787>,
            <https://doi.org/10.7554/eLife.95521> .
}


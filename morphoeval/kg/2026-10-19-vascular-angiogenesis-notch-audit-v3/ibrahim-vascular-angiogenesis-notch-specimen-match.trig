sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ibrahim-vascular-angiogenesis-notch> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Bentley, Gerhardt & Bates (2008) PLoS Comput. Biol., Hellström et al. (2007) Nature & Jakobsson et al. (2010) Nat. Cell Biol. VEGF-VEGFR2-Dll4-Notch1 tip/stalk salt-and-pepper lateral inhibition and angiogenic sprouting, coupled to lumenized Poiseuille flow, wall-shear pruning and arteriovenous specification (Pass 3) — Morphological realism / specimen match: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The SHA-256-verified CC BY 4.0 Homo sapiens HUVEC angiogenic sprouting micrograph is segmented as in v2 (plexus density 0.1967, 69 junctions, 58 tips, tip/junction 0.8406, inter-tip NND CV 0.7003; L1384-1463) and shown in Panel F of the regenerated 3x3 figure, whose Panels G-I now render the lumenized plexus before and after pruning with wall-shear and AV-identity colouring, the six pruning cascades, and the k_t coupling sweep; the new pruning GIF (25 frames) animates the cascade. Deductions: no specimen or published micrograph of a perfused/pruned plexus or of ephrinB2/EphB4 segregation is vendored, so the entire hemodynamic layer is validated against literature bands only (-6); the WT survivor pattern in Panel G clusters near the arteriolar inlet with one 9 um rung, which does not resemble a retinal capillary bed (-3); the HUVEC specimen is a 2D in-vitro cord network without lumen or flow, so it cannot inform the Pass 3 mechanism at all (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/vascular_angiogenesis_notch/hemodynamic_pruning_av_specification_reference.json L79–L87: Hemodynamic reference values are bands / qualitative statements (WSS 1-2 Pa, density ratio 1.3-2.0, 'collapse to single shunt'); no perfused-plexus specimen <https://github.com/fractastical/morpholib/blob/45670cb8/datasets/vascular_angiogenesis_notch/hemodynamic_pruning_av_specification_reference.json#L79-L87>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-specimen-match-4> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L1384–L1463" ;
        dct:description "Calcein fluorescence plexus segmentation, medial-axis skeletonization, 69 junctions and 58 tips (unchanged from v2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L1384-L1463> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L1886–L1990" ;
        dct:description "Panels G (plexus t=0 / remodelled / AV identity), H (six pruning cascades), I (k_t coupling sweep + perfusion-pressure inset)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L1886-L1990> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L1608–L1648" ;
        dct:description "render_pruning_gif: 25-frame pruning-cascade animation of the WT plexus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L1608-L1648> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/vascular_angiogenesis_notch_comparison.png (generated output)" ;
        dct:description "9-panel comparison figure; Panel F is the only specimen comparison, Panels G-I are compared to literature bands, not to a perfused-plexus specimen — docs/media/vascular_angiogenesis_notch_comparison.png: rendered output of 2021-ibrahim-vascular-angiogenesis-notch.py at 45670cb8, image/png, 983086 B, 2490×2295 px, artifact_sha256 fd3c85687efc1287ea9c3e8f2cd276efc5cd31cc00709058be54738c071ff2f6 (sha256 fd3c85687efc1287ea9c3e8f2cd276efc5cd31cc00709058be54738c071ff2f6), spec_fingerprint 31f617f2809746d8f47765027c2e4f33a695caa68552a3da1ad8254312629dce" .

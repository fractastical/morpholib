sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ibrahim-vascular-angiogenesis-notch> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L182–L224" ;
        dcterms:description "Brillouin k = pi antisymmetric instability margin and sFlt1 decoy window verifier (Lean Theorems 1 & 3)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L182-L224> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L245–L483" ;
        dcterms:description "M = 16 VEGFR2-Dll4-Notch1 ODE network + 2D filopodial sprout elongation; now also returns tip_activity / adj_tip_crowd for the lumen coupling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L245-L483> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L641–L662" ;
        dcterms:description "Pries, Secomb & Gaehtgens pressure-dependent wall-shear set point tau_e(P) in Pa (1.4 Pa @10 mmHg, 3.9 @30, 10 @100)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L641-L662> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L773–L845" ;
        dcterms:description "Exact Hagen-Poiseuille / Kirchhoff resistor-network solve, tau = 4 mu |Q| / (pi r^3), returns node residual" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L773-L845> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L912–L1198" ;
        dcterms:description "Pries log-sensing adaptation + metabolic stimulus + shrinkage bias, pruning below r_min (alive[e]=False L1015), Notch-gated logistic AV readout (notch_norm L1053, av_index L1106)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L912-L1198> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity-6> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_060_vascular_angiogenesis_notch.lean L48–L233" ;
        dcterms:description "5 machine-checked theorems (0 sorrys): Brillouin symmetry breaking, DAPT all-tip collapse, sFlt1 rescue, murray_cube_law_from_uniform_wall_shear (L152-189), franco_pruning_flow_stealing_cascade (L193-231)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_060_vascular_angiogenesis_notch.lean#L48-L233> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 060 Pass 3 Assessor, Phase B subagent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Bentley, Gerhardt & Bates (2008) PLoS Comput. Biol., Hellström et al. (2007) Nature & Jakobsson et al. (2010) Nat. Cell Biol. VEGF-VEGFR2-Dll4-Notch1 tip/stalk salt-and-pepper lateral inhibition and angiogenic sprouting, coupled to lumenized Poiseuille flow, wall-shear pruning and arteriovenous specification (Pass 3) — Model fidelity to source: 85/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the Brillouin k = pi stability verifier (L182-224), the M = 16 VEGFR2-Dll4-Notch1 + 2D sprouting solver (L245-483), and the new hemodynamic layer — an exact Poiseuille/Kirchhoff resistor solve (L773-845), the Pries set point tau_e(P) implemented as published (L641-662), log-sensing adaptation with metabolic stimulus and shrinkage bias plus topological pruning (L912-1198), a Notch -> lumen coupling point (L665-690), and the shear-only-shunt / uniform-shear / no-flow ablations (L1210-1240) whose outcomes match Pries 1998 and Chen 2012 qualitatively; five Lean 4 theorems (0 sorrys) formalise the mechanisms. Deductions: `evaluate_notch_gain_sweep` simulates only k_t = 0 and returns closed-form Hill templates (`hill_rec`, `hill_alt`, L1337-1349) for the other 7 points, so Panel C and measurement 7 are not model output (-6); `simulate_vessel_notch_sprouting` carries regime-specific hard-coded branches — the Dll4+/- quartet mask forcing 75% tips (L313, L327-333, L370), a prescribed high-VEGF sinusoid (L339), hand-set mosaic targets n_target[14]/[15] (L347-348), and the DAPT state overwritten each step (L378-380) — so the benchmark regimes are steered rather than emergent (-6); the WT Murray exponent is 3.53 (+18%) and the remodelled bed keeps one dominant proximal rung at the 9 um radius clip, contradicting the counter-current comment (L761-765) that competition is calibre- not position-dependent (-2); the AV readout is one-way (no shear -> Dll4/Notch feedback), the ladder topology is imposed and the plexus is quasi-static with constant viscosity (-1, disclosed at L525-534)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2021-ibrahim-vascular-angiogenesis-notch.py L1308–L1377: evaluate_notch_gain_sweep: only k_t = 0 calls the simulator; k_t > 0 uses closed-form Hill templates hill_rec / hill_alt (L1337-1349) <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L1308-L1377>",
            "2021-ibrahim-vascular-angiogenesis-notch.py L313–L380: Regime-specific hard-coded branches: is_dll4_haplo quartet mask (L313, L327-333), 0.78*d_target (L370), high-VEGF osc_drive sinusoid (L339), mosaic n_target[14]/[15] (L347-348), DAPT state forced each step (L378-380) <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L313-L380>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity-6> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


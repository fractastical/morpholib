sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ibrahim-vascular-angiogenesis-notch> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L1–L100" ;
        dcterms:description "Module docstring: equation-to-paper traceability for Sections 2-3b and file#line pins to the 5 Lean theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L1-L100> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L519–L535" ;
        dcterms:description "Section 3b banner: explicit reduced-model scope and residuals (no Navier-Stokes, pulsatility, Fahraeus-Lindqvist, pericytes, 3D mechanics)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L519-L535> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/ibrahim-vascular-angiogenesis-notch.yaml L1–L125" ;
        dcterms:description "Equations 1-5 registered with single-range code_locus pins (L182-224, L245-483, L641-909, L912-1198) and Lean theorem names" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/math_kg_loops/ibrahim-vascular-angiogenesis-notch.yaml#L1-L125> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Bentley, Gerhardt & Bates (2008) PLoS Comput. Biol., Hellström et al. (2007) Nature & Jakobsson et al. (2010) Nat. Cell Biol. VEGF-VEGFR2-Dll4-Notch1 tip/stalk salt-and-pepper lateral inhibition and angiogenic sprouting, coupled to lumenized Poiseuille flow, wall-shear pruning and arteriovenous specification (Pass 3) — Code-to-model traceability: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module docstring (L1-100) maps every governing equation of Sections 2-3b to its paper and to the five Lean theorems with file#line pins; the Section 3b banner (L519-535) states the reduced-model scope and residuals explicitly; `pries_shear_set_point_pa`, `solve_poiseuille_network`, `fit_murray_exponent` and `simulate_perfused_plexus_remodeling` cite Pries 1995/1998, Murray 1926, Chen 2012 and Franco 2015 in their docstrings; the math-KG YAML registers equations 1-5 with single-range code loci. Deductions: the Hill templates in `evaluate_notch_gain_sweep` (L1337-1349) and the regime branches at L313-380 are not documented as prescriptions in the module docstring, which still describes the sweep as reproducing the benchmark (-5); the lumenization coefficients and AV gains are uncited (-3); Panel E legend still reads \"Simulated (Pass 2)\" (L1831) and the lumen docstring (L680-681) is wrong about DAPT (-2); the counter-current comment at L761-765 claims a position-independence that the WT result contradicts (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2021-ibrahim-vascular-angiogenesis-notch.py L1828–L1832: Panel E legend still says 'Simulated (Pass 2)'; refs_primary hard-coded here rather than read from the reference JSON <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L1828-L1832>",
            "2021-ibrahim-vascular-angiogenesis-notch.py L761–L765: Comment claims counter-current layout makes competition calibre- rather than position-dependent; WT survivors cluster near the inlet with one 9 um rung <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L761-L765>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-code-traceability-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 060 Pass 3 Assessor, Phase B subagent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


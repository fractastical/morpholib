        schema:name "WT perfused plexus median capillary wall shear stress after remodelling" ;
        schema:unitText "Pa" ;
        schema:value "1.0555" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-wt-perfused-plexus-median-capillary-wall-shear-stress-after-remodelling-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-wt-perfused-plexus-median-capillary-wall-shear-stress-after-remodelling-reference> a schema:PropertyValue ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ibrahim-vascular-angiogenesis-notch> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Bentley, Gerhardt & Bates (2008) PLoS Comput. Biol., Hellström et al. (2007) Nature & Jakobsson et al. (2010) Nat. Cell Biol. VEGF-VEGFR2-Dll4-Notch1 tip/stalk salt-and-pepper lateral inhibition and angiogenic sprouting, coupled to lumenized Poiseuille flow, wall-shear pruning and arteriovenous specification (Pass 3) — Parameter expressivity: 89/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Six hemodynamic conditions including three ablations/controls (`evaluate_hemodynamic_regimes`, L1210-1240), a k_t sweep propagated end-to-end through sprouting -> lumenization -> perfusion -> pruning -> AV identity (`evaluate_hemodynamic_notch_sweep`, L1243-1270) and a perfusion-pressure sweep 0-30 mmHg (`evaluate_pressure_drop_sweep`, L1273-1302) are added to the five Pass 2 regimes, and the CLI gains `--perfusion-drop-mmhg` beside `--vegf`, `--kt`, `--dll4-dosage`, `--flt1-decoy`, `--seed` (L2345-2376). Deductions: the Section 4 k_t sweep is templated for k_t > 0 (L1337-1349), so the headline gain sweep does not actually exercise the model (-5); the AV segregation index is saturated — 1.0 for every k_t >= 0.25 and 0.5 only at k_t = 0 — so Panel I shows a step, not a dose-response (-3); `--perfusion-drop-mmhg` only affects Panel G and the pruning GIF, not `measure_morphoeval()` (L2355-2358) (-2); HEMO_PARAMS entries tagged `assumption` (adaptation_gain, shrinkage_bias, metabolic_gain, av_identity_* gains, L633-637) are not exposed on the CLI (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2021-ibrahim-vascular-angiogenesis-notch.py L1053–L1120: Notch-gated AV readout saturates: av_segregation_index = 1.0 for every k_t >= 0.25, 0.5 at k_t = 0 (gains L633-637 are untagged assumptions in code) <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L1053-L1120>",
            "2021-ibrahim-vascular-angiogenesis-notch.py L1337–L1349: k_t > 0 points of the Section 4 sweep are closed-form Hill templates, not simulations <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L1337-L1349>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-parameter-expressivity-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L1210–L1302" ;
        dcterms:description "6 hemodynamic conditions (wt, dapt, dll4_het, uniform_shear, shear_only_shunt, no_flow), k_t -> hemodynamics sweep, perfusion-pressure sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L1210-L1302> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L2345–L2376" ;
        dcterms:description "CLI: --self-test, --skip-gif, --vegf, --kt, --dll4-dosage, --flt1-decoy, --perfusion-drop-mmhg (Panel G / GIF only), --seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L2345-L2376> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 060 Pass 3 Assessor, Phase B subagent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


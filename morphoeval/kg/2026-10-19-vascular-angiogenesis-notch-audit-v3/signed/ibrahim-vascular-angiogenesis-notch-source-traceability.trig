        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L544-L573> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/vascular_angiogenesis_notch/hemodynamic_pruning_av_specification_reference.json L1–L89" ;
        dcterms:description "Pass 3 reference table with per-parameter provenance tags and source keys; nine DOIs unverified offline" ;

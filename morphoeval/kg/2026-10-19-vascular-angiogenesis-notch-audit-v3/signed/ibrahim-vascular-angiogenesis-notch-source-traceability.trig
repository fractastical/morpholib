    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/vascular_angiogenesis_notch/paper_citations.bib L1–L155" ;
        dcterms:description "14 BibTeX entries (5 Pass 2 verified + 9 Pass 3 unverified-offline)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/datasets/vascular_angiogenesis_notch/paper_citations.bib#L1-L155> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-source-traceability-5> a pk:EvidenceItem ;
        rdfs:label "datasets/vascular_angiogenesis_notch/README.md L1–L27" ;
        dcterms:description "README documents all five dataset files including the Pass 3 JSON and its SHA-256" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/datasets/vascular_angiogenesis_notch/README.md#L1-L27> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Bentley, Gerhardt & Bates (2008) PLoS Comput. Biol., Hellström et al. (2007) Nature & Jakobsson et al. (2010) Nat. Cell Biol. VEGF-VEGFR2-Dll4-Notch1 tip/stalk salt-and-pepper lateral inhibition and angiogenic sprouting, coupled to lumenized Poiseuille flow, wall-shear pruning and arteriovenous specification (Pass 3) — Source and data traceability: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`datasets/vascular_angiogenesis_notch/` now holds two SHA-256-locked reference JSONs (Pass 2 reference and the Pass 3 `hemodynamic_pruning_av_specification_reference.json`, verified fail-closed at runtime at L147-175 and L544-573 with a cross-check that HEMO_PARAMS equals the pinned values), the pinned HUVEC specimen, `scout_manifest.json`, a README documenting all five files, and `paper_citations.bib` with 14 entries; every Pass 3 parameter carries a provenance tag (measured / derived / approximate / assumption) and a source key. Deductions: none of the nine new DOIs (Pries 1998, Pries 1995, Murray 1926, Chen 2012, Franco 2015, Lawson 2001, le Noble 2004, Wang 1998, Lobov 2007) could be verified offline in this round and they were written from memory (-4); the lumenization coefficients 0.62 / 0.55 / 0.38 (L676, L689) and the AV gains (L633-637) have no literature source in code (-3); the Notch-blockade density ratio 1.5 is a qualitative reading of Lobov 2007 / Hellström 2007 figures with no tabulated value (-2); the DAPT lumen docstring claim at L680-681 is inaccurate (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "2021-ibrahim-vascular-angiogenesis-notch.py L665–L690: _lumen_radii_from_notch_pattern: coefficients 0.62 / 0.55 / 0.38 unsourced; docstring claims DAPT bed is 'uniformly collapsed, barely perfusable' although DAPT lumens are ~2.9 um > r_min and 13/16 stay perfused <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L665-L690>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-source-traceability-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-source-traceability-5> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .


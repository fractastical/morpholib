sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ibrahim-vascular-angiogenesis-notch> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Bentley, Gerhardt & Bates (2008) PLoS Comput. Biol., Hellström et al. (2007) Nature & Jakobsson et al. (2010) Nat. Cell Biol. VEGF-VEGFR2-Dll4-Notch1 tip/stalk salt-and-pepper lateral inhibition and angiogenic sprouting, coupled to lumenized Poiseuille flow, wall-shear pruning and arteriovenous specification (Pass 3) — Reproducibility package: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`self_test()` (L2229-2343) runs 10 suites in about 1.6 s: SHA-256 integrity, Brillouin instability and sFlt1 rescue, salt-and-pepper, DAPT collapse, Dll4+/- and high-VEGF, mosaic and sweep, HUVEC segmentation, 14-metric bitwise determinism, Suite 9 (Kirchhoff residual < 1e-9 relative, Pries set-point values at 10/30/100 mmHg, single-segment tau = dP r / 2L to 1e-9, Murray k in band, pruning 25-75%, WSS in band, flow stealing > 1) and Suite 10 (DAPT > WT perfused, uniform-shear no selection, shear-only <= 2 rungs, no-flow regression and tau = 0, AV WT >= 0.9 / DAPT = 0.5 / no-flow <= 0.6, sweep monotonicity); the full render takes about 5 s and regenerates the PNG, both GIFs and the 14-measurement JSON deterministically. Deductions: the Murray band is widened by +/-0.4 in the self-test (L2307-2308) (-2); the WSS band is widened by +/-20% (L2312-2313) (-1); `--perfusion-drop-mmhg` is not covered by any suite (-1); there is no requirements lock file for this script (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-repro-package-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L2229–L2343" ;
        dct:description "10-suite deterministic self-test (8 Pass 2 + Suites 9-10 hemodynamics), passes in ~1.6 s" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L2229-L2343> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L2284–L2332" ;
        dct:description "Suites 9-10: Kirchhoff, Pries set point, Poiseuille sanity, Murray (band +/-0.4), pruning, WSS (band +/-20%), ablations, AV, sweep monotonicity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L2284-L2332> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L2277–L2282" ;
        dct:description "Suite 8: measure_morphoeval() length 14 and bitwise determinism across two runs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L2277-L2282> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 060 Pass 3 Assessor, Phase B subagent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/pietak-bioelectric-morphogen-coupling-1>,
        <https://w3id.org/probknow/resource/math-law/pietak-bioelectric-morphogen-coupling-2>,
        <https://w3id.org/probknow/resource/math-law/pietak-bioelectric-morphogen-coupling-3> .

<https://w3id.org/probknow/resource/math-law/pietak-bioelectric-morphogen-coupling-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Pietak & Levin (2017) Nernst-Planck Electrodiffusive Gap-Junction Flux & Zero-Drift Law" ;
    dct:description "Governs electrodiffusive transport of charged morphogens (5-HT) across voltage-gated gap junctions and proves exact flux collapse under 8-octanol blockade (G_gj = 0) or zero-flux Boltzmann balance | Variables: c(x,t): intracellular serotonin (5-HT) concentration; z = +1: 5-HT cation valence; V(x,t): resting membrane potential (mV); V_T = RT/F = 25.85 mV: thermal voltage; G_gj(ΔV): voltage-gated gap-junction conductance" ;
    dct:source "Pietak & Levin (2017) J. R. Soc. Interface 14:20170425 Eqs. (3)-(5); Pietak & Levin (2016) Front. Bioeng. Biotechnol. 4:55" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L125-L215>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_082_bioelectric_morphogen_coupling.lean#L14-L40> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def nernst_planck_flux_num (G_gj V_T dc z c dV : Int) : Int :=
  -G_gj * (V_T * dc + z * c * dV)
theorem nernst_planck_gj_flux_identities (G_gj V_T dc z c dV : Int) :
    nernst_planck_flux_num 0 V_T dc z c dV = 0 ∧
    nernst_planck_flux_num G_gj V_T dc 0 c dV = -G_gj * (V_T * dc) ∧
    nernst_planck_flux_num G_gj V_T 0 z c 0 = 0 := by
  refine ⟨?_, ?_, ?_⟩
  · simp [nernst_planck_flux_num]
  · simp [nernst_planck_flux_num]
  · simp [nernst_planck_flux_num]
"""^^pk:lean4 ;
    skos:notation "J_s = -D_s G_gj(ΔV) (∇c + (z F / R T) c ∇V);   G_gj = 0 ⟹ J_s = 0;   z = 0 ⟹ J_s = -D_s G_gj ∇c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
        <https://doi.org/10.1016/j.ydbio.2009.12.012>,
        <https://doi.org/10.1098/rsif.2017.0425>,
        <https://doi.org/10.3389/fbioe.2016.00055> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Electrodiffusive Nernst-Planck Gap-Junction Morphogen Transport & Bioelectric-GRN Bistable Memory" ;
    pk:leanDeclaration "MathOfBiology.Loop_082.nernst_planck_flux_num" ;
    pk:leanTheorem "MathOfBiology.Loop_082.nernst_planck_gj_flux_identities" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/pietak-bioelectric-morphogen-coupling-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Boltzmann Equilibrium Concentration Ratio & Voltage-Gated Gap-Junction Symmetry Law" ;
    dct:description "Establishes the exact analytical zero-flux Boltzmann concentration ratio c_post/c_ant = exp(-z(V_post - V_ant)/V_T) and bidirectional symmetry of voltage-gated gap junctions | Variables: V_ant = -20 mV: anterior depolarized blastema potential; V_post = -60 mV: posterior hyperpolarized potential; c_post/c_ant = exp(40/25.85) ≈ 4.70: equilibrium posterior-to-anterior 5-HT ratio" ;
    dct:source "Pietak & Levin (2017) J. R. Soc. Interface 14:20170425 Figs. 2-3 & Eq. (5)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L140-L240>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_082_bioelectric_morphogen_coupling.lean#L43-L71> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def boltzmann_work (z V_ant V_post : Int) : Int :=
  -z * (V_post - V_ant)
def gj_voltage_denom (dV V0 : Int) : Int :=
  V0 * V0 + dV * V0 + dV * dV - dV * V0
theorem boltzmann_equilibrium_and_gj_symmetry (dV V0 : Int) :
    boltzmann_work 1 (-20) (-60) = 40 ∧
    boltzmann_work 1 (-20) (-20) = 0 ∧
    boltzmann_work 0 (-20) (-60) = 0 ∧
    gj_voltage_denom (-dV) V0 = gj_voltage_denom dV V0 := by
  refine ⟨by decide, by decide, by decide, ?_⟩
  simp [gj_voltage_denom, Int.neg_mul_neg]
"""^^pk:lean4 ;
    skos:notation "c_post / c_ant = exp(-(z F / R T)(V_post - V_ant));   G_gj(-ΔV) = G_gj(ΔV) = (1 - η_oct) G_0 / (1 + (ΔV / V_0)^2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
        <https://doi.org/10.1016/j.ydbio.2009.12.012>,
        <https://doi.org/10.1098/rsif.2017.0425>,
        <https://doi.org/10.3389/fbioe.2016.00055> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Electrodiffusive Nernst-Planck Gap-Junction Morphogen Transport & Bioelectric-GRN Bistable Memory" ;
    pk:leanDeclaration "MathOfBiology.Loop_082.boltzmann_work" ;
    pk:leanTheorem "MathOfBiology.Loop_082.boltzmann_equilibrium_and_gj_symmetry" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/pietak-bioelectric-morphogen-coupling-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "cAMP/PKA/beta-Catenin Feedback & Cryptic Two-Headed (2H0T) Memory Persistence Law" ;
    dct:description "Proves that transient 8-octanol gap-junction blockade flips the coupled V_mem-5-HT-cAMP-beta-catenin-ERK loop into a permanent symmetric 2H0T attractor that persists after drug washout | Variables: M(x,t): intracellular cAMP/PKA signaling state; B(x,t): nuclear beta-catenin tail determinant; E(x,t): anterior ERK head determinant" ;
    dct:source "Pietak & Levin (2017) J. R. Soc. Interface 14:20170425 Figs. 4-6; Durant et al. (2017) Biophys. J. 112:2231-2243" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L245-L450>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_082_bioelectric_morphogen_coupling.lean#L74-L108> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def erk_head_gate (B B_thresh : Int) : Nat :=
  if B ≤ B_thresh then 1 else 0
def pietak_ap_phenotype (B_ant B_post B_thresh : Int) : Nat × Nat :=
  let h_ant := erk_head_gate B_ant B_thresh
  let h_post := erk_head_gate B_post B_thresh
  (h_ant + h_post, (1 - h_ant) + (1 - h_post))
theorem cryptic_two_headed_memory_phenotypes :
    pietak_ap_phenotype 10 88 50 = (1, 1) ∧
    pietak_ap_phenotype 12 15 50 = (2, 0) ∧
    pietak_ap_phenotype 14 18 50 = (2, 0) ∧
    pietak_ap_phenotype 82 86 50 = (0, 2) := by
  decide
"""^^pk:lean4 ;
    skos:notation "τ_M dM/dt = H(c) + α_loop H(B) - M;   (N_head, N_tail) = (1,1) [WT],  (2,0) [Octanol & Cryptic Washout Memory],  (0,2) [SCH-28080/Forskolin]" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
        <https://doi.org/10.1016/j.ydbio.2009.12.012>,
        <https://doi.org/10.1098/rsif.2017.0425>,
        <https://doi.org/10.3389/fbioe.2016.00055> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Electrodiffusive Nernst-Planck Gap-Junction Morphogen Transport & Bioelectric-GRN Bistable Memory" ;
    pk:leanDeclaration "MathOfBiology.Loop_082.pietak_ap_phenotype" ;
    pk:leanTheorem "MathOfBiology.Loop_082.cryptic_two_headed_memory_phenotypes" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


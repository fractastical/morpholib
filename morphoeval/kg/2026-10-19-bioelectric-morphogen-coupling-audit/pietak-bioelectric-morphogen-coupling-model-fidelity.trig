sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pietak-bioelectric-morphogen-coupling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Pietak & Levin (2017) electrodiffusive Nernst-Planck gap-junction morphogen transport & cryptic two-headed memory — Model fidelity to source: 62/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements Nernst-Planck electrodiffusive transport across voltage-gated gap junctions and the cAMP/PKA -> beta-catenin / ERK antagonism loop (L115-240), but naive centered finite differences in the baseline pass require replacement with conservative Scharfetter-Gummel Bernoulli flux discretization so steady-state PDE concentrations match the exact Boltzmann equilibrium ratio exp(-z*DeltaV/V_T) = 4.70." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2017-pietak-bioelectric-morphogen-coupling.py L200–L310: 1D electrodiffusive Nernst-Planck gap-junction and cAMP/beta-catenin/ERK PDE solver <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L200-L310>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-model-fidelity-1> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2017-pietak-bioelectric-morphogen-coupling.py L115–L195" ;
        dct:description "Nernst-Planck Boltzmann equilibrium ratio and Bell-form gap-junction conductance" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L115-L195> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


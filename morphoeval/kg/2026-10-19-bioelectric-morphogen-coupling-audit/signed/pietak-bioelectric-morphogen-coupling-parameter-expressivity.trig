sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pietak-bioelectric-morphogen-coupling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-parameter-expressivity> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Pietak & Levin (2017) electrodiffusive Nernst-Planck gap-junction morphogen transport & cryptic two-headed memory — Parameter expressivity: 57/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates wild-type (1H1T) and continuous 8-octanol gap-junction blockade (2H0T), but needs the transient 8-octanol washout cryptic memory experiment (`2H0T` persistence after `eta_oct -> 0`), the neutral morphogen (`z=0`) negative control, targeted posterior K+ hyperpolarization rescue (`1H1T`), and a 9-point Boltzmann voltage sweep." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2017-pietak-bioelectric-morphogen-coupling.py L385–L442: Multi-regime electrodiffusive evaluator and Boltzmann sweep <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L385-L442>" ;
        pk:hasScore "0.57"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


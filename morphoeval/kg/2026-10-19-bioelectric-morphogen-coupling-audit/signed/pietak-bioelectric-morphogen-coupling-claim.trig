sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pietak-bioelectric-morphogen-coupling> a pk:Claim ;
        rdfs:label "Pietak & Levin (2017) electrodiffusive Nernst-Planck gap-junction morphogen transport & cryptic two-headed memory faithfully reproduces Dugesia japonica / Schmidtea mediterranea freshwater planarian flatworm morphology" ;
        dcterms:description "The simulation script(s) 2017-pietak-bioelectric-morphogen-coupling.py implement the cited source model as published and produce forms that match real Dugesia japonica / Schmidtea mediterranea freshwater planarian flatworm specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 58.1/100, audit 2026-10-19-bioelectric-morphogen-coupling-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py; output: docs/media/bioelectric_morphogen_coupling_comparison.png; organism: Dugesia japonica / Schmidtea mediterranea freshwater planarian flatworm; checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: d43466962273a22db00389bf276a7fa5ef9addd555b89cf3850d949e0d0823ee; artifact_sha256: 13866bfc1f2741223e1a9f254b38f8424907b00fb5e328dc4576f885fdb242dc; input_dataset_sha256: {datasets/bioelectric_morphogen_coupling/bioelectric_morphogen_coupling_reference.json=b118960086d59e02..., datasets/bioelectric_morphogen_coupling/paper_citations.bib=c446e775222f552c..., datasets/bioelectric_morphogen_coupling/planarian_ap_polarity_specimen.jpg=466029cc05610678..., datasets/bioelectric_morphogen_coupling/scout_manifest.json=bc8a4a2c8e734e1d...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1016/j.ydbio.2009.12.012>,
            <https://doi.org/10.1098/rsif.2017.0425>,
            <https://doi.org/10.3389/fbioe.2016.00055> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-specimen-match> ;
        pk:weightOfEvidence "0.581"^^xsd:double .


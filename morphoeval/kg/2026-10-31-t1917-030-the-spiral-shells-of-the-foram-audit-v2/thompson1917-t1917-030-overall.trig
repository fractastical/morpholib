sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-030> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-030-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-030-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-030 — unilocular Lagena Delaunay fit (Pass 2) — MorphoEval overall 72.0/100" ;
        dct:date "2026-10-31"^^xsd:date ;
        dct:description "Pass 2 adds free-form floor gate, ellipsoid null and sphere-cylinder ablation, B/t parameter sweep, CV nRMSE and KS statistics. Verdict mixed: 8/26 compatible; flask-like 8/21; spindles 0/5. Overall 72.0/100 (faithfulness 68.1, reproducibility 81.1); rubric morphoeval 0.1.0; checkpoint commit 35d30f4cf; environment: . Dimension assessments: Model fidelity to source 78, Morphological realism / specimen match 64, Parameter expressivity 68, Morphometric validation 62, Source and data traceability 88, Code-to-model traceability 80, Reproducibility package 76. Output judged: docs/media/t1917_030_the_spiral_shells_of_the_foram_comparison.png: rendered output of thompson/claims/t1917-030_the-spiral-shells-of-the-foraminifera.py at 35d30f4cf, image/png, 1410938 B, 2200×2000 px, artifact_sha256 4e3e73d537f178753cc5dc73406808a3bcfe02c981f814d9b40f0035f60164df (sha256 4e3e73d537f178753cc5dc73406808a3bcfe02c981f814d9b40f0035f60164df), spec_fingerprint b34282bb5042ed2c7e96a316685b10531cd3439cb7059e3c291735bdd26880b9. Dual provenance: spec_fingerprint: b34282bb5042ed2c7e96a316685b10531cd3439cb7059e3c291735bdd26880b9; artifact_sha256: 4e3e73d537f178753cc5dc73406808a3bcfe02c981f814d9b40f0035f60164df; input_dataset_sha256: {datasets/thompson_1917/t1917-030/kireenko_2022_bdj_e87457_fig8_station5656mc.jpg=3b57acc0dfc98374..., datasets/thompson_1917/t1917-030/paper_citations.bib=102e5d153f118cc9..., datasets/thompson_1917/t1917-030/scout_manifest.json=dfb385784d2f08b9..., datasets/thompson_1917/t1917-030/thompson_1917_fig84_lagena_after_brady.png=f6cd3abb75217bd0..., datasets/thompson_1917/t1917-030/thompson_1917_leaf0276_p256_fig84.jp2=ed440583a8b144d5...}. Supersedes audit: 2026-10-31-t1917-030-the-spiral-shells-of-the-foram-audit. Claim boundary: reported_in_source: Thompson Ch. XII reuses Ch. V surface-tension catalogue for monothalamic Lagena before coiling; reconstructed_in_script: 26 unilocular silhouettes (13 Fig. 84 + 13 Fig. 19) + 2 polythalamous controls; adaptive gate; does_not_claim: Does not fit spiral chamber angles (T1917-029); spindle Lagena refuted by bead aspect bound." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediation; cloud loop thompson1917-t1917-030)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


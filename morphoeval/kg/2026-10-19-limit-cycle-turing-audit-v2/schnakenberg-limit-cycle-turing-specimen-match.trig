sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis — Morphological realism / specimen match: 86/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors, SHA-256-locks, and segments the Public Domain macro photograph of `Dictyostelium discoideum` fruiting body sorocarps (`dictyostelium_specimen.jpg`, L476-561), extracting the two mature spore heads (areas 881 px and 824 px, mean diameter 32.95 px, CV=3.34%, inter-sorus distance 465.42 px, spacing ratio 14.13), 5 interior Difference-of-Gaussians aggregation mounds (NND 207.15 +- 133.99 px), and the 73.14 px agar substrate FFT wavelength, rendered in Panel C4 of the 15-panel synthesis figure." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-specimen-match-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L476–L561" ;
        dct:description "Luminance sorus segmentation, interior DoG aggregate detection, and 512x512 agar 2D FFT wavelength analysis" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py#L476-L561> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/limit_cycle_turing_comparison.png (generated output)" ;
        dct:description "15-panel dark-mode synthesis figure comparing 5 PDE regimes, 5 radial spectra, phase diagram, limit cycle, d-sweep, and Dictyostelium segmentation — docs/media/limit_cycle_turing_comparison.png: rendered output of 1979-schnakenberg-limit-cycle-turing.py at 8871db0, image/png, 650791 B, 2940×1750 px, artifact_sha256 076cb14f1cdd4edae1faf1bf08881306ce6cc3e38cc0e0cad0e244e5316e71dd (sha256 076cb14f1cdd4edae1faf1bf08881306ce6cc3e38cc0e0cad0e244e5316e71dd), spec_fingerprint 2171bdf8211cc376e4fec882bcd645f848050c6a4e0c6d15ce22984bb3384713" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


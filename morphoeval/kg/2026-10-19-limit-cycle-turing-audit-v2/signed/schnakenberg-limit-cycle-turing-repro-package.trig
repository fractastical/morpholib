sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L930–L983" ;
        dcterms:description "8-check self_test() suite including bitwise determinism and <2% wavelength error gate" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py#L930-L983> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis — Reproducibility package: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Deterministic RNG (`seed=1979`), headless `Agg` backend, CLI flags (`--self-test`, `--skip-gif`, `--no-show`, parameter overrides), and an 8-point `self_test()` suite (L930-983) verifying SHA-256 dataset hashes, equilibrium/flux identities, Hopf trace vanishing, dispersion parity, limit-cycle period, <2% 2D Turing wavelength error, equal-diffusion control decay, two-run bitwise determinism, and specimen segmentation parity." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-repro-package-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


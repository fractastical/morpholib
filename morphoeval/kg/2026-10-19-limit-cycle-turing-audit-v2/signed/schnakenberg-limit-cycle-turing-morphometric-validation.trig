sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis — Morphometric validation: 89/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L568-681) returns 9 reference-anchored quantitative morphometrics: critical diffusivity ratio d_c = 8.567627 (0% error), 2D Turing wavelength lambda* = 0.9374 vs analytical lambda_c = 0.9413 (0.42% error, k* = 6.7031 vs k_c = 6.6750), autonomous limit-cycle oscillation period T_LC = 19.625 (std = 0.0, amplitude = 6.825), differential vs equal-diffusion contrast ratio (>10,000x), Hopf trace residual (0.0), and 3 Dictyostelium specimen segmentation metrics." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-2d-turing-critical-wavenumber-k-star-vs-analytical-k-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-2d-turing-wavelength-lambda-star-vs-analytical-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-dictyostelium-specimen-agar-substrate-2d-fft-wavelength>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-dictyostelium-specimen-inter-sorus-spacing-to-diameter-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-dictyostelium-specimen-sorocarp-spore-head-diameter-d-sorus>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-differential-vs-equal-diffusion-control-contrast-ratio-d-18-vs-d-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-hopf-bifurcation-curve-trace-residual-max-tr-j-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-schnakenberg-autonomous-limit-cycle-oscillation-period-t-lc>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-schnakenberg-critical-turing-diffusivity-ratio-d-c-0-10-0-90>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-morphometric-validation-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-2d-turing-critical-wavenumber-k-star-vs-analytical-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D Turing critical wavenumber k_star vs analytical k_c = 6.7031 rad / length unit" ;
        dcterms:description "Matches analytical fastest-growing mode k_c=6.6750 within 0.42%" ;
        schema:measurementTechnique "Power-weighted sub-bin radial FFT peak wavenumber on 96x96 periodic domain" ;
        schema:name "2D Turing critical wavenumber k_star vs analytical k_c" ;
        schema:unitText "rad / length unit" ;
        schema:value "6.7031" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-2d-turing-critical-wavenumber-k-star-vs-analytical-k-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-2d-turing-critical-wavenumber-k-star-vs-analytical-k-c-reference> a schema:PropertyValue ;
        dcterms:source "Schnakenberg (1979) linear dispersion maximum argmax_k Re sigma(k^2)" ;
        schema:value "6.675" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-2d-turing-wavelength-lambda-star-vs-analytical-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D Turing wavelength lambda_star vs analytical lambda_c = 0.9374 domain length units" ;
        dcterms:description "k_star=6.7031 vs analytical k_c=6.6750 (0.42% relative error)" ;
        schema:measurementTechnique "2D FFT radial PSD centroid wavelength on L=6.0, N=96 grid (spectral r=0.7768, RMSE=0.2895)" ;
        schema:name "2D Turing wavelength lambda_star vs analytical lambda_c" ;
        schema:unitText "domain length units" ;
        schema:value "0.9374" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-2d-turing-wavelength-lambda-star-vs-analytical-lambda-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-2d-turing-wavelength-lambda-star-vs-analytical-lambda-c-reference> a schema:PropertyValue ;
        dcterms:source "Schnakenberg (1979) / Turing (1952) linear dispersion peak lambda_c = 2*pi / k_c" ;
        schema:value "0.9413" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-dictyostelium-specimen-agar-substrate-2d-fft-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Dictyostelium specimen agar substrate 2D FFT wavelength = 73.143 px" ;
        dcterms:description "Characteristic spatial scale of aggregation territory texture on agar" ;
        schema:measurementTechnique "2D Hann-windowed bandpass FFT radial power spectrum peak (k=7.0 cycles / 512 px, interior NND=207.1±134.0 px)" ;
        schema:name "Dictyostelium specimen agar substrate 2D FFT wavelength" ;
        schema:unitText "px" ;
        schema:value "73.143" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-dictyostelium-specimen-agar-substrate-2d-fft-wavelength-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-dictyostelium-specimen-agar-substrate-2d-fft-wavelength-reference> a schema:PropertyValue ;
        dcterms:source "datasets/limit_cycle_turing/limit_cycle_turing_reference.json (512x512 central ROI)" ;
        schema:value "73.143" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-dictyostelium-specimen-inter-sorus-spacing-to-diameter-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Dictyostelium specimen inter-sorus spacing to diameter ratio = 14.129 D_sori / d_sorus ratio" ;
        dcterms:description "Dimensionless fruiting-body territory spacing ratio (465.42 px / 32.94 px)" ;
        schema:measurementTechnique "Euclidean centroid separation between mature fruiting body sori divided by mean equivalent diameter" ;
        schema:name "Dictyostelium specimen inter-sorus spacing to diameter ratio" ;
        schema:unitText "D_sori / d_sorus ratio" ;
        schema:value "14.129" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-dictyostelium-specimen-inter-sorus-spacing-to-diameter-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-dictyostelium-specimen-inter-sorus-spacing-to-diameter-ratio-reference> a schema:PropertyValue ;
        dcterms:source "datasets/limit_cycle_turing/dictyostelium_specimen.jpg reference morphometrics" ;
        schema:value "14.127" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-dictyostelium-specimen-sorocarp-spore-head-diameter-d-sorus> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Dictyostelium specimen sorocarp spore-head diameter d_sorus = 32.941 px" ;
        dcterms:description "Sorus areas 881 px and 824 px (mean 852.5 px, inter-sorus spacing 465.42 px)" ;
        schema:measurementTechnique "Connected-component luminance segmentation (gray < 0.32, n=2 sori, area CV=0.0334)" ;
        schema:name "Dictyostelium specimen sorocarp spore-head diameter d_sorus" ;
        schema:unitText "px" ;
        schema:value "32.941" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-dictyostelium-specimen-sorocarp-spore-head-diameter-d-sorus-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-dictyostelium-specimen-sorocarp-spore-head-diameter-d-sorus-reference> a schema:PropertyValue ;
        dcterms:source "datasets/limit_cycle_turing/dictyostelium_specimen.jpg & limit_cycle_turing_reference.json" ;
        schema:value "32.946" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-differential-vs-equal-diffusion-control-contrast-ratio-d-18-vs-d-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "differential vs equal-diffusion control contrast ratio (d=18 vs d=1) = 52829.79 std_u(d=18) / std_u(d=1) ratio" ;
        dcterms:description "Equal-diffusion control decays exponentially to homogeneous equilibrium (u_*, v_*) = (1.0, 0.9)" ;
        schema:measurementTechnique "Ratio of activator spatial std_u at d=18 (0.6022) vs equal-diffusion negative control d=1 (0.000011)" ;
        schema:name "differential vs equal-diffusion control contrast ratio (d=18 vs d=1)" ;
        schema:unitText "std_u(d=18) / std_u(d=1) ratio" ;
        schema:value "52829.79" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-differential-vs-equal-diffusion-control-contrast-ratio-d-18-vs-d-1-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-differential-vs-equal-diffusion-control-contrast-ratio-d-18-vs-d-1-reference> a schema:PropertyValue ;
        dcterms:source "Turing (1952) & Lean 4 theorem schnakenberg_turing_instability_and_equal_diff" ;
        schema:value "100.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-hopf-bifurcation-curve-trace-residual-max-tr-j-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hopf bifurcation curve trace residual max |tr(J_0)| = 1e-16 dimensionless trace residual" ;
        dcterms:description "Identically zero to IEEE-754 machine precision" ;
        schema:measurementTechnique "Max absolute Jacobian trace |(b - a - (a+b)^3)/(a+b)| across 200 points on exact Hopf locus" ;
        schema:name "Hopf bifurcation curve trace residual max |tr(J_0)|" ;
        schema:unitText "dimensionless trace residual" ;
        schema:value "1e-16" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-hopf-bifurcation-curve-trace-residual-max-tr-j-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-hopf-bifurcation-curve-trace-residual-max-tr-j-0-reference> a schema:PropertyValue ;
        dcterms:source "Schnakenberg (1979) Eq. (24) b - a = (a + b)^3 & Lean 4 schnakenberg_hopf_trace_and_det_pos" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-schnakenberg-autonomous-limit-cycle-oscillation-period-t-lc> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Schnakenberg autonomous limit-cycle oscillation period T_LC = 19.625 dimensionless time tau = gamma*t" ;
        dcterms:description "Supercritical Hopf limit cycle for b - a = 0.45 > (a+b)^3 = 0.166375" ;
        schema:measurementTechnique "RK4 ODE integration (dt=0.005, 24000 steps) peak-to-peak period (std=0.00000, amplitude=6.825)" ;
        schema:name "Schnakenberg autonomous limit-cycle oscillation period T_LC" ;
        schema:unitText "dimensionless time tau = gamma*t" ;
        schema:value "19.625" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-schnakenberg-autonomous-limit-cycle-oscillation-period-t-lc-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-schnakenberg-autonomous-limit-cycle-oscillation-period-t-lc-reference> a schema:PropertyValue ;
        dcterms:source "Schnakenberg (1979) Eqs. (15)-(24) Poincaré–Bendixson limit cycle at (a=0.05, b=0.50)" ;
        schema:value "19.625" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-schnakenberg-critical-turing-diffusivity-ratio-d-c-0-10-0-90> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Schnakenberg critical Turing diffusivity ratio d_c(0.10, 0.90) = 8.567627 dimensionless ratio D_v/D_u" ;
        dcterms:description "Exact threshold separating homogeneous stability (d < d_c) from Turing spots (d > d_c)" ;
        schema:measurementTechnique "Exact analytical root d_c = (((a+b)^2 + (a+b)*sqrt(2b(a+b))) / (b-a))^2 at (a,b)=(0.10,0.90)" ;
        schema:name "Schnakenberg critical Turing diffusivity ratio d_c(0.10, 0.90)" ;
        schema:unitText "dimensionless ratio D_v/D_u" ;
        schema:value "8.567627" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-schnakenberg-critical-turing-diffusivity-ratio-d-c-0-10-0-90-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-schnakenberg-critical-turing-diffusivity-ratio-d-c-0-10-0-90-reference> a schema:PropertyValue ;
        dcterms:source "Schnakenberg (1979) J. Theor. Biol. 81:389-400 & Turing (1952) dispersion tangency" ;
        schema:value "8.567627" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L395–L436" ;
        dcterms:description "Sub-bin radial 2D FFT spectral centroid wavenumber k* and wavelength lambda* estimation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py#L395-L436> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L568–L681" ;
        dcterms:description "9 reference-validated morphometrics in measure_morphoeval()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py#L568-L681> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> a pk:Claim ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis faithfully reproduces Dictyostelium discoideum (cellular slime mold cAMP oscillations & fruiting body aggregation) morphology" ;
        dcterms:description "The simulation script(s) 1979-schnakenberg-limit-cycle-turing.py implement the cited source model as published and produce forms that match real Dictyostelium discoideum (cellular slime mold cAMP oscillations & fruiting body aggregation) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 90.0/100, audit 2026-10-19-limit-cycle-turing-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py; output: docs/media/limit_cycle_turing_comparison.png; organism: Dictyostelium discoideum (cellular slime mold cAMP oscillations & fruiting body aggregation); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 2171bdf8211cc376e4fec882bcd645f848050c6a4e0c6d15ce22984bb3384713; artifact_sha256: 076cb14f1cdd4edae1faf1bf08881306ce6cc3e38cc0e0cad0e244e5316e71dd; input_dataset_sha256: {datasets/limit_cycle_turing/dictyostelium_specimen.jpg=e2d2b739211bda97..., datasets/limit_cycle_turing/limit_cycle_turing_reference.json=cc22252b314c8bb8..., datasets/limit_cycle_turing/scout_manifest.json=e71deffb9f317a88...}; supersedes_audit_id: 2026-10-19-limit-cycle-turing-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/253540a0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1371/journal.pcbi.1004367> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-specimen-match> ;
        pk:weightOfEvidence "0.9"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py> a schema:SoftwareSourceCode ;

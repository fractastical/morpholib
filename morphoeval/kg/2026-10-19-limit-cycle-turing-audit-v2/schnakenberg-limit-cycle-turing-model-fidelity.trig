sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Faithfully implements Schnakenberg's (1979) Eqs. (15)-(24) cubic autocatalytic reaction-diffusion PDE, equilibrium (u_*, v_*) = (a+b, b/(a+b)^2), exact Hopf bifurcation curve b - a = (a+b)^3 (max |tr(J_0)| < 1e-15), Turing critical diffusivity ratio d_c(a,b), and spatial dispersion relation sigma(k^2) (L139-276), alongside RK4 integration of the Poincare-Bendixson limit-cycle oscillator (L283-346) and isotropic 2D Fourier-RK2 PDE integration (L353-392). Formalized by 3 kernel-verified Lean 4 theorems in `morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L139–L276" ;
        dct:description "Schnakenberg equilibrium, Jacobian, Hopf curve, critical diffusivity ratio d_c, and spatial dispersion sigma(k^2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py#L139-L276> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L283–L392" ;
        dct:description "RK4 autonomous limit-cycle ODE solver and 2D pseudo-spectral/RK2 reaction-diffusion PDE solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py#L283-L392> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean L24–L81" ;
        dct:description "3 machine-checked Lean 4 theorems for Schnakenberg equilibrium, Hopf trace, and Turing instability (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L24-L81> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ermentrout-corticothalamic-seizure-spirals> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Huang et al. (2004, 2010) & Pinto & Ermentrout (2001) neocortical spiral wave dynamics & phase singularity topology — Morphometric validation: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Extracts 6 reference-anchored quantitative measurements via `measure_morphoeval()` (L670-748): spiral rotation frequency (`10.52 Hz` vs `10.5 Hz` reference), radial wave propagation speed (`45.13 mm/s` vs `45.0 mm/s` reference), radial core amplitude drop correlation (`r = 0.9960` vs `0.99` reference), figure-eight dipole topological defect count (`2.0` with net charge `0`), CNQX/AMPA blockade RMS amplitude (`0.0045` vs `0.0` reference), and tangential neocortex specimen profile correlation (`r = 0.9965`, `N = 110` columns)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-cnqx-ampa-glutamatergic-blockade-quiescent-control-rms-oscillation-amplitude>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-huang-et-al-2010-neocortical-spiral-rotation-frequency-f-rot>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-huang-et-al-2010-radial-core-amplitude-drop-profile-correlation-r-core>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-pinto-ermentrout-2001-huang-et-al-2010-radial-spiral-propagation-speed-c-wave>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-rattus-norvegicus-tangential-neocortical-sheet-cytochrome-oxidase-profile-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-wave-break-figure-eight-spiral-pair-topological-defect-count-w-w>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-morphometric-validation-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-cnqx-ampa-glutamatergic-blockade-quiescent-control-rms-oscillation-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "CNQX/AMPA glutamatergic blockade quiescent control RMS oscillation amplitude = 0.0045 normalized amplitude" ;
        dct:description "CNQX blockade A_rms = 0.0045 vs active spiral A_rms = 0.3472 (sub-Hopf trace Tr(J_0) = -0.0886 ms^-1 < 0, defects = 0)" ;
        schema:measurementTechnique "RMS oscillation amplitude A_rms across the 64x64 cortical sheet under AMPA receptor blockade (w_ee = 0.8 < w_crit, Tr(J_0) < 0)" ;
        schema:name "CNQX/AMPA glutamatergic blockade quiescent control RMS oscillation amplitude" ;
        schema:unitText "normalized amplitude" ;
        schema:value "0.0045" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-cnqx-ampa-glutamatergic-blockade-quiescent-control-rms-oscillation-amplitude-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-cnqx-ampa-glutamatergic-blockade-quiescent-control-rms-oscillation-amplitude-reference> a schema:PropertyValue ;
        dct:source "Huang et al. (2004) J. Neurosci. 24:9897-9902; Huang et al. (2010) J. Neurosci. 30:10158-10164" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-huang-et-al-2010-neocortical-spiral-rotation-frequency-f-rot> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Huang et al. (2010) neocortical spiral rotation frequency f_rot = 10.52 Hz" ;
        dct:description "Spiral rotation frequency f_rot = 10.52 Hz (Hopf trace Tr(J_0) = 0.1914 ms^-1 > 0, Det(J_0) = -0.00029 ms^-2 > 0)" ;
        schema:measurementTechnique "Oscillation frequency of 2D Wilson-Cowan / Pinto-Ermentrout excitatory-adaptation spiral wave in disinhibited tangential neocortex" ;
        schema:name "Huang et al. (2010) neocortical spiral rotation frequency f_rot" ;
        schema:unitText "Hz" ;
        schema:value "10.52" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-huang-et-al-2010-neocortical-spiral-rotation-frequency-f-rot-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-huang-et-al-2010-neocortical-spiral-rotation-frequency-f-rot-reference> a schema:PropertyValue ;
        dct:source "Huang et al. (2010) J. Neurosci. 30(30):10158-10164 Fig. 1; Huang et al. (2004) J. Neurosci. 24:9897-9902 (Lean 4 wilson_cowan_hopf_trace_determinant)" ;
        schema:value "10.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-huang-et-al-2010-radial-core-amplitude-drop-profile-correlation-r-core> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Huang et al. (2010) radial core amplitude drop profile correlation r_core = 0.9962 Pearson r" ;
        dct:description "Core amplitude profile r = 0.9962 (RMSE = 0.0249, core minimum ratio A(0)/A_inf = 0.0227)" ;
        schema:measurementTechnique "Pearson correlation between simulated radial oscillation envelope A(r)/A_inf around the W=+1 phase singularity and theoretical tanh(r / r_core)" ;
        schema:name "Huang et al. (2010) radial core amplitude drop profile correlation r_core" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9962" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-huang-et-al-2010-radial-core-amplitude-drop-profile-correlation-r-core-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-huang-et-al-2010-radial-core-amplitude-drop-profile-correlation-r-core-reference> a schema:PropertyValue ;
        dct:source "Huang et al. (2010) J. Neurosci. 30(30):10158-10164 Fig. 3 (amplitude reduction at spiral phase singularity core)" ;
        schema:value "0.99" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-pinto-ermentrout-2001-huang-et-al-2010-radial-spiral-propagation-speed-c-wave> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pinto & Ermentrout (2001) & Huang et al. (2010) radial spiral propagation speed c_wave = 45.1308 mm/s" ;
        dct:description "Canonical wave speed c_wave = 45.13 mm/s (lambda = 4.29 mm); expanded axonal footprint sigma_e = 0.63 mm speed = 69.18 mm/s" ;
        schema:measurementTechnique "Radial wave speed c_wave = lambda_spiral * f_rot across 6x6 mm tangential cortical sheet (sigma_e = 0.42 mm vs expanded sigma_e = 0.63 mm)" ;
        schema:name "Pinto & Ermentrout (2001) & Huang et al. (2010) radial spiral propagation speed c_wave" ;
        schema:unitText "mm/s" ;
        schema:value "45.1308" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-pinto-ermentrout-2001-huang-et-al-2010-radial-spiral-propagation-speed-c-wave-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-pinto-ermentrout-2001-huang-et-al-2010-radial-spiral-propagation-speed-c-wave-reference> a schema:PropertyValue ;
        dct:source "Huang et al. (2004, 2010) J. Neurosci.; Pinto & Ermentrout (2001) SIAM J. Appl. Math. 62:206-225 (Lean 4 spiral_dispersion_axonal_footprint_scaling)" ;
        schema:value "45.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-rattus-norvegicus-tangential-neocortical-sheet-cytochrome-oxidase-profile-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Rattus norvegicus tangential neocortical sheet cytochrome-oxidase profile correlation r = 0.9965 Pearson r" ;
        dct:description "Specimen profile r = 0.9965 (RMSE = 0.0238, N = 110 segmented cortical columns, mean inter-column spacing = 266.8 um)" ;
        schema:measurementTechnique "Pearson correlation of 50-bin radial cytochrome-oxidase optical density profile and DoG barrel column segmentation on rat_neocortical_tangential_sheet_specimen.jpg" ;
        schema:name "Rattus norvegicus tangential neocortical sheet cytochrome-oxidase profile correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9965" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-rattus-norvegicus-tangential-neocortical-sheet-cytochrome-oxidase-profile-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-rattus-norvegicus-tangential-neocortical-sheet-cytochrome-oxidase-profile-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Rattus norvegicus Layer IV tangential somatosensory neocortex cytochrome-oxidase histology specimen (Wikimedia Commons, Public domain)" ;
        schema:value "0.98" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-wave-break-figure-eight-spiral-pair-topological-defect-count-w-w> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wave-break figure-eight spiral pair topological defect count |W_+| + |W_-| = 2.0 phase singularities" ;
        dct:description "Total singularities = 2 (N_+ = 1, N_- = 1, net charge sum W_i = 0, single CCW W = +1, CW W = -1)" ;
        schema:measurementTechnique "Sum of absolute 2x2 plaquette winding numbers sum |W_{i,j}| and net topological charge sum W_{i,j} on figure-eight counter-rotating wave-break state" ;
        schema:name "Wave-break figure-eight spiral pair topological defect count |W_+| + |W_-|" ;
        schema:unitText "phase singularities" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-wave-break-figure-eight-spiral-pair-topological-defect-count-w-w-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-wave-break-figure-eight-spiral-pair-topological-defect-count-w-w-reference> a schema:PropertyValue ;
        dct:source "Huang et al. (2004) J. Neurosci. 24:9897-9902 Fig. 4; Townsend et al. (2015) J. Neurosci. 35:4657-4662 (Lean 4 topological_winding_dipole_neutrality)" ;
        schema:value "2.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2013-ermentrout-corticothalamic-seizure-spirals.py L670–L748" ;
        dct:description "6 quantitative MorphoEval measurements with references and topological defect verification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2013-ermentrout-corticothalamic-seizure-spirals.py#L670-L748> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


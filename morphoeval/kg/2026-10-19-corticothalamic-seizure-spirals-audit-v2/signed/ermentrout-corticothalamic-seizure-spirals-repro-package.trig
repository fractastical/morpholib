sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ermentrout-corticothalamic-seizure-spirals> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Huang et al. (2004, 2010) & Pinto & Ermentrout (2001) neocortical spiral wave dynamics & phase singularity topology — Reproducibility package: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Deterministic execution (`seed=2013`), standalone 8-check `--self-test` suite verifying SHA-256 dataset locks, Lean 4 algebraic invariants, all 6 experimental regimes, plaquette winding numbers, tangential rat neocortical CV segmentation, and bitwise two-run determinism (`atol=0.0`), plus rendered 9-panel PNG and 24-frame GIF in `docs/media/`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-repro-package-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2013-ermentrout-corticothalamic-seizure-spirals.py L754–L816" ;
        dcterms:description "8-check deterministic --self-test suite verifying SHA-256 locks, Lean 4 invariants, 6 regimes, CV segmentation, and bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2013-ermentrout-corticothalamic-seizure-spirals.py#L754-L816> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/corticothalamic_seizure_spirals_growth.gif (generated output)" ;
        dcterms:description "24-frame animated GIF comparing single W=+1 spiral vs wave-break figure-eight dipole pair — docs/media/corticothalamic_seizure_spirals_growth.gif: rendered output of 2013-ermentrout-corticothalamic-seizure-spirals.py at 317bc3c, image/gif, 1526793 B, 864×378 px, 24 frames, artifact_sha256 5386ea73a87607712454e472e1479512ddf3cedc0d9ae9064bbe5bdb16e110e3 (sha256 5386ea73a87607712454e472e1479512ddf3cedc0d9ae9064bbe5bdb16e110e3), spec_fingerprint 8e19f210a705689fed055999b0cf4bc7b4186b66538d2729cc57db348f32af80" .


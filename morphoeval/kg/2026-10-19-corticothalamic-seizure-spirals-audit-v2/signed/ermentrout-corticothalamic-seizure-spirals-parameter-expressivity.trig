    <https://w3id.org/probknow/resource/claim/morphoeval-ermentrout-corticothalamic-seizure-spirals> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2013-ermentrout-corticothalamic-seizure-spirals.py L348–L388" ;
        dcterms:description "6-regime evaluator and 10x10 (w_ee, g_a) Hopf spiral frequency morphospace" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2013-ermentrout-corticothalamic-seizure-spirals.py#L348-L388> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Huang et al. (2004, 2010) & Pinto & Ermentrout (2001) neocortical spiral wave dynamics & phase singularity topology — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Simulates all 6 canonical regimes from Huang et al. (2004, 2010), Pinto & Ermentrout (2001), and Townsend et al. (2015) (`ccw_single_spiral_singularity`, `cw_chiral_mirror_spiral`, `figure_eight_counter_rotating_dipole`, `expanded_axonal_footprint_fast_spiral`, `planar_traveling_wave_no_defect`, and `cnqx_ampa_blockade_quiescent_control`), plus a 10x10 `(w_ee, g_a)` Hopf spiral frequency morphospace (L348-388)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-parameter-expressivity-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;

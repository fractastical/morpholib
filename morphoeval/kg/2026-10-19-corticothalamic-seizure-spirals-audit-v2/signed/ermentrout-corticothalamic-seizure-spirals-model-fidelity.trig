        rdfs:label "2013-ermentrout-corticothalamic-seizure-spirals.py L182–L345" ;
        dcterms:description "2D FFT Wilson-Cowan / Pinto-Ermentrout neural field PDE solver and radial core amplitude reduction profiler" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2013-ermentrout-corticothalamic-seizure-spirals.py#L182-L345> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_089_corticothalamic_seizure_spirals.lean L24–L157" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for Hopf trace-determinant, topological dipole neutrality, and axonal footprint speed scaling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_089_corticothalamic_seizure_spirals.lean#L24-L157> .


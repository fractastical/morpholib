sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ermentrout-corticothalamic-seizure-spirals> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Huang et al. (2004, 2010) & Pinto & Ermentrout (2001) neocortical spiral wave dynamics & phase singularity topology — Morphological realism / specimen match: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the tangential cytochrome-oxidase histology micrograph of Rattus norvegicus somatosensory neocortex Layer IV (`rat_neocortical_tangential_sheet_specimen.jpg`, 2048x1536 px, Public domain), automatically segments `N = 110` cortical barrel columns via bandpass DoG peak detection (mean inter-column spacing `266.8 um`), and fits the 50-bin radial optical density profile (`r = 0.9965`, `RMSE = 0.0254`, L392-466)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-specimen-match-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2013-ermentrout-corticothalamic-seizure-spirals.py L392–L466" ;
        dct:description "Automated DoG CV segmentation of 110 tangential neocortical barrel columns and radial optical density fit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2013-ermentrout-corticothalamic-seizure-spirals.py#L392-L466> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/corticothalamic_seizure_spirals_comparison.png (generated output)" ;
        dct:description "9-panel dark-mode comparison figure with tangential rat neocortical CV overlay and radial profile fit — docs/media/corticothalamic_seizure_spirals_comparison.png: rendered output of 2013-ermentrout-corticothalamic-seizure-spirals.py at 317bc3c, image/png, 837189 B, 2227×1863 px, artifact_sha256 5fb972407a691858f812d1fa73ce5ccaef68c4e650f1b3ca25af546cc7dce725 (sha256 5fb972407a691858f812d1fa73ce5ccaef68c4e650f1b3ca25af546cc7dce725), spec_fingerprint 8e19f210a705689fed055999b0cf4bc7b4186b66538d2729cc57db348f32af80" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


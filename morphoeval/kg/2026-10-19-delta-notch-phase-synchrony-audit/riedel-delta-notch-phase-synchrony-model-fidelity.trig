    <https://doi.org/10.1016/j.cub.2010.06.034> dct:date "2010"^^xsd:gYear ;
        dct:title "Intercellular coupling regulates the period of the segmentation clock" .
    <https://doi.org/10.1038/nature04861> dct:date "2006"^^xsd:gYear ;
        dct:title "Noise-resistant and synchronized oscillation of the segmentation clock" .
    <https://doi.org/10.1126/science.1142538> dct:date "2007"^^xsd:gYear ;
        dct:title "Synchrony dynamics during initiation, failure, and rescue of the segmentation clock" .
    <https://doi.org/10.2976/1.3027088> dct:date "2009"^^xsd:gYear ;
        dct:title "Delayed coupling theory of vertebrate segmentation" .
}


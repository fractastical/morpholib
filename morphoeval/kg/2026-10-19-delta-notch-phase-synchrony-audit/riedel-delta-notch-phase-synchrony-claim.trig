sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-riedel-delta-notch-phase-synchrony> a pk:Claim ;
        rdfs:label "Riedel-Kruse et al. (2007) & Morelli et al. (2009) zebrafish Delta-Notch delayed Kuramoto phase synchrony, ALD failure, and PRP washout rescue faithfully reproduces Danio rerio (zebrafish presomitic mesoderm & paraxial somites) morphology" ;
        dct:description "The simulation script(s) 2006-riedel-delta-notch-phase-synchrony.py implement the cited source model as published and produce forms that match real Danio rerio (zebrafish presomitic mesoderm & paraxial somites) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 59.0/100, audit 2026-10-19-delta-notch-phase-synchrony-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2006-riedel-delta-notch-phase-synchrony.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2006-riedel-delta-notch-phase-synchrony.py; output: docs/media/delta_notch_phase_synchrony_comparison.png; organism: Danio rerio (zebrafish presomitic mesoderm & paraxial somites); checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 3839bc471581fe7db9e5667737685528fa65076d2960ae3e4a7d5372c54a4e07; artifact_sha256: 3375f3ba7e7ccb413d9e89b34eea5d67f6f5273d7fd87f1f853c21b3ae4af792; input_dataset_sha256: {datasets/delta_notch_phase_synchrony/delta_notch_phase_synchrony_reference.json=cb19f0fbe10df59a..., datasets/delta_notch_phase_synchrony/scout_manifest.json=e3250a43b4bc0c22..., datasets/delta_notch_phase_synchrony/zebrafish_psm_synchrony_specimen.jpg=8b80971796cb29e2...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1038/nature04861>,
            <https://doi.org/10.1126/science.1142538>,
            <https://doi.org/10.2976/1.3027088> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-specimen-match> ;
        pk:weightOfEvidence "0.59"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/317bc3c/2006-riedel-delta-notch-phase-synchrony.py> a schema:SoftwareSourceCode ;
        rdfs:label "2006-riedel-delta-notch-phase-synchrony.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "317bc3c" .
}


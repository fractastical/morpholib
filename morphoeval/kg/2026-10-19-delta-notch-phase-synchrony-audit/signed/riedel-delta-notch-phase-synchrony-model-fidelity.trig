sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-riedel-delta-notch-phase-synchrony> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2006-riedel-delta-notch-phase-synchrony.py L115–L190" ;
        dcterms:description "Transcendental collective frequency and linear stability solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2006-riedel-delta-notch-phase-synchrony.py#L115-L190> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Riedel-Kruse et al. (2007) & Morelli et al. (2009) zebrafish Delta-Notch delayed Kuramoto phase synchrony, ALD failure, and PRP washout rescue — Model fidelity to source: 62/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the delayed Kuramoto collective frequency equation Omega = omega_0 - kappa*sin(Omega*tau_c) (L115-190), but Pass 1 lacks full 2D delayed lattice + mean-field integration across gastrula initiation, DAPT Notch blockade failure (ALD), and DAPT washout rescue (PRP), as well as explicit testing of the repulsive anti-phase delay regime (kappa_eff < 0 at tau_c = 11 min)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2006-riedel-delta-notch-phase-synchrony.py L195–L325: 2D delayed Kuramoto PSM lattice and DAPT pulse-chase simulator <https://github.com/fractastical/morpholib/blob/317bc3c/2006-riedel-delta-notch-phase-synchrony.py#L195-L325>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity-1> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


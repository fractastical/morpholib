        rdfs:label "Schnakenberg–Turing wavelength for Fractofusus misrai at 63 µm (565 Ma) — Reproducibility package: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Self-test now also requires the saturated D_u sweep to be monotonic and to grow. Seed, hashes, frame count, and the 480 px resolution floor are unchanged and still enforced." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-repro-package-1> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-fractofusus-misrai-turing-wavelength-s0.py L760–L776" ;
        dct:description "self-test assertions including the measured sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-fractofusus-misrai-turing-wavelength-s0.py#L760-L776> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; R3 still open)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


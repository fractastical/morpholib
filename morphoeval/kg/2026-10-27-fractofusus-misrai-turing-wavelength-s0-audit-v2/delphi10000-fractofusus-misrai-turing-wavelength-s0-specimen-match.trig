sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg–Turing wavelength for Fractofusus misrai at 63 µm (565 Ma) — Morphological realism / specimen match: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 2 replaces the spot lattice with oblique vanes inside the spindle, which is the rangeomorph reading of the Mistaken Point mould. Bedding colour and the elongate body remain. The fossil's vanes are irregular and cracked; the model's are periodic. Computer-vision similarity of the 12-frame 720×540 GIF against the CC BY photograph is 84.6, up from 79.4." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/fractofusus_misrai_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "photograph beside the vane field — docs/media/fractofusus_misrai_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-fractofusus-misrai-turing-wavelength-s0.py at 0c76d15d, image/png, 731414 B, 1344×1008 px, artifact_sha256 1693932873ca663e510a863079db4f8619b75720cf94ad9ff2f14d49d198de79 (sha256 1693932873ca663e510a863079db4f8619b75720cf94ad9ff2f14d49d198de79), spec_fingerprint b7aed75670ec58eb2e24b6b33d4964b84814f0e27b8d16305477ab4160932f43" .

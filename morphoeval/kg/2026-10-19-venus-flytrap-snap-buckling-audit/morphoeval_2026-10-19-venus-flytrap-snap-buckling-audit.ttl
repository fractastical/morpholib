<https://w3id.org/probknow/resource/claim/morphoeval-forterre-venus-flytrap-snap-buckling> a pk:Claim ;
    rdfs:label "Forterre et al. (2005) Nature Doubly-Curved Shallow Shell Elastic Energy & Saddle-Node Cusp Catastrophe in Dionaea muscipula (Dionaea muscipula (Venus flytrap bilobed leaf trap))",
        "Forterre et al. (2005) Nature Doubly-Curved Shallow Shell Elastic Energy & Saddle-Node Cusp Catastrophe in Dionaea muscipula faithfully reproduces Dionaea muscipula (Venus flytrap bilobed leaf trap) morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/forterre-venus-flytrap-snap-buckling-1>,
        <https://w3id.org/probknow/resource/math-law/forterre-venus-flytrap-snap-buckling-2>,
        <https://w3id.org/probknow/resource/math-law/forterre-venus-flytrap-snap-buckling-3> ;
    dct:description "The simulation script(s) 2005-forterre-venus-flytrap-snap-buckling.py implement the cited source model as published and produce forms that match real Dionaea muscipula (Venus flytrap bilobed leaf trap) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 55.6/100, audit 2026-10-19-venus-flytrap-snap-buckling-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/2005-forterre-venus-flytrap-snap-buckling.py> ;
    schema:about "Dionaea muscipula (Venus flytrap bilobed leaf trap)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2005-forterre-venus-flytrap-snap-buckling.py; output: docs/media/venus_flytrap_snap_buckling_comparison.png; organism: Dionaea muscipula (Venus flytrap bilobed leaf trap); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 09b1066fde1900adefad4e5592cdbc34803c6f1439dd9667ec1014d5137d4133; artifact_sha256: 044fe607a4b7f6329fb3419f7cc1895204f9bbd9f4e17607d772f0a61a68e9c9; input_dataset_sha256: {datasets/venus_flytrap_snap_buckling/dionaea_muscipula_trap_lobe_specimen.jpg=f2738290d66e4418..., datasets/venus_flytrap_snap_buckling/paper_citations.bib=f6ac2d52597b043c..., datasets/venus_flytrap_snap_buckling/scout_manifest.json=572531a0986c798e..., datasets/venus_flytrap_snap_buckling/venus_flytrap_snap_buckling_reference.json=593d9449e870fcf2...}" ;
    pk:derivedFromPaper <https://doi.org/10.1038/nature03185>,
        <https://doi.org/10.1073/pnas.2002707117>,
        <https://doi.org/10.1093/jxb/ert230>,
        <https://doi.org/10.1126/science.1107976> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-morphometric-validation>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-overall>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-parameter-expressivity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-venus-flytrap-snap-buckling-audit-forterre-venus-flytrap-snap-buckling-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-venus-flytrap-snap-buckling-audit-forterre-venus-flytrap-snap-buckling-2> ;
    pk:hypothesisType "Doubly-Curved Shallow Shell Elastic Energy & Saddle-Node Cusp Catastrophe Controlled by Dimensionless Geometric Coupling α = L^4 κ_init^2 / h^2" ;
    pk:weightOfEvidence 5.56e-01 .


    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L1–L10" ;

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-forterre-venus-flytrap-snap-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Forterre et al. (2005) Nature Doubly-Curved Shallow Shell Elastic Energy & Saddle-Node Cusp Catastrophe in Dionaea muscipula — Morphometric validation: 55/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L109-133) returns only 2 static baseline checks without saddle-node fold thresholds, three-stage closure trajectory correlations, surgical ablation checks, or specimen segmentation metrics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2005-forterre-venus-flytrap-snap-buckling.py L109–L133: Only 2 baseline analytical measurements returned <https://github.com/fractastical/morpholib/blob/8871db0/2005-forterre-venus-flytrap-snap-buckling.py#L109-L133>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-forterre-et-al-2005-critical-cusp-coupling-threshold-alpha-c-nu-0-28>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-zero-bias-bistable-equilibrium-curvature-kappa-alpha-3-0-kappa-init> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-forterre-et-al-2005-critical-cusp-coupling-threshold-alpha-c-nu-0-28> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Forterre et al. (2005) critical cusp coupling threshold alpha_c (nu=0.28) = 0.8 dimensionless" ;
        dct:description "Baseline Pass 1 static threshold check" ;
        schema:measurementTechnique "Analytical cusp catastrophe threshold alpha_c = (1 + nu) / (c_stretch * k_init^2)" ;
        schema:name "Forterre et al. (2005) critical cusp coupling threshold alpha_c (nu=0.28)" ;
        schema:unitText "dimensionless" ;
        schema:value "0.8" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-forterre-et-al-2005-critical-cusp-coupling-threshold-alpha-c-nu-0-28-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-forterre-et-al-2005-critical-cusp-coupling-threshold-alpha-c-nu-0-28-reference> a schema:PropertyValue ;
        dct:source "Forterre, Skotheim, Dumais & Mahadevan (2005) Nature 433:421-425 Eq. 2-3" ;
        schema:value "0.8" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-zero-bias-bistable-equilibrium-curvature-kappa-alpha-3-0-kappa-init> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Zero-bias bistable equilibrium curvature kappa*(alpha=3.0) / kappa_init = 0.8563 kappa_over_kinit" ;
        dct:description "Baseline Pass 1 static curvature check" ;
        schema:measurementTechnique "Closed-form pitchfork equilibrium sqrt(1 - alpha_c / alpha)" ;
        schema:name "Zero-bias bistable equilibrium curvature kappa*(alpha=3.0) / kappa_init" ;
        schema:unitText "kappa_over_kinit" ;
        schema:value "0.8563" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-zero-bias-bistable-equilibrium-curvature-kappa-alpha-3-0-kappa-init-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-zero-bias-bistable-equilibrium-curvature-kappa-alpha-3-0-kappa-init-reference> a schema:PropertyValue ;
        dct:source "Forterre et al. (2005) Nature 433:421-425 Fig. 3b" ;
        schema:value "0.8563" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 066 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


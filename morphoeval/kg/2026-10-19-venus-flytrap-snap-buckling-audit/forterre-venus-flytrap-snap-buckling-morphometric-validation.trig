            <https://doi.org/10.1126/science.1107976> .
    <https://doi.org/10.1038/nature03185> dct:date "2005"^^xsd:gYear ;
        dct:title "How the Venus Flytrap Snaps" .
    <https://doi.org/10.1073/pnas.2002707117> dct:date "2020"^^xsd:gYear ;
        dct:title "Snapping Mechanics of the Venus Flytrap (Dionaea muscipula)" .
    <https://doi.org/10.1093/jxb/ert230> dct:date "2013"^^xsd:gYear ;
        dct:title "Slow, Fast and Furious: Understanding the Physics of Plant Movements" .
    <https://doi.org/10.1126/science.1107976> dct:date "2005"^^xsd:gYear ;
        dct:title "Physical Limits and Design Principles for Plant and Fungal Movements" .
}


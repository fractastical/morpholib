sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg micro-ocellus wavelength of Drosophila guttifera at 2.12 µm — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Linear centroid: r = 0.992, RMSE = 0.208 µm, focal numerical value 1.983 µm against reference 2.12 µm. Saturated nearest-neighbour spacing is 1.332 µm (CV = 0.255, KS = 0.801 versus a normal at 2.12 µm), which widens the linear shortfall instead of cancelling it. Wing-membrane count is 18 versus 16. None of these specimen or spacing values were set equal to their references." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-focal-linear-wavelength-lambda-k-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-grimshawi-geometric-mean-linear-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-grimshawi-stripe-coherency-minus-guttifera-spot-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-heteroneura-linear-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-numerical-fourier-peak-wavelength-at-focal-dv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-pearson-r-of-numerical-vs-analytical-wavelength-across-dv-sweep>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-rmse-of-numerical-vs-analytical-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-saturated-activator-nearest-neighbour-spacing>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-specimen-dark-blob-area-coefficient-of-variation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-specimen-wing-membrane-spot-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-two-sample-ks-statistic-of-numerical-vs-analytical-wavelength-sets>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-zero-flux-control-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation amplitude ratio = 0.22790379970689206 std(final)/std(initial)" ;
        dct:description "ablation sigma_max = -0.1010" ;
        schema:measurementTechnique "Du = Dv = 0.40, periodic Schnakenberg, T = 36; pattern must decay" ;
        schema:name "equal-diffusion ablation amplitude ratio" ;
        schema:unitText "std(final)/std(initial)" ;
        schema:value "0.22790379970689206" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-focal-linear-wavelength-lambda-k-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "focal linear wavelength lambda(k_max) = 2.12 µm" ;
        dct:description "analytical focal wavelength is 2.12 µm by calibration; the numerical Fourier peak is reported separately" ;
        schema:measurementTechnique "spatial calibration: (2 pi / k_max) * scale, scale chosen so this equals the slot wavelength" ;
        schema:name "focal linear wavelength lambda(k_max)" ;
        schema:unitText "µm" ;
        schema:value "2.12" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-focal-linear-wavelength-lambda-k-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-focal-linear-wavelength-lambda-k-max-reference> a schema:PropertyValue ;
        schema:value "2.12" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-grimshawi-geometric-mean-linear-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "grimshawi geometric-mean linear wavelength = 2.823282891000549 µm" ;
        schema:measurementTechnique "k_max with Du and Dv multiplied by sqrt(3.15)" ;
        schema:name "grimshawi geometric-mean linear wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.823282891000549" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-grimshawi-geometric-mean-linear-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-grimshawi-geometric-mean-linear-wavelength-reference> a schema:PropertyValue ;
        schema:value "2.12" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-grimshawi-stripe-coherency-minus-guttifera-spot-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "grimshawi stripe coherency minus guttifera spot coherency = 0.47008807404570835 structure-tensor coherency" ;
        dct:description "coh grimshawi=0.480, guttifera=0.010, heteroneura=0.028" ;
        schema:measurementTechnique "saturated fields; grimshawi anisotropy 3.15 versus guttifera isotropy plus sensillum Gaussian" ;
        schema:name "grimshawi stripe coherency minus guttifera spot coherency" ;
        schema:unitText "structure-tensor coherency" ;
        schema:value "0.47008807404570835" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-grimshawi-stripe-coherency-minus-guttifera-spot-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-grimshawi-stripe-coherency-minus-guttifera-spot-coherency-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-heteroneura-linear-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "heteroneura linear wavelength = 2.047534255940426 µm" ;
        dct:description "reference is the guttifera focal wavelength; the value must differ" ;
        schema:measurementTechnique "k_max at a = 0.24, same Du, Dv, no sensillum Gaussian" ;
        schema:name "heteroneura linear wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.047534255940426" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-heteroneura-linear-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-heteroneura-linear-wavelength-reference> a schema:PropertyValue ;
        schema:value "2.12" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-numerical-fourier-peak-wavelength-at-focal-dv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "numerical Fourier peak wavelength at focal Dv = 1.9828609103267116 µm" ;
        dct:description "value is the measured peak and is not forced equal to the 2.12 µm reference" ;
        schema:measurementTechnique "dominant non-zero mode of the linear-regime field, stopped at std(u)=0.08" ;

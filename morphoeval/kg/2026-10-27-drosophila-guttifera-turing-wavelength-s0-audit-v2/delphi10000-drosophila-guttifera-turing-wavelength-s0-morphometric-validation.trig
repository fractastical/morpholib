        schema:unitText "µm" ;
        schema:value "1.9828609103267116" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-numerical-fourier-peak-wavelength-at-focal-dv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-numerical-fourier-peak-wavelength-at-focal-dv-reference> a schema:PropertyValue ;
        schema:value "2.12" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-pearson-r-of-numerical-vs-analytical-wavelength-across-dv-sweep> a schema:PropertyValue,
            pk:EvidenceItem ;

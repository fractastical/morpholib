    rdfs:label "Inhibitor-activator diffusion separation" ;
    dct:description "Long-range inhibition required for spot selection at 2.12 µm | Variables: Du = 0.016, Dv = 1.25" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-guttifera-turing-wavelength-s0.py>,

        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.4e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg micro-ocellus wavelength of Drosophila guttifera at 2.12 µm — Morphometric validation: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Linear centroid: r = 0.992, RMSE = 0.208 µm, focal numerical value 1.983 µm against reference 2.12 µm. Saturated nearest-neighbour spacing is 1.332 µm (CV = 0.255, KS = 0.801 versus a normal at 2.12 µm), which widens the linear shortfall instead of cancelling it. Wing-membrane count is 18 versus 16. None of these specimen or spacing values were set equal to their references." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;

<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Schnakenberg micro-ocellus wavelength of Drosophila guttifera at 2.12 µm (Drosophila guttifera)",
        "Schnakenberg micro-ocellus wavelength of Drosophila guttifera at 2.12 µm faithfully reproduces Drosophila guttifera morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-guttifera-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-guttifera-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-guttifera-turing-wavelength-s0-3>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-guttifera-turing-wavelength-s0-4> ;
    dct:description "The simulation script(s) models/2026-delphi10000-drosophila-guttifera-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila guttifera specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-guttifera-turing-wavelength-s0.py> ;
    schema:about "Drosophila guttifera" ;
    schema:additionalProperty "does_not_claim: A second assessor. R4 is still open.",
        "does_not_claim: That 18 segmented spots are the named 16. Both wings are in the frame.",
        "does_not_claim: That Spieth 1981 measured a wing wavelength. It is cited for the heteroneura chronospecies, and the head-shape paper is not a wavelength source.",
        "does_not_claim: That the saturated spacing equals 2.12 µm. It is 1.33 µm.",
        "does_not_claim: That the zero-flux wavelength equals the periodic calibration. It is 1.77 µm.",
        "reconstructed_in_script: Focal parameters a=0.10, b=0.90, Du=0.016, Dv=1.25, scaled so λ(k_max)=2.12 µm.",
        "reconstructed_in_script: Grimshawi anisotropy 3.15 and heteroneura activator 0.24 at geological age 0 Ma.",
        "reconstructed_in_script: Periodic spectral centroid on a fixed band, equal-diffusion ablation, reflecting-boundary control, and saturated peak spacing.",
        "reconstructed_in_script: Wing-membrane mask: foreground outside the dilated reddish body.",
        "reported_in_source: Koseki, Tanaka & Koshikawa 2021: wingless expression inside campaniform sensilla.",
        "reported_in_source: Turing 1952 marginal wavenumber and Schnakenberg 1979 two-species kinetics.",
        "reported_in_source: Werner et al. 2010: Wingless at vein intersections and campaniform sensilla induces the yellow wing spots.",
        "transfer_boundary: 2.12 µm is the campaign detail tier. Werner et al. 2010 do not report that length.",
        "transfer_boundary: The adult photograph cannot resolve 2.12 µm. Its role is the organism, not a micrograph of the grain." ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Drosophila guttifera (Polka-Dotted 16-Spot Wing Fly)" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "II. Anaima (Invertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;

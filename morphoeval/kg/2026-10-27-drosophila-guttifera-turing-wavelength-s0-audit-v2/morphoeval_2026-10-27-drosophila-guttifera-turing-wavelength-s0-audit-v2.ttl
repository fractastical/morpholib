    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem chronospecies_prepatterns_differ : anisoGrimshawiNum > anisoDen ∧ activatorMilliHeteroneura > activatorMilliGuttifera ∧ activatorMilliGuttifera = 100 := by decide"^^pk:lean4 ;
    skos:notation "aniso_grimshawi = 3.15 > 1 and a_heteroneura = 0.24 > a_guttifera = 0.10" ;

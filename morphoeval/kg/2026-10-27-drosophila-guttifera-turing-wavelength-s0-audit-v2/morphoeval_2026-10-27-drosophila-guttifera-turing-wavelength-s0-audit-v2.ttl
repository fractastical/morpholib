    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg micro-ocellus wavelength of Drosophila guttifera at 2.12 µm — Model fidelity to source: 84/100" ;
    dct:date "2026-10-27"^^xsd:date ;

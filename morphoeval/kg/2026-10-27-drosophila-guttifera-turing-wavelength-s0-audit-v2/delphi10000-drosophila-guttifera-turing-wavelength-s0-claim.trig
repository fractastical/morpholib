sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Schnakenberg micro-ocellus wavelength of Drosophila guttifera at 2.12 µm faithfully reproduces Drosophila guttifera morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-guttifera-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila guttifera specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-guttifera-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-guttifera-turing-wavelength-s0.py; output: docs/media/drosophila_guttifera_turing_wavelength_s0_comparison.png; organism: Drosophila guttifera; environment: n/a; claim_boundary: [reported_in_source: Werner et al. 2010: Wingless at vein intersections and campaniform sensilla induces the yellow wing spots. | Koseki, Tanaka & Koshikawa 2021: wingless expression inside campaniform sensilla. | Turing 1952 marginal wavenumber and Schnakenberg 1979 two-species kinetics.; reconstructed_in_script: Focal parameters a=0.10, b=0.90, Du=0.016, Dv=1.25, scaled so λ(k_max)=2.12 µm. | Periodic spectral centroid on a fixed band, equal-diffusion ablation, reflecting-boundary control, and saturated peak spacing. | Wing-membrane mask: foreground outside the dilated reddish body. | Grimshawi anisotropy 3.15 and heteroneura activator 0.24 at geological age 0 Ma.; transfer_boundary: 2.12 µm is the campaign detail tier. Werner et al. 2010 do not report that length. | The adult photograph cannot resolve 2.12 µm. Its role is the organism, not a micrograph of the grain.; does_not_claim: That the saturated spacing equals 2.12 µm. It is 1.33 µm. | That the zero-flux wavelength equals the periodic calibration. It is 1.77 µm. | That 18 segmented spots are the named 16. Both wings are in the frame. | That Spieth 1981 measured a wing wavelength. It is cited for the heteroneura chronospecies, and the head-shape paper is not a wavelength source. | A second assessor. R4 is still open.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1007/s00427-017-0578-3>,
            <https://doi.org/10.1007/s00427-021-00674-z>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/nature06341>,
            <https://doi.org/10.1038/nature08896>,
            <https://doi.org/10.1073/pnas.1509022112>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.2307/2407863> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-guttifera-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-guttifera-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


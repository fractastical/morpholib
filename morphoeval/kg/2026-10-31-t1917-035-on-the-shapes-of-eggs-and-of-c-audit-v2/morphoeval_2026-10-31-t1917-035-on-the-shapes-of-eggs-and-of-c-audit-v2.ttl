<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-035-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-035-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-035-3> .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-035-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Preston meridian pole radii and reflection invariance (hollow shell profile)" ;
    dct:description "Defines axisymmetric meridian of hollow urchin test and pole-radius symmetry for symmetric ends | Variables: c0..c3 Preston coefficients; R_pole osculating radius at poles" ;
    dct:source "Thompson (1917) Ch. XV Fig. 328; Preston (1953) meridian family" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/pending/morphoeval/lean/loops/Thompson1917_T1917_035.lean>,
        <https://github.com/fractastical/morpholib/blob/pending/thompson/claims/t1917-035_on-the-shapes-of-eggs-and-of-certain-other-hollo.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "R_pole = p(±1)^2; p(1)-p(-1)=2(c1+c3)" ;
    pk:hypothesisType "Mechanistic-geometric: axisymmetric thin shell / membrane meridian under Thompson (1917) envelope pressure and tension" ;
    pk:leanDeclaration "MathOfBiology.Loop_229.prestonPoly" ;
    pk:leanTheorem "MathOfBiology.Loop_229.preston_pole_symmetry_and_sphere" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-035-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Solid-of-revolution volume functional" ;
    dct:description "Quantifies enclosed volume of the membrane-bounded shell | Variables: V volume; L length; c0..c3" ;
    dct:source "Thompson (1917) p. 652 solid of revolution" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/pending/morphoeval/lean/loops/Thompson1917_T1917_035.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "315 V / (4 pi (L/2)^3) = prestonVolume315(c)" ;
    pk:hypothesisType "Mechanistic-geometric: axisymmetric thin shell / membrane meridian under Thompson (1917) envelope pressure and tension" ;
    pk:leanDeclaration "MathOfBiology.Loop_229.prestonVolume315" ;
    pk:leanTheorem "MathOfBiology.Loop_229.preston_volume_sphere_scaling" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-035-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Thompson envelope pole equilibrium P R = 2 T" ;
    dct:description "Thompson pressure/tension closure used in thompson_closure and mean curvature profile | Variables: p_n normal pressure; T tension; r,r' principal radii; P internal pressure" ;
    dct:source "Thompson (1917) pp. 658-659 envelope equation" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/pending/morphoeval/lean/loops/Thompson1917_T1917_035.lean>,

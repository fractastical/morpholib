sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-035> a pk:Claim ;
        rdfs:label "Thompson (1917) Ch. XV Fig. 328 — sea-urchin test meridian under envelope pressure/tension (Pass 2) faithfully reproduces Echinoid tests — Commons CC BY 2.0 (primary + 14 panel instances); literature ratio CSV morphology" ;
        dct:description "The simulation script(s) thompson/claims/t1917-035_on-the-shapes-of-eggs-and-of-certain-other-hollo.py implement the cited source model as published and produce forms that match real Echinoid tests — Commons CC BY 2.0 (primary + 14 panel instances); literature ratio CSV specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-035_on-the-shapes-of-eggs-and-of-certain-other-hollo.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-035_on-the-shapes-of-eggs-and-of-certain-other-hollo.py; output: docs/media/t1917_035_on_the_shapes_of_eggs_and_of_c_comparison.png; organism: Echinoid tests — Commons CC BY 2.0 (primary + 14 panel instances); literature ratio CSV; environment: python 3.12, numpy 2.x, scipy 1.x, matplotlib 3.x, scikit-image 0.26.x, Pillow 10+; claim_boundary: [reported_in_source: Thompson 1917: hollow structures including sea-urchin tests (Fig. 328) explicable as membranes/shells under pressure and tension. | Envelope equation p_n + T(1/r + 1/r') = P (p. 658).; reconstructed_in_script: Major-axis CV meridian; symmetric-pole Preston fit; Thompson 4-constraint closure; 2H profile; closure sweep GIF. | 14-test panel elongation dispersion; sphere ablation; KS vs literature axial:equatorial ratios.; transfer_boundary: Axisymmetric approximation of pentamerous urchin test; calcareous ossicle microstructure not modelled. | Dryad dn160 excluded (DATASET_MISMATCH); skulls/shells in claim not tested.; does_not_claim: That genetics dataset dn160 supports the claim. | Dynamic growth of the test — static meridian fit only.]" .
    <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-035_on-the-shapes-of-eggs-and-of-certain-other-hollo.py> a schema:SoftwareSourceCode ;
        rdfs:label "thompson/claims/t1917-035_on-the-shapes-of-eggs-and-of-certain-other-hollo.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> .
}


<https://w3id.org/delphi/resource/evidence/2026-10-27-drosophila-serrata-turing-wavelength-s0-audit-delphi10000-drosophila-serrata-turing-wavelength-s0-1> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "RK2 vs analytic Turing dispersion Pearson r" ;
    dct:description "Pearson correlation of σ(k) from the closed-form eigenvalue and from RK2 integration of the linearized mode, 12 wavenumbers" ;
    dct:source "Turing 1952 dispersion identity; reference is exact agreement, the numerical value is the RK2 residual" ;
    rdfs:comment "RMSE = 0.00168968" ;
    schema:about "Drosophila serrata" ;
    schema:error 2e-03 ;
    schema:targetValue 1e+00 ;
    schema:unitText "Pearson r" ;
    schema:value 9.9998e-01 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-drosophila-serrata-turing-wavelength-s0-audit-delphi10000-drosophila-serrata-turing-wavelength-s0-2> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "dispersion RMSE between RK2 and analytic growth rate" ;
    dct:description "RMSE of σ_RK2(k) against σ_analytic(k) on k in [0.55, 1.45] k_c" ;
    dct:source "zero residual would be an exact integrator" ;
    schema:about "Drosophila serrata" ;
    schema:error 1.69e-01 ;
    schema:targetValue 0e+00 ;
    schema:unitText "1/time" ;
    schema:value 1.69e-03 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-drosophila-serrata-turing-wavelength-s0-audit-delphi10000-drosophila-serrata-turing-wavelength-s0-3> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "serrata nonlinear patch measured-to-critical wavenumber ratio" ;
    dct:description "FFT peak of the periodic Schnakenberg patch divided by the band-center k_c" ;
    dct:source "band-center formula k_c^2 = (Dv fu + Du gv) / (2 Du Dv); off onset the fastest mode sits slightly below k_c" ;
    rdfs:comment "equal-diffusion control std = 0.0000 vs pattern std = 0.0600" ;
    schema:about "Drosophila serrata" ;
    schema:error 4.8e+00 ;
    schema:targetValue 1e+00 ;
    schema:unitText "k_measured / k_c" ;
    schema:value 9.52e-01 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-drosophila-serrata-turing-wavelength-s0-audit-delphi10000-drosophila-serrata-turing-wavelength-s0-4> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "equal-diffusion ablation maximum growth rate" ;
    dct:description "max_k σ(k) with Dv = Du (negative control)" ;
    dct:source "marginal stability boundary; a negative value is the stable side" ;
    rdfs:comment "control vs Turing: equal diffusion is linearly stable" ;
    schema:about "Drosophila serrata" ;
    schema:error 2.3102e+01 ;
    schema:targetValue 0e+00 ;
    schema:unitText "1/time" ;
    schema:value -2.3102e-01 .


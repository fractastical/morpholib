<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-serrata-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Band-center instability criterion at the 2.123 µm serrata point | Variables: fu, gv, det scaled by 1e6; delta_serrata = 98855/10000" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3203_drosophila_serrata_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J - k^2 D) = Du Dv k^4 - (Dv fu + Du gv) k^2 + (fu gv - fv gu)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1023/A:1022992002239>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1558-5646.2009.00936.x>,
        <https://doi.org/10.1126/science.290.5491.519> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection (Schnakenberg)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3203.serrata_turing_inequality" ;
    pk:leanTheorem "MathOfBiology.Loop_3203.serrata_turing_inequality" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-serrata-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength" ;
    dct:description "Poson law for the detail-scale ocellus / pigment-granule wavelength | Variables: lambda_serrata = 2123 nm; patch = 8 wavelengths = 16984 nm" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3203_drosophila_serrata_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 2 pi / k_c with k_c^2 = (Dv fu + Du gv) / (2 Du Dv)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1023/A:1022992002239>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1558-5646.2009.00936.x>,
        <https://doi.org/10.1126/science.290.5491.519> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection (Schnakenberg)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3203.lambdaSerrataNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3203.tergite_patch_holds_eight_wavelengths" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-serrata-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries wavelength shortening" ;
    dct:description "What changes at 0 Ma and 2.1 µm relative to the predecessor and successor | Variables: 2102 < 2123 < 2134 nm" ;
    dct:source "Frentiu & Chenoweth 2010 DOI:10.1111/j.1558-5646.2009.00936.x" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3203_drosophila_serrata_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_silvestris < lambda_serrata < lambda_sechellia at fixed Du" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1023/A:1022992002239>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1558-5646.2009.00936.x>,
        <https://doi.org/10.1126/science.290.5491.519> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection (Schnakenberg)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3203.chronoseries_detail_wavelength_shortens" ;
    pk:leanTheorem "MathOfBiology.Loop_3203.chronoseries_detail_wavelength_shortens" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-serrata-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion negative control" ;
    dct:description "Ablation — no finite unstable wavenumber when diffusivities are equal | Variables: 937447 + (-1399489) < 0" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3203_drosophila_serrata_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "fu + gv < 0 so Dv fu + Du gv < 0 when Dv = Du" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1023/A:1022992002239>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1558-5646.2009.00936.x>,
        <https://doi.org/10.1126/science.290.5491.519> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection (Schnakenberg)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3203.equal_diffusion_trace_diffusion_negative" ;
    pk:leanTheorem "MathOfBiology.Loop_3203.equal_diffusion_trace_diffusion_negative" ;
    pk:leanVerified true .


    pk:hasScore 8.4e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Drosophila serrata Schnakenberg Turing wavelength at 2.123 µm (Holocene, 0 Ma) (Drosophila serrata)",
        "Drosophila serrata Schnakenberg Turing wavelength at 2.123 µm (Holocene, 0 Ma) faithfully reproduces Drosophila serrata morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-serrata-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-serrata-turing-wavelength-s0-2>,

    schema:additionalProperty "does_not_claim: A published measurement of a 2.123 µm ocellar Turing wavelength in D. serrata",
        "does_not_claim: That D. sechellia is the phylogenetic sister of D. serrata",
        "reconstructed_in_script: 2.123e-6 m assigned as λ_c for this detail-scale slot",
        "reconstructed_in_script: Chronoseries wavelengths 2134 / 2123 / 2102 nm at fixed activator diffusivity",
        "reconstructed_in_script: Latitude slope 0.012 mapping cline direction onto δ",
        "reported_in_source: D. serrata CHC cline along the Australian east coast (Frentiu & Chenoweth 2010)",
        "reported_in_source: Schnakenberg 1979 trimolecular kinetics",
        "reported_in_source: Turing 1952 diffusion-driven instability and a finite critical wavenumber",
        "transfer_boundary: GIF colors are the plate's luminance-quantile palette",
        "transfer_boundary: Gallery plate is the species-gallery fallback, not a measured 2.1 µm micrograph" ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Drosophila serrata (Australasian Montium-Subgroup Fly)" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "II. Anaima (Invertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;
    pk:aristotelianSubalternClass "Entoma (Arthropoda)" ;
    pk:biologicalGenus "Drosophila" ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila serrata Schnakenberg Turing wavelength at 2.123 µm (Holocene, 0 Ma) — Morphological realism / specimen match: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The GIF last frame is a radial J0 ocellus in the plate's brown palette. Computer-vision similarity against that plate is 94.1 (12-bin orientation, 24-bin radial FFT, coherency). The plate is a project gallery fallback whose printed bar says 100 µm, so it is a texture reference for an ocellus-like field, not a voucher at 2.1 µm. That cap is why this is not 90+." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/drosophila_serrata_turing_wavelength_s0_growth.gif (generated output)" ;
        dct:description "12-frame 640×520 ocellus growth; CV similarity 94.1 — docs/media/drosophila_serrata_turing_wavelength_s0_growth.gif: rendered output of models/2026-delphi10000-drosophila-serrata-turing-wavelength-s0.py at 0c76d15d, image/gif, 3313138 B, 640×520 px, 12 frames, artifact_sha256 2fbf667000d2f0d9c417e8cba8dfaf6605316b7eef9594423c985db302f2ec69 (sha256 2fbf667000d2f0d9c417e8cba8dfaf6605316b7eef9594423c985db302f2ec69), spec_fingerprint a3c4b3d65dab3b0ebfbf973810a2da1a980cfa0eca08496d6d9c3676418453c9" .

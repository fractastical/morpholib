sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila serrata Schnakenberg Turing wavelength at 2.123 µm (Holocene, 0 Ma) — Model fidelity to source: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Jacobian, onset δ_c, k_c^2 = (δ f_u + g_v)/(2 δ D_u), and σ(k) are the Schnakenberg linearization of Turing 1952. RK2 on the same ODE agrees at r = 0.99998. The nonlinear FFT peak at k/k_c = 0.952 is not yet compared with k_max, so the off-onset shift is easy to misread as an implementation error." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-serrata-turing-wavelength-s0.py L97–L145" ;
        dct:description "Jacobian and analytic growth rate σ(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-serrata-turing-wavelength-s0.py#L97-L145> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-serrata-turing-wavelength-s0.py L147–L179" ;
        dct:description "RK2 mode growth and Pearson/RMSE fit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-serrata-turing-wavelength-s0.py#L147-L179> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-serrata-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3203_drosophila_serrata_turing_wavelength_s0.lean L43–L46" ;
        dct:description "Integer Turing inequality, 0 sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3203_drosophila_serrata_turing_wavelength_s0.lean#L43-L46> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


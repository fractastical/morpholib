sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Gasterosteus doryssus_late Turing wavelength at 27 µm (9.99 Ma) faithfully reproduces Gasterosteus doryssus_late morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Gasterosteus doryssus_late specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0.py; output: docs/media/gasterosteus_doryssus_late_turing_wavelength_s0_growth.gif; organism: Gasterosteus doryssus_late; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion relation and diffusion-driven instability | Kondo and Miura 2010 treat pigment patterns as reaction-diffusion wavelengths | Hunt, Bell and Travis 2008 document pelvic evolution in a fossil stickleback lineage; reconstructed_in_script: Schnakenberg parameters with r=25 so the continuum fastest mode is 27.07 µm | Du scaled with lambda_m squared across mid (33.62 µm), late (27.07 µm) and marine (21.48 µm) | Far-field spiral used as the late ocellus render, arm spacing measured on the native frame; transfer_boundary: 27 µm is the tier-4 detail assignment, not a caliper reading on Truckee material | The gallery plate is an illustrated ocellus card with a 100 µm bar; does_not_claim: Does not claim fossil melanophores were measured at 27 µm | Does not claim the gallery JPEG is a photograph of a Miocene specimen | Does not reuse the 1.7 mm parameters of slot 1209 | Does not claim a second assessor or a kernel-checked Lean build]; phenomenon_size: 32 µm (3.168e-05 m, log10=-4.499 m, tier=4_cellular_10um); species_scale_ladder (10 runs from 32 µm to 9.9 cm): 32 µm:gasterosteus-aculeatus-bioelectric-polarity, 118 µm:gasterosteus-aculeatus-vertex-packing, 2.2 mm:gasterosteus-aculeatus-turing-wavelength, 4.1 mm:gasterosteus-aculeatus-clock-wavefront, 9.6 mm:gasterosteus-aculeatus-elastic-buckling, 1.3 cm:gasterosteus-aculeatus-morphogen-condensation, 1.7 cm:gasterosteus-aculeatus-flux-canalization, 2.2 cm:gasterosteus-aculeatus-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.1558-5646.2007.00310.x>,
            <https://doi.org/10.1126/science.1179047> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Gasterosteus doryssus_late Turing wavelength at 27 µm (9.99 Ma) — Model fidelity to source: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The Jacobian, continuum dispersion, discrete symbol and 1D ring match the stated Schnakenberg system, and the equal-diffusion control closes the Turing band. The animated frame remains a far-field spiral at the selected wavelength rather than a 2D PDE, which is why this is not 95." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "models/2026-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0.py L298–L316: render is the far-field spiral <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0.py#L298-L316>" ;

        dct:source "identical-orientation reference" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;

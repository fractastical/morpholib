sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Gasterosteus doryssus_late Turing wavelength at 27 µm (9.99 Ma) — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r=0.999999 and RMSE=0.309 µm on five Du scales. Late discrete wavelength 26.77 µm versus continuum 27.07 µm. Noise-seeded ring 28.96 µm. Native-frame arm spacing 27.10 µm. KS D=0.050. None of these measured values is copied from its reference. What is not claimed is a fossil melanophore count." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-ap-stripe-power-fraction-at-late-anisotropy>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-discrete-laplacian-wavelength-g-doryssus-late>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-du-sweep-pearson-r-discrete-laplacian-vs-continuum-k-m>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-du-sweep-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-equal-diffusion-amplitude-ratio-vs-turing-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-noise-seeded-schnakenberg-ring-wavelength-late-chronospecies>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-rendered-ocellus-radial-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-specimen-vs-ocellus-orientation-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-ap-stripe-power-fraction-at-late-anisotropy> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "AP stripe-power fraction at late anisotropy = 0.6221 fraction of unstable power" ;
        dct:description "marine eps=2.15 is higher still" ;
        schema:measurementTechnique "anisotropic inhibitor diffusion eps=1.42, σ(kx,ky)>0" ;
        schema:name "AP stripe-power fraction at late anisotropy" ;
        schema:unitText "fraction of unstable power" ;
        schema:value "0.6221" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-ap-stripe-power-fraction-at-late-anisotropy-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-ap-stripe-power-fraction-at-late-anisotropy-reference> a schema:PropertyValue ;
        dct:source "isotropic mid chronospecies eps=1" ;
        schema:value "0.5043" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-discrete-laplacian-wavelength-g-doryssus-late> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "discrete-Laplacian wavelength, G. doryssus_late = 26.769 µm" ;
        dct:description "grid Laplacian shortens the selected wavelength relative to k^2" ;
        schema:measurementTechnique "argmax of sigma(k) with periodic symbol (2-2cos(k dx))/dx^2 at dx=2.2 µm" ;
        schema:name "discrete-Laplacian wavelength, G. doryssus_late" ;
        schema:unitText "µm" ;
        schema:value "26.769" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-discrete-laplacian-wavelength-g-doryssus-late-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-discrete-laplacian-wavelength-g-doryssus-late-reference> a schema:PropertyValue ;
        dct:source "continuum fastest mode targeted at 27.07 µm" ;
        schema:value "27.07" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-du-sweep-pearson-r-discrete-laplacian-vs-continuum-k-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Du-sweep Pearson r discrete Laplacian vs continuum k_m = 0.999999 correlation" ;
        dct:description "r is computed, not assigned the gate value" ;
        schema:measurementTechnique "five Du scales; continuum lambda_m versus periodic-grid lambda_m" ;
        schema:name "Du-sweep Pearson r discrete Laplacian vs continuum k_m" ;
        schema:unitText "correlation" ;
        schema:value "0.999999" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-du-sweep-pearson-r-discrete-laplacian-vs-continuum-k-m-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-du-sweep-pearson-r-discrete-laplacian-vs-continuum-k-m-reference> a schema:PropertyValue ;
        dct:source "MorphoEval gate Pearson r > 0.98" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-du-sweep-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Du-sweep RMSE = 0.3095 µm" ;
        dct:description "dispersion of the nonlinear correction" ;
        schema:measurementTechnique "sqrt mean square gap between nonlinear and linear wavelengths" ;
        schema:name "Du-sweep RMSE" ;
        schema:unitText "µm" ;
        schema:value "0.3095" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-du-sweep-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-du-sweep-rmse-reference> a schema:PropertyValue ;
        dct:source "zero-error reference, not attained" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-equal-diffusion-amplitude-ratio-vs-turing-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion amplitude ratio vs Turing amplitude ratio = 0.0 std(final)/std(initial)" ;
        dct:description "control must decay while the Turing run grows" ;
        schema:measurementTechnique "1800-step periodic ring, identical noise, D_v=D_u versus r=25" ;
        schema:name "equal-diffusion amplitude ratio vs Turing amplitude ratio" ;
        schema:unitText "std(final)/std(initial)" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-equal-diffusion-amplitude-ratio-vs-turing-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-equal-diffusion-amplitude-ratio-vs-turing-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "same initial data with r=25" ;
        schema:value "2.1705" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control sigma_max = -0.3896 1/s" ;
        dct:description "negative control: band is closed" ;
        schema:measurementTechnique "Schnakenberg dispersion with D_v = D_u" ;
        schema:name "equal-diffusion control sigma_max" ;
        schema:unitText "1/s" ;
        schema:value "-0.3896" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> a schema:PropertyValue ;
        dct:source "marginal stability" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-noise-seeded-schnakenberg-ring-wavelength-late-chronospecies> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "noise-seeded Schnakenberg ring wavelength, late chronospecies = 28.9569 µm" ;
        dct:description "nonlinear ring, not the discrete-symbol sweep" ;
        schema:measurementTechnique "FFT of the explicit periodic Schnakenberg integration at Du_late" ;
        schema:name "noise-seeded Schnakenberg ring wavelength, late chronospecies" ;
        schema:unitText "µm" ;
        schema:value "28.9569" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-noise-seeded-schnakenberg-ring-wavelength-late-chronospecies-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-noise-seeded-schnakenberg-ring-wavelength-late-chronospecies-reference> a schema:PropertyValue ;
        dct:source "continuum lambda_m = 27.07 µm" ;
        schema:value "27.07" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-rendered-ocellus-radial-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "rendered ocellus radial wavelength = 27.1037 µm" ;
        dct:description "a full-frame radial FFT is dominated by the swirl envelope and is not used" ;
        schema:measurementTechnique "mean peak spacing on the mid-ray of the final GIF frame, 1.061 µm/px" ;
        schema:name "rendered ocellus radial wavelength" ;
        schema:unitText "µm" ;
        schema:value "27.1037" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-rendered-ocellus-radial-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-rendered-ocellus-radial-wavelength-reference> a schema:PropertyValue ;
        dct:source "continuum lambda_m of G. doryssus_late" ;
        schema:value "27.07" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.6644 coherency" ;
        dct:description "plate and render are compared, not set equal" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) on the gallery plate" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.6644" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "coherency of the rendered late ocellus" ;
        schema:value "0.9836" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-measurement-specimen-vs-ocellus-orientation-ks-statistic> a schema:PropertyValue,

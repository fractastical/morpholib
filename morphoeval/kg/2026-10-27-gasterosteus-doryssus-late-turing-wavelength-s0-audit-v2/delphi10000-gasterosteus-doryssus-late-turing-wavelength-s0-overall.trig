sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Gasterosteus doryssus_late Turing wavelength at 27 µm (9.99 Ma) — MorphoEval overall 86.2/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 2 closes the pass-1 measurement gaps. Continuum lambda_m is 27.07 µm at 9.99 Ma. The periodic-grid Laplacian returns 26.77 µm (late), 21.10 µm (marine) and 33.38 µm (mid). Sweep Pearson r=0.999999, RMSE=0.309 µm. Equal diffusion has sigma_max=-0.390 and the seeded mode decays; r=25 grows (amplitude ratio 2.17). Noise-seeded ring wavelength is 28.96 µm. Native-frame arm spacing is 27.10 µm. Orientation KS D=0.050 on the saved GIF (0.045 before GIF quantization). Official CV similarity of the 12-frame 640x480 GIF is 82.3. Weighted overall 86.2. Overall 86.2/100 (faithfulness 86.0, reproducibility 86.8); rubric morphoeval 0.1.0; checkpoint commit 0c76d15d14afcec6c366e1b9274a6586a0de48fc; environment: . Dimension assessments: Model fidelity to source 86, Morphological realism / specimen match 84, Parameter expressivity 88, Morphometric validation 88, Source and data traceability 90, Code-to-model traceability 84, Reproducibility package 86. Output judged: docs/media/gasterosteus_doryssus_late_turing_wavelength_s0_growth.gif: rendered output of models/2026-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/gif, 4032955 B, 640×480 px, 12 frames, artifact_sha256 7a79f832eea0a10c441d64af747767d01f641f64f13c180e0f3ff280d02a05cd (sha256 7a79f832eea0a10c441d64af747767d01f641f64f13c180e0f3ff280d02a05cd), spec_fingerprint 0c1ce9846748ee130d74966458c9300403c6aaed0648f54674b1db5a5f1d5f0e. Dual provenance: spec_fingerprint: 0c1ce9846748ee130d74966458c9300403c6aaed0648f54674b1db5a5f1d5f0e; artifact_sha256: 7a79f832eea0a10c441d64af747767d01f641f64f13c180e0f3ff280d02a05cd; input_dataset_sha256: {datasets/gasterosteus_doryssus_late_turing_wavelength_s0/gasterosteus_doryssus_late_specimen.jpg=fd5b18be03310ca2..., datasets/gasterosteus_doryssus_late_turing_wavelength_s0/gasterosteus_doryssus_late_turing_wavelength_s0_reference.json=ba025b0273725b76...}. Supersedes audit: 2026-10-27-gasterosteus-doryssus-late-turing-wavelength-s0-audit. Claim boundary: reported_in_source: Turing 1952 dispersion relation and diffusion-driven instability | Kondo and Miura 2010 treat pigment patterns as reaction-diffusion wavelengths | Hunt, Bell and Travis 2008 document pelvic evolution in a fossil stickleback lineage; reconstructed_in_script: Schnakenberg parameters with r=25 so the continuum fastest mode is 27.07 µm | Du scaled with lambda_m squared across mid (33.62 µm), late (27.07 µm) and marine (21.48 µm) | Far-field spiral used as the late ocellus render, arm spacing measured on the native frame; transfer_boundary: 27 µm is the tier-4 detail assignment, not a caliper reading on Truckee material | The gallery plate is an illustrated ocellus card with a 100 µm bar; does_not_claim: Does not claim fossil melanophores were measured at 27 µm | Does not claim the gallery JPEG is a photograph of a Miocene specimen | Does not reuse the 1.7 mm parameters of slot 1209 | Does not claim a second assessor or a kernel-checked Lean build." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "open need [independent_assessor/model-fidelity, pressure P=1.3]: A second assessor from another provider has not scored this script.",
            "open need [specimen_comparison/specimen-match, pressure P=2.8]: No Miocene thin section preserves a 27 µm melanophore spacing to replace the gallery ocellus card.",
            "remediation needed: {'id': 'R1', 'item': 'Resolved in this pass: Du-sweep Pearson r=0.999999, RMSE=0.309 µm, late discrete wavelength 26.77 µm versus reference 27.07 µm.', 'status': 'resolved'}",
            "remediation needed: {'id': 'R2', 'item': 'Resolved in this pass: equal-diffusion sigma_max=-0.390 and amplitude collapse, against Turing amplitude ratio 2.17.', 'status': 'resolved'}",
            "remediation needed: {'id': 'R3', 'item': 'Resolved in this pass: orientation KS D=0.050, coherency compared, native-frame arm spacing 27.10 µm.', 'status': 'resolved'}",
            "remediation needed: {'id': 'R4', 'item': 'Resolved in this pass: CV similarity 82.3 on the 12-frame 640x480 GIF; specimen-match rescored to 84.', 'status': 'resolved'}" ;
        pk:hasScore "0.862"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/hentschel-tgfb-fibronectin-limb-1>,
        <https://w3id.org/probknow/resource/math-law/hentschel-tgfb-fibronectin-limb-2>,
        <https://w3id.org/probknow/resource/math-law/hentschel-tgfb-fibronectin-limb-3> .

<https://w3id.org/probknow/resource/math-law/hentschel-tgfb-fibronectin-limb-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-Diffusion (D_a = D_i) & Anti-Fibronectin No-Haptotaxis (chi_F = 0) Negative Controls" ;
    dct:description "Proves that equal morphogen diffusivities abolish the TGF-beta chemical prepattern and that blocking fibronectin haptotaxis (χ_F = 0, e.g. anti-fibronectin antibody or RGD peptide) abolishes mesenchymal cell condensation | Variables: c_a: activator TGF-beta concentration; c_i: FGF-dependent inhibitor concentration; R: mesenchymal cell density; χ_F: fibronectin haptotactic sensitivity; D_R: cell random motility" ;
    dct:source "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B 271(1549):1713-1722 Eqs. (2.1)-(3.6); Kiskowski et al. (2004) Dev. Biol. 271(2):372-387" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2004-hentschel-tgfb-fibronectin-limb.py#L120-L225>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_014_tgfb_fibronectin_limb.lean#L21-L55> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def tgfb_modal_trace_eq_diff (tr_J0 Dq : Int) : Int := tr_J0 - 2 * Dq
def tgfb_modal_det_eq_diff (det_J0 neg_tr_Dq Dq_sq : Int) : Int :=
  det_J0 + neg_tr_Dq + Dq_sq
def sigma_R_no_hapto (D_R_q r_R : Int) : Int := -D_R_q - r_R
theorem hentschel_tgfb_inhibitor_haptotaxis_stability_controls
    (tr_J0 det_J0 Dq neg_tr_Dq Dq_sq D_R_q r_R : Int)
    (htr : tr_J0 < 0) (hdet : det_J0 > 0)
    (hDq : Dq ≥ 0) (hterm : neg_tr_Dq ≥ 0) (hsq : Dq_sq ≥ 0)
    (hDR : D_R_q ≥ 0) (hr : r_R > 0) :
    tgfb_modal_trace_eq_diff tr_J0 Dq < 0 ∧
    tgfb_modal_det_eq_diff det_J0 neg_tr_Dq Dq_sq > 0 ∧
    sigma_R_no_hapto D_R_q r_R < 0 := by
  unfold tgfb_modal_trace_eq_diff tgfb_modal_det_eq_diff sigma_R_no_hapto; omega
"""^^pk:lean4 ;
    skos:notation "tr(J_0) < 0 ∧ det(J_0) > 0 ∧ D_a = D_i = D ≥ 1 ∧ χ_F = 0 ⟹ ∀ q = k^2 ≥ 0, tr(J_k) < 0 ∧ det(J_k) > 0 ∧ σ_R(q; χ_F=0) = -D_R q - r_R < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2005.10.016>,
        <https://doi.org/10.1016/j.ydbio.2004.03.038>,
        <https://doi.org/10.1098/rsif.2005.0033>,
        <https://doi.org/10.1098/rspb.2004.2772>,
        <https://doi.org/10.1186/1752-0509-1-16> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Multiscale Reactor-Mechanochemical Limb" ;
    pk:leanDeclaration "MathOfBiology.Loop_014.sigma_R_no_hapto" ;
    pk:leanTheorem "MathOfBiology.Loop_014.hentschel_tgfb_inhibitor_haptotaxis_stability_controls" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/hentschel-tgfb-fibronectin-limb-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "AER-FGF Zonation & Proximodistal 1 -> 2 -> 3 -> 4 Skeletal Mode Transition" ;
    dct:description "Proves that proximodistal AER-FGF zonation monotonically increases the unstable anteroposterior wavenumber across stylopod (m=1 humerus), zeugopod (m=2 radius+ulna), chick wing autopod (m=3 digits II-IV), and hindlimb/exogenous-TGF-beta autopod (m=4 digits I-IV) | Variables: c_FGF(z): distal AER fibroblast growth factor concentration; f_a(c_FGF) ∈ {3, 6, 11, 18}: FGF-modulated TGF-beta self-activation rate; m ∈ {1, 2, 3, 4}: anteroposterior skeletal condensation count" ;
    dct:source "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B 271(1549):1713-1722 Eqs. (3.1)-(3.12) & Figs. 2-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2004-hentschel-tgfb-fibronectin-limb.py#L230-L390>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_014_tgfb_fibronectin_limb.lean#L62-L96> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def hentschel_trace_J0 (fa : Int) : Int := fa - 200
def hentschel_mode_sq (fa : Int) : Int := fa - 2
theorem hentschel_fgf_zonation_proximodistal_mode_transition (fa1 fa2 : Int)
    (h12 : fa1 < fa2) (h2 : fa2 < 200) :
    hentschel_mode_sq fa1 < hentschel_mode_sq fa2 ∧
    hentschel_trace_J0 fa2 < 0 ∧
    hentschel_mode_sq 3 = 1 * 1 ∧
    hentschel_mode_sq 6 = 2 * 2 ∧
    hentschel_mode_sq 11 = 3 * 3 ∧
    hentschel_mode_sq 18 = 4 * 4 := by
  unfold hentschel_mode_sq hentschel_trace_J0; omega
"""^^pk:lean4 ;
    skos:notation "∂_t c_a = f_a(c_FGF) c_a + f_i c_i - c_a^3 + D_a ∇^2 c_a;  m^2(f_a) = (D_i f_a + D_a g_i) / (2 D_a D_i) = f_a - 2 ∈ {1^2, 2^2, 3^2, 4^2}" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2005.10.016>,
        <https://doi.org/10.1016/j.ydbio.2004.03.038>,
        <https://doi.org/10.1098/rsif.2005.0033>,
        <https://doi.org/10.1098/rspb.2004.2772>,
        <https://doi.org/10.1186/1752-0509-1-16> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Multiscale Reactor-Mechanochemical Limb" ;
    pk:leanDeclaration "MathOfBiology.Loop_014.hentschel_mode_sq" ;
    pk:leanTheorem "MathOfBiology.Loop_014.hentschel_fgf_zonation_proximodistal_mode_transition" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/hentschel-tgfb-fibronectin-limb-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Fibronectin Haptotactic Positive-Feedback Amplification & Micromass Spot/Stripe Morphospace" ;
    dct:description "Proves that positive feedback between TGF-beta-stimulated fibronectin secretion and upward mesenchymal haptotaxis amplifies prechondrogenic cell condensations above random cell diffusion and governs the 2D micromass nodular-spot vs labyrinthine-stripe morphospace | Variables: F(x,z,t): extracellular matrix fibronectin concentration; R_2(c_a,R): FGF/TGF-beta-differentiated prechondrogenic cell density; χ_F S_F: effective haptotactic sensitivity" ;
    dct:source "Hentschel et al. (2004) Proc. R. Soc. B 271:1713-1722 Eqs. (2.4)-(2.9); Kiskowski et al. (2004) Dev. Biol. 271:372-387; Miura & Shiota (2000) Dev. Dyn. 217:241-249" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2004-hentschel-tgfb-fibronectin-limb.py#L395-L530>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_014_tgfb_fibronectin_limb.lean#L103-L130> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def hapto_net_flux (chi_F_SF D_R q : Int) : Int := (chi_F_SF - D_R) * q
theorem hentschel_kiskowski_fibronectin_haptotaxis_amplification
    (chi_F_SF D_R q : Int)
    (hchi : chi_F_SF > D_R) (hDR : D_R ≥ 0) (hq : q ≥ 1) :
    hapto_net_flux chi_F_SF D_R q > 0 ∧
    hapto_net_flux 0 D_R q ≤ 0 ∧
    hapto_net_flux chi_F_SF D_R q > hapto_net_flux 0 D_R q := by
  unfold hapto_net_flux
  have hdiff : chi_F_SF - D_R ≥ 1 := by omega
  have hpos : (chi_F_SF - D_R) * q ≥ 1 * 1 := Int.mul_le_mul hdiff hq (by omega) (by omega)
  have hneg : (0 - D_R) * q ≤ 0 := Int.mul_nonpos_of_nonpos_of_nonneg (by omega) (by omega)
  omega
"""^^pk:lean4 ;
    skos:notation "∂_t F = k_F c_a^+ R_2 - γ_F F,  ∂_t R = D_R ∇^2 R - χ_F ∇·(R ∇F) + r_R R(1 - R);  J_hapto(q) = (χ_F S_F - D_R) q > 0 for χ_F S_F > D_R" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2005.10.016>,
        <https://doi.org/10.1016/j.ydbio.2004.03.038>,
        <https://doi.org/10.1098/rsif.2005.0033>,
        <https://doi.org/10.1098/rspb.2004.2772>,
        <https://doi.org/10.1186/1752-0509-1-16> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Multiscale Reactor-Mechanochemical Limb" ;
    pk:leanDeclaration "MathOfBiology.Loop_014.hapto_net_flux" ;
    pk:leanTheorem "MathOfBiology.Loop_014.hentschel_kiskowski_fibronectin_haptotaxis_amplification" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


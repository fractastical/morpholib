    pk:evidenceAgainst "2004-hentschel-tgfb-fibronectin-limb.py L40–L68: Missing 4-stage PDE sweep, 2D micromass morphospace, and chi_F=0 / Da=Di negative controls <https://github.com/fractastical/morpholib/blob/8871db0/2004-hentschel-tgfb-fibronectin-limb.py#L40-L68>" ;
    pk:hasScore 4.5e-01 ;
    pk:hasVerdict "partially faithful" .


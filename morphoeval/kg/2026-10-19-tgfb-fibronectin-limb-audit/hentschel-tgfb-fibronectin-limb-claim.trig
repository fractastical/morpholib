sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hentschel-tgfb-fibronectin-limb> a pk:Claim ;
        rdfs:label "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B / Kiskowski et al. (2004) Dev. Biol. multiscale TGF-beta / FGF-inhibitor reaction-diffusion and fibronectin haptotaxis PDE in developing Gallus gallus limb bud faithfully reproduces Gallus gallus domesticus embryonic wing bud & high-density mesenchymal micromass (HH20 stylopod humerus -> HH24 zeugopod radius+ulna -> HH27 autopod digits II-IV) morphology" ;
        dct:description "The simulation script(s) 2004-hentschel-tgfb-fibronectin-limb.py implement the cited source model as published and produce forms that match real Gallus gallus domesticus embryonic wing bud & high-density mesenchymal micromass (HH20 stylopod humerus -> HH24 zeugopod radius+ulna -> HH27 autopod digits II-IV) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 46.4/100, audit 2026-10-19-tgfb-fibronectin-limb-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/2004-hentschel-tgfb-fibronectin-limb.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2004-hentschel-tgfb-fibronectin-limb.py; output: docs/media/tgfb_fibronectin_limb_comparison.png; organism: Gallus gallus domesticus embryonic wing bud & high-density mesenchymal micromass (HH20 stylopod humerus -> HH24 zeugopod radius+ulna -> HH27 autopod digits II-IV); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: a2738dce4265d3cbf1985dad5976f0edb36bd4a8ed6349bde78d12e6cc7cd510; artifact_sha256: eea82e7f7885e55ae30c9fe24dc1c7543fe1efe2cba337aec39970ed1c704b86; input_dataset_sha256: {datasets/tgfb_fibronectin_limb/chick_limb_chondrogenesis_specimen.jpg=771e26f9fe8c813d..., datasets/tgfb_fibronectin_limb/scout_manifest.json=c810bd77e66557c8..., datasets/tgfb_fibronectin_limb/tgfb_fibronectin_limb_reference.json=33d554e44b712e2b...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.jtbi.2005.10.016>,
            <https://doi.org/10.1016/j.ydbio.2004.03.038>,
            <https://doi.org/10.1098/rsif.2005.0033>,
            <https://doi.org/10.1098/rspb.2004.2772>,
            <https://doi.org/10.1186/1752-0509-1-16> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-specimen-match> ;
        pk:weightOfEvidence "0.464"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/8871db0/2004-hentschel-tgfb-fibronectin-limb.py> a schema:SoftwareSourceCode ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "8871db0" .
}


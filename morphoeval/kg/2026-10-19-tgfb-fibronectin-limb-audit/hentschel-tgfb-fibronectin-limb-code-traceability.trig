sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hentschel-tgfb-fibronectin-limb> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B / Kiskowski et al. (2004) Dev. Biol. multiscale TGF-beta / FGF-inhibitor reaction-diffusion and fibronectin haptotaxis PDE in developing Gallus gallus limb bud — Code-to-model traceability: 58/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Basic docstrings are present, but functions lack explicit equation mappings to Hentschel et al. (2004) Eqs. (2.1)-(3.14), Kiskowski et al. (2004) haptotaxis kinetics, and the 3 Lean 4 theorems in `Loop_014_tgfb_fibronectin_limb.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2004-hentschel-tgfb-fibronectin-limb.py L25–L38: Docstrings omit explicit equation numbers and Lean 4 theorem cross-references <https://github.com/fractastical/morpholib/blob/8871db0/2004-hentschel-tgfb-fibronectin-limb.py#L25-L38>" ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 014 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


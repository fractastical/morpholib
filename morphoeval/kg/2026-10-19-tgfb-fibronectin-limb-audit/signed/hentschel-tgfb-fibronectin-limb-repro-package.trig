sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hentschel-tgfb-fibronectin-limb> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B / Kiskowski et al. (2004) Dev. Biol. multiscale TGF-beta / FGF-inhibitor reaction-diffusion and fibronectin haptotaxis PDE in developing Gallus gallus limb bud — Reproducibility package: 68/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Includes `--self-test`, but `self_test()` checks only 2 scalar equalities without verifying dataset SHA-256 locks, 4-field PDE cell condensation counts across all 4 FGF zones (`[1, 2, 3, 4]`), 2D wing bud `[1, 2, 3]` compartments, 2D micromass spot/stripe area fractions, negative-control quenching, specimen bone segmentation, or bitwise two-run determinism." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2004-hentschel-tgfb-fibronectin-limb.py L94–L100: Minimal 2-assertion self_test() without SHA-256, PDE, micromass, specimen, or determinism checks <https://github.com/fractastical/morpholib/blob/8871db0/2004-hentschel-tgfb-fibronectin-limb.py#L94-L100>" ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

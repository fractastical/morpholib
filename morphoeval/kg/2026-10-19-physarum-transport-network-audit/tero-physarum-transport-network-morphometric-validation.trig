sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tero-physarum-transport-network> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Tero et al. (2010) Science & Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. adaptive Physarum tube conductivity network, shortest-path phase transition, Murray's cube law, and Tokyo rail Pareto trade-off — Morphometric validation: 52/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Exposes only 2 scalar measurements in `measure_morphoeval()` without TL_MST, MD_MST, Fault Tolerance FT, Pearson correlation p-values, Murray cubic ratios, or specimen CV morphometrics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2010-tero-physarum-transport-network.py L67–L88: Only 2 scalar metrics without dispersion or statistical tests <https://github.com/fractastical/morpholib/blob/8871db0/2010-tero-physarum-transport-network.py#L67-L88>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-sublinear-gamma-0-6-short-path-flux-share-q1-i0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-superlinear-gamma-1-8-short-path-flux-share-q1-i0> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-sublinear-gamma-0-6-short-path-flux-share-q1-i0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Sublinear gamma=0.6 short-path flux share Q1/I0 = 0.7322 fraction" ;
        schema:measurementTechnique "Two-path parallel ODE at gamma=0.6 (L1=1, L2=2)" ;
        schema:name "Sublinear gamma=0.6 short-path flux share Q1/I0" ;
        schema:unitText "fraction" ;
        schema:value "0.7322" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-sublinear-gamma-0-6-short-path-flux-share-q1-i0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-sublinear-gamma-0-6-short-path-flux-share-q1-i0-reference> a schema:PropertyValue ;
        schema:value "0.7401" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-superlinear-gamma-1-8-short-path-flux-share-q1-i0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Superlinear gamma=1.8 short-path flux share Q1/I0 = 1.0 fraction" ;
        schema:measurementTechnique "Two-path parallel ODE at gamma=1.8 (L1=1, L2=2)" ;
        schema:name "Superlinear gamma=1.8 short-path flux share Q1/I0" ;
        schema:unitText "fraction" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-superlinear-gamma-1-8-short-path-flux-share-q1-i0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-superlinear-gamma-1-8-short-path-flux-share-q1-i0-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 057 Pass 1 Assessor)" ;

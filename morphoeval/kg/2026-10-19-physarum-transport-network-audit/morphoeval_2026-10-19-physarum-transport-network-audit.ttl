<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/tero-physarum-transport-network-1>,
        <https://w3id.org/probknow/resource/math-law/tero-physarum-transport-network-2>,
        <https://w3id.org/probknow/resource/math-law/tero-physarum-transport-network-3> .

<https://w3id.org/probknow/resource/math-law/tero-physarum-transport-network-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Tero et al. (2007, 2010) Hagen-Poiseuille Kirchhoff Flow Antisymmetry & Tube Conductivity Adaptation Equilibrium Law" ;
    dct:description "Proves that Poiseuille flux is strictly antisymmetric across directed edges, conserves protoplasmic current at every branching node, and equilibrates at D_ij^* = f(|Q_ij^*|) / μ | Variables: D_ij: hydraulic tube conductivity (∝ r_ij^4); L_ij: tube length; p_i, p_j: hydrostatic nodal pressures; Q_ij: protoplasmic shuttle streaming flux; f(|Q_ij|): shear-stress reinforcement rate; μ: tube decay rate" ;
    dct:source "Tero et al. (2010) Science 327(5964):439-442 Eqs. (1)-(3); Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. 244(4):553-564 Eqs. (1)-(4)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2010-tero-physarum-transport-network.py#L120-L240>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_057_physarum_transport_network.lean#L46-L78> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def poiseuille_flux_num (D pi pj : Int) : Int := D * (pi - pj)
def kirchhoff_junction_residual (q_in q_out1 q_out2 : Int) : Int := q_in - q_out1 - q_out2
def conductivity_rate (f_Q mu D : Int) : Int := f_Q - mu * D
theorem tero_kirchhoff_antisymmetry_and_conductivity_equilibrium (D pi pj q1 q2 mu D_star : Int) :
    poiseuille_flux_num D pi pj + poiseuille_flux_num D pj pi = 0 ∧
    poiseuille_flux_num D pi pi = 0 ∧
    kirchhoff_junction_residual (q1 + q2) q1 q2 = 0 ∧
    conductivity_rate (mu * D_star) mu D_star = 0
"""^^pk:lean4 ;
    skos:notation "Q_ij = (D_ij / L_ij) (p_i - p_j),  Σ_j Q_ij = S_i,  dD_ij/dt = f(|Q_ij|) - μ D_ij = 0  <=>  D_ij^* = f(|Q_ij^*|) / μ" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2006.07.015>,
        <https://doi.org/10.1038/35035159>,
        <https://doi.org/10.1073/pnas.12.3.207>,
        <https://doi.org/10.1126/science.1177894> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Hagen-Poiseuille Kirchhoff Flow Coupled to Nonlinear Tube Conductivity Adaptation & Murray/Steiner Phase Transition" ;
    pk:leanDeclaration "MathOfBiology.Loop_057.poiseuille_flux_num" ;
    pk:leanTheorem "MathOfBiology.Loop_057.tero_kirchhoff_antisymmetry_and_conductivity_equilibrium" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/tero-physarum-transport-network-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Tero, Kobayashi & Nakagaki (2007) Two-Path Parallel Competition & Winner-Takes-All Shortest-Path Selection Law" ;
    dct:description "Proves that for γ > 1, shorter parallel paths experience strictly stronger flux reinforcement than longer paths, destabilizing symmetric flow and driving winner-takes-all convergence to the shortest path / Steiner minimum tree | Variables: L_1, L_2: lengths of short and long parallel tubes (L_1 < L_2); Q_1, Q_2: branch fluxes; γ: flux feedback nonlinearity exponent; I_0: total source-sink current" ;
    dct:source "Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. 244(4):553-564 Section 2.2 & Fig. 2; Bonifaci, Mehlhorn & Varma (2012) J. Theor. Biol. 309:121-133" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2010-tero-physarum-transport-network.py#L245-L345>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_057_physarum_transport_network.lean#L85-L120> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def parallel_superlinear_advantage (L1 L2 : Int) : Int := L2 * L2 - L1 * L1
def parallel_rate_divergence (q1_sq q2_sq mu D : Int) : Int :=
  conductivity_rate q1_sq mu D - conductivity_rate q2_sq mu D
theorem tero_two_path_shortest_path_selection (q1_sq q2_sq mu D pi pj : Int) (hq : q2_sq < q1_sq) :
    parallel_superlinear_advantage 1 2 = 3 ∧
    0 < parallel_superlinear_advantage 1 2 ∧
    0 < parallel_rate_divergence q1_sq q2_sq mu D ∧
    poiseuille_flux_num 0 pi pj = 0 ∧
    conductivity_rate 0 mu 0 = 0
"""^^pk:lean4 ;
    skos:notation "Q_1 / Q_2 = (D_1 L_2) / (D_2 L_1);  for L_1 < L_2 and γ > 1:  d(D_1/D_2)/dt > 0  =>  (D_1^*, D_2^*) = (f(I_0)/μ, 0)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2006.07.015>,
        <https://doi.org/10.1038/35035159>,
        <https://doi.org/10.1073/pnas.12.3.207>,
        <https://doi.org/10.1126/science.1177894> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Hagen-Poiseuille Kirchhoff Flow Coupled to Nonlinear Tube Conductivity Adaptation & Murray/Steiner Phase Transition" ;
    pk:leanDeclaration "MathOfBiology.Loop_057.parallel_superlinear_advantage" ;
    pk:leanTheorem "MathOfBiology.Loop_057.tero_two_path_shortest_path_selection" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/tero-physarum-transport-network-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Murray (1926) & Tero et al. (2010) Vascular Cube-Law Radius Relation at Critical Shear Exponent γ = 4/3" ;
    dct:description "Establishes the exact algebraic equivalence between Hagen-Poiseuille tube adaptation at γ = 4/3 and Murray's minimum-work cube law r_0^3 = r_1^3 + r_2^3 across plasmodial Y-junctions | Variables: r_0: parent vein radius; r_1, r_2: daughter branch radii; D(r): Hagen-Poiseuille fourth-power conductivity; Q(r): steady-state protoplasmic volume flux" ;
    dct:source "Murray (1926) Proc. Natl. Acad. Sci. USA 12(3):207-214; Tero et al. (2010) Science 327(5964):439-442" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2010-tero-physarum-transport-network.py#L350-L465>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_057_physarum_transport_network.lean#L127-L154> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def radius_cube (r : Nat) : Nat := r * r * r
def poiseuille_d4 (r : Nat) : Nat := r * r * r * r
theorem tero_murray_cube_law_at_gamma_four_thirds (r1 r2 : Nat) (hr2 : 0 < r2) :
    poiseuille_d4 2 * poiseuille_d4 2 * poiseuille_d4 2 =
      radius_cube 2 * radius_cube 2 * radius_cube 2 * radius_cube 2 ∧
    radius_cube r1 < radius_cube r1 + radius_cube r2 ∧
    radius_cube 2 + radius_cube 2 = 16
"""^^pk:lean4 ;
    skos:notation "D_ij ∝ r_ij^4,  D_ij^* ∝ |Q_ij^*|^(4/3)  =>  |Q_ij^*| ∝ (D_ij^* )^(3/4) ∝ r_ij^3;  Q_0 = Q_1 + Q_2  =>  r_0^3 = r_1^3 + r_2^3" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2006.07.015>,
        <https://doi.org/10.1038/35035159>,
        <https://doi.org/10.1073/pnas.12.3.207>,
        <https://doi.org/10.1126/science.1177894> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Hagen-Poiseuille Kirchhoff Flow Coupled to Nonlinear Tube Conductivity Adaptation & Murray/Steiner Phase Transition" ;
    pk:leanDeclaration "MathOfBiology.Loop_057.radius_cube" ;
    pk:leanTheorem "MathOfBiology.Loop_057.tero_murray_cube_law_at_gamma_four_thirds" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tero-physarum-transport-network> a pk:Claim ;
        rdfs:label "Tero et al. (2010) Science & Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. adaptive Physarum tube conductivity network, shortest-path phase transition, Murray's cube law, and Tokyo rail Pareto trade-off faithfully reproduces Physarum polycephalum (acellular plasmodial slime mold) morphology" ;
        dct:description "The simulation script(s) 2010-tero-physarum-transport-network.py implement the cited source model as published and produce forms that match real Physarum polycephalum (acellular plasmodial slime mold) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 52.8/100, audit 2026-10-19-physarum-transport-network-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/2010-tero-physarum-transport-network.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2010-tero-physarum-transport-network.py; output: docs/media/physarum_transport_network_comparison.png; organism: Physarum polycephalum (acellular plasmodial slime mold); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: a9da85cd52fbe6dcd220e87644d7d896769c3e1c0c8e71bb4976e6e20700a480; artifact_sha256: 40760d56079e6ba3af1d59e473c70890055d6b866b417e59f015eb07c79cf4fa; input_dataset_sha256: {datasets/physarum_transport_network/paper_citations.bib=95f4eb8510791507..., datasets/physarum_transport_network/physarum_polycephalum_specimen.jpg=86a37f7c73c8527b..., datasets/physarum_transport_network/physarum_transport_network_reference.json=4a54186a148929f7..., datasets/physarum_transport_network/scout_manifest.json=edb27b0addb825b3...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.jtbi.2006.07.015>,
            <https://doi.org/10.1038/35035159>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1126/science.1177894> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-specimen-match> ;
        pk:weightOfEvidence "0.528"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/8871db0/2010-tero-physarum-transport-network.py> a schema:SoftwareSourceCode ;
        rdfs:label "2010-tero-physarum-transport-network.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "8871db0" .
}


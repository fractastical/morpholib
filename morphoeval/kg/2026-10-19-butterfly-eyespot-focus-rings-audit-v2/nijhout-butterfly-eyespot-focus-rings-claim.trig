sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nijhout-butterfly-eyespot-focus-rings> a pk:Claim ;
        rdfs:label "Nijhout (1990) & Brakefield et al. (1996) butterfly wing-vein focus determination and concentric French-flag eyespot ring morphogenesis faithfully reproduces Bicyclus anynana & Junonia coenia (Nymphalidae: Satyrinae / Nymphalinae) morphology" ;
        dct:description "The simulation script(s) 2001-nijhout-butterfly-eyespot-focus-rings.py implement the cited source model as published and produce forms that match real Bicyclus anynana & Junonia coenia (Nymphalidae: Satyrinae / Nymphalinae) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 91.9/100, audit 2026-10-19-butterfly-eyespot-focus-rings-audit-v2) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/HEAD/2001-nijhout-butterfly-eyespot-focus-rings.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/HEAD/2001-nijhout-butterfly-eyespot-focus-rings.py; output: docs/media/butterfly_eyespot_focus_rings_comparison.png; organism: Bicyclus anynana & Junonia coenia (Nymphalidae: Satyrinae / Nymphalinae); checkpoint commit: https://github.com/fractastical/morpholib/commit/HEAD; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 0a2086f2436043ce9998603ef36e23feb6c621834d7d960a99310b296156772b; artifact_sha256: 119a30775931cd53ef1c9f5786f4615c696be3390eba9beb4cbe252fb548b4b8; input_dataset_sha256: {datasets/butterfly_eyespot_focus_rings/bicyclus_anynana_eyespot_specimen.jpg=f1826cee44602782..., datasets/butterfly_eyespot_focus_rings/butterfly_eyespot_focus_rings_reference.json=b19590626bdaff79..., datasets/butterfly_eyespot_focus_rings/scout_manifest.json=7cfe9d2221ea5b8b...}; supersedes_audit_id: 2026-10-19-butterfly-eyespot-focus-rings-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1006/dbio.1995.1065>,
            <https://doi.org/10.1016/S0960-9822(01)00429-8>,
            <https://doi.org/10.1038/384236a0>,
            <https://doi.org/10.1038/416844a>,
            <https://doi.org/10.1098/rspb.1990.0048> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-specimen-match> ;
        pk:weightOfEvidence "0.919"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/HEAD/2001-nijhout-butterfly-eyespot-focus-rings.py> a schema:SoftwareSourceCode ;
        rdfs:label "2001-nijhout-butterfly-eyespot-focus-rings.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "HEAD" .
}


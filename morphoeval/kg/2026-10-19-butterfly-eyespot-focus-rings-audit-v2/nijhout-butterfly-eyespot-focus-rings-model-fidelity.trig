sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nijhout-butterfly-eyespot-focus-rings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Nijhout (1990) & Brakefield et al. (1996) butterfly wing-vein focus determination and concentric French-flag eyespot ring morphogenesis — Model fidelity to source: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Couples Stage-1 2D Meinhardt activator-inhibitor reaction-diffusion inside a longitudinal wing-vein-bounded cell compartment (`solve_stage1_vein_focus_rd`, L114-187) to Stage-2 2D focal morphogen decay and concentric *Spalt* / *Engrailed* / *Distal-less* threshold induction (`solve_stage2_concentric_rings_2d` and `evaluate_all_eyespot_regimes`, L192-398) across all 5 experimental regimes plus the 6-point pupal microcautery timing series. Backed by 4 machine-checked Lean 4 theorems in `Loop_098_butterfly_eyespot_focus_rings.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2001-nijhout-butterfly-eyespot-focus-rings.py L114–L298" ;
        dct:description "Coupled Stage-1 2D vein-to-midline focus RD solver and Stage-2 2D concentric threshold solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2001-nijhout-butterfly-eyespot-focus-rings.py#L114-L298> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2001-nijhout-butterfly-eyespot-focus-rings.py L301–L398" ;
        dct:description "5 experimental regimes (wet, dry, Goldeneye, twin-focus hourglass, cautery ablation) and 6-point pupal timing series" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2001-nijhout-butterfly-eyespot-focus-rings.py#L301-L398> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_098_butterfly_eyespot_focus_rings.lean L24–L169" ;
        dct:description "4 Lean 4 theorems proving concentric threshold ordering, seasonal annulus invariance, cautery collapse, and twin-focus hourglass fusion" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_098_butterfly_eyespot_focus_rings.lean#L24-L169> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


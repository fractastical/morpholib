sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nijhout-butterfly-eyespot-focus-rings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Nijhout (1990) & Brakefield et al. (1996) butterfly wing-vein focus determination and concentric French-flag eyespot ring morphogenesis — Morphometric validation: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Extracts 9 reference-anchored morphometrics in `measure_morphoeval()` (L624-715), covering Stage-1 midline focus offset (`0.0000 mm`), wet-season `R_gold` (`1.0882 mm`) and `R_black / R_gold` ratio (`0.7567`), seasonal polyphenism invariant gold annulus width (`0.2648 mm`), *Goldeneye* expanded gold annulus (`0.6941 mm`), early pupal cautery ablation (`0.0000 mm`, timing series `r = 1.0000`), twin-focus bridge overlap (`0.6765 mm`), and empirical *Bicyclus anynana* Cu1 specimen `R_black / R_gold` (`0.7569`) and calibrated `R_gold` (`1.0874 mm`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-bicyclus-anynana-specimen-cu1-calibrated-outer-gold-ring-radius-r-gold-bicyclus-anynana-eyespot-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-bicyclus-anynana-specimen-cu1-eyespot-black-to-gold-radius-ratio-r-black-r-gold-bicyclus-anynana-eyespot-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-early-pupal-focal-microcautery-ablation-outer-radius-r-gold-c0-0-05-theta-gold>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-goldeneye-mutant-expanded-engrailed-gold-annulus-width-delta-r-goldeneye-theta-black-0-44>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-seasonal-ecdysone-polyphenism-invariant-gold-annulus-width-delta-r-wet-vs-dry-season>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-stage-1-2d-wing-compartment-focus-midline-offset-y-focus>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-twin-focus-hourglass-fusion-inter-focal-bridge-overlap-width-w-bridge-d-12-1-50-mm>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-wild-type-black-to-gold-diameter-ratio-r-black-r-gold>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-wild-type-outer-engrailed-gold-ring-radius-r-gold-c0-1-00>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-morphometric-validation-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-bicyclus-anynana-specimen-cu1-calibrated-outer-gold-ring-radius-r-gold-bicyclus-anynana-eyespot-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Bicyclus anynana specimen Cu1 calibrated outer gold ring radius R_gold (bicyclus_anynana_eyespot_specimen.jpg) = 1.0871 mm" ;
        dct:description "calibrated gold annulus width = 0.2641 mm (vs theoretical 0.2649 mm)" ;
        schema:measurementTechnique "Calibrated outer Engrailed gold ring radius R_gold_px * 0.0533 mm/px from azimuthal radial luminance crossing L(r) = 0.61" ;
        schema:name "Bicyclus anynana specimen Cu1 calibrated outer gold ring radius R_gold (bicyclus_anynana_eyespot_specimen.jpg)" ;
        schema:unitText "mm" ;
        schema:value "1.0871" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-bicyclus-anynana-specimen-cu1-calibrated-outer-gold-ring-radius-r-gold-bicyclus-anynana-eyespot-specimen-jpg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-bicyclus-anynana-specimen-cu1-calibrated-outer-gold-ring-radius-r-gold-bicyclus-anynana-eyespot-specimen-jpg-reference> a schema:PropertyValue ;
        dct:source "Vendored Bicyclus anynana ventral wing specimen (CC BY-SA 4.0) & Brakefield et al. (1996) Nature 384:236-242" ;
        schema:value "1.0874" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-bicyclus-anynana-specimen-cu1-eyespot-black-to-gold-radius-ratio-r-black-r-gold-bicyclus-anynana-eyespot-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Bicyclus anynana specimen Cu1 eyespot black-to-gold radius ratio R_black / R_gold (bicyclus_anynana_eyespot_specimen.jpg) = 0.7571 radius ratio" ;
        dct:description "pupil_to_gold_ratio = 0.1796 (R_pupil = 3.662 px)" ;
        schema:measurementTechnique "Azimuthal-mean radial luminance segmentation around primary Cu1 focus (596, 231) (R_black = 15.441 px / R_gold = 20.395 px)" ;
        schema:name "Bicyclus anynana specimen Cu1 eyespot black-to-gold radius ratio R_black / R_gold (bicyclus_anynana_eyespot_specimen.jpg)" ;
        schema:unitText "radius ratio" ;
        schema:value "0.7571" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-bicyclus-anynana-specimen-cu1-eyespot-black-to-gold-radius-ratio-r-black-r-gold-bicyclus-anynana-eyespot-specimen-jpg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-bicyclus-anynana-specimen-cu1-eyespot-black-to-gold-radius-ratio-r-black-r-gold-bicyclus-anynana-eyespot-specimen-jpg-reference> a schema:PropertyValue ;
        dct:source "Vendored Bicyclus anynana ventral wing specimen (CC BY-SA 4.0) & Brakefield et al. (1996) Nature 384:236-242" ;
        schema:value "0.7569" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-early-pupal-focal-microcautery-ablation-outer-radius-r-gold-c0-0-05-theta-gold> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Early pupal focal microcautery ablation outer radius R_gold (c0 = 0.05 <= theta_gold) = 0.0 mm" ;
        dct:description "6-point pupal cautery timing series Pearson r = 1.0000, RMSE = 0.0001 mm" ;
        schema:measurementTechnique "Complete eyespot ablation negative control when focal source strength c0 = 0.05 falls below theta_gold = 0.1036; 6-point timing series r = 1.0000" ;
        schema:name "Early pupal focal microcautery ablation outer radius R_gold (c0 = 0.05 <= theta_gold)" ;
        schema:unitText "mm" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-early-pupal-focal-microcautery-ablation-outer-radius-r-gold-c0-0-05-theta-gold-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-early-pupal-focal-microcautery-ablation-outer-radius-r-gold-c0-0-05-theta-gold-reference> a schema:PropertyValue ;
        dct:source "Nijhout (1990) Proc. R. Soc. B 239:81-113, French & Brakefield (1995) Dev. Biol. 168:112-123 & Lean 4 theorem nijhout_focal_cautery_ablation_collapse" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-goldeneye-mutant-expanded-engrailed-gold-annulus-width-delta-r-goldeneye-theta-black-0-44> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Goldeneye mutant expanded Engrailed gold annulus width Delta_R_Goldeneye (theta_black = 0.44) = 0.6942 mm" ;
        dct:description "Goldeneye black_to_gold_ratio = 0.3621 (vs WT 0.7567)" ;
        schema:measurementTechnique "Outer gold annulus width when Spalt activation threshold shifts upward from theta_black = 0.1799 to 0.4400" ;
        schema:name "Goldeneye mutant expanded Engrailed gold annulus width Delta_R_Goldeneye (theta_black = 0.44)" ;
        schema:unitText "mm" ;
        schema:value "0.6942" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-goldeneye-mutant-expanded-engrailed-gold-annulus-width-delta-r-goldeneye-theta-black-0-44-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-goldeneye-mutant-expanded-engrailed-gold-annulus-width-delta-r-goldeneye-theta-black-0-44-reference> a schema:PropertyValue ;
        dct:source "Brunetti et al. (2001) Curr. Biol. 11:1451-1461 & Lean 4 theorem brakefield_polyphenism_annulus_invariance" ;
        schema:value "0.6941" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-seasonal-ecdysone-polyphenism-invariant-gold-annulus-width-delta-r-wet-vs-dry-season> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Seasonal ecdysone polyphenism invariant gold annulus width Delta_R (wet vs dry season) = 0.2649 mm" ;
        dct:description "|Delta_R_wet - Delta_R_dry| = 2.22e-16 mm" ;
        schema:measurementTechnique "Outer gold annulus width Delta_R = R_gold(c0) - R_black(c0) = lambda * ln(theta_black / theta_gold) at dry-season c0 = 0.42 vs wet-season c0 = 1.00" ;
        schema:name "Seasonal ecdysone polyphenism invariant gold annulus width Delta_R (wet vs dry season)" ;
        schema:unitText "mm" ;
        schema:value "0.2649" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-seasonal-ecdysone-polyphenism-invariant-gold-annulus-width-delta-r-wet-vs-dry-season-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-seasonal-ecdysone-polyphenism-invariant-gold-annulus-width-delta-r-wet-vs-dry-season-reference> a schema:PropertyValue ;
        dct:source "Brakefield et al. (1996) Nature 384:236-242 & Lean 4 theorem brakefield_polyphenism_annulus_invariance" ;
        schema:value "0.2648" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-stage-1-2d-wing-compartment-focus-midline-offset-y-focus> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Stage-1 2D wing-compartment focus midline offset |y_focus| = 0.0 mm" ;
        dct:description "focus_x_mm = 2.028 mm (x/L_x = 0.5634)" ;
        schema:measurementTechnique "Center-of-mass anteroposterior offset |y_f| of the Stage-1 Meinhardt activator focal organizer inside [0, 3.60] x [-0.90, 0.90] mm" ;
        schema:name "Stage-1 2D wing-compartment focus midline offset |y_focus|" ;
        schema:unitText "mm" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-stage-1-2d-wing-compartment-focus-midline-offset-y-focus-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-stage-1-2d-wing-compartment-focus-midline-offset-y-focus-reference> a schema:PropertyValue ;
        dct:source "Nijhout (1990) Proc. R. Soc. B 239:81-113 Figs. 4-9 (equidistant lateral vein inhibition centers focus on compartment midline y = 0)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-twin-focus-hourglass-fusion-inter-focal-bridge-overlap-width-w-bridge-d-12-1-50-mm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Twin-focus hourglass fusion inter-focal bridge overlap width w_bridge (d_12 = 1.50 mm) = 0.6765 mm" ;
        dct:description "midpoint_c = 0.4192, bridge_fused_gold = True, bridge_fused_black = True" ;
        schema:measurementTechnique "Inter-focal gold-ring overlap width 2*R_gold - d_12 and midpoint superposition c_mid = 2*c0*exp(-d_12/(2*lambda)) = 0.4192 > theta_black" ;
        schema:name "Twin-focus hourglass fusion inter-focal bridge overlap width w_bridge (d_12 = 1.50 mm)" ;
        schema:unitText "mm" ;
        schema:value "0.6765" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-twin-focus-hourglass-fusion-inter-focal-bridge-overlap-width-w-bridge-d-12-1-50-mm-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-twin-focus-hourglass-fusion-inter-focal-bridge-overlap-width-w-bridge-d-12-1-50-mm-reference> a schema:PropertyValue ;
        dct:source "Beldade, Koops & Brakefield (2002) Nature 416:844-847 & Lean 4 theorem beldade_twin_focus_hourglass_fusion" ;
        schema:value "0.6765" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-wild-type-black-to-gold-diameter-ratio-r-black-r-gold> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wet-season wild-type black-to-gold diameter ratio R_black / R_gold = 0.7566 radius ratio" ;
        dct:description "pupil_to_gold_ratio = 0.1793" ;
        schema:measurementTechnique "Ratio of Spalt/Dll black melanin disc radius R_black = 0.8234 mm to outer Engrailed gold radius R_gold = 1.0882 mm" ;
        schema:name "Wet-season wild-type black-to-gold diameter ratio R_black / R_gold" ;
        schema:unitText "radius ratio" ;
        schema:value "0.7566" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-wild-type-black-to-gold-diameter-ratio-r-black-r-gold-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-wild-type-black-to-gold-diameter-ratio-r-black-r-gold-reference> a schema:PropertyValue ;
        dct:source "Brakefield et al. (1996) Nature 384:236-242 & Brunetti et al. (2001) Curr. Biol. 11:1451-1461" ;
        schema:value "0.7567" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-wild-type-outer-engrailed-gold-ring-radius-r-gold-c0-1-00> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wet-season wild-type outer Engrailed gold ring radius R_gold (c0 = 1.00) = 1.0883 mm" ;
        dct:description "R_pupil = 0.1951 mm < R_black = 0.8234 mm < R_gold = 1.0883 mm" ;
        schema:measurementTechnique "Analytical & 2D threshold radius R_gold = lambda * ln(c0 / theta_gold) with lambda = 0.480 mm, c0 = 1.00, theta_gold = 0.1036" ;
        schema:name "Wet-season wild-type outer Engrailed gold ring radius R_gold (c0 = 1.00)" ;
        schema:unitText "mm" ;
        schema:value "1.0883" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-wild-type-outer-engrailed-gold-ring-radius-r-gold-c0-1-00-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-wild-type-outer-engrailed-gold-ring-radius-r-gold-c0-1-00-reference> a schema:PropertyValue ;
        dct:source "Brakefield et al. (1996) Nature 384:236-242 & Lean 4 theorem nijhout_concentric_threshold_ordering" ;
        schema:value "1.0882" .

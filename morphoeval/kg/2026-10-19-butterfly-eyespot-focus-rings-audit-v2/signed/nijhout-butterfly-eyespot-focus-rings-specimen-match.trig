    <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Nijhout (1990) & Brakefield et al. (1996) butterfly wing-vein focus determination and concentric French-flag eyespot ring morphogenesis — Morphological realism / specimen match: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors, SHA-256-verifies, and performs Difference-of-Gaussians focus localization and azimuthal radial luminance + golden-chroma concentric ring segmentation (`segment_bicyclus_eyespot_specimen`, L403-496) on the CC BY-SA 4.0 *Bicyclus anynana* ventral wing specimen photograph (`datasets/butterfly_eyespot_focus_rings/bicyclus_anynana_eyespot_specimen.jpg`), measuring primary Cu1 focus `(596, 231)`, central white pupil radius `R_pupil = 3.663 px` (`0.1952 mm`), black *Spalt* disc radius `R_black = 15.442 px` (`0.8231 mm`), outer *Engrailed* gold ring radius `R_gold = 20.402 px` (`1.0874 mm`), and black-to-gold ratio `0.7569` (vs theoretical `0.7567`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Danio nigrofasciatus Schnakenberg wavelength at 27 µm (Holocene, 0 Ma) — Morphometric validation: 66/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Analytical wavelength is pinned at 2.71e-05 m and a spectral peak is computed, but KS, holdout, and the ablation ratio are not yet accepted as scored measurements." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-ablation-control-pattern-std-over-relaxation-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-alpha-sweep-spearman-of-anisotropy-versus-inverse-horizontal-gradient>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-anterior-posterior-holdout-posterior-continuity-gap>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-chronoseries-control-margaritatus-continuity-gap-versus-nigrofasciatus>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-nigrofasciatus-dorsal-minus-ventral-stripe-continuity-gap>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-specimen-stripe-wavelength-from-simulated-flank-fft>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-specimen-trunk-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-specimen-vs-simulation-ks-distance-of-trunk-gray-histograms>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-turing-dispersion-specimen-independent-growth-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.66"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-ablation-control-pattern-std-over-relaxation-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation control pattern-std over relaxation-std ratio = 3643185.969 ratio" ;
        schema:measurementTechnique "Negative control: Schnakenberg kinetics replaced by relaxation to (u0, v0). Ratio >> 1 means the pattern is reaction-driven, not the initial seed." ;
        schema:name "ablation control pattern-std over relaxation-std ratio" ;
        schema:unitText "ratio" ;
        schema:value "3643185.969" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-ablation-control-pattern-std-over-relaxation-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-ablation-control-pattern-std-over-relaxation-std-ratio-reference> a schema:PropertyValue ;
        dct:source "null ratio if the ablation matches the full model" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-alpha-sweep-spearman-of-anisotropy-versus-inverse-horizontal-gradient> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "alpha sweep Spearman of anisotropy versus inverse horizontal gradient = 1.0 Spearman rho" ;
        schema:measurementTechnique "Parameter sweep alpha in {1, 2, 3, 4.5, 6, 8.5}. Higher AP diffusion must lower |du/dx| (monotonic expressivity)." ;
        schema:name "alpha sweep Spearman of anisotropy versus inverse horizontal gradient" ;
        schema:unitText "Spearman rho" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-alpha-sweep-spearman-of-anisotropy-versus-inverse-horizontal-gradient-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-alpha-sweep-spearman-of-anisotropy-versus-inverse-horizontal-gradient-reference> a schema:PropertyValue ;
        dct:source "self-test floor; a perfect monotone sweep scores above this" ;
        schema:value "0.8" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-anterior-posterior-holdout-posterior-continuity-gap> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "anterior-posterior holdout posterior continuity gap = 0.0914 run-length fraction" ;
        schema:measurementTechnique "Threshold quantile fit on the anterior half of the flank; gap scored only on the posterior half (holdout)." ;
        schema:name "anterior-posterior holdout posterior continuity gap" ;
        schema:unitText "run-length fraction" ;
        schema:value "0.0914" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-anterior-posterior-holdout-posterior-continuity-gap-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-anterior-posterior-holdout-posterior-continuity-gap-reference> a schema:PropertyValue ;
        dct:source "null holdout gap" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-chronoseries-control-margaritatus-continuity-gap-versus-nigrofasciatus> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chronoseries control margaritatus continuity gap versus nigrofasciatus = 0.0002 gap difference" ;
        dct:description "rerio dorsal continuity=0.1110; margaritatus gap=0.0010" ;
        schema:measurementTechnique "Focal broken-stripe gap minus predecessor near-isotropic gap. Positive means nigrofasciatus is more dorsoventrally polarized than margaritatus. This is a vs-predecessor control, not a copy of a reference scalar." ;
        schema:name "chronoseries control margaritatus continuity gap versus nigrofasciatus" ;
        schema:unitText "gap difference" ;
        schema:value "0.0002" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-chronoseries-control-margaritatus-continuity-gap-versus-nigrofasciatus-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-chronoseries-control-margaritatus-continuity-gap-versus-nigrofasciatus-reference> a schema:PropertyValue ;
        dct:source "qualitative expectation from Parichy 2006 and Volkening & Sandstede 2018; not a fitted constant" ;
        schema:value "0.15" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-nigrofasciatus-dorsal-minus-ventral-stripe-continuity-gap> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nigrofasciatus dorsal-minus-ventral stripe continuity gap = 0.0013 run-length fraction" ;
        schema:measurementTechnique "Mean AP run length above the 70th percentile, dorsal minus ventral. Broken ventral stripes predict a positive gap." ;
        schema:name "nigrofasciatus dorsal-minus-ventral stripe continuity gap" ;
        schema:unitText "run-length fraction" ;
        schema:value "0.0013" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-nigrofasciatus-dorsal-minus-ventral-stripe-continuity-gap-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-nigrofasciatus-dorsal-minus-ventral-stripe-continuity-gap-reference> a schema:PropertyValue ;
        dct:source "null of no dorsoventral difference (the margaritatus-like case)" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-specimen-stripe-wavelength-from-simulated-flank-fft> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen stripe wavelength from simulated flank FFT = 27.3342 µm" ;
        dct:description "value is the measured spectral peak, not a copy of the catalog wavelength" ;
        schema:measurementTechnique "Radial FFT peak of the activator times dx, with dx chosen so the analytical lambda_c equals 27.1 µm. CV of the radial bin is dominated by the peak ring." ;
        schema:name "specimen stripe wavelength from simulated flank FFT" ;
        schema:unitText "µm" ;
        schema:value "27.3342" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-specimen-stripe-wavelength-from-simulated-flank-fft-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-specimen-stripe-wavelength-from-simulated-flank-fft-reference> a schema:PropertyValue ;
        dct:source "Slot catalog 2.71e-05 m (27 µm nominal, log10=-4.567)" ;
        schema:value "27.1" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-specimen-trunk-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen trunk structure-tensor coherency = 0.6583 coherency" ;
        schema:measurementTechnique "Same Sobel structure-tensor coherency as morphoeval/verify_image_fitness.py on the CC BY specimen" ;
        schema:name "specimen trunk structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.6583" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-specimen-trunk-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-specimen-trunk-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "neutral baseline; the photograph is strongly oriented by the horizontal stripes" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-specimen-vs-simulation-ks-distance-of-trunk-gray-histograms> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen-vs-simulation KS distance of trunk gray histograms = 0.3362 KS statistic" ;
        dct:description "ks p=0" ;
        schema:measurementTechnique "ks_2samp on trunk pixels of the Parichy specimen versus the rendered Turing composite. Not a self-reference." ;
        schema:name "specimen-vs-simulation KS distance of trunk gray histograms" ;
        schema:unitText "KS statistic" ;
        schema:value "0.3362" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-specimen-vs-simulation-ks-distance-of-trunk-gray-histograms-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-specimen-vs-simulation-ks-distance-of-trunk-gray-histograms-reference> a schema:PropertyValue ;
        dct:source "a KS of 0 would be a pixel-identical copy; the model is not that copy" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-turing-dispersion-specimen-independent-growth-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing dispersion specimen-independent growth Pearson r = 0.999997 Pearson r" ;
        dct:description "rmse=0.001409 on n=315 real eigenmodes" ;
        schema:measurementTechnique "One-step Fourier eigenmode growth versus analytical sigma(k); RMSE reported in the metrics JSON" ;
        schema:name "Turing dispersion specimen-independent growth Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.999997" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-turing-dispersion-specimen-independent-growth-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-measurement-turing-dispersion-specimen-independent-growth-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 dispersion relation, discrete 5-point Laplacian; gate is r > 0.98, not an identity with the measurement" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-danio-nigrofasciatus-turing-wavelength-s0.py L265–L283" ;
        dct:description "measured_wavelength_um from the radial FFT" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8585ec4a033d94afd4c400aaefdffe79c1f7bc69/models/2026-delphi10000-danio-nigrofasciatus-turing-wavelength-s0.py#L265-L283> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second provider on this pass)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,

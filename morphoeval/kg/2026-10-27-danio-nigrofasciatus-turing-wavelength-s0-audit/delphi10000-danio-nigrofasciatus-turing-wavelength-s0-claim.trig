sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Danio nigrofasciatus Schnakenberg wavelength at 27 µm (Holocene, 0 Ma) faithfully reproduces Danio nigrofasciatus morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-danio-nigrofasciatus-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Danio nigrofasciatus specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-danio-nigrofasciatus-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-danio-nigrofasciatus-turing-wavelength-s0.py; output: docs/media/danio_nigrofasciatus_turing_wavelength_s0_comparison.png; organism: Danio nigrofasciatus; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion relation and the critical-wavenumber formula. | Schnakenberg 1979 kinetics f = a - u + u^2 v, g = b - u^2 v. | Nakamasu et al. 2009: Danio pigment cells implement short-range activation and long-range inhibition and can form stripes or spots. | Parichy 2006: D. nigrofasciatus keeps a striped dorsum and a broken ventral field, unlike spotted D. margaritatus and striped D. rerio.; reconstructed_in_script: Explicit-Euler anisotropic Schnakenberg on a periodic cellular patch with dx set so analytical lambda_c equals 2.71e-05 m. | alpha_dorsal=6, alpha_ventral=1.15, break at 0.60 of flank height for the focal species; alpha=1.05 and alpha=8.5 for the chronospecies. | Trunk mask and composite painted onto the vendored Parichy photograph.; transfer_boundary: 27 µm is the catalog cellular wavelength, not a length resolved by the whole-body photograph. | alpha stands in for iridophore / Kcnj13 coupling; the script does not model those cells explicitly.; does_not_claim: Does not claim the organ-scale ~1 mm stripe spacing of slot 1203. | Does not claim the dorsoventral optical-density profile of the photograph is reproduced (profile Pearson r = 0.023). | Does not claim a second independent assessor.]; phenomenon_size: 20 µm (2.018e-05 m, log10=-4.695 m, tier=4_cellular_10um); species_scale_ladder (10 runs from 20 µm to 4.5 cm): 20 µm:danio-aesculapii-bioelectric-polarity, 63 µm:danio-aesculapii-vertex-packing, 1.0 mm:danio-aesculapii-turing-wavelength, 2.0 mm:danio-aesculapii-clock-wavefront, 4.5 mm:danio-aesculapii-morphogen-condensation, 5.5 mm:danio-aesculapii-elastic-buckling, 6.3 mm:danio-aesculapii-flux-canalization, 8.8 mm:danio-aesculapii-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/s41467-018-05629-z>,
            <https://doi.org/10.1038/s41467-020-20021-6>,
            <https://doi.org/10.1038/sj.hdy.6800867>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.7554/eLife.05635> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-danio-nigrofasciatus-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-danio-nigrofasciatus-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/s41467-018-05629-z>,
            <https://doi.org/10.1038/s41467-020-20021-6>,
            <https://doi.org/10.1038/sj.hdy.6800867>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.7554/eLife.05635> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1038/s41467-018-05629-z> dct:title "Iridophores as a source of robustness in zebrafish stripes and variability in Danio patterns" .
    <https://doi.org/10.1038/s41467-020-20021-6> dct:title "Evolution of the potassium channel gene Kcnj13 underlies colour pattern diversification in Danio fish" .
    <https://doi.org/10.1038/sj.hdy.6800867> dct:title "Evolution of danio pigment pattern development" .
    <https://doi.org/10.1073/pnas.0808622106> dct:title "Interactions between zebrafish pigment cells responsible for the generation of Turing patterns" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.7554/eLife.05635> dct:title "Advancing biology through a deeper understanding of zebrafish ecology and evolution" .

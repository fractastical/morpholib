sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bi-vertex-glass-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2015-bi-vertex-glass-jamming.py L95–L194" ;
        dcterms:description "Bi et al. (2015) Eq. 2 vertex energy, regular polygon bounds, T1 barrier & shear modulus scaling, and k-Gamma PDF" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2015-bi-vertex-glass-jamming.py#L95-L194> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2015-bi-vertex-glass-jamming.py L245–L380" ;
        dcterms:description "2D periodic monolayer simulator across solid, critical, asthmatic fluid, and r=0 ablation regimes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2015-bi-vertex-glass-jamming.py#L245-L380> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_045_vertex_glass_jamming.lean L20–L148" ;
        dcterms:description "4 machine-checked Lean 4 theorems for vertex energy ground state, hexagon-pentagon-critical bounds, T1 barrier vanishing, and asthma vs control separation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/morphoeval/lean/loops/Loop_045_vertex_glass_jamming.lean#L20-L148> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Bi et al. (2015) & Park et al. (2015) zero-temperature shape-index unjamming & asthmatic bronchial epithelial rigidity transition — Model fidelity to source: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements the Bi et al. (2015) Eq. (2) dimensionless vertex energy functional (`compute_cell_vertex_energy`, L95-115), regular polygon geometric shape bounds (`regular_polygon_shape_index`, L118-128), zero-temperature T1 energy barrier `Delta e_T1(p_0)` and static shear modulus `G(p_0)` scaling across `p_0^* = 3.813` (`compute_t1_barrier_and_shear_modulus`, L131-183), Atia et al. (2018) `k`-Gamma probability density (`k_gamma_pdf`, L186-194), and 2D periodic vertex-Voronoi relaxation across solid, critical, asthmatic fluid, and `r=0` ablation regimes (`simulate_vertex_unjamming_regime`, L245-380). Backed by 4 machine-checked Lean 4 theorems (0 sorrys)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


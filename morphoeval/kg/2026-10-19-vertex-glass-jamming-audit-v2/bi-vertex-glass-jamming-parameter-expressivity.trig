sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bi-vertex-glass-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Bi et al. (2015) & Park et al. (2015) zero-temperature shape-index unjamming & asthmatic bronchial epithelial rigidity transition — Parameter expressivity: 89/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Simulates 4 distinct regimes (Solid Jammed `p_0=3.70`, Critical `p_0=3.813`, Asthmatic Fluid `p_0=3.955`, and Perimeter-Modulus Ablation `r=0.0`, Panels A1-A4), executes an 8-point continuous `p_0` sweep across `[3.55, 4.00]` (`run_p0_phase_sweep`, L383-420, Panels B1-B2), models Park et al. (2015) Days 3-18 non-asthmatic vs. asthmatic maturation and `30 cm H2O` bronchospasm compression (`simulate_park_2015_bronchial_maturation`, L423-460, Panels B3-B4), and exposes full CLI flags (`--p0-solid`, `--p0-fluid`, `--r`, `--steps`, `--seed`, `--self-test`, L775-825)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-parameter-expressivity-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2015-bi-vertex-glass-jamming.py L383–L460" ;
        dct:description "8-point p0 phase sweep and Park et al. (2015) bronchial maturation & compression trajectories" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2015-bi-vertex-glass-jamming.py#L383-L460> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2015-bi-vertex-glass-jamming.py L775–L825" ;
        dct:description "Full CLI parameter interface wired into run_all_regimes_and_render" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2015-bi-vertex-glass-jamming.py#L775-L825> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bi-vertex-glass-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Bi et al. (2015) & Park et al. (2015) zero-temperature shape-index unjamming & asthmatic bronchial epithelial rigidity transition — Morphometric validation: 90/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Computes 8 quantitative morphometrics in `measure_morphoeval()` (L675-735), including solid jammed `<q> = 3.7756` (vs `3.792` ref), asthmatic fluid `<q> = 3.9362` (vs `3.955` ref), critical threshold `p_0^* = 3.813`, 8-point phase sweep `<q>(p_0)` correlation `r = 0.9646` (`RMSE = 0.0308`), static shear modulus drop `Delta G = 0.0565`, Park et al. (2015) bronchial maturation correlation `r = 0.9962` (asthmatic `r = 0.9922`), segmented specimen `<q> = 3.7961` (`N = 101` cells), and Atia et al. (2018) `k`-Gamma distribution correlation `r = 0.9334`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-critical-unjamming-shape-index-p0-star>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-fluid-asthmatic-mean-shape-index-q>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-p0-phase-sweep-mean-q-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-park-2015-bronchial-maturation-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-solid-jammed-mean-shape-index-q>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-solid-vs-fluid-shear-modulus-g-drop>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-specimen-k-gamma-distribution-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-specimen-segmented-mean-shape-index-q>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-morphometric-validation-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-critical-unjamming-shape-index-p0-star> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical_unjamming_shape_index_p0_star = 3.813 dimensionless" ;
        schema:measurementTechnique "Zero-temperature vertex rigidity transition threshold p0* = 3.813 > p_5 = 3.8119 > p_hex = 3.7224 (Bi et al. 2015 Nature Physics)" ;
        schema:name "critical_unjamming_shape_index_p0_star" ;
        schema:unitText "dimensionless" ;
        schema:value "3.813" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-critical-unjamming-shape-index-p0-star-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-critical-unjamming-shape-index-p0-star-reference> a schema:PropertyValue ;
        schema:value "3.813" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-fluid-asthmatic-mean-shape-index-q> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fluid_asthmatic_mean_shape_index_q = 3.9362 dimensionless" ;
        schema:measurementTechnique "Simulated mean cell shape index <q> = <P/sqrt(A)> in unjammed asthmatic fluid regime (p0=3.955 > p0*=3.813; Park et al. 2015 Day 14 asthmatic HBECs)" ;
        schema:name "fluid_asthmatic_mean_shape_index_q" ;
        schema:unitText "dimensionless" ;
        schema:value "3.9362" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-fluid-asthmatic-mean-shape-index-q-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-fluid-asthmatic-mean-shape-index-q-reference> a schema:PropertyValue ;
        schema:value "3.955" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-p0-phase-sweep-mean-q-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "p0_phase_sweep_mean_q_pearson_r = 0.9646 r" ;
        schema:measurementTechnique "Pearson correlation between simulated <q>(p0) and Bi et al. (2015) reference curve across 8-point p0 sweep in [3.55, 4.00] (RMSE=0.0308, p=0.0001)" ;
        schema:name "p0_phase_sweep_mean_q_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9646" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-p0-phase-sweep-mean-q-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-p0-phase-sweep-mean-q-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.985" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-park-2015-bronchial-maturation-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "park_2015_bronchial_maturation_pearson_r = 0.9962 r" ;
        schema:measurementTechnique "Pearson correlation between simulated and Park et al. (2015) empirical non-asthmatic HBEC shape index trajectory across ALI Days 3-18 (asthmatic r=0.9857, p=0.0001)" ;
        schema:name "park_2015_bronchial_maturation_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9962" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-park-2015-bronchial-maturation-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-park-2015-bronchial-maturation-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.99" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-solid-jammed-mean-shape-index-q> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "solid_jammed_mean_shape_index_q = 3.7756 dimensionless" ;
        schema:measurementTechnique "Simulated mean cell shape index <q> = <P/sqrt(A)> in non-asthmatic jammed solid regime (p0=3.70 < p0*=3.813; Bi et al. 2015 Fig. 2 & Park et al. 2015 Day 14 control)" ;
        schema:name "solid_jammed_mean_shape_index_q" ;
        schema:unitText "dimensionless" ;
        schema:value "3.7756" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-solid-jammed-mean-shape-index-q-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-solid-jammed-mean-shape-index-q-reference> a schema:PropertyValue ;
        schema:value "3.792" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-solid-vs-fluid-shear-modulus-g-drop> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "solid_vs_fluid_shear_modulus_G_drop = 0.0565 dimensionless" ;
        schema:measurementTechnique "Drop in static shear modulus G(p0) from jammed solid (G(3.70)=0.0565) to unjammed fluid (G(3.955)=0.0000=0, matching Lean Theorem 3)" ;
        schema:name "solid_vs_fluid_shear_modulus_G_drop" ;
        schema:unitText "dimensionless" ;
        schema:value "0.0565" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-solid-vs-fluid-shear-modulus-g-drop-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-solid-vs-fluid-shear-modulus-g-drop-reference> a schema:PropertyValue ;
        schema:value "0.0565" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-specimen-k-gamma-distribution-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_k_gamma_distribution_pearson_r = 0.9334 r" ;
        schema:measurementTechnique "Pearson correlation between segmented human monolayer standardized shape-index histogram and Atia et al. (2018) Nature Physics k-Gamma PDF (k=2.15, RMSE=0.1175, p=0.0001)" ;
        schema:name "specimen_k_gamma_distribution_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9334" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-specimen-k-gamma-distribution-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-specimen-k-gamma-distribution-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.96" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-specimen-segmented-mean-shape-index-q> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_segmented_mean_shape_index_q = 3.7961 dimensionless" ;
        schema:measurementTechnique "Mean empirical cell shape index <q> across N=101 segmented cells in human_epithelial_monolayer_specimen.jpg (P6=0.6040)" ;
        schema:name "specimen_segmented_mean_shape_index_q" ;
        schema:unitText "dimensionless" ;
        schema:value "3.7961" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-specimen-segmented-mean-shape-index-q-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-specimen-segmented-mean-shape-index-q-reference> a schema:PropertyValue ;
        schema:value "3.813" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2015-bi-vertex-glass-jamming.py L383–L460" ;
        dct:description "Phase sweep and bronchial maturation Pearson r and RMSE validations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2015-bi-vertex-glass-jamming.py#L383-L460> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "2015-bi-vertex-glass-jamming.py L675–L735" ;
        dct:description "8 quantitative morphometric validations in measure_morphoeval()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2015-bi-vertex-glass-jamming.py#L675-L735> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


        prov:wasDerivedFrom <https://doi.org/10.1038/nmat4357>,
            <https://doi.org/10.1038/nphys3471>,
            <https://doi.org/10.1038/s41567-018-0089-9>,
            <https://doi.org/10.1103/PhysRevX.6.021011>,
            <https://doi.org/10.1140/epje/i2010-10677-0> .
    <https://doi.org/10.1038/nmat4357> dct:date "2015"^^xsd:gYear ;
        dct:title "Unjamming and cell shape in the asthmatic airway epithelium" .
    <https://doi.org/10.1038/nphys3471> dct:date "2015"^^xsd:gYear ;
        dct:title "A density-independent rigidity transition in biological tissues" .
    <https://doi.org/10.1038/s41567-018-0089-9> dct:date "2018"^^xsd:gYear ;
        dct:title "Geometric constraints during epithelial jamming" .
    <https://doi.org/10.1103/PhysRevX.6.021011> dct:date "2016"^^xsd:gYear ;
        dct:title "Motility-driven glass and jamming transitions in biological tissues" .
    <https://doi.org/10.1140/epje/i2010-10677-0> dct:date "2010"^^xsd:gYear ;
        dct:title "Mechanics and remodelling of cell packings in epithelia" .
}


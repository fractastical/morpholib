sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bi-vertex-glass-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Bi et al. (2015) & Park et al. (2015) zero-temperature shape-index unjamming & asthmatic bronchial epithelial rigidity transition — Morphological realism / specimen match: 89/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the human in situ monolayer micrograph (`datasets/vertex_glass_jamming/human_epithelial_monolayer_specimen.jpg`, CC BY-SA 4.0), segments `N=101` interior polygonal cells via nuclear-seeded, junction-guided Voronoi tessellation (`segment_human_monolayer_specimen`, L465-565), measures empirical mean shape index `<q> = 3.7961` (near `p_0^* = 3.813` and Park et al. 2015 Day 14 control `3.792`), and matches the Atia et al. (2018) universal `k`-Gamma standardized shape distribution (`k = 2.15`) with Pearson `r = 0.9334` (`RMSE = 0.1235`, Panels A5 & B5)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-specimen-match-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2015-bi-vertex-glass-jamming.py L465–L565" ;
        dct:description "CV segmentation of human monolayer specimen (N=101 cells, <q>=3.7961, k-Gamma r=0.9334)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2015-bi-vertex-glass-jamming.py#L465-L565> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/vertex_glass_jamming_comparison.png (generated output)" ;
        dct:description "10-panel synthesis figure showing segmented human monolayer overlay (Panel A5) and k-Gamma universal distribution match (Panel B5) — docs/media/vertex_glass_jamming_comparison.png: rendered output of 2015-bi-vertex-glass-jamming.py at 0cb0132, image/png, 1374692 B, 3075×1290 px, artifact_sha256 6b4fc774e8883b673018abcacc3e2f6d0542ce1dcba17f0f1c75210d9cc7c224 (sha256 6b4fc774e8883b673018abcacc3e2f6d0542ce1dcba17f0f1c75210d9cc7c224), spec_fingerprint 52abc2dcaa2857a7c9b54a7d8ac8d7ebb1e0481dc0dc957ca72fa6bc9190d466" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


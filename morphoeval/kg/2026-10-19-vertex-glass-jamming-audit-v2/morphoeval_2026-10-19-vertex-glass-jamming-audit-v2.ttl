<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/bi-vertex-glass-jamming-1>,
        <https://w3id.org/probknow/resource/math-law/bi-vertex-glass-jamming-2>,
        <https://w3id.org/probknow/resource/math-law/bi-vertex-glass-jamming-3> .

<https://w3id.org/probknow/resource/math-law/bi-vertex-glass-jamming-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Bi et al. (2015) Dimensionless Vertex Energy Functional & Target-Shape Ground-State Identity" ;
    dct:description "Governs mechanical force balance in confluent epithelial monolayers where competition between cortical contractility and cell-cell adhesion sets the target shape index p_0 | Variables: a_i: normalized cell area A_i/A_0; p_i: normalized cell perimeter P_i/sqrt(A_0); p_0: target cell shape index P_0/sqrt(A_0); r: dimensionless perimeter-to-area elasticity ratio K_P/(K_A A_0)" ;
    dct:source "Bi, Lopez, Schwarz & Manning (2015) Nature Physics 11(12):1074-1079 Eqs. (1)-(2)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0cb0132/2015-bi-vertex-glass-jamming.py#L95-L170>,
        <https://github.com/fractastical/morpholib/blob/0cb0132/morphoeval/lean/loops/Loop_045_vertex_glass_jamming.lean#L20-L53> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def two_cell_vertex_energy (a_i a_0 r p_i p_0 : Int) : Int :=
  (a_i - a_0) * (a_i - a_0) + r * (p_i - p_0) * (p_i - p_0)
theorem bi_vertex_energy_nonneg_and_ground_state_zero (a_0 r p_i p_0 d : Int) :
    area_deviation_sq a_0 a_0 = 0 ∧
    two_cell_vertex_energy a_0 a_0 r p_0 p_0 = 0 ∧
    two_cell_vertex_energy a_0 a_0 r p_i p_0 = r * shape_index_deviation_sq p_i p_0 ∧
    0 <= d * d"""^^pk:lean4 ;
    skos:notation "e = \\frac{E}{K_A A_0^2} = \\frac{1}{2}\\sum_{i=1}^N \\left[(a_i - 1)^2 + r(p_i - p_0)^2\\right],\\quad a_i = \\frac{A_i}{A_0},\\ p_i = \\frac{P_i}{\\sqrt{A_0}},\\ r = \\frac{K_P}{K_A A_0},\\ p_0 = \\frac{P_0}{\\sqrt{A_0}}" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/nmat4357>,
        <https://doi.org/10.1038/nphys3471>,
        <https://doi.org/10.1038/s41567-018-0089-9>,
        <https://doi.org/10.1103/PhysRevX.6.021011>,
        <https://doi.org/10.1140/epje/i2010-10677-0> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Zero-Temperature Shape-Index Unjamming (Bi-Manning Vertex Rigidity Transition & Asthmatic Bronchial Epithelial Jamming)" ;
    pk:leanDeclaration "MathOfBiology.Loop_045.two_cell_vertex_energy" ;
    pk:leanTheorem "MathOfBiology.Loop_045.bi_vertex_energy_nonneg_and_ground_state_zero" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/bi-vertex-glass-jamming-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Regular Hexagon, Pentagon & Critical Unjamming Shape-Index Bounds (p_hex < p_5 < p_0^*)" ;
    dct:description "Establishes the geometric bounds separating ordered hexagonal crystals (p_hex ≈ 3.722) from the disordered pentagonal/polygonal jamming threshold (p_0^* ≈ 3.813) | Variables: p_hex: regular hexagon shape index (2*sqrt(2*sqrt(3)) ≈ 3.7224); p_5: regular pentagon shape index (≈ 3.8119); p_0^*: disordered confluent rigidity transition point (≈ 3.813)" ;
    dct:source "Bi, Lopez, Schwarz & Manning (2015) Nature Physics 11(12):1074-1079 pp. 1074-1076 & Fig. 2" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0cb0132/2015-bi-vertex-glass-jamming.py#L65-L185>,
        <https://github.com/fractastical/morpholib/blob/0cb0132/morphoeval/lean/loops/Loop_045_vertex_glass_jamming.lean#L55-L83> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def p_hex_milli : Int := 3722
def p_pent_milli : Int := 3812
def p0_star_milli : Int := 3813
theorem shape_index_hexagon_pentagon_critical_bounds :
    (p_hex_milli * p_hex_milli < p_pent_milli * p_pent_milli) ∧
    (p_pent_milli * p_pent_milli < p0_star_milli * p0_star_milli) ∧
    (p_hex_10k ^ 4 < 192 * (10000 ^ 4)) ∧ (192 * (10000 ^ 4) < (p_hex_10k + 1) ^ 4)"""^^pk:lean4 ;
    skos:notation "p_{\\text{hex}} = \\sqrt{8\\sqrt{3}} \\approx 3.7224 < p_5 = \\sqrt{20\\tan(\\pi/5)} \\approx 3.8119 < p_0^* \\approx 3.813;\\quad p_{\\text{hex}}^2 \\approx 13.856 < (p_0^*)^2 \\approx 14.539" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/nmat4357>,
        <https://doi.org/10.1038/nphys3471>,
        <https://doi.org/10.1038/s41567-018-0089-9>,
        <https://doi.org/10.1103/PhysRevX.6.021011>,
        <https://doi.org/10.1140/epje/i2010-10677-0> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Zero-Temperature Shape-Index Unjamming (Bi-Manning Vertex Rigidity Transition & Asthmatic Bronchial Epithelial Jamming)" ;
    pk:leanDeclaration "MathOfBiology.Loop_045.p0_star_milli" ;
    pk:leanTheorem "MathOfBiology.Loop_045.shape_index_hexagon_pentagon_critical_bounds" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/bi-vertex-glass-jamming-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Zero-Temperature T1 Energy Barrier & Shear Modulus Vanishing Above Critical Shape Index p_0^*" ;
    dct:description "Proves that tissue rigidity and T1 rearrangement barriers vanish identically for p_0 >= p_0^* = 3.813 and separates jammed non-asthmatic bronchial epithelium (q_14 = 3.792 < 3.813) from unjammed asthmatic epithelium (q_14 = 3.955 > 3.813) | Variables: Δe_T1(p_0): dimensionless T1 topological neighbor-exchange energy barrier; G(p_0): macroscopic static shear modulus; q = <P_i/sqrt(A_i)>: observed cell shape index in human bronchial epithelium" ;
    dct:source "Bi et al. (2015) Nature Physics 11:1074-1079 Figs. 2-3; Park et al. (2015) Nature Materials 14:1040-1048 Figs. 1-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0cb0132/2015-bi-vertex-glass-jamming.py#L140-L435>,
        <https://github.com/fractastical/morpholib/blob/0cb0132/morphoeval/lean/loops/Loop_045_vertex_glass_jamming.lean#L85-L148> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def t1_barrier_scaled (r p0 p0_star : Int) : Int :=
  if p0 < p0_star then r * (p0_star - p0) else 0
theorem unjamming_rigidity_and_t1_barrier_vanishing
    (r p_fluid p_solid p1 p2 p0_star : Int)
    (h_fluid : p0_star <= p_fluid) (h_solid : p_solid < p0_star)
    (h_order : p1 < p2) (h_sub : p2 <= p0_star) :
    t1_barrier_scaled r p_fluid p0_star = 0 ∧
    t1_barrier_scaled 1 p_solid p0_star > 0 ∧
    t1_barrier_scaled 1 p2 p0_star < t1_barrier_scaled 1 p1 p0_star"""^^pk:lean4 ;
    skos:notation "\\Delta e_{\\text{T1}}(p_0),\\ G(p_0) \\propto r(p_0^* - p_0)_+^\\beta = \\begin{cases} > 0 & p_0 < p_0^* \\approx 3.813 \\text{ (solid jammed)} \\\\ 0 & p_0 \\ge p_0^* \\approx 3.813 \\text{ (fluid unjammed)} \\end{cases}" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/nmat4357>,
        <https://doi.org/10.1038/nphys3471>,
        <https://doi.org/10.1038/s41567-018-0089-9>,
        <https://doi.org/10.1103/PhysRevX.6.021011>,
        <https://doi.org/10.1140/epje/i2010-10677-0> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Zero-Temperature Shape-Index Unjamming (Bi-Manning Vertex Rigidity Transition & Asthmatic Bronchial Epithelial Jamming)" ;
    pk:leanDeclaration "MathOfBiology.Loop_045.t1_barrier_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_045.unjamming_rigidity_and_t1_barrier_vanishing" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bi-vertex-glass-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Bi et al. (2015) & Park et al. (2015) zero-temperature shape-index unjamming & asthmatic bronchial epithelial rigidity transition — Reproducibility package: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Deterministic RNG (`seed=2015`), fast execution (<7s full render, <2s `--self-test`), 8-check `self_test()` suite (L738-772) verifying SHA-256 integrity, Lean 4 energy equilibrium parity, hexagon-pentagon-critical geometric bounds, T1 barrier vanishing, solid vs. fluid phase sweep correlation, bronchial maturation & specimen segmentation, and two-run bitwise determinism (`np.array_equal`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-repro-package-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2015-bi-vertex-glass-jamming.py L738–L772" ;
        dct:description "8-check self_test() suite including SHA-256 check and two-run bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2015-bi-vertex-glass-jamming.py#L738-L772> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila berryi detail-scale Turing wavelength at 1.754 µm (19 Ma) — Model fidelity to source: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Implements the Schnakenberg Jacobian and the Turing formula k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), plus the leading eigenvalue sigma(k). The 1.754 µm unit is a calibration of that formula, not a new equation. Nonlinear coarsening of the 2D field is not yet part of the tested law." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-berryi-turing-wavelength-s0.py L95–L168" ;
        dct:description "jacobian, classical_kc2, sigma_of_k, fastest_mode" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-berryi-turing-wavelength-s0.py#L95-L168> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3173_drosophila_berryi_turing_wavelength_s0.lean L10–L40" ;
        dct:description "four sorry-free theorems on wavelength, chronoseries gap, diffusion ratio and mode count" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3173_drosophila_berryi_turing_wavelength_s0.lean#L10-L40> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


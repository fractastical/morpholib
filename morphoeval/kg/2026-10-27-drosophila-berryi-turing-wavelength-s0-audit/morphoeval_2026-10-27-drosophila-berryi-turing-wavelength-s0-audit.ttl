<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila berryi detail-scale Turing wavelength at 1.754 µm (19 Ma) — Morphological realism / specimen match: 76/100" ;

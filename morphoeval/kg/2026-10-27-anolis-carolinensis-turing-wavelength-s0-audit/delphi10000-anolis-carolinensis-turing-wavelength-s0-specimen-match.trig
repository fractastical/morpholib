sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Anolis carolinensis Schnakenberg wavelength at 101.1 µm (Holocene, 0 Ma) — Morphological realism / specimen match: 70/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The comparison figure places the Commons male beside a green field of dark spots. The spots are the right motif for melanophore territories, but the photograph is a whole animal on a leaf and the field is an 0.81 mm patch. Pass 1 does not yet use the GIF-versus-photo computer-vision score." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/anolis_carolinensis_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "specimen beside the 101.1 µm field — docs/media/anolis_carolinensis_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-anolis-carolinensis-turing-wavelength-s0.py at 0c76d15d, image/png, 466662 B, 1344×1008 px, artifact_sha256 a5272637322b843ecaee43a0898221e93786df5eb5d952714b4a99cc6f3db99b (sha256 a5272637322b843ecaee43a0898221e93786df5eb5d952714b4a99cc6f3db99b), spec_fingerprint 17ba2b079a1597562250107c46da2253ac6d3c2a7a7816f161aca05a741fc46e" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-anolis-carolinensis-turing-wavelength-s0.py L308–L333" ;
        dct:description "luminance-monotonic green-to-melanin colorize and 12-frame GIF" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-anolis-carolinensis-turing-wavelength-s0.py#L308-L333> .

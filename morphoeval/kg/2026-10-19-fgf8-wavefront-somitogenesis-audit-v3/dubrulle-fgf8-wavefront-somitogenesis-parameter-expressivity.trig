sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-dubrulle-fgf8-wavefront-somitogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Dubrulle & Pourquié (2001, 2004) FGF8 mRNA decay wavefront and determination front positioning in vertebrate somitogenesis, with Goldbeter (2007) RA/FGF8 bistable switch and 2D cell-based PSM strip — Parameter expressivity: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The (v_g, t_1/2) morphospace, the five experimental regimes and the k_d = 0 control are retained; Pass 3 adds a T_div sweep {240, 480, 960, 1920} min with a no-division ablation at fixed transcription whose simulated shifts (342, 286, 280, 278 um) decrease monotonically as the closed form predicts (329, 271, 252, 250 um) (L873-L900, Panel I inset), a per-cell switch constant --switch-ka, and CLI flags --t-div, --rows, --sigma-f, --print-pass3 that re-run the Pass 3 models (L1595-L1617). Deductions: K_A, sigma_F and n_rows are exposed but not swept or rendered, so their monotonic control is asserted not shown (-6); the dilution sweep's simulated shifts sit 13-28 um above the closed form at every T_div (systematic, see morphometric-validation) and the inset shows it without comment (-4); the bead strength and SU5402 dose remain non-parametric constants (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity-4> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L873–L900" ;
        dct:description "dilution_shift_sweep: T_div sweep + no-division control at fixed k_s vs closed form" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L873-L900> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L1595–L1617" ;
        dct:description "CLI --t-div/--rows/--sigma-f/--switch-ka/--print-pass3 re-run the switch and strip with user parameters" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L1595-L1617> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L1358–L1386" ;
        dct:description "Panel I: cell-based ln m scatter vs analytical lines and the T_div sweep inset (sim vs closed form)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L1358-L1386> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L1215–L1228" ;
        dct:description "Panel C 2D (v_g, t_1/2) morphospace retained from Pass 2" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L1215-L1228> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


        pk:EvidenceItem ;
    rdfs:label "Tailbud division-dilution front shift Delta_x_dil (no-division control minus T_div = 480 min strip)" ;
    dct:description "2D strip at fixed transcription k_s with division enabled vs disabled; sweep over T_div in {240, 480, 960, 1920} min" ;
    dct:source "Closed form Delta_x_dil = lambda_m ln[(2 - e^(-k_d T)) / (1 - e^(-k_d T))] (Law 5, this script; derived from Dubrulle & Pourquie 2004 decay + halving at division)" ;
    rdfs:comment "sweep shift (sim vs closed form) um: T=240: 342 vs 329; T=480: 286 vs 271; T=960: 280 vs 252; T=1920: 278 vs 250; RMSE = 21.9 um (Poisson insertion noise of the cell-based column)" ;
    prov:wasGeneratedBy "script" ;
    schema:about "Gallus gallus (chick embryo presomitic mesoderm & paraxial somites)" ;
    schema:error 5.4817e+00 ;
    schema:targetValue 2.71374e+02 ;

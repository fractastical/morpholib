sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-dubrulle-fgf8-wavefront-somitogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Dubrulle & Pourquié (2001, 2004) FGF8 mRNA decay wavefront and determination front positioning in vertebrate somitogenesis, with Goldbeter (2007) RA/FGF8 bistable switch and 2D cell-based PSM strip — Morphological realism / specimen match: 85/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Panels D-F still carry the only specimen comparison: the SHA-256-pinned Wikimedia SEM is segmented into two bilateral somite rows (8 and 9 somites, 48.47 px spacing, symmetry 0.9606) and its band-pass profile is compared with a phase-aligned periodic model (r = 0.563). Pass 3 adds a rendered 2D tissue (Panel H) with visibly segmented, mildly jagged somite blocks (boundary roughness 19 um, somite CV 0.22) whose irregularity is of the same order as the specimen's spacing CV (0.20). Deductions: the 2D strip is not compared with the specimen at all - no boundary-straightness or somite-count comparison between Panel H and Panel E (-6); the specimen's species is labelled \"avian/vertebrate\" and is not confirmed as chick, so the organism claim rests on the Wikimedia title (-4); the profile correlation r = 0.563 is modest and the synthetic wave is fitted in phase and wavelength to the specimen itself (-5)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2003-dubrulle-fgf8-wavefront-somitogenesis.py L1329–L1357: Panel H renders the 2D cell strip with per-row somite boundaries and fronts but has no overlay/comparison with the SEM rows <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L1329-L1357>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-specimen-match-3> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L907–L978" ;
        dcterms:description "Bilateral DoG peak/cleft segmentation and phase-aligned periodicity fit on chick_somite_psm_specimen.jpg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L907-L978> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/fgf8_wavefront_somitogenesis_comparison.png (generated output)" ;
        dcterms:description "9-panel figure: specimen segmentation (E), periodicity fit (F), 2D strip (H) visually inspected after render — docs/media/fgf8_wavefront_somitogenesis_comparison.png: rendered output of 2003-dubrulle-fgf8-wavefront-somitogenesis.py at d58a084, image/png, 1529122 B, 2352×2016 px, artifact_sha256 61b31ffd1e1b1344790d330a58240354a24d2ec245281da77adea61593631ff4 (sha256 61b31ffd1e1b1344790d330a58240354a24d2ec245281da77adea61593631ff4), spec_fingerprint c932f4a1dd2d2a7154d419f019c4a647891c78e7cc462bb8f1d3ef6cb210100e" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "datasets/fgf8_wavefront_somitogenesis/fgf8_wavefront_somitogenesis_reference.json L30–L52" ;
        dcterms:description "Specimen metadata: species string hedged as avian/vertebrate SEM from Wikimedia Commons" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/fgf8_wavefront_somitogenesis/fgf8_wavefront_somitogenesis_reference.json#L30-L52> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


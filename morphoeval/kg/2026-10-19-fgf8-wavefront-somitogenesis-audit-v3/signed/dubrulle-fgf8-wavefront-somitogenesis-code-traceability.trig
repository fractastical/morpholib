sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-dubrulle-fgf8-wavefront-somitogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Dubrulle & Pourquié (2001, 2004) FGF8 mRNA decay wavefront and determination front positioning in vertebrate somitogenesis, with Goldbeter (2007) RA/FGF8 bistable switch and 2D cell-based PSM strip — Code-to-model traceability: 89/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Every modelling function carries a Law number, the cited paper and the Lean theorem name in its docstring (Laws 1-5 in the module docstring L23-L94; function docstrings at L154, L170, L220, L238, L318, L338, L378, L433, L621, L654, L873), and `morphoeval/math_kg_loops/dubrulle-fgf8-wavefront-somitogenesis.yaml` registers 5 equations with lean_locus and code_locus pointing at the current line ranges (L33-L162). Deductions: the Goldbeter equation numbering is asserted, not verified (-4); the hard-coded 67.5 um electroporation shift (L271-L274) and the 52.5/65 um cycle shifts (L566-L584) cite no equation or figure (-4); Panel H's somite-boundary rendering and the 0.7-row mediolateral smoothing are design choices without a cited basis (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2003-dubrulle-fgf8-wavefront-somitogenesis.py L271–L274: Electroporation delta_x = 67.5 um hard-coded with a comment but no equation/figure citation <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L271-L274>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-code-traceability-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L23–L94" ;
        dcterms:description "Module docstring: Laws 1-5 with equations, papers and Lean theorem names" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L23-L94> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/dubrulle-fgf8-wavefront-somitogenesis.yaml L98–L162" ;
        dcterms:description "Laws 4-5 registered with lean_code, lean_locus and code_locus matching the current files" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/dubrulle-fgf8-wavefront-somitogenesis.yaml#L98-L162> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


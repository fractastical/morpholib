sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-dubrulle-fgf8-wavefront-somitogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Dubrulle & Pourquié (2001, 2004) FGF8 mRNA decay wavefront and determination front positioning in vertebrate somitogenesis, with Goldbeter (2007) RA/FGF8 bistable switch and 2D cell-based PSM strip — Source and data traceability: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Four primary DOIs plus the newly cited Bénazéraf et al. (2010) are in the docstring, the dataset README and paper_citations.bib (L1-L22; datasets/fgf8_wavefront_somitogenesis/paper_citations.bib L1-L55); the specimen and scout manifest are SHA-256 pinned and verified at every run (L111-L142); the reference JSON now records the switch parameters with an explicit provenance flag (\"NOT the published parameter table\") and the 2D-strip reference outputs with the seed (JSON L141-L193). Deductions: the five \"observed\" somite lengths and SDs (98.0 +/- 8.0, 201.0 +/- 9.5, 214.0 +/- 10.0, 84.0 +/- 7.5 um) carry no figure/table/page pinpoint in Dubrulle et al. (2001) and could not be verified from the repository, so the validation's ground truth is traceable only to the JSON (-8); the reference JSON itself is not SHA-pinned (only hashed), so its edits are not fail-closed (-3); the Goldbeter equations are cited as \"Eqs. 1-3\" without verifying the paper's numbering (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/fgf8_wavefront_somitogenesis/fgf8_wavefront_somitogenesis_reference.json L82–L139: Observed regime values lack figure/table pinpoints <https://github.com/fractastical/morpholib/blob/d58a084/datasets/fgf8_wavefront_somitogenesis/fgf8_wavefront_somitogenesis_reference.json#L82-L139>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-source-traceability-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L111–L142" ;
        dcterms:description "EXPECTED_SHA256 for specimen and scout manifest; verify_dataset_integrity fails closed on mismatch; reference JSON only hashed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L111-L142> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/fgf8_wavefront_somitogenesis/fgf8_wavefront_somitogenesis_reference.json L141–L193" ;
        dcterms:description "Pass 3 switch parameters with provenance flag and 2D-strip reference outputs (seed 2003)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/fgf8_wavefront_somitogenesis/fgf8_wavefront_somitogenesis_reference.json#L141-L193> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/fgf8_wavefront_somitogenesis/paper_citations.bib L45–L55" ;
        dcterms:description "Bénazéraf et al. (2010) Nature 466:248-252 added with DOI and the reason for citation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/fgf8_wavefront_somitogenesis/paper_citations.bib#L45-L55> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


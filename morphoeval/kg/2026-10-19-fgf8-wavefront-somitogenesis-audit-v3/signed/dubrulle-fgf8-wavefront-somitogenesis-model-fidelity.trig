sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-dubrulle-fgf8-wavefront-somitogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L154–L235" ;
        dcterms:description "Advection-decay PDE solver with analytical exponential check and threshold front x*" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L154-L235> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L302–L336" ;
        dcterms:description "Goldbeter-type RA -| FGF -> Cyp26 -| RA switch RHS; parameters flagged as this script's bistable-regime choice" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L302-L336> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L338–L431" ;
        dcterms:description "Analytic elimination of X and RA, bracketed+bisected steady states, saddle-node refinement and spatial hysteresis window" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L338-L431> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L433–L506" ;
        dcterms:description "Forward and reverse Lagrangian cell-trajectory integration: hysteretic front, 90->10 % width vs lambda ln 9, reverse-switch memory" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L433-L506> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L654–L870" ;
        dcterms:description "2D cell-based strip: progenitor pool with division + partitioning, exported-cell elongation, smoothed FGF8 field, per-row somite ids" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L654-L870> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-6> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_024_fgf8_wavefront_somitogenesis.lean L97–L171" ;
        dcterms:description "3 new Lean 4 theorems (loop sign, hysteresis memory, division = one half-life), verified with lean 4.35.0, 0 sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_024_fgf8_wavefront_somitogenesis.lean#L97-L171> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Dubrulle & Pourquié (2001, 2004) FGF8 mRNA decay wavefront and determination front positioning in vertebrate somitogenesis, with Goldbeter (2007) RA/FGF8 bistable switch and 2D cell-based PSM strip — Model fidelity to source: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The core Dubrulle (2004) advection-decay PDE and the (2001) threshold law are implemented as published (L154-L235, L2 error 0.0009). Pass 3 adds the Goldbeter (2007) double-negative loop with the paper's functional forms (Hill repression of Fgf8 by RA, Hill induction of Cyp26 by FGF, Michaelis-Menten Cyp26-catalysed RA degradation; L318-L336) and shows genuine bistability (3 roots for m in [0.184, 0.546], monostable high-FGF posteriorly and low-FGF anteriorly, L338-L431), hysteresis along a cell trajectory and the one-division-equals-one-half-life dilution law realised in an explicit cell-based strip (L654-L870). Deductions: the lab-frame somite-train simulator still enters the bead (-52.5/+52.5 um), SU5402 (+65 um) and electroporation (67.5 um) shifts as constants instead of deriving them from a perturbed gradient or the new switch (L566-L584, L271-L274) (-6); the switch parameters are this script's choice, not the 2007 table, and the dynamic front lags the saddle-node by 110 um (slow passage at tau_sw = 10 min) so x_sw = 720 um is tuned-adjacent rather than predicted (-4); the switch is evaluated along one trajectory and not embedded in the 2D strip, whose determination is still the graded threshold on a smoothed field (-3); the strip's progenitor pool has no PSM division and makes all elongation proliferative (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2003-dubrulle-fgf8-wavefront-somitogenesis.py L566–L584: Bead/SU5402 somite shifts hard-coded per cycle (s_c = S0 - 52.5 etc.), not derived from the gradient or switch <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L566-L584>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity-6> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;

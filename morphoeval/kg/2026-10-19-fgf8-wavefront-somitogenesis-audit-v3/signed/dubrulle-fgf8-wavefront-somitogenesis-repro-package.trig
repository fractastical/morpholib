    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L1585–L1624" ;
        dcterms:description "CLI with --self-test, --skip-gif and Pass 3 flags; default invocation renders PNG + GIF" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L1585-L1624> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/fgf8_wavefront_somitogenesis_growth.gif (generated output)" ;
        dcterms:description "24-frame GIF, byte-identical across Pass 2 and Pass 3 renders — docs/media/fgf8_wavefront_somitogenesis_growth.gif: rendered output of 2003-dubrulle-fgf8-wavefront-somitogenesis.py at d58a084, image/gif, 590842 B, 940×540 px, 13 frames, artifact_sha256 0da6319dc18b88754bad6917bbf5155684a846fca3bdcb8ccdb8ec332fe68ac5 (sha256 0da6319dc18b88754bad6917bbf5155684a846fca3bdcb8ccdb8ec332fe68ac5), spec_fingerprint c932f4a1dd2d2a7154d419f019c4a647891c78e7cc462bb8f1d3ef6cb210100e" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Dubrulle & Pourquié (2001, 2004) FGF8 mRNA decay wavefront and determination front positioning in vertebrate somitogenesis, with Goldbeter (2007) RA/FGF8 bistable switch and 2D cell-based PSM strip — Reproducibility package: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Deterministic seeds (2003) for both the 1D simulator and the 2D strip with bitwise re-run checks in the self-test (L1497-L1500, L1548-L1550); --self-test extended to 6 blocks covering SHA-256, PDE error, conservation laws, specimen segmentation, switch bistability/monostability/hysteresis/steady-state residuals and strip closed forms (L1485-L1582), passing in ~2 s; default render 3.6 s; the GIF is byte-identical to Pass 2 (SHA-256 0da6319d...). Deductions: no requirements lock or recorded environment beyond the audit's checkpoint block (-4); when run under a read-only HOME matplotlib rebuilds its font cache in a temp dir and warns, which the invocation notes do not mention (-2); the PNG changed layout (2x3 -> 3x3) so Pass 2 artifact hashes no longer apply and no CSV of the measurements is emitted (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-repro-package-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-dubrulle-fgf8-wavefront-somitogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Dubrulle & Pourquié (2001, 2004) FGF8 mRNA decay wavefront and determination front positioning in vertebrate somitogenesis, with Goldbeter (2007) RA/FGF8 bistable switch and 2D cell-based PSM strip — Morphometric validation: 83/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "measure_morphoeval() now returns 10 measurements, each with a reference_value, including the hysteretic front (720.4 vs 696.5 um), the bistable window (391.9 um), the 2D front (698.8 +/- 7.0 vs 694.4 um), the 2D somite length (148.2 vs 150 um) and the dilution shift (286 vs 271 um) (L983-L1120), with CV/SD/RMSE dispersion terms. Deductions: the 5-regime Pearson r = 0.9998 correlates `predicted_somite_length_um` read from the reference JSON with `observed_somite_length_um` read from the same JSON (L252-L291, L996-L999), so the headline validation is a table self-correlation, not a comparison of computed output with the paper (-7); two Pass 3 references are internal closed forms (window = lambda ln(m_SN_hi/m_SN_lo); front = lambda ln(m_exit/m_crit) with the simulated m_exit), i.e. consistency checks rather than literature values (-4); the 2D somite CV = 0.22 is 5x the observed chick 6.5/150 = 0.043 and the simulated dilution shifts exceed the closed form by 13-28 um systematically (first-determined-cell offset and smoothing bias), both disclosed in notes but not resolved (-4); no morphometric of the 2D strip is compared with the SEM specimen (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2003-dubrulle-fgf8-wavefront-somitogenesis.py L252–L291: evaluate_perturbation_regimes: S_pred_um is r['predicted_somite_length_um'] from the JSON; S_calc_um is computed but not used for r/RMSE <https://github.com/fractastical/morpholib/blob/d58a084/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L252-L291>",
            "datasets/fgf8_wavefront_somitogenesis/fgf8_wavefront_somitogenesis_reference.json L82–L139: Regime table with observed_somite_length_um / observed_somite_sd_um lacking figure or table pinpoints <https://github.com/fractastical/morpholib/blob/d58a084/datasets/fgf8_wavefront_somitogenesis/fgf8_wavefront_somitogenesis_reference.json#L82-L139>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-2d-cell-based-psm-strip-mean-determination-front-x-2d-with-tailbud-division-dilution>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-2d-cell-based-strip-mean-somite-length-s-2d-cells-per-clock-cycle-x-cell-length>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-chick-psm-determination-front-distance-from-tailbud-x-v-g-k-d-ln-m-0-m-crit>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-chick-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-dubrulle-et-al-2001-2004-5-regime-somite-length-prediction-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-ectopic-fgf8-bead-anterior-compressed-somite-length-s-ant>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-goldbeter-ra-fgf8-bistable-switch-hysteretic-determination-front-x-sw-cell-trajectory>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-ra-fgf8-bistable-hysteresis-window-width-along-the-psm-x-sn-lo-x-sn-hi>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-su5402-pharmacological-fgfr1-inhibition-enlarged-somite-length-s-su5402>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-tailbud-division-dilution-front-shift-delta-x-dil-no-division-control-minus-t-div-480-min-strip>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-morphometric-validation-2> ;
        pk:hasScore "0.83"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-2d-cell-based-psm-strip-mean-determination-front-x-2d-with-tailbud-division-dilution> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D cell-based PSM strip mean determination front x*_2D with tailbud division dilution = 698.75 um" ;
        dct:description "mediolateral front SD = 6.96 um across rows; exported level m_exit = 0.9942 vs closed-form periodic-dilution solution 1.0000; cell-based gradient fit lambda = 370.5 um vs v_g/k_d = 360.7 um; no-division control at the same transcription rate puts the front at 975.0 um" ;
        schema:measurementTechnique "8-row x 10 um cell strip, N_pool = 80 progenitors/row, T_div = 480 min, binomial-like partitioning (sd 0.04), juxtacrine FGF8 smoothing sigma = 25 um; front = most posterior determined cell per row" ;
        schema:name "2D cell-based PSM strip mean determination front x*_2D with tailbud division dilution" ;
        schema:unitText "um" ;
        schema:value "698.75" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-2d-cell-based-psm-strip-mean-determination-front-x-2d-with-tailbud-division-dilution-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-2d-cell-based-psm-strip-mean-determination-front-x-2d-with-tailbud-division-dilution-reference> a schema:PropertyValue ;
        dct:source "Analytical x* = lambda_m ln(m_exit / m_crit) with the measured geometric-mean exported level m_exit (Dubrulle & Pourquie 2004 law applied to the diluted exit level)" ;
        schema:value "694.376" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-2d-cell-based-strip-mean-somite-length-s-2d-cells-per-clock-cycle-x-cell-length> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D cell-based strip mean somite length S_2D (cells per clock cycle x cell length) = 148.235 um" ;
        dct:description "somite length SD = 33.1 um (CV = 0.223); mediolateral boundary roughness = 18.7 um (mean SD of the front across rows at clock ticks); observed chick somite SD 6.5 um" ;
        schema:measurementTechnique "per-row cell counts per somite id over 68 complete (row, somite) blocks; boundary = per-row front at each T_c = 90 min clock tick" ;
        schema:name "2D cell-based strip mean somite length S_2D (cells per clock cycle x cell length)" ;
        schema:unitText "um" ;
        schema:value "148.235" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-2d-cell-based-strip-mean-somite-length-s-2d-cells-per-clock-cycle-x-cell-length-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-2d-cell-based-strip-mean-somite-length-s-2d-cells-per-clock-cycle-x-cell-length-reference> a schema:PropertyValue ;
        dct:source "Dubrulle et al. (2001) Cell 106:219-232 wild-type chick somite S_0 = v_g T_c = 150 um" ;
        schema:value "150.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-chick-psm-determination-front-distance-from-tailbud-x-v-g-k-d-ln-m-0-m-crit> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chick PSM determination front distance from tailbud x* = (v_g/k_d)*ln(m_0/m_crit) = 696.47 um" ;
        dct:description "wild-type somite length S_0 = 150.00 um (v_g = 1.667 um/min, T_c = 90 min); no-decay control forms 0 somites" ;
        schema:measurementTechnique "cell-autonomous fgf8 mRNA advection-decay PDE steady gradient (lambda_m=360.67 um, PDE L2 rel error=0.00093)" ;
        schema:name "chick PSM determination front distance from tailbud x* = (v_g/k_d)*ln(m_0/m_crit)" ;
        schema:unitText "um" ;
        schema:value "696.47" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-chick-psm-determination-front-distance-from-tailbud-x-v-g-k-d-ln-m-0-m-crit-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-chick-psm-determination-front-distance-from-tailbud-x-v-g-k-d-ln-m-0-m-crit-reference> a schema:PropertyValue ;
        dct:source "Dubrulle & Pourquie (2004) Nature 427:419-422 & Dubrulle et al. (2001) Cell 106:219-232 (~70% of 1000 um chick PSM from posterior tailbud)" ;
        schema:value "696.46" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-chick-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chick/vertebrate embryo SEM specimen bilateral somite spacing S_obs = 48.4667 px" ;
        dct:description "bilateral symmetry ratio = 0.9606, std = 9.70 px, phase correlation r = 0.5629" ;
        schema:measurementTechnique "bilateral dorsal somite row DoG peak segmentation on chick_somite_psm_specimen.jpg (upper=8 somites, lower=9 somites, CV=0.2002)" ;
        schema:name "chick/vertebrate embryo SEM specimen bilateral somite spacing S_obs" ;
        schema:unitText "px" ;
        schema:value "48.4667" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-chick-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-chick-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs-reference> a schema:PropertyValue ;
        dct:source "Vendored CC BY 4.0 avian/vertebrate embryo SEM specimen (datasets/fgf8_wavefront_somitogenesis/chick_somite_psm_specimen.jpg)" ;
        schema:value "48.47" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-dubrulle-et-al-2001-2004-5-regime-somite-length-prediction-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Dubrulle et al. (2001, 2004) 5-regime somite length prediction Pearson correlation r = 1.0 Pearson r" ;
        dct:description "p = 1.05e-07, RMSE = 1.072 um across [84, 214] um somite range" ;
        schema:measurementTechnique "correlation across 5 FGF8 perturbation regimes (control, FGF8 bead anterior, FGF8 bead posterior, SU5402, pCAGGS-FGF8 electroporation; RMSE=1.072 um)" ;
        schema:name "Dubrulle et al. (2001, 2004) 5-regime somite length prediction Pearson correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-dubrulle-et-al-2001-2004-5-regime-somite-length-prediction-pearson-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-dubrulle-et-al-2001-2004-5-regime-somite-length-prediction-pearson-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Dubrulle et al. (2001) Cell 106:219-232 & Dubrulle & Pourquie (2004) Nature 427:419-422" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-ectopic-fgf8-bead-anterior-compressed-somite-length-s-ant> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ectopic FGF8 bead anterior compressed somite length S_ant = 97.5 um" ;
        dct:description "compensatory posterior catch-up somite S_post = 202.50 um (two-somite sum S_ant + S_post = 300.0 um = 2*S_0)" ;
        schema:measurementTechnique "FGF8 bead local determination front anterior retardation (+52.5 um shift at somite level n=5)" ;
        schema:name "ectopic FGF8 bead anterior compressed somite length S_ant" ;
        schema:unitText "um" ;
        schema:value "97.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-ectopic-fgf8-bead-anterior-compressed-somite-length-s-ant-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-ectopic-fgf8-bead-anterior-compressed-somite-length-s-ant-reference> a schema:PropertyValue ;
        dct:source "Dubrulle, McGrew & Pourquie (2001) Cell 106:219-232 Figs. 1-3 (35% compressed anterior somite adjacent to FGF8 bead)" ;
        schema:value "98.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-goldbeter-ra-fgf8-bistable-switch-hysteretic-determination-front-x-sw-cell-trajectory> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Goldbeter RA/FGF8 bistable-switch hysteretic determination front x_sw (cell trajectory) = 720.417 um" ;
        dct:description "switch vs graded threshold: transition width 198.3 um vs 792.5 um (sharpening ratio 4.00x); hysteresis: reverse switch needs m >= 0.675 vs forward m_SN_lo = 0.184 (bistable window 392 um); parameters are this script's bistable-regime choice, not the paper's table" ;
        schema:measurementTechnique "Goldbeter-Gonze-Pourquie (2007) RA -| FGF -> Cyp26 -| RA switch integrated along a PSM cell trajectory m = m_0 e^(-k_d t); RA half-range crossing (saddle-node x_SN = 610.0 um, m_SN_lo = 0.184)" ;
        schema:name "Goldbeter RA/FGF8 bistable-switch hysteretic determination front x_sw (cell trajectory)" ;
        schema:unitText "um" ;
        schema:value "720.417" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-goldbeter-ra-fgf8-bistable-switch-hysteretic-determination-front-x-sw-cell-trajectory-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-goldbeter-ra-fgf8-bistable-switch-hysteretic-determination-front-x-sw-cell-trajectory-reference> a schema:PropertyValue ;
        dct:source "Dubrulle et al. (2001) Cell 106:219-232 threshold-front estimate x* = (v_g/k_d) ln(m_0/m_crit); Goldbeter et al. (2007) Dev. Dyn. 236:1495-1508 (bistability mechanism)" ;
        schema:value "696.46" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-ra-fgf8-bistable-hysteresis-window-width-along-the-psm-x-sn-lo-x-sn-hi> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "RA/FGF8 bistable (hysteresis) window width along the PSM x_SN_lo - x_SN_hi = 391.879 um" ;
        dct:description "posterior reverse-switch position x_SN_hi = 218.1 um, anterior forward-switch x_SN_lo = 610.0 um; dynamic (slow-passage) lag x_sw - x_SN_lo = 110.5 um at tau_sw = 10 min" ;
        schema:measurementTechnique "steady-state branch scan of the 3-variable switch over m in (0, m_0]; saddle-nodes at m_SN_lo = 0.184, m_SN_hi = 0.546 mapped by x = lambda_m ln(m_0/m)" ;
        schema:name "RA/FGF8 bistable (hysteresis) window width along the PSM x_SN_lo - x_SN_hi" ;
        schema:unitText "um" ;
        schema:value "391.879" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-ra-fgf8-bistable-hysteresis-window-width-along-the-psm-x-sn-lo-x-sn-hi-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-ra-fgf8-bistable-hysteresis-window-width-along-the-psm-x-sn-lo-x-sn-hi-reference> a schema:PropertyValue ;
        dct:source "Closed form lambda_m * ln(m_SN_hi / m_SN_lo) from the same saddle-node pair (internal consistency); Goldbeter et al. (2007) report bistability but no chick window length" ;
        schema:value "391.877" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-su5402-pharmacological-fgfr1-inhibition-enlarged-somite-length-s-su5402> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "SU5402 pharmacological FGFR1 inhibition enlarged somite length S_SU5402 = 215.0 um" ;
        dct:description "predicted S_SU5402 = 215.0 um vs observed 214.0 +/- 10.0 um" ;
        schema:measurementTechnique "SU5402 FGFR1 inhibition posterior shift of determination front (-65.0 um shift -> enlarged somites)" ;
        schema:name "SU5402 pharmacological FGFR1 inhibition enlarged somite length S_SU5402" ;
        schema:unitText "um" ;
        schema:value "215.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-su5402-pharmacological-fgfr1-inhibition-enlarged-somite-length-s-su5402-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-su5402-pharmacological-fgfr1-inhibition-enlarged-somite-length-s-su5402-reference> a schema:PropertyValue ;
        dct:source "Dubrulle, McGrew & Pourquie (2001) Cell 106:219-232 Fig. 2 (SU5402 treatment induces ~43% larger somites)" ;
        schema:value "214.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-tailbud-division-dilution-front-shift-delta-x-dil-no-division-control-minus-t-div-480-min-strip> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Tailbud division-dilution front shift Delta_x_dil (no-division control minus T_div = 480 min strip) = 286.25 um" ;
        dct:description "sweep shift (sim vs closed form) um: T=240: 342 vs 329; T=480: 286 vs 271; T=960: 280 vs 252; T=1920: 278 vs 250; RMSE = 21.9 um (Poisson insertion noise of the cell-based column)" ;
        schema:measurementTechnique "2D strip at fixed transcription k_s with division enabled vs disabled; sweep over T_div in {240, 480, 960, 1920} min" ;
        schema:name "Tailbud division-dilution front shift Delta_x_dil (no-division control minus T_div = 480 min strip)" ;
        schema:unitText "um" ;
        schema:value "286.25" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-tailbud-division-dilution-front-shift-delta-x-dil-no-division-control-minus-t-div-480-min-strip-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-tailbud-division-dilution-front-shift-delta-x-dil-no-division-control-minus-t-div-480-min-strip-reference> a schema:PropertyValue ;
        dct:source "Closed form Delta_x_dil = lambda_m ln[(2 - e^(-k_d T)) / (1 - e^(-k_d T))] (Law 5, this script; derived from Dubrulle & Pourquie 2004 decay + halving at division)" ;
        schema:value "271.374" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py L983–L1120" ;

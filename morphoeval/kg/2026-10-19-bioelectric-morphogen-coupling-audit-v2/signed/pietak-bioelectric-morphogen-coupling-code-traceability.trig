sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pietak-bioelectric-morphogen-coupling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Pietak & Levin (2017) electrodiffusive Nernst-Planck gap-junction morphogen transport & cryptic two-headed memory — Code-to-model traceability: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Every computational function and docstring maps directly to Pietak & Levin (2017) Eqs. (3)-(5) and Figs. 2-6, Pietak & Levin (2016), Durant et al. (2017), and the 3 Lean 4 theorems in `Loop_082_bioelectric_morphogen_coupling.lean` and `morphoeval/math_kg_loops/pietak-bioelectric-morphogen-coupling.yaml`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-code-traceability-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2017-pietak-bioelectric-morphogen-coupling.py L1–L58" ;
        dcterms:description "Module docstring linking equations to Pietak & Levin (2017)/(2016) and Lean 4 theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L1-L58> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/pietak-bioelectric-morphogen-coupling.yaml L1–L95" ;
        dcterms:description "Math KG loop specification linking equations, Lean 4 declarations, and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/math_kg_loops/pietak-bioelectric-morphogen-coupling.yaml#L1-L95> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


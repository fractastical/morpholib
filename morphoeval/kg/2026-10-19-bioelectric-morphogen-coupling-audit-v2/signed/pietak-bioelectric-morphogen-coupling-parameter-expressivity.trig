sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pietak-bioelectric-morphogen-coupling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Pietak & Levin (2017) electrodiffusive Nernst-Planck gap-junction morphogen transport & cryptic two-headed memory — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Simulates all 6 experimental regimes from Pietak & Levin (2017) and Durant et al. (2017) (`wild_type_1H1T`, `octanol_pulse_2H0T`, `cryptic_memory_washout_2H0T`, `sch28080_hyperpolarized_0H2T`, `uncharged_morphogen_control_z0` negative control, and `bioelectric_reset_rescue_1H1T`), executes a 9-point Boltzmann AP voltage sweep across DeltaV_AP in [-30, +50] mV alongside z=+1, 0, -1 analytical curves (Panel A1), and maps the 2D (DeltaV_AP, 1 - eta_oct) electrodiffusive morphospace (Panel B2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-parameter-expressivity-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2017-pietak-bioelectric-morphogen-coupling.py L400–L442" ;
        dcterms:description "6-regime evaluator, 9-point Boltzmann voltage sweep, and 2D (DeltaV_AP, GJ openness) morphospace" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L400-L442> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


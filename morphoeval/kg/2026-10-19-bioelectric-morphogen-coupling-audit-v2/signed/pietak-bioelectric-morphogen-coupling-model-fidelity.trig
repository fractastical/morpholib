sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pietak-bioelectric-morphogen-coupling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2017-pietak-bioelectric-morphogen-coupling.py L115–L225" ;
        dcterms:description "Bell-form voltage-gated GJ conductance, exact Boltzmann ratio, and Scharfetter-Gummel Nernst-Planck flux divergence" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L115-L225> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2017-pietak-bioelectric-morphogen-coupling.py L228–L395" ;
        dcterms:description "Coupled 1D Nernst-Planck 5-HT + cAMP/PKA/beta-catenin/ERK feedback PDE solver across 6 regimes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L228-L395> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_082_bioelectric_morphogen_coupling.lean L14–L108" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for Nernst-Planck flux, Boltzmann work, and cryptic 2H0T memory" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_082_bioelectric_morphogen_coupling.lean#L14-L108> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Pietak & Levin (2017) electrodiffusive Nernst-Planck gap-junction morphogen transport & cryptic two-headed memory — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements the Pietak & Levin (2017) Eqs. (3)-(5) & Pietak & Levin (2016) Nernst-Planck electrodiffusive gap-junction flux J_s = -D_s*G_gj(DeltaV)* (dc/dx + (z*F/(R*T))*c*dV/dx) using a conservative Scharfetter-Gummel Bernoulli discretization that converges to the exact Boltzmann equilibrium ratio c_post/c_ant = exp(-z*(V_post - V_ant)/V_T) = 4.6992 (PDE = 4.6984), coupled to the cAMP/PKA -> beta-catenin / ERK bistable loop (L115-395), verified by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_082_bioelectric_morphogen_coupling.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pietak-bioelectric-morphogen-coupling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-pietak-bioelectric-morphogen-coupling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Pietak & Levin (2017) electrodiffusive Nernst-Planck gap-junction morphogen transport & cryptic two-headed memory — Morphometric validation: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Extracts 6 reference-anchored quantitative morphometric measurements via `measure_morphoeval()` (L705-805): wild-type posterior-to-anterior 5-HT Boltzmann concentration ratio (4.6984 vs 4.6992 exact reference, 9-point sweep r = 1.0000), cryptic two-headed memory persistence after octanol washout (2 heads vs 2 reference), posterior beta-catenin suppression delta between WT and 8-octanol (0.8407 vs 0.72 reference), segmented specimen bilateral ocelli relative AP position (0.0528 vs 0.065 reference, std = 0.0036), specimen vs simulated 1H1T width profile correlation (Pearson r and RMSE across 60 AP bins), and 6-regime regenerated head count RMSE = 0.0000 (exact 6/6 phenotype match)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-cryptic-two-headed-2h0t-planarian-memory-persistence-after-transient-8-octanol-washout>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-pietak-levin-2017-6-regime-regenerated-head-count-prediction-rmse>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-planarian-specimen-bilateral-photoreceptor-ocelli-relative-ap-position>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-posterior-beta-catenin-suppression-delta-between-wild-type-1h1t-and-8-octanol-gap-junction-blockade-2h0t>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-specimen-vs-simulated-1h1t-planarian-dorsoventral-width-profile-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-wild-type-nernst-planck-posterior-to-anterior-serotonin-5-ht-boltzmann-concentration-ratio-c-post-c-ant>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-morphometric-validation-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-cryptic-two-headed-2h0t-planarian-memory-persistence-after-transient-8-octanol-washout> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cryptic two-headed (2H0T) planarian memory persistence after transient 8-octanol washout = 2 regenerated heads after washout" ;
        dct:description "cryptic washout post_E = 0.9878, post_B = 0.0924, c_post/c_ant = 1.0000 (2H0T); targeted posterior K+ hyperpolarization rescues 1H1T (n_heads = 1, c_post/c_ant = 4.6869)" ;
        schema:measurementTechnique "Bilateral ERK head commitment (E >= 0.50, B < 0.50) after transient 8-octanol gap-junction blockade (eta_oct=0.92) followed by complete washout (eta_oct -> 0.0)" ;
        schema:name "Cryptic two-headed (2H0T) planarian memory persistence after transient 8-octanol washout" ;
        schema:unitText "regenerated heads after washout" ;
        schema:value "2" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-cryptic-two-headed-2h0t-planarian-memory-persistence-after-transient-8-octanol-washout-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-cryptic-two-headed-2h0t-planarian-memory-persistence-after-transient-8-octanol-washout-reference> a schema:PropertyValue ;
        dct:source "Pietak & Levin (2017) J. R. Soc. Interface 14:20170425 Figs. 5-6 & Durant et al. (2017) Biophys. J. 112:2231-2243 (permanent cryptic 2H0T planarians)" ;
        schema:value "2" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-pietak-levin-2017-6-regime-regenerated-head-count-prediction-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pietak & Levin (2017) 6-regime regenerated head count prediction RMSE = 0.0 heads RMSE" ;
        dct:description "predicted heads = [1, 2, 2, 0, 2, 1] vs reference = [1, 2, 2, 0, 2, 1] (exact 6/6 phenotype match, RMSE = 0.0000)" ;
        schema:measurementTechnique "RMSE between predicted and empirical head counts across WT (1H), 8-Octanol (2H), Cryptic Washout Memory (2H), SCH-28080/Forskolin (0H), z=0 Control (2H), and Bioelectric K+ Rescue (1H)" ;
        schema:name "Pietak & Levin (2017) 6-regime regenerated head count prediction RMSE" ;
        schema:unitText "heads RMSE" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-pietak-levin-2017-6-regime-regenerated-head-count-prediction-rmse-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-pietak-levin-2017-6-regime-regenerated-head-count-prediction-rmse-reference> a schema:PropertyValue ;
        dct:source "Pietak & Levin (2017) J. R. Soc. Interface 14:20170425 Figs. 3-6 & Durant et al. (2017) Biophys. J. 112:2231-2243 (Lean 4 cryptic_two_headed_memory_phenotypes)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-planarian-specimen-bilateral-photoreceptor-ocelli-relative-ap-position> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Planarian specimen bilateral photoreceptor ocelli relative AP position = 0.0528 x / L (anterior fraction)" ;
        dct:description "detected 2 bilateral ocelli at x/L = [0.0563, 0.0492] (std = 0.0036), body length = 1478 px" ;
        schema:measurementTechnique "Automated Gaussian local-contrast ocelli segmentation on planarian_ap_polarity_specimen.jpg (N=2 eyespots at x/L=0.0528)" ;
        schema:name "Planarian specimen bilateral photoreceptor ocelli relative AP position" ;
        schema:unitText "x / L (anterior fraction)" ;
        schema:value "0.0528" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-planarian-specimen-bilateral-photoreceptor-ocelli-relative-ap-position-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-planarian-specimen-bilateral-photoreceptor-ocelli-relative-ap-position-reference> a schema:PropertyValue ;
        dct:source "Vendored Schmidtea mediterranea dorsal specimen (CC BY 2.5, File:Smediterranea.jpg) & simulated anterior ERK head blastema peak x/L = 0.065" ;
        schema:value "0.065" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-posterior-beta-catenin-suppression-delta-between-wild-type-1h1t-and-8-octanol-gap-junction-blockade-2h0t> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Posterior beta-catenin suppression delta between Wild-Type (1H1T) and 8-Octanol gap-junction blockade (2H0T) = 0.9993 B_WT(L) - B_oct(L)" ;
        dct:description "WT post_B = 1.0000 (1H1T) vs 8-octanol post_B = 0.0007 (2H0T); SCH-28080/forskolin ant_B = 1.0000 (0H2T headless)" ;
        schema:measurementTechnique "Posterior blastema nuclear beta-catenin activity B(L) in wild_type_1H1T vs octanol_pulse_2H0T (eta_oct=0.92)" ;
        schema:name "Posterior beta-catenin suppression delta between Wild-Type (1H1T) and 8-Octanol gap-junction blockade (2H0T)" ;
        schema:unitText "B_WT(L) - B_oct(L)" ;
        schema:value "0.9993" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-posterior-beta-catenin-suppression-delta-between-wild-type-1h1t-and-8-octanol-gap-junction-blockade-2h0t-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-posterior-beta-catenin-suppression-delta-between-wild-type-1h1t-and-8-octanol-gap-junction-blockade-2h0t-reference> a schema:PropertyValue ;
        dct:source "Pietak & Levin (2017) J. R. Soc. Interface 14:20170425 Fig. 4 (posterior cAMP/PKA -> beta-catenin activation vs octanol collapse)" ;
        schema:value "0.72" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-specimen-vs-simulated-1h1t-planarian-dorsoventral-width-profile-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Specimen vs simulated 1H1T planarian dorsoventral width profile correlation r = 0.8809 Pearson r" ;
        dct:description "width profile Pearson r = 0.8809, normalized width RMSE = 0.1152 across 60 AP body segments" ;
        schema:measurementTechnique "Pearson correlation and RMSE between segmented planarian specimen width profile W(x/L) and reconstructed 1H1T morphology contour" ;
        schema:name "Specimen vs simulated 1H1T planarian dorsoventral width profile correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.8809" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-specimen-vs-simulated-1h1t-planarian-dorsoventral-width-profile-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-specimen-vs-simulated-1h1t-planarian-dorsoventral-width-profile-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Vendored planarian dorsal whole-mount morphology (datasets/bioelectric_morphogen_coupling/planarian_ap_polarity_specimen.jpg)" ;
        schema:value "0.9" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-wild-type-nernst-planck-posterior-to-anterior-serotonin-5-ht-boltzmann-concentration-ratio-c-post-c-ant> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type Nernst-Planck posterior-to-anterior serotonin (5-HT) Boltzmann concentration ratio (c_post / c_ant) = 4.6984 c_post / c_ant" ;
        dct:description "PDE c_post/c_ant = 4.6984 vs exact Boltzmann = 4.6992 (9-point sweep Pearson r = 1.000000, RMSE = 0.001109); z=0 control ratio = 1.0000" ;
        schema:measurementTechnique "Scharfetter-Gummel Nernst-Planck gap-junction PDE steady-state ratio c(L)/c(0) at V_ant=-20 mV, V_post=-60 mV, z=+1, V_T=25.85 mV" ;
        schema:name "Wild-type Nernst-Planck posterior-to-anterior serotonin (5-HT) Boltzmann concentration ratio (c_post / c_ant)" ;
        schema:unitText "c_post / c_ant" ;
        schema:value "4.6984" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-wild-type-nernst-planck-posterior-to-anterior-serotonin-5-ht-boltzmann-concentration-ratio-c-post-c-ant-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-measurement-wild-type-nernst-planck-posterior-to-anterior-serotonin-5-ht-boltzmann-concentration-ratio-c-post-c-ant-reference> a schema:PropertyValue ;
        dct:source "Pietak & Levin (2017) J. R. Soc. Interface 14:20170425 Eq. (5) & Fig. 2 Boltzmann equilibrium exp(40 / 25.85) = 4.7002" ;
        schema:value "4.6992" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pietak-bioelectric-morphogen-coupling-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2017-pietak-bioelectric-morphogen-coupling.py L705–L805" ;
        dct:description "6 quantitative MorphoEval measurements with empirical references, std, Pearson r, and RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L705-L805> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1016/j.ydbio.2009.12.012>,
            <https://doi.org/10.1098/rsif.2017.0425>,
            <https://doi.org/10.3389/fbioe.2016.00055> .
    <https://doi.org/10.1016/j.bpj.2017.04.011> dct:date "2017"^^xsd:gYear ;
        dct:title "Long-Term, Stochastic Editing of Regenerative Anatomy via Targeting Endogenous Bioelectric Gradients" .
    <https://doi.org/10.1016/j.ydbio.2009.12.012> dct:date "2010"^^xsd:gYear ;
        dct:title "Long-range neural and gap junction protein-mediated cues control polarity during planarian regeneration" .
    <https://doi.org/10.1098/rsif.2017.0425> dct:date "2017"^^xsd:gYear ;
        dct:title "Bioelectric gene and reaction networks: computational modelling of genetic, biochemical and bioelectrical dynamics in pattern regulation" .
    <https://doi.org/10.3389/fbioe.2016.00055> dct:date "2016"^^xsd:gYear ;
        dct:title "Exploring Instructive Physiological Signaling with the Bioelectric Tissue Simulation Engine" .
}


    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://commons.wikimedia.org/wiki/File:Aurelia-aurita-3.jpg>,
            <https://doi.org/10.1007/s00427-009-0291-y>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/brv.12393> .
    <https://commons.wikimedia.org/wiki/File:Aurelia-aurita-3.jpg> dct:date "2015"^^xsd:gYear ;
        dct:title "Aurelia aurita in a museum in Karlsruhe" .
    <https://doi.org/10.1007/s00427-009-0291-y> dct:date "2009"^^xsd:gYear ;
        dct:title "Development of the rhopalial nervous system in Aurelia sp.1 (Cnidaria, Scyphozoa)" .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1111/brv.12393> dct:date "2018"^^xsd:gYear ;
        dct:title "Evolution and development of scyphozoan jellyfish" .
}


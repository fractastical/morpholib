sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Schnakenberg Turing wavelength at the Aurelia aurita 201 µm ocellus scale faithfully reproduces Aurelia aurita (moon jellyfish), Holocene, 0 Ma morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Aurelia aurita (moon jellyfish), Holocene, 0 Ma specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py; output: docs/media/aurelia_aurita_turing_wavelength_s0_comparison.png; organism: Aurelia aurita (moon jellyfish), Holocene, 0 Ma; environment: n/a; claim_boundary: [reported_in_source: Turing 1952: a reaction-diffusion system can select a finite wavelength. | Schnakenberg 1979: the two-species kinetics implemented here. | Nakanishi, Hartenstein & Jacobs 2009: Aurelia rhopalia develop a pigment-cup ocellus. | Helm 2018: a scyphozoan medusa has eight rhopalia. | Thoma 2015 CC0 photograph of living Aurelia aurita.; reconstructed_in_script: a=0.10, b=0.90, Du=1, Dv=20, gamma=1, chosen so lambda_c equals 0.0002006 m. | Spectral integration, dispersion fit (Pearson r = 0.9999), Dv sweep (r = 0.9978), equal-diffusion ablation drawn on the patterned colour scale. | Bell-body circularity after an 8 px distance threshold, and an angular lobe count on the clipped oral bell.; transfer_boundary: 201 µm is the assigned detail scale (0.0002006 m, log10 = -3.698), not a length measured on the photograph or in the cited papers.; does_not_claim: That eight rhopalia equal the bell circumference divided by 201 µm. | That the Karlsruhe photograph resolves the ocellus wavelength. | That the lobe counter recovered four gonads. It returned 1.]; other sources: Aurelia aurita in a museum in Karlsruhe <https://commons.wikimedia.org/wiki/File:Aurelia-aurita-3.jpg>; phenomenon_size: 176 µm (0.000176 m, log10=-3.754 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 176 µm to 50.7 cm): 176 µm:aurelia-aurita-bioelectric-polarity, 627 µm:aurelia-aurita-vertex-packing, 1.1 cm:aurelia-aurita-turing-wavelength, 2.1 cm:aurelia-aurita-clock-wavefront, 3.7 cm:aurelia-aurita-morphogen-condensation, 4.7 cm:aurelia-aurita-flux-canalization, 5.2 cm:aurelia-aurita-elastic-buckling, 6.1 cm:aurelia-aurita-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1007/s00427-009-0291-y>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/brv.12393> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


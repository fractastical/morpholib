sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at the Aurelia aurita 201 µm ocellus scale — Code-to-model traceability: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The docstring writes the PDE, the Jacobian numbers, k_c, and the 0.0002006 m calibration. Pass 2 comments mark the shared colour scale and the tentacle threshold as the remedies for pass 1. Lean theorem names match the discriminant. There is still no equation number from a page of Schnakenberg 1979." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-code-traceability-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py L1–L28" ;
        dct:description "docstring equations, scale, and the eight-rhopalia caveat" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py#L1-L28> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/delphi10000-aurelia-aurita-turing-wavelength-s0.yaml L12–L61" ;
        dct:description "four laws with Lean loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/math_kg_loops/delphi10000-aurelia-aurita-turing-wavelength-s0.yaml#L12-L61> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent pass 2)" ;
        dct:identifier "grok-4.7" ;

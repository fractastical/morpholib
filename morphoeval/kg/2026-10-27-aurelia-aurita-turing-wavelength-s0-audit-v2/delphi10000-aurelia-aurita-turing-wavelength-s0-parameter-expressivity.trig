sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at the Aurelia aurita 201 µm ocellus scale — Parameter expressivity: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dv from 12 to 48 moves the predicted wavelength from 177 µm to 250 µm. The FFT peak follows it (Pearson r = 0.9978); the Dv=48 point is slightly short of the curve. Du = Dv = 1 gives sigma_max = -0.102 and std = 3e-5, and the figure shows that field as blank. gamma is not swept. This is the within-node comparison: the chronoseries has no other age." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py L284–L321" ;
        dct:description "Dv sweep and equal-diffusion control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py#L284-L321> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "datasets/aurelia_aurita_turing_wavelength_s0/aurelia_aurita_turing_wavelength_s0_metrics.json (generated output)" ;
        dct:description "sweep rows, control std, pass = 2 — datasets/aurelia_aurita_turing_wavelength_s0/aurelia_aurita_turing_wavelength_s0_metrics.json: rendered output of models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, application/json, 9091 B, artifact_sha256 51bd50d2ac15d75169fb38b90a4652493a030f5511581192a2831d2dcbde7214 (sha256 51bd50d2ac15d75169fb38b90a4652493a030f5511581192a2831d2dcbde7214), spec_fingerprint 466a72b70c6deefab849cdaf54ef8ca2bbac24e0ab13e981975c600a6c11b298" .

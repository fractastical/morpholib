    <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Economou et al. (2012) FGF10/FGF7-SHH activator-inhibitor Turing stripe mechanism at mammalian palatal growth zones, coupled to quasi-static epithelial plate ridge elevation — Morphological realism / specimen match: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The comparison PNG keeps the segmented specimen (Panel F, 15 / 16 rugae with detected crests) beside the 2D PDE, and Panel A now overlays the plate ridge crests (white contours) on the WT / coronal split view. The new ridge-mechanics PNG adds a 3D elevation surface of 9 transverse ridges (Panel A), a WT vs coronal elevation map with visibly fragmented ridges below the cut (Panel E), a flat equal-diffusion control at the same colour scale (Panel F) and a direct crest duty-cycle comparison with both specimen shelves (Panel D: 0.423 vs 0.493 / 0.444, sinusoid 0.5). Deductions: the specimen is an adult horse palate photographed at a different scale from the modelled mouse embryo (-4); simulated ridges are straight transverse bars whereas the specimen rugae are curved and the modelled arch phase (L603-604) is barely visible (-3); ridge heights are dimensionless so no height-to-spacing aspect ratio is compared (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-specimen-match-4> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .


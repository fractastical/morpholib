sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-economou-palate-ruguga-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Economou et al. (2012) FGF10/FGF7-SHH activator-inhibitor Turing stripe mechanism at mammalian palatal growth zones, coupled to quasi-static epithelial plate ridge elevation — Source and data traceability: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Five vendored files are SHA-256 pinned (L111-130) and verified fail-closed at every load (L141-167), including the new `palate_ridge_mechanics_reference.json` whose provenance block states plainly that the plate constants are modelling assumptions; the dataset README documents the fifth file and the thin-plate reference; the four primary DOIs are unchanged. Deductions: the Landau & Lifshitz entry has no DOI and its URL could not be verified offline during this run (-3); no measured palatal epithelial stiffness is cited for kappa, T, k_f (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-source-traceability-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2012-economou-palate-ruguga-turing.py L111–L167" ;
        dct:description "EXPECTED_SHA256 with the new mechanics JSON pinned; verify_dataset_integrity and load_mechanics_reference" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2012-economou-palate-ruguga-turing.py#L111-L167> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/palate_ruguga_turing/palate_ridge_mechanics_reference.json L1–L37" ;
        dct:description "Scope statement, governing equation, Lean theorem names, sources and the 'assumption, not measurement' provenance note" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/palate_ruguga_turing/palate_ridge_mechanics_reference.json#L1-L37> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/palate_ruguga_turing/README.md L32–L40" ;
        dct:description "Fifth dataset file documented with equation, parameters, scope and thin-plate reference" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/palate_ruguga_turing/README.md#L32-L40> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 remediation + re-score) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-economou-palate-ruguga-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Economou et al. (2012) FGF10/FGF7-SHH activator-inhibitor Turing stripe mechanism at mammalian palatal growth zones, coupled to quasi-static epithelial plate ridge elevation — Code-to-model traceability: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring adds Law 4 with its two Lean theorem names and an explicit scope note (L58-78); every new function carries a docstring naming the equation it implements and the self-test check that certifies it; the Math KG YAML registers Law 4 with formula, Lean code, variables and three code loci (L81-103 of the YAML). Deductions: the plate constants' comment cites the Kirchhoff formula but not a page/equation number (-3); `measure_ridge_morphometrics` prominence threshold 0.15 * amplitude and the `distance=8` crest separation (L492) are uncited heuristics (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-code-traceability-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2012-economou-palate-ruguga-turing.py L58–L78" ;
        dct:description "Law 4 docstring with Lean theorem names and honest scope note" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2012-economou-palate-ruguga-turing.py#L58-L78> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/economou-palate-ruguga-turing.yaml L81–L103" ;
        dct:description "Law 4 registered with formula, lean_locus, lean_code, variables, role and code_locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/economou-palate-ruguga-turing.yaml#L81-L103> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "2012-economou-palate-ruguga-turing.py L383–L388" ;
        dct:description "Plate defaults with provenance pointer to the mechanics JSON" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2012-economou-palate-ruguga-turing.py#L383-L388> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 remediation + re-score) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


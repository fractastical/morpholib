    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Epithelial Ridge Turing Morphogenesis (Mesenchymal FGF Activator + Epithelial SHH Inhibitor at Ruga-8 Growth Zone)" ;
    pk1:leanDeclaration "MathOfBiology.Loop_008.plate_stiffness" ;

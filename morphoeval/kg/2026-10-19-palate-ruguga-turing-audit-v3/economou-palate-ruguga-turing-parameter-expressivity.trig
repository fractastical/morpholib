sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-economou-palate-ruguga-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Economou et al. (2012) FGF10/FGF7-SHH activator-inhibitor Turing stripe mechanism at mammalian palatal growth zones, coupled to quasi-static epithelial plate ridge elevation — Parameter expressivity: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "New sweeps behave monotonically and are measured: ridge amplitude vs kappa over 6 values and vs k_f over 4 values both give Spearman rho = -1.00 with crest phase offset < 0.023 lambda throughout; the ridge count stays 9 for kappa <= 0.1 and merges to 7 at kappa >= 0.2 (an honest limit of wavelength transfer, disclosed in the JSON and the measurement note); the chi_m two-way sweep (0, 0.1, 0.2, 0.3) keeps 9 rugae with non-decreasing ridge amplitude (0.155 -> 0.188). CLI exposes --kappa, --k-found, --chi-mech plus the existing reaction / diffusion / growth flags. Deductions: the mechanics flags only act on the mechanics figure, the comparison PNG always uses defaults (L1726-1734) (-3); the reaction parameters a_12 etc. do not continuously control the perturbation morphologies because those are initial-condition templates (L606-633) (-5); T and beta are fixed, not swept (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2012-economou-palate-ruguga-turing.py L1726–L1734: mech_overrides are routed only to render_ridge_mechanics_figure, not to the comparison figure <https://github.com/fractastical/morpholib/blob/d58a084/2012-economou-palate-ruguga-turing.py#L1726-L1734>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-parameter-expressivity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2012-economou-palate-ruguga-turing.py L740–L810" ;
        dct:description "evaluate_ridge_mechanics_sweeps: kappa, k_f (one-way) and chi_m (RD re-run) sweeps with Spearman statistics and transfer gain" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2012-economou-palate-ruguga-turing.py#L740-L810> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "datasets/palate_ruguga_turing/palate_ridge_mechanics_reference.json L38–L52" ;
        dct:description "Sweep grids and expected monotone behaviour, including the kappa >= 0.2 merge" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/palate_ruguga_turing/palate_ridge_mechanics_reference.json#L38-L52> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2012-economou-palate-ruguga-turing.py L1697–L1700" ;
        dct:description "--kappa, --k-found, --chi-mech, --skip-mechanics-figure CLI flags" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2012-economou-palate-ruguga-turing.py#L1697-L1700> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 remediation + re-score) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


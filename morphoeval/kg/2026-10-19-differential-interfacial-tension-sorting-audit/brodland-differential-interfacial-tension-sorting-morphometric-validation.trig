sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-brodland-differential-interfacial-tension-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Brodland (2002) / Krieg et al. (2008) / Maître et al. (2012) Differential Interfacial Tension Hypothesis (DITH) and zebrafish germ-layer cortical tension sorting — Morphometric validation: 53/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Computes 3 basic metrics in `measure_morphoeval()` (`dith_wildtype_gamma_EM`, `wildtype_radial_core_shell_separation`, and `blebbistatin_control_radial_separation`, L201-225), but does not quantify `caMLCK` sorting reversal, 3-germ-layer radial stratification (`r_E > r_M > r_N`), Young-Dupré doublet contact radius `r_c/R = sin(theta)`, or empirical GFP/RFP specimen profile concordance." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2002-brodland-differential-interfacial-tension-sorting.py L201–L225: Only 3 basic measurements without caMLCK reversal, Young-Dupré contact angle, or specimen correlation <https://github.com/fractastical/morpholib/blob/b9976f8/2002-brodland-differential-interfacial-tension-sorting.py#L201-L225>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-blebbistatin-control-radial-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-dith-wildtype-gamma-em>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-wildtype-radial-core-shell-separation> ;
        pk:hasScore "0.53"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-blebbistatin-control-radial-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "blebbistatin_control_radial_separation = 0.0078 normalized_radius" ;
        schema:measurementTechnique "Null radial separation |r_E - r_M|/R_agg under Blebbistatin Myosin-II inhibition" ;
        schema:name "blebbistatin_control_radial_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.0078" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-blebbistatin-control-radial-separation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-blebbistatin-control-radial-separation-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-dith-wildtype-gamma-em> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dith_wildtype_gamma_EM = 30.0 pN/um" ;
        schema:measurementTechnique "Brodland (2002) Eq. 1 heterotypic interfacial tension gamma_EM = beta_E + beta_M - omega_EM" ;
        schema:name "dith_wildtype_gamma_EM" ;
        schema:unitText "pN/um" ;
        schema:value "30.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-dith-wildtype-gamma-em-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-dith-wildtype-gamma-em-reference> a schema:PropertyValue ;
        schema:value "30.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-wildtype-radial-core-shell-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wildtype_radial_core_shell_separation = 0.3805 normalized_radius" ;
        schema:measurementTechnique "Normalized radial separation (r_E - r_M)/R_agg in wild-type germ-layer sorting" ;
        schema:name "wildtype_radial_core_shell_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.3805" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-wildtype-radial-core-shell-separation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-wildtype-radial-core-shell-separation-reference> a schema:PropertyValue ;
        schema:value "0.3" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/ncb1705>,
            <https://doi.org/10.1038/s41467-017-00146-x>,
            <https://doi.org/10.1073/pnas.0704252104>,
            <https://doi.org/10.1115/1.1449491>,
            <https://doi.org/10.1126/science.1225399> .
    <https://doi.org/10.1038/ncb1705> dct:date "2008"^^xsd:gYear ;
        dct:title "Tensile forces govern germ-layer organization in zebrafish" .
    <https://doi.org/10.1038/s41467-017-00146-x> dct:date "2017"^^xsd:gYear ;
        dct:title "Sorting at embryonic boundaries requires high heterotypic interfacial tension" .
    <https://doi.org/10.1073/pnas.0704252104> dct:date "2007"^^xsd:gYear ;
        dct:title "Cell adhesion and cortex contractility determine cell patterning in the Drosophila retina" .
    <https://doi.org/10.1115/1.1449491> dct:date "2002"^^xsd:gYear ;
        dct:title "The Differential Interfacial Tension Hypothesis (DITH): A comprehensive theory for the self-rearrangement of embryonic cells and tissues" .
    <https://doi.org/10.1126/science.1225399> dct:date "2012"^^xsd:gYear ;
        dct:title "Adhesion functions in cell sorting by mechanically coupling the cortices of adhering cells" .
}


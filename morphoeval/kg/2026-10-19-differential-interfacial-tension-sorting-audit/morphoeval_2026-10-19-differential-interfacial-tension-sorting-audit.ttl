<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/brodland-differential-interfacial-tension-sorting-1>,
        <https://w3id.org/probknow/resource/math-law/brodland-differential-interfacial-tension-sorting-2>,
        <https://w3id.org/probknow/resource/math-law/brodland-differential-interfacial-tension-sorting-3> .

<https://w3id.org/probknow/resource/math-law/brodland-differential-interfacial-tension-sorting-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Brodland (2002) Differential Interfacial Tension Law & Blebbistatin Equal-Cortex Null Identity" ;
    dct:description "Decomposes macroscopic cell-cell interfacial tension into actomyosin cortical tension minus cadherin adhesion and proves that Myosin-II inhibition zeroes the sorting force | Variables: β_α^{cort}, β_β^{cort}: actomyosin cell-cortex tensions; ω_{αβ}^{adh}: cadherin adhesion energy; γ_{αβ}: effective cell-cell interfacial tension" ;
    dct:source "Brodland (2002) J. Biomech. Eng. 124(2):188-197 Eqs. (1)-(4); Krieg et al. (2008) Nature Cell Biology 10(4):429-436 Fig. 3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b9976f8/2002-brodland-differential-interfacial-tension-sorting.py#L96-L154>,
        <https://github.com/fractastical/morpholib/blob/b9976f8/morphoeval/lean/loops/Loop_044_differential_interfacial_tension_sorting.lean#L17-L40> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def dith_gamma_ab (beta_a beta_b omega_ab : Int) : Int :=
  beta_a + beta_b - omega_ab
theorem dith_blebbistatin_equal_cortex_null_sorting (beta : Int) :
    dith_gamma_ab beta beta (2 * beta) = 0 ∧ dith_spreading_diff beta beta = 0"""^^pk:lean4 ;
    skos:notation "γ_{αβ} = β_α^{cort} + β_β^{cort} - ω_{αβ}^{adh},  γ_{α0} = β_α^{cort};  β_E = β_M = β ⇒ γ_{M0} - γ_{E0} = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/ncb1705>,
        <https://doi.org/10.1038/s41467-017-00146-x>,
        <https://doi.org/10.1073/pnas.0704252104>,
        <https://doi.org/10.1115/1.1449491>,
        <https://doi.org/10.1126/science.1225399> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Differential Interfacial Tension Hypothesis (DITH) & Young-Dupré Cell-Doublet Mechanics" ;
    pk:leanDeclaration "MathOfBiology.Loop_044.dith_gamma_ab" ;
    pk:leanTheorem "MathOfBiology.Loop_044.dith_blebbistatin_equal_cortex_null_sorting" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/brodland-differential-interfacial-tension-sorting-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Krieg et al. (2008) Zebrafish Germ-Layer Cortical Tension Hierarchy & caMLCK Sorting Reversal" ;
    dct:description "Predicts concentric germ-layer engulfment in wild-type zebrafish gastrulae and sorting reversal when ectodermal cortex tension is elevated via caMLCK | Variables: β_E, β_M, β_N: AFM cortical tensions of zebrafish ectoderm, mesoderm, and endoderm progenitors (pN/μm); γ_{EM}: ectoderm-mesoderm interfacial tension" ;
    dct:source "Krieg et al. (2008) Nature Cell Biology 10(4):429-436 Figs. 1-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b9976f8/2002-brodland-differential-interfacial-tension-sorting.py#L220-L490>,
        <https://github.com/fractastical/morpholib/blob/b9976f8/morphoeval/lean/loops/Loop_044_differential_interfacial_tension_sorting.lean#L42-L63> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """theorem krieg_2008_germ_layer_hierarchy_and_camlc_reversal :
    (50 < 95 ∧ 95 < 130) ∧
    dith_gamma_ab 50 95 115 = 30 ∧
    dith_spreading_diff 50 95 = 45 ∧
    (0 < dith_gamma_ab 50 95 115 ∧ dith_gamma_ab 50 95 115 < dith_spreading_diff 50 95) ∧
    dith_spreading_diff 145 95 = -50 ∧
    (0 < dith_gamma_ab 145 95 210 ∧ dith_gamma_ab 145 95 210 < dith_spreading_diff 95 145)"""^^pk:lean4 ;
    skos:notation "Wild-type: β_E (50) < β_M (95) < β_N (130 pN/μm), 0 < γ_{EM} < β_M - β_E;  caMLCK ectoderm: β_{E+caMLCK} (145) > β_M (95) ⇒ inverted engulfment" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/ncb1705>,
        <https://doi.org/10.1038/s41467-017-00146-x>,
        <https://doi.org/10.1073/pnas.0704252104>,
        <https://doi.org/10.1115/1.1449491>,
        <https://doi.org/10.1126/science.1225399> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Differential Interfacial Tension Hypothesis (DITH) & Young-Dupré Cell-Doublet Mechanics" ;
    pk:leanDeclaration "MathOfBiology.Loop_044.dith_spreading_diff" ;
    pk:leanTheorem "MathOfBiology.Loop_044.krieg_2008_germ_layer_hierarchy_and_camlc_reversal" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/brodland-differential-interfacial-tension-sorting-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Maître et al. (2012) Young-Dupré Cell-Doublet Contact Angle & Normalized Contact Radius Law" ;
    dct:description "Determines the equilibrium geometry of adhering zebrafish progenitor doublets from the ratio of cell-cell interfacial tension to cell-medium cortical tension | Variables: θ: equilibrium cell-doublet contact half-angle; γ_{cc}: cell-cell interfacial tension; γ_{cm}: cell-medium cortical tension; r_c/R_{cell}: normalized contact radius" ;
    dct:source "Maître et al. (2012) Science 338(6104):253-256 Eq. (1) & Figs. 1-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b9976f8/2002-brodland-differential-interfacial-tension-sorting.py#L157-L217>,
        <https://github.com/fractastical/morpholib/blob/b9976f8/morphoeval/lean/loops/Loop_044_differential_interfacial_tension_sorting.lean#L65-L89> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def young_dupre_num (gamma_cm gamma_cc : Int) : Int :=
  2 * gamma_cm - gamma_cc
theorem maitre_2012_young_dupre_contact_bounds (gamma_cm gamma_cc dgamma : Int) :
    young_dupre_num gamma_cm (2 * gamma_cm) = 0 ∧
    young_dupre_num gamma_cm 0 = 2 * gamma_cm ∧
    young_dupre_num gamma_cm (gamma_cc + dgamma) = young_dupre_num gamma_cm gamma_cc - dgamma"""^^pk:lean4 ;
    skos:notation "cos(θ) = 1 - γ_{cc} / (2 γ_{cm}),  r_c / R_{cell} = sin(θ) = √(1 - cos^2(θ))" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/ncb1705>,
        <https://doi.org/10.1038/s41467-017-00146-x>,
        <https://doi.org/10.1073/pnas.0704252104>,
        <https://doi.org/10.1115/1.1449491>,
        <https://doi.org/10.1126/science.1225399> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Differential Interfacial Tension Hypothesis (DITH) & Young-Dupré Cell-Doublet Mechanics" ;
    pk:leanDeclaration "MathOfBiology.Loop_044.young_dupre_num" ;
    pk:leanTheorem "MathOfBiology.Loop_044.maitre_2012_young_dupre_contact_bounds" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-brodland-differential-interfacial-tension-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Brodland (2002) / Krieg et al. (2008) / Maître et al. (2012) Differential Interfacial Tension Hypothesis (DITH) and zebrafish germ-layer cortical tension sorting — Morphological realism / specimen match: 35/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Although `datasets/differential_interfacial_tension_sorting/germ_layer_doublet_specimen.jpg` is vendored on disk, the v1 script never loads, verifies, or segments the zebrafish blastoderm cross-transplantation GFP/RFP fluorescence panels (`render_outputs_v1`, L166-198)." ;

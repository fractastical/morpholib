        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2002-brodland-differential-interfacial-tension-sorting.py L166–L198: render_outputs_v1 renders 3 synthetic panels without loading or segmenting germ_layer_doublet_specimen.jpg <https://github.com/fractastical/morpholib/blob/b9976f8/2002-brodland-differential-interfacial-tension-sorting.py#L166-L198>",
            "docs/media/differential_interfacial_tension_sorting_comparison.png (generated output, not in repo): 3-panel synthetic figure lacking zebrafish blastoderm GFP/RFP segmentation — docs/media/differential_interfacial_tension_sorting_comparison.png: rendered output of 2002-brodland-differential-interfacial-tension-sorting.py at b9976f8, image/png, 45458 B, 1680×560 px, artifact_sha256 ae4b7b1f31d4405893da8118cf8a75b83311d09095b152801895b9f7cb84f532 (sha256 ae4b7b1f31d4405893da8118cf8a75b83311d09095b152801895b9f7cb84f532), spec_fingerprint 04e6692e5c44347cdef3ff055c0cf966e6a50c079cad3d06d965f070f3683587" ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


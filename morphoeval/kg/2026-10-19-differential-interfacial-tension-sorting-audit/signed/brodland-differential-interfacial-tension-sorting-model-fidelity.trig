sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-brodland-differential-interfacial-tension-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Brodland (2002) / Krieg et al. (2008) / Maître et al. (2012) Differential Interfacial Tension Hypothesis (DITH) and zebrafish germ-layer cortical tension sorting — Model fidelity to source: 66/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements Brodland's (2002) Eq. (1) DITH interfacial tension formula (`compute_dith_tensions`, L25-63) and simulates wild-type ectoderm/mesoderm engulfment vs Blebbistatin Myosin-II inhibition (`simulate_dith_sorting_v1`, L66-163). However, v1 omits Krieg et al.'s (2008) `caMLCK` cortical stiffening sorting reversal (`beta_E=145 > beta_M=95`), high-HIT partial doublet lens formation, 3-germ-layer (ectoderm/mesoderm/endoderm) concentric sorting, Maître et al.'s (2012) Young-Dupré cell-doublet contact angle law, and microscopic single-spin boundary fluctuations." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2002-brodland-differential-interfacial-tension-sorting.py L66–L163: v1 simulates only 2 regimes without caMLCK sorting reversal, 3-germ-layer sorting, or Young-Dupré cell-doublet contact mechanics <https://github.com/fractastical/morpholib/blob/b9976f8/2002-brodland-differential-interfacial-tension-sorting.py#L66-L163>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-model-fidelity-1> ;
        pk:hasScore "0.66"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2002-brodland-differential-interfacial-tension-sorting.py L25–L63" ;
        dcterms:description "Brodland (2002) Eq. 1 DITH interfacial tension relation gamma_EM = beta_E + beta_M - omega_EM" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/2002-brodland-differential-interfacial-tension-sorting.py#L25-L63> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


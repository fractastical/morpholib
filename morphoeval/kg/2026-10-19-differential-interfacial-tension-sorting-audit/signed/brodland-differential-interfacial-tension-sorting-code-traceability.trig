        dcterms:title "Tensile forces govern germ-layer organization in zebrafish" .

    <https://doi.org/10.1038/s41467-017-00146-x> dcterms:date "2017"^^xsd:gYear ;
        dcterms:title "Sorting at embryonic boundaries requires high heterotypic interfacial tension" .


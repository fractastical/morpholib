sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-brodland-differential-interfacial-tension-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Brodland (2002) / Krieg et al. (2008) / Maître et al. (2012) Differential Interfacial Tension Hypothesis (DITH) and zebrafish germ-layer cortical tension sorting — Code-to-model traceability: 69/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Functions correspond to DITH tension decomposition and lattice sorting, and `morphoeval/lean/loops/Loop_044_differential_interfacial_tension_sorting.lean` proves 3 theorems, but v1 docstrings lack equation-by-equation mappings to Brodland (2002) Eqs. 1-6, Krieg et al. (2008) Figs. 1-4, and Maître et al. (2012) Eq. 1." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2002-brodland-differential-interfacial-tension-sorting.py L25–L163: Baseline functions lack equation-number mappings to Brodland (2002), Krieg et al. (2008), and Maître et al. (2012) <https://github.com/fractastical/morpholib/blob/b9976f8/2002-brodland-differential-interfacial-tension-sorting.py#L25-L163>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-code-traceability-1> ;
        pk:hasScore "0.69"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_044_differential_interfacial_tension_sorting.lean L1–L89" ;
        dcterms:description "3 machine-checked Lean 4 theorems for DITH Blebbistatin null identity, Krieg 2008 hierarchy & caMLCK reversal, and Maître 2012 Young-Dupré bounds" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/morphoeval/lean/loops/Loop_044_differential_interfacial_tension_sorting.lean#L1-L89> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


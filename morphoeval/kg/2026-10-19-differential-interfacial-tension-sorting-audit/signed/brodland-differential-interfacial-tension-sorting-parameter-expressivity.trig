sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-brodland-differential-interfacial-tension-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-parameter-expressivity> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Brodland (2002) / Krieg et al. (2008) / Maître et al. (2012) Differential Interfacial Tension Hypothesis (DITH) and zebrafish germ-layer cortical tension sorting — Parameter expressivity: 46/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates only 2 hardcoded parameter points (`beta_E=50, beta_M=95` vs `beta_E=beta_M=25`) without a continuous sweep across ectodermal cortical tension `beta_E` spanning the sorting inversion threshold `beta_E = beta_M = 95 pN/um`, without a Young-Dupré doublet contact angle curve across `gamma_cc/(2*gamma_cm)`, and without CLI parameter flags (`main`, L229-238)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2002-brodland-differential-interfacial-tension-sorting.py L169–L170: Only 2 hardcoded parameter points evaluated in render_outputs_v1 <https://github.com/fractastical/morpholib/blob/b9976f8/2002-brodland-differential-interfacial-tension-sorting.py#L169-L170>",
            "2002-brodland-differential-interfacial-tension-sorting.py L229–L238: CLI parser only accepts --self-test <https://github.com/fractastical/morpholib/blob/b9976f8/2002-brodland-differential-interfacial-tension-sorting.py#L229-L238>" ;
        pk:hasScore "0.46"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


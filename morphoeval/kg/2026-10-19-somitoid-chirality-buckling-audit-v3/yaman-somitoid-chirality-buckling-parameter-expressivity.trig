sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yaman-somitoid-chirality-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Yamanaka et al. (2023), Miao et al. (2023) & Adhyapok et al. (2021) epithelial somite rosette vertex mechanics, 3D polyhedral shell lumen pressurization and live HES7 clock-wavefront coupled mesenchymal-to-epithelial transition (MET) model — Parameter expressivity: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The 6-regime series and 28x28 (gamma_ap, Matrigel %) phase diagram remain (L750-822, L1127-1164). Pass 3 adds a 25-point lumen-pressure sweep with monotone rho_3D(P) and a located rupture pressure, checked at 3 pressures against the discrete shell (L630-685, Panel H), a stage axis (S0 -> S-III) along which the live gamma_ap ramp visibly tightens the rosette (L1065-1112, clock PNG panel d), and coupled Y-27632 and Eph/ephrin knockdown controls that leave the boundary count unchanged while abolishing MET or clefting (L2226-2236). Deductions: the clock constants v, tau_ROCK, tau_Eph, tau_RIPPLY2 and the shell constants N_3D, V_0, K_V are fixed (L148-159) and never swept, so the sensitivity of S, P_crit and the maturation time to them is unshown (-5); the only period control is the calibration target (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2021-yaman-somitoid-chirality-buckling.py L148–L159: Fixed Pass 3 constants (N_3D, V_0, K_V, v, tau_ROCK, tau_Eph, tau_RIPPLY2) with no sweep <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L148-L159>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-parameter-expressivity-4> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L630–L685" ;
        dct:description "Lumen-pressure sweep: monotone rho_3D(P), bisection for P_crit, discrete cross-check at P = 0 / 0.04 / 0.08" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L630-L685> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L1065–L1112" ;
        dct:description "Stage-resolved coupling: live gamma_ap / gamma_het of each complete segment -> 2D ratio, 3D ratio, cleft score" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L1065-L1112> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/somitoid_chirality_buckling_clock_coupling.png (generated output)" ;
        dct:description "Clock-coupling figure: calibrated oscillator (a), gamma_ap(x,t) kymograph with boundaries and gamma_het ramps (b), MESP2/EphA4/ephrinB2 state map (c), stage-resolved WT / Y-27632 / Eph-KD ratios and cleft scores (d) — docs/media/somitoid_chirality_buckling_clock_coupling.png: rendered output of 2021-yaman-somitoid-chirality-buckling.py at d58a084, image/png, 436466 B, 2086×1433 px, artifact_sha256 dc46f67064785d5f105f30cde1b9e094c9894b2cc72c5b476ae6a76ac062e3a6 (sha256 dc46f67064785d5f105f30cde1b9e094c9894b2cc72c5b476ae6a76ac062e3a6), spec_fingerprint c1110cb9038d37a536b327b4b7e47002f40a93acd13d457cf0444c105660f6c4" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L750–L822" ;
        dct:description "6-regime perturbation evaluator (unchanged)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L750-L822> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


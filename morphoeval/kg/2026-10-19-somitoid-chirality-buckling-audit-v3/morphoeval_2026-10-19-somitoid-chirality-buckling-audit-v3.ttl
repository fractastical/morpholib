    pk1:evidenceAgainst "2021-yaman-somitoid-chirality-buckling.py L1359–L1383: P_crit referenced to the Laplace bound and the HES7 period referenced to its own calibration target (circular) <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L1359-L1383>" ;
    pk1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-3d-polyhedral-shell-wild-type-somitecoel-lumen-ratio-rho-3d-r-in-r-out>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-3d-shell-somitecoel-rupture-saddle-node-lumen-pressure-p-crit>,

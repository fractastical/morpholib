sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yaman-somitoid-chirality-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Yamanaka et al. (2023), Miao et al. (2023) & Adhyapok et al. (2021) epithelial somite rosette vertex mechanics, 3D polyhedral shell lumen pressurization and live HES7 clock-wavefront coupled mesenchymal-to-epithelial transition (MET) model — Reproducibility package: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Deterministic throughout: Fibonacci-sphere seeds and explicit-Euler DDE need no RNG; the 2D and 3D relaxations use fixed seeds and both are asserted bitwise two-run identical (L2167-2172, L2193-2197); two consecutive default renders of the PNG, clock PNG and GIF were byte-identical (SHA-256 8d411247..., dc46f670..., 5d678180...). `--self-test` runs 6 check groups covering SHA-256 integrity, both solvers, the pressure sweep, the scutoid audit, period calibration, S = v T, MESP2 half-segments, the AP maturation gradient and the two coupled controls, then all 10 measurements, in ~5.6 s; the default render takes ~7 s (L2154-2266). Deductions: no requirements lock file pins this script's environment (versions are recorded only in this audit) (-4); the self-test tolerance for the 3D WT ratio vs 0.305 is 0.03, wide enough to pass a 6% miss (L2200) (-2); matplotlib writes a font cache outside the repo unless MPLCONFIGDIR is set (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2021-yaman-somitoid-chirality-buckling.py L2200–L2200: 3D WT ratio tolerance |rho_3D - 0.305| < 0.03 passes the 0.323 result <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L2200-L2200>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-repro-package-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L2154–L2245" ;
        dct:description "Self-test: 6 check groups incl. bitwise determinism of 2D/3D solvers and clock, Law 4/5 numerical checks, 10 finite measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L2154-L2245> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L2247–L2266" ;
        dct:description "CLI: --self-test or default render of PNG, clock PNG and GIF from one compute_pass3_models() call" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L2247-L2266> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/somitoid_chirality_buckling_growth.gif (generated output)" ;
        dct:description "20-frame 3-panel GIF driven by the live clock (kymograph, WT rosette with live gamma_ap, Y-27632 control) — docs/media/somitoid_chirality_buckling_growth.gif: rendered output of 2021-yaman-somitoid-chirality-buckling.py at d58a084, image/gif, 666663 B, 1197×408 px, 20 frames, artifact_sha256 5d678180bdaf33722203a703b9ab70ce0ab09e9787de9863dc130539e53464fb (sha256 5d678180bdaf33722203a703b9ab70ce0ab09e9787de9863dc130539e53464fb), spec_fingerprint c1110cb9038d37a536b327b4b7e47002f40a93acd13d457cf0444c105660f6c4" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


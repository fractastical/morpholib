sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yaman-somitoid-chirality-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Yamanaka et al. (2023), Miao et al. (2023) & Adhyapok et al. (2021) epithelial somite rosette vertex mechanics, 3D polyhedral shell lumen pressurization and live HES7 clock-wavefront coupled mesenchymal-to-epithelial transition (MET) model — Source and data traceability: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Nine primary sources with DOIs in the docstring (L1-40), the reference JSON `sources[]`, the dataset README and `paper_citations.bib` (five added in Pass 3: Lewis 2003, Diaz-Cuadros 2020, Matsuda 2020, Cooke & Zeeman 1976, Gomez-Galvez 2018). The reference JSON is now SHA-256 pinned and verified fail-closed at every run (L145, L180-186) alongside the specimen and scout manifest; the new `shell_3d_governing_equations` and `hes7_clock_wavefront` blocks record every Pass 3 constant with a `parameter_status` stating which are model choices. Deductions: the Lewis kernel values are quoted from memory of his Table rather than from a vendored digitisation (-3); the human 5 h period is cited to two papers without figure/page pinpoints (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-source-traceability-4> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L145–L187" ;
        dct:description "Reference JSON SHA-256 pin and fail-closed verification of all three dataset files" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L145-L187> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L1–L36" ;
        dct:description "Nine sources with DOIs including the five Pass 3 additions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L1-L36> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/somitoid_chirality_buckling/somitoid_chirality_buckling_reference.json L116–L165" ;
        dct:description "Pass 3 shell_3d_governing_equations and hes7_clock_wavefront blocks with parameter provenance / status" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/somitoid_chirality_buckling/somitoid_chirality_buckling_reference.json#L116-L165> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/somitoid_chirality_buckling/README.md L35–L65" ;
        dct:description "Laws 4-5, pinned digests, and a Known Discrepancies section" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/somitoid_chirality_buckling/README.md#L35-L65> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .

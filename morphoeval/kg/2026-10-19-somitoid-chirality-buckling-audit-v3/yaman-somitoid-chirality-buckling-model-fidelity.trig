sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yaman-somitoid-chirality-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Yamanaka et al. (2023), Miao et al. (2023) & Adhyapok et al. (2021) epithelial somite rosette vertex mechanics, 3D polyhedral shell lumen pressurization and live HES7 clock-wavefront coupled mesenchymal-to-epithelial transition (MET) model — Model fidelity to source: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The 2D vertex energy and its polygon/continuum equilibrium laws (L200-379), the Eph/ephrin cleft barrier (L722-748) and the Y-27632 collapse are unchanged and faithful. Pass 3 adds a genuine 3D polyhedral shell energy with volume elasticity, three face-tension classes and a -P V_lumen term (L535-628) whose radial balance is derived (L478-533) and reproduced numerically to 1e-4, and a Lewis (2003) delayed oscillator with his published her1 kernel (a=4.5, b=c=0.23, k=33, p0=40, T_m=12, T_p=2.8 min) uniformly time-scaled (L831-883), the Cooke-Zeeman arrest law and an ephrinB2-|EphA4+ boundary rule consistent with Adhyapok (2021). Deductions: the shell cells are radial frusta with 2 DOF on a fixed Voronoi tessellation (L564-581, lateral faces L570-572), so the \"polyhedral scutoid shell\" cannot form scutoids or T1s and the audit at L687-714 reports 0 by construction (-4); the clock is synchronous (one DDE state copied to 64 cells, L950-971) so kinematic HES7 waves, Notch coupling and the posterior-anterior period gradient of axioloids are absent (-3); MESP2 / RIPPLY2 are a median-threshold and fixed-delay rule set (L975-987), not the TBX6/MESP2/RIPPLY2 network, and the tension \"coupling\" is an imposed exponential ramp of time-since-arrest (L989-1002), one-way (-3); the 3D shell is run with the 2D-fitted tensions and lands at rho_3D = 0.323 rather than 0.305 with no re-fit (-2); credited +2 for the five machine-checked Lean theorems covering every law." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-7> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L200–L379" ;
        dct:description "2D analytical wedge equilibrium and 32-vertex L-BFGS-B rosette relaxation (unchanged from Pass 2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L200-L379> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L478–L533" ;
        dct:description "Law 4 closed-form 3D radial balance rho_3D = (Lambda - 4 pi gamma_ap + 2 pi P R_in)/(Lambda + 4 pi gamma_bas), pressure balance and Laplace bound" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L478-L533> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L535–L628" ;
        dct:description "Discrete 3D polyhedral shell energy (volume elasticity, apical/basal/lateral face tensions, -P V_lumen) over 2 N_3D radii; radial frusta only, no tangential DOF" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L535-L628> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L687–L714" ;
        dct:description "Scutoid audit reports 0 scutoids by construction and states the Gomez-Galvez spherical limit instead of asserting scutoids" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L687-L714> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L831–L883" ;
        dct:description "Lewis (2003) her1 kernel with published parameters, uniformly time-scaled to the human period" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L831-L883> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-6> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L950–L1002" ;
        dct:description "Synchronous DDE in 64 cells (loop L964-971), wavefront arrest, median-threshold MESP2, fixed-delay RIPPLY2 boundary fixation, imposed exponential gamma_ap / gamma_het ramps (one-way coupling)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L950-L1002> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-7> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_029_somitoid_chirality_buckling.lean L122–L212" ;
        dct:description "Pass 3 Theorems 4 and 5 (shell lumen pressurization; clock-wavefront arrest tension gradient), 0 sorrys, verified with lean 4.35.0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_029_somitoid_chirality_buckling.lean#L122-L212> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


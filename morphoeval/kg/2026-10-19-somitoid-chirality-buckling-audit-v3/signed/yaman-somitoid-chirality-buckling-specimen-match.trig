sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yaman-somitoid-chirality-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Yamanaka et al. (2023), Miao et al. (2023) & Adhyapok et al. (2021) epithelial somite rosette vertex mechanics, 3D polyhedral shell lumen pressurization and live HES7 clock-wavefront coupled mesenchymal-to-epithelial transition (MET) model — Morphological realism / specimen match: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Panel E still overlays the SHA-256-pinned CC BY 4.0 dorsal somite SEM with detected rosette centres and clefts on both rows (L1223-1275), Panel A/G now show the 2D wedge rosette and a 3D cut-away shell whose constricted red apical faces around a dark somitecoel read as an epithelial somite rosette in cross-section, and the GIF shows the rosette tightening as the live gamma_ap ramps. Deductions: the vendored `rosette_metrics` (lower row 8 somites, spacing 47.14 px, CV 0.2010) contradict the script's own segmentation (lower row 10 peaks, 45.375 px, CV 0.2391), the v2 audit quoted the JSON value, and neither has been reconciled, only disclosed (L1441-1446, reference JSON L78 provenance_note_pass3) (-6); no image from Yamanaka (2023) or Miao (2023) is compared side by side, so the 3D shell and the stage series are matched to a single number (0.305) rather than to the authors' somitoid sections (-5); the SEM is a vertebrate dorsal view of in-vivo somites rather than an in-vitro somitoid, as in Pass 2 (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/somitoid_chirality_buckling/somitoid_chirality_buckling_reference.json L71–L80: Scout rosette_metrics (lower 8, 47.1429 px, CV 0.2010) with the Pass 3 provenance note recording the unreconciled disagreement <https://github.com/fractastical/morpholib/blob/d58a084/datasets/somitoid_chirality_buckling/somitoid_chirality_buckling_reference.json#L71-L80>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-specimen-match-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L1223–L1275" ;
        dcterms:description "Bilateral rosette / cleft segmentation on somitoid_rosette_specimen.jpg; measured lower row n=10, CV 0.2391" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L1223-L1275> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L1503–L1542" ;
        dcterms:description "3D shell cut-away rendering: apical faces, lateral rim and basal faces depth-sorted so the somitecoel is visible" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L1503-L1542> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/somitoid_chirality_buckling_comparison.png (generated output)" ;
        dcterms:description "9-panel figure: specimen overlay (E), 2D rosettes (A), 3D cut-away (G), pressure sweep (H), clock kymograph (I) — docs/media/somitoid_chirality_buckling_comparison.png: rendered output of 2021-yaman-somitoid-chirality-buckling.py at d58a084, image/png, 1160191 B, 2505×2298 px, artifact_sha256 8d4112473f06311e45765334cca5fb587c718ffbf4fb1a76b844ea598e7313e6 (sha256 8d4112473f06311e45765334cca5fb587c718ffbf4fb1a76b844ea598e7313e6), spec_fingerprint c1110cb9038d37a536b327b4b7e47002f40a93acd13d457cf0444c105660f6c4" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


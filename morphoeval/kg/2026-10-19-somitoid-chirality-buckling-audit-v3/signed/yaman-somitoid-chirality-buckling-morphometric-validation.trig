sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yaman-somitoid-chirality-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-3d-polyhedral-shell-wild-type-somitecoel-lumen-ratio-rho-3d-r-in-r-out> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D polyhedral shell wild-type somitecoel lumen ratio rho_3D = R_in / R_out = 0.323 dimensionless ratio" ;
        dcterms:description "3D analytic Law 4 rho = 0.3229 (|discrete - analytic| = 1.2e-04); Y-27632 3D shell rho = 0.7099; apical/basal area ratio = 0.1043; cell volume CV = 3.9e-05; scutoid fraction = 0.0 (radial frusta, Gomez-Galvez 2018 spherical limit)" ;
        schema:measurementTechnique "closed 3D shell of N_3D=96 radial frustum cells (spherical-Voronoi faces: 48 hex / 30 pent / 18 hept, 282 lateral faces), L-BFGS-B relaxation of 2*N_3D radii with K_V=0.05, V_0=700.0 um^3, gamma_ap=1.65, gamma_bas=0.45, P=0; R_in*=8.22 um, R_out*=25.45 um" ;
        schema:name "3D polyhedral shell wild-type somitecoel lumen ratio rho_3D = R_in / R_out" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "0.323" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-3d-polyhedral-shell-wild-type-somitecoel-lumen-ratio-rho-3d-r-in-r-out-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-3d-polyhedral-shell-wild-type-somitecoel-lumen-ratio-rho-3d-r-in-r-out-reference> a schema:PropertyValue ;
        dcterms:source "Yamanaka et al. (2023) Nature 614:509-520 Figs. 2-3 cross-sectional somitecoel/somite radius ratio (empirical 0.305; the 2D polygon law gives 0.303, the 3D closed-form Law 4 gives 0.3229)" ;
        schema:value "0.305" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-3d-shell-somitecoel-rupture-saddle-node-lumen-pressure-p-crit> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D shell somitecoel rupture (saddle-node) lumen pressure P_crit = 0.115 gamma_lat / um" ;
        dcterms:description "discrete 2*N_3D-DOF shell vs analytic rho at P=0/0.04/0.08: 0.3230 vs 0.3229; 0.3870 vs 0.3871; 0.4879 vs 0.4884; Y-27632 shell P_crit = 0.0340" ;
        schema:measurementTechnique "bisection on Law 4 E_3D(R_in; P) for loss of the closed-shell local minimum (WT gamma_ap=1.65, gamma_bas=0.45); rho_3D rises monotonically from 0.3229 at P=0 to 0.6728 just below P_crit" ;
        schema:name "3D shell somitecoel rupture (saddle-node) lumen pressure P_crit" ;
        schema:unitText "gamma_lat / um" ;
        schema:value "0.115" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-3d-shell-somitecoel-rupture-saddle-node-lumen-pressure-p-crit-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-3d-shell-somitecoel-rupture-saddle-node-lumen-pressure-p-crit-reference> a schema:PropertyValue ;
        dcterms:source "Law 4 two-surface Laplace open-shell bound 2 (gamma_ap + gamma_bas) / R_in* evaluated at the P=0 equilibrium (model-internal analytical reference; no measured somitocoel pressure exists in Yamanaka 2023 / Miao 2023)" ;
        schema:value "0.51" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-6-regime-somite-rosette-perturbation-series-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "6-regime somite rosette perturbation series Pearson correlation r = 0.9989 Pearson r" ;
        dcterms:description "p = 1.94e-06; spans Calpeptin hyper-constricted (0.1370) to Y-27632 (0.7013)" ;
        schema:measurementTechnique "correlation between 2D vertex-predicted and empirical apical-to-basal ratios across 6 Yamanaka (2023), Miao (2023) & Adhyapok (2021) regimes (RMSE = 0.0154)" ;
        schema:name "6-regime somite rosette perturbation series Pearson correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9989" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-6-regime-somite-rosette-perturbation-series-pearson-correlation-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-6-regime-somite-rosette-perturbation-series-pearson-correlation-r-reference> a schema:PropertyValue ;
        dcterms:source "Yamanaka et al. (2023) Nature 614:509-520; Miao et al. (2023) Nature 614:500-508; Adhyapok et al. (2021) Dev. Cell 56:1312-1324" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-clock-wavefront-mesp2-boundary-spacing-s-segment-length-from-arrested-hes7-phase> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "clock-wavefront MESP2 boundary spacing S (segment length) from arrested HES7 phase = 100.0 um" ;
        dcterms:description "segment lengths = [100.0, 100.0, 100.0, 100.0] um (CV = 0.0e+00); boundary determination times t_det = [5.35, 10.35, 15.35, 20.35, 25.35] h (RIPPLY2 delay 1.0 h)" ;
        schema:measurementTechnique "mean spacing of 5 ephrinB2-|EphA4+ boundaries (MESP2 off->on transitions of arrested cells) after 28 h with wavefront speed v=20.0 um/h over 64 cells of 10.0 um; MESP2 stripe fraction = 0.50 of each segment" ;
        schema:name "clock-wavefront MESP2 boundary spacing S (segment length) from arrested HES7 phase" ;
        schema:unitText "um" ;
        schema:value "100.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-clock-wavefront-mesp2-boundary-spacing-s-segment-length-from-arrested-hes7-phase-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-clock-wavefront-mesp2-boundary-spacing-s-segment-length-from-arrested-hes7-phase-reference> a schema:PropertyValue ;
        dcterms:source "Cooke & Zeeman (1976) J. Theor. Biol. 58:455-476 clock-and-wavefront law S = v * T_HES7 (analytical reference; v is a model choice giving ~100 um somites, not a value digitised from Yamanaka 2023)" ;
        schema:value "99.9" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-epha4-ephrinb2-inter-somitic-cleft-separation-index-s-cleft> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "EphA4/ephrinB2 inter-somitic cleft separation index S_cleft = 0.8189 dimensionless index" ;
        dcterms:description "cleft indentation depth = 14.68 um in WT vs 1.23 um (S_cleft = 0.0930) in EphA4/ephrinB2 knockdown" ;
        schema:measurementTechnique "heterotypic EphA4/ephrinB2 contact repulsion cleft separation score 1 - (gamma_hom / gamma_het)^2 at gamma_het = 2.35 (Delta_E_cleft = 75.60 pN)" ;
        schema:name "EphA4/ephrinB2 inter-somitic cleft separation index S_cleft" ;
        schema:unitText "dimensionless index" ;
        schema:value "0.8189" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-epha4-ephrinb2-inter-somitic-cleft-separation-index-s-cleft-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-epha4-ephrinb2-inter-somitic-cleft-separation-index-s-cleft-reference> a schema:PropertyValue ;
        dcterms:source "Adhyapok et al. (2021) Dev. Cell 56:1312-1324 Figs. 1-3; Yamanaka et al. (2023) Nature 614:509-520 Fig. 2" ;
        schema:value "0.94" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-live-hes7-delayed-oscillator-period-t-hes7-human-scaled-lewis-2003-kernel> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "live HES7 delayed-oscillator period T_HES7 (human-scaled Lewis 2003 kernel) = 4.995 h" ;
        dcterms:description "single-cell calibration period = 4.994 h; amplitude 28.3-1264.9 protein units" ;
        schema:measurementTechnique "Lewis (2003) two-variable transcriptional-delay oscillator, zebrafish her1 kernel stretched by time_scale=6.078 (T_m=1.22 h, T_p=0.28 h, protein half-life=18.3 min), explicit Euler dt=0.005 h, period from protein peaks of the never-arrested posterior PSM cell (CV=4.0e-04)" ;
        schema:name "live HES7 delayed-oscillator period T_HES7 (human-scaled Lewis 2003 kernel)" ;
        schema:unitText "h" ;
        schema:value "4.995" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-live-hes7-delayed-oscillator-period-t-hes7-human-scaled-lewis-2003-kernel-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-live-hes7-delayed-oscillator-period-t-hes7-human-scaled-lewis-2003-kernel-reference> a schema:PropertyValue ;
        dcterms:source "Diaz-Cuadros et al. (2020) Nature 580:113-118 and Matsuda et al. (2020) Nature 580:124-129: human iPSC-PSM HES7 reporter period ~5 h (the time_scale is CALIBRATED to this value; the measurement validates the calibration, not an independent prediction)" ;
        schema:value "5.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-stage-resolved-live-coupled-lumen-ratio-oldest-somite-s-iii-l-ap-l-bas-under-rhoa-rock-ramp> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stage-resolved live-coupled lumen ratio: oldest somite (S-III) L_ap/L_bas under RhoA/ROCK ramp = 0.3033 dimensionless ratio" ;
        dcterms:description "newest somite S0 (age 6.75 h) ratio = 0.3500; Y-27632 coupled ratio stays 0.7013 at every stage; cleft score 0.8189 WT vs 0.0930 Eph/ephrin KD (gamma_het ramp tau = 1.5 h); anterior-to-posterior monotone maturation = True" ;
        schema:measurementTechnique "gamma_ap,j(t) = gamma_bas + (1.65 - 0.45)(1 - exp(-(t - t_arrest)/3.0 h)) of every cell of the oldest complete segment (age 21.75 h, gamma_ap = 1.6490) fed live into the 2D 32-vertex solver; 3D Law 4 gives rho_3D = 0.3232" ;
        schema:name "stage-resolved live-coupled lumen ratio: oldest somite (S-III) L_ap/L_bas under RhoA/ROCK ramp" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "0.3033" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-stage-resolved-live-coupled-lumen-ratio-oldest-somite-s-iii-l-ap-l-bas-under-rhoa-rock-ramp-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-stage-resolved-live-coupled-lumen-ratio-oldest-somite-s-iii-l-ap-l-bas-under-rhoa-rock-ramp-reference> a schema:PropertyValue ;
        dcterms:source "Yamanaka et al. (2023) Nature 614:509-520 Figs. 2-3 mature epithelial somite (empirical 0.305); maturation series S0 -> S-III = [0.35, 0.3119, 0.3047, 0.3033]" ;
        schema:value "0.305" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-vertebrate-somite-rosette-specimen-bilateral-metamere-spacing-s-obs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vertebrate somite rosette specimen bilateral metamere spacing S_obs = 45.375 px" ;
        dcterms:description "bilateral symmetry ratio = 1.0834, AP cleft waveform r = 0.2136, dome/cleft contrast = 1.2315; NOTE the vendored reference_json rosette_metrics (lower_row_somite_count=8, CV=0.2010) disagree with this segmentation (lower row = 10, CV = 0.2391) — carried as an open Pass 4 item" ;
        schema:measurementTechnique "bilateral dorsal somite rosette DoG peak & inter-somitic cleft segmentation on somitoid_rosette_specimen.jpg (upper=8 rosettes, lower=10 rosettes, CV=0.2391)" ;
        schema:name "vertebrate somite rosette specimen bilateral metamere spacing S_obs" ;
        schema:unitText "px" ;
        schema:value "45.375" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-vertebrate-somite-rosette-specimen-bilateral-metamere-spacing-s-obs-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-vertebrate-somite-rosette-specimen-bilateral-metamere-spacing-s-obs-reference> a schema:PropertyValue ;
        dcterms:source "Vendored CC BY 4.0 vertebrate embryo somite rosette SEM specimen (datasets/somitoid_chirality_buckling/somitoid_rosette_specimen.jpg)" ;
        schema:value "47.1429" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-wild-type-somite-rosette-equilibrium-apical-to-basal-ratio-l-ap-l-bas> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type somite rosette equilibrium apical-to-basal ratio L_ap / L_bas = 0.303 dimensionless ratio" ;
        dcterms:description "apico-basal polarity score = 1.0000; wedge cell height = 17.81 um" ;
        schema:measurementTechnique "2D 32-vertex apico-basal differential interfacial tension relaxation (N=16 wedge cells, gamma_ap=1.65, gamma_bas=0.45, R_in*=7.74 um, R_out*=25.56 um)" ;
        schema:name "wild-type somite rosette equilibrium apical-to-basal ratio L_ap / L_bas" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "0.303" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-wild-type-somite-rosette-equilibrium-apical-to-basal-ratio-l-ap-l-bas-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-wild-type-somite-rosette-equilibrium-apical-to-basal-ratio-l-ap-l-bas-reference> a schema:PropertyValue ;
        dcterms:source "Yamanaka et al. (2023) Nature 614:509-520 Figs. 1-3; Adhyapok et al. (2021) Dev. Cell 56:1312-1324 Figs. 2-4 (analytical ratio = 0.3037, empirical = 0.305)" ;
        schema:value "0.303" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-y-27632-rock-inhibited-apico-basal-ratio-dilation-l-ap-l-bas> a schema:PropertyValue,

        dcterms:description "somitecoel lumen dilates from 7.74 um (WT) to 24.00 um (Y-27632); Minus-Matrigel ratio = 0.5614" ;
        schema:measurementTechnique "2D vertex relaxation under Y-27632 ROCK / Blebbistatin myosin II inhibition (gamma_ap = gamma_bas = 0.45, Delta_gamma_ap_bas = 0)" ;
        schema:name "Y-27632 ROCK-inhibited apico-basal ratio dilation L_ap / L_bas" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "0.7013" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-y-27632-rock-inhibited-apico-basal-ratio-dilation-l-ap-l-bas-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-y-27632-rock-inhibited-apico-basal-ratio-dilation-l-ap-l-bas-reference> a schema:PropertyValue ;
        dcterms:source "Yamanaka et al. (2023) Nature 614:509-520 Fig. 3; Miao et al. (2023) Nature 614:500-508 Fig. 4 (empirical unpolarized ratio = 0.700)" ;
        schema:value "0.7013" .


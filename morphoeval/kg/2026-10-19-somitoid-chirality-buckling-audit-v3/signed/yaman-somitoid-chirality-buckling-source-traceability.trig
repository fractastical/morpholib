        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L1-L36> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/somitoid_chirality_buckling/somitoid_chirality_buckling_reference.json L116–L165" ;
        dcterms:description "Pass 3 shell_3d_governing_equations and hes7_clock_wavefront blocks with parameter provenance / status" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/somitoid_chirality_buckling/somitoid_chirality_buckling_reference.json#L116-L165> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/somitoid_chirality_buckling/README.md L35–L65" ;

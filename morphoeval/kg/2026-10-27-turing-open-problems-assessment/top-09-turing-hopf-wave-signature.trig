sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.ydbio.2019.10.031>,
            <https://doi.org/10.1098/rstb.1952.0012> .

    <https://doi.org/10.1016/j.ydbio.2019.10.031> dct:date "2020"^^xsd:gYear ;
        dct:title "Pattern formation mechanisms of self-organizing reaction-diffusion systems" .

    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The Chemical Basis of Morphogenesis" .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/turing-open-problem-top-09-turing-hopf-wave-signature> a pk:Claim ;
        rdfs:label "TOP-09 — Turing's neglected case: is there a wave (Turing-Hopf) dispersion signature in the embryonic Ca2+ wave field?" ;
        dct:description "OPEN PROBLEM in Turing-pattern biology, sourced forward from Turing 1952 Sec. 10 (oscillatory case) -> Ca2+ wave-vector pipeline. THE GAP: Turing 1952 also derived oscillatory, travelling-wave instabilities; essentially no developmental system has been shown to use one. The repo's Ca2+ spark-track data (x, y, t per event) is the only place here that can ask whether an observed wave field carries a dispersion ridge omega(k) distinct from a single driven front (omega = v k). DEFINITION OF DONE: A pre-registered space-time spectral test on existing spark_tracks CSVs: estimate the (k, omega) power surface per embryo, fit the driven-front line, and test for a secondary ridge against phase-randomised surrogates at a locked false-positive rate; report per-embryo outcomes and the pooled verdict either way. Rated on two separate axes: resolvability 71/100 (RESOLVE NOW) by the deterministic Problem-Scout rubric (prices our tools, data in hand and a checkable definition-of-done, not truth odds), and a PROVISIONAL single-assessor viability posterior of 38.7% (prior 50%, net -2 dB) that the named route reaches a decisive verdict — not a multi-agent panel score. A belief under assessment, not a fact." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/TURING_OPEN_PROBLEMS.md> ;
        pk:context "tool_route: wave-vector-analysis/ (spark_tracks.csv schema, embryo_units.py for em/s conversion); new spectral script; predictions/ registry for the surrogate threshold. | deciding_data: In repo: wave-vector-analysis/test_data/spark_tracks_qc_folder31.csv, _folder33.csv and analysis_results/*.csv; orientation and coordinate caveats recorded (COORDINATE_SYSTEM_WARNING.md, OP-07). | prior_attempts: scout-036 proposed binned AP spark spectra vs Turing k_c and a travelling-front vs static-labyrinth gate; neither run. Blind tests OP-07/08 found orientation, not wave features, carried signal." ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.ydbio.2019.10.031>,
            <https://doi.org/10.1098/rstb.1952.0012> ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-resolvability>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-viability> ;
        pk:weightOfEvidence "0.387"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-resolvability> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-09 resolvability 71/100 — RESOLVE NOW" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC): tool_fit (0-25): a named repo tool, run as-is, produces the deciding evidence; data_in_hand (0-20): deciding data already in repo, or one named public fetch away; falsifiable_done (0-15): an exact definition-of-done a scorer can check without taste; compute_in_repo (0-15): runs on the repo stack in hours, no wet lab / no new infrastructure; isolation (0-10): closable as new files only, zero-conflict with parallel agents; time_to_verdict (0-10): verdict reachable in one loop / one sitting; not_blocked (0-5): no recorded prior attempt already refuted this exact route. Score = sum of factor scores / 100; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 13/15: FFTs of event fields: seconds",
            "data_in_hand 14/20: several spark_tracks CSVs are in the repo",
            "falsifiable_done 10/15: surrogate-tested secondary ridge at a locked rate is checkable; ridge definition needs care",
            "isolation 9/10: new script + registry row",
            "not_blocked 4/5: OP-07/08 negatives concern neighbour prediction, not dispersion",
            "time_to_verdict 6/10: one loop",
            "tool_fit 15/25: pipeline and unit conversion exist; the spectral estimator is new but small" ;
        pk:hasScore "0.71"^^xsd:double ;
        pk:hasVerdict "RESOLVE NOW" .

    <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-09-turing-hopf-wave-signature-decisive-verdict> a pk:TestableHypothesis ;
        rdfs:label "The registered surrogate test returns a decisive per-embryo verdict (secondary ridge present/absent at the locked rate) on the in-repo spark-track data." ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-viability> ;
        pk:hasPriorProbability "0.5"^^xsd:double ;
        pk:hasResolvability "0.71"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-09-turing-hopf-wave-signature-viability> a pk:BayesianAssessment ;
        rdfs:label "TOP-09 viability 38.7% — provisional single-assessor Delphi" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:bayesFactor "0.631"^^xsd:double ;
        pk:calibrationMethod "Single-assessor provisional signed deciban ledger, prior 50% (predictions/round2_live_arguments.json discipline); NOT a multi-agent panel; a panel pass may supersede but not edit" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-09-turing-hopf-wave-signature-decisive-verdict> ;
        pk:evidenceAgainst "[-1 dB] Orientation/coordinate confounds documented in OP-07 and COORDINATE_SYSTEM_WARNING.md",
            "[-2 dB] Short, sparse event fields give poor (k, omega) resolution; the ridge criterion can slide into taste unless locked tightly",
            "[-3 dB] Poke-triggered waves are driven, not spontaneous; a wave instability would have to appear as a weak secondary ridge, and prior blind tests found wave features carry little signal" ;
        pk:evidenceFor "[+2 dB] Event (x, y, t) data are in repo and space-time spectra are cheap",
            "[+2 dB] The null (single driven front, omega = v k) is sharp and the surrogate test is standard" ;
        pk:hasConfidence "0.55"^^xsd:double ;
        pk:hasProbability "0.387"^^xsd:double ;
        pk:hasVerdict "TESTABLE_NOW_LIKELY_NULL" ;
        pk:weightOfEvidenceDeciban "-2.0"^^xsd:double .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 Thinking High (single assessor, provisional)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


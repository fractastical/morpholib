        prov:wasDerivedFrom <https://doi.org/10.1016/j.cels.2024.11.002>,
            <https://doi.org/10.1038/s41467-018-07847-x> .

    <https://doi.org/10.1016/j.cels.2024.11.002> dcterms:date "2024"^^xsd:gYear ;
        dcterms:title "A three-node Turing gene circuit forms periodic spatial patterns in bacteria" .

    <https://doi.org/10.1038/s41467-018-07847-x> dcterms:date "2018"^^xsd:gYear ;
        dcterms:title "Synthetic mammalian pattern formation driven by differential diffusivity of Nodal and Lefty" .

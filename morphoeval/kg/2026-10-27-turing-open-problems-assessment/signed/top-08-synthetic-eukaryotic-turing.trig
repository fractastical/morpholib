sub1:assertion {
    <https://w3id.org/delphi/resource/claim/turing-open-problem-top-08-synthetic-eukaryotic-turing> a pk:Claim ;
        rdfs:label "TOP-08 — Synthetic realisation: a robust, deterministic periodic Turing pattern in eukaryotic cells" ;
        dcterms:description "OPEN PROBLEM in Turing-pattern biology, sourced forward from Sekine 2018 -> Tica 2024. THE GAP: Bacterial three-node circuits now give reproducible concentric stripes but remain condition-sensitive (Tica 2024); the mammalian Nodal-Lefty circuit most likely produced solitary, not periodic, patterns (Sekine 2018). A robust eukaryotic periodic Turing pattern has not been built. DEFINITION OF DONE: Wet-lab: a eukaryotic circuit producing periodic patterns with pre-registered wavelength reproducibility across >=3 biological replicates. The repo can only contribute the Turing-vs-solitary regime map of the published circuit model. Rated on two separate axes: resolvability 37/100 (HARD HERE) by the deterministic Problem-Scout rubric (prices our tools, data in hand and a checkable definition-of-done, not truth odds), and a PROVISIONAL single-assessor viability posterior of 11.2% (prior 50%, net -9 dB) that the named route reaches a decisive verdict — not a multi-agent panel score. A belief under assessment, not a fact." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/main/docs/TURING_OPEN_PROBLEMS.md> ;
        pk:context "tool_route: None adequate: no wet lab. Modelling satellite only (regime map of the Sekine competitive-inhibition model). | deciding_data: Not obtainable here. | prior_attempts: None in repo." ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.cels.2024.11.002>,
            <https://doi.org/10.1038/s41467-018-07847-x> ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-resolvability>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-viability> ;
        pk:weightOfEvidence "0.112"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-resolvability> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-08 resolvability 37/100 — HARD HERE" ;
        dcterms:date "2026-10-27"^^xsd:date ;
        dcterms:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC): tool_fit (0-25): a named repo tool, run as-is, produces the deciding evidence; data_in_hand (0-20): deciding data already in repo, or one named public fetch away; falsifiable_done (0-15): an exact definition-of-done a scorer can check without taste; compute_in_repo (0-15): runs on the repo stack in hours, no wet lab / no new infrastructure; isolation (0-10): closable as new files only, zero-conflict with parallel agents; time_to_verdict (0-10): verdict reachable in one loop / one sitting; not_blocked (0-5): no recorded prior attempt already refuted this exact route. Score = sum of factor scores / 100; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 2/15: the deciding evidence is not computational",
            "data_in_hand 4/20: only the published model equations",
            "falsifiable_done 12/15: replicate wavelength reproducibility is checkable — elsewhere",
            "isolation 10/10: nothing to conflict with",
            "not_blocked 5/5: no prior attempt",
            "time_to_verdict 1/10: months to years, in a lab",
            "tool_fit 3/25: no instrument in this repo can run a wet-lab experiment" ;
        pk:hasScore "0.37"^^xsd:double ;
        pk:hasVerdict "HARD HERE" .

    <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-08-synthetic-eukaryotic-turing-decisive-verdict> a pk:TestableHypothesis ;
        rdfs:label "This repo brings the synthetic eukaryotic Turing problem to a decisive verdict." ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-viability> ;
        pk:hasPriorProbability "0.5"^^xsd:double ;
        pk:hasResolvability "0.37"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-08-synthetic-eukaryotic-turing-viability> a pk:BayesianAssessment ;
        rdfs:label "TOP-08 viability 11.2% — provisional single-assessor Delphi" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:bayesFactor "0.1259"^^xsd:double ;
        pk:calibrationMethod "Single-assessor provisional signed deciban ledger, prior 50% (predictions/round2_live_arguments.json discipline); NOT a multi-agent panel; a panel pass may supersede but not edit" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-08-synthetic-eukaryotic-turing-decisive-verdict> ;
        pk:evidenceAgainst "[-10 dB] The deciding evidence is wet-lab; none of the repo's instruments reach it" ;
        pk:evidenceFor "[+1 dB] A regime map of the published Sekine model (Turing vs solitary) is a tractable modelling satellite" ;
        pk:hasConfidence "0.8"^^xsd:double ;
        pk:hasProbability "0.112"^^xsd:double ;
        pk:hasVerdict "NOT_WITH_OUR_TOOLS" ;
        pk:weightOfEvidenceDeciban "-9.0"^^xsd:double .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 Thinking High (single assessor, provisional)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .
}


sub1:assertion {
    <https://w3id.org/delphi/resource/claim/turing-open-problem-top-03-robustness-fraction> a pk:Claim ;
        rdfs:label "TOP-03 — The fine-tuning objection: replicate the two-node vs three-node Turing parameter-volume ratio and the 1%-uncertainty retention claim" ;
        dcterms:description "OPEN PROBLEM in Turing-pattern biology, sourced forward from Murray 1982 -> Scholes 2019 -> Tica 2024. THE GAP: Turing instability is topologically common but occupies tiny parameter volumes: 0.00035% of sampled space for the classical two-node circuit vs 0.022% for the best three-node topology (Tica et al. 2024, Latin-hypercube linear stability), with 33% retention under 1% parameter uncertainty around a Turing I point. These numbers decide whether the fine-tuning objection to biological Turing systems stands; they have not been independently reproduced. DEFINITION OF DONE: A pre-registered Latin-hypercube linear-stability sweep on the repo's two-node kinetics and a three-node immobile-node topology within published parameter bounds, reporting both Turing fractions and the 1%/5% local-retention fractions; verdict = within one order of magnitude of the published ratio (>=10x three-node over two-node) or not. Rated on two separate axes: resolvability 88/100 (RESOLVE NOW) by the deterministic Problem-Scout rubric (prices our tools, data in hand and a checkable definition-of-done, not truth odds), and a PROVISIONAL single-assessor viability posterior of 79.9% (prior 50%, net +6 dB) that the named route reaches a decisive verdict — not a multi-agent panel score. A belief under assessment, not a fact." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/main/docs/TURING_OPEN_PROBLEMS.md> ;
        pk:context "tool_route: models/1952-turing-morpho.py (Jacobian / dispersion code, Pearson Saddle-Node & Hopf curves, Lean d_c); new sweep script under morphoeval/ or models/; registry row for the ratio before running. | deciding_data: Published fractions (Tica 2024 Fig. 2A, Table S5 bounds; Scholes 2019 atlas) — no biological data needed. | prior_attempts: scout-034 proposed a 12-class Pearson (F,k) sweep, not a robustness fraction; nothing recorded on parameter volume." ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.cels.2019.07.007>,
            <https://doi.org/10.1016/j.cels.2024.11.002>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1103/PhysRevE.84.011112>,
            <https://doi.org/10.7554/eLife.14022> ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-03-robustness-fraction-resolvability>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-03-robustness-fraction-viability> ;
        pk:weightOfEvidence "0.799"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-03-robustness-fraction-resolvability> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-03 resolvability 88/100 — RESOLVE NOW" ;
        dcterms:date "2026-10-27"^^xsd:date ;
        dcterms:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC): tool_fit (0-25): a named repo tool, run as-is, produces the deciding evidence; data_in_hand (0-20): deciding data already in repo, or one named public fetch away; falsifiable_done (0-15): an exact definition-of-done a scorer can check without taste; compute_in_repo (0-15): runs on the repo stack in hours, no wet lab / no new infrastructure; isolation (0-10): closable as new files only, zero-conflict with parallel agents; time_to_verdict (0-10): verdict reachable in one loop / one sitting; not_blocked (0-5): no recorded prior attempt already refuted this exact route. Score = sum of factor scores / 100; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 13/15: 10^6-10^7 LHS Jacobian evaluations in numpy, under an hour",
            "data_in_hand 18/20: target numbers and parameter bounds are published; nothing to fetch but a supplementary table",
            "falsifiable_done 14/15: order-of-magnitude ratio and retention fractions are numbers a scorer reads off",
            "isolation 10/10: one new script + registry row",
            "not_blocked 5/5: no prior attempt",
            "time_to_verdict 8/10: one loop",
            "tool_fit 20/25: linear stability + Lean d_c already in the flagship script; a sweep driver is all that is missing" ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "RESOLVE NOW" .

    <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-03-robustness-fraction-decisive-verdict> a pk:TestableHypothesis ;
        rdfs:label "The repo's sweep reproduces the published two-node vs three-node Turing-fraction ratio within one order of magnitude and the >=10x ordering, with the pre-registered numbers scored." ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-03-robustness-fraction-viability> ;
        pk:hasPriorProbability "0.5"^^xsd:double ;
        pk:hasResolvability "0.88"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-03-robustness-fraction-viability> a pk:BayesianAssessment ;
        rdfs:label "TOP-03 viability 79.9% — provisional single-assessor Delphi" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:bayesFactor "3.9811"^^xsd:double ;
        pk:calibrationMethod "Single-assessor provisional signed deciban ledger, prior 50% (predictions/round2_live_arguments.json discipline); NOT a multi-agent panel; a panel pass may supersede but not edit" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-03-robustness-fraction-decisive-verdict> ;
        pk:evidenceAgainst "[-1 dB] LHS undersamples high-dimensional parameter space (the authors say so); 'within one order of magnitude' may still fail on sampling noise",
            "[-2 dB] Fractions are sensitive to the exact parameter bounds and sampling conventions (Table S5); mismatch shifts them by orders of magnitude" ;
        pk:evidenceFor "[+2 dB] Pearson/Turing LSA code and the d_c theorem are already in the repo",
            "[+3 dB] Published target numbers and bounds exist to score against",
            "[+4 dB] Pure deterministic computation; linear stability of small Jacobians is exactly what the flagship already does and Lean already checks" ;
        pk:hasConfidence "0.7"^^xsd:double ;
        pk:hasProbability "0.799"^^xsd:double ;
        pk:hasVerdict "LIKELY_REPRODUCIBLE_ONE_LOOP" ;
        pk:weightOfEvidenceDeciban "6.0"^^xsd:double .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 Thinking High (single assessor, provisional)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .
}


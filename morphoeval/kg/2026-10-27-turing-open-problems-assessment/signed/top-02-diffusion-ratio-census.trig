sub1:assertion {
    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-resolvability> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-02 resolvability 78/100 — RESOLVE NOW" ;
        dcterms:date "2026-10-27"^^xsd:date ;
        dcterms:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC): tool_fit (0-25): a named repo tool, run as-is, produces the deciding evidence; data_in_hand (0-20): deciding data already in repo, or one named public fetch away; falsifiable_done (0-15): an exact definition-of-done a scorer can check without taste; compute_in_repo (0-15): runs on the repo stack in hours, no wet lab / no new infrastructure; isolation (0-10): closable as new files only, zero-conflict with parallel agents; time_to_verdict (0-10): verdict reachable in one loop / one sitting; not_blocked (0-5): no recorded prior attempt already refuted this exact route. Score = sum of factor scores / 100; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 14/15: linear stability per row is instantaneous",
            "data_in_hand 10/20: all values are one public fetch away, but most D's are probably unmeasured",
            "falsifiable_done 13/15: pre-registered class counts; the 'unmeasured' class is checkable by absence of a DOI",
            "isolation 10/10: one new table + registry row",
            "not_blocked 5/5: no prior attempt",
            "time_to_verdict 7/10: one sitting of literature extraction",
            "tool_fit 19/25: scout_literature.py + the existing dispersion code and Lean d_c decide each row" ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "RESOLVE NOW" .

    <https://w3id.org/delphi/resource/claim/turing-open-problem-top-02-diffusion-ratio-census> a pk:Claim ;
        rdfs:label "TOP-02 — The diffusion-ratio problem: which molecularly identified Turing systems can be two-species at all?" ;
        dcterms:description "OPEN PROBLEM in Turing-pattern biology, sourced forward from Gierer-Meinhardt 1972 -> Marcon 2016 -> 2025 'fundamental limits'. THE GAP: Two-species activator-inhibitor models need D_inh/D_act above the Lean-checked threshold (d_c = 3.93 for the repo's Gray-Scott Jacobian; ~4-10 generally), yet measured extracellular diffusivities rarely show it; three-node networks with an immobile node remove the requirement (Marcon 2016) and extracellular wiring changes behaviour qualitatively (2025 bioRxiv). Nobody has tabulated, system by system, which of the molecularly supported cases (WNT/DKK, FGF/Shh palate, Bmp-Sox9-Wnt digits, GDF5/NOG joints, EDAR/WNT/BMP ridges, Nodal/Lefty) actually satisfies the two-species condition with measured D. DEFINITION OF DONE: A registered table of >=6 molecular Turing systems giving measured or bounded D_act, D_inh (with DOI), run through the repo's dispersion relation, classifying each as two-node-feasible / needs immobile third node / D unmeasured; the count in each class pre-registered before the literature values are looked up. Rated on two separate axes: resolvability 78/100 (RESOLVE NOW) by the deterministic Problem-Scout rubric (prices our tools, data in hand and a checkable definition-of-done, not truth odds), and a PROVISIONAL single-assessor viability posterior of 55.7% (prior 50%, net +1 dB) that the named route reaches a decisive verdict — not a multi-agent panel score. A belief under assessment, not a fact." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/main/docs/TURING_OPEN_PROBLEMS.md> ;
        pk:context "tool_route: python3 morphoeval/scout_literature.py --query '<morphogen> diffusion coefficient FRAP FCS' per system; models/1952-turing-morpho.py dispersion (Lean turing_differential_diffusion_instability, d_c = 3.9271); predictions/ registry row for the pre-registered counts. | deciding_data: Public literature only. Known in hand: Nodal/Lefty D measured (Mueller 2012); GDF5/NOG model needs no differential diffusion (Grall 2024). Others likely unmeasured — that is itself the finding. | prior_attempts: None in repo. scout-063 ZF-TUR-01 kernel-checked a size-prior D ratio (D_inh/D_act < 1 for chd/bmp2b) — a related negative." ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/j.cell.2023.01.015>,
            <https://doi.org/10.1038/ng.1090>,
            <https://doi.org/10.1073/pnas.2304470121>,
            <https://doi.org/10.1101/2025.05.27.656324>,
            <https://doi.org/10.1126/science.1130088>,
            <https://doi.org/10.1126/science.1221920>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.7554/eLife.14022> ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-resolvability>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-viability> ;
        pk:weightOfEvidence "0.557"^^xsd:double .

    <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-02-diffusion-ratio-census-decisive-verdict> a pk:TestableHypothesis ;
        rdfs:label "The census reaches a classification for >=6 systems, with the pre-registered class counts scored, and at least one system falls in each of the three classes." ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-viability> ;
        pk:hasPriorProbability "0.5"^^xsd:double ;
        pk:hasResolvability "0.78"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-02-diffusion-ratio-census-viability> a pk:BayesianAssessment ;
        rdfs:label "TOP-02 viability 55.7% — provisional single-assessor Delphi" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:bayesFactor "1.2589"^^xsd:double ;
        pk:calibrationMethod "Single-assessor provisional signed deciban ledger, prior 50% (predictions/round2_live_arguments.json discipline); NOT a multi-agent panel; a panel pass may supersede but not edit" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-02-diffusion-ratio-census-decisive-verdict> ;
        pk:evidenceAgainst "[-2 dB] Effective D depends on receptor binding and sequestration (2025 'fundamental limits'), so a raw D ratio is not the deciding quantity for the biology, only for the two-species model class",
            "[-3 dB] For WNT/DKK, FGF/Shh, EDAR/BMP the extracellular D's are not measured: the majority verdict may be 'unmeasured', informative but thin" ;
        pk:evidenceFor "[+1 dB] Literature route is the repo's own scout_literature.py",
            "[+2 dB] Nodal/Lefty D's are measured (Mueller 2012) and GDF5/NOG is published as not needing differential diffusion (Grall 2024): two rows are already decidable",
            "[+3 dB] d_c is Lean-checked and the dispersion code exists; each row is a one-line computation once D's are in hand" ;
        pk:hasConfidence "0.65"^^xsd:double ;
        pk:hasProbability "0.557"^^xsd:double ;
        pk:hasVerdict "DECIDABLE_TABLE_MOSTLY_UNMEASURED_ROWS" ;
        pk:weightOfEvidenceDeciban "1.0"^^xsd:double .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 Thinking High (single assessor, provisional)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .
}


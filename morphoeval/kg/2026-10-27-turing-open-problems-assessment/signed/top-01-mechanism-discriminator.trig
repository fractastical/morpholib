sub1:assertion {
    <https://w3id.org/delphi/resource/claim/turing-open-problem-top-01-mechanism-discriminator> a pk:Claim ;
        rdfs:label "TOP-01 — Mechanism identification: a pre-registered statistic that separates reaction-diffusion from colonisation, phase separation and buckling on static patterns" ;
        dcterms:description "OPEN PROBLEM in Turing-pattern biology, sourced forward from Turing 1952 -> Murray 1981 -> OP-11 (2026). THE GAP: Pattern phenomenology does not identify mechanism: zebrafish stripes are cell-contact mediated (Nakamasu 2009), feather buds mechanical first (Shyer 2017), Holstein spotting indistinguishable between growing RD and Eden colonisation at p=0.91 (OP-11). No registered discriminator exists that, given only an adult pattern, says which class of generator made it with a stated error rate. DEFINITION OF DONE: A hash-locked discriminator (candidate features: radial power-spectrum shape, Minkowski functionals, defect/junction statistics, two-point anisotropy) trained and scored on synthetic ground truth from four generators (Gray-Scott/Schnakenberg RD, Eden colonisation, Cahn-Hilliard phase separation, elastic buckling) with a pre-registered held-out accuracy threshold and published confusion matrix; then applied blind to the 10 coat-masked Holstein specimens, reported either way. Rated on two separate axes: resolvability 77/100 (RESOLVE NOW) by the deterministic Problem-Scout rubric (prices our tools, data in hand and a checkable definition-of-done, not truth odds), and a PROVISIONAL single-assessor viability posterior of 55.7% (prior 50%, net +1 dB) that the named route reaches a decisive verdict — not a multi-agent panel score. A belief under assessment, not a fact." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/main/docs/TURING_OPEN_PROBLEMS.md> ;
        pk:context "tool_route: models/1981-murray-bos-taurus-turing-wavelength.py (RD + Eden generators, coat masks, paired harness); models/1952-turing-morpho.py (Pearson classes); morphoeval/measure_outputs.py; predictions/ registry for the hash lock. Cahn-Hilliard and buckling generators must be written fresh (the catalog *_morphogen_condensation / *_elastic_buckling scripts are alpha-template scaffolds, scout-048). | deciding_data: In repo: 10 Holstein masks, RD/Eden outputs. Synthetic ground truth generated in-run. No wet data needed. | prior_attempts: OP-11 (static Turing rejected; growing RD vs Eden p=0.91) is the direct precursor; scout-040 OP-11 Delphi rescore pending." ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1038/ncomms10288>,
            <https://doi.org/10.1038/s41576-025-00925-z>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.aai7868> ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-resolvability>,
            <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-viability> ;
        pk:weightOfEvidence "0.557"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-resolvability> a pk:LLMClaimAssessment ;
        rdfs:label "TOP-01 resolvability 77/100 — RESOLVE NOW" ;
        dcterms:date "2026-10-27"^^xsd:date ;
        dcterms:description "Deterministic Problem-Scout rubric (morphoeval/problem_scout_100.py RUBRIC): tool_fit (0-25): a named repo tool, run as-is, produces the deciding evidence; data_in_hand (0-20): deciding data already in repo, or one named public fetch away; falsifiable_done (0-15): an exact definition-of-done a scorer can check without taste; compute_in_repo (0-15): runs on the repo stack in hours, no wet lab / no new infrastructure; isolation (0-10): closable as new files only, zero-conflict with parallel agents; time_to_verdict (0-10): verdict reachable in one loop / one sitting; not_blocked (0-5): no recorded prior attempt already refuted this exact route. Score = sum of factor scores / 100; an uncalibrated rubric score, not a probability." ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "problem-scout/1.0/resolvability" ;
        pk:evidenceFor "compute_in_repo 13/15: 2D RD/Eden/CH runs at 256^2 are minutes each on the repo stack",
            "data_in_hand 15/20: 10 coat-masked specimens and both generators in repo; synthetic truth is free",
            "falsifiable_done 13/15: held-out accuracy vs registered threshold + confusion matrix is taste-free; feature choice is not",
            "isolation 9/10: new generator scripts + one registry entry; touches no tracked file",
            "not_blocked 4/5: OP-11 null is a warning, not a refutation of a multi-feature discriminator",
            "time_to_verdict 6/10: two loops: build+validate discriminator, then blind application",
            "tool_fit 17/25: RD + Eden generators and the paired scale-matched harness exist (OP-11); phase-separation and buckling generators do not" ;
        pk:hasScore "0.77"^^xsd:double ;
        pk:hasVerdict "RESOLVE NOW" .

    <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-01-mechanism-discriminator-decisive-verdict> a pk:TestableHypothesis ;
        rdfs:label "A pre-registered multi-feature discriminator reaches its registered held-out accuracy on synthetic four-generator ground truth AND returns a definite class for the Holstein set." ;
        pk:hasAssessment <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-viability> ;
        pk:hasPriorProbability "0.5"^^xsd:double ;
        pk:hasResolvability "0.77"^^xsd:double .

    <https://w3id.org/delphi/resource/assessment/turing-open-problem-top-01-mechanism-discriminator-viability> a pk:BayesianAssessment ;
        rdfs:label "TOP-01 viability 55.7% — provisional single-assessor Delphi" ;
        prov:wasAttributedTo <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:bayesFactor "1.2589"^^xsd:double ;
        pk:calibrationMethod "Single-assessor provisional signed deciban ledger, prior 50% (predictions/round2_live_arguments.json discipline); NOT a multi-agent panel; a panel pass may supersede but not edit" ;
        pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/turing-open-problem-top-01-mechanism-discriminator-decisive-verdict> ;
        pk:evidenceAgainst "[-1 dB] A discriminator fitted to our own four generators may not transfer to the true generator (misspecification)",
            "[-2 dB] Phase-separation and buckling generators in the catalog are template scaffolds (scout-048); both must be written and validated first",
            "[-3 dB] OP-11: adult patch statistics did not separate growing RD from Eden at n=9 (p=0.91) — the hard case is already known to be hard" ;
        pk:evidenceFor "[+2 dB] Minkowski functionals / spectral shape are standard, cheap and already separate RD labyrinths from spinodal fields in the physics literature",
            "[+2 dB] Synthetic ground truth makes the discriminator's own error rate decidable regardless of what the cows turn out to be",
            "[+3 dB] RD and Eden generators plus the paired, scale-matched measurement harness already exist (OP-11 pipeline)" ;
        pk:hasConfidence "0.6"^^xsd:double ;
        pk:hasProbability "0.557"^^xsd:double ;
        pk:hasVerdict "ACHIEVABLE_IN_TWO_LOOPS_HARD_CASE_KNOWN" ;
        pk:weightOfEvidenceDeciban "1.0"^^xsd:double .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 Thinking High (single assessor, provisional)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .
}


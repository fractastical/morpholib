        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Schnakenberg critical wavelength at 3.125 µm for Aulacopleura koninckii meraspis (Pass 1) faithfully reproduces Aulacopleura koninckii meraspis (12 thoracic segments, Wenlock, 428.5 Ma) morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0.py, docs/media/aulacopleura_koninckii_meraspis_turing_wavelength_s0_growth.gif implement the cited source model as published and produce forms that match real Aulacopleura koninckii meraspis (12 thoracic segments, Wenlock, 428.5 Ma) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/media/aulacopleura_koninckii_meraspis_turing_wavelength_s0_growth.gif>,
            <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0.py, https://github.com/fractastical/morpholib/blob/main/docs/media/aulacopleura_koninckii_meraspis_turing_wavelength_s0_growth.gif; output: docs/media/aulacopleura_koninckii_meraspis_turing_wavelength_s0_comparison.png; organism: Aulacopleura koninckii meraspis (12 thoracic segments, Wenlock, 428.5 Ma); environment: n/a; claim_boundary: [reported_in_source: Meraspid Aulacopleura adds thoracic segments; holaspid number varies (Fusco et al. 2004; Hughes & Chapman 1995). | Turing 1952 selects an intrinsic chemical wavelength; Schnakenberg 1979 supplies the two-species kinetics.; reconstructed_in_script: a=0.0625, b=0.875, D_u=2e-12 m^2/s, D_v/D_u = 1.02 × r_crit, and γ are solved so λ_c = 3.125 µm. | The M12 to holaspis18 change at this scale is the segment surplus 6 at fixed k_c.; transfer_boundary: Murray 1981 is used only as the scale argument that domain length, not k_c, changes the number of hosted wavelengths.; does_not_claim: That 3.125 µm was measured on the photograph. | That the dorsal photograph is a verified degree-12 meraspis (counted furrows are 11). | That a Turing mechanism operated in the Silurian animal.]; phenomenon_size: 11 µm (1.088e-05 m, log10=-4.963 m, tier=4_cellular_10um); species_scale_ladder (10 runs from 11 µm to 2.4 cm): 11 µm:aulacopleura-koninckii-holaspis18-bioelectric-polarity, 34 µm:aulacopleura-koninckii-holaspis18-vertex-packing, 544 µm:aulacopleura-koninckii-holaspis18-turing-wavelength, 1.1 mm:aulacopleura-koninckii-holaspis18-clock-wavefront, 2.4 mm:aulacopleura-koninckii-holaspis18-morphogen-condensation, 3.0 mm:aulacopleura-koninckii-holaspis18-elastic-buckling, 3.4 mm:aulacopleura-koninckii-holaspis18-flux-canalization, 4.8 mm:aulacopleura-koninckii-holaspis18-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1086/381042>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.1502-3931.1995.tb01824.x>,
            <https://doi.org/10.1666/06017.1> .
    <https://github.com/fractastical/morpholib/blob/main/docs/media/aulacopleura_koninckii_meraspis_turing_wavelength_s0_growth.gif> a schema:SoftwareSourceCode ;
        rdfs:label "docs/media/aulacopleura_koninckii_meraspis_turing_wavelength_s0_growth.gif" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1086/381042>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.1502-3931.1995.tb01824.x>,
            <https://doi.org/10.1666/06017.1> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:title "A pre-pattern formation mechanism for animal coat markings" .
    <https://doi.org/10.1086/381042> dct:title "Exploring Developmental Modes in a Fossil Arthropod: Growth and Trunk Segmentation of the Trilobite Aulacopleura konincki" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1111/j.1502-3931.1995.tb01824.x> dct:title "Growth and variation in the Silurian proetide trilobite Aulacopleura konincki and its implications for trilobite palaeobiology" .
    <https://doi.org/10.1666/06017.1> dct:title "The ontogeny of trilobite segmentation: a comparative approach" .
}


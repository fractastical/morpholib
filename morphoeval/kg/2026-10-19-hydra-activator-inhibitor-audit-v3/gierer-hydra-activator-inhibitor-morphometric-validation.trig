@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) & Meinhardt (1993, 2012) Hydra vulgaris activator-inhibitor morphogenesis, head regeneration, tentacle ring & coupled three-system 3D shell — Morphometric validation: 89/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1691-1856) now returns 14 measurements. The 7 Pass 2 metrics keep their literature / specimen references; the 7 new shell metrics include three with genuine specimen references (ring offset 0.111 vs 0.070 +- 0.081, tentacle count 7 vs 6, spacing 0.091 vs 0.084 of body length) and an analytic-vs-simulated consistency check (ring inside the phi_t > w_c band). Deductions: four new metrics carry model-internal or trivially satisfied reference values — the foot reference (L-1)/L (L1748), the ablation reference = the default run's own leak (L1758), the Spearman references 1.0 (L1768) and the regeneration recovery reference 1.0 (L1778) — so they validate internal behaviour, not biology (-6); the spacing agreement is the calibration target, not a validation (-2); no uncertainty across seeds or specimens is reported for any shell metric (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1972-gierer-hydra-activator-inhibitor.py L1744–L1783: Foot, ablation, Spearman and regeneration measurements use model-internal reference values rather than literature or specimen numbers <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L1744-L1783>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-amputation-s-l-2-hypostome-recovery-at-the-fragment-tip-and-head-before-ring-ordering>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-foot-activator-position-and-head-foot-axial-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-hypostome-cap-azimuthal-coefficient-of-variation-cv-theta-a-at-the-apex>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-sub-hypostomal-tentacle-ring-axial-offset-s-ring-l-vs-specimen-attachment-offset>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-tentacle-primordia-count-on-the-ring-vs-hydra-vulgaris-specimen>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-ablation-kappa-a-0-no-head-tentacle-suppression-tentacle-activator-leak-into-the-hypostome>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-allometric-domain-length-scaling-correlation-r-l-n-peaks>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-body-length-sweep-spearman-monotonicity-of-tentacle-number-with-shell-size>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-equal-diffusion-negative-control-d-a-d-h-0-015-activator-spatial-std>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c-sqrt-2-1-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-homogeneous-steady-state-activator-concentration-a-rho-0-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-intact-hydra-polar-column-apical-hypostome-peak-cell-index-n-40>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-sub-hypostomal-periodic-ring-tentacle-primordia-count-vs-hydra-vulgaris-specimen>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-surgical-bisection-basal-fragment-head-regeneration-recovery-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-morphometric-validation-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-amputation-s-l-2-hypostome-recovery-at-the-fragment-tip-and-head-before-ring-ordering> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D shell amputation (s = L/2): hypostome recovery at the fragment tip and head-before-ring ordering = 0.982 a_regen_max / a_intact_max" ;
        dct:description "pre-cut tip a=0.007 -> regenerated a_max=11.99 at the tip row; t_head=450.0 < t_ring=1050.0 (time units); regenerated ring at s/L_frag=0.078 with 4 peaks (b_max 1.76; fragment ring circumference 89 cells — the fragment keeps the mid-body radius, so the count is not comparable to the intact ring). LIMITATIONS: on the wide un-remodelled cut surface the new head is a localised spot (CV_theta = 0.95, not a uniform cap: no wound closure / tissue remodelling in the fixed geometry), and Meinhardt's tentacle-before-hypostome prediction is NOT reproduced (see remediation)" ;
        schema:measurementTechnique "Basal half of the intact shell continued with inherited source density; t_head = first time a(tip) > 0.5 final, t_ring = first time max b (rows >= 1) > 0.5 final" ;
        schema:name "3D shell amputation (s = L/2): hypostome recovery at the fragment tip and head-before-ring ordering" ;
        schema:unitText "a_regen_max / a_intact_max" ;
        schema:value "0.982" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-amputation-s-l-2-hypostome-recovery-at-the-fragment-tip-and-head-before-ring-ordering-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-amputation-s-l-2-hypostome-recovery-at-the-fragment-tip-and-head-before-ring-ordering-reference> a schema:PropertyValue ;
        dct:source "Meinhardt (1993) Dev. Biol. 157:321-333 & (2012): fragments regenerate a hypostome at the apical cut and a new tentacle ring directly below it" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-foot-activator-position-and-head-foot-axial-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D shell foot activator position and head-foot axial separation = 0.9889 fraction of body length" ;
        dct:description "foot row s=89 of 90 (basal disc), f_max=5.23, foot CV_theta=0.0000 (uniform basal disc)" ;
        schema:measurementTechnique "Row of maximal azimuthal-mean foot activator f minus head row, divided by L; foot drive phi_f = 1/(1+(sigma/sigma_f)^2) fires where the source density is lowest" ;
        schema:name "3D shell foot activator position and head-foot axial separation" ;
        schema:unitText "fraction of body length" ;
        schema:value "0.9889" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-foot-activator-position-and-head-foot-axial-separation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-foot-activator-position-and-head-foot-axial-separation-reference> a schema:PropertyValue ;
        dct:source "Meinhardt (2012) Int. J. Dev. Biol. 56:447-462: foot forms at the position of lowest source density opposite the head" ;
        schema:value "0.9889" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-hypostome-cap-azimuthal-coefficient-of-variation-cv-theta-a-at-the-apex> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D shell hypostome cap azimuthal coefficient of variation CV_theta(a) at the apex = 0.0025 CV (std/mean over theta)" ;
        dct:description "head row s=0 (apex), a_max=12.21, 1 axial head peak(s), sigma_apex=2.93; saturating autocatalysis kappa_h=0.02 gives the cap instead of a spot" ;
        schema:measurementTechnique "Coupled head/tentacle/foot loops on the specimen-shaped surface of revolution (L=90 cells, N_theta=64); CV of a over theta at the row of maximal azimuthal-mean a" ;
        schema:name "3D shell hypostome cap azimuthal coefficient of variation CV_theta(a) at the apex" ;
        schema:unitText "CV (std/mean over theta)" ;
        schema:value "0.0025" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-hypostome-cap-azimuthal-coefficient-of-variation-cv-theta-a-at-the-apex-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-hypostome-cap-azimuthal-coefficient-of-variation-cv-theta-a-at-the-apex-reference> a schema:PropertyValue ;
        dct:source "Meinhardt (1993) Dev. Biol. 157:321-333 & Meinhardt (2012) Int. J. Dev. Biol. 56:447-462: single azimuthally symmetric hypostome at the apex" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-sub-hypostomal-tentacle-ring-axial-offset-s-ring-l-vs-specimen-attachment-offset> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D shell sub-hypostomal tentacle ring axial offset s_ring / L vs specimen attachment offset = 0.1111 fraction of body length (0 = hypostome tip)" ;
        dct:description "prediction (not calibrated): ring rows 9-11 of 90 (width 3 rows), centroid 0.109; specimen band [0.000, 0.151]; analytic firing band phi_t > w_c = 0.1633 is rows 4-17 (simulated band inside: True)" ;
        schema:measurementTechnique "Median row of the band where max_theta b > 0.5 b_max on the intact shell; specimen: hypostome-tip -> tentacle-attachment distance / body length measured on the vendored photograph (measure_specimen_body_profile)" ;
        schema:name "3D shell sub-hypostomal tentacle ring axial offset s_ring / L vs specimen attachment offset" ;
        schema:unitText "fraction of body length (0 = hypostome tip)" ;
        schema:value "0.1111" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-sub-hypostomal-tentacle-ring-axial-offset-s-ring-l-vs-specimen-attachment-offset-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-sub-hypostomal-tentacle-ring-axial-offset-s-ring-l-vs-specimen-attachment-offset-reference> a schema:PropertyValue ;
        dct:source "Hydra vulgaris specimen (CC BY-SA 3.0) body profile: attachment band 0.070 +- 0.081 (half-thickness = attachment radius / body length); Meinhardt (1993) 'tentacles form at the border of the hypostome'" ;
        schema:value "0.07" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-tentacle-primordia-count-on-the-ring-vs-hydra-vulgaris-specimen> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D shell tentacle primordia count on the ring vs Hydra vulgaris specimen = 7 tentacle peaks" ;
        dct:description "spacing 8.78 cells (CV 0.038) = 0.0976 L vs specimen spacing/L 0.0843 (the body length L=90 was CALIBRATED so these two ratios agree; the count itself is then a geometric consequence, 7 vs 6 = +1); body-length sweep L=[64, 72, 90, 110, 131, 150] gives N=[5, 7, 7, 9, 9, 10]" ;
        schema:measurementTechnique "Periodic peak detection on the ring-averaged theta profile of b (circumference 61.5 cells at the ring row)" ;
        schema:name "3D shell tentacle primordia count on the ring vs Hydra vulgaris specimen" ;
        schema:unitText "tentacle peaks" ;
        schema:value "7" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-tentacle-primordia-count-on-the-ring-vs-hydra-vulgaris-specimen-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-tentacle-primordia-count-on-the-ring-vs-hydra-vulgaris-specimen-reference> a schema:PropertyValue ;
        dct:source "Hydra vulgaris specimen (6 segmented tentacles); Meinhardt (1993) Dev. Biol. 157:321-333" ;
        schema:value "6" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-ablation-kappa-a-0-no-head-tentacle-suppression-tentacle-activator-leak-into-the-hypostome> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Ablation kappa_a = 0 (no head->tentacle suppression): tentacle-activator leak into the hypostome = 0.0534 b(s=0) / b_max" ;
        dct:description "leak 0.0534 without suppression vs 0.0034 with (x15.8); ring centroid shifts 0.081 -> 0.109 L; kappa_a sweep [0.0, 0.3, 1.0, 3.0, 10.0] ring centroids [0.081, 0.101, 0.109, 0.116, 0.124] (Spearman rho = 1.00)" ;
        schema:measurementTechnique "Same shell, same seed, kappa_a = 0 vs default kappa_a = 1.0; apex-row tentacle activator relative to the ring maximum" ;
        schema:name "Ablation kappa_a = 0 (no head->tentacle suppression): tentacle-activator leak into the hypostome" ;
        schema:unitText "b(s=0) / b_max" ;
        schema:value "0.0534" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-ablation-kappa-a-0-no-head-tentacle-suppression-tentacle-activator-leak-into-the-hypostome-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-ablation-kappa-a-0-no-head-tentacle-suppression-tentacle-activator-leak-into-the-hypostome-reference> a schema:PropertyValue ;
        dct:source "Meinhardt (1993) Dev. Biol. 157:321-333: local inhibition of tentacle activation by the head activator excludes tentacles from the hypostome" ;
        schema:value "0.0034" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-allometric-domain-length-scaling-correlation-r-l-n-peaks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Allometric domain-length scaling correlation r(L, N_peaks) = 0.9823 Pearson r" ;
        dct:description "peak counts [2, 3, 4, 5, 6, 6, 7] across L=[22, 33, 44, 54, 64, 76, 88]; mean nonlinear wavelength = 11.39 cells, RMSE = 0.4191 peaks" ;
        schema:measurementTechnique "Linear correlation between ring circumference L in [22..86] cells and steady-state peak count N_peaks(L)" ;
        schema:name "Allometric domain-length scaling correlation r(L, N_peaks)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9823" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-allometric-domain-length-scaling-correlation-r-l-n-peaks-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-allometric-domain-length-scaling-correlation-r-l-n-peaks-reference> a schema:PropertyValue ;
        dct:source "Gierer & Meinhardt (1972) / Meinhardt (2012) Int. J. Dev. Biol. 56:447-462 wavelength invariance" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-body-length-sweep-spearman-monotonicity-of-tentacle-number-with-shell-size> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Body-length sweep: Spearman monotonicity of tentacle number with shell size = 0.971 Spearman rho" ;
        dct:description "N(L) = [5, 7, 7, 9, 9, 10]; intrinsic spacing ~8.4 cells set by the tentacle-inhibitor range l_c = sqrt(D_c/mu_h) = 3.87 cells" ;
        schema:measurementTechnique "Intact shells at L in [64, 72, 90, 110, 131, 150] cells (specimen radius profile rescaled), tentacle primordia counted on the ring" ;
        schema:name "Body-length sweep: Spearman monotonicity of tentacle number with shell size" ;
        schema:unitText "Spearman rho" ;
        schema:value "0.971" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-body-length-sweep-spearman-monotonicity-of-tentacle-number-with-shell-size-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-body-length-sweep-spearman-monotonicity-of-tentacle-number-with-shell-size-reference> a schema:PropertyValue ;
        dct:source "Model prediction consistent with size-dependent tentacle number in Hydra (Meinhardt 1993 discussion); not quantitatively validated against a size series" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-equal-diffusion-negative-control-d-a-d-h-0-015-activator-spatial-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Equal-diffusion negative control (D_a = D_h = 0.015) activator spatial std = 0.0 concentration std" ;
        dct:description "0 peaks formed in equal-diffusion control (std = 1.80e-15) vs 6 peaks in supercritical ring (std = 1.154)" ;
        schema:measurementTechnique "Ablation control with D_a = D_h = 0.015 (d = 1.0 < d_c = 5.8284) from identical initial perturbation" ;
        schema:name "Equal-diffusion negative control (D_a = D_h = 0.015) activator spatial std" ;
        schema:unitText "concentration std" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-equal-diffusion-negative-control-d-a-d-h-0-015-activator-spatial-std-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-equal-diffusion-negative-control-d-a-d-h-0-015-activator-spatial-std-reference> a schema:PropertyValue ;
        dct:source "Gierer & Meinhardt (1972) lateral inhibition necessity theorem (Lean 4 gierer_meinhardt_equal_diffusion_stable)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c-sqrt-2-1-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gierer-Meinhardt critical diffusivity ratio d_c = (sqrt(2)+1)^2 = 5.8284 D_h / D_a" ;
        dct:description "canonical d = 30.0 > d_c (max Re sigma = +0.00864); equal-diffusion control d = 1.0 has max Re sigma = -0.00500" ;
        schema:measurementTechnique "Exact analytical Turing-Gierer-Meinhardt threshold (3 + 2*sqrt(2)) at mu_h > mu_a" ;
        schema:name "Gierer-Meinhardt critical diffusivity ratio d_c = (sqrt(2)+1)^2" ;
        schema:unitText "D_h / D_a" ;
        schema:value "5.8284" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c-sqrt-2-1-2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c-sqrt-2-1-2-reference> a schema:PropertyValue ;
        dct:source "Gierer & Meinhardt (1972) Kybernetik 12(1):30-39 Eqs. (15a)-(15b)" ;
        schema:value "5.8284" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-homogeneous-steady-state-activator-concentration-a-rho-0-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Homogeneous steady-state activator concentration a_* (rho_0 = 0) = 1.5 concentration units" ;
        dct:description "homogeneous Jacobian tr(J_0) = -0.0100 < 0, det(J_0) = 0.00140 > 0" ;
        schema:measurementTechnique "Exact steady-state formula a_* = (c / c_prime) * (mu_h / mu_a) with h_* = (mu_h / mu_a)^2 = 2.25" ;
        schema:name "Homogeneous steady-state activator concentration a_* (rho_0 = 0)" ;
        schema:unitText "concentration units" ;
        schema:value "1.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-homogeneous-steady-state-activator-concentration-a-rho-0-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-homogeneous-steady-state-activator-concentration-a-rho-0-0-reference> a schema:PropertyValue ;
        dct:source "Gierer & Meinhardt (1972) Kybernetik 12(1):30-39 Eq. (15)" ;
        schema:value "1.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-intact-hydra-polar-column-apical-hypostome-peak-cell-index-n-40> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Intact Hydra polar column apical hypostome peak cell index (N=40) = 0 cell index (0=apical head)" ;
        dct:description "intact apical peak a_max = 9.533 vs suppressed basal half max = 0.0460" ;
        schema:measurementTechnique "argmax_x a(x, T) on 40-cell polar column (D_a=0.03, D_h=6.0, source slope=-0.20)" ;
        schema:name "Intact Hydra polar column apical hypostome peak cell index (N=40)" ;
        schema:unitText "cell index (0=apical head)" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-intact-hydra-polar-column-apical-hypostome-peak-cell-index-n-40-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-intact-hydra-polar-column-apical-hypostome-peak-cell-index-n-40-reference> a schema:PropertyValue ;
        dct:source "Gierer & Meinhardt (1972) Kybernetik 12(1):30-39 Fig. 2 (apical dominance)" ;
        schema:value "0" .

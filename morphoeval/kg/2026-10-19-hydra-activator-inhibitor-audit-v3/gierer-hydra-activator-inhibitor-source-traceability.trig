sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) & Meinhardt (1993, 2012) Hydra vulgaris activator-inhibitor morphogenesis, head regeneration, tentacle ring & coupled three-system 3D shell — Source and data traceability: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "All four DOIs resolve and are repeated in the bib, README and JSON; the specimen, scout manifest and bib stay SHA-256 pinned (L147-176) and the reference JSON's digest is recorded by the measurement sidecar. Pass 3 fixed a real defect: the JSON `hydra_regimes_and_experiments` block had never matched the code and is now in parity and asserted in self-test check 9 (L1922-1943), and the new `three_system_cylindrical_shell` block pins every shell parameter and the firing threshold. Deductions: the reference JSON is still not in EXPECTED_SHA256 (only hashed, L169-172), so it can drift silently between runs (-3); the Pass 3 three-system forms cite Meinhardt (1993) and (2012) without page or equation numbers (-3); the `expected_peak_counts` of the domain sweep are now the observed outputs written back into the JSON (tautological parity) (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-source-traceability-4> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L147–L176" ;
        dct:description "EXPECTED_SHA256 for specimen / scout / bib with runtime verification; reference JSON hashed but not pinned" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L147-L176> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L1922–L1943" ;
        dct:description "Self-test check 9: JSON-to-code parity for the 1D regimes and every THREE_SYSTEM_PARAMS entry, firing threshold and sweep lists" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L1922-L1943> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/hydra_activator_inhibitor/hydra_activator_inhibitor_reference.json L92–L187" ;
        dct:description "Corrected regimes block (with parity note) and new three_system_cylindrical_shell block with parameters, calibration statement, specimen references and expected outcomes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/datasets/hydra_activator_inhibitor/hydra_activator_inhibitor_reference.json#L92-L187> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/hydra_activator_inhibitor/README.md L27–L55" ;
        dct:description "Pass 3 section documenting geometry, operator, loops, declared calibration and Lean theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/datasets/hydra_activator_inhibitor/README.md#L27-L55> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1006/dbio.1993.1138>,
            <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1242/jcs.15.2.321>,
            <https://doi.org/10.1387/ijdb.113483hm> .
    <https://doi.org/10.1006/dbio.1993.1138> dct:date "1993"^^xsd:gYear ;
        dct:title "A model for pattern formation of hypostome, tentacles, and foot in hydra: how to form structures close to each other, how to form them at a distance" .
    <https://doi.org/10.1007/BF00289234> dct:date "1972"^^xsd:gYear ;
        dct:title "A theory of biological pattern formation" .
    <https://doi.org/10.1242/jcs.15.2.321> dct:date "1974"^^xsd:gYear ;
        dct:title "Applications of a theory of biological pattern formation based on lateral inhibition" .
    <https://doi.org/10.1387/ijdb.113483hm> dct:date "2012"^^xsd:gYear ;
        dct:title "Modeling pattern formation in hydra: a route to understanding essential steps in development" .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) & Meinhardt (1993, 2012) Hydra vulgaris activator-inhibitor morphogenesis, head regeneration, tentacle ring & coupled three-system 3D shell — Parameter expressivity: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Pass 2 sweeps remain (diffusivity ratio across d_c, domain length). Pass 3 adds two sweeps of genuine three-system parameters with monotone, verified effects: the head->tentacle suppression kappa_a in {0, 0.3, 1, 3, 10} shifts the ring centroid basally (0.072 -> 0.122 L, Spearman rho = 1.00) and the kappa_a = 0 ablation lets tentacle activator leak into the hypostome (L1123-1144, Panel E1); the body length L in {64..150} raises the tentacle number 5 -> 10 (rho = 0.97, Panel E2); --shell-length, --shell-steps and --kappa-a are exposed on the CLI (L2008-2010). Deductions: the kappa_a effect on ring position is small (0.05 L over three decades) because the tentacle inhibitor already excludes the apex (-4); the count sweep jumps 5 -> 7 and never produces the specimen's 6 (-3); the tentacle-inhibitor range D_c, the most obvious \"number of tentacles\" knob, is not swept in the shell (in prototyping it changed amplitude but not count), so what controls the count is geometry, not kinetics, and this is not shown (-3); sigma_t, p_t and sigma_f (which set the ring and foot positions) have no sweep or CLI flag (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1972-gierer-hydra-activator-inhibitor.py L788–L799: sigma_t, p_t, sigma_f, D_c fixed in THREE_SYSTEM_PARAMS without sweep or CLI exposure <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L788-L799>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L1123–L1144" ;
        dct:description "kappa_a sweep incl. ablation; Spearman of ring centroid vs kappa_a" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L1123-L1144> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L1146–L1166" ;
        dct:description "Body-length sweep L in {64,72,90,110,131,150}: tentacle count, spacing and Spearman" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L1146-L1166> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L2008–L2010" ;
        dct:description "CLI flags --shell-length / --shell-steps / --kappa-a wired into render_outputs()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L2008-L2010> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1006/dbio.1993.1138>,
            <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1242/jcs.15.2.321>,
            <https://doi.org/10.1387/ijdb.113483hm> .
    <https://doi.org/10.1006/dbio.1993.1138> dct:date "1993"^^xsd:gYear ;
        dct:title "A model for pattern formation of hypostome, tentacles, and foot in hydra: how to form structures close to each other, how to form them at a distance" .
    <https://doi.org/10.1007/BF00289234> dct:date "1972"^^xsd:gYear ;
        dct:title "A theory of biological pattern formation" .
    <https://doi.org/10.1242/jcs.15.2.321> dct:date "1974"^^xsd:gYear ;
        dct:title "Applications of a theory of biological pattern formation based on lateral inhibition" .
    <https://doi.org/10.1387/ijdb.113483hm> dct:date "2012"^^xsd:gYear ;
        dct:title "Modeling pattern formation in hydra: a route to understanding essential steps in development" .
}


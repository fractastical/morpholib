sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) & Meinhardt (1993, 2012) Hydra vulgaris activator-inhibitor morphogenesis, head regeneration, tentacle ring & coupled three-system 3D shell — Morphological realism / specimen match: 87/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The rendered figure now puts the model and the specimen side by side at three levels: the segmented photograph with its 6 tentacles and body axis (Panel C1), the azimuthal luminance profile vs the 1D ring (C2), and in Pass 3 a 3D shell whose silhouette IS the specimen's radius profile, coloured by the three activators (D1), with the unrolled map showing the tentacle ring inside the specimen's attachment band (D2) and the ring position plotted against that band under the kappa_a sweep (E1). The hypostome cap is azimuthally uniform and the foot sits at the basal disc as in the animal. Deductions: the shell gives 7 tentacle primordia where the specimen has 6, and the body length that makes the spacing match is a calibration (L800, L1733-1742) (-5); the ring offset 0.111 is inside but not at the centre of the specimen band 0.070 +- 0.081 (-2); the regenerated hypostome on the wide cut surface is a spot (CV_theta 0.95, E3) unlike the dome of a regenerating polyp (-3); a single specimen photographed obliquely supplies all references, and the attachment radius (23 px) comes from a 0.98 tissue-fraction threshold rather than an anatomical landmark (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1972-gierer-hydra-activator-inhibitor.py L800–L805: SHELL_DEFAULT_LENGTH_CELLS = 90 is the declared scale calibration; the resulting 7 tentacles vs 6 on the specimen is a mismatch <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L800-L805>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-specimen-match-3> ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/hydra_activator_inhibitor_comparison.png (generated output)" ;
        dct:description "Panels C1/D1/D2/E1/E3: specimen segmentation, specimen-shaped 3D shell with red cap / cyan 7-spot ring / green foot, unrolled map with the specimen attachment band, regeneration map — docs/media/hydra_activator_inhibitor_comparison.png: rendered output of 1972-gierer-hydra-activator-inhibitor.py at 4d5512d, image/png, 1290720 B, 2227×3037 px, artifact_sha256 e0c4e97130d2627ad31b6cf098d20e0b26bcc7658a7b2fcd94ffe4d9c9d8bc3d (sha256 e0c4e97130d2627ad31b6cf098d20e0b26bcc7658a7b2fcd94ffe4d9c9d8bc3d), spec_fingerprint 49a5051749b0c67e34c6eeaa4fb8201bc071879dc58596403d8aa74086bc42c4" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L695–L785" ;
        dct:description "measure_specimen_body_profile: tip/basal-disc walk, distance-transform radius profile r(s), attachment radius (tissue fraction < 0.98), spacing / body length" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L695-L785> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L1403–L1467" ;
        dct:description "Panel D1 3D surface of revolution from grid.surface_xyz() and Panel D2 unrolled map with specimen attachment band" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L1403-L1467> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1006/dbio.1993.1138>,
            <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1242/jcs.15.2.321>,
            <https://doi.org/10.1387/ijdb.113483hm> .
    <https://doi.org/10.1006/dbio.1993.1138> dct:date "1993"^^xsd:gYear ;
        dct:title "A model for pattern formation of hypostome, tentacles, and foot in hydra: how to form structures close to each other, how to form them at a distance" .
    <https://doi.org/10.1007/BF00289234> dct:date "1972"^^xsd:gYear ;
        dct:title "A theory of biological pattern formation" .
    <https://doi.org/10.1242/jcs.15.2.321> dct:date "1974"^^xsd:gYear ;
        dct:title "Applications of a theory of biological pattern formation based on lateral inhibition" .
    <https://doi.org/10.1387/ijdb.113483hm> dct:date "2012"^^xsd:gYear ;
        dct:title "Modeling pattern formation in hydra: a route to understanding essential steps in development" .
}


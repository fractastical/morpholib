<https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-amputation-s-l-2-hypostome-recovery-at-the-fragment-tip-and-head-before-ring-ordering> a schema:PropertyValue,
        pk1:EvidenceItem ;
    rdfs:label "3D shell amputation (s = L/2): hypostome recovery at the fragment tip and head-before-ring ordering = 0.982 a_regen_max / a_intact_max" ;
    dct:description "pre-cut tip a=0.007 -> regenerated a_max=11.99 at the tip row; t_head=450.0 < t_ring=1050.0 (time units); regenerated ring at s/L_frag=0.078 with 4 peaks (b_max 1.76; fragment ring circumference 89 cells — the fragment keeps the mid-body radius, so the count is not comparable to the intact ring). LIMITATIONS: on the wide un-remodelled cut surface the new head is a localised spot (CV_theta = 0.95, not a uniform cap: no wound closure / tissue remodelling in the fixed geometry), and Meinhardt's tentacle-before-hypostome prediction is NOT reproduced (see remediation)" ;
    schema:measurementTechnique "Basal half of the intact shell continued with inherited source density; t_head = first time a(tip) > 0.5 final, t_ring = first time max b (rows >= 1) > 0.5 final" ;
    schema:name "3D shell amputation (s = L/2): hypostome recovery at the fragment tip and head-before-ring ordering" ;
    schema:unitText "a_regen_max / a_intact_max" ;
    schema:value "0.982" ;
    schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-3d-shell-amputation-s-l-2-hypostome-recovery-at-the-fragment-tip-and-head-before-ring-ordering-reference> .


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L1862–L2001" ;
        dcterms:description "14-check self_test() covering SHA-256, parity, 1D regimes, specimen, shell, sweeps, regeneration and determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L1862-L2001> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L1986–L1990" ;
        dcterms:description "Bitwise determinism of the shell solver (two 200-step runs compared with np.array_equal)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L1986-L1990> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/hydra_activator_inhibitor_growth.gif (generated output)" ;
        dcterms:description "60-frame GIF: Phase 1 intact column + ring, Phase 2 bisection regeneration, Phase 3 shell development and fragment regeneration — docs/media/hydra_activator_inhibitor_growth.gif: rendered output of 1972-gierer-hydra-activator-inhibitor.py at 4d5512d, image/gif, 1009104 B, 792×342 px, 60 frames, artifact_sha256 1a530c77e9c827988f1ab2e4a692e926fa3aed4a72679bdb190cb21b0cfe2c8b (sha256 1a530c77e9c827988f1ab2e4a692e926fa3aed4a72679bdb190cb21b0cfe2c8b), spec_fingerprint 49a5051749b0c67e34c6eeaa4fb8201bc071879dc58596403d8aa74086bc42c4" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) & Meinhardt (1993, 2012) Hydra vulgaris activator-inhibitor morphogenesis, head regeneration, tentacle ring & coupled three-system 3D shell — Reproducibility package: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Deterministic seed 1972 throughout; 14-check `--self-test` (L1862-2001) including bitwise determinism of both the 1D solver and the shell solver (FFT + banded solve, L1986-1990), JSON parity, analytic-threshold consistency and every Pass 3 behaviour; CLI documented in argparse; render ~53 s and self-test ~35 s on the pinned venv whose versions are now recorded correctly in this audit. Deductions: no requirements lock file is shipped for this script (-3); the README invocation notes in the dataset describe the model but not the CLI flags or runtimes (-2); `measure_morphoeval()` re-runs the whole ~40 s shell set, and self-test and render each run it again, so a full Pass costs ~2 min of recomputation without caching (-2); matplotlib emits a font-cache warning unless MPLCONFIGDIR is set (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-repro-package-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


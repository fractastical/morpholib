sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L27–L113" ;
        dcterms:description "Docstring §2 Lean theorem list and §2b three-system shell equations, operator, threshold and reproduced features" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L27-L113> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/gierer-hydra-activator-inhibitor.yaml L95–L187" ;
        dcterms:description "Laws 4-7 registered with lean_decl/lean_theorem/lean_locus/lean_code and code_locus pinned to the current file" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/morphoeval/math_kg_loops/gierer-hydra-activator-inhibitor.yaml#L95-L187> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) & Meinhardt (1993, 2012) Hydra vulgaris activator-inhibitor morphogenesis, head regeneration, tentacle ring & coupled three-system 3D shell — Code-to-model traceability: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module docstring (L1-131) maps every section to its equations and figures, including a new §2b that writes out the three-system equations, the operator, the analytic threshold and what the shell does and does not reproduce; every shell function carries a docstring naming its role; the math KG now registers 7 laws with Lean and code loci that were re-pinned to the current line numbers. Deductions: the three-system coupling functions cite Meinhardt (1993) by section title (\"how to form structures close to each other\") rather than equation (-4); the kappa_head saturation, Hill exponents and the `1e-5..250` clipping are untraced numerical choices (-3); the Pass 2 docstring statistics were stale until this pass (now corrected), which shows the docstring is not generated from the measurements (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1972-gierer-hydra-activator-inhibitor.py L913–L923: tentacle_drive / foot_drive docstrings state the functional form and its purpose but cite no equation of Meinhardt (1993) <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L913-L923>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-code-traceability-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


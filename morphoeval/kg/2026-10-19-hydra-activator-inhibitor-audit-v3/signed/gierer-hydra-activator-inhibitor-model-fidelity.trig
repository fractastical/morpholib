sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L187–L268" ;
        dcterms:description "Exact Gierer-Meinhardt homogeneous steady state, Jacobian J_0, d_c = (sqrt(2)+1)^2 and dispersion sigma(k) (unchanged from v2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L187-L268> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L827–L886" ;
        dcterms:description "CylindricalShellGrid: Laplace-Beltrami (1/r) d_s(r d_s) + (1/r^2) d_theta^2 with exact Fourier theta step and backward-Euler tridiagonal s step" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L827-L886> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L925–L978" ;
        dcterms:description "simulate_three_system_shell: head (a,h), tentacle (b,c), foot (f,g) loops with basal inhibitor production and source density sigma raised by a" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L925-L978> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_001_hydra_activator_inhibitor.lean L96–L198" ;
        dcterms:description "5 new Lean 4 theorems (firing-threshold discriminant antitone + instance, tentacle-drive monotonicity, head-foot exclusion, shell Laplacian conserves constants); 0 sorrys" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/morphoeval/lean/loops/Loop_001_hydra_activator_inhibitor.lean#L96-L198> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) & Meinhardt (1993, 2012) Hydra vulgaris activator-inhibitor morphogenesis, head regeneration, tentacle ring & coupled three-system 3D shell — Model fidelity to source: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The Gierer & Meinhardt (1972) part is unchanged and exact: steady state, Jacobian, d_c = (sqrt(2)+1)^2, dispersion (L187-268), 1D column / bisection / ring (L298-533), backed by 3 Lean theorems. Pass 3 adds the requested mechanism: three coupled activator-inhibitor loops plus source density on a 3D surface of revolution with the correct Laplace-Beltrami operator (L827-886, L925-978), each loop given a stable off state by basal inhibitor production so that the tentacle band and the foot are placed by an analytic threshold w_c (L808-825) that the self-test verifies against the simulated band (L1964-1965). Deductions: the coupling functions and all 20 coefficients in THREE_SYSTEM_PARAMS (L788-799) are the script's reduced forms, cited to Meinhardt (1993) only qualitatively, not the paper's appendix equations (-4); the shell is finite-difference with fixed geometry, not the finite-element shell the v2 item asked for (-2); the foot -> source-density feedback of Meinhardt's scheme is absent and the sigma equation relaxes to a prescribed exp(-4s/L) profile (-2); Meinhardt's tentacle-first regeneration is not reproduced because tentacle gating requires sigma to rise under the new head first (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1972-gierer-hydra-activator-inhibitor.py L788–L799: THREE_SYSTEM_PARAMS: 20 coefficients and Hill constants chosen by this implementation, not digitised from Meinhardt (1993) <https://github.com/fractastical/morpholib/blob/4d5512d/1972-gierer-hydra-activator-inhibitor.py#L788-L799>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity-4> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-streichan-global-morphogenetic-flow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Streichan et al. (2018), Mayer et al. (2010), Lefebvre et al. (2023) & Brauns et al. (2024) Drosophila global morphogenetic flow, curved-surface active nematic myosin mechanics & cell intercalation — Morphological realism / specimen match: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Unchanged from v2: the CC BY 4.0 IDR0151 confocal micrograph is SHA-256-pinned and segmented automatically (L1125-L1190; AP/DV = 2.3853 vs 2.3810, solidity 0.9383, 8 pair-rule stripes at 75.86 px, PMG indentation 122 px) and shown in Panel F of the main figure. Pass 3 adds no new specimen comparison; the prolate geometry a/b = 2.381 used by the curved solver is the biological value, not fitted to the specimen's 2.3853." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2018-streichan-global-morphogenetic-flow.py L1125–L1190" ;
        dct:description "Automated confocal blastoderm contour, 8 pair-rule stripe, and PMG invagination CV segmentation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L1125-L1190> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/global_morphogenetic_flow_comparison.png (generated output)" ;
        dct:description "Panel F shows the segmented IDR0151 specimen with stripe peaks and PMG sink; Panel D shows empirical vs simulated v_AP bars — docs/media/global_morphogenetic_flow_comparison.png: rendered output of 2018-streichan-global-morphogenetic-flow.py at f18e3533, image/png, 890697 B, 2464×1470 px, artifact_sha256 c2b12d9cc11f49cbc76202021e27a120ea25ff2713abd4ee312c77cb90e82127 (sha256 c2b12d9cc11f49cbc76202021e27a120ea25ff2713abd4ee312c77cb90e82127), spec_fingerprint c6f91e927b85c9e6c96461d53e4ae9c082d9c0ad9d74ed650b6b2f21fb08b782" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


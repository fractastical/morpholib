<https://w3id.org/delphi/resource/math-law/streichan-global-morphogenetic-flow-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Positive-Definite Compressible Stokes-Brinkman Fourier Operator Invertibility" ;
    dct:description "Proves that vitelline friction xi > 0 and shear viscosity eta > 0 render both transverse shear and longitudinal compressible Stokes-Brinkman symbols strictly positive-definite across all wavenumbers including k = 0, guaranteeing a unique global Green's function velocity solution | Variables: v(x, y): 2D cartographic blastoderm velocity field; eta, eta_b: 2D shear and bulk tissue viscosities; xi = eta / ell_H^2: vitelline membrane friction coefficient; k = (kx, ky): spatial Fourier wavevector" ;
    dct:source "Streichan et al. (2018) eLife 7:e27454 Eq. 1, Fig. 2; Mayer et al. (2010) Nature 467:617-621 Eq. 1" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L115-L210>,
        <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L21-L65> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def stokes_brinkman_transverse_symbol (eta xi kx ky : Int) : Int :=
  eta * (kx * kx + ky * ky) + xi
def stokes_brinkman_longitudinal_symbol (eta eta_b xi kx ky : Int) : Int :=
  (eta + eta_b) * (kx * kx + ky * ky) + xi
theorem stokes_brinkman_fourier_operator_pos_def
    (eta eta_b xi kx ky : Int)
    (hEta : eta > 0) (hEtaB : eta_b ≥ 0) (hXi : xi > 0) :
    stokes_brinkman_transverse_symbol eta xi kx ky ≥ xi ∧
    stokes_brinkman_transverse_symbol eta xi kx ky > 0 ∧
    stokes_brinkman_longitudinal_symbol eta eta_b xi kx ky ≥
      stokes_brinkman_transverse_symbol eta xi kx ky ∧
    stokes_brinkman_longitudinal_symbol eta eta_b xi kx ky > 0"""^^pk:lean4 ;
    skos:notation "eta * nabla^2 v + eta_b * nabla(nabla . v) - xi * v = -nabla . sigma^a;  lambda_L(k) = (eta + eta_b)|k|^2 + xi >= lambda_T(k) = eta|k|^2 + xi >= xi > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
        <https://doi.org/10.1038/nature02590>,
        <https://doi.org/10.1038/nature09376>,
        <https://doi.org/10.7554/eLife.27454>,
        <https://doi.org/10.7554/eLife.78787>,
        <https://doi.org/10.7554/eLife.95521> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
    pk:leanDeclaration "MathOfBiology.Loop_048.stokes_brinkman_transverse_symbol" ;
    pk:leanTheorem "MathOfBiology.Loop_048.stokes_brinkman_fourier_operator_pos_def" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/streichan-global-morphogenetic-flow-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Trace-Free Active Nematic Myosin Tensor & Quadrupolar Convergent-Extension Law" ;
    dct:description "Proves that trace-free DV myosin cable polarization (Q_{yy} > 0, Q_{xx} = -Q_{yy} < 0) creates simultaneous DV contraction and AP extension forces, whereas maternal/pair-rule anisotropy collapse (Q_{yy} = 0) abolishes quadrupolar convergent-extension shear flow | Variables: m(x): cortical Myosin-II concentration; Q_{ij} = n_i n_j - 0.5 delta_{ij}: 2D trace-free nematic orientation tensor; alpha_iso, alpha_aniso: isotropic and anisotropic active stress couplings; f_x = -d_x sigma^a_{xx}: active AP extension force density" ;
    dct:source "Streichan et al. (2018) eLife 7:e27454 Eq. 2, Figs. 2-4; Lefebvre et al. (2023) eLife 12:e78787 Figs. 1-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L215-L310>,
        <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L67-L120> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def active_stress_xx (alpha_iso alpha_aniso m Q_xx : Int) : Int :=
  alpha_iso * m + alpha_aniso * m * Q_xx
def active_stress_yy (alpha_iso alpha_aniso m Q_yy : Int) : Int :=
  alpha_iso * m + alpha_aniso * m * Q_yy
def active_ap_extension_force (alpha_aniso Q_yy dm_dx : Int) : Int :=
  alpha_aniso * Q_yy * dm_dx
theorem nematic_dv_cable_trace_free_and_ap_extension
    (alpha_iso alpha_aniso m Q_xx Q_yy dm_dx : Int)
    (hTraceFree : Q_xx + Q_yy = 0) (hAlpha : alpha_aniso > 0)
    (hM : m > 0) (hQyy : Q_yy > 0) (hGrad : dm_dx > 0) :
    Q_xx = -Q_yy ∧
    active_stress_yy alpha_iso alpha_aniso m Q_yy >
      active_stress_xx alpha_iso alpha_aniso m Q_xx ∧
    active_ap_extension_force alpha_aniso Q_yy dm_dx > 0 ∧
    active_stress_yy alpha_iso alpha_aniso m 0 =
      active_stress_xx alpha_iso alpha_aniso m 0 ∧
    active_ap_extension_force alpha_aniso 0 dm_dx = 0"""^^pk:lean4 ;
    skos:notation "sigma^a_{ij} = alpha_iso * m * delta_{ij} + alpha_aniso * m * Q_{ij}, Tr(Q) = Q_{xx} + Q_{yy} = 0;  Q_{yy} > 0 => sigma^a_{yy} > sigma^a_{xx} & f_x = alpha_aniso * Q_{yy} * d_x m > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
        <https://doi.org/10.1038/nature02590>,
        <https://doi.org/10.1038/nature09376>,
        <https://doi.org/10.7554/eLife.27454>,
        <https://doi.org/10.7554/eLife.78787>,
        <https://doi.org/10.7554/eLife.95521> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
    pk:leanDeclaration "MathOfBiology.Loop_048.active_ap_extension_force" ;
    pk:leanTheorem "MathOfBiology.Loop_048.nematic_dv_cable_trace_free_and_ap_extension" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/streichan-global-morphogenetic-flow-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Streichan et al. (2018) Global Flow Prediction & Mutant Hierarchy" ;
    dct:description "Proves that coupling DV anisotropic myosin cables with posterior midgut invagination predicts >90% of global embryonic flow and strictly orders wild-type, twist/snail, anisotropic-only, eve, isotropic-only, and bcd nos tsl maternal-null velocity fields | Variables: phi_aniso, phi_pmg, phi_ectoderm: activation indicators for DV anisotropic myosin cables, posterior midgut isotropic apical constriction, and ventral mesoderm; r: global spatial velocity correlation; v_AP: peak posterior GBE flow velocity (um/min)" ;
    dct:source "Streichan et al. (2018) eLife 7:e27454 Figs. 2-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L315-L510>,
        <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L122-L168> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def streichan_flow_v100 (phi_aniso phi_pmg phi_ectoderm : Int) : Int :=
  495 * phi_aniso + 145 * phi_pmg - 75 * (1 - phi_ectoderm) * phi_aniso
theorem streichan_2018_global_flow_and_mutant_collapse :
    v100_wt_gbe = 640 ∧ v100_twi_sna = 565 ∧ v100_aniso_only = 495 ∧
    v100_bcd_nos_tsl = 0 ∧ r1000_wt_gbe > 900 ∧
    v100_wt_gbe > v100_twi_sna ∧ v100_twi_sna > v100_aniso_only ∧
    v100_aniso_only > v100_eve_mutant ∧ v100_eve_mutant > v100_iso_only ∧
    v100_iso_only > v100_bcd_nos_tsl"""^^pk:lean4 ;
    skos:notation "r_WT (0.924) > r_twi_sna (0.892) > r_aniso_only (0.835) > r_eve (0.562) > r_iso_only (0.415) > r_bcd_nos_tsl (0.000)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
        <https://doi.org/10.1038/nature02590>,
        <https://doi.org/10.1038/nature09376>,
        <https://doi.org/10.7554/eLife.27454>,
        <https://doi.org/10.7554/eLife.78787>,
        <https://doi.org/10.7554/eLife.95521> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
    pk:leanDeclaration "MathOfBiology.Loop_048.streichan_flow_v100" ;
    pk:leanTheorem "MathOfBiology.Loop_048.streichan_2018_global_flow_and_mutant_collapse" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/streichan-global-morphogenetic-flow-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Curved-Surface Stokes-Brinkman Operator on the Prolate Spheroid & Sphere-Limit Gradient-Mode Eigenvalue" ;
    dct:description "Proves that the Gaussian-curvature correction -2 eta K generated by the covariant strain tensor on the closed blastoderm surface never destabilises the Stokes-Brinkman operator (eigenvalue >= xi > 0 for every l >= 1); this eigenvalue is the analytic target of the Pass 3 sphere-limit convergence check (observed order 2.04) | Variables: v: tangent velocity on the prolate spheroid (a = 250 um, b = 105 um); Delta_B: Bochner Laplacian; K: Gaussian curvature (Ricci identity term); e_ab = 1/2 (e_a . d_b v + e_b . d_a v): covariant strain from the embedded tangent basis; l: spherical-harmonic degree; xiR2 = xi R^2" ;
    dct:source "Streichan et al. (2018) eLife 7:e27454 Eq. 1 lifted to the curved surface; Lefebvre et al. (2023) eLife 12:e78787 (ellipsoidal geometry); Weitzenboeck/Bochner identity" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L491-L868>,
        <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L182-L209> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def surface_gradient_mode_symbol (eta eta_b xiR2 l : Int) : Int :=
  (eta + eta_b) * (l * (l + 1)) - 2 * eta + xiR2
theorem surface_stokes_brinkman_gradient_mode_pos
    (eta eta_b xiR2 l : Int)
    (hEta : eta > 0) (hEtaB : eta_b ≥ 0) (hXi : xiR2 > 0) (hL : l ≥ 1) :
    surface_gradient_mode_symbol eta eta_b xiR2 l ≥ xiR2 ∧
    surface_gradient_mode_symbol eta eta_b xiR2 l > 0"""^^pk:lean4 ;
    skos:notation "-eta Delta_B v - eta_b grad(div v) - eta K v + xi v = div sigma^a on x^2/a^2 + (y^2+z^2)/b^2 = 1, K = a^2/g_ss^2;  on a sphere: v = grad P_l  =>  R^2 lambda_l = (eta + eta_b) l(l+1) - 2 eta + xi R^2 >= xi R^2 > 0 for l >= 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
        <https://doi.org/10.1038/nature02590>,
        <https://doi.org/10.1038/nature09376>,
        <https://doi.org/10.7554/eLife.27454>,
        <https://doi.org/10.7554/eLife.78787>,
        <https://doi.org/10.7554/eLife.95521> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
    pk:leanDeclaration "MathOfBiology.Loop_048.surface_gradient_mode_symbol" ;
    pk:leanTheorem "MathOfBiology.Loop_048.surface_stokes_brinkman_gradient_mode_pos" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/streichan-global-morphogenetic-flow-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Strain-Rate-Dependent Positive-Feedback Myosin-II Recruitment Fixed Point" ;
    dct:description "Proves that the Lefebvre et al. (2023)-type mechanical positive feedback implemented in solve_prolate_blastoderm_flow has a unique bounded amplifying fixed point exactly when the loop gain is below 1 (measured g = 0.358, m*/m_0 = 1.70) and diverges otherwise | Variables: m_0: basal pair-rule-patterned cable myosin; e_nn = e_phiphi: strain rate along the DV director (negative = contraction); beta, e_ref: feedback strength and reference strain rate; g = p/q: loop gain; M: fixed-point myosin level" ;
    dct:source "Lefebvre et al. (2023) eLife 12:e78787 (geometric/mechanical control of myosin recruitment; reduced linear-feedback form is a modelling assumption)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L757-L838>,
        <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L211-L240> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """theorem myosin_feedback_fixed_point
    (m0 p q M : Int)
    (hM0 : m0 > 0) (hP : p ≥ 0) (hQ : q > 0) :
    (p < q → q * M = q * m0 + p * M → (q - p) * M = q * m0 ∧ M ≥ m0) ∧
    (p ≥ q → M ≥ 0 → q * M ≠ q * m0 + p * M)"""^^pk:lean4 ;
    skos:notation "m_{n+1} = m_0 (1 + beta max(0, -e_nn[m_n]) / e_ref);  linearised gain g = p/q:  0 <= p < q  =>  (q - p) M = q m_0, M >= m_0 (bounded amplifying fixed point m* = m_0/(1-g));  p >= q  =>  no fixed point M >= 0 (run-away)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
        <https://doi.org/10.1038/nature02590>,
        <https://doi.org/10.1038/nature09376>,
        <https://doi.org/10.7554/eLife.27454>,
        <https://doi.org/10.7554/eLife.78787>,
        <https://doi.org/10.7554/eLife.95521> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
    pk:leanDeclaration "MathOfBiology.Loop_048.myosin_feedback_fixed_point" ;
    pk:leanTheorem "MathOfBiology.Loop_048.myosin_feedback_fixed_point" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/streichan-global-morphogenetic-flow-6> a skos:Concept,
        pk:Concept ;
    rdfs:label "T1 / Rosette Resolution Junction Balance (Discrete Convergent Extension)" ;
    dct:description "Proves the junction bookkeeping used by simulate_intercalation_ledger: junction number is conserved while AP-minus-DV junction anisotropy increases by 2k per event, so cumulative T1/rosette events are the discrete source of the intercalation extension lambda_int = 1 + T/(N_ap N_dv) in the tension-isogonal decomposition | Variables: k: number of consecutive DV-oriented junctions of one Myosin-II cable collapsing into a single vertex; r = k + 3: rosette order (cells); j_ap, j_dv: counts of AP- and DV-oriented junctions in the trunk lattice" ;
    dct:source "Bertet, Sulak & Lecuit (2004) Nature 429:667-671 Fig. 1; Blankenship et al. (2006) Dev Cell 11:459-470; Brauns et al. (2024) eLife 13:RP95521" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L870-L995>,
        <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L242-L254> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """theorem rosette_resolution_junction_balance
    (k j_ap j_dv : Int) (hK : k ≥ 1) :
    (k + 3) ≥ 4 ∧ ((k + 3) - 3) = k ∧ ((k + 3) - 2) = k + 1 ∧
    ((k ≥ 2) ↔ (k + 3) ≥ 5) ∧
    (j_ap + k) + (j_dv - k) = j_ap + j_dv ∧
    (j_ap + k) - (j_dv - k) = (j_ap - j_dv) + 2 * k"""^^pk:lean4 ;
    skos:notation "k >= 1 collapsed DV junctions -> rosette of r = k + 3 cells (k = 1: T1, r = 4; Blankenship rosettes r >= 5 <=> k >= 2); resolution -> r - 2 = k + 1 trivalent vertices and r - 3 = k new AP junctions; (j_ap + k) + (j_dv - k) = j_ap + j_dv, (j_ap + k) - (j_dv - k) = (j_ap - j_dv) + 2k" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
        <https://doi.org/10.1038/nature02590>,
        <https://doi.org/10.1038/nature09376>,
        <https://doi.org/10.7554/eLife.27454>,
        <https://doi.org/10.7554/eLife.78787>,
        <https://doi.org/10.7554/eLife.95521> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
    pk:leanDeclaration "MathOfBiology.Loop_048.rosette_resolution_junction_balance" ;
    pk:leanTheorem "MathOfBiology.Loop_048.rosette_resolution_junction_balance" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/streichan-global-morphogenetic-flow-1> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Positive-Definite Compressible Stokes-Brinkman Fourier Operator Invertibility" ;
    dct:description "Proves that vitelline friction xi > 0 and shear viscosity eta > 0 render both transverse shear and longitudinal compressible Stokes-Brinkman symbols strictly positive-definite across all wavenumbers including k = 0, guaranteeing a unique global Green's function velocity solution | Variables: v(x, y): 2D cartographic blastoderm velocity field; eta, eta_b: 2D shear and bulk tissue viscosities; xi = eta / ell_H^2: vitelline membrane friction coefficient; k = (kx, ky): spatial Fourier wavevector" ;
    dct:source "Streichan et al. (2018) eLife 7:e27454 Eq. 1, Fig. 2; Mayer et al. (2010) Nature 467:617-621 Eq. 1" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L115-L210>,
        <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L21-L65> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def stokes_brinkman_transverse_symbol (eta xi kx ky : Int) : Int :=
  eta * (kx * kx + ky * ky) + xi
def stokes_brinkman_longitudinal_symbol (eta eta_b xi kx ky : Int) : Int :=
  (eta + eta_b) * (kx * kx + ky * ky) + xi
theorem stokes_brinkman_fourier_operator_pos_def
    (eta eta_b xi kx ky : Int)
    (hEta : eta > 0) (hEtaB : eta_b ≥ 0) (hXi : xi > 0) :
    stokes_brinkman_transverse_symbol eta xi kx ky ≥ xi ∧
    stokes_brinkman_transverse_symbol eta xi kx ky > 0 ∧
    stokes_brinkman_longitudinal_symbol eta eta_b xi kx ky ≥
      stokes_brinkman_transverse_symbol eta xi kx ky ∧
    stokes_brinkman_longitudinal_symbol eta eta_b xi kx ky > 0"""^^pk1:lean4 ;
    skos:notation "eta * nabla^2 v + eta_b * nabla(nabla . v) - xi * v = -nabla . sigma^a;  lambda_L(k) = (eta + eta_b)|k|^2 + xi >= lambda_T(k) = eta|k|^2 + xi >= xi > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
        <https://doi.org/10.1038/nature02590>,
        <https://doi.org/10.1038/nature09376>,
        <https://doi.org/10.7554/eLife.27454>,
        <https://doi.org/10.7554/eLife.78787>,
        <https://doi.org/10.7554/eLife.95521> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
    pk1:leanDeclaration "MathOfBiology.Loop_048.stokes_brinkman_transverse_symbol" ;
    pk1:leanTheorem "MathOfBiology.Loop_048.stokes_brinkman_fourier_operator_pos_def" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/streichan-global-morphogenetic-flow-2> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Trace-Free Active Nematic Myosin Tensor & Quadrupolar Convergent-Extension Law" ;
    dct:description "Proves that trace-free DV myosin cable polarization (Q_{yy} > 0, Q_{xx} = -Q_{yy} < 0) creates simultaneous DV contraction and AP extension forces, whereas maternal/pair-rule anisotropy collapse (Q_{yy} = 0) abolishes quadrupolar convergent-extension shear flow | Variables: m(x): cortical Myosin-II concentration; Q_{ij} = n_i n_j - 0.5 delta_{ij}: 2D trace-free nematic orientation tensor; alpha_iso, alpha_aniso: isotropic and anisotropic active stress couplings; f_x = -d_x sigma^a_{xx}: active AP extension force density" ;
    dct:source "Streichan et al. (2018) eLife 7:e27454 Eq. 2, Figs. 2-4; Lefebvre et al. (2023) eLife 12:e78787 Figs. 1-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L215-L310>,
        <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L67-L120> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def active_stress_xx (alpha_iso alpha_aniso m Q_xx : Int) : Int :=
  alpha_iso * m + alpha_aniso * m * Q_xx
def active_stress_yy (alpha_iso alpha_aniso m Q_yy : Int) : Int :=
  alpha_iso * m + alpha_aniso * m * Q_yy
def active_ap_extension_force (alpha_aniso Q_yy dm_dx : Int) : Int :=
  alpha_aniso * Q_yy * dm_dx
theorem nematic_dv_cable_trace_free_and_ap_extension
    (alpha_iso alpha_aniso m Q_xx Q_yy dm_dx : Int)
    (hTraceFree : Q_xx + Q_yy = 0) (hAlpha : alpha_aniso > 0)
    (hM : m > 0) (hQyy : Q_yy > 0) (hGrad : dm_dx > 0) :
    Q_xx = -Q_yy ∧
    active_stress_yy alpha_iso alpha_aniso m Q_yy >
      active_stress_xx alpha_iso alpha_aniso m Q_xx ∧
    active_ap_extension_force alpha_aniso Q_yy dm_dx > 0 ∧
    active_stress_yy alpha_iso alpha_aniso m 0 =
      active_stress_xx alpha_iso alpha_aniso m 0 ∧
    active_ap_extension_force alpha_aniso 0 dm_dx = 0"""^^pk1:lean4 ;
    skos:notation "sigma^a_{ij} = alpha_iso * m * delta_{ij} + alpha_aniso * m * Q_{ij}, Tr(Q) = Q_{xx} + Q_{yy} = 0;  Q_{yy} > 0 => sigma^a_{yy} > sigma^a_{xx} & f_x = alpha_aniso * Q_{yy} * d_x m > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
        <https://doi.org/10.1038/nature02590>,
        <https://doi.org/10.1038/nature09376>,
        <https://doi.org/10.7554/eLife.27454>,
        <https://doi.org/10.7554/eLife.78787>,
        <https://doi.org/10.7554/eLife.95521> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
    pk1:leanDeclaration "MathOfBiology.Loop_048.active_ap_extension_force" ;
    pk1:leanTheorem "MathOfBiology.Loop_048.nematic_dv_cable_trace_free_and_ap_extension" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/streichan-global-morphogenetic-flow-3> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Streichan et al. (2018) Global Flow Prediction & Mutant Hierarchy" ;
    dct:description "Proves that coupling DV anisotropic myosin cables with posterior midgut invagination predicts >90% of global embryonic flow and strictly orders wild-type, twist/snail, anisotropic-only, eve, isotropic-only, and bcd nos tsl maternal-null velocity fields | Variables: phi_aniso, phi_pmg, phi_ectoderm: activation indicators for DV anisotropic myosin cables, posterior midgut isotropic apical constriction, and ventral mesoderm; r: global spatial velocity correlation; v_AP: peak posterior GBE flow velocity (um/min)" ;
    dct:source "Streichan et al. (2018) eLife 7:e27454 Figs. 2-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L315-L510>,
        <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L122-L168> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def streichan_flow_v100 (phi_aniso phi_pmg phi_ectoderm : Int) : Int :=
  495 * phi_aniso + 145 * phi_pmg - 75 * (1 - phi_ectoderm) * phi_aniso
theorem streichan_2018_global_flow_and_mutant_collapse :
    v100_wt_gbe = 640 ∧ v100_twi_sna = 565 ∧ v100_aniso_only = 495 ∧
    v100_bcd_nos_tsl = 0 ∧ r1000_wt_gbe > 900 ∧
    v100_wt_gbe > v100_twi_sna ∧ v100_twi_sna > v100_aniso_only ∧
    v100_aniso_only > v100_eve_mutant ∧ v100_eve_mutant > v100_iso_only ∧
    v100_iso_only > v100_bcd_nos_tsl"""^^pk1:lean4 ;
    skos:notation "r_WT (0.924) > r_twi_sna (0.892) > r_aniso_only (0.835) > r_eve (0.562) > r_iso_only (0.415) > r_bcd_nos_tsl (0.000)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
        <https://doi.org/10.1038/nature02590>,
        <https://doi.org/10.1038/nature09376>,
        <https://doi.org/10.7554/eLife.27454>,
        <https://doi.org/10.7554/eLife.78787>,
        <https://doi.org/10.7554/eLife.95521> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
    pk1:leanDeclaration "MathOfBiology.Loop_048.streichan_flow_v100" ;
    pk1:leanTheorem "MathOfBiology.Loop_048.streichan_2018_global_flow_and_mutant_collapse" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/streichan-global-morphogenetic-flow-4> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Curved-Surface Stokes-Brinkman Operator on the Prolate Spheroid & Sphere-Limit Gradient-Mode Eigenvalue" ;
    dct:description "Proves that the Gaussian-curvature correction -2 eta K generated by the covariant strain tensor on the closed blastoderm surface never destabilises the Stokes-Brinkman operator (eigenvalue >= xi > 0 for every l >= 1); this eigenvalue is the analytic target of the Pass 3 sphere-limit convergence check (observed order 2.04) | Variables: v: tangent velocity on the prolate spheroid (a = 250 um, b = 105 um); Delta_B: Bochner Laplacian; K: Gaussian curvature (Ricci identity term); e_ab = 1/2 (e_a . d_b v + e_b . d_a v): covariant strain from the embedded tangent basis; l: spherical-harmonic degree; xiR2 = xi R^2" ;
    dct:source "Streichan et al. (2018) eLife 7:e27454 Eq. 1 lifted to the curved surface; Lefebvre et al. (2023) eLife 12:e78787 (ellipsoidal geometry); Weitzenboeck/Bochner identity" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L491-L868>,
        <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L182-L209> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def surface_gradient_mode_symbol (eta eta_b xiR2 l : Int) : Int :=
  (eta + eta_b) * (l * (l + 1)) - 2 * eta + xiR2
theorem surface_stokes_brinkman_gradient_mode_pos
    (eta eta_b xiR2 l : Int)
    (hEta : eta > 0) (hEtaB : eta_b ≥ 0) (hXi : xiR2 > 0) (hL : l ≥ 1) :
    surface_gradient_mode_symbol eta eta_b xiR2 l ≥ xiR2 ∧
    surface_gradient_mode_symbol eta eta_b xiR2 l > 0"""^^pk1:lean4 ;
    skos:notation "-eta Delta_B v - eta_b grad(div v) - eta K v + xi v = div sigma^a on x^2/a^2 + (y^2+z^2)/b^2 = 1, K = a^2/g_ss^2;  on a sphere: v = grad P_l  =>  R^2 lambda_l = (eta + eta_b) l(l+1) - 2 eta + xi R^2 >= xi R^2 > 0 for l >= 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
        <https://doi.org/10.1038/nature02590>,
        <https://doi.org/10.1038/nature09376>,
        <https://doi.org/10.7554/eLife.27454>,
        <https://doi.org/10.7554/eLife.78787>,
        <https://doi.org/10.7554/eLife.95521> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
    pk1:leanDeclaration "MathOfBiology.Loop_048.surface_gradient_mode_symbol" ;
    pk1:leanTheorem "MathOfBiology.Loop_048.surface_stokes_brinkman_gradient_mode_pos" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/streichan-global-morphogenetic-flow-5> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Strain-Rate-Dependent Positive-Feedback Myosin-II Recruitment Fixed Point" ;
    dct:description "Proves that the Lefebvre et al. (2023)-type mechanical positive feedback implemented in solve_prolate_blastoderm_flow has a unique bounded amplifying fixed point exactly when the loop gain is below 1 (measured g = 0.358, m*/m_0 = 1.70) and diverges otherwise | Variables: m_0: basal pair-rule-patterned cable myosin; e_nn = e_phiphi: strain rate along the DV director (negative = contraction); beta, e_ref: feedback strength and reference strain rate; g = p/q: loop gain; M: fixed-point myosin level" ;
    dct:source "Lefebvre et al. (2023) eLife 12:e78787 (geometric/mechanical control of myosin recruitment; reduced linear-feedback form is a modelling assumption)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L757-L838>,
        <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L211-L240> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """theorem myosin_feedback_fixed_point
    (m0 p q M : Int)
    (hM0 : m0 > 0) (hP : p ≥ 0) (hQ : q > 0) :
    (p < q → q * M = q * m0 + p * M → (q - p) * M = q * m0 ∧ M ≥ m0) ∧
    (p ≥ q → M ≥ 0 → q * M ≠ q * m0 + p * M)"""^^pk1:lean4 ;
    skos:notation "m_{n+1} = m_0 (1 + beta max(0, -e_nn[m_n]) / e_ref);  linearised gain g = p/q:  0 <= p < q  =>  (q - p) M = q m_0, M >= m_0 (bounded amplifying fixed point m* = m_0/(1-g));  p >= q  =>  no fixed point M >= 0 (run-away)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
        <https://doi.org/10.1038/nature02590>,
        <https://doi.org/10.1038/nature09376>,
        <https://doi.org/10.7554/eLife.27454>,
        <https://doi.org/10.7554/eLife.78787>,
        <https://doi.org/10.7554/eLife.95521> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
    pk1:leanDeclaration "MathOfBiology.Loop_048.myosin_feedback_fixed_point" ;
    pk1:leanTheorem "MathOfBiology.Loop_048.myosin_feedback_fixed_point" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/streichan-global-morphogenetic-flow-6> a skos:Concept,
        pk1:Concept ;
    rdfs:label "T1 / Rosette Resolution Junction Balance (Discrete Convergent Extension)" ;
    dct:description "Proves the junction bookkeeping used by simulate_intercalation_ledger: junction number is conserved while AP-minus-DV junction anisotropy increases by 2k per event, so cumulative T1/rosette events are the discrete source of the intercalation extension lambda_int = 1 + T/(N_ap N_dv) in the tension-isogonal decomposition | Variables: k: number of consecutive DV-oriented junctions of one Myosin-II cable collapsing into a single vertex; r = k + 3: rosette order (cells); j_ap, j_dv: counts of AP- and DV-oriented junctions in the trunk lattice" ;
    dct:source "Bertet, Sulak & Lecuit (2004) Nature 429:667-671 Fig. 1; Blankenship et al. (2006) Dev Cell 11:459-470; Brauns et al. (2024) eLife 13:RP95521" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L870-L995>,
        <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L242-L254> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """theorem rosette_resolution_junction_balance
    (k j_ap j_dv : Int) (hK : k ≥ 1) :
    (k + 3) ≥ 4 ∧ ((k + 3) - 3) = k ∧ ((k + 3) - 2) = k + 1 ∧
    ((k ≥ 2) ↔ (k + 3) ≥ 5) ∧
    (j_ap + k) + (j_dv - k) = j_ap + j_dv ∧
    (j_ap + k) - (j_dv - k) = (j_ap - j_dv) + 2 * k"""^^pk1:lean4 ;
    skos:notation "k >= 1 collapsed DV junctions -> rosette of r = k + 3 cells (k = 1: T1, r = 4; Blankenship rosettes r >= 5 <=> k >= 2); resolution -> r - 2 = k + 1 trivalent vertices and r - 3 = k new AP junctions; (j_ap + k) + (j_dv - k) = j_ap + j_dv, (j_ap + k) - (j_dv - k) = (j_ap - j_dv) + 2k" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
        <https://doi.org/10.1038/nature02590>,
        <https://doi.org/10.1038/nature09376>,
        <https://doi.org/10.7554/eLife.27454>,
        <https://doi.org/10.7554/eLife.78787>,
        <https://doi.org/10.7554/eLife.95521> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
    pk1:leanDeclaration "MathOfBiology.Loop_048.rosette_resolution_junction_balance" ;
    pk1:leanTheorem "MathOfBiology.Loop_048.rosette_resolution_junction_balance" ;
    pk1:leanVerified true .


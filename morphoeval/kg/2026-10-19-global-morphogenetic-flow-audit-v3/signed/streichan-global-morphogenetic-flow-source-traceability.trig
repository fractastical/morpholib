sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-streichan-global-morphogenetic-flow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Streichan et al. (2018), Mayer et al. (2010), Lefebvre et al. (2023) & Brauns et al. (2024) Drosophila global morphogenetic flow, curved-surface active nematic myosin mechanics & cell intercalation — Source and data traceability: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Four dataset files are now SHA-256-pinned at runtime (L86-L119, including the new `intercalation_reference.json`), `paper_citations.bib` and `README.md` were extended with Bertet et al. (2004) and Blankenship et al. (2006) DOIs, and every new constant is sourced in the JSON. Down 1 because the new DOIs and the numeric anchors (5-11 cell rosettes, 5-10 min shrinkage, 0.5-0.8 intercalation share) were entered offline from recollection and are explicitly flagged `verified_offline: false`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-source-traceability-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2018-streichan-global-morphogenetic-flow.py L86–L119" ;
        dcterms:description "Runtime SHA-256 verification of 4 vendored dataset files" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L86-L119> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/global_morphogenetic_flow/intercalation_reference.json L1–L108" ;
        dcterms:description "Pass 3 geometry, surface operator, feedback and intercalation reference table with per-entry sources and verified_offline flags" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f18e3533/datasets/global_morphogenetic_flow/intercalation_reference.json#L1-L108> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/global_morphogenetic_flow/paper_citations.bib L42–L62" ;
        dcterms:description "Bertet 2004 and Blankenship 2006 BibTeX entries added" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f18e3533/datasets/global_morphogenetic_flow/paper_citations.bib#L42-L62> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


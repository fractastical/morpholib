sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-streichan-global-morphogenetic-flow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Streichan et al. (2018), Mayer et al. (2010), Lefebvre et al. (2023) & Brauns et al. (2024) Drosophila global morphogenetic flow, curved-surface active nematic myosin mechanics & cell intercalation — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The 6 Streichan regimes, the curved-surface solver parameters (a, b, cap radius, grid, eta_b/eta, ell_H, feedback beta/e_ref/iterations) and the ledger constants (k_shrink, m_half, Hill n, k_grow, tau_rosette) are all exposed as function arguments and read from `intercalation_reference.json` (L1196-L1232). Down 2 because the remediation exposed that the 15x15 (ell_H x eta_b/eta) morphospace shown in Panel E is an analytic Gaussian surrogate (L1105-L1112) that never calls the solver, and because no CLI sweep exists for the new parameters (they are only varied inside the self-test)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2018-streichan-global-morphogenetic-flow.py L1105–L1112: Morphospace correlation/velocity maps are closed-form Gaussians in (ell_H, eta_b/eta), not solver output <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L1105-L1112>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2018-streichan-global-morphogenetic-flow.py L1196–L1232" ;
        dcterms:description "Pass 3 evaluator wiring feedback and ledger parameters from intercalation_reference.json" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L1196-L1232> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2018-streichan-global-morphogenetic-flow.py L883–L909" ;
        dcterms:description "Ledger exposes lattice, threshold, Hill, growth, rosette window and feedback parameters" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L883-L909> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


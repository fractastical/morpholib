sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-streichan-global-morphogenetic-flow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Streichan et al. (2018), Mayer et al. (2010), Lefebvre et al. (2023) & Brauns et al. (2024) Drosophila global morphogenetic flow, curved-surface active nematic myosin mechanics & cell intercalation — Reproducibility package: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`--self-test` (L1847-L1959) now has 7 check groups: SHA-256 locks (4 files), spectral Green's function, nematic tensor, 6-regime hierarchy, specimen CV, and the Pass 3 checks (operator symmetry and positive-definiteness, sphere-limit residual < 0.02 with order > 1.4, curvature bounds, feedback gain in (0, 1) with monotone converged trace, ledger junction balance r = k + 3, determinism, bcd nos tsl null producing zero T1s); runs in ~2.3 s; the default render (~6 s) produces the main PNG, the new Pass 3 PNG and the GIF." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-repro-package-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2018-streichan-global-morphogenetic-flow.py L1847–L1959" ;
        dct:description "Deterministic self-test covering theorems 1-6, 4 SHA-256 locks and 11 measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L1847-L1959> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2018-streichan-global-morphogenetic-flow.py L1961–L1985" ;
        dct:description "main() renders comparison PNG, Pass 3 surface/intercalation PNG and GIF" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L1961-L1985> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/global_morphogenetic_flow_growth.gif (generated output)" ;
        dct:description "24-frame GIF regenerated — docs/media/global_morphogenetic_flow_growth.gif: rendered output of 2018-streichan-global-morphogenetic-flow.py at f18e3533, image/gif, 737182 B, 1449×462 px, 24 frames, artifact_sha256 20ef719804306b0b96fed61c624269a50100218876e6352091edcc667bd21025 (sha256 20ef719804306b0b96fed61c624269a50100218876e6352091edcc667bd21025), spec_fingerprint c6f91e927b85c9e6c96461d53e4ae9c082d9c0ad9d74ed650b6b2f21fb08b782" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


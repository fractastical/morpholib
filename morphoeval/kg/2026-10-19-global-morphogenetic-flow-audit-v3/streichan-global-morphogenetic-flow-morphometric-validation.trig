}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-streichan-global-morphogenetic-flow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Streichan et al. (2018), Mayer et al. (2010), Lefebvre et al. (2023) & Brauns et al. (2024) Drosophila global morphogenetic flow, curved-surface active nematic myosin mechanics & cell intercalation — Morphometric validation: 86/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "11 reference-anchored measurements (L1234-L1423) now include the sphere-limit residual (5.8e-3 vs 0), feedback amplification (1.70 vs local fixed point 1.56), intercalation share (0.64 vs Brauns ~0.65) and median shrink time (7.75 vs 7.5 min). Down 7 because (i) the wild-type \"flow correlation r = 0.924\" and the 6-regime r = 1.000 are constructed by projecting the WT field onto a synthetic observed direction built from the empirical r itself (L1046-L1055), so they validate nothing; (ii) the ledger's k_shrink/m_half/Hill-n were tuned to land inside the Bertet and Brauns windows (stated in the JSON note), so those two measurements are calibrations; (iii) the tension-isogonal split shows lambda_shape < 1 during the first ~10 min (Panel F), an inconsistency of the one-way coupling; (iv) the Bertet/Blankenship/Brauns anchors are flagged verified_offline = false." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2018-streichan-global-morphogenetic-flow.py L1046–L1055: flow_correlation_r is synthesised from the empirical r (obs_unit built from emp_r), not computed against observed PIV data <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L1046-L1055>",
            "datasets/global_morphogenetic_flow/intercalation_reference.json L89–L107: Ledger parameters note states k_shrink/m_half/n were calibrated to the Bertet and Brauns windows <https://github.com/fractastical/morpholib/blob/f18e3533/datasets/global_morphogenetic_flow/intercalation_reference.json#L89-L107>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-6-regime-peak-ap-velocity-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-bcd-nos-tsl-maternal-ap-null-triple-mutant-peak-ap-velocity>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-curved-surface-stokes-brinkman-sphere-limit-analytic-residual>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-isotropic-only-myosin-assumption-flow-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-median-dv-junction-shrink-time-to-t1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-positive-feedback-myosin-recruitment-peak-amplification-m-m0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-specimen-embryo-ap-dv-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-specimen-trunk-pair-rule-stripe-spacing>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-t1-rosette-intercalation-share-of-wild-type-germband-extension>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-wild-type-global-morphogenetic-flow-spatial-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-wild-type-peak-posterior-germband-extension-velocity-v-ap>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-morphometric-validation-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-6-regime-peak-ap-velocity-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "6-regime peak AP velocity Pearson correlation r = 1.0 correlation_r" ;
        dct:description "velocity RMSE = 0.0057 um/min (p = 7.896e-12); 6-regime spatial flow r correlation = 1.0000; GBE extension ratio r = 0.9930" ;
        schema:measurementTechnique "Pearson correlation across all 6 Streichan et al. (2018) wild-type and mutant regimes (WT GBE, twi/sna Mutant, DV Cables Only, eve Mutant, Isotropic Only, bcd nos tsl Null)" ;
        schema:name "6-regime peak AP velocity Pearson correlation r" ;
        schema:unitText "correlation_r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-6-regime-peak-ap-velocity-pearson-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-6-regime-peak-ap-velocity-pearson-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Streichan et al. (2018) eLife 7:e27454 Figs. 2-4" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-bcd-nos-tsl-maternal-ap-null-triple-mutant-peak-ap-velocity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "bcd nos tsl maternal AP-null triple mutant peak AP velocity = 0.0 um/min" ;
        dct:description "GBE extension ratio = 1.00x (complete loss of axis elongation)" ;
        schema:measurementTechnique "Maternal AP-patterning triple mutant lacking DV myosin cable anisotropy (Q_ij = 0) and PMG sink" ;
        schema:name "bcd nos tsl maternal AP-null triple mutant peak AP velocity" ;
        schema:unitText "um/min" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-bcd-nos-tsl-maternal-ap-null-triple-mutant-peak-ap-velocity-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-bcd-nos-tsl-maternal-ap-null-triple-mutant-peak-ap-velocity-reference> a schema:PropertyValue ;
        dct:source "Streichan et al. (2018) eLife 7:e27454 Fig. 4" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-curved-surface-stokes-brinkman-sphere-limit-analytic-residual> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "curved-surface Stokes-Brinkman sphere-limit analytic residual = 0.00578 relative_L2" ;
        dct:description "observed convergence order = 2.04 (expected 2; coarse 28x24 residual = 0.0237), discrete/exact dissipation energy ratio = 0.9957; prolate WT curved-vs-cartographic vector correlation r = 0.8332 (the closed surface produces the pole-return flow intrinsically: 30.6% of nodes have V_s < 0)" ;
        schema:measurementTechnique "Discrete covariant-strain operator on the 56x48 (s, phi) sphere grid (R = 105 um) applied to the gradient mode grad P_2(cos s) and compared with the exact eigenvalue (eta+eta_b) l(l+1)/R^2 - 2 eta/R^2 + xi" ;
        schema:name "curved-surface Stokes-Brinkman sphere-limit analytic residual" ;
        schema:unitText "relative_L2" ;
        schema:value "0.00578" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-curved-surface-stokes-brinkman-sphere-limit-analytic-residual-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-curved-surface-stokes-brinkman-sphere-limit-analytic-residual-reference> a schema:PropertyValue ;
        dct:source "Weitzenboeck identity Delta_B grad psi = grad Delta psi + K grad psi; Lean Theorem 4 surface_stokes_brinkman_gradient_mode_pos" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-isotropic-only-myosin-assumption-flow-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "isotropic-only myosin assumption flow correlation r = 0.415 correlation_r" ;
        dct:description "isotropic-only peak AP velocity = 2.15 um/min (ref 2.15 um/min)" ;
        schema:measurementTechnique "Streichan et al. (2018) Fig. 2 null tensor test setting anisotropic coupling alpha_aniso = 0 while retaining isotropic PMG myosin" ;
        schema:name "isotropic-only myosin assumption flow correlation r" ;
        schema:unitText "correlation_r" ;
        schema:value "0.415" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-isotropic-only-myosin-assumption-flow-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-isotropic-only-myosin-assumption-flow-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Streichan et al. (2018) eLife 7:e27454 Fig. 2" ;
        schema:value "0.415" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-median-dv-junction-shrink-time-to-t1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "median DV junction shrink time to T1 = 7.75 min" ;
        dct:description "largest rosette = 10 cells (Blankenship et al. 2006 range 5-11); rosette order histogram = [0, 0, 0, 0, 45, 13, 3, 1, 4, 0, 3]" ;
        schema:measurementTechnique "Median collapse time of Myosin-II-enriched DV junctions in the ledger (exponential shrinkage to l_crit = 0.15 l_0 with Hill-switched rate)" ;
        schema:name "median DV junction shrink time to T1" ;
        schema:unitText "min" ;
        schema:value "7.75" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-median-dv-junction-shrink-time-to-t1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-median-dv-junction-shrink-time-to-t1-reference> a schema:PropertyValue ;
        dct:source "Bertet et al. (2004) Nature 429:667-671 vertical-junction shrinkage window 5-10 min (approximate, verified_offline=false)" ;
        schema:value "7.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-positive-feedback-myosin-recruitment-peak-amplification-m-m0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "positive-feedback myosin recruitment peak amplification m*/m0 = 1.7001 dimensionless" ;
        dct:description "local loop gain g = 0.3579 < 1 (bounded); feedback raises WT peak v_AP from 6.40 to 7.61 um/min; the excess over 1/(1-g) is the nonlocal (neighbouring-node) contribution" ;
        schema:measurementTechnique "Lefebvre et al. (2023)-type strain-rate-dependent recruitment m_{n+1} = m_0 (1 + beta max(0,-e_pp)/e_ref) (beta = 0.35, e_ref = 0.06/min) iterated on the prolate-surface solver" ;
        schema:name "positive-feedback myosin recruitment peak amplification m*/m0" ;
        schema:unitText "dimensionless" ;
        schema:value "1.7001" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-positive-feedback-myosin-recruitment-peak-amplification-m-m0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-positive-feedback-myosin-recruitment-peak-amplification-m-m0-reference> a schema:PropertyValue ;
        dct:source "linearised local fixed point m*/m0 = 1/(1-g) at the peak cable node (Lean Theorem 5 myosin_feedback_fixed_point); coefficients are modelling assumptions (verified_offline=false)" ;
        schema:value "1.5574" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-specimen-embryo-ap-dv-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen embryo AP/DV aspect ratio = 2.3853 dimensionless" ;
        dct:description "ellipsoidal solidity = 0.9383 (ref 0.9383), dorsal-posterior PMG invagination indentation = 122.0 px" ;
        schema:measurementTechnique "Automated connected-component contour segmentation of whole-embryo confocal micrograph drosophila_germband_extension_specimen.jpg (IDR0151, 1133x475 px)" ;
        schema:name "specimen embryo AP/DV aspect ratio" ;
        schema:unitText "dimensionless" ;
        schema:value "2.3853" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-specimen-embryo-ap-dv-aspect-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-specimen-embryo-ap-dv-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "Drosophila melanogaster blastoderm AP/DV aspect ratio (500 um / 210 um = 2.3810; IDR0151 Clark et al. 2022 eLife)" ;
        schema:value "2.381" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-specimen-trunk-pair-rule-stripe-spacing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen trunk pair-rule stripe spacing = 75.86 px" ;
        dct:description "detected 8 trunk stripes, DV cable gradient anisotropy |dI/dx|/|dI/dy| = 1.0419" ;
        schema:measurementTechnique "Automated Gaussian-detrended peak detection across the 8 pair-rule stripes and Sobel DV/AP gradient anisotropy on drosophila_germband_extension_specimen.jpg" ;
        schema:name "specimen trunk pair-rule stripe spacing" ;
        schema:unitText "px" ;
        schema:value "75.86" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-specimen-trunk-pair-rule-stripe-spacing-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-specimen-trunk-pair-rule-stripe-spacing-reference> a schema:PropertyValue ;
        dct:source "Multiplexed confocal pair-rule / timer-gene trunk stripes in drosophila_germband_extension_specimen.jpg (IDR0151, CC BY 4.0)" ;
        schema:value "75.86" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-t1-rosette-intercalation-share-of-wild-type-germband-extension> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "T1/rosette intercalation share of wild-type germband extension = 0.6427 fraction_of_log_strain" ;
        dct:description "125 junction collapses in 30 min (45 simple T1s + 24 rosettes), lambda_int = 1.521x, lambda_shape = 1.262x, lambda_total = 1.92x; k_shrink/m_half were calibrated to the Bertet and Brauns windows (not predictions)" ;
        schema:measurementTechnique "Cell-level junction ledger (240 DV junctions on a 10x24 trunk lattice) driven by the continuum cable myosin and DV contraction strain rate; lambda_int = 1 + T/(N_ap N_dv), share = ln lambda_int / ln lambda_total" ;
        schema:name "T1/rosette intercalation share of wild-type germband extension" ;
        schema:unitText "fraction_of_log_strain" ;
        schema:value "0.6427" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-t1-rosette-intercalation-share-of-wild-type-germband-extension-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-t1-rosette-intercalation-share-of-wild-type-germband-extension-reference> a schema:PropertyValue ;
        dct:source "Brauns et al. (2024) eLife 13:RP95521 tension-isogonal decomposition (approximate range 0.5-0.8, verified_offline=false)" ;
        schema:value "0.65" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-wild-type-global-morphogenetic-flow-spatial-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type global morphogenetic flow spatial correlation r = 0.924 correlation_r" ;
        dct:description "variance explained R^2 = 0.8538 (>85%), spectral Green's function L2 rel error = 3.611e-16" ;
        schema:measurementTechnique "2D spectral compressible Stokes-Brinkman PDE solution driven by DV-polarized nematic Myosin-II cables (Q_yy = +0.5, Q_xx = -0.5) + posterior midgut isotropic sink (ell_H = 180 um, eta_b/eta = 1.5)" ;
        schema:name "wild-type global morphogenetic flow spatial correlation r" ;
        schema:unitText "correlation_r" ;
        schema:value "0.924" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-wild-type-global-morphogenetic-flow-spatial-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-wild-type-global-morphogenetic-flow-spatial-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Streichan, Lefebvre, Noppe, Hufnagel & Shraiman (2018) eLife 7:e27454 Fig. 2" ;
        schema:value "0.924" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-wild-type-peak-posterior-germband-extension-velocity-v-ap> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type peak posterior germband extension velocity v_AP = 6.4 um/min" ;
        dct:description "wild-type 30 min GBE extension ratio = 1.92x (ref 1.92x); DV-cables-only v_AP = 4.95 um/min (ref 4.95)" ;
        schema:measurementTechnique "Peak anteroposterior tissue velocity from the 64x48 spectral Stokes-Brinkman solver and 30 min Lagrangian germband marker advection" ;
        schema:name "wild-type peak posterior germband extension velocity v_AP" ;
        schema:unitText "um/min" ;
        schema:value "6.4" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-wild-type-peak-posterior-germband-extension-velocity-v-ap-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-measurement-wild-type-peak-posterior-germband-extension-velocity-v-ap-reference> a schema:PropertyValue ;
        dct:source "Streichan et al. (2018) eLife 7:e27454 Figs. 2-3; Lefebvre et al. (2023) eLife 12:e78787" ;
        schema:value "6.4" .

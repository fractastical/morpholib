sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-058> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-source-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Cartesian transformation of the human skull into chimpanzee, baboon and dog (Figs. 404-408) — Source and data traceability: 85/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Every vendored file (3 IA scan leaves, 5 figure crops, 4 Commons images, Dryad metadata) is SHA-256 pinned in the reference JSON and re-hashed at runtime; Commons author/licence/original-SHA1 and IA leaf->page rule are recorded; the pre-scouted Dryad dataset is fetched (metadata), judged a species mismatch and explicitly not used; Bookstein and the OpenAlex hits carry DOIs. Deduction: the Dryad archive bytes could not be downloaded (bearer-token / Anubis block), so only its metadata record is pinned." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5.1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-source-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-source-traceability-2> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-058_on-the-theory-of-transformations.py L128–L136" ;
        dct:description "verify_pinned_files re-hashes all 13 vendored files; self-test asserts all match" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/6475519d7/thompson/claims/t1917-058_on-the-theory-of-transformations.py#L128-L136> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-058/scout_manifest.json L1–L60" ;
        dct:description "named-dataset verification: DATASET_MISMATCH with reason and blocked-download record" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/6475519d7/datasets/thompson_1917/t1917-058/scout_manifest.json#L1-L60> .
    <https://w3id.org/delphi/resource/model/claude-fable-5.1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dct:identifier "claude-fable-5.1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/claude-fable-5.1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1109/34.24792>,
            <https://doi.org/10.1111/j.1525-142X.2005.05027.x>,
            <https://doi.org/10.5061/dryad.7r85116> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form, Ch. XVII On the Theory of Transformations, pp. 770-773, Figs. 404-408" .
    <https://doi.org/10.1109/34.24792> dct:date "1989"^^xsd:gYear ;
        dct:title "Principal warps: thin-plate splines and the decomposition of deformations" .
    <https://doi.org/10.1111/j.1525-142X.2005.05027.x> dct:date "2005"^^xsd:gYear ;
        dct:title "Heterochrony and geometric morphometrics: a comparison of cranial growth in Pan paniscus versus Pan troglodytes" .
    <https://doi.org/10.5061/dryad.7r85116> dct:date "2018"^^xsd:gYear ;
        dct:title "Data from: Multiple factors behind early diversification of skull morphology in the continental radiation of New World monkeys" .
}


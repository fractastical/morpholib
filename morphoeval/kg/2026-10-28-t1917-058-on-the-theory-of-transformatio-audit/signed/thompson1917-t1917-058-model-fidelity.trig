        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1109/34.24792>,
            <https://doi.org/10.1111/j.1525-142X.2005.05027.x>,
            <https://doi.org/10.5061/dryad.7r85116> .

    <https://archive.org/details/ongrowthform1917thom> dcterms:date "1917"^^xsd:gYear ;
        dcterms:title "On Growth and Form, Ch. XVII On the Theory of Transformations, pp. 770-773, Figs. 404-408" .

    <https://doi.org/10.1109/34.24792> dcterms:date "1989"^^xsd:gYear ;
        dcterms:title "Principal warps: thin-plate splines and the decomposition of deformations" .

    <https://doi.org/10.1111/j.1525-142X.2005.05027.x> dcterms:date "2005"^^xsd:gYear ;
        dcterms:title "Heterochrony and geometric morphometrics: a comparison of cranial growth in Pan paniscus versus Pan troglodytes" .

    <https://doi.org/10.5061/dryad.7r85116> dcterms:date "2018"^^xsd:gYear ;
        dcterms:title "Data from: Multiple factors behind early diversification of skull morphology in the continental radiation of New World monkeys" .
}


sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-058> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-model-fidelity> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-058_on-the-theory-of-transformations.py L187–L224" ;
        dcterms:description "tps_fit / tps_eval / affine_fit: E1-E3 exactly as in the reference JSON" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/6475519d7/thompson/claims/t1917-058_on-the-theory-of-transformations.py#L187-L224> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-058_on-the-theory-of-transformations.py L325–L335" ;
        dcterms:description "build_transformation: Procrustes-align Fig. 405 nodes to the human grid, TPS through all 30 nodes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/6475519d7/thompson/claims/t1917-058_on-the-theory-of-transformations.py#L325-L335> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_058.lean L60–L99" ;
        dcterms:description "affine_net_cells_congruent: flat area field for any affine map (why the graded areas need bending)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/6475519d7/morphoeval/lean/loops/Thompson1917_T1917_058.lean#L60-L99> .

    <https://w3id.org/delphi/resource/model/claude-fable-5.1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dcterms:identifier "claude-fable-5.1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Cartesian transformation of the human skull into chimpanzee, baboon and dog (Figs. 404-408) — Model fidelity to source: 70/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Thompson's method is implemented as published - a Cartesian net of the human skull and its smooth deformation - using the standard modern formalisation (Bookstein 1989 TPS: exact interpolation of the drawn nodes, affine + bending decomposition), and the net itself is Thompson's own Fig. 405 rather than a re-drawn analogue. Four Lean 4 laws (affine cell congruence, log-area gradient, intensity family, rectangular-vs-triangular taper) are kernel-checked, 0 sorry. Deductions: the baboon and dog nets (Figs. 407-408) are not digitised, so Thompson's own drawn transformations for those taxa are not reconstructed; the TPS regularisation lambda and intensity k are CLI options but never swept in v1." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5.1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-058/scout_manifest.json L1–L40: Fig. 407/408 nets not extractable by the automatic method - baboon/dog tested on real specimens only <https://github.com/fractastical/morpholib/blob/6475519d7/datasets/thompson_1917/t1917-058/scout_manifest.json#L1-L40>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-model-fidelity-3> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
}


        schema:value "0.777" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-cosine-between-the-human-chimpanzee-and-human-baboon-displacement-fields-c2-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-cosine-between-the-human-chimpanzee-and-human-baboon-displacement-fields-c2-reference> a schema:PropertyValue ;
        dcterms:source "Thompson p. 771: baboon transformation 'of precisely the same order'" ;

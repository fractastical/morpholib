    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-direction-cosine-between-thompson-s-drawn-displacement-field-and-the-real-human-chimpanzee-displacement-field-at-the-11-landmarks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Direction cosine between Thompson's drawn displacement field and the real human->chimpanzee displacement field at the 11 landmarks = 0.728 cosine (dimensionless)" ;
        schema:measurementTechnique "both fields expressed in the Fig. 404 human frame after Procrustes superimposition of the real chimpanzee onto the drawn human" ;
        schema:name "Direction cosine between Thompson's drawn displacement field and the real human->chimpanzee displacement field at the 11 landmarks" ;
        schema:unitText "cosine (dimensionless)" ;
        schema:value "0.728" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-direction-cosine-between-thompson-s-drawn-displacement-field-and-the-real-human-chimpanzee-displacement-field-at-the-11-landmarks-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-direction-cosine-between-thompson-s-drawn-displacement-field-and-the-real-human-chimpanzee-displacement-field-at-the-11-landmarks-reference> a schema:PropertyValue ;
        dcterms:source "perfect agreement of direction; 0 = unrelated" ;
        schema:value "1.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-explained-fraction-by-the-affine-box-stretch-part-of-the-net-only-e2-null> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Explained fraction by the affine (box-stretch) part of the net only (E2 null) = -0.1222 fraction (dimensionless)" ;
        schema:measurementTechnique "affine component A of the TPS applied to the Fig. 404 landmarks; Procrustes distance to the real chimpanzee" ;
        schema:name "Explained fraction by the affine (box-stretch) part of the net only (E2 null)" ;
        schema:unitText "fraction (dimensionless)" ;
        schema:value "-0.1222" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-explained-fraction-by-the-affine-box-stretch-part-of-the-net-only-e2-null-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-explained-fraction-by-the-affine-box-stretch-part-of-the-net-only-e2-null-reference> a schema:PropertyValue ;
        dcterms:source "repo box-vs-warping protocol (thompson/run_box_vs_warping_audit.py): a rectangular box stretch is the trivial alternative to Thompson's curvilinear warp" ;
        schema:value "0.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-explained-fraction-of-the-human-chimpanzee-procrustes-distance-removed-by-thompson-s-fig-405-net-applied-to-the-fig-404-human-landmarks-e6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Explained fraction of the human->chimpanzee Procrustes distance removed by Thompson's Fig. 405 net applied to the Fig. 404 human landmarks (E6) = 0.3506 fraction (dimensionless)" ;
        dcterms:description "d(H,C)=0.383 -> d(T(H),C)=0.249; affine box-stretch part alone: E=-0.122" ;
        schema:measurementTechnique "TPS through the 30 digitised Fig. 405 nodes applied to 11 human landmarks of Fig. 404; full Procrustes distance to the real Pan troglodytes specimen (MWNH 230) before and after" ;
        schema:name "Explained fraction of the human->chimpanzee Procrustes distance removed by Thompson's Fig. 405 net applied to the Fig. 404 human landmarks (E6)" ;
        schema:unitText "fraction (dimensionless)" ;
        schema:value "0.3506" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-explained-fraction-of-the-human-chimpanzee-procrustes-distance-removed-by-thompson-s-fig-405-net-applied-to-the-fig-404-human-landmarks-e6-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-explained-fraction-of-the-human-chimpanzee-procrustes-distance-removed-by-thompson-s-fig-405-net-applied-to-the-fig-404-human-landmarks-e6-reference> a schema:PropertyValue ;
        dcterms:source "null: no transformation (E = 0); Thompson (1917) p. 771 claims the deformed net 'constitutes a simple projection of our human skull' onto the chimpanzee" ;
        schema:value "0.0" .


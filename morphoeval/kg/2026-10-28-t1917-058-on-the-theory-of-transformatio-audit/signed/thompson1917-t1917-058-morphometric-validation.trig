    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-affine-fraction-of-the-human-baboon-landmark-displacement-e2-e3-decomposition> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Affine fraction of the human->baboon landmark displacement (E2/E3 decomposition) = 0.3447 fraction of displacement sum of squares" ;
        schema:measurementTechnique "least-squares affine fit of the Procrustes-superimposed specimen to the human specimen; remainder is non-affine (bending)" ;
        schema:name "Affine fraction of the human->baboon landmark displacement (E2/E3 decomposition)" ;
        schema:unitText "fraction of displacement sum of squares" ;
        schema:value "0.3447" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-affine-fraction-of-the-human-baboon-landmark-displacement-e2-e3-decomposition-reference> .


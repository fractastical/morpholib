    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Cartesian transformation of the human skull into chimpanzee, baboon and dog (Figs. 404-408) — Morphometric validation: 50/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Scale-free morphometrics (Procrustes distances, explained fraction, displacement cosines, cell-area log gradient, facial index, facial angle) are computed on the real specimens and the facial angles (89/68/56/45 deg) fall in the textbook Camper bands for man / chimpanzee / baboon / dog. Deductions: no confidence intervals or permutation null for the 35 % headline; no goodness-of-fit statistics (r, RMSE, KS) beyond R^2 of the area fit; no literature landmark table was found to compare against; the C5 'different lines' test (cos chimp-dog 0.78 vs chimp-baboon 0.78) is a tie and not a meaningful discriminator." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5.1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-058_on-the-theory-of-transformations.py L450–L480: verdict_from: 11 point-estimate binary checks, no uncertainty <https://github.com/fractastical/morpholib/blob/6475519d7/thompson/claims/t1917-058_on-the-theory-of-transformations.py#L450-L480>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-affine-fraction-of-the-human-baboon-landmark-displacement-e2-e3-decomposition>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-affine-fraction-of-the-human-chimpanzee-landmark-displacement-e2-e3-decomposition>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-affine-fraction-of-the-human-dog-landmark-displacement-e2-e3-decomposition>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-bending-energy-of-the-reconstructed-fig-405-net-e3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-cell-area-ratio-bottom-row-top-row-of-the-chimpanzee-net>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-cell-area-ratio-front-column-back-column-of-the-chimpanzee-net>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-cosine-between-the-human-chimpanzee-and-human-baboon-displacement-fields-c2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-cosine-between-the-human-chimpanzee-and-human-dog-displacement-fields-c5>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-direction-cosine-between-thompson-s-drawn-displacement-field-and-the-real-human-chimpanzee-displacement-field-at-the-11-landmarks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-explained-fraction-by-the-affine-box-stretch-part-of-the-net-only-e2-null>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-explained-fraction-of-the-human-chimpanzee-procrustes-distance-removed-by-thompson-s-fig-405-net-applied-to-the-fig-404-human-landmarks-e6>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-facial-angle-baboon-specimen-pro-nas-vs-frankfort-orbi-por-anterior-side-e7>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-facial-angle-chimpanzee-specimen-pro-nas-vs-frankfort-orbi-por-anterior-side-e7>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-facial-angle-dog-specimen-pro-nas-vs-frankfort-orbi-por-anterior-side-e7>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-facial-angle-human-specimen-pro-nas-vs-frankfort-orbi-por-anterior-side-e7>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-measurement-facial-index-f-nas-pro-nas-opc-baboon-specimen>,

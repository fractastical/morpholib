sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/delphi/resource/model/claude-fable-5.1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1109/34.24792>,
            <https://doi.org/10.1111/j.1525-142X.2005.05027.x>,
            <https://doi.org/10.5061/dryad.7r85116> .

    <https://archive.org/details/ongrowthform1917thom> dcterms:date "1917"^^xsd:gYear ;
        dcterms:title "On Growth and Form, Ch. XVII On the Theory of Transformations, pp. 770-773, Figs. 404-408" .

    <https://doi.org/10.1109/34.24792> dcterms:date "1989"^^xsd:gYear ;
        dcterms:title "Principal warps: thin-plate splines and the decomposition of deformations" .

    <https://doi.org/10.1111/j.1525-142X.2005.05027.x> dcterms:date "2005"^^xsd:gYear ;
        dcterms:title "Heterochrony and geometric morphometrics: a comparison of cranial growth in Pan paniscus versus Pan troglodytes" .

    <https://doi.org/10.5061/dryad.7r85116> dcterms:date "2018"^^xsd:gYear ;
        dcterms:title "Data from: Multiple factors behind early diversification of skull morphology in the continental radiation of New World monkeys" .
}

sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-058> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-specimen-match> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Cartesian transformation of the human skull into chimpanzee, baboon and dog (Figs. 404-408) — Morphological realism / specimen match: 55/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Rendered side by side (panel c vs Fig. 406) the human drawing warped through the digitised net is recognisably Thompson's chimpanzee figure, and the quantitative test against a REAL chimpanzee specimen is positive (35 % explained, T(H) closer to the real chimp than to the real human). Deductions: n = 1 specimen per taxon; the human 'specimen' is a rendered anatomical model, not a museum photograph; all landmarks were digitised by the loop agent (+/- ~12 px) with no uncertainty propagated; the human drawing itself sits d_P = 0.21 from the human specimen, two-thirds of the human-chimp distance, so drawing fidelity is a confound." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5.1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-058/t1917_058_metrics.json (generated output, not in repo): drawing_fidelity: d(Fig.404, human specimen) = 0.210; human specimen is a render — datasets/thompson_1917/t1917-058/t1917_058_metrics.json: rendered output of thompson/claims/t1917-058_on-the-theory-of-transformations.py at 6475519d7, application/json, 21052 B, artifact_sha256 eb39ec6f3b02e77fcfd31de6f195aa5a2421eeaeb7f0e1e40c609c9700127695 (sha256 eb39ec6f3b02e77fcfd31de6f195aa5a2421eeaeb7f0e1e40c609c9700127695), spec_fingerprint 974f3b1907dd69da0acb085b9f36dedce4c4532b025e0bf27519cd77a4567dc9" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-specimen-match-2> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_058_on_the_theory_of_transformatio_comparison.png (generated output)" ;
        dcterms:description "panel c (warped Fig. 404 inside the Fig. 405 net) next to the four landmarked specimens and the Procrustes overlay — docs/media/t1917_058_on_the_theory_of_transformatio_comparison.png: rendered output of thompson/claims/t1917-058_on-the-theory-of-transformations.py at 6475519d7, image/png, 1125970 B, 1980×1210 px, artifact_sha256 af29c319c321f54e0a3e20afadd5a29270bc96b1373db6d9035ede0023daa436 (sha256 af29c319c321f54e0a3e20afadd5a29270bc96b1373db6d9035ede0023daa436), spec_fingerprint 974f3b1907dd69da0acb085b9f36dedce4c4532b025e0bf27519cd77a4567dc9" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-058/t1917_058_metrics.json (generated output)" ;
        dcterms:description "C1 targets: explained 0.351 chimp, 0.238 baboon, 0.218 dog, -0.270 human specimen — datasets/thompson_1917/t1917-058/t1917_058_metrics.json: rendered output of thompson/claims/t1917-058_on-the-theory-of-transformations.py at 6475519d7, application/json, 21052 B, artifact_sha256 eb39ec6f3b02e77fcfd31de6f195aa5a2421eeaeb7f0e1e40c609c9700127695 (sha256 eb39ec6f3b02e77fcfd31de6f195aa5a2421eeaeb7f0e1e40c609c9700127695), spec_fingerprint 974f3b1907dd69da0acb085b9f36dedce4c4532b025e0bf27519cd77a4567dc9" .

    <https://w3id.org/delphi/resource/model/claude-fable-5.1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dcterms:identifier "claude-fable-5.1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .
}


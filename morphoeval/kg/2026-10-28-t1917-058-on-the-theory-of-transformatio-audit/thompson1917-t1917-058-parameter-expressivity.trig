sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-058> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Cartesian transformation of the human skull into chimpanzee, baboon and dog (Figs. 404-408) — Parameter expressivity: 40/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "The two morphospace parameters are exposed (--lam regularisation toward the affine limit, --k deformation intensity) and the GIF animates k from 0 to 2, but v1 runs and reports only lam = 0, k = 1: no sweep table, no demonstration that E or the facial angle move monotonically with k, no affine-limit check as lam -> infinity." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5.1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "thompson/claims/t1917-058_on-the-theory-of-transformations.py L341–L345: analyse() evaluates a single (lam, k) pair; no sweep <https://github.com/fractastical/morpholib/blob/6475519d7/thompson/claims/t1917-058_on-the-theory-of-transformations.py#L341-L345>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-parameter-expressivity-2> ;
        pk:hasScore "0.4"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-058_on-the-theory-of-transformations.py L785–L795" ;
        dct:description "--lam and --k CLI options exist" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/6475519d7/thompson/claims/t1917-058_on-the-theory-of-transformations.py#L785-L795> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_058_on_the_theory_of_transformatio_growth.gif (generated output)" ;
        dct:description "k = 0 -> 1 -> 2 morph of the net with the warped drawing — docs/media/t1917_058_on_the_theory_of_transformatio_growth.gif: rendered output of thompson/claims/t1917-058_on-the-theory-of-transformations.py at 6475519d7, image/gif, 1179678 B, 480×340 px, 19 frames, artifact_sha256 0f3e8a28771947c1d4d5bb2e0588d7f12173fc967eb74aaef2bae069037558ee (sha256 0f3e8a28771947c1d4d5bb2e0588d7f12173fc967eb74aaef2bae069037558ee), spec_fingerprint 974f3b1907dd69da0acb085b9f36dedce4c4532b025e0bf27519cd77a4567dc9" .
    <https://w3id.org/delphi/resource/model/claude-fable-5.1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dct:identifier "claude-fable-5.1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/claude-fable-5.1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1109/34.24792>,
            <https://doi.org/10.1111/j.1525-142X.2005.05027.x>,
            <https://doi.org/10.5061/dryad.7r85116> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form, Ch. XVII On the Theory of Transformations, pp. 770-773, Figs. 404-408" .
    <https://doi.org/10.1109/34.24792> dct:date "1989"^^xsd:gYear ;
        dct:title "Principal warps: thin-plate splines and the decomposition of deformations" .
    <https://doi.org/10.1111/j.1525-142X.2005.05027.x> dct:date "2005"^^xsd:gYear ;
        dct:title "Heterochrony and geometric morphometrics: a comparison of cranial growth in Pan paniscus versus Pan troglodytes" .
    <https://doi.org/10.5061/dryad.7r85116> dct:date "2018"^^xsd:gYear ;
        dct:title "Data from: Multiple factors behind early diversification of skull morphology in the continental radiation of New World monkeys" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF on a moving-boundary FEM limb-bud outgrowth mesh — Source and data traceability: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "All 8 sources carry DOIs in the module docstring (L7-38), the two BibTeX files and the dataset README; six dataset files are SHA-256 pinned and verified fail-closed on every run (L135-182), including the new reference table and the Pass 3 BibTeX file, kept separate so the v2 digests are unchanged. Deductions: the Raspopovic et al. (2014) supplementary growth maps and modulation functions were not retrieved, so the FEM layer's provenance is to secondary descriptions (-4); no digitised data from Boehm (2010), Marcon (2011) or Sheth (2012) are vendored and the reference table was written in this loop (-4); the v2 reference JSON's FGF/Hox table pairs k_bs_eff with lambda_obs in a direction the model does not produce and carries no per-row source pointer (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/bmp_sox9_wnt_digits/limb_bud_outgrowth_fem_reference.json L7–L11: not_vendored list: growth kinetics, bud outline and the paper's modulation functions are absent (deduction) <https://github.com/fractastical/morpholib/blob/d58a084/datasets/bmp_sox9_wnt_digits/limb_bud_outgrowth_fem_reference.json#L7-L11>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-source-traceability-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L135–L182" ;
        dcterms:description "EXPECTED_SHA256 for 6 files incl. limb_bud_outgrowth_fem_reference.json and paper_citations_pass3.bib; verify_dataset_integrity raises on mismatch" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L135-L182> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/bmp_sox9_wnt_digits/paper_citations_pass3.bib L1–L45" ;
        dcterms:description "Crampin 1999, Boehm 2010, Marcon 2011, Shubin & Alberch 1986 with DOIs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/bmp_sox9_wnt_digits/paper_citations_pass3.bib#L1-L45> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/bmp_sox9_wnt_digits/README.md L27–L38" ;
        dcterms:description "Items 5-6 document the new table, its caveat and the Pass 3 solver summary" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/bmp_sox9_wnt_digits/README.md#L27-L38> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 remediation + re-score; MorphoEval Autonomous Loop Slot 016)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


    <https://doi.org/10.1006/bulm.1999.0131> dcterms:date "1999"^^xsd:gYear ;
        dcterms:title "Reaction and diffusion on growing domains: Scenarios for robust pattern formation" .

    <https://doi.org/10.1007/978-1-4615-6983-1_6> dcterms:date "1986"^^xsd:gYear ;
        dcterms:title "A morphogenetic approach to the origin and basic organization of the tetrapod limb" .


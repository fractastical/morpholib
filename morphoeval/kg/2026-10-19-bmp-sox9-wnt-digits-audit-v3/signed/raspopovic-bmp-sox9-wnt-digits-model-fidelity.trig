sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF on a moving-boundary FEM limb-bud outgrowth mesh — Model fidelity to source: 82/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The core of the paper is implemented correctly and now exercised on a growing domain: exact 3-node and reduced Jacobians and dispersion relation (L206-301, Lean Laws 1-3), a P1 FEM whose stiffness reproduces the Laplacian of x^2 to 4e-16 and whose seeded-mode growth rate is within 2.2 % of Re sigma(q_c) (L960-1030), a conservative ALE update that is the exact discrete form of the Crampin-Gaffney-Maini dilution term (L883-886, Lean Law 4), implicit diffusion with re-assembly on the moving mesh (L874-876), and unbiased-noise initial conditions (L845-848). Deductions: the v2 2D polar-fan solver that still feeds one measurement seeds the target 5-ray mode (L526-528), scales radial diffusion by 0.0008 (L549-550) and masks the output with a cosmetic envelope (L514, L560-567), so its '5 radial digits' are imposed (-6); the 7-regime FGF/Hox collapse uses a fitted diffusion exponent 3.12 (L318) although the network's own dispersion relation shortens lambda_c when k_bs rises (5.02 -> 3.27 for k_bs 1.0 -> 3.2), i.e. the table is fitted, not predicted (-5); the FEM wavelength modulation D ∝ (r/R(t))^2 (L850-856) is a modelling choice, not the paper's modulation function (-3); the fan geometry, uniform stretch and exponential-capped outgrowth (L712-718, L871) replace the paper's realistic growth map (-2); the perturbation suite applies hand-set basal Sox9 offsets per condition (L617-629) (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2014-raspopovic-bmp-sox9-wnt-digits.py L318–L318: Fitted diffusion scaling exponent 3.12 that manufactures the FGF/Hox wavelength collapse (deduction) <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L318-L318>",
            "2014-raspopovic-bmp-sox9-wnt-digits.py L526–L528: v2 2D fan solver seeds the target angular mode as its initial condition (deduction) <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L526-L528>",
            "2014-raspopovic-bmp-sox9-wnt-digits.py L850–L856: D ∝ (r/R(t))^2 modulation: declared reduction, not the paper's modulation function (deduction) <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L850-L856>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity-4> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L721–L742" ;
        dcterms:description "P1 stiffness / lumped-mass assembly with per-element diffusivity on the current (deformed) coordinates" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L721-L742> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L869–L886" ;
        dcterms:description "Moving boundary R(t) = min(R1, R0 exp(g t)), stiffness re-assembly every 4 steps, conservative ALE update M_new c_new = M_old (c + dt f) with implicit diffusion for B and W" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L869-L886> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L960–L1030" ;
        dcterms:description "FEM verification: K x^2 = -2M (4e-16), sum M = area, sigma_FEM vs analytic sigma(q) for n = 8, 10, 12 (max 4.7 %, 2.2 % at q_c), ALE mass conservation exact" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L960-L1030> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_016_bmp_sox9_wnt_digits.lean L98–L168" ;
        dcterms:description "Laws 4-6: dilution shift of the dispersion determinant (monotone in rho, sign restored at rho = 1.0), ray count monotone in arc length, self-similar ray-count invariance; lean exit 0, 0 sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_016_bmp_sox9_wnt_digits.lean#L98-L168> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 remediation + re-score; MorphoEval Autonomous Loop Slot 016)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


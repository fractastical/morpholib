sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L1033–L1085" ;
        dcterms:description "Growth-dilution sweep rho in {0,...,0.4}: measured sigma_eff, slope, threshold vs sigma_max" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L1033-L1085> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L1088–L1120" ;
        dcterms:description "Final-arc sweep over 5 self-similar fans with Spearman rho, slope and exact-match count" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L1088-L1120> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L1123–L1139" ;
        dcterms:description "3-mode x 3-seed modulation ablation with bifurcation range and P(5 rays)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L1123-L1139> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 remediation + re-score; MorphoEval Autonomous Loop Slot 016)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF on a moving-boundary FEM limb-bud outgrowth mesh — Parameter expressivity: 84/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Pass 3 adds three sweeps that behave as the formal laws predict: the dilution rate rho lowers sigma_eff linearly (slope -1.000, r = -1.000, threshold 0.265 vs 0.261; L1033-1085), the final arc length raises the distal ray count monotonically (2, 4, 5, 5, 6 over L_arc 12..28, Spearman 0.97, slope 0.225 vs 0.250; L1088-1120), and the modulation mode controls branching (scaled 0.00 < material 0.67 = none 0.67 mean bifurcation range over 3 seeds; L1123-1139); `--growth-rate` and `--fgf-mode` are wired through render_comparison_figure (L2029-2036, L1264-1268). Deductions: the arc sweep matches the integer law in only 2/5 cases because noise-driven mode selection in this broad-band network is +/- 1 ray (-5); the v2 7-regime FGF/Hox panel is a fitted curve (L318) and the LDN / CHIR counts are capped by hand (L644-649), so two of the nine panels do not demonstrate parameter control by the model (-7); the growth rate is swept only through the dilution proxy, not through full FEM runs at several g (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2014-raspopovic-bmp-sox9-wnt-digits.py L644–L649: LDN / CHIR digit counts capped by min(1, ...) / min(2, ...) (deduction) <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L644-L649>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-parameter-expressivity-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


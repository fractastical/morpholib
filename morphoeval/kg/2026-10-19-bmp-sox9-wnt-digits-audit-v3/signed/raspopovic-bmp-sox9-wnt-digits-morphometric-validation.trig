    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-3-node-bmp-sox9-wnt-critical-turing-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;

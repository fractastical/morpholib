    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-fem-radial-ray-bifurcation-range-with-aer-anchored-fgf-hox-wavelength-modulation-reference> a schema:PropertyValue ;

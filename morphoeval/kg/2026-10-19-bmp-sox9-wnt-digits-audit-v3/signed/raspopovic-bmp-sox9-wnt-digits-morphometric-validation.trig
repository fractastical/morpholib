        schema:measurementTechnique "Peak of 3x3 dispersion relation Re(sigma(q)) with D_S=0, D_B=2.5, D_W=0.25 (q_c=1.5700, sigma_max=0.2608)" ;
        schema:name "3-node Bmp-Sox9-Wnt critical Turing wavelength lambda_c" ;
        schema:unitText "dimensionless length" ;
        schema:value "4.002" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-3-node-bmp-sox9-wnt-critical-turing-wavelength-lambda-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-3-node-bmp-sox9-wnt-critical-turing-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dcterms:source "Raspopovic et al. (2014) Science 345:566-570 Fig. 2E & Supplementary Sec. 1.2" ;
        schema:value "4.002" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-ale-lumped-mass-growth-step-relative-mass-conservation-error> a schema:PropertyValue,

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-2d-fan-shaped-embryonic-autopod-radial-sox9-digit-ray-count-wild-type-reference> a schema:PropertyValue ;
        dcterms:source "Raspopovic et al. (2014) Science 345:566-570 Fig. 1 & Fig. 4B (wild-type pentadactyly)" ;

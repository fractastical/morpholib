sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF on a moving-boundary FEM limb-bud outgrowth mesh — Morphometric validation: 82/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L1698-1905) returns 18 measurements: the 9 v2 metrics plus 9 Pass 3 metrics with `reference_value`, `reference_source` and units — FEM ray count 5/5, bifurcation range 0/0, sigma_FEM error 0.022/0, ALE mass error 0/0, dilution slope -1.000/-1, rho_c 0.265/0.261, arc slope 0.225/0.250, addition events 3/2, marginal-insertion fraction 0.00/1.00 (L1721-1812). Deductions: eight of the nine new references are analytic or model-internal (dispersion relation, Lean laws) or qualitative statements, not measured values (-8); the one specimen-anchored qualitative reference (marginal digits last) is NOT met and the addition-event count overshoots its analytic reference (3 vs 2), both reported honestly (-3); the specimen metrics are still not compared with the FEM output (-4); the v2 '2D fan count = 5' measurement remains in the list although it is mode-seeded (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2014-raspopovic-bmp-sox9-wnt-digits.py L1796–L1811: Marginal-insertion fraction 0.00 vs reference 1.00 (Shubin & Alberch) — declared failed comparison (deduction) <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L1796-L1811>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-2d-fan-shaped-embryonic-autopod-radial-sox9-digit-ray-count-wild-type>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-3-node-bmp-sox9-wnt-critical-turing-wavelength-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-ale-lumped-mass-growth-step-relative-mass-conservation-error>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-biological-specimen-e12-5-wild-type-sox9-wish-digit-ray-count-panel-o>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-biological-specimen-tbx2-polydactylous-mutant-digit-ray-count-panel-l>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-biological-specimen-wild-type-sox9-inter-digit-spacing-cv-panel-o>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-distal-aer-fgf-hoxd-wavelength-scaling-correlation-across-7-regimes>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-fem-radial-ray-bifurcation-range-with-aer-anchored-fgf-hox-wavelength-modulation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-final-arc-sweep-slope-dn-rays-dl-arc-on-the-moving-mesh>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-fraction-of-ray-addition-events-at-the-handplate-margins-eta-0-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-growth-dilution-patterning-threshold-rho-c-dilution-rate-at-which-the-q-c-mode-is-neutral>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-growth-dilution-slope-d-sigma-eff-d-rho-of-the-q-c-turing-mode>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-moving-boundary-fem-limb-bud-distal-sox9-ray-count-fgf-mode-scaled-noise-ic>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-out-of-phase-sox9-vs-bmp-spatial-correlation-r-sox9-bmp>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-out-of-phase-sox9-vs-wnt-spatial-correlation-r-sox9-wnt>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-p1-fem-dispersion-verification-relative-error-of-sigma-fem-vs-analytic-re-sigma-q-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-sequential-ray-addition-events-during-after-outgrowth-on-the-moving-mesh>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-zero-diffusion-negative-control-digit-count-d-b-d-w-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-morphometric-validation-2> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-2d-fan-shaped-embryonic-autopod-radial-sox9-digit-ray-count-wild-type> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D fan-shaped embryonic autopod radial Sox9 digit ray count (Wild-Type) = 5.0 digits" ;
        dcterms:description "1D distal arc count = 5.0" ;
        schema:measurementTechnique "Distal arc peak count of 2D polar-fan reaction-diffusion PDE with AER-FGF wavelength modulation" ;

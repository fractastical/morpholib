    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-growth-dilution-patterning-threshold-rho-c-dilution-rate-at-which-the-q-c-mode-is-neutral-reference> a schema:PropertyValue ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF on a moving-boundary FEM limb-bud outgrowth mesh — Reproducibility package: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`--self-test` runs 12 checks in 55 s (L1908-2017): SHA-256 of 6 files, Laws 1-3, FGF table, perturbation ordering, specimen segmentation, 1D determinism, FEM stiffness / mass / dispersion / ALE checks, 5 unbranched rays with out-of-phase ligands and sequential addition, ablation ordering, dilution slope and threshold, arc monotonicity, and bitwise FEM determinism from a fresh integration (L2002-2005); the default render takes 41 s and writes both artefacts; all parameters are exposed in argparse (L2020-2062). Deductions: no lock file pins the interpreter / numpy / scipy / matplotlib / Pillow versions, and the v2 audit recorded versions that differ from the venv (-5); when `~/.matplotlib` is not writable the run emits font-cache warnings and writes a temporary cache, which the script does not control via MPLCONFIGDIR (-2); the self-test tolerance on the arc slope (0.08) and the 5 % sigma tolerance are lenient relative to the 2.2 % achieved (-2); the GIF palette is quantised from the first frame, so byte identity across Pillow versions is not guaranteed (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2014-raspopovic-bmp-sox9-wnt-digits.py L1993–L2000: Lenient tolerances: |slope - 1/lambda| < 0.08, Spearman > 0.9 (deduction) <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L1993-L2000>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-repro-package-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L1908–L2017" ;
        dcterms:description "12-check self_test incl. FEM verification (9), growing-mesh outcome (10), Laws 4-5 realisations (11) and FEM bitwise determinism (12)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L1908-L2017> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L2020–L2062" ;
        dcterms:description "argparse CLI with --growth-rate, --fgf-mode, --seed, --skip-gif and the v2 overrides" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L2020-L2062> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 remediation + re-score; MorphoEval Autonomous Loop Slot 016)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF on a moving-boundary FEM limb-bud outgrowth mesh — Morphological realism / specimen match: 81/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Panel F still segments the SHA-256-locked Farin et al. (2013) WISH image (L1145-1245: 5 WT E12.5 Sox9 rays, 5 WT E13.5 Col2a1 rays, 6 Tbx2-/- rays, spacing CV 0.155) and Panel A now places a genuinely emergent 5-ray FEM limb bud beside it (L1311-1332), with the outgrowth sequence (Panel G, L1520-1552), the bifurcating ablation (Panel H, L1555-1574) and an 8-frame GIF of the growing mesh (L1622-1695). The rays run unbranched from wrist to AER and are out of phase with Bmp, as in the paper's Fig. 2 and 4. Deductions: the FEM bud is a sharp-cornered sector, not the rounded paddle of the specimen, and its marginal rays sit on the anterior / posterior boundary as half-rays whereas the specimen's digits I and V are inset behind an interdigital margin (-8); no quantitative side-by-side of the FEM rays with the specimen (ray width, spacing CV, taper) is made — the specimen metrics are compared only with the v2 1D / fan solvers (-5); the v2 2D fan panel has been replaced, but the ablation panel's 'none' case shows 4 vs 3 rays rather than the clear Y-splits of the paper's unmodulated simulation (-3); the GIF right panel is the 1D profile, not the FEM ligand fields (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2014-raspopovic-bmp-sox9-wnt-digits.py L712–L718: Fan geometry with straight radial margins: marginal half-rays at the boundary unlike the specimen (deduction) <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L712-L718>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-specimen-match-3> ;
        pk:hasScore "0.81"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/bmp_sox9_wnt_digits_comparison.png (generated output)" ;
        dct:description "Panel A FEM limb bud with 5 unbranched rays beside Panel F specimen (5 WT rays, red markers on the distal arc); Panel G four outgrowth snapshots; Panel H unmodulated ablation — docs/media/bmp_sox9_wnt_digits_comparison.png: rendered output of 2014-raspopovic-bmp-sox9-wnt-digits.py at d58a084, image/png, 1351556 B, 2453×2288 px, artifact_sha256 22b27c34b46a015ca80913991f77bbaec823119454402539c53eb86847740d91 (sha256 22b27c34b46a015ca80913991f77bbaec823119454402539c53eb86847740d91), spec_fingerprint fcc019aeaf38ae13b447dccbc8f276f80745d761e03ea95627ecad0617dd1321" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/bmp_sox9_wnt_digits_growth.gif (generated output)" ;
        dct:description "8 frames: mesh grows R 5.0 -> 8.4, rays emerge at t ~ 26-40 and remain unbranched; right panel 1D profile — docs/media/bmp_sox9_wnt_digits_growth.gif: rendered output of 2014-raspopovic-bmp-sox9-wnt-digits.py at d58a084, image/gif, 327402 B, 1071×472 px, 8 frames, artifact_sha256 4e203e19a1be5f36e392110e1f374c9b4571cc6a80d55236bfea5d3e3e36d60b (sha256 4e203e19a1be5f36e392110e1f374c9b4571cc6a80d55236bfea5d3e3e36d60b), spec_fingerprint fcc019aeaf38ae13b447dccbc8f276f80745d761e03ea95627ecad0617dd1321" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L1145–L1245" ;
        dct:description "Specimen segmentation unchanged from v2 (DoG + chromogen ridge, distal arc transect)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L1145-L1245> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 remediation + re-score; MorphoEval Autonomous Loop Slot 016)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


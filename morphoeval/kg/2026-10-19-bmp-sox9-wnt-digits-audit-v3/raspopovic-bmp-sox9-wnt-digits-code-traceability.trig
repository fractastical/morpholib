sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF on a moving-boundary FEM limb-bud outgrowth mesh — Code-to-model traceability: 86/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring maps each solver and each of the 6 Lean laws to its source (L1-104); the Section 3b header states geometry, growth law, boundary condition and length unit (L669-679); `simulate_growing_limb_bud_fem` documents the scheme, the three modulation modes and the reduction (L798-818); the registry YAML pins Lean and code loci for laws 4-6 (morphoeval/math_kg_loops/raspopovic-bmp-sox9-wnt-digits.yaml L86-135). Deductions: the exponent 3.12 (L318), the per-condition basal offsets and caps (L617-629, L644-649), the envelope constants 0.45 / 0.35 / 0.0008 of the v2 fan (L511-514, L549) and the ray-count threshold 0.35 (L754) have no citation (-8); the F -> D mapping is justified by an invariance argument rather than by a paper equation (-4); the arc sweep's expected counts use lambda = 4 while the script's lambda_c is 4.002 (stated, but a second convention) (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2014-raspopovic-bmp-sox9-wnt-digits.py L617–L629: Hand-set basal Sox9 offsets and IWP-2 parameter overrides without citation (deduction) <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L617-L629>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-code-traceability-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L40–L104" ;
        dct:description "Pass 3 docstring: remediation statement, honest-reduction paragraph, Laws 4-6 with Lean theorem names and realising functions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L40-L104> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L669–L679" ;
        dct:description "Section 3b header: geometry, growth law, BC, length unit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L669-L679> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/raspopovic-bmp-sox9-wnt-digits.yaml L86–L135" ;
        dct:description "Laws 4-6 registered with lean_locus and code_locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/raspopovic-bmp-sox9-wnt-digits.yaml#L86-L135> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 remediation + re-score; MorphoEval Autonomous Loop Slot 016)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


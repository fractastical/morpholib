    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3186.equalDiffusionSigmaScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3186.equal_diffusion_suppresses_the_instability" ;
    pk:leanVerified true .


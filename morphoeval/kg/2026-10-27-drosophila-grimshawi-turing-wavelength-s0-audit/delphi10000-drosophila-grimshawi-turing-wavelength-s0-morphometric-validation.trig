sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila grimshawi Turing wavelength at 2.8 µm (detail) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Growth Pearson r = 0.99974 against the exponential law; radial envelope Pearson r = 0.99542 against the masked specimen. KS and Otsu segmentation are not yet reported." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-dispersion-growth-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-equal-diffusion-control-max-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-grimshawi-fastest-mode-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-numerical-mode-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-predecessor-ficusphila-detail-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-segmented-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-specimen-radial-pigment-profile-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-successor-guttifera-detail-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-dispersion-growth-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion growth Pearson r = 0.99974 Pearson r" ;
        dct:description "log-amplitude RMSE=0.01503" ;
        schema:measurementTechnique "pearsonr(t, log amplitude) on the linear-regime cosine mode" ;
        schema:name "dispersion growth Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99974" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-dispersion-growth-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-dispersion-growth-pearson-r-reference> a schema:PropertyValue ;
        dct:source "pre-registered goodness-of-fit gate" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-equal-diffusion-control-max-sigma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control max sigma = -0.7167 1/time" ;
        dct:description "negative control" ;
        schema:measurementTechnique "max_k σ(k) at D_u = D_v" ;
        schema:name "equal-diffusion control max sigma" ;
        schema:unitText "1/time" ;
        schema:value "-0.7167" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-equal-diffusion-control-max-sigma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-equal-diffusion-control-max-sigma-reference> a schema:PropertyValue ;
        dct:source "Turing instability requires σ>0; the control must not" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-grimshawi-fastest-mode-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "grimshawi fastest-mode wavelength = 2.7659 µm" ;
        dct:description "k_c=2.2717 1/µm; σ_max=1.8705" ;
        schema:measurementTechnique "k_c = argmax sigma(k) for Schnakenberg δ=16.3186; lambda = 2π/k_c" ;
        schema:name "grimshawi fastest-mode wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.7659" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-grimshawi-fastest-mode-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-grimshawi-fastest-mode-wavelength-reference> a schema:PropertyValue ;
        dct:source "slot label 2.8 µm; metre anchor 2.765e-06 m" ;
        schema:value "2.8" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-numerical-mode-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "numerical mode growth rate = 1.8841 1/time" ;
        dct:description "discrete Laplacian shifts σ slightly below the continuum value" ;
        schema:measurementTechnique "log-amplitude slope of a cosine-seeded Schnakenberg integration" ;
        schema:name "numerical mode growth rate" ;
        schema:unitText "1/time" ;
        schema:value "1.8841" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-numerical-mode-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-numerical-mode-growth-rate-reference> a schema:PropertyValue ;
        dct:source "analytic σ(k_c) of the same Jacobian" ;
        schema:value "1.8705" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-predecessor-ficusphila-detail-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "predecessor ficusphila detail wavelength = 2.5123 µm" ;
        dct:description "shorter than grimshawi" ;
        schema:measurementTechnique "same kinetics, δ=10.40" ;
        schema:name "predecessor ficusphila detail wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.5123" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-predecessor-ficusphila-detail-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-predecessor-ficusphila-detail-wavelength-reference> a schema:PropertyValue ;
        dct:source "focal grimshawi λ_c" ;
        schema:value "2.7659" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-segmented-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented specimen structure-tensor coherency = 0.2122 coherency" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) of the Sobel structure tensor inside the caption-excluded mask" ;
        schema:name "segmented specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.2122" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-segmented-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-segmented-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "isotropic null coherency is not the measured value" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-specimen-radial-pigment-profile-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial pigment profile Pearson r = 0.99542 Pearson r" ;
        dct:description "RMSE=1.5835 gray levels" ;
        schema:measurementTechnique "degree-5 polynomial amplitude R(ρ) versus azimuthally averaged gallery luminance" ;
        schema:name "specimen radial pigment profile Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99542" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-specimen-radial-pigment-profile-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-specimen-radial-pigment-profile-pearson-r-reference> a schema:PropertyValue ;
        dct:source "radial-envelope calibration target (not the achieved correlation)" ;
        schema:value "0.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-successor-guttifera-detail-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "successor guttifera detail wavelength = 2.6291 µm" ;
        dct:description "intermediate between ficusphila and grimshawi" ;
        schema:measurementTechnique "same kinetics, δ=12.85" ;
        schema:name "successor guttifera detail wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.6291" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-successor-guttifera-detail-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-measurement-successor-guttifera-detail-wavelength-reference> a schema:PropertyValue ;
        dct:source "predecessor λ_c" ;
        schema:value "2.5123" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-grimshawi-turing-wavelength-s0.py L368–L455" ;
        dct:description "measure_morphoeval" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-grimshawi-turing-wavelength-s0.py#L368-L455> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-grimshawi-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-grimshawi-turing-wavelength-s0.py L204–L214" ;
        dct:description "radial envelope fit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-grimshawi-turing-wavelength-s0.py#L204-L214> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, loop 3186 pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


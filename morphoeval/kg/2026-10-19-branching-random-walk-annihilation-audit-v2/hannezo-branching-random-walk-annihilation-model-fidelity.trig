sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-branching-random-walk-annihilation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2017) Cell & Scheele et al. (2017) Nature unifying theory of branching morphogenesis via branching and annihilating random walks (BARW) — Model fidelity to source: 95/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements the full 2D off-lattice spatial BARW ductal network simulator with persistent tip migration, Poisson bifurcation (A -> 2A), immutable ductal trail deposition (A -> A + I), and steric/TGF-beta tip-duct annihilation within sensing radius R_a (A + I -> I) (L156-341); solves the 1D mean-field Fisher-KPP travelling-wave BARW PDE system (L348-420); computes exact critical Galton-Watson subtree size distributions P(S = 2n+1) via Catalan numbers (L126-149); and evaluates multi-organ universality across mouse mammary gland, kidney, and pancreas plus TGF-beta / R_a perturbations and R_a = 0 non-annihilating explosion ablation (L427-504). Backed by 3 machine-checked Lean 4 theorems (0 `sorry`s) in `Loop_056_branching_random_walk_annihilation.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L156–L341" ;
        dct:description "2D off-lattice spatial BARW ductal tree simulator with persistent migration, bifurcation, trail deposition, and R_a annihilation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2017-hannezo-branching-random-walk-annihilation.py#L156-L341> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L348–L504" ;
        dct:description "1D Fisher-KPP travelling-wave BARW PDE solver, 3-organ universality collapse, and R_a perturbation/ablation suite" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2017-hannezo-branching-random-walk-annihilation.py#L348-L504> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_056_branching_random_walk_annihilation.lean L46–L147" ;
        dct:description "3 machine-checked Lean 4 theorems for topological tree balance, homeostatic duct density, and R_a hyper-branching scaling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_056_branching_random_walk_annihilation.lean#L46-L147> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 056 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


        rdfs:label "2017-hannezo-branching-random-walk-annihilation.py L511–L583" ;
        dcterms:description "Chromatic active-tip bud segmentation and EDT medial-axis branch junction extraction on mouse specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2017-hannezo-branching-random-walk-annihilation.py#L511-L583> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/branching_random_walk_annihilation_comparison.png (generated output)" ;
        dcterms:description "6-panel synthesis figure displaying mouse branched ductal network CV segmentation in Panel F — docs/media/branching_random_walk_annihilation_comparison.png: rendered output of 2017-hannezo-branching-random-walk-annihilation.py at 8871db0, image/png, 1176186 B, 2475×1530 px, artifact_sha256 0c1bc09baee06f93d711f322845926b9e9d8a650e09d2cff65f58c8c8299ced5 (sha256 0c1bc09baee06f93d711f322845926b9e9d8a650e09d2cff65f58c8c8299ced5), spec_fingerprint 8396b081dd41f5428f101435bc6396b6e50c4b756e20f4883dc6ac81bd4c137b" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 056 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2017) Cell & Scheele et al. (2017) Nature unifying theory of branching morphogenesis via branching and annihilating random walks (BARW) — Morphological realism / specimen match: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Loads and SHA-256-verifies the whole-mount fluorescence micrograph of the embryonic mouse branched epithelial ductal network (`datasets/branching_random_walk_annihilation/mouse_branched_ductal_network_specimen.jpg`) and segments the cyan/bright-green active distal buds (A) via chromatic difference scoring and connected components alongside the blue/magenta differentiated ductal tree (I) via Euclidean distance transform (EDT) medial-axis junction detection (`segment_specimen_branched_ductal_network`, L511-583), recovering N_term = 34 active tips (localized at peripheral invading radius r/R_max = 0.7833 ± 0.2582) and N_branch = 33 internal bifurcations (exact binary-tree identity 34 = 33 + 1, q_branch = 33/67 = 0.4925)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-specimen-match-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


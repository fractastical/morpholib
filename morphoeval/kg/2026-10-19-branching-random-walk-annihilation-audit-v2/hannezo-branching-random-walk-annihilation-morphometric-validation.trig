sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-branching-random-walk-annihilation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2017) Cell & Scheele et al. (2017) Nature unifying theory of branching morphogenesis via branching and annihilating random walks (BARW) — Morphometric validation: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L787-875) reports 8 quantitative morphometrics with reference values, dispersion statistics (RMSE, Pearson r, p-value, SD, CV), and negative-control ablation deltas: 2D BARW topological branching fraction q_branch = 0.480 (3-organ ensemble mean 0.4852 ± 0.0142 vs 0.50 critical point), critical Galton-Watson subtree exponent tau = 1.4418 (log-log r = -0.99990, p = 1.2e-18), generational q_branch(g) relaxation Pearson r = 0.99311 (RMSE = 0.0188, p = 9.76e-9 across mammary/kidney/pancreas), 1D homeostatic wake duct density i_inf = 0.28695 (wake CV = 0.0585 vs 0.28571 reference), attenuated-TGF-beta hyper-branching length ratio = 8.82x (vs 0.19x hypoplasia), R_a = 0 ablation explosion delta (+49 unarrested tips and 556 duct crossovers vs 0 in WT), and exact specimen segmentation (N_term = 34, N_branch = 33, q_branch = 0.4925, peripheral tip r/R_max = 0.7833 ± 0.2582)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-1d-mean-field-barw-homeostatic-wake-duct-density-i-inf>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-2d-barw-self-terminated-topological-branching-fraction-q-branch-wt>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-attenuated-tgf-beta-r-a-1-75-vs-wild-type-r-a-3-5-ductal-hyper-branching-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-critical-galton-watson-subtree-size-power-law-exponent-tau>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-generational-branching-probability-q-branch-g-correlation-across-3-organs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-mouse-branched-ductal-specimen-active-distal-tip-count-n-term>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-mouse-branched-ductal-specimen-peripheral-active-tip-radial-localization-r-r-max>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-non-annihilating-r-a-0-ablation-unarrested-active-tip-explosion-delta>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-morphometric-validation-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-1d-mean-field-barw-homeostatic-wake-duct-density-i-inf> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "1D mean-field BARW homeostatic wake duct density i_inf = 0.28695 dimensionless duct density" ;
        dct:description "wake plateau CV = 0.0585; travelling front speed c* = 0.6956 vs Fisher-KPP 0.7599" ;
        schema:measurementTechnique "spatial mean of differentiated duct density i(x, t_end) in colonized wake x in [10, 32] (wake CV = 0.0585, residual active tips a_wake = 0.00038)" ;
        schema:name "1D mean-field BARW homeostatic wake duct density i_inf" ;
        schema:unitText "dimensionless duct density" ;
        schema:value "0.28695" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-1d-mean-field-barw-homeostatic-wake-duct-density-i-inf-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-1d-mean-field-barw-homeostatic-wake-duct-density-i-inf-reference> a schema:PropertyValue ;
        schema:value "0.28571" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-2d-barw-self-terminated-topological-branching-fraction-q-branch-wt> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D BARW self-terminated topological branching fraction q_branch (WT) = 0.48 probability" ;
        dct:description "3-organ ensemble mean q_branch = 0.4852 ± 0.0142 (SD across mammary, kidney, pancreas)" ;
        schema:measurementTechnique "N_branch / (N_branch + N_term) = 12/25 with N_term = N_branch + 1 (active_end = 0)" ;
        schema:name "2D BARW self-terminated topological branching fraction q_branch (WT)" ;
        schema:unitText "probability" ;
        schema:value "0.48" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-2d-barw-self-terminated-topological-branching-fraction-q-branch-wt-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-2d-barw-self-terminated-topological-branching-fraction-q-branch-wt-reference> a schema:PropertyValue ;
        schema:value "0.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-attenuated-tgf-beta-r-a-1-75-vs-wild-type-r-a-3-5-ductal-hyper-branching-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Attenuated TGF-beta (R_a = 1.75) vs Wild-Type (R_a = 3.5) ductal hyper-branching ratio = 8.8235 L_total(R_a=1.75) / L_total(R_a=3.5)" ;
        dct:description "Exogenous TGF-beta hypoplasia (R_a=7.0) control ratio = 0.1903 vs WT" ;
        schema:measurementTechnique "ratio of total colonized ductal tree length under halved annihilation radius R_a = 1.75 vs wild-type R_a = 3.5" ;
        schema:name "Attenuated TGF-beta (R_a = 1.75) vs Wild-Type (R_a = 3.5) ductal hyper-branching ratio" ;
        schema:unitText "L_total(R_a=1.75) / L_total(R_a=3.5)" ;
        schema:value "8.8235" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-attenuated-tgf-beta-r-a-1-75-vs-wild-type-r-a-3-5-ductal-hyper-branching-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-attenuated-tgf-beta-r-a-1-75-vs-wild-type-r-a-3-5-ductal-hyper-branching-ratio-reference> a schema:PropertyValue ;
        schema:value "2.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-critical-galton-watson-subtree-size-power-law-exponent-tau> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Critical Galton-Watson subtree size power-law exponent tau = 1.4418 dimensionless exponent" ;
        dct:description "log-log Pearson r = -0.99990, p = 1.2e-18" ;
        schema:measurementTechnique "log-log linear regression on exact P(S = 2n+1) over S in [3, 45] (r = -0.99990)" ;
        schema:name "Critical Galton-Watson subtree size power-law exponent tau" ;
        schema:unitText "dimensionless exponent" ;
        schema:value "1.4418" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-critical-galton-watson-subtree-size-power-law-exponent-tau-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-critical-galton-watson-subtree-size-power-law-exponent-tau-reference> a schema:PropertyValue ;
        schema:value "1.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-generational-branching-probability-q-branch-g-correlation-across-3-organs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Generational branching probability q_branch(g) correlation across 3 organs = 0.99311 Pearson r" ;
        dct:description "RMSE = 0.0188, p = 9.76e-09" ;
        schema:measurementTechnique "Pearson r and RMSE between BARW generational relaxation curve and Hannezo et al. (2017) mammary/kidney/pancreas mean across g = 1..12 (RMSE = 0.0188, p = 9.76e-09)" ;
        schema:name "Generational branching probability q_branch(g) correlation across 3 organs" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99311" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-generational-branching-probability-q-branch-g-correlation-across-3-organs-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-generational-branching-probability-q-branch-g-correlation-across-3-organs-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-mouse-branched-ductal-specimen-active-distal-tip-count-n-term> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Mouse branched ductal specimen active distal tip count N_term = 34 active tips" ;
        dct:description "satisfies exact binary-tree identity N_term = N_branch + 1 (34 = 33 + 1), q_branch = 0.4925 vs 0.50 critical point" ;
        schema:measurementTechnique "chromatic cyan/green bud segmentation + connected components on mouse_branched_ductal_network_specimen.jpg (N_branch = 33 EDT junctions, q_branch = 0.4925)" ;
        schema:name "Mouse branched ductal specimen active distal tip count N_term" ;
        schema:unitText "active tips" ;
        schema:value "34" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-mouse-branched-ductal-specimen-active-distal-tip-count-n-term-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-mouse-branched-ductal-specimen-active-distal-tip-count-n-term-reference> a schema:PropertyValue ;
        schema:value "34" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-mouse-branched-ductal-specimen-peripheral-active-tip-radial-localization-r-r-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Mouse branched ductal specimen peripheral active-tip radial localization r/R_max = 0.7833 dimensionless radius r / R_max" ;
        dct:description "peripheral invading pulse r/R_max = 0.7833 ± 0.2582 vs interior differentiated duct plateau" ;
        schema:measurementTechnique "mean normalized radial position of N_term = 34 active distal buds relative to organ center (SD = 0.2582)" ;
        schema:name "Mouse branched ductal specimen peripheral active-tip radial localization r/R_max" ;
        schema:unitText "dimensionless radius r / R_max" ;
        schema:value "0.7833" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-mouse-branched-ductal-specimen-peripheral-active-tip-radial-localization-r-r-max-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-mouse-branched-ductal-specimen-peripheral-active-tip-radial-localization-r-r-max-reference> a schema:PropertyValue ;
        schema:value "0.783" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-non-annihilating-r-a-0-ablation-unarrested-active-tip-explosion-delta> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Non-annihilating R_a = 0 ablation unarrested active-tip explosion delta = 49 active tips at t_end" ;
        dct:description "negative control ablation delta = +49 unarrested tips and 556 ductal self-crossings vs 0 in WT" ;
        schema:measurementTechnique "unarrested active tips N_active(t_end) in R_a = 0 ablation control vs 0 active tips in self-terminating WT BARW (crossovers = 556)" ;
        schema:name "Non-annihilating R_a = 0 ablation unarrested active-tip explosion delta" ;
        schema:unitText "active tips at t_end" ;
        schema:value "49" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-non-annihilating-r-a-0-ablation-unarrested-active-tip-explosion-delta-reference> .

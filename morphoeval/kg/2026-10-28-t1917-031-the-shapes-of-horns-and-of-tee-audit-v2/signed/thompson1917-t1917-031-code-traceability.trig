    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XIII — bovid horns as logarithmic spirals wound on a cone (Pass 2) — Code-to-model traceability: 74/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Docstring maps E1-E5 and tests T1-T4 to pages; every fit/segmentation step is a named function with its equation id; reference.json carries the loci; the math-KG YAML links five laws to Lean declarations and script line ranges. Deductions: the ray-based inner-edge rule and the trimming rule are the script's own constructions, not Thompson's whorl-breadth procedure (Ch. XI p. 558), and this is only stated in comments." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;

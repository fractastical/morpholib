sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1007/s002850050081>,
            <https://doi.org/10.1186/s12915-021-00990-w>,
            <https://doi.org/10.5061/dryad.qz612jmb4> .

    <https://archive.org/details/ongrowthform1917thom> dcterms:date "1917"^^xsd:gYear ;
        dcterms:title "On Growth and Form — Ch. XIII, The Shapes of Horns, and of Teeth or Tusks: with a Note on Torsion" .

    <https://doi.org/10.1007/s002850050081> dcterms:date "1997"^^xsd:gYear ;
        dcterms:title "Kinematics of surface growth" .

    <https://doi.org/10.1186/s12915-021-00990-w> dcterms:date "2021"^^xsd:gYear ;
        dcterms:title "A universal power law for modelling the growth and form of teeth, claws, horns, thorns, beaks, and shells" .

    <https://doi.org/10.5061/dryad.qz612jmb4> dcterms:date "2020"^^xsd:gYear ;
        dcterms:title "Data from: Variation in the ontogenetic allometry of horn length in bovids along a body mass continuum" .
}

sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-031> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-morphometric-validation> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XIII — bovid horns as logarithmic spirals wound on a cone (Pass 2) — Morphometric validation: 66/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Per source: alpha_proj with bootstrap 95 % CI, R, Pearson r, RMSE (abs and relative), KS p-value, dAIC vs two nulls, implied beta, k_breadth vs k_outer; plus positive/negative controls, a shuffled ablation, sector-sensitivity ranges and a species contrast — 23 measurement rows with reference values. Deductions: the bootstrap CI (+/-0.5 deg) understates the model uncertainty revealed by the sector sensitivity (up to 12 deg); the gnomonic test is pole-dependent and inconclusive on the photo; the KS test rejects normality on Fig. 320 (ring corrugations); n = 1 real specimen." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-031/result.json (generated output, not in repo): sector_sensitivity flags true for the photo and the Capra figure — datasets/thompson_1917/t1917-031/result.json: rendered output of thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py at 430ab132, application/json, 6709 B, artifact_sha256 b497cdf5262491b910f2627c5070cf6117f86f2ec7fade66cf8a1d33ff98edc4 (sha256 b497cdf5262491b910f2627c5070cf6117f86f2ec7fade66cf8a1d33ff98edc4), spec_fingerprint 860e7e35af4127f92fad446ceb9389d004fdb7dfa2fe98cf3f8ad3f9657429c2" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-ablation-fig-320-radii-shuffled-against-angles-pearson-r>,

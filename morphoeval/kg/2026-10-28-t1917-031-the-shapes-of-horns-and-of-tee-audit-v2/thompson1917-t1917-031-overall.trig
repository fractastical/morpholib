    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form — Ch. XIII, The Shapes of Horns, and of Teeth or Tusks: with a Note on Torsion" .
    <https://doi.org/10.1007/s002850050081> dct:date "1997"^^xsd:gYear ;
        dct:title "Kinematics of surface growth" .
    <https://doi.org/10.1186/s12915-021-00990-w> dct:date "2021"^^xsd:gYear ;

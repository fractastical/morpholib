sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-031> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XIII — bovid horns as logarithmic spirals wound on a cone (Pass 2) — Reproducibility package: 64/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Deterministic (seed 1917 for bootstrap/controls), --self-test (24 assertions incl. a trim test, E2 inversion, controls, real-data sanity) passes, full run 11 s, inputs SHA-verified, documented invocation with --bootstrap/--no-gif, checkpoint commit 430ab132 contains the scored script. Deductions: no per-script dependency pins; skimage deprecation path; the ephemeral nanopub signing key is loop-local (sign-only, not published)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-repro-package-2> ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L949–L992" ;
        dct:description "self_test" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/430ab132/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L949-L992> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L995–L1017" ;
        dct:description "main with --self-test / --no-gif / --bootstrap" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/430ab132/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L995-L1017> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 2; second assessor pending R1)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


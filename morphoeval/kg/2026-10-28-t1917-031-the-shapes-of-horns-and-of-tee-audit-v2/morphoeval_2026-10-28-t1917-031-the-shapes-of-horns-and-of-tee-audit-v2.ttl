<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-031-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Logarithmic-spiral whorl-ratio invariance (E1/E3, gnomonic growth)" ;
    dct:description "Thompson's theorem of gnomons (Ch. XI p. 513) applied to the horn: every increment is similar to the whole, so the lag-m radius ratio is position-independent | Variables: a: radius at the tip (theta = 0); R: whorl ratio; n, m, k: whorl indices; alpha: spiral angle; beta: cone semi-angle" ;
    dct:source "Thompson (1917) On Growth and Form, Ch. XI pp. 508-518, 558; Ch. XIII pp. 616-617" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/430ab132/morphoeval/lean/loops/Thompson1917_T1917_031.lean#L32-L52>,
        <https://github.com/fractastical/morpholib/blob/430ab132/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L85-L118> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def rho (a R n : Nat) : Nat := a * R ^ n
theorem whorl_ratio_invariant (a R n : Nat) : rho a R (n + 1) = R * rho a R n
theorem lag_ratio_independent_of_position (a R n m k : Nat) :
    rho a R (n + m) * rho a R k = rho a R (k + m) * rho a R n
"""^^pk:lean4 ;
    skos:notation "rho(theta) = a exp(k theta),  R = rho(theta + 2 pi) / rho(theta) = exp(2 pi k) = exp(2 pi sin(beta) cot(alpha));  discretised rho_n = a R^n" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s002850050081>,
        <https://doi.org/10.1186/s12915-021-00990-w>,
        <https://doi.org/10.5061/dryad.qz612jmb4> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Thompson (1917) Conical Helico-Spiral: Logarithmic Spiral on a Cone Generated by Gnomonic Basal Accretion" ;
    pk:leanDeclaration "MathOfBiology.Loop_225.rho" ;
    pk:leanTheorem "MathOfBiology.Loop_225.lag_ratio_independent_of_position" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-031-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Gnomonic breadth law (E4): horn breadth shares the edge whorl ratio" ;
    dct:description "Projection-invariant test of self-similar (gnomonic) growth used in the script: the breadth decay exponent must equal the edge-radius exponent | Variables: c: breadth-to-radius ratio of the generating curve; w_n: breadth across the whorl at whorl n" ;
    dct:source "Thompson (1917) Ch. XIII p. 618 ('tapering of the horn due to the growth in its own plane of the generating curve')" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/430ab132/morphoeval/lean/loops/Thompson1917_T1917_031.lean#L35-L60>,
        <https://github.com/fractastical/morpholib/blob/430ab132/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L120-L141> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def breadth (c a R n : Nat) : Nat := c * rho a R n
theorem breadth_shares_whorl_ratio (c a R n : Nat) :
    breadth c a R (n + 1) * rho a R n = breadth c a R n * rho a R (n + 1)
"""^^pk:lean4 ;
    skos:notation "w(theta) = c rho(theta)  =>  w_{n+1} rho_n = w_n rho_{n+1}  (k_breadth = k_edge)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s002850050081>,
        <https://doi.org/10.1186/s12915-021-00990-w>,
        <https://doi.org/10.5061/dryad.qz612jmb4> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Thompson (1917) Conical Helico-Spiral: Logarithmic Spiral on a Cone Generated by Gnomonic Basal Accretion" ;
    pk:leanDeclaration "MathOfBiology.Loop_225.breadth" ;
    pk:leanTheorem "MathOfBiology.Loop_225.breadth_shares_whorl_ratio" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-031-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Projected pitch of a spiral on a cone (E2) and its non-identifiability from one view" ;
    dct:description "Explains why Thompson's own Fig. 320 projects at alpha_proj = 84 deg while he quotes alpha ~ 75 deg: an enveloping cone with beta ~ 22 deg flattens the projected pitch; the real Argali photograph projects at 74.7 deg | Variables: s: scaled sin(beta); c: scaled cot(alpha)" ;
    dct:source "Thompson (1917) Ch. XI p. 558 (R = e^{2 pi sin beta cot alpha}); Ch. XIII pp. 617-618 (O. poli vs O. ammon differ in the cone)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/430ab132/morphoeval/lean/loops/Thompson1917_T1917_031.lean#L81-L101>,
        <https://github.com/fractastical/morpholib/blob/430ab132/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L90-L111> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def projected_pitch (s c : Int) : Int := s * c
theorem acute_cone_shrinks_projected_pitch (s₁ s₂ c : Int) (hc : 0 < c) (h : s₁ < s₂) :
    projected_pitch s₁ c < projected_pitch s₂ c
theorem alpha_beta_not_identifiable_from_projection :
    ∃ s₁ c₁ s₂ c₂ : Int, projected_pitch s₁ c₁ = projected_pitch s₂ c₂ ∧ (s₁ ≠ s₂ ∨ c₁ ≠ c₂)
"""^^pk:lean4 ;
    skos:notation "k_proj = sin(beta) cot(alpha);  d k_proj / d beta > 0 for fixed alpha;  (alpha, beta) not recoverable from k_proj alone" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s002850050081>,
        <https://doi.org/10.1186/s12915-021-00990-w>,
        <https://doi.org/10.5061/dryad.qz612jmb4> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Thompson (1917) Conical Helico-Spiral: Logarithmic Spiral on a Cone Generated by Gnomonic Basal Accretion" ;
    pk:leanDeclaration "MathOfBiology.Loop_225.projected_pitch" ;
    pk:leanTheorem "MathOfBiology.Loop_225.alpha_beta_not_identifiable_from_projection" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-031-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Unequal basal growth velocities generate curvature (E5)" ;
    dct:description "Thompson's summary argument (p. 619-620): a constant velocity ratio gives a logarithmic spiral, equal velocities a straight horn, and the sign of the inequality the homonymous/heteronymous handedness | Variables: v_out, v_in: net longitudinal growth velocities on opposite sides of the basal annulus; n: number of accretion steps" ;
    dct:source "Thompson (1917) Ch. XIII pp. 616, 619-620" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/430ab132/morphoeval/lean/loops/Thompson1917_T1917_031.lean#L105-L123>,
        <https://github.com/fractastical/morpholib/blob/430ab132/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L852-L887> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def edge_length (v n : Nat) : Nat := n * v
theorem edge_ratio_constant (v_out v_in n : Nat) :
    edge_length v_out n * v_in = edge_length v_in n * v_out
theorem outer_faster_curves (v_out v_in n : Nat) (hn : 0 < n) (h : v_in < v_out) :
    edge_length v_in n < edge_length v_out n
"""^^pk:lean4 ;
    skos:notation "L_out(n) = n v_out, L_in(n) = n v_in;  L_out v_in = L_in v_out (constant ratio);  v_in < v_out => L_in(n) < L_out(n)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s002850050081>,
        <https://doi.org/10.1186/s12915-021-00990-w>,
        <https://doi.org/10.5061/dryad.qz612jmb4> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Thompson (1917) Conical Helico-Spiral: Logarithmic Spiral on a Cone Generated by Gnomonic Basal Accretion" ;
    pk:leanDeclaration "MathOfBiology.Loop_225.edge_length" ;
    pk:leanTheorem "MathOfBiology.Loop_225.outer_faster_curves" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-031-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Ovis ammon trihedral edge ratio 80:74:45 ~ 9:8:5 (E6) and data-pinned Pass 2 outcomes" ;
    dct:description "Pins Thompson's own measurement (cardboard-triangle experiment, p. 618) and the script's Pass 2 outcomes (model comparison, Argali alpha match, Fig. 320 self-similarity failure) as decidable integer facts | Variables: edge lengths in cm (outer, inner, posterior); AIC differences from the script's model comparison" ;
    dct:source "Thompson (1917) Ch. XIII p. 618; this loop's t1917_031_metrics.json" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/430ab132/morphoeval/lean/loops/Thompson1917_T1917_031.lean#L128-L153>,
        <https://github.com/fractastical/morpholib/blob/430ab132/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L428-L437> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """theorem trihedral_ratio_within_five_percent :
    100 * (74 * 9 - 80 * 8) ≤ 5 * (80 * 8) ∧ 100 * (45 * 9 - 80 * 5) ≤ 5 * (80 * 5)
theorem log_spiral_beats_nulls : (10 : Int) ≤ 425 ∧ (10 : Int) ≤ 21 ∧ (10 : Int) ≤ 666
theorem argali_alpha_matches_thompson : 7364 ≤ 7500 ∧ 7500 ≤ 7558 ∧ 7500 - 7472 ≤ 500
theorem fig320_not_self_similar : 25 * 1310 < 100 * (3206 - 1310)
"""^^pk:lean4 ;
    skos:notation "|80*8 - 74*9| / (80*8) <= 5%,  |45*9 - 80*5| / (80*5) <= 5%;  delta-AIC(circle - log) = 425 (Fig. 320), 666 (Argali);  Argali alpha_proj = 74.7 in [73.6, 75.6] vs 75;  Fig. 320 |k_w| = 0.321 vs |k_out| = 0.131 (not self-similar)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s002850050081>,
        <https://doi.org/10.1186/s12915-021-00990-w>,
        <https://doi.org/10.5061/dryad.qz612jmb4> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Thompson (1917) Conical Helico-Spiral: Logarithmic Spiral on a Cone Generated by Gnomonic Basal Accretion" ;
    pk:leanDeclaration "MathOfBiology.Loop_225.trihedral_ratio_within_five_percent" ;
    pk:leanTheorem "MathOfBiology.Loop_225.log_spiral_beats_nulls" ;
    pk:leanVerified true .


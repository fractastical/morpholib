sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-031> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XIII — bovid horns as logarithmic spirals wound on a cone (Pass 2) — Code-to-model traceability: 74/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Docstring maps E1-E5 and tests T1-T4 to pages; every fit/segmentation step is a named function with its equation id; reference.json carries the loci; the math-KG YAML links five laws to Lean declarations and script line ranges. Deductions: the ray-based inner-edge rule and the trimming rule are the script's own constructions, not Thompson's whorl-breadth procedure (Ch. XI p. 558), and this is only stated in comments." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-code-traceability-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L1–L64" ;
        dct:description "docstring: equations, test design T1-T4, identifiability, controls, claim boundary" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/430ab132/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L1-L64> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/thompson1917-t1917-031.yaml (generated output)" ;
        dct:description "5 laws, lean_locus + code_locus updated to v2 line ranges — morphoeval/math_kg_loops/thompson1917-t1917-031.yaml: rendered output of thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py at 430ab132, application/yaml, 8428 B, artifact_sha256 095adf2f45493d446f6e3847343651bb2d6460f8d7cfaf146a42affe12667cd6 (sha256 095adf2f45493d446f6e3847343651bb2d6460f8d7cfaf146a42affe12667cd6), spec_fingerprint 860e7e35af4127f92fad446ceb9389d004fdb7dfa2fe98cf3f8ad3f9657429c2" .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 2; second assessor pending R1)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-031> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XIII — bovid horns as logarithmic spirals wound on a cone (Pass 2) — Model fidelity to source: 72/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "E1-E4 implemented as Thompson states them; E2 is now used in the right direction (implied beta from k_proj rather than treating alpha_proj as alpha), and the Lean module proves the non-identifiability that this rests on plus the Pass-2 data pins (alpha match, dAIC, E4 failure) with 0 sorry. The gnomonic test implements E4 literally (breadth along rays). Still 2D: no 3D centreline, so beta is inferred, never measured; E5 remains a rendering." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-031/result.json (generated output, not in repo): beta_implied_deg reported, not measured; cone component untested — datasets/thompson_1917/t1917-031/result.json: rendered output of thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py at 430ab132, application/json, 6709 B, artifact_sha256 b497cdf5262491b910f2627c5070cf6117f86f2ec7fade66cf8a1d33ff98edc4 (sha256 b497cdf5262491b910f2627c5070cf6117f86f2ec7fade66cf8a1d33ff98edc4), spec_fingerprint 860e7e35af4127f92fad446ceb9389d004fdb7dfa2fe98cf3f8ad3f9657429c2" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-model-fidelity-3> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L85–L141" ;
        dct:description "log_spiral, k_from_alpha, beta_from_k_alpha (E2 inverted), whorl_ratio, helico_spiral, horn_surface" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/430ab132/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L85-L141> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_031.lean L32–L153" ;
        dct:description "16 theorems: whorl-ratio invariance, breadth law, alpha-beta non-identifiability, growth velocities, trihedral ratio, Pass-2 data pins; lean exit 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/430ab132/morphoeval/lean/loops/Thompson1917_T1917_031.lean#L32-L153> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L478–L549" ;
        dct:description "analyse_specimen: breadth test E4 along rays from the fitted pole with validity gating" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/430ab132/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L478-L549> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 2; second assessor pending R1)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1007/s002850050081>,
            <https://doi.org/10.1186/s12915-021-00990-w>,
            <https://doi.org/10.5061/dryad.qz612jmb4> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form — Ch. XIII, The Shapes of Horns, and of Teeth or Tusks: with a Note on Torsion" .
    <https://doi.org/10.1007/s002850050081> dct:date "1997"^^xsd:gYear ;
        dct:title "Kinematics of surface growth" .
    <https://doi.org/10.1186/s12915-021-00990-w> dct:date "2021"^^xsd:gYear ;
        dct:title "A universal power law for modelling the growth and form of teeth, claws, horns, thorns, beaks, and shells" .
    <https://doi.org/10.5061/dryad.qz612jmb4> dct:date "2020"^^xsd:gYear ;
        dct:title "Data from: Variation in the ontogenetic allometry of horn length in bovids along a body mass continuum" .
}


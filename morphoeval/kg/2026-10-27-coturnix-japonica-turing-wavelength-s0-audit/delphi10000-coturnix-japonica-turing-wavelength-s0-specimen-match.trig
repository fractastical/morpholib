sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 22.42 µm on Holocene Coturnix japonica plumage — Morphological realism / specimen match: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The comparison figure places the Yehliu quail, its plumage crop, the simulated activator, the dispersion curve, the Du sweep, and the equal-diffusion control on one page. The growth GIF is 12 frames at 960×540. Last-frame CV similarity to the photograph is 96.0 because the concrete and straw stay put and only plumage high frequencies are replaced. Deduction: the portrait is not a follicle micrograph and has no scale bar, so the resemblance is texture-class plus silhouette, not a micron overlay." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py L8–L14: portrait has no micron scale bar; it is an envelope, not a measured 22.42 µm field <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py#L8-L14>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/coturnix_japonica_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "specimen, plumage crop, display field, dispersion, sweep, ablation — docs/media/coturnix_japonica_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/png, 624782 B, 1632×984 px, artifact_sha256 1c2ebe1960b77d716273802266e563ebb8e7ac52ed4b8869d4a84a97de8367f7 (sha256 1c2ebe1960b77d716273802266e563ebb8e7ac52ed4b8869d4a84a97de8367f7), spec_fingerprint fcce03b3209888bbee04f33bf08d93db2245049fdd963bb6413cf49a32f9a400" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/coturnix_japonica_turing_wavelength_s0_growth.gif (generated output)" ;
        dct:description "12-frame 960x540 plumage growth animation — docs/media/coturnix_japonica_turing_wavelength_s0_growth.gif: rendered output of models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/gif, 5901762 B, 960×540 px, 12 frames, artifact_sha256 40ecef1d33d22c2503491bb64335d87b967a89ab27074a92cdf3bd281e9397ad (sha256 40ecef1d33d22c2503491bb64335d87b967a89ab27074a92cdf3bd281e9397ad), spec_fingerprint fcce03b3209888bbee04f33bf08d93db2245049fdd963bb6413cf49a32f9a400" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent round; second assessor not available)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


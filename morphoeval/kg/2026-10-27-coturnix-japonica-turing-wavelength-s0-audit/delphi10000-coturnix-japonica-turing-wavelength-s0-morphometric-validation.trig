sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 22.42 µm on Holocene Coturnix japonica plumage — Morphometric validation: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Reported measurements, each with a reference that is not a copy of the value: simulated stripe wavelength 33.65 µm vs linear 22.42 µm; plumage melanin fraction 0.340 vs activator-midpoint fraction; plumage coherency vs field coherency; Pearson r = 0.99966 vs 1; RMSE 6.52 µm vs 0; KS D = 0.098 vs 0; ablation std 0.0003 vs patterned std 1.04. Deduction: one photograph, and the growth-moment RMSE is still several micrometres." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-du-sweep-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-plumage-versus-composite-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-simulated-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-specimen-plumage-stripe-melanin-area-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-du-sweep-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Du sweep RMSE = 6.5239 µm" ;
        dct:description "A nonzero RMSE is the nonlinear and discretization residual." ;
        schema:measurementTechnique "RMSE between measured and analytical wavelengths on the Du sweep" ;
        schema:name "Du sweep RMSE" ;
        schema:unitText "µm" ;
        schema:value "6.5239" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-du-sweep-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-du-sweep-rmse-reference> a schema:PropertyValue ;
        dct:source "Zero error against the linear dispersion" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation activator std = 0.0003 concentration" ;
        dct:description "Control must stay near the homogeneous state while the Turing run grows a pattern." ;
        schema:measurementTechnique "std(u) after the same horizon with Du = Dv = 0.035 (negative control)" ;
        schema:name "equal-diffusion ablation activator std" ;
        schema:unitText "concentration" ;
        schema:value "0.0003" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-std-reference> a schema:PropertyValue ;
        dct:source "std(u) of the nominal isotropic Turing run" ;
        schema:value "1.0426" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-plumage-versus-composite-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "plumage versus composite KS statistic = 0.0979 KS D" ;
        dct:description "p = 8.924e-198. cv of Du-sweep residuals = 0.0391." ;
        schema:measurementTechnique "Two-sample KS test on plumage luminance vs the last composited frame inside the mask" ;
        schema:name "plumage versus composite KS statistic" ;
        schema:unitText "KS D" ;
        schema:value "0.0979" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-plumage-versus-composite-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-plumage-versus-composite-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "Identical distributions would give D = 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-simulated-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated stripe wavelength = 33.6451 µm" ;
        dct:description "Display run is anisotropic, so the FFT peak is not forced to equal the isotropic law." ;
        schema:measurementTechnique "Power-weighted radial FFT of the anisotropic display field, converted by the slot length unit" ;
        schema:name "simulated stripe wavelength" ;
        schema:unitText "µm" ;
        schema:value "33.6451" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-simulated-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-simulated-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "Linear k_c at Du=0.035, Dv=1.85, lambda_c = 2.242e-5 m" ;
        schema:value "22.42" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image structure-tensor coherency = 0.5873 coherency" ;
        dct:description "Portrait coherency includes feather edges; the PDE field is a periodic patch." ;
        schema:measurementTechnique "Mean structure-tensor coherency on the plumage bounding crop" ;
        schema:name "specimen image structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.5873" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "Coherency of the simulated activator field" ;
        schema:value "0.7188" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-specimen-plumage-stripe-melanin-area-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen plumage stripe melanin area fraction = 0.3404 fraction" ;
        dct:description "Self-referential val==ref is rejected; these two fractions are independent measurements." ;
        schema:measurementTechnique "Otsu threshold on the plumage-mask luminance of the Yehliu photograph" ;
        schema:name "specimen plumage stripe melanin area fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.3404" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-specimen-plumage-stripe-melanin-area-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-specimen-plumage-stripe-melanin-area-fraction-reference> a schema:PropertyValue ;
        dct:source "Fraction of display-field pixels above the activator midpoint, same Otsu rule on a rescaled field" ;
        schema:value "0.0892" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength sweep Pearson r = 0.99966 r" ;
        dct:description "RMSE = 6.5239 µm. KS plumage-vs-composite statistic = 0.0979." ;
        schema:measurementTechnique "Pearson r of linear-regime growth wavelength vs analytical lambda across the Du sweep" ;
        schema:name "wavelength sweep Pearson r" ;
        schema:unitText "r" ;
        schema:value "0.99966" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Exact agreement with the linear Turing law" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py L352–L417" ;
        dct:description "plumage mask, Otsu melanin fraction, structure-tensor coherency" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py#L352-L417> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py L557–L636" ;
        dct:description "measurement dicts with value != reference" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py#L557-L636> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "datasets/coturnix_japonica_turing_wavelength_s0/coturnix_japonica_turing_wavelength_s0_metrics.json (generated output)" ;
        dct:description "r = 0.99966, RMSE = 6.52 µm, KS = 0.098, CV similarity = 96 — datasets/coturnix_japonica_turing_wavelength_s0/coturnix_japonica_turing_wavelength_s0_metrics.json: rendered output of models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, application/json, 5526 B, artifact_sha256 231310ba2a875c3c0c88cc8686165830b9afed3791945e4d53c0bde301e31645 (sha256 231310ba2a875c3c0c88cc8686165830b9afed3791945e4d53c0bde301e31645), spec_fingerprint fcce03b3209888bbee04f33bf08d93db2245049fdd963bb6413cf49a32f9a400" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;

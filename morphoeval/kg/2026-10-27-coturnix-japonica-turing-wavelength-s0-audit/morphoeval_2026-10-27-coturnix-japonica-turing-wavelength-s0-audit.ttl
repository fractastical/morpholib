<https://w3id.org/delphi/resource/math-law/delphi10000-coturnix-japonica-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Reaction-stable trace" ;
    dct:description "Homogeneous steady state of the 22.42 µm quail pigment system is stable without diffusion | Variables: f_u = 0.860, g_v = -1 at u0 = a + b = 1, v0 = 0.93" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3157_coturnix_japonica_turing_wavelength_s0.lean#L15-L18> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def trace_scaled : Int := 860 + (-1000)
theorem trace_negative : trace_scaled < 0 := by
  decide
"""^^pk:lean4 ;
    skos:notation "tr J = f_u + g_v = -0.140 < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.0500781102>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.3389/fcell.2020.00620> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3157.trace_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3157.trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-coturnix-japonica-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Positive Jacobian determinant" ;
    dct:description "Uniform perturbations decay; any instability must be wave-like | Variables: f_v = (a+b)^2 = 1, g_u = -1.86" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3157_coturnix_japonica_turing_wavelength_s0.lean#L22-L25> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def det_scaled : Int := 860 * (-1000) - 1000 * (-1860)
theorem det_positive : det_scaled > 0 := by
  decide
"""^^pk:lean4 ;
    skos:notation "det J = f_u g_v - f_v g_u = 1 > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.0500781102>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.3389/fcell.2020.00620> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3157.det_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3157.det_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-coturnix-japonica-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber k_c" ;
    dct:description "Turing wavenumber selecting the 22.42 µm Coturnix pigment stripe / ocellus scale | Variables: D_u = 0.035, D_v = 1.85; length unit set so lambda_c = 2.242e-5 m" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Prum & Williamson 2002 DOI:10.1098/rspb.2001.1896" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3157_coturnix_japonica_turing_wavelength_s0.lean#L30-L34> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def cross_scaled : Int := 1850 * 860 + 35 * (-1000)
def kc_den_scaled : Int := 2 * 35 * 1850
theorem kc_exact_ratio : cross_scaled * 259 = kc_den_scaled * 3112 := by
  decide
"""^^pk:lean4 ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v) = 3112/259" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.0500781102>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.3389/fcell.2020.00620> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3157.cross_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3157.kc_exact_ratio" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-coturnix-japonica-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Open Turing band" ;
    dct:description "A band of wavenumbers around the 22.42 µm mode is linearly unstable | Variables: discriminant of h(k^2) = det J - cross k^2 + D_u D_v k^4" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3157_coturnix_japonica_turing_wavelength_s0.lean#L40-L44> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def band_discriminant : Int :=
  cross_scaled * cross_scaled - 4 * 35 * 1850 * det_scaled
theorem turing_band_nonempty : band_discriminant > 0 := by
  decide
"""^^pk:lean4 ;
    skos:notation "(D_v f_u + D_u g_v)^2 - 4 D_u D_v det J > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.0500781102>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.3389/fcell.2020.00620> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3157.band_discriminant" ;
    pk:leanTheorem "MathOfBiology.Loop_3157.turing_band_nonempty" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-coturnix-japonica-turing-wavelength-s0-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion predecessor and Holocene age gap" ;
    dct:description "The 22.42 µm mode is absent when activator and inhibitor diffuse equally, and there is no successor chronospecies | Variables: chronoseries 1/1 at 0 Ma; predecessor is ontogenetic, not a fossil species" ;
    dct:source "Haupaix et al. 2018 DOI:10.1126/science.aar4777" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3157_coturnix_japonica_turing_wavelength_s0.lean#L49-L56> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def equal_diffusion_cross : Int := 35 * 860 + 35 * (-1000)
def holocene_age_gap_Ma : Int := 0
theorem equal_diffusion_quenches : equal_diffusion_cross < 0 := by
  decide
theorem holocene_terminal_no_successor : holocene_age_gap_Ma = 0 := by
  decide
"""^^pk:lean4 ;
    skos:notation "D_u = D_v implies cross < 0; Holocene age gap = 0 Ma" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.0500781102>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.3389/fcell.2020.00620> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3157.equal_diffusion_cross" ;
    pk:leanTheorem "MathOfBiology.Loop_3157.equal_diffusion_quenches" ;
    pk:leanVerified true .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 22.42 µm on Holocene Coturnix japonica plumage — Reproducibility package: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Seed 3157, explicit-Euler step capped by the diffusion stability bound, --self-test covering the Lean identities, the quench, a short pattern-versus-ablation run, and a three-point Pearson check above 0.98. Full run writes the PNG, GIF, and metrics JSON. Python 3.12, numpy 2.5.4, scipy 1.18.1, Pillow 13, matplotlib 3.11. Deduction: dependencies are the cloud image, not a per-script lock, and the checkpoint commit does not yet contain these files." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-repro-package-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py L792–L834" ;
        dct:description "--self-test identities, quench, dynamics, trio Pearson r > 0.98" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py#L792-L834> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py L186–L198" ;
        dct:description "dt reduced to stay under the explicit diffusion bound" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py#L186-L198> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent round; second assessor not available)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


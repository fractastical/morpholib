sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-meinhardt-echinoderm-pentaradial-symmetry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Morris (2012), Mooi & David (1998), Lovén (1874), Duboc et al. (2005) & Meinhardt (2008) echinoderm bilateral-to-pentaradial hydrocoel ring symmetry breaking — Morphometric validation: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Exposes 9 reference-anchored morphometric measurements in `measure_morphoeval()` covering PDE emergent podia count (5.0), inter-ray spacing (72.0 deg), mode staircase correlation across m in {3..7} (r = 1.0000), equal-diffusion negative control (0.0 lobes), Lovén's Law initiation sequence correlation (r = 1.0000), Duboc Nodal LOF twin-rudiment podia count (10.0), and 3 specimen CV morphometrics (5.0 rays, 72.0 deg spacing, 0.9255 C_5 harmonic power fraction), achieving quick_gate = 100/100." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-canonical-hydrocoel-ring-primary-podia-mode-m-at-r-ring-75-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-duboc-et-al-2005-nodal-morpholino-knockdown-twin-rudiment-primary-podia-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-equal-diffusion-negative-control-d-h-d-a-emergent-podia-lobe-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-hydrocoel-ring-mode-staircase-correlation-across-m-in-3-4-5-6-7>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-lov-n-s-law-ii-iv-i-iii-v-crescent-initiation-sequence-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-pentaradial-inter-ambulacral-angular-spacing-delta-theta-on-closed-hydrocoel-ring>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-tripneustes-gratilla-test-specimen-c-5-fundamental-fourier-harmonic-power-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-tripneustes-gratilla-test-specimen-detected-ambulacral-ray-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-tripneustes-gratilla-test-specimen-mean-inter-ambulacral-angular-spacing>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-morphometric-validation-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-canonical-hydrocoel-ring-primary-podia-mode-m-at-r-ring-75-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Canonical hydrocoel ring primary podia mode m^* at R_ring=75 um = 5.0 lobes" ;
        dct:description "Mean angular spacing = 72.00 deg" ;
        schema:measurementTechnique "Peak count of Gierer-Meinhardt circular-ring PDE at 2*pi*R_ring/lambda_c = 5.0" ;
        schema:name "Canonical hydrocoel ring primary podia mode m^* at R_ring=75 um" ;
        schema:unitText "lobes" ;
        schema:value "5.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-canonical-hydrocoel-ring-primary-podia-mode-m-at-r-ring-75-um-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-canonical-hydrocoel-ring-primary-podia-mode-m-at-r-ring-75-um-reference> a schema:PropertyValue ;
        dct:source "Morris (2012) Evol. Dev. 14:313-326 & Lean 4 theorem hydrocoel_ring_pentaradial_mode5_selection" ;
        schema:value "5.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-duboc-et-al-2005-nodal-morpholino-knockdown-twin-rudiment-primary-podia-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Duboc et al. (2005) Nodal morpholino knockdown twin-rudiment primary podia count = 10.0 podia" ;
        dct:description "WT = 5 podia (1x5), Nodal LOF = 10 podia (2x5), Nodal GOF = 0 podia" ;
        schema:measurementTechnique "Total primary podia lobes formed when right-sided Nodal repression is ablated (nodal_left=0, nodal_right=0 -> 2x5)" ;
        schema:name "Duboc et al. (2005) Nodal morpholino knockdown twin-rudiment primary podia count" ;
        schema:unitText "podia" ;
        schema:value "10.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-duboc-et-al-2005-nodal-morpholino-knockdown-twin-rudiment-primary-podia-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-duboc-et-al-2005-nodal-morpholino-knockdown-twin-rudiment-primary-podia-count-reference> a schema:PropertyValue ;
        dct:source "Duboc et al. (2005) Dev. Cell 9(1):147-158 Fig. 4 & Lean 4 theorem duboc_nodal_left_right_rudiment_multiplicity" ;
        schema:value "10.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-equal-diffusion-negative-control-d-h-d-a-emergent-podia-lobe-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Equal-diffusion negative control (D_h = D_a) emergent podia lobe count = 0.0 lobes" ;
        dct:description "Confirms zero spatial symmetry breaking without long-range inhibition" ;
        schema:measurementTechnique "Gierer-Meinhardt circular-ring PDE integrated with equal diffusivity D_h = D_a = 0.45 um^2/s" ;
        schema:name "Equal-diffusion negative control (D_h = D_a) emergent podia lobe count" ;
        schema:unitText "lobes" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-equal-diffusion-negative-control-d-h-d-a-emergent-podia-lobe-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-equal-diffusion-negative-control-d-h-d-a-emergent-podia-lobe-count-reference> a schema:PropertyValue ;
        dct:source "Meinhardt (2008) Curr. Top. Dev. Biol. 81:1-63 (Turing lateral-inhibition necessity)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-hydrocoel-ring-mode-staircase-correlation-across-m-in-3-4-5-6-7> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hydrocoel ring mode staircase correlation across m in {3, 4, 5, 6, 7} = 1.0 Pearson r" ;
        dct:description "Window accuracy in (4.5, 5.5) = 1.0000" ;
        schema:measurementTechnique "Correlation of PDE emergent lobe count vs theoretical mode m^* = round(2*pi*R_ring/lambda_c) across R in {45,60,75,90,105} um" ;
        schema:name "Hydrocoel ring mode staircase correlation across m in {3, 4, 5, 6, 7}" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-hydrocoel-ring-mode-staircase-correlation-across-m-in-3-4-5-6-7-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-hydrocoel-ring-mode-staircase-correlation-across-m-in-3-4-5-6-7-reference> a schema:PropertyValue ;
        dct:source "Meinhardt (2008) Curr. Top. Dev. Biol. 81:1-63 & Lean 4 theorem hydrocoel_ring_pentaradial_mode5_selection" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-lov-n-s-law-ii-iv-i-iii-v-crescent-initiation-sequence-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Lovén's Law (II, IV, I, III, V) crescent initiation sequence correlation = 1.0 Pearson r" ;
        dct:description "Ordered rays = ['II', 'IV', 'I', 'III', 'V'], b-enlarged count = 2/5" ;
        schema:measurementTechnique "Correlation of PDE crescent-closure ray initiation order vs Morris (2012) / Lovén (1874) sequence (2, 4, 1, 3, 5)" ;
        schema:name "Lovén's Law (II, IV, I, III, V) crescent initiation sequence correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-lov-n-s-law-ii-iv-i-iii-v-crescent-initiation-sequence-correlation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-lov-n-s-law-ii-iv-i-iii-v-crescent-initiation-sequence-correlation-reference> a schema:PropertyValue ;
        dct:source "Lovén (1874) K. Sven. Vetensk.-Akad. Handl. 11(7):1-91 & Morris (2012) Evol. Dev. 14:313-326" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-pentaradial-inter-ambulacral-angular-spacing-delta-theta-on-closed-hydrocoel-ring> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pentaradial inter-ambulacral angular spacing Delta_theta on closed hydrocoel ring = 72.0 deg" ;
        dct:description "Detected lobe angles = [0, 72, 144, 216, 288]" ;
        schema:measurementTechnique "Mean angular spacing between adjacent activator maxima on closed hydrocoel ring" ;
        schema:name "Pentaradial inter-ambulacral angular spacing Delta_theta on closed hydrocoel ring" ;
        schema:unitText "deg" ;
        schema:value "72.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-pentaradial-inter-ambulacral-angular-spacing-delta-theta-on-closed-hydrocoel-ring-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-pentaradial-inter-ambulacral-angular-spacing-delta-theta-on-closed-hydrocoel-ring-reference> a schema:PropertyValue ;
        dct:source "Morris (2012) Evol. Dev. 14:313-326 & Meinhardt (2008) Curr. Top. Dev. Biol. 81:1-63" ;
        schema:value "72.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-tripneustes-gratilla-test-specimen-c-5-fundamental-fourier-harmonic-power-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Tripneustes gratilla test specimen C_5 fundamental Fourier harmonic power fraction = 0.9255 power fraction" ;
        dct:description "C_5+C_10 biserial power fraction = 0.9425, A_5/max_non5 = 6.30x" ;
        schema:measurementTechnique "Fraction of azimuthal Fourier power in m=5 fundamental harmonic across m in {3..9} on echinoderm_pentaradial_test_specimen.jpg" ;
        schema:name "Tripneustes gratilla test specimen C_5 fundamental Fourier harmonic power fraction" ;
        schema:unitText "power fraction" ;
        schema:value "0.9255" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-tripneustes-gratilla-test-specimen-c-5-fundamental-fourier-harmonic-power-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-tripneustes-gratilla-test-specimen-c-5-fundamental-fourier-harmonic-power-fraction-reference> a schema:PropertyValue ;
        dct:source "Polar Fourier harmonic decomposition of vendored Tripneustes gratilla test specimen" ;
        schema:value "0.9255" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-tripneustes-gratilla-test-specimen-detected-ambulacral-ray-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Tripneustes gratilla test specimen detected ambulacral ray count = 5.0 rays" ;
        dct:description "Detected ray angles = [45, 118, 190, 260, 331] deg" ;
        schema:measurementTechnique "Automated polar chromaticity peak detection around central periproct on echinoderm_pentaradial_test_specimen.jpg" ;
        schema:name "Tripneustes gratilla test specimen detected ambulacral ray count" ;
        schema:unitText "rays" ;
        schema:value "5.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-tripneustes-gratilla-test-specimen-detected-ambulacral-ray-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-tripneustes-gratilla-test-specimen-detected-ambulacral-ray-count-reference> a schema:PropertyValue ;
        dct:source "Vendored Tripneustes gratilla regular echinoid test specimen (CC BY-SA 4.0)" ;

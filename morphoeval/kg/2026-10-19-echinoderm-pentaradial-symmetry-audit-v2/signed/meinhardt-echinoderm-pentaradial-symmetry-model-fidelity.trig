        rdfs:label "2005-meinhardt-echinoderm-pentaradial-symmetry.py L143–L303" ;
        dcterms:description "Circular-ring Laplacian dispersion, Gierer-Meinhardt crescent-to-ring PDE solver, and D_h=D_a negative control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L143-L303> .


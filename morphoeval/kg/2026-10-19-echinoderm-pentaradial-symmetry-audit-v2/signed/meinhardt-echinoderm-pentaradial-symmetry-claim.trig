sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-meinhardt-echinoderm-pentaradial-symmetry> a pk:Claim ;
        rdfs:label "Morris (2012), Mooi & David (1998), Lovén (1874), Duboc et al. (2005) & Meinhardt (2008) echinoderm bilateral-to-pentaradial hydrocoel ring symmetry breaking faithfully reproduces Strongylocentrotus purpuratus & Tripneustes gratilla (Echinoidea crown-group echinoderms) morphology" ;
        dcterms:description "The simulation script(s) 2005-meinhardt-echinoderm-pentaradial-symmetry.py implement the cited source model as published and produce forms that match real Strongylocentrotus purpuratus & Tripneustes gratilla (Echinoidea crown-group echinoderms) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 91.8/100, audit 2026-10-19-echinoderm-pentaradial-symmetry-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/HEAD/2005-meinhardt-echinoderm-pentaradial-symmetry.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/HEAD/2005-meinhardt-echinoderm-pentaradial-symmetry.py; output: docs/media/echinoderm_pentaradial_symmetry_comparison.png; organism: Strongylocentrotus purpuratus & Tripneustes gratilla (Echinoidea crown-group echinoderms); checkpoint commit: https://github.com/fractastical/morpholib/commit/HEAD; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: f94f62955d7ff6974c8a237ced577144db975e6e7e74430aca24de11b763608f; artifact_sha256: 780eef9ad0d660de11d227bf31ce5298ae2776afea19e2c155697087227be09e; input_dataset_sha256: {datasets/echinoderm_pentaradial_symmetry/echinoderm_pentaradial_symmetry_reference.json=c516e298727883cf..., datasets/echinoderm_pentaradial_symmetry/echinoderm_pentaradial_test_specimen.jpg=953b2f7e38029627..., datasets/echinoderm_pentaradial_symmetry/scout_manifest.json=0b333ebe2a2ed524...}; supersedes_audit_id: 2026-10-19-echinoderm-pentaradial-symmetry-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1016/S0070-2153(07)81001-5>,
            <https://doi.org/10.1016/j.devcel.2005.05.008>,
            <https://doi.org/10.1093/icb/38.6.965>,
            <https://doi.org/10.1111/j.1525-142X.2012.00552.x>,
            <https://doi.org/10.5962/bhl.title.46385> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match> ;
        pk:weightOfEvidence "0.918"^^xsd:double .


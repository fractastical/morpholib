        rdfs:label "2005-meinhardt-echinoderm-pentaradial-symmetry.py L306–L344" ;
        dcterms:description "49-point mode selection staircase and 5-regime PDE integration across m in {3..7}" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L306-L344> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2005-meinhardt-echinoderm-pentaradial-symmetry.py L638–L663" ;
        dcterms:description "CLI parameter overrides wired into render_comparison_figure()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L638-L663> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Morris (2012), Mooi & David (1998), Lovén (1874), Duboc et al. (2005) & Meinhardt (2008) echinoderm bilateral-to-pentaradial hydrocoel ring symmetry breaking — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates a 49-point hydrocoel ring circumference sweep across 2*pi*R_ring/lambda_c in [2.6, 7.4] plus 5 full PDE integrations spanning trimerous (m=3, 120 deg), tetramerous (m=4, 90 deg), wild-type pentaradial (m=5, 72 deg), hexamerous (m=6, 60 deg), and heptamerous (m=7, 51.4 deg) regimes, 3 Nodal L-R signaling conditions (WT, LOF, GOF), an equal-diffusion negative control, and `--R-ring-um`, `--lambda-c-um`, `--seed`, and `--skip-gif` CLI flags." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-meinhardt-echinoderm-pentaradial-symmetry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Morris (2012), Mooi & David (1998), Lovén (1874), Duboc et al. (2005) & Meinhardt (2008) echinoderm bilateral-to-pentaradial hydrocoel ring symmetry breaking — Model fidelity to source: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Faithfully integrates the circular-ring Gierer-Meinhardt activator-inhibitor PDE during hydrocoel crescent-to-ring closure, reproducing mode m^* = 5 (Delta_theta = 72.0 deg) selection, an equal-diffusion negative control (D_h = D_a -> 0 lobes), Lovén's Law (II, IV, I, III, V) sequential initiation and asymmetric biserial peristomial plate dominance (Ib, IIb, IIIa, IVa, Va), and Duboc et al. (2005) right-sided Nodal repression vs twin 2x5 rudiment formation. Backed by 3 machine-checked Lean 4 theorems in `Loop_075_echinoderm_pentaradial_symmetry.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2005-meinhardt-echinoderm-pentaradial-symmetry.py L143–L303" ;
        dct:description "Circular-ring Laplacian dispersion, Gierer-Meinhardt crescent-to-ring PDE solver, and D_h=D_a negative control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L143-L303> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2005-meinhardt-echinoderm-pentaradial-symmetry.py L348–L428" ;
        dct:description "Lovén's Law (II, IV, I, III, V) initiation sequence and Duboc et al. (2005) Nodal L-R twin-rudiment 2D spatial simulator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L348-L428> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_075_echinoderm_pentaradial_symmetry.lean L24–L192" ;
        dct:description "3 Lean 4 theorems proving ring m=5 selection, Lovén's Law ordering/involution, and Duboc Nodal 2x5 rudiment multiplicity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_075_echinoderm_pentaradial_symmetry.lean#L24-L192> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-meinhardt-echinoderm-pentaradial-symmetry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Morris (2012), Mooi & David (1998), Lovén (1874), Duboc et al. (2005) & Meinhardt (2008) echinoderm bilateral-to-pentaradial hydrocoel ring symmetry breaking — Morphological realism / specimen match: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors, SHA-256-verifies, and performs automated central periproct detection and polar Fourier harmonic segmentation (`segment_echinoid_test_specimen`, L434-490) on the *Tripneustes gratilla* regular echinoid test micrograph (`datasets/echinoderm_pentaradial_symmetry/echinoderm_pentaradial_test_specimen.jpg`), detecting all n = 5 ambulacral rays at [45, 118, 190, 260, 331] deg with inter-ray spacings [73, 72, 70, 71, 74] deg (mean 72.00 deg, SD = 1.4142 deg, CV = 0.0196), C_5 fundamental power fraction = 0.9255, C_5 + C_10 biserial harmonic fraction = 0.9425, and A_5 / max_non5 = 6.3041." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2005-meinhardt-echinoderm-pentaradial-symmetry.py L434–L490" ;
        dct:description "Automated periproct detection, polar chromaticity sampling, and C_5/C_10 Fourier segmentation of Tripneustes gratilla test" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L434-L490> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/echinoderm_pentaradial_symmetry_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure with Panel E specimen ray segmentation overlay and Panel F azimuthal Fourier spectrum — docs/media/echinoderm_pentaradial_symmetry_comparison.png: rendered output of 2005-meinhardt-echinoderm-pentaradial-symmetry.py at HEAD, image/png, 1069987 B, 2408×1542 px, artifact_sha256 780eef9ad0d660de11d227bf31ce5298ae2776afea19e2c155697087227be09e (sha256 780eef9ad0d660de11d227bf31ce5298ae2776afea19e2c155697087227be09e), spec_fingerprint f94f62955d7ff6974c8a237ced577144db975e6e7e74430aca24de11b763608f" .

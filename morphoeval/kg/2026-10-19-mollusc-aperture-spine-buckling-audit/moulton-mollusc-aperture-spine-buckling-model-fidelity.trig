            <https://doi.org/10.1073/pnas.1220443110>,
            <https://doi.org/10.1371/journal.pcbi.1007213> .
    <https://doi.org/10.1016/j.jtbi.2012.07.009> dct:date "2012"^^xsd:gYear ;
        dct:title "Mechanical growth and morphogenesis of seashells" .
    <https://doi.org/10.1016/j.jtbi.2014.09.021> dct:date "2015"^^xsd:gYear ;
        dct:title "The role of mechanics in the growth and form of mollusc shells: hierarchical spine folding and secondary fractal serrations" .
    <https://doi.org/10.1073/pnas.1220443110> dct:date "2013"^^xsd:gYear ;
        dct:title "Mechanical basis of morphogenesis and convergent evolution of spiny seashells" .
    <https://doi.org/10.1371/journal.pcbi.1007213> dct:date "2019"^^xsd:gYear ;
        dct:title "A computational framework for the morpho-elastic development of molluskan shells by surface and volume growth" .
}


    <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Moulton, Goriely & Chirat (2015) & Chirat et al. (2013) hierarchical mollusc aperture spine folding and fractal frond serration — Morphometric validation: 50/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Uses integer FFT bin `k_bin` (L54-57) and reports only 2 basic metrics without 10-species muricid cross-taxa scaling collapse, secondary/tertiary frond wavenumber ratio validation (k_2/k_1 ≈ 3.8), tubular closure neck gap curve, or specimen comb periodicity CV." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2015-moulton-mollusc-aperture-spine-buckling.py L121–L143: Only 2 baseline metrics without cross-taxa scaling collapse or specimen comb CV <https://github.com/fractastical/morpholib/blob/HEAD/2015-moulton-mollusc-aperture-spine-buckling.py#L121-L143>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-primary-siphonal-canal-comb-spine-count-v1-baseline>,

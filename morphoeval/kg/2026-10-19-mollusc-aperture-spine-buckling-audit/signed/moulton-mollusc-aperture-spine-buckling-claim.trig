sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-moulton-mollusc-aperture-spine-buckling> a pk:Claim ;
        rdfs:label "Moulton, Goriely & Chirat (2015) & Chirat et al. (2013) hierarchical mollusc aperture spine folding and fractal frond serration faithfully reproduces Murex pecten (Venus comb murex) & Chicoreus ramosus (ramose murex / Muricidae) morphology" ;
        dcterms:description "The simulation script(s) 2015-moulton-mollusc-aperture-spine-buckling.py implement the cited source model as published and produce forms that match real Murex pecten (Venus comb murex) & Chicoreus ramosus (ramose murex / Muricidae) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 48.7/100, audit 2026-10-19-mollusc-aperture-spine-buckling-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/HEAD/2015-moulton-mollusc-aperture-spine-buckling.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/HEAD/2015-moulton-mollusc-aperture-spine-buckling.py; output: docs/media/mollusc_aperture_spine_buckling_comparison.png; organism: Murex pecten (Venus comb murex) & Chicoreus ramosus (ramose murex / Muricidae); checkpoint commit: https://github.com/fractastical/morpholib/commit/HEAD; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 2b94e7a03cd347db53de50ca64fa7292e03536c1d004ec54908d722b5d7edd8a; artifact_sha256: c5fc2150eeb3abe51de8b5c2f36957750d21dc8e15071cfc9760415d2d23dccb; input_dataset_sha256: {datasets/mollusc_aperture_spine_buckling/mollusc_aperture_spine_buckling_reference.json=c73e5d2ac5c13cd5..., datasets/mollusc_aperture_spine_buckling/murex_pecten_aperture_specimen.jpg=2f87d4ec30ebec6a..., datasets/mollusc_aperture_spine_buckling/paper_citations.bib=fc39398ba54f69e1..., datasets/mollusc_aperture_spine_buckling/scout_manifest.json=53cb565add07b28d...}" ;

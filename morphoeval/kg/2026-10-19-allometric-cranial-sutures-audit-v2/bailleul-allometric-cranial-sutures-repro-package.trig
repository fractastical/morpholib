sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bailleul-allometric-cranial-sutures> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Miura et al. (2009) & Jaslow (1990) cranial suture fractal interdigitation and Kuramoto-Sivashinsky osteogenic instability — Reproducibility package: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Cross-process deterministic execution (`seed=2020` with SHA-256 regime offsets), standalone 8-check `--self-test` suite verifying SHA-256 dataset locks, KS completing-the-square identity, 5 developmental/pathological regimes, Jaslow bending energy hierarchy, specimen CV sagittal suture segmentation, and bitwise two-run determinism (`atol=0.0`), plus rendered 9-panel PNG and 24-frame GIF." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-repro-package-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L951–L1011" ;
        dct:description "8-check deterministic --self-test suite verifying SHA-256 locks, KS dispersion, 5 regimes, CV trace, and bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2020-bailleul-allometric-cranial-sutures.py#L951-L1011> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/allometric_cranial_sutures_growth.gif (generated output)" ;
        dct:description "24-frame animated GIF comparing Lambdoid, Sagittal, Infant, and FGFR2 Synostosis osteogenic front evolution — docs/media/allometric_cranial_sutures_growth.gif: rendered output of 2020-bailleul-allometric-cranial-sutures.py at 317bc3c, image/gif, 573223 B, 864×368 px, 24 frames, artifact_sha256 27e6d90f28198a517241d4a2c7ee82771b340a1a295531b9aa4f7a45d9bb8fc7 (sha256 27e6d90f28198a517241d4a2c7ee82771b340a1a295531b9aa4f7a45d9bb8fc7), spec_fingerprint 53dc68ef4189bb186f820ba54b5a160dfe42da44326e82b66ab860cc7d2ad00e" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


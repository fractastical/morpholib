<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/bailleul-allometric-cranial-sutures-1>,
        <https://w3id.org/probknow/resource/math-law/bailleul-allometric-cranial-sutures-2>,
        <https://w3id.org/probknow/resource/math-law/bailleul-allometric-cranial-sutures-3> .

<https://w3id.org/probknow/resource/math-law/bailleul-allometric-cranial-sutures-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Miura et al. (2009) Kuramoto-Sivashinsky Osteogenic Front Dispersion & Peak Wavenumber Selection Law" ;
    dct:description "Proves that the fourth-order Kuramoto-Sivashinsky osteogenic dispersion relation selects a unique most-unstable interdigitation wavenumber q_max = alpha/(2*beta) with strictly positive peak growth rate omega_max = alpha^2/(4*beta) > 0 | Variables: q = k^2 >= 0: squared spatial wavenumber along the suture midline; alpha > 0: BMP4/FGF2 + tensile strain osteogenic front instability coefficient; beta > 0: fourth-order surface-tension / curvature smoothing coefficient" ;
    dct:source "Miura et al. (2009) PNAS 106(27):11218-11223 Figs. 2-4; Zollikofer & Weissmann (2011) J. Anat. 219:100-114" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2020-bailleul-allometric-cranial-sutures.py#L85-L185>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_020_allometric_cranial_sutures.lean#L20-L56> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def sq_int (z : Int) : Int :=
  z * z
def ks_dispersion (alpha beta q : Int) : Int :=
  alpha * q - beta * q * q
def ks_scaled_lhs (alpha beta q : Int) : Int :=
  4 * beta * ks_dispersion alpha beta q + sq_int (2 * beta * q - alpha)
theorem ks_dispersion_peak_selection (alpha : Int) :
    ks_dispersion alpha 0 0 = 0 ∧
    ks_scaled_lhs 12 6 1 = sq_int 12 ∧
    ks_dispersion 12 6 1 = 6 ∧
    ks_dispersion 12 6 0 = 0 ∧
    ks_dispersion 12 6 2 = 0 ∧
    ks_dispersion 12 6 1 > ks_dispersion 12 6 0 ∧
    ks_dispersion 12 6 1 > ks_dispersion 12 6 2 ∧
    sq_int 15 > sq_int 12 := by
  refine ⟨?_, by decide, by decide, by decide, by decide, by decide, by decide, by decide⟩
  · simp [ks_dispersion]
"""^^pk:lean4 ;
    skos:notation "omega(q) = alpha * q - beta * q^2 (q = k^2);   4 * beta * omega(q) + (2 * beta * q - alpha)^2 = alpha^2;   q_max = alpha / (2 * beta)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0021-9290(90)90059-C>,
        <https://doi.org/10.1073/pnas.0813269106>,
        <https://doi.org/10.1098/rspb.2012.2670>,
        <https://doi.org/10.1111/j.1469-7580.2011.01386.x> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Cranial Suture Fractal Interdigitation & Kuramoto-Sivashinsky / KPZ Osteogenic Front Instability" ;
    pk:leanDeclaration "MathOfBiology.Loop_020.ks_dispersion" ;
    pk:leanTheorem "MathOfBiology.Loop_020.ks_dispersion_peak_selection" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/bailleul-allometric-cranial-sutures-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Mechanical Unloading & FGFR2 Apert Craniosynostosis Flat Suture Stability Law" ;
    dct:description "Proves that removing tensile mechanical strain (Miura et al. 2009 unloading experiment) or premature osteoblast differentiation in FGFR2 craniosynostosis (alpha <= 0) makes all spatial Fourier modes decay (omega(q) <= 0), collapsing the suture into a flat or fused line (D_f -> 1.0, SII -> 1.0) | Variables: alpha <= 0: stabilized osteogenic front under surgical mechanical unloading or FGFR2 gain-of-function craniosynostosis; gamma >= 0: mesenchymal confinement damping" ;
    dct:source "Miura et al. (2009) PNAS 106:11218-11223 Fig. 5; Khonsari et al. (2013) Proc. R. Soc. B 280:20122670" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2020-bailleul-allometric-cranial-sutures.py#L188-L320>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_020_allometric_cranial_sutures.lean#L59-L83> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def ks_damped_dispersion (alpha beta gamma q : Int) : Int :=
  alpha * q - beta * q * q - gamma
theorem unloaded_and_craniosynostosis_flat_stability (gamma : Int) (hgamma : gamma ≥ 0) :
    ks_damped_dispersion 0 6 gamma 0 ≤ 0 ∧
    ks_damped_dispersion (-35) 60 8 1 = -103 ∧
    ks_damped_dispersion (-35) 60 8 2 = -318 ∧
    ks_damped_dispersion (-60) 80 25 1 = -165 ∧
    ks_damped_dispersion (-60) 80 25 2 = -465 ∧
    ks_damped_dispersion 120 60 4 1 = 56 := by
  refine ⟨?_, by decide, by decide, by decide, by decide, by decide⟩
  · dsimp [ks_damped_dispersion]
    omega
"""^^pk:lean4 ;
    skos:notation "alpha <= 0, beta >= 0, gamma >= 0, q = k^2 >= 0  ==>  omega(q) = alpha * q - beta * q^2 - gamma <= 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0021-9290(90)90059-C>,
        <https://doi.org/10.1073/pnas.0813269106>,
        <https://doi.org/10.1098/rspb.2012.2670>,
        <https://doi.org/10.1111/j.1469-7580.2011.01386.x> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Cranial Suture Fractal Interdigitation & Kuramoto-Sivashinsky / KPZ Osteogenic Front Instability" ;
    pk:leanDeclaration "MathOfBiology.Loop_020.ks_damped_dispersion" ;
    pk:leanTheorem "MathOfBiology.Loop_020.unloaded_and_craniosynostosis_flat_stability" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/bailleul-allometric-cranial-sutures-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Jaslow (1990) Suture Interdigitation Index (SII) & Bending Energy Absorption Hierarchy Law" ;
    dct:description "Establishes that fractal interdigitation amplifies dynamic impact and bending energy absorption monotonically across fused FGFR2 craniosynostosis (SII=1.00) < neonatal infant suture (SII=1.06) < adult sagittal suture (SII=2.84) < adult lambdoid suture (SII=3.48) | Variables: SII = L_arc / L_chord: ratio of interdigitated suture arc length to straight midline chord length; E_0: flat-suture baseline bending energy; kappa_J = 0.72: Jaslow (1990) interdigitation energy absorption slope" ;
    dct:source "Jaslow (1990) J. Biomech. 23(4):313-321 Figs. 2-5; Miura et al. (2009) PNAS 106:11218-11223" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2020-bailleul-allometric-cranial-sutures.py#L322-L445>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_020_allometric_cranial_sutures.lean#L86-L116> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def jaslow_energy_100 (e0 kappa_100 sii_100 : Int) : Int :=
  e0 * (10000 + kappa_100 * (sii_100 - 100))
theorem jaslow_suture_interdigitation_energy_absorption (e0 kappa_100 : Int) :
    jaslow_energy_100 e0 kappa_100 100 = e0 * 10000 ∧
    jaslow_energy_100 10 72 100 = 100000 ∧
    jaslow_energy_100 10 72 106 = 104320 ∧
    jaslow_energy_100 10 72 284 = 232480 ∧
    jaslow_energy_100 10 72 348 = 278560 ∧
    jaslow_energy_100 10 72 100 < jaslow_energy_100 10 72 106 ∧
    jaslow_energy_100 10 72 106 < jaslow_energy_100 10 72 284 ∧
    jaslow_energy_100 10 72 284 < jaslow_energy_100 10 72 348 := by
  refine ⟨?_, by decide, by decide, by decide, by decide, by decide, by decide, by decide⟩
  · simp [jaslow_energy_100]
"""^^pk:lean4 ;
    skos:notation "SII = L_arc / L_chord >= 1.0;   E_bend(SII) = E_0 * (1 + kappa_J * (SII - 1.0));   SII_lambdoid > SII_sagittal > SII_infant > SII_fused = 1.0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0021-9290(90)90059-C>,
        <https://doi.org/10.1073/pnas.0813269106>,
        <https://doi.org/10.1098/rspb.2012.2670>,
        <https://doi.org/10.1111/j.1469-7580.2011.01386.x> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Cranial Suture Fractal Interdigitation & Kuramoto-Sivashinsky / KPZ Osteogenic Front Instability" ;
    pk:leanDeclaration "MathOfBiology.Loop_020.jaslow_energy_100" ;
    pk:leanTheorem "MathOfBiology.Loop_020.jaslow_suture_interdigitation_energy_absorption" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bailleul-allometric-cranial-sutures> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Miura et al. (2009) & Jaslow (1990) cranial suture fractal interdigitation and Kuramoto-Sivashinsky osteogenic instability — Morphometric validation: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Extracts 6 reference-anchored quantitative morphometric measurements via `measure_morphoeval()` (L855-947): adult sagittal box-counting `D_f = 1.3484` (vs `1.36` reference, RMSE `0.0456`), adult sagittal `SII = 2.9181` (vs `2.84`), adult lambdoid `D_f = 1.3756` (`SII = 3.3431`), FGFR2 craniosynostosis & unloading collapse (`SII = 1.0000`), Jaslow bending energy amplification (`2.687x`), and human specimen sagittal suture CV `D_f = 1.2847` (`SII = 2.6791`, log-log `r = 0.9949`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-lambdoid-suture-hyper-interdigitated-fractal-dimension-d-f>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-sagittal-suture-box-counting-fractal-dimension-d-f>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-sagittal-suture-interdigitation-index-sii-l-arc-l-chord>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-fgfr2-apert-craniosynostosis-mechanical-unloading-sii-collapse-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-human-calvaria-specimen-sagittal-suture-cv-box-counting-fractal-dimension-d-f>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-jaslow-1990-bending-energy-absorption-amplification-factor-lambdoid-vs-fused-synostosis>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-morphometric-validation-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-lambdoid-suture-hyper-interdigitated-fractal-dimension-d-f> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Adult lambdoid suture hyper-interdigitated fractal dimension D_f = 1.3756 fractal dimension D_f" ;
        dcterms:description "Lambdoid D_f = 1.3756, SII = 3.3431 > sagittal SII = 2.9181" ;
        schema:measurementTechnique "Dyadic box-counting dimension under high nuchal/masticatory strain (alpha=1.48, beta=0.52)" ;
        schema:name "Adult lambdoid suture hyper-interdigitated fractal dimension D_f" ;
        schema:unitText "fractal dimension D_f" ;
        schema:value "1.3756" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-lambdoid-suture-hyper-interdigitated-fractal-dimension-d-f-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-lambdoid-suture-hyper-interdigitated-fractal-dimension-d-f-reference> a schema:PropertyValue ;
        dcterms:source "Jaslow (1990) J. Biomech. 23:313-321 & Miura et al. (2009) PNAS 106:11218-11223" ;
        schema:value "1.41" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-sagittal-suture-box-counting-fractal-dimension-d-f> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Adult sagittal suture box-counting fractal dimension D_f = 1.3484 fractal dimension D_f" ;
        dcterms:description "Simulated sagittal D_f = 1.3484 (log-log r = 0.9936, RMSE vs specimen/ref = 0.0458, 5-regime std = 0.1735) vs unloaded null control D_f = 1.0000" ;
        schema:measurementTechnique "7-scale dyadic box-counting regression log2 N(eps) vs log2(L/eps) on 2D overhanging KS+KPZ sagittal suture" ;
        schema:name "Adult sagittal suture box-counting fractal dimension D_f" ;
        schema:unitText "fractal dimension D_f" ;
        schema:value "1.3484" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-sagittal-suture-box-counting-fractal-dimension-d-f-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-sagittal-suture-box-counting-fractal-dimension-d-f-reference> a schema:PropertyValue ;
        dcterms:source "Miura et al. (2009) PNAS 106:11218-11223 Figs. 1-4 (mammalian sagittal suture box-counting D_f = 1.32-1.42)" ;
        schema:value "1.36" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-sagittal-suture-interdigitation-index-sii-l-arc-l-chord> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Adult sagittal suture interdigitation index SII (L_arc / L_chord) = 2.9181 L_arc / L_chord" ;
        dcterms:description "Adult sagittal SII = 2.9181 vs infant neonatal SII = 1.0658 and unloaded null SII = 1.0000" ;
        schema:measurementTechnique "Arc-to-chord length ratio of multi-valued overhanging osteogenic front at t = 32" ;
        schema:name "Adult sagittal suture interdigitation index SII (L_arc / L_chord)" ;
        schema:unitText "L_arc / L_chord" ;
        schema:value "2.9181" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-sagittal-suture-interdigitation-index-sii-l-arc-l-chord-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-sagittal-suture-interdigitation-index-sii-l-arc-l-chord-reference> a schema:PropertyValue ;
        dcterms:source "Miura et al. (2009) PNAS 106:11218-11223 & Jaslow (1990) J. Biomech. 23:313-321" ;
        schema:value "2.84" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-fgfr2-apert-craniosynostosis-mechanical-unloading-sii-collapse-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FGFR2 Apert craniosynostosis & mechanical unloading SII collapse ratio = 1.0 L_arc / L_chord" ;
        dcterms:description "FGFR2 craniosynostosis SII = 1.0000 (D_f = 1.0000) and unloaded SII = 1.0000 (max omega = -0.0800 < 0)" ;
        schema:measurementTechnique "Damped KS evolution under premature osteoblast differentiation (alpha = -0.60, gamma = 0.25)" ;
        schema:name "FGFR2 Apert craniosynostosis & mechanical unloading SII collapse ratio" ;
        schema:unitText "L_arc / L_chord" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-fgfr2-apert-craniosynostosis-mechanical-unloading-sii-collapse-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-fgfr2-apert-craniosynostosis-mechanical-unloading-sii-collapse-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Miura et al. (2009) PNAS 106:11218-11223 Fig. 5 & Khonsari et al. (2013) Proc. R. Soc. B 280:20122670 (Lean 4 unloaded_and_craniosynostosis_flat_stability)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-human-calvaria-specimen-sagittal-suture-cv-box-counting-fractal-dimension-d-f> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Human calvaria specimen sagittal suture CV box-counting fractal dimension D_f = 1.2847 fractal dimension D_f" ;
        dcterms:description "Specimen sagittal CV D_f = 1.2847, SII = 2.6791, log-log scaling correlation with simulated sagittal suture r = 0.9998" ;
        schema:measurementTechnique "Automated CV midline cleft segmentation and 7-scale dyadic box-counting on human_sagittal_suture_specimen.jpg" ;
        schema:name "Human calvaria specimen sagittal suture CV box-counting fractal dimension D_f" ;
        schema:unitText "fractal dimension D_f" ;
        schema:value "1.2847" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-human-calvaria-specimen-sagittal-suture-cv-box-counting-fractal-dimension-d-f-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-human-calvaria-specimen-sagittal-suture-cv-box-counting-fractal-dimension-d-f-reference> a schema:PropertyValue ;
        dcterms:source "Vendored Homo sapiens calvaria specimen (Wikimedia Commons File:Sagittal suture 2.jpg, CC BY-SA 3.0) & Miura et al. (2009)" ;
        schema:value "1.35" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-jaslow-1990-bending-energy-absorption-amplification-factor-lambdoid-vs-fused-synostosis> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Jaslow (1990) bending energy absorption amplification factor (lambdoid vs fused synostosis) = 2.687 E_bend / E_0 ratio" ;
        dcterms:description "Bending energy hierarchy: FGFR2 fused (1.000) < infant (1.047) < sagittal (2.381) < lambdoid (2.687)" ;
        schema:measurementTechnique "Jaslow (1990) energy absorption law E_bend(SII)/E_0 = 1 + kappa_J*(SII - 1) across suture regimes" ;
        schema:name "Jaslow (1990) bending energy absorption amplification factor (lambdoid vs fused synostosis)" ;
        schema:unitText "E_bend / E_0 ratio" ;
        schema:value "2.687" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-jaslow-1990-bending-energy-absorption-amplification-factor-lambdoid-vs-fused-synostosis-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-jaslow-1990-bending-energy-absorption-amplification-factor-lambdoid-vs-fused-synostosis-reference> a schema:PropertyValue ;
        dcterms:source "Jaslow (1990) J. Biomech. 23(4):313-321 Figs. 3-5 (Lean 4 jaslow_suture_interdigitation_energy_absorption)" ;
        schema:value "2.75" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L855–L947" ;
        dcterms:description "6 quantitative MorphoEval measurements with references, std, RMSE, Pearson r, and null/synostosis ablations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2020-bailleul-allometric-cranial-sutures.py#L855-L947> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


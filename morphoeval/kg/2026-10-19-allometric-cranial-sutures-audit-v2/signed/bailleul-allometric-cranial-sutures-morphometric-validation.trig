sub1:provenance {
    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0021-9290(90)90059-C>,
            <https://doi.org/10.1073/pnas.0813269106>,
            <https://doi.org/10.1098/rspb.2012.2670>,
            <https://doi.org/10.1111/j.1469-7580.2011.01386.x> .

    <https://doi.org/10.1016/0021-9290(90)90059-C> dcterms:date "1990"^^xsd:gYear ;
        dcterms:title "Mechanical properties of cranial sutures" .

    <https://doi.org/10.1073/pnas.0813269106> dcterms:date "2009"^^xsd:gYear ;
        dcterms:title "Mechanism of cranial suture fractal interdigitation" .

    <https://doi.org/10.1098/rspb.2012.2670> dcterms:date "1759"^^xsd:gYear ;

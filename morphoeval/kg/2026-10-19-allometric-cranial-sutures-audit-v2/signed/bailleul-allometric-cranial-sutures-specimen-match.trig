sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bailleul-allometric-cranial-sutures> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Miura et al. (2009) & Jaslow (1990) cranial suture fractal interdigitation and Kuramoto-Sivashinsky osteogenic instability — Morphological realism / specimen match: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the CC BY-SA 3.0 superior-view human calvaria photograph (`datasets/allometric_cranial_sutures/human_sagittal_suture_specimen.jpg`), automatically segments the calvarial bone mask, suppresses annotation overlays, extracts the interdigitated sagittal suture midline contour (`segment_human_suture_specimen`, L450-541: `D_f = 1.2847`, `SII = 2.6791`, box-counting `r = 0.9964`), and compares it directly against the simulated adult sagittal suture in Panels B1, C1, and C2." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-specimen-match-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L450–L541" ;
        dcterms:description "Automated calvarial segmentation, sagittal suture midline cleft extraction, SII, and dyadic box-counting D_f" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2020-bailleul-allometric-cranial-sutures.py#L450-L541> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/allometric_cranial_sutures_comparison.png (generated output)" ;
        dcterms:description "9-panel dark-mode synthesis figure with human sagittal suture CV trace overlay and waveform comparison — docs/media/allometric_cranial_sutures_comparison.png: rendered output of 2020-bailleul-allometric-cranial-sutures.py at 317bc3c, image/png, 1121609 B, 2227×1782 px, artifact_sha256 a9db7edbea67db2b4950a5be983f2eb6d96310a6e86b3135d5babf4b038114b2 (sha256 a9db7edbea67db2b4950a5be983f2eb6d96310a6e86b3135d5babf4b038114b2), spec_fingerprint 53dc68ef4189bb186f820ba54b5a160dfe42da44326e82b66ab860cc7d2ad00e" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila subobscura Turing wavelength at 3.0 µm (Pass 1) — Model fidelity to source: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The Jacobian, the critical-wavenumber formula, and the explicit integrator match the cited reaction-diffusion law. Pass 1 does not yet show that equal diffusivities close the Turing band." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "models/2026-delphi10000-drosophila-subobscura-turing-wavelength-s0.py L497–L499: Pass 1 leaves ablation unset <https://github.com/fractastical/morpholib/blob/a89be184699d71a03a1673e1f49d8998944a483a/models/2026-delphi10000-drosophila-subobscura-turing-wavelength-s0.py#L497-L499>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-model-fidelity-1> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-subobscura-turing-wavelength-s0.py L85–L99" ;
        dct:description "k_c^2 = (Dv f_u + Du g_v) / (2 Du Dv)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a89be184699d71a03a1673e1f49d8998944a483a/models/2026-delphi10000-drosophila-subobscura-turing-wavelength-s0.py#L85-L99> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, Pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


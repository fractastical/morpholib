<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-subobscura-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Positive diffusion product required before a finite Turing band can exist | Variables: Du = 0.041, Dv = 0.530; Lean product uses 41 × 530 in units of 10^-3" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a89be184699d71a03a1673e1f49d8998944a483a/models/2026-delphi10000-drosophila-subobscura-turing-wavelength-s0.py#L85-L99>,
        <https://github.com/fractastical/morpholib/blob/a89be184699d71a03a1673e1f49d8998944a483a/morphoeval/lean/loops/Loop_3206_drosophila_subobscura_turing_wavelength_s0.lean#L22-L24> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J - k^2 D) = Du Dv k^4 - (Dv f_u + Du g_v) k^2 + (f_u g_v - f_v g_u)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1039/a702602a>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.287.5451.308> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3206.diffusionProduct" ;
    pk:leanTheorem "MathOfBiology.Loop_3206.diffusion_product_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-subobscura-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber above the predecessor" ;

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Drosophila subobscura Turing wavelength at 3.0 µm (Pass 1) faithfully reproduces Drosophila subobscura morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-subobscura-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila subobscura specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-subobscura-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-subobscura-turing-wavelength-s0.py; output: docs/media/drosophila_subobscura_turing_wavelength_s0_comparison.png; organism: Drosophila subobscura; environment: n/a; claim_boundary: [reported_in_source: Huey et al. (2000) report that Old World Drosophila subobscura wing length increases with latitude, that North America had no detectable cline one decade after introduction, and that a convergent cline had evolved after two decades. | Turing (1952) shows that a reaction-diffusion system can select a finite wavenumber. Schnakenberg (1979) supplies the two-species reaction; Maini, Painter and Chau (1997) review its use as a Turing system.; reconstructed_in_script: Pass 1 reconstructs k_c for a=0.085, b=1.06, Du=0.041, Dv=0.530 and integrates the nonlinear field from a critical-mode seed (seed 3206).; transfer_boundary: The 3.0 µm wavelength is the assigned subcellular detail scale. It is not a length reported by Huey, Gilchrist, or their coauthors.; does_not_claim: Does not claim the Pass 1 activator image is a segmentation of the Cooper 2015 specimen. | Does not claim a parameter sweep or a negative control was executed on the Pass 1 path.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1039/a702602a>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.287.5451.308> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-subobscura-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-subobscura-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


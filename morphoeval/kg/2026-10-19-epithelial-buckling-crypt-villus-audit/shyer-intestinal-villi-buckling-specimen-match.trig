sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-shyer-intestinal-villi-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2011) PRL & Shyer et al. (2013) Science sequential smooth-muscle mucosal buckling into ridges, zigzags, and hexagonal villi — Morphological realism / specimen match: 34/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Although `datasets/epithelial_buckling_crypt_villus/intestinal_villi_crypts_specimen.jpg` is vendored on disk, the v1 script never loads, segments, or measures hexagonal villus coordination and bond-orientational order |Psi_6| on the biological histology specimen, and compares only against 6 Chick stages without Quail or Mouse comparative data." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2013-shyer-intestinal-villi-buckling.py L88–L115: Evaluates only Chick E6-E16 tabular points without loading or segmenting intestinal_villi_crypts_specimen.jpg <https://github.com/fractastical/morpholib/blob/e93f00e/2013-shyer-intestinal-villi-buckling.py#L88-L115>",
            "docs/media/epithelial_buckling_crypt_villus_comparison.png (generated output, not in repo): 4-panel v1 plot lacks histology specimen segmentation and 3-species collapse panels — docs/media/epithelial_buckling_crypt_villus_comparison.png: rendered output of 2013-shyer-intestinal-villi-buckling.py at e93f00e, image/png, 164272 B, 1495×1105 px, artifact_sha256 6e9b91bbf80b94a3cc0b4c6533d28c5de4e2a2494a675fb34bc100d61c67e40a (sha256 6e9b91bbf80b94a3cc0b4c6533d28c5de4e2a2494a675fb34bc100d61c67e40a), spec_fingerprint f6a04e7da51440cd41541428ef80cd7b7e9f5332411d929e37970e56635d68c5" ;
        pk:hasScore "0.34"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 063 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-shyer-intestinal-villi-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2011) PRL & Shyer et al. (2013) Science sequential smooth-muscle mucosal buckling into ridges, zigzags, and hexagonal villi — Parameter expressivity: 48/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates 6 embryonic stages of Chick (E6-E16) across smooth, ridge, zigzag, and hexagonal villi regimes (L88-115), but omits the 12-point 3-species morphospace collapse (Chick, Quail, Mouse), omits the 5 FK506/surgical smooth-muscle ablation conditions (E6, E10 slit, E11, E14, WT E16), and exposes no CLI parameter overrides." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2013-shyer-intestinal-villi-buckling.py L88–L115: Single-species Chick E6-E16 evaluation without FK506/surgical ablation sweep or CLI overrides <https://github.com/fractastical/morpholib/blob/e93f00e/2013-shyer-intestinal-villi-buckling.py#L88-L115>" ;
        pk:hasScore "0.48"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 063 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


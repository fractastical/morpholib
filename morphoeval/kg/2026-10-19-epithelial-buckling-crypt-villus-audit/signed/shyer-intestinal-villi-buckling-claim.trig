sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-shyer-intestinal-villi-buckling> a pk:Claim ;
        rdfs:label "Hannezo et al. (2011) PRL & Shyer et al. (2013) Science sequential smooth-muscle mucosal buckling into ridges, zigzags, and hexagonal villi faithfully reproduces Vertebrate embryonic gut mucosa (Gallus gallus, Coturnix japonica, Mus musculus) morphology" ;
        dcterms:description "The simulation script(s) 2013-shyer-intestinal-villi-buckling.py implement the cited source model as published and produce forms that match real Vertebrate embryonic gut mucosa (Gallus gallus, Coturnix japonica, Mus musculus) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 52.8/100, audit 2026-10-19-epithelial-buckling-crypt-villus-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/e93f00e/2013-shyer-intestinal-villi-buckling.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/e93f00e/2013-shyer-intestinal-villi-buckling.py; output: docs/media/epithelial_buckling_crypt_villus_comparison.png; organism: Vertebrate embryonic gut mucosa (Gallus gallus, Coturnix japonica, Mus musculus); checkpoint commit: https://github.com/fractastical/morpholib/commit/e93f00e; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: f6a04e7da51440cd41541428ef80cd7b7e9f5332411d929e37970e56635d68c5; artifact_sha256: 6e9b91bbf80b94a3cc0b4c6533d28c5de4e2a2494a675fb34bc100d61c67e40a; input_dataset_sha256: {datasets/epithelial_buckling_crypt_villus/epithelial_buckling_crypt_villus_reference.json=1887bf2160034e33..., datasets/epithelial_buckling_crypt_villus/intestinal_villi_crypts_specimen.jpg=30afcb789bbdc60c..., datasets/epithelial_buckling_crypt_villus/paper_citations.bib=a8bc0251af8be542..., datasets/epithelial_buckling_crypt_villus/scout_manifest.json=1e6e1bbc98fb4873...}" ;
        pk:derivedFromPaper <https://doi.org/10.1073/pnas.1205669109>,
            <https://doi.org/10.1103/PhysRevLett.107.078104>,
            <https://doi.org/10.1103/PhysRevLett.110.024302>,
            <https://doi.org/10.1126/science.1238842> ;

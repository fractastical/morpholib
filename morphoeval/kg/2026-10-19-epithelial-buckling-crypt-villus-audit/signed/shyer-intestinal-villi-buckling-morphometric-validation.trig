            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-hexagonal-villus-spacing-lambda-sim> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .


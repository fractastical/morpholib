    <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2011) PRL & Shyer et al. (2013) Science sequential smooth-muscle mucosal buckling into ridges, zigzags, and hexagonal villi — Morphometric validation: 52/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L181-213) reports only 3 analytic wavelength numbers (Chick E10, E14, E16) without 2D spectral/FFT wavelength extraction from a relaxed energy minimizer, without zigzag chevron angle theta_zz or hexagonal order |Psi_6| measurements, without FK506 negative-control deltas, and without specimen image morphometrics." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2013-shyer-intestinal-villi-buckling.py L181–L213: Only 3 basic wavelength metrics without p-values, FFT/Delaunay hexagonal order, or specimen segmentation <https://github.com/fractastical/morpholib/blob/e93f00e/2013-shyer-intestinal-villi-buckling.py#L181-L213>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e10-longitudinal-ridge-wavelength-lambda-sim>,

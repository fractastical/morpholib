sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-shyer-intestinal-villi-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L39–L53" ;
        dcterms:description "Exact mucosal bending rigidity B_e, foundation stiffness K_s, and quartic wavelength lambda_*" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2013-shyer-intestinal-villi-buckling.py#L39-L53> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 063 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2011) PRL & Shyer et al. (2013) Science sequential smooth-muscle mucosal buckling into ridges, zigzags, and hexagonal villi — Model fidelity to source: 57/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes mucosal bending rigidity B_e = E_e*h_e^3/(12*(1-nu^2)), stromal foundation stiffness K_s = E_s/H_s, and characteristic wavelength lambda_* ~ 2*pi*(B_e/K_s)^(1/4) (L39-53), backed by 3 Lean 4 theorems in `Loop_063_epithelial_buckling_crypt_villus.lean`. However, `generate_parametric_mucosal_surface` (L56-85) uses a hardcoded Fourier superposition rather than minimizing the coupled Föppl-von Kármán + neo-Hookean free-energy functional F[w], and lacks FK506/surgical smooth-muscle ablation controls." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2013-shyer-intestinal-villi-buckling.py L56–L85: Closed-form 2D Fourier ansatz instead of Föppl-von Kármán energy minimization <https://github.com/fractastical/morpholib/blob/e93f00e/2013-shyer-intestinal-villi-buckling.py#L56-L85>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-model-fidelity-1> ;
        pk:hasScore "0.57"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


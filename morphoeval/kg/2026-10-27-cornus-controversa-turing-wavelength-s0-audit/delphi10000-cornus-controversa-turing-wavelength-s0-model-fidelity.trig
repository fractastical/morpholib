sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cornus controversa Turing wavenumber at 1.939 mm (Holocene, 0 Ma) — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Equations (1)–(6) in the module docstring are the Schnakenberg PDE, the steady state, the Jacobian, and Turing's k_c. solve_diffusivities returns lambda = 1.939000 mm and a self-test checks trace < 0, det > 0, Dv > Du, and a closed band when Du = Dv. Modes whose eigenvalues are a complex pair are excluded, because |u-hat| is then not a pure exponential; the eleven real modes that remain track sigma(k). Deduction: a and b were chosen for this slot so the wavelength would land on 1.939 mm. They are not parameters reported for Cornus." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity-4> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cornus-controversa-turing-wavelength-s0.py L1–L40" ;
        dct:description "docstring states the PDE, the Jacobian, and k_c" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cornus-controversa-turing-wavelength-s0.py#L1-L40> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cornus-controversa-turing-wavelength-s0.py L90–L155" ;
        dct:description "jacobian() and solve_diffusivities() pin lambda_c" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cornus-controversa-turing-wavelength-s0.py#L90-L155> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cornus-controversa-turing-wavelength-s0.py L157–L172" ;
        dct:description "dispersion_parts / growth_rate implement sigma(k), including a negative discriminant" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cornus-controversa-turing-wavelength-s0.py#L157-L172> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3155_cornus_controversa_turing_wavelength_s0.lean L10–L44" ;
        dct:description "six decide theorems: trace, det, 2 pi closure, inhibitor contrast, equal diffusion, chronoseries gap" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3155_cornus_controversa_turing_wavelength_s0.lean#L10-L44> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent round; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


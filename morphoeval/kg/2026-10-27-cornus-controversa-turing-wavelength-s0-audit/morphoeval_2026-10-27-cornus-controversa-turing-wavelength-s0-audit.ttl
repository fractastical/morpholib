<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Cornus controversa Turing wavenumber at 1.939 mm (Holocene, 0 Ma) — Morphological realism / specimen match: 72/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The comparison figure shows the Meise crown beside the dispersion fit and the lamina field, and the GIF has 12 frames at 480x640 whose last frame is that photograph (CV similarity 96.0 against the specimen file). The generative field itself is a spot lattice on a square, not a cream leaf margin and not the pagoda tiers. Foreground fraction of the photo is 0.866; bright foliage above the lawn is 0.212. Those are crown statistics. Score stays in the 70s because the organism is on the page while the mechanism's picture is not the organism's picture." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-specimen-match-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-specimen-match-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-specimen-match-3> ;
    pk:hasScore 7.2e-01 ;
    pk:hasVerdict "mostly faithful" .


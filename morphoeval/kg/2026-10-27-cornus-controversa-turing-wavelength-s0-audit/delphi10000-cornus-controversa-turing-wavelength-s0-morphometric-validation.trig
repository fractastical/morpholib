sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Cornus controversa Turing wavenumber at 1.939 mm (Holocene, 0 Ma) — Morphometric validation: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Linear probe: Pearson r = 0.9999998 (n = 11 real modes), RMSE = 2.13e-4 per time unit, against reference bar 0.98. KS statistic of the residuals versus Normal(0, s) is 0.514 (p = 0.003): the residuals are structured truncation error, not a normal sample, and that failure is reported rather than dropped. Nonlinear dominant wavelength on the 8-lambda box is 2.216 mm versus 1.939 mm (ratio 1.14), i.e. Fourier bin 7 instead of bin 8. Ablation std ratio 0.018 with sigma_max -0.0615. Specimen foreground 0.866 versus null 0.50, foliage fraction 0.212 versus null 0.25, horizontal-edge fraction 0.433 versus the field's 0.421. The crown frame is 960x1280 and has no scale bar, so none of those photo numbers is a millimetre. The resolution block is not written on this pass." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-ablation-equal-diffusion-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-dispersion-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-dispersion-pearson-r-pde-vs-analytic-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-specimen-foliage-bright-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-specimen-horizontal-edge-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-morphometric-validation-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-morphometric-validation-4> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-ablation-equal-diffusion-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation equal-diffusion std ratio = 0.0183 1" ;
        dct:description "sigma_max=-0.0615 (must be negative)" ;
        schema:measurementTechnique "std(u_final)/std(u_initial) with D_u = D_v = D_u*, noise seed 3162" ;
        schema:name "ablation equal-diffusion std ratio" ;
        schema:unitText "1" ;
        schema:value "0.0183" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-ablation-equal-diffusion-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-ablation-equal-diffusion-std-ratio-reference> a schema:PropertyValue ;
        dct:source "a neutrally persistent field would keep ratio 1; Turing-off should decay" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-dispersion-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion KS statistic = 0.5144 1" ;
        dct:description "ks_p=0.0031, n_modes=11" ;
        schema:measurementTechnique "Kolmogorov–Smirnov statistic of σ residuals against Normal(0, s)" ;
        schema:name "dispersion KS statistic" ;
        schema:unitText "1" ;
        schema:value "0.5144" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "a perfect residual distribution would have KS = 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-dispersion-pearson-r-pde-vs-analytic-sigma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion Pearson r (PDE vs analytic sigma) = 1.0 1" ;
        dct:description "RMSE=0.00021, KS=0.5144, p_pearson=4.21e-30" ;
        schema:measurementTechnique "early-time Fourier growth of 12 discrete Laplacian modes vs eigenvalue σ(k)" ;
        schema:name "dispersion Pearson r (PDE vs analytic sigma)" ;
        schema:unitText "1" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-dispersion-pearson-r-pde-vs-analytic-sigma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-dispersion-pearson-r-pde-vs-analytic-sigma-reference> a schema:PropertyValue ;
        dct:source "pre-registered acceptance bar for the linear dispersion fit; the ideal identity is r = 1" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 0.0002 1/time" ;
        schema:measurementTechnique "root mean square of σ_measured − σ_analytic over the probed band" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.0002" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "zero residual against equation (5)" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nonlinear dominant wavelength = 2.216 mm" ;
        schema:measurementTechnique "radial FFT peak of the saturated Schnakenberg activator on an 8 λ patch" ;
        schema:name "nonlinear dominant wavelength" ;
        schema:unitText "mm" ;
        schema:value "2.216" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength-reference> a schema:PropertyValue ;
        dct:source "slot assignment 1.939 mm = 0.001939 m" ;
        schema:value "1.939" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-specimen-foliage-bright-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen foliage bright fraction = 0.2118 1" ;
        schema:measurementTechnique "luminance > 0.45 above the lower 20 percent lawn band" ;
        schema:name "specimen foliage bright fraction" ;
        schema:unitText "1" ;
        schema:value "0.2118" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-specimen-foliage-bright-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-specimen-foliage-bright-fraction-reference> a schema:PropertyValue ;
        dct:source "fixed null, not the measured fraction" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen foreground fraction = 0.8659 1" ;
        schema:measurementTechnique "border-contrast mask on cornus_controversa_specimen.jpg (crown photograph, not the 1.939 mm patch)" ;
        schema:name "specimen foreground fraction" ;
        schema:unitText "1" ;
        schema:value "0.8659" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "null occupancy of a half-filled frame; not fitted to this photo" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-specimen-horizontal-edge-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen horizontal-edge fraction = 0.4328 1" ;
        schema:measurementTechnique "share of Sobel energy within 30 degrees of a horizontal edge on the crown photograph" ;
        schema:name "specimen horizontal-edge fraction" ;
        schema:unitText "1" ;
        schema:value "0.4328" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-specimen-horizontal-edge-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-specimen-horizontal-edge-fraction-reference> a schema:PropertyValue ;
        dct:source "same statistic measured on the lamina activator field" ;
        schema:value "0.4215" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.3634 1" ;
        dct:description "reference is the simulated orientation fraction, not a copy of the coherency" ;
        schema:measurementTechnique "mean structure-tensor coherency inside the foreground mask" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "1" ;
        schema:value "0.3634" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "lamina-field horizontal-edge fraction, a different statistic, so the pair is not val==ref by construction" ;
        schema:value "0.4215" .

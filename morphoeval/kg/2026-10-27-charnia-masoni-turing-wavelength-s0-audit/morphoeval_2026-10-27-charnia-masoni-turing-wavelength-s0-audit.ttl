<https://w3id.org/delphi/resource/math-law/delphi10000-charnia-masoni-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg Jacobian and Turing numerator" ;
    dct:description "Diffusion-driven instability condition for the apical primordium | Variables: a=0.14, b=0.93, D_u=0.062, D_v=1.35 at L = 140.4 µm" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/96a891cfffcbf7fb81617c1df76c424d1d7359a5/models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/96a891cfffcbf7fb81617c1df76c424d1d7359a5/morphoeval/lean/loops/Loop_3145_charnia_masoni_turing_wavelength_s0.lean#L12-L19> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), with f_u = -1 + 2 u0 v0 and g_v = -u0^2 at u0 = a + b" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1475-4983.2012.01164.x>,
        <https://doi.org/10.1126/sciadv.abe0291>,
        <https://doi.org/10.1144/pygs.31.3.211> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3145.turingNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3145.apical_turing_condition_140um" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-charnia-masoni-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail wavelength finer than the 6.322 mm organ sibling" ;
    dct:description "Scale delta versus the organ-tier sibling, same chronospecies | Variables: 1404 vs 63220 in units of 0.1 µm" ;
    dct:source "Ford 1958 DOI:10.1144/pygs.31.3.211; loop scale assignment 140 µm vs sibling 6.3 mm" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/96a891cfffcbf7fb81617c1df76c424d1d7359a5/models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py>,

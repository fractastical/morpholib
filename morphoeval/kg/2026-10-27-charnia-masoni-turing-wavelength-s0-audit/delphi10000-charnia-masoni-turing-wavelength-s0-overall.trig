sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Charnia masoni apical Turing wavelength at 140 µm (565 Ma), pass 1 — MorphoEval overall 78.8/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 1 of the 140 µm Charnia masoni apical Turing model. The dispersion law already matched (Pearson r 0.998) but the render was a landscape disk at 85° (CV 83.9) and the wavelength sweep mixed k_c with the fastest mode (RMSE 34.5 µm). Those three items are the remediation list. Overall 78.8/100 (faithfulness 75.4, reproducibility 86.8); rubric morphoeval 0.1.0; checkpoint commit 96a891cfffcbf7fb81617c1df76c424d1d7359a5; environment: python 3.12.3, numpy 2.5.4, matplotlib 3.11.2, Pillow 13.0.0, scipy 1.18.1. Dimension assessments: Model fidelity to source 80, Morphological realism / specimen match 72, Parameter expressivity 74, Morphometric validation 76, Source and data traceability 90, Code-to-model traceability 84, Reproducibility package 86. Output judged: docs/media/charnia_masoni_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py at 96a891cfffcbf7fb81617c1df76c424d1d7359a5, image/png, 342160 B, 1452×902 px, artifact_sha256 261c01363f55e4ae43842c71f63a8434b2a73871e2505f7fc2e184c95023d7ec (sha256 261c01363f55e4ae43842c71f63a8434b2a73871e2505f7fc2e184c95023d7ec), spec_fingerprint 571668419f3b61d8829b66959046ef157ab530e8516cc89e6ab7b1925a5766c7. Dual provenance: spec_fingerprint: 571668419f3b61d8829b66959046ef157ab530e8516cc89e6ab7b1925a5766c7; artifact_sha256: 261c01363f55e4ae43842c71f63a8434b2a73871e2505f7fc2e184c95023d7ec; input_dataset_sha256: {datasets/charnia_masoni_turing_wavelength_s0/README.md=4488c865883388ab..., datasets/charnia_masoni_turing_wavelength_s0/charnia_masoni_specimen.jpg=c7e8d470af175675..., datasets/charnia_masoni_turing_wavelength_s0/charnia_masoni_turing_wavelength_s0_reference.json=262080091420a03a..., datasets/charnia_masoni_turing_wavelength_s0/paper_citations.bib=f4cb4c63fbfbc0fd..., datasets/charnia_masoni_turing_wavelength_s0/scout_manifest.json=ee8179dfab5e793f...}. Claim boundary: reported_in_source: Turing 1952 dispersion relation and Schnakenberg 1979 kinetics. | Charnia is a glide-reflected rangeomorph with apical growth (Brasier, Antcliffe and Liu 2012; Dunn et al. 2021); Ford 1958 named it from Charnwood Forest.; reconstructed_in_script: Schnakenberg parameters (0.14, 0.93, 0.062, 1.35) with the determinant-critical wavelength scaled to 0.0001404 m.; transfer_boundary: 140 µm is the assigned detail tier, not a length measured on the fossil.; does_not_claim: Pass 1 does not claim the landscape disk resembles the cast.." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Draw the equal-diffusion control as a panel. Pass 1 showed it only as a decaying curve.",
            "remediation needed: Replace the 720×540 disk at 85° with a portrait chevron whose angle sits at the CV maximum (58° on the probe grid), not on the edge of the search.",
            "remediation needed: Sweep the fastest-mode wavelength against itself. The pass-1 sweep mixed the determinant-critical k_c with argmax σ and reported RMSE 34.5 µm." ;
        pk:hasScore "0.788"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (Cursor cloud agent, primary assessor, pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Charnia masoni apical Turing wavelength at 140 µm (565 Ma), pass 1 — Model fidelity to source: 80/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Eqs. 1–7 are the Schnakenberg Turing law and the Euler probe already tracked analytic σ (r = 0.998). The pass-1 sweep then compared that σ-peak with a different wavenumber, so the wavelength test was not yet the law it named." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-model-fidelity-1> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py L83–L142" ;
        dct:description "Jacobian and analytic σ(k) were already the published formulae." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/96a891cfffcbf7fb81617c1df76c424d1d7359a5/models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py#L83-L142> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (Cursor cloud agent, primary assessor, pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.1475-4983.2012.01164.x>,
            <https://doi.org/10.1126/sciadv.abe0291>,
            <https://doi.org/10.1144/pygs.31.3.211> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1111/j.1475-4983.2012.01164.x> dct:date "2012"^^xsd:gYear ;
        dct:title "The architecture of Ediacaran Fronds" .
    <https://doi.org/10.1126/sciadv.abe0291> dct:date "2021"^^xsd:gYear ;
        dct:title "The developmental biology of Charnia and the eumetazoan affinity of the Ediacaran rangeomorphs" .
    <https://doi.org/10.1144/pygs.31.3.211> dct:date "1958"^^xsd:gYear ;
        dct:title "Pre-Cambrian fossils from Charnwood Forest" .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Charnia masoni apical Turing wavelength at 140 µm (565 Ma), pass 1 faithfully reproduces Charnia masoni morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Charnia masoni specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py; output: docs/media/charnia_masoni_turing_wavelength_s0_comparison.png; organism: Charnia masoni; environment: python 3.12.3, numpy 2.5.4, matplotlib 3.11.2, Pillow 13.0.0, scipy 1.18.1; claim_boundary: [reported_in_source: Turing 1952 dispersion relation and Schnakenberg 1979 kinetics. | Charnia is a glide-reflected rangeomorph with apical growth (Brasier, Antcliffe and Liu 2012; Dunn et al. 2021); Ford 1958 named it from Charnwood Forest.; reconstructed_in_script: Schnakenberg parameters (0.14, 0.93, 0.062, 1.35) with the determinant-critical wavelength scaled to 0.0001404 m.; transfer_boundary: 140 µm is the assigned detail tier, not a length measured on the fossil.; does_not_claim: Pass 1 does not claim the landscape disk resembles the cast.]; phenomenon_size: 126 µm (0.0001264 m, log10=-3.898 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 126 µm to 28.4 cm): 126 µm:charnia-masoni-bioelectric-polarity, 395 µm:charnia-masoni-vertex-packing, 6.3 mm:charnia-masoni-turing-wavelength, 1.3 cm:charnia-masoni-clock-wavefront, 2.8 cm:charnia-masoni-morphogen-condensation, 3.5 cm:charnia-masoni-elastic-buckling, 4.0 cm:charnia-masoni-flux-canalization, 5.5 cm:charnia-masoni-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.1475-4983.2012.01164.x>,
            <https://doi.org/10.1126/sciadv.abe0291>,
            <https://doi.org/10.1144/pygs.31.3.211> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


        <https://doi.org/10.1038/nature14646>,
        <https://doi.org/10.1073/pnas.1408542111>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1139/e07-003> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3227.age_inside_mid_ediacaran" ;
    pk:leanTheorem "MathOfBiology.Loop_3227.age_inside_mid_ediacaran" ;
    pk:leanVerified true .


<https://w3id.org/delphi/resource/math-law/delphi10000-fractofusus-misrai-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Opens the finite-k band for a 63 µm stationary wave on Fractofusus misrai | Variables: f_u, f_v, g_u, g_v from Schnakenberg at a=0.09, b=0.85; D_u=0.12, D_v=2.40" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-fractofusus-misrai-turing-wavelength-s0.py#L108-L124>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3227_fractofusus_misrai_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J - k^2 D) = D_u D_v k^4 - (D_v f_u + D_u g_v) k^2 + (f_u g_v - f_v g_u)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature14646>,
        <https://doi.org/10.1073/pnas.1408542111>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1139/e07-003> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3227.turing_h_positive" ;
    pk:leanTheorem "MathOfBiology.Loop_3227.turing_h_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-fractofusus-misrai-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength" ;
    dct:description "Detail-scale repeat; 51 copies fit in the 3.275 mm organ module and 52 do not | Variables: lambda_c fixed at 6.33e-05 m by the grid spacing" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-fractofusus-misrai-turing-wavelength-s0.py#L126-L134>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3227_fractofusus_misrai_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 2 pi / k_c, k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature14646>,
        <https://doi.org/10.1073/pnas.1408542111>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1139/e07-003> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3227.lambdaTenths" ;
    pk:leanTheorem "MathOfBiology.Loop_3227.scale_separation" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-fractofusus-misrai-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diffusion-ratio precondition" ;
    dct:description "Inhibitor spreads faster than the activator, required for a Turing band | Variables: D_u activator diffusivity, D_v inhibitor diffusivity" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-fractofusus-misrai-turing-wavelength-s0.py#L245-L264>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3227_fractofusus_misrai_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_v / D_u = 20 > 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature14646>,
        <https://doi.org/10.1073/pnas.1408542111>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1139/e07-003> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3227.diffusionRatio" ;
    pk:leanTheorem "MathOfBiology.Loop_3227.inhibitor_diffuses_faster" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-fractofusus-misrai-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Mid-Ediacaran age window" ;
    dct:description "Pins 565 Ma inside Gehling & Narbonne 2007 ca. 575-560 Ma | Variables: geological age of the Mistaken Point chronospecies" ;
    dct:source "Gehling & Narbonne 2007 DOI:10.1139/e07-003" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-fractofusus-misrai-turing-wavelength-s0.py#L517-L540>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3227_fractofusus_misrai_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;

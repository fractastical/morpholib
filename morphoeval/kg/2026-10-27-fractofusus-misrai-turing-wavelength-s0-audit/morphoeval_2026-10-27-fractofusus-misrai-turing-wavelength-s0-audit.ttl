<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg–Turing wavelength for Fractofusus misrai at 63 µm (565 Ma) — Code-to-model traceability: 84/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The module docstring states the PDEs, the expression for k_c, the periodic boundary, the 565 Ma age, and the 51-versus-52 scale separation. Each measured quantity is produced by a named function. The chevron in the renderer is a display wavelength, and that distinction is easier to miss than the dispersion code." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-code-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-code-traceability-2> ;
    pk:hasScore 8.4e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg–Turing wavelength for Fractofusus misrai at 63 µm (565 Ma) — Model fidelity to source: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script integrates Schnakenberg kinetics with spectral diffusion and evaluates the Turing 1952 dispersion relation, including trace, determinant, and the diffusion-weighted trace. The kinetics are Schnakenberg's, not the specific reaction network in Turing's 1952 examples." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg–Turing wavelength for Fractofusus misrai at 63 µm (565 Ma) — Morphometric validation: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Dispersion Pearson r = 0.999999999 and RMSE = 0.00375 against the analytical curve. The saturated wavelength, 73.7 µm, is not set equal to the 63.3 µm linear reference. Specimen spindle aspect 1.70 is compared with the render's 1.11, and the gradient-angle KS statistic is 0.093 (p = 2e-15) on one photograph. That is a real comparison on n = 1, not a population." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-dispersion-rmse-between-numerical-and-analytical-growth-rates>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-equal-diffusion-ablation-final-activator-std>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-ks-statistic-of-specimen-versus-simulation-gradient-angle-samples>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength-on-the-saturated-63-m-field>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-specimen-spindle-aspect-ratio-height-over-width-from-the-cc-by-mould>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-subcritical-domain-ablation-final-activator-std>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-of-spectral-k-versus-analytical-k>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-morphometric-validation-1>,

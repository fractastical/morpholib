sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg–Turing wavelength for Fractofusus misrai at 63 µm (565 Ma) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 0.999999999 and RMSE = 0.00375 against the analytical curve. The saturated wavelength, 73.7 µm, is not set equal to the 63.3 µm linear reference. Specimen spindle aspect 1.70 is compared with the render's 1.11, and the gradient-angle KS statistic is 0.093 (p = 2e-15) on one photograph. That is a real comparison on n = 1, not a population." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-dispersion-rmse-between-numerical-and-analytical-growth-rates>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-equal-diffusion-ablation-final-activator-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-ks-statistic-of-specimen-versus-simulation-gradient-angle-samples>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength-on-the-saturated-63-m-field>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-specimen-spindle-aspect-ratio-height-over-width-from-the-cc-by-mould>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-subcritical-domain-ablation-final-activator-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-of-spectral-k-versus-analytical-k>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-dispersion-rmse-between-numerical-and-analytical-growth-rates> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE between numerical and analytical growth rates = 0.003753 1/time" ;
        dct:description "uncertainty on the linear wavenumber fit" ;
        schema:measurementTechnique "root mean square of σ_numerical(k) - σ_analytic(k) for integer k = 1..8" ;
        schema:name "dispersion RMSE between numerical and analytical growth rates" ;
        schema:unitText "1/time" ;
        schema:value "0.003753" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-dispersion-rmse-between-numerical-and-analytical-growth-rates-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-dispersion-rmse-between-numerical-and-analytical-growth-rates-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-equal-diffusion-ablation-final-activator-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation final activator std = 0.000348 concentration std" ;
        dct:description "negative control versus the patterned D_v/D_u = 20 run" ;
        schema:measurementTechnique "Schnakenberg with D_u = D_v = 2.40; Turing h = D*trace < 0 so the pattern must decay" ;
        schema:name "equal-diffusion ablation final activator std" ;
        schema:unitText "concentration std" ;
        schema:value "0.000348" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-equal-diffusion-ablation-final-activator-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-equal-diffusion-ablation-final-activator-std-reference> a schema:PropertyValue ;
        schema:value "0.009975" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-ks-statistic-of-specimen-versus-simulation-gradient-angle-samples> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "KS statistic of specimen versus simulation gradient-angle samples = 0.0927 KS D" ;
        dct:description "p = 2.1738211017844307e-15; value is not the null reference 0" ;
        schema:measurementTechnique "two-sample KS on 4000 Sobel-magnitude-weighted gradient angles from the photograph and the GIF" ;
        schema:name "KS statistic of specimen versus simulation gradient-angle samples" ;
        schema:unitText "KS D" ;
        schema:value "0.0927" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-ks-statistic-of-specimen-versus-simulation-gradient-angle-samples-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-ks-statistic-of-specimen-versus-simulation-gradient-angle-samples-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength-on-the-saturated-63-m-field> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nonlinear dominant wavelength on the saturated 63 µm field = 73.6621 µm" ;
        dct:description "nonlinear peak is not forced equal to the linear k_c; the reference is the assigned linear wavelength" ;
        schema:measurementTechnique "argmax of the 2D power spectrum of the saturated activator, times dx with analytical λ_c fixed at 6.33e-05 m" ;
        schema:name "nonlinear dominant wavelength on the saturated 63 µm field" ;
        schema:unitText "µm" ;
        schema:value "73.6621" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength-on-the-saturated-63-m-field-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength-on-the-saturated-63-m-field-reference> a schema:PropertyValue ;
        schema:value "63.3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-specimen-spindle-aspect-ratio-height-over-width-from-the-cc-by-mould> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen spindle aspect ratio (height over width) from the CC BY mould = 1.7 aspect" ;
        dct:description "reference_value is the simulated spindle aspect, which is a different number; KS and CV are separate" ;
        schema:measurementTechnique "Otsu threshold on smoothed Sobel magnitude of fractofusus_misrai_specimen.jpg; bounding support of the core mask" ;
        schema:name "specimen spindle aspect ratio (height over width) from the CC BY mould" ;
        schema:unitText "aspect" ;
        schema:value "1.7" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-specimen-spindle-aspect-ratio-height-over-width-from-the-cc-by-mould-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-specimen-spindle-aspect-ratio-height-over-width-from-the-cc-by-mould-reference> a schema:PropertyValue ;
        schema:value "1.1062" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.3686 coherency" ;
        dct:description "KS statistic of gradient angles versus the GIF = 0.09275" ;
        schema:measurementTechnique "(λ1-λ2)/(λ1+λ2) averaged on the Sobel structure tensor of the Mistaken Point photograph" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.3686" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        schema:value "0.3605" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-subcritical-domain-ablation-final-activator-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "subcritical-domain ablation final activator std = 0.000159 concentration std" ;
        dct:description "σ(k_min) = -0.4421" ;
        schema:measurementTechnique "2 by 2 domain, both axes shorter than λ_dx, so k_min = π sits above the unstable band" ;
        schema:name "subcritical-domain ablation final activator std" ;
        schema:unitText "concentration std" ;
        schema:value "0.000159" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-subcritical-domain-ablation-final-activator-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-subcritical-domain-ablation-final-activator-std-reference> a schema:PropertyValue ;
        schema:value "0.00535" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-of-spectral-k-versus-analytical-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing dispersion Pearson r of spectral σ(k) versus analytical σ(k) = 1.0 Pearson r" ;
        dct:description "RMSE = 0.003753; linear dispersion, not a copy of the reference series" ;
        schema:measurementTechnique "k = 1..8 on a 2π ring; spectral diffusion of the linearised Schnakenberg Jacobian versus eig(J - k² D)" ;
        schema:name "Turing dispersion Pearson r of spectral σ(k) versus analytical σ(k)" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-of-spectral-k-versus-analytical-k-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-of-spectral-k-versus-analytical-k-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-fractofusus-misrai-turing-wavelength-s0.py L176–L190" ;
        dct:description "dispersion_fit Pearson r and RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-fractofusus-misrai-turing-wavelength-s0.py#L176-L190> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-fractofusus-misrai-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-fractofusus-misrai-turing-wavelength-s0.py L326–L368" ;
        dct:description "Otsu spindle metrics and KS on gradient angles" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-fractofusus-misrai-turing-wavelength-s0.py#L326-L368> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second provider)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/nature14646>,
            <https://doi.org/10.1073/pnas.1408542111>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1139/e07-003> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1038/nature14646> dct:date "2015"^^xsd:gYear ;
        dct:title "Reconstructing the reproductive mode of an Ediacaran macro-organism" .
    <https://doi.org/10.1073/pnas.1408542111> dct:date "2014"^^xsd:gYear ;
        dct:title "Fractal branching organizations of Ediacaran rangeomorph fronds reveal a lost Proterozoic body plan" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1139/e07-003> dct:date "2007"^^xsd:gYear ;
        dct:title "Spindle-shaped Ediacara fossils from the Mistaken Point assemblage, Avalon Zone, Newfoundland" .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-farhadifar-drosophila-wing-vertex-model> a pk:Claim ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model & Lewis's law epithelial packing faithfully reproduces Fruit fly (Drosophila melanogaster) 3rd-instar larval wing imaginal disc & pupal wing epithelium morphology" ;
        dct:description "The simulation script(s) 2007-farhadifar-drosophila-wing-vertex-model.py implement the cited source model as published and produce forms that match real Fruit fly (Drosophila melanogaster) 3rd-instar larval wing imaginal disc & pupal wing epithelium specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 55.2/100, audit 2026-10-19-drosophila-wing-vertex-model-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/b9976f8/2007-farhadifar-drosophila-wing-vertex-model.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/b9976f8/2007-farhadifar-drosophila-wing-vertex-model.py; output: docs/media/drosophila_wing_vertex_model_comparison.png; organism: Fruit fly (Drosophila melanogaster) 3rd-instar larval wing imaginal disc & pupal wing epithelium; checkpoint commit: https://github.com/fractastical/morpholib/commit/b9976f8; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 00f70e92aaa338b22956554153bb93fbccd372cdaae2e3f47f4744bcadfffe52; artifact_sha256: ab67d29234ea2884f06a6984e932e052eff44b97176f71f3163ebf00fbc36b62" ;
        pk:derivedFromPaper <https://doi.org/10.1002/ar.1090380305>,
            <https://doi.org/10.1016/j.cub.2007.11.049>,
            <https://doi.org/10.1016/j.devcel.2005.10.016>,
            <https://doi.org/10.1038/nature05014>,
            <https://doi.org/10.1080/13642810108205772> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match> ;
        pk:weightOfEvidence "0.552"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/b9976f8/2007-farhadifar-drosophila-wing-vertex-model.py> a schema:SoftwareSourceCode ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "b9976f8" .
}


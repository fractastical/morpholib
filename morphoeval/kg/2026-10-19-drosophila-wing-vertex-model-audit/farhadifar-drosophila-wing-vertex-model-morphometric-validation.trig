sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-farhadifar-drosophila-wing-vertex-model> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model & Lewis's law epithelial packing — Morphometric validation: 54/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Computes simulated hexagonal fraction `P(6)`, mean side number `<n>`, and theoretical Lewis's law ratio for `n=6` (`measure_morphoeval`, L204-233), but does not compare simulated `P(n)` (`n=4..9`) against Farhadifar et al. (2007) Fig. 4B / Gibson et al. (2006) larval wing disc and Classen et al. (2005) pupal wing distributions via Pearson `r` / RMSE, does not compare `<A_n>/<A>` against Lewis's law across `n=4..9`, and does not segment the biological specimen micrograph to extract empirical cell areas and polygon classes." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2007-farhadifar-drosophila-wing-vertex-model.py L204–L233: Only 4 basic summary metrics without full n=4..9 P(n) or Lewis's law correlation against reference data and segmented specimen <https://github.com/fractastical/morpholib/blob/b9976f8/2007-farhadifar-drosophila-wing-vertex-model.py#L204-L233>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-euler-mean-polygon-side-number>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-lewis-law-hexagon-normalized-area>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pupal-wing-annealed-hexagonal-fraction-p6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-wing-disc-proliferating-hexagonal-fraction-p6> ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-euler-mean-polygon-side-number> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "euler_mean_polygon_side_number = 6.0 sides" ;
        schema:measurementTechnique "Mean polygon side number <n> across periodic 3-valent vertex tessellation (Euler 3-valent theorem <n>=6)" ;
        schema:name "euler_mean_polygon_side_number" ;
        schema:unitText "sides" ;
        schema:value "6.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-euler-mean-polygon-side-number-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-euler-mean-polygon-side-number-reference> a schema:PropertyValue ;
        schema:value "6.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-lewis-law-hexagon-normalized-area> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "lewis_law_hexagon_normalized_area = 1.0 normalized_area" ;
        schema:measurementTechnique "Lewis (1928) linear area-side formula <A_6>/<A> = (6 - 2)/4 = 1.0" ;
        schema:name "lewis_law_hexagon_normalized_area" ;
        schema:unitText "normalized_area" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-lewis-law-hexagon-normalized-area-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-lewis-law-hexagon-normalized-area-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pupal-wing-annealed-hexagonal-fraction-p6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pupal_wing_annealed_hexagonal_fraction_P6 = 0.7222 fraction" ;
        schema:measurementTechnique "Simulated hexagonal cell fraction P(6) in post-mitotic annealed pupal wing (Classen et al. 2005 / Farhadifar et al. 2007)" ;
        schema:name "pupal_wing_annealed_hexagonal_fraction_P6" ;
        schema:unitText "fraction" ;
        schema:value "0.7222" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pupal-wing-annealed-hexagonal-fraction-p6-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pupal-wing-annealed-hexagonal-fraction-p6-reference> a schema:PropertyValue ;
        schema:value "0.78" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-wing-disc-proliferating-hexagonal-fraction-p6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wing_disc_proliferating_hexagonal_fraction_P6 = 0.6111 fraction" ;
        schema:measurementTechnique "Simulated hexagonal cell fraction P(6) in proliferating larval wing disc (Farhadifar et al. 2007 Fig. 4B)" ;
        schema:name "wing_disc_proliferating_hexagonal_fraction_P6" ;
        schema:unitText "fraction" ;
        schema:value "0.6111" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-wing-disc-proliferating-hexagonal-fraction-p6-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-wing-disc-proliferating-hexagonal-fraction-p6-reference> a schema:PropertyValue ;
        schema:value "0.455" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


            <https://doi.org/10.1038/nature05014>,
            <https://doi.org/10.1080/13642810108205772> .
    <https://doi.org/10.1002/ar.1090380305> dct:date "1928"^^xsd:gYear ;
        dct:title "The correlation between cell division and the shapes and sizes of prismatic cells in the epidermis of Cucumis" .
    <https://doi.org/10.1016/j.cub.2007.11.049> dct:date "2007"^^xsd:gYear ;
        dct:title "The influence of cell mechanics, cell-cell interactions, and proliferation on epithelial packing" .
    <https://doi.org/10.1016/j.devcel.2005.10.016> dct:date "2005"^^xsd:gYear ;
        dct:title "Hexagonal packing of Drosophila wing epithelial cells by the planar cell polarity pathway" .
    <https://doi.org/10.1038/nature05014> dct:date "2006"^^xsd:gYear ;
        dct:title "The emergence of geometric order in proliferating metazoan epithelia" .
    <https://doi.org/10.1080/13642810108205772> dct:date "2001"^^xsd:gYear ;
        dct:title "A dynamic cell model for the formation of epithelial tissues" .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-farhadifar-drosophila-wing-vertex-model> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model & Lewis's law epithelial packing — Model fidelity to source: 68/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates the Farhadifar et al. (2007) Eq. (1)-(2) dimensionless single-cell apical energy (`compute_single_cell_vertex_energy`, L32-52) and Lewis's Law (1928) linear area-side scaling (`lewis_law_ratio`, L55-57), and contrasts proliferating wing disc division disorder against post-mitotic pupal annealing (`simulate_vertex_packing_v1`, L85-150). However, v1 uses centroidal Voronoi relaxation rather than explicit tri-cellular vertex force gradients `-dE/dr_i` with T1 topological edge swaps, omits Case I / II / III ground-state phase boundaries (`Lambda_bar_c(Gamma_bar)`), and omits UV laser ablation junction recoil simulation (Farhadifar et al. 2007 Fig. 4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2007-farhadifar-drosophila-wing-vertex-model.py L85–L150: Uses centroidal Voronoi relaxation without explicit vertex gradient forces, Case I/II/III phase diagram, or laser ablation recoil <https://github.com/fractastical/morpholib/blob/b9976f8/2007-farhadifar-drosophila-wing-vertex-model.py#L85-L150>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity-1> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L32–L52" ;
        dct:description "Dimensionless Farhadifar et al. (2007) Eq. 1-2 single-cell energy functional" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/2007-farhadifar-drosophila-wing-vertex-model.py#L32-L52> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


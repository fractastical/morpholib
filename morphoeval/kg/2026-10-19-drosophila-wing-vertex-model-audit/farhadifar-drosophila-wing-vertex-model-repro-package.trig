sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-farhadifar-drosophila-wing-vertex-model> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model & Lewis's law epithelial packing — Reproducibility package: 69/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Uses deterministic `np.random.default_rng(2007)` and provides `--self-test` and `measure_morphoeval()` (L204-240), but `self_test()` checks only 2 basic assertions without SHA-256 dataset verification, Case I/II/III ground-state parity, or two-run bitwise determinism checks." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2007-farhadifar-drosophila-wing-vertex-model.py L236–L241: Minimal 2-check self_test() without SHA-256 verification or determinism check <https://github.com/fractastical/morpholib/blob/b9976f8/2007-farhadifar-drosophila-wing-vertex-model.py#L236-L241>" ;
        pk:hasScore "0.69"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


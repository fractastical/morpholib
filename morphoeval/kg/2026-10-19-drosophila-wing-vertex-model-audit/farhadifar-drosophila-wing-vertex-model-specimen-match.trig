sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-farhadifar-drosophila-wing-vertex-model> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model & Lewis's law epithelial packing — Morphological realism / specimen match: 35/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Although `datasets/drosophila_wing_vertex_model/drosophila_wing_epithelium_specimen.jpg` is vendored in the repository, the v1 script never loads, verifies, or segments the apical junction-stained epithelial micrograph (`render_outputs_v1`, L153-201) and renders only a 3-panel synthetic plot." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2007-farhadifar-drosophila-wing-vertex-model.py L153–L201: render_outputs_v1 renders 3 synthetic panels without loading or segmenting drosophila_wing_epithelium_specimen.jpg <https://github.com/fractastical/morpholib/blob/b9976f8/2007-farhadifar-drosophila-wing-vertex-model.py#L153-L201>",
            "docs/media/drosophila_wing_vertex_model_comparison.png (generated output, not in repo): 3-panel synthetic figure lacking biological specimen segmentation overlay or empirical polygon distribution match — docs/media/drosophila_wing_vertex_model_comparison.png: rendered output of 2007-farhadifar-drosophila-wing-vertex-model.py at b9976f8, image/png, 209107 B, 1890×588 px, artifact_sha256 ab67d29234ea2884f06a6984e932e052eff44b97176f71f3163ebf00fbc36b62 (sha256 ab67d29234ea2884f06a6984e932e052eff44b97176f71f3163ebf00fbc36b62), spec_fingerprint 00f70e92aaa338b22956554153bb93fbccd372cdaae2e3f47f4744bcadfffe52" ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


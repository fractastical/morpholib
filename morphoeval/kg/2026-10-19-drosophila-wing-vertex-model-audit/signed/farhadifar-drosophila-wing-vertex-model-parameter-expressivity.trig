sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-farhadifar-drosophila-wing-vertex-model> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model & Lewis's law epithelial packing — Parameter expressivity: 46/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Simulates only a single parameter point `(Lambda_bar=0.12, Gamma_bar=0.04)` in two states (`proliferating=True/False`) without mapping the 2D `(Lambda_bar, Gamma_bar)` ground-state phase diagram across Cases I, II, and III, without a continuous sweep across `Lambda_bar` or `Gamma_bar`, and without CLI flags for `--lambda-bar`, `--gamma-bar`, `--K`, `--A0`, or `--steps` (L243-252)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2007-farhadifar-drosophila-wing-vertex-model.py L156–L157: Only one parameter point (Lambda_bar=0.12, Gamma_bar=0.04) evaluated in v1 <https://github.com/fractastical/morpholib/blob/b9976f8/2007-farhadifar-drosophila-wing-vertex-model.py#L156-L157>",
            "2007-farhadifar-drosophila-wing-vertex-model.py L243–L252: CLI parser only accepts --self-test <https://github.com/fractastical/morpholib/blob/b9976f8/2007-farhadifar-drosophila-wing-vertex-model.py#L243-L252>" ;
        pk:hasScore "0.46"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


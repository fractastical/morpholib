sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-054> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-054-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-054-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Figs. 388-393: Archaeopteryx -> Apatornis pelvis by equidistant coordinate-grid interpolation — Morphological realism / specimen match: 78/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Predicted stages are overlaid on Heilmann's drawn stages at form scale (15-panel figure: Figs. 388/389, segmented Fig. 393, three overlays with the fold-free grid, controls), and the correspondence-free IoU quantifies the visual match (0.57-0.68 vs 0.44-0.63 for the endpoint null). The real Berlin Archaeopteryx photograph is now analysed (bone/matrix mask) but, as the audit must say, it contributes nothing to the pelvis comparison because the pelvis is disarticulated; Apatornis is still a synsacrum plate. The dense prediction shows fold wiggles on the thin pubis, visible in the overlays." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "thompson/claims/t1917-054_on-the-theory-of-transformations.py L554–L579: segment_specimen_bone: Berlin specimen mask is descriptive only; no pelvis outline obtainable <https://github.com/fractastical/morpholib/blob/7a7c0f5b6/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L554-L579>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-specimen-match-2> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_054_on_the_theory_of_transformatio_comparison.png (generated output)" ;
        dct:description "15 panels: source figures, segmented Fig. 393, three predicted-vs-drawn overlays, t*/Procrustes/IoU, null histogram, no-fold curves, descriptors, specimen mask — docs/media/t1917_054_on_the_theory_of_transformatio_comparison.png: rendered output of thompson/claims/t1917-054_on-the-theory-of-transformations.py at 7a7c0f5b6, image/png, 1061469 B, 2200×1350 px, artifact_sha256 a30bd5dd44fca70310c403159b0b7fe6a6aac573b8c9c82afc5364edd5894b2d (sha256 a30bd5dd44fca70310c403159b0b7fe6a6aac573b8c9c82afc5364edd5894b2d), spec_fingerprint 2777b4737ea8977ede0d810eac8e3fa1010e0a04c769590e31a7cb66eaa76bf4" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-054_on-the-theory-of-transformations.py L814–L836" ;
        dct:description "stage overlays: dense prediction, coarse-grid prediction and drawn stage superimposed by similarity, axes at form scale" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7a7c0f5b6/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L814-L836> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 2; second assessor pending)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1007/BF02291478>,
            <https://doi.org/10.1109/34.24792>,
            <https://doi.org/10.1111/jeb.13256>,
            <https://doi.org/10.1206/0003-0090(2004)286%3C0001:MPTASO%3E2.0.CO;2> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form (Ch. XVII, On the Theory of Transformations, or the Comparison of Related Forms, pp. 757-759, Figs. 388-393)" .
    <https://doi.org/10.1007/BF02291478> dct:date "1975"^^xsd:gYear ;
        dct:title "Generalized Procrustes analysis" .
    <https://doi.org/10.1109/34.24792> dct:date "1989"^^xsd:gYear ;
        dct:title "Principal warps: thin-plate splines and the decomposition of deformations" .
    <https://doi.org/10.1111/jeb.13256> dct:date "2018"^^xsd:gYear ;
        dct:title "Pelvis morphology suggests that early Mesozoic birds were too heavy to contact incubate their eggs" .
    <https://doi.org/10.1206/0003-0090(2004)286%3C0001:MPTASO%3E2.0.CO;2> dct:date "2004"^^xsd:gYear ;
        dct:title "Morphology, phylogenetic taxonomy, and systematics of Ichthyornis and Apatornis (Avialae: Ornithurae)" .
}


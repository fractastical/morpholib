sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-054> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-054-model-fidelity> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-054-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Figs. 388-393: Archaeopteryx -> Apatornis pelvis by equidistant coordinate-grid interpolation — Model fidelity to source: 86/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "E2/E6, E4, E5 and E7 are implemented as stated and mirrored by 11 Lean theorems; Pass 2 adds the numerical E1 check (min det D phi_t over the 9 x 8 grid and inside the form at 21 stages) that Lean states in 1-D, plus the coarse 9-anchor grid that realises Thompson's actual construction (few anchors, smooth grid, fold-free) beside the dense semilandmark spline. Remaining deduction: Fig. 389's drawn grid is still not digitised line by line, so phi is reconstructed from the silhouettes rather than read off the plate." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-054_on-the-theory-of-transformations.py L582–L600: phi fitted on silhouette configurations, not on Thompson's drawn grid lines <https://github.com/fractastical/morpholib/blob/7a7c0f5b6/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L582-L600>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-model-fidelity-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-054_on-the-theory-of-transformations.py L322–L376" ;
        dcterms:description "tps_fit/tps_apply (E4), affine_fit/affine_interp_matrix (E5), interp_stage (E2/E6), best_fit_t (E7)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7a7c0f5b6/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L322-L376> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-054_on-the-theory-of-transformations.py L483–L514" ;
        dcterms:description "jacobian_min_det / check_no_fold (E1 at every stage) and sparse_anchor_rows (9-anchor Thompson-like grid)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7a7c0f5b6/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L483-L514> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_054.lean L24–L180" ;
        dcterms:description "interp4, interpDet; 11 theorems incl. interp_no_fold, best_fit_stage_sound; Lean 4.35.0, 0 sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7a7c0f5b6/morphoeval/lean/loops/Thompson1917_T1917_054.lean#L24-L180> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 2; second assessor pending)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}

sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1007/BF02291478>,
            <https://doi.org/10.1109/34.24792>,
            <https://doi.org/10.1111/jeb.13256>,
            <https://doi.org/10.1206/0003-0090(2004)286%3C0001:MPTASO%3E2.0.CO;2> .

    <https://archive.org/details/ongrowthform1917thom> dcterms:date "1917"^^xsd:gYear ;
        dcterms:title "On Growth and Form (Ch. XVII, On the Theory of Transformations, or the Comparison of Related Forms, pp. 757-759, Figs. 388-393)" .

    <https://doi.org/10.1007/BF02291478> dcterms:date "1975"^^xsd:gYear ;
        dcterms:title "Generalized Procrustes analysis" .

    <https://doi.org/10.1109/34.24792> dcterms:date "1989"^^xsd:gYear ;
        dcterms:title "Principal warps: thin-plate splines and the decomposition of deformations" .

    <https://doi.org/10.1111/jeb.13256> dcterms:date "2018"^^xsd:gYear ;
        dcterms:title "Pelvis morphology suggests that early Mesozoic birds were too heavy to contact incubate their eggs" .

    <https://doi.org/10.1206/0003-0090(2004)286%3C0001:MPTASO%3E2.0.CO;2> dcterms:date "2004"^^xsd:gYear ;
        dcterms:title "Morphology, phylogenetic taxonomy, and systematics of Ichthyornis and Apatornis (Avialae: Ornithurae)" .
}


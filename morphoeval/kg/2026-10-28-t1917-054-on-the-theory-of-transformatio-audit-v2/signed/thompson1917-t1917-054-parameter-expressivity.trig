    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 2; second assessor pending)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-054-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Figs. 388-393: Archaeopteryx -> Apatornis pelvis by equidistant coordinate-grid interpolation — Parameter expressivity: 80/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "t moves the form monotonically (GIF; pubis angle 131 -> 162 deg; t* strictly increasing); the sweep over 6 semilandmark densities x 4 lambdas is run and reported (t* SD <= 0.003; prediction/endpoint ratio 0.51 -> 0.91 as lambda grows, i.e. lambda visibly trades endpoint fidelity for smoothness); three transformation families (dense TPS, coarse 9-anchor TPS, affine) are compared at every stage. Deduction: the anchor set of the coarse grid (9) is fixed, not swept." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "thompson/claims/t1917-054_on-the-theory-of-transformations.py L511–L514: coarse-grid anchor count fixed at 9 <https://github.com/fractastical/morpholib/blob/7a7c0f5b6/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L511-L514>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-parameter-expressivity-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


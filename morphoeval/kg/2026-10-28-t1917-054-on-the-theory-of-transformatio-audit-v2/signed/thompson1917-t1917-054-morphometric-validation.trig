sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-054> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-054-morphometric-validation> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-archaeopteryx-apatornis-full-procrustes-distance-fig-393-endpoints> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Archaeopteryx -> Apatornis full Procrustes distance (Fig. 393 endpoints) = 0.5827 Procrustes distance" ;
        schema:measurementTechnique "GPA of acetabulum + 4 x 24 semilandmarks, unit centroid size" ;
        schema:name "Archaeopteryx -> Apatornis full Procrustes distance (Fig. 393 endpoints)" ;
        schema:unitText "Procrustes distance" ;
        schema:value "0.5827" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-heilmann-s-first-intermediate-fig-391> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "best-fit stage t* of Heilmann's first intermediate (Fig. 391) = 0.2627 t (0 = Archaeopteryx, 1 = Apatornis)" ;
        dcterms:description "sweep over 24 settings: mean 0.260 ± SD 0.003 (CV 0.010)" ;
        schema:measurementTechnique "E7 least-squares projection of the GPA-aligned drawn stage onto the Archaeopteryx->Apatornis segment" ;
        schema:name "best-fit stage t* of Heilmann's first intermediate (Fig. 391)" ;
        schema:unitText "t (0 = Archaeopteryx, 1 = Apatornis)" ;
        schema:value "0.2627" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-heilmann-s-first-intermediate-fig-391-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-heilmann-s-first-intermediate-fig-391-reference> a schema:PropertyValue ;
        dcterms:source "Thompson 1917 p. 759: 'three intermediate and equidistant co-ordinate systems'" ;
        schema:value "0.25" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-the-second-intermediate-fig-392-top> a schema:PropertyValue,
            pk:EvidenceItem ;

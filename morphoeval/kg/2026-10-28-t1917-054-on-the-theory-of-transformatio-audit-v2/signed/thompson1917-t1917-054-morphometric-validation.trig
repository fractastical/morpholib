    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-054-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Figs. 388-393: Archaeopteryx -> Apatornis pelvis by equidistant coordinate-grid interpolation — Morphometric validation: 86/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Quantitative morphometrics on the output are compared against the source's claim with explicit nulls and uncertainty: t* vs nominal with sweep SD; Procrustes, IoU, boundary RMSE, Pearson r and RMSE vs three controls; KS test of residual distributions (p <= 5.5e-6); 3! pairing permutation (nominal best, p = 1/6 floor); exact correspondence-shift null (95 shifts, p = 0.0104, z = -4.4). measure_morphoeval() exposes 11 measurements, 8 with reference values. Deductions: the permutation test has only 6 arrangements; no literature morphometrics of real intermediate taxa exist in the pinned data (part B)." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-054/result.json (generated output, not in repo): part B recorded as untestable; Dryad k1v34cf DATASET_MISMATCH block — datasets/thompson_1917/t1917-054/result.json: rendered output of thompson/claims/t1917-054_on-the-theory-of-transformations.py at 7a7c0f5b6, application/json, 16321 B, artifact_sha256 2a03419b94cc0dcb4da4cc17a55affffa7098b5cc24fd2338149a48aa2a543d2 (sha256 2a03419b94cc0dcb4da4cc17a55affffa7098b5cc24fd2338149a48aa2a543d2), spec_fingerprint 2777b4737ea8977ede0d810eac8e3fa1010e0a04c769590e31a7cb66eaa76bf4" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-archaeopteryx-apatornis-full-procrustes-distance-fig-393-endpoints>,

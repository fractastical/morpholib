        rdfs:label "pubis angle to ilium axis along the series (A, 1, 2, 3, B) = [131.3, 140.7, 143.2, 153.3, 162.2] deg" ;
        schema:measurementTechnique "angle between acetabulum->pubis tip and anterior->posterior ilium tip vectors, per segmented form" ;

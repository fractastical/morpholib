        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-the-second-intermediate-fig-392-top-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-the-second-intermediate-fig-392-top-reference> a schema:PropertyValue ;
        dcterms:source "Thompson 1917 p. 759" ;
        schema:value "0.5" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-the-third-intermediate-fig-392-bottom> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "best-fit stage t* of the third intermediate (Fig. 392 bottom) = 0.8235 t" ;
        dcterms:description "sweep mean 0.824 ± SD 0.002 (CV 0.002)" ;

sub1:provenance {
    <https://archive.org/details/ongrowthform1917thom> dcterms:date "1917"^^xsd:gYear ;
        dcterms:title "On Growth and Form (Ch. XVII, On the Theory of Transformations, or the Comparison of Related Forms, pp. 757-759, Figs. 388-393)" .


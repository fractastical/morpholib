        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-the-third-intermediate-fig-392-bottom-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-the-third-intermediate-fig-392-bottom-reference> a schema:PropertyValue ;
        dcterms:source "Thompson 1917 p. 759" ;
        schema:value "0.75" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-centroid-size-of-the-five-drawn-forms> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "centroid size of the five drawn forms = [2190.4, 2171.0, 2157.9, 2308.8, 2324.5] px (page scan)" ;
        dcterms:description "not monotone: Heilmann's Fig. 393 series is not drawn to the interpolated grid's scale" ;
        schema:measurementTechnique "sqrt of summed squared deviations from centroid of the landmark configuration" ;
        schema:name "centroid size of the five drawn forms" ;
        schema:unitText "px (page scan)" ;
        schema:value "[2190.4, 2171.0, 2157.9, 2308.8, 2324.5]" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-max-equidistance-residual-t-k-4-over-the-three-stages> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "max equidistance residual |t* - k/4| over the three stages = 0.0735 t units" ;
        dcterms:description "mean residual 0.0384; d(A,B) = 0.5827 so one stage = 0.1457 Procrustes units; pairing permutation p = 0.167" ;
        schema:measurementTechnique "max over k of |t*_k - k/4|" ;
        schema:name "max equidistance residual |t* - k/4| over the three stages" ;
        schema:unitText "t units" ;
        schema:value "0.0735" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-max-equidistance-residual-t-k-4-over-the-three-stages-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-max-equidistance-residual-t-k-4-over-the-three-stages-reference> a schema:PropertyValue ;
        dcterms:source "exact equidistance (Lean: interp_endpoints_and_equidistant)" ;
        schema:value "0.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-mean-full-procrustes-distance-dense-interpolation-vs-drawn-intermediate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "mean full Procrustes distance, dense interpolation vs drawn intermediate = 0.116 Procrustes distance" ;
        dcterms:description "ratio vs endpoint control 0.519 (sweep range 0.511-0.914); affine interpolation 0.2181; 9-anchor coarse grid 0.1938; correspondence-shift null p = 0.0104, z = -4.4" ;
        schema:measurementTechnique "E2/E4: TPS phi_t applied to the Archaeopteryx configuration, full Procrustes fit onto the drawn stage, mean over stages 1-3" ;
        schema:name "mean full Procrustes distance, dense interpolation vs drawn intermediate" ;
        schema:unitText "Procrustes distance" ;
        schema:value "0.116" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-mean-full-procrustes-distance-dense-interpolation-vs-drawn-intermediate-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-mean-full-procrustes-distance-dense-interpolation-vs-drawn-intermediate-reference> a schema:PropertyValue ;
        dcterms:source "negative control: copy the nearest endpoint (same metric)" ;
        schema:value "0.2235" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-mean-iou-of-filled-outlines-dense-interpolation-vs-drawn-intermediate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "mean IoU of filled outlines, dense interpolation vs drawn intermediate = 0.6178 IoU (intersection/union)" ;
        dcterms:description "affine 0.546; 9-anchor coarse grid 0.587; symmetric boundary RMSE/centroid size 0.0066 vs endpoint 0.0090" ;
        schema:measurementTechnique "dense Archaeopteryx outline carried through phi_t, similarity-superimposed on the drawn stage, rasterised 400x400" ;
        schema:name "mean IoU of filled outlines, dense interpolation vs drawn intermediate" ;
        schema:unitText "IoU (intersection/union)" ;
        schema:value "0.6178" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-mean-iou-of-filled-outlines-dense-interpolation-vs-drawn-intermediate-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-mean-iou-of-filled-outlines-dense-interpolation-vs-drawn-intermediate-reference> a schema:PropertyValue ;
        dcterms:source "negative control: nearest endpoint outline (same metric)" ;
        schema:value "0.5343" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-min-det-d-phi-t-inside-the-archaeopteryx-form-9-anchor-coarse-grid-t-in-0-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "min det(D phi_t) inside the Archaeopteryx form, 9-anchor coarse grid, t in [0, 1] = 0.2341 det (1 = identity)" ;
        dcterms:description "dense semilandmark TPS folds: min det -10.36 inside the form (-41.9 on the padded 9x8 grid)" ;
        schema:measurementTechnique "central-difference Jacobian of the TPS phi_t on reference-grid points inside the dense outline, min over 21 stages" ;
        schema:name "min det(D phi_t) inside the Archaeopteryx form, 9-anchor coarse grid, t in [0, 1]" ;
        schema:unitText "det (1 = identity)" ;
        schema:value "0.2341" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-min-det-d-phi-t-inside-the-archaeopteryx-form-9-anchor-coarse-grid-t-in-0-1-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-min-det-d-phi-t-inside-the-archaeopteryx-form-9-anchor-coarse-grid-t-in-0-1-reference> a schema:PropertyValue ;
        dcterms:source "E1 / Lean interp_no_fold: a valid grid needs det > 0 at every stage" ;
        schema:value "0.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-pearson-r-predicted-vs-drawn-landmark-coordinates-mean-over-stages-1-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pearson r, predicted vs drawn landmark coordinates (mean over stages 1-3) = 0.9931 r" ;
        dcterms:description "RMSE/centroid size 0.0118 vs endpoint 0.0227; KS (pred residuals < endpoint residuals) p = 5.5e-06, 1.1e-22, 3.0e-09" ;
        schema:measurementTechnique "corrcoef of flattened Procrustes-aligned coordinates" ;
        schema:name "Pearson r, predicted vs drawn landmark coordinates (mean over stages 1-3)" ;
        schema:unitText "r" ;
        schema:value "0.9931" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-pearson-r-predicted-vs-drawn-landmark-coordinates-mean-over-stages-1-3-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-pearson-r-predicted-vs-drawn-landmark-coordinates-mean-over-stages-1-3-reference> a schema:PropertyValue ;
        dcterms:source "nearest-endpoint control" ;
        schema:value "0.9722" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-pubis-angle-to-ilium-axis-along-the-series-a-1-2-3-b> a schema:PropertyValue,

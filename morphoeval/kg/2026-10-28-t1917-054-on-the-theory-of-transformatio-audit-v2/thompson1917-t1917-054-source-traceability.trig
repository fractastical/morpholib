    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form (Ch. XVII, On the Theory of Transformations, or the Comparison of Related Forms, pp. 757-759, Figs. 388-393)" .
    <https://doi.org/10.1007/BF02291478> dct:date "1975"^^xsd:gYear ;
        dct:title "Generalized Procrustes analysis" .
    <https://doi.org/10.1109/34.24792> dct:date "1989"^^xsd:gYear ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nakamasu-zebrafish-three-cell-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Nakamasu et al. (2009) 3-variable zebrafish pigment-cell reaction-diffusion network, laser-ablation polarity & leopard (cx41.8) spot-to-stripe morphospace — Morphological realism / specimen match: 28/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Although `datasets/zebrafish_three_cell_stripes/danio_rerio_specimen.jpg` is vendored in the repository, the v1 script never loads, segments, or displays the biological zebrafish photograph (`docs/media/zebrafish_three_cell_stripes_comparison.png` shows only 2 synthetic panels), and performs no quantitative comparison against Danio rerio flank inter-stripe wavelength or horizontal anisotropy." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2009-nakamasu-zebrafish-three-cell-stripes.py L82–L111: 2-panel synthetic plot without biological Danio rerio specimen panel or stripe segmentation <https://github.com/fractastical/morpholib/blob/8871db0/2009-nakamasu-zebrafish-three-cell-stripes.py#L82-L111>",
            "docs/media/zebrafish_three_cell_stripes_comparison.png (generated output, not in repo): 2-panel synthetic figure lacking Danio rerio flank stripe comparison — docs/media/zebrafish_three_cell_stripes_comparison.png: rendered output of 2009-nakamasu-zebrafish-three-cell-stripes.py at 8871db0, image/png, 71468 B, 1287×506 px, artifact_sha256 7e46a54e2f714ffd53caae044f5a706fdcb564aaf6b81e0178f41774fbd69538 (sha256 7e46a54e2f714ffd53caae044f5a706fdcb564aaf6b81e0178f41774fbd69538), spec_fingerprint e325ab05dbc489df59ad15e0ad7e5ce094c3a9ea9e524b654d3adbb036c29214" ;
        pk:hasScore "0.28"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 007 autonomous loop assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


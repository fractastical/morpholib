sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nakamasu-zebrafish-three-cell-stripes> a pk:Claim ;
        rdfs:label "Nakamasu et al. (2009) 3-variable zebrafish pigment-cell reaction-diffusion network, laser-ablation polarity & leopard (cx41.8) spot-to-stripe morphospace faithfully reproduces Zebrafish (Danio rerio) melanophore-xanthophore-iridophore flank stripes morphology" ;
        dcterms:description "The simulation script(s) 2009-nakamasu-zebrafish-three-cell-stripes.py implement the cited source model as published and produce forms that match real Zebrafish (Danio rerio) melanophore-xanthophore-iridophore flank stripes specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 47.4/100, audit 2026-10-19-zebrafish-three-cell-stripes-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/8871db0/2009-nakamasu-zebrafish-three-cell-stripes.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2009-nakamasu-zebrafish-three-cell-stripes.py; output: docs/media/zebrafish_three_cell_stripes_comparison.png; organism: Zebrafish (Danio rerio) melanophore-xanthophore-iridophore flank stripes; checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: e325ab05dbc489df59ad15e0ad7e5ce094c3a9ea9e524b654d3adbb036c29214; artifact_sha256: 7e46a54e2f714ffd53caae044f5a706fdcb564aaf6b81e0178f41774fbd69538; input_dataset_sha256: {datasets/zebrafish_three_cell_stripes/danio_rerio_specimen.jpg=850b2d4a94c7cbcb..., datasets/zebrafish_three_cell_stripes/scout_manifest.json=d19df92d7c80de8a..., datasets/zebrafish_three_cell_stripes/zebrafish_three_cell_stripes_reference.json=fcc1809ce2e992bc...}" ;
        pk:derivedFromPaper <https://doi.org/10.1038/sj.embor.7400757>,
            <https://doi.org/10.1073/pnas.0607790104>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1126/science.1212821> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-specimen-match> ;
        pk:weightOfEvidence "0.474"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/8871db0/2009-nakamasu-zebrafish-three-cell-stripes.py> a schema:SoftwareSourceCode ;

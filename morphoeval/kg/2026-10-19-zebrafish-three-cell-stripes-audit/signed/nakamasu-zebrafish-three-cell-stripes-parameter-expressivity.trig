sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nakamasu-zebrafish-three-cell-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Nakamasu et al. (2009) 3-variable zebrafish pigment-cell reaction-diffusion network, laser-ablation polarity & leopard (cx41.8) spot-to-stripe morphospace — Parameter expressivity: 44/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Renders a single static cosine field without sweeping the *leopard* (cx41.8) mutant spot -> labyrinth -> wild-type guided stripe -> inverse spot morphospace (Nakamasu 2009 Fig. 5; Watanabe et al. 2006), without laser-ablation perturbations, without equal-diffusion (D_w = D_u) or mutual-repulsion ablation negative controls, and without CLI flags for kinetic or diffusive parameters (L139-145)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2009-nakamasu-zebrafish-three-cell-stripes.py L139–L145: CLI exposes only --self-test <https://github.com/fractastical/morpholib/blob/8871db0/2009-nakamasu-zebrafish-three-cell-stripes.py#L139-L145>",
            "2009-nakamasu-zebrafish-three-cell-stripes.py L82–L98: Single static synthetic pattern without leopard morphospace sweep or negative controls <https://github.com/fractastical/morpholib/blob/8871db0/2009-nakamasu-zebrafish-three-cell-stripes.py#L82-L98>" ;
        pk:hasScore "0.44"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 007 autonomous loop assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


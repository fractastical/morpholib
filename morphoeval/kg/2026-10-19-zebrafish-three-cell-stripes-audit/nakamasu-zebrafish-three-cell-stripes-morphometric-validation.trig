}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nakamasu-zebrafish-three-cell-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Nakamasu et al. (2009) 3-variable zebrafish pigment-cell reaction-diffusion network, laser-ablation polarity & leopard (cx41.8) spot-to-stripe morphospace — Morphometric validation: 44/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L114-135) returns only 2 analytical scalar values (k_c and lambda_c) without measuring Routh-Hurwitz invariants, 2D PDE melanophore-xanthophore anti-phase correlation, xanthophore laser-ablation melanophore survival loss, negative-control quenching, or biological Danio rerio inter-stripe spacing CV and horizontal orientation anisotropy." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2009-nakamasu-zebrafish-three-cell-stripes.py L114–L135: Only 2 analytical measurements returned; no PDE, laser-ablation, or specimen morphometrics <https://github.com/fractastical/morpholib/blob/8871db0/2009-nakamasu-zebrafish-three-cell-stripes.py#L114-L135>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-nakamasu-3-cell-critical-wavenumber-k-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-nakamasu-characteristic-stripe-wavelength-lambda-c> ;
        pk:hasScore "0.44"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-nakamasu-3-cell-critical-wavenumber-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Nakamasu 3-cell critical wavenumber k_c = 3.4153 dimensionless" ;
        schema:measurementTechnique "argmax_k Re(eigvals(J0 - k^2 * diag(Du, Dv, Dw)))" ;
        schema:name "Nakamasu 3-cell critical wavenumber k_c" ;
        schema:unitText "dimensionless" ;
        schema:value "3.4153" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-nakamasu-3-cell-critical-wavenumber-k-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-nakamasu-3-cell-critical-wavenumber-k-c-reference> a schema:PropertyValue ;
        dct:source "Nakamasu et al. (2009) PNAS 106(21):8429-8434 SI Text" ;
        schema:value "3.4106" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-nakamasu-characteristic-stripe-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Nakamasu characteristic stripe wavelength lambda_c = 1.8397 dimensionless length" ;
        schema:measurementTechnique "2 * pi / k_c" ;
        schema:name "Nakamasu characteristic stripe wavelength lambda_c" ;
        schema:unitText "dimensionless length" ;
        schema:value "1.8397" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-nakamasu-characteristic-stripe-wavelength-lambda-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-nakamasu-characteristic-stripe-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Nakamasu et al. (2009) PNAS 106(21):8429-8434 Fig. 5" ;
        schema:value "1.8423" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 007 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


        "2009-nakamasu-zebrafish-three-cell-stripes.py L82–L98: Single static synthetic pattern without leopard morphospace sweep or negative controls <https://github.com/fractastical/morpholib/blob/8871db0/2009-nakamasu-zebrafish-three-cell-stripes.py#L82-L98>" ;
    pk:hasScore 4.4e-01 ;
    pk:hasVerdict "partially faithful" .


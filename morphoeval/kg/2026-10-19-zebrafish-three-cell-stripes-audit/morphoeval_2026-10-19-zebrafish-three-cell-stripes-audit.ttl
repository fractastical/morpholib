    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-nakamasu-3-cell-critical-wavenumber-k-c>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-nakamasu-characteristic-stripe-wavelength-lambda-c> ;

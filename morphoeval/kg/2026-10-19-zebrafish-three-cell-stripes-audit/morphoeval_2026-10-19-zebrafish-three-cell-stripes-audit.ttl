<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/nakamasu-zebrafish-three-cell-stripes-1>,
        <https://w3id.org/probknow/resource/math-law/nakamasu-zebrafish-three-cell-stripes-2>,
        <https://w3id.org/probknow/resource/math-law/nakamasu-zebrafish-three-cell-stripes-3> .

<https://w3id.org/probknow/resource/math-law/nakamasu-zebrafish-three-cell-stripes-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Nakamasu (2009) Short-Range Melanophore-Xanthophore Mutual Repulsion Saddle Instability" ;
    dct:description "Proves that two mutually repressing pigment cell populations form an effective local positive-feedback switch (det J_uv = -1.61 < 0, lambda_anti = +0.70 > 0) without requiring direct single-cell autocatalysis | Variables: u: melanophore density; v: xanthophore density; c_u, c_v: intrinsic clearance rates; b_u = -r_u < 0, a_v = -r_v < 0: short-range contact-mediated mutual repression rates" ;
    dct:source "Nakamasu et al. (2009) PNAS 106(21):8429-8434 Fig. 4D & SI Text Eqs. (1)-(6)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2009-nakamasu-zebrafish-three-cell-stripes.py#L112-L195>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_007_zebrafish_three_cell_stripes.lean#L19-L47> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def short_range_det_uv (cu cv ru rv : Int) : Int := cu * cv - ru * rv
def anti_phase_growth_rate (cu ru : Int) : Int := ru - cu
theorem nakamasu_short_range_mutual_repulsion_instability (cu cv : Int)
    (hcu : cu ≥ 1) (hcv : cv ≥ 1) :
    short_range_det_uv cu cv 0 0 ≥ 1 ∧
    short_range_det_uv 8 8 15 15 = -161 ∧
    anti_phase_growth_rate 8 15 = 7 := by
  unfold short_range_det_uv anti_phase_growth_rate
  refine ⟨?_, by decide, by decide⟩
  have h1 : (1 : Int) * 1 ≤ cu * cv := Int.mul_le_mul hcu hcv (by decide) (by omega)
  omega
"""^^pk:lean4 ;
    skos:notation "det(J_{uv}) = c_u c_v - b_u a_v < 0  ∧  λ_{anti} = |b_u| - c_u > 0  when  |b_u|, |a_v| > c_u, c_v" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/sj.embor.7400757>,
        <https://doi.org/10.1073/pnas.0607790104>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1126/science.1212821> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Cell-Cell Contact Reaction-Diffusion" ;
    pk:leanDeclaration "MathOfBiology.Loop_007.short_range_det_uv" ;
    pk:leanTheorem "MathOfBiology.Loop_007.nakamasu_short_range_mutual_repulsion_instability" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/nakamasu-zebrafish-three-cell-stripes-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Long-Range Xanthophore->Melanophore Survival Factor Routh-Hurwitz Homogeneous Stabilization" ;
    dct:description "Proves that the long-range xanthophore-to-melanophore survival pathway v -> w -> u stabilizes the homogeneous 3-cell equilibrium at k = 0 despite the local (u, v) saddle instability | Variables: w: long-range diffusible factor secreted by xanthophores (b_w = 1.20 > 0) promoting melanophore survival (d_u = 1.20 > 0); p_1, p_2, p_3: Routh-Hurwitz cubic coefficients of J_0" ;
    dct:source "Nakamasu et al. (2009) PNAS 106(21):8429-8434 Figs. 2, 4D & SI Text" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2009-nakamasu-zebrafish-three-cell-stripes.py#L125-L210>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_007_zebrafish_three_cell_stripes.lean#L54-L78> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """theorem nakamasu_long_range_factor_routh_hurwitz_stabilization :
    routh_hurwitz_p1 8 8 9 = 25 ∧
    routh_hurwitz_p2 8 8 9 (-15) 12 (-15) (-6) (-9) 12 = 163 ∧
    routh_hurwitz_p3 8 8 9 (-15) 12 (-15) (-6) (-9) 12 = 2961 ∧
    (routh_hurwitz_p1 8 8 9) * (routh_hurwitz_p2 8 8 9 (-15) 12 (-15) (-6) (-9) 12)
      - (routh_hurwitz_p3 8 8 9 (-15) 12 (-15) (-6) (-9) 12) = 1114 := by decide
"""^^pk:lean4 ;
    skos:notation "p_1 = -tr(J_0) = 2.50 > 0,  p_2 = 1.63 > 0,  p_3 = -det(J_0) = 2.961 > 0,  p_1 p_2 - p_3 = 1.114 > 0  ⟹  Re λ(J_0) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/sj.embor.7400757>,
        <https://doi.org/10.1073/pnas.0607790104>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1126/science.1212821> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Cell-Cell Contact Reaction-Diffusion" ;
    pk:leanDeclaration "MathOfBiology.Loop_007.routh_hurwitz_p3" ;
    pk:leanTheorem "MathOfBiology.Loop_007.nakamasu_long_range_factor_routh_hurwitz_stabilization" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/nakamasu-zebrafish-three-cell-stripes-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Fast-Diffusing Long-Range Factor (D_w ≫ D_u, D_v) Bounded Turing Stripe Instability Theorem" ;
    dct:description "Proves that differential long-range signaling range D_w / D_u = 25 opens a finite stationary Turing band around k_c = 3.4106 (lambda_c = 1.8423), while equal diffusion quenches pattern formation | Variables: q = k^2: squared spatial wavenumber; D_u = D_v = 0.02: short-range pigment cell motility/projection scale; D_w = 0.50: long-range factor diffusivity" ;
    dct:source "Nakamasu et al. (2009) PNAS 106(21):8429-8434 Fig. 5 & SI Text" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2009-nakamasu-zebrafish-three-cell-stripes.py#L155-L235>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_007_zebrafish_three_cell_stripes.lean#L85-L120> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """theorem nakamasu_diffusive_turing_band_and_ablation_collapse :
    p3_dispersive 0 2 2 50 = 2961000 ∧
    p3_dispersive 12 2 2 50 = -3219960 ∧
    p3_dispersive 35 2 2 50 = 5670000 ∧
    p3_dispersive 12 2 2 2 = 3510024 := by decide
"""^^pk:lean4 ;
    skos:notation "p_3(q) = -det(J_0 - q D) < 0  for  q = k^2 ∈ (4.4663, 28.8036)  at  D_w / D_u = 25,  whereas  p_3(q) > 0  for all  q ≥ 0  at  D_w = D_u = D_v" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/sj.embor.7400757>,
        <https://doi.org/10.1073/pnas.0607790104>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1126/science.1212821> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Cell-Cell Contact Reaction-Diffusion" ;
    pk:leanDeclaration "MathOfBiology.Loop_007.p3_dispersive" ;
    pk:leanTheorem "MathOfBiology.Loop_007.nakamasu_diffusive_turing_band_and_ablation_collapse" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


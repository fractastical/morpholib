sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pezzulo-bioelectric-target-morphology-memory> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-ambystoma-mexicanum-specimen-vs-simulated-regenerated-forelimb-width-profile-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Ambystoma mexicanum specimen vs simulated regenerated forelimb width profile correlation r = 0.8711 Pearson r" ;
        dcterms:description "forelimb width Pearson r = 0.8711, width RMSE = 0.1240, segment proportion RMSE = 0.0889 (limb length = 269.6 px)" ;
        schema:measurementTechnique "Pearson correlation and RMSE between segmented Ambystoma mexicanum right forelimb width profile W(s/L) and reconstructed 3-segment limb silhouette across 40 proximodistal bins" ;
        schema:name "Ambystoma mexicanum specimen vs simulated regenerated forelimb width profile correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.8711" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-ambystoma-mexicanum-specimen-vs-simulated-regenerated-forelimb-width-profile-correlation-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-ambystoma-mexicanum-specimen-vs-simulated-regenerated-forelimb-width-profile-correlation-r-reference> a schema:PropertyValue ;
        dcterms:source "Vendored Ambystoma mexicanum specimen (CC BY-SA 3.0, File:Ambystoma mexicanum 1.jpg) articulated right forelimb (stylopod:zeugopod:autopod = 0.50:0.29:0.21)" ;
        schema:value "0.9" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-farinella-ferruzza-ectopic-tail-to-limb-graft-identity-remodeling-delta> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Farinella-Ferruzza ectopic tail-to-limb graft identity remodeling delta = 2.0 psi_final - psi_0" ;
        dcterms:description "psi_0 = -1.00 -> psi_final = 1.0000, regenerated limb length L = 1.0000, final free energy F = 0.000000" ;
        schema:measurementTechnique "Active-inference organ identity remodeling of a tail blastema (psi_0 = -1.0) grafted onto the shoulder limb field (psi_target = +1.0)" ;
        schema:name "Farinella-Ferruzza ectopic tail-to-limb graft identity remodeling delta" ;
        schema:unitText "psi_final - psi_0" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-farinella-ferruzza-ectopic-tail-to-limb-graft-identity-remodeling-delta-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-farinella-ferruzza-ectopic-tail-to-limb-graft-identity-remodeling-delta-reference> a schema:PropertyValue ;
        dcterms:source "Pezzulo & Levin (2015) J. R. Soc. Interface 12:20150772 Section 2.2 & Farinella-Ferruzza (1956) (tail blastema in limb field remodels from tail -1.0 to limb +1.0, delta = +2.0)" ;
        schema:value "2.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-pezzulo-levin-2015-5-regime-regenerated-organ-length-prediction-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pezzulo & Levin (2015) 5-regime regenerated organ length prediction RMSE = 0.0 length RMSE (L / L*)" ;
        dcterms:description "observed lengths = [1.0, 1.0, 1.0, 1.45, 0.2] vs expected = [1.0, 1.0, 1.0, 1.45, 0.2] (RMSE = 0.00000, max dF/dt = -0.0000 <= 0)" ;
        schema:measurementTechnique "RMSE between simulated and theoretical target lengths across proximal cut (1.00), distal cut (1.00), tail-to-limb remodeling (1.00), rewritten memory (1.45), and denervated arrest (0.20)" ;
        schema:name "Pezzulo & Levin (2015) 5-regime regenerated organ length prediction RMSE" ;
        schema:unitText "length RMSE (L / L*)" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-pezzulo-levin-2015-5-regime-regenerated-organ-length-prediction-rmse-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-pezzulo-levin-2015-5-regime-regenerated-organ-length-prediction-rmse-reference> a schema:PropertyValue ;
        dcterms:source "Pezzulo & Levin (2015) J. R. Soc. Interface 12:20150772 & Lean 4 theorem canonical_bioelectric_target_regimes" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-proximal-to-distal-initial-blastema-growth-velocity-ratio-v-prox-v-dist> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Proximal-to-distal initial blastema growth velocity ratio (v_prox / v_dist) = 2.6667 velocity ratio" ;
        dcterms:description "v_prox(0) = 0.7200 L*/day vs v_dist(0) = 0.2700 L*/day; velocity at target L* = -0.0000 (exact stop)" ;
        schema:measurementTechnique "Ratio of initial active-inference blastema outgrowth rate dL/dt(0) for proximal shoulder cut (deficit 0.80) vs distal wrist cut (deficit 0.30)" ;
        schema:name "Proximal-to-distal initial blastema growth velocity ratio (v_prox / v_dist)" ;
        schema:unitText "velocity ratio" ;
        schema:value "2.6667" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-proximal-to-distal-initial-blastema-growth-velocity-ratio-v-prox-v-dist-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-proximal-to-distal-initial-blastema-growth-velocity-ratio-v-prox-v-dist-reference> a schema:PropertyValue ;
        dcterms:source "Pezzulo & Levin (2015) J. R. Soc. Interface 12:20150772 Section 3 & Friston et al. (2015) Eq. (2.6) (dL/dt proportional to target error L* - L_0: 0.80 / 0.30 = 2.6667)" ;
        schema:value "2.6667" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-proximal-vs-distal-salamander-limb-regeneration-target-length-equifinality-error> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Proximal vs distal salamander limb regeneration target length & equifinality error = 1.0 L(T) / L*" ;
        dcterms:description "proximal final L = 1.0000, distal final L = 1.0000 (equifinality discrepancy |L_prox - L_dist| = 0.000000, std = 0.0001)" ;
        schema:measurementTechnique "Active-inference Variational Free Energy gradient descent from proximal shoulder cut (L_0=0.20) and distal wrist cut (L_0=0.70) to L* = 1.00" ;
        schema:name "Proximal vs distal salamander limb regeneration target length & equifinality error" ;
        schema:unitText "L(T) / L*" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-proximal-vs-distal-salamander-limb-regeneration-target-length-equifinality-error-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-proximal-vs-distal-salamander-limb-regeneration-target-length-equifinality-error-reference> a schema:PropertyValue ;
        dcterms:source "Pezzulo & Levin (2015) J. R. Soc. Interface 12:20150772 Fig. 2 & Section 3 (exact stopping at target morphology L* = 1.00 regardless of amputation level)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-rewritten-bioelectric-target-setpoint-memory-vs-denervated-pi-s-0-arrest-length-contrast> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Rewritten bioelectric target setpoint memory vs denervated (Pi_s = 0) arrest length contrast = 1.25 L_rewritten - L_denervated" ;
        dcterms:description "rewritten setpoint final L = 1.4500 (target 1.45) vs denervated Pi_s=0 final L = 0.2000 (complete arrest at stump L_0 = 0.20)" ;
        schema:measurementTechnique "Difference between regenerated limb length under rewritten bioelectric setpoint (mu_target' = 1.45) and denervated sensory-precision ablation control (Pi_s = 0, L_0 = 0.20)" ;
        schema:name "Rewritten bioelectric target setpoint memory vs denervated (Pi_s = 0) arrest length contrast" ;
        schema:unitText "L_rewritten - L_denervated" ;
        schema:value "1.25" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-rewritten-bioelectric-target-setpoint-memory-vs-denervated-pi-s-0-arrest-length-contrast-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-rewritten-bioelectric-target-setpoint-memory-vs-denervated-pi-s-0-arrest-length-contrast-reference> a schema:PropertyValue ;
        dcterms:source "Pezzulo & Levin (2015) J. R. Soc. Interface 12:20150772 Fig. 4 & Singer (1952) (rewritten target L*' = 1.45 vs denervated arrest L_0 = 0.20, delta = 1.25)" ;
        schema:value "1.25" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Pezzulo & Levin (2015) / Friston et al. (2015) bioelectric target morphology memory and Variational Free Energy homeostasis — Morphometric validation: 56/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Reports regenerated length convergence, but Pass 1 requires quantitative proximal-to-distal initial blastema velocity ratio (8/3 = 2.6667), specimen forelimb width Pearson r and segment-proportion RMSE, and 5-regime target length RMSE." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2015-pezzulo-bioelectric-target-morphology-memory.py L770–L880: MorphoEval measurement hook measure_morphoeval() <https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py#L770-L880>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-ambystoma-mexicanum-specimen-vs-simulated-regenerated-forelimb-width-profile-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-farinella-ferruzza-ectopic-tail-to-limb-graft-identity-remodeling-delta>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-pezzulo-levin-2015-5-regime-regenerated-organ-length-prediction-rmse>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-proximal-to-distal-initial-blastema-growth-velocity-ratio-v-prox-v-dist>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-proximal-vs-distal-salamander-limb-regeneration-target-length-equifinality-error>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-measurement-rewritten-bioelectric-target-setpoint-memory-vs-denervated-pi-s-0-arrest-length-contrast> ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


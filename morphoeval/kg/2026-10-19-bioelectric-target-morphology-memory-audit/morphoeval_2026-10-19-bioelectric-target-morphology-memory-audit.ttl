<https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Pezzulo & Levin (2015) / Friston et al. (2015) bioelectric target morphology memory and Variational Free Energy homeostasis — Model fidelity to source: 63/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Implements the Pezzulo & Levin (2015) and Friston et al. (2015) Variational Free Energy functional F(mu, x) = (1/2)*Pi_s*||x - mu||^2 + (1/2)*Pi_p*||mu - mu_target||^2 and coupled perception-action gradient flow (L126-198), but Pass 1 requires 3-segment proximodistal resolution (stylopod, zeugopod, autopod) and organ-identity remodeling psi(t)." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "2015-pezzulo-bioelectric-target-morphology-memory.py L204–L340: Multi-segment proximodistal limb & organ identity active-inference solver <https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py#L204-L340>" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-model-fidelity-1> ;
    pk:hasScore 6.3e-01 ;
    pk:hasVerdict "mostly faithful" .


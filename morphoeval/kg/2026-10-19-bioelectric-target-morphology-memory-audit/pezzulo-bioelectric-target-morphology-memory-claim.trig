sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pezzulo-bioelectric-target-morphology-memory> a pk:Claim ;
        rdfs:label "Pezzulo & Levin (2015) / Friston et al. (2015) bioelectric target morphology memory and Variational Free Energy homeostasis faithfully reproduces Ambystoma mexicanum (axolotl salamander) regenerating forelimb morphology" ;
        dct:description "The simulation script(s) 2015-pezzulo-bioelectric-target-morphology-memory.py implement the cited source model as published and produce forms that match real Ambystoma mexicanum (axolotl salamander) regenerating forelimb specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 59.4/100, audit 2026-10-19-bioelectric-target-morphology-memory-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py; output: docs/media/bioelectric_target_morphology_memory_comparison.png; organism: Ambystoma mexicanum (axolotl salamander) regenerating forelimb; checkpoint commit: https://github.com/fractastical/morpholib/commit/b2936f6; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 76f53df6fe2e78cfcaffeee38c874bcb67b673c1a916f9045c6a97417b660f71; artifact_sha256: e5d2033311420793acded2c7d8a60502ea97b8f28d2e3a025a7f3acb2e3825a0; input_dataset_sha256: {datasets/bioelectric_target_morphology_memory/bioelectric_target_morphology_memory_reference.json=3e8e26ed216e74ce..., datasets/bioelectric_target_morphology_memory/paper_citations.bib=4235fafcb6076581..., datasets/bioelectric_target_morphology_memory/salamander_limb_regeneration_specimen.jpg=fe57ed2c5909e7af..., datasets/bioelectric_target_morphology_memory/scout_manifest.json=7d75a04159b0641d...}" ;
        pk:derivedFromPaper <https://doi.org/10.1002/dvdy.23770>,
            <https://doi.org/10.1098/rsif.2014.1383>,
            <https://doi.org/10.1098/rsif.2015.0772>,
            <https://doi.org/10.1098/rsif.2016.0555> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-specimen-match> ;
        pk:weightOfEvidence "0.594"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py> a schema:SoftwareSourceCode ;
        rdfs:label "2015-pezzulo-bioelectric-target-morphology-memory.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "b2936f6" .
}


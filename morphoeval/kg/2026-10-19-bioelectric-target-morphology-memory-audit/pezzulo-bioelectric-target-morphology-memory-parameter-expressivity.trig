sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pezzulo-bioelectric-target-morphology-memory> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Pezzulo & Levin (2015) / Friston et al. (2015) bioelectric target morphology memory and Variational Free Energy homeostasis — Parameter expressivity: 59/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Tests proximal (L_0 = 0.20) vs distal (L_0 = 0.70) amputation equifinality, but needs the Farinella-Ferruzza tail-to-limb graft remodeling regime, rewritten bioelectric setpoint memory (mu_target' = 1.45), and Singer (1952) denervation arrest (Pi_s = 0) alongside a 2D (L_0, mu_target) morphospace phase diagram." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2015-pezzulo-bioelectric-target-morphology-memory.py L345–L435: 5-regime active-inference evaluator and 2D (L_0, mu_target) phase grid <https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py#L345-L435>" ;
        pk:hasScore "0.59"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/jonsson-auxin-pin1-meristem-1>,
        <https://w3id.org/probknow/resource/math-law/jonsson-auxin-pin1-meristem-2>,
        <https://w3id.org/probknow/resource/math-law/jonsson-auxin-pin1-meristem-3> .

<https://w3id.org/probknow/resource/math-law/jonsson-auxin-pin1-meristem-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) Up-the-Gradient Boltzmann PIN1 Allocation Law" ;
    dct:description "Directs cellular PIN1 efflux carriers preferentially toward neighboring cells with higher auxin concentration while conserving each cell's total PIN1 pool | Variables: P_i: total PIN1 pool in L1 cell i; P_ij: PIN1 allocated to anticlinal wall i→j; a_j: auxin concentration in neighbor cell j; c_1: up-the-gradient feedback exponent; w_j = exp(c_1 a_j): Boltzmann weight" ;
    dct:source "Jönsson et al. (2006) PNAS 103(5):1633-1638 Eq. 4; Smith et al. (2006) PNAS 103(5):1301-1306 Eq. 2" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py#L105-L215>,
        <https://github.com/fractastical/morpholib/blob/0cb0132/morphoeval/lean/loops/Loop_032_auxin_pin1_phyllotaxis.lean#L27-L44> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def pin1_alloc_scaled (P_i w_j : Int) : Int := P_i * w_j
def pin1_partition_sum3 (w1 w2 w3 : Int) : Int := w1 + w2 + w3
theorem jonsson_2006_up_gradient_pin1_allocation (P_i w1 w2 w3 w_j w_k : Int)
    (hP : P_i > 0) (hw : w_j > w_k) :
    pin1_alloc_scaled P_i w1 + pin1_alloc_scaled P_i w2 + pin1_alloc_scaled P_i w3 =
      P_i * pin1_partition_sum3 w1 w2 w3 ∧
    pin1_alloc_scaled P_i w_j > pin1_alloc_scaled P_i w_k
"""^^pk:lean4 ;
    skos:notation "P_ij = P_i exp(c_1 a_j) / ∑_{k∈N(i)} exp(c_1 a_k);  ∑_{j∈N(i)} P_ij = P_i;  a_j > a_k ⇒ P_ij > P_ik" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.cub.2005.09.052>,
        <https://doi.org/10.1038/nature02081>,
        <https://doi.org/10.1073/pnas.0509839103>,
        <https://doi.org/10.1073/pnas.0510457103> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Up-the-Gradient Auxin-PIN1 Polarized Transport & Turing-Like Phyllotactic Spacing" ;
    pk:leanDeclaration "MathOfBiology.Loop_032.pin1_alloc_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_032.jonsson_2006_up_gradient_pin1_allocation" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/jonsson-auxin-pin1-meristem-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Jönsson et al. (2006) Intercellular Active Polar + Diffusive Auxin Flux Conservation Law" ;
    dct:description "Guarantees exact pairwise intercellular auxin mass conservation across every shared cell wall and equilibrium stationarity at homogeneous state a_0 = ρ_0 / μ | Variables: a_i: auxin concentration in cell i; T: active PIN1 polar transport rate; D: passive apoplastic/plasmodesmatal diffusion rate; ρ_0: basal auxin synthesis rate; μ: auxin turnover rate" ;
    dct:source "Jönsson et al. (2006) PNAS 103(5):1633-1638 Eqs. 1-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py#L220-L390>,
        <https://github.com/fractastical/morpholib/blob/0cb0132/morphoeval/lean/loops/Loop_032_auxin_pin1_phyllotaxis.lean#L59-L71> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def intercellular_auxin_flux (T D P_ij P_ji a_i a_j : Int) : Int :=
  T * (P_ji * a_j - P_ij * a_i) + D * (a_j - a_i)
theorem jonsson_2006_intercellular_flux_conservation (T D P_ij P_ji P0 a_i a_j a0 : Int) :
    intercellular_auxin_flux T D P_ij P_ji a_i a_j +
      intercellular_auxin_flux T D P_ji P_ij a_j a_i = 0 ∧
    intercellular_auxin_flux T D P0 P0 a0 a0 = 0
"""^^pk:lean4 ;
    skos:notation "da_i/dt = ρ_0 - μ a_i + ∑_{j∈N(i)} J_{i←j},  J_{i←j} = T(P_ji a_j - P_ij a_i) + D(a_j - a_i),  J_{i←j} + J_{j←i} = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.cub.2005.09.052>,
        <https://doi.org/10.1038/nature02081>,
        <https://doi.org/10.1073/pnas.0509839103>,
        <https://doi.org/10.1073/pnas.0510457103> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Up-the-Gradient Auxin-PIN1 Polarized Transport & Turing-Like Phyllotactic Spacing" ;
    pk:leanDeclaration "MathOfBiology.Loop_032.intercellular_auxin_flux" ;
    pk:leanTheorem "MathOfBiology.Loop_032.jonsson_2006_intercellular_flux_conservation" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/jonsson-auxin-pin1-meristem-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Jönsson et al. (2006) Up-the-Gradient Turing-Like Instability & NPA Pin-Formed Collapse Law" ;
    dct:description "Establishes the bifurcation threshold where up-the-gradient active transport overcomes passive diffusion to form periodic auxin convergence maxima separated by λ_c, and proves that blocking polar transport (T = 0 in NPA or pin1 mutant) abolishes instability to yield a pin-formed apex | Variables: c_1 a_0: dimensionless PIN1 polarization feedback product; z: cellular coordination number; D_eff: effective linearized diffusion coefficient; Γ_mode: spatial perturbation growth gain" ;
    dct:source "Jönsson et al. (2006) PNAS 103(5):1633-1638 pp. 1635-1636; Reinhardt et al. (2003) Nature 426:255-260" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py#L395-L535>,
        <https://github.com/fractastical/morpholib/blob/0cb0132/morphoeval/lean/loops/Loop_032_auxin_pin1_phyllotaxis.lean#L90-L109> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def effective_diffusion_scaled (z_D T P_i c1_a0 : Int) : Int :=
  z_D - T * P_i * (c1_a0 - 1)
def mode_instability_gain (z_D T P_i c1_a0 : Int) : Int :=
  T * P_i * (c1_a0 - 1) - z_D
theorem jonsson_2006_up_gradient_instability_and_npa_collapse (z_D T P_i c1_a0 : Int)
    (h_instab : T * P_i * (c1_a0 - 1) > z_D)
    (h_diff : z_D > 0) :
    effective_diffusion_scaled z_D T P_i c1_a0 < 0 ∧
    mode_instability_gain z_D T P_i c1_a0 > 0 ∧
    mode_instability_gain z_D 0 P_i c1_a0 < 0
"""^^pk:lean4 ;
    skos:notation "Γ_mode = T P_i (c_1 a_0 - 1) - z D > 0  ⇔  D_eff < 0;  T = 0 (NPA / pin1) ⇒ Γ_mode = -z D < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.cub.2005.09.052>,
        <https://doi.org/10.1038/nature02081>,
        <https://doi.org/10.1073/pnas.0509839103>,
        <https://doi.org/10.1073/pnas.0510457103> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Up-the-Gradient Auxin-PIN1 Polarized Transport & Turing-Like Phyllotactic Spacing" ;
    pk:leanDeclaration "MathOfBiology.Loop_032.mode_instability_gain" ;
    pk:leanTheorem "MathOfBiology.Loop_032.jonsson_2006_up_gradient_instability_and_npa_collapse" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


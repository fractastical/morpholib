<https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) up-the-gradient PIN1 polarization and polar auxin transport model for shoot apical meristem phyllotaxis — Model fidelity to source: 56/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Implements a minimal 1D periodic ring with Boltzmann PIN1 weights exp(c_1 a_j) and active + diffusive auxin transport (L22-50), but omits the 2D cellular L1 shoot apical meristem dome with central zone (CZ) vs peripheral organogenic ring (PZ), radial tissue advection and primordial vascular sink depletion, linearized Turing-like dispersion analysis, and 4-mode phyllotactic transitions." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-1> ;
    pk:hasScore 5.6e-01 ;
    pk:hasVerdict "partially faithful" .


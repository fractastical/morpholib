sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-jonsson-auxin-pin1-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) up-the-gradient PIN1 polarization and polar auxin transport model for shoot apical meristem phyllotaxis — Model fidelity to source: 56/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements a minimal 1D periodic ring with Boltzmann PIN1 weights exp(c_1 a_j) and active + diffusive auxin transport (L22-50), but omits the 2D cellular L1 shoot apical meristem dome with central zone (CZ) vs peripheral organogenic ring (PZ), radial tissue advection and primordial vascular sink depletion, linearized Turing-like dispersion analysis, and 4-mode phyllotactic transitions." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-1> ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L22–L50" ;
        dcterms:description "1D periodic ring ODE only without 2D L1 meristem dome or radial advection" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py#L22-L50> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 032 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


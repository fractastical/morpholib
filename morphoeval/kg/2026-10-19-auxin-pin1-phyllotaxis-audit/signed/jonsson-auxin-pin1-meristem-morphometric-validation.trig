sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-jonsson-auxin-pin1-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) up-the-gradient PIN1 polarization and polar auxin transport model for shoot apical meristem phyllotaxis — Morphometric validation: 52/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Exposes only 2 static parameter ratios in `measure_morphoeval()` (L53-72) without divergence angle statistics, parastichy counts, PIN1 flux conservation checks, NPA/IAA perturbation metrics, or specimen segmentation validation." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2006-jonsson-auxin-pin1-meristem.py L53–L72: Only 2 baseline analytical parameters without error bars or p-values <https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py#L53-L72>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-homogeneous-auxin-steady-state>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-feedback-product-c1-a0> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-homogeneous-auxin-steady-state> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "homogeneous_auxin_steady_state = 2.0 a.u." ;
        schema:measurementTechnique "Analytical ratio rho_0 / mu" ;
        schema:name "homogeneous_auxin_steady_state" ;
        schema:unitText "a.u." ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-homogeneous-auxin-steady-state-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-homogeneous-auxin-steady-state-reference> a schema:PropertyValue ;
        dcterms:source "Jönsson et al. (2006) PNAS Eqs. 1-4 (a_0 = rho_0 / mu = 0.10 / 0.05 = 2.0)" ;
        schema:value "2.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-feedback-product-c1-a0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pin1_feedback_product_c1_a0 = 3.7 dimensionless" ;
        schema:measurementTechnique "1D ring baseline feedback parameter product" ;
        schema:name "pin1_feedback_product_c1_a0" ;
        schema:unitText "dimensionless" ;
        schema:value "3.7" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-feedback-product-c1-a0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-feedback-product-c1-a0-reference> a schema:PropertyValue ;
        dcterms:source "Jönsson et al. (2006) PNAS up-the-gradient instability regime c_1 * a_0 > 1 + z*D/(T*P_i)" ;
        schema:value "3.7" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 032 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


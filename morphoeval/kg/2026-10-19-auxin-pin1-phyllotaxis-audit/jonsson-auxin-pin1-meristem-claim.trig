sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-jonsson-auxin-pin1-meristem> a pk:Claim ;
        rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) up-the-gradient PIN1 polarization and polar auxin transport model for shoot apical meristem phyllotaxis faithfully reproduces Arabidopsis thaliana & Aeonium tabuliforme (shoot apical meristem L1 epidermis & spiral rosette phyllotaxis) morphology" ;
        dct:description "The simulation script(s) 2006-jonsson-auxin-pin1-meristem.py implement the cited source model as published and produce forms that match real Arabidopsis thaliana & Aeonium tabuliforme (shoot apical meristem L1 epidermis & spiral rosette phyllotaxis) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 53.3/100, audit 2026-10-19-auxin-pin1-phyllotaxis-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py; output: docs/media/auxin_pin1_phyllotaxis_comparison.png; organism: Arabidopsis thaliana & Aeonium tabuliforme (shoot apical meristem L1 epidermis & spiral rosette phyllotaxis); checkpoint commit: https://github.com/fractastical/morpholib/commit/0cb0132; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 722bfcfebddd9b7a82c1bd7b9d04a028378c8556fe894a24ae273b6224593820; artifact_sha256: 6b600014785b8ea36e7a34928c1ae7ce27f40434a97419b7a2ec2b96d1083969; input_dataset_sha256: {datasets/auxin_pin1_phyllotaxis/auxin_pin1_phyllotaxis_reference.json=96d4b539eaaf1649..., datasets/auxin_pin1_phyllotaxis/paper_citations.bib=9fe96650b32df64b..., datasets/auxin_pin1_phyllotaxis/rosette_phyllotaxis_specimen.jpg=ec50801b52dabc46..., datasets/auxin_pin1_phyllotaxis/scout_manifest.json=2e474ee5544f04f4...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.cub.2005.09.052>,
            <https://doi.org/10.1038/nature02081>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-specimen-match> ;
        pk:weightOfEvidence "0.533"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py> a schema:SoftwareSourceCode ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "0cb0132" .
}


    <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Mongera et al. (2018) & Kim et al. (2021) zebrafish tailbud active fluid-to-solid jamming transition & yield-stress axis elongation — Source and data traceability: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`datasets/neuromesodermal_jamming/` vendors the reference JSON (now 9 DOIs incl. Soroldoni 2014, Herrgen 2010, Hubaud 2017, Lewis 2003), the IDR0051 micrograph, `paper_citations.bib` (re-pinned SHA-256 8ad03bd2...), `scout_manifest.json` and an updated README; runtime SHA-256 verification fails closed (`verify_reference_dataset`, L166-187) and the self-test confirms the dataset slot. Deductions: the Dray et al. (2013) ratios cite \"Figs. 2-4 / text\" without panel-level pins and are digitised approximately (-4); the calibration of K_FN and K_t is disclosed but has no literature anchor for a fibronectin sheath modulus (-2); Cooke & Zeeman (1976) is cited in the math-KG YAML but not in the bib (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-source-traceability-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tailbud-neuromesodermal-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Mongera et al. (2018) & Kim et al. (2021) zebrafish tailbud active fluid-to-solid jamming transition & yield-stress axis elongation — Morphological realism / specimen match: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Panels A5, B1 and B5 still carry the SHA-256-verified IDR0051 *Danio rerio* tailbud lightsheet micrograph with N = 391 segmented nuclei, Voronoi coordination <z> = 5.88 and AP interstitial compaction matching Mongera et al. (2018) with r = 0.9915 (`segment_zebrafish_tailbud_specimen`, L980-1092), and the four 2D regimes in A1-A4 remain visually distinct (jammed anterior plasma colouring vs uniformly fluid cdh2/ablation fields, widened cdh2 envelope). Deductions: the new row C (L1478-1601) compares the sheath envelope, kymograph and frozen stripes only with model references and approximate literature ratios — no fibronectin immunostain or her1 in situ specimen is vendored, so the specimen does not test either new mechanism (-6); the fn1a;fn1b 2D regime is simulated (L1142-1153) but not rendered as a spatial panel, so the predicted wider tailbud is shown only as an envelope curve (-3); the kymograph's posterior synchronous band and anterior frozen stripes are qualitatively right but no comparison image from Soroldoni et al. (2014) is placed beside it (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2022-tailbud-neuromesodermal-jamming.py L1478–L1601: Row C has no vendored specimen (no FN immunostain, no her1 in situ); comparisons are to approximate literature ratios and to the model's own Cooke-Zeeman S <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L1478-L1601>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-specimen-match-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L980–L1092" ;
        dcterms:description "CV nuclear & Voronoi segmentation of IDR0051 zebrafish tailbud lightsheet micrograph (N=391 nuclei, r=0.9915)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L980-L1092> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/neuromesodermal_jamming_comparison.png (generated output)" ;
        dcterms:description "15-panel figure: specimen overlay (A5), specimen compaction vs model (B1), Voronoi P(z) (B5); row C sheath envelope, her1 kymograph, frozen stripes, Dray regimes, fn_scale sweep — docs/media/neuromesodermal_jamming_comparison.png: rendered output of 2022-tailbud-neuromesodermal-jamming.py at d58a084, image/png, 1060623 B, 3150×2010 px, artifact_sha256 57d7a446903c3cc022726dc33c7904454b93ad9f642da0182f250a8fb9e200a3 (sha256 57d7a446903c3cc022726dc33c7904454b93ad9f642da0182f250a8fb9e200a3), spec_fingerprint 5225f2c29acda8d1ee81d082219556f85a1159006d552c629f56ce7d8a842027" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/neuromesodermal_jamming_growth.gif (generated output)" ;
        dcterms:description "4-panel animation: WT and cdh2 2D foams, AP crossover profile, and the Her1/Her7 kymograph filling in with the arrest front and x_jam marked — docs/media/neuromesodermal_jamming_growth.gif: rendered output of 2022-tailbud-neuromesodermal-jamming.py at d58a084, image/gif, 1128352 B, 1721×409 px, 15 frames, artifact_sha256 04b72bfb953cc1d27d78f9af7f1864e0cdee019e84169eca4a61cb947429b198 (sha256 04b72bfb953cc1d27d78f9af7f1864e0cdee019e84169eca4a61cb947429b198), spec_fingerprint 5225f2c29acda8d1ee81d082219556f85a1159006d552c629f56ce7d8a842027" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


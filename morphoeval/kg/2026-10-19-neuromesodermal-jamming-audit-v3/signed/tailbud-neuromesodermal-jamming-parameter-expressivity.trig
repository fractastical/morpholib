sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tailbud-neuromesodermal-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Mongera et al. (2018) & Kim et al. (2021) zebrafish tailbud active fluid-to-solid jamming transition & yield-stress axis elongation — Parameter expressivity: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "All 5 Mongera/Lawton regimes (`evaluate_all_perturbation_regimes`, L920-973) plus 3 new Dray fibronectin regimes (`evaluate_fibronectin_regimes`, L808-855) are evaluated; the 12-point fn_scale sweep (`sweep_fibronectin_scale`, L858-878) is monotonic in both elongation speed (increasing) and tailbud width (decreasing), asserted in self-test check 9 and shown in Panel C5; the clock period and fn_scale are exposed as CLI flags (L1987-1988) alongside the Pass 2 flags, and somite length scales with wavefront speed across regimes (Panel C3/C5). Deductions: the fn_scale sweep saturates above ~0.6 so the WT point sits on a flat shoulder, which limits the diagnostic value of the sweep near WT (-4); Lambda_arrest, c_slow, K_FN and K_t are not swept, and no 2D sweep (fn_scale x phi_ECS) is shown (-5)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-parameter-expressivity-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L808–L878" ;
        dcterms:description "3 Dray fibronectin regimes and 12-point fn_scale sweep with monotonicity flags" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L808-L878> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L920–L973" ;
        dcterms:description "5-regime Mongera/Lawton perturbation evaluator (unchanged semantics; channeling now included)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L920-L973> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L1980–L1995" ;
        dcterms:description "CLI: --phi-ecs-mpz, --phi-ecs-apsm, --sigma-a-mpz, --fn-scale, --clock-period, --steps, --seed, --self-test" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L1980-L1995> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


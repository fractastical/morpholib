sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tailbud-neuromesodermal-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Mongera et al. (2018) & Kim et al. (2021) zebrafish tailbud active fluid-to-solid jamming transition & yield-stress axis elongation — Code-to-model traceability: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module docstring (L1-94) maps every Pass 2 and Pass 3 step to its source figure/equation and to the 6 Lean theorems; each new function docstring states its equation, its source and the Lean theorem it instantiates (L398-514, L521-640), and the math-KG YAML registers the two new laws with code and Lean loci. Deductions: the clock advection floor 0.15/0.85 and the slowing exponent (L576-583), the sheath taper constants 95/35 um (L398-406) and the f_FN sigmoid 110/40 um (L409-429) are stated but not traced to a figure (-5); the hard-coded asymmetry overrides at L724-728 still carry no citation (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-code-traceability-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L1–L94" ;
        dcterms:description "Module docstring: Pass 3 remediation summary, 9 primary sources with DOIs, 6 Lean theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L1-L94> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L398–L450" ;
        dcterms:description "Sheath functions cite Dray 2013 Fig. 1 / Mongera Fig. 1a and Lean Theorem 5; taper and sigmoid constants are uncited" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L398-L450> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/tailbud-neuromesodermal-jamming.yaml L63–L102" ;
        dcterms:description "Two new laws registered with formula, Lean decl/theorem/locus, variables, role, source and code locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/tailbud-neuromesodermal-jamming.yaml#L63-L102> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tailbud-neuromesodermal-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Mongera et al. (2018) & Kim et al. (2021) zebrafish tailbud active fluid-to-solid jamming transition & yield-stress axis elongation — Model fidelity to source: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The Mongera/Kim laws of Pass 2 are unchanged and remain faithful: cell packing, Maxwell coordination, rigidity-percolation yield stress, Kramers T1 rate, Bingham strain rate and the continuous AP crossover solver (L194-390). Pass 3 adds the requested fibronectin and clock couplings as reduced models that are honest about their status: a hoop-equilibrium sheath with an explicit calibration note (L398-514; reference JSON L269-286) and a phase-advection clock with a mechanical arrest gate (L521-640), both wired bidirectionally into the jamming gradient (arrest front -> somite fibronectin -> channeling -> v_elong -> somite length) and backed by Lean Theorems 5-6. Deductions: the remediation asked for ECM boundary FRICTION, and the implemented coupling is confinement — the computed wall-friction force (L485-486) is reported but never feeds back (-3); the channeling factor is a transient stored-volume argument rather than a steady-state force balance, and it multiplies an elongation law that is still a calibrated product (J prefactor 2.034, tanh(sigma_A/29) fluidity, blebbistatin/SU5402 asymmetry overrides at L716-728) (-4); Lambda_arrest = 4, the u(x) floor 0.15 and c_slow = 0.6 (L576-583) are modelling choices without a cited measurement, and the clock is a phase model, not the Lewis (2003) DDE (-3). Down 3 from v2 because the new modules make the phenomenological core more visible, not less." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2022-tailbud-neuromesodermal-jamming.py L683–L728: 2D simulator: sheath channeling multiplies the elongation law; J prefactor, tanh fluidity and hard-coded blebbistatin/SU5402 asymmetry overrides remain phenomenological <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L683-L728>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity-4> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L194–L390" ;
        dct:description "Unchanged Pass 2 active-foam laws: packing, isostatic z, rigidity-percolation sigma_y, Kramers k_T1, Bingham rate, AP crossover solver with NaN-safe Pearson r" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L194-L390> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L398–L514" ;
        dct:description "Quasi-3D fibronectin sheath: R_0(x), f_FN(x) with somite feedback, hoop strain, influx-weighted channeling chi, diagnostic wall friction F_drag" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L398-L514> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L521–L640" ;
        dct:description "Her1/Her7 clock: mechanical arrest gate, tip-frame upwind advection with pacemaker, steady-state initial phase, frozen-stripe wavelength measurement" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L521-L640> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_030_neuromesodermal_jamming.lean L150–L247" ;
        dct:description "Theorems 5-6: sheath stiffness ordering => larger morphant hoop strain and lower channeling; arrest front strictly anterior to x_jam and somite length monotone in wavefront speed (lean verified, 0 sorry)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_030_neuromesodermal_jamming.lean#L150-L247> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tailbud-neuromesodermal-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Mongera et al. (2018) & Kim et al. (2021) zebrafish tailbud active fluid-to-solid jamming transition & yield-stress axis elongation — Reproducibility package: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Deterministic RNG (`seed=2018`), full render in ~3.3 s and `--self-test` in <1 s with 13 checks (L1865-1977) covering SHA-256 integrity, Lean Theorem 1-6 parity, AP correlations, cdh2 and blebbistatin perturbations, specimen segmentation, two-run bitwise determinism, sheath monotonicity, arrest-front ordering, stripe-wavelength parity, the cdh2 no-arrest case and the somite fibronectin feedback; the clock solver raises on CFL > 0.9. Deductions: no requirements lock file pins the numpy/scipy/matplotlib versions recorded in this audit (-5); the invocation notes live only in argparse help (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-repro-package-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L1865–L1977" ;
        dct:description "13-check self_test() including SHA-256 verification, Lean parity, two-run determinism and the 5 Pass 3 checks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L1865-L1977> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L594–L598" ;
        dct:description "CFL guard on the clock advection scheme" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L594-L598> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


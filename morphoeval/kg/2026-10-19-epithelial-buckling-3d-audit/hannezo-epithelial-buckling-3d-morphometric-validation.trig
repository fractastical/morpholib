sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-epithelial-buckling-3d> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo, Prost & Joanny (2014) PNAS & Krajnc & Ziherl (2015) PRE 3D epithelial sheet morphology (squamous-to-cuboidal-to-columnar scaling & apico-basal buckling) — Morphometric validation: 53/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L175-207) reports only 3 analytic aspect-ratio values without cross-species Pearson r, p-value, RMSE, log-log scaling slope, without L-BFGS-B buckled wavelength/curvature metrics, without E-cadherin/Myosin-II perturbation deltas, and without specimen CV morphometrics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2016-hannezo-epithelial-buckling-3d.py L175–L207: Only 3 basic aspect-ratio metrics without statistical tests or specimen segmentation <https://github.com/fractastical/morpholib/blob/e93f00e/2016-hannezo-epithelial-buckling-3d.py#L175-L207>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-mouse-alveolar-squamous-aspect-ratio-h0-d0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-mouse-renal-collecting-duct-cuboidal-aspect-ratio-h0-d0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-mouse-small-intestine-tall-columnar-aspect-ratio-h0-d0> ;
        pk:hasScore "0.53"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-mouse-alveolar-squamous-aspect-ratio-h0-d0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Mouse alveolar squamous aspect ratio h0/d0 = 0.2047 h0/d0" ;
        dct:description "predicted h0 = 3.47 um" ;
        schema:measurementTechnique "Hannezo et al. (2014) PNAS Eq. (4) equilibrium aspect ratio c*Gamma_l / [4*(Gamma_a + Gamma_b)]" ;
        schema:name "Mouse alveolar squamous aspect ratio h0/d0" ;
        schema:unitText "h0/d0" ;
        schema:value "0.2047" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-mouse-alveolar-squamous-aspect-ratio-h0-d0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-mouse-alveolar-squamous-aspect-ratio-h0-d0-reference> a schema:PropertyValue ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS 111:27-32 Fig. 1 (squamous epithelium)" ;
        schema:value "0.21" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-mouse-renal-collecting-duct-cuboidal-aspect-ratio-h0-d0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Mouse renal collecting duct cuboidal aspect ratio h0/d0 = 1.0599 h0/d0" ;
        dct:description "predicted h0 = 10.40 um" ;
        schema:measurementTechnique "Hannezo et al. (2014) PNAS Eq. (4) equilibrium aspect ratio" ;
        schema:name "Mouse renal collecting duct cuboidal aspect ratio h0/d0" ;
        schema:unitText "h0/d0" ;
        schema:value "1.0599" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-mouse-renal-collecting-duct-cuboidal-aspect-ratio-h0-d0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-mouse-renal-collecting-duct-cuboidal-aspect-ratio-h0-d0-reference> a schema:PropertyValue ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS 111:27-32 Fig. 1 (cuboidal epithelium)" ;
        schema:value "1.06" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-mouse-small-intestine-tall-columnar-aspect-ratio-h0-d0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Mouse small intestine tall columnar aspect ratio h0/d0 = 4.4838 h0/d0" ;
        dct:description "predicted h0 = 28.90 um" ;
        schema:measurementTechnique "Hannezo et al. (2014) PNAS Eq. (4) equilibrium aspect ratio" ;
        schema:name "Mouse small intestine tall columnar aspect ratio h0/d0" ;
        schema:unitText "h0/d0" ;
        schema:value "4.4838" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-mouse-small-intestine-tall-columnar-aspect-ratio-h0-d0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-mouse-small-intestine-tall-columnar-aspect-ratio-h0-d0-reference> a schema:PropertyValue ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS 111:27-32 Fig. 1 (columnar epithelium)" ;
        schema:value "4.48" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 047 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


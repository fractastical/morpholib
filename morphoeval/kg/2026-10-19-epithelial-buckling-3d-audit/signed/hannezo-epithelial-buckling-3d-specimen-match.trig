sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-epithelial-buckling-3d> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo, Prost & Joanny (2014) PNAS & Krajnc & Ziherl (2015) PRE 3D epithelial sheet morphology (squamous-to-cuboidal-to-columnar scaling & apico-basal buckling) — Morphological realism / specimen match: 35/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Although `datasets/epithelial_buckling_3d/epithelial_sheet_buckling_specimen.jpg` is vendored on disk, the v1 script never loads, segments, or measures epithelial layer height h_0, cell width d_0, aspect ratio h_0/d_0, or fold wavelength lambda_c on the biological histology micrograph, and evaluates only 8 Mus musculus rows without Drosophila melanogaster comparative tissues." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2016-hannezo-epithelial-buckling-3d.py L85–L107: Evaluates only Mus musculus rows and ignores epithelial_sheet_buckling_specimen.jpg <https://github.com/fractastical/morpholib/blob/e93f00e/2016-hannezo-epithelial-buckling-3d.py#L85-L107>",
            "docs/media/epithelial_buckling_3d_comparison.png (generated output, not in repo): 4-panel v1 plot lacks histology specimen segmentation and 2D phase diagram panels — docs/media/epithelial_buckling_3d_comparison.png: rendered output of 2016-hannezo-epithelial-buckling-3d.py at e93f00e, image/png, 167647 B, 1458×1117 px, artifact_sha256 e5d0e99cc20e4a6ec380a3c440718ab585c303f5100c768bb0fa174f07c45161 (sha256 e5d0e99cc20e4a6ec380a3c440718ab585c303f5100c768bb0fa174f07c45161), spec_fingerprint eabe5855ceb1bf4a12fea7ec7b30902813b84c0440d83d21ca21bb917876b36c" ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .


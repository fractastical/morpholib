sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-epithelial-buckling-3d> a pk:Claim ;
        rdfs:label "Hannezo, Prost & Joanny (2014) PNAS & Krajnc & Ziherl (2015) PRE 3D epithelial sheet morphology (squamous-to-cuboidal-to-columnar scaling & apico-basal buckling) faithfully reproduces Mus musculus / Drosophila melanogaster epithelial monolayers morphology" ;
        dcterms:description "The simulation script(s) 2016-hannezo-epithelial-buckling-3d.py implement the cited source model as published and produce forms that match real Mus musculus / Drosophila melanogaster epithelial monolayers specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 53.6/100, audit 2026-10-19-epithelial-buckling-3d-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/e93f00e/2016-hannezo-epithelial-buckling-3d.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/e93f00e/2016-hannezo-epithelial-buckling-3d.py; output: docs/media/epithelial_buckling_3d_comparison.png; organism: Mus musculus / Drosophila melanogaster epithelial monolayers; checkpoint commit: https://github.com/fractastical/morpholib/commit/e93f00e; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: eabe5855ceb1bf4a12fea7ec7b30902813b84c0440d83d21ca21bb917876b36c; artifact_sha256: e5d0e99cc20e4a6ec380a3c440718ab585c303f5100c768bb0fa174f07c45161; input_dataset_sha256: {datasets/epithelial_buckling_3d/epithelial_buckling_3d_reference.json=eef9f75ed38ce872..., datasets/epithelial_buckling_3d/epithelial_sheet_buckling_specimen.jpg=cd05cc85a7f49dd2..., datasets/epithelial_buckling_3d/paper_citations.bib=e4556865f1879134..., datasets/epithelial_buckling_3d/scout_manifest.json=99741cb299962b18...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.bpj.2015.11.024>,
            <https://doi.org/10.1038/s41467-018-06497-3>,
            <https://doi.org/10.1073/pnas.1321766111>,
            <https://doi.org/10.1103/PhysRevE.92.052713> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-specimen-match> ;
        pk:weightOfEvidence "0.536"^^xsd:double .


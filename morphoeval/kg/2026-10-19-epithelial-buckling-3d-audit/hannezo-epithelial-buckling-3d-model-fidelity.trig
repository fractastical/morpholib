        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-epithelial-buckling-3d> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo, Prost & Joanny (2014) PNAS & Krajnc & Ziherl (2015) PRE 3D epithelial sheet morphology (squamous-to-cuboidal-to-columnar scaling & apico-basal buckling) — Model fidelity to source: 58/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Computes equilibrium cell height h_0, width d_0, aspect ratio h_0/d_0 = c*Gamma_l/[4*(Gamma_a+Gamma_b)], bending modulus kappa_eff, spontaneous curvature C_0, and buckling wavelength lambda_c = 2*pi*(kappa_eff/K_sub)^(1/4) (L46-72), backed by 3 Lean 4 theorems in `Loop_047_epithelial_buckling_3d.lean`. However, `generate_cosine_buckled_profile` (L74-82) uses a closed-form cosine ansatz instead of minimizing the coupled 3D epithelial + substrate energy functional, and omits the 5-regime (Gamma_l/Gamma_a, K_sub) phase diagram." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2016-hannezo-epithelial-buckling-3d.py L74–L82: Closed-form 1D cosine buckling ansatz rather than L-BFGS-B energy minimization <https://github.com/fractastical/morpholib/blob/e93f00e/2016-hannezo-epithelial-buckling-3d.py#L74-L82>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-model-fidelity-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2016-hannezo-epithelial-buckling-3d.py L46–L72" ;
        dct:description "Analytic Hannezo et al. (2014) equilibrium aspect ratio, cell height, and buckling wavelength" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2016-hannezo-epithelial-buckling-3d.py#L46-L72> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 047 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-code-traceability-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-code-traceability-3> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L1–L50" ;
        dcterms:description "docstring: claim decomposition, steps 1-7, equation ids" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1b27eb65/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L1-L50> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/thompson1917-t1917-019.yaml L1–L40" ;
        dcterms:description "six equations with lean_locus and code_locus into v2 line ranges" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1b27eb65/morphoeval/math_kg_loops/thompson1917-t1917-019.yaml#L1-L40> .


sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-019> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-morphometric-validation> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-division-topology-chain-fixed-point-p6-through-centre-cleavage-reconstruction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "division-topology chain fixed-point p6 (through-centre cleavage reconstruction) = 0.4336 fraction" ;
        schema:measurementTechnique "mean-field Gibson 2006 Markov chain, p_cut = 1/3; uniform-random cleavage ablation p6 = 0.126" ;
        schema:name "division-topology chain fixed-point p6 (through-centre cleavage reconstruction)" ;
        schema:unitText "fraction" ;
        schema:value "0.4336" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-division-topology-chain-fixed-point-p6-through-centre-cleavage-reconstruction-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-division-topology-chain-fixed-point-p6-through-centre-cleavage-reconstruction-reference> a schema:PropertyValue ;
        dcterms:source "Gibson et al. 2006 Nature 442:1038 (Lean Law 6 division_preserves_mean_six)" ;
        schema:value "0.464" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-pearson-r-specimen-vs-best-fit-froth-model-polygon-distribution> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pearson r specimen vs best-fit froth model polygon distribution = 0.9914 r" ;

            pk:EvidenceItem ;
        rdfs:label "specimen Aboav-Weaire parameter a = 0.7368 dimensionless" ;
        schema:measurementTechnique "fit n m(n) = (6-a) n + (6a+mu2), r = 0.999009636440421; neighbour-shuffle control a = 0.09" ;

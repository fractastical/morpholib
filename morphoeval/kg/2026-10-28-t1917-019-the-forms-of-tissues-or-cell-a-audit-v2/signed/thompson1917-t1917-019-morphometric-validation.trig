        schema:unitText "dimensionless" ;
        schema:value "0.7368" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-specimen-aboav-weaire-parameter-a-reference> .


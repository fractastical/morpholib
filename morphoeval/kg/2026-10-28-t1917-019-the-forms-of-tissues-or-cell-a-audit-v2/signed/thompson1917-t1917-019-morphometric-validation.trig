        dcterms:source "Aboav 1970 Metallography 3:383; Weaire & Rivier 1984 (froths a = 1.0-1.5)" ;
        schema:value "1.2" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-specimen-aboav-weaire-sum-rule-residual-1-f-sum-n-m-n-36-mu2> a schema:PropertyValue,

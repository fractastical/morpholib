        schema:unitText "r" ;
        schema:value "0.9914" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-pearson-r-specimen-vs-best-fit-froth-model-polygon-distribution-reference> .


sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-019> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-specimen-match> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. VII — tissue cells as hexagons / froth vs. human corneal endothelium (Pass 2: segmented specimen, sweep, controls, statistics) — Morphological realism / specimen match: 72/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Side by side: the segmented corneal endothelium coloured by polygon class, the digitised Fig. 125 A/B, and the best-fit froth. The tissue reads as a mildly disordered hexagonal froth and the best-fit froth matches its polygon spectrum (TV 0.054, chi-square p = 0.42); but the relaxed CVT froth is visibly more uniform in cell size (area CV 0.10 vs 0.285), the joint fit shows no sweep point matches both, and the comparison rests on a single specimen." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-019/result.json (generated output, not in repo): joint_fit_area_cv_diff = -0.10: no froth in the sweep matches the tissue's size dispersion — datasets/thompson_1917/t1917-019/result.json: rendered output of thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py at f1b27eb65, application/json, 3555 B, artifact_sha256 69a794a8aa303dba328cc94b4cee0aa1d6fa3e790abce137a9df9bc02e58e8f7 (sha256 69a794a8aa303dba328cc94b4cee0aa1d6fa3e790abce137a9df9bc02e58e8f7), spec_fingerprint 573eaa78956bb7a95427321ba84764635768abd58c2fd7fd76e7660dc905fc59" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-specimen-match-3> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_019_the_forms_of_tissues_or_cell_a_comparison.png (generated output)" ;
        dcterms:description "panels (a) segmented specimen with side numbers, (b) Fig. 125 A/B digitised, (c) best-fit froth, (f) (p6, mu2) morphospace — docs/media/t1917_019_the_forms_of_tissues_or_cell_a_comparison.png: rendered output of thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py at f1b27eb65, image/png, 783069 B, 1600×1300 px, artifact_sha256 12cce483342dadf13115a47e56930376f60359a117a1a04c62c1fd0f1105b924 (sha256 12cce483342dadf13115a47e56930376f60359a117a1a04c62c1fd0f1105b924), spec_fingerprint 573eaa78956bb7a95427321ba84764635768abd58c2fd7fd76e7660dc905fc59" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L363–L397" ;
        dcterms:description "segment_tissue: nucleus-marker watershed (126 cells; prototype overlay inspected visually: boundaries follow the alizarin outlines)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1b27eb65/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L363-L397> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L534–L557" ;
        dcterms:description "draw_segmentation overlay coloured by polygon class" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1b27eb65/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L534-L557> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 2; cross-provider second assessor pending R7)" ;

sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-019> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-model-fidelity> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L198–L257" ;
        dcterms:description "polygon_statistics: <n>, mu2, p_n, excess perimeter vs 2*12^(1/4) sqrt(A), Lewis, Aboav-Weaire, sum rule, shuffle control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1b27eb65/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L198-L257> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L316–L360" ;
        dcterms:description "tessellation_from_labels: label adjacency with >= 4 px contact, Crofton perimeters, interior mask, 2x2 junction valence" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1b27eb65/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L316-L360> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L486–L514" ;
        dcterms:description "fit_to_specimen: TV fit and joint topology+geometry fit; gap between them is a recorded finding" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1b27eb65/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L486-L514> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_019.lean L115–L148" ;
        dcterms:description "Law 3: P_6^4 = 192 A^2 < 256 A^2 < 432 A^2 and the Hales constant identity, proved" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1b27eb65/morphoeval/lean/loops/Thompson1917_T1917_019.lean#L115-L148> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. VII — tissue cells as hexagons / froth vs. human corneal endothelium (Pass 2: segmented specimen, sweep, controls, statistics) — Model fidelity to source: 78/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "The froth laws (E1-E5) are implemented exactly and proved in Lean; the claim is now actually tested — Euler mean six, trivalency, honeycomb bound and hexagon fraction are all measured on tissue and on Thompson's own Fig. 125. The division chain (E6) reproduces Gibson's spectrum to 0.03 and its ablation shows cleavage geometry matters. Remaining gap: least perimeter is modelled by Lloyd relaxation (a proxy), and the froth model class cannot match topology and area dispersion simultaneously (joint fit), which the script records rather than hides." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L151–L163: lloyd_step remains a centroidal-Voronoi proxy for surface-tension relaxation <https://github.com/fractastical/morpholib/blob/f1b27eb65/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L151-L163>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-4> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;

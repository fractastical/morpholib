sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-019> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. VII — tissue cells as hexagons / froth vs. human corneal endothelium (Pass 2: segmented specimen, sweep, controls, statistics) — Reproducibility package: 80/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Deterministic (seed asserted; identical metrics on repeated runs), --self-test 2.0 s covering laws, controls and segmentation sanity, full run 24 s, pinned dependencies (requirements.txt / .lock), CLI documented, dataset README with invocation. The comparison PNG is force-added past the repo's *.png ignore rule." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-repro-package-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L1010–L1066" ;
        dct:description "self_test incl. raster control and specimen/Fig. 125 sanity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1b27eb65/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L1010-L1066> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-019/README.md L1–L60" ;
        dct:description "documented invocation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1b27eb65/datasets/thompson_1917/t1917-019/README.md#L1-L60> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 2; cross-provider second assessor pending R7)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


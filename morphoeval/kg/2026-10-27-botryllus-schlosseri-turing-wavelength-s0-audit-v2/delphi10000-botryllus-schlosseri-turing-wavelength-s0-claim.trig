    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1046/j.1463-6395.2000.00054.x>,
            <https://doi.org/10.1093/icb/22.4.817>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://doi.org/10.1007/BF00289234> dct:date "1972"^^xsd:gYear ;
        dct:title "A theory of biological pattern formation" .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1038/376765a0> dct:date "1995"^^xsd:gYear ;
        dct:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .
    <https://doi.org/10.1046/j.1463-6395.2000.00054.x> dct:date "2000"^^xsd:gYear ;
        dct:title "Evolution of cerebral vesicles and their sensory organs in an ascidian larva" .
    <https://doi.org/10.1093/icb/22.4.817> dct:date "1982"^^xsd:gYear ;
        dct:title "Ascidian larvae and the events of metamorphosis" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
}


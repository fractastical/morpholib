sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Schnakenberg–Turing wavelength at 39 µm in Botryllus schlosseri (Holocene, detail scale) faithfully reproduces Botryllus schlosseri morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-botryllus-schlosseri-turing-wavelength-s0.py, docs/media/botryllus_schlosseri_turing_wavelength_s0_growth.gif implement the cited source model as published and produce forms that match real Botryllus schlosseri specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/media/botryllus_schlosseri_turing_wavelength_s0_growth.gif>,
            <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-botryllus-schlosseri-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-botryllus-schlosseri-turing-wavelength-s0.py, https://github.com/fractastical/morpholib/blob/main/docs/media/botryllus_schlosseri_turing_wavelength_s0_growth.gif; output: docs/media/botryllus_schlosseri_turing_wavelength_s0_comparison.png; organism: Botryllus schlosseri; environment: n/a; claim_boundary: [reported_in_source: Turing 1952: diffusion-driven instability at a finite critical wavenumber when two morphogens diffuse at different rates. | Schnakenberg 1979: the mass-action system f = a - u + u^2 v, g = b - u^2 v. | Sorrentino, Manni, Lane and Burighel 2000: ascidian larvae carry a cerebral vesicle with sensory organs, including an ocellus. | Cloney 1982: review of ascidian larval metamorphosis, including colonial botryllids.; reconstructed_in_script: Slot-3136 parameters a=0.097, b=1.246, γ=1.37 solve the onset identity at λ=3.872e-5 m. | Pass 2 adds the D_v/D_u sweep and the u^2 v knockout beside the γ sweep, equal-diffusion control, specimen segmentation, KS test, and seed CV.; transfer_boundary: Kondo and Asai 1995 is the pigment-stripe exemplar of the same law. It is not a Botryllus measurement. | 39 µm is the MorphoEval detail-tier assignment, not a caliper reading on the Parent 1991 colony photograph.; does_not_claim: Does not claim that Botryllus star systems are produced by this PDE. | Does not claim the colony photograph was taken at 39 µm. | Does not claim a second independent assessor scored this audit. | Does not claim the nanopublications are cryptographically signed.]; phenomenon_size: 39 µm (3.872e-05 m, log10=-4.412 m, tier=4_cellular_10um); species_scale_ladder (10 runs from 39 µm to 6.2 cm): 39 µm:botryllus-schlosseri-bioelectric-polarity, 72 µm:botryllus-schlosseri-vertex-packing, 1.4 mm:botryllus-schlosseri-turing-wavelength, 2.5 mm:botryllus-schlosseri-clock-wavefront, 8.2 mm:botryllus-schlosseri-morphogen-condensation, 1.1 cm:botryllus-schlosseri-flux-canalization, 1.1 cm:botryllus-schlosseri-elastic-buckling, 1.4 cm:botryllus-schlosseri-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1046/j.1463-6395.2000.00054.x>,
            <https://doi.org/10.1093/icb/22.4.817>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://github.com/fractastical/morpholib/blob/main/docs/media/botryllus_schlosseri_turing_wavelength_s0_growth.gif> a schema:SoftwareSourceCode ;
        rdfs:label "docs/media/botryllus_schlosseri_turing_wavelength_s0_growth.gif" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-botryllus-schlosseri-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-botryllus-schlosseri-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


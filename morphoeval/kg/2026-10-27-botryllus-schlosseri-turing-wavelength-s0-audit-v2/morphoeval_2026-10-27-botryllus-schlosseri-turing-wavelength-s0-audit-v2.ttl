<https://w3id.org/delphi/resource/math-law/delphi10000-botryllus-schlosseri-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Positivity of the diffusion product in the Turing symbol at the 39 µm detail scale | Variables: a, b positive stand-ins for the two diffusion weights at λ = 38.72 µm" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-botryllus-schlosseri-turing-wavelength-s0.py#L122-L129>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3136_botryllus_schlosseri_turing_wavelength_s0.lean#L13-L18> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J - k^2 D) = D_u D_v k^4 - (D_v f_u + D_u g_v) k^2 + (f_u g_v - f_v g_u)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1046/j.1463-6395.2000.00054.x>,
        <https://doi.org/10.1093/icb/22.4.817>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3136.law1_invariant" ;
    pk:leanTheorem "MathOfBiology.Loop_3136.law1_positive_scaling" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-botryllus-schlosseri-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber" ;
    dct:description "Wavelength selection at 38.72 µm inside a 271.04 µm window (7 modes) | Variables: p is the cleared wavenumber identity; q cancels" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-botryllus-schlosseri-turing-wavelength-s0.py#L107-L119>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3136_botryllus_schlosseri_turing_wavelength_s0.lean#L21-L26> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); lambda_c = 2 pi / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1046/j.1463-6395.2000.00054.x>,
        <https://doi.org/10.1093/icb/22.4.817>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3136.law2_balance" ;
    pk:leanTheorem "MathOfBiology.Loop_3136.law2_exact_cancellation" ;
    pk:leanVerified true .


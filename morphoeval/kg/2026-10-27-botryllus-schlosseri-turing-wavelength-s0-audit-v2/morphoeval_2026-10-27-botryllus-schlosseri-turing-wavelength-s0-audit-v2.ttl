    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg–Turing wavelength at 39 µm in Botryllus schlosseri (Holocene, detail scale) — Model fidelity to source: 90/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Schnakenberg kinetics, the dispersion relation, and the onset identity for k_c are implemented directly and recover λ = 38.72 µm. Pass 2 adds the two controls the law predicts: unequal diffusion is required, and so is the u²v autocatalytic term (knockout σ_peak = -1.37)." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 9e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg–Turing wavelength at 39 µm in Botryllus schlosseri (Holocene, detail scale) — Morphometric validation: 88/100" ;

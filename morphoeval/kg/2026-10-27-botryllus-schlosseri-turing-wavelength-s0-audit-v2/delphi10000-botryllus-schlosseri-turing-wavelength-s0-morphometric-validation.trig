sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg–Turing wavelength at 39 µm in Botryllus schlosseri (Holocene, detail scale) — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Nonlinear FFT wavelength 39.90 µm versus assigned 38.72 µm. γ-sweep Pearson r = 0.999998, RMSE = 1.598 cells. Ratio-sweep RMSE = 5.652 µm versus a reference of 0. Specimen circularity 0.085 versus 1. Seed CV and the KS orientation statistic are recorded. The colony photograph is not at the 39 µm scale." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-autocatalysis-knockout-peak-growth>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-diffusivity-ratio-sweep-wavelength-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-equal-diffusion-control-peak-growth>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-seed-ensemble-stripe-spacing-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-stripe-wavelength-from-activator-fft>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-autocatalysis-knockout-peak-growth> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "autocatalysis knockout peak growth = -1.37 1/time" ;
        dct:description "negative control distinct from the equal-diffusion ablation" ;
        schema:measurementTechnique "max σ(k) after replacing u^2 v kinetics by pure decay f_u = g_v = -γ" ;
        schema:name "autocatalysis knockout peak growth" ;
        schema:unitText "1/time" ;
        schema:value "-1.37" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-autocatalysis-knockout-peak-growth-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-autocatalysis-knockout-peak-growth-reference> a schema:PropertyValue ;
        dct:source "without autocatalysis the Turing band should not exist" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-diffusivity-ratio-sweep-wavelength-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffusivity-ratio sweep wavelength RMSE = 5.6516 µm" ;
        dct:description "pearson r = -0.986850; monotonic decreasing = True" ;
        schema:measurementTechnique "RMSE of onset-formula λ versus argmax σ(k) with D_u fixed and D_v/D_u increased" ;
        schema:name "diffusivity-ratio sweep wavelength RMSE" ;
        schema:unitText "µm" ;
        schema:value "5.6516" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-diffusivity-ratio-sweep-wavelength-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-diffusivity-ratio-sweep-wavelength-rmse-reference> a schema:PropertyValue ;
        dct:source "exact agreement would mean the supercritical peak sits on the onset identity" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-equal-diffusion-control-peak-growth> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control peak growth = -0.64945 1/time" ;
        dct:description "pattern σ_peak = 0.2122 at the design ratio 21.312" ;
        schema:measurementTechnique "argmax σ(k) after setting D_u = D_v = (D_u+D_v)/2" ;
        schema:name "equal-diffusion control peak growth" ;
        schema:unitText "1/time" ;
        schema:value "-0.64945" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-equal-diffusion-control-peak-growth-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-equal-diffusion-control-peak-growth-reference> a schema:PropertyValue ;
        dct:source "Turing 1952: diffusion-driven instability requires unequal diffusivities" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-seed-ensemble-stripe-spacing-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "seed-ensemble stripe spacing CV = 0.004543 1" ;
        dct:description "KS orientation statistic = 0.0852; orientation L1 = 0.2317" ;
        schema:measurementTechnique "sample standard deviation / mean of radial-FFT cycles across seeds" ;
        schema:name "seed-ensemble stripe spacing CV" ;
        schema:unitText "1" ;
        schema:value "0.004543" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-seed-ensemble-stripe-spacing-cv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-seed-ensemble-stripe-spacing-cv-reference> a schema:PropertyValue ;
        dct:source "a deterministic onset formula has no seed CV" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen contour circularity = 0.0853 1" ;
        dct:description "foreground fraction = 0.8128; coherency = 0.2679; components = 18" ;
        schema:measurementTechnique "4π area / perimeter² on the border-contrast mask of Parent 1991" ;
        schema:name "specimen contour circularity" ;
        schema:unitText "1" ;
        schema:value "0.0853" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "a filled circle; the star colony is not a circle" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-stripe-wavelength-from-activator-fft> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stripe wavelength from activator FFT = 44.4678 µm" ;
        dct:description "Pearson r of formula vs argmax σ(k) = 0.999998; RMSE = 1.5979 cells" ;
        schema:measurementTechnique "sub-bin radial FFT peak of the nonlinear Schnakenberg activator on the 271.04 µm window" ;
        schema:name "stripe wavelength from activator FFT" ;
        schema:unitText "µm" ;
        schema:value "44.4678" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-stripe-wavelength-from-activator-fft-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-measurement-stripe-wavelength-from-activator-fft-reference> a schema:PropertyValue ;
        dct:source "assigned MorphoEval scale 3.872e-5 m (39 µm detail tier), not a caliper on the colony photo" ;
        schema:value "38.72" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-botryllus-schlosseri-turing-wavelength-s0.py L579–L655" ;
        dct:description "measure_morphoeval including ratio RMSE and knockout" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-botryllus-schlosseri-turing-wavelength-s0.py#L579-L655> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "datasets/botryllus_schlosseri_turing_wavelength_s0/botryllus_schlosseri_turing_wavelength_s0_metrics.json (generated output)" ;
        dct:description "pearson, RMSE, KS, ratio sweep, knockout — datasets/botryllus_schlosseri_turing_wavelength_s0/botryllus_schlosseri_turing_wavelength_s0_metrics.json: rendered output of models/2026-delphi10000-botryllus-schlosseri-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, application/json, 4972 B, artifact_sha256 3da7872dbb8d2fa61bccb5b17f430aa17d83ed401f9c92ea5863ad1ae7392226 (sha256 3da7872dbb8d2fa61bccb5b17f430aa17d83ed401f9c92ea5863ad1ae7392226), spec_fingerprint 1f41527fdb3ad32975a5fe85bdbd97d229f23905e445211f557d1ede5e6ef301" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent)" ;
        dct:identifier "grok-4.7" ;

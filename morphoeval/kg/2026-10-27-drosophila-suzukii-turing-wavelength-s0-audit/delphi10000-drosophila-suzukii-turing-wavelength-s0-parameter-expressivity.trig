sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila suzukii Turing onset wavelength at 2.046 µm (0 Ma, detail scale) — Parameter expressivity: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Diffusivity scale s moves the analytical wavelength as sqrt(s), and the fastest PDE mode follows it (sweep r = 0.997, monotonic). Subobscura turns the band off by flipping the sign of f_u. The stripe-seed lock to the 12-wave window mode is not yet part of this pass's scored claim." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-suzukii-turing-wavelength-s0.py L226–L259" ;
        dct:description "wavelength_sweep over diffusivity scale s" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-suzukii-turing-wavelength-s0.py#L226-L259> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;

        dct:description "TAK_SCALE = 1.44 and subobscura a, b" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-suzukii-turing-wavelength-s0.py#L61-L63> .

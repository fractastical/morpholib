    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila suzukii Turing onset wavelength at 2.046 µm (0 Ma, detail scale) — Model fidelity to source: 84/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Onset wavenumber, Jacobian trace/determinant, and sigma(k) match Turing 1952 and Schnakenberg 1979, and D_u is solved so lambda_c is 2.046 µm. The first numerical sigma used a pure-u kick, which does not isolate the unstable eigenvector, so the dispersion correlation was 0.970 rather than the law. Kinetics are phenomenological." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.4e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-suzukii-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila suzukii Turing onset wavelength at 2.046 µm (0 Ma, detail scale) — Morphometric validation: 78/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Specimen foreground fraction 0.203 (prior 0.40), melanin fraction 0.028 (prior 0.10), left-right darkness -5.3 gray (null 0), abdominal troughs 7 (tergite prior 6), coherency 0.375 (isotropic prior 0.50). None equals its reference. The pure-u dispersion estimate did not clear Pearson r > 0.98 (r = 0.970). Labyrinth spacing CV is 0.37 and KS against lambda_sigma is 0.63." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-suzukii-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing onset wavenumber" ;
    dct:description "Selects the 2.046 µm pigment-carrier wavelength in extant D. suzukii cuticle (0 Ma) | Variables: f_u, g_v, D_u, D_v at the Schnakenberg steady state" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3207_drosophila_suzukii_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v),  lambda_c = 2 pi / k_c = 2.046 um" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1038/nature04597>,
        <https://doi.org/10.1098/rspb.2013.2840>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/dgd.12661>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3207.traceMicro" ;
    pk:leanTheorem "MathOfBiology.Loop_3207.homogeneous_trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-suzukii-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homogeneous stability (trace and determinant)" ;
    dct:description "Diffusionless state is stable; pattern requires the diffusion-driven band | Variables: Jacobian of Schnakenberg kinetics at (u0, v0) = (a+b, b/(a+b)^2)" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3207_drosophila_suzukii_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "tr(J) = f_u + g_v < 0 and det(J) = f_u g_v - f_v g_u > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1038/nature04597>,
        <https://doi.org/10.1098/rspb.2013.2840>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/dgd.12661>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3207.detMicro" ;
    pk:leanTheorem "MathOfBiology.Loop_3207.homogeneous_determinant_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-suzukii-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries ocellus count" ;
    dct:description "What changes at 2.0 µm and 0 Ma relative to subobscura and takahashii | Variables: L = 24.552 um window; lambda_c,suzukii = 2.046 um; lambda_c,takahashii = 2.4552 um" ;
    dct:source "Gompel 2005 DOI:10.1038/nature03235; Koshikawa 2020 DOI:10.1111/dgd.12661" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3207_drosophila_suzukii_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = floor(L / lambda_c); N_suzukii = 12, N_takahashii = 10, N_subobscura undefined (f_u < 0)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1038/nature04597>,
        <https://doi.org/10.1098/rspb.2013.2840>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/dgd.12661>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3207.nOcelli" ;
    pk:leanTheorem "MathOfBiology.Loop_3207.successor_drops_two_ocelli" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,

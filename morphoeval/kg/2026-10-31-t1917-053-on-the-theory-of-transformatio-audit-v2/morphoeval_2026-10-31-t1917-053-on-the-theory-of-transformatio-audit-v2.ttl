<https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-053> a pk:Claim ;
    rdfs:label "Thompson (1917) Fig. 387: Dimorphodon -> Pteranodon skull coordinate transformation (Dimorphodon macronyx and Pteranodon longiceps (lateral skull outlines))",
        "Thompson (1917) Fig. 387: Dimorphodon -> Pteranodon skull coordinate transformation faithfully reproduces Dimorphodon macronyx and Pteranodon longiceps (lateral skull outlines) morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-053-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-053-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-053-3>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-053-4>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-053-5> ;
    dct:description "The simulation script(s) thompson/claims/t1917-053_on-the-theory-of-transformations.py implement the cited source model as published and produce forms that match real Dimorphodon macronyx and Pteranodon longiceps (lateral skull outlines) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-053_on-the-theory-of-transformations.py> ;
    schema:about "Dimorphodon macronyx and Pteranodon longiceps (lateral skull outlines)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-053_on-the-theory-of-transformations.py; output: docs/media/t1917_053_on_the_theory_of_transformatio_comparison.png; organism: Dimorphodon macronyx and Pteranodon longiceps (lateral skull outlines); environment: n/a; phenomenon_size: 103 µm (0.0001027 m, log10=-3.988 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 103 µm to 15.6 cm): 103 µm:morpho-menelaus-bioelectric-polarity, 363 µm:morpho-menelaus-vertex-packing, 3.5 mm:morpho-menelaus-turing-wavelength, 1.2 cm:morpho-menelaus-clock-wavefront, 2.2 cm:morpho-menelaus-morphogen-condensation, 2.8 cm:morpho-menelaus-flux-canalization, 3.0 cm:morpho-menelaus-elastic-buckling, 3.6 cm:morpho-menelaus-branching-tree" ;
    pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-053-code-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-053-model-fidelity>,

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-053> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-053-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-053-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Fig. 387: Dimorphodon -> Pteranodon skull coordinate transformation — Morphometric validation: 74/100" ;
        dct:date "2026-10-31"^^xsd:date ;
        dct:description "Dense Procrustes, IoU, r, shuffled-null, KS; null p=0.80 not significant." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-053/result.json L30–L31: shuffled null p=0.80 — correspondence not significant at alpha 0.05 <https://github.com/fractastical/morpholib/blob/35d30f4cf/datasets/thompson_1917/t1917-053/result.json#L30-L31>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-053-measurement-affine-procrustes-dense>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-053-measurement-iou-tps>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-053-measurement-jacobian-min-det-t1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-053-measurement-pearson-r-tps>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-053-measurement-procrustes-baseline-dim-pte>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-053-measurement-shuffled-landmark-null-p>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-053-measurement-similarity-procrustes-dense>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-053-measurement-tps-procrustes-dense>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-053-morphometric-validation-1> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

@prefix dct: <http://purl.org/dc/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix pk: <https://w3id.org/delphi/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-053> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-053-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-053-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Fig. 387: Dimorphodon -> Pteranodon skull coordinate transformation — Morphological realism / specimen match: 68/100" ;
        dct:date "2026-10-31"^^xsd:date ;
        dct:description "Fig. 387 CV segmentation + YPM1177 specimen Otsu CV (descriptive)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-053-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-053-specimen-match-2> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-053-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-053_on-the-theory-of-transformations.py L310–L316" ;
        dct:description "specimen_cv on vendored Pteranodon photo" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/35d30f4cf/thompson/claims/t1917-053_on-the-theory-of-transformations.py#L310-L316> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-053-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-053/result.json L20–L35" ;
        dct:description "verdict mixed; automated warp does not beat affine at default landmarks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/35d30f4cf/datasets/thompson_1917/t1917-053/result.json#L20-L35> .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (builder-assessor, Pass 2)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/gemini-4-argon> .
}


<https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-025> a pk:Claim ;
    rdfs:label "Thompson (1917) T1917-025 — radiolarian geodesic spherical lattices (Radiolaria (Haeckel / Challenger plates))",
        "Thompson (1917) T1917-025 — radiolarian geodesic spherical lattices faithfully reproduces Radiolaria (Haeckel / Challenger plates) morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-025-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-025-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-025-3>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-025-4> ;
    dct:description "The simulation script(s) thompson/claims/t1917-025_spicules-geodetics.py implement the cited source model as published and produce forms that match real Radiolaria (Haeckel / Challenger plates) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    schema:about "Radiolaria (Haeckel / Challenger plates)" ;
    schema:additionalProperty "does_not_claim: Quantitative 3-D SEM tomography from 2-D engravings in Pass 1",
        "reconstructed_in_script: Great-circle geodesic edge lengths on icosahedral / Fibonacci-sphere reference nets",
        "reported_in_source: Thompson (1917) Ch. IX-X: latticed siliceous shells as shortest lines on a sphere with near-equal partitions" ;
    pk:context "script(s): None/blob/main/thompson/claims/t1917-025_spicules-geodetics.py; output: docs/media/t1917_025_spicules_geodetics_comparison.png; organism: Radiolaria (Haeckel / Challenger plates); environment: n/a; claim_boundary: [reported_in_source: Thompson (1917) Ch. IX-X: latticed siliceous shells as shortest lines on a sphere with near-equal partitions; reconstructed_in_script: Great-circle geodesic edge lengths on icosahedral / Fibonacci-sphere reference nets; does_not_claim: Quantitative 3-D SEM tomography from 2-D engravings in Pass 1]; other sources: On Growth and Form (1st ed.), Ch. IX-X <https://archive.org/details/ongrowthform1917thom>, Challenger Radiolaria Plate 111 <https://commons.wikimedia.org/wiki/File:Radiolaria_(Challenger)_Plate_111.jpg>" ;
    pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-025-code-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-025-model-fidelity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-025-morphometric-validation>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-025-overall>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-025-parameter-expressivity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-025-repro-package>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-025-source-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-025-specimen-match> ;
    pk:hypothesisType "geometric — geodesic/minimal frameworks on a sphere (Thompson 1917 Ch. IX-X claim T1917-025)" ;
    pk:weightOfEvidence 5.41e-01 .


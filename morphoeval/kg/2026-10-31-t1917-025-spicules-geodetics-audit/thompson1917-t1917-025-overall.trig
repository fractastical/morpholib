@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-025> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-025-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-025-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-025 — radiolarian geodesic spherical lattices — MorphoEval overall 54.1/100" ;
        dct:date "2026-10-31"^^xsd:date ;
        dct:description "Pass 1 baseline: geodesic reference mesh and plate comparison figure, single subdivision frequency, no ablation controls, no result.json, incomplete morphometric GOF block. Overall 54.1/100 (faithfulness 48.7, reproducibility 66.5); rubric morphoeval 0.1.0; checkpoint commit 35d30f4cf; environment: . Dimension assessments: Model fidelity to source 62, Morphological realism / specimen match 48, Parameter expressivity 40, Morphometric validation 38, Source and data traceability 78, Code-to-model traceability 65, Reproducibility package 58. Output judged: docs/media/t1917_025_spicules_geodetics_comparison.png: rendered output of thompson/claims/t1917-025_spicules-geodetics.py, not present when the audit was snapshotted (unfingerprinted). Claim boundary: reported_in_source: Thompson (1917) Ch. IX-X: latticed siliceous shells as shortest lines on a sphere with near-equal partitions; reconstructed_in_script: Great-circle geodesic edge lengths on icosahedral / Fibonacci-sphere reference nets; does_not_claim: Quantitative 3-D SEM tomography from 2-D engravings in Pass 1." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Ablation controls and GOF statistics; write result.json.",
            "remediation needed: Full freq sweep and specimen-matched model selection." ;
        pk:hasScore "0.541"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Cloud Loop Slot 220 Pass 1)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://commons.wikimedia.org/wiki/File:Radiolaria_(Challenger)_Plate_111.jpg> .
    <https://archive.org/details/ongrowthform1917thom> dct:title "On Growth and Form (1st ed.), Ch. IX-X" .
    <https://commons.wikimedia.org/wiki/File:Radiolaria_(Challenger)_Plate_111.jpg> dct:title "Challenger Radiolaria Plate 111" .
}


    <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Huang et al. (2004, 2010) & Pinto & Ermentrout (2001) neocortical spiral wave dynamics & phase singularity topology — Morphometric validation: 54/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Reports only 2 baseline metrics in `measure_morphoeval()`, lacking plaquette topological winding number verification, radial core amplitude deficit fit r against A_inf tanh(r/r_core), wave speed dispersion c = lambda * f_rot, CNQX blockade amplitude suppression, and specimen CV morphometrics." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2013-ermentrout-corticothalamic-seizure-spirals.py L98–L121: Baseline 2-metric measure_morphoeval() hook without plaquette winding or specimen CV metrics <https://github.com/fractastical/morpholib/blob/317bc3c/2013-ermentrout-corticothalamic-seizure-spirals.py#L98-L121>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-huang-et-al-2010-neocortical-spiral-rotation-frequency-f-rot>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ermentrout-corticothalamic-seizure-spirals-measurement-spiral-phase-singularity-core-minimum-amplitude-a-min> ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ermentrout-corticothalamic-seizure-spirals> a pk:Claim ;
        rdfs:label "Huang et al. (2004, 2010) & Pinto & Ermentrout (2001) neocortical spiral wave dynamics & phase singularity topology faithfully reproduces Rattus norvegicus / Homo sapiens tangential neocortical sheet (Layers III-V) morphology" ;
        dct:description "The simulation script(s) 2013-ermentrout-corticothalamic-seizure-spirals.py implement the cited source model as published and produce forms that match real Rattus norvegicus / Homo sapiens tangential neocortical sheet (Layers III-V) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 55.9/100, audit 2026-10-19-corticothalamic-seizure-spirals-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2013-ermentrout-corticothalamic-seizure-spirals.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2013-ermentrout-corticothalamic-seizure-spirals.py; output: docs/media/corticothalamic_seizure_spirals_comparison.png; organism: Rattus norvegicus / Homo sapiens tangential neocortical sheet (Layers III-V); checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 8e19f210a705689fed055999b0cf4bc7b4186b66538d2729cc57db348f32af80; artifact_sha256: 168c38a1491d8d8b8390557426a55422a51df364d866344764fec9d005fd7c92; input_dataset_sha256: {datasets/corticothalamic_seizure_spirals/corticothalamic_seizure_spirals_reference.json=3570a9b466035f9e..., datasets/corticothalamic_seizure_spirals/paper_citations.bib=2ea747169ffdca2a..., datasets/corticothalamic_seizure_spirals/rat_neocortical_tangential_sheet_specimen.jpg=c4fdfb27cd39c842..., datasets/corticothalamic_seizure_spirals/scout_manifest.json=e31d28291faa189a...}" ;
        pk:derivedFromPaper <https://doi.org/10.1137/S0036139900346453>,
            <https://doi.org/10.1523/JNEUROSCI.2547-10.2010>,
            <https://doi.org/10.1523/JNEUROSCI.2705-04.2010>,
            <https://doi.org/10.1523/JNEUROSCI.4663-14.2015> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-ermentrout-corticothalamic-seizure-spirals-specimen-match> ;
        pk:weightOfEvidence "0.559"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/317bc3c/2013-ermentrout-corticothalamic-seizure-spirals.py> a schema:SoftwareSourceCode ;
        rdfs:label "2013-ermentrout-corticothalamic-seizure-spirals.py" ;

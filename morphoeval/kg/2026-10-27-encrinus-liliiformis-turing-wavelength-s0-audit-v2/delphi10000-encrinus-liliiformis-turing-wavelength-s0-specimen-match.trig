sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Encrinus liliiformis Schnakenberg wavelength at 12 nm (Muschelkalk, 240 Ma) — Morphological realism / specimen match: 76/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Last GIF frame versus the CC BY-SA Ingelfingen slab has CV similarity 84.6 (orientation, radial FFT, coherency, occupancy). The comparison figure shows the slab and the rings side by side. They are not the same silhouette: one is a crown on limestone, the other is the radial stereom mode. 76 credits the shared calcite palette and the radial profile overlay without calling them the same picture." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/encrinus_liliiformis_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "four-panel comparison at 12 nm and 240 Ma — docs/media/encrinus_liliiformis_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-encrinus-liliiformis-turing-wavelength-s0.py at cd3c0ff20113e2850a5dd72a24dfd8d4e782b322, image/png, 725947 B, 1456×1092 px, artifact_sha256 f172842057f584571e80ded76c4691c784b4f9e36c8eb9e4a2192ed76327ba48 (sha256 f172842057f584571e80ded76c4691c784b4f9e36c8eb9e4a2192ed76327ba48), spec_fingerprint a01502a8a9ccbc4b5251448c56820781f74c49be8d38d864003cd60c668e74f1" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;

<https://w3id.org/delphi/resource/math-law/delphi10000-encrinus-liliiformis-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg trace is negative at the 12 nm point" ;
    dct:description "Homogeneous state is stable without diffusion | Variables: a=0.047, b=1.153, lambda=1.238e-8 m, age=240 Ma" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/cd3c0ff20113e2850a5dd72a24dfd8d4e782b322/models/2026-delphi10000-encrinus-liliiformis-turing-wavelength-s0.py#L106-L135>,
        <https://github.com/fractastical/morpholib/blob/cd3c0ff20113e2850a5dd72a24dfd8d4e782b322/morphoeval/lean/loops/Loop_3218_encrinus_liliiformis_turing_wavelength_s0.lean#L34-L37> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "f_u + g_v = 553/600 - 36/25 < 0 for a=47/1000, b=1153/1000" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.4202/app.2009.0108> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3218.schnakenberg_trace_negative" ;
    pk:leanTheorem "MathOfBiology.Loop_3218.schnakenberg_trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-encrinus-liliiformis-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Inhibitor drive versus equal-diffusion ablation" ;
    dct:description "Turing wavenumber exists only when the inhibitor diffuses faster | Variables: delta=22.4 at 12 nm; ablation delta=1" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/cd3c0ff20113e2850a5dd72a24dfd8d4e782b322/models/2026-delphi10000-encrinus-liliiformis-turing-wavelength-s0.py#L156-L163>,
        <https://github.com/fractastical/morpholib/blob/cd3c0ff20113e2850a5dd72a24dfd8d4e782b322/morphoeval/lean/loops/Loop_3218_encrinus_liliiformis_turing_wavelength_s0.lean#L39-L42> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "delta=112/5 gives delta*f_u + g_v > 0; delta=1 does not" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.4202/app.2009.0108> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3218.inhibitor_drive_positive_and_equal_diffusion_fails" ;
    pk:leanTheorem "MathOfBiology.Loop_3218.inhibitor_drive_positive_and_equal_diffusion_fails" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-encrinus-liliiformis-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Muschelkalk wavelength is the chronoseries minimum" ;
    dct:description "What changes at this age relative to the neighboring grades | Variables: Holocrinus 248 Ma, Encrinus 240 Ma, Chelocrinus 232 Ma" ;
    dct:source "Stolarski, Gorzelak et al. 2009 DOI:10.4202/app.2009.0108" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/cd3c0ff20113e2850a5dd72a24dfd8d4e782b322/models/2026-delphi10000-encrinus-liliiformis-turing-wavelength-s0.py#L50-L76>,
        <https://github.com/fractastical/morpholib/blob/cd3c0ff20113e2850a5dd72a24dfd8d4e782b322/morphoeval/lean/loops/Loop_3218_encrinus_liliiformis_turing_wavelength_s0.lean#L18-L21> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "12.380 nm < 15.640 nm < 18.720 nm and 232 Ma < 240 Ma < 248 Ma" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.4202/app.2009.0108> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3218.muschelkalk_wavelength_is_chronoseries_minimum" ;
    pk:leanTheorem "MathOfBiology.Loop_3218.muschelkalk_wavelength_is_chronoseries_minimum" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-encrinus-liliiformis-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Nanograin mode packing and wavenumber peak" ;
    dct:description "Places the detail-scale wavelength inside one published nanograin | Variables: nanograin 100 nm from Stolarski et al. 2009; this slot wavelength 12 nm" ;
    dct:source "Stolarski, Gorzelak et al. 2009 DOI:10.4202/app.2009.0108" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/cd3c0ff20113e2850a5dd72a24dfd8d4e782b322/models/2026-delphi10000-encrinus-liliiformis-turing-wavelength-s0.py#L165-L187>,
        <https://github.com/fractastical/morpholib/blob/cd3c0ff20113e2850a5dd72a24dfd8d4e782b322/morphoeval/lean/loops/Loop_3218_encrinus_liliiformis_turing_wavelength_s0.lean#L23-L48> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "100 nm grain holds 8 wavelengths of 12.38 nm, more than the 15.64 nm or 18.72 nm neighbors" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.4202/app.2009.0108> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3218.nanograin_packs_more_encrinus_wavelengths" ;
    pk:leanTheorem "MathOfBiology.Loop_3218.wavenumber_peaks_in_the_muschelkalk" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;

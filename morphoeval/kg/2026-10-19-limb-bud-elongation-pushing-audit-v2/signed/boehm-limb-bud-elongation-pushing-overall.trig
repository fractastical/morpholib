sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-boehm-limb-bud-elongation-pushing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-overall> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Boehm et al. (2010) & Gros et al. (2010) vertebrate limb bud oriented cell division & Wnt5a/FGF8 pushing vs proliferation-gradient hypothesis — MorphoEval overall 94.0/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Pass 2 (v2) evaluation of `2015-boehm-limb-bud-elongation-pushing.py` (overall weighted score: 93.8/100, up from 57.3/100 in v1). The remediated script solves the 2D/3D continuum artificial-compressibility pressure-Poisson & Stokes velocity field (`nabla . v = s(x)`, `-nabla p + (1/Re)*nabla^2 v + nabla . sigma_active = 0`) coupled to Wnt5a/JNK oriented cell division active stress and AER-FGF8/MAPK velocity gradients; reproduces the 5-regime PD elongation hierarchy (Pearson r = 0.9970, RMSE = 1.232%) and E11.5 aspect-ratio hierarchy (Pearson r = 0.9920, RMSE = 0.0801); confirms 5-decade Reynolds-number insensitivity (Re in [10^-6, 10^-1], r = 0.9995, span = 8.60 percentage points); demonstrates the 11.74x Hooke-Jeeves inverse-optimization proliferation gap; and segments 5 sub-panels of the SHA-256-locked OPT specimen image `mouse_limb_bud_specimen.jpg`. Overall 94.0/100 (faithfulness 93.9, reproducibility 94.3); rubric morphoeval 0.1.0; checkpoint commit 317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1. Dimension assessments: Model fidelity to source 94, Morphological realism / specimen match 93, Parameter expressivity 94, Morphometric validation 95, Source and data traceability 95, Code-to-model traceability 94, Reproducibility package 94. Output judged: docs/media/limb_bud_elongation_pushing_comparison.png: rendered output of 2015-boehm-limb-bud-elongation-pushing.py at 317bc3c, image/png, 991910 B, 3300×1380 px, artifact_sha256 e809b1fc6f9248c8c9eb080564b3429e238a87fbb5a336ba5d352fa9851d9379 (sha256 e809b1fc6f9248c8c9eb080564b3429e238a87fbb5a336ba5d352fa9851d9379), spec_fingerprint 4c3f0cfc301e2c955c4f4f6c7d2e02e3996ca3b4cd571d212368d55baab36b29. Dual provenance: spec_fingerprint: 4c3f0cfc301e2c955c4f4f6c7d2e02e3996ca3b4cd571d212368d55baab36b29; artifact_sha256: e809b1fc6f9248c8c9eb080564b3429e238a87fbb5a336ba5d352fa9851d9379. Supersedes audit: 2026-10-19-limb-bud-elongation-pushing-audit." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Extend the 2D mid-plane pressure-Poisson solver to an unstructured 3D tetrahedral finite-element mesh imported directly from Optical Projection Tomography iso-surfaces." ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 017 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


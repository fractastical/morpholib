    <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Boehm et al. (2010) & Gros et al. (2010) vertebrate limb bud oriented cell division & Wnt5a/FGF8 pushing vs proliferation-gradient hypothesis — Parameter expressivity: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates all 5 biological perturbation regimes (`evaluate_all_five_regimes`, L464-514), a 6-point Reynolds number sensitivity sweep across 5 orders of magnitude Re in [10^-6, 10^-1] (`run_reynolds_and_2d_parameter_sweeps`, L517-571), and a 25-point 5x5 2D morphospace grid over (zeta_OCD, chi_FGF), plus CLI flags `--zeta-ocd`, `--chi-fgf`, `--reynolds`, `--hours`, `--seed`, `--output`, `--gif`, and `--self-test` (L1158-1188)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-parameter-expressivity-2> ;
        pk:hasScore "0.94"^^xsd:double ;

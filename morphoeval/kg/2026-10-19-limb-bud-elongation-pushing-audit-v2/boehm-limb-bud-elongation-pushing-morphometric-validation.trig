sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-boehm-limb-bud-elongation-pushing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Boehm et al. (2010) & Gros et al. (2010) vertebrate limb bud oriented cell division & Wnt5a/FGF8 pushing vs proliferation-gradient hypothesis — Morphometric validation: 95/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L998-1090) computes 8 reference-anchored morphometric measurements: 5-regime 6h PD elongation Pearson r = 0.9970 (RMSE = 1.232%), 5-regime E11.5 aspect-ratio Pearson r = 0.9920 (RMSE = 0.0801), Model II WT 6h PD elongation = 43.3706% (ref 42.16%), Model I negative control = 10.1843% (ref 10.10%), 5-decade Reynolds sensitivity span = 8.6005 percentage points (ref 8.4, r = 0.9995), Specimen Panel F posterior St1/St0 ratio = 1.3587 (derived_from: specimen), Specimen Panel D/E 3D OPT iso-surface AR gain = 1.1732 (derived_from: specimen), and Hooke-Jeeves inverse-opt to empirical distal source ratio = 11.7357 (ref 11.7358)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-5-regime-6h-pd-elongation-hierarchy-pearson-r-vs-empirical>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-5-regime-e11-5-aspect-ratio-l-pd-w-ap-pearson-r-vs-empirical>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-hooke-jeeves-inverse-opt-to-empirical-distal-source-ratio-s-opt-1-s-emp-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-i-isotropic-proliferation-6h-pd-elongation-at-re-10-2-negative-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-ii-wild-type-6h-pd-elongation-vs-opt-st0-st1-benchmark>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-reynolds-number-5-decade-sensitivity-span-re-in-10-6-10-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-specimen-panel-d-vs-panel-e-3d-opt-iso-surface-aspect-ratio-gain>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-specimen-panel-f-posterior-dv-pd-st1-st0-elongation-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-morphometric-validation-1> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-5-regime-6h-pd-elongation-hierarchy-pearson-r-vs-empirical> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "5-regime 6h PD elongation hierarchy Pearson r vs empirical = 0.997 Pearson r" ;
        dct:description "RMSE = 1.232% across WT, FGF-only, Wnt5a-/-, Model I, and Uniform controls" ;
        schema:measurementTechnique "evaluate_all_five_regimes (RMSE = 1.232%)" ;
        schema:name "5-regime 6h PD elongation hierarchy Pearson r vs empirical" ;
        schema:unitText "Pearson r" ;
        schema:value "0.997" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-5-regime-6h-pd-elongation-hierarchy-pearson-r-vs-empirical-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-5-regime-6h-pd-elongation-hierarchy-pearson-r-vs-empirical-reference> a schema:PropertyValue ;
        dct:source "Boehm et al. (2010) PLoS Biol. 8:e1000420 Figs. 4, S8 & Gros et al. (2010) Curr. Biol. 20:1993" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-5-regime-e11-5-aspect-ratio-l-pd-w-ap-pearson-r-vs-empirical> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "5-regime E11.5 aspect ratio L_PD/W_AP Pearson r vs empirical = 0.992 Pearson r" ;
        dct:description "WT AR = 2.298 vs Model I bulbous AR = 1.115 and Wnt5a-/- AR = 1.286 (RMSE = 0.0801)" ;
        schema:measurementTechnique "evaluate_all_five_regimes E11.5 L_PD/W_AP (RMSE = 0.0801)" ;
        schema:name "5-regime E11.5 aspect ratio L_PD/W_AP Pearson r vs empirical" ;
        schema:unitText "Pearson r" ;
        schema:value "0.992" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-5-regime-e11-5-aspect-ratio-l-pd-w-ap-pearson-r-vs-empirical-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-5-regime-e11-5-aspect-ratio-l-pd-w-ap-pearson-r-vs-empirical-reference> a schema:PropertyValue ;
        dct:source "Gros et al. (2010) Current Biology 20:1993-2004 Figs. 1-6 & Boehm et al. (2010) PLoS Biol. 8:e1000420" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-hooke-jeeves-inverse-opt-to-empirical-distal-source-ratio-s-opt-1-s-emp-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hooke-Jeeves inverse-opt to empirical distal source ratio s_opt(1)/s_emp(1) = 11.7357 s_opt / s_emp" ;
        dct:description "Demonstrates >11x net (>8.5x gross) proliferation gap proving isotropic growth is biologically unrealistic" ;
        schema:measurementTechnique "compute_iddu_brdu_atlas_profile(x_pd_norm=1.0) inverse-opt vs empirical net rate" ;
        schema:name "Hooke-Jeeves inverse-opt to empirical distal source ratio s_opt(1)/s_emp(1)" ;
        schema:unitText "s_opt / s_emp" ;
        schema:value "11.7357" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-hooke-jeeves-inverse-opt-to-empirical-distal-source-ratio-s-opt-1-s-emp-1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-hooke-jeeves-inverse-opt-to-empirical-distal-source-ratio-s-opt-1-s-emp-1-reference> a schema:PropertyValue ;
        dct:source "Boehm et al. (2010) PLoS Biology 8:e1000420 Figs. 6D & 9C (0.54 h^-1 vs 0.046 h^-1 net)" ;
        schema:value "11.7358" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-i-isotropic-proliferation-6h-pd-elongation-at-re-10-2-negative-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Model I isotropic proliferation 6h PD elongation at Re=10^-2 (negative control) = 10.1843 %" ;
        dct:description "Refutes pure proliferation-gradient hypothesis (bulbous expansion ~10.1% vs empirical 42.2%)" ;
        schema:measurementTechnique "simulate_limb_bud_regime(model_i_isotropic_proliferation_gradient, Re=1e-2)" ;
        schema:name "Model I isotropic proliferation 6h PD elongation at Re=10^-2 (negative control)" ;
        schema:unitText "%" ;
        schema:value "10.1843" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-i-isotropic-proliferation-6h-pd-elongation-at-re-10-2-negative-control-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-i-isotropic-proliferation-6h-pd-elongation-at-re-10-2-negative-control-reference> a schema:PropertyValue ;
        dct:source "Boehm et al. (2010) PLoS Biology 8:e1000420 Fig. 4 & Fig. S3" ;
        schema:value "10.1" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-ii-wild-type-6h-pd-elongation-vs-opt-st0-st1-benchmark> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Model II wild-type 6h PD elongation vs OPT St0->St1 benchmark = 43.3706 %" ;
        dct:description "Directional Wnt5a/JNK oriented cell division + AER-FGF8 velocity field reproduces +42.2% PD outgrowth" ;
        schema:measurementTechnique "simulate_limb_bud_regime(model_ii_wt_directional_pushing, 6.0 h)" ;
        schema:name "Model II wild-type 6h PD elongation vs OPT St0->St1 benchmark" ;
        schema:unitText "%" ;
        schema:value "43.3706" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-ii-wild-type-6h-pd-elongation-vs-opt-st0-st1-benchmark-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-ii-wild-type-6h-pd-elongation-vs-opt-st0-st1-benchmark-reference> a schema:PropertyValue ;
        dct:source "Boehm et al. (2010) PLoS Biology 8:e1000420 Fig. 2 (1020 um -> 1450 um in 6 h)" ;
        schema:value "42.16" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-reynolds-number-5-decade-sensitivity-span-re-in-10-6-10-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Reynolds number 5-decade sensitivity span (Re in [10^-6, 10^-1]) = 8.6005 percentage points" ;
        dct:description "Confirms viscosity insensitivity (<9 percentage points variation across 5 decades, r = 0.9995)" ;
        schema:measurementTechnique "run_reynolds_and_2d_parameter_sweeps (Pearson r = 0.9995)" ;
        schema:name "Reynolds number 5-decade sensitivity span (Re in [10^-6, 10^-1])" ;
        schema:unitText "percentage points" ;
        schema:value "8.6005" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-reynolds-number-5-decade-sensitivity-span-re-in-10-6-10-1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-reynolds-number-5-decade-sensitivity-span-re-in-10-6-10-1-reference> a schema:PropertyValue ;
        dct:source "Boehm et al. (2010) PLoS Biology 8:e1000420 Fig. S3 (3.4% to 11.8% across 5 orders of magnitude)" ;
        schema:value "8.4" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-specimen-panel-d-vs-panel-e-3d-opt-iso-surface-aspect-ratio-gain> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Specimen Panel D vs Panel E 3D OPT iso-surface aspect ratio gain = 1.1732 AR(St1) / AR(St0)" ;
        dct:description "St0 AR = 1.0049 -> St1 AR = 1.1789" ;
        schema:measurementTechnique "segment_limb_bud_specimen Panels D & E connected-component bounding-box ratio" ;
        schema:name "Specimen Panel D vs Panel E 3D OPT iso-surface aspect ratio gain" ;
        schema:unitText "AR(St1) / AR(St0)" ;
        schema:value "1.1732" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-specimen-panel-d-vs-panel-e-3d-opt-iso-surface-aspect-ratio-gain-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-specimen-panel-d-vs-panel-e-3d-opt-iso-surface-aspect-ratio-gain-reference> a schema:PropertyValue ;
        dct:source "Boehm et al. (2010) PLoS Biology 8:e1000420 Fig. 2D-E (mouse_limb_bud_specimen.jpg)" ;
        schema:value "1.1732" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-specimen-panel-f-posterior-dv-pd-st1-st0-elongation-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Specimen Panel F posterior DV-PD St1/St0 elongation ratio = 1.3587 L_PD(St1) / L_PD(St0)" ;
        dct:description "Aspect ratio increases from 1.0888 (St0) to 1.3021 (St1)" ;
        schema:measurementTechnique "segment_limb_bud_specimen Panel F posterior view contour segmentation" ;
        schema:name "Specimen Panel F posterior DV-PD St1/St0 elongation ratio" ;
        schema:unitText "L_PD(St1) / L_PD(St0)" ;
        schema:value "1.3587" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-specimen-panel-f-posterior-dv-pd-st1-st0-elongation-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-specimen-panel-f-posterior-dv-pd-st1-st0-elongation-ratio-reference> a schema:PropertyValue ;
        dct:source "Boehm et al. (2010) PLoS Biology 8:e1000420 Fig. 2F (mouse_limb_bud_specimen.jpg)" ;
        schema:value "1.3587" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2015-boehm-limb-bud-elongation-pushing.py L998–L1090" ;
        dct:description "8 quantitative reference-anchored morphometric measurements including 2 specimen-derived metrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2015-boehm-limb-bud-elongation-pushing.py#L998-L1090> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 017 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;

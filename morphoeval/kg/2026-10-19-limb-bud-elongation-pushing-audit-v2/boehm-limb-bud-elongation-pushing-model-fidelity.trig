sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-boehm-limb-bud-elongation-pushing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Boehm et al. (2010) & Gros et al. (2010) vertebrate limb bud oriented cell division & Wnt5a/FGF8 pushing vs proliferation-gradient hypothesis — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements 3D principal strain-rate decomposition (`compute_principal_strain_rates`, L128-153), empirical dual-label IddU/BrdU cell-cycle source profiles vs Hooke-Jeeves inverse-optimized sources (`compute_iddu_brdu_atlas_profile`, L156-199), an artificial-compressibility pressure-Poisson and viscous velocity solver (`solve_continuum_pressure_velocity_field`, L205-294), and 12-substep RK2 Lagrangian boundary and marker-clone advection across all 5 experimental regimes (`simulate_limb_bud_regime`, L297-461), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_017_limb_bud_elongation_pushing.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2015-boehm-limb-bud-elongation-pushing.py L128–L199" ;
        dct:description "3D principal strain-rate laws and IddU/BrdU vs Hooke-Jeeves inverse-optimized source profiles" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2015-boehm-limb-bud-elongation-pushing.py#L128-L199> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2015-boehm-limb-bud-elongation-pushing.py L205–L461" ;
        dct:description "Continuum artificial-compressibility pressure-Poisson & Stokes velocity solver and 5-regime simulator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2015-boehm-limb-bud-elongation-pushing.py#L205-L461> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_017_limb_bud_elongation_pushing.lean L21–L152" ;
        dct:description "3 machine-checked Lean 4 theorems for zero deviatoric strain, Wnt5a/FGF anisotropic stress, and IddU/BrdU bounds (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_017_limb_bud_elongation_pushing.lean#L21-L152> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 017 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-divergence-angle-g006> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fibonacci_divergence_angle_G006 = 137.3193 deg" ;
        schema:measurementTechnique "Iterative dipole energy minimization at G=0.06 (last 20 drops mean Δφ)" ;
        schema:name "fibonacci_divergence_angle_G006" ;
        schema:unitText "deg" ;
        schema:value "137.3193" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-divergence-angle-g006-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-divergence-angle-g006-reference> a schema:PropertyValue ;
        schema:value "137.5078" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Douady & Couder (1992, 1996) ferrofluid magnetic-drop iterative repulsive phyllotaxis — Morphometric validation: 44/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L275-291) returns only 2 scalar divergence angles (at G=0.06 and G=0.92) without Delaunay contact parastichy pair extraction (m, n), without comparison to `magnetic_drop_phyllotaxis_reference.json` benchmark curves, without goodness-of-fit statistics (Pearson r, RMSE, KS test), and without empirical conifer cone parastichy measurements." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1992-douady-magnetic-drop-phyllotaxis.py L275–L291: Only 2 scalar measurements in measure_morphoeval() with no Delaunay parastichy counts or statistical tests <https://github.com/fractastical/morpholib/blob/317bc3c/1992-douady-magnetic-drop-phyllotaxis.py#L275-L291>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-distichous-divergence-angle-g092>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-divergence-angle-g006> ;
        pk:hasScore "0.44"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

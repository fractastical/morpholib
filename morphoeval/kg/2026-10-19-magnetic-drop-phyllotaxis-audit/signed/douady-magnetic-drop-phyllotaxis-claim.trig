sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-douady-magnetic-drop-phyllotaxis> a pk:Claim ;
        rdfs:label "Douady & Couder (1992, 1996) ferrofluid magnetic-drop iterative repulsive phyllotaxis faithfully reproduces Conifer seed cone (Pinus sp.) & Helianthus annuus phyllotactic primordia morphology" ;
        dcterms:description "The simulation script(s) 1992-douady-magnetic-drop-phyllotaxis.py implement the cited source model as published and produce forms that match real Conifer seed cone (Pinus sp.) & Helianthus annuus phyllotactic primordia specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 48.2/100, audit 2026-10-19-magnetic-drop-phyllotaxis-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/317bc3c/1992-douady-magnetic-drop-phyllotaxis.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/1992-douady-magnetic-drop-phyllotaxis.py; output: docs/media/magnetic_drop_phyllotaxis_comparison.png; organism: Conifer seed cone (Pinus sp.) & Helianthus annuus phyllotactic primordia; checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 33eddc6c7f7154d2ce87a1a999bc4ec67c98aaa43e0d2412fb26a2fc20bc5041; artifact_sha256: ef80ca944c2794c45e245c405a7cdfa1e25ee9131b25f4517e1988b2b99c6e57; input_dataset_sha256: {datasets/magnetic_drop_phyllotaxis/conifer_cone_specimen.jpg=7bcb68e856d4db53..., datasets/magnetic_drop_phyllotaxis/magnetic_drop_phyllotaxis_reference.json=9ae33106a0fea23f..., datasets/magnetic_drop_phyllotaxis/paper_citations.bib=2c3aa1ec0e4c53de...}" ;
        pk:derivedFromPaper <https://doi.org/10.1006/jtbi.1996.0024>,
            <https://doi.org/10.1006/jtbi.1996.0025>,
            <https://doi.org/10.1103/PhysRevLett.68.2098>,
            <https://doi.org/10.1209/0295-5075/14/6/006> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-overall>,

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-douady-magnetic-drop-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Douady & Couder (1992, 1996) ferrofluid magnetic-drop iterative repulsive phyllotaxis — Source and data traceability: 68/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`datasets/magnetic_drop_phyllotaxis/` contains `magnetic_drop_phyllotaxis_reference.json`, `conifer_cone_specimen.jpg`, and `paper_citations.bib`, but the v1 script does not load or verify the SHA-256 digests of the reference JSON or specimen image at runtime." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "1992-douady-magnetic-drop-phyllotaxis.py L29–L36: Defines REF_JSON path but never loads or verifies SHA-256 hashes at runtime <https://github.com/fractastical/morpholib/blob/317bc3c/1992-douady-magnetic-drop-phyllotaxis.py#L29-L36>" ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


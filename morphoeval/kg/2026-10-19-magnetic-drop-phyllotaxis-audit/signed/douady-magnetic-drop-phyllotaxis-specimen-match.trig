sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-douady-magnetic-drop-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Douady & Couder (1992, 1996) ferrofluid magnetic-drop iterative repulsive phyllotaxis — Morphological realism / specimen match: 22/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Although `datasets/magnetic_drop_phyllotaxis/conifer_cone_specimen.jpg` is vendored in the dataset directory, the v1 script never loads, displays, or segments the conifer cone photograph (`docs/media/magnetic_drop_phyllotaxis_comparison.png` shows only 6 synthetic plots)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1992-douady-magnetic-drop-phyllotaxis.py L174–L246: 6-panel figure renders only synthetic simulations with zero biological specimen image or segmentation <https://github.com/fractastical/morpholib/blob/317bc3c/1992-douady-magnetic-drop-phyllotaxis.py#L174-L246>",
            "docs/media/magnetic_drop_phyllotaxis_comparison.png (generated output, not in repo): Baseline 2x3 synthetic figure lacking conifer cone specimen comparison — docs/media/magnetic_drop_phyllotaxis_comparison.png: rendered output of 1992-douady-magnetic-drop-phyllotaxis.py at 317bc3c, image/png, 239042 B, 1960×1232 px, artifact_sha256 ef80ca944c2794c45e245c405a7cdfa1e25ee9131b25f4517e1988b2b99c6e57 (sha256 ef80ca944c2794c45e245c405a7cdfa1e25ee9131b25f4517e1988b2b99c6e57), spec_fingerprint 33eddc6c7f7154d2ce87a1a999bc4ec67c98aaa43e0d2412fb26a2fc20bc5041" ;
        pk:hasScore "0.22"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


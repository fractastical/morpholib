sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-douady-magnetic-drop-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Douady & Couder (1992, 1996) ferrofluid magnetic-drop iterative repulsive phyllotaxis — Parameter expressivity: 46/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Simulates 4 fixed-G values (0.92, 0.30, 0.14, 0.06) and an adiabatic ramp, but lacks a universality sweep across dipole interaction exponents gamma in {1, 3, 5}, lacks the Lucas branch initial-condition basin, lacks negative/ablation controls (such as N_mem=1 memory truncation or zero-repulsion random placement), and exposes no CLI parameters for G, gamma, or advection mode (L302-313)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1992-douady-magnetic-drop-phyllotaxis.py L177–L182: Only 4 fixed-G Fibonacci points without Lucas basin, gamma sweep, or ablation controls <https://github.com/fractastical/morpholib/blob/317bc3c/1992-douady-magnetic-drop-phyllotaxis.py#L177-L182>",
            "1992-douady-magnetic-drop-phyllotaxis.py L302–L313: CLI supports only --self-test and --skip-gif <https://github.com/fractastical/morpholib/blob/317bc3c/1992-douady-magnetic-drop-phyllotaxis.py#L302-L313>" ;
        pk:hasScore "0.46"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


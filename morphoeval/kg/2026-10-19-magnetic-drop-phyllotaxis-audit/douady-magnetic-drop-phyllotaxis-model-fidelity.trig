sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-douady-magnetic-drop-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Douady & Couder (1992, 1996) ferrofluid magnetic-drop iterative repulsive phyllotaxis — Model fidelity to source: 58/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements the iterative dipole repulsion potential E(phi) = sum_k d_k(phi, phi_{n-k})^{-3} on the meristem rim (L38-88) and adiabatic Fibonacci ramp (L142-171). However, v1 only implements exponential advection r_k = exp(k*G) without Douady & Couder's (1992) physical silicone-oil dish linear advection r_k = 1 + k*G, does not solve the analytical opposition-to-spiral pitchfork bifurcation condition, does not compute the exact regular-spiral zero-force curves F(G, Delta_phi) = 0, and omits the disconnected Lucas branch (1,3)->(3,4)->(4,7)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1992-douady-magnetic-drop-phyllotaxis.py L142–L171: Adiabatic ramp tracks only main Fibonacci branch without Lucas saddle-node branch <https://github.com/fractastical/morpholib/blob/317bc3c/1992-douady-magnetic-drop-phyllotaxis.py#L142-L171>",
            "1992-douady-magnetic-drop-phyllotaxis.py L38–L88: Exponential-only dipole energy minimization without linear advection or exact equilibrium branch solver <https://github.com/fractastical/morpholib/blob/317bc3c/1992-douady-magnetic-drop-phyllotaxis.py#L38-L88>" ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


    pk:evidenceAgainst "1992-douady-magnetic-drop-phyllotaxis.py L177–L182: Only 4 fixed-G Fibonacci points without Lucas basin, gamma sweep, or ablation controls <https://github.com/fractastical/morpholib/blob/317bc3c/1992-douady-magnetic-drop-phyllotaxis.py#L177-L182>",
        "1992-douady-magnetic-drop-phyllotaxis.py L302–L313: CLI supports only --self-test and --skip-gif <https://github.com/fractastical/morpholib/blob/317bc3c/1992-douady-magnetic-drop-phyllotaxis.py#L302-L313>" ;
    pk:hasScore 4.6e-01 ;
    pk:hasVerdict "partially faithful" .


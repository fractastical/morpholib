sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Gasterosteus doryssus_late Turing wavelength at 27 µm (9.99 Ma) — Model fidelity to source: 80/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Continuum sigma(k), the periodic-grid symbol, the 1D Schnakenberg ring and the equal-diffusion control implement the cited dispersion relation. Deduction: the animated ocellus is a kinematic far-field spiral at a fixed pitch, not a 2D integration of the same PDE." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "models/2026-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0.py L298–L316: GIF is a kinematic spiral, not the 2D PDE <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0.py#L298-L316>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0.py L84–L125" ;
        dct:description "sigma(k), continuum k_m, discrete Laplacian symbol" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0.py#L84-L125> .

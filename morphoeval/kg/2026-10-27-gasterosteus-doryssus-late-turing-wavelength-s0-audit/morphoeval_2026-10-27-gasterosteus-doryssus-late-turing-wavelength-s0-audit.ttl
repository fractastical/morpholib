        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;

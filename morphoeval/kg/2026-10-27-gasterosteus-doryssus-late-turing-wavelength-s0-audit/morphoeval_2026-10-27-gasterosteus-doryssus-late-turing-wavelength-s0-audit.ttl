<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg trace-stability without diffusion" ;
    dct:description "Homogeneous dermal state is stable until diffusion splits the eigenvalues | Variables: f_u = 2/3, g_v = -36/25 at steady state (6/5, 25/36)" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3231_gasterosteus_doryssus_late_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "tr J = f_u + g_v = -58/75 < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1558-5646.2007.00310.x>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3231.traceNum" ;
    pk:leanTheorem "MathOfBiology.Loop_3231.trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing inequality at inhibitor ratio r = 25" ;
    dct:description "Opens a finite band of unstable wavenumbers at the 27 µm detail scale | Variables: r = D_v/D_u = 25, det J = 36/25" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; Kondo & Miura (2010) DOI:10.1126/science.1179047" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3231_gasterosteus_doryssus_late_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(D_v f_u + D_u g_v)^2 > 4 D_u D_v det J, cleared as 1142^2 > 144 * 75^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1558-5646.2007.00310.x>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3231.turing_inequality_r25" ;
    pk:leanTheorem "MathOfBiology.Loop_3231.turing_inequality_r25" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronospecies ordering of fastest-mode wavelength" ;
    dct:description "Pelvic-loss stage (9.99 Ma) shortens the cellular pigment wavelength relative to vestigial-spine doryssus_mid and remains longer than the plated marine successor | Variables: wavelengths stored in nanometres 21480, 27070, 33620" ;
    dct:source "Hunt, Bell & Travis (2008) DOI:10.1111/j.1558-5646.2007.00310.x" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gasterosteus-doryssus-late-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3231_gasterosteus_doryssus_late_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "λ_marine (21.48 µm) < λ_late (27.07 µm) < λ_mid (33.62 µm), and D_u ∝ λ_m^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1558-5646.2007.00310.x>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3231.chronospecies_wavelength_order" ;
    pk:leanTheorem "MathOfBiology.Loop_3231.chronospecies_wavelength_order" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


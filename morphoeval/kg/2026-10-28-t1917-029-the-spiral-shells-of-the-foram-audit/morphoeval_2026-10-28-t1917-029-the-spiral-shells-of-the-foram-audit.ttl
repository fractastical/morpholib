    pk:evidenceAgainst "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L367–L377: four fixed morph tuples; no sweep <https://github.com/fractastical/morpholib/blob/0eb517d23d79fca6826d903b09d425781dd017b4/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L367-L377>" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-parameter-expressivity-1> ;
    pk:hasScore 5e-01 ;
    pk:hasVerdict "partially faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-repro-package-builder-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;

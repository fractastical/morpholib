sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-029> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-morphometric-validation-builder-assessor-claude-fable-5-1> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-morphometric-validation-builder-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-029: logarithmic-spiral chamber succession with constant ratio vs Shi (2021) fusulinid half-whorl series — Morphometric validation: 62/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Strong core: 106 specimens x ~13 stages, per-specimen r / RMSE / ratio CV / BIC vs arithmetic, genus means with SD, and an explicit comparison with Thompson's printed 1.225 and 1.5 (T3 passes at 1.239 / 1.53). Thompson's own tables are refitted and his stated ratios recovered. Docked because: no confidence intervals or KS/normality test on residuals; T2 (CV <= 0.15) cannot detect the systematic ontogenetic hump of the pseudoschwagerines seen in panel G; T4 uses an uncalibrated threshold whose null expectation (~6.6 for n ~ 96) exceeds the cut-off, so the v1 FAIL is an artefact of the statistic, not of the data; no negative control." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L309–L339: verdict_from_metrics: T1-T4 rules; T2 is CV-only, T4 threshold 6.0 is arbitrary <https://github.com/fractastical/morpholib/blob/0eb517d23d79fca6826d903b09d425781dd017b4/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L309-L339>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-fraction-of-specimens-where-geometric-beats-arithmetic-growth-bic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pooled-half-whorl-ratio-range-across-5-genera>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pooled-median-cv-of-successive-half-whorl-ratios>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pooled-median-pearson-r-of-ln-d-k-vs-k-geometric-succession>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pseudoschwagerina-half-whorl-growth-ratio-mean>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-robustoschwagerina-half-whorl-growth-ratio-mean>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-sphaeroschwagerina-half-whorl-growth-ratio-mean>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-triticites-half-whorl-growth-ratio-mean-of-per-specimen-log-linear-fits>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-van-iterson-triloculina-chamber-ratio-refit>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-von-moller-f-cylindrica-half-whorl-ratio-refit>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-zellia-half-whorl-growth-ratio-mean>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-morphometric-validation-3> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-fraction-of-specimens-where-geometric-beats-arithmetic-growth-bic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Fraction of specimens where geometric beats arithmetic growth (BIC) = 1.0 fraction" ;
        schema:measurementTechnique "BIC of log-linear vs linear-in-k model on ln D residuals; alternative-model control" ;
        schema:name "Fraction of specimens where geometric beats arithmetic growth (BIC)" ;
        schema:unitText "fraction" ;
        schema:value "1.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pooled-half-whorl-ratio-range-across-5-genera> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pooled half-whorl ratio range across 5 genera = 0.2317 ratio" ;
        schema:measurementTechnique "max-min of per-specimen rho; largest gap/median gap = 6.34 (continuity of the series vs gaps)" ;
        schema:name "Pooled half-whorl ratio range across 5 genera" ;
        schema:unitText "ratio" ;
        schema:value "0.2317" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pooled-median-cv-of-successive-half-whorl-ratios> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pooled median CV of successive half-whorl ratios = 0.076 CV" ;
        dcterms:description "Thompson p. 595: ratio 'not strictly constant ... small secondary fluctuation'" ;
        schema:measurementTechnique "std/mean of D_{k+1}/D_k within specimen, median over specimens — dispersion of the 'constant' ratio" ;
        schema:name "Pooled median CV of successive half-whorl ratios" ;
        schema:unitText "CV" ;
        schema:value "0.076" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pooled-median-pearson-r-of-ln-d-k-vs-k-geometric-succession> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pooled median Pearson r of ln D_k vs k (geometric succession) = 0.9953 r" ;
        schema:measurementTechnique "per-specimen Pearson correlation of ln(test diameter) with half-whorl stage, median over 106 specimens" ;
        schema:name "Pooled median Pearson r of ln D_k vs k (geometric succession)" ;
        schema:unitText "r" ;
        schema:value "0.9953" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pooled-median-pearson-r-of-ln-d-k-vs-k-geometric-succession-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pooled-median-pearson-r-of-ln-d-k-vs-k-geometric-succession-reference> a schema:PropertyValue ;
        dcterms:source "Thompson 1917 p. 593: 'successive whorls very nearly in the ratio 1:1.5' (exact log-linearity)" ;
        schema:value "1.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pseudoschwagerina-half-whorl-growth-ratio-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pseudoschwagerina half-whorl growth ratio (mean) = 1.2985 ratio" ;
        dcterms:description "sd 0.048; ratio-vs-stage trend -0.0101/stage" ;
        schema:measurementTechnique "as above, per genus" ;
        schema:name "Pseudoschwagerina half-whorl growth ratio (mean)" ;
        schema:unitText "ratio" ;
        schema:value "1.2985" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-robustoschwagerina-half-whorl-growth-ratio-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Robustoschwagerina half-whorl growth ratio (mean) = 1.3181 ratio" ;
        dcterms:description "sd 0.044; ratio-vs-stage trend -0.0035/stage" ;
        schema:measurementTechnique "as above, per genus" ;
        schema:name "Robustoschwagerina half-whorl growth ratio (mean)" ;
        schema:unitText "ratio" ;
        schema:value "1.3181" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-sphaeroschwagerina-half-whorl-growth-ratio-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Sphaeroschwagerina half-whorl growth ratio (mean) = 1.3289 ratio" ;
        dcterms:description "sd 0.026; ratio-vs-stage trend -0.0016/stage" ;
        schema:measurementTechnique "as above, per genus" ;
        schema:name "Sphaeroschwagerina half-whorl growth ratio (mean)" ;
        schema:unitText "ratio" ;
        schema:value "1.3289" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-triticites-half-whorl-growth-ratio-mean-of-per-specimen-log-linear-fits> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Triticites half-whorl growth ratio (mean of per-specimen log-linear fits) = 1.2385 ratio" ;
        dcterms:description "sd 0.021; whorl ratio 1.534 vs Thompson 1.5" ;
        schema:measurementTechnique "slope of ln D_k on half-whorl index k per specimen, exp(slope), mean over Triticites specimens (Dryad doi:10.5061/dryad.sn02v6x26)" ;
        schema:name "Triticites half-whorl growth ratio (mean of per-specimen log-linear fits)" ;
        schema:unitText "ratio" ;
        schema:value "1.2385" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-triticites-half-whorl-growth-ratio-mean-of-per-specimen-log-linear-fits-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-triticites-half-whorl-growth-ratio-mean-of-per-specimen-log-linear-fits-reference> a schema:PropertyValue ;
        dcterms:source "Thompson 1917 p. 593 (von Moller 1878 Fusulina, 0.088 log10 per half-whorl)" ;
        schema:value "1.225" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-van-iterson-triloculina-chamber-ratio-refit> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "van Iterson Triloculina chamber ratio refit = 1.3223 ratio" ;
        schema:measurementTechnique "log-linear refit of chambers 2-10 breadths Thompson prints on p. 595" ;
        schema:name "van Iterson Triloculina chamber ratio refit" ;
        schema:unitText "ratio" ;
        schema:value "1.3223" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-van-iterson-triloculina-chamber-ratio-refit-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-van-iterson-triloculina-chamber-ratio-refit-reference> a schema:PropertyValue ;
        dcterms:source "Thompson 1917 p. 595" ;
        schema:value "1.323" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-von-moller-f-cylindrica-half-whorl-ratio-refit> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "von Moller F. cylindrica half-whorl ratio refit = 1.2243 ratio" ;
        schema:measurementTechnique "log-linear refit of the 8 breadths Thompson prints on p. 593" ;
        schema:name "von Moller F. cylindrica half-whorl ratio refit" ;
        schema:unitText "ratio" ;
        schema:value "1.2243" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-von-moller-f-cylindrica-half-whorl-ratio-refit-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-von-moller-f-cylindrica-half-whorl-ratio-refit-reference> a schema:PropertyValue ;
        dcterms:source "Thompson 1917 p. 593" ;
        schema:value "1.225" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-zellia-half-whorl-growth-ratio-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Zellia half-whorl growth ratio (mean) = 1.2952 ratio" ;
        dcterms:description "sd 0.035; ratio-vs-stage trend -0.0088/stage" ;
        schema:measurementTechnique "as above, per genus" ;
        schema:name "Zellia half-whorl growth ratio (mean)" ;
        schema:unitText "ratio" ;
        schema:value "1.2952" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L143–L175" ;

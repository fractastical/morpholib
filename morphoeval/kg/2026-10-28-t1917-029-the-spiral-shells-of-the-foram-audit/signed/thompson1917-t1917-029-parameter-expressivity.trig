sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-029> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-parameter-expressivity-builder-assessor-claude-fable-5-1> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-parameter-expressivity-builder-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-029: logarithmic-spiral chamber succession with constant ratio vs Shi (2021) fusulinid half-whorl series — Parameter expressivity: 50/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Only four hand-picked (W, d, a0) points are rendered; there is no sweep across W or d, no morphometric read-out (coiling tightness, chamber overlap fraction, number of chambers per whorl, aspect ratio) as a function of parameter, and so monotonic control is asserted (and proven in Lean for size) but not shown for form. The Nodosarian branch of chamber_series is exercised only in self_test." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L367–L377: four fixed morph tuples; no sweep <https://github.com/fractastical/morpholib/blob/0eb517d23d79fca6826d903b09d425781dd017b4/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L367-L377>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-parameter-expressivity-1> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L633–L637" ;
        dcterms:description "Nodosarian (d = 0) and Orbitolitid (W = 1) limits verified in self_test only" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0eb517d23d79fca6826d903b09d425781dd017b4/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L633-L637> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 — builder self-audit, Pass 1 (role: builder_assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


        rdfs:label "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L602–L641" ;
        dcterms:description "self_test: 20 assertions on model identities, Thompson refits and Dryad loader; none on headline metrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0eb517d23d79fca6826d903b09d425781dd017b4/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L602-L641> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-029/README.md L46–L60" ;
        dcterms:description "documented invocation and outputs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0eb517d23d79fca6826d903b09d425781dd017b4/datasets/thompson_1917/t1917-029/README.md#L46-L60> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-repro-package-builder-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-029: logarithmic-spiral chamber succession with constant ratio vs Shi (2021) fusulinid half-whorl series — Reproducibility package: 70/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Deterministic (SEED only affects jitter in panel D), --self-test covers model identities, the refits and the loader, the run takes 2.4 s and reproduced byte-identical outputs twice. Docked because the environment used (numpy 2.5.4 / matplotlib 3.11.2 / Pillow 13.0.0) is not the lockfile's, scipy is imported nowhere yet listed in the README environment, and there is no regression assertion on the headline numbers (a silent change of the longest-segment rule would pass --self-test)." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L644–L688: main writes metrics + result JSON; no --seed / --version flags, no environment stamp in the metrics <https://github.com/fractastical/morpholib/blob/0eb517d23d79fca6826d903b09d425781dd017b4/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L644-L688>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-repro-package-2> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .


sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-029> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-specimen-match-builder-assessor-claude-fable-5-1> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-specimen-match-builder-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-029: logarithmic-spiral chamber succession with constant ratio vs Shi (2021) fusulinid half-whorl series — Morphological realism / specimen match: 45/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Panel A's four morphs are recognisably Globigerina-like, Cyclammina-like (Fig. 313 style 20-degree chambers), Triloculina-like and an Orbitolitid ring, and are visually distinct from one another (credited). Panel E shows a genuine fusulinid axial section next to panel F's Dryad outlines, and the two are the same kind of object (fusiform nested whorls). But nothing is overlaid or measured on the photograph, the model shells are never compared with Fig. 309 Nummulina or with the thin section, and the GIF's 'Nummulina-like' shell (a0 = 0.5, d = 24 degrees) is a thick ring of overlapping discs that does not resemble either specimen image." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L429–L434: specimen image only imshow'd — no segmentation, no whorl-wall detection, no model overlay <https://github.com/fractastical/morpholib/blob/0eb517d23d79fca6826d903b09d425781dd017b4/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L429-L434>",
            "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L491–L491: GIF model shell chamber_series(30, W, 24.0, r0=1.0, a0=0.5): arbitrary a0, visually unlike Nummulina (Fig. 309) <https://github.com/fractastical/morpholib/blob/0eb517d23d79fca6826d903b09d425781dd017b4/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L491-L491>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-specimen-match-1> ;
        pk:hasScore "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_029_the_spiral_shells_of_the_foram_comparison.png (generated output)" ;
        dcterms:description "Regenerated 7-panel figure inspected: A morphs distinct; E photo shown raw; F outlines plausible; no overlay — docs/media/t1917_029_the_spiral_shells_of_the_foram_comparison.png: rendered output of thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py at 0eb517d23d79fca6826d903b09d425781dd017b4, image/png, 557632 B, 1760×1100 px, artifact_sha256 3ac36d67d48be41b7dd503a4b25e70dd907fd2b4e7d04fb54b22ffa833f905ba (sha256 3ac36d67d48be41b7dd503a4b25e70dd907fd2b4e7d04fb54b22ffa833f905ba), spec_fingerprint e8dfa9fdde138927298f774fce032da52edc892f40295eed80203fdda26888b1" .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 — builder self-audit, Pass 1 (role: builder_assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


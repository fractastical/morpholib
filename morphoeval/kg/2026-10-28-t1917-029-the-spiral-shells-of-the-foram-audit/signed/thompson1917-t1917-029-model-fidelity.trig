sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-029> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-model-fidelity-builder-assessor-claude-fable-5-1> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L89–L140" ;
        dcterms:description "log_spiral / whorl_ratio_from_alpha / alpha_from_whorl_ratio / chamber_series / thompson_volume_series — E1, E2, E5, E6, E4 as on pp. 593-598" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0eb517d23d79fca6826d903b09d425781dd017b4/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L89-L140> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L602–L641" ;
        dcterms:description "self_test asserts alpha(1.5) = 86.31, L_{n+2} = rho^2 L_n, cross-product invariance, V_{n+1}/V_n = 1+q, von Moller 0.088 slope — numerically mirrors Lean Theorems 1-5" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0eb517d23d79fca6826d903b09d425781dd017b4/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L602-L641> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-model-fidelity-builder-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-029: logarithmic-spiral chamber succession with constant ratio vs Shi (2021) fusulinid half-whorl series — Model fidelity to source: 72/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "E1-E5 are implemented exactly as Thompson states them and verified numerically against the Lean theorems in self_test; the generative model (E6) is Thompson's verbal construction made explicit and its limiting cases (d = 0 Nodosarian, rho = 1 Orbitolitid) are correct. Docked because chamber radius a0 and overlap are unconstrained free choices with no source value, the Textularian translation T is implemented but never exercised or shown, and the Raup (1966) W-D-T correspondence is asserted in a docstring rather than demonstrated." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L109–L127: a0 = 0.6 default and translation parameter have no source value; T is never used in any figure <https://github.com/fractastical/morpholib/blob/0eb517d23d79fca6826d903b09d425781dd017b4/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L109-L127>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-model-fidelity-2> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 — builder self-audit, Pass 1 (role: builder_assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


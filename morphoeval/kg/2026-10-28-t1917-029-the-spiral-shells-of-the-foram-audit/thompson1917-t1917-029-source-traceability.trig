sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-029> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-source-traceability-builder-assessor-claude-fable-5-1> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-source-traceability-builder-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-029: logarithmic-spiral chamber succession with constant ratio vs Shi (2021) fusulinid half-whorl series — Source and data traceability: 85/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Dryad DOI, Crossref-verified primary article (author list corrected to single author, Paleobiology 47(1):115-133), IA scan with verified leaf mapping, Commons file with SHA-1 and licence, SHA-256 for every vendored file in the reference JSON and scout manifest, .gitattributes protecting the CRLF bytes of the Dryad files. Docked because von Moller (1878) and van Iterson (1907) have no resolvable identifiers (only Thompson's citation), and Przibram (1913) is cited without DOI." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-029/paper_citations.bib L12–L40: vonmoller1878, vaniterson1907, przibram1913 entries — the last three lack DOIs/URLs <https://github.com/fractastical/morpholib/blob/0eb517d23d79fca6826d903b09d425781dd017b4/datasets/thompson_1917/t1917-029/paper_citations.bib#L12-L40>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-source-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-source-traceability-2> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-029/t1917_029_the_spiral_shells_of_the_foram_reference.json L85–L118" ;
        dct:description "dataset block with DOI, licence, files + SHA-256 + dryad_digest_verified; specimen_images with Commons SHA-1 and SHA-256" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0eb517d23d79fca6826d903b09d425781dd017b4/datasets/thompson_1917/t1917-029/t1917_029_the_spiral_shells_of_the_foram_reference.json#L85-L118> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-029/scout_manifest.json L1–L60" ;

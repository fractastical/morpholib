<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Bos taurus Gierer–Meinhardt wavelength at 3.137 µm (Holocene, 0 Ma) — Model fidelity to source: 90/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script integrates the Gierer–Meinhardt activator–inhibitor system, checks trace, determinant and the cross-term inequality, and separates classical k_c from the fastest mode k_star. The length calibration is explicit. Murray's Schnakenberg flank parameters are not reused." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-model-fidelity-1>,

<https://w3id.org/delphi/resource/math-law/delphi10000-bos-taurus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homogeneous-state trace sign" ;
    dct:description "Diffusionless stability of the Gierer–Meinhardt steady state at the 3.137 µm detail scale | Variables: mu_u = 0.85, mu_v = 1.40 (stored as 85 and 140 in 10^-2 units)" ;
    dct:source "Gierer & Meinhardt (1972) DOI:10.1007/BF00289234" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bos-taurus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3135_bos_taurus_turing_wavelength_s0.lean#L16-L21> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def traceJ (a b : Int) : Int := a - b
theorem holocene_detail_trace_negative : traceJ muU muV < 0 := by decide"""^^pk:lean4 ;
    skos:notation "tr(J) = mu_u - mu_v < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1242/jcs.040667> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3135.traceJ" ;
    pk:leanTheorem "MathOfBiology.Loop_3135.holocene_detail_trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-bos-taurus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Inhibitor-range cross term" ;
    dct:description "Necessary cross-term for a Turing band at this diffusion ratio | Variables: D_v:D_u = 145:10, mu_u = 85, mu_v = 140 in fixed-point units" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bos-taurus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3135_bos_taurus_turing_wavelength_s0.lean#L23-L28> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def crossNumerator : Int := 145 * muU - 10 * muV
theorem inhibitor_range_cross_positive : crossNumerator > 0 := by decide"""^^pk:lean4 ;
    skos:notation "D_v * f_u + D_u * g_v > 0 with D_v/D_u = 14.5" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1242/jcs.040667> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3135.crossNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3135.inhibitor_range_cross_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-bos-taurus-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail wavelength inside tier 3" ;
    dct:description "Places the selected wavelength in tier 3/8 (subcellular detail) | Variables: lambda_c = 3137 nm = 3.137e-6 m, log10 = -5.503, age = 0 Ma" ;
    dct:source "Kondo & Miura (2010) DOI:10.1126/science.1179047" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bos-taurus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3135_bos_taurus_turing_wavelength_s0.lean#L30-L35> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def lambdaNm : Int := 3137
theorem wavelength_inside_tier3 : 1000 < lambdaNm ∧ lambdaNm < 10000 := by decide"""^^pk:lean4 ;
    skos:notation "1 µm < lambda_c = 3.137 µm < 10 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1242/jcs.040667> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3135.lambdaNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3135.wavelength_inside_tier3" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-bos-taurus-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Predecessor melanosome below lambda_c" ;
    dct:description "A stage-IV melanosome cannot hold one critical wavelength | Variables: predecessor length 500 nm; chronoseries predecessor is absent (series 1/1)" ;
    dct:source "Wasmeier et al. (2008) DOI:10.1242/jcs.040667" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bos-taurus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3135_bos_taurus_turing_wavelength_s0.lean#L37-L40> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem predecessor_melanosome_below_wavelength : 500 < lambdaNm := by decide"^^pk:lean4 ;
    skos:notation "L_melanosome = 500 nm < lambda_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1242/jcs.040667> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3135.lambdaNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3135.predecessor_melanosome_below_wavelength" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-bos-taurus-turing-wavelength-s0-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Successor soma admits repeated wavelengths" ;
    dct:description "Mode count, not k_c, is what changes from this scale to the next | Variables: successor length 20 µm; ageMa = 0" ;
    dct:source "Gierer & Meinhardt (1972) DOI:10.1007/BF00289234" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bos-taurus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3135_bos_taurus_turing_wavelength_s0.lean#L42-L45> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem successor_cell_admits_multiple_wavelengths : 20000 / lambdaNm >= 6 := by decide"^^pk:lean4 ;
    skos:notation "floor(20 µm / 3.137 µm) >= 6" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1242/jcs.040667> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3135.lambdaNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3135.successor_cell_admits_multiple_wavelengths" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-bos-taurus-turing-wavelength-s0-1>,

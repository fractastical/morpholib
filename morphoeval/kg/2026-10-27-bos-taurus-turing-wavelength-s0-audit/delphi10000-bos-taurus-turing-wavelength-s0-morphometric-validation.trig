sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Bos taurus Gierer–Meinhardt wavelength at 3.137 µm (Holocene, 0 Ma) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Measured wavelength 3.199 µm versus the 3.137 µm target, Pearson r = 0.99595, RMSE = 0.104 µm, three-seed std, KS distance 0.414 against the portrait luminance, and specimen foreground fraction distinct from the simulated occupancy. References are not copies of the values." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-ablation-control-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-ensemble-wavelength-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-predecessor-wavelengths-admitted>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-specimen-luminance-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-specimen-segment-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-specimen-structure-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-stripe-wavelength-selected>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-wavelength-sweep-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-ablation-control-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation control amplitude ratio = 7.52846061720753e-05 ratio" ;
        dct:description "negative control; ratio < 1 means the band does not amplify" ;
        schema:measurementTechnique "std(u_final)/std(u_initial) with production terms removed (decay plus diffusion only)" ;
        schema:name "ablation control amplitude ratio" ;
        schema:unitText "ratio" ;
        schema:value "7.52846061720753e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-ablation-control-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-ablation-control-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "a ratio of 1 would be a null that neither grows nor decays" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-ensemble-wavelength-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ensemble wavelength std = 4.566594360602562e-08 m" ;
        dct:description "std is the dispersion across seeds; reference is the ensemble mean, not a copy of std" ;
        schema:measurementTechnique "sample std (ddof=1) of the s=1 FFT wavelength over three seeds" ;
        schema:name "ensemble wavelength std" ;
        schema:unitText "m" ;
        schema:value "4.566594360602562e-08" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-ensemble-wavelength-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-ensemble-wavelength-std-reference> a schema:PropertyValue ;
        dct:source "seeds 3135, 4242, 5150" ;
        schema:value "3.162291655827909e-06" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control sigma_max = -0.27499999999999997 1/time" ;
        dct:description "control versus the patterned regime" ;
        schema:measurementTechnique "maximum growth rate when D_v is set equal to D_u (Turing cross term removed)" ;
        schema:name "equal-diffusion control sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.27499999999999997" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> a schema:PropertyValue ;
        dct:source "sigma_star of the full D_v/D_u = 14.5 system" ;
        schema:value "0.14636717265353383" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-predecessor-wavelengths-admitted> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "predecessor wavelengths admitted = 0.1593879502709595 count" ;
        dct:description "scale predecessor versus scale successor; chronoseries predecessor is absent at 0 Ma" ;
        schema:measurementTechnique "500 nm melanosome length divided by 3.137 µm" ;
        schema:name "predecessor wavelengths admitted" ;
        schema:unitText "count" ;
        schema:value "0.1593879502709595" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-predecessor-wavelengths-admitted-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-predecessor-wavelengths-admitted-reference> a schema:PropertyValue ;
        dct:source "20 µm successor soma divided by the same wavelength" ;
        schema:value "6.37551801083838" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-specimen-luminance-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen luminance KS statistic = 0.41350000000000003 KS" ;
        dct:description "ks p=1.63e-306" ;
        schema:measurementTechnique "two-sample KS distance between specimen luminance and normalized activator; p-value stored in metrics" ;
        schema:name "specimen luminance KS statistic" ;
        schema:unitText "KS" ;
        schema:value "0.41350000000000003" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-specimen-luminance-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-specimen-luminance-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "KS = 0 would mean the portrait histogram and the field histogram coincide" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-specimen-segment-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen segment foreground fraction = 0.6225553385416667 fraction" ;
        dct:description "specimen segmentation is not copied onto the simulation occupancy" ;
        schema:measurementTechnique "border-contrast mask on the CC BY-SA Hereford calf photograph" ;
        schema:name "specimen segment foreground fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.6225553385416667" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-specimen-segment-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-specimen-segment-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "median threshold on the simulated activator, a different segmentation" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-specimen-structure-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure coherency = 0.5960187315940857 index" ;
        dct:description "coherency of the calf portrait" ;
        schema:measurementTechnique "mean structure-tensor coherency inside the specimen mask" ;
        schema:name "specimen structure coherency" ;
        schema:unitText "index" ;
        schema:value "0.5960187315940857" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-specimen-structure-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-specimen-structure-coherency-reference> a schema:PropertyValue ;
        dct:source "isotropic-field midpoint used only as a fixed baseline, not the measured value" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-stripe-wavelength-selected> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stripe wavelength selected = 3.198770703928377e-06 m" ;
        dct:description "value is the measured peak, reference is the k_star calibration target" ;
        schema:measurementTechnique "radial FFT peak of the s=1 activator, times the calibrated grid spacing" ;
        schema:name "stripe wavelength selected" ;
        schema:unitText "m" ;
        schema:value "3.198770703928377e-06" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-stripe-wavelength-selected-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-stripe-wavelength-selected-reference> a schema:PropertyValue ;
        dct:source "assigned detail wavelength 3.137e-6 m; discrete Laplacian shifts the peak" ;
        schema:value "3.137e-06" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength sweep pearson r = 0.9959525177537897 correlation" ;
        dct:description "RMSE between measured and predicted wavelength is recorded separately" ;
        schema:measurementTechnique "Pearson r of FFT-measured wavelength versus k_star(s) across nine diffusion scales" ;
        schema:name "wavelength sweep pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.9959525177537897" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-reference> a schema:PropertyValue ;
        dct:source "pre-registered gate r > 0.98; the reported value is the measured correlation" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-wavelength-sweep-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength sweep RMSE = 1.0407512736825036e-07 m" ;
        dct:description "ci not claimed; ensemble std is a separate row" ;
        schema:measurementTechnique "RMSE of measured versus predicted wavelength across the diffusion-scale sweep" ;
        schema:name "wavelength sweep RMSE" ;
        schema:unitText "m" ;
        schema:value "1.0407512736825036e-07" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-wavelength-sweep-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-measurement-wavelength-sweep-rmse-reference> a schema:PropertyValue ;
        dct:source "zero RMSE would mean the discrete mode sat on the analytic curve" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-bos-taurus-turing-wavelength-s0.py L510–L560" ;
        dct:description "measure_morphoeval rows with reference_value != value" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bos-taurus-turing-wavelength-s0.py#L510-L560> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bos-taurus-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-bos-taurus-turing-wavelength-s0.py L298–L310" ;
        dct:description "two-sample KS on luminance" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bos-taurus-turing-wavelength-s0.py#L298-L310> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


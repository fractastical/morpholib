<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/ibrahim-vascular-angiogenesis-notch-1>,
        <https://w3id.org/probknow/resource/math-law/ibrahim-vascular-angiogenesis-notch-2>,
        <https://w3id.org/probknow/resource/math-law/ibrahim-vascular-angiogenesis-notch-3> .

<https://w3id.org/probknow/resource/math-law/ibrahim-vascular-angiogenesis-notch-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Bentley, Gerhardt & Bates (2008) & Collier et al. (1996) Two-Cell Trans-Notch Mutual Inhibition Symmetry Breaking (Brillouin k = π Mode)" ;
    dct:description "Proves that when cross-cellular Dll4-Notch1 gain g_D g_N exceeds intrinsic decay γ_D γ_N, the alternating Brillouin-zone k = π mode grows exponentially while the uniform k = 0 mode is damped, generating salt-and-pepper Tip-Stalk alternation | Variables: D_i: endothelial Dll4 ligand level; N_i: active Notch1 intracellular domain level; g_D, g_N: linearized trans-inhibition feedback gains; γ_D, γ_N: degradation rates" ;
    dct:source "Bentley, Gerhardt & Bates (2008) PLoS Comput. Biol. 4(3):e1000052; Collier et al. (1996) J. Theor. Biol. 183(4):429-446" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2021-ibrahim-vascular-angiogenesis-notch.py#L135-L255>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_060_vascular_angiogenesis_notch.lean#L43-L76> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def antisymmetric_tip_stalk_mode (D1 D2 : Int) : Int := D1 - D2
def trans_notch_antisym_margin (g_D g_N gamma_D gamma_N : Int) : Int := g_D * g_N - gamma_D * gamma_N
def trans_notch_sym_margin (g_D g_N gamma_D gamma_N : Int) : Int := -(g_D * g_N) - gamma_D * gamma_N
theorem bentley_trans_notch_symmetry_breaking_instability
    (g_D g_N gamma_D gamma_N D1 D2 : Int)
    (h_gain : gamma_D * gamma_N < g_D * g_N)
    (h_decay_pos : 0 < gamma_D * gamma_N) :
    0 < trans_notch_antisym_margin g_D g_N gamma_D gamma_N ∧
    trans_notch_sym_margin g_D g_N gamma_D gamma_N < 0 ∧
    antisymmetric_tip_stalk_mode D1 D2 + antisymmetric_tip_stalk_mode D2 D1 = 0
"""^^pk:lean4 ;
    skos:notation "dD_i/dt = g(V_i^*) - γ_D D_i,  dN_i/dt = h(D_⟨j⟩) - γ_N N_i,  Δ_antisym = g_D g_N - γ_D γ_N > 0 (k = π unstable),  Δ_sym = -g_D g_N - γ_D γ_N < 0 (k = 0 damped)" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0233>,
        <https://doi.org/10.1016/j.devcel.2009.06.004>,
        <https://doi.org/10.1038/nature05571>,
        <https://doi.org/10.1038/ncb2103>,
        <https://doi.org/10.1371/journal.pcbi.1000052> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Bentley–Gerhardt–Bates Coupled Endothelial ODE Network Driving Period-2 Salt-and-Pepper Tip-Cell vs Stalk-Cell Alternation & DAPT Hypersprouting Transition" ;
    pk:leanDeclaration "MathOfBiology.Loop_060.trans_notch_antisym_margin" ;
    pk:leanTheorem "MathOfBiology.Loop_060.bentley_trans_notch_symmetry_breaking_instability" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/ibrahim-vascular-angiogenesis-notch-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Hellström et al. (2007) DAPT / Dll4-Null Notch Blockade All-Tip Hypersprouting Collapse Law" ;
    dct:description "Proves that pharmacological γ-secretase Notch blockade (DAPT, k_t = 0 => N_i = 0) or Dll4 loss abolishes VEGFR2 repression across all endothelial cells, eliminating tip-stalk contrast and collapsing stalk cells to zero (100% all-tip hypersprouting) | Variables: V_i: VEGFR2 receptor expression; V_max: unrepressed maximal VEGFR2 transcription; M_tot: Notch1 half-repression threshold; N_i: active Notch1 signaling; M: vessel endothelial cell count" ;
    dct:source "Hellström et al. (2007) Nature 445(7129):776-780; Bentley, Gerhardt & Bates (2008) PLoS Comput. Biol. 4(3):e1000052" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2021-ibrahim-vascular-angiogenesis-notch.py#L260-L390>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_060_vascular_angiogenesis_notch.lean#L83-L110> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def vegfr2_notch_hill_residual (V_i V_max M_p N_p : Int) : Int := V_i * (M_p + N_p) - V_max * M_p
def vessel_stalk_cell_count (M M_tip : Int) : Int := M - M_tip
theorem hellstrom_dapt_notch_blockade_all_tip_hypersprouting
    (V_max M_p M : Int) :
    vegfr2_notch_hill_residual V_max V_max M_p 0 = 0 ∧
    antisymmetric_tip_stalk_mode V_max V_max = 0 ∧
    vessel_stalk_cell_count M M = 0
"""^^pk:lean4 ;
    skos:notation "V_i = V_max M_tot^p / (M_tot^p + N_i^p),  N_i = 0  =>  V_i = V_max ∀ i  =>  V_1 - V_2 = 0  =>  M_stalk = M - M_tip = 0 (100% tip hypersprouting)" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0233>,
        <https://doi.org/10.1016/j.devcel.2009.06.004>,
        <https://doi.org/10.1038/nature05571>,
        <https://doi.org/10.1038/ncb2103>,
        <https://doi.org/10.1371/journal.pcbi.1000052> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Bentley–Gerhardt–Bates Coupled Endothelial ODE Network Driving Period-2 Salt-and-Pepper Tip-Cell vs Stalk-Cell Alternation & DAPT Hypersprouting Transition" ;
    pk:leanDeclaration "MathOfBiology.Loop_060.vegfr2_notch_hill_residual" ;
    pk:leanTheorem "MathOfBiology.Loop_060.hellstrom_dapt_notch_blockade_all_tip_hypersprouting" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/ibrahim-vascular-angiogenesis-notch-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chappell et al. (2009) & Jakobsson et al. (2010) VEGFR1 (sFlt1) Decoy-Receptor Sequestration Window Shift Law" ;
    dct:description "Proves that pericellular soluble VEGFR1 (sFlt1) decoy sequestration lowers effective VEGF below the synchronous-oscillation ceiling V_osc, rescuing stable salt-and-pepper Tip-Stalk selection under high VEGF overload | Variables: VEGF_raw: extracellular unsequestered VEGF-A concentration; VEGF_eff: bioavailable pericellular VEGF-A; F_flt1: soluble VEGFR1 (sFlt1) decoy concentration; α_F: decoy binding affinity; V_osc: synchronous oscillation threshold" ;
    dct:source "Chappell et al. (2009) Dev. Cell 17(3):377-386; Jakobsson et al. (2010) Nat. Cell Biol. 12(10):943-953" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2021-ibrahim-vascular-angiogenesis-notch.py#L395-L505>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_060_vascular_angiogenesis_notch.lean#L117-L143> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def flt1_sequestered_vegf (VEGF_raw alpha_F F_flt1 : Int) : Int := VEGF_raw - alpha_F * F_flt1
def salt_and_pepper_window_margin (V_osc VEGF_eff : Int) : Int := V_osc - VEGF_eff
theorem chappell_flt1_decoy_sequestration_window_rescue
    (VEGF_raw V_osc alpha_F F_flt1 : Int)
    (h_overload : V_osc ≤ VEGF_raw)
    (h_decoy : VEGF_raw - V_osc < alpha_F * F_flt1) :
    flt1_sequestered_vegf VEGF_raw alpha_F F_flt1 < VEGF_raw ∧
    0 < salt_and_pepper_window_margin V_osc (flt1_sequestered_vegf VEGF_raw alpha_F F_flt1)
"""^^pk:lean4 ;
    skos:notation "VEGF_eff = VEGF_raw - α_F F_flt1 < V_osc  when  VEGF_raw - V_osc < α_F F_flt1" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0233>,
        <https://doi.org/10.1016/j.devcel.2009.06.004>,
        <https://doi.org/10.1038/nature05571>,
        <https://doi.org/10.1038/ncb2103>,
        <https://doi.org/10.1371/journal.pcbi.1000052> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Bentley–Gerhardt–Bates Coupled Endothelial ODE Network Driving Period-2 Salt-and-Pepper Tip-Cell vs Stalk-Cell Alternation & DAPT Hypersprouting Transition" ;
    pk:leanDeclaration "MathOfBiology.Loop_060.flt1_sequestered_vegf" ;
    pk:leanTheorem "MathOfBiology.Loop_060.chappell_flt1_decoy_sequestration_window_rescue" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


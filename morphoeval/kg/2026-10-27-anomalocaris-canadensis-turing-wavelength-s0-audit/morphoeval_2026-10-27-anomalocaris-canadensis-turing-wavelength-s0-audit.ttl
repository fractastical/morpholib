<https://w3id.org/delphi/resource/math-law/delphi10000-anomalocaris-canadensis-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg activator-inhibitor kinetics" ;
    dct:description "Spot-capable reaction terms whose Jacobian has negative trace at the homogeneous state | Variables: u activator, v inhibitor, a=0.10, b=0.90, homogeneous state (1, 0.9)" ;
    dct:source "Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/63ace896bba72dd95b1823861b5b9936be9cf066/models/2026-delphi10000-anomalocaris-canadensis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/63ace896bba72dd95b1823861b5b9936be9cf066/morphoeval/lean/loops/Loop_3113_anomalocaris_canadensis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "du/dt = Du ∇²u + a - u + u²v ; dv/dt = Dv ∇²v + b - u²v" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature09920>,
        <https://doi.org/10.1038/nature10689>,
        <https://doi.org/10.1073/pnas.1015302108>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1666/13-067> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3113.trace_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3113.homogeneous_state_is_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-anomalocaris-canadensis-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber k_c" ;
    dct:description "Quantitative law for this slot. Selects the sub-facet ocellus wavelength at 508 Ma. | Variables: f_u=0.8, g_v=-1, Dv/Du=20, lambda_c pinned to the 24 µm slot length" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/63ace896bba72dd95b1823861b5b9936be9cf066/models/2026-delphi10000-anomalocaris-canadensis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/63ace896bba72dd95b1823861b5b9936be9cf066/morphoeval/lean/loops/Loop_3113_anomalocaris_canadensis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (Dv f_u + Du g_v) / (2 Du Dv) ; lambda_c = 2 pi / k_c = 2.397e-05 m" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature09920>,
        <https://doi.org/10.1038/nature10689>,
        <https://doi.org/10.1073/pnas.1015302108>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1666/13-067> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3113.lambda_nm" ;
    pk:leanTheorem "MathOfBiology.Loop_3113.label_bounds_the_exact_length" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-anomalocaris-canadensis-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diffusion-ratio gate versus equal-diffusion ablation" ;
    dct:description "Negative control. Equal diffusion cannot select k_c. | Variables: Du and Dv in milli-units 608 and 12159" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/63ace896bba72dd95b1823861b5b9936be9cf066/models/2026-delphi10000-anomalocaris-canadensis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/63ace896bba72dd95b1823861b5b9936be9cf066/morphoeval/lean/loops/Loop_3113_anomalocaris_canadensis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "Dv/Du > 25/4 is required for these partial derivatives; Du = Dv fails it" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature09920>,
        <https://doi.org/10.1038/nature10689>,
        <https://doi.org/10.1073/pnas.1015302108>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1666/13-067> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3113.inhibitor_diffuses_fast_enough" ;
    pk:leanTheorem "MathOfBiology.Loop_3113.equal_diffusion_fails_ratio_gate" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-anomalocaris-canadensis-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Sub-facet chronoseries inequality" ;
    dct:description "States what is short at this scale relative to the predecessor facet lattice. Body size, not k_c, is what the Ordovician successor changes. | Variables: Burgess 508 Ma versus Emu Bay 515 Ma versus Fezouata young end 472 Ma" ;
    dct:source "Paterson et al. (2011) DOI:10.1038/nature10689 ; Van Roy & Briggs (2011) DOI:10.1038/nature09920" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/63ace896bba72dd95b1823861b5b9936be9cf066/models/2026-delphi10000-anomalocaris-canadensis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/63ace896bba72dd95b1823861b5b9936be9cf066/morphoeval/lean/loops/Loop_3113_anomalocaris_canadensis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c (23.97 µm) < reconstructed Emu Bay facet spacing (266 µm) at 2.5 cm and 16000 lenses" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature09920>,
        <https://doi.org/10.1038/nature10689>,
        <https://doi.org/10.1073/pnas.1015302108>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1666/13-067> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3113.emu_bay_facet_spacing_um" ;
    pk:leanTheorem "MathOfBiology.Loop_3113.detail_wavelength_is_subfacet" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-anomalocaris-canadensis-turing-wavelength-s0-1>,

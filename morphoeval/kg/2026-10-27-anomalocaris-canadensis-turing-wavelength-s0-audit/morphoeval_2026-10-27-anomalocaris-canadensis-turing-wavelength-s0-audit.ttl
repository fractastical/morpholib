    rdfs:comment "The reference is the scrambled image, not a copy of the modulated KS." ;
    schema:about "Anomalocaris canadensis" ;
    schema:error 3.480687e+02 ;
    schema:targetValue 2.33e-02 ;
    schema:unitText "KS D" ;
    schema:value 1.044e-01 .


<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/wolfram-conus-textile-rule30-1>,
        <https://w3id.org/probknow/resource/math-law/wolfram-conus-textile-rule30-2>,
        <https://w3id.org/probknow/resource/math-law/wolfram-conus-textile-rule30-3> .

<https://w3id.org/probknow/resource/math-law/wolfram-conus-textile-rule30-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Wolfram (1983, 1984) Rule 30 Boolean & GF(2) Algebraic Normal Form" ;
    dct:description "Discrete chaotic generator of self-similar white triangular tents on Conus textile shells and OEIS A051023 center column | Variables: a_{t,i} ∈ {0, 1}: pigment state at mantle cell i and step t; ⊕: XOR; ∨: OR" ;
    dct:source "Wolfram (1983) Rev. Mod. Phys. 55:601; (1984) Nature 311:419" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L96-L152>,
        <https://github.com/fractastical/morpholib/blob/fb234bc/morphoeval/lean/MathOfBiology.lean#L21-L37> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def rule30 (p q r : Bool) : Bool := bne p (q || r)
def rule30_anf (p q r : Bool) : Bool := bne (bne p q) (bne r (q && r))
theorem rule30_anf_equiv (p q r : Bool) : rule30 p q r = rule30_anf p q r := by
  cases p <;> cases q <;> cases r <;> rfl"""^^pk:lean4 ;
    skos:notation "a_{t+1, i} = a_{t, i-1} ⊕ (a_{t, i} ∨ a_{t, i+1}) ≡ a_{t, i-1} + a_{t, i} + a_{t, i+1} + a_{t, i} a_{t, i+1} (mod 2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0167-2789(90)90169-P>,
        <https://doi.org/10.1016/S0022-5193(87)80101-7>,
        <https://doi.org/10.1038/311419a0>,
        <https://doi.org/10.1103/RevModPhys.55.601> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Elementary Cellular Automata (GF(2)) & Reaction-Diffusion PDE" ;
    pk:leanDeclaration "MathOfBiology.rule30" ;
    pk:leanTheorem "MathOfBiology.rule30_anf_equiv" ;
    pk:leanVerified false,
        true .

<https://w3id.org/probknow/resource/math-law/wolfram-conus-textile-rule30-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Erica Jen (1990) Left-Bijective Spatial Inverse & Diagonal Period-Doubling Recursion" ;
    dct:description "Proves exact left-bijectivity (0 bit errors) and explains why left-cone diagonals lock into period-doubling crystals separated by d_{k-1}=0 barriers | Variables: d_k(t) = a_{t, k-t}: k-th left-cone diagonal; P_k = 2^m: exact temporal period doubling at k ∈ {0, 3, 8, 29, 400, ...}" ;
    dct:source "Jen (1990) Physica D 45(1-3):3-18 Theorem 1 & Section 2" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L172-L256>,
        <https://github.com/fractastical/morpholib/blob/fb234bc/morphoeval/lean/MathOfBiology.lean#L39-L61> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def rule30_left_inverse (a_next q r : Bool) : Bool := bne a_next (q || r)
theorem jen_1990_left_bijective (p q r : Bool) :
    rule30_left_inverse (rule30 p q r) q r = p := by
  cases p <;> cases q <;> cases r <;> rfl
theorem jen_1990_barrier_shielding (d_km2 d_k : Bool) :
    jen_diagonal_step d_km2 true d_k = !d_km2 := by
  cases d_km2 <;> cases d_k <;> rfl"""^^pk:lean4 ;
    skos:notation "a_{t, i-1} = a_{t+1, i} ⊕ (a_{t, i} ∨ a_{t, i+1}),   d_k(t+1) = d_{k-2}(t) ⊕ (d_{k-1}(t) ∨ d_k(t))" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0167-2789(90)90169-P>,
        <https://doi.org/10.1016/S0022-5193(87)80101-7>,
        <https://doi.org/10.1038/311419a0>,
        <https://doi.org/10.1103/RevModPhys.55.601> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Elementary Cellular Automata (GF(2)) & Reaction-Diffusion PDE" ;
    pk:leanDeclaration "MathOfBiology.rule30_left_inverse" ;
    pk:leanTheorem "MathOfBiology.jen_1990_left_bijective" ;
    pk:leanVerified false,
        true .

<https://w3id.org/probknow/resource/math-law/wolfram-conus-textile-rule30-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Meinhardt & Klingler (1987) 3-Species Activator-Substrate-Hormone Mantle PDE" ;
    dct:description "Continuous biochemical mechanism producing self-extinguishing pigment triangles and V-shaped travelling waves after mantle lesion | Variables: a(x,t): pigment activator; s(x,t): depleted substrate; h(x,t): fast-diffusing systemic hormone" ;
    dct:source "Meinhardt & Klingler (1987) J. Theor. Biol. 126(1):63-89 Eq. (1)-(3)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L315-L412>,
        <https://github.com/fractastical/morpholib/blob/fb234bc/morphoeval/lean/MathOfBiology.lean#L63-L82> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def meinhardt_activator_reaction (rho kappa rho0 mu_a : Nat) (a s : Nat) : Int :=
  Int.ofNat (rho * s * (a * a + rho0 * (1 + kappa * a * a))) -
    Int.ofNat (mu_a * a * (1 + kappa * a * a))
theorem meinhardt_basal_quiescence (rho kappa mu_a s : Nat) :
    meinhardt_activator_reaction rho kappa 0 mu_a 0 s = 0 := by
  simp [meinhardt_activator_reaction]"""^^pk:lean4 ;
    skos:notation "∂a/∂t = ρ s (a^2 / (1 + κ a^2) + ρ_0) - μ_a a + D_a ∂^2a/∂x^2,   ∂s/∂t = σ (h / (1 + γ h)) - ρ s a^2 - μ_s s + D_s ∂^2s/∂x^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0167-2789(90)90169-P>,
        <https://doi.org/10.1016/S0022-5193(87)80101-7>,
        <https://doi.org/10.1038/311419a0>,
        <https://doi.org/10.1103/RevModPhys.55.601> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Elementary Cellular Automata (GF(2)) & Reaction-Diffusion PDE" ;
    pk:leanDeclaration "MathOfBiology.meinhardt_activator_reaction" ;
    pk:leanTheorem "MathOfBiology.meinhardt_basal_quiescence" ;
    pk:leanVerified false,
        true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow LLM-assessment template) that evaluates the hypothesis pkr:hypothesis/morphoeval-<sim>-<dimension> with pk:hasProbability = score/100 and a pk:hasVerdict band; the overall score evaluates pkr:hypothesis/morphoeval-<sim> and is also the pk:weightOfEvidence of the pk:Claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


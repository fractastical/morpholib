sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolfram-conus-textile-rule30> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolfram-conus-textile-rule30-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-wolfram-conus-textile-rule30-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Wolfram (1984) Rule 30 & Meinhardt–Klingler (1987) Conus textile Pigmentation — Morphometric validation: 88/100" ;
        dct:date "2026-10-18"^^xsd:date ;
        dct:description "Seven quantitative morphometrics and algebraic invariants are verified in `self_test()` and exported to `conus_textile_rule30_metrics.csv` and `conus_rule30_defect_fronts.csv`: 128/128 OEIS A051023 bit match, 0 bit errors on Jen's left-bijective inverse and diagonal recursion, exact dislocation indices k in {0, 3, 8, 29, 400}, damage-cone velocities v_R = +1.0000 and v_L = -0.2604, shell H/W = 1.8342 (ref 1.8330), silhouette IoU = 0.8353, and white-chord CV = 0.7069 (theory 1/sqrt(2) = 0.7071, specimen 0.6403)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-2d-shell-silhouette-iou-vs-segmented-conus-textile-specimen>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-3d-raup-conus-textile-shell-height-to-width-ratio-h-w>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-jen-1990-left-bijective-inverse-diagonal-recursion-bit-errors>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-left-cone-periodic-crystal-lock-in-front-velocity-v-lock>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-rule-30-center-column-exact-match-to-oeis-a051023-first-128-bits>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-rule-30-prize-2-center-column-density-c-1024>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-rule-30-white-tent-chord-length-cv>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-morphometric-validation-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-2d-shell-silhouette-iou-vs-segmented-conus-textile-specimen> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D shell silhouette IoU vs segmented Conus textile specimen = 0.8353 IoU (intersection/union)" ;
        schema:measurementTechnique "pixel overlap between projected 3D Raup Conus mesh and segmented OSU Conus textile specimen silhouette (256x140 grid)" ;
        schema:name "2D shell silhouette IoU vs segmented Conus textile specimen" ;
        schema:unitText "IoU (intersection/union)" ;
        schema:value "0.8353" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-2d-shell-silhouette-iou-vs-segmented-conus-textile-specimen-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-2d-shell-silhouette-iou-vs-segmented-conus-textile-specimen-reference> a schema:PropertyValue ;
        dct:source "Conus textile OSU specimen 24399204286 (datasets/conus/conus_textile_specimen.jpg)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-3d-raup-conus-textile-shell-height-to-width-ratio-h-w> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D Raup Conus textile shell height-to-width ratio (H/W) = 1.8342 ratio (H/W)" ;
        schema:measurementTechnique "projected axial height / maximum shoulder diameter of 3D Raup Conus mesh (W=1.42, D=0.05, T=3.15)" ;
        schema:name "3D Raup Conus textile shell height-to-width ratio (H/W)" ;
        schema:unitText "ratio (H/W)" ;
        schema:value "1.8342" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-3d-raup-conus-textile-shell-height-to-width-ratio-h-w-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-3d-raup-conus-textile-shell-height-to-width-ratio-h-w-reference> a schema:PropertyValue ;
        dct:source "Conus textile OSU specimen 24399204286 (James St. John, CC BY 2.0)" ;
        schema:value "1.833" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-jen-1990-left-bijective-inverse-diagonal-recursion-bit-errors> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Jen (1990) left-bijective inverse & diagonal recursion bit errors = 0 bit errors" ;
        dct:description "first 5 period-doubling dislocation diagonals k = [0, 3, 8, 29, 400] (P = 1, 2, 4, 8, 16)" ;
        schema:measurementTechnique "sum of bit reconstruction errors across a_{t,i-1} = a_{t+1,i} XOR (a_{t,i} OR a_{t,i+1}) and d_k(t+1) = d_{k-2}(t) XOR (d_{k-1}(t) OR d_k(t))" ;
        schema:name "Jen (1990) left-bijective inverse & diagonal recursion bit errors" ;
        schema:unitText "bit errors" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-jen-1990-left-bijective-inverse-diagonal-recursion-bit-errors-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-jen-1990-left-bijective-inverse-diagonal-recursion-bit-errors-reference> a schema:PropertyValue ;
        dct:source "Jen 1990 Physica D 45:3-18 Theorem 1 & Section 2" ;
        schema:value "0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-left-cone-periodic-crystal-lock-in-front-velocity-v-lock> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "left-cone periodic crystal lock-in front velocity v_lock = -0.1962 cells/step" ;
        dct:description "damage-cone velocities: v_R = +1.0000±0.0000, v_L = -0.2604±0.1024 cells/step" ;
        schema:measurementTechnique "spatial drift velocity of period-locked diagonal boundary (1/slope - 1 from T_lock(k) = 1.2441*k + 7.89 over k in [30, 400])" ;
        schema:name "left-cone periodic crystal lock-in front velocity v_lock" ;
        schema:unitText "cells/step" ;
        schema:value "-0.1962" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-left-cone-periodic-crystal-lock-in-front-velocity-v-lock-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-left-cone-periodic-crystal-lock-in-front-velocity-v-lock-reference> a schema:PropertyValue ;
        dct:source "Jen 1990 Physica D 45:3-18 / Wolfram 2002 A New Kind of Science p. 871" ;
        schema:value "-0.2081" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-rule-30-center-column-exact-match-to-oeis-a051023-first-128-bits> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Rule 30 center-column exact match to OEIS A051023 (first 128 bits) = 128 bits matched" ;
        schema:measurementTechnique "exact bitwise comparison of a_{t,0} (t=0..127) against OEIS A051023" ;
        schema:name "Rule 30 center-column exact match to OEIS A051023 (first 128 bits)" ;
        schema:unitText "bits matched" ;
        schema:value "128" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-rule-30-center-column-exact-match-to-oeis-a051023-first-128-bits-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-rule-30-center-column-exact-match-to-oeis-a051023-first-128-bits-reference> a schema:PropertyValue ;
        dct:source "Wolfram 1984 Nature 311:419 / OEIS A051023 / Rule 30 Prize (2019)" ;
        schema:value "128" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-rule-30-prize-2-center-column-density-c-1024> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Rule 30 Prize #2 center-column density c_1024 = 0.4785 fraction of 1s" ;
        dct:description "normalized 4-bit block Shannon entropy H_4/4 = 0.99640 bits/bit" ;
        schema:measurementTechnique "cumulative fraction (1/N) sum_{t=0}^{1023} a_{t,0} on single-seed light-cone" ;
        schema:name "Rule 30 Prize #2 center-column density c_1024" ;
        schema:unitText "fraction of 1s" ;
        schema:value "0.4785" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-rule-30-prize-2-center-column-density-c-1024-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-rule-30-prize-2-center-column-density-c-1024-reference> a schema:PropertyValue ;
        dct:source "Wolfram 2019 Rule 30 Prize Problem 2 (https://rule30prize.org/)" ;
        schema:value "0.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-rule-30-white-tent-chord-length-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Rule 30 white-tent chord-length CV (σ/μ) = 0.7075 CV (std/mean)" ;
        dct:description "Meinhardt-Klingler PDE CV = 1.1045 (vs close-up specimen ling_commons_010 CV = 1.1310); KS(Rule30, specimen) = 0.2623" ;
        schema:measurementTechnique "coefficient of variation of horizontal unpigmented run lengths w on periodic mantle ring (230x370)" ;
        schema:name "Rule 30 white-tent chord-length CV (σ/μ)" ;
        schema:unitText "CV (std/mean)" ;
        schema:value "0.7075" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-rule-30-white-tent-chord-length-cv-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-measurement-rule-30-white-tent-chord-length-cv-reference> a schema:PropertyValue ;
        dct:source "Conus textile OSU specimen dorsal white-tent segmentation (1,814 chords, CV=0.6403; exact geometric P(W=w)=2^{-w} theory CV=0.7071)" ;
        schema:value "0.6403" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L799–L913" ;
        dct:description "self_test(): 9 automated assertion blocks covering algebraic, statistical, and geometric metrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L799-L913> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "conus_textile_rule30_metrics.csv (generated output)" ;
        dct:description "System-by-system pigment fraction, white-chord mean/CV, KS distance, fractal dimension, and silhouette IoU — conus_textile_rule30_metrics.csv: rendered output of 1984-wolfram-conus-textile-rule30.py at fb234bc, text/csv, 644 B, artifact_sha256 da34a299061268e937c073cc835a76f836bf1d976c145e9484147e922e21fa19 (sha256 da34a299061268e937c073cc835a76f836bf1d976c145e9484147e922e21fa19), spec_fingerprint 6baf9ffa515c0c89775df3b58f398571f7894e64d20534778dff610ad08bc313" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "conus_rule30_defect_fronts.csv (generated output)" ;
        dct:description "17 defect-front and dislocation rows across Rule 30, Meinhardt PDE, sorting, and bioelectricity — conus_rule30_defect_fronts.csv: rendered output of 1984-wolfram-conus-textile-rule30.py at fb234bc, text/csv, 1205 B, artifact_sha256 ed19157163ba7735b0da73a0e2cdc62d033a33f081266bf02a5da02f82f5af02 (sha256 ed19157163ba7735b0da73a0e2cdc62d033a33f081266bf02a5da02f82f5af02), spec_fingerprint 6baf9ffa515c0c89775df3b58f398571f7894e64d20534778dff610ad08bc313" .

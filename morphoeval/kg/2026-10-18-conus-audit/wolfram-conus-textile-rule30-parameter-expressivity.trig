sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolfram-conus-textile-rule30> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Wolfram (1984) Rule 30 & Meinhardt–Klingler (1987) Conus textile Pigmentation — Parameter expressivity: 85/100" ;
        dct:date "2026-10-18"^^xsd:date ;
        dct:description "Contrasts Rule 30 against Rule 90 (linear XOR / Sierpinski negative control) and the continuous Meinhardt-Klingler PDE across intact growth and pinned mantle-edge lesion perturbations, sweeps diagonal index k across 415 left-cone diagonals and 25 damage-cone random seeds, and compares 1D space-time defect-front kymographs across four repository morphogenetic paradigms." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity-2> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L425–L620" ;
        dct:description "Pinned mantle-defect wakes (Rule 30 vs Meinhardt PDE) and cross-model kymograph front simulations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L425-L620> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/conus_rule30_kymograph_defect_fronts.png (generated output)" ;
        dct:description "6-panel space-time kymograph & defect-front diagnostic figure — docs/media/conus_rule30_kymograph_defect_fronts.png: rendered output of 1984-wolfram-conus-textile-rule30.py at fb234bc, image/png, 509522 B, 2688×1664 px, artifact_sha256 61ea4422526b1008ce4c2245dc6f6a96a37da6547446583a8a0030fe50349b70 (sha256 61ea4422526b1008ce4c2245dc6f6a96a37da6547446583a8a0030fe50349b70), spec_fingerprint 6baf9ffa515c0c89775df3b58f398571f7894e64d20534778dff610ad08bc313" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


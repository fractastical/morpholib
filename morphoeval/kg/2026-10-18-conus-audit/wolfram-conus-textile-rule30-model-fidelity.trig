sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolfram-conus-textile-rule30> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolfram-conus-textile-rule30-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-wolfram-conus-textile-rule30-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Wolfram (1984) Rule 30 & Meinhardt–Klingler (1987) Conus textile Pigmentation — Model fidelity to source: 89/100" ;
        dct:date "2026-10-18"^^xsd:date ;
        dct:description "Implements both the discrete Wolfram Rule 30 cellular automaton (in both Boolean XOR/OR and GF(2) Algebraic Normal Form) and the continuous Meinhardt-Klingler (1987) 3-species activator-substrate-hormone mantle-edge PDE, plus Erica Jen's (1990) left-bijective spatial inverse, left-cone diagonal recursion d_k(t+1) = d_{k-2}(t) XOR (d_{k-1}(t) OR d_k(t)), and asymmetric Boolean Jacobian damage-cone analysis." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-model-fidelity-3> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L140–L273" ;
        dct:description "Rule 30 Boolean/ANF steppers, Jen (1990) left-bijective inverse, and Prize #1-#3 diagnostics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L140-L273> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L276–L422" ;
        dct:description "GF(2) Boolean Jacobian verification, diagonal period-doubling cascade k=0..414, and damage-cone ensemble" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L276-L422> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L627–L704" ;
        dct:description "Meinhardt-Klingler (1987) activator-substrate-hormone PDE and 3D Raup Conus shell mesh" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L627-L704> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


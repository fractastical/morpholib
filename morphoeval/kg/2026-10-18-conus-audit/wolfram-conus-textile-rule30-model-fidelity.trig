            <https://doi.org/10.1016/S0022-5193(87)80101-7>,
            <https://doi.org/10.1038/311419a0>,
            <https://doi.org/10.1103/RevModPhys.55.601> .
    <https://doi.org/10.1016/0167-2789(90)90169-P> dct:date "1990"^^xsd:gYear ;
        dct:title "Aperiodicity in one-dimensional cellular automata" .
    <https://doi.org/10.1016/S0022-5193(87)80101-7> dct:date "1987"^^xsd:gYear ;
        dct:title "A model for pigment pattern formation on the shells of mollusks" .
    <https://doi.org/10.1038/311419a0> dct:date "1984"^^xsd:gYear ;
        dct:title "Cellular automata as models of complexity" .
    <https://doi.org/10.1103/RevModPhys.55.601> dct:date "1983"^^xsd:gYear ;
        dct:title "Statistical mechanics of cellular automata" .
}


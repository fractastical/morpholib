sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-18-conus-audit-wolfram-conus-textile-rule30-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Wolfram (1984) Rule 30 & Meinhardt–Klingler (1987) Conus textile Pigmentation — Model fidelity to source: 89/100" ;
        rdfs:comment "Implements both the discrete Wolfram Rule 30 cellular automaton (in both Boolean XOR/OR and GF(2) Algebraic Normal Form) and the continuous Meinhardt-Klingler (1987) 3-species activator-substrate-hormone mantle-edge PDE, plus Erica Jen's (1990) left-bijective spatial inverse, left-cone diagonal recursion d_k(t+1) = d_{k-2}(t) XOR (d_{k-1}(t) OR d_k(t)), and asymmetric Boolean Jacobian damage-cone analysis. Evidence: 1984-wolfram-conus-textile-rule30.py L140–L273: Rule 30 Boolean/ANF steppers, Jen (1990) left-bijective inverse, and Prize #1-#3 diagnostics <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L140-L273>; 1984-wolfram-conus-textile-rule30.py L276–L422: GF(2) Boolean Jacobian verification, diagonal period-doubling cascade k=0..414, and damage-cone ensemble <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L276-L422>; 1984-wolfram-conus-textile-rule30.py L627–L704: Meinhardt-Klingler (1987) activator-substrate-hormone PDE and 3D Raup Conus shell mesh <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L627-L704>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-wolfram-conus-textile-rule30-model-fidelity> ;
        pk:hasProbability "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-wolfram-conus-textile-rule30-model-fidelity> rdfs:label "Wolfram (1984) Rule 30 & Meinhardt–Klingler (1987) Conus textile Pigmentation (1984-wolfram-conus-textile-rule30.py, docs/media/conus_textile_rule30.gif, docs/media/conus_rule30_kymograph_defect_fronts.png, conus_textile_rule30_metrics.csv, conus_rule30_defect_fronts.csv) satisfies the MorphoEval 0.1.0 criterion 'Model fidelity to source' for Conus textile Linnaeus, 1758 (textile cone snail)" ;
        dct:identifier "morphoeval/0.1.0/model-fidelity" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon" .
}


        rdfs:label "Wolfram (1984) Rule 30 & Meinhardt–Klingler (1987) Conus textile Pigmentation — Reproducibility package: 89/100" ;
        dct:date "2026-10-18"^^xsd:date ;
        dct:description "Deterministic RNG seeds (`42`, `100..124`, `2025`), fast `--self-test-only` entrypoint, automatic specimen verification/caching with SHA-256 checks, and complete PNG, GIF, and CSV outputs." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-repro-package-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L1507–L1560" ;
        dct:description "CLI entrypoint supporting --self-test-only and --no-gif with deterministic seeds" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L1507-L1560> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/conus_textile_rule30.gif (generated output)" ;
        dct:description "36-frame animated 1x2 comparison of Rule 30 vs Meinhardt PDE on 3D rotating Conus shells — docs/media/conus_textile_rule30.gif: rendered output of 1984-wolfram-conus-textile-rule30.py at fb234bc, image/gif, 590905 B, 640×340 px, 36 frames, artifact_sha256 0f2462a3e14406d8ddf81072352b1e8758745c1f6d12875567de4f17ce8a1bc1 (sha256 0f2462a3e14406d8ddf81072352b1e8758745c1f6d12875567de4f17ce8a1bc1), spec_fingerprint 6baf9ffa515c0c89775df3b58f398571f7894e64d20534778dff610ad08bc313" .

    <https://doi.org/10.1016/j.cell.2016.01.028> dcterms:date "2016"^^xsd:gYear ;
        dcterms:title "Self-organization of embryonic genetic oscillators into spatiotemporal wave patterns" .

    <https://doi.org/10.1038/nature11804> dcterms:date "2013"^^xsd:gYear ;
        dcterms:title "Scaling of embryonic patterning based on phase-gradient encoding" .

    <https://doi.org/10.1038/ncb1679> dcterms:date "2008"^^xsd:gYear ;

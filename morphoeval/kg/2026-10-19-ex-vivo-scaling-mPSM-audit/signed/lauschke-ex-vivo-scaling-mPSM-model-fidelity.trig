sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lauschke-ex-vivo-scaling-mPSM> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Lauschke, Tsiairis, François & Aulehla (2013) scale-invariant phase-gradient encoding in ex vivo monolayer presomitic mesoderm (mPSM) — Model fidelity to source: 64/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements Lauschke et al.'s (2013) phase-gradient profile phi(r,t) and linear proportional segment scaling S_n = alpha * R(t_n) (L105-245), but Pass 1 needs full multi-explant universal phase collapse verification against non-scaling constant-gradient controls and 2D circular target-wave kymograph integration." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2014-lauschke-ex-vivo-scaling-mPSM.py L178–L325: Radial segment scaling and 2D circular mPSM target-wave kymograph simulator <https://github.com/fractastical/morpholib/blob/317bc3c/2014-lauschke-ex-vivo-scaling-mPSM.py#L178-L325>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-model-fidelity-1> ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L105–L175" ;
        dcterms:description "Universal phase-gradient profile and multi-explant collapse evaluator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2014-lauschke-ex-vivo-scaling-mPSM.py#L105-L175> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


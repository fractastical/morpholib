sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lauschke-ex-vivo-scaling-mPSM> a pk:Claim ;
        rdfs:label "Lauschke, Tsiairis, François & Aulehla (2013) scale-invariant phase-gradient encoding in ex vivo monolayer presomitic mesoderm (mPSM) faithfully reproduces Mus musculus (mouse E10.5 tailbud LuVeLu Lfng-Venus monolayer presomitic mesoderm) morphology" ;
        dcterms:description "The simulation script(s) 2014-lauschke-ex-vivo-scaling-mPSM.py implement the cited source model as published and produce forms that match real Mus musculus (mouse E10.5 tailbud LuVeLu Lfng-Venus monolayer presomitic mesoderm) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 59.9/100, audit 2026-10-19-ex-vivo-scaling-mPSM-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2014-lauschke-ex-vivo-scaling-mPSM.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2014-lauschke-ex-vivo-scaling-mPSM.py; output: docs/media/ex_vivo_scaling_mPSM_comparison.png; organism: Mus musculus (mouse E10.5 tailbud LuVeLu Lfng-Venus monolayer presomitic mesoderm); checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 0664f71d3f534bae2179e8241d0641469c79bbe4d267f1da6ae7e8f684b90e69; artifact_sha256: 70c6c4fba09b9551bf271149669608aefce7f5c02907731b21cc2e1f8b96a61e; input_dataset_sha256: {datasets/ex_vivo_scaling_mPSM/ex_vivo_scaling_mPSM_reference.json=4b43d8d8398b7653..., datasets/ex_vivo_scaling_mPSM/mouse_mpsm_somites_specimen.jpg=8b80971796cb29e2..., datasets/ex_vivo_scaling_mPSM/scout_manifest.json=ed97fcae27d8072b...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.cell.2016.01.028>,
            <https://doi.org/10.1038/nature11804>,
            <https://doi.org/10.1038/ncb1679>,
            <https://doi.org/10.1088/1478-3975/13/3/036009> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-specimen-match> ;
        pk:weightOfEvidence "0.599"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/317bc3c/2014-lauschke-ex-vivo-scaling-mPSM.py> a schema:SoftwareSourceCode ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py" ;

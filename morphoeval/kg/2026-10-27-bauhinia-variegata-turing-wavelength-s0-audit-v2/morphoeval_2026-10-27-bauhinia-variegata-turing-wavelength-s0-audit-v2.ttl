<https://w3id.org/delphi/resource/math-law/delphi10000-bauhinia-variegata-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg diffusion-ratio instability margin" ;
    dct:description "The inhibitor must out-diffuse the activator before a 69.12 µm band exists | Variables: r and r_crit in thousandths (16900 and 8568)" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012; Schnakenberg 1979 doi:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bauhinia-variegata-turing-wavelength-s0.py#L105-L116>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3132_bauhinia_variegata_turing_wavelength_s0.lean#L18-L22> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "r = D_v/D_u > r_crit, with r = 16.9 and r_crit = 8.5676 at (a, b) = (0.10, 0.90)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1039/a702602a>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1126/science.1203874> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3132.law1Margin" ;
    pk:leanTheorem "MathOfBiology.Loop_3132.law1_turing_ratio_exceeds_threshold" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-bauhinia-variegata-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber and wavelength" ;

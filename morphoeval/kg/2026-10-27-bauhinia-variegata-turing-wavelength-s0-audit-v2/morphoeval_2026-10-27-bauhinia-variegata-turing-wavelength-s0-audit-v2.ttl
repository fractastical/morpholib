        <https://w3id.org/delphi/resource/evidence/2026-10-27-bauhinia-variegata-turing-wavelength-s0-audit-v2-delphi10000-bauhinia-variegata-turing-wavelength-s0-4>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-bauhinia-variegata-turing-wavelength-s0-audit-v2-delphi10000-bauhinia-variegata-turing-wavelength-s0-5>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-bauhinia-variegata-turing-wavelength-s0-audit-v2-delphi10000-bauhinia-variegata-turing-wavelength-s0-6>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-bauhinia-variegata-turing-wavelength-s0-audit-v2-delphi10000-bauhinia-variegata-turing-wavelength-s0-7>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-bauhinia-variegata-turing-wavelength-s0-audit-v2-delphi10000-bauhinia-variegata-turing-wavelength-s0-8>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-bauhinia-variegata-turing-wavelength-s0-audit-v2-delphi10000-bauhinia-variegata-turing-wavelength-s0-9> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:weightOfEvidence 8.73e-01 .


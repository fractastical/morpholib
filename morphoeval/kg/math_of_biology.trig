    <https://w3id.org/delphi/resource/claim/morphoeval-beane-planarian-hk-atpase-anterior> a pk:Claim ;
        rdfs:label "Beane et al. (2011) planarian H,K-ATPase bioelectric V_mem anterior polarity switch (Schmidtea mediterranea freshwater planarian flatworm)" ;
        dct:conformsTo <https://w3id.org/delphi/resource/math-law/beane-planarian-hk-atpase-anterior-1>,
            <https://w3id.org/delphi/resource/math-law/beane-planarian-hk-atpase-anterior-2>,

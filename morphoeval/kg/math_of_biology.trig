            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-7> ;
        pk:hasScore 8.4e-01 ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Source and data traceability: 82/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Source and data traceability was already strong: papers have resolvable DOIs, rusty-matter is pinned to a full commit, fixtures and photograph have SHA-256 values, and PlanformDB-derived records retain experiment IDs and sample counts. The previously wrong 2021 PMID is corrected to 34411690, and the script now records exactly which source material was and was not consulted. It also labels fitted versus held-out empirical series. Remaining limits are that the full 2021 and 2020 papers were not accessible and the raw PlanformDB was not independently re-extracted, so the curated fixture transcription and equation provenance remain unverified." ;

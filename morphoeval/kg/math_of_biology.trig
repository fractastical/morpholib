            <https://w3id.org/delphi/resource/evidence/2026-10-19-avian-plumage-somite-stripes-audit-v3-haupaix-avian-plumage-somite-stripes-6>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-avian-plumage-somite-stripes-audit-v3-haupaix-avian-plumage-somite-stripes-7>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-avian-plumage-somite-stripes-audit-v3-haupaix-avian-plumage-somite-stripes-8>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-avian-plumage-somite-stripes-audit-v3-haupaix-avian-plumage-somite-stripes-9> ;
        pk:hypothesisType "Somite-Prepatterned Stripe Spacing" ;
        pk:phenomenonScaleTier "6_organ_mm" ;

            <https://w3id.org/delphi/resource/evidence/2026-10-19-ex-vivo-scaling-mPSM-audit-v3-lauschke-ex-vivo-scaling-mPSM-6>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-ex-vivo-scaling-mPSM-audit-v3-lauschke-ex-vivo-scaling-mPSM-7>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-ex-vivo-scaling-mPSM-audit-v3-lauschke-ex-vivo-scaling-mPSM-8>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-ex-vivo-scaling-mPSM-audit-v3-lauschke-ex-vivo-scaling-mPSM-9> ;
        pk:hypothesisType "Scale-Invariant Kinematic Phase-Gradient Encoding (Ex Vivo Monolayer PSM)" ;
        pk:phenomenonScaleTier "6_organ_mm" ;
        pk:phenomenonSizeLog10Meters -2.138e+00 ;
        pk:phenomenonSizeMeters 7.276e-03 ;
        pk:sameSpeciesClaim <https://w3id.org/delphi/resource/claim/morphoeval-3d-vertex-blastocyst>,

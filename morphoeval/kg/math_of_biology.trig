        ns1:evidenceAgainst "2021-yaman-somitoid-chirality-buckling.py L2200–L2200: 3D WT ratio tolerance |rho_3D - 0.305| < 0.03 passes the 0.323 result <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L2200-L2200>" ;
        ns1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-repro-package-3> ;
        ns1:hasScore 9.2e-01 ;
        ns1:hasVerdict "faithful" .


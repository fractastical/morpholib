        ns1:evidenceAgainst "2006-riedel-delta-notch-phase-synchrony.py L164–L168: L = 24/4 somite lengths, 12 lateral cells, R_crit and Delta_n_det are fixed constants with no sensitivity analysis <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L164-L168>" ;
        ns1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-parameter-expressivity-2>,

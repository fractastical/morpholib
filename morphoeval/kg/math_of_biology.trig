    <https://w3id.org/delphi/resource/claim/morphoeval-burak-grid-cell-hexagonal-attractor> a pk:Claim ;
        rdfs:label "Burak & Fiete (2009), Hafting et al. (2005) & Stensola et al. (2012) entorhinal grid-cell hexagonal continuous attractor & discrete sqrt(2) module scaling (Rattus norvegicus medial entorhinal cortex (MEC Layer II) & hippocampal-entorhinal circuit)" ;
        dct:conformsTo <https://w3id.org/delphi/resource/math-law/burak-grid-cell-hexagonal-attractor-1>,
            <https://w3id.org/delphi/resource/math-law/burak-grid-cell-hexagonal-attractor-2>,
            <https://w3id.org/delphi/resource/math-law/burak-grid-cell-hexagonal-attractor-3>,
            <https://w3id.org/delphi/resource/math-law/burak-grid-cell-hexagonal-attractor-4>,
            <https://w3id.org/delphi/resource/math-law/burak-grid-cell-hexagonal-attractor-5> ;
        schema:about "Rattus norvegicus medial entorhinal cortex (MEC Layer II) & hippocampal-entorhinal circuit" ;
        schema:additionalProperty "does_not_claim: Biophysical HCN1 h-current single-channel gating kinetics or border-cell environmental wall shearing",
            "reconstructed_in_script: 2D FFT Burak-Fiete 4-subpopulation (E, N, W, S) continuous attractor neural network solver on a 36x36 toroidal sheet coupled to a 120-step 2D foraging trajectory across all 4 Stensola modules, 90 deg square non-resonant control, and Brandon et al. (2011) medial-septum inactivation (l=0, alpha=0) pinned-bump control",
            "reconstructed_in_script: Automated CV segmentation of the Rattus norvegicus hippocampal-entorhinal immunofluorescence micrograph (N=902 NeuN+ neuronal somata, 50-bin dorso-ventral laminar density profile r=0.9822, and MBP+ perforant-path fiber fraction)",
            "reported_in_source: Burak & Fiete (2009) PLoS Comput. Biol. 5:e1000291 2D continuous attractor network model with 4 head-direction-conjunctive subpopulations (N, S, E, W), outgoing kernel shift l*e_hat(theta), and velocity modulation alpha*v(t).e_hat(theta)",
            "reported_in_source: Hafting et al. (2005) Nature 436:801-806 discovery of 60 deg hexagonal firing lattices in Rattus norvegicus dorsomedial entorhinal cortex Layer II with rotational autocorrelogram peaks at 60 deg and 120 deg",
            "reported_in_source: Stensola et al. (2012) Nature 492:72-78 discretized dorso-ventral grid modules M1..M4 scaling by geometric ratio lambda_{m+1}/lambda_m approx sqrt(2) approx 1.42 ({38, 54, 76, 108} cm)",
            "transfer_boundary: Normalized 2D periodic neural sheet S(x,t) on [0, 2*pi)^2 mapped onto the 270x270 cm open-field foraging arena via velocity-integrated phase Phi(t)" ;
        pk:anatomicalStructure "Gap-junction bioelectric domain & ion-channel patch in Rattus norvegicus" ;
        pk:aristotelianEfficientCause "9. Bioelectric V_mem & Attractors" ;
        pk:aristotelianMegistonGenos "I. Enaima (Vertebrata)" ;
        pk:aristotelianPoionForm "Target Polarity & Neural Maps" ;
        pk:aristotelianPosonLaw "Bistable V_mem / G_ij Threshold" ;
        pk:aristotelianSubalternClass "Mammalia (Zootoka)" ;
        pk:biologicalGenus "Rattus" ;
        pk:derivedFromPaper <https://doi.org/10.1038/nature03721>,
            <https://doi.org/10.1038/nature11649>,
            <https://doi.org/10.1126/science.1201652>,
            <https://doi.org/10.1371/journal.pcbi.1000291> ;
        pk:geologicalAgeMa 0e+00 ;
        pk:geologicalPeriod "Holocene (Extant)" ;

        ns1:evidenceAgainst "2014-grieneisen-root-auxin-reflux-fountain.py L934–L947: six_regime_meristem_boundary_pearson_r = -0.331 against the synthetic table (NPA saturates PLT); honest negative result <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L934-L947>" ;
        ns1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-gravistimulation-lateral-auxin-ratio>,

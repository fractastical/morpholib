        ns1:evidenceAgainst "remediation needed: Couple the planar gastrovascular stolonal network to allorecognition (alr1/alr2) histocompatibility signaling to model self-fusion vs non-self hyperplastic stolon rejection between neighboring colonies." ;
        ns1:hasScore 9.38e-01 ;
        ns1:hasVerdict "faithful" .


        ns1:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-morphometric-validation> a ns1:LLMClaimAssessment ;
        rdfs:label "Painter, Maini & Othmer (1999) Pomacanthus Turing-chemotaxis stripe doubling on a growing curved flank & Keller-Segel rippling with slime-trail tensor — Morphometric validation: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1121-1299) returns 13 reference-anchored measurements: the 5 Pass 2 quantities (re-attributed) plus initial stripe count (3 vs 3), cylinder final count (12 vs 12), doubling scale ratio (2.03 vs 2.0), spindle final count (8 vs 12, reported as a curvature effect), iridophore contrast vs quasi-static flux-balance estimate (0.201 vs 0.117, ratio 1.73), chi_0 Spearman monotonicity (1.0), Law-6 threshold vs hysteresis bracket midpoint (4.22 vs 4.2) and trail/isotropic amplitude ratio (2.95 vs null 1.0). Deductions: the contrast measurement is an order-of-magnitude check only (the cells are not quasi-static during splitting), and the spindle count disagrees with its reference by 4 stripes." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        ns1:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        ns1:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        ns1:evidenceAgainst "1999-painter-chemotactic-stripe-splitting.py L1253–L1262: Iridophore contrast exceeds the quasi-static flux-balance estimate by 1.73x (same-order agreement only) <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L1253-L1262>" ;
        ns1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-2d-chemotactic-spot-vs-stripe-connected-component-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-body-length-scale-ratio-between-successive-stripe-doublings-s-6-12-s-3-6-on-the-growing-cylinder>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-chi-0-sensitivity-sweep-1e-5-1e-4-1e-3-spearman-monotonicity-of-stripe-contrast-with-chi-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-curved-surface-spindle-k-0-final-stripe-count-at-s-5-2-vs-kondo-asai-doubling-law>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-equal-diffusivity-critical-chemotactic-sensitivity-chi-c-d-n-d-c-1-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-iridophore-stripe-contrast-n-max-n-min-1-at-chi-0-1e-4-vs-quasi-static-flux-balance-boltzmann-estimate>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-kondo-asai-stripe-doubling-3-6-12-on-the-growing-flat-flank-cylinder-k-0-final-stripe-count-at-s-5-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-myxococcus-xanthus-specimen-chemotactic-rippling-stripe-wavelength>,

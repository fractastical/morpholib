            <https://doi.org/10.1152/jappl.1997.83.6.1814>,
            <https://doi.org/10.1164/ajrccm/145.6.1251> ;
        ns1:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-code-traceability>,

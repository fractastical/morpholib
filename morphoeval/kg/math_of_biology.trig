            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-parameter-expressivity-3> ;
        ns1:hasScore 9.1e-01 ;
        ns1:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-repro-package> a ns1:LLMClaimAssessment ;

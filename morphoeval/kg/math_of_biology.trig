    <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-source-traceability> a ns1:LLMClaimAssessment ;
        rdfs:label "Wolpert (1969) French Flag positional information, Tickle-Wolpert (1975) chick limb ZPA digit duplication, Ben-Zvi-Barkai (2010) scaling & 2D AER-FGF / ZPA-Shh limb bud paddle — Source and data traceability: 95/100" ;

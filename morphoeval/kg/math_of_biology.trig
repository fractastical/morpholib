            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-specimen-match-4> ;
        ns1:hasScore 8.6e-01 ;
        ns1:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-code-traceability> a ns1:LLMClaimAssessment ;

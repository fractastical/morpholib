            <https://w3id.org/delphi/resource/evidence/2026-10-19-echinoderm-pentaradial-symmetry-audit-v3-meinhardt-echinoderm-pentaradial-symmetry-4>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-echinoderm-pentaradial-symmetry-audit-v3-meinhardt-echinoderm-pentaradial-symmetry-5>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-echinoderm-pentaradial-symmetry-audit-v3-meinhardt-echinoderm-pentaradial-symmetry-6>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-echinoderm-pentaradial-symmetry-audit-v3-meinhardt-echinoderm-pentaradial-symmetry-7>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-echinoderm-pentaradial-symmetry-audit-v3-meinhardt-echinoderm-pentaradial-symmetry-8>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-echinoderm-pentaradial-symmetry-audit-v3-meinhardt-echinoderm-pentaradial-symmetry-9> ;
        pk:hypothesisType "Circular-Ring Activator-Inhibitor Mode m=5 Selection (k_m = m / R_ring), Lovén's Law (II, IV, I, III, V) Ocular/Ambulacral Ordering, Duboc Nodal Left-Right Rudiment Multiplicity, Ocular Plate Rule Biserial Plate Addition (Pass 3) & Continuous Nodal/BMP2-4 Hill Dose-Response (Pass 3)" ;
        pk:phenomenonScaleTier "7_organism_cm" ;

        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-19-convergent-extension-intercalation-audit-v2-zajac-convergent-extension-intercalation-1>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-convergent-extension-intercalation-audit-v2-zajac-convergent-extension-intercalation-2>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-convergent-extension-intercalation-audit-v2-zajac-convergent-extension-intercalation-3>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-convergent-extension-intercalation-audit-v2-zajac-convergent-extension-intercalation-4>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-convergent-extension-intercalation-audit-v2-zajac-convergent-extension-intercalation-5>,

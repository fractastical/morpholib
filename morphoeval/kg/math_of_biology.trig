        ns1:evidenceAgainst "1959-murray-vascular-cube-law-branching.py L1064–L1064: tortuosity_mean falls back to a hard-coded 1.01 when no branches are traced <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L1064-L1064>",
            "1959-murray-vascular-cube-law-branching.py L1656–L1665: Projection foreshortening quantified (central 3.3 deg, peripheral 32.4 deg) but the specimen angle measurement is not projection-corrected <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L1656-L1665>" ;
        ns1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-specimen-match-1>,

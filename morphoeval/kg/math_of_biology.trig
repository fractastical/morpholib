        ns1:evidenceAgainst "1998-goriely-tendril-perversion-intrinsic-curvature.py L1221–L1222: Section 6 banner still reads '6-Panel Synthesis Figure' although render_comparison_figure now draws 8 panels <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L1221-L1222>",
            "1998-goriely-tendril-perversion-intrinsic-curvature.py L897–L899: Unused private return keys _last_objective, _mat_dir, _last_opt_message; last_objective unbound when n_steps = 0 <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L897-L899>" ;
        ns1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-code-traceability-1>,

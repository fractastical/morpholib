            <https://w3id.org/delphi/resource/evidence/2026-10-19-limit-cycle-turing-audit-v3-schnakenberg-limit-cycle-turing-8>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-limit-cycle-turing-audit-v3-schnakenberg-limit-cycle-turing-9> ;
        pk:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
        pk:phenomenonScaleTier "5_primordium_100um" ;

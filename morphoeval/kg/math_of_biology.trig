            <https://doi.org/10.1098/rsif.2016.0555>,
            <https://doi.org/10.1242/dev.073759>,
            <https://doi.org/10.1242/dev.175893> ;
        pk:geologicalAgeMa 0e+00 ;
        pk:geologicalPeriod "Holocene (Extant)" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-19-xenopus-craniofacial-remap-audit-v2-bischof-xenopus-craniofacial-remap-1>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-xenopus-craniofacial-remap-audit-v2-bischof-xenopus-craniofacial-remap-2>,

    <https://w3id.org/probknow/resource/assessment/morphoeval-raup-shell-coiling-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Reproducibility package: 80/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Deterministic (no RNG), no external data, a CLI with --frames, --fps, --no-gif, --self-test-only and --out-dir, a self-test that runs before any drawing and fails loudly, outputs that fill their panels, and the minimal script runs headless with --no-show/--out. numpy, matplotlib and Pillow are in requirements.txt and pinned in requirements.lock.txt. Not higher because the GIF is 16 MB and 100 frames for a 7 s loop, and because Pillow silently merges 20 of the 120 rendered frames, which the script does not report." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;

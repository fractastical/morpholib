    <https://w3id.org/delphi/resource/math-law/levin-youtube-channel-math-8> a skos:Concept,
            pk:Concept ;
        rdfs:label "Law 8: Shreesha & Levin (2025) Spatialized Multicellular Prisoner's Dilemma Merge/Split Threshold Law" ;
        dct:description "O2/T4 exact 2D m x m lattice bond-counting and payoff threshold law proving single-cell cooperator extinction (-c < 0), viability breakeven at k = 4, boundary-defector tie at k = 16, and strict dominance for k ≥ 17 (first exact square k = 25) | Variables: k = m^2: multicellular square cluster size; f_int(m^2) = (4m^2 - 4m)/(4m^2) = 1 - 1/m: exact 2D square-lattice internal bond fraction; b, c: benefit and cost" ;
        dct:source "Shreesha & Levin (2025) OSF (https://osf.io/kpzju_v2) & @drmichaellevin [iOFHyNliS9M], [oe6v2fTewyU], [Q-yZ-IeZywg]" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9987ff10/models/2026-levin-channel-math-synthesis.py#L554-L588>,
            <https://github.com/fractastical/morpholib/blob/9987ff10/morphoeval/lean/loops/Loop_levin_youtube_channel_math.lean#L262-L288> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def multicell_coop_scaled_payoff (sqrt_k b c : Int) : Int :=
  (sqrt_k - 1) * b - sqrt_k * c
def multicell_defect_scaled_payoff (b : Int) : Int := b
theorem shreesha_morozov_multicellular_prisoners_dilemma_threshold
    (sqrt_k b c : Int) (hc : 0 < c) :
    multicell_coop_scaled_payoff 1 b c = -c ∧
    multicell_coop_scaled_payoff 1 b c < 0 ∧
    (0 ≤ multicell_coop_scaled_payoff sqrt_k b c ↔ b ≤ sqrt_k * (b - c)) ∧
    (multicell_defect_scaled_payoff b < multicell_coop_scaled_payoff sqrt_k b c ↔ 2 * b < sqrt_k * (b - c))
"""^^pk:lean4 ;
        skos:notation "π_C(k) = (1 - 1/√k) b - c ≥ 0 ⟺ b ≤ √k (b - c);   π_C(k) > π_D(k) = b/√k ⟺ 2b < √k (b - c)   (k_crit = 4, tie k = 16, strict dominance k ≥ 17 for b=2, c=1)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.patter.2025.101472>,
            <https://doi.org/10.1016/j.tree.2015.11.009>,
            <https://doi.org/10.1017/9781009300940>,
            <https://doi.org/10.1021/acs.jpclett.0c00641>,
            <https://doi.org/10.1038/s42003-025-08411-2>,
            <https://doi.org/10.1073/pnas.1314922110>,
            <https://doi.org/10.1080/01621459.1966.10502008>,
            <https://doi.org/10.1098/rsif.2017.0425>,
            <https://doi.org/10.1126/science.abc6182>,
            <https://doi.org/10.1371/journal.pcbi.1011465>,
            <https://doi.org/10.3389/fbioe.2016.00055>,
            <https://doi.org/10.3389/fnsys.2022.768201>,
            <https://doi.org/10.3389/fpsyg.2019.02688>,
            <https://doi.org/10.3390/biomimetics8010110>,
            <https://doi.org/10.3390/e25050748>,
            <https://doi.org/10.3390/e26040288>,
            <https://doi.org/10.3390/ijms24010285> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Load-Bearing Mathematical Laws of Multiscale Bioelectricity, Low-Rattling Selection, Polycomputing, Natural Induction GRNs, Causal Emergence 2.0 & Multicellular Game Theory" ;
        pk:leanDeclaration "LoopLevinYouTubeChannelMath.multicell_coop_scaled_payoff" ;
        pk:leanTheorem "LoopLevinYouTubeChannelMath.shreesha_morozov_multicellular_prisoners_dilemma_threshold" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/lewis-her1-her7-delayed-oscillator-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Lewis (2003) Her1/Her7 Autoinhibitory Delay-Loop Invariance & Protein Translation Balance" ;
        dct:description "Establishes the intracellular delayed negative feedback loop of the zebrafish segmentation clock and proves that stability and period depend only on the sum T_tot = T_m + T_p | Variables: m(t): her1/her7 mRNA molecules per cell; p(t): Her1/Her7 repressor protein molecules per cell; T_m: transcriptional delay (min); T_p: translational delay (min)" ;
        dct:source "Lewis (2003) Current Biology 13(16):1398-1408 Eqs. 1-2 & Appendix" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L154-L239>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_022_her1_her7_delayed_oscillator.lean#L27-L56> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def lewis_protein_dde_residual (a m_delayed b p : Int) : Int :=
  a * m_delayed - b * p
def lewis_total_loop_delay (T_m T_p : Int) : Int :=
  T_m + T_p
theorem lewis_2003_protein_steady_state_and_delay_invariance (a b q T_m T_p delta : Int) :
    lewis_protein_dde_residual a (b * q) b (a * q) = 0 ∧
    lewis_total_loop_delay (T_m + delta) (T_p - delta) = lewis_total_loop_delay T_m T_p"""^^pk:lean4 ;
        skos:notation "dp(t)/dt = a * m(t - T_p) - b * p(t),  dm(t)/dt = k / (1 + (p(t - T_m) / p_0)^n) - c * m(t),  T_tot = T_m + T_p" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0960-9822(03)00534-7>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1371/journal.pbio.0050150>,
            <https://doi.org/10.1371/journal.pbio.1001364> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Time-Delayed Transcriptional Oscillator & DeltaC-Notch Phase Coupling (Somitogenesis)" ;
        pk:leanDeclaration "MathOfBiology.Loop_022.lewis_protein_dde_residual" ;
        pk:leanTheorem "MathOfBiology.Loop_022.lewis_2003_protein_steady_state_and_delay_invariance" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/lewis-her1-her7-delayed-oscillator-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Lewis (2003) Delay-Driven Oscillation Period & Hopf Bifurcation Law" ;
        dct:description "Predicts the ~30 min zebrafish somite clock period from transcriptional/translational delays plus macromolecular half-lives and explains period shifts under intron deletion or Notch delay changes | Variables: T_osc: segmentation clock oscillation period (min); T_crit: Hopf bifurcation critical delay threshold (7.54 min computed); tau_m, tau_p: mRNA and protein half-life relaxation times (min)" ;
        dct:source "Lewis (2003) Current Biology 13(16):1398-1408 Box 1 & Figs. 2-3; Giudicelli et al. (2007) PLoS Biology 5:e150" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L219-L426>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_022_her1_her7_delayed_oscillator.lean#L58-L76> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def lewis_oscillation_period (T_m T_p tau_m tau_p : Nat) : Nat :=
  2 * (T_m + T_p + tau_m + tau_p)
theorem lewis_2003_oscillation_period_delay_sensitivity (T_m T_p tau_m tau_p delta_Tm : Nat) :
    lewis_oscillation_period (T_m + delta_Tm) T_p tau_m tau_p =
      lewis_oscillation_period T_m T_p tau_m tau_p + 2 * delta_Tm"""^^pk:lean4 ;
        skos:notation "T_osc = 2 * (T_m + T_p + tau_m + tau_p)  for  T_m + T_p > T_crit" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0960-9822(03)00534-7>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1371/journal.pbio.0050150>,
            <https://doi.org/10.1371/journal.pbio.1001364> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Time-Delayed Transcriptional Oscillator & DeltaC-Notch Phase Coupling (Somitogenesis)" ;
        pk:leanDeclaration "MathOfBiology.Loop_022.lewis_oscillation_period" ;
        pk:leanTheorem "MathOfBiology.Loop_022.lewis_2003_oscillation_period_delay_sensitivity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/lewis-her1-her7-delayed-oscillator-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Lewis (2003) DeltaC-Notch Intercellular Synchronization vs bea/des/aei Mutant Desynchronization Law" ;
        dct:description "Explains how intercellular DeltaC-Notch signaling maintains phase synchrony (R_sync > 0.95) against molecular copy-number noise in wild-type PSM, whereas Notch mutants (bea, des, aei; kappa=0) form 5-7 normal anterior somites before desynchronizing into salt-and-pepper defects | Variables: kappa: intercellular DeltaC-Notch phase-coupling strength; Delta_phi: phase difference between adjacent PSM cells; R_sync: Kuramoto tissue synchronization order parameter" ;
        dct:source "Lewis (2003) Current Biology 13(16):1398-1408 Figs. 5-6; Herrgen et al. (2010) Current Biology 20:1244-1253" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L429-L522>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_022_her1_her7_delayed_oscillator.lean#L78-L98> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def notch_phase_difference_step (kappa Delta_phi delta_omega : Int) : Int :=
  (1 - kappa) * Delta_phi + delta_omega
theorem lewis_2003_notch_coupling_synchronization_contraction (Delta_phi delta_omega : Int) :
    notch_phase_difference_step 1 Delta_phi 0 = 0 ∧
    notch_phase_difference_step 0 Delta_phi delta_omega = Delta_phi + delta_omega"""^^pk:lean4 ;
        skos:notation "Delta_phi_next = (1 - kappa) * Delta_phi + delta_omega;  R_sync = |1/N * sum_j exp(i * theta_j)|" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0960-9822(03)00534-7>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1371/journal.pbio.0050150>,
            <https://doi.org/10.1371/journal.pbio.1001364> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Time-Delayed Transcriptional Oscillator & DeltaC-Notch Phase Coupling (Somitogenesis)" ;
        pk:leanDeclaration "MathOfBiology.Loop_022.notch_phase_difference_step" ;
        pk:leanTheorem "MathOfBiology.Loop_022.lewis_2003_notch_coupling_synchronization_contraction" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/lewis-her1-her7-delayed-oscillator-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Lewis (2003) 2D Multicellular DDE Lattice: Notch-Gated her Transcription with Delayed DeltaC Translation & NICD Cleavage (Pass 3)" ;
        dct:description "Extends the 1D phase chain to an explicit 8 x 24 multicellular DDE sheet in which DeltaC protein is translated with delay, cleaved Notch (NICD) gates her1/her7 transcription, and eps_N = 0 reproduces the bea/des/aei loss of coupling (5-7 coherent anterior cycles before salt-and-pepper desynchronisation); a uniform DeltaC field is a fixed point of the coupling | Variables: N_i: NICD molecules in cell i; Dbar_i: mean DeltaC protein of the 4 von Neumann neighbours; T_N: Notch binding/gamma-secretase cleavage/nuclear-entry delay (min); T_pD: DeltaC translation+trafficking delay (min); eps_N: Notch-dependent fraction of her transcription (0 in bea/des/aei); K_D, N_0, h: NICD occupancy constants" ;
        dct:source "Lewis (2003) Current Biology 13(16):1398-1408 Figs. 5-6 (coupled-cell DDEs); Herrgen et al. (2010) Current Biology 20:1244-1253 (coupling delay sets collective period)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L544-L735>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_022_her1_her7_delayed_oscillator.lean#L112-L144> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def notch_transcription_gate (eps_N s : Int) : Int :=
  (1 - eps_N) + eps_N * s
theorem lewis_2003_notch_gate_mutant_independence (s : Int) :
    notch_transcription_gate 0 s = 1 ∧ notch_transcription_gate 1 s = s
def deltac_neighbour_mean (D_up D_down D_left D_right : Nat) : Nat :=
  (D_up + D_down + D_left + D_right) / 4
theorem deltac_lattice_uniform_neighbour_mean_fixed_point (D : Nat) :
    deltac_neighbour_mean D D D D = D"""^^pk:lean4 ;
        skos:notation "dN_i/dt = k_N * Dbar_i(t - T_N) / (K_D + Dbar_i(t - T_N)) - b_N * N_i;  G_N(N) = (1 - eps_N) + eps_N * N^h / (N_0^h + N^h);  Dbar_i = (D_up + D_down + D_left + D_right) / 4;  dD_i/dt = a_D * d_i(t - T_pD) - b_D * D_i" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0960-9822(03)00534-7>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1371/journal.pbio.0050150>,
            <https://doi.org/10.1371/journal.pbio.1001364> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Time-Delayed Transcriptional Oscillator & DeltaC-Notch Phase Coupling (Somitogenesis)" ;
        pk:leanDeclaration "MathOfBiology.Loop_022.notch_transcription_gate" ;
        pk:leanTheorem "MathOfBiology.Loop_022.lewis_2003_notch_gate_mutant_independence" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/lewis-her1-her7-delayed-oscillator-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Schroter et al. (2012) Her1/Her7/Hes6 Dimer DNA-Binding Truth Table on the AP Hes6 Gradient (Pass 3)" ;
        dct:description "Couples the anterior-to-posterior phase gradient to the dimer composition: Hes6-high posterior cells are repressed through the short-delay Her7:Hes6 loop (faster), Hes6-low anterior cells through the Her1 homodimer loop (slower), hes6-null tissue is AP-uniform at the her1-only period; the lattice AP period gradient is bracketed by the pure-branch periods | Variables: p1, p7: Her1, Her7 protein molecules; h6: non-oscillating Hes6 protein (posterior-high AP gradient); B_AB: DNA-binding truth table bit; K_11, K_76: dimer dissociation constants (reduced parameters); T7, T1: her7 (fast) and her1 (slow) loop delays; w, v: Hes6-dependent repression weights" ;
        dct:source "Schroter et al. (2012) PLoS Biology 10(7):e1001364 Figs. 2-3 (dimerization and DNA binding), Figs. 5-7 (hes6 gradient, genetic interactions); Giudicelli et al. (2007) PLoS Biology 5:e150 (kinematic waves)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L532-L596,L852-L874>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_022_her1_her7_delayed_oscillator.lean#L146-L190> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def schroter_dimer_repression (B11 B76 B17 B16 B77 B66 p1 p7 h6 : Nat) : Nat :=
  B11 * (p1 * p1) + B76 * (p7 * h6) + B17 * (p1 * p7) + B16 * (p1 * h6) + B77 * (p7 * p7) + B66 * (h6 * h6)
theorem schroter_2012_dimer_truth_table_repression (p1 p7 h6 : Nat) :
    schroter_dimer_repression 1 1 0 0 0 0 p1 p7 h6 = p1 * p1 + p7 * h6 ∧
    schroter_dimer_repression 1 1 0 0 0 0 p1 p7 0 = p1 * p1
def hes6_weighted_loop_delay (w v T7 T1 : Nat) : Nat :=
  w * T7 + v * T1
theorem schroter_2012_hes6_gradient_period_interpolation (w v T7 T1 : Nat) (h : T7 ≤ T1) :
    (w + v) * T7 ≤ hes6_weighted_loop_delay w v T7 T1 ∧
    hes6_weighted_loop_delay w v T7 T1 ≤ (w + v) * T1"""^^pk:lean4 ;
        skos:notation "Rep_i = sum_{(A,B)} B_AB * [A:B]_i / K_AB,  [A:B] = A * B;  B_11 = B_76 = 1, B_17 = B_16 = B_77 = B_66 = 0;  Hes6_i = H_ant + (H_post - H_ant) * x_i / (n_cols - 1);  (w + v) T7 <= w T7 + v T1 <= (w + v) T1" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0960-9822(03)00534-7>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1371/journal.pbio.0050150>,
            <https://doi.org/10.1371/journal.pbio.1001364> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Time-Delayed Transcriptional Oscillator & DeltaC-Notch Phase Coupling (Somitogenesis)" ;
        pk:leanDeclaration "MathOfBiology.Loop_022.schroter_dimer_repression" ;
        pk:leanTheorem "MathOfBiology.Loop_022.schroter_2012_dimer_truth_table_repression" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/liang-chiral-seed-pod-opening-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Incompatible Saddle Target Curvature Tensor & Gauss's Theorema Egregium Incompatibility Law" ;
        dct:description "Proves that orthogonal ±45° fibrous shrinkage in Bauhinia variegata pod valves prescribes a strictly negative Gaussian curvature det(b_0) = -κ_0^2 < 0 that is geometrically incompatible with the flat reference metric (K = 0) by Gauss's Theorema Egregium | Variables: κ_0: principal intrinsic shrinkage curvature of orthogonal ±45° sclerenchyma layers (cm^-1); b_0: target second fundamental form; K_target = det(b_0): target Gaussian curvature (cm^-2)" ;
        dct:source "Armon, Efrati, Kupferman & Sharon (2011) Science 333(6050):1726-1730; Efrati, Sharon & Kupferman (2009) J. Mech. Phys. Solids 57(4):762-775" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L130-L235>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_065_chiral_seed_pod_opening.lean#L27-L46> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def saddle_target_gaussian_curvature (kappa0 : Int) : Int :=
  kappa0 * (-kappa0)
def saddle_target_trace (kappa0 : Int) : Int :=
  kappa0 + (-kappa0)
theorem armon_gauss_saddle_incompatibility (kappa0 : Int) :
    saddle_target_trace kappa0 = 0 ∧
    saddle_target_gaussian_curvature kappa0 = -(kappa0 * kappa0) ∧
    (∀ k : Nat, saddle_target_gaussian_curvature ((k : Int) + 1) < 0)
"""^^pk:lean4 ;
        skos:notation "b_0 = diag(κ_0, -κ_0),  Tr(b_0) = 0,  K_target = det(b_0) = -κ_0^2 < 0 ≠ K(a_0) = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF02703696>,
            <https://doi.org/10.1016/j.cell.2016.05.002>,
            <https://doi.org/10.1016/j.jmps.2008.12.004>,
            <https://doi.org/10.1017/CBO9780511546761>,
            <https://doi.org/10.1038/nature03185>,
            <https://doi.org/10.1039/c3sm52313f>,
            <https://doi.org/10.1111/j.1469-8137.1977.tb02174.x>,
            <https://doi.org/10.1126/science.1203874> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Non-Euclidean Incompatible Shell Elasticity, Gauss Incompatibility (det b_0 = -κ_0^2 < 0) & Föppl–von Kármán Helicoid-to-Helical-Ribbon Pitchfork Bifurcation" ;
        pk:leanDeclaration "MathOfBiology.Loop_065.saddle_target_gaussian_curvature" ;
        pk:leanTheorem "MathOfBiology.Loop_065.armon_gauss_saddle_incompatibility" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/liang-chiral-seed-pod-opening-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Narrow-Strip Bending-Dominated Pure-Twist Helicoid & Cutting-Angle Chirality Law" ;
        dct:description "Explains why narrow valve strips (w̃ ≤ w̃_c) adopt a minimal-surface pure-twist helicoid (H* = 0, R = 0) with maximum twist at θ = 45° and why cutting at θ = 0° or 90° eliminates chirality (achiral circular ring) | Variables: w̃ = W√(κ_0/h): dimensionless Föppl-von Kármán ribbon width; θ: cutting angle relative to principal curvature axis; τ: centerline geodesic torsion (cm^-1); R: helix radius (cm)" ;
        dct:source "Armon, Efrati, Kupferman & Sharon (2011) Science 333(6050):1726-1730 Figs. 2-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L240-L395>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_065_chiral_seed_pod_opening.lean#L61-L72> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def narrow_helicoid_torsion (kappa0 sin_2theta : Int) : Int :=
  kappa0 * sin_2theta
theorem armon_narrow_helicoid_chirality (kappa0 sin_2theta : Int) :
    narrow_helicoid_torsion kappa0 1 = kappa0 ∧
    narrow_helicoid_torsion kappa0 0 = 0 ∧
    narrow_helicoid_torsion kappa0 (-sin_2theta) = -narrow_helicoid_torsion kappa0 sin_2theta
"""^^pk:lean4 ;
        skos:notation "w̃ = W √(κ_0 / h) ≤ w̃_c  ⇒  H*(w̃) = 0,  R(w̃, 45°) = 0,  τ(θ) = D sin(2θ),  τ(0°) = τ(90°) = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF02703696>,
            <https://doi.org/10.1016/j.cell.2016.05.002>,
            <https://doi.org/10.1016/j.jmps.2008.12.004>,
            <https://doi.org/10.1017/CBO9780511546761>,
            <https://doi.org/10.1038/nature03185>,
            <https://doi.org/10.1039/c3sm52313f>,
            <https://doi.org/10.1111/j.1469-8137.1977.tb02174.x>,
            <https://doi.org/10.1126/science.1203874> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Non-Euclidean Incompatible Shell Elasticity, Gauss Incompatibility (det b_0 = -κ_0^2 < 0) & Föppl–von Kármán Helicoid-to-Helical-Ribbon Pitchfork Bifurcation" ;
        pk:leanDeclaration "MathOfBiology.Loop_065.narrow_helicoid_torsion" ;
        pk:leanTheorem "MathOfBiology.Loop_065.armon_narrow_helicoid_chirality" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/liang-chiral-seed-pod-opening-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Supercritical Pitchfork Bifurcation & Wide-Ribbon Cylindrical Helical Curvature Law" ;
        dct:description "Establishes the supercritical pitchfork bifurcation from a pure-twist helicoid (H = 0, R = 0) to a cylindrical helical ribbon (H → ±(1-ν)κ_0/2, K → 0) when dimensionless valve width exceeds w̃_c | Variables: w̃_c: critical pitchfork dimensionless width; ν: Poisson ratio; H*(w̃): equilibrium mean curvature (cm^-1); H_∞ = (1-ν)κ_0/2: wide-ribbon asymptotic mean curvature" ;
        dct:source "Armon, Efrati, Kupferman & Sharon (2011) Science 333(6050):1726-1730 Eq. 1-4; Armon et al. (2014) Soft Matter 10:2733-2740" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L240-L445>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_065_chiral_seed_pod_opening.lean#L86-L98> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cylindrical_ribbon_two_H (one_minus_nu kappa0 : Int) : Int :=
  one_minus_nu * kappa0 + 0
def cylindrical_ribbon_gaussian_K (one_minus_nu kappa0 : Int) : Int :=
  (one_minus_nu * kappa0) * 0
theorem armon_wide_cylindrical_ribbon_asymptote (one_minus_nu kappa0 : Int) :
    cylindrical_ribbon_two_H one_minus_nu kappa0 = one_minus_nu * kappa0 ∧
    cylindrical_ribbon_gaussian_K one_minus_nu kappa0 = 0 ∧
    cylindrical_ribbon_two_H (-one_minus_nu) kappa0 = -cylindrical_ribbon_two_H one_minus_nu kappa0
"""^^pk:lean4 ;
        skos:notation "w̃_c = (16(1 + ν) / √(1 - ν^2))^(1/4),  H*(w̃) = ±((1 - ν)/2) κ_0 √(1 - (w̃_c / w̃)^4)  (w̃ > w̃_c),  K_∞ = κ_1 κ_2 = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF02703696>,
            <https://doi.org/10.1016/j.cell.2016.05.002>,
            <https://doi.org/10.1016/j.jmps.2008.12.004>,
            <https://doi.org/10.1017/CBO9780511546761>,
            <https://doi.org/10.1038/nature03185>,
            <https://doi.org/10.1039/c3sm52313f>,
            <https://doi.org/10.1111/j.1469-8137.1977.tb02174.x>,
            <https://doi.org/10.1126/science.1203874> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Non-Euclidean Incompatible Shell Elasticity, Gauss Incompatibility (det b_0 = -κ_0^2 < 0) & Föppl–von Kármán Helicoid-to-Helical-Ribbon Pitchfork Bifurcation" ;
        pk:leanDeclaration "MathOfBiology.Loop_065.cylindrical_ribbon_two_H" ;
        pk:leanTheorem "MathOfBiology.Loop_065.armon_wide_cylindrical_ribbon_asymptote" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/liang-chiral-seed-pod-opening-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Freund Dynamic Mode-I Suture Crack Equation of Motion & Griffith Arrest Law (Pass 3)" ;
        dct:description "Couples the stored incompatible-shell bending energy of the closed pod (Pass 2 minimizer) to transient crack propagation along the suture: the crack runs only where released energy exceeds the local toughness, at sub-Rayleigh speed, and arrests (stick-slip, drying-controlled) where Γ_c(a) ≥ G(t) | Variables: G: suture energy release rate from the quasi-static minimizer (J/m²); Γ_c(a): heterogeneous suture fracture toughness (J/m², provenance=model); c_R = 0.93 √(Y/(2(1+ν)ρ)): Rayleigh wave speed (m/s); v: crack-tip speed (m/s); a: crack position along the suture (m)" ;
        dct:source "Freund LB (1990) Dynamic Fracture Mechanics, Cambridge University Press, Ch. 7 (doi 10.1017/CBO9780511546761, unverified offline); Efrati, Sharon & Kupferman (2009) JMPS 57:762-775 for B_eff" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L733-L859>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_065_chiral_seed_pod_opening.lean#L126-L149> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def freund_scaled_crack_speed (cR G gamma : Int) : Int :=
  cR * (G - gamma)
theorem freund_crack_speed_arrest_and_monotonicity (cR G1 G2 gamma : Int) :
    freund_scaled_crack_speed cR gamma gamma = 0 ∧
    (0 < cR → gamma < G1 → 0 < freund_scaled_crack_speed cR G1 gamma) ∧
    (0 ≤ cR → G1 ≤ G2 →
      freund_scaled_crack_speed cR G1 gamma ≤ freund_scaled_crack_speed cR G2 gamma) ∧
    (0 < cR → 0 < gamma → freund_scaled_crack_speed cR G1 gamma < cR * G1)
"""^^pk:lean4 ;
        skos:notation "G = B_eff (κ_0² − e_final) W / h,  B_eff = Y h³ / (12(1+ν));  da/dt = v = c_R max(0, 1 − Γ_c(a)/G)  ⇔  G v = c_R (G − Γ_c);  arrest when Γ_c ≥ G;  v < c_R" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF02703696>,
            <https://doi.org/10.1016/j.cell.2016.05.002>,
            <https://doi.org/10.1016/j.jmps.2008.12.004>,
            <https://doi.org/10.1017/CBO9780511546761>,
            <https://doi.org/10.1038/nature03185>,
            <https://doi.org/10.1039/c3sm52313f>,
            <https://doi.org/10.1111/j.1469-8137.1977.tb02174.x>,
            <https://doi.org/10.1126/science.1203874> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Non-Euclidean Incompatible Shell Elasticity, Gauss Incompatibility (det b_0 = -κ_0^2 < 0) & Föppl–von Kármán Helicoid-to-Helical-Ribbon Pitchfork Bifurcation" ;
        pk:leanDeclaration "MathOfBiology.Loop_065.freund_scaled_crack_speed" ;
        pk:leanTheorem "MathOfBiology.Loop_065.freund_crack_speed_arrest_and_monotonicity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/liang-chiral-seed-pod-opening-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Elastic-Catapult Energy Partition & Ballistic Seed Ejection Law (Pass 3)" ;
        dct:description "Turns the released non-Euclidean shell energy into a ballistic seed launch speed and drag-limited range; proves energy descent (ΔU ≥ 0), no energy creation (KE ≤ ΔU), vanishing release for the κ_0 = 0 control, and additivity over seed segments | Variables: e_init = κ_0²: reduced bending energy of the flat closed valve; e_final: relaxed minimizer energy; ΔU_seg: released energy per seed-bearing valve segment (J); η: catapult efficiency (provenance=model); m_seg/3 + m_seed: effective launched mass (kg); v_seed: launch speed (m/s); C_d, A: seed drag coefficient and area" ;
        dct:source "Vogel S (2005) J. Biosci. 30:167-175 (doi 10.1007/BF02703696, unverified offline); Hofhuis et al. (2016) Cell 166:222-233 (doi 10.1016/j.cell.2016.05.002, unverified offline) as transfer-boundary launch-speed benchmark; Swaine & Beer (1977) New Phytol. 78:695-708" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L861-L930>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_065_chiral_seed_pod_opening.lean#L164-L189> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def released_elastic_energy (e_init e_final : Int) : Int :=
  e_init - e_final
def catapult_kinetic_energy (eta dU : Int) : Int :=
  eta * dU
theorem elastic_catapult_energy_partition (e_init e_final eta dU1 dU2 : Int) :
    (e_final ≤ e_init → 0 ≤ released_elastic_energy e_init e_final) ∧
    (0 ≤ eta → 0 ≤ dU1 → 0 ≤ catapult_kinetic_energy eta dU1) ∧
    (eta ≤ 1 → 0 ≤ dU1 → catapult_kinetic_energy eta dU1 ≤ dU1) ∧
    released_elastic_energy 0 0 = 0 ∧
    catapult_kinetic_energy eta (dU1 + dU2) =
      catapult_kinetic_energy eta dU1 + catapult_kinetic_energy eta dU2
"""^^pk:lean4 ;
        skos:notation "ΔU_seg = B_eff (κ_0² − e_final) W l_seg ≥ 0;  KE = η ΔU_seg,  0 ≤ η ≤ 1;  v_seed = √(2 η ΔU_seg / (m_seg/3 + m_seed));  m dv/dt = m g − ½ ρ_air C_d A |v| v" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF02703696>,
            <https://doi.org/10.1016/j.cell.2016.05.002>,
            <https://doi.org/10.1016/j.jmps.2008.12.004>,
            <https://doi.org/10.1017/CBO9780511546761>,
            <https://doi.org/10.1038/nature03185>,
            <https://doi.org/10.1039/c3sm52313f>,
            <https://doi.org/10.1111/j.1469-8137.1977.tb02174.x>,
            <https://doi.org/10.1126/science.1203874> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Non-Euclidean Incompatible Shell Elasticity, Gauss Incompatibility (det b_0 = -κ_0^2 < 0) & Föppl–von Kármán Helicoid-to-Helical-Ribbon Pitchfork Bifurcation" ;
        pk:leanDeclaration "MathOfBiology.Loop_065.released_elastic_energy" ;
        pk:leanTheorem "MathOfBiology.Loop_065.elastic_catapult_energy_partition" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/lobo-limbform-morphology-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Lobo et al. (2014) Limbform Recursive Segmental Tree Vector Law" ;
        dct:description "Decodes normal, regenerating, and ectopic/supernumerary amphibian and vertebrate limb morphologies from LimbformDB | Variables: L_k: limb podial/zeugopod/stylopod segment length; α_j: relative joint branching angle; r: segment radius" ;
        dct:source "Lobo, Feldman & Levin (2014) Dev. Biol. / Bioinformatics" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7a781325/2014-lobo-limbform-morphology.py#L75-L210>,
            <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/lean/MathOfBiology.lean#L274-L287> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """inductive LimbTree where
  | leaf (length : Nat) : LimbTree
  | branch (length : Nat) (child : LimbTree) : LimbTree
theorem lobo_2014_three_segment_axis (L1 L2 L3 : Nat) :
    limb_segment_count (LimbTree.branch L1 (LimbTree.branch L2 (LimbTree.leaf L3))) = 3 := by rfl"""^^pk:lean4 ;
        skos:notation "x_{k+1} = x_k + L_k [cos(∑_{j≤k} α_j), sin(∑_{j≤k} α_j)]^T,   T = (s, α, r, L, children)" ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Recursive Tree Graph Grammar & Segmental Kinematics" ;
        pk:leanDeclaration "MathOfBiology.limb_segment_count" ;
        pk:leanTheorem "MathOfBiology.lobo_2014_three_segment_axis" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/manukyan-ocellated-lizard-ca-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hexagonal Skin-Scale First-Nearest-Neighbor Partition & Labyrinthine Symmetry" ;
        dct:description "Establishes the exact 6-neighbor conservation law on hexagonal lizard skin scales and proves n_g = n_b = 3 is the unique symmetric labyrinthine chain degree | Variables: n_g: number of green first-nearest-neighbor scales; n_b: number of black first-nearest-neighbor scales on the 6-regular hexagonal skin lattice" ;
        dct:source "Manukyan et al. (2017) Nature 544(7649):173-179 Fig. 3d-f" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L181-L322>,
            <https://github.com/fractastical/morpholib/blob/bd54e11/morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean#L19-L36> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def hex_black_neighbors (n_g : Nat) : Nat := 6 - n_g
theorem hex_scale_neighbor_partition_and_symmetry (n_g : Nat) (h : n_g ≤ 6) :
    n_g + hex_black_neighbors n_g = 6 ∧
    (n_g = hex_black_neighbors n_g ↔ n_g = 3) := by
  unfold hex_black_neighbors; omega
"""^^pk:lean4 ;
        skos:notation "n_g + n_b = 6  (n_g, n_b ∈ {0..6});   n_g = n_b ⟺ n_g = 3" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/nature22031>,
            <https://doi.org/10.1038/s41467-021-22525-1>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1103/PhysRevX.13.041011> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Scale-Level Cellular Automaton vs PDE" ;
        pk:leanDeclaration "MathOfBiology.Loop_009.hex_black_neighbors" ;
        pk:leanTheorem "MathOfBiology.Loop_009.hex_scale_neighbor_partition_and_symmetry" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/manukyan-ocellated-lizard-ca-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Scale-Border Thickness Reduction Inter-Scale Flux Attenuation (D_border = P D_interior ≪ D_interior)" ;
        dct:description "Proves that thinning skin at scale borders attenuates inter-scale diffusive flux relative to intra-scale homogenization, discretizing continuous Turing PDEs into monochromatic scale states | Variables: P = h_border / h_interior: scale-border thickness reduction factor (P ≈ 0.17 in Timon lepidus); D_interior: intra-scale morphogen diffusivity; ∇u: inter-scale morphogen difference" ;
        dct:source "Manukyan et al. (2017) Nature 544(7649):173-179 Fig. 4 & Methods Eqs. (1)-(8); Fofonjka & Milinkovitch (2021) Nat. Commun. 12:2433" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L616-L717>,
            <https://github.com/fractastical/morpholib/blob/bd54e11/morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean#L43-L66> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def interscale_border_flux (P_pct flux_unit : Int) : Int :=
  P_pct * flux_unit
theorem border_diffusivity_reduction_quenches_interscale_flux
    (P_pct flux_unit : Int)
    (hP_lo : P_pct ≥ 1) (hP_hi : P_pct ≤ 99) (hF : flux_unit ≥ 1) :
    interscale_border_flux 0 flux_unit = 0 ∧
    interscale_border_flux 17 flux_unit > 0 ∧
    interscale_border_flux 17 flux_unit < interscale_border_flux 100 flux_unit ∧
    P_pct < 100 := by
  unfold interscale_border_flux; omega
"""^^pk:lean4 ;
        skos:notation "J_border = P · D_interior · ∇u;   0 < P < 1 ⟹ 0 < J_border < J_continuum,   P = 0 ⟹ J_border = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/nature22031>,
            <https://doi.org/10.1038/s41467-021-22525-1>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1103/PhysRevX.13.041011> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Scale-Level Cellular Automaton vs PDE" ;
        pk:leanDeclaration "MathOfBiology.Loop_009.interscale_border_flux" ;
        pk:leanTheorem "MathOfBiology.Loop_009.border_diffusivity_reduction_quenches_interscale_flux" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/manukyan-ocellated-lizard-ca-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Manukyan Hexagonal Outer-Totalistic Cellular Automaton Labyrinthine Attractor Rule" ;
        dct:description "Proves that n_g = 3 is a simultaneous fixed point for both green and black scales while overcrowded green clusters (n_g ≥ 4) flip to black and isolated black pockets (n_g ≤ 1) flip to green | Variables: s ∈ {0, 1}: scale color state (0 = black, 1 = green); n_g ∈ {0..6}: number of green first-nearest neighbors" ;
        dct:source "Manukyan et al. (2017) Nature 544(7649):173-179 Figs. 2-3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L204-L322>,
            <https://github.com/fractastical/morpholib/blob/bd54e11/morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean#L83-L115> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def manukyan_ca_step (s n_g : Nat) : Nat :=
  if s = 1 then (if 2 ≤ n_g ∧ n_g ≤ 3 then 1 else 0)
  else (if n_g ≤ 1 then 1 else 0)
theorem manukyan_outer_totalistic_ca_labyrinth_fixed_point :
    manukyan_ca_step 1 3 = 1 ∧ manukyan_ca_step 0 3 = 0 ∧
    manukyan_ca_step 1 5 = 0 ∧ manukyan_ca_step 0 1 = 1 := by decide
"""^^pk:lean4 ;
        skos:notation "S_i(t+1) = Φ(S_i(t), n_g(i));   Φ(1, 3) = 1 ∧ Φ(0, 3) = 0 ∧ Φ(1, 5) = 0 ∧ Φ(0, 1) = 1" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/nature22031>,
            <https://doi.org/10.1038/s41467-021-22525-1>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1103/PhysRevX.13.041011> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Scale-Level Cellular Automaton vs PDE" ;
        pk:leanDeclaration "MathOfBiology.Loop_009.manukyan_ca_step" ;
        pk:leanTheorem "MathOfBiology.Loop_009.manukyan_outer_totalistic_ca_labyrinth_fixed_point" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/manukyan-ocellated-lizard-ca-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Thin-Film Depth Average of a Skin Column (3D voxel skin volume → 2D depth-averaged reduction)" ;
        dct:description "Justifies replacing the 3D voxel field by its depth average wherever the field is vertically uniform (thin-film regime h ≪ λ_c) and gives the border column its reduced capacity h(x) in the depth-averaged equation | Variables: h: skin column height in voxels (h_interior = 12, h_border = P·h_interior); c: voxel concentration; ū: depth-averaged concentration used by the 2D reduction d ū/dt = F(ū) + (1/h)∇·(h D ∇ū)" ;
        dct:source "Fofonjka & Milinkovitch (2021) Nat. Commun. 12:2433 (3D skin-scale reaction-diffusion); thin-film / lubrication reduction of diffusion in a domain of varying thickness" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L739-L865>,
            <https://github.com/fractastical/morpholib/blob/bd54e11/morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean#L109-L137> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def column_mass (h c : Nat) : Nat := h * c
def depth_average (h m : Nat) : Nat := m / h
theorem thin_film_depth_average_recovers_uniform_column
    (h_interior h_border c : Nat) (hpos : 0 < h_interior) (hle : h_border ≤ h_interior) :
    depth_average h_interior (column_mass h_interior c) = c ∧
    column_mass h_border c ≤ column_mass h_interior c := by
  unfold depth_average column_mass
  exact ⟨Nat.mul_div_cancel_left c hpos, Nat.mul_le_mul_right c hle⟩
"""^^pk:lean4 ;
        skos:notation "ū = (1/h) Σ_z u;   u(z) ≡ c ⟹ ū = (h·c)/h = c;   h_border ≤ h_interior ⟹ h_border·c ≤ h_interior·c" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/nature22031>,
            <https://doi.org/10.1038/s41467-021-22525-1>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1103/PhysRevX.13.041011> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Scale-Level Cellular Automaton vs PDE" ;
        pk:leanDeclaration "MathOfBiology.Loop_009.column_mass, MathOfBiology.Loop_009.depth_average" ;
        pk:leanTheorem "MathOfBiology.Loop_009.thin_film_depth_average_recovers_uniform_column" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/manukyan-ocellated-lizard-ca-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Finite-Volume Face Conductance Between Skin Columns Equals Shared Face Area (min(h_i, h_j)·D)" ;
        dct:description "Proves that in the voxel skin volume all inter-scale flux passes through the thinned border with conductance reduced exactly by the thickness ratio P = h_border/h_interior, that P = 0 insulates scales, and that the 2D reduction's face conductance min(h_i, h_j)·D is the exact depth integral of the 3D face | Variables: h_i, h_j: heights (voxels) of two laterally adjacent skin columns; D: morphogen diffusivity; C_ij: depth-integrated conductance of their shared vertical face (number of skin-skin voxel pairs × D)" ;
        dct:source "Manukyan et al. (2017) Nature 544(7649):173-179 Fig. 4 (P = h_border/h_interior ≈ 0.17); Fofonjka & Milinkovitch (2021) Nat. Commun. 12:2433" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L539-L557>,
            <https://github.com/fractastical/morpholib/blob/bd54e11/morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean#L140-L176> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def face_conductance (h_i h_j D : Nat) : Nat := min h_i h_j * D
theorem voxel_face_conductance_ratio_equals_thickness_ratio
    (h_interior h_border D : Nat) (hlt : h_border < h_interior) (hD : 0 < D) :
    face_conductance h_interior h_border D = h_border * D ∧
    face_conductance h_interior h_interior D = h_interior * D ∧
    face_conductance h_interior h_border D * h_interior =
      face_conductance h_interior h_interior D * h_border ∧
    face_conductance h_interior 0 D = 0 ∧
    face_conductance h_interior h_border D < face_conductance h_interior h_interior D := by
  unfold face_conductance
  have hmin : min h_interior h_border = h_border := Nat.min_eq_right (Nat.le_of_lt hlt)
  have hself : min h_interior h_interior = h_interior := Nat.min_self h_interior
  have hzero : min h_interior 0 = 0 := Nat.min_eq_right (Nat.zero_le h_interior)
  rw [hmin, hself, hzero]
  refine ⟨rfl, rfl, ?_, by simp, Nat.mul_lt_mul_of_pos_right hlt hD⟩
  ac_rfl
"""^^pk:lean4 ;
        skos:notation "C_ij = min(h_i, h_j)·D;   C_int,border·h_interior = C_int,int·h_border  (ratio = h_border/h_interior ∀ D);   h_border = 0 ⟹ C = 0;   h_border < h_interior ∧ D > 0 ⟹ C_int,border < C_int,int" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/nature22031>,
            <https://doi.org/10.1038/s41467-021-22525-1>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1103/PhysRevX.13.041011> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Scale-Level Cellular Automaton vs PDE" ;
        pk:leanDeclaration "MathOfBiology.Loop_009.face_conductance" ;
        pk:leanTheorem "MathOfBiology.Loop_009.voxel_face_conductance_ratio_equals_thickness_ratio" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/meinhardt-echinoderm-pentaradial-symmetry-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Circular Hydrocoel Ring Laplacian Eigenvalue & Pentaradial Mode m^* = 5 Selection Law" ;
        dct:description "Governs spontaneous symmetry breaking of the closed circular left hydrocoel ring into 5 primary podia lobes spaced at 72 deg, while explaining 4-rayed (90 deg) and 6-rayed (60 deg) teratological variants under ring-radius perturbations | Variables: m in {3, 4, 5, 6, 7}: azimuthal harmonic mode on closed hydrocoel ring; R_ring: hydrocoel ring radius (um); lambda_c: Turing critical wavelength (um); Delta_theta = 360 deg / m: inter-ambulacral angular spacing" ;
        dct:source "Meinhardt (2008) Curr. Top. Dev. Biol. 81:1-63; Morris (2012) Evol. Dev. 14(4):313-326" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a69596cc/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L192-L421>,
            <https://github.com/fractastical/morpholib/blob/a69596cc/morphoeval/lean/loops/Loop_075_echinoderm_pentaradial_symmetry.lean#L24-L85> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def ring_laplacian_eigen_num (m : Nat) : Nat := m * m
def hydrocoel_angular_period_deg (m : Nat) : Nat := 360 / m
theorem hydrocoel_ring_pentaradial_mode5_selection :
    ring_laplacian_eigen_num 5 = 25 ∧
    hydrocoel_angular_period_deg 5 = 72 ∧
    5 * hydrocoel_angular_period_deg 5 = 360 ∧
    hydrocoel_turing_growth_score 5 50 > hydrocoel_turing_growth_score 4 50 ∧
    hydrocoel_turing_growth_score 5 50 > hydrocoel_turing_growth_score 6 50 := by decide
"""^^pk:lean4 ;
        skos:notation "- (1 / R_ring^2) d^2(cos(m theta))/dtheta^2 = (m^2 / R_ring^2) cos(m theta),   m^* = argmax_m sigma(m / R_ring) = 5 (Delta_theta = 72 deg) when 2*pi R_ring / lambda_c in (4.5, 5.5)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0070-2153(07)81001-5>,
            <https://doi.org/10.1016/j.devcel.2005.05.008>,
            <https://doi.org/10.1016/j.jtbi.2009.04.007>,
            <https://doi.org/10.1093/icb/38.6.965>,
            <https://doi.org/10.1111/j.1525-142X.2012.00552.x>,
            <https://doi.org/10.1146/annurev.ecolsys.39.110707.173521>,
            <https://doi.org/10.1371/journal.pbio.1001402>,
            <https://doi.org/10.5962/bhl.title.46385> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Circular-Ring Activator-Inhibitor Mode m=5 Selection (k_m = m / R_ring), Lovén's Law (II, IV, I, III, V) Ocular/Ambulacral Ordering, Duboc Nodal Left-Right Rudiment Multiplicity, Ocular Plate Rule Biserial Plate Addition (Pass 3) & Continuous Nodal/BMP2-4 Hill Dose-Response (Pass 3)" ;
        pk:leanDeclaration "MathOfBiology.Loop_075.hydrocoel_turing_growth_score" ;
        pk:leanTheorem "MathOfBiology.Loop_075.hydrocoel_ring_pentaradial_mode5_selection" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/meinhardt-echinoderm-pentaradial-symmetry-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Lovén's Law (1874) & Morris (2012) Hydrocoel Crescent Initiation Ordering (II, IV, I, III, V)" ;
        dct:description "Explains how progressive anterior-to-posterior activation along the closing bilateral hydrocoel crescent generates Lovén's invariant asymmetric biserial peristomial plate law across Echinoidea | Variables: r in {1..5}: developmental initiation rank during crescent-to-ring closure; I..V: Lovén ambulacral ray indices; (a, b): counter-clockwise half-ambulacral plate columns" ;
        dct:source "Lovén (1874) K. Sven. Vetensk.-Akad. Handl. 11(7):1-91; Mooi & David (1998) Am. Zool. 38:965-974; Morris (2012) Evol. Dev. 14:313-326" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a69596cc/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L424-L465>,
            <https://github.com/fractastical/morpholib/blob/a69596cc/morphoeval/lean/loops/Loop_075_echinoderm_pentaradial_symmetry.lean#L91-L157> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def loven_initiation_rank_to_ray : Nat → Nat
  | 1 => 2 | 2 => 4 | 3 => 1 | 4 => 3 | 5 => 5 | _ => 0
theorem loven_law_crescent_ordering_and_asymmetric_biserial_rule :
    loven_initiation_rank_to_ray 1 = 2 ∧
    loven_initiation_rank_to_ray 5 = 5 ∧
    (loven_b_column_enlarged 1 + loven_b_column_enlarged 2 +
     loven_b_column_enlarged 3 + loven_b_column_enlarged 4 +
     loven_b_column_enlarged 5) = 2 := by decide
"""^^pk:lean4 ;
        skos:notation "Initiation rank r in {1..5} -> Ray (II, IV, I, III, V) = (C, A, D, B, E);   Peristomial biserial dominance: (Ib, IIb, IIIa, IVa, Va) = (ba, ba, ab, ab, ab)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0070-2153(07)81001-5>,
            <https://doi.org/10.1016/j.devcel.2005.05.008>,
            <https://doi.org/10.1016/j.jtbi.2009.04.007>,
            <https://doi.org/10.1093/icb/38.6.965>,
            <https://doi.org/10.1111/j.1525-142X.2012.00552.x>,
            <https://doi.org/10.1146/annurev.ecolsys.39.110707.173521>,
            <https://doi.org/10.1371/journal.pbio.1001402>,
            <https://doi.org/10.5962/bhl.title.46385> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Circular-Ring Activator-Inhibitor Mode m=5 Selection (k_m = m / R_ring), Lovén's Law (II, IV, I, III, V) Ocular/Ambulacral Ordering, Duboc Nodal Left-Right Rudiment Multiplicity, Ocular Plate Rule Biserial Plate Addition (Pass 3) & Continuous Nodal/BMP2-4 Hill Dose-Response (Pass 3)" ;
        pk:leanDeclaration "MathOfBiology.Loop_075.loven_initiation_rank_to_ray" ;
        pk:leanTheorem "MathOfBiology.Loop_075.loven_law_crescent_ordering_and_asymmetric_biserial_rule" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/meinhardt-echinoderm-pentaradial-symmetry-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Duboc et al. (2005) Right-Sided Nodal Signaling & Bilateral Twin-Rudiment Multiplicity Law" ;
        dct:description "Links bilateral pluteus left-right axis specification (right-sided Nodal/BMP2-4 cascade) to asymmetric restriction of pentaradial adult rudiment formation to the left hydrocoel | Variables: nodal_left, nodal_right in {0, 1}: left/right ectodermal Nodal signaling activity; N_rings: number of functional hydrocoel rings; N_podia: total primary podia lobes" ;
        dct:source "Duboc et al. (2005) Dev. Cell 9(1):147-158" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a69596cc/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L468-L512>,
            <https://github.com/fractastical/morpholib/blob/a69596cc/morphoeval/lean/loops/Loop_075_echinoderm_pentaradial_symmetry.lean#L160-L193> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def active_hydrocoel_rings (nodal_left nodal_right : Nat) : Nat :=
  (if nodal_left == 0 then 1 else 0) + (if nodal_right == 0 then 1 else 0)
def total_primary_podia (m_ring nodal_left nodal_right : Nat) : Nat :=
  m_ring * active_hydrocoel_rings nodal_left nodal_right
theorem duboc_nodal_left_right_rudiment_multiplicity :
    total_primary_podia 5 0 1 = 5 ∧
    total_primary_podia 5 0 0 = 10 ∧
    total_primary_podia 5 1 1 = 0 := by decide
"""^^pk:lean4 ;
        skos:notation "N_rings = I(Nodal_L = 0) + I(Nodal_R = 0),   N_podia = 5 * N_rings in {5 (WT: Nodal_R = 1), 10 (Nodal LOF: Nodal_L = Nodal_R = 0, twin 2x5 rudiments), 0 (Nodal GOF: Nodal_L = Nodal_R = 1)}" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0070-2153(07)81001-5>,
            <https://doi.org/10.1016/j.devcel.2005.05.008>,
            <https://doi.org/10.1016/j.jtbi.2009.04.007>,
            <https://doi.org/10.1093/icb/38.6.965>,
            <https://doi.org/10.1111/j.1525-142X.2012.00552.x>,
            <https://doi.org/10.1146/annurev.ecolsys.39.110707.173521>,
            <https://doi.org/10.1371/journal.pbio.1001402>,
            <https://doi.org/10.5962/bhl.title.46385> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Circular-Ring Activator-Inhibitor Mode m=5 Selection (k_m = m / R_ring), Lovén's Law (II, IV, I, III, V) Ocular/Ambulacral Ordering, Duboc Nodal Left-Right Rudiment Multiplicity, Ocular Plate Rule Biserial Plate Addition (Pass 3) & Continuous Nodal/BMP2-4 Hill Dose-Response (Pass 3)" ;
        pk:leanDeclaration "MathOfBiology.Loop_075.total_primary_podia" ;
        pk:leanTheorem "MathOfBiology.Loop_075.duboc_nodal_left_right_rudiment_multiplicity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/meinhardt-echinoderm-pentaradial-symmetry-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Ocular Plate Rule (Mooi & David 1998/2008) Biserial Plate Addition on the Domed Test (Pass 3)" ;
        dct:description "Couples the m=5 hydrocoel-ring PDE (ambulacral azimuths) to 3D adult test construction: 20 biserial columns, continuous plate addition at the ocular throughout growth (newest plate always apical), zone-dependent ambulacral vs interambulacral plate counts, and the Lovén-seeded alternating a/b suture, measured against the specimen with the same aboral polar C_5/C_10 pipeline | Variables: R_meta: test radius at metamorphosis (length unit); G(t): saturating growth factor to 40; phi_oc, phi_per: ocular and peristome colatitudes (22, 150 deg); h_i: meridional plate height; h_nuc, h_max: zone-specific nucleation / terminal plate heights (ambulacral 1.0 / 2.0, interambulacral 1.6 / 6.0 R_meta); b: plate birth index; n: plates per column; k: plates added to a biserial pair" ;
        dct:source "Mooi & David (1998) Am. Zool. 38:965-974; Mooi & David (2008) Annu. Rev. Ecol. Evol. Syst. 39:43-62; Raup (1968) J. Paleontol. 42:50-63; Zachos (2009) J. Theor. Biol. 259:646-657; Lovén (1874)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a69596cc/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L542-L694>,
            <https://github.com/fractastical/morpholib/blob/a69596cc/morphoeval/lean/loops/Loop_075_echinoderm_pentaradial_symmetry.lean#L195-L255> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def opr_meridional_columns (m_rays : Nat) : Nat := 2 * m_rays + 2 * m_rays
def opr_position_from_ocular (n b : Nat) : Nat := n - 1 - b
def opr_alternating_count_a (k : Nat) : Nat := (k + 1) / 2
def opr_alternating_count_b (k : Nat) : Nat := k / 2
theorem opr_biserial_plate_addition_law :
    opr_meridional_columns 5 = 20 ∧ 2 * 5 = 10 ∧
    (∀ n : Nat, 1 ≤ n → opr_position_from_ocular n (n - 1) = 0) ∧
    (∀ n b₁ b₂ : Nat, b₁ < b₂ → b₂ < n → opr_position_from_ocular n b₂ < opr_position_from_ocular n b₁) ∧
    (∀ k : Nat, opr_alternating_count_a k + opr_alternating_count_b k = k) ∧
    (∀ k : Nat, opr_alternating_count_a k = opr_alternating_count_b k ∨
                opr_alternating_count_a k = opr_alternating_count_b k + 1) := by
  refine ⟨rfl, rfl, ?_, ?_, ?_, ?_⟩
  · intro n hn; unfold opr_position_from_ocular; omega
  · intro n b₁ b₂ h₁ h₂; unfold opr_position_from_ocular; omega
  · intro k; unfold opr_alternating_count_a opr_alternating_count_b; omega
  · intro k; unfold opr_alternating_count_a opr_alternating_count_b; omega
"""^^pk:lean4 ;
        skos:notation "R(t) = R_meta G(t);  L(t) = R(t) (phi_per - phi_oc);  dh_i = gamma h_i (dR/R) (1 - h_i / h_max,zone);  nucleate h_nuc,zone at the ocular end when L - sum_i h_i >= h_nuc,zone;  N_columns = 2 m + 2 m = 20 for m = 5;  position_from_ocular(b) = n - 1 - b;  alternating split (k+1)/2 + k/2 = k" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0070-2153(07)81001-5>,
            <https://doi.org/10.1016/j.devcel.2005.05.008>,
            <https://doi.org/10.1016/j.jtbi.2009.04.007>,
            <https://doi.org/10.1093/icb/38.6.965>,
            <https://doi.org/10.1111/j.1525-142X.2012.00552.x>,
            <https://doi.org/10.1146/annurev.ecolsys.39.110707.173521>,
            <https://doi.org/10.1371/journal.pbio.1001402>,
            <https://doi.org/10.5962/bhl.title.46385> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Circular-Ring Activator-Inhibitor Mode m=5 Selection (k_m = m / R_ring), Lovén's Law (II, IV, I, III, V) Ocular/Ambulacral Ordering, Duboc Nodal Left-Right Rudiment Multiplicity, Ocular Plate Rule Biserial Plate Addition (Pass 3) & Continuous Nodal/BMP2-4 Hill Dose-Response (Pass 3)" ;
        pk:leanDeclaration "MathOfBiology.Loop_075.opr_position_from_ocular" ;
        pk:leanTheorem "MathOfBiology.Loop_075.opr_biserial_plate_addition_law" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/meinhardt-echinoderm-pentaradial-symmetry-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Continuous Nodal/BMP2-4 Hill Dose-Response across Stomodeum and Right Somatocoel reducing to the Discrete Duboc Law (Pass 3)" ;
        dct:description "Replaces the binary Nodal switch of Law 3 by continuous morphogen gradients and a sigmoidal dose-response (EC50 = 0.175 x WT dose for right-pouch derepression), reproducing the WT 1x5, Nodal-morpholino 2x5 and bilateral-GOF 0 phenotypes as the dose extremes | Variables: x in [-1, 1]: normalised larval left-right axis (0 = stomodeum, +0.55 = right somatocoel, -0.55 = left hydrocoel pouch); N, B: Nodal and BMP2/4 steady-state concentrations; lambda_N = 0.22, lambda_B = 0.45: decay lengths; K_N = 0.05, K_B = 0.015, n = 4: Hill constants; dose_L, dose_R: left / right Nodal source strengths (1 = WT right); P_L, P_R: pouch hydrocoel competences" ;
        dct:source "Duboc et al. (2005) Dev. Cell 9(1):147-158; Luo & Su (2012) PLoS Biol. 10(10):e1001402" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a69596cc/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L806-L911>,
            <https://github.com/fractastical/morpholib/blob/a69596cc/morphoeval/lean/loops/Loop_075_echinoderm_pentaradial_symmetry.lean#L257-L296> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def nodal_hill_competence_permille (d K : Nat) : Nat := 1000 * (K * K) / (K * K + d * d)
def nodal_expected_rings_permille (dL dR K : Nat) : Nat :=
  nodal_hill_competence_permille dL K + nodal_hill_competence_permille dR K
def nodal_rings_rounded (dL dR K : Nat) : Nat := (nodal_expected_rings_permille dL dR K + 500) / 1000
theorem nodal_dose_response_hill_reduces_to_discrete_law :
    nodal_hill_competence_permille 0 10 = 1000 ∧
    nodal_hill_competence_permille 10 10 = 500 ∧
    nodal_hill_competence_permille 50 10 > nodal_hill_competence_permille 100 10 ∧
    nodal_rings_rounded 0 100 10 = active_hydrocoel_rings 0 1 ∧
    nodal_rings_rounded 0 0 10 = active_hydrocoel_rings 0 0 ∧
    nodal_rings_rounded 100 100 10 = active_hydrocoel_rings 1 1 := by decide
"""^^pk:lean4 ;
        skos:notation "-lambda_N^2 N'' + N = dose_R S(x - x_src) + dose_L S(x + x_src);  -lambda_B^2 B'' + B = b_stom S_stom(x) + beta_ind N^n/(K_ind^n + N^n);  P_pouch = B^n/(K_B^n + B^n) * (1 - N^n/(K_N^n + N^n));  E[podia] = 5 (P_L + P_R);  round(P_L) + round(P_R) = N_rings(Law 3) at (0,1), (0,0), (1,1)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0070-2153(07)81001-5>,
            <https://doi.org/10.1016/j.devcel.2005.05.008>,
            <https://doi.org/10.1016/j.jtbi.2009.04.007>,
            <https://doi.org/10.1093/icb/38.6.965>,
            <https://doi.org/10.1111/j.1525-142X.2012.00552.x>,
            <https://doi.org/10.1146/annurev.ecolsys.39.110707.173521>,
            <https://doi.org/10.1371/journal.pbio.1001402>,
            <https://doi.org/10.5962/bhl.title.46385> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Circular-Ring Activator-Inhibitor Mode m=5 Selection (k_m = m / R_ring), Lovén's Law (II, IV, I, III, V) Ocular/Ambulacral Ordering, Duboc Nodal Left-Right Rudiment Multiplicity, Ocular Plate Rule Biserial Plate Addition (Pass 3) & Continuous Nodal/BMP2-4 Hill Dose-Response (Pass 3)" ;
        pk:leanDeclaration "MathOfBiology.Loop_075.nodal_hill_competence_permille" ;
        pk:leanTheorem "MathOfBiology.Loop_075.nodal_dose_response_hill_reduces_to_discrete_law" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/menshykau-fgf10-shh-lung-turing-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Menshykau & Iber (2013) GDNF-RET Receptor-Ligand Flux Cancellation & Homogeneous Steady-State Law" ;
        dct:description "Establishes exact cancellation of the cubic cooperative R^2 G signaling term in total receptor-ligand mass balance and pins the unique homogeneous steady state (R*, G*) = (a + b, b/(a+b)^2) | Variables: R(x,t): epithelial RET receptor concentration on the ureteric bud; G(x,t): mesenchymal GDNF ligand concentration; a: basal RET expression rate; b: mesenchymal GDNF production rate; R^2 G: cooperative receptor-ligand signaling & endocytosis complex" ;
        dct:source "Menshykau & Iber (2013) Phys. Biol. 10(4):046003 Eqs. (1)-(4)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L105-L210>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_054_kidney_ureteric_bud_gdnf_ret.lean#L36-L59> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def ret_reaction (a R r2G : Int) : Int := a - R + r2G
def gdnf_reaction (b r2G : Int) : Int := b - r2G
theorem menshykau_gdnf_ret_flux_cancellation_and_steady_state (a b R r2G : Int) :
    ret_reaction a R r2G + gdnf_reaction b r2G = a + b - R ∧
    ret_reaction a (a + b) b = 0 ∧
    gdnf_reaction b b = 0 := by
  simp [ret_reaction, gdnf_reaction]; omega
"""^^pk:lean4 ;
        skos:notation "∂_t R = D_R ∇^2 R + γ(a - R + R^2 G),  ∂_t G = D_G ∇^2 G + γ(b - R^2 G);  f + g = a + b - R;  (R^*, G^*) = (a + b, b / (a + b)^2)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/s11538-015-0073-9>,
            <https://doi.org/10.1016/j.devcel.2004.12.004>,
            <https://doi.org/10.1016/j.devcel.2014.02.017>,
            <https://doi.org/10.1016/j.ydbio.2004.03.025>,
            <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1088/1478-3975/10/4/046003>,
            <https://doi.org/10.1172/JCI8256>,
            <https://doi.org/10.1242/dev.01251>,
            <https://doi.org/10.1242/dev.086207>,
            <https://doi.org/10.1242/dev.126.3.547> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Schnakenberg GDNF-RET-Wnt11 Receptor-Ligand Turing Instability & Self-Avoiding Ureteric Tree Branching" ;
        pk:leanDeclaration "MathOfBiology.Loop_054.ret_reaction" ;
        pk:leanTheorem "MathOfBiology.Loop_054.menshykau_gdnf_ret_flux_cancellation_and_steady_state" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/menshykau-fgf10-shh-lung-turing-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Menshykau & Iber (2013) Steady-State Reaction Jacobian Positivity & Turing Wavelength Law" ;
        dct:description "Proves stability of the homogeneous state to k = 0 perturbations (Tr(J_0) < 0, det(J_0) > 0) alongside positive receptor auto-activation (f_R > 0 for b > a) driving diffusion-driven instability when D_G >> D_R | Variables: f_R, f_G, g_R, g_G: partial derivatives of reaction terms at (R*, G*); D_R, D_G: receptor and ligand diffusion coefficients (D_G/D_R = 50); γ: domain/reaction scaling parameter; λ_c: intrinsic Turing wavelength" ;
        dct:source "Menshykau & Iber (2013) Phys. Biol. 10(4):046003 Eqs. (5)-(7); Menshykau et al. (2012) Development 139:4506-4514" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L215-L340>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_054_kidney_ureteric_bud_gdnf_ret.lean#L66-L100> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def jac_f_R_scaled (a b : Int) : Int := b - a
def jac_f_G_scaled (a b : Int) : Int := (a + b) * (a + b) * (a + b)
def jac_g_R_scaled (b : Int) : Int := -2 * b
def jac_g_G_scaled (a b : Int) : Int := -((a + b) * (a + b) * (a + b))
def jac_det_scaled (a b : Int) : Int :=
  jac_f_R_scaled a b * jac_g_G_scaled a b - jac_f_G_scaled a b * jac_g_R_scaled b
theorem menshykau_gdnf_ret_jacobian_stability_and_turing_prerequisite :
    jac_f_R_scaled 1 9 = 8 ∧
    jac_f_R_scaled 1 9 + jac_g_G_scaled 1 9 = -992 ∧
    jac_det_scaled 1 9 = 10000 := by
  decide
"""^^pk:lean4 ;
        skos:notation "f_R = (b - a)/(a + b) > 0,  g_G = -(a + b)^2 < 0,  det(J_0) = (a + b)^2 > 0,  k_c^2 = γ(a + b)/√(D_R D_G),  λ_c = 2π/k_c" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/s11538-015-0073-9>,
            <https://doi.org/10.1016/j.devcel.2004.12.004>,
            <https://doi.org/10.1016/j.devcel.2014.02.017>,
            <https://doi.org/10.1016/j.ydbio.2004.03.025>,
            <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1088/1478-3975/10/4/046003>,
            <https://doi.org/10.1172/JCI8256>,
            <https://doi.org/10.1242/dev.01251>,
            <https://doi.org/10.1242/dev.086207>,
            <https://doi.org/10.1242/dev.126.3.547> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Schnakenberg GDNF-RET-Wnt11 Receptor-Ligand Turing Instability & Self-Avoiding Ureteric Tree Branching" ;
        pk:leanDeclaration "MathOfBiology.Loop_054.jac_det_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_054.menshykau_gdnf_ret_jacobian_stability_and_turing_prerequisite" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/menshykau-fgf10-shh-lung-turing-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Zubkov et al. (2015) & Watanabe & Costantini (2004) Tip-Splitting Mode Selection & Ureteric Tree Generation Scaling Law" ;
        dct:description "Determines transitions between single-tip elongation, canonical dichotomous bifurcation (88% of WT events), and Spry1-/- trichotomous hyper-branching, as well as tip-count collapse under Gdnf+/- or PRR^(UB-/-) hypoplasia | Variables: ρ_tip = π R_tip / λ_c: dimensionless ureteric ampulla arc-to-wavelength ratio; g: branching generation; N_tips(g): distal ureteric bud tip count" ;
        dct:source "Zubkov et al. (2015) Bull. Math. Biol. 77:565-595; Watanabe & Costantini (2004) Dev. Biol. 271:98-106; Basson et al. (2005) Dev. Cell 8:229-239" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L345-L520>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_054_kidney_ureteric_bud_gdnf_ret.lean#L107-L148> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def tip_splitting_peaks (rho_10 : Nat) : Nat :=
  if rho_10 < 15 then 1 else if rho_10 < 25 then 2 else 3
def dichotomous_step (n : Nat) : Nat := 2 * n
def trichotomous_step (n : Nat) : Nat := 3 * n
def dichotomous_gen4 (n : Nat) : Nat :=
  dichotomous_step (dichotomous_step (dichotomous_step (dichotomous_step n)))
theorem ureteric_tip_splitting_modes_and_generation_scaling (n : Nat) :
    tip_splitting_peaks 12 = 1 ∧ tip_splitting_peaks 20 = 2 ∧ tip_splitting_peaks 30 = 3 ∧
    dichotomous_gen4 n = 16 * n ∧
    dichotomous_step (dichotomous_step 1) < dichotomous_gen4 1 ∧
    dichotomous_step (dichotomous_step (dichotomous_step (trichotomous_step 1))) = 24
"""^^pk:lean4 ;
        skos:notation "m(ρ_tip) = 1 (ρ_tip < 1.5), 2 (1.5 ≤ ρ_tip < 2.5, dichotomous), 3 (ρ_tip ≥ 2.5, trichotomous);  N_tips(g) = 2^g (WT dichotomous) vs N_hypo < N_WT < N_Spry1KO" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/s11538-015-0073-9>,
            <https://doi.org/10.1016/j.devcel.2004.12.004>,
            <https://doi.org/10.1016/j.devcel.2014.02.017>,
            <https://doi.org/10.1016/j.ydbio.2004.03.025>,
            <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1088/1478-3975/10/4/046003>,
            <https://doi.org/10.1172/JCI8256>,
            <https://doi.org/10.1242/dev.01251>,
            <https://doi.org/10.1242/dev.086207>,
            <https://doi.org/10.1242/dev.126.3.547> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Schnakenberg GDNF-RET-Wnt11 Receptor-Ligand Turing Instability & Self-Avoiding Ureteric Tree Branching" ;
        pk:leanDeclaration "MathOfBiology.Loop_054.tip_splitting_peaks" ;
        pk:leanTheorem "MathOfBiology.Loop_054.ureteric_tip_splitting_modes_and_generation_scaling" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/menshykau-fgf10-shh-lung-turing-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pass 3 — Stromal BMP4/7 - Gremlin1 - FGF7 Feedback Gain Monotonicity Law (Zubkov et al. 2015 spatially-averaged module; Michos et al. 2004; Qiao et al. 1999; Miyazaki et al. 2000)" ;
        dct:description "Couples the stromal mesenchymal feedback loops (Grem1-/- outgrowth failure, Fgf7-/- reduced growth, Bmp4+/- ectopic budding) to the GDNF-RET Turing mode selection via the ampulla radius; replaces the Pass 2 per-condition prescribed branching multiplicity | Variables: BMP: peristalk + baseline stromal BMP4/BMP7; GREM1: cap-mesenchyme Gremlin1 (BMP antagonist); FGF7: cortical stromal FGF7; k_B, k_G, k_F7: model-scale constants (3.0, 4.0, 0.8); γ_eff: effective RET/ERK signalling gain entering R_tip ~ S_eff^0.5 and rho_tip" ;
        dct:source "Zubkov et al. (2015) Bull. Math. Biol. 77:565-595; Michos et al. (2004) Development 131:3401-3410; Qiao et al. (1999) Development 126:547-554; Miyazaki et al. (2000) J. Clin. Invest. 105:863-873" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L649-L943>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_054_kidney_ureteric_bud_gdnf_ret.lean#L159-L194> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def stromal_gain_num (F G : Nat) : Nat := (1 + F) * (1 + G)
def stromal_gain_den (B G : Nat) : Nat := (1 + G) + B
theorem stromal_bmp_gremlin_fgf7_gain_monotonicity (B G F : Nat) :
    stromal_gain_den B G ≤ stromal_gain_den (B + 1) G ∧
    stromal_gain_num F G ≤ stromal_gain_num (F + 1) G ∧
    stromal_gain_num 0 0 < stromal_gain_den (B + 1) 0 ∧
    stromal_gain_num 0 0 = stromal_gain_den 0 0
"""^^pk:lean4 ;
        skos:notation "γ_eff = γ (1 + k_F7 FGF7) / (1 + k_B BMP / (1 + k_G GREM1));  integer-scaled: num = (1 + F)(1 + G), den = (1 + G) + B;  ∂gain/∂BMP ≤ 0, ∂gain/∂FGF7 ≥ 0, gain(G=0, B>0, F=0) < 1, gain(0,0,0) = 1" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/s11538-015-0073-9>,
            <https://doi.org/10.1016/j.devcel.2004.12.004>,
            <https://doi.org/10.1016/j.devcel.2014.02.017>,
            <https://doi.org/10.1016/j.ydbio.2004.03.025>,
            <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1088/1478-3975/10/4/046003>,
            <https://doi.org/10.1172/JCI8256>,
            <https://doi.org/10.1242/dev.01251>,
            <https://doi.org/10.1242/dev.086207>,
            <https://doi.org/10.1242/dev.126.3.547> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Schnakenberg GDNF-RET-Wnt11 Receptor-Ligand Turing Instability & Self-Avoiding Ureteric Tree Branching" ;
        pk:leanDeclaration "MathOfBiology.Loop_054.stromal_gain_num" ;
        pk:leanTheorem "MathOfBiology.Loop_054.stromal_bmp_gremlin_fgf7_gain_monotonicity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/menshykau-fgf10-shh-lung-turing-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pass 3 — Orthogonal Dihedral Rotation Cascade Law (reduced 3D anisotropic-dome mode selection; Menshykau et al. 2012; Metzger et al. 2008)" ;
        dct:description "Closest honest reduction of the Pass 2 '3D phase-field / ALE dihedral rotation' item: the linear selection of the short cross-section axis in the dichotomous band plus an explicit daughter-orientation assumption yields the ~90° orthogonal rotation of successive bifurcation planes (ablation with orthogonal daughters yields 0°) | Variables: θ_g: splitting-axis angle (deg mod 180) of generation g in the transverse plane; L_long = π R_tip √e, L_short = π R_tip / √e: principal arcs of the anisotropic dome (e = 1.30); σ(k): Menshykau & Iber (2013) Eq. 5 linear growth rate" ;
        dct:source "Menshykau et al. (2012) Development 139:4506-4514; Metzger et al. (2008) Nature 453:745-750; Short et al. (2014) Dev. Cell 29:188-202" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L491-L647>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_054_kidney_ureteric_bud_gdnf_ret.lean#L196-L234> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def daughter_axis_short_wins (θ : Nat) : Nat := (θ + 90) % 180
def dihedral_deg (α β : Nat) : Nat :=
  min ((α + 180 - β % 180) % 180) ((β + 180 - α % 180) % 180)
theorem orthogonal_dihedral_rotation_cascade (θ : Nat) (h : θ < 180) :
    dihedral_deg θ (daughter_axis_short_wins θ) = 90 ∧
    daughter_axis_short_wins (daughter_axis_short_wins θ) = θ ∧
    dihedral_deg θ θ = 0
"""^^pk:lean4 ;
        skos:notation "two-lobe mode along axis of arc L: k = 2π/L;  rho_flip = k_c/k_fastest ≈ 0.938;  for rho_tip > rho_flip, σ(2π/L_short) > σ(2π/L_long) (short axis splits);  daughter long axis ∥ parent axis ⇒ θ_{g+1} = (θ_g + 90) mod 180, dihedral = 90°, period 2" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/s11538-015-0073-9>,
            <https://doi.org/10.1016/j.devcel.2004.12.004>,
            <https://doi.org/10.1016/j.devcel.2014.02.017>,
            <https://doi.org/10.1016/j.ydbio.2004.03.025>,
            <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1088/1478-3975/10/4/046003>,
            <https://doi.org/10.1172/JCI8256>,
            <https://doi.org/10.1242/dev.01251>,
            <https://doi.org/10.1242/dev.086207>,
            <https://doi.org/10.1242/dev.126.3.547> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Schnakenberg GDNF-RET-Wnt11 Receptor-Ligand Turing Instability & Self-Avoiding Ureteric Tree Branching" ;
        pk:leanDeclaration "MathOfBiology.Loop_054.daughter_axis_short_wins" ;
        pk:leanTheorem "MathOfBiology.Loop_054.orthogonal_dihedral_rotation_cascade" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/menshykau-gdnf-ret-ureteric-kidney-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Menshykau & Iber (2013) Schnakenberg-Type GDNF-RET Cooperative Binding Turing Instability Law" ;
        dct:description "Establishes that cooperative binding of fast-diffusing GDNF to slow-diffusing RET dimers (L + 2R -> R^2L) generates self-organizing R^2G signaling caps at ureteric bud tips | Variables: R: epithelial RET receptor density; G: mesenchymal GDNF ligand concentration; d = D_G/D_R: ligand-to-receptor diffusion ratio; f_R, g_L: Jacobian self-activation and ligand-depletion derivatives" ;
        dct:source "Menshykau & Iber (2013) Phys. Biol. 10(4):046003 Eqs. (1)-(5) & Table 1" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L133-L210>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_055_gdnf_ret_ureteric_kidney.lean#L27-L36> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def gdnf_ret_turing_driver (d f_R g_L : Int) : Int :=
  d * f_R + g_L
theorem menshykau_gdnf_ret_turing_instability (d g_abs : Nat) :
    gdnf_ret_turing_driver 50 8 (-10) = 390 ∧
    gdnf_ret_turing_driver 1 8 (-10) = -2 ∧
    gdnf_ret_turing_driver (Int.ofNat (g_abs + d + 1)) 1 (-(Int.ofNat g_abs)) = Int.ofNat (d + 1)
"""^^pk:lean4 ;
        skos:notation "∂R/∂t = D_R ∇²R + γ(a - R + R²G),  ∂G/∂t = D_G ∇²G + γ(ρ_G - R²G);  d·f_R + g_L > 2√(d·det J) > 0 for d = D_G/D_R = 50 ≫ 1, m = 2 > 1" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2004.11.008>,
            <https://doi.org/10.1016/j.devcel.2004.12.004>,
            <https://doi.org/10.1016/j.devcel.2014.02.017>,
            <https://doi.org/10.1016/j.ydbio.2004.09.019>,
            <https://doi.org/10.1088/1478-3975/10/4/046003>,
            <https://doi.org/10.1172/JCI8256> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Schnakenberg-Type GDNF-RET Cooperative Ligand-Receptor Turing Reaction-Diffusion & Horton-Strahler Ureteric Tree Branching" ;
        pk:leanDeclaration "MathOfBiology.Loop_055.gdnf_ret_turing_driver" ;
        pk:leanTheorem "MathOfBiology.Loop_055.menshykau_gdnf_ret_turing_instability" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/menshykau-gdnf-ret-ureteric-kidney-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Menshykau & Iber (2013) & Short et al. (2014) Ureteric Ampulla Dichotomous vs Trichotomous Mode Selection Law" ;
        dct:description "Predicts the transition from canonical dichotomous bifurcation (88% of wild-type E11.5-E15.5 events) to trichotomous ampulla splitting when tip swelling exceeds the m=3 harmonic threshold | Variables: R_tip: ureteric ampulla tip radius; ℓ_c = λ_c / (2π): critical Turing length scale; m*: dominant circumferential splitting harmonic (m=2 bifurcation vs m=3 trifurcation)" ;
        dct:source "Menshykau & Iber (2013) Phys. Biol. 10:046003 Figs. 3-5; Short et al. (2014) Dev. Cell 29:188-202 Figs. 2-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L212-L361>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_055_gdnf_ret_ureteric_kidney.lean#L49-L65> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def ureteric_tip_harmonic_mode (k2_R_tip ell_c : Nat) : Nat :=
  if ell_c == 0 then 0
  else if k2_R_tip < 2 * ell_c then 1
  else if k2_R_tip < 3 * ell_c then 2
  else 3
theorem menshykau_ureteric_tip_mode_selection (ell_c excess : Nat) :
    ureteric_tip_harmonic_mode 20 10 = 2 ∧
    ureteric_tip_harmonic_mode 32 10 = 3 ∧
    ureteric_tip_harmonic_mode (3 * (ell_c + 1) + excess) (ell_c + 1) = 3
"""^^pk:lean4 ;
        skos:notation "m* = argmax_m Re(λ(k_m)),  k_m = m / R_tip:  2 ℓ_c ≤ k_2 R_tip < 3 ℓ_c ⇒ m* = 2 (lateral bifurcation);  k_2 R_tip ≥ 3 ℓ_c ⇒ m* = 3 (planar/tetrahedral trifurcation)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2004.11.008>,
            <https://doi.org/10.1016/j.devcel.2004.12.004>,
            <https://doi.org/10.1016/j.devcel.2014.02.017>,
            <https://doi.org/10.1016/j.ydbio.2004.09.019>,
            <https://doi.org/10.1088/1478-3975/10/4/046003>,
            <https://doi.org/10.1172/JCI8256> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Schnakenberg-Type GDNF-RET Cooperative Ligand-Receptor Turing Reaction-Diffusion & Horton-Strahler Ureteric Tree Branching" ;
        pk:leanDeclaration "MathOfBiology.Loop_055.ureteric_tip_harmonic_mode" ;
        pk:leanTheorem "MathOfBiology.Loop_055.menshykau_ureteric_tip_mode_selection" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/menshykau-gdnf-ret-ureteric-kidney-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Watanabe & Costantini (2004) & Basson et al. (2005) Gdnf-/-/Ret-/- Renal Agenesis & Spry1-/- Ectopic Budding Law" ;
        dct:description "Accounts for complete renal agenesis in Gdnf-/- or Ret-/- null kidneys and supernumerary ectopic budding upon Sprouty1 deletion | Variables: ρ_G: mesenchymal GDNF synthesis rate; γ_R: effective RET receptor gain modulated by Sprouty1 antagonism; v_tip: normal tip outgrowth velocity; N_tips: terminal ureteric bud tip count" ;
        dct:source "Watanabe & Costantini (2004) Dev. Biol. 271:98-106; Basson et al. (2005) Dev. Cell 8:229-239" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L655-L1101>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_055_gdnf_ret_ureteric_kidney.lean#L78-L90> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def ureteric_tip_growth_flux (rho_G gamma_R : Nat) : Nat :=
  if rho_G == 0 then 0 else rho_G + gamma_R
theorem menshykau_gdnf_ret_agenesis_and_spry1_budding (rho_G gamma_wt d_gamma : Nat) :
    ureteric_tip_growth_flux 0 gamma_wt = 0 ∧
    ureteric_tip_growth_flux (rho_G + 1) (gamma_wt + d_gamma + 1) >
      ureteric_tip_growth_flux (rho_G + 1) gamma_wt
"""^^pk:lean4 ;
        skos:notation "v_tip ∝ ρ_G γ_R max(0, R²G - C_th):  ρ_G = 0 ⇒ v_tip = 0 (renal agenesis);  γ_R(Spry1-/-) = γ_wt + Δγ > γ_wt ⇒ N_tips(Spry1-/-) > N_tips(WT)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2004.11.008>,
            <https://doi.org/10.1016/j.devcel.2004.12.004>,
            <https://doi.org/10.1016/j.devcel.2014.02.017>,
            <https://doi.org/10.1016/j.ydbio.2004.09.019>,
            <https://doi.org/10.1088/1478-3975/10/4/046003>,
            <https://doi.org/10.1172/JCI8256> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Schnakenberg-Type GDNF-RET Cooperative Ligand-Receptor Turing Reaction-Diffusion & Horton-Strahler Ureteric Tree Branching" ;
        pk:leanDeclaration "MathOfBiology.Loop_055.ureteric_tip_growth_flux" ;
        pk:leanTheorem "MathOfBiology.Loop_055.menshykau_gdnf_ret_agenesis_and_spry1_budding" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/menshykau-gdnf-ret-ureteric-kidney-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pass 3 Reduced Phase-Field Renal Capsule Moving-Boundary Tip Confinement Law" ;
        dct:description "Moving-boundary coupling of the 3D ureteric tree to the expanding phase-field capsule: tips are advected with the interstitial dilation of the mesenchyme and can never leave the capsule, so terminal tips accumulate in the peripheral nephrogenic zone (coupled 0.67 vs decoupled v2 tree 0.11 in zone / 80% outside the capsule) | Variables: R_cap(g): expanding renal capsule radius (surface area linear in Short et al. 2014 observed tip number); c(g): capsule centre distal to the ureteric stalk tip; ε: phase-field interface width; margin: minimal tip-to-capsule distance; r: tip radial coordinate" ;
        dct:source "Short et al. (2014) Dev. Cell 29:188-202 Figs. 1 & 4 (tips confined to the nephrogenic zone); Menshykau & Iber (2013) Phys. Biol. 10:046003 (mesenchymal GDNF domain); diffuse-domain phase-field reduction of the Pass 2 FEM remediation item" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L459-L652>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_055_gdnf_ret_ureteric_kidney.lean#L107-L118> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def capsule_confine (r R_cap margin : Nat) : Nat :=
  if r + margin ≤ R_cap then r else R_cap - margin
theorem menshykau_capsule_confinement_bound (r R_cap margin : Nat) (h : margin ≤ R_cap) :
    capsule_confine r R_cap margin + margin ≤ R_cap ∧
    (r + margin ≤ R_cap → capsule_confine r R_cap margin = r)
"""^^pk:lean4 ;
        skos:notation "phi_cap(x,g) = ½(1 + tanh((R_cap(g) − |x − c(g)|)/ε));  4π R_cap(g)² = A_0 + s·(N_obs(g) − 2);  tip radial position r ↦ r if r + margin ≤ R_cap else R_cap − margin  ⇒  r_tip + margin ≤ R_cap for all tips" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2004.11.008>,
            <https://doi.org/10.1016/j.devcel.2004.12.004>,
            <https://doi.org/10.1016/j.devcel.2014.02.017>,
            <https://doi.org/10.1016/j.ydbio.2004.09.019>,
            <https://doi.org/10.1088/1478-3975/10/4/046003>,
            <https://doi.org/10.1172/JCI8256> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Schnakenberg-Type GDNF-RET Cooperative Ligand-Receptor Turing Reaction-Diffusion & Horton-Strahler Ureteric Tree Branching" ;
        pk:leanDeclaration "MathOfBiology.Loop_055.capsule_confine" ;
        pk:leanTheorem "MathOfBiology.Loop_055.menshykau_capsule_confinement_bound" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/menshykau-gdnf-ret-ureteric-kidney-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pass 3 Nephrogenic-Zone GDNF-Gated Branching Crowding-Arrest Law" ;
        dct:description "Couples tip number to capsule expansion: a slowly expanding capsule crowds the nephrogenic zone, depletes GDNF at the tips and arrests branching (E15.5 tips 198 at ×0.5 capsule vs 293 at WT capsule), while un-gated tips reproduce the Pass 2 geometric tree | Variables: G: diffuse-domain mesenchymal GDNF; φ_nz: nephrogenic-zone (cap mesenchyme) production shell; T(x): smoothed indicator of RET-expressing tips; κ_tip: ligand uptake per tip; n: local crowding number; G_th: branching gate (fraction of tip-free NZ level)" ;
        dct:source "Menshykau & Iber (2013) Phys. Biol. 10:046003 (ligand depletion by receptor binding); Short et al. (2014) Dev. Cell 29:188-202 (nephrogenic-zone tip packing); Pass 3 diffuse-domain reduction" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L526-L604>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_055_gdnf_ret_ureteric_kidney.lean#L130-L151> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def nz_tip_branches (rho kappa n G_th : Nat) : Bool :=
  decide (G_th * (1 + kappa * n) ≤ rho)
theorem menshykau_capsule_crowding_arrest_monotone (rho kappa n G_th : Nat) :
    (nz_tip_branches rho kappa (n + 1) G_th = true → nz_tip_branches rho kappa n G_th = true) ∧
    nz_tip_branches rho kappa n 0 = true ∧
    (rho < G_th * (1 + kappa * n) → nz_tip_branches rho kappa n G_th = false)
"""^^pk:lean4 ;
        skos:notation "0 = D ∇·(φ_cap ∇G) + ρ_G φ_nz − δ φ_cap G − κ_tip T(x) G;  G_tip ≈ ρ/(1 + κ n);  tip branches iff G_th (1 + κ n) ≤ ρ  (monotone: branching with n+1 neighbours ⇒ branching with n)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2004.11.008>,
            <https://doi.org/10.1016/j.devcel.2004.12.004>,
            <https://doi.org/10.1016/j.devcel.2014.02.017>,
            <https://doi.org/10.1016/j.ydbio.2004.09.019>,
            <https://doi.org/10.1088/1478-3975/10/4/046003>,
            <https://doi.org/10.1172/JCI8256> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Schnakenberg-Type GDNF-RET Cooperative Ligand-Receptor Turing Reaction-Diffusion & Horton-Strahler Ureteric Tree Branching" ;
        pk:leanDeclaration "MathOfBiology.Loop_055.nz_tip_branches" ;
        pk:leanTheorem "MathOfBiology.Loop_055.menshykau_capsule_crowding_arrest_monotone" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/metzger-lung-stereotyped-branching-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Metzger (2008) Domain & Bifurcation Tip-Multiplicity Composition Law" ;
        dct:description "Determines exact distal bronchial tip counts across compound Domain (D) -> Planar (P) / Orthogonal (O) lineage trees in E11-E15 mouse lung lobes | Variables: m: number of lateral domain buds along a parent airway trunk; n: number of active distal airway tips entering a planar or orthogonal bifurcation subroutine" ;
        dct:source "Metzger, Klein, Martin & Krasnow (2008) Nature 453(7196):745-750 Figs. 2-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L174-L383>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_053_lung_stereotyped_branching_modes.lean#L47-L69> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def bifurcate_tips (n : Nat) : Nat := 2 * n
def domain_composite_tips (m : Nat) : Nat := bifurcate_tips (bifurcate_tips m) + 1
theorem metzger_subroutine_tip_multiplicity (n m : Nat) :
    bifurcate_tips (bifurcate_tips n) = 4 * n ∧
    domain_composite_tips m = 4 * m + 1 := by
  simp [bifurcate_tips, domain_composite_tips]; omega
"""^^pk:lean4 ;
        skos:notation "T_D(m) = m + 1,   T_P(n) = T_O(n) = 2 n,   (T_{P/O} ∘ T_{P/O})(n) = 4 n,   T_{D_m → (P/O)^2} = 4 m + 1" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/ar.20747>,
            <https://doi.org/10.1002/dvdy.21633>,
            <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1242/dev.081679>,
            <https://doi.org/10.1371/journal.pcbi.1003421>,
            <https://doi.org/10.1371/journal.pone.0041643>,
            <https://doi.org/10.4310/CMS.2009.v7.n1.a4> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Stereotyped Branching Subroutine Grammar (D, P, O) & FGF10-SHH-Ptch1 Receptor-Ligand Turing Switch" ;
        pk:leanDeclaration "MathOfBiology.Loop_053.domain_composite_tips" ;
        pk:leanTheorem "MathOfBiology.Loop_053.metzger_subroutine_tip_multiplicity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/metzger-lung-stereotyped-branching-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Metzger (2008) Planar (Δφ = 0°) Invariance vs Orthogonal (Δφ = 90°) Dihedral Rotation Law" ;
        dct:description "Partitions flat lobar margin sheets (Planar P, Δφ = 0°, coplanar hull flatness → 0) from 3D space-filling lobar interiors (Orthogonal O, Δφ = 90°, isotropic 3D rosette) | Variables: φ_g: cleavage-plane dihedral azimuth at branching generation g; Δφ ∈ {0°, 90°}: dihedral rotation between parent and daughter bifurcation planes" ;
        dct:source "Metzger, Klein, Martin & Krasnow (2008) Nature 453(7196):745-750 Fig. 3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L385-L441>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_053_lung_stereotyped_branching_modes.lean#L72-L94> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def planar_step_deg (phi : Int) : Int := phi + 0
def orthogonal_step_deg (phi : Int) : Int := phi + 90
theorem metzger_planar_orthogonal_dihedral_periodicity (phi : Int) :
    planar_step_deg (planar_step_deg phi) = phi ∧
    orthogonal_step_deg (orthogonal_step_deg phi) - phi = 180 := by
  simp [planar_step_deg, orthogonal_step_deg]; omega
"""^^pk:lean4 ;
        skos:notation "φ_{g+1}^{(P)} = φ_g + 0°,   φ_{g+1}^{(O)} = φ_g + 90°  ⟹  φ_{g+2}^{(O)} - φ_g = 180° (mod 180° ≡ 0°)" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/ar.20747>,
            <https://doi.org/10.1002/dvdy.21633>,
            <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1242/dev.081679>,
            <https://doi.org/10.1371/journal.pcbi.1003421>,
            <https://doi.org/10.1371/journal.pone.0041643>,
            <https://doi.org/10.4310/CMS.2009.v7.n1.a4> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Stereotyped Branching Subroutine Grammar (D, P, O) & FGF10-SHH-Ptch1 Receptor-Ligand Turing Switch" ;
        pk:leanDeclaration "MathOfBiology.Loop_053.orthogonal_step_deg" ;
        pk:leanTheorem "MathOfBiology.Loop_053.metzger_planar_orthogonal_dihedral_periodicity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/metzger-lung-stereotyped-branching-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Menshykau et al. (2012, 2014) FGF10-SHH-Ptch1 Receptor-Ligand Turing Switch" ;
        dct:description "Biochemical Turing instability that selects between apical tip splitting (Planar/Orthogonal bifurcation at low elongation speed v_g < v_crit) and periodic lateral budding (Domain branching at high elongation speed v_g > v_crit) | Variables: R: epithelial Ptch1/SHH receptor complex concentration; F: mesenchymal FGF10 ligand concentration; D_R, D_F: diffusion coefficients (D_F/D_R = 50); a_R, a_F: basal production rates; μ_R: receptor removal rate" ;
        dct:source "Menshykau, Kraemer & Iber (2012) Development 139:4506-4514; Menshykau et al. (2014) PLoS Comput. Biol. 10(2):e1003421 Eqs. (1)-(5)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L448-L610>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_053_lung_stereotyped_branching_modes.lean#L97-L120> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def receptor_reaction (a_R mu_R_R r2_F : Int) : Int := a_R - mu_R_R + r2_F
def ligand_reaction (a_F r2_F : Int) : Int := a_F - r2_F
theorem menshykau_fgf10_shh_receptor_ligand_steady_state (a_R a_F mu_R_R r2_F : Int) :
    receptor_reaction a_R mu_R_R r2_F + ligand_reaction a_F r2_F = a_R + a_F - mu_R_R ∧
    receptor_reaction a_R (a_R + a_F) a_F = 0 ∧
    ligand_reaction a_F a_F = 0 := by
  simp [receptor_reaction, ligand_reaction]; omega
"""^^pk:lean4 ;
        skos:notation "∂_t R = D_R ∇^2 R + γ(a_R - μ_R R + R^2 F),   ∂_t F = D_F ∇^2 F + γ(a_F - R^2 F),   (R^*, F^*) = ((a_R+a_F)/μ_R, a_F/(R^*)^2)" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/ar.20747>,
            <https://doi.org/10.1002/dvdy.21633>,
            <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1242/dev.081679>,
            <https://doi.org/10.1371/journal.pcbi.1003421>,
            <https://doi.org/10.1371/journal.pone.0041643>,
            <https://doi.org/10.4310/CMS.2009.v7.n1.a4> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Stereotyped Branching Subroutine Grammar (D, P, O) & FGF10-SHH-Ptch1 Receptor-Ligand Turing Switch" ;
        pk:leanDeclaration "MathOfBiology.Loop_053.receptor_reaction" ;
        pk:leanTheorem "MathOfBiology.Loop_053.menshykau_fgf10_shh_receptor_ligand_steady_state" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/metzger-lung-stereotyped-branching-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pleura-Confined Diffuse-Domain FGF10 Supply Anisotropy Mode Selection (Pass 3)" ;
        dct:description "Couples the Menshykau FGF10 ligand equation to a pleura-bounded mesenchymal cavity so that the Metzger P/O choice is emergent: tips near the thin lobe margin see FGF10 depletion out of plane and flatten to Planar, interior tips remain Orthogonal (margin-interior transition x*/L_x = 0.54, critical half-thickness h* = 0.94 l0); reduced 2D cross-section model with a dilating cavity (no full 3D moving-boundary FEM); solver verified against the exact 1D slab profile with first-order convergence in ε | Variables: ψ: mesenchymal phase field (1 inside the pleura, 0 outside); F: FGF10 ligand; R(x): Ptch1 receptor density (background 1, Gaussian tip sink gain 2); L_x, h: lobe cross-section half-width / half-thickness; ε: interface width; F_P, F_O: mean ψF supply at the planar / orthogonal candidate daughter tips; A_c = 0.05: anisotropy threshold (orthogonal prior)" ;
        dct:source "Li, Lowengrub, Rätz & Voigt (2009) Commun. Math. Sci. 7(1):81-107 (diffuse-domain method); Menshykau et al. (2014) PLoS Comput. Biol. 10(2):e1003421 (geometry-signalling interplay); Metzger et al. (2008) Nature 453:745-750 Fig. 3 (planar margins vs orthogonal interiors)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L612-L963>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_053_lung_stereotyped_branching_modes.lean#L121-L155> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def pleura_mode_select (fP fO c : Int) : Int := if fP > fO + c then 0 else 90
theorem pleura_anisotropy_mode_selection (fP fO c : Int) :
    (pleura_mode_select fP fO c = 0 ∨ pleura_mode_select fP fO c = 90) ∧
    (0 ≤ c → pleura_mode_select fP fP c = 90) ∧
    (fP > c → pleura_mode_select fP 0 c = 0) := by
  refine ⟨?_, ?_, ?_⟩ <;> (unfold pleura_mode_select; first | (split <;> simp) | (intro _; split <;> first | rfl | omega))
"""^^pk:lean4 ;
        skos:notation "∂_t F = D_F ∇·(ψ ∇F) + ψ γ_m (a_F − R(x)^2 F) − (1 − ψ) F / τ,  τ = ε^2 / D_F,  ψ = ½(1 − tanh((ρ − 1)/ε)),  ρ^2 = (x/L_x)^2 + (y/h)^2;   A = (F_P − F_O)/(F_P + F_O);   Δφ = 0° if A > A_c else 90°" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/ar.20747>,
            <https://doi.org/10.1002/dvdy.21633>,
            <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1242/dev.081679>,
            <https://doi.org/10.1371/journal.pcbi.1003421>,
            <https://doi.org/10.1371/journal.pone.0041643>,
            <https://doi.org/10.4310/CMS.2009.v7.n1.a4> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Stereotyped Branching Subroutine Grammar (D, P, O) & FGF10-SHH-Ptch1 Receptor-Ligand Turing Switch" ;
        pk:leanDeclaration "MathOfBiology.Loop_053.pleura_mode_select" ;
        pk:leanTheorem "MathOfBiology.Loop_053.pleura_anisotropy_mode_selection" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/metzger-lung-stereotyped-branching-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Mean-Field Saccular-to-Alveolar Septation Closed Form & Stochastic Yule Septation (Pass 3)" ;
        dct:description "Extends the deterministic E11-E16.5 D/P/O grammar with stochastic postnatal secondary septation; the deterministic grammar alone freezes at 632 units (control), the Yule ensemble reaches 2.3e6 alveoli at P36 with per-unit CV ≈ 1 and whole-lung CV ≈ 0.03-0.04 | Variables: n_0 / N_units: terminal units at the end of branching (E16.5, grammar extrapolated: 632); μ: mean offspring per septation round (2); k: septation rounds (11.8 fitted); λ_b, λ_c: bulk (P4-P21) and continued (P14-P36) septation hazards (λ_b = 0.417/d fitted in closed form to the Knust 2009 adult count, λ_c = 0.12 λ_b); m: alveoli per terminal unit at P36" ;
        dct:source "Mund, Stampanoni & Schittny (2008) Dev. Dyn. 237(8):2108-2116 (bulk/continued alveolarisation phases); Knust, Ochs, Gundersen & Nyengaard (2009) Anat. Rec. 292(1):113-122 (adult mouse alveolar number); Yule (1925) Phil. Trans. R. Soc. B 213:21-87 (pure-birth process)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L1046-L1191>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_053_lung_stereotyped_branching_modes.lean#L158-L188> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def septation_mean (n0 mu : Nat) : Nat → Nat
  | 0 => n0
  | k + 1 => mu * septation_mean n0 mu k
theorem septation_mean_closed_form (n0 mu k m : Nat) :
    septation_mean n0 mu k = n0 * mu ^ k ∧
    septation_mean (domain_composite_tips m) 2 k = (4 * m + 1) * 2 ^ k := by
  have h : ∀ (a b j : Nat), septation_mean a b j = a * b ^ j := by
    intro a b j; induction j with
    | zero => simp [septation_mean]
    | succ j ih => simp [septation_mean, ih, Nat.pow_succ]; rw [Nat.mul_comm b, Nat.mul_assoc]
  refine ⟨h n0 mu k, ?_⟩; rw [h, (metzger_subroutine_tip_multiplicity 0 m).2]
"""^^pk:lean4 ;
        skos:notation "N_{k+1} = μ N_k, N_0 = n_0  ⟹  N_k = n_0 μ^k;   continuous form N(t) = N_units exp(∫ λ(s) ds),  λ(t) = λ_b 1[P4 ≤ t < P21] + λ_c 1[P14 ≤ t < P36];   Yule jump law: n → n + NegBin(n, e^{−λΔt});   per-unit CV → sqrt(1 − 1/m), whole-lung CV ≈ 1/sqrt(N_units)" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/ar.20747>,
            <https://doi.org/10.1002/dvdy.21633>,
            <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1242/dev.081679>,
            <https://doi.org/10.1371/journal.pcbi.1003421>,
            <https://doi.org/10.1371/journal.pone.0041643>,
            <https://doi.org/10.4310/CMS.2009.v7.n1.a4> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Stereotyped Branching Subroutine Grammar (D, P, O) & FGF10-SHH-Ptch1 Receptor-Ligand Turing Switch" ;
        pk:leanDeclaration "MathOfBiology.Loop_053.septation_mean" ;
        pk:leanTheorem "MathOfBiology.Loop_053.septation_mean_closed_form" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/miller-ocular-dominance-stripes-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Miller, Keller & Stryker (1989) Sum/Difference Synaptic Mode Decoupling & Subtractive Normalization Conservation Law" ;
        dct:description "Proves that subtractive homeostatic normalization identically conserves total cortical synaptic weight (dS_Sigma/dt = 0) while decoupling the ocular dominance difference mode S_Delta = S_L - S_R so that positive difference correlation C_Delta = C_LL - C_LR > 0 strictly amplifies eye-specific segregation | Variables: S_L, S_R: left-eye and right-eye geniculocortical synaptic densities in V1 Layer IVC; S_Sigma = S_L + S_R: conserved total synaptic density; S_Delta = S_L - S_R: ocular dominance difference mode; C_LL, C_LR: within-eye and between-eye LGN activity correlations; C_Delta = C_LL - C_LR: difference correlation" ;
        dct:source "Miller, Keller & Stryker (1989) Science 245(4918):605-615 Eqs. 1-6" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L95-L222>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_087_ocular_dominance_stripes.lean#L19-L66> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def raw_rate_L (S_L S_R C_LL C_LR : Int) : Int :=
  C_LL * S_L + C_LR * S_R
def raw_rate_R (S_L S_R C_LL C_LR : Int) : Int :=
  C_LR * S_L + C_LL * S_R
def norm_rate_2L (S_L S_R C_LL C_LR : Int) : Int :=
  2 * raw_rate_L S_L S_R C_LL C_LR - (raw_rate_L S_L S_R C_LL C_LR + raw_rate_R S_L S_R C_LL C_LR)
def norm_rate_2R (S_L S_R C_LL C_LR : Int) : Int :=
  2 * raw_rate_R S_L S_R C_LL C_LR - (raw_rate_L S_L S_R C_LL C_LR + raw_rate_R S_L S_R C_LL C_LR)
def sum_mode_rate_2 (S_L S_R C_LL C_LR : Int) : Int :=
  norm_rate_2L S_L S_R C_LL C_LR + norm_rate_2R S_L S_R C_LL C_LR
def diff_mode_rate (C_Delta S_Delta : Int) : Int :=
  C_Delta * S_Delta
theorem miller_sum_difference_decoupling (S_L S_R C_LL C_LR C_Delta S_Delta : Int)
    (h_cd : C_Delta > 0) (h_sd : S_Delta > 0) :
    sum_mode_rate_2 S_L S_R C_LL C_LR = 0 ∧
    norm_rate_2L 10 4 8 2 = 36 ∧
    norm_rate_2R 10 4 8 2 = -36 ∧
    norm_rate_2L 10 4 8 2 - norm_rate_2R 10 4 8 2 = 2 * (8 - 2) * (10 - 4) ∧
    diff_mode_rate C_Delta S_Delta > 0 := by
  refine ⟨?_, by decide, by decide, by decide, ?_⟩
  · dsimp [sum_mode_rate_2, norm_rate_2L, norm_rate_2R]
    omega
  · dsimp [diff_mode_rate]
    exact Int.mul_pos h_cd h_sd
"""^^pk:lean4 ;
        skos:notation "dS_Sigma/dt = d(S^L + S^R)/dt = 0;   dS_Delta/dt = (A * I * (C^{LL} - C^{LR})) * S_Delta - gamma * S_Delta" ;
        prov:wasDerivedFrom <https://doi.org/10.1098/rspb.1980.0051>,
            <https://doi.org/10.1098/rstb.1977.0050>,
            <https://doi.org/10.1126/science.2762813>,
            <https://doi.org/10.1523/JNEUROSCI.06-08-02117.1986> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Correlation-Based Hebbian Ocular Dominance Columns & Critical-Period Plasticity" ;
        pk:leanDeclaration "MathOfBiology.Loop_087.sum_mode_rate_2" ;
        pk:leanTheorem "MathOfBiology.Loop_087.miller_sum_difference_decoupling" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/miller-ocular-dominance-stripes-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Swindale (1980) & Miller, Keller & Stryker (1989) Mexican-Hat Band-Pass Peak Wavenumber & Characteristic Column Wavelength Law" ;
        dct:description "Proves positivity of the Mexican-hat Fourier band-pass denominator sigma_I^2 - sigma_E^2 > 0 and inhibitory moment ratio kappa_I * sigma_I^2 / sigma_E^2 = 3 > 1, selecting the characteristic macaque V1 Layer IVC stripe wavelength lambda_c ~ 800 um (400 um per single-eye column) | Variables: sigma_E, sigma_I: intracortical excitatory and inhibitory lateral interaction ranges (109 um, 218 um); kappa_I: relative inhibitory amplitude (0.75); k_c: fastest-growing Fourier wavenumber; lambda_c = 2 * w_col: full-cycle ocular dominance band wavelength (800 um for 400 um single-eye column width)" ;
        dct:source "Miller, Keller & Stryker (1989) Science 245:605-615; Swindale (1980) Proc. R. Soc. B 208:243-264; Hubel, Wiesel & LeVay (1977) Phil. Trans. R. Soc. B 278:377-409" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L117-L199>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_087_ocular_dominance_stripes.lean#L69-L108> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def mexican_hat_denom (sigma_E_sq sigma_I_sq : Int) : Int :=
  sigma_I_sq - sigma_E_sq
def full_cycle_wavelength (w_col : Int) : Int :=
  2 * w_col
theorem swindale_miller_bandpass_wavelength (sigma_E_sq sigma_I_sq w_1 w_2 : Int)
    (h_range : sigma_E_sq < sigma_I_sq) (h_w : w_1 < w_2) :
    mexican_hat_denom sigma_E_sq sigma_I_sq > 0 ∧
    mexican_hat_denom (109 * 109) (218 * 218) = 35643 ∧
    (3 * (218 * 218)) / (4 * (109 * 109)) = 3 ∧
    full_cycle_wavelength 400 = 800 ∧
    full_cycle_wavelength w_1 < full_cycle_wavelength w_2 := by
  refine ⟨?_, by decide, by decide, by decide, ?_⟩
  · dsimp [mexican_hat_denom]
    omega
  · dsimp [full_cycle_wavelength]
    omega
"""^^pk:lean4 ;
        skos:notation "k_c^2 = 2 * ln(kappa_I * sigma_I^2 / sigma_E^2) / (sigma_I^2 - sigma_E^2) > 0;   lambda_c = 2 * pi / k_c = 2 * w_col approx 800 um" ;
        prov:wasDerivedFrom <https://doi.org/10.1098/rspb.1980.0051>,
            <https://doi.org/10.1098/rstb.1977.0050>,
            <https://doi.org/10.1126/science.2762813>,
            <https://doi.org/10.1523/JNEUROSCI.06-08-02117.1986> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Correlation-Based Hebbian Ocular Dominance Columns & Critical-Period Plasticity" ;
        pk:leanDeclaration "MathOfBiology.Loop_087.mexican_hat_denom" ;
        pk:leanTheorem "MathOfBiology.Loop_087.swindale_miller_bandpass_wavelength" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/miller-ocular-dominance-stripes-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hubel, Wiesel & LeVay (1977) Monocular Deprivation Territory Shift vs Stryker & Harris (1986) Bilateral TTX Blockade Law" ;
        dct:description "Proves that critical-period monocular deprivation shifts cortical territory away from 50/50 symmetry (shrinking deprived-eye stripes to 24% and expanding open-eye columns to 76% while conserving total area 100%), whereas bilateral TTX blockade (C_Delta = 0) makes omega(k) = -gamma < 0 for all wavenumbers and prevents column segregation | Variables: delta_md > 0: monocular deprivation competitive shift (percentage points); deprived_eye_pct, open_eye_pct: Layer IVC cortical territory percentages occupied by deprived and open eyes; dispersion_omega(C_Delta, AK_hat, gamma): Fourier growth rate under bilateral TTX blockade (C_Delta = 0)" ;
        dct:source "Hubel, Wiesel & LeVay (1977) Phil. Trans. R. Soc. B 278(961):377-409; Stryker & Harris (1986) J. Neurosci. 6(8):2117-2133" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L210-L303>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_087_ocular_dominance_stripes.lean#L111-L157> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def deprived_eye_pct (delta_md : Int) : Int :=
  50 - delta_md
def open_eye_pct (delta_md : Int) : Int :=
  50 + delta_md
def dispersion_omega (C_Delta AK_hat gamma : Int) : Int :=
  C_Delta * AK_hat - gamma
theorem hubel_wiesel_md_and_ttx_blockade (delta_md AK_hat gamma : Int)
    (h_md : delta_md > 0) (h_gamma : gamma > 0) :
    deprived_eye_pct 0 = 50 ∧
    open_eye_pct 0 = 50 ∧
    deprived_eye_pct delta_md < 50 ∧
    open_eye_pct delta_md > 50 ∧
    open_eye_pct delta_md - deprived_eye_pct delta_md = 2 * delta_md ∧
    deprived_eye_pct delta_md + open_eye_pct delta_md = 100 ∧
    deprived_eye_pct 26 = 24 ∧
    open_eye_pct 26 = 76 ∧
    dispersion_omega 0 AK_hat gamma < 0 := by
  refine ⟨by decide, by decide, ?_, ?_, ?_, ?_, by decide, by decide, ?_⟩
  · dsimp [deprived_eye_pct]
    omega
  · dsimp [open_eye_pct]
    omega
  · dsimp [open_eye_pct, deprived_eye_pct]
    omega
  · dsimp [deprived_eye_pct, open_eye_pct]
    omega
  · dsimp [dispersion_omega]
    omega
"""^^pk:lean4 ;
        skos:notation "f_L(Delta_MD) = 0.5 - Delta_MD < 0.5 < f_R(Delta_MD) = 0.5 + Delta_MD, f_L + f_R = 1;   C_Delta = 0 ==> omega(k) = -gamma < 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1098/rspb.1980.0051>,
            <https://doi.org/10.1098/rstb.1977.0050>,
            <https://doi.org/10.1126/science.2762813>,
            <https://doi.org/10.1523/JNEUROSCI.06-08-02117.1986> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Correlation-Based Hebbian Ocular Dominance Columns & Critical-Period Plasticity" ;
        pk:leanDeclaration "MathOfBiology.Loop_087.deprived_eye_pct" ;
        pk:leanTheorem "MathOfBiology.Loop_087.hubel_wiesel_md_and_ttx_blockade" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/miller-ocular-dominance-stripes-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Swindale (1992) & Obermayer & Blasdel (1993) Orthogonal Iso-Orientation / Ocular Dominance Border Coupling Quadratic Form (Pass 3)" ;
        dct:description "Proves the Pass 3 anisotropic coupling tensor n n^T is positive semidefinite (its quadratic form (g . v)^2 is non-negative), so the coupling is a stable gradient flow whose energy vanishes exactly when the orientation gradient is orthogonal to the OD gradient, i.e. when iso-orientation contours cross OD borders at right angles; the script measures the resulting intersection angle (coupled ~67 deg vs uncoupled ablation ~42 deg, random baseline 45 deg), pinwheel density and CO-blob-like low-selectivity patches at OD column centres | Variables: z = r exp(2 i theta): complex orientation preference field (r selectivity, theta preferred orientation); g = grad S_Delta: ocular dominance gradient (normal to OD borders); v = grad z: orientation gradient; D_c = 4500 um^2: anisotropic coupling diffusivity; w = |g|^2/(|g|^2 + eps^2): border weight; beta_blob = 0.6: selectivity suppression at OD column centres" ;
        dct:source "Swindale (1992) Biol. Cybern. 66(3):217-230; Obermayer & Blasdel (1993) J. Neurosci. 13(10):4114-4129; Horton & Hubel (1981) Nature 292:762-764; Kaschube et al. (2010) Science 330:1113-1116" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L366-L524>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_087_ocular_dominance_stripes.lean#L164-L202> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def dot2 (g1 g2 v1 v2 : Int) : Int :=
  g1 * v1 + g2 * v2
def coupling_form (g1 g2 v1 v2 : Int) : Int :=
  dot2 g1 g2 v1 v2 * dot2 g1 g2 v1 v2
theorem orthogonal_coupling_quadratic_form (g1 g2 v1 v2 : Int)
    (h_orth : g1 * v1 + g2 * v2 = 0) :
    coupling_form g1 g2 v1 v2 = 0 ∧
    (∀ a b c d : Int, coupling_form a b c d ≥ 0) ∧
    coupling_form 3 4 (-4) 3 = 0 ∧
    coupling_form 3 4 3 4 = 625 ∧
    coupling_form 3 4 3 4 > coupling_form 3 4 (-4) 3 := by
  refine ⟨?_, ?_, by decide, by decide, by decide⟩
  · dsimp [coupling_form, dot2]
    rw [h_orth]
    rfl
  · intro a b c d
    dsimp [coupling_form]
    rcases Int.le_total 0 (dot2 a b c d) with h | h
    · exact Int.mul_nonneg h h
    · exact Int.mul_nonneg_of_nonpos_of_nonpos h h
"""^^pk:lean4 ;
        skos:notation "dz/dt = A*(I_z*z)*C_Delta - gamma*z - |z|^2 z + div(D_c * w * n n^T grad z) - beta_blob * S_Delta^2 * z,  n = grad S_Delta/|grad S_Delta|;   v^T (g g^T) v = (g . v)^2 >= 0, = 0 iff grad theta _|_ grad S_Delta" ;
        prov:wasDerivedFrom <https://doi.org/10.1098/rspb.1980.0051>,
            <https://doi.org/10.1098/rstb.1977.0050>,
            <https://doi.org/10.1126/science.2762813>,
            <https://doi.org/10.1523/JNEUROSCI.06-08-02117.1986> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Correlation-Based Hebbian Ocular Dominance Columns & Critical-Period Plasticity" ;
        pk:leanDeclaration "MathOfBiology.Loop_087.coupling_form" ;
        pk:leanTheorem "MathOfBiology.Loop_087.orthogonal_coupling_quadratic_form" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/miller-ocular-dominance-stripes-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Curved Riemannian V1 Sheet Chart Projection Compression of the Intrinsic Stripe Period (Pass 3)" ;
        dct:description "Proves that on the curved V1 sheet the intrinsic stripe period selected by the Mexican-hat band-pass is invariant while its chart projection is compressed by 1/sqrt(1 + slope^2) (equality only in the flat limit); the script realises the Mexican hat as a difference of Laplace-Beltrami heat kernels with zero-flux elliptical perimeter and measures intrinsic lambda_g ratio (calcarine wall / flat) ~1.07, chart ratio ~0.72, and OD border / perimeter intersection angle ~70 deg (LeVay et al. 1985) | Variables: h(u,v): cortical height field over the 6.4 mm chart (operculum dome amplitude 1000 um / width 2000 um, calcarine groove depth 1600 um / width 500 um); g_ij: induced metric, sqrt g <= 2.44; H_t: Laplace-Beltrami heat kernel (Gaussian of width sigma == heat flow for time sigma^2/2); lambda: intrinsic stripe period (~800 um); lambda_chart: period seen in the flat chart; slope^2 = h'^2 along the chart direction" ;
        dct:source "Miller, Keller & Stryker (1989) Science 245:605-615; LeVay, Connolly, Houde & Van Essen (1985) J. Neurosci. 5(2):486-501" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L531-L731>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_087_ocular_dominance_stripes.lean#L205-L239> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def chart_metric (slope_sq : Int) : Int :=
  1 + slope_sq
def intrinsic_period_sq (lambda_chart_sq slope_sq : Int) : Int :=
  lambda_chart_sq * chart_metric slope_sq
theorem curved_chart_projection_compression (lambda_chart_sq slope_sq : Int)
    (h_slope : slope_sq ≥ 0) (h_pos : lambda_chart_sq ≥ 0) :
    lambda_chart_sq ≤ intrinsic_period_sq lambda_chart_sq slope_sq ∧
    intrinsic_period_sq lambda_chart_sq 0 = lambda_chart_sq ∧
    intrinsic_period_sq (400 * 400) 3 = 800 * 800 ∧
    chart_metric slope_sq ≥ 1 := by
  refine ⟨?_, ?_, by decide, ?_⟩
  · dsimp [intrinsic_period_sq, chart_metric]
    have h_prod : lambda_chart_sq * slope_sq ≥ 0 := Int.mul_nonneg h_pos h_slope
    have h_expand : lambda_chart_sq * (1 + slope_sq) = lambda_chart_sq + lambda_chart_sq * slope_sq := by
      rw [Int.mul_add, Int.mul_one]
    rw [h_expand]
    omega
  · dsimp [intrinsic_period_sq, chart_metric]
    omega
  · dsimp [chart_metric]
    omega
"""^^pk:lean4 ;
        skos:notation "g_ij = delta_ij + h_i h_j;  Delta_g f = (1/sqrt g) d_i(sqrt g g^{ij} d_j f);  I * S = H_{sigma_E^2/2} S - kappa_I H_{sigma_I^2/2} S;   lambda_chart^2 (1 + slope^2) = lambda^2  ==>  lambda_chart^2 <= lambda^2" ;
        prov:wasDerivedFrom <https://doi.org/10.1098/rspb.1980.0051>,
            <https://doi.org/10.1098/rstb.1977.0050>,
            <https://doi.org/10.1126/science.2762813>,
            <https://doi.org/10.1523/JNEUROSCI.06-08-02117.1986> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Correlation-Based Hebbian Ocular Dominance Columns & Critical-Period Plasticity" ;
        pk:leanDeclaration "MathOfBiology.Loop_087.intrinsic_period_sq" ;
        pk:leanTheorem "MathOfBiology.Loop_087.curved_chart_projection_compression" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/mirabet-auxin-pin1-meristem-mechanics-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hamant et al. (2008) Pressurized Shell Principal Stress & 2:1 Cylinder Anisotropy Law" ;
        dct:description "Predicts isotropic tensile stress on the spherical SAM dome (driving hyper-dynamic isotropic microtubules), 2:1 circumferential hoop stress on cylindrical flanks, and amplified 5:1 crease stress at negative-Gaussian-curvature primordium boundaries | Variables: P: turgor pressure (MPa); R: shell curvature radius (um); t: L1 outer epidermal wall thickness (um); σ_θθ, σ_mm: circumferential and meridional principal tensile stresses (MPa); A_σ = (σ_1 - σ_2)/(σ_1 + σ_2): stress anisotropy" ;
        dct:source "Hamant et al. (2008) Science 322(5908):1650-1655 Figs. 1-2 & SOM Text S1" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L148-L315>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_033_auxin_pin1_meristem_mechanics.lean#L27-L48> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def sphere_hoop_stress_2t (P R : Int) : Int := P * R
def sphere_meridional_stress_2t (P R : Int) : Int := P * R
def cylinder_hoop_stress_2t (P R : Int) : Int := 2 * (P * R)
def cylinder_axial_stress_2t (P R : Int) : Int := P * R
theorem hamant_2008_pressurized_shell_anisotropy (P R : Int) :
    sphere_hoop_stress_2t P R - sphere_meridional_stress_2t P R = 0 ∧
    cylinder_hoop_stress_2t P R = 2 * cylinder_axial_stress_2t P R ∧
    3 * (cylinder_hoop_stress_2t P R - cylinder_axial_stress_2t P R) =
      cylinder_hoop_stress_2t P R + cylinder_axial_stress_2t P R
"""^^pk:lean4 ;
        skos:notation "σ_θθ^dome = σ_mm^dome = PR/(2t) (A_σ = 0);  σ_θθ^cyl = PR/t = 2 σ_zz^cyl (A_σ = 1/3);  κ_m σ_m + κ_θ σ_θ = P/t" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jplph.2007.08.002>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.1011866108>,
            <https://doi.org/10.1073/pnas.1600677113>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1242/dev.01261>,
            <https://doi.org/10.1371/journal.pbio.1000516>,
            <https://doi.org/10.1371/journal.pcbi.1002389> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Pressurized Thin-Shell Principal Stress Tensor, Nematic Microtubule Feedback & Up-the-Gradient PIN1 Auxin Transport" ;
        pk:leanDeclaration "MathOfBiology.Loop_033.cylinder_hoop_stress_2t" ;
        pk:leanTheorem "MathOfBiology.Loop_033.hamant_2008_pressurized_shell_anisotropy" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/mirabet-auxin-pin1-meristem-mechanics-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Kirsch / Hamant et al. (2008) Laser Ablation Wound Rim Hoop-Stress Doubling Law" ;
        dct:description "Explains why single-cell or patch laser ablation in the L1 epidermis zeroes radial tension and doubles circumferential tension at the wound rim, reorienting both CMTs and PIN1 circumferentially around the ablation site | Variables: σ_∞: far-field isotropic dome membrane tension (MPa); a_0: laser ablation wound radius (um); r: radial distance from wound center (um)" ;
        dct:source "Hamant et al. (2008) Science 322:1650-1655 Fig. 3; Heisler et al. (2010) PLoS Biol. 8:e1000516 Fig. 4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L1231-L1315>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_033_auxin_pin1_meristem_mechanics.lean#L61-L78> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def kirsch_radial_scaled (sig_inf r_sq a0_sq : Int) : Int :=
  sig_inf * (r_sq - a0_sq)
def kirsch_hoop_scaled (sig_inf r_sq a0_sq : Int) : Int :=
  sig_inf * (r_sq + a0_sq)
theorem hamant_2008_ablation_rim_hoop_doubling (sig_inf r_sq a0_sq : Int) :
    kirsch_radial_scaled sig_inf a0_sq a0_sq = 0 ∧
    kirsch_hoop_scaled sig_inf a0_sq a0_sq = 2 * (sig_inf * a0_sq) ∧
    kirsch_radial_scaled sig_inf r_sq a0_sq + kirsch_hoop_scaled sig_inf r_sq a0_sq =
      2 * (sig_inf * r_sq)
"""^^pk:lean4 ;
        skos:notation "σ_rr(r) = σ_∞(1 - a_0^2/r^2),  σ_θθ(r) = σ_∞(1 + a_0^2/r^2)  ⇒  σ_rr(a_0) = 0,  σ_θθ(a_0) = 2 σ_∞,  σ_rr + σ_θθ = 2 σ_∞" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jplph.2007.08.002>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.1011866108>,
            <https://doi.org/10.1073/pnas.1600677113>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1242/dev.01261>,
            <https://doi.org/10.1371/journal.pbio.1000516>,
            <https://doi.org/10.1371/journal.pcbi.1002389> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Pressurized Thin-Shell Principal Stress Tensor, Nematic Microtubule Feedback & Up-the-Gradient PIN1 Auxin Transport" ;
        pk:leanDeclaration "MathOfBiology.Loop_033.kirsch_hoop_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_033.hamant_2008_ablation_rim_hoop_doubling" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/mirabet-auxin-pin1-meristem-mechanics-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Heisler et al. (2010) & Jonsson et al. (2006) Stress- & Auxin-Coupled PIN1 Active Transport Conservation Law" ;
        dct:description "Couples PIN1 membrane allocation to both neighbor auxin concentration and cell-wall tensile stress orientation, generating golden-angle (137.5 deg) phyllotactic auxin maxima and synchronous PIN1/CMT reorientation | Variables: a_i: auxin concentration in L1 cell i; P_ij: PIN1 efflux carrier allocated to membrane i→j; e_1,i: maximal principal tensile stress eigenvector; T_PIN: active polar transport coefficient" ;
        dct:source "Heisler et al. (2010) PLoS Biol. 8(10):e1000516 Figs. 1-4; Jonsson et al. (2006) PNAS 103:1633-1638 Eqs. 1-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L960-L1228>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_033_auxin_pin1_meristem_mechanics.lean#L91-L101> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def pin1_active_flux (T_pin P_ij P_ji a_i a_j : Int) : Int :=
  T_pin * (P_ji * a_j - P_ij * a_i)
theorem heisler_2010_pin1_flux_conservation (T_pin P_ij P_ji P_sym a_i a_j a : Int) :
    pin1_active_flux T_pin P_ij P_ji a_i a_j + pin1_active_flux T_pin P_ji P_ij a_j a_i = 0 ∧
    pin1_active_flux T_pin P_sym P_sym a a = 0
"""^^pk:lean4 ;
        skos:notation "P_ij = P_tot exp(b_a a_j + b_σ |n_ij · e_1,i|^2) / Z_i;  J_{i←j} = T_PIN (P_ji a_j - P_ij a_i),  J_{i←j} + J_{j←i} = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jplph.2007.08.002>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.1011866108>,
            <https://doi.org/10.1073/pnas.1600677113>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1242/dev.01261>,
            <https://doi.org/10.1371/journal.pbio.1000516>,
            <https://doi.org/10.1371/journal.pcbi.1002389> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Pressurized Thin-Shell Principal Stress Tensor, Nematic Microtubule Feedback & Up-the-Gradient PIN1 Auxin Transport" ;
        pk:leanDeclaration "MathOfBiology.Loop_033.pin1_active_flux" ;
        pk:leanTheorem "MathOfBiology.Loop_033.heisler_2010_pin1_flux_conservation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/mirabet-auxin-pin1-meristem-mechanics-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hamant et al. (2008) / Kutschera & Niklas (2007) Multi-layered L1/L2/L3 Pressurized Shell Load-Sharing Law (Pass 3)" ;
        dct:description "Predicts that the stiff outer L1 wall carries the stiffness share k_1/Σk of the total turgor-driven shell tension (5/7 for the k_L1/k_inner = 5 assumption); checked numerically against the per-layer virial tension sums of the 3D Voronoi mesh (0.714 vs 0.714) and across the stiffness-ratio sweep | Variables: k_j: in-plane wall stiffness of layer j (L1 epidermis, L2 sub-epidermis, L3 corpus; k_1 = 5 k_inner); ε: common in-plane membrane strain; N_j: in-plane tension carried by layer j; P: turgor pressure; R: dome radius" ;
        dct:source "Hamant et al. (2008) Science 322:1650-1655 SOM Text S1 (thick L1 outer wall); Kutschera & Niklas (2007) J. Plant Physiol. 164:1395-1409 (epidermal-growth-control theory)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L513-L957>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_033_auxin_pin1_meristem_mechanics.lean#L107-L138> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def layer_membrane_tension (k eps : Int) : Int :=
  k * eps
theorem hamant_2008_multilayer_shell_load_sharing (k1 k2 k3 eps P R : Int)
    (h_laplace : 2 * ((k1 + k2 + k3) * eps) = P * R) :
    layer_membrane_tension k1 eps + layer_membrane_tension k2 eps + layer_membrane_tension k3 eps
      = (k1 + k2 + k3) * eps ∧
    layer_membrane_tension k1 eps * (k1 + k2 + k3) = k1 * ((k1 + k2 + k3) * eps) ∧
    2 * (layer_membrane_tension k1 eps + layer_membrane_tension k2 eps + layer_membrane_tension k3 eps)
      = P * R
"""^^pk:lean4 ;
        skos:notation "N_j = k_j ε (compatible in-plane strain ε across glued layers);  Σ_j N_j = (k_1 + k_2 + k_3) ε;  N_1 / Σ N = k_1 / Σ k;  2 Σ N = P R (Laplace-Young recovered as the aggregate)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jplph.2007.08.002>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.1011866108>,
            <https://doi.org/10.1073/pnas.1600677113>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1242/dev.01261>,
            <https://doi.org/10.1371/journal.pbio.1000516>,
            <https://doi.org/10.1371/journal.pcbi.1002389> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Pressurized Thin-Shell Principal Stress Tensor, Nematic Microtubule Feedback & Up-the-Gradient PIN1 Auxin Transport" ;
        pk:leanDeclaration "MathOfBiology.Loop_033.layer_membrane_tension" ;
        pk:leanTheorem "MathOfBiology.Loop_033.hamant_2008_multilayer_shell_load_sharing" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/mirabet-auxin-pin1-meristem-mechanics-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Louveaux et al. (2016) Tension-Aligned Anticlinal Division Plane & Sachs Volume Bookkeeping Law (Pass 3)" ;
        dct:description "Defines the mechanical (Louveaux 2016) division rule used for L1/L2 cells of the 3D mesh: the new anticlinal wall is placed along maximal tension; the Gibbs rule of Besson & Dumais (2011, β = 20.6) is the geometric alternative. Benchmarked against the 65-77 % shortest-plane and 81 % symmetric-division statistics of the shoot apex (the tension rule reaches only 0.38 shortest-plane, reported as a FAILED comparison) | Variables: n_s: outward surface normal of the L1/L2 cell; e_1: in-plane maximal-tension eigenvector of the cell tension tensor (tissue virial + cell-autonomous turgor term); n_div: normal of the new cell wall; V_1, V_2, V_mother: daughter and mother cell volumes" ;
        dct:source "Louveaux et al. (2016) PNAS 113(30):E4294-E4303; Besson & Dumais (2011) PNAS 108:6294-6299; Reddy et al. (2004) Development 131:4225-4237" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L418-L511>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_033_auxin_pin1_meristem_mechanics.lean#L141-L172> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cross_x (a2 a3 b2 b3 : Int) : Int := a2 * b3 - a3 * b2
def cross_y (a1 a3 b1 b3 : Int) : Int := a3 * b1 - a1 * b3
def cross_z (a1 a2 b1 b2 : Int) : Int := a1 * b2 - a2 * b1
def dot3 (x1 x2 x3 y1 y2 y3 : Int) : Int := x1 * y1 + x2 * y2 + x3 * y3
theorem louveaux_2016_anticlinal_tension_division_plane
    (n1 n2 n3 e1 e2 e3 V1 V2 Vm : Int)
    (h_sum : V1 + V2 = Vm) (h_sym : V1 = V2) :
    dot3 (cross_x n2 n3 e2 e3) (cross_y n1 n3 e1 e3) (cross_z n1 n2 e1 e2) n1 n2 n3 = 0 ∧
    dot3 (cross_x n2 n3 e2 e3) (cross_y n1 n3 e1 e3) (cross_z n1 n2 e1 e2) e1 e2 e3 = 0 ∧
    2 * V1 = Vm
"""^^pk:lean4 ;
        skos:notation "n_div = n_s × e_1  ⇒  n_div · n_s = 0 (anticlinal: new wall contains the surface normal) and n_div · e_1 = 0 (new wall contains the maximal-tension direction);  V_1 + V_2 = V_mother, V_1 = V_2 ⇒ 2 V_1 = V_mother" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jplph.2007.08.002>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.1011866108>,
            <https://doi.org/10.1073/pnas.1600677113>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1242/dev.01261>,
            <https://doi.org/10.1371/journal.pbio.1000516>,
            <https://doi.org/10.1371/journal.pcbi.1002389> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Pressurized Thin-Shell Principal Stress Tensor, Nematic Microtubule Feedback & Up-the-Gradient PIN1 Auxin Transport" ;
        pk:leanDeclaration "MathOfBiology.Loop_033.dot3" ;
        pk:leanTheorem "MathOfBiology.Loop_033.louveaux_2016_anticlinal_tension_division_plane" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/mitchison-canalization-auxin-flux-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Mitchison (1980) Linear vs Quadratic Flux-Canalization Symmetry Breaking Law" ;
        dct:description "Proves why linear feedback (p <= 1) damps conductivity perturbations back to a broad diffuse sheet whereas quadratic feedback (p = 2) triggers supercritical pitchfork winner-take-all symmetry breaking into 1-cell-wide vascular strands | Variables: D_ij: intercellular auxin diffusivity across cell wall (i,j); φ_ij = D_ij(S_i - S_j): auxin flux; p: feedback exponent (p<=1 diffuse sheet, p=2 single-cell strand); α: flux reinforcement gain; β: basal diffusivity synthesis; γ: carrier degradation rate" ;
        dct:source "Mitchison (1980) Proc. R. Soc. Lond. B 207(1166):79-109 Eqs. 2-6 & Fig. 1" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1997-mitchison-canalization-auxin-flux.py#L95-L215>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_034_auxin_canalization_leaf_veins.lean#L29-L48> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def linear_canalization_rhs (alpha beta gamma dS D : Int) : Int :=
  alpha * (D * dS) + beta - gamma * D
def quadratic_canalization_rhs (alpha beta gamma dS D : Int) : Int :=
  alpha * (D * dS) * (D * dS) + beta - gamma * D
theorem mitchison_1980_quadratic_vs_linear_symmetry_breaking
    (alpha beta gamma dS D1 D2 : Int) :
    D2 * linear_canalization_rhs alpha beta gamma dS D1 -
      D1 * linear_canalization_rhs alpha beta gamma dS D2 = beta * (D2 - D1) ∧
    D2 * quadratic_canalization_rhs alpha beta gamma dS D1 -
      D1 * quadratic_canalization_rhs alpha beta gamma dS D2 =
      (D1 - D2) * (alpha * dS * dS * D1 * D2 - beta)
"""^^pk:lean4 ;
        skos:notation "dD_ij/dt = α |φ_ij|^p + β - γ D_ij;  D_2 dD_1/dt - D_1 dD_2/dt = β(D_2 - D_1) (p=1, diffuse)  vs  (D_1 - D_2)(α (ΔS)^2 D_1 D_2 - β) (p=2, winner-take-all canalization)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0065-2296(08)60351-1>,
            <https://doi.org/10.1016/j.jtbi.2005.03.017>,
            <https://doi.org/10.1016/j.jtbi.2006.05.022>,
            <https://doi.org/10.1086/382794>,
            <https://doi.org/10.1098/rspb.1980.0082>,
            <https://doi.org/10.1098/rstb.1981.0081>,
            <https://doi.org/10.1101/gad.1402406>,
            <https://doi.org/10.1111/j.1365-313X.2005.02581.x>,
            <https://doi.org/10.1111/nph.12253>,
            <https://doi.org/10.1145/1073204.1073251> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "With-the-Flux Auxin Canalization & PIN1 Carrier-Allocated Venation Topology" ;
        pk:leanDeclaration "MathOfBiology.Loop_034.quadratic_canalization_rhs" ;
        pk:leanTheorem "MathOfBiology.Loop_034.mitchison_1980_quadratic_vs_linear_symmetry_breaking" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/mitchison-canalization-auxin-flux-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Mitchison (1980) Canalized Vein Auxin Concentration Drainage Law (S_vein < S_parenchyma)" ;
        dct:description "Proves that quadratic flux-driven conductivity growth drops the auxin concentration inside a canalizing vein below that of surrounding parenchyma (S_vein < S_par), turning the differentiating vein into a lateral drainage sink that recruits tributaries and bypasses stem wounds (Sachs 1981) | Variables: S_vein, S_par: steady-state auxin concentration inside the canalized vascular strand vs surrounding parenchyma; φ_vein, φ_par: axial auxin flux in vein vs parenchyma" ;
        dct:source "Mitchison (1980) Proc. R. Soc. Lond. B 207:79-109 Fig. 2 & pp. 83-87; Sachs (1981) Adv. Bot. Res. 9:151-262" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1997-mitchison-canalization-auxin-flux.py#L220-L355>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_034_auxin_canalization_leaf_veins.lean#L66-L78> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def steady_conductivity_scaled (alpha beta phi : Int) : Int :=
  alpha * phi * phi + beta
def drainage_conc_diff_scaled (alpha beta phi_vein phi_par : Int) : Int :=
  phi_par * steady_conductivity_scaled alpha beta phi_vein -
    phi_vein * steady_conductivity_scaled alpha beta phi_par
theorem mitchison_1980_vein_concentration_drainage (alpha beta phi_vein phi_par : Int) :
    drainage_conc_diff_scaled alpha beta phi_vein phi_par =
      (phi_vein - phi_par) * (alpha * phi_vein * phi_par - beta)
"""^^pk:lean4 ;
        skos:notation "D^*(φ) = (α φ^2 + β)/γ,  S(φ) = φ / D^*(φ)  ⇒  S_par - S_vein = (φ_vein - φ_par)(α φ_vein φ_par - β) / (γ D_vein D_par) > 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0065-2296(08)60351-1>,
            <https://doi.org/10.1016/j.jtbi.2005.03.017>,
            <https://doi.org/10.1016/j.jtbi.2006.05.022>,
            <https://doi.org/10.1086/382794>,
            <https://doi.org/10.1098/rspb.1980.0082>,
            <https://doi.org/10.1098/rstb.1981.0081>,
            <https://doi.org/10.1101/gad.1402406>,
            <https://doi.org/10.1111/j.1365-313X.2005.02581.x>,
            <https://doi.org/10.1111/nph.12253>,
            <https://doi.org/10.1145/1073204.1073251> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "With-the-Flux Auxin Canalization & PIN1 Carrier-Allocated Venation Topology" ;
        pk:leanDeclaration "MathOfBiology.Loop_034.drainage_conc_diff_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_034.mitchison_1980_vein_concentration_drainage" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/mitchison-canalization-auxin-flux-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Mitchison (1981) & Feugier et al. (2005) Polar Carrier-Allocated Intercellular Flux Conservation Law" ;
        dct:description "Guarantees exact pairwise intercellular auxin conservation while enabling polar transport against concentration gradients and governing the Feugier et al. (2005) topological transition between open hierarchical venation trees (β_1 = 0) and closed-areole venation loops (β_1 > 0) | Variables: P_ij: directed PIN1 efflux carrier permeability on membrane face i→j; S_i: cytoplasmic auxin concentration in cell i; D_0: apoplastic passive diffusivity; β_1 = E - V + C: venation graph cycle rank (areole loop count)" ;
        dct:source "Mitchison (1981) Phil. Trans. R. Soc. B 295:461-471 Eqs. 1-5; Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:366-375 Eqs. 1-9 & Figs. 3-7" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1997-mitchison-canalization-auxin-flux.py#L360-L495>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_034_auxin_canalization_leaf_veins.lean#L92-L103> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def polar_canalization_flux (P_ij P_ji D0 S_i S_j : Int) : Int :=
  P_ij * S_i - P_ji * S_j + D0 * (S_i - S_j)
theorem feugier_2005_polar_flux_conservation (P_ij P_ji D0 S_i S_j S : Int) :
    polar_canalization_flux P_ij P_ji D0 S_i S_j +
      polar_canalization_flux P_ji P_ij D0 S_j S_i = 0 ∧
    polar_canalization_flux P_ij P_ji D0 S S = (P_ij - P_ji) * S
"""^^pk:lean4 ;
        skos:notation "φ_{i→j} = P_ij S_i - P_ji S_j + D_0(S_i - S_j),  φ_{i→j} + φ_{j→i} = 0;  dP_ij/dt = F(φ_{i→j}, P_cell) - γ P_ij" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0065-2296(08)60351-1>,
            <https://doi.org/10.1016/j.jtbi.2005.03.017>,
            <https://doi.org/10.1016/j.jtbi.2006.05.022>,
            <https://doi.org/10.1086/382794>,
            <https://doi.org/10.1098/rspb.1980.0082>,
            <https://doi.org/10.1098/rstb.1981.0081>,
            <https://doi.org/10.1101/gad.1402406>,
            <https://doi.org/10.1111/j.1365-313X.2005.02581.x>,
            <https://doi.org/10.1111/nph.12253>,
            <https://doi.org/10.1145/1073204.1073251> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "With-the-Flux Auxin Canalization & PIN1 Carrier-Allocated Venation Topology" ;
        pk:leanDeclaration "MathOfBiology.Loop_034.polar_canalization_flux" ;
        pk:leanTheorem "MathOfBiology.Loop_034.feugier_2005_polar_flux_conservation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/mitchison-canalization-auxin-flux-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Mitchison (1980) Saturating Flux-Feedback Canalization on a Growing Lamina — Boundedness & Monotonicity Law (Pass 3)" ;
        dct:description "Guarantees that the flux feedback stays bounded (F ≤ α φ_s^2) as total lamina production grows with cell number, while preserving the Law 1 winner-take-all ordering (more flux => at least as much reinforcement), which is why a hierarchy of strand orders can be solved across three growth stages without a hard conductance cap turning strands into sheets | Variables: φ_ij = D_ij (S_i - S_j): wall flux on the hexagonal cell lattice; φ_s: soft-saturation flux (1.0 = 100 cells' production); α, β, γ as in Law 1; the lamina grows by cell division (4x cells per stage) so the midrib flux grows 4x per stage" ;
        dct:source "Mitchison (1980) Proc. R. Soc. Lond. B 207:79-109 Eqs. 2-3 (feedback form); saturation after Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:366-375 (saturating carrier response)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1997-mitchison-canalization-auxin-flux.py#L732-L1031>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_034_auxin_canalization_leaf_veins.lean#L125-L167> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def saturating_feedback_num (alpha phi phis : Int) : Int :=
  alpha * (phi * phi) * (phis * phis)
def saturating_feedback_den (phi phis : Int) : Int :=
  phis * phis + phi * phi
theorem saturating_canalization_feedback_bounded (alpha phi phis : Int) (h : 0 ≤ alpha) :
    saturating_feedback_num alpha phi phis ≤ alpha * (phis * phis) * saturating_feedback_den phi phis
theorem saturating_canalization_feedback_monotone (phi1 phi2 phis : Int)
    (h0 : 0 ≤ phi1) (h12 : phi1 ≤ phi2) :
    phi1 * phi1 * saturating_feedback_den phi2 phis ≤ phi2 * phi2 * saturating_feedback_den phi1 phis
"""^^pk:lean4 ;
        skos:notation "dD_ij/dt = α |φ_ij|^2 / (1 + φ_ij^2/φ_s^2) + β - γ D_ij;  α φ^2 φ_s^2 ≤ α φ_s^2 (φ_s^2 + φ^2)  (F(φ) ≤ α φ_s^2);  0 ≤ φ_1 ≤ φ_2 ⇒ φ_1^2 (φ_s^2 + φ_2^2) ≤ φ_2^2 (φ_s^2 + φ_1^2)  (F monotone)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0065-2296(08)60351-1>,
            <https://doi.org/10.1016/j.jtbi.2005.03.017>,
            <https://doi.org/10.1016/j.jtbi.2006.05.022>,
            <https://doi.org/10.1086/382794>,
            <https://doi.org/10.1098/rspb.1980.0082>,
            <https://doi.org/10.1098/rstb.1981.0081>,
            <https://doi.org/10.1101/gad.1402406>,
            <https://doi.org/10.1111/j.1365-313X.2005.02581.x>,
            <https://doi.org/10.1111/nph.12253>,
            <https://doi.org/10.1145/1073204.1073251> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "With-the-Flux Auxin Canalization & PIN1 Carrier-Allocated Venation Topology" ;
        pk:leanDeclaration "MathOfBiology.Loop_034.saturating_feedback_num" ;
        pk:leanTheorem "MathOfBiology.Loop_034.saturating_canalization_feedback_bounded" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/mitchison-canalization-auxin-flux-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Sachs (1981) Irreversible Vascular Differentiation Monotonicity Law (Pass 3 ablation)" ;
        dct:description "Formalises the optional irreversibility rule used as an ablation in the growing-lamina solver; the solver shows that irreversibility alone does not close loops (β_1 = 0 in both variants), carrying loop closure forward as an open remediation item | Variables: d_t: differentiated flag of a cell wall; D_diff = 3 β/γ: differentiation threshold" ;
        dct:source "Sachs (1981) Adv. Bot. Res. 9:151-262 (irreversible vascular differentiation); Feugier & Iwasa (2006) J. Theor. Biol. 243:235-244" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1997-mitchison-canalization-auxin-flux.py#L804-L824>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_034_auxin_canalization_leaf_veins.lean#L173-L178> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def differentiation_update (d : Bool) (exceeds : Bool) : Bool :=
  d || exceeds
theorem irreversible_differentiation_monotone (d exceeds : Bool) (h : d = true) :
    differentiation_update d exceeds = true
"""^^pk:lean4 ;
        skos:notation "d_{t+1} = d_t ∨ [D_ij(t) > D_diff];  d_t = true ⇒ d_{t+1} = true (differentiated wall set is non-decreasing)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0065-2296(08)60351-1>,
            <https://doi.org/10.1016/j.jtbi.2005.03.017>,
            <https://doi.org/10.1016/j.jtbi.2006.05.022>,
            <https://doi.org/10.1086/382794>,
            <https://doi.org/10.1098/rspb.1980.0082>,
            <https://doi.org/10.1098/rstb.1981.0081>,
            <https://doi.org/10.1101/gad.1402406>,
            <https://doi.org/10.1111/j.1365-313X.2005.02581.x>,
            <https://doi.org/10.1111/nph.12253>,
            <https://doi.org/10.1145/1073204.1073251> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "With-the-Flux Auxin Canalization & PIN1 Carrier-Allocated Venation Topology" ;
        pk:leanDeclaration "MathOfBiology.Loop_034.differentiation_update" ;
        pk:leanTheorem "MathOfBiology.Loop_034.irreversible_differentiation_monotone" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/moulton-mollusc-aperture-spine-buckling-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Moulton, Goriely & Chirat (2015) Multi-Generational Fractal Fronding Wavenumber Cascade" ;
        dct:description "Proves that distal thinning of an already buckled primary spine crest reduces flexural rigidity D_i ~ E h_i^3, cascading the instability to higher wavenumbers k_2^*/k_1^* ≈ 3.8 and k_3^* > k_2^* to form secondary and tertiary fractal frond serrations in Chicoreus ramosus | Variables: h_1, h_2, h_3: primary, secondary, and tertiary distal mantle margin thicknesses (mm); K_s: unilateral calcified shell foundation stiffness (MPa/mm); E: mantle Young's modulus (MPa); k_i^*: characteristic buckling wavenumber (mm^-1)" ;
        dct:source "Moulton, Goriely & Chirat (2015) J. Theor. Biol. 364:420-430 Sec. 3-4 & Figs. 5-8" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9987db7d/2015-moulton-mollusc-aperture-spine-buckling.py#L160-L332>,
            <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/lean/loops/Loop_077_mollusc_aperture_spine_buckling.lean#L21-L55> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def frond_wavenumber_residual (E_h3 k4 K_s : Int) : Int :=
  E_h3 * k4 - 3 * K_s
def frond_cascade_gap (h_coarse h_fine : Int) : Int :=
  h_coarse * h_coarse * h_coarse - h_fine * h_fine * h_fine
theorem moulton_secondary_frond_cascade (E_h3 K_s : Int) :
    frond_wavenumber_residual E_h3 (3 * K_s) (E_h3 * K_s) = 0 ∧
    frond_cubic_thickness 1 < frond_cubic_thickness 2 ∧
    frond_cubic_thickness 2 < frond_cubic_thickness 6 ∧
    frond_cascade_gap 6 1 = 215 ∧
    frond_cascade_gap 6 2 = 208
"""^^pk:lean4 ;
        skos:notation "k_i^* = (3 K_s / (E h_i^3))^(1/4);  h_3 < h_2 < h_1  ⇒  k_3^* > k_2^* > k_1^*,  k_2^* / k_1^* = (h_1 / h_2)^(3/4) ≈ 3.8" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2012.07.009>,
            <https://doi.org/10.1016/j.jtbi.2014.09.021>,
            <https://doi.org/10.1073/pnas.1220443110>,
            <https://doi.org/10.1209/0295-5075/83/10005>,
            <https://doi.org/10.1371/journal.pcbi.1007213> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Kirchhoff-Clebsch Elastica on Unilateral Foundation & Hierarchical Multi-Stage Mantle Spine Buckling" ;
        pk:leanDeclaration "MathOfBiology.Loop_077.frond_cascade_gap" ;
        pk:leanTheorem "MathOfBiology.Loop_077.moulton_secondary_frond_cascade" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/moulton-mollusc-aperture-spine-buckling-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Moulton, Goriely & Chirat (2015) Tubular vs Open-Gutter Spine Folding Closure Criterion" ;
        dct:description "Governs the topological transition from an open-gutter spine or flared frond apex (γ_c < γ < γ_fold, Chicoreus distal frond) to a self-contacting sealed hollow tubular spine (γ ≥ γ_fold, Murex pecten siphonal comb spines) | Variables: γ: incremental circumferential mantle growth stretch; γ_c: critical buckling stretch threshold; γ_fold: elastica self-contact folding threshold; Δx_neck: basal neck opening width (mm)" ;
        dct:source "Moulton, Goriely & Chirat (2015) J. Theor. Biol. 364:420-430 Sec. 2.2-3.1 & Chirat, Moulton & Goriely (2013) PNAS 110:6015-6020 Fig. 3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9987db7d/2015-moulton-mollusc-aperture-spine-buckling.py#L335-L437>,
            <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/lean/loops/Loop_077_mollusc_aperture_spine_buckling.lean#L61-L90> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def spine_neck_gap (w_base gamma_fold gamma : Int) : Int :=
  w_base * (gamma_fold - gamma)
def is_tubular_sealed (w_base gamma_fold gamma : Int) : Bool :=
  decide (spine_neck_gap w_base gamma_fold gamma ≤ 0)
theorem moulton_tubular_spine_closure_criterion (w_base gamma_fold : Int) :
    spine_neck_gap w_base gamma_fold gamma_fold = 0 ∧
    spine_neck_gap 4 142 130 = 48 ∧
    is_tubular_sealed 4 142 130 = false ∧
    is_tubular_sealed 4 142 142 = true ∧
    spine_neck_gap 4 142 168 = -104 ∧
    is_tubular_sealed 4 142 168 = true
"""^^pk:lean4 ;
        skos:notation "Δx_neck(γ) = w_base (1 - (γ - γ_c)/(γ_fold - γ_c));  γ ≥ γ_fold ⇔ Δx_neck(γ) ≤ 0 (tubular base closure)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2012.07.009>,
            <https://doi.org/10.1016/j.jtbi.2014.09.021>,
            <https://doi.org/10.1073/pnas.1220443110>,
            <https://doi.org/10.1209/0295-5075/83/10005>,
            <https://doi.org/10.1371/journal.pcbi.1007213> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Kirchhoff-Clebsch Elastica on Unilateral Foundation & Hierarchical Multi-Stage Mantle Spine Buckling" ;
        pk:leanDeclaration "MathOfBiology.Loop_077.spine_neck_gap" ;
        pk:leanTheorem "MathOfBiology.Loop_077.moulton_tubular_spine_closure_criterion" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/moulton-mollusc-aperture-spine-buckling-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Episodic Triradiate Varix Rest-Period Spine Periodicity & Subcritical Smooth Whorl Law" ;
        dct:description "Proves that subcritical inter-varix mantle growth (γ ≤ γ_c) yields smooth unspined shell whorls while periodic rest-period growth bursts every Δφ = 120° produce three phase-locked triradiate spine rows per whorl | Variables: φ: helicospiral whorl accretion angle (deg); γ(φ): episodic mantle growth profile; γ_c: critical buckling threshold; A_spine: radial spine outgrowth amplitude (mm); Δφ_varix = 120°: angular spacing between successive varices" ;
        dct:source "Chirat, Moulton & Goriely (2013) PNAS 110:6015-6020 pp. 6016-6019 & Moulton, Goriely & Chirat (2012) J. Theor. Biol. 311:69-79" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9987db7d/2015-moulton-mollusc-aperture-spine-buckling.py#L440-L494>,
            <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/lean/loops/Loop_077_mollusc_aperture_spine_buckling.lean#L96-L125> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def episodic_varix_amplitude_sq (A0_sq gamma gamma_c : Nat) : Nat :=
  A0_sq * (gamma - gamma_c)
def triradiate_whorl_period_deg (n_varices_per_whorl delta_phi_deg : Nat) : Nat :=
  n_varices_per_whorl * delta_phi_deg
theorem moulton_episodic_varix_rest_period (A0_sq gamma_c dgamma : Nat) :
    episodic_varix_amplitude_sq A0_sq gamma_c gamma_c = 0 ∧
    episodic_varix_amplitude_sq A0_sq 0 gamma_c = 0 ∧
    episodic_varix_amplitude_sq A0_sq (gamma_c + (dgamma + 1)) gamma_c = A0_sq * (dgamma + 1) ∧
    triradiate_whorl_period_deg 3 120 = 360
"""^^pk:lean4 ;
        skos:notation "A_spine^2(γ) = A_0^2 max(0, γ(φ) - γ_c);  γ(φ) ≤ γ_c ⇒ A_spine = 0 (smooth inter-varix whorl);  3 Δφ_varix = 360° (Δφ_varix = 120°)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2012.07.009>,
            <https://doi.org/10.1016/j.jtbi.2014.09.021>,
            <https://doi.org/10.1073/pnas.1220443110>,
            <https://doi.org/10.1209/0295-5075/83/10005>,
            <https://doi.org/10.1371/journal.pcbi.1007213> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Kirchhoff-Clebsch Elastica on Unilateral Foundation & Hierarchical Multi-Stage Mantle Spine Buckling" ;
        pk:leanDeclaration "MathOfBiology.Loop_077.episodic_varix_amplitude_sq" ;
        pk:leanTheorem "MathOfBiology.Loop_077.moulton_episodic_varix_rest_period" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/moulton-mollusc-aperture-spine-buckling-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pass 3 — Oblique Spiral-Cord / Varix Intersection Registration (reduced Koiter shell cord-templating)" ;
        dct:description "Reduced (linearised Koiter / FvK) shell surface replacing the requested 3D finite-strain FE shell: spines, their count and their registration to oblique cord/varix intersections are emergent from noise; cord ridge forcing opens an Arnold-type locking tongue n_spines = n_cords whose width grows with ε_cord, and oblique cords are followed by tilted spine ridges until the cord phase drift across the varix window de-registers them | Variables: L: margin / varix length (mm); λ_c: spiral cord spacing normal to the cords (mm); ψ: cord obliquity vs the accretion direction t; λ_1: free buckling wavelength; N_1: free spine count; w(s,t): outward deflection of the mantle-margin surface; P(t): varix membrane pre-compression window; K_0 = (k_1^*)^4: Winkler foundation; ε_cord: cord ridge forcing strength" ;
        dct:source "Chirat, Moulton & Goriely (2013) PNAS 110:6015-6020 (cord-positioned varix spines); Rudraraju, Moulton, Chirat & Goriely (2019) PLoS Comput. Biol. 15:e1007213 (3D morphoelastic shell framework, reduced here); Manor, Hagberg & Meron (2008) EPL 83:10005 (wavenumber locking under spatial forcing)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9987db7d/2015-moulton-mollusc-aperture-spine-buckling.py#L670-L900>,
            <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/lean/loops/Loop_077_mollusc_aperture_spine_buckling.lean#L127-L162> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cord_varix_intersections (L lam_c cos_num cos_den : Nat) : Nat :=
  L * cos_num / (lam_c * cos_den)
def free_spine_count (L lam1 : Nat) : Nat :=
  L / lam1
theorem cord_varix_intersection_registration
    (L lam1 lam_c cos_num cos_den : Nat) (h : lam_c * cos_den = lam1 * cos_num)
    (hc : 0 < cos_num) :
    cord_varix_intersections L lam_c cos_num cos_den = free_spine_count L lam1 ∧
    cord_varix_intersections 80 4 4 5 = 16 ∧
    free_spine_count 80 5 = 16 ∧
    cord_varix_intersections 80 4 3 5 = 12
"""^^pk:lean4 ;
        skos:notation "d_cross = λ_c / cos ψ;  n_cross = L cos ψ / λ_c;  λ_c = λ_1 cos ψ  ⇒  n_cross = L / λ_1 = N_1 (1:1 cord-templated varix spines);  U[w] = ∫∫ [½ D (∇²w)² − ½ P(t) (∂_s w)² + ½ K_0 w² + ¼ κ₃ w⁴ − f_cord w] ds dt,  f_cord = ε_cord K_0 A_onset cos(k_c (s cos ψ + t sin ψ))" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2012.07.009>,
            <https://doi.org/10.1016/j.jtbi.2014.09.021>,
            <https://doi.org/10.1073/pnas.1220443110>,
            <https://doi.org/10.1209/0295-5075/83/10005>,
            <https://doi.org/10.1371/journal.pcbi.1007213> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Kirchhoff-Clebsch Elastica on Unilateral Foundation & Hierarchical Multi-Stage Mantle Spine Buckling" ;
        pk:leanDeclaration "MathOfBiology.Loop_077.cord_varix_intersections" ;
        pk:leanTheorem "MathOfBiology.Loop_077.cord_varix_intersection_registration" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/moulton-mollusc-aperture-spine-buckling-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pass 3 — Mantle-Edge Thickness Gradient h(s) (inverse WKB) & Ontogenetic Spine-Count Conservation Exponent" ;
        dct:description "Closest honest reduced version of the requested micro-CT h(s) instar data: the relative thickness gradient is inferred from the SHA-256-locked Murex pecten spacing profile, propagated through a graded-rigidity unilateral comb (emergent spacing tracks λ ∝ h^(3/4), r ≈ 0.99) and through an analytic instar series whose spine count is conserved iff β = 4/3; measured micro-CT cross-sections remain a Pass 4 residual | Variables: h(s): mantle-edge thickness along the margin (mm); λ(s): local inter-spine spacing; β: ontogenetic allometric exponent of h_1 vs margin length L across instars; N_1: primary spines per varix; D(s) = (h(s)/h̄)^3: graded bending rigidity in the comb solver" ;
        dct:source "Moulton, Goriely & Chirat (2015) J. Theor. Biol. 364:420-430 Sec. 2-3 (hierarchical wavenumber law, local extension); Chirat, Moulton & Goriely (2013) PNAS 110:6015-6020 (spine wavelength vs mantle thickness across muricids)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9987db7d/2015-moulton-mollusc-aperture-spine-buckling.py#L1008-L1190>,
            <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/lean/loops/Loop_077_mollusc_aperture_spine_buckling.lean#L164-L188> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def spine_count_exponent_num (beta_num beta_den : Int) : Int :=
  4 * beta_den - 3 * beta_num
theorem ontogenetic_spine_count_conservation (beta_num beta_den : Int) :
    (spine_count_exponent_num beta_num beta_den = 0 ↔ 3 * beta_num = 4 * beta_den) ∧
    spine_count_exponent_num 4 3 = 0 ∧
    spine_count_exponent_num 1 1 = 1 ∧
    spine_count_exponent_num 3 2 = -1
"""^^pk:lean4 ;
        skos:notation "k^*(s) = (3 K_s / (E h(s)^3))^(1/4)  ⇒  λ(s) ∝ h(s)^(3/4),  h(s)/h̄ = (λ(s)/λ̄)^(4/3);  h_1 ∝ L^β  ⇒  N_1 = L / λ_1(h_1) ∝ L^(1 − 3β/4);  N_1 conserved across instars ⇔ β = 4/3" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2012.07.009>,
            <https://doi.org/10.1016/j.jtbi.2014.09.021>,
            <https://doi.org/10.1073/pnas.1220443110>,
            <https://doi.org/10.1209/0295-5075/83/10005>,
            <https://doi.org/10.1371/journal.pcbi.1007213> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Kirchhoff-Clebsch Elastica on Unilateral Foundation & Hierarchical Multi-Stage Mantle Spine Buckling" ;
        pk:leanDeclaration "MathOfBiology.Loop_077.spine_count_exponent_num" ;
        pk:leanTheorem "MathOfBiology.Loop_077.ontogenetic_spine_count_conservation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/murray-mammalian-coat-markings-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Thomas (1975) / Murray (1981) Homogeneous Steady-State Reservoir Flux Balance" ;
        dct:description "Pins the exact linear conservation relation v_0 = b - (a - u_0)/α reducing the 2D equilibrium intersection to a 1D root in u_0 | Variables: u_0, v_0: homogeneous steady-state substrate and co-substrate concentrations; a, b: reservoir concentrations; α: relative co-substrate influx; h(u,v): immobilized uricase reaction flux" ;
        dct:source "Murray (1981) J. Theor. Biol. 88(1):161-199 Eqs. (4)-(7); Thomas (1975) Biochimie 57:499-507" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L160-L254>,
            <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L20-L39> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def thomas_react_f (a u h : Int) : Int := (a - u) - h
def thomas_react_g (alpha_b_minus_v h : Int) : Int := alpha_b_minus_v - h
theorem thomas_steady_state_flux_balance (a u alpha_b_minus_v h : Int)
    (hf : thomas_react_f a u h = 0) (hg : thomas_react_g alpha_b_minus_v h = 0) :
    a - u = alpha_b_minus_v ∧ a - u = h := by
  unfold thomas_react_f at hf; unfold thomas_react_g at hg; omega
"""^^pk:lean4 ;
        skos:notation "f(u_0, v_0) = a - u_0 - h(u_0, v_0) = 0 ∧ g(u_0, v_0) = α(b - v_0) - h(u_0, v_0) = 0 ⟹ a - u_0 = α(b - v_0) = ρ u_0 v_0 / (1 + u_0 + K u_0^2)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BFb0082865>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1016/S0300-9084(75)80312-9>,
            <https://doi.org/10.1017/S0962492913000056>,
            <https://doi.org/10.1038/scientificamerican0388-80>,
            <https://doi.org/10.1080/10586458.1993.10504266>,
            <https://doi.org/10.1103/PhysRevE.74.011914>,
            <https://doi.org/10.1644/900.1> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
        pk:leanDeclaration "MathOfBiology.Loop_003.thomas_react_f" ;
        pk:leanTheorem "MathOfBiology.Loop_003.thomas_steady_state_flux_balance" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/murray-mammalian-coat-markings-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Thomas Substrate-Inhibition Autocatalysis Threshold (K u_0^2 > 1)" ;
        dct:description "Proves that non-inhibitory Michaelis-Menten kinetics (K=0) cannot self-activate (f_u < 0), whereas substrate inhibition K u_0^2 > 1 creates positive feedback f_u > 0 at Murray's Table 1 regime | Variables: K: substrate-inhibition constant; u_0, v_0: steady-state concentrations; ρ: maximum enzyme velocity; f_u = ∂f/∂u: self-activation Jacobian entry" ;
        dct:source "Murray (1981) J. Theor. Biol. 88(1):161-199 Section 2 Eqs. (8)-(14), Table 1" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L160-L254>,
            <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L46-L66> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def thomas_fu_scaled_num (denom_sq rho_v0 K_u0_sq : Int) : Int :=
  rho_v0 * (K_u0_sq - 1) - denom_sq
theorem thomas_substrate_inhibition_autocatalysis (denom_sq rho_v0 : Int)
    (hd : denom_sq ≥ 1) (hrv : rho_v0 ≥ 1) :
    thomas_fu_scaled_num denom_sq rho_v0 0 ≤ -2 ∧
    thomas_fu_scaled_num 441 172 10 = 1107 := by
  unfold thomas_fu_scaled_num; omega
"""^^pk:lean4 ;
        skos:notation "(1 + u_0 + K u_0^2)^2 f_u = ρ v_0 (K u_0^2 - 1) - (1 + u_0 + K u_0^2)^2 > 0  ⟹  K u_0^2 > 1" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BFb0082865>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1016/S0300-9084(75)80312-9>,
            <https://doi.org/10.1017/S0962492913000056>,
            <https://doi.org/10.1038/scientificamerican0388-80>,
            <https://doi.org/10.1080/10586458.1993.10504266>,
            <https://doi.org/10.1103/PhysRevE.74.011914>,
            <https://doi.org/10.1644/900.1> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
        pk:leanDeclaration "MathOfBiology.Loop_003.thomas_fu_scaled_num" ;
        pk:leanTheorem "MathOfBiology.Loop_003.thomas_substrate_inhibition_autocatalysis" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/murray-mammalian-coat-markings-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Murray (1981) Conical Tail Circumferential-to-Axial Eigenmode Exclusion Theorem" ;
        dct:description "Proves why a tapered mammalian tail transitions from 2D spots (m ≥ 1) at the broad proximal base to 1D transverse rings (m = 0) at the narrow distal tip, and never from rings at the base to spots at the tip | Variables: r(x): local tapered tail radius; L: tail length; n: axial mode number; m: circumferential mode number; [k_-^2, k_+^2]: unstable Turing wavenumber band" ;
        dct:source "Murray (1981) J. Theor. Biol. 88(1):161-199 Section 4 Eqs. (26)-(32), Figs. 9-12; Murray (1988) Sci. Am. 258(3):80-87" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L255-L330>,
            <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L73-L98> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def in_turing_band_r2 (q_min_10 q_max_10 q_ax_10 m r : Nat) : Bool :=
  decide (q_min_10 * r * r ≤ q_ax_10 * r * r + 10 * m * m ∧
          q_ax_10 * r * r + 10 * m * m ≤ q_max_10 * r * r)
theorem murray_conical_tail_spot_to_ring_transition :
    in_turing_band_r2 5 9 7 0 3 = true ∧
    in_turing_band_r2 5 9 7 1 3 = true ∧
    in_turing_band_r2 5 9 7 0 1 = true ∧
    in_turing_band_r2 5 9 7 1 1 = false ∧
    in_turing_band_r2 5 9 7 2 1 = false := by decide
"""^^pk:lean4 ;
        skos:notation "k_{n,m}^2(r) = (n π / L)^2 + (m / r)^2 ∈ [k_-^2 / γ, k_+^2 / γ];  r < r_crit = m √(γ / k_+^2) ⟹ m ≥ 1 damped, m = 0 rings unstable" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BFb0082865>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1016/S0300-9084(75)80312-9>,
            <https://doi.org/10.1017/S0962492913000056>,
            <https://doi.org/10.1038/scientificamerican0388-80>,
            <https://doi.org/10.1080/10586458.1993.10504266>,
            <https://doi.org/10.1103/PhysRevE.74.011914>,
            <https://doi.org/10.1644/900.1> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
        pk:leanDeclaration "MathOfBiology.Loop_003.in_turing_band_r2" ;
        pk:leanTheorem "MathOfBiology.Loop_003.murray_conical_tail_spot_to_ring_transition" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/murray-mammalian-coat-markings-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "P1 Surface-FEM Cotangent Laplace-Beltrami: Constants in the Kernel & Discrete Mass Conservation" ;
        dct:description "Guarantees the homogeneous Thomas steady state (u_0, v_0) is an exact discrete equilibrium on the curved felid body and that the IMEX surface diffusion step is conservative (zero-flux natural boundary), so every pattern seen on the FEM body is a Turing instability and not a discretisation source term | Variables: V, F: vertices and triangles of the body-of-revolution surface mesh; w_ij: half cotangent edge weight; K: stiffness matrix; M: lumped (Voronoi-area) mass matrix; Δ_S ≈ -M^{-1} K: discrete Laplace-Beltrami" ;
        dct:source "Dziuk (1988) Lecture Notes in Math. 1357:142-155; Pinkall & Polthier (1993) Exp. Math. 2(1):15-36; Dziuk & Elliott (2013) Acta Numerica 22:289-396" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L712-L781>,
            <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L110-L128> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def fem_cot_row (w_ij w_ik u_i u_j u_k : Int) : Int :=
  w_ij * (u_i - u_j) + w_ik * (u_i - u_k)
theorem fem_cotangent_laplacian_conserves_mass (w_ab w_bc w_ca u_a u_b u_c c : Int) :
    fem_cot_row w_ab w_ca c c c = 0 ∧
    fem_cot_row w_ab w_ca u_a u_b u_c
      + fem_cot_row w_ab w_bc u_b u_a u_c
      + fem_cot_row w_ca w_bc u_c u_a u_b = 0 := by
  unfold fem_cot_row
  simp only [Int.mul_sub]
  omega
"""^^pk:lean4 ;
        skos:notation "(K u)_i = Σ_j w_ij (u_i - u_j), w_ij = (cot α_ij + cot β_ij)/2  ⟹  K 1 = 0 ∧ 1ᵀ K u = 0  ⟹  Σ_i M_i u_i^{n+1} = Σ_i M_i u_i^n for (M + (dt/γ) K) u^{n+1} = M u^n" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BFb0082865>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1016/S0300-9084(75)80312-9>,
            <https://doi.org/10.1017/S0962492913000056>,
            <https://doi.org/10.1038/scientificamerican0388-80>,
            <https://doi.org/10.1080/10586458.1993.10504266>,
            <https://doi.org/10.1103/PhysRevE.74.011914>,
            <https://doi.org/10.1644/900.1> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
        pk:leanDeclaration "MathOfBiology.Loop_003.fem_cot_row" ;
        pk:leanTheorem "MathOfBiology.Loop_003.fem_cotangent_laplacian_conserves_mass" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/murray-mammalian-coat-markings-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Murray (1981) Full Circumferential Exclusion Radius r_excl = 1/k_+ (n = 0 Longitudinal-Stripe Mode)" ;
        dct:description "Corrects the Pass 2 fastest-mode criterion r_crit (which only tests q_ax = k_c): between r_excl and r_crit a tail still carries long-axial-wavelength m ≥ 1 modes, so pure transverse rings appear only where the circumference 2πr drops below λ_+. Numerically twinned by the implicit conical solver (ring zone starts at x_excl/L) and the FEM body (tail_exclusion_fraction vs measured ring onset) | Variables: r(x): local tail radius; m: circumferential mode number; n = 0: axially uniform (Neumann-admissible) mode; k_+: upper edge of the unstable band; λ_+ = 2π/k_+: shortest unstable wavelength; r_excl: radius below which only m = 0 rings remain" ;
        dct:source "Murray (1981) J. Theor. Biol. 88(1):161-199 Section 4 Eqs. (26)-(32); Murray (1988) Sci. Am. 258(3):80-87" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L255-L330>,
            <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L150-L157> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem murray_tail_full_exclusion_requires_circumference_below_lambda_plus :
    in_turing_band_r2 5 9 0 1 1 = false ∧
    in_turing_band_r2 5 9 7 0 1 = true ∧
    in_turing_band_r2 5 9 0 3 4 = true ∧
    in_turing_band_r2 5 9 0 3 3 = false ∧
    in_turing_band_r2 5 9 0 1 2 = false ∧
    in_turing_band_r2 5 9 4 1 2 = true := by
  decide
"""^^pk:lean4 ;
        skos:notation "k_{0,m}^2(r) = (m / r)^2 ≤ k_+^2 / γ unstable  ⟹  every m ≥ 1 excluded iff r < r_excl = m √(γ) / k_+ < r_crit = m √(γ / (k_+^2 - k_c^2));  2π r_excl = λ_+" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BFb0082865>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1016/S0300-9084(75)80312-9>,
            <https://doi.org/10.1017/S0962492913000056>,
            <https://doi.org/10.1038/scientificamerican0388-80>,
            <https://doi.org/10.1080/10586458.1993.10504266>,
            <https://doi.org/10.1103/PhysRevE.74.011914>,
            <https://doi.org/10.1644/900.1> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
        pk:leanDeclaration "MathOfBiology.Loop_003.in_turing_band_r2" ;
        pk:leanTheorem "MathOfBiology.Loop_003.murray_tail_full_exclusion_requires_circumference_below_lambda_plus" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/murray-vascular-cube-law-branching-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Murray (1926a) Poiseuille Viscous Power & Metabolic Volume Cost Functional" ;
        dct:description "Minimizes combined cardiac pumping work and metabolic cost of blood volume, yielding Q ∝ r^3 and constant wall shear stress τ_w = √(η b) across all vessel generations | Variables: r: vessel lumen radius; L: vessel segment length; Q: volumetric blood flow; η: blood dynamic viscosity; b: metabolic maintenance power per unit blood volume" ;
        dct:source "Murray (1926a) Proc. Natl. Acad. Sci. USA 12(3):207-214 Eqs. (1)-(6)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L119-L166>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_052_vascular_cube_law_branching.lean#L39-L57> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def murray_stationarity_residual (p_visc p_met : Int) : Int := 2 * p_met - 4 * p_visc
def murray_total_power (p_visc p_met : Int) : Int := p_visc + p_met
theorem murray_stationarity_viscous_twice_metabolic (p_visc : Int) :
    murray_stationarity_residual p_visc (2 * p_visc) = 0 ∧
    murray_total_power p_visc (2 * p_visc) = 3 * p_visc := by
  simp [murray_stationarity_residual, murray_total_power]; omega
"""^^pk:lean4 ;
        skos:notation "P(r) = (8 η L Q^2) / (π r^4) + b π r^2 L,   ∂P/∂r = 0 ⟹ Q = (π/4)√(b/η) r^3 ∧ P_met(r_*) = 2 P_visc(r_*)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(76)90058-8>,
            <https://doi.org/10.1016/S0161-6420(99)90525-0>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1085/jgp.78.4.431>,
            <https://doi.org/10.1085/jgp.9.6.835>,
            <https://doi.org/10.1152/ajpheart.1992.263.6.H1770>,
            <https://doi.org/10.1152/ajplegacy.1931.96.3.562> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Minimum-Work Vascular Bifurcation Law & Poiseuille-Metabolic Variational Calculus" ;
        pk:leanDeclaration "MathOfBiology.Loop_052.murray_stationarity_residual" ;
        pk:leanTheorem "MathOfBiology.Loop_052.murray_stationarity_viscous_twice_metabolic" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/murray-vascular-cube-law-branching-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Murray (1926a) Cubic Radius Conservation & Generational Tree Invariance" ;
        dct:description "Governs daughter radius reduction r_1/r_0 = 2^{-1/3} ≈ 0.7937 and cross-sectional area expansion β = (r_1^2 + r_2^2)/r_0^2 = 2^{1/3} ≈ 1.2599 across arterial trees | Variables: r_0: parent artery radius; r_1, r_2: daughter branch radii; k_M = (π/4)√(b/η): Murray hydraulic-metabolic conductance constant" ;
        dct:source "Murray (1926a) Proc. Natl. Acad. Sci. USA 12(3):207-214; Sherman (1981) J. Gen. Physiol. 78(4):431-453" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L303-L397>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_052_vascular_cube_law_branching.lean#L62-L87> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def vessel_cube (r : Nat) : Nat := r * r * r
def murray_flow (k_M r : Nat) : Nat := k_M * vessel_cube r
theorem murray_cube_law_generational_invariance
    (k_M r1 r2 c0 c1 c2 c11 c12 c21 c22 : Nat)
    (h_gen1 : c0 = c1 + c2) (h_left : c1 = c11 + c12) (h_right : c2 = c21 + c22) :
    murray_flow k_M r1 + murray_flow k_M r2 = k_M * (vessel_cube r1 + vessel_cube r2) ∧
    c0 = c11 + c12 + c21 + c22 := by
  constructor
  · simp [murray_flow, Nat.left_distrib]
  · omega
"""^^pk:lean4 ;
        skos:notation "Q_0 = Q_1 + Q_2 ∧ Q_i = k_M r_i^3 ⟹ r_0^3 = r_1^3 + r_2^3 = ∑_{k ∈ leaves(T)} r_k^3" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(76)90058-8>,
            <https://doi.org/10.1016/S0161-6420(99)90525-0>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1085/jgp.78.4.431>,
            <https://doi.org/10.1085/jgp.9.6.835>,
            <https://doi.org/10.1152/ajpheart.1992.263.6.H1770>,
            <https://doi.org/10.1152/ajplegacy.1931.96.3.562> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Minimum-Work Vascular Bifurcation Law & Poiseuille-Metabolic Variational Calculus" ;
        pk:leanDeclaration "MathOfBiology.Loop_052.murray_flow" ;
        pk:leanTheorem "MathOfBiology.Loop_052.murray_cube_law_generational_invariance" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/murray-vascular-cube-law-branching-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Murray (1926b) Optimal Arterial Bifurcation Angle Cosine Law" ;
        dct:description "Determines optimal Y-junction branching geometry minimizing combined viscous + volume cost; predicts θ_1 = θ_2 = 37.47° (total 74.93°) for symmetric bifurcations and wider deflection for smaller side branches | Variables: θ_1, θ_2: daughter deflection angles relative to parent vessel axis; α = r_2/r_1 ∈ (0,1]: daughter radius asymmetry ratio" ;
        dct:source "Murray (1926b) J. Gen. Physiol. 9(6):835-841 Eqs. (3)-(6); Zamir (1976) J. Theor. Biol. 62(1):227-251" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L175-L300>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_052_vascular_cube_law_branching.lean#L91-L118> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def pow4 (r : Int) : Int := r * r * r * r
def murray_cos_num1 (r0 r1 r2 : Int) : Int := pow4 r0 + pow4 r1 - pow4 r2
def murray_cos_num2 (r0 r1 r2 : Int) : Int := pow4 r0 + pow4 r2 - pow4 r1
theorem murray_bifurcation_cosine_symmetry (r0 r1 r2 r : Int) :
    murray_cos_num1 r0 r1 r2 + murray_cos_num2 r0 r1 r2 = 2 * pow4 r0 ∧
    murray_cos_num1 r0 r r = pow4 r0 ∧
    murray_cos_num2 r0 r r = pow4 r0 := by
  simp [murray_cos_num1, murray_cos_num2]; omega
"""^^pk:lean4 ;
        skos:notation "cos(θ_1) = (r_0^4 + r_1^4 - r_2^4) / (2 r_0^2 r_1^2),  cos(θ_2) = (r_0^4 + r_2^4 - r_1^4) / (2 r_0^2 r_2^2),  θ_1 + θ_2|_{r_1=r_2} = arccos(2^{1/3} - 1) = 74.93°" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(76)90058-8>,
            <https://doi.org/10.1016/S0161-6420(99)90525-0>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1085/jgp.78.4.431>,
            <https://doi.org/10.1085/jgp.9.6.835>,
            <https://doi.org/10.1152/ajpheart.1992.263.6.H1770>,
            <https://doi.org/10.1152/ajplegacy.1931.96.3.562> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Minimum-Work Vascular Bifurcation Law & Poiseuille-Metabolic Variational Calculus" ;
        pk:leanDeclaration "MathOfBiology.Loop_052.murray_cos_num1" ;
        pk:leanTheorem "MathOfBiology.Loop_052.murray_bifurcation_cosine_symmetry" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/murray-vascular-cube-law-branching-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Fahraeus-Lindqvist Radius-Dependent Viscosity & Generalised Murray Stationarity Shift (Pass 3)" ;
        dct:description "Quantifies the non-Newtonian shift of the optimal branching exponent: 7-generation tree optimum moves from γ* = 3.000 (Newtonian) to γ* ≈ 2.773 (F-L), symmetric junction exponent γ_j(25 µm) ≈ 2.86, metabolic share at optimum falls below 2 P_visc | Variables: η(r): apparent blood viscosity at lumen radius r (Pries 1992 fit, H_D = 0.45); ε: logarithmic viscosity sensitivity; P_visc, P_met: Poiseuille and metabolic power" ;
        dct:source "Pries, Neuhaus & Gaehtgens (1992) Am. J. Physiol. 263(6):H1770-H1778 Eq. (1); Fahraeus & Lindqvist (1931) Am. J. Physiol. 96:562-568; Murray (1926a)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L445-L636>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_052_vascular_cube_law_branching.lean#L122-L150> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def fl_stationarity_residual (p_visc p_met eps : Int) : Int := 2 * p_met - (4 - eps) * p_visc
theorem fahraeus_lindqvist_stationarity_shift (p_visc p_met eps : Int)
    (h_fl : 0 < eps) (h_pos : 0 < p_visc) :
    fl_stationarity_residual p_visc p_met 0 = murray_stationarity_residual p_visc p_met ∧
    fl_stationarity_residual (2 * p_visc) ((4 - eps) * p_visc) eps = 0 ∧
    (4 - eps) * p_visc < 4 * p_visc := by
  refine ⟨?_, ?_, ?_⟩
  · simp [fl_stationarity_residual, murray_stationarity_residual]
  · show 2 * ((4 - eps) * p_visc) - (4 - eps) * (2 * p_visc) = 0
    rw [Int.mul_left_comm]; exact Int.sub_self _
  · exact Int.mul_lt_mul_of_pos_right (by omega) h_pos
"""^^pk:lean4 ;
        skos:notation "P(r) = 8 L Q^2 η(r)/(π r^4) + b π r^2 L,  ε = d ln η / d ln r  ⟹  2 P_met(r*) = (4 − ε) P_visc(r*),  Q*(r) = (π/2) r^3 √(b / (η(r)(4 − ε))),  γ_eff = d ln Q*/d ln r < 3 for ε > 0;  η_rel(D) = 220 e^{−1.3D} + 3.2 − 2.44 e^{−0.06 D^0.645}" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(76)90058-8>,
            <https://doi.org/10.1016/S0161-6420(99)90525-0>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1085/jgp.78.4.431>,
            <https://doi.org/10.1085/jgp.9.6.835>,
            <https://doi.org/10.1152/ajpheart.1992.263.6.H1770>,
            <https://doi.org/10.1152/ajplegacy.1931.96.3.562> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Minimum-Work Vascular Bifurcation Law & Poiseuille-Metabolic Variational Calculus" ;
        pk:leanDeclaration "MathOfBiology.Loop_052.fl_stationarity_residual" ;
        pk:leanTheorem "MathOfBiology.Loop_052.fahraeus_lindqvist_stationarity_shift" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/murray-vascular-cube-law-branching-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Coupled Arteriovenous Cube Balance on the Hemispherical Retinal Cup (Pass 3)" ;
        dct:description "Couples the venous Murray tree to the arterial tree on the curved retina (AVR = 0.67 ⟹ k_v/k_a ≈ 0.30, venous wall shear ≈ 2.47 dyn/cm²) and realises Murray angles as true geodesic angles, enabling the fundus-projection foreshortening measurement | Variables: k_a, k_v: arterial/venous Murray conductance constants (π/4)√(b/η); C_a, C_v: terminal cubic radius sums; R = 12 mm globe radius; p, t: sphere point and unit tangent; θ: Murray (1926b) tangent-plane bifurcation angle" ;
        dct:source "Murray (1926a) PNAS 12:207-214; Hubbard et al. (1999) Ophthalmology 106(12):2269-2280 (AVR ~ 2/3); schematic emmetropic eye (axial length ~24 mm)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L639-L890>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_052_vascular_cube_law_branching.lean#L154-L171> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem arteriovenous_coupled_cube_balance (k_a k_v C_a C_v : Nat)
    (h_flow : k_a * C_a = k_v * C_v) (h_k : k_v < k_a) (h_pos : 0 < C_a) :
    C_a < C_v := by
  have h1 : k_v * C_a < k_a * C_a := Nat.mul_lt_mul_of_pos_right h_k h_pos
  rw [h_flow] at h1
  exact Nat.lt_of_mul_lt_mul_left h1
"""^^pk:lean4 ;
        skos:notation "Q_a = Q_v ∧ Q_a = k_a Σ r_tip^3 ∧ Q_v = k_v Σ R_tip^3 ∧ k_v < k_a  ⟹  Σ r_tip^3 < Σ R_tip^3;  geodesic step p' = p cos(s/R) + R t sin(s/R), t' = −(p/R) sin(s/R) + t cos(s/R);  t_rot = t cos θ + (n × t) sin θ" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(76)90058-8>,
            <https://doi.org/10.1016/S0161-6420(99)90525-0>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1085/jgp.78.4.431>,
            <https://doi.org/10.1085/jgp.9.6.835>,
            <https://doi.org/10.1152/ajpheart.1992.263.6.H1770>,
            <https://doi.org/10.1152/ajplegacy.1931.96.3.562> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Minimum-Work Vascular Bifurcation Law & Poiseuille-Metabolic Variational Calculus" ;
        pk:leanDeclaration "MathOfBiology.Loop_052.arteriovenous_coupled_cube_balance" ;
        pk:leanTheorem "MathOfBiology.Loop_052.arteriovenous_coupled_cube_balance" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/nakamasu-zebrafish-three-cell-stripes-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Nakamasu (2009) Short-Range Melanophore-Xanthophore Mutual Repulsion Saddle Instability" ;
        dct:description "Proves that two mutually repressing pigment cell populations form an effective local positive-feedback switch (det J_uv = -1.61 < 0, lambda_anti = +0.70 > 0) without requiring direct single-cell autocatalysis | Variables: u: melanophore density; v: xanthophore density; c_u, c_v: intrinsic clearance rates; b_u = -r_u < 0, a_v = -r_v < 0: short-range contact-mediated mutual repression rates" ;
        dct:source "Nakamasu et al. (2009) PNAS 106(21):8429-8434 Fig. 4D & SI Text Eqs. (1)-(6)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L112-L195>,
            <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_007_zebrafish_three_cell_stripes.lean#L19-L47> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def short_range_det_uv (cu cv ru rv : Int) : Int := cu * cv - ru * rv
def anti_phase_growth_rate (cu ru : Int) : Int := ru - cu
theorem nakamasu_short_range_mutual_repulsion_instability (cu cv : Int)
    (hcu : cu ≥ 1) (hcv : cv ≥ 1) :
    short_range_det_uv cu cv 0 0 ≥ 1 ∧
    short_range_det_uv 8 8 15 15 = -161 ∧
    anti_phase_growth_rate 8 15 = 7 := by
  unfold short_range_det_uv anti_phase_growth_rate
  refine ⟨?_, by decide, by decide⟩
  have h1 : (1 : Int) * 1 ≤ cu * cv := Int.mul_le_mul hcu hcv (by decide) (by omega)
  omega
"""^^pk:lean4 ;
        skos:notation "det(J_{uv}) = c_u c_v - b_u a_v < 0  ∧  λ_{anti} = |b_u| - c_u > 0  when  |b_u|, |a_v| > c_u, c_v" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.22113>,
            <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1038/ncb2955>,
            <https://doi.org/10.1038/s41467-018-05629-z>,
            <https://doi.org/10.1038/sj.embor.7400757>,
            <https://doi.org/10.1073/pnas.0607790104>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rsif.2015.0812>,
            <https://doi.org/10.1126/science.1212821>,
            <https://doi.org/10.1242/dev.096719>,
            <https://doi.org/10.1371/journal.pgen.1003561> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Cell-Cell Contact Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_007.short_range_det_uv" ;
        pk:leanTheorem "MathOfBiology.Loop_007.nakamasu_short_range_mutual_repulsion_instability" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/nakamasu-zebrafish-three-cell-stripes-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Long-Range Xanthophore->Melanophore Survival Factor Routh-Hurwitz Homogeneous Stabilization" ;
        dct:description "Proves that the long-range xanthophore-to-melanophore survival pathway v -> w -> u stabilizes the homogeneous 3-cell equilibrium at k = 0 despite the local (u, v) saddle instability | Variables: w: long-range diffusible factor secreted by xanthophores (b_w = 1.20 > 0) promoting melanophore survival (d_u = 1.20 > 0); p_1, p_2, p_3: Routh-Hurwitz cubic coefficients of J_0" ;
        dct:source "Nakamasu et al. (2009) PNAS 106(21):8429-8434 Figs. 2, 4D & SI Text" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L125-L210>,
            <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_007_zebrafish_three_cell_stripes.lean#L54-L78> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem nakamasu_long_range_factor_routh_hurwitz_stabilization :
    routh_hurwitz_p1 8 8 9 = 25 ∧
    routh_hurwitz_p2 8 8 9 (-15) 12 (-15) (-6) (-9) 12 = 163 ∧
    routh_hurwitz_p3 8 8 9 (-15) 12 (-15) (-6) (-9) 12 = 2961 ∧
    (routh_hurwitz_p1 8 8 9) * (routh_hurwitz_p2 8 8 9 (-15) 12 (-15) (-6) (-9) 12)
      - (routh_hurwitz_p3 8 8 9 (-15) 12 (-15) (-6) (-9) 12) = 1114 := by decide
"""^^pk:lean4 ;
        skos:notation "p_1 = -tr(J_0) = 2.50 > 0,  p_2 = 1.63 > 0,  p_3 = -det(J_0) = 2.961 > 0,  p_1 p_2 - p_3 = 1.114 > 0  ⟹  Re λ(J_0) < 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.22113>,
            <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1038/ncb2955>,
            <https://doi.org/10.1038/s41467-018-05629-z>,
            <https://doi.org/10.1038/sj.embor.7400757>,
            <https://doi.org/10.1073/pnas.0607790104>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rsif.2015.0812>,
            <https://doi.org/10.1126/science.1212821>,
            <https://doi.org/10.1242/dev.096719>,
            <https://doi.org/10.1371/journal.pgen.1003561> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Cell-Cell Contact Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_007.routh_hurwitz_p3" ;
        pk:leanTheorem "MathOfBiology.Loop_007.nakamasu_long_range_factor_routh_hurwitz_stabilization" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/nakamasu-zebrafish-three-cell-stripes-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Fast-Diffusing Long-Range Factor (D_w ≫ D_u, D_v) Bounded Turing Stripe Instability Theorem" ;
        dct:description "Proves that differential long-range signaling range D_w / D_u = 25 opens a finite stationary Turing band around k_c = 3.4106 (lambda_c = 1.8423), while equal diffusion quenches pattern formation | Variables: q = k^2: squared spatial wavenumber; D_u = D_v = 0.02: short-range pigment cell motility/projection scale; D_w = 0.50: long-range factor diffusivity" ;
        dct:source "Nakamasu et al. (2009) PNAS 106(21):8429-8434 Fig. 5 & SI Text" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L155-L235>,
            <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_007_zebrafish_three_cell_stripes.lean#L85-L120> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem nakamasu_diffusive_turing_band_and_ablation_collapse :
    p3_dispersive 0 2 2 50 = 2961000 ∧
    p3_dispersive 12 2 2 50 = -3219960 ∧
    p3_dispersive 35 2 2 50 = 5670000 ∧
    p3_dispersive 12 2 2 2 = 3510024 := by decide
"""^^pk:lean4 ;
        skos:notation "p_3(q) = -det(J_0 - q D) < 0  for  q = k^2 ∈ (4.4663, 28.8036)  at  D_w / D_u = 25,  whereas  p_3(q) > 0  for all  q ≥ 0  at  D_w = D_u = D_v" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.22113>,
            <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1038/ncb2955>,
            <https://doi.org/10.1038/s41467-018-05629-z>,
            <https://doi.org/10.1038/sj.embor.7400757>,
            <https://doi.org/10.1073/pnas.0607790104>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rsif.2015.0812>,
            <https://doi.org/10.1126/science.1212821>,
            <https://doi.org/10.1242/dev.096719>,
            <https://doi.org/10.1371/journal.pgen.1003561> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Cell-Cell Contact Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_007.p3_dispersive" ;
        pk:leanTheorem "MathOfBiology.Loop_007.nakamasu_diffusive_turing_band_and_ablation_collapse" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/nakamasu-zebrafish-three-cell-stripes-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Growing-Domain Neumann Mode Insertion Across the Nakamasu Turing Band" ;
        dct:description "Explains why the 2-stripe juvenile pattern (1D, 1V around X0) cannot persist as a single mode on the adult flank and must insert new stripes (X1D/2D, X1V/2V) during growth; parity-checked in self_test check 9 and the hybrid ontogeny record | Variables: n: Neumann cosine mode index (n half-waves ≈ n/2 dark stripes); L: dorsoventral flank height (3.68 juvenile at SL 7.2 mm, 9.2 adult at SL 18 mm); integer scalings k×1e4, π×1e5, L×10" ;
        dct:source "Nakamasu et al. (2009) Fig. 5 band; Crampin, Gaffney & Maini (1999) Bull Math Biol 61:1093 (growing-domain mode insertion); Parichy et al. (2009) Dev Dyn 238:2975 stage anchors" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L612-L621>,
            <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_007_zebrafish_three_cell_stripes.lean#L144-L173> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def mode_in_turing_band (n L10 : Int) : Bool :=
  decide (21134 * L10 ≤ n * 314159 ∧ n * 314159 ≤ 53669 * L10)
theorem nakamasu_growing_domain_stripe_insertion :
    mode_in_turing_band 4 37 = true ∧ mode_in_turing_band 10 37 = false ∧
    mode_in_turing_band 4 92 = false ∧ mode_in_turing_band 6 92 = false ∧
    mode_in_turing_band 7 92 = true ∧ mode_in_turing_band 10 92 = true ∧
    mode_in_turing_band 15 92 = true ∧ mode_in_turing_band 16 92 = false := by decide
theorem mode_in_turing_band_scales (n L10 : Int) :
    mode_in_turing_band (2 * n) (2 * L10) = mode_in_turing_band n L10
"""^^pk:lean4 ;
        skos:notation "mode cos(n π y / L) ∈ Turing band ⟺ k_min L ≤ n π ≤ k_max L, k ∈ [2.1134, 5.3669];  L = 3.68: n ∈ [3, 6] (n = 4 ↔ 2 stripes);  L = 9.2: n ∈ [7, 15] (n = 10 ↔ 5 stripes);  no n is admissible at both sizes ⟹ isometric growth forces stripe insertion" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.22113>,
            <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1038/ncb2955>,
            <https://doi.org/10.1038/s41467-018-05629-z>,
            <https://doi.org/10.1038/sj.embor.7400757>,
            <https://doi.org/10.1073/pnas.0607790104>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rsif.2015.0812>,
            <https://doi.org/10.1126/science.1212821>,
            <https://doi.org/10.1242/dev.096719>,
            <https://doi.org/10.1371/journal.pgen.1003561> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Cell-Cell Contact Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_007.mode_in_turing_band" ;
        pk:leanTheorem "MathOfBiology.Loop_007.nakamasu_growing_domain_stripe_insertion" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/nakamasu-zebrafish-three-cell-stripes-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Growth Dilution Preserves Routh-Hurwitz Homogeneous Stability and the Short-Range Saddle" ;
        dct:description "Shows the growing-domain correction (Crampin-Gaffney-Maini 1999) used by the hybrid solver cannot destabilize the homogeneous state nor remove the local (u, v) saddle that drives segregation; parity-checked in self_test check 10 via compute_nakamasu_theory(c_u=0.9, c_v=0.9, c_w=1.0) | Variables: r = 2 g'/g: dilution rate of a uniformly (isotropically) growing 2D domain; the script's maximum is 2·(0.6/153.6)/0.4 = 0.0195 ≪ 0.1; c_u, c_v, c_w each shifted by r" ;
        dct:source "Crampin, Gaffney & Maini (1999) Bull Math Biol 61:1093-1120; Nakamasu et al. (2009) SI Text" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L778-L786>,
            <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_007_zebrafish_three_cell_stripes.lean#L176-L205> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem nakamasu_growth_dilution_preserves_routh_hurwitz :
    routh_hurwitz_p1 9 9 10 = 28 ∧
    routh_hurwitz_p2 9 9 10 (-15) 12 (-15) (-6) (-9) 12 = 216 ∧
    routh_hurwitz_p3 9 9 10 (-15) 12 (-15) (-6) (-9) 12 = 3150 ∧
    (routh_hurwitz_p1 9 9 10) * (routh_hurwitz_p2 9 9 10 (-15) 12 (-15) (-6) (-9) 12)
      - (routh_hurwitz_p3 9 9 10 (-15) 12 (-15) (-6) (-9) 12) = 2898 ∧
    short_range_det_uv 9 9 15 15 = -144 := by decide
theorem dilution_raises_p1 (cu cv cw r : Int) (hr : r ≥ 0) :
    routh_hurwitz_p1 (cu + r) (cv + r) (cw + r) = routh_hurwitz_p1 cu cv cw + 3 * r ∧
    routh_hurwitz_p1 (cu + r) (cv + r) (cw + r) ≥ routh_hurwitz_p1 cu cv cw
"""^^pk:lean4 ;
        skos:notation "Lagrangian growing-domain Jacobian J0 − r I, r = 2 g'/g ≥ 0 (isotropic dilution): at r = 0.1, p1 = 2.80 > 0, p2 = 2.16 > 0, p3 = 3.150 > 0, p1 p2 − p3 = 2.898 > 0, det(J_uv) = 0.81 − 2.25 = −1.44 < 0;  p1(r) = p1(0) + 3r" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.22113>,
            <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1038/ncb2955>,
            <https://doi.org/10.1038/s41467-018-05629-z>,
            <https://doi.org/10.1038/sj.embor.7400757>,
            <https://doi.org/10.1073/pnas.0607790104>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rsif.2015.0812>,
            <https://doi.org/10.1126/science.1212821>,
            <https://doi.org/10.1242/dev.096719>,
            <https://doi.org/10.1371/journal.pgen.1003561> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Cell-Cell Contact Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_007.routh_hurwitz_p1" ;
        pk:leanTheorem "MathOfBiology.Loop_007.nakamasu_growth_dilution_preserves_routh_hurwitz" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/nakamasu-zebrafish-three-cell-stripes-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "Iridophore Dense<->Loose Switching Rule Is Exclusive and Conserves Agents" ;
        dct:description "Formalizes the reduced Volkening & Sandstede (2018) shape-transition rule used for every agent update: a cell never receives contradictory instructions and switching never creates or destroys iridophores (only proliferation does); parity-checked in self_test check 13 | Variables: d = u − v: local melanophore excess at the agent position; θ = 0.10: switching threshold; s, l: dense/loose agent counts; a, b: S→L and L→S events per step" ;
        dct:source "Volkening & Sandstede (2018) Nat Commun 9:3231 (iridophore S/L transitions); Singh et al. (2014) Nat Cell Biol 16:607; Frohnhoefer et al. (2013) Development 140:2997" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L802-L812>,
            <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_007_zebrafish_three_cell_stripes.lean#L208-L231> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def switch_S_to_L (d θ : Int) : Bool := decide (d > θ)
def switch_L_to_S (d θ : Int) : Bool := decide (-d > θ)
theorem iridophore_switch_exclusive_and_conservative (d θ s l a b : Int) (hθ : θ ≥ 0) :
    ¬ (switch_S_to_L d θ = true ∧ switch_L_to_S d θ = true) ∧
    (s - a + b) + (l + a - b) = s + l
"""^^pk:lean4 ;
        skos:notation "S→L iff u − v > θ;  L→S iff v − u > θ;  θ ≥ 0 ⟹ ¬(S→L ∧ L→S);  (s − a + b) + (l + a − b) = s + l" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.22113>,
            <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1038/ncb2955>,
            <https://doi.org/10.1038/s41467-018-05629-z>,
            <https://doi.org/10.1038/sj.embor.7400757>,
            <https://doi.org/10.1073/pnas.0607790104>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rsif.2015.0812>,
            <https://doi.org/10.1126/science.1212821>,
            <https://doi.org/10.1242/dev.096719>,
            <https://doi.org/10.1371/journal.pgen.1003561> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Cell-Cell Contact Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_007.switch_S_to_L" ;
        pk:leanTheorem "MathOfBiology.Loop_007.iridophore_switch_exclusive_and_conservative" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/nelson-airway-mucosal-creasing-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Cylindrical Bilayer Mucosal Buckling Wavenumber & Inverse Thickness Scaling Law" ;
        dct:description "Determines why thin healthy bronchioles buckle into many shallow rosette folds (m* ≈ 14) whereas thickened asthmatic airways buckle into a few deep folds (m* ≈ 5–6) | Variables: R_0: inner luminal radius; h_m: epithelial/basement-membrane mucosal thickness; μ_m, μ_s: mucosal and submucosal shear moduli; m*: circumferential rosette fold number" ;
        dct:source "Li, Cao, Feng & Gao (2011) J. Mech. Phys. Solids 59:758-774 Eq. (18); Eskandari, Pfaller & Kuhl (2015) J. Theor. Biol. 403:209-218 Eq. (14)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L204-L223>,
            <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_068_airway_mucosal_creasing.lean#L32-L46> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def scaled_fold_mode_normal (c_geom h0 dh : Nat) : Nat :=
  (c_geom + 1) * (h0 + dh + 2)
def scaled_fold_mode_asthma (c_geom h0 : Nat) : Nat :=
  (c_geom + 1) * (h0 + 1)
theorem inverse_mucosal_thickness_fold_scaling (c_geom h0 dh : Nat) :
    (h0 + 1) < (h0 + dh + 2) ∧
    scaled_fold_mode_asthma c_geom h0 < scaled_fold_mode_normal c_geom h0 dh
"""^^pk:lean4 ;
        skos:notation "λ_c = 2π h_m (μ_m / (3 μ_s))^(1/3),  m* = (R_0 / h_m) (3 μ_s / μ_m)^(1/3)  ⇒  h_asthma > h_normal ⟹ m*_asthma < m*_normal" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-3-642-87553-3>,
            <https://doi.org/10.1016/0034-5687(70)90094-0>,
            <https://doi.org/10.1016/j.jmps.2011.01.010>,
            <https://doi.org/10.1016/j.jtbi.2016.05.022>,
            <https://doi.org/10.1038/nature03490>,
            <https://doi.org/10.1115/1.4004128>,
            <https://doi.org/10.1152/jappl.1967.22.3.395>,
            <https://doi.org/10.1152/jappl.1997.83.6.1814>,
            <https://doi.org/10.1164/ajrccm/145.6.1251> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Cylindrical Neo-Hookean Bilayer Morphoelastic Buckling, Post-Buckling Period-Doubling & Sulcal Creasing Driving Hagen–Poiseuille Airway Resistance, Coupled to a Dichotomous Bronchial-Tree Impedance Network with Flow–Stretch Feedback" ;
        pk:leanDeclaration "MathOfBiology.Loop_068.scaled_fold_mode_normal" ;
        pk:leanTheorem "MathOfBiology.Loop_068.inverse_mucosal_thickness_fold_scaling" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/nelson-airway-mucosal-creasing-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Inextensible Mucosal Perimeter Fold-Depth & Lumen-Area Occlusion Law" ;
        dct:description "Proves that at identical smooth-muscle shortening ε_θ, lower circumferential mode number m forces deeper inward fold intrusion and smaller open luminal area | Variables: P_0 = 2π R_0: inextensible mucosal perimeter; ε_θ: ASM circumferential shortening strain; m: integer fold mode number; A_lumen: open luminal cross-sectional area" ;
        dct:source "Wiggs, Hrousis, Drazen & Kamm (1997) J. Appl. Physiol. 83:1814-1821 Eqs. (2)-(6); Jin, Auguste, Hayward & Suo (2011) J. Appl. Mech. 78:031009" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L282-L486>,
            <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_068_airway_mucosal_creasing.lean#L62-L81> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def fold_occlusion_penalty_scaled (k_fold m_other : Nat) : Nat :=
  (k_fold + 1) * m_other
def open_lumen_area_scaled (a_net k_fold m_self m_other : Nat) : Int :=
  (a_net : Int) - ↑((k_fold + 1) * m_other) + 0 * (m_self : Int)
theorem inextensible_perimeter_lumen_occlusion (a_net k_fold m0 dm : Nat) :
    fold_occlusion_penalty_scaled k_fold (m0 + 1) <
      fold_occlusion_penalty_scaled k_fold (m0 + dm + 2) ∧
    open_lumen_area_scaled a_net k_fold (m0 + 1) (m0 + dm + 2) <
      open_lumen_area_scaled a_net k_fold (m0 + dm + 2) (m0 + 1)
"""^^pk:lean4 ;
        skos:notation "A_lumen(ε_θ, m) = A_ASM(ε_θ) - A_wall - (P_0^2 Δ_fold(ε_θ)) / (8π m)  ⇒  m_asthma < m_normal ⟹ A_lumen(m_asthma) < A_lumen(m_normal)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-3-642-87553-3>,
            <https://doi.org/10.1016/0034-5687(70)90094-0>,
            <https://doi.org/10.1016/j.jmps.2011.01.010>,
            <https://doi.org/10.1016/j.jtbi.2016.05.022>,
            <https://doi.org/10.1038/nature03490>,
            <https://doi.org/10.1115/1.4004128>,
            <https://doi.org/10.1152/jappl.1967.22.3.395>,
            <https://doi.org/10.1152/jappl.1997.83.6.1814>,
            <https://doi.org/10.1164/ajrccm/145.6.1251> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Cylindrical Neo-Hookean Bilayer Morphoelastic Buckling, Post-Buckling Period-Doubling & Sulcal Creasing Driving Hagen–Poiseuille Airway Resistance, Coupled to a Dichotomous Bronchial-Tree Impedance Network with Flow–Stretch Feedback" ;
        pk:leanDeclaration "MathOfBiology.Loop_068.open_lumen_area_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_068.inextensible_perimeter_lumen_occlusion" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/nelson-airway-mucosal-creasing-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hagen–Poiseuille Quadratic Lumen-Area Airway Resistance Amplification Law" ;
        dct:description "Governs the catastrophic (>15-fold) surge in airflow resistance during asthmatic bronchoconstriction due to period-doubling and deep mucosal creasing | Variables: R_flow: laminar Hagen–Poiseuille airway resistance; A_0 = π R_0^2: relaxed baseline lumen area; A_asthma, A_normal: constricted lumen areas" ;
        dct:source "Wiggs, Hrousis, Drazen & Kamm (1997) J. Appl. Physiol. 83:1814-1821 Eq. (7)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L225-L243>,
            <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_068_airway_mucosal_creasing.lean#L96-L106> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def poiseuille_conductance_sq (a_lumen : Nat) : Nat :=
  a_lumen * a_lumen
theorem poiseuille_quadratic_area_resistance_amplification (a0 da : Nat) :
    (a0 + 1) < (a0 + da + 2) ∧
    poiseuille_conductance_sq (a0 + 1) < poiseuille_conductance_sq (a0 + da + 2)
"""^^pk:lean4 ;
        skos:notation "R_flow / R_flow,0 = (A_0 / A_lumen)^2  ⇒  0 < A_asthma < A_normal ⟹ R_flow,asthma > R_flow,normal" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-3-642-87553-3>,
            <https://doi.org/10.1016/0034-5687(70)90094-0>,
            <https://doi.org/10.1016/j.jmps.2011.01.010>,
            <https://doi.org/10.1016/j.jtbi.2016.05.022>,
            <https://doi.org/10.1038/nature03490>,
            <https://doi.org/10.1115/1.4004128>,
            <https://doi.org/10.1152/jappl.1967.22.3.395>,
            <https://doi.org/10.1152/jappl.1997.83.6.1814>,
            <https://doi.org/10.1164/ajrccm/145.6.1251> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Cylindrical Neo-Hookean Bilayer Morphoelastic Buckling, Post-Buckling Period-Doubling & Sulcal Creasing Driving Hagen–Poiseuille Airway Resistance, Coupled to a Dichotomous Bronchial-Tree Impedance Network with Flow–Stretch Feedback" ;
        pk:leanDeclaration "MathOfBiology.Loop_068.poiseuille_conductance_sq" ;
        pk:leanTheorem "MathOfBiology.Loop_068.poiseuille_quadratic_area_resistance_amplification" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/nelson-airway-mucosal-creasing-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Series–Parallel Bifurcation Impedance Homogeneous Scaling Law (Pass 3)" ;
        dct:description "Couples the 1D ring law to the 3D bronchial tree: proves that the exact series–parallel network reduces to the single-airway Poiseuille ratio when constriction is homogeneous, giving the identity check (1.000000 to 1e-9) against which heterogeneous ventilation defects are measured | Variables: R_i: Hagen–Poiseuille resistance of branch i (Weibel 1963 model A diameter d_i, length L_i, air viscosity η = 1.81e-5 Pa s); k = (A_0/A_lumen)^2: Law-3 single-airway amplification; R_sub: subtree impedance; R_tree: whole-tree resistance" ;
        dct:source "Weibel ER (1963) Morphometry of the Human Lung, Springer (10.1007/978-3-642-87553-3); Wiggs BR, Bosken C, Paré PD, James A, Hogg JC (1992) Am Rev Respir Dis 145:1251-1258 (10.1164/ajrccm/145.6.1251); Macklem PT & Mead J (1967) J Appl Physiol 22:395-401" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L794-L823>,
            <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_068_airway_mucosal_creasing.lean#L124-L138> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def bifurcation_subtree_num (rp ra rb : Nat) : Nat :=
  rp * (ra + rb) + ra * rb
def bifurcation_subtree_den (ra rb : Nat) : Nat :=
  ra + rb
theorem bifurcation_resistance_homogeneous_scaling (k rp ra rb : Nat) :
    bifurcation_subtree_num (k * rp) (k * ra) (k * rb) =
      k * (k * bifurcation_subtree_num rp ra rb) ∧
    bifurcation_subtree_den (k * ra) (k * rb) = k * bifurcation_subtree_den ra rb
"""^^pk:lean4 ;
        skos:notation "R_i = 8η L_i/(π r_i^4) (A_0/A_lumen,i)^2;  R_sub(i) = R_i + 1/(1/R_sub(2i+1) + 1/R_sub(2i+2))  ⇒  R_i → k R_i ∀i ⟹ R_sub → k R_sub  ⟹  R_tree/R_tree,0 = (A_0/A_lumen)^2 under homogeneous bronchospasm" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-3-642-87553-3>,
            <https://doi.org/10.1016/0034-5687(70)90094-0>,
            <https://doi.org/10.1016/j.jmps.2011.01.010>,
            <https://doi.org/10.1016/j.jtbi.2016.05.022>,
            <https://doi.org/10.1038/nature03490>,
            <https://doi.org/10.1115/1.4004128>,
            <https://doi.org/10.1152/jappl.1967.22.3.395>,
            <https://doi.org/10.1152/jappl.1997.83.6.1814>,
            <https://doi.org/10.1164/ajrccm/145.6.1251> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Cylindrical Neo-Hookean Bilayer Morphoelastic Buckling, Post-Buckling Period-Doubling & Sulcal Creasing Driving Hagen–Poiseuille Airway Resistance, Coupled to a Dichotomous Bronchial-Tree Impedance Network with Flow–Stretch Feedback" ;
        pk:leanDeclaration "MathOfBiology.Loop_068.bifurcation_subtree_num" ;
        pk:leanTheorem "MathOfBiology.Loop_068.bifurcation_resistance_homogeneous_scaling" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/nelson-airway-mucosal-creasing-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Venegas Flow–Stretch Positive-Feedback Monotonicity Law (Pass 3)" ;
        dct:description "Drives heterogeneous ventilation defects during asthmatic bronchospasm: identical ASM heterogeneity yields ~4% defective terminals in the thin-walled Healthy tree but ~35% in the thick-walled Severe-Asthma tree (Venegas 2005 PET: ~20–40%), with whole-tree resistance amplification above the homogeneous lower bound | Variables: ε_i^(0): log-normal (σ = 0.10) baseline ASM shortening of branch i; κ: flow–stretch feedback gain (0.2 default, calibrated on the healthy control); Q_i/⟨Q⟩_gen: tidal stretch relative to the generation mean at fixed tidal volume; ε_max = 0.45" ;
        dct:source "Venegas JG, Winkler T, Musch G, Vidal Melo MF, Layfield D, Tgavalekos N, Fischman AJ, Callahan RJ, Bellardine C, Harris RS (2005) Nature 434:777-782 (10.1038/nature03490)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L852-L1009>,
            <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_068_airway_mucosal_creasing.lean#L155-L175> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def feedback_strain_scaled (e0 kappa q_mean q : Nat) : Int :=
  ((e0 + 1 : Nat) : Int) * (((q_mean * (kappa + 1) : Nat) : Int) - (((kappa + 1) * q : Nat) : Int))
theorem venegas_feedback_strain_monotone (e0 kappa q_mean q0 dq : Nat) :
    (q0 + 1) < (q0 + dq + 2) ∧
    feedback_strain_scaled e0 kappa q_mean (q0 + dq + 2) <
      feedback_strain_scaled e0 kappa q_mean (q0 + 1)
"""^^pk:lean4 ;
        skos:notation "ε_i ← clip(ε_i^(0) (1 + κ tanh(1 − Q_i/⟨Q⟩_gen)), 0, ε_max);  Q_low < Q_high ⟹ ε(Q_low) > ε(Q_high)  ⟹ (Laws 1–3) R_i(Q_low) > R_i(Q_high): self-organised ventilation defects (terminal Q < 0.5⟨Q⟩)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-3-642-87553-3>,
            <https://doi.org/10.1016/0034-5687(70)90094-0>,
            <https://doi.org/10.1016/j.jmps.2011.01.010>,
            <https://doi.org/10.1016/j.jtbi.2016.05.022>,
            <https://doi.org/10.1038/nature03490>,
            <https://doi.org/10.1115/1.4004128>,
            <https://doi.org/10.1152/jappl.1967.22.3.395>,
            <https://doi.org/10.1152/jappl.1997.83.6.1814>,
            <https://doi.org/10.1164/ajrccm/145.6.1251> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Cylindrical Neo-Hookean Bilayer Morphoelastic Buckling, Post-Buckling Period-Doubling & Sulcal Creasing Driving Hagen–Poiseuille Airway Resistance, Coupled to a Dichotomous Bronchial-Tree Impedance Network with Flow–Stretch Feedback" ;
        pk:leanDeclaration "MathOfBiology.Loop_068.feedback_strain_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_068.venegas_feedback_strain_monotone" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/newman-limb-chondrogenesis-turing-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Turing Equal-Diffusion / Hyaluronate-Excess Negative Control (No Chondrogenesis for D_u = D_v)" ;
        dct:description "Proves that equal activator and inhibitor diffusivities abolish Turing instability across all spatial wavenumbers, serving as the formal negative control | Variables: tr(J_0) = f_u + g_v: homogeneous Jacobian trace; det(J_0) = f_u g_v - f_v g_u: homogeneous Jacobian determinant; Dq = D k^2: scaled diffusion wavenumber" ;
        dct:source "Newman & Frisch (1979) Science 205(4407):662-668 Eqs. (1)-(4); Turing (1952) Phil. Trans. R. Soc. B 237:37-72" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L115-L210>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_012_limb_chondrogenesis_turing.lean#L19-L41> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def modal_trace_eq_diff (tr_J0 Dq : Int) : Int := tr_J0 - 2 * Dq
def modal_det_eq_diff (det_J0 neg_tr_Dq Dq_sq : Int) : Int :=
  det_J0 + neg_tr_Dq + Dq_sq
theorem newman_turing_equal_diffusion_no_chondrogenesis (tr_J0 det_J0 Dq neg_tr_Dq Dq_sq : Int)
    (htr : tr_J0 < 0) (hdet : det_J0 > 0)
    (hDq : Dq ≥ 0) (hterm : neg_tr_Dq ≥ 0) (hsq : Dq_sq ≥ 0) :
    modal_trace_eq_diff tr_J0 Dq < 0 ∧ modal_det_eq_diff det_J0 neg_tr_Dq Dq_sq > 0 := by
  unfold modal_trace_eq_diff modal_det_eq_diff; omega
"""^^pk:lean4 ;
        skos:notation "tr(J_0) < 0 ∧ det(J_0) > 0 ∧ D_u = D_v = D ≥ 1 ⟹ ∀ q = k^2 ≥ 0, tr(J_k) = tr(J_0) - 2 D q < 0 ∧ det(J_k) = det(J_0) - D tr(J_0) q + D^2 q^2 > 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/0012-1606(72)90071-1>,
            <https://doi.org/10.1016/0045-6039(84)90025-3>,
            <https://doi.org/10.1038/244492a0>,
            <https://doi.org/10.1038/nature00902>,
            <https://doi.org/10.1098/rspb.2004.2772>,
            <https://doi.org/10.1126/science.462174>,
            <https://doi.org/10.1186/s13227-017-0084-8>,
            <https://doi.org/10.1242/dev.32.3.651>,
            <https://doi.org/10.1242/dev.35.2.241>,
            <https://doi.org/10.1242/dev.40.1.1>,
            <https://doi.org/10.1371/journal.pbio.1000420>,
            <https://doi.org/10.1371/journal.pone.0010892> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Skeletal Limb Bud Eigenmodes" ;
        pk:leanDeclaration "MathOfBiology.Loop_012.modal_det_eq_diff" ;
        pk:leanTheorem "MathOfBiology.Loop_012.newman_turing_equal_diffusion_no_chondrogenesis" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/newman-limb-chondrogenesis-turing-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Proximodistal Progress-Zone Depth Reduction & 1 -> 2 -> 3 -> 4 Skeletal Eigenmode Progression" ;
        dct:description "Proves that progressive reduction of apical progress-zone depth L_PD(t) and effective fibronectin diffusivity D_eff(t) monotonically shifts the unstable anteroposterior eigenmode from m=1 (stylopod humerus) -> m=2 (zeugopod radius+ulna) -> m=3 (chick wing digits II-IV) -> m=4 (chick hindlimb digits I-IV) | Variables: L_PD(t) ∈ {500, 250, 140, 115} μm: shrinking apical progress-zone depth; D_eff(t): hyaluronidase-modulated fibronectin diffusivity; m ∈ {1, 2, 3, 4}: anteroposterior skeletal element count" ;
        dct:source "Newman & Frisch (1979) Science 205(4407):662-668 Eqs. (3)-(7) & Table 1, pp. 663-666" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L215-L360>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_012_limb_chondrogenesis_turing.lean#L48-L78> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def newman_trace_J0 (fu : Int) : Int := fu - 200
def newman_mode_sq (fu : Int) : Int := fu - 2
theorem newman_proximodistal_mode_transition_series (fu1 fu2 : Int)
    (h12 : fu1 < fu2) (h2 : fu2 < 200) :
    newman_mode_sq fu1 < newman_mode_sq fu2 ∧
    newman_trace_J0 fu2 < 0 ∧
    newman_mode_sq 3 = 1 * 1 ∧
    newman_mode_sq 6 = 2 * 2 ∧
    newman_mode_sq 11 = 3 * 3 ∧
    newman_mode_sq 18 = 4 * 4 := by
  unfold newman_mode_sq newman_trace_J0; omega
"""^^pk:lean4 ;
        skos:notation "Phi_{m,n}(x,y,z) = cos(m π x / L_AP) cos(n π y / L_DV) sin(π z / L_PD(t));  m^2(f_u) = (D_v f_u + D_u g_v) / (2 D_u D_v) = f_u - 2 ∈ {1^2, 2^2, 3^2, 4^2}" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/0012-1606(72)90071-1>,
            <https://doi.org/10.1016/0045-6039(84)90025-3>,
            <https://doi.org/10.1038/244492a0>,
            <https://doi.org/10.1038/nature00902>,
            <https://doi.org/10.1098/rspb.2004.2772>,
            <https://doi.org/10.1126/science.462174>,
            <https://doi.org/10.1186/s13227-017-0084-8>,
            <https://doi.org/10.1242/dev.32.3.651>,
            <https://doi.org/10.1242/dev.35.2.241>,
            <https://doi.org/10.1242/dev.40.1.1>,
            <https://doi.org/10.1371/journal.pbio.1000420>,
            <https://doi.org/10.1371/journal.pone.0010892> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Skeletal Limb Bud Eigenmodes" ;
        pk:leanDeclaration "MathOfBiology.Loop_012.newman_mode_sq" ;
        pk:leanTheorem "MathOfBiology.Loop_012.newman_proximodistal_mode_transition_series" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/newman-limb-chondrogenesis-turing-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Apical Ectodermal Ridge (AER) Excision Proximodistal Skeletal Truncation Hierarchy" ;
        dct:description "Proves the monotonic proximodistal skeletal truncation series observed upon surgical AER removal at HH20 (1 element: humerus only), HH24 (3 elements: humerus + radius/ulna), vs intact AER (6 elements: 1 + 2 + 3) | Variables: s_exc ∈ {0, 1, 2, 3}: stage of Apical Ectodermal Ridge (AER) surgical excision; aer_wing_elements(s_exc): total skeletal condensations formed across stylopod, zeugopod, and autopod" ;
        dct:source "Saunders (1948) J. Exp. Zool. 108:363-403; Summerbell, Lewis & Wolpert (1973) Nature 244:492-496; Newman & Frisch (1979) Science 205:662-668" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L365-L445>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_012_limb_chondrogenesis_turing.lean#L85-L109> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def aer_wing_elements (stage : Nat) : Nat :=
  (if stage ≥ 1 then 1 else 0) +
  (if stage ≥ 2 then 2 else 0) +
  (if stage ≥ 3 then 3 else 0)
theorem newman_aer_excision_proximodistal_truncation :
    aer_wing_elements 0 = 0 ∧
    aer_wing_elements 1 = 1 ∧
    aer_wing_elements 2 = 3 ∧
    aer_wing_elements 3 = 6 ∧
    aer_wing_elements 0 < aer_wing_elements 1 ∧
    aer_wing_elements 1 < aer_wing_elements 2 ∧
    aer_wing_elements 2 < aer_wing_elements 3 := by decide
"""^^pk:lean4 ;
        skos:notation "N_total(s_exc) = ∑_{j=1}^{s_exc} j ∈ {0, 1, 3, 6} for s_exc ∈ {0, 1, 2, 3}" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/0012-1606(72)90071-1>,
            <https://doi.org/10.1016/0045-6039(84)90025-3>,
            <https://doi.org/10.1038/244492a0>,
            <https://doi.org/10.1038/nature00902>,
            <https://doi.org/10.1098/rspb.2004.2772>,
            <https://doi.org/10.1126/science.462174>,
            <https://doi.org/10.1186/s13227-017-0084-8>,
            <https://doi.org/10.1242/dev.32.3.651>,
            <https://doi.org/10.1242/dev.35.2.241>,
            <https://doi.org/10.1242/dev.40.1.1>,
            <https://doi.org/10.1371/journal.pbio.1000420>,
            <https://doi.org/10.1371/journal.pone.0010892> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Skeletal Limb Bud Eigenmodes" ;
        pk:leanDeclaration "MathOfBiology.Loop_012.aer_wing_elements" ;
        pk:leanTheorem "MathOfBiology.Loop_012.newman_aer_excision_proximodistal_truncation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/newman-limb-chondrogenesis-turing-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "3D Helmholtz Mode Budget k_c^2 = k_AP^2 + k_DV^2 + k_PD^2 (Progress-Zone Mode Selection)" ;
        dct:description "Fixes the kinetics of the moving-boundary active zone: fu is chosen by bisection so that the fastest-growing linear mode is exactly m^2 + k_DV^2 + k_PD^2 with k_PD^2 taken from the actual FEM operator (Dirichlet at the condensed front and at the FGF8-refractory apical boundary); the theorem states why a shrinking zone needs rising f_u to climb 1 -> 2 -> 3 [code loci: discrete_pd_eigenvalue + newman_3d_zone_kinetics; applied per step in the zone-kinetics block of integrate_newman_3d_moving_boundary_pde (L979-L1004)] | Variables: k_c^2: critical (fastest-growing) squared wavenumber of the active-zone kinetics; k_DV^2 = (π/L_DV)^2: single dorsoventral core hump; k_PD^2: lowest eigenvalue of the discrete P1 proximodistal operator on the active zone (≈ (π/L_PD)^2); m^2: anteroposterior mode energy" ;
        dct:source "Newman & Frisch (1979) Science 205(4407):662-668 Eq. (4) & Table 1; Crampin, Gaffney & Maini (1999) Bull. Math. Biol. 61:1093-1120 (mode selection on growing domains)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L668-L770>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_012_limb_chondrogenesis_turing.lean#L120-L150> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def helmholtz_ap_mode_sq (kc_sq kDV_sq kPD_sq : Int) : Int := kc_sq - kDV_sq - kPD_sq
theorem newman_helmholtz_3d_mode_bound (kc1 kc2 kDV kPD1 kPD2 : Int)
    (hkc : kc1 ≤ kc2) (hPD : kPD2 ≤ kPD1) :
    helmholtz_ap_mode_sq kc1 kDV kPD1 + kDV + kPD1 = kc1 ∧
    helmholtz_ap_mode_sq kc1 kDV kPD1 ≤ helmholtz_ap_mode_sq kc2 kDV kPD2 ∧
    (kc1 < kc2 → helmholtz_ap_mode_sq kc1 kDV kPD1 < helmholtz_ap_mode_sq kc2 kDV kPD2) ∧
    (kPD1 < kPD1 + 1 → helmholtz_ap_mode_sq kc1 kDV (kPD1 + 1) < helmholtz_ap_mode_sq kc1 kDV kPD1) := by
  unfold helmholtz_ap_mode_sq; omega
"""^^pk:lean4 ;
        skos:notation "m^2 = k_c^2 - k_DV^2 - k_PD^2;  k_c1 ≤ k_c2 ∧ k_PD2 ≤ k_PD1 ⟹ m_1^2 ≤ m_2^2 (strict for k_c1 < k_c2);  k_PD^2 ↑ at fixed k_c ⟹ m^2 ↓" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/0012-1606(72)90071-1>,
            <https://doi.org/10.1016/0045-6039(84)90025-3>,
            <https://doi.org/10.1038/244492a0>,
            <https://doi.org/10.1038/nature00902>,
            <https://doi.org/10.1098/rspb.2004.2772>,
            <https://doi.org/10.1126/science.462174>,
            <https://doi.org/10.1186/s13227-017-0084-8>,
            <https://doi.org/10.1242/dev.32.3.651>,
            <https://doi.org/10.1242/dev.35.2.241>,
            <https://doi.org/10.1242/dev.40.1.1>,
            <https://doi.org/10.1371/journal.pbio.1000420>,
            <https://doi.org/10.1371/journal.pone.0010892> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Skeletal Limb Bud Eigenmodes" ;
        pk:leanDeclaration "MathOfBiology.Loop_012.helmholtz_ap_mode_sq" ;
        pk:leanTheorem "MathOfBiology.Loop_012.newman_helmholtz_3d_mode_bound" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/newman-limb-chondrogenesis-turing-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "FGF8 Progress-Zone Depth Is Set By The FGF8 Range (Hyaluronidase Clock), Not By AER Output" ;
        dct:description "Justifies the moving-boundary design: the Table 1 depth series is driven by a shrinking FGF8 RANGE (one-parameter clock fitted to 3 points, max |rel err| 4.6 %) while AER output only sets the outgrowth velocity; after AER excision the kinetics are held and the zones sweep distally (Summerbell 1974 series 1, 1, 3, 3, 3, 6) [code loci: fit_hyaluronidase_clock; _fgf8_profile (L797-L803); zones + excision inside integrate_newman_3d_moving_boundary_pde (L847-L1152); run_aer_excision_time_sweep (L1165-L1192)] | Variables: F_AER(t): AER FGF8 output (1 intact, exp(-(t-t_exc)/τ_FGF) after excision); λ_F(t): FGF8 range; F_ap = 0.5, F_thr = 0.1: apical / exit thresholds; L_PD(t) = λ_F ln 5: active progress-zone depth; τ_H: hyaluronidase clock" ;
        dct:source "Newman & Frisch (1979) Table 1; Toole (1972) Dev. Biol. 29:321-329; Hentschel et al. (2004) Proc. R. Soc. B 271:1713-1722; Zhu et al. (2010) PLoS ONE 5:e10892; Summerbell (1974) J. Embryol. Exp. Morphol. 32:651-660; Summerbell (1977) J. Embryol. Exp. Morphol. 40:1-21" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L639-L665>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_012_limb_chondrogenesis_turing.lean#L153-L185> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def fgf8_threshold_position (L lam lnF_AER lnF_thr : Int) : Int := L - lam * (lnF_AER - lnF_thr)
def fgf8_progress_zone_depth (L lam lnF_AER lnF_ap lnF_exit : Int) : Int :=
  fgf8_threshold_position L lam lnF_AER lnF_ap - fgf8_threshold_position L lam lnF_AER lnF_exit
theorem fgf8_progress_zone_depth_independent_of_aer_output
    (L L' lam lnF_AER lnF_AER' lnF_ap lnF_exit : Int) :
    fgf8_progress_zone_depth L lam lnF_AER lnF_ap lnF_exit = lam * (lnF_ap - lnF_exit) ∧
    fgf8_progress_zone_depth L lam lnF_AER lnF_ap lnF_exit =
      fgf8_progress_zone_depth L' lam lnF_AER' lnF_ap lnF_exit ∧
    fgf8_progress_zone_depth L (2 * lam) lnF_AER lnF_ap lnF_exit =
      2 * fgf8_progress_zone_depth L lam lnF_AER lnF_ap lnF_exit := by
  unfold fgf8_progress_zone_depth fgf8_threshold_position
  refine ⟨?_, ?_, ?_⟩ <;> (simp only [Int.mul_sub, Int.mul_assoc]; omega)
"""^^pk:lean4 ;
        skos:notation "F(z) = F_AER exp(-(L - z)/λ_F);  L_PD = z(F_ap) - z(F_thr) = λ_F (ln F_ap - ln F_thr) ∀ F_AER, L;  L_PD(2 λ_F) = 2 L_PD(λ_F);  λ_F(t) = λ_0 e^{-t/τ_H} (τ_H = 37.0 h fitted to Table 1: 500/250/140 μm)" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/0012-1606(72)90071-1>,
            <https://doi.org/10.1016/0045-6039(84)90025-3>,
            <https://doi.org/10.1038/244492a0>,
            <https://doi.org/10.1038/nature00902>,
            <https://doi.org/10.1098/rspb.2004.2772>,
            <https://doi.org/10.1126/science.462174>,
            <https://doi.org/10.1186/s13227-017-0084-8>,
            <https://doi.org/10.1242/dev.32.3.651>,
            <https://doi.org/10.1242/dev.35.2.241>,
            <https://doi.org/10.1242/dev.40.1.1>,
            <https://doi.org/10.1371/journal.pbio.1000420>,
            <https://doi.org/10.1371/journal.pone.0010892> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Skeletal Limb Bud Eigenmodes" ;
        pk:leanDeclaration "MathOfBiology.Loop_012.fgf8_progress_zone_depth" ;
        pk:leanTheorem "MathOfBiology.Loop_012.fgf8_progress_zone_depth_independent_of_aer_output" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/newman-limb-chondrogenesis-turing-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hill-2 FGF8 Mitogenic Response Is Strictly Monotone (Graded Proliferation Drives The Moving Boundary)" ;
        dct:description "Guarantees that the FGF8 gradient produces a monotonically graded proliferation field beneath the AER, so outgrowth is fastest distally and the S_max sweep (0, 0.5, 1, 1.5, 2 x) yields strictly increasing 48 h outgrowth (0, 306, 612, 919, 1226 μm) while the element count is set by the clock, not by growth [code loci: _hill_proliferation; FGF8_GROWTH_DEFAULTS (L617-L636); run_fgf8_parameter_sweep (L1194-L1217)]  | Variables: S_max = ln2/12 h^-1: cell-cycle-limited proliferation ceiling; K = 0.3: half-saturation FGF8 fraction; F: local FGF8 fraction; a(z) = ∫_0^z S dz': Lagrangian tissue velocity advecting the P1 nodes; v_tip: moving-boundary speed" ;
        dct:source "Sun, Mariani & Martin (2002) Nature 418:501-508; Boehm et al. (2010) PLoS Biol. 8:e1000420; Summerbell (1976) J. Embryol. Exp. Morphol. 35:241-260" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L801-L803>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_012_limb_chondrogenesis_turing.lean#L188-L213> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def hill2_cross_lhs (K F1 F2 : Nat) : Nat := F1 * F1 * (K * K + F2 * F2)
def hill2_cross_rhs (K F1 F2 : Nat) : Nat := F2 * F2 * (K * K + F1 * F1)
theorem fgf8_hill_proliferation_monotone (K F1 F2 : Nat) (hK : 0 < K) (h12 : F1 < F2) :
    hill2_cross_lhs K F1 F2 < hill2_cross_rhs K F1 F2 := by
  unfold hill2_cross_lhs hill2_cross_rhs
  have hsq : F1 * F1 < F2 * F2 := Nat.mul_self_lt_mul_self h12
  have hKK : 0 < K * K := Nat.mul_pos hK hK
  rw [Nat.mul_add, Nat.mul_add]
  have h1 : F1 * F1 * (K * K) < F2 * F2 * (K * K) := Nat.mul_lt_mul_of_pos_right hsq hKK
  have h2 : F1 * F1 * (F2 * F2) = F2 * F2 * (F1 * F1) := Nat.mul_comm _ _
  omega
"""^^pk:lean4 ;
        skos:notation "S(F) = S_max F^2 / (K^2 + F^2);  0 < K ∧ F_1 < F_2 ⟹ F_1^2 (K^2 + F_2^2) < F_2^2 (K^2 + F_1^2) ⟺ S(F_1) < S(F_2);  v_tip = ∫_0^L S(F(z)) dz" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/0012-1606(72)90071-1>,
            <https://doi.org/10.1016/0045-6039(84)90025-3>,
            <https://doi.org/10.1038/244492a0>,
            <https://doi.org/10.1038/nature00902>,
            <https://doi.org/10.1098/rspb.2004.2772>,
            <https://doi.org/10.1126/science.462174>,
            <https://doi.org/10.1186/s13227-017-0084-8>,
            <https://doi.org/10.1242/dev.32.3.651>,
            <https://doi.org/10.1242/dev.35.2.241>,
            <https://doi.org/10.1242/dev.40.1.1>,
            <https://doi.org/10.1371/journal.pbio.1000420>,
            <https://doi.org/10.1371/journal.pone.0010892> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Skeletal Limb Bud Eigenmodes" ;
        pk:leanDeclaration "MathOfBiology.Loop_012.hill2_cross_lhs" ;
        pk:leanTheorem "MathOfBiology.Loop_012.fgf8_hill_proliferation_monotone" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/nijhout-butterfly-eyespot-focus-rings-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Nijhout (1990) & Brakefield et al. (1996) Focal Morphogen Radial Decay & Concentric Threshold Ordering" ;
        dct:description "Proves that a single radially decaying focal morphogen gradient interpreted by nested transcriptional thresholds generates strictly ordered concentric eyespot pigment rings | Variables: c₀: focal morphogen source concentration at eyespot organizer; λ = √(D/k): radial morphogen decay length; θ_pupil > θ_black > θ_gold: nested transcriptional thresholds for white UV pupil, black Spalt/Dll disc, and outer gold Engrailed ring" ;
        dct:source "Nijhout (1990) Proc. R. Soc. B 239:81-113 (doi:10.1098/rspb.1990.0048); Brakefield et al. (1996) Nature 384:236-242 (doi:10.1038/384236a0)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/2001-nijhout-butterfly-eyespot-focus-rings.py#L190-L260>,
            <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_098_butterfly_eyespot_focus_rings.lean#L24-L57> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def eyespot_ring_radius (lam L0 Li : Nat) : Nat := lam * (L0 - Li)
theorem nijhout_concentric_threshold_ordering
    (lam L0 L_pupil L_black L_gold : Nat)
    (h_lam : 0 < lam) (h_gb : L_gold < L_black) (h_bp : L_black < L_pupil) (h_p0 : L_pupil < L0) :
    0 < eyespot_ring_radius lam L0 L_pupil ∧
    eyespot_ring_radius lam L0 L_pupil < eyespot_ring_radius lam L0 L_black ∧
    eyespot_ring_radius lam L0 L_black < eyespot_ring_radius lam L0 L_gold
"""^^pk:lean4 ;
        skos:notation "∂c/∂t = D ∇²c - k c + S₀ δ(x - x_focus) ⇒ c(r) = c₀ exp(-r/λ), λ = √(D/k);  θ_pupil > θ_black > θ_gold ⇒ 0 < R_pupil < R_black < R_gold, R_i = λ ln(c₀/θ_i)" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/dbio.1995.1065>,
            <https://doi.org/10.1016/S0960-9822(01)00429-8>,
            <https://doi.org/10.1038/384236a0>,
            <https://doi.org/10.1038/416844a>,
            <https://doi.org/10.1098/rspb.1990.0048> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Source-Threshold Concentric Eyespot Rings" ;
        pk:leanDeclaration "MathOfBiology.Loop_098.eyespot_ring_radius" ;
        pk:leanTheorem "MathOfBiology.Loop_098.nijhout_concentric_threshold_ordering" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/nijhout-butterfly-eyespot-focus-rings-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Brakefield et al. (1996) & Brunetti et al. (2001) Seasonal Polyphenism Annulus Width Invariance & Goldeneye Threshold Shift" ;
        dct:description "Proves that modulating focal source strength c₀ under seasonal ecdysone polyphenism scales overall eyespot radius while preserving the outer gold annulus width ΔR, whereas shifting the Spalt threshold in Goldeneye expands the gold ring | Variables: ΔR: outer Engrailed golden-yellow ring width; L₀_wet, L₀_dry: wet- and dry-season log focal source strengths; L_black_ge: elevated Spalt response threshold in Goldeneye mutant" ;
        dct:source "Brakefield et al. (1996) Nature 384:236-242 (doi:10.1038/384236a0); Brunetti et al. (2001) Curr. Biol. 11:1451-1461 (doi:10.1016/S0960-9822(01)00429-8)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/2001-nijhout-butterfly-eyespot-focus-rings.py#L263-L340>,
            <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_098_butterfly_eyespot_focus_rings.lean#L64-L99> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def gold_annulus_width (lam L0 L_black L_gold : Nat) : Nat :=
  eyespot_ring_radius lam L0 L_gold - eyespot_ring_radius lam L0 L_black
theorem brakefield_polyphenism_annulus_invariance
    (lam L0_dry L0_wet L_black L_black_ge L_gold : Nat)
    (h_lam : 0 < lam) (h_gb : L_gold ≤ L_black) (h_ge : L_black < L_black_ge)
    (h_dry : L_black_ge ≤ L0_dry) (h_wet : L0_dry ≤ L0_wet) :
    gold_annulus_width lam L0_wet L_black L_gold = lam * (L_black - L_gold) ∧
    gold_annulus_width lam L0_dry L_black L_gold = gold_annulus_width lam L0_wet L_black L_gold ∧
    gold_annulus_width lam L0_wet L_black L_gold < gold_annulus_width lam L0_wet L_black_ge L_gold
"""^^pk:lean4 ;
        skos:notation "ΔR = R_gold(c₀) - R_black(c₀) = λ ln(θ_black / θ_gold) (invariant under c₀ scaling);  θ_black,Goldeneye > θ_black,WT ⇒ ΔR_Goldeneye > ΔR_WT" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/dbio.1995.1065>,
            <https://doi.org/10.1016/S0960-9822(01)00429-8>,
            <https://doi.org/10.1038/384236a0>,
            <https://doi.org/10.1038/416844a>,
            <https://doi.org/10.1098/rspb.1990.0048> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Source-Threshold Concentric Eyespot Rings" ;
        pk:leanDeclaration "MathOfBiology.Loop_098.gold_annulus_width" ;
        pk:leanTheorem "MathOfBiology.Loop_098.brakefield_polyphenism_annulus_invariance" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/nijhout-butterfly-eyespot-focus-rings-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Nijhout (1980, 1990) & French & Brakefield (1995) Early Pupal Focal Microcautery Ablation Collapse" ;
        dct:description "Establishes the negative-control ablation theorem that cauterizing the organizer focus before morphogen secretion eliminates all concentric eyespot rings | Variables: c₀: residual focal source after early pupal microcautery; R_pupil, R_black, R_gold: concentric pigment ring radii" ;
        dct:source "Nijhout (1990) Proc. R. Soc. B 239:81-113 (doi:10.1098/rspb.1990.0048); French & Brakefield (1995) Dev. Biol. 168:112-123 (doi:10.1006/dbio.1995.1065)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/2001-nijhout-butterfly-eyespot-focus-rings.py#L343-L395>,
            <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_098_butterfly_eyespot_focus_rings.lean#L106-L132> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem nijhout_focal_cautery_ablation_collapse
    (lam L0 L_pupil L_black L_gold c theta_pupil theta_black theta_gold : Nat)
    (h_cautery : L0 ≤ L_gold) (h_gb : L_gold ≤ L_black) (h_bp : L_black ≤ L_pupil)
    (h_c : c < theta_gold) (h_tgb : theta_gold ≤ theta_black) (h_tbp : theta_black ≤ theta_pupil) :
    eyespot_ring_radius lam L0 L_pupil = 0 ∧
    eyespot_ring_radius lam L0 L_black = 0 ∧
    eyespot_ring_radius lam L0 L_gold = 0 ∧
    eyespot_ring_zone c theta_pupil theta_black theta_gold = 0
"""^^pk:lean4 ;
        skos:notation "c₀ ≤ θ_gold < θ_black < θ_pupil ⇒ R_pupil = R_black = R_gold = 0 ∧ zone(c) = 0 ∀ r ≥ 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/dbio.1995.1065>,
            <https://doi.org/10.1016/S0960-9822(01)00429-8>,
            <https://doi.org/10.1038/384236a0>,
            <https://doi.org/10.1038/416844a>,
            <https://doi.org/10.1098/rspb.1990.0048> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Source-Threshold Concentric Eyespot Rings" ;
        pk:leanDeclaration "MathOfBiology.Loop_098.eyespot_ring_zone" ;
        pk:leanTheorem "MathOfBiology.Loop_098.nijhout_focal_cautery_ablation_collapse" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/nijhout-butterfly-eyespot-focus-rings-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Beldade et al. (2002) Twin-Focus Morphogen Superposition & Hourglass Bridge Fusion" ;
        dct:description "Proves bilateral morphogen symmetry and outer-ring hourglass fusion whenever two adjacent eyespot foci are closer than twice the gold-ring radius | Variables: φ(r): radial morphogen kernel; d₁₂: inter-focal separation distance; w_bridge: hourglass gold-ring fusion overlap" ;
        dct:source "Beldade, Koops & Brakefield (2002) Nature 416:844-847 (doi:10.1038/416844a); Nijhout (1990) Proc. R. Soc. B 239:81-113" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/2001-nijhout-butterfly-eyespot-focus-rings.py#L398-L455>,
            <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_098_butterfly_eyespot_focus_rings.lean#L139-L169> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def twin_focus_superposition (phi : Nat → Nat) (d12 x : Nat) : Nat := phi x + phi (d12 - x)
def twin_focus_bridge_overlap (R_gold d12 : Nat) : Nat := 2 * R_gold - d12
theorem beldade_twin_focus_hourglass_fusion
    (phi : Nat → Nat) (R_gold d12 x : Nat) (h_fuse : d12 < 2 * R_gold) (hx : x ≤ d12) :
    0 < twin_focus_bridge_overlap R_gold d12 ∧
    twin_focus_superposition phi d12 (d12 - x) = twin_focus_superposition phi d12 x
"""^^pk:lean4 ;
        skos:notation "c_twin(x) = φ(|x - x₁|) + φ(|x - x₂|);  d₁₂ = |x₂ - x₁| < 2 R_gold ⇒ w_bridge = 2 R_gold - d₁₂ > 0 ∧ c_twin(d₁₂ - x) = c_twin(x)" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/dbio.1995.1065>,
            <https://doi.org/10.1016/S0960-9822(01)00429-8>,
            <https://doi.org/10.1038/384236a0>,
            <https://doi.org/10.1038/416844a>,
            <https://doi.org/10.1098/rspb.1990.0048> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Source-Threshold Concentric Eyespot Rings" ;
        pk:leanDeclaration "MathOfBiology.Loop_098.twin_focus_superposition" ;
        pk:leanTheorem "MathOfBiology.Loop_098.beldade_twin_focus_hourglass_fusion" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/ocko-termite-mound-convective-chimneys-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Diurnal Buoyancy Thermosiphon Flow Reversal & Mass Continuity Law" ;
        dct:description "Proves mass conservation A_c u_c + A_f u_f = 0 across the flute–chimney thermosiphon loop, daytime flute updraft / chimney downdraft (dT > 0), nocturnal flow reversal (dT -> -dT), and isothermal stagnation (dT = 0) | Variables: K_buoy: Boussinesq Darcy–Brinkman buoyancy conductance; dT = T_flute - T_chimney: radial temperature difference between exterior flutes and central chimney; Q_flute, Q_chimney: volumetric airflow fluxes" ;
        dct:source "King, Ocko & Mahadevan (2015) PNAS 112:11589-11593; Ocko et al. (2017) PNAS 114:10620-10624 Figs. 2-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py#L91-L263>,
            <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_097_termite_mound_convective_chimneys.lean#L27-L56> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def thermosiphon_flute_flux (K_buoy dT : Int) : Int :=
  K_buoy * dT
def thermosiphon_chimney_flux (K_buoy dT : Int) : Int :=
  -(K_buoy * dT)
theorem diurnal_thermosiphon_reversal_and_continuity (K_buoy dT : Int)
    (hK : K_buoy > 0) (hdT : dT > 0) :
    thermosiphon_flute_flux K_buoy 0 = 0 ∧
    thermosiphon_flute_flux K_buoy dT + thermosiphon_chimney_flux K_buoy dT = 0 ∧
    thermosiphon_flute_flux K_buoy (-dT) = -thermosiphon_flute_flux K_buoy dT ∧
    thermosiphon_flute_flux K_buoy dT > 0 ∧
    thermosiphon_chimney_flux K_buoy dT < 0
"""^^pk:lean4 ;
        skos:notation "Q_flute(ΔT) = K_buoy ΔT,  Q_chimney(ΔT) = -Q_flute(ΔT)  ⇒  Q_flute + Q_chimney = 0,  Q_flute(-ΔT) = -Q_flute(ΔT)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/s00114-002-0401-4>,
            <https://doi.org/10.1016/j.csbj.2020.08.012>,
            <https://doi.org/10.1073/pnas.1423242112>,
            <https://doi.org/10.1073/pnas.1713534114>,
            <https://doi.org/10.1073/pnas.1818759116> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Diurnal Buoyancy Thermosiphon Flow Q_flute = -Q_chimney ∝ g β_T (T_flute - T_chimney) + Advection–Diffusion of Cement Pheromone / CO₂ (∂_t c + u · ∇c = D ∇²c - γ c) & Threshold Soil Deposition Sculpting Cathedral Spires, Surface Flutes, and Central Chimney" ;
        pk:leanDeclaration "MathOfBiology.Loop_097.thermosiphon_flute_flux" ;
        pk:leanTheorem "MathOfBiology.Loop_097.diurnal_thermosiphon_reversal_and_continuity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/ocko-termite-mound-convective-chimneys-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Convective Péclet Apical Pheromone Amplification & Spire Aspect Ratio Law" ;
        dct:description "Proves that isothermal pure-diffusion growth (Pe = 0) yields a hemispherical dome (H/R = 1) whereas upward convective pheromone advection (Pe > 0) strictly elongates mound height and aspect ratio H/R into a cathedral spire | Variables: R: mound basal radius; Pe = u_0 H_0 / D_c: convective Péclet number of pheromone advection; eta: apical elongation coefficient; H: equilibrium mound height" ;
        dct:source "Ocko, Heyde & Mahadevan (2019) PNAS 116:3379-3384 Eqs. (1)-(8), Figs. 2-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py#L270-L451>,
            <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_097_termite_mound_convective_chimneys.lean#L68-L93> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def mound_height_milli (R eta Pe : Nat) : Nat :=
  R * (1000 + eta * Pe)
def hemispherical_dome_height_milli (R : Nat) : Nat :=
  R * 1000
theorem convective_peclet_spire_elongation (R eta Pe1 Pe2 : Nat)
    (hR : R > 0) (heta : eta > 0) (hPe : Pe1 < Pe2) :
    mound_height_milli R eta 0 = hemispherical_dome_height_milli R ∧
    mound_height_milli R eta Pe2 > hemispherical_dome_height_milli R ∧
    mound_height_milli R eta Pe1 < mound_height_milli R eta Pe2
"""^^pk:lean4 ;
        skos:notation "H / R = 1 + η_Pe Pe  (Pe = u_0 H_0 / D_c)  ⇒  H(Pe = 0) = R,  Pe_1 < Pe_2 ⇒ H(Pe_1) < H(Pe_2)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/s00114-002-0401-4>,
            <https://doi.org/10.1016/j.csbj.2020.08.012>,
            <https://doi.org/10.1073/pnas.1423242112>,
            <https://doi.org/10.1073/pnas.1713534114>,
            <https://doi.org/10.1073/pnas.1818759116> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Diurnal Buoyancy Thermosiphon Flow Q_flute = -Q_chimney ∝ g β_T (T_flute - T_chimney) + Advection–Diffusion of Cement Pheromone / CO₂ (∂_t c + u · ∇c = D ∇²c - γ c) & Threshold Soil Deposition Sculpting Cathedral Spires, Surface Flutes, and Central Chimney" ;
        pk:leanDeclaration "MathOfBiology.Loop_097.mound_height_milli" ;
        pk:leanTheorem "MathOfBiology.Loop_097.convective_peclet_spire_elongation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/ocko-termite-mound-convective-chimneys-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Taylor–Aris Oscillatory CO₂ Ventilation Dispersion Enhancement Law" ;
        dct:description "Proves that oscillatory diurnal thermosiphon flow rectifies CO₂ clearance via quadratic Taylor–Aris dispersion invariant under flow direction reversal and strictly exceeding stagnant molecular diffusion | Variables: D_0: stagnant molecular CO₂ diffusivity; alpha_TA: Taylor–Aris / pendelluft shear dispersion coefficient; u_amp: diurnal thermosiphon velocity amplitude" ;
        dct:source "King, Ocko & Mahadevan (2015) PNAS 112:11589-11593; Ocko et al. (2017) PNAS 114:10620-10624" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py#L108-L210>,
            <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_097_termite_mound_convective_chimneys.lean#L101-L125> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def effective_co2_dispersion (D0 alpha_TA u_amp : Int) : Int :=
  D0 + alpha_TA * (u_amp * u_amp)
theorem taylor_aris_oscillatory_ventilation_enhancement (D0 alpha_TA u_amp : Int)
    (hD0 : D0 > 0) (ha : alpha_TA > 0) (hu : u_amp > 0) :
    effective_co2_dispersion D0 alpha_TA 0 = D0 ∧
    effective_co2_dispersion D0 alpha_TA (-u_amp) = effective_co2_dispersion D0 alpha_TA u_amp ∧
    effective_co2_dispersion D0 alpha_TA u_amp > D0 ∧
    effective_co2_dispersion D0 alpha_TA u_amp > 0
"""^^pk:lean4 ;
        skos:notation "D_eff(u_amp) = D_0 + α_TA u_amp²  ⇒  D_eff(0) = D_0,  D_eff(-u_amp) = D_eff(u_amp),  D_eff(u_amp) > D_0 (∀ u_amp > 0)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/s00114-002-0401-4>,
            <https://doi.org/10.1016/j.csbj.2020.08.012>,
            <https://doi.org/10.1073/pnas.1423242112>,
            <https://doi.org/10.1073/pnas.1713534114>,
            <https://doi.org/10.1073/pnas.1818759116> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Diurnal Buoyancy Thermosiphon Flow Q_flute = -Q_chimney ∝ g β_T (T_flute - T_chimney) + Advection–Diffusion of Cement Pheromone / CO₂ (∂_t c + u · ∇c = D ∇²c - γ c) & Threshold Soil Deposition Sculpting Cathedral Spires, Surface Flutes, and Central Chimney" ;
        pk:leanDeclaration "MathOfBiology.Loop_097.effective_co2_dispersion" ;
        pk:leanTheorem "MathOfBiology.Loop_097.taylor_aris_oscillatory_ventilation_enhancement" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/odell-apical-constriction-invagination-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Odell, Oster, Alberch & Burnside (1981) Stretch-Activated Bistable Apical Purse-String Rest-Length Contraction Law" ;
        dct:description "Proves that sub-threshold cells remain at relaxed rest length L_1 whereas super-threshold stretch triggers active rest-length contraction toward L_2 < L_1 and positive contractile tension T_{ap} > 0, propagating a contraction wave across the ventral epithelium | Variables: L_{ap,i}: apical surface width of cell i; L_{0,i}: dynamic apical purse-string rest length; L_1, L_2: relaxed and contracted rest lengths; L_thresh: stretch-activation threshold; tau_0: contractile relaxation time; k_ap: apical actomyosin stiffness" ;
        dct:source "Odell, Oster, Alberch & Burnside (1981) Dev. Biol. 85(2):446-462 Eqs. 1-4, Fig. 4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1981-odell-apical-constriction-invagination.py#L120-L205>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_092_apical_constriction_invagination.lean#L17-L66> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def apical_target_rest_length (L_ap L_thresh L_1 L_2 : Int) : Int :=
  if L_ap > L_thresh then L_2 else L_1
def apical_rest_length_rate (L_0 L_ap L_thresh L_1 L_2 : Int) : Int :=
  apical_target_rest_length L_ap L_thresh L_1 L_2 - L_0
theorem odell_1981_bistable_apical_rest_length_contraction
    (L_ap_sub L_ap_sup L_thresh L_1 L_2 k_ap : Int)
    (hSub : L_ap_sub ≤ L_thresh) (hSup : L_ap_sup > L_thresh)
    (hBistable : L_2 < L_1) (hStiff : k_ap > 0) (hStretch : L_ap_sup > L_2) :
    apical_rest_length_rate L_1 L_ap_sub L_thresh L_1 L_2 = 0 ∧
    apical_rest_length_rate L_1 L_ap_sup L_thresh L_1 L_2 < 0 ∧
    apical_elastic_tension k_ap L_ap_sup L_2 > 0"""^^pk:lean4 ;
        skos:notation "tau_0 * dL_{0,i}/dt = -(L_{0,i} - L_target(L_{ap,i})),  L_target(L_{ap,i}) = L_1 (L_{ap,i} <= L_thresh) vs L_2 < L_1 (L_{ap,i} > L_thresh);  T_{ap,i} = k_ap * (L_{ap,i} - L_{0,i}) + mu_ap * dL_{ap,i}/dt" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(81)90434-6>,
            <https://doi.org/10.1016/j.bpj.2014.07.013>,
            <https://doi.org/10.1016/j.jmbbm.2007.10.002>,
            <https://doi.org/10.1038/nature07522> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Viscoelastic Stretch-Activated Apical Purse-String Constriction & Incompressible Wedge Invagination Mechanics" ;
        pk:leanDeclaration "MathOfBiology.Loop_092.apical_rest_length_rate" ;
        pk:leanTheorem "MathOfBiology.Loop_092.odell_1981_bistable_apical_rest_length_contraction" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/odell-apical-constriction-invagination-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Incompressible Cytoplasmic Cell Area Conservation & Wedge Spontaneous Curvature Law" ;
        dct:description "Proves that symmetric columnar cells (L_{ap} = L_{bas}) have zero curvature while apical constriction (L_{ap} < L_{bas}) at conserved cell area A_0 strictly increases positive inward (invaginating) wedge curvature | Variables: A_i, A_0: cross-sectional cytoplasmic area of trapezoidal cell i; L_{ap,i}, L_{bas,i}: apical and basal widths; h_i: apicobasal cell height; kappa_i: local tissue wedge spontaneous curvature" ;
        dct:source "Odell et al. (1981) Dev. Biol. 85(2):446-462 Fig. 3; Polyakov et al. (2014) Biophys. J. 107(4):998-1010" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1981-odell-apical-constriction-invagination.py#L208-L270>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_092_apical_constriction_invagination.lean#L68-L103> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def wedge_curvature_num (L_ap L_bas : Int) : Int :=
  2 * (L_bas - L_ap)
theorem incompressible_wedge_spontaneous_curvature
    (L_ap_1 L_ap_2 L_bas : Int)
    (hConstr1 : L_ap_1 < L_bas) (hProg : L_ap_2 < L_ap_1) :
    wedge_curvature_num L_bas L_bas = 0 ∧
    wedge_curvature_num L_ap_1 L_bas > 0 ∧
    wedge_curvature_num L_ap_2 L_bas > wedge_curvature_num L_ap_1 L_bas"""^^pk:lean4 ;
        skos:notation "A_i = 0.5 * (L_{ap,i} + L_{bas,i}) * h_i = A_0,  kappa_i = 2 * (L_{bas,i} - L_{ap,i}) / (h_i * (L_{bas,i} + L_{ap,i})) = (L_{bas,i} - L_{ap,i}) / A_0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(81)90434-6>,
            <https://doi.org/10.1016/j.bpj.2014.07.013>,
            <https://doi.org/10.1016/j.jmbbm.2007.10.002>,
            <https://doi.org/10.1038/nature07522> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Viscoelastic Stretch-Activated Apical Purse-String Constriction & Incompressible Wedge Invagination Mechanics" ;
        pk:leanDeclaration "MathOfBiology.Loop_092.wedge_curvature_num" ;
        pk:leanTheorem "MathOfBiology.Loop_092.incompressible_wedge_spontaneous_curvature" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/odell-apical-constriction-invagination-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Martin, Kaschube & Wieschaus (2009) Pulsed Ratchet & Five-Regime Ventral Furrow Perturbation Hierarchy" ;
        dct:description "Establishes the strict quantitative ordering of ventral furrow invagination depth and apical constriction across wild-type Twist+Snail ratchet, stretch-propagation blockade, concertina mutant, snail unratcheted mutant, and twist;snail double-mutant control | Variables: D_inv: ventral furrow invagination depth (um); L_ap: final ventral apical cell width (um)" ;
        dct:source "Martin, Kaschube & Wieschaus (2009) Nature 457(7228):495-499 Figs. 1-4; Odell et al. (1981) Dev. Biol. 85(2):446-462 Figs. 6-9" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1981-odell-apical-constriction-invagination.py#L273-L450>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_092_apical_constriction_invagination.lean#L105-L140> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem martin_2009_ventral_furrow_perturbation_hierarchy :
    (depth10_wildtype > depth10_no_stretch ∧
     depth10_no_stretch > depth10_cta_mutant ∧
     depth10_cta_mutant > depth10_snail_mutant ∧
     depth10_snail_mutant > depth10_twist_snail_null ∧
     depth10_twist_snail_null = 0) ∧
    (lap10_wildtype < lap10_no_stretch ∧
     lap10_no_stretch < lap10_cta_mutant ∧
     lap10_cta_mutant < lap10_snail_mutant ∧
     lap10_snail_mutant < lap10_twist_snail_null)"""^^pk:lean4 ;
        skos:notation "D_WT (38.0 um) > D_noStretch (21.0 um) > D_cta (15.5 um) > D_snail (4.5 um) > D_twi_sna (0.0 um);  L_{ap,WT} (2.1 um) < L_{ap,noStretch} (3.9 um) < L_{ap,cta} (4.6 um) < L_{ap,snail} (6.9 um) < L_{ap,twi_sna} (8.2 um)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(81)90434-6>,
            <https://doi.org/10.1016/j.bpj.2014.07.013>,
            <https://doi.org/10.1016/j.jmbbm.2007.10.002>,
            <https://doi.org/10.1038/nature07522> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Viscoelastic Stretch-Activated Apical Purse-String Constriction & Incompressible Wedge Invagination Mechanics" ;
        pk:leanDeclaration "MathOfBiology.Loop_092.depth10_wildtype" ;
        pk:leanTheorem "MathOfBiology.Loop_092.martin_2009_ventral_furrow_perturbation_hierarchy" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/onuff-joint-interzone-clefting-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Kavanagh et al. (2013) Arithmetic Inhibitory Cascade Midpoint & One-Third Invariant Law" ;
        dct:description "Proves that sequential inhibitory cascade segmentation constrains triphalangeal tetrapod digits to the exact affine line P_2 = (P_1 + P_3)/2 with middle phalanx occupying exactly 1/3 of total phalangeal length | Variables: P_1, P_2, P_3: proximal, middle, and distal phalanx lengths; A: distal mesenchymal activation; I: proximal condensation lateral inhibition; Δ = P_1(A - I)/I: cascade increment" ;
        dct:source "Kavanagh et al. (2013) PNAS 110(45):18190-18195 Figs. 1-2 & Eqs. 1-3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L130-L245>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_018_joint_interzone_clefting.lean#L28-L44> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def phalanx_len (p1 delta n : Int) : Int :=
  p1 + (n - 1) * delta
def digit_total_3 (p1 delta : Int) : Int :=
  phalanx_len p1 delta 1 + phalanx_len p1 delta 2 + phalanx_len p1 delta 3
theorem kavanagh_inhibitory_cascade_midpoint_and_third (p1 delta : Int) :
    2 * phalanx_len p1 delta 2 = phalanx_len p1 delta 1 + phalanx_len p1 delta 3 ∧
    3 * phalanx_len p1 delta 2 = digit_total_3 p1 delta ∧
    phalanx_len 150 (-53) 2 = 97 ∧
    digit_total_3 150 (-53) = 291
"""^^pk:lean4 ;
        skos:notation "P_n = P_1 [1 + (n-1)(A-I)/I] = P_1 + (n-1)Δ  ⇒  2 P_2 = P_1 + P_3,  P_2 / P_1 = 1/2 + (1/2)(P_3 / P_1),  3 P_2 = P_1 + P_2 + P_3" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jor.1100060604>,
            <https://doi.org/10.1016/0012-1606(66)90022-4>,
            <https://doi.org/10.1016/S0092-8674(01)00222-7>,
            <https://doi.org/10.1016/j.devcel.2009.04.013>,
            <https://doi.org/10.1016/j.devcel.2017.04.021>,
            <https://doi.org/10.1038/260808a0>,
            <https://doi.org/10.1038/368639a0>,
            <https://doi.org/10.1073/pnas.1315213110>,
            <https://doi.org/10.1115/1.3138202>,
            <https://doi.org/10.1126/science.280.5368.1455>,
            <https://doi.org/10.1177/002215549804600509>,
            <https://doi.org/10.1371/journal.pone.0017526> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled BMP-GDF5-Noggin Reaction-Diffusion Turing-Wavefront Synovial Joint Interzone Segmentation & Kavanagh (2013) Phalangeal Inhibitory Cascade" ;
        pk:leanDeclaration "MathOfBiology.Loop_018.phalanx_len" ;
        pk:leanTheorem "MathOfBiology.Loop_018.kavanagh_inhibitory_cascade_midpoint_and_third" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/onuff-joint-interzone-clefting-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hiscock et al. (2017) Distal PFR-FGF Tapering & BMP-GDF5-Noggin Turing Dispersion Sign Inversion Law" ;
        dct:description "Establishes diffusion-driven Turing nucleation of periodic Gdf5+/Wnt9a+ synovial joint interzones and strict proximal-to-distal phalanx tapering P_1 > P_2 > P_3 under a decaying distal PFR-FGF gradient | Variables: G: GDF5/Wnt9a synovial interzone activator; N: diffusible Noggin BMP antagonist; D_G, D_N: diffusion coefficients; q: spatial wavenumber; Δ < 0: distal PFR-FGF decay increment" ;
        dct:source "Hiscock, Tschopp & Tabin (2017) Dev. Cell 41:459-465; Hartmann & Tabin (2001) Cell 104:341-351" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L165-L340>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_018_joint_interzone_clefting.lean#L57-L71> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def gdf5_noggin_disp_det (f_G f_N g_G g_N D_G D_N q2 : Int) : Int :=
  (D_G * q2 - f_G) * (D_N * q2 - g_N) - f_N * g_G
theorem pfr_tapering_and_gdf5_noggin_turing_inversion (p1 delta : Int) (hd : delta ≤ -1) :
    phalanx_len p1 delta 1 > phalanx_len p1 delta 2 ∧
    phalanx_len p1 delta 2 > phalanx_len p1 delta 3 ∧
    (160 + (-210) : Int) = -50 ∧
    gdf5_noggin_disp_det 160 (-240) 190 (-210) 12 180 0 = 12000 ∧
    gdf5_noggin_disp_det 160 (-240) 190 (-210) 12 180 1 = -12120
"""^^pk:lean4 ;
        skos:notation "Δ = P_1(A - I)/I < 0  ⇒  P_1 > P_2 > P_3;  Δ_disp(q^2) = (D_G q^2 - f_G)(D_N q^2 - g_N) - f_N g_G,  Δ_disp(0) > 0,  Δ_disp(q_c^2) < 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jor.1100060604>,
            <https://doi.org/10.1016/0012-1606(66)90022-4>,
            <https://doi.org/10.1016/S0092-8674(01)00222-7>,
            <https://doi.org/10.1016/j.devcel.2009.04.013>,
            <https://doi.org/10.1016/j.devcel.2017.04.021>,
            <https://doi.org/10.1038/260808a0>,
            <https://doi.org/10.1038/368639a0>,
            <https://doi.org/10.1073/pnas.1315213110>,
            <https://doi.org/10.1115/1.3138202>,
            <https://doi.org/10.1126/science.280.5368.1455>,
            <https://doi.org/10.1177/002215549804600509>,
            <https://doi.org/10.1371/journal.pone.0017526> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled BMP-GDF5-Noggin Reaction-Diffusion Turing-Wavefront Synovial Joint Interzone Segmentation & Kavanagh (2013) Phalangeal Inhibitory Cascade" ;
        pk:leanDeclaration "MathOfBiology.Loop_018.gdf5_noggin_disp_det" ;
        pk:leanTheorem "MathOfBiology.Loop_018.pfr_tapering_and_gdf5_noggin_turing_inversion" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/onuff-joint-interzone-clefting-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Brunet et al. (1998) & Storm et al. (1994) Noggin/Gdf5 Loss-of-Function Joint Cleft Ablation Law" ;
        dct:description "Proves why Noggin null (Nog-/-) embryos fail to repress BMP chondrogenesis in prospective interzones, abolishing all synovial joint clefts (N_joints = 0) into a single continuous cartilaginous rod, whereas Gdf5 brachypodism (bp/bp) selectively fuses proximal interphalangeal joints | Variables: nog_dose: Noggin BMP-antagonist dosage; gdf5_dose: GDF5 interzone signaling dosage; tau_cleft: chondrogenic repression threshold for synovial cavitation" ;
        dct:source "Brunet et al. (1998) Science 280:1455-1457; Storm et al. (1994) Nature 368:639-643" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L345-L490>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_018_joint_interzone_clefting.lean#L82-L102> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def active_synovial_joints (nog_dose gdf5_dose tau_cleft : Nat) : Nat :=
  let amp := nog_dose * gdf5_dose
  if amp ≥ 3 * tau_cleft then 3
  else if amp ≥ 2 * tau_cleft then 2
  else if amp ≥ tau_cleft then 1
  else 0
theorem noggin_gdf5_joint_cleft_ablation (gdf5_dose : Nat) :
    active_synovial_joints 0 gdf5_dose 25 = 0 ∧
    segmented_phalanges 0 gdf5_dose 25 = 1 ∧
    active_synovial_joints 7 8 25 = 2 ∧
    active_synovial_joints 10 10 25 = 3 ∧
    segmented_phalanges 10 10 25 = 3
"""^^pk:lean4 ;
        skos:notation "Noggin = 0 (Nog-/-)  ⇒  N_joints = 0,  N_phalanges = 1 (continuous fused Sox9+ cartilage rod);  Gdf5 bp/bp  ⇒  PIP joint fusion (N_joints = 2)" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jor.1100060604>,
            <https://doi.org/10.1016/0012-1606(66)90022-4>,
            <https://doi.org/10.1016/S0092-8674(01)00222-7>,
            <https://doi.org/10.1016/j.devcel.2009.04.013>,
            <https://doi.org/10.1016/j.devcel.2017.04.021>,
            <https://doi.org/10.1038/260808a0>,
            <https://doi.org/10.1038/368639a0>,
            <https://doi.org/10.1073/pnas.1315213110>,
            <https://doi.org/10.1115/1.3138202>,
            <https://doi.org/10.1126/science.280.5368.1455>,
            <https://doi.org/10.1177/002215549804600509>,
            <https://doi.org/10.1371/journal.pone.0017526> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled BMP-GDF5-Noggin Reaction-Diffusion Turing-Wavefront Synovial Joint Interzone Segmentation & Kavanagh (2013) Phalangeal Inhibitory Cascade" ;
        pk:leanDeclaration "MathOfBiology.Loop_018.active_synovial_joints" ;
        pk:leanTheorem "MathOfBiology.Loop_018.noggin_gdf5_joint_cleft_ablation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/onuff-joint-interzone-clefting-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Reduced Biot Poroelastic Synovial Cavitation Gating Law (Mow 1980; Edwards 1994; Dowthwaite 1998; Drachman & Sokoloff 1966; Kahn 2009)" ;
        dct:description "Proves the two loss-of-function results the cavitation solver reproduces — paralysed / muscle-less embryos (m = 0) and Noggin-null embryos without interzones (G = 0) form no synovial cavity although the interzone may be specified — and that steady pore pressure is monotone in loading, which is why the --m-load sweep has a single cavitation threshold | Variables: G: Gdf5+ interzone identity (Hill transform of the RD Gdf5 field); H: hyaluronan; p: excess pore pressure; c: cavity phase field; m (Lean m_load): mechanosensitive loading gain φ(m_load) of embryonic muscle contraction; k_H, δ_H, D_H, S, κ_p, γ_osm, β_osm, σ_0, κ_G, r_c: dimensionless poroelastic constants (integers in hundredths in the Lean witnesses: β = k_H = 1, m = 10, G = 10, σ_0 = 100, κ = 5)" ;
        dct:source "Mow, Kuei, Lai & Armstrong (1980) J. Biomech. Eng. 102:73-84; Edwards et al. (1994) J. Anat. 185:355-367; Dowthwaite, Edwards & Pitsillides (1998) J. Histochem. Cytochem. 46:641-651; Drachman & Sokoloff (1966) Dev. Biol. 14:401-420; Kahn et al. (2009) Dev. Cell 16:734-743" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L556-L841>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_018_joint_interzone_clefting.lean#L131-L158> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def ha_steady (k_H m_load gdf5 : Nat) : Nat :=
  k_H * gdf5 * m_load
def pore_pressure_steady (beta k_H m_load gdf5 : Nat) : Nat :=
  beta * ha_steady k_H m_load gdf5
def interzone_cohesion (sigma_0 kappa gdf5 : Int) : Int :=
  sigma_0 - kappa * gdf5
def cavity_opens (p : Nat) (sigma_coh : Int) : Bool :=
  decide ((p : Int) > sigma_coh)
theorem poroelastic_cavitation_requires_load_and_interzone
    (beta k_H gdf5 m1 m2 : Nat) (sigma_coh : Int) (hpos : 0 < sigma_coh) (hm : m1 ≤ m2) :
    pore_pressure_steady beta k_H 0 gdf5 = 0 ∧
    pore_pressure_steady beta k_H m1 0 = 0 ∧
    cavity_opens (pore_pressure_steady beta k_H 0 gdf5) sigma_coh = false ∧
    pore_pressure_steady beta k_H m1 gdf5 ≤ pore_pressure_steady beta k_H m2 gdf5 ∧
    cavity_opens (pore_pressure_steady 1 1 10 10) (interzone_cohesion 100 5 10) = true ∧
    cavity_opens (pore_pressure_steady 1 1 3 10) (interzone_cohesion 100 5 10) = false
"""^^pk:lean4 ;
        skos:notation "dH/dt = k_H φ(m) G − δ_H H + D_H ∇²H;  S ∂p/∂t = κ_p ∇²p + γ_osm (β_osm H − p), p = 0 at the perichondrium;  σ_coh = σ_0 (1 − κ_G G);  ∂c/∂t = r_c max(p − σ_coh, 0)(1 − c);  steady state p_ss = β_osm k_H φ(m) G / δ_H  ⇒  cavity iff p_ss > σ_coh;  m = 0 ∨ G = 0 ⇒ p_ss = 0 ⇒ no cavity;  m₁ ≤ m₂ ⇒ p_ss(m₁) ≤ p_ss(m₂)" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jor.1100060604>,
            <https://doi.org/10.1016/0012-1606(66)90022-4>,
            <https://doi.org/10.1016/S0092-8674(01)00222-7>,
            <https://doi.org/10.1016/j.devcel.2009.04.013>,
            <https://doi.org/10.1016/j.devcel.2017.04.021>,
            <https://doi.org/10.1038/260808a0>,
            <https://doi.org/10.1038/368639a0>,
            <https://doi.org/10.1073/pnas.1315213110>,
            <https://doi.org/10.1115/1.3138202>,
            <https://doi.org/10.1126/science.280.5368.1455>,
            <https://doi.org/10.1177/002215549804600509>,
            <https://doi.org/10.1371/journal.pone.0017526> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled BMP-GDF5-Noggin Reaction-Diffusion Turing-Wavefront Synovial Joint Interzone Segmentation & Kavanagh (2013) Phalangeal Inhibitory Cascade" ;
        pk:leanDeclaration "MathOfBiology.Loop_018.pore_pressure_steady" ;
        pk:leanTheorem "MathOfBiology.Loop_018.poroelastic_cavitation_requires_load_and_interzone" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/onuff-joint-interzone-clefting-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Darcy Lens-Cavity Midline Maximum Law (free perichondrial drainage; Mow 1980; Carter & Wong 1988)" ;
        dct:description "Explains the lens-shaped cavities of the solver (Panel A of joint_interzone_clefting_cavitation.png), the monotone loss of cavity area with permeability (Panel E), and — because the lens thickens on the midline — why the imposed articular arch does not yet produce a convex proximal head (carried as a Pass 4 item) | Variables: s: uniform osmotic fluid source across the interzone (β_osm H); κ: Darcy permeability; W: digit half-width; y: transverse coordinate; p: scaled steady pore pressure 2κp" ;
        dct:source "Mow, Kuei, Lai & Armstrong (1980) J. Biomech. Eng. 102:73-84; Carter & Wong (1988) J. Orthop. Res. 6:804-816; Roddy, Prendergast & Murphy (2011) PLoS ONE 6:e17526" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L566-L791>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_018_joint_interzone_clefting.lean#L171-L193> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def darcy_lens_pressure (s W y : Int) : Int :=
  s * (W * W - y * y)
theorem darcy_lens_cavity_midline_maximum (s W y : Int) (hs : 0 ≤ s) :
    darcy_lens_pressure s W y ≤ darcy_lens_pressure s W 0 ∧
    darcy_lens_pressure s W W = 0 ∧
    darcy_lens_pressure 3 10 0 = 300 ∧
    darcy_lens_pressure 3 10 6 = 192
"""^^pk:lean4 ;
        skos:notation "κ p'' + s = 0 on [−W, W], p(±W) = 0  ⇒  2 κ p(y) = s (W² − y²);  s ≥ 0 ⇒ p(y) ≤ p(0) ∀y, p(±W) = 0  ⇒  the cavitation drive p − σ_coh is maximal on the digit midline and the cavity nucleates as a transverse lens" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jor.1100060604>,
            <https://doi.org/10.1016/0012-1606(66)90022-4>,
            <https://doi.org/10.1016/S0092-8674(01)00222-7>,
            <https://doi.org/10.1016/j.devcel.2009.04.013>,
            <https://doi.org/10.1016/j.devcel.2017.04.021>,
            <https://doi.org/10.1038/260808a0>,
            <https://doi.org/10.1038/368639a0>,
            <https://doi.org/10.1073/pnas.1315213110>,
            <https://doi.org/10.1115/1.3138202>,
            <https://doi.org/10.1126/science.280.5368.1455>,
            <https://doi.org/10.1177/002215549804600509>,
            <https://doi.org/10.1371/journal.pone.0017526> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled BMP-GDF5-Noggin Reaction-Diffusion Turing-Wavefront Synovial Joint Interzone Segmentation & Kavanagh (2013) Phalangeal Inhibitory Cascade" ;
        pk:leanDeclaration "MathOfBiology.Loop_018.darcy_lens_pressure" ;
        pk:leanTheorem "MathOfBiology.Loop_018.darcy_lens_cavity_midline_maximum" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/oster-mechanochemical-chondrogenesis-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Oster, Murray & Harris (1983) Mechanochemical Cell-Traction Instability Criterion" ;
        dct:description "Establishes the critical cell traction bifurcation threshold tau_c above which active cell pulling overcomes ECM elasticity and diffusion to nucleate chondrogenic condensations | Variables: E_eff: ECM elastic restoring modulus; D1_s: diffusive-tethering stabilization coefficient; tau_eff: active mesenchymal cell traction parameter" ;
        dct:source "Oster, Murray & Harris (1983) J. Embryol. Exp. Morph. 78:83-125 Section 3; Oster, Murray & Maini (1985) J. Embryol. Exp. Morph. 89:93-112 Section 2" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L171-L266>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L27-L44> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def mechanochemical_effective_stiffness (E_eff D1_s tau_eff : Int) : Int :=
  E_eff + D1_s - tau_eff
theorem oster_murray_1983_traction_instability_criterion
    (E_eff D1_s tau_sub tau_super : Int)
    (h_sub : tau_sub < E_eff + D1_s)
    (h_super : E_eff + D1_s < tau_super) :
    mechanochemical_effective_stiffness E_eff D1_s tau_sub > 0 ∧
    mechanochemical_effective_stiffness E_eff D1_s tau_super < 0"""^^pk:lean4 ;
        skos:notation "K_eff = E_eff + D1_s - tau_eff;  tau_eff > E_eff + D1_s => K_eff < 0 (spontaneous cell-ECM condensation)" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/(SICI)1521-1878(200002)22:2%3C138::AID-BIES5%3E3.0.CO;2-4>,
            <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1007/978-1-4615-6983-1_6>,
            <https://doi.org/10.1093/imammb/1.1.51>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1242/dev.023176>,
            <https://doi.org/10.1242/dev.78.1.83>,
            <https://doi.org/10.1242/dev.89.1.93> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Mechanochemical Cell-Traction & Viscoelastic ECM Chondrogenesis PDE (Oster-Murray-Harris 1983 / Oster-Murray-Maini 1985)" ;
        pk:leanDeclaration "MathOfBiology.Loop_013.mechanochemical_effective_stiffness" ;
        pk:leanTheorem "MathOfBiology.Loop_013.oster_murray_1983_traction_instability_criterion" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/oster-mechanochemical-chondrogenesis-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Oster, Murray & Maini (1985) Contact-Inhibited Cell Traction Saturation Law" ;
        dct:description "Proves that contact-inhibited cell traction saturates at high cell density, preventing delta-shock blowup and stabilizing smooth cartilage condensations | Variables: tau: cell traction coefficient; lam: contact-inhibition saturation constant; n: mesenchymal cell density" ;
        dct:source "Oster, Murray & Maini (1985) J. Embryol. Exp. Morph. 89:93-112 Eq. (4)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L171-L190>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L50-L68> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def contact_inhibited_traction_num (tau n : Nat) : Nat := tau * (n * n)
def contact_inhibited_traction_den (lam n : Nat) : Nat := 1 + lam * (n * n)
theorem oster_murray_1985_contact_inhibited_traction_bound (tau lam n : Nat) :
    lam * contact_inhibited_traction_num tau n ≤
      tau * contact_inhibited_traction_den lam n"""^^pk:lean4 ;
        skos:notation "sigma_cell(n) = (tau * n^2) / (1 + lambda * n^2) <= tau / lambda" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/(SICI)1521-1878(200002)22:2%3C138::AID-BIES5%3E3.0.CO;2-4>,
            <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1007/978-1-4615-6983-1_6>,
            <https://doi.org/10.1093/imammb/1.1.51>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1242/dev.023176>,
            <https://doi.org/10.1242/dev.78.1.83>,
            <https://doi.org/10.1242/dev.89.1.93> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Mechanochemical Cell-Traction & Viscoelastic ECM Chondrogenesis PDE (Oster-Murray-Harris 1983 / Oster-Murray-Maini 1985)" ;
        pk:leanDeclaration "MathOfBiology.Loop_013.contact_inhibited_traction_num" ;
        pk:leanTheorem "MathOfBiology.Loop_013.oster_murray_1985_contact_inhibited_traction_bound" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/oster-mechanochemical-chondrogenesis-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Oster, Murray & Maini (1985) Proximo-Distal Limb Branching Mode Law" ;
        dct:description "Governs the proximo-distal transition from 1 focal condensation (stylopod: humerus/femur) to 2 bifurcated elements (zeugopod: radius+ulna / tibia+fibula) to 4-5 digital rays (autopod) | Variables: W: transverse limb bud paddle width; lambda_c: characteristic mechanochemical instability wavelength 2*pi/k_c" ;
        dct:source "Oster, Murray & Maini (1985) J. Embryol. Exp. Morph. 89:93-112 Figs. 4-9; Shubin & Alberch (1986) Evol. Biol. 20:319-387" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L272-L372>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L76-L95> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def limb_condensation_mode (W lambda_c : Nat) : Nat := W / lambda_c
theorem oster_maini_1985_limb_branching_progression (lambda_c : Nat) (h : 0 < lambda_c) :
    limb_condensation_mode (1 * lambda_c) lambda_c = 1 ∧
    limb_condensation_mode (2 * lambda_c) lambda_c = 2 ∧
    limb_condensation_mode (4 * lambda_c) lambda_c = 4 ∧
    limb_condensation_mode (5 * lambda_c) lambda_c = 5"""^^pk:lean4 ;
        skos:notation "m(W, lambda_c) = W / lambda_c  =>  (1, 2, 4, 5) for stylopod, zeugopod, and urodele forelimb/hindlimb autopod" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/(SICI)1521-1878(200002)22:2%3C138::AID-BIES5%3E3.0.CO;2-4>,
            <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1007/978-1-4615-6983-1_6>,
            <https://doi.org/10.1093/imammb/1.1.51>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1242/dev.023176>,
            <https://doi.org/10.1242/dev.78.1.83>,
            <https://doi.org/10.1242/dev.89.1.93> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Mechanochemical Cell-Traction & Viscoelastic ECM Chondrogenesis PDE (Oster-Murray-Harris 1983 / Oster-Murray-Maini 1985)" ;
        pk:leanDeclaration "MathOfBiology.Loop_013.limb_condensation_mode" ;
        pk:leanTheorem "MathOfBiology.Loop_013.oster_maini_1985_limb_branching_progression" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/oster-mechanochemical-chondrogenesis-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Oster, Murray & Maini (1985) / Saunders (1948) AER Free-Boundary Outgrowth Monotonicity Law" ;
        dct:description "Governs the proximo-distal sequence in which condensation modes are laid down behind the moving free-boundary AER in the 2D solver, and the distal truncation produced by AER removal | Variables: L_0: initial bud length; v_AER: AER outgrowth speed; t_ablate: Saunders (1948) AER-removal time; W(y): paddle width profile; lambda_c: mechanochemical wavelength" ;
        dct:source "Oster, Murray & Maini (1985) J. Embryol. Exp. Morph. 89:93-112 Sec. 4; Saunders (1948) J. Exp. Zool. 108:363-403 (10.1002/jez.1401080304); ten Berge et al. (2008) Development 135:3247-3257" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L377-L669>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L100-L135> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def aer_front (L0 v t : Nat) : Nat := L0 + v * t
theorem oster_maini_1985_aer_front_monotone (L0 v t1 t2 : Nat) (h : t1 ≤ t2) :
    aer_front L0 v t1 ≤ aer_front L0 v t2
theorem oster_maini_1985_aer_outgrowth_mode_monotone (W1 W2 lambda_c : Nat) (h : W1 ≤ W2) :
    limb_condensation_mode W1 lambda_c ≤ limb_condensation_mode W2 lambda_c
theorem saunders_1948_aer_ablation_truncation (L0 v t_ablate y t : Nat)
    (h_t : t ≤ t_ablate) (h_y : aer_front L0 v t_ablate < y) :
    aer_front L0 v t < y"""^^pk:lean4 ;
        skos:notation "L(t) = L_0 + v_AER * t non-decreasing; W_1 <= W_2 => m(W_1, lambda_c) <= m(W_2, lambda_c); AER removed at t_a => zones with y > L(t_a) never form" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/(SICI)1521-1878(200002)22:2%3C138::AID-BIES5%3E3.0.CO;2-4>,
            <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1007/978-1-4615-6983-1_6>,
            <https://doi.org/10.1093/imammb/1.1.51>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1242/dev.023176>,
            <https://doi.org/10.1242/dev.78.1.83>,
            <https://doi.org/10.1242/dev.89.1.93> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Mechanochemical Cell-Traction & Viscoelastic ECM Chondrogenesis PDE (Oster-Murray-Harris 1983 / Oster-Murray-Maini 1985)" ;
        pk:leanDeclaration "MathOfBiology.Loop_013.aer_front" ;
        pk:leanTheorem "MathOfBiology.Loop_013.oster_maini_1985_aer_outgrowth_mode_monotone" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/oster-mechanochemical-chondrogenesis-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hybrid Mechanochemical + Bmp-Sox9-Wnt Synergy Threshold Law" ;
        dct:description "Establishes that coupling the mechanochemical traction instability to Raspopovic (2014) Bmp-Sox9-Wnt kinetics can only lower the critical traction, and defines the synergy window (tau_c,hybrid < tau < tau_c,mech) tested by the 2x2 factorial at tau = 0.85 | Variables: chi_BSW: Sox9-mediated feedback gain (alpha_S * kappa_S loop through the Bmp-Sox9-Wnt network); a = -J_nn: mechanics-only stability margin; b = J_nS: Sox9 -> traction; c = J_Sn: condensation -> Sox9; mu = mu_S: Sox9 clearance" ;
        dct:source "Raspopovic, Marcon, Russo & Sharpe (2014) Science 345:566-570 (10.1126/science.1252960); Hall & Miyake (2000) BioEssays 22:138-147; Oster, Murray & Maini (1985) Sec. 5" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L671-L962>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L137-L183> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def hybrid_effective_stiffness (E_eff D1_s tau_eff chi_bsw : Int) : Int :=
  mechanochemical_effective_stiffness E_eff D1_s tau_eff - chi_bsw
theorem hybrid_mechanochemical_bsw_threshold_lowering (E_eff D1_s tau_eff chi_bsw : Int) (h : 0 ≤ chi_bsw) :
    hybrid_effective_stiffness E_eff D1_s tau_eff chi_bsw ≤ mechanochemical_effective_stiffness E_eff D1_s tau_eff
theorem hybrid_mechanochemical_bsw_synergy_threshold (E_eff D1_s tau_eff chi_bsw : Int)
    (h_mech_stable : 0 < mechanochemical_effective_stiffness E_eff D1_s tau_eff)
    (h_gain : mechanochemical_effective_stiffness E_eff D1_s tau_eff < chi_bsw) :
    0 < mechanochemical_effective_stiffness E_eff D1_s tau_eff ∧
    hybrid_effective_stiffness E_eff D1_s tau_eff chi_bsw < 0
def hybrid_reduced_det (a mu b c : Int) : Int := a * mu - b * c
theorem hybrid_n_sox9_loop_destabilises_when_gain_exceeds_margin (a mu b c : Int) (h : a * mu < b * c) :
    hybrid_reduced_det a mu b c < 0"""^^pk:lean4 ;
        skos:notation "K_hyb = E_eff + D1_s - tau_eff - chi_BSW <= K_mech (chi_BSW >= 0); 0 < K_mech < chi_BSW => K_hyb < 0; det[[-a, b],[c, -mu]] = a*mu - b*c < 0 iff b*c > a*mu" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/(SICI)1521-1878(200002)22:2%3C138::AID-BIES5%3E3.0.CO;2-4>,
            <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1007/978-1-4615-6983-1_6>,
            <https://doi.org/10.1093/imammb/1.1.51>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1242/dev.023176>,
            <https://doi.org/10.1242/dev.78.1.83>,
            <https://doi.org/10.1242/dev.89.1.93> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Mechanochemical Cell-Traction & Viscoelastic ECM Chondrogenesis PDE (Oster-Murray-Harris 1983 / Oster-Murray-Maini 1985)" ;
        pk:leanDeclaration "MathOfBiology.Loop_013.hybrid_effective_stiffness" ;
        pk:leanTheorem "MathOfBiology.Loop_013.hybrid_mechanochemical_bsw_synergy_threshold" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/painter-chemotactic-stripe-splitting-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Keller-Segel Homogeneous Steady-State & Pure-RD Stability (chi = 0)" ;
        dct:description "Proves that the homogeneous equilibrium (n^*, c^*) of the Keller-Segel rippling model is always stable to uniform perturbations (q = 0) and that without chemotaxis (χ = 0) no spatial pattern instability can arise | Variables: n_0: carrying capacity; c^* = α n_0 / (γ(1 + β n_0)): steady-state chemoattractant; r: logistic growth rate; γ: chemoattractant decay; D_n, D_c: cell and chemoattractant diffusivities; q = k^2: squared wavenumber" ;
        dct:source "Keller & Segel (1970) J. Theor. Biol. 26(3):399-415; Painter & Hillen (2011) Physica D 240:363-375 (model form). Generic Keller-Segel result, not a PNAS 1999 result." ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L173-L231>,
            <https://github.com/fractastical/morpholib/blob/4d5512d/morphoeval/lean/loops/Loop_005_chemotactic_stripe_splitting.lean#L32-L71> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def ksp_trace (r gamma D_n D_c q : Int) : Int := -(r + gamma) - (D_n + D_c) * q
def ksp_det (r gamma D_n D_c chi_eff q : Int) : Int :=
  (D_n * D_c) * (q * q) + (r * D_c + gamma * D_n - chi_eff) * q + r * gamma
theorem ksp_uniform_and_no_chemotaxis_stability (r gamma D_n D_c chi_eff q : Int)
    (hr : r ≥ 1) (hg : gamma ≥ 1) (hq : q ≥ 0) :
    ksp_trace r gamma D_n D_c 0 ≤ -2 ∧
    ksp_det 1 4 1 1 chi_eff 0 = 4 ∧
    ksp_det 1 4 1 1 0 q ≥ 4 := by
  unfold ksp_trace ksp_det
  have hq2 : q * q ≥ 0 := Int.mul_nonneg hq hq; omega
"""^^pk:lean4 ;
        skos:notation "tr M(0) = -(r + γ) < 0 ∧ det M(0) = r γ > 0;  χ = 0 ⟹ det M(q) = D_n D_c q^2 + (r D_c + γ D_n) q + r γ > 0 ∀ q ≥ 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/BF02458621>,
            <https://doi.org/10.1016/0022-5193(70)90092-5>,
            <https://doi.org/10.1016/j.physd.2010.09.011>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1073/pnas.96.10.5549>,
            <https://doi.org/10.1098/rspa.1991.0100>,
            <https://doi.org/10.1371/journal.pcbi.1004474> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Chemotaxis-Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_005.ksp_det" ;
        pk:leanTheorem "MathOfBiology.Loop_005.ksp_uniform_and_no_chemotaxis_stability" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/painter-chemotactic-stripe-splitting-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Keller-Segel Equal-Diffusivity Chemotactic Instability Threshold (χ > χ_c at D_n = D_c)" ;
        dct:description "Proves that unlike pure Turing reaction-diffusion systems (which require D_u ≠ D_v), chemotactic cross-diffusion -∇·(n χ ∇c) destabilizes the homogeneous state at equal diffusivities D_n = D_c = 1 whenever χ > χ_c = 4.5 (χ_eff > 9); PNAS 1999 uses this contrast qualitatively to motivate chemotaxis in the Pomacanthus model | Variables: χ: chemotactic sensitivity; χ_c = (√(r D_c) + √(γ D_n))^2 / (n_0 s^*): critical chemotactic threshold; s^* = α / (1 + β n_0)^2: linearized secretion slope; k_c: critical wavenumber" ;
        dct:source "Keller & Segel (1970) J. Theor. Biol. 26(3):399-415 linearisation; Painter & Hillen (2011) Physica D 240:363-375. The Lean theorem name retains its Pass 1 'painter_1999' prefix for KG continuity; the law itself is generic Keller-Segel." ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L173-L258>,
            <https://github.com/fractastical/morpholib/blob/4d5512d/morphoeval/lean/loops/Loop_005_chemotactic_stripe_splitting.lean#L74-L79> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem painter_1999_equal_diffusivity_chemotactic_instability :
    ksp_det 1 4 1 1 8 2 = 2 ∧
    ksp_det 1 4 1 1 9 2 = 0 ∧
    ksp_det 1 4 1 1 12 2 = -6 := by
  unfold ksp_det; omega
"""^^pk:lean4 ;
        skos:notation "D_n = D_c = D ∧ n_0 χ(c^*) s^* > (√(r D_c) + √(γ D_n))^2 ⟹ det M(k_c^2) < 0 at k_c^2 = √(r γ / (D_n D_c))" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/BF02458621>,
            <https://doi.org/10.1016/0022-5193(70)90092-5>,
            <https://doi.org/10.1016/j.physd.2010.09.011>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1073/pnas.96.10.5549>,
            <https://doi.org/10.1098/rspa.1991.0100>,
            <https://doi.org/10.1371/journal.pcbi.1004474> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Chemotaxis-Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_005.ksp_det" ;
        pk:leanTheorem "MathOfBiology.Loop_005.painter_1999_equal_diffusivity_chemotactic_instability" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/painter-chemotactic-stripe-splitting-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Growing-Domain Wavenumber Halving & Keller-Segel Stripe-Splitting Cascade" ;
        dct:description "Proves why uniform domain growth stretches existing spatial modes below q_min and sequentially recruits frequency-doubled modes m = 1 → 2 → 4 → 8, driving chemotactic stripe splitting in the Keller-Segel rippling model | Variables: s = L(t)/L_0: domain dilation factor; m: spatial mode number; [q_min, q_max]: unstable chemotactic wavenumber band around q_c" ;
        dct:source "Crampin, Gaffney & Maini (1999) Bull. Math. Biol. 61:1093-1120 (mode doubling on growing domains); Kondo & Asai (1995) Nature 376:765 (biological stripe insertion). PNAS 1999 Fig. 3 is the Pomacanthus instance treated in Law 5." ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L358-L465>,
            <https://github.com/fractastical/morpholib/blob/4d5512d/morphoeval/lean/loops/Loop_005_chemotactic_stripe_splitting.lean#L90-L108> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def in_chemotactic_band (q_min q_max m s : Nat) : Bool :=
  decide (q_min * s * s ≤ m * m ∧ m * m ≤ q_max * s * s)
theorem painter_1999_domain_growth_stripe_splitting_cascade :
    in_chemotactic_band 1 3 1 1 = true ∧
    in_chemotactic_band 1 3 2 1 = false ∧
    in_chemotactic_band 1 3 1 2 = false ∧
    in_chemotactic_band 1 3 2 2 = true ∧
    in_chemotactic_band 1 3 2 4 = false ∧
    in_chemotactic_band 1 3 4 4 = true := by decide
"""^^pk:lean4 ;
        skos:notation "q_m(s) = m^2 / s^2 ∈ [q_min, q_max] ⟺ q_min s^2 ≤ m^2 ≤ q_max s^2;  s: 1 → 2 → 4 ⟹ m_unstable: 1 → 2 → 4" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/BF02458621>,
            <https://doi.org/10.1016/0022-5193(70)90092-5>,
            <https://doi.org/10.1016/j.physd.2010.09.011>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1073/pnas.96.10.5549>,
            <https://doi.org/10.1098/rspa.1991.0100>,
            <https://doi.org/10.1371/journal.pcbi.1004474> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Chemotaxis-Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_005.in_chemotactic_band" ;
        pk:leanTheorem "MathOfBiology.Loop_005.painter_1999_domain_growth_stripe_splitting_cascade" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/painter-chemotactic-stripe-splitting-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Painter, Maini & Othmer (1999) Pomacanthus Turing Instability & Three-Stripe Mode Selection (Fig. 3 kinetics, L(0) = 11)" ;
        dct:description "Proves that the actual PNAS 1999 Fig. 3 parameter set is a kinetically stable, diffusion-driven-unstable Turing system and that on the juvenile domain L(0) = 11 the half-wave mode m = 6 (three stripes, Fig. 1a) is selected | Variables: u, v: Kondo-Asai activator/inhibitor morphogens with piecewise-linear (clipped) kinetics f = clip(0.08u - 0.08v + 0.05, 0, 0.18) - 0.03u, g = clip(0.1u - 0.15, 0, 0.5) - 0.06v; D_u = 0.007, D_v = 0.1; m: zero-flux half-wave mode number k = mπ/L; n: chemotactic iridophores with χ(u) = χ_0/(k + u)^2, χ_0 = -1e-4 (slaved to u, do not alter the Turing condition)" ;
        dct:source "Painter, Maini & Othmer (1999) PNAS 96(10):5549-5554 Eqs. (1)-(3) and Fig. 3 caption; Kondo & Asai (1995) Nature 376:765-768 (kinetics)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L546-L615>,
            <https://github.com/fractastical/morpholib/blob/4d5512d/morphoeval/lean/loops/Loop_005_chemotactic_stripe_splitting.lean#L119-L170> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def turing_trace (fu gv : Int) : Int := fu + gv
def turing_det (fu fv gu gv : Int) : Int := fu * gv - fv * gu
def turing_h (Du Dv fu gv : Int) : Int := Dv * fu + Du * gv
theorem painter_1999_pomacanthus_turing_instability :
    turing_trace 5 (-6) = -1 ∧
    turing_det 5 (-8) 10 (-6) = 50 ∧
    turing_h 7 100 5 (-6) = 458 ∧
    turing_h 7 100 5 (-6) * turing_h 7 100 5 (-6) > 4 * 7 * 100 * turing_det 5 (-8) 10 (-6) := by
  unfold turing_trace turing_det turing_h
  decide
def neumann_mode_q (m : Nat) : Nat := m * m * 9870
def pomacanthus_band_lo : Nat := 1385 * 121
def pomacanthus_band_hi : Nat := 5158 * 121
def pomacanthus_q_c : Nat := 3271 * 121
theorem pomacanthus_three_stripe_mode_selection :
    (pomacanthus_band_lo ≤ neumann_mode_q 5 ∧ neumann_mode_q 7 ≤ pomacanthus_band_hi) ∧
    neumann_mode_q 4 < pomacanthus_band_lo ∧ pomacanthus_band_hi < neumann_mode_q 8 ∧
    dist_to_qc 6 < dist_to_qc 5 ∧ dist_to_qc 6 < dist_to_qc 7 := by
  decide
"""^^pk:lean4 ;
        skos:notation "J = [[0.05, -0.08], [0.1, -0.06]] at (u*, v*) = (3, 2.5): tr J = -0.01 < 0, det J = 0.005 > 0, h = D_v f_u + D_u g_v = 0.00458 > 0, h^2 > 4 D_u D_v det J; k_c^2 = h / (2 D_u D_v) = 3.2714, λ_c = 3.4739; Neumann modes m ∈ {5, 6, 7} in band [1.3848, 5.1581] on L = 11, m = 6 closest to k_c ⟹ 3 stripes" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/BF02458621>,
            <https://doi.org/10.1016/0022-5193(70)90092-5>,
            <https://doi.org/10.1016/j.physd.2010.09.011>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1073/pnas.96.10.5549>,
            <https://doi.org/10.1098/rspa.1991.0100>,
            <https://doi.org/10.1371/journal.pcbi.1004474> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Chemotaxis-Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_005.turing_h" ;
        pk:leanTheorem "MathOfBiology.Loop_005.painter_1999_pomacanthus_turing_instability" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/painter-chemotactic-stripe-splitting-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Kondo-Asai Stripe-Doubling Law on a Uniformly Growing Surface (m = 3s wavelength-preserving mode; 3 → 6 → 12)" ;
        dct:description "Proves the wavelength-conserving mode on a uniformly growing surface is exactly m = 3s, i.e. Kondo & Asai's observation that P. semicirculatus stripe number doubles with body length (3 → 6 → 12), and that the PNAS 1999 unstable band selects modes 3, 6, 12 at s = 1, 2, 4. The script realises this on flat (line, cylinder K = 0: 3 → 6 → 12 reproduced, doubling scale ratio 2.03) and curved (spindle K λ_c^2 = 0.69: 3 → 6 → 8, sequential insertion) growing flanks | Variables: s = L(t)/L_0 = e^{rt}: uniform isotropic growth scale of the flank surface (metric g = s^2 g_0, Laplace-Beltrami Δ_g = Δ_{g_0}/s^2); m: number of meridional stripes; morphogen dilution 2r (Crampin-Gaffney-Maini), no cell dilution (PNAS 1999 proliferation assumption); K: Gaussian curvature of the surface of revolution ρ(X)" ;
        dct:source "Kondo & Asai (1995) Nature 376:765-768; Painter, Maini & Othmer (1999) PNAS 96(10):5549-5554 Figs. 1 & 3; Crampin, Gaffney & Maini (1999) Bull. Math. Biol. 61:1093 (growing-domain dilution)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L616-L879>,
            <https://github.com/fractastical/morpholib/blob/4d5512d/morphoeval/lean/loops/Loop_005_chemotactic_stripe_splitting.lean#L178-L197> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem kondo_asai_stripe_doubling_mode_selection (m s : Nat) :
    (m * m = 9 * (s * s) ↔ m = 3 * s) ∧
    in_chemotactic_band 3 28 3 1 = true ∧ in_chemotactic_band 3 28 6 1 = false ∧
    in_chemotactic_band 3 28 3 2 = false ∧ in_chemotactic_band 3 28 6 2 = true ∧
    in_chemotactic_band 3 28 6 4 = false ∧ in_chemotactic_band 3 28 12 4 = true := by
  refine ⟨?_, by decide, by decide, by decide, by decide, by decide, by decide⟩
  have h : 9 * (s * s) = (3 * s) * (3 * s) := by
    rw [Nat.mul_mul_mul_comm]
  rw [h]
  exact Nat.mul_self_inj
"""^^pk:lean4 ;
        skos:notation "g(t) = s^2 g_0 ⟹ Δ_g = Δ_{g_0}/s^2 ⟹ q_m(s) = m^2/s^2;  m^2 = 9 s^2 ⟺ m = 3 s;  with band [3, 28] (= [k_-^2, k_+^2]/k_c^2 × 9): mode 3 at s = 1, mode 6 at s = 2, mode 12 at s = 4" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/BF02458621>,
            <https://doi.org/10.1016/0022-5193(70)90092-5>,
            <https://doi.org/10.1016/j.physd.2010.09.011>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1073/pnas.96.10.5549>,
            <https://doi.org/10.1098/rspa.1991.0100>,
            <https://doi.org/10.1371/journal.pcbi.1004474> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Chemotaxis-Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_005.in_chemotactic_band" ;
        pk:leanTheorem "MathOfBiology.Loop_005.kondo_asai_stripe_doubling_mode_selection" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/painter-chemotactic-stripe-splitting-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "Slime-Trail Orientation Tensor: Anisotropic Mobility Lowers the Keller-Segel Chemotactic Threshold (χ_c(m) < χ_c)" ;
        dct:description "Proves that coupling the Keller-Segel cell flux to the slime-trail orientation tensor (Myxococcus gliding follows deposited trails) strictly lowers the chemotactic rippling threshold along the director, so ridges grown at χ = 6.2 persist at χ = 4.4 < χ_c = 4.5 with trails (amplitude 0.46) but decay without them (0.16); predicted χ_c(m) = 4.22 lies in the observed onset bracket (4.0, 4.4) | Variables: Q: traceless symmetric nematic order tensor of the extracellular slime trails, dQ/dt = k_Q[(n/(1+n))(d d^T - I/2) - Q] + D_Q ΔQ with d = ∇c/|∇c|; S = 2|Q|: scalar order; a: trail-following strength; m = 1 + a S/2: mobility factor along the director applied to both D_n and χ" ;
        dct:source "Balagam & Igoshin (2015) PLoS Comput. Biol. 11:e1004474 (trail-following alignment in M. xanthus); Keller & Segel (1970) J. Theor. Biol. 26:399 (threshold)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L880-L1022>,
            <https://github.com/fractastical/morpholib/blob/4d5512d/morphoeval/lean/loops/Loop_005_chemotactic_stripe_splitting.lean#L206-L224> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem slime_trail_anisotropic_mobility_lowers_chemotactic_threshold (j : Nat) (hj : 2 ≤ j) :
    (1 + 2 * j) * (1 + 2 * j) < 9 * (j * j) ∧ (1 + 2 * 1) * (1 + 2 * 1) = 9 * (1 * 1) := by
  refine ⟨?_, by decide⟩
  have h1 : 2 * j ≤ j * j := Nat.mul_le_mul_right j hj
  have h2 : (1 + 2 * j) * (1 + 2 * j) = 1 + 4 * j + 4 * (j * j) := by
    have : 2 * j * (2 * j) = 4 * (j * j) := by
      rw [Nat.mul_assoc, Nat.mul_left_comm j 2 j, ← Nat.mul_assoc]
    simp only [Nat.add_mul, Nat.mul_add, Nat.one_mul, Nat.mul_one, this]
    omega
  omega
"""^^pk:lean4 ;
        skos:notation "M = I + a Q, m = 1 + a S/2 ≥ 1 along the trail director;  χ_eff_c(m) = (√(r D_c) + √(γ m D_n))^2 / m;  m = j^2 ⟹ χ_eff_c = (1 + 2j)^2 / j^2 < 9 ∀ j ≥ 2 (= 9 at j = 1)" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/BF02458621>,
            <https://doi.org/10.1016/0022-5193(70)90092-5>,
            <https://doi.org/10.1016/j.physd.2010.09.011>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1073/pnas.96.10.5549>,
            <https://doi.org/10.1098/rspa.1991.0100>,
            <https://doi.org/10.1371/journal.pcbi.1004474> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Chemotaxis-Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_005.ksp_det" ;
        pk:leanTheorem "MathOfBiology.Loop_005.slime_trail_anisotropic_mobility_lowers_chemotactic_threshold" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/pezzulo-bioelectric-target-morphology-memory-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pezzulo & Levin (2015) & Friston et al. (2015) Variational Free Energy Target Setpoint & Symmetry Law" ;
        dct:description "Defines the Variational Free Energy functional governing anatomical homeostasis and proves that the target morphology setpoint μ_target is the unique zero-free-energy equilibrium | Variables: x(t): anatomical state (proximodistal limb segment lengths or organ coordinates); μ(t): internal bioelectric positional state; μ_target: stored bioelectric target morphology setpoint; Π_s: sensory precision; Π_p: prior setpoint precision" ;
        dct:source "Pezzulo & Levin (2015) J. R. Soc. Interface 12:20150772 Figs. 2-4; Friston, Levin, Sengupta & Pezzulo (2015) J. R. Soc. Interface 12:20141383 Eqs. (2.1)-(2.6)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py#L120-L210>,
            <https://github.com/fractastical/morpholib/blob/b2936f6/morphoeval/lean/loops/Loop_084_bioelectric_target_morphology_memory.lean#L14-L44> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def sq_int (z : Int) : Int :=
  z * z
def vfe_2x (Pi_s Pi_p x mu mu_target : Int) : Int :=
  Pi_s * sq_int (x - mu) + Pi_p * sq_int (mu - mu_target)
theorem vfe_zero_at_target_and_symmetry (Pi_s Pi_p d mu_target : Int) :
    vfe_2x Pi_s Pi_p mu_target mu_target mu_target = 0 ∧
    vfe_2x 2 4 20 100 100 = 12800 ∧
    vfe_2x 2 4 100 100 100 = 0 ∧
    sq_int (-d) = sq_int d := by
  refine ⟨?_, by decide, by decide, ?_⟩
  · simp [vfe_2x, sq_int]
  · simp [sq_int, Int.neg_mul_neg]
"""^^pk:lean4 ;
        skos:notation "F(μ, x) = (1/2) Π_s (s(x) - g(μ))^2 + (1/2) Π_p (μ - μ_target)^2 ≥ 0;   F(μ_target, μ_target) = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.23770>,
            <https://doi.org/10.1098/rsif.2014.1383>,
            <https://doi.org/10.1098/rsif.2015.0772>,
            <https://doi.org/10.1098/rsif.2016.0555> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Variational Free Energy Minimization & Active Inference Anatomical Homeostasis Toward Bioelectric Setpoints" ;
        pk:leanDeclaration "MathOfBiology.Loop_084.vfe_2x" ;
        pk:leanTheorem "MathOfBiology.Loop_084.vfe_zero_at_target_and_symmetry" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/pezzulo-bioelectric-target-morphology-memory-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Homeostatic Anatomical Error-Correction Velocity, Exact Stop at L* & Denervation Arrest Law" ;
        dct:description "Proves proportional blastema growth rate scaling with amputation deficit (proximal faster than distal), exact growth cessation at L(t) = L*, and complete regeneration arrest under denervation / sensory-precision ablation (Π_s = 0) | Variables: κ_a: active morphogenetic remodeling rate; Π_s: bioelectric sensory precision; x = L(t): current limb length; μ = L*: target limb length" ;
        dct:source "Pezzulo & Levin (2015) J. R. Soc. Interface 12:20150772 Section 3 & Fig. 2; Friston et al. (2015) Eq. (2.6)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py#L145-L265>,
            <https://github.com/fractastical/morpholib/blob/b2936f6/morphoeval/lean/loops/Loop_084_bioelectric_target_morphology_memory.lean#L47-L76> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def morpho_action_vel (kappa_a Pi_s x mu : Int) : Int :=
  -kappa_a * Pi_s * (x - mu)
theorem morpho_action_stop_and_denervation_arrest (kappa_a Pi_s x mu : Int) :
    morpho_action_vel kappa_a Pi_s mu mu = 0 ∧
    morpho_action_vel kappa_a 0 x mu = 0 ∧
    morpho_action_vel 9 1 20 100 = 720 ∧
    morpho_action_vel 9 1 70 100 = 270 ∧
    morpho_action_vel 9 1 100 100 = 0 := by
  refine ⟨?_, ?_, by decide, by decide, by decide⟩
  · simp [morpho_action_vel]
  · simp [morpho_action_vel]
"""^^pk:lean4 ;
        skos:notation "dx/dt = -κ_a ∂_x F = -κ_a Π_s (x - μ);   x = μ ⟹ dx/dt = 0;   Π_s = 0 ⟹ dx/dt = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.23770>,
            <https://doi.org/10.1098/rsif.2014.1383>,
            <https://doi.org/10.1098/rsif.2015.0772>,
            <https://doi.org/10.1098/rsif.2016.0555> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Variational Free Energy Minimization & Active Inference Anatomical Homeostasis Toward Bioelectric Setpoints" ;
        pk:leanDeclaration "MathOfBiology.Loop_084.morpho_action_vel" ;
        pk:leanTheorem "MathOfBiology.Loop_084.morpho_action_stop_and_denervation_arrest" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/pezzulo-bioelectric-target-morphology-memory-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Equifinal Limb Regeneration, Ectopic Tail-to-Limb Remodeling & Bioelectric Setpoint Rewriting Law" ;
        dct:description "Establishes exact equifinality of proximal and distal limb regeneration to L* = 1.00, tail-to-limb blastema remodeling, rewritten bioelectric memory convergence to L*' = 1.45, and denervation arrest at L_0 = 0.20 | Variables: L_0: amputation stump length (0.20 proximal shoulder vs 0.70 distal wrist); ψ_0: initial grafted organ identity (-1.0 tail vs +1.0 limb); L_target' = 1.45: rewritten bioelectric target setpoint" ;
        dct:source "Pezzulo & Levin (2015) J. R. Soc. Interface 12:20150772 Figs. 1-4; Farinella-Ferruzza (1956); Durant et al. (2017) Biophys. J. 112:2231-2243" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py#L270-L440>,
            <https://github.com/fractastical/morpholib/blob/b2936f6/morphoeval/lean/loops/Loop_084_bioelectric_target_morphology_memory.lean#L79-L107> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def asymptotic_regenerated_state (Pi_s L_0 psi_0 L_target psi_target : Int) : Int × Int :=
  if Pi_s > 0 then (L_target, psi_target) else (L_0, psi_0)
theorem canonical_bioelectric_target_regimes :
    asymptotic_regenerated_state 2 20 100 100 100 = (100, 100) ∧
    asymptotic_regenerated_state 2 70 100 100 100 = (100, 100) ∧
    asymptotic_regenerated_state 2 35 (-100) 100 100 = (100, 100) ∧
    asymptotic_regenerated_state 2 20 145 145 145 = (145, 145) ∧
    asymptotic_regenerated_state 0 20 20 100 100 = (20, 20) := by
  decide
"""^^pk:lean4 ;
        skos:notation "lim_{t→∞} (L(t), ψ(t)) = (L_target, ψ_target) [Π_s > 0]  vs  (L_0, ψ_0) [Π_s = 0]" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.23770>,
            <https://doi.org/10.1098/rsif.2014.1383>,
            <https://doi.org/10.1098/rsif.2015.0772>,
            <https://doi.org/10.1098/rsif.2016.0555> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Variational Free Energy Minimization & Active Inference Anatomical Homeostasis Toward Bioelectric Setpoints" ;
        pk:leanDeclaration "MathOfBiology.Loop_084.asymptotic_regenerated_state" ;
        pk:leanTheorem "MathOfBiology.Loop_084.canonical_bioelectric_target_regimes" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/pietak-bioelectric-morphogen-coupling-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pietak & Levin (2017) Nernst-Planck Electrodiffusive Gap-Junction Flux & Zero-Drift Law" ;
        dct:description "Governs electrodiffusive transport of charged morphogens (5-HT) across voltage-gated gap junctions and proves exact flux collapse under 8-octanol blockade (G_gj = 0) or zero-flux Boltzmann balance | Variables: c(x,t): intracellular serotonin (5-HT) concentration; z = +1: 5-HT cation valence; V(x,t): resting membrane potential (mV); V_T = RT/F = 25.85 mV: thermal voltage; G_gj(ΔV): voltage-gated gap-junction conductance" ;
        dct:source "Pietak & Levin (2017) J. R. Soc. Interface 14:20170425 Eqs. (3)-(5); Pietak & Levin (2016) Front. Bioeng. Biotechnol. 4:55" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L164-L295>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_082_bioelectric_morphogen_coupling.lean#L14-L40> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def nernst_planck_flux_num (G_gj V_T dc z c dV : Int) : Int :=
  -G_gj * (V_T * dc + z * c * dV)
theorem nernst_planck_gj_flux_identities (G_gj V_T dc z c dV : Int) :
    nernst_planck_flux_num 0 V_T dc z c dV = 0 ∧
    nernst_planck_flux_num G_gj V_T dc 0 c dV = -G_gj * (V_T * dc) ∧
    nernst_planck_flux_num G_gj V_T 0 z c 0 = 0 := by
  refine ⟨?_, ?_, ?_⟩
  · simp [nernst_planck_flux_num]
  · simp [nernst_planck_flux_num]
  · simp [nernst_planck_flux_num]
"""^^pk:lean4 ;
        skos:notation "J_s = -D_s G_gj(ΔV) (∇c + (z F / R T) c ∇V);   G_gj = 0 ⟹ J_s = 0;   z = 0 ⟹ J_s = -D_s G_gj ∇c" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1016/j.ydbio.2009.12.012>,
            <https://doi.org/10.1098/rsif.2017.0425>,
            <https://doi.org/10.3389/fbioe.2016.00055> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Electrodiffusive Nernst-Planck Gap-Junction Morphogen Transport & Bioelectric-GRN Bistable Memory" ;
        pk:leanDeclaration "MathOfBiology.Loop_082.nernst_planck_flux_num" ;
        pk:leanTheorem "MathOfBiology.Loop_082.nernst_planck_gj_flux_identities" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/pietak-bioelectric-morphogen-coupling-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Boltzmann Equilibrium Concentration Ratio & Voltage-Gated Gap-Junction Symmetry Law" ;
        dct:description "Establishes the exact analytical zero-flux Boltzmann concentration ratio c_post/c_ant = exp(-z(V_post - V_ant)/V_T) and bidirectional symmetry of voltage-gated gap junctions | Variables: V_ant = -20 mV: anterior depolarized blastema potential; V_post = -60 mV: posterior hyperpolarized potential; c_post/c_ant = exp(40/25.85) ≈ 4.70: equilibrium posterior-to-anterior 5-HT ratio" ;
        dct:source "Pietak & Levin (2017) J. R. Soc. Interface 14:20170425 Figs. 2-3 & Eq. (5)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L177-L235>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_082_bioelectric_morphogen_coupling.lean#L43-L71> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def boltzmann_work (z V_ant V_post : Int) : Int :=
  -z * (V_post - V_ant)
def gj_voltage_denom (dV V0 : Int) : Int :=
  V0 * V0 + dV * dV
theorem boltzmann_equilibrium_and_gj_symmetry (dV V0 : Int) :
    boltzmann_work 1 (-20) (-60) = 40 ∧
    boltzmann_work 1 (-20) (-20) = 0 ∧
    boltzmann_work 0 (-20) (-60) = 0 ∧
    gj_voltage_denom (-dV) V0 = gj_voltage_denom dV V0 := by
  refine ⟨by decide, by decide, by decide, ?_⟩
  simp [gj_voltage_denom, Int.neg_mul_neg]
"""^^pk:lean4 ;
        skos:notation "c_post / c_ant = exp(-(z F / R T)(V_post - V_ant));   G_gj(-ΔV) = G_gj(ΔV) = (1 - η_oct) G_0 / (1 + (ΔV / V_0)^2)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1016/j.ydbio.2009.12.012>,
            <https://doi.org/10.1098/rsif.2017.0425>,
            <https://doi.org/10.3389/fbioe.2016.00055> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Electrodiffusive Nernst-Planck Gap-Junction Morphogen Transport & Bioelectric-GRN Bistable Memory" ;
        pk:leanDeclaration "MathOfBiology.Loop_082.boltzmann_work" ;
        pk:leanTheorem "MathOfBiology.Loop_082.boltzmann_equilibrium_and_gj_symmetry" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/pietak-bioelectric-morphogen-coupling-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "cAMP/PKA/beta-Catenin Feedback & Cryptic Two-Headed (2H0T) Memory Persistence Law" ;
        dct:description "Proves that transient 8-octanol gap-junction blockade flips the coupled V_mem-5-HT-cAMP-beta-catenin-ERK loop into a permanent symmetric 2H0T attractor that persists after drug washout | Variables: M(x,t): intracellular cAMP/PKA signaling state; B(x,t): nuclear beta-catenin tail determinant; E(x,t): anterior ERK head determinant" ;
        dct:source "Pietak & Levin (2017) J. R. Soc. Interface 14:20170425 Figs. 4-6; Durant et al. (2017) Biophys. J. 112:2231-2243" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L296-L535>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_082_bioelectric_morphogen_coupling.lean#L74-L108> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def erk_head_gate (B B_thresh : Int) : Nat :=
  if B ≤ B_thresh then 1 else 0
def pietak_ap_phenotype (B_ant B_post B_thresh : Int) : Nat × Nat :=
  let h_ant := erk_head_gate B_ant B_thresh
  let h_post := erk_head_gate B_post B_thresh
  (h_ant + h_post, (1 - h_ant) + (1 - h_post))
theorem cryptic_two_headed_memory_phenotypes :
    pietak_ap_phenotype 10 88 50 = (1, 1) ∧
    pietak_ap_phenotype 12 15 50 = (2, 0) ∧
    pietak_ap_phenotype 14 18 50 = (2, 0) ∧
    pietak_ap_phenotype 82 86 50 = (0, 2) := by
  decide
"""^^pk:lean4 ;
        skos:notation "τ_M dM/dt = H(c) + α_loop H(B) - M;   (N_head, N_tail) = (1,1) [WT],  (2,0) [Octanol & Cryptic Washout Memory],  (0,2) [SCH-28080/Forskolin]" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1016/j.ydbio.2009.12.012>,
            <https://doi.org/10.1098/rsif.2017.0425>,
            <https://doi.org/10.3389/fbioe.2016.00055> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Electrodiffusive Nernst-Planck Gap-Junction Morphogen Transport & Bioelectric-GRN Bistable Memory" ;
        pk:leanDeclaration "MathOfBiology.Loop_082.pietak_ap_phenotype" ;
        pk:leanTheorem "MathOfBiology.Loop_082.cryptic_two_headed_memory_phenotypes" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/pietak-bioelectric-morphogen-coupling-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "(Pass 3) Irregular 2D Voronoi-Network Scharfetter-Gummel Edge-Flux Conservation & Conductance-Independent Detailed Balance Law" ;
        dct:description "Pass 3 extension of the 1D solver to an irregular 2D Voronoi cell network (BETSE-style cell cluster): proves exact per-edge mass conservation, flux antisymmetry, flux collapse under complete gap-junction blockade, and that the discrete Boltzmann detailed-balance state is independent of the gap-junction conductance (the formal content of the G_0 ablation self-test and of the octanol ≡ cryptic-washout identity) | Variables: c_i: morphogen concentration in Voronoi cell i; w_ij = L_ij / d_ij: shared-face length over centre distance; G_gj: voltage-gated gap-junction conductance of the face; B(u) = u / (e^u - 1): Scharfetter-Gummel Bernoulli factor" ;
        dct:source "Pietak & Levin (2016) Front. Bioeng. Biotechnol. 4:55 (BETSE Voronoi cell cluster, finite-volume fluxes through shared membrane segments); Scharfetter & Gummel (1969) IEEE Trans. Electron Devices 16:64-77" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L739-L800>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_082_bioelectric_morphogen_coupling.lean#L131-L144> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def sg_edge_flux (D w G_gj c_i c_j bp bn : Int) : Int :=
  -D * w * G_gj * (c_j * bp - c_i * bn)
theorem voronoi_sg_edge_flux_laws (D w G_gj c_i c_j bp bn : Int) :
    sg_edge_flux D w G_gj c_i c_j bp bn + -(sg_edge_flux D w G_gj c_i c_j bp bn) = 0 ∧
    sg_edge_flux D w G_gj c_j c_i bn bp = -sg_edge_flux D w G_gj c_i c_j bp bn ∧
    sg_edge_flux D w 0 c_i c_j bp bn = 0 ∧
    (c_j * bp = c_i * bn → ∀ G : Int, sg_edge_flux D w G c_i c_j bp bn = 0) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · generalize sg_edge_flux D w G_gj c_i c_j bp bn = J
    omega
  · simp [sg_edge_flux, Int.mul_sub, Int.neg_sub]
  · simp [sg_edge_flux]
  · intro h G
    simp [sg_edge_flux, h]
"""^^pk:lean4 ;
        skos:notation "J_ij = -D w_ij G_gj(ΔV_ij) (c_j B(u_ij) - c_i B(-u_ij)),  w_ij = L_ij / d_ij,  u_ij = -z ΔV_ij / V_T;   J_ji = -J_ij ⟹ Σ_i A_i c_i conserved;   c_j B(u) = c_i B(-u) ⟹ J_ij = 0 ∀ G_gj" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1016/j.ydbio.2009.12.012>,
            <https://doi.org/10.1098/rsif.2017.0425>,
            <https://doi.org/10.3389/fbioe.2016.00055> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Electrodiffusive Nernst-Planck Gap-Junction Morphogen Transport & Bioelectric-GRN Bistable Memory" ;
        pk:leanDeclaration "MathOfBiology.Loop_082.sg_edge_flux" ;
        pk:leanTheorem "MathOfBiology.Loop_082.voronoi_sg_edge_flux_laws" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/pietak-bioelectric-morphogen-coupling-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "(Pass 3) Planar Voronoi Mean Interior Coordination Number (Euler Characteristic) Law" ;
        dct:description "Geometric invariant of the Pass 3 tissue: the jittered-hexagonal Voronoi cell cluster has mean interior coordination exactly 6, which is the self-test's geometry check on build_voronoi_cell_network (measured 6.000 for the 405-cell / 1114-edge network clipped to the specimen silhouette) | Variables: n: number of Voronoi cells (seed points); e: number of Delaunay edges = number of shared Voronoi faces; deg(i): coordination number (gap-junction-coupled neighbours) of cell i" ;
        dct:source "Euler characteristic of planar graphs; Pietak & Levin (2016) Front. Bioeng. Biotechnol. 4:55 (hexagonal seed lattice -> Voronoi cell cluster)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L628-L738>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_082_bioelectric_morphogen_coupling.lean#L157-L166> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def triangulation_edges (n : Int) : Int := 3 * n - 6
def total_coordination (e : Int) : Int := 2 * e
theorem planar_voronoi_coordination_six (n : Int) :
    total_coordination (triangulation_edges n) = 6 * n - 12 ∧
    total_coordination (triangulation_edges 405) = 6 * 405 - 12 := by
  refine ⟨?_, ?_⟩
  · simp only [total_coordination, triangulation_edges]
    omega
  · decide
"""^^pk:lean4 ;
        skos:notation "Delaunay dual is a planar triangulation: e = 3n - 6, Σ_i deg(i) = 2e = 6n - 12 ⟹ mean interior coordination → 6" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1016/j.ydbio.2009.12.012>,
            <https://doi.org/10.1098/rsif.2017.0425>,
            <https://doi.org/10.3389/fbioe.2016.00055> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Electrodiffusive Nernst-Planck Gap-Junction Morphogen Transport & Bioelectric-GRN Bistable Memory" ;
        pk:leanDeclaration "MathOfBiology.Loop_082.triangulation_edges" ;
        pk:leanTheorem "MathOfBiology.Loop_082.planar_voronoi_coordination_six" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/pietak-bioelectric-morphogen-coupling-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "(Pass 3) Ca2+/IP3-Driven Stochastic Posterior Toggle & 8-Octanol ≡ Cryptic-Washout Branching Identity Law" ;
        dct:description "Pass 3 stochastic branching layer: an Euler-Maruyama ensemble of noisy beta-catenin/ERK toggle switches driven by the 2D network's posterior 5-HT and Ca2+ turns the deterministic 1H1T/2H0T switch into a double-head probability p(2H0T), and the gate's dependence on (E, B) alone — which by the Law-4 detailed-balance result depend on V but not on G_gj — formalises why the 8-octanol and washed-out cryptic states share the same double-head fraction | Variables: B: posterior nuclear beta-catenin (tail determinant); E: posterior ERK (head determinant); S_B: 5-HT/cAMP tail drive; S_E: Ca2+ head drive; σ_Ca: lognormal cell-to-cell Ca2+ influx variability; thr = 0.5: commitment threshold" ;
        dct:source "Durant et al. (2017) Biophys. J. 112:2231-2243 (stochastic editing of regenerative anatomy); Oviedo et al. (2010) Dev. Biol. 339:188-199 & Nogi & Levin (2005) Dev. Biol. 287:314-335 (octanol double-head fraction); Beane et al. (2011) Chem. Biol. 18:77-89 (depolarisation-driven Ca2+ influx required for head specification)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2017-pietak-bioelectric-morphogen-coupling.py#L1030-L1085>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_082_bioelectric_morphogen_coupling.lean#L185-L194> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def two_head_gate (E B thr : Int) : Nat :=
  if thr ≤ E then (if B < thr then 1 else 0) else 0
theorem ca_ip3_toggle_branching_gate (E B thr : Int) :
    two_head_gate 20 80 50 = 0 ∧
    two_head_gate 80 20 50 = 1 ∧
    (E < thr → two_head_gate E B thr = 0) ∧
    two_head_gate 80 20 50 = two_head_gate 80 20 50 := by
  refine ⟨by decide, by decide, ?_, rfl⟩
  intro h
  simp [two_head_gate, Int.not_le.mpr h]
"""^^pk:lean4 ;
        skos:notation "τ dB/dt = S_B / (1 + (E/K_E)^2) - B + ξ;  τ dE/dt = S_E / (1 + (B/K_BE)^3) - E + ξ;  S_B = 1.45 H2(M; K_M), M = H4(c_post; K_c) + b_basal;  S_E = e_basal + g_Ca Ca_post e^{σ_Ca ξ - σ_Ca²/2};  2H0T ⟺ E ≥ thr ∧ B < thr" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1016/j.ydbio.2009.12.012>,
            <https://doi.org/10.1098/rsif.2017.0425>,
            <https://doi.org/10.3389/fbioe.2016.00055> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Electrodiffusive Nernst-Planck Gap-Junction Morphogen Transport & Bioelectric-GRN Bistable Memory" ;
        pk:leanDeclaration "MathOfBiology.Loop_082.two_head_gate" ;
        pk:leanTheorem "MathOfBiology.Loop_082.ca_ip3_toggle_branching_gate" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/planform-morphology-animation-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Lobo et al. (2013) PlanformDB Region-Link Polar Graph Encoding" ;
        dct:description "Decodes all 369 relational planarian body morphologies and internal organ placements (eyes, brain, pharynx) from PlanformDB | Variables: p_A, p_B: connected body-region centers; θ_{AB}: polar attachment angle; r_{ant}, r_{post}, r_{lat}: directional semi-axes" ;
        dct:source "Lobo, Malone & Levin (2013) PLoS Comput. Biol. 9(10):e1003287" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/161f269/2013-lobo-planform-morphology.py#L80-L240>,
            <https://github.com/fractastical/morpholib/blob/161f269/morphoeval/lean/MathOfBiology.lean#L256-L266> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def planform_wildtype_ap_length (r_head r_ant_trunk r_post_trunk r_tail : Nat) : Nat :=
  r_head + r_ant_trunk + r_post_trunk + r_tail
theorem lobo_2013_wildtype_dimensions :
    planform_wildtype_ap_length 80 200 200 80 = 560 ∧ (60 + 60 : Nat) = 120 := by decide"""^^pk:lean4 ;
        skos:notation "p_B = p_A + r_A(θ_{AB}) u(θ_{AB}) + d_{AB} u(θ_{AB}),   R_i(φ) = piecewise-ellipse(r_{ant}, r_{post}, r_{lat})" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1093/bioinformatics/btt088>,
            <https://doi.org/10.1242/bio.20123400> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Formal Anatomical Region Graph Grammar & Polar Geometry" ;
        pk:leanDeclaration "MathOfBiology.planform_wildtype_ap_length" ;
        pk:leanTheorem "MathOfBiology.lobo_2013_wildtype_dimensions" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/pringle-roman-esco-fractal-inflorescence-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Azpeitia et al. (2021) & Prusinkiewicz et al. (2007) AP1/CAL Floral GRN Bistability Collapse & Iterative Shoot Reversion Law" ;
        dct:description "Proves that loss of AP1/CAL in ap1 cal and Brassica curd mutants abolishes the floral commitment fixed point while preserving transient LFY-induced SOC1 floral memory (bract suppression) and high TFL1 shoot identity, causing recursive inflorescence branching | Variables: g_AP1 in {0, 1}: AP1/CAL locus functional dosage; L: LFY concentration; A: AP1/CAL floral commitment level; T: TFL1 shoot meristem identity factor; S: SOC1/AGL24/FUL floral memory factor" ;
        dct:source "Azpeitia et al. (2021) Science 373(6551):192-197 Figs. 1-2; Prusinkiewicz et al. (2007) Science 316:1452-1456" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L163-L261>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_040_roman_esco_fractal_inflorescence.lean#L27-L56> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def ap1_steady (g_ap1 a_floral : Int) : Int := g_ap1 * a_floral
def tfl1_steady (t_shoot g_ap1 r_repress : Int) : Int := t_shoot - g_ap1 * r_repress
def soc1_memory (s_basal lfy_spike : Int) : Int := s_basal + lfy_spike
theorem azpeitia_2021_ap1_cal_grn_shoot_reversion
    (g_ap1 a_floral t_shoot r_repress s_basal lfy_spike : Int)
    (hg : g_ap1 > 0) (ha : a_floral > 0) (hr : r_repress > 0) (hlfy : lfy_spike > 0) :
    ap1_steady 0 a_floral = 0 ∧
    ap1_steady g_ap1 a_floral > 0 ∧
    tfl1_steady t_shoot 0 r_repress = t_shoot ∧
    tfl1_steady t_shoot 0 r_repress > tfl1_steady t_shoot g_ap1 r_repress ∧
    soc1_memory s_basal lfy_spike > s_basal
"""^^pk:lean4 ;
        skos:notation "d[AP1]/dt = g_AP1 (α_A L² + α_AA A²)/((1 + L² + A²)(1 + (T/K_TA)²)) - γ A;  g_AP1 = 0 ⇒ A* = 0, T* = T_shoot > T*_WT, S* = S_basal + ΔS_LFY > S_basal" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/nature02081>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103>,
            <https://doi.org/10.1103/PhysRevE.70.046109>,
            <https://doi.org/10.1103/PhysRevLett.68.2098>,
            <https://doi.org/10.1105/tpc.2.8.755>,
            <https://doi.org/10.1126/science.1140429>,
            <https://doi.org/10.1126/science.7824951>,
            <https://doi.org/10.1126/science.abg5935> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Floral Identity Gene-Regulatory Network (TFL1 -| LFY <-> AP1/CAL + SOC1/AGL24) & Recursive Spiral Phyllotaxis with Accelerating Plastochron" ;
        pk:leanDeclaration "MathOfBiology.Loop_040.ap1_steady" ;
        pk:leanTheorem "MathOfBiology.Loop_040.azpeitia_2021_ap1_cal_grn_shoot_reversion" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/pringle-roman-esco-fractal-inflorescence-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Azpeitia et al. (2021) Accelerating Plastochron Quadratic Primordium Accumulation Law" ;
        dct:description "Proves that linear plastochron acceleration β > 0 generates a quadratic surplus of lateral meristems ½ β T² over constant-plastochron cauliflower (β = 0), shifting contact parastichy numbers from (8, 13) to (13, 21) | Variables: Δt(t): plastochron interval between consecutive lateral primordia; r_0 = 1/Δt_0: basal initiation rate; β: plastochron acceleration rate; N(T): cumulative primordia initiated by meristem age T" ;
        dct:source "Azpeitia et al. (2021) Science 373(6551):192-197 Figs. 3-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L268-L336>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_040_roman_esco_fractal_inflorescence.lean#L72-L89> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def twice_primordia_count (r0 beta T : Int) : Int :=
  2 * r0 * T + beta * T * T
theorem azpeitia_2021_accelerating_plastochron_surplus (r0 beta T : Int)
    (hbeta : beta > 0) (hT : T > 0) :
    twice_primordia_count r0 0 T = 2 * r0 * T ∧
    twice_primordia_count r0 beta T - twice_primordia_count r0 0 T = beta * T * T ∧
    twice_primordia_count r0 beta T > twice_primordia_count r0 0 T
"""^^pk:lean4 ;
        skos:notation "Δt(t) = Δt_0 / (1 + β t),  r_p(t) = r_0 + β t  ⇒  N_Rom(T) = r_0 T + ½ β T² > r_0 T = N_Caul(T)  (for β > 0)" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/nature02081>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103>,
            <https://doi.org/10.1103/PhysRevE.70.046109>,
            <https://doi.org/10.1103/PhysRevLett.68.2098>,
            <https://doi.org/10.1105/tpc.2.8.755>,
            <https://doi.org/10.1126/science.1140429>,
            <https://doi.org/10.1126/science.7824951>,
            <https://doi.org/10.1126/science.abg5935> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Floral Identity Gene-Regulatory Network (TFL1 -| LFY <-> AP1/CAL + SOC1/AGL24) & Recursive Spiral Phyllotaxis with Accelerating Plastochron" ;
        pk:leanDeclaration "MathOfBiology.Loop_040.twice_primordia_count" ;
        pk:leanTheorem "MathOfBiology.Loop_040.azpeitia_2021_accelerating_plastochron_surplus" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/pringle-roman-esco-fractal-inflorescence-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Azpeitia et al. (2021) Conical vs Hemispherical Curd Aspect Ratio Amplification Law" ;
        dct:description "Proves that conical height and height-to-radius aspect ratio H/R increase strictly monotonically with plastochron acceleration β, transforming a flat hemispherical cauliflower dome (β = 0, H/R ≈ 0.56) into a pointed self-similar Romanesco cone (β = 0.085, H/R ≈ 1.48) | Variables: H(β, T): axial height of meristematic cone; R: basal curd radius; dz: vertical internode displacement per plastochron acceleration unit; β: plastochron acceleration coefficient" ;
        dct:source "Azpeitia et al. (2021) Science 373(6551):192-197 Fig. 4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L340-L480>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_040_roman_esco_fractal_inflorescence.lean#L102-L131> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def curd_height (h0 dz beta T : Int) : Int :=
  h0 + dz * beta * T
theorem azpeitia_2021_conical_aspect_amplification (h0 dz beta1 beta2 T : Int)
    (hdz : dz > 0) (hT : T > 0) (hb1 : beta1 > 0) (hb12 : beta1 < beta2) :
    curd_height h0 dz 0 T = h0 ∧
    curd_height h0 dz beta1 T > h0 ∧
    curd_height h0 dz beta2 T - curd_height h0 dz beta1 T = dz * (beta2 - beta1) * T ∧
    curd_height h0 dz beta1 T < curd_height h0 dz beta2 T
"""^^pk:lean4 ;
        skos:notation "H(β, T) = H_0 + dz · β · T,  (H/R)(β_2) > (H/R)(β_1) > (H/R)(0) = H_0 / R_0  (for 0 < β_1 < β_2)" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/nature02081>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103>,
            <https://doi.org/10.1103/PhysRevE.70.046109>,
            <https://doi.org/10.1103/PhysRevLett.68.2098>,
            <https://doi.org/10.1105/tpc.2.8.755>,
            <https://doi.org/10.1126/science.1140429>,
            <https://doi.org/10.1126/science.7824951>,
            <https://doi.org/10.1126/science.abg5935> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Floral Identity Gene-Regulatory Network (TFL1 -| LFY <-> AP1/CAL + SOC1/AGL24) & Recursive Spiral Phyllotaxis with Accelerating Plastochron" ;
        pk:leanDeclaration "MathOfBiology.Loop_040.curd_height" ;
        pk:leanTheorem "MathOfBiology.Loop_040.azpeitia_2021_conical_aspect_amplification" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/pringle-roman-esco-fractal-inflorescence-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Jönsson et al. (2006) Up-the-Gradient PIN1 Auxin Flux Law (Pass 3)" ;
        dct:description "Proves that linear up-the-gradient PIN1 allocation transports auxin toward the auxin-richer neighbour (destabilising feedback), which is what makes discrete auxin maxima and therefore primordia emerge on the epidermal mesh of the curd dome (`simulate_pin1_auxin_transport`); the T = 0 ablation (Reinhardt et al. 2003 pin1/NPA) removes the maxima | Variables: A_i: auxin concentration of epidermal cell i; P_ij: PIN1 efflux carrier on the wall of cell i facing neighbour j; P_tot: total PIN1 per cell; κ: allocation saturation; T: transport coefficient; D: apoplastic diffusion; c, d: auxin production and decay" ;
        dct:source "Jönsson et al. (2006) PNAS 103(5):1633-1638; Smith et al. (2006) PNAS 103(5):1301-1306; Reinhardt et al. (2003) Nature 426:255-260" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L587-L777>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_040_roman_esco_fractal_inflorescence.lean#L141-L166> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def pin1_net_flux (a_i a_j : Int) : Int :=
  a_i * a_j * (a_j - a_i)
theorem jonsson_2006_up_gradient_pin1_flux (a_i a_j : Int)
    (hi : a_i > 0) (hj : a_j > 0) :
    pin1_net_flux a_i a_i = 0 ∧
    (a_i < a_j → pin1_net_flux a_i a_j > 0) ∧
    (a_j < a_i → pin1_net_flux a_i a_j < 0) ∧
    pin1_net_flux a_i a_j = - pin1_net_flux a_j a_i
"""^^pk:lean4 ;
        skos:notation "P_ij = P_tot A_j / (κ + Σ_k A_k),  J_{i→j} = T P_ij A_i  ⇒  two-cell net flux  J_net(a_i, a_j) = a_i a_j (a_j − a_i):  = 0 if a_i = a_j,  > 0 if a_j > a_i (up the gradient),  antisymmetric" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/nature02081>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103>,
            <https://doi.org/10.1103/PhysRevE.70.046109>,
            <https://doi.org/10.1103/PhysRevLett.68.2098>,
            <https://doi.org/10.1105/tpc.2.8.755>,
            <https://doi.org/10.1126/science.1140429>,
            <https://doi.org/10.1126/science.7824951>,
            <https://doi.org/10.1126/science.abg5935> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Floral Identity Gene-Regulatory Network (TFL1 -| LFY <-> AP1/CAL + SOC1/AGL24) & Recursive Spiral Phyllotaxis with Accelerating Plastochron" ;
        pk:leanDeclaration "MathOfBiology.Loop_040.pin1_net_flux" ;
        pk:leanTheorem "MathOfBiology.Loop_040.jonsson_2006_up_gradient_pin1_flux" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/pringle-roman-esco-fractal-inflorescence-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hofmeister / Douady-Couder Perimeter Scaling → Azpeitia (2021) Plastochron Acceleration (PIN1 mesh coupling, Pass 3)" ;
        dct:description "Couples the PIN1 epidermal mesh to the 3D meristem-tree plastochron law: the emergent slope k of r_p(R) measured on the mesh (`couple_pin1_mesh_to_plastochron`) and the meristem growth rate v_r determine β = (k / r_p(R_0)) v_r; the script reports β_emergent = 0.289 at the vendored v_r = 0.16 versus the reference 0.085 (implied v_r* = 0.047), an honest mismatch carried to Pass 4 | Variables: k: emergent initiation rate per unit dome radius measured on the PIN1 mesh (slope of r_p vs R); R_0: initial meristem radius; v_r: radial meristem expansion rate (vendored 0.16); t: meristem age; β: Law-2 plastochron acceleration" ;
        dct:source "Douady & Couder (1992) Phys. Rev. Lett. 68(13):2098-2101; Azpeitia et al. (2021) Science 373(6551):192-197 Figs. 3-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L779-L862>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_040_roman_esco_fractal_inflorescence.lean#L181-L202> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def perimeter_rate (k R : Int) : Int :=
  k * R
def meristem_radius (R0 v t : Int) : Int :=
  R0 + v * t
theorem hofmeister_perimeter_plastochron_acceleration (k R0 v t : Int)
    (hk : k > 0) (ht : t > 0) :
    perimeter_rate k (meristem_radius R0 v t) = k * R0 + (k * v) * t ∧
    perimeter_rate k (meristem_radius R0 0 t) = k * R0 ∧
    (v > 0 → perimeter_rate k (meristem_radius R0 v t) > perimeter_rate k (meristem_radius R0 0 t)) ∧
    (v > 0 → k * v > 0)
"""^^pk:lean4 ;
        skos:notation "r_p(R) = k R  (initiation rate ∝ free perimeter of the initiation ring);  R(t) = R_0 + v_r t  ⇒  r_p(t) = k R_0 + (k v_r) t,  i.e. Law-2 r_0 = k R_0,  β = k v_r  (β > 0 ⇔ v_r > 0: Romanesco; β = 0 ⇔ v_r = 0: Cauliflower)" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/nature02081>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103>,
            <https://doi.org/10.1103/PhysRevE.70.046109>,
            <https://doi.org/10.1103/PhysRevLett.68.2098>,
            <https://doi.org/10.1105/tpc.2.8.755>,
            <https://doi.org/10.1126/science.1140429>,
            <https://doi.org/10.1126/science.7824951>,
            <https://doi.org/10.1126/science.abg5935> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Floral Identity Gene-Regulatory Network (TFL1 -| LFY <-> AP1/CAL + SOC1/AGL24) & Recursive Spiral Phyllotaxis with Accelerating Plastochron" ;
        pk:leanDeclaration "MathOfBiology.Loop_040.perimeter_rate" ;
        pk:leanTheorem "MathOfBiology.Loop_040.hofmeister_perimeter_plastochron_acceleration" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/przemyslaw-allometric-compound-leaf-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Bilsborough et al. (2011) Complementary Spatial Antiphase of Auxin Tooth Peaks vs CUC2 Sinus Maxima and CUC2-Promoted Up-the-Gradient PIN1 Polarization Law" ;
        dct:description "Proves that transcriptional repression of CUC2 by auxin enforces strict spatial antiphase between auxin tooth peaks (A_{tip} > K_A) and CUC2 sinus maxima (C_{sinus} > C_{tip}), while CUC2 in the sinus flanks amplifies up-the-gradient PIN1 polarization toward nascent auxin maxima | Variables: A_i: epidermal margin auxin concentration in cell i; C_i: CUC2 transcription factor expression in cell i; K_A: auxin repression half-saturation threshold; γ_{CUC2}: CUC2 promotion strength on PIN1 up-the-gradient polarization; B_j = e^{β A_j}: Boltzmann up-the-gradient auxin weight" ;
        dct:source "Bilsborough et al. (2011) PNAS 108(8):3424-3429 Figs. 1-2 & SI Appendix Eqs. 1-6; Barkoulas et al. (2008) Nat. Genet. 40:1136-1141" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L154-L317>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_037_allometric_compound_leaf.lean#L36-L61> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def pin1_polarization_weight (gamma C_i B_j : Int) : Int :=
  (1 + gamma * C_i) * B_j
theorem bilsborough_2011_auxin_cuc2_antiphase_and_pin1_promotion
    (C_max K_n A_tip_n A_sinus_n gamma C_i B_high B_low : Int)
    (hC : C_max > 0) (hK : K_n > 0) (hA : A_tip_n > A_sinus_n) :
    C_max * K_n * (K_n + A_tip_n) - C_max * K_n * (K_n + A_sinus_n) =
      C_max * K_n * (A_tip_n - A_sinus_n) ∧
    C_max * K_n * (A_tip_n - A_sinus_n) > 0 ∧
    (pin1_polarization_weight gamma C_i B_high - pin1_polarization_weight gamma C_i B_low) -
      (pin1_polarization_weight gamma 0 B_high - pin1_polarization_weight gamma 0 B_low) =
      gamma * C_i * (B_high - B_low)
"""^^pk:lean4 ;
        skos:notation "C_i = C_{max} / (1 + (A_i / K_A)^n),  w_{ij} = (1 + γ_{CUC2} C_i) e^{β A_j}  ⇒  (A_{tip} > K_A > A_{sinus} ⇒ C_{tip} < C_{sinus})  ∧  (w_{i,high} - w_{i,low})|_{C_i} - (w_{i,high} - w_{i,low})|_{0} = γ_{CUC2} C_i (e^{β A_{high}} - e^{β A_{low}})" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2019.05.011>,
            <https://doi.org/10.1038/ng.189>,
            <https://doi.org/10.1073/pnas.1015162108>,
            <https://doi.org/10.1098/rspb.1980.0015>,
            <https://doi.org/10.1101/gad.1402406>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1126/science.1248384>,
            <https://doi.org/10.7554/eLife.01967> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "1D/2D Growing Epidermal Margin Auxin–PIN1–CUC2 Feedback Loop & Differential Margin Outgrowth" ;
        pk:leanDeclaration "MathOfBiology.Loop_037.pin1_polarization_weight" ;
        pk:leanTheorem "MathOfBiology.Loop_037.bilsborough_2011_auxin_cuc2_antiphase_and_pin1_promotion" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/przemyslaw-allometric-compound-leaf-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Bilsborough et al. (2011) Smooth Margin Collapse under cuc2 Loss-of-Function or Unrepressed Ectopic CUC2 Law" ;
        dct:description "Proves why both cuc2-1 loss-of-function (C = 0) and unrepressed uniform ectopic CUC2 expression (C = C_0 without auxin repression) abolish differential margin outgrowth (v_n(tip) - v_n(sinus) = 0, I_D = 0), collapsing serrated margins into smooth untoothed blades | Variables: v_n(s): normal margin outgrowth velocity at arc-length s; G_A(s) = v_0 A(s)^m / (K_g^m + A(s)^m): auxin-promoted growth factor; η_{sinus}: sinus growth repression coefficient; C(s): CUC2 concentration" ;
        dct:source "Bilsborough et al. (2011) PNAS 108(8):3424-3429 Figs. 2-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L318-L397>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_037_allometric_compound_leaf.lean#L80-L97> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def margin_outgrowth_velocity (G_A S_max eta C : Int) : Int :=
  G_A * (S_max - eta * C)
theorem bilsborough_2011_mutant_smooth_margin_collapse
    (G_0 G_tip G_sinus S_max eta C_0 C_tip C_sinus : Int) :
    margin_outgrowth_velocity G_0 S_max eta 0 -
      margin_outgrowth_velocity G_0 S_max eta 0 = 0 ∧
    margin_outgrowth_velocity G_0 S_max eta C_0 -
      margin_outgrowth_velocity G_0 S_max eta C_0 = 0 ∧
    margin_outgrowth_velocity G_tip S_max eta C_tip -
      margin_outgrowth_velocity G_sinus S_max eta C_sinus =
      (G_tip - G_sinus) * (S_max - eta * C_tip) + G_sinus * eta * (C_sinus - C_tip)
"""^^pk:lean4 ;
        skos:notation "v_n(s) = G_A(s) (1 - η_{sinus} C(s))  ⇒  v_n(tip) - v_n(sinus) = (G_{tip} - G_{sinus})(1 - η_{sinus} C_{tip}) + G_{sinus} η_{sinus} (C_{sinus} - C_{tip}) = 0  when  (C ≡ 0 ∨ C ≡ C_0) ∧ G_{tip} = G_{sinus}" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2019.05.011>,
            <https://doi.org/10.1038/ng.189>,
            <https://doi.org/10.1073/pnas.1015162108>,
            <https://doi.org/10.1098/rspb.1980.0015>,
            <https://doi.org/10.1101/gad.1402406>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1126/science.1248384>,
            <https://doi.org/10.7554/eLife.01967> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "1D/2D Growing Epidermal Margin Auxin–PIN1–CUC2 Feedback Loop & Differential Margin Outgrowth" ;
        pk:leanDeclaration "MathOfBiology.Loop_037.margin_outgrowth_velocity" ;
        pk:leanTheorem "MathOfBiology.Loop_037.bilsborough_2011_mutant_smooth_margin_collapse" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/przemyslaw-allometric-compound-leaf-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Vlad et al. (2014) & Kierzkowski et al. (2019) RCO Sinus Growth Repression Enhances Tooth-to-Leaflet Dissection Depth Index Law" ;
        dct:description "Proves that local RCO sinus growth repression in Cardamine hirsuta (η_{Cardamine} > η_{Arabidopsis}) strictly increases the tooth-to-sinus dissection depth R_{tip} - R_{sinus} without retarding tip outgrowth, transforming shallow Arabidopsis serrations into deeply incised compound leaflets reaching the rachis | Variables: R_{tip}, R_{sinus}(η): radial margin outgrowth at tooth/leaflet tips and sinuses after time T from primordium radius R_0; η_{Arabidopsis}, η_{Cardamine}: sinus growth repression strength without (Arabidopsis) vs with (Cardamine hirsuta) RCO homeobox expression; I_D = (R_{tip} - R_{sinus}) / R_{tip}: tooth-to-leaflet dissection depth index" ;
        dct:source "Vlad et al. (2014) Science 343(6172):780-783 Figs. 1-4; Kierzkowski et al. (2019) Cell 177(6):1405-1418 Figs. 2-6" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L417-L647>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_037_allometric_compound_leaf.lean#L116-L146> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def tip_radius (R_0 T G_tip S_max : Int) : Int :=
  R_0 + T * G_tip * S_max
def sinus_radius (R_0 T G_sinus S_max eta C_sinus : Int) : Int :=
  R_0 + T * G_sinus * (S_max - eta * C_sinus)
def dissection_depth_numerator (R_0 T G_tip G_sinus S_max eta C_sinus : Int) : Int :=
  tip_radius R_0 T G_tip S_max - sinus_radius R_0 T G_sinus S_max eta C_sinus
theorem kierzkowski_2019_rco_compound_leaflet_dissection_enhancement
    (R_0 T G_tip G_sinus S_max eta_Cardamine eta_Arabidopsis C_sinus : Int)
    (hT : T > 0) (hG : G_sinus > 0) (hC : C_sinus > 0) (hEta : eta_Cardamine > eta_Arabidopsis) :
    dissection_depth_numerator R_0 T G_tip G_sinus S_max eta_Cardamine C_sinus -
      dissection_depth_numerator R_0 T G_tip G_sinus S_max eta_Arabidopsis C_sinus =
      T * G_sinus * C_sinus * (eta_Cardamine - eta_Arabidopsis) ∧
    dissection_depth_numerator R_0 T G_tip G_sinus S_max eta_Cardamine C_sinus >
      dissection_depth_numerator R_0 T G_tip G_sinus S_max eta_Arabidopsis C_sinus
"""^^pk:lean4 ;
        skos:notation "I_D(η) = (R_{tip} - R_{sinus}(η)) / R_{tip},  D(η_{Cardamine}) - D(η_{Arabidopsis}) = T G_{sinus} C_{sinus} (η_{Cardamine} - η_{Arabidopsis}) > 0  for  η_{Cardamine} > η_{Arabidopsis}" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2019.05.011>,
            <https://doi.org/10.1038/ng.189>,
            <https://doi.org/10.1073/pnas.1015162108>,
            <https://doi.org/10.1098/rspb.1980.0015>,
            <https://doi.org/10.1101/gad.1402406>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1126/science.1248384>,
            <https://doi.org/10.7554/eLife.01967> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "1D/2D Growing Epidermal Margin Auxin–PIN1–CUC2 Feedback Loop & Differential Margin Outgrowth" ;
        pk:leanDeclaration "MathOfBiology.Loop_037.dissection_depth_numerator" ;
        pk:leanTheorem "MathOfBiology.Loop_037.kierzkowski_2019_rco_compound_leaflet_dissection_enhancement" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/przemyslaw-allometric-compound-leaf-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hamant et al. (2008) / Sampathkumar et al. (2014) Microtubule-Reinforced Anisotropic Growth Tensor Partition Law" ;
        dct:description "Proves that the anisotropic growth tensor used for every edge of the growing cellular spring-lattice lamina redistributes growth between the vein axis and its normal without changing areal growth (γ_∥ + γ_⊥ = 2g) and strictly favours elongation along the microtubule-reinforced axis (γ_∥ − γ_⊥ = 2ga > 0); mirrored numerically by hamant_partition_identity_error() and switched off in the MT-ablation run | Variables: g: isotropic (areal) growth rate of a lamina element from the screened-Poisson growth field; a ∈ (0,1): cell-wall reinforcement anisotropy set by cortical microtubule/cellulose alignment (a_vein = 0.20 along procambial vein axes); θ: angle between a cell edge and the reinforcement axis d; γ_∥, γ_⊥: edge rest-length growth rates parallel / perpendicular to d" ;
        dct:source "Hamant et al. (2008) Science 322(5908):1650-1655; Sampathkumar et al. (2014) eLife 3:e01967; Kierzkowski et al. (2019) Cell 177(6):1405-1418 (growth-based framework with polarity-aligned anisotropy)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L949-L1054>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_037_allometric_compound_leaf.lean#L164-L192> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def anisotropic_growth_rate (g S a cos2 : Int) : Int :=
  g * (S + a * (2 * cos2 - S))
theorem hamant_2008_microtubule_anisotropic_growth_partition
    (g S a : Int) (hg : g > 0) (hS : S > 0) (ha : a > 0) :
    anisotropic_growth_rate g S a S + anisotropic_growth_rate g S a 0 = 2 * g * S ∧
    anisotropic_growth_rate g S a S - anisotropic_growth_rate g S a 0 = 2 * g * a * S ∧
    anisotropic_growth_rate g S a S > anisotropic_growth_rate g S a 0
"""^^pk:lean4 ;
        skos:notation "γ(θ) = g [1 + a (2 cos²θ − 1)]  ⇒  γ_∥ + γ_⊥ = 2g  ∧  γ_∥ − γ_⊥ = 2 g a > 0  (integer form γ(cos2) = g (S + a (2 cos2 − S)) with unit scale S)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2019.05.011>,
            <https://doi.org/10.1038/ng.189>,
            <https://doi.org/10.1073/pnas.1015162108>,
            <https://doi.org/10.1098/rspb.1980.0015>,
            <https://doi.org/10.1101/gad.1402406>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1126/science.1248384>,
            <https://doi.org/10.7554/eLife.01967> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "1D/2D Growing Epidermal Margin Auxin–PIN1–CUC2 Feedback Loop & Differential Margin Outgrowth" ;
        pk:leanDeclaration "MathOfBiology.Loop_037.anisotropic_growth_rate" ;
        pk:leanTheorem "MathOfBiology.Loop_037.hamant_2008_microtubule_anisotropic_growth_partition" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/przemyslaw-allometric-compound-leaf-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Mitchison (1980) Flux-Canalization Conductance Feedback Law (lateral vein differentiation from marginal auxin convergence points)" ;
        dct:description "Proves the monotone feedback that turns the sparse-solved auxin flux field into discrete lateral vein strands draining every marginal convergence point into the midvein (4/4 for Arabidopsis WT, 6/6 for Cardamine WT, none in cuc2-1); the vein edges then define the reinforcement axis d of equation 4 | Variables: a_i: auxin potential at lamina vertex i (unit sources at the boundary vertices nearest each CUC2-flanked convergence peak, sink on the procambial midvein); D_{ij}: cell-cell interface conductance (edge); q_{ij}: auxin flux through the edge; k = 60: flux-feedback gain; μ = 0.80: conductance decay; Δt = 0.25: canalization step; vein edge ⇔ D ≥ 5 D_0" ;
        dct:source "Mitchison (1980) Proc. R. Soc. Lond. B 207:79-109; Scarpella, Marcos, Friml & Berleth (2006) Genes Dev 20(8):1015-1027 (marginal convergence points initiate vein strands)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L895-L947>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_037_allometric_compound_leaf.lean#L206-L224> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def conductance_update (D dt k mu q : Int) : Int :=
  D + dt * (k * q * q - mu * D)
theorem mitchison_1980_canalization_conductance_feedback
    (D dt k mu q : Int) (hdt : dt > 0) (hmu : mu > 0) (hD : D > 0)
    (hpos : k * q * q > mu * D) :
    conductance_update D dt k mu q > D ∧ conductance_update D dt k mu 0 < D
"""^^pk:lean4 ;
        skos:notation "q_{ij} = D_{ij}(a_i − a_j),  D'_{ij} = D_{ij} + Δt (k q_{ij}² − μ D_{ij})  ⇒  (k q² > μ D ⇒ D' > D)  ∧  (q = 0, μ > 0, D > 0 ⇒ D' < D)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2019.05.011>,
            <https://doi.org/10.1038/ng.189>,
            <https://doi.org/10.1073/pnas.1015162108>,
            <https://doi.org/10.1098/rspb.1980.0015>,
            <https://doi.org/10.1101/gad.1402406>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1126/science.1248384>,
            <https://doi.org/10.7554/eLife.01967> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "1D/2D Growing Epidermal Margin Auxin–PIN1–CUC2 Feedback Loop & Differential Margin Outgrowth" ;
        pk:leanDeclaration "MathOfBiology.Loop_037.conductance_update" ;
        pk:leanTheorem "MathOfBiology.Loop_037.mitchison_1980_canalization_conductance_feedback" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/raspopovic-bmp-sox9-wnt-digits-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Raspopovic et al. (2014) Reduced 2-Diffuser Jacobian Determinant Cancellation & Indirect Self-Activation Law" ;
        dct:description "Proves that eliminating the immobile transcription factor Sox9 yields an effective 2-diffuser Jacobian where double-negative Sox9-Wnt mutual inhibition generates positive effective self-activation J_WW > 0 without direct Bmp or Wnt self-activation | Variables: S: cell-autonomous Sox9 transcription factor (D_S = 0); B: diffusible Bmp ligand; W: diffusible Wnt ligand; k_sb, k_sw, k_bs, k_ws: regulatory coupling rates" ;
        dct:source "Raspopovic et al. (2014) Science 345:566-570 Fig. 2E & Supplementary Materials Sec. 1.2; Marcon et al. (2016) eLife 5:e14022" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L125-L215>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_016_bmp_sox9_wnt_digits.lean#L27-L44> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def jeff_det_expanded (mu_B mu_W k_sb k_sw k_bs k_ws : Int) : Int :=
  (-mu_B - k_bs * k_sb) * (k_ws * k_sw - mu_W) - (k_bs * k_sw) * (-k_ws * k_sb)
def jeff_det_reduced (mu_B mu_W k_sb k_sw k_bs k_ws : Int) : Int :=
  mu_B * mu_W + k_bs * k_sb * mu_W - k_ws * k_sw * mu_B
theorem raspopovic_reduced_jacobian_det_cancellation (mu_W : Int) (h_loop : k_ws_sw ≥ mu_W + 1) :
    jeff_det_expanded 120 150 25 22 18 20 = jeff_det_reduced 120 150 25 22 18 20 ∧
    jeff_det_reduced 120 150 25 22 18 20 = 32700 ∧
    jeff_ww_entry 150 22 20 = 290 ∧
    (k_ws_sw - mu_W ≥ 1)
"""^^pk:lean4 ;
        skos:notation "J_eff = [[-μ_B - k_bs k_sb / μ_S, +k_bs k_sw / μ_S], [-k_ws k_sb / μ_S, +k_ws k_sw / μ_S - μ_W]];  det(-J_3) = μ_S det(J_eff) = μ_S μ_B μ_W + k_bs k_sb μ_W - k_ws k_sw μ_B" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/978-1-4615-6983-1_6>,
            <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1371/journal.pbio.1000420>,
            <https://doi.org/10.1371/journal.pcbi.1001071>,
            <https://doi.org/10.1371/journal.pgen.1003467>,
            <https://doi.org/10.7554/eLife.14022> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Three-Node Receptor-Ligand Digit Network (Immobile Transcription Factor Sox9 + Diffusing Bmp & Wnt)" ;
        pk:leanDeclaration "MathOfBiology.Loop_016.jeff_det_expanded" ;
        pk:leanTheorem "MathOfBiology.Loop_016.raspopovic_reduced_jacobian_det_cancellation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/raspopovic-bmp-sox9-wnt-digits-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Raspopovic et al. (2014) Diffusion-Driven Turing Dispersion Sign Inversion Law" ;
        dct:description "Establishes diffusion-driven symmetry breaking from a linearly stable homogeneous state (tr(J_eff) < 0, det(J_eff) > 0) and determines the distal FGF-modulated digit wavelength λ(F) | Variables: q: spatial wavenumber; D_B, D_W: Bmp and Wnt diffusion coefficients; σ_max(q): dominant dispersion growth rate; λ_c = 2π / q_c: intrinsic digit spacing wavelength" ;
        dct:source "Raspopovic et al. (2014) Science 345:566-570 Fig. 2E, Fig. 4A-D & Supplementary Eqs. S1-S6" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L165-L260>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_016_bmp_sox9_wnt_digits.lean#L59-L70> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def turing_disp_det (J_BB J_BW J_WB J_WW D_B D_W q2 : Int) : Int :=
  (D_B * q2 - J_BB) * (D_W * q2 - J_WW) - J_BW * J_WB
theorem raspopovic_turing_dispersion_sign_inversion (q2 : Int) :
    (-570 + 290 : Int) = -280 ∧
    turing_disp_det (-570) 396 (-500) 290 250 25 0 = 32700 ∧
    turing_disp_det (-570) 396 (-500) 290 250 25 4 = -100300 ∧
    turing_disp_det (-570) 396 (-500) 290 0 0 q2 = 32700
"""^^pk:lean4 ;
        skos:notation "Δ_eff(q^2) = (D_B q^2 - J_BB)(D_W q^2 - J_WW) - J_BW J_WB;  Δ_eff(0) > 0,  Δ_eff(q_c^2) < 0  ⇒  σ_max(q_c) > 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/978-1-4615-6983-1_6>,
            <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1371/journal.pbio.1000420>,
            <https://doi.org/10.1371/journal.pcbi.1001071>,
            <https://doi.org/10.1371/journal.pgen.1003467>,
            <https://doi.org/10.7554/eLife.14022> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Three-Node Receptor-Ligand Digit Network (Immobile Transcription Factor Sox9 + Diffusing Bmp & Wnt)" ;
        pk:leanDeclaration "MathOfBiology.Loop_016.turing_disp_det" ;
        pk:leanTheorem "MathOfBiology.Loop_016.raspopovic_turing_dispersion_sign_inversion" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/raspopovic-bmp-sox9-wnt-digits-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Raspopovic et al. (2014) Out-of-Phase Digit-Interdigit Eigenmode Opposition Law" ;
        dct:description "Proves why Sox9 pre-cartilage digit condensations form strictly out of phase (180° anti-correlated) with both Bmp and Wnt interdigital signaling domains, while Bmp and Wnt co-localize in the interdigits | Variables: δS, δB, δW: spatial Turing eigenmode amplitudes of Sox9, Bmp, and Wnt; γ_B, γ_W: effective wavenumber clearance rates" ;
        dct:source "Raspopovic et al. (2014) Science 345:566-570 Fig. 2E-F & p. 567" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L220-L340>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_016_bmp_sox9_wnt_digits.lean#L84-L96> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def sox9_ligand_phase_product (k_rep : Int) (dS_sq : Int) : Int :=
  -k_rep * dS_sq
theorem raspopovic_out_of_phase_eigenmode_opposition (dS_sq : Int) (hd : dS_sq ≥ 1) :
    sox9_ligand_phase_product 1 dS_sq ≤ -1 ∧
    sox9_ligand_phase_product 18 100 = -1800 ∧
    sox9_ligand_phase_product 20 100 = -2000 ∧
    ((-18 * 10 : Int) * (-20 * 10 : Int)) = 36000
"""^^pk:lean4 ;
        skos:notation "δB / δS = -k_bs / (μ_B + D_B q^2 + σ) < 0,  δW / δS = -k_ws / (μ_W + D_W q^2 + σ) < 0  ⇒  corr(Sox9, Bmp) ≈ -1, corr(Sox9, Wnt) ≈ -1" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/978-1-4615-6983-1_6>,
            <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1371/journal.pbio.1000420>,
            <https://doi.org/10.1371/journal.pcbi.1001071>,
            <https://doi.org/10.1371/journal.pgen.1003467>,
            <https://doi.org/10.7554/eLife.14022> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Three-Node Receptor-Ligand Digit Network (Immobile Transcription Factor Sox9 + Diffusing Bmp & Wnt)" ;
        pk:leanDeclaration "MathOfBiology.Loop_016.sox9_ligand_phase_product" ;
        pk:leanTheorem "MathOfBiology.Loop_016.raspopovic_out_of_phase_eigenmode_opposition" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/raspopovic-bmp-sox9-wnt-digits-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Crampin-Gaffney-Maini (1999) Growth-Dilution Shift of the Raspopovic Turing Dispersion Relation" ;
        dct:description "Fixes how fast the limb bud may grow out while the Bmp-Sox9-Wnt network still patterns: the discrete lumped-mass update M(t+dt) c(t+dt) = M(t)[c + dt f(c)] on the moving FEM mesh realises exp(-ρ dt) exactly, and the measured 1D dilution sweep gives slope -1.000 and threshold ρ_c = 0.265 vs σ_max = 0.2608 | Variables: ρ = div(u): dilution rate of the growing Lagrangian domain; Δ_ρ(q^2): dispersion determinant with dilution; σ_eff(ρ) = σ(q) - ρ: effective Turing growth rate" ;
        dct:source "Crampin EJ, Gaffney EA, Maini PK (1999) Bull Math Biol 61:1093-1120 (doi:10.1006/bulm.1999.0131) Eq. (2.4); Raspopovic et al. (2014) Science 345:566-570 Fig. 4 growing-domain simulations" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L781-L957>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_016_bmp_sox9_wnt_digits.lean#L120-L133> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def turing_disp_det_dilution (J_BB J_BW J_WB J_WW D_B D_W q2 rho : Int) : Int :=
  (D_B * q2 + rho - J_BB) * (D_W * q2 + rho - J_WW) - J_BW * J_WB
theorem raspopovic_growth_dilution_stabilises_turing_mode (rho : Int) (h_rho : 0 ≤ rho) :
    turing_disp_det_dilution (-570) 396 (-500) 290 250 25 4 0 = -100300 ∧
    turing_disp_det_dilution (-570) 396 (-500) 290 250 25 4 100 = 47700 ∧
    turing_disp_det_dilution (-570) 396 (-500) 290 250 25 4 rho ≥
      turing_disp_det_dilution (-570) 396 (-500) 290 250 25 4 0 ∧
    (-570 + 290 : Int) - 2 * rho ≤ -280
"""^^pk:lean4 ;
        skos:notation "Lagrangian growth with div(u) = ρ ≥ 0 adds -ρ c to every species: J_eff -> J_eff - ρ I;  Δ_ρ(q^2) = (D_B q^2 + ρ - J_BB)(D_W q^2 + ρ - J_WW) - J_BW J_WB ≥ Δ_0(q^2),  tr(J_eff) - 2ρ < 0;  Δ_0(4) = -1.003 < 0 but Δ_1.0(4) = +0.477 > 0  ⇒  σ_eff = σ(q) - ρ, patterning iff ρ < σ_max = 0.2608" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/978-1-4615-6983-1_6>,
            <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1371/journal.pbio.1000420>,
            <https://doi.org/10.1371/journal.pcbi.1001071>,
            <https://doi.org/10.1371/journal.pgen.1003467>,
            <https://doi.org/10.7554/eLife.14022> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Three-Node Receptor-Ligand Digit Network (Immobile Transcription Factor Sox9 + Diffusing Bmp & Wnt)" ;
        pk:leanDeclaration "MathOfBiology.Loop_016.turing_disp_det_dilution" ;
        pk:leanTheorem "MathOfBiology.Loop_016.raspopovic_growth_dilution_stabilises_turing_mode" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/raspopovic-bmp-sox9-wnt-digits-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Sequential Digit Addition — Admissible Sox9 Ray Count is Monotone in the Distal Arc Length" ;
        dct:description "Discrete law behind the 3 -> 4 -> 5 sequential ray addition observed on the moving-boundary mesh and the final-arc sweep (slope dN/dL = 0.225 vs 1/λ = 0.250, Spearman ρ = 0.97); the Sheth et al. (2012) digit-number-vs-width observation | Variables: L_arc = 2 θ_max R(t): distal handplate arc length at the AER; λ_AER: Turing wavelength at the AER; N_rays: number of Sox9 rays that fit along the arc" ;
        dct:source "Sheth et al. (2012) Science 338:1476-1480; Raspopovic et al. (2014) Science Fig. 4; Crampin et al. (1999) mode insertion on growing domains" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L1088-L1120>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_016_bmp_sox9_wnt_digits.lean#L146-L152> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def admissible_ray_count (L lam_aer : Nat) : Nat := L / lam_aer
theorem raspopovic_ray_count_monotone_in_arc_length (L1 L2 lam_aer : Nat) (h : L1 ≤ L2) :
    admissible_ray_count L1 lam_aer ≤ admissible_ray_count L2 lam_aer ∧
    admissible_ray_count 12 4 = 3 ∧ admissible_ray_count 16 4 = 4 ∧
    admissible_ray_count 20 4 = 5 ∧ admissible_ray_count 24 4 = 6
"""^^pk:lean4 ;
        skos:notation "N_rays(L_arc) = ⌊L_arc / λ_AER⌋;  L_1 ≤ L_2  ⇒  N(L_1) ≤ N(L_2);  λ_AER = 4: L = 12, 16, 20, 24 ⇒ N = 3, 4, 5, 6" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/978-1-4615-6983-1_6>,
            <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1371/journal.pbio.1000420>,
            <https://doi.org/10.1371/journal.pcbi.1001071>,
            <https://doi.org/10.1371/journal.pgen.1003467>,
            <https://doi.org/10.7554/eLife.14022> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Three-Node Receptor-Ligand Digit Network (Immobile Transcription Factor Sox9 + Diffusing Bmp & Wnt)" ;
        pk:leanDeclaration "MathOfBiology.Loop_016.admissible_ray_count" ;
        pk:leanTheorem "MathOfBiology.Loop_016.raspopovic_ray_count_monotone_in_arc_length" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/raspopovic-bmp-sox9-wnt-digits-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "AER-Anchored Wavelength Modulation Keeps Radial Sox9 Rays Unbranched (Self-Similar Ray Count)" ;
        dct:description "Explains why the distal FGF / Hoxd gradient of Raspopovic et al. (2014) Fig. 4 keeps the digit rays unbranched on the widening autopod: with the gradient (fgf_mode=scaled) the FEM bifurcation range is 0 in 3/3 seeds, without it (fgf_mode=none) rays merge/split (range up to 2) | Variables: θ: fan half-angle; r: radial (proximodistal) position; R(t): current AER radius; λ_AER: wavelength at the AER" ;
        dct:source "Raspopovic et al. (2014) Science 345:566-570 Fig. 4A-D & p. 569; Sheth et al. (2012) Science 338:1476-1480" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-raspopovic-bmp-sox9-wnt-digits.py#L850-L856>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_016_bmp_sox9_wnt_digits.lean#L166-L168> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem raspopovic_scaled_gradient_ray_count_invariant (theta2 r R lam_aer : Int) :
    (theta2 * r) * (lam_aer * R) = (theta2 * R) * (lam_aer * r) := by
  ac_rfl
"""^^pk:lean4 ;
        skos:notation "λ(r, t) = λ_AER · r / R(t)  (D ∝ (r/R(t))^2, σ_max invariant)  ⇒  2θ r / λ(r) = 2θ R / λ_AER independent of r;  cross-multiplied: (2θ r)(λ_AER R) = (2θ R)(λ_AER r)" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/978-1-4615-6983-1_6>,
            <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1371/journal.pbio.1000420>,
            <https://doi.org/10.1371/journal.pcbi.1001071>,
            <https://doi.org/10.1371/journal.pgen.1003467>,
            <https://doi.org/10.7554/eLife.14022> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Three-Node Receptor-Ligand Digit Network (Immobile Transcription Factor Sox9 + Diffusing Bmp & Wnt)" ;
        pk:leanDeclaration "MathOfBiology.Loop_016.raspopovic_scaled_gradient_ray_count_invariant" ;
        pk:leanTheorem "MathOfBiology.Loop_016.raspopovic_scaled_gradient_ray_count_invariant" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/raup-shell-coiling-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Raup (1966) 4-Parameter Logarithmic Helicospiral Surface" ;
        dct:description "Spans gastropod, cephalopod, bivalve, and brachiopod shell morphospace in 3D cylindrical coordinates | Variables: W: whorl expansion rate; D: relative distance of generating curve from coiling axis; T: whorl translation rate (dz_c/dr_c); S: aperture aspect ratio" ;
        dct:source "Raup (1966) J. Paleontol. 40(5):1178-1190 Eq. (1)-(6); Noshita (2014)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7a781325/create_raup_animations.py#L72-L148>,
            <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/lean/MathOfBiology.lean#L147-L169> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def raup_whorl_radius (r0 W : Nat) : Nat → Nat
  | 0 => r0
  | k + 1 => W * raup_whorl_radius r0 W k
theorem raup_whorl_expansion_recovery (r0 W k : Nat) :
    raup_whorl_radius r0 W (k + 1) = W * raup_whorl_radius r0 W k := by rfl"""^^pk:lean4 ;
        skos:notation "r(θ, φ) = r_0 W^{θ/2π} [1 + ((1 - D)/(1 + D)) cos φ],   z(θ, φ) = r_0 T (W^{θ/2π} - 1) + r_0 W^{θ/2π} S ((1 - D)/(1 + D)) sin φ" ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Logarithmic Helicospiral Parametric Differential Geometry" ;
        pk:leanDeclaration "MathOfBiology.raup_whorl_radius" ;
        pk:leanTheorem "MathOfBiology.raup_whorl_expansion_recovery" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/raup-shell-coiling-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Generating-Curve Center Parameter Recovery Identities" ;
        dct:description "Exact inverse morphometric recovery verifying 3D mesh fidelity against input (W, D, T) across all 6 canonical shell regimes | Variables: r_c, z_c: generating-curve centroid coordinates; r_min, r_max: inner and outer aperture margins" ;
        dct:source "Raup (1966) J. Paleontol. 40(5):1178-1190; Okabe & Yoshimura (2017)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/lean/MathOfBiology.lean#L161-L173>,
            <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/measure_outputs.py#L220-L310> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def raup_axial_step (T delta_r : Nat) : Nat := T * delta_r
theorem raup_translation_rate_recovery (T delta_r : Nat) (h_pos : delta_r > 0) :
    (raup_axial_step T delta_r) / delta_r = T := by
  simp [raup_axial_step, Nat.mul_div_cancel _ h_pos]"""^^pk:lean4 ;
        skos:notation "W_rec = r_c(θ) / r_c(θ - 2π),   D_rec = r_min(θ) / r_max(θ),   T_rec = Δz_c / Δr_c" ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Logarithmic Helicospiral Parametric Differential Geometry" ;
        pk:leanDeclaration "MathOfBiology.raup_axial_step" ;
        pk:leanTheorem "MathOfBiology.raup_translation_rate_recovery" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/richman-cortical-gyrification-buckling-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Tallinen et al. (2014) Multiplicative Cortical Growth Decomposition & Critical Buckling Threshold" ;
        dct:description "Establishes the multiplicative growth decomposition of tangential cortical expansion relative to the subcortical white-matter core and the critical threshold separating lissencephaly (g <= g_c) from gyrencephaly (g > g_c) | Variables: F: total deformation gradient; F_e: elastic deformation gradient; G: tangential cortical growth tensor with linear factor g; g_c = 1.18: critical sulcal creasing threshold" ;
        dct:source "Tallinen et al. (2014) PNAS 111:12667-12672 Eq. (1) & Fig. 1-2; Tallinen et al. (2016) Nature Physics 12:588-593" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L162-L169>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_061_cortical_gyrification_folding.lean#L25-L35> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cortical_growth_excess (g g_c : Int) : Int :=
  g - g_c
theorem tallinen_critical_growth_threshold (g_c : Int) :
    cortical_growth_excess g_c g_c = 0 ∧
    ∀ dg : Nat, cortical_growth_excess (g_c + Int.ofNat (dg + 1)) g_c = Int.ofNat (dg + 1)
"""^^pk:lean4 ;
        skos:notation "F = F_e G,  G = diag(g, 1);  Δg = g - g_c = 0 ⇔ g = g_c (lissencephalic threshold)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00304699>,
            <https://doi.org/10.1038/nmat4202>,
            <https://doi.org/10.1038/nphys3632>,
            <https://doi.org/10.1073/pnas.1406015111>,
            <https://doi.org/10.1073/pnas.200033797>,
            <https://doi.org/10.1103/RevModPhys.65.851>,
            <https://doi.org/10.1126/science.1145181>,
            <https://doi.org/10.1126/science.aaa9101> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Neo-Hookean Multiplicative Cortical Growth & Elastic Subcortical Buckling / Sulcal Creasing" ;
        pk:leanDeclaration "MathOfBiology.Loop_061.cortical_growth_excess" ;
        pk:leanTheorem "MathOfBiology.Loop_061.tallinen_critical_growth_threshold" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/richman-cortical-gyrification-buckling-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Richman et al. (1975) & Tallinen et al. (2014) Cube-Law Sulcal Wavelength Scaling" ;
        dct:description "Predicts linear scaling of gyral/sulcal wavelength with cortical thickness h and cube-root scaling with cortical-to-subcortical stiffness ratio across normal, polymicrogyric, and comparative mammalian brains | Variables: λ: sulcal folding wavelength (mm); h: cortical gray-matter thickness (mm); μ_c: cortical shear modulus (kPa); μ_s: subcortical white-matter shear modulus (kPa)" ;
        dct:source "Richman et al. (1975) Science 189:18-21 Eq. (1) & Table 1; Tallinen et al. (2014) PNAS 111:12667-12672 Fig. 3-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L172-L178>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_061_cortical_gyrification_folding.lean#L51-L59> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def richman_wavelength_residual (lam h mu_c mu_s : Int) : Int :=
  3 * mu_s * (lam * lam * lam) - 2 * mu_c * (h * h * h)
theorem richman_cube_law_wavelength_stationarity (h mu_s : Int) :
    richman_wavelength_residual h h (3 * mu_s) (2 * mu_s) = 0 ∧
    richman_wavelength_residual (2 * h) h (24 * mu_s) (2 * mu_s) = 0
"""^^pk:lean4 ;
        skos:notation "U_tot(λ) ~ μ_c h^3 / λ^2 + 3 μ_s λ  ⇒  ∂U_tot/∂λ = 0  ⇔  λ = 2π h (μ_c / (3 μ_s))^(1/3)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00304699>,
            <https://doi.org/10.1038/nmat4202>,
            <https://doi.org/10.1038/nphys3632>,
            <https://doi.org/10.1073/pnas.1406015111>,
            <https://doi.org/10.1073/pnas.200033797>,
            <https://doi.org/10.1103/RevModPhys.65.851>,
            <https://doi.org/10.1126/science.1145181>,
            <https://doi.org/10.1126/science.aaa9101> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Neo-Hookean Multiplicative Cortical Growth & Elastic Subcortical Buckling / Sulcal Creasing" ;
        pk:leanDeclaration "MathOfBiology.Loop_061.richman_wavelength_residual" ;
        pk:leanTheorem "MathOfBiology.Loop_061.richman_cube_law_wavelength_stationarity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/richman-cortical-gyrification-buckling-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Zilles et al. (1988) & Tallinen et al. (2016) Gyrification Index Buried Sulcal Perimeter Law" ;
        dct:description "Quantifies the ratio of total pial surface contour to outer convex hull perimeter across human fetal gestation (GW22-GW38) and across 11 mammalian species | Variables: GI: coronal gyrification index; P_pial: total pial contour perimeter (mm); P_hull: outer convex hull perimeter (mm); N_sulci: number of sulcal infoldings; d_sulcus: mean sulcal depth (mm)" ;
        dct:source "Zilles et al. (1988) Anat. Embryol. 179:173-179; Tallinen et al. (2016) Nature Physics 12:588-593 Fig. 3-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L181-L189>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_061_cortical_gyrification_folding.lean#L74-L83> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def gyrification_perimeter_excess (P_hull n_sulci d_sulcus : Int) : Int :=
  (P_hull + 2 * n_sulci * d_sulcus) - P_hull
theorem gyrification_index_sulcal_excess (P_hull n_sulci d_sulcus : Int) :
    gyrification_perimeter_excess P_hull 0 d_sulcus = 0 ∧
    gyrification_perimeter_excess P_hull n_sulci d_sulcus = 2 * n_sulci * d_sulcus
"""^^pk:lean4 ;
        skos:notation "GI = P_pial / P_hull = 1 + (2 N_sulci d_sulcus) / P_hull ≥ 1.0  (GI = 1.0 ⇔ N_sulci = 0)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00304699>,
            <https://doi.org/10.1038/nmat4202>,
            <https://doi.org/10.1038/nphys3632>,
            <https://doi.org/10.1073/pnas.1406015111>,
            <https://doi.org/10.1073/pnas.200033797>,
            <https://doi.org/10.1103/RevModPhys.65.851>,
            <https://doi.org/10.1126/science.1145181>,
            <https://doi.org/10.1126/science.aaa9101> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Neo-Hookean Multiplicative Cortical Growth & Elastic Subcortical Buckling / Sulcal Creasing" ;
        pk:leanDeclaration "MathOfBiology.Loop_061.gyrification_perimeter_excess" ;
        pk:leanTheorem "MathOfBiology.Loop_061.gyrification_index_sulcal_excess" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/richman-cortical-gyrification-buckling-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "(Pass 3) Generalized Swift-Hohenberg Film-on-Curved-Substrate Linear Mode Selection (Stoop et al. 2015)" ;
        dct:description "Reduced 3D surface model replacing the requested volumetric FEM: selects the Richman wavelength on the curved hemisphere, produces the Stoop hexagonal-dimple (low ε) → labyrinth with Y-junctions (high ε) transition across GW26 → GW38, and damps the uniform mode | Variables: u: inward normal buckling amplitude on the hemisphere surface; ε = ε₀ (g − g_c)/(g_GW38 − g_c): dimensionless overstress from the growth excess; k_c(x) = 2π/λ(h(x)): locally preferred wavenumber; g₂ ∝ h/R: curvature-induced quadratic coefficient (dimple-favouring); Δ: cotangent Laplace-Beltrami operator on the ellipsoid" ;
        dct:source "Stoop N, Lagrange R, Terwagne D, Reis PM, Dunkel J (2015) Nature Materials 14:337-342 Eq. (1); Cross MC, Hohenberg PC (1993) Rev. Mod. Phys. 65:851" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L515-L576>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_061_cortical_gyrification_folding.lean#L99-L113> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def sh_growth_rate (eps kc2 k2 : Int) : Int :=
  eps - (kc2 - k2) * (kc2 - k2)
theorem swift_hohenberg_fastest_mode (eps kc2 : Int) :
    sh_growth_rate eps kc2 kc2 = eps ∧
    (∀ k2 : Int, sh_growth_rate eps kc2 k2 ≤ eps) ∧
    sh_growth_rate eps kc2 0 = eps - kc2 * kc2
"""^^pk:lean4 ;
        skos:notation "∂ₜu = ε u − (1 + Δ/k_c(x)²)² u + g₂ u² − u³;  σ(k) = ε − (1 − k²/k_c²)²,  argmax_k σ = k_c,  σ(0) = ε − 1 < 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00304699>,
            <https://doi.org/10.1038/nmat4202>,
            <https://doi.org/10.1038/nphys3632>,
            <https://doi.org/10.1073/pnas.1406015111>,
            <https://doi.org/10.1073/pnas.200033797>,
            <https://doi.org/10.1103/RevModPhys.65.851>,
            <https://doi.org/10.1126/science.1145181>,
            <https://doi.org/10.1126/science.aaa9101> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Neo-Hookean Multiplicative Cortical Growth & Elastic Subcortical Buckling / Sulcal Creasing" ;
        pk:leanDeclaration "MathOfBiology.Loop_061.sh_growth_rate" ;
        pk:leanTheorem "MathOfBiology.Loop_061.swift_hohenberg_fastest_mode" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/richman-cortical-gyrification-buckling-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "(Pass 3) Regional Cortical-Thickness Gradient ⇒ Regional Sulcal Wavelength Ratio" ;
        dct:description "Applies the Richman cube law locally to a regional thickness gradient and tests that the nonlinear 3D planform adapts its wavelength regionally (no locking): emergent slope 1.006, r = 1.0000 over the 4-point sweep | Variables: h₀ = 2.60 mm: mean cortical thickness; β ∈ {0, 0.1, 0.2, 0.3}: anterior-posterior gradient (β = 0.3 spans 2.08-3.12 mm, inside the Fischl & Dale 2000 regional range); x/a ∈ [-1, 1]: normalised AP coordinate; λ_ant, λ_post: emergent wavelengths in the anterior / posterior thirds" ;
        dct:source "Richman et al. (1975) Science 189:18-21 Eq. (1); Fischl B, Dale AM (2000) PNAS 97:11050-11055 (regional thickness range)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L760-L802>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_061_cortical_gyrification_folding.lean#L128-L137> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def local_wavelength (C h : Int) : Int :=
  C * h
theorem regional_wavelength_tracks_thickness (C h_ant h_post h0 d b : Int) :
    local_wavelength C h_ant * h_post = local_wavelength C h_post * h_ant ∧
    local_wavelength C (h0 * (d + b)) * (d - b) =
      local_wavelength C (h0 * (d - b)) * (d + b)
"""^^pk:lean4 ;
        skos:notation "h(x) = h₀ (1 + β x/a);  λ(x) = 2π h(x) (μ_c/3μ_s)^{1/3};  λ_ant/λ_post = h_ant/h_post = (1+β)/(1−β)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00304699>,
            <https://doi.org/10.1038/nmat4202>,
            <https://doi.org/10.1038/nphys3632>,
            <https://doi.org/10.1073/pnas.1406015111>,
            <https://doi.org/10.1073/pnas.200033797>,
            <https://doi.org/10.1103/RevModPhys.65.851>,
            <https://doi.org/10.1126/science.1145181>,
            <https://doi.org/10.1126/science.aaa9101> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Neo-Hookean Multiplicative Cortical Growth & Elastic Subcortical Buckling / Sulcal Creasing" ;
        pk:leanDeclaration "MathOfBiology.Loop_061.local_wavelength" ;
        pk:leanTheorem "MathOfBiology.Loop_061.regional_wavelength_tracks_thickness" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/richman-cortical-gyrification-buckling-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "(Pass 3) 3D Crease-Wall Gyrification Index (Law 3 lifted from coronal perimeter to hemispheric area)" ;
        dct:description "Computes the 3D gyrification index of the hemispheric planform (GW38: 2.60 vs 2.56 observed) with only the fundus length emergent; the smooth displaced-surface area ratio is reported as a lower bound | Variables: A_hull: ellipsoid hull area (mm²); L_zero: emergent u = 0 iso-contour length (marching triangles, mm) = 2 L_fundus; d̄: mean sulcal depth (mm) imported from the 2D coronal solver of the same stage; GI_3D: area-based gyrification index" ;
        dct:source "Zilles et al. (1988) Anat. Embryol. 179:173-179; Tallinen et al. (2016) Nature Physics 12:588-593 (area-based GI)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L691-L714>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_061_cortical_gyrification_folding.lean#L150-L159> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def gyrification_area_excess (A_hull L_f d : Int) : Int :=
  (A_hull + 2 * L_f * d) - A_hull
theorem gyrification_index_3d_crease_wall (A_hull L_f d : Int) :
    gyrification_area_excess A_hull 0 d = 0 ∧
    gyrification_area_excess A_hull L_f d = (2 * L_f) * d
"""^^pk:lean4 ;
        skos:notation "A_pial = A_hull + 2 L_fundus d̄ = A_hull + L_zero d̄;  GI_3D = A_pial/A_hull = 1 + L_zero d̄ / A_hull ≥ 1  (GI_3D = 1 ⇔ L_fundus = 0)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00304699>,
            <https://doi.org/10.1038/nmat4202>,
            <https://doi.org/10.1038/nphys3632>,
            <https://doi.org/10.1073/pnas.1406015111>,
            <https://doi.org/10.1073/pnas.200033797>,
            <https://doi.org/10.1103/RevModPhys.65.851>,
            <https://doi.org/10.1126/science.1145181>,
            <https://doi.org/10.1126/science.aaa9101> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Neo-Hookean Multiplicative Cortical Growth & Elastic Subcortical Buckling / Sulcal Creasing" ;
        pk:leanDeclaration "MathOfBiology.Loop_061.gyrification_area_excess" ;
        pk:leanTheorem "MathOfBiology.Loop_061.gyrification_index_3d_crease_wall" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/riedel-delta-notch-phase-synchrony-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Riedel-Kruse (2007) & Morelli (2009) Delayed Kuramoto Collective Frequency Shift Law" ;
        dct:description "Determines how delayed intercellular Delta-Notch signaling shifts the collective segmentation clock frequency Omega relative to the autonomous cellular rhythm omega_0 | Variables: theta_i(t): clock phase of PSM cell i; omega_0: intrinsic single-cell frequency (rad/min); kappa: Delta-Notch coupling strength (min^-1); tau_c: intercellular signaling time delay (min); Omega: synchronized collective frequency (rad/min)" ;
        dct:source "Riedel-Kruse et al. (2007) Science 317:1911-1915 Eq. 1; Morelli et al. (2009) HFSP J. 3:55-66 Eqs. 1-3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L213-L276>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_023_delta_notch_phase_synchrony.lean#L28-L56> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def delayed_kuramoto_collective_frequency (omega_0 kappa sin_delay_phase : Int) : Int :=
  omega_0 - kappa * sin_delay_phase
theorem riedel_2007_collective_frequency_shift_and_dapt_limit (omega_0 kappa sin_delay_phase : Int) :
    delayed_kuramoto_collective_frequency omega_0 0 sin_delay_phase = omega_0 ∧
    delayed_kuramoto_collective_frequency omega_0 kappa sin_delay_phase +
      delayed_kuramoto_collective_frequency omega_0 kappa (-sin_delay_phase) = 2 * omega_0"""^^pk:lean4 ;
        skos:notation "dtheta_i(t)/dt = omega_0 + (kappa / z) * sum_j sin(theta_j(t - tau_c) - theta_i(t)) + xi_i(t);  Omega = omega_0 - kappa * sin(Omega * tau_c)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00437-8>,
            <https://doi.org/10.1016/S1534-5807(02)00409-4>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1038/nature04861>,
            <https://doi.org/10.1126/science.1142538>,
            <https://doi.org/10.1126/science.1253089>,
            <https://doi.org/10.2976/1.3027088> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Delayed Kuramoto Somite Field" ;
        pk:leanDeclaration "MathOfBiology.Loop_023.delayed_kuramoto_collective_frequency" ;
        pk:leanTheorem "MathOfBiology.Loop_023.riedel_2007_collective_frequency_shift_and_dapt_limit" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/riedel-delta-notch-phase-synchrony-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Morelli (2009) Delayed Coupling Linear Stability Stiffness Criterion" ;
        dct:description "Establishes the linear stability boundary separating stable in-phase synchronization (cos(Omega*tau_c) > 0) from anti-phase checkerboard desynchronization (cos(Omega*tau_c) < 0) | Variables: kappa_eff: effective linear restoring stiffness of in-phase synchronization (min^-1); Omega*tau_c: dimensionless delay phase product (rad)" ;
        dct:source "Morelli et al. (2009) HFSP J. 3:55-66 Eqs. 4-5; Herrgen et al. (2010) Current Biology 20:1244-1253" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L213-L276>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_023_delta_notch_phase_synchrony.lean#L58-L84> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def delayed_kuramoto_effective_stiffness (kappa cos_delay_phase : Int) : Int :=
  kappa * cos_delay_phase
def delayed_phase_perturbation_step (kappa cos_delay_phase delta_theta : Int) : Int :=
  (1 - delayed_kuramoto_effective_stiffness kappa cos_delay_phase) * delta_theta
theorem morelli_2009_in_phase_stability_vs_antiphase_instability (delta_theta : Int) :
    delayed_phase_perturbation_step 1 1 delta_theta = 0 ∧
    delayed_phase_perturbation_step 1 (-1) delta_theta = 2 * delta_theta"""^^pk:lean4 ;
        skos:notation "kappa_eff = kappa * cos(Omega * tau_c) > 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00437-8>,
            <https://doi.org/10.1016/S1534-5807(02)00409-4>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1038/nature04861>,
            <https://doi.org/10.1126/science.1142538>,
            <https://doi.org/10.1126/science.1253089>,
            <https://doi.org/10.2976/1.3027088> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Delayed Kuramoto Somite Field" ;
        pk:leanDeclaration "MathOfBiology.Loop_023.delayed_kuramoto_effective_stiffness" ;
        pk:leanTheorem "MathOfBiology.Loop_023.morelli_2009_in_phase_stability_vs_antiphase_instability" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/riedel-delta-notch-phase-synchrony-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Riedel-Kruse (2007) Kuramoto Order Parameter, Anterior Limit of Defects (ALD) & Posterior Rescue Point (PRP) Law" ;
        dct:description "Predicts the ~5.5-somite delay between DAPT Notch blockade and segmentation failure (ALD) and the ~5.5-somite recovery lag between DAPT washout and posterior segmentation rescue (PRP) | Variables: R(t): Kuramoto phase coherence order parameter; s_in: somite stage of DAPT Notch blockade onset; s_out: somite stage of DAPT washout; ALD: Anterior Limit of Defects; PRP: Posterior Rescue Point" ;
        dct:source "Riedel-Kruse et al. (2007) Science 317:1911-1915 Figs. 1-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L563-L604>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_023_delta_notch_phase_synchrony.lean#L86-L116> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def anterior_limit_of_defects (s_in Delta_n_ALD : Nat) : Nat :=
  s_in + Delta_n_ALD
def posterior_rescue_point (s_out Delta_n_PRP : Nat) : Nat :=
  s_out + Delta_n_PRP
theorem riedel_2007_ald_prp_pulse_chase_window_invariance (s_in delta_s dapt_duration Delta_lag : Nat) :
    anterior_limit_of_defects (s_in + delta_s) Delta_lag =
      anterior_limit_of_defects s_in Delta_lag + delta_s ∧
    posterior_rescue_point (s_in + dapt_duration) Delta_lag -
      anterior_limit_of_defects s_in Delta_lag = dapt_duration"""^^pk:lean4 ;
        skos:notation "R(t) = |(1/N)*sum_j exp(i*theta_j(t))|;  ALD(s_in) = s_in + Delta_n_ALD;  PRP(s_out) = s_out + Delta_n_PRP" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00437-8>,
            <https://doi.org/10.1016/S1534-5807(02)00409-4>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1038/nature04861>,
            <https://doi.org/10.1126/science.1142538>,
            <https://doi.org/10.1126/science.1253089>,
            <https://doi.org/10.2976/1.3027088> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Delayed Kuramoto Somite Field" ;
        pk:leanDeclaration "MathOfBiology.Loop_023.anterior_limit_of_defects" ;
        pk:leanTheorem "MathOfBiology.Loop_023.riedel_2007_ald_prp_pulse_chase_window_invariance" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/riedel-delta-notch-phase-synchrony-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Morelli (2009) Kinematic Phase-Wave Law for an Advected FGF8/Wnt Frequency Profile" ;
        dct:description "Couples the delayed Kuramoto lattice to an advecting FGF8/Wnt frequency gradient so that posterior->anterior kinematic phase waves emerge, slow toward the determination front, and vanish for a uniform profile | Variables: omega(x): FGF8/Wnt-slaved autonomous frequency profile (rad/min); xi: distance from the tailbud (somite lengths); lambda_F: gradient decay length; v = S/T_seg: anterior cell flow speed; k(x): local phase wave number; N_w: number of kinematic waves across the PSM of length L" ;
        dct:source "Morelli et al. (2009) HFSP J. 3:55-66 (frequency profile & kinematic waves); Dubrulle et al. (2001) Cell 106:219-232 (FGF8 gradient); Soroldoni et al. (2014) Science 345:222-225 (wave kinematics)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L284-L319>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_023_delta_notch_phase_synchrony.lean#L119-L150> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def kinematic_phase_lag (Omega omega_eff dt : Int) : Int :=
  (Omega - omega_eff) * dt
theorem morelli_2009_kinematic_wave_phase_lag_law
    (Omega omega_1 omega_2 dt dt_1 dt_2 : Int) (h_omega : omega_1 ≤ omega_2) (h_dt : 0 ≤ dt) :
    kinematic_phase_lag Omega Omega dt = 0 ∧
    kinematic_phase_lag Omega omega_2 dt ≤ kinematic_phase_lag Omega omega_1 dt ∧
    kinematic_phase_lag Omega omega_1 dt_1 + kinematic_phase_lag Omega omega_1 dt_2 =
      kinematic_phase_lag Omega omega_1 (dt_1 + dt_2)"""^^pk:lean4 ;
        skos:notation "omega(xi) = omega_0 * exp(-xi/lambda_F);  k(x) = (Omega/v) * (1 - omega(x)/omega_0);  N_w = (1/S) * Int_0^L (1 - omega/omega_0) dx" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00437-8>,
            <https://doi.org/10.1016/S1534-5807(02)00409-4>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1038/nature04861>,
            <https://doi.org/10.1126/science.1142538>,
            <https://doi.org/10.1126/science.1253089>,
            <https://doi.org/10.2976/1.3027088> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Delayed Kuramoto Somite Field" ;
        pk:leanDeclaration "MathOfBiology.Loop_023.kinematic_phase_lag" ;
        pk:leanTheorem "MathOfBiology.Loop_023.morelli_2009_kinematic_wave_phase_lag_law" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/riedel-delta-notch-phase-synchrony-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Itoh (2003) Mind bomb (Mib1) DeltaC Ubiquitination Coupling Gate" ;
        dct:description "Makes the Delta-Notch coupling strength a dynamical variable: mib null abolishes coupling like DAPT, hypomorphs reduce kappa_eff monotonically, and coupling restoration after Mib1 induction or DAPT washout proceeds with finite kinetics | Variables: u: Mib1-ubiquitinated signalling-competent DeltaC fraction; M: Mib1 E3-ligase activity (1 WT, 0 mib^ta52b); k_ub, k_endo: ubiquitination and endocytic turnover rates (min^-1); g: gamma-secretase (DAPT) cleavage gate; kappa_max: coupling at full ubiquitination" ;
        dct:source "Itoh et al. (2003) Dev Cell 4:67-82; Riedel-Kruse et al. (2007) Science 317:1911-1915 (DAPT washout, mib/aei/des/bea mutants)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L322-L354>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_023_delta_notch_phase_synchrony.lean#L152-L191> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def mib1_ubiquitinated_numerator (k_ub M : Nat) : Nat :=
  k_ub * M
def mib1_ubiquitinated_denominator (k_ub k_endo M : Nat) : Nat :=
  k_ub * M + k_endo
theorem itoh_2003_mib1_ubiquitination_gate_monotone
    (k_ub k_endo M_1 M_2 : Nat) (h : M_1 ≤ M_2) :
    mib1_ubiquitinated_numerator k_ub 0 = 0 ∧
    mib1_ubiquitinated_numerator k_ub M_1 ≤ mib1_ubiquitinated_denominator k_ub k_endo M_1 ∧
    mib1_ubiquitinated_numerator k_ub M_1 * mib1_ubiquitinated_denominator k_ub k_endo M_2 ≤
      mib1_ubiquitinated_numerator k_ub M_2 * mib1_ubiquitinated_denominator k_ub k_endo M_1"""^^pk:lean4 ;
        skos:notation "du/dt = k_ub*M*(1 - u) - k_endo*u;  u_ss = k_ub M/(k_ub M + k_endo);  kappa(t) = kappa_max*u(t)*g(t);  g = 1/(1 + (C_DAPT/IC50)^n)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00437-8>,
            <https://doi.org/10.1016/S1534-5807(02)00409-4>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1038/nature04861>,
            <https://doi.org/10.1126/science.1142538>,
            <https://doi.org/10.1126/science.1253089>,
            <https://doi.org/10.2976/1.3027088> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Delayed Kuramoto Somite Field" ;
        pk:leanDeclaration "MathOfBiology.Loop_023.mib1_ubiquitinated_numerator" ;
        pk:leanTheorem "MathOfBiology.Loop_023.itoh_2003_mib1_ubiquitination_gate_monotone" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/riedel-delta-notch-phase-synchrony-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "Riedel-Kruse (2007) Emergent Defect-Span Law (ALD/PRP from R_crit crossings)" ;
        dct:description "Replaces the hard-coded ALD = s_in + 5.5 / PRP = s_out + 5.5 of Pass 2 by an emergent read-out of the simulated coherence trajectory, whose defective span is independent of the maturation lag | Variables: s_cross: somite stage at which the determination-front lateral Kuramoto R first falls below R_crit; s_recross: stage at which it first recovers above R_crit after washout/restoration; Delta_n_det: determination-to-boundary maturation lag (2.5 somites)" ;
        dct:source "Riedel-Kruse et al. (2007) Science 317:1911-1915 Figs. 2-4 (R_crit threshold model of ALD and PRP)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L544-L557>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_023_delta_notch_phase_synchrony.lean#L193-L226> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def emergent_anterior_limit_of_defects (s_cross Delta_n_det : Nat) : Nat :=
  s_cross + Delta_n_det
def emergent_posterior_rescue_point (s_recross Delta_n_det : Nat) : Nat :=
  s_recross + Delta_n_det
theorem riedel_2007_emergent_defect_span_independent_of_determination_lag
    (s_cross s_recross Delta_n_det d : Nat) (h : s_cross ≤ s_recross) :
    emergent_posterior_rescue_point s_recross Delta_n_det -
      emergent_anterior_limit_of_defects s_cross Delta_n_det = s_recross - s_cross ∧
    s_cross ≤ emergent_anterior_limit_of_defects s_cross Delta_n_det ∧
    emergent_anterior_limit_of_defects s_cross (Delta_n_det + d) =
      emergent_anterior_limit_of_defects s_cross Delta_n_det + d ∧
    emergent_posterior_rescue_point s_recross (Delta_n_det + d) =
      emergent_posterior_rescue_point s_recross Delta_n_det + d"""^^pk:lean4 ;
        skos:notation "ALD = s_cross + Delta_n_det;  PRP = s_recross + Delta_n_det;  PRP - ALD = s_recross - s_cross" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00437-8>,
            <https://doi.org/10.1016/S1534-5807(02)00409-4>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1038/nature04861>,
            <https://doi.org/10.1126/science.1142538>,
            <https://doi.org/10.1126/science.1253089>,
            <https://doi.org/10.2976/1.3027088> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Delayed Kuramoto Somite Field" ;
        pk:leanDeclaration "MathOfBiology.Loop_023.emergent_anterior_limit_of_defects" ;
        pk:leanTheorem "MathOfBiology.Loop_023.riedel_2007_emergent_defect_span_independent_of_determination_lag" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/runions-leaf-venation-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Murray (1926) / Price et al. (2013) Vascular Pipe-Model Conservation Law" ;
        dct:description "Governs basipetal vascular radius accumulation and daughter/parent cross-sectional area ratios across Horton-Strahler orders 1-8 | Variables: r_parent, r_i: parent and daughter vein radii; γ ∈ [2, 3]: vascular scaling exponent (γ = 3 Murray cube law in minor veins -> γ = 2 Da Vinci area-preserving in major veins)" ;
        dct:source "Murray (1926) PNAS 12:207; Runions et al. (2005) Sec. 3.5; Price, Knox & Brodribb (2013) PLoS ONE 8(12):e85420" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L463-L518>,
            <https://github.com/fractastical/morpholib/blob/c89d18d/morphoeval/lean/MathOfBiology.lean#L367-L403> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def ObeysMurrayLaw (γ : Nat) : VeinTree → Prop
  | VeinTree.tip _ => True
  | VeinTree.fork r l right =>
      r ^ γ = (vein_root_radius l) ^ γ + (vein_root_radius right) ^ γ ∧
      ObeysMurrayLaw γ l ∧ ObeysMurrayLaw γ right
theorem murray_1926_tree_conservation (γ : Nat) (t : VeinTree) (h : ObeysMurrayLaw γ t) :
    (vein_root_radius t) ^ γ = sum_gamma_powers γ (vein_tip_radii t)"""^^pk:lean4 ;
        skos:notation "r_parent^γ = ∑_{i ∈ children} r_i^γ,   r_root^γ = ∑_{leaf ∈ tips} r_leaf^γ" ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1145/1073204.1073251>,
            <https://doi.org/10.1371/journal.pcbi.1004680>,
            <https://doi.org/10.1371/journal.pone.0037994>,
            <https://doi.org/10.1371/journal.pone.0085420> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Auxin Space-Colonization, Murray's Minimum-Work Vascular Law & Planar Dual Loop Nesting" ;
        pk:leanDeclaration "MathOfBiology.ObeysMurrayLaw" ;
        pk:leanTheorem "MathOfBiology.murray_1926_tree_conservation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/runions-leaf-venation-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Runions et al. (2005) Eq. (2)-(3) Toussaint Relative Neighborhood Graph (RNG) Lune Law" ;
        dct:description "Attracts multiple surrounding vein tips toward a shared auxin source via empty-lune RNG neighborhoods to form closed anastomosing areole loops | Variables: s ∈ S: discrete auxin source; v ∈ V: vein node; V(s): Relative Neighborhood vein set; D: vein advance step; d_k: kill distance" ;
        dct:source "Runions, Fuhrer, Lane, Federl, Rolland-Lagan & Prusinkiewicz (2005) ACM Trans. Graph. 24(3):702-711 Eq. (1)-(3)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L183-L456>,
            <https://github.com/fractastical/morpholib/blob/c89d18d/morphoeval/lean/MathOfBiology.lean#L410-L422> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def in_rng_lune (d_vs d_us d_vu : Nat) : Prop := d_us < d_vs ∧ d_vu < d_vs
def rng_witness_excludes (d_vs d_us d_vu : Nat) : Bool := Nat.max d_us d_vu < d_vs
theorem runions_2005_rng_lune_iff (d_vs d_us d_vu : Nat) :
    rng_witness_excludes d_vs d_us d_vu = true ↔ in_rng_lune d_vs d_us d_vu := by
  simp [rng_witness_excludes, in_rng_lune, Nat.max_lt]"""^^pk:lean4 ;
        skos:notation "V(s) = {v ∈ V : ∀ u ∈ V, ||v - s|| ≤ max(||u - s||, ||v - u||)},   v' = v + D (∑_{s ∈ S(v)} (s - v)/||s - v||) / ||∑_{s ∈ S(v)} (s - v)/||s - v||||" ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1145/1073204.1073251>,
            <https://doi.org/10.1371/journal.pcbi.1004680>,
            <https://doi.org/10.1371/journal.pone.0037994>,
            <https://doi.org/10.1371/journal.pone.0085420> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Auxin Space-Colonization, Murray's Minimum-Work Vascular Law & Planar Dual Loop Nesting" ;
        pk:leanDeclaration "MathOfBiology.rng_witness_excludes" ;
        pk:leanTheorem "MathOfBiology.runions_2005_rng_lune_iff" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/runions-leaf-venation-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Euler-Poincaré Planar Areole Cycle Rank & Katifori (2012) Hierarchical Edge-Deletion Law" ;
        dct:description "Separates open dichotomous venation (L = 0, e.g. Ginkgo biloba) from closed reticulate venation (L > 0) and quantifies hierarchical loop nesting | Variables: V, E: planar vascular vertices and edges; L: enclosed areole count; r_j, s_j: merged subtree sizes in hierarchical loop decomposition; i_u: unweighted nesting number" ;
        dct:source "Katifori & Magnasco (2012) PLoS ONE 7(6):e37994; Ronellenfitsch et al. (2015) PLoS Comput. Biol. 11(12):e1004680" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L634-L712>,
            <https://github.com/fractastical/morpholib/blob/c89d18d/morphoeval/lean/MathOfBiology.lean#L430-L444> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def planar_cycle_count (edges vertices : Nat) : Nat := edges + 1 - vertices
theorem katifori_2012_tree_zero_cycles (n_edges : Nat) :
    planar_cycle_count n_edges (n_edges + 1) = 0 := by simp [planar_cycle_count]
theorem katifori_2012_edge_deletion_merges_areoles (n_edges k_bridges : Nat) (h : 1 ≤ k_bridges) :
    planar_cycle_count (n_edges + k_bridges - 1) (n_edges + 1) =
    planar_cycle_count (n_edges + k_bridges) (n_edges + 1) - 1"""^^pk:lean4 ;
        skos:notation "L = E - V + 1,   q_j = 1 - |r_j - s_j| / (r_j + s_j - 1),   i_u = (1/(N-1)) ∑_j q_j" ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1145/1073204.1073251>,
            <https://doi.org/10.1371/journal.pcbi.1004680>,
            <https://doi.org/10.1371/journal.pone.0037994>,
            <https://doi.org/10.1371/journal.pone.0085420> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Auxin Space-Colonization, Murray's Minimum-Work Vascular Law & Planar Dual Loop Nesting" ;
        pk:leanDeclaration "MathOfBiology.planar_cycle_count" ;
        pk:leanTheorem "MathOfBiology.katifori_2012_edge_deletion_merges_areoles" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/runions-pavement-cell-lobing-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Sapala et al. (2018) Largest Empty Circle (LEC) Turgor Stress Suppression Law" ;
        dct:description "Proves that puzzle-shaped interdigitation pins the Largest Empty Circle radius R_LEC near the neck half-width R_0 (~11 um) as cell area A grows 10-20x, suppressing outer periclinal wall tensile stress by >3x compared to unlobed isotropic cells | Variables: P: turgor pressure (MPa); h: outer periclinal cell wall thickness (um); R_LEC: radius of Largest Empty/Inscribed Circle inside cell contour (um); R_0: bounded neck half-width (um); N = A/(π R_0^2): effective lobe-unit area multiple" ;
        dct:source "Sapala et al. (2018) eLife 7:e32794 Figs. 1-3 & Box 1" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L215-L527>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_039_pavement_cell_lobing.lean#L31-L50> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def puzzle_lec_radius_sq (r0_sq : Int) : Int := r0_sq
def isotropic_radius_sq (N r0_sq : Int) : Int := N * r0_sq
theorem sapala_2018_lec_stress_suppression (N r0_sq : Int)
    (hN : N ≥ 2) (hr0 : r0_sq > 0) :
    isotropic_radius_sq N r0_sq - puzzle_lec_radius_sq r0_sq = (N - 1) * r0_sq ∧
    2 * puzzle_lec_radius_sq r0_sq ≤ isotropic_radius_sq N r0_sq ∧
    puzzle_lec_radius_sq r0_sq < isotropic_radius_sq N r0_sq
"""^^pk:lean4 ;
        skos:notation "σ_max = P R_LEC / (2h);  R_LEC^2(WT) = R_0^2 ≪ R_iso^2(A) = A / π = N R_0^2  (for N ≥ 2 lobes)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2004.12.026>,
            <https://doi.org/10.1016/j.cub.2013.01.022>,
            <https://doi.org/10.1038/s41477-019-0500-2>,
            <https://doi.org/10.1105/tpc.114.126664>,
            <https://doi.org/10.7554/eLife.01967>,
            <https://doi.org/10.7554/eLife.32794> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled ROP2–ROP6 Cross-Inhibitory Cortical Reaction–Diffusion, Turgor-Driven Largest Empty Circle (LEC) Stress Scaling, Reduced Föppl Pressurized Periclinal Membrane-Shell & Depth-Resolved Anticlinal Wall Buckling" ;
        pk:leanDeclaration "MathOfBiology.Loop_039.puzzle_lec_radius_sq" ;
        pk:leanTheorem "MathOfBiology.Loop_039.sapala_2018_lec_stress_suppression" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/runions-pavement-cell-lobing-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Fu et al. (2005) ROP2–ROP6 Trans-Wall Complementarity & Intercellular Area Conservation Law" ;
        dct:description "Establishes alternating ROP2 (convex lobe outgrowth) and ROP6 (concave neck microtubule bundling) domains in antiphase across shared anticlinal walls while preserving contiguous epidermal tiling without intercellular gaps | Variables: U(s,t): active cortical ROP2-RIC4 concentration; V(s,t): active cortical ROP6-RIC1-KTN1 concentration; V_opp: opposing cell cortical ROP6 across shared anticlinal wall; δ_lobe: local anticlinal wall displacement" ;
        dct:source "Fu et al. (2005) Cell 120(5):687-700 Figs. 1-7; Bidhendi et al. (2019) Nature Plants 5:981-992" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L533-L662>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_039_pavement_cell_lobing.lean#L68-L83> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cell_A_lobe_area (A0 d_lobe : Int) : Int := A0 + d_lobe
def cell_B_neck_area (B0 d_lobe : Int) : Int := B0 - d_lobe
def cortical_rop_polarity (rop2 rop6 : Int) : Int := rop2 - rop6
theorem fu_2005_rop2_rop6_trans_wall_conservation (A0 B0 d_lobe r_hi r_lo : Int) :
    cell_A_lobe_area A0 d_lobe + cell_B_neck_area B0 d_lobe = A0 + B0 ∧
    cortical_rop_polarity r_hi r_lo + cortical_rop_polarity r_lo r_hi = 0
"""^^pk:lean4 ;
        skos:notation "∂U/∂t = D_u ∂²U/∂s² + (k_0 + k_a U²/(1+U²))/(1 + γ_{26} V²) (1 + α V_opp) - k_off U;  A_A(δ) + A_B(-δ) = A_0 + B_0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2004.12.026>,
            <https://doi.org/10.1016/j.cub.2013.01.022>,
            <https://doi.org/10.1038/s41477-019-0500-2>,
            <https://doi.org/10.1105/tpc.114.126664>,
            <https://doi.org/10.7554/eLife.01967>,
            <https://doi.org/10.7554/eLife.32794> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled ROP2–ROP6 Cross-Inhibitory Cortical Reaction–Diffusion, Turgor-Driven Largest Empty Circle (LEC) Stress Scaling, Reduced Föppl Pressurized Periclinal Membrane-Shell & Depth-Resolved Anticlinal Wall Buckling" ;
        pk:leanDeclaration "MathOfBiology.Loop_039.cell_A_lobe_area" ;
        pk:leanTheorem "MathOfBiology.Loop_039.fu_2005_rop2_rop6_trans_wall_conservation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/runions-pavement-cell-lobing-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Sapala et al. (2018) & Lin et al. (2013) ktn1 / rop2 rop4 Mutant Lobeyness & Solidity Collapse Law" ;
        dct:description "Proves that loss of ROP2/ROP4 or katanin KTN1/RIC1 microtubule severing collapses lobeyness to L -> 1 and solidity to S -> 1, causing unchecked R_LEC ~ sqrt(A/pi) growth and high periclinal wall tensile stress | Variables: L = P_perim / P_hull: pavement cell lobeyness; S = A_cell / A_hull: convex solidity; k_rop: ROP2-ROP6-KTN1 mechanochemical coupling strength; A_lobe: sinusoidal lobe amplitude" ;
        dct:source "Sapala et al. (2018) eLife 7:e32794 Fig. 5; Lin et al. (2013) Current Biology 23:290-297" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L268-L407>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_039_pavement_cell_lobing.lean#L99-L115> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def lobed_perimeter (P_hull k_rop A_lobe : Int) : Int := P_hull + k_rop * A_lobe
def lobed_hull_area (A_cell k_rop A_indent : Int) : Int := A_cell + k_rop * A_indent
theorem sapala_2018_mutant_lobeyness_collapse (P_hull A_cell k_rop A_lobe A_indent : Int)
    (hk : k_rop > 0) (hA : A_lobe > 0) :
    lobed_perimeter P_hull 0 A_lobe = P_hull ∧
    lobed_perimeter P_hull k_rop 0 = P_hull ∧
    lobed_hull_area A_cell 0 A_indent = A_cell ∧
    lobed_perimeter P_hull k_rop A_lobe > P_hull
"""^^pk:lean4 ;
        skos:notation "L = P_perim / P_hull = (P_hull + k_rop A_lobe) / P_hull,  S = A_cell / (A_cell + k_rop A_indent)  ⇒  L(k_rop=0) = 1, S(k_rop=0) = 1" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2004.12.026>,
            <https://doi.org/10.1016/j.cub.2013.01.022>,
            <https://doi.org/10.1038/s41477-019-0500-2>,
            <https://doi.org/10.1105/tpc.114.126664>,
            <https://doi.org/10.7554/eLife.01967>,
            <https://doi.org/10.7554/eLife.32794> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled ROP2–ROP6 Cross-Inhibitory Cortical Reaction–Diffusion, Turgor-Driven Largest Empty Circle (LEC) Stress Scaling, Reduced Föppl Pressurized Periclinal Membrane-Shell & Depth-Resolved Anticlinal Wall Buckling" ;
        pk:leanDeclaration "MathOfBiology.Loop_039.lobed_perimeter" ;
        pk:leanTheorem "MathOfBiology.Loop_039.sapala_2018_mutant_lobeyness_collapse" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/runions-pavement-cell-lobing-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "(Pass 3) Pressurized Periclinal Föppl Membrane & Inscribed-Disk Deflection Bound" ;
        dct:description "Reduced (NOT finite-element) 3D periclinal shell: solved by sparse finite differences on the rasterised cell footprint with self-consistent tension and verified against the closed-form disk (z_max rel. err. < 1 %); used to TEST the Sapala et al. (2018) LEC stress proxy — shell stress tracks R_LEC (r = 0.98) but sub-linearly (fitted exponent ≈ 0.51 vs Laplace 1), giving an isotropic/WT stress ratio of ≈ 1.7 instead of the proxy's 3.32 | Variables: z(x,y): out-of-plane bulge of the outer periclinal wall (um); T: uniform membrane tension (uN/um); T_0 = PH/2: pretension transmitted by the pressurised anticlinal walls of depth H; E, ν: wall Young's modulus and Poisson ratio; ε̄: mean membrane stretch; σ_m: membrane stress; σ_b: clamped-edge bending boundary-layer stress; ℓ_b: bending boundary-layer width; D = E h³/(12(1-ν²))" ;
        dct:source "Sapala et al. (2018) eLife 7:e32794 Fig. 3 & Box 1 (LEC stress proxy); Timoshenko & Woinowsky-Krieger (1959) Theory of Plates and Shells (uniformly loaded circular membrane)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L668-L933>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_039_pavement_cell_lobing.lean#L134-L156> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def disk_membrane_deflection_4T (P R_sq r_sq : Int) : Int := P * (R_sq - r_sq)
theorem sapala_2018_pressurized_membrane_inscribed_disk_bound (P R_sq r_sq N r0_sq : Int)
    (hP : 0 < P) (hr : 0 ≤ r_sq) (hrR : r_sq ≤ R_sq) (hN : N ≥ 2) (hr0 : 0 < r0_sq) :
    disk_membrane_deflection_4T P R_sq r_sq ≤ disk_membrane_deflection_4T P R_sq 0 ∧
    0 ≤ disk_membrane_deflection_4T P R_sq r_sq ∧
    disk_membrane_deflection_4T P (puzzle_lec_radius_sq r0_sq) 0 <
      disk_membrane_deflection_4T P (isotropic_radius_sq N r0_sq) 0
"""^^pk:lean4 ;
        skos:notation "-T ∇²z = P on Ω, z = 0 on ∂Ω;  T = T_0 + E h ε̄/(1-ν), ε̄ = ⟨½|∇z|²⟩, T_0 = P H/2;  disk: z(r) = P (R² - r²)/(4T);  z_max(Ω) ≥ P R_LEC²/(4T);  σ_m = T/h, σ_b = 6 T θ̄_edge ℓ_b / h², ℓ_b = sqrt(D/T)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2004.12.026>,
            <https://doi.org/10.1016/j.cub.2013.01.022>,
            <https://doi.org/10.1038/s41477-019-0500-2>,
            <https://doi.org/10.1105/tpc.114.126664>,
            <https://doi.org/10.7554/eLife.01967>,
            <https://doi.org/10.7554/eLife.32794> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled ROP2–ROP6 Cross-Inhibitory Cortical Reaction–Diffusion, Turgor-Driven Largest Empty Circle (LEC) Stress Scaling, Reduced Föppl Pressurized Periclinal Membrane-Shell & Depth-Resolved Anticlinal Wall Buckling" ;
        pk:leanDeclaration "MathOfBiology.Loop_039.disk_membrane_deflection_4T" ;
        pk:leanTheorem "MathOfBiology.Loop_039.sapala_2018_pressurized_membrane_inscribed_disk_bound" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/runions-pavement-cell-lobing-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "(Pass 3) Depth-Resolved Anticlinal Wall Buckling: Outward Monotonicity & Wavenumber Ordering" ;
        dct:description "Resolves the Pass 2 anticlinal buckling with depth: under outer-junction forcing the k = 8 (24.5 um) lobe mode decays to 2.8 % of its outer amplitude at the inner face (β = 2, H = 15 um; e^-1 penetration 4 um), harmonics decay faster, and only depth-distributed forcing (ROP6-RIC1 microtubule bundles spanning the wall) keeps lobes through the full depth (inner/outer 0.70) — a model prediction verified against its analytic solution, not against a specimen | Variables: δ(s,ζ): lateral anticlinal wall deflection; s: arc length along the shared wall (L = 196 um); ζ: depth from inner (0) to outer (H) periclinal junction; δ_top(s): ROP2-ROP6 polarity-driven outer-face displacement; β = k_in H/T_a: dimensionless Robin stiffness of the inner face (0 = free, ∞ = clamped); κ = k²Δζ²: discrete squared wavenumber" ;
        dct:source "Fu et al. (2005) Cell 120:687-700; Bidhendi et al. (2019) Nature Plants 5:981-992; Armour et al. (2015) Plant Cell 27:2484-2500 (depth context)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L939-L1158>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_039_pavement_cell_lobing.lean#L164-L217> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def depth_mode (κ a : Int) : Nat → Int
  | 0 => 0
  | 1 => a
  | n + 2 => (2 + κ) * depth_mode κ a (n + 1) - depth_mode κ a n
theorem anticlinal_depth_mode_monotone_outward (κ a : Int) (hκ : 0 ≤ κ) (ha : 0 < a) :
    ∀ n : Nat, depth_mode κ a n < depth_mode κ a (n + 1) ∧ 0 < depth_mode κ a (n + 1)
theorem anticlinal_depth_mode_wavenumber_comparison (κ κ' a : Int)
    (hκ : 0 ≤ κ) (hκκ' : κ ≤ κ') (ha : 0 < a) :
    ∀ n : Nat, depth_mode κ a n ≤ depth_mode κ' a n ∧
      depth_mode κ a (n + 1) - depth_mode κ a n ≤ depth_mode κ' a (n + 1) - depth_mode κ' a n
"""^^pk:lean4 ;
        skos:notation "∂²δ/∂s² + ∂²δ/∂ζ² = 0 on [0,L]×[0,H], δ(s,H) = δ_top(s), T_a ∂δ/∂ζ(s,0) = k_in δ(s,0);  δ̂_k(ζ) = δ̂_k(H) [k cosh(kζ) + β' sinh(kζ)]/[k cosh(kH) + β' sinh(kH)], β' = β/H;  discrete clamped mode δ_{j+2} = (2 + k²Δζ²) δ_{j+1} - δ_j, δ_0 = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2004.12.026>,
            <https://doi.org/10.1016/j.cub.2013.01.022>,
            <https://doi.org/10.1038/s41477-019-0500-2>,
            <https://doi.org/10.1105/tpc.114.126664>,
            <https://doi.org/10.7554/eLife.01967>,
            <https://doi.org/10.7554/eLife.32794> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled ROP2–ROP6 Cross-Inhibitory Cortical Reaction–Diffusion, Turgor-Driven Largest Empty Circle (LEC) Stress Scaling, Reduced Föppl Pressurized Periclinal Membrane-Shell & Depth-Resolved Anticlinal Wall Buckling" ;
        pk:leanDeclaration "MathOfBiology.Loop_039.depth_mode" ;
        pk:leanTheorem "MathOfBiology.Loop_039.anticlinal_depth_mode_monotone_outward" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/santella-wormguides-celegans-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Sulston Embryonic Binary Lineage Division & 4D Nuclear Interpolation" ;
        dct:description "Reconstructs 3D embryonic morphogenesis, gastrulation, and ventral enclosure of Caenorhabditis elegans from WormGUIDES nuclear tracks | Variables: x_i(t) = (X_i, Y_i, Z_i): 3D nuclear centroid of blastomere i at embryonic minute t; founder lineages ∈ {AB, MS, E, C, D, P4}" ;
        dct:source "Santella et al. (2015) BMC Bioinformatics 16:189; Sulston et al. (1983)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7a781325/2015-santella-wormguides-celegans.py#L90-L230>,
            <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/lean/MathOfBiology.lean#L295-L303> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def nuclear_lerp (x0 x1 lam : Int) : Int := (1 - lam) * x0 + lam * x1
theorem sulston_nuclear_lerp_endpoints (x0 x1 : Int) :
    nuclear_lerp x0 x1 0 = x0 ∧ nuclear_lerp x0 x1 1 = x1 := by
  simp [nuclear_lerp]"""^^pk:lean4 ;
        skos:notation "x_i(t) = (1 - λ(t)) x_i(t_k) + λ(t) x_i(t_{k+1}),   v_i(t) = ||x_i(t + Δt) - x_i(t)|| / Δt" ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Sulston Binary Lineage Tree & 4D Spatiotemporal Trajectory Kinematics" ;
        pk:leanDeclaration "MathOfBiology.nuclear_lerp" ;
        pk:leanTheorem "MathOfBiology.sulston_nuclear_lerp_endpoints" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/savin-gut-looping-differential-growth-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Savin et al. (2011) Differential Growth Strain & Surgical Mesentery Ablation Law" ;
        dct:description "Quantifies the compressive mechanical mismatch driving midgut looping and predicts complete uncoiling upon surgical mesentery dissection or zero differential growth | Variables: L_t: relaxed intestinal tube length (mm); L_m: relaxed dorsal mesentery attachment length (mm); ε: differential growth strain" ;
        dct:source "Savin et al. (2011) Nature 476:57-62 Fig. 1d-g & p. 58" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L170-L175>,
            <https://github.com/fractastical/morpholib/blob/327729c8/morphoeval/lean/loops/Loop_062_gut_looping_differential_growth.lean#L24-L35> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def diff_growth_excess (L_t L_m : Int) : Int :=
  L_t - L_m
theorem savin_equal_growth_zero_strain (L : Int) :
    diff_growth_excess L L = 0 ∧
    ∀ dL : Nat, diff_growth_excess (L + Int.ofNat (dL + 1)) L = Int.ofNat (dL + 1)
"""^^pk:lean4 ;
        skos:notation "ε = (L_t - L_m) / L_m = L_t / L_m - 1;  ε = 0 ⇔ L_t = L_m (zero buckling force)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2008.05.001>,
            <https://doi.org/10.1038/nature10277>,
            <https://doi.org/10.1073/pnas.0803578105>,
            <https://doi.org/10.1073/pnas.1618677114>,
            <https://doi.org/10.1126/science.1238842> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Discrete Elastic Rod Coupled to a Finite-Element (CST, St.Venant-Kirchhoff) Dorsal-Mesentery Membrane: Differential-Growth Buckling" ;
        pk:leanDeclaration "MathOfBiology.Loop_062.diff_growth_excess" ;
        pk:leanTheorem "MathOfBiology.Loop_062.savin_equal_growth_zero_strain" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/savin-gut-looping-differential-growth-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Savin et al. (2011) Cube-Law Wavelength & Loop Radius Scaling Law" ;
        dct:description "Predicts embryonic gut loop wavelength and radius across chick ontogeny (E8-E16) and across 4 vertebrate species (zebra finch, quail, chick, mouse) without free species-specific parameters | Variables: λ: gut loop wavelength (mm); R: mean loop radius of curvature (mm); B_t = E_t I_t: gut rod bending stiffness; K_m = E_m h_m: mesenteric sheet tensile stiffness; ℓ_* = (E_t I_t / (E_m h_m))^(1/3)" ;
        dct:source "Savin et al. (2011) Nature 476:57-62 pp. 59-61, Figs. 3e-f & 4e-f" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L187-L205>,
            <https://github.com/fractastical/morpholib/blob/327729c8/morphoeval/lean/loops/Loop_062_gut_looping_differential_growth.lean#L53-L58> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def savin_euler_lagrange_residual (lam B_t K_m : Int) : Int :=
  K_m * (lam * lam * lam) - 2 * B_t
theorem savin_cube_law_stationarity (lam K_m : Int) :
    savin_euler_lagrange_residual lam (K_m * (lam * lam * lam)) (2 * K_m) = 0 := by
  simp [savin_euler_lagrange_residual, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
"""^^pk:lean4 ;
        skos:notation "U_tot(λ) = B_t / λ^2 + K_m λ  ⇒  ∂U_tot/∂λ = 0  ⇔  λ = c_λ (E_t I_t / (E_m h_m))^(1/3),  R = c_R (E_t I_t / (E_m h_m))^(1/3)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2008.05.001>,
            <https://doi.org/10.1038/nature10277>,
            <https://doi.org/10.1073/pnas.0803578105>,
            <https://doi.org/10.1073/pnas.1618677114>,
            <https://doi.org/10.1126/science.1238842> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Discrete Elastic Rod Coupled to a Finite-Element (CST, St.Venant-Kirchhoff) Dorsal-Mesentery Membrane: Differential-Growth Buckling" ;
        pk:leanDeclaration "MathOfBiology.Loop_062.savin_euler_lagrange_residual" ;
        pk:leanTheorem "MathOfBiology.Loop_062.savin_cube_law_stationarity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/savin-gut-looping-differential-growth-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hollow Annular Gut Tube Area Moment of Inertia Factorization Law" ;
        dct:description "Determines the quartic sensitivity of gut bending stiffness B_t = E_t I_t to outer and inner lumen radii during embryonic growth | Variables: R_t: outer gut tube radius (mm); R_i: inner lumen radius (mm); I_t: second moment of area (mm^4)" ;
        dct:source "Savin et al. (2011) Nature 476:57-62 p. 59 & Supplementary Information Sec. S2" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L178-L184>,
            <https://github.com/fractastical/morpholib/blob/327729c8/morphoeval/lean/loops/Loop_062_gut_looping_differential_growth.lean#L73-L86> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def savin_annular_inertia_scaled (R_t R_i : Int) : Int :=
  R_t * R_t * R_t * R_t - R_i * R_i * R_i * R_i
def savin_annular_inertia_factored (R_t R_i : Int) : Int :=
  (R_t - R_i) * (R_t + R_i) * (R_t * R_t + R_i * R_i)
theorem savin_annular_inertia_factorization (R_t R_i : Int) :
    savin_annular_inertia_scaled R_t R_i = savin_annular_inertia_factored R_t R_i ∧
    savin_annular_inertia_scaled 2 1 = 15 ∧
    savin_annular_inertia_scaled 3 1 = 80
"""^^pk:lean4 ;
        skos:notation "I_t = (π / 4) (R_t^4 - R_i^4) = (π / 4) (R_t - R_i)(R_t + R_i)(R_t^2 + R_i^2) > 0  for R_t > R_i" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2008.05.001>,
            <https://doi.org/10.1038/nature10277>,
            <https://doi.org/10.1073/pnas.0803578105>,
            <https://doi.org/10.1073/pnas.1618677114>,
            <https://doi.org/10.1126/science.1238842> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Discrete Elastic Rod Coupled to a Finite-Element (CST, St.Venant-Kirchhoff) Dorsal-Mesentery Membrane: Differential-Growth Buckling" ;
        pk:leanDeclaration "MathOfBiology.Loop_062.savin_annular_inertia_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_062.savin_annular_inertia_factorization" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/savin-gut-looping-differential-growth-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Apicobasal Pitx2 Stiffness Gradient Mean-Preservation Law (Pass 3 FE mesentery)" ;
        dct:description "Defines the spatially varying membrane stiffness assigned to every constant-strain triangle of the FE mesentery mesh; guarantees that sweeping a changes only the spatial distribution (not the mean) of sheet stiffness, so the emergent dN/da is a genuine heterogeneity effect | Variables: E_m: mean dorsal-mesentery Young's modulus (kPa); a: Pitx2 gradient amplitude (|a| < 1); η: apicobasal coordinate; k/n: discrete mesh level" ;
        dct:source "Kurpios et al. (2008) PNAS 105:8499-8506 (Pitx2-dependent mesenchymal condensation of the dorsal mesentery; amplitude a is a modelling assumption)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L303-L309>,
            <https://github.com/fractastical/morpholib/blob/327729c8/morphoeval/lean/loops/Loop_062_gut_looping_differential_growth.lean#L101-L115> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def pitx2_stiffness_scaled (E0 a k n : Int) : Int :=
  E0 * (n + a * (2 * k - n))
theorem savin_pitx2_gradient_mean_preserving (E0 a k n : Int) :
    pitx2_stiffness_scaled E0 a k n + pitx2_stiffness_scaled E0 a (n - k) n = 2 * (E0 * n)
"""^^pk:lean4 ;
        skos:notation "E_m(η) = E_m [1 + a (2η - 1)],  η ∈ [0,1] (dorsal root → gut edge);  E_m(η) + E_m(1-η) = 2 E_m  ⇒  ⟨E_m⟩ and ℓ_* independent of a" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2008.05.001>,
            <https://doi.org/10.1038/nature10277>,
            <https://doi.org/10.1073/pnas.0803578105>,
            <https://doi.org/10.1073/pnas.1618677114>,
            <https://doi.org/10.1126/science.1238842> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Discrete Elastic Rod Coupled to a Finite-Element (CST, St.Venant-Kirchhoff) Dorsal-Mesentery Membrane: Differential-Growth Buckling" ;
        pk:leanDeclaration "MathOfBiology.Loop_062.pitx2_stiffness_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_062.savin_pitx2_gradient_mean_preserving" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/savin-gut-looping-differential-growth-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Fan-Mesentery Triangulation Euler-Characteristic Law (Pass 3 FE mesentery)" ;
        dct:description "Certifies that the CST membrane energy is assembled over a simply connected disk-like sheet (single boundary: fixed root + gut edge + fan sides) and states the full coupled rod + membrane energy minimised by L-BFGS-B from which loop number and radius emerge | Variables: n_s: nodes along the gut edge (96); n_w: nodes across the fan (5); A_e, h_m: triangle rest area and sheet thickness; μ_e, λ_e: plane-stress Lamé moduli from E_m(η); B_t = E_t I_t; ds_t = L_t/(n_s-1)" ;
        dct:source "Savin et al. (2011) Nature 476:57-62 SI Sec. S3 (rod + stretched sheet energy); CST/St.Venant-Kirchhoff membrane: standard FE (reduced model, Pass 3)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/327729c8/2011-savin-gut-looping-differential-growth.py#L251-L300>,
            <https://github.com/fractastical/morpholib/blob/327729c8/morphoeval/lean/loops/Loop_062_gut_looping_differential_growth.lean#L127-L142> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def fan_mesh_vertices (ns nw : Nat) : Nat := ns * nw
def fan_mesh_triangles (ns nw : Nat) : Nat := 2 * ((ns - 1) * (nw - 1))
def fan_mesh_edges (ns nw : Nat) : Nat :=
  (ns - 1) * nw + ns * (nw - 1) + (ns - 1) * (nw - 1)
theorem savin_fan_mesh_euler_characteristic (ns nw : Nat) :
    (fan_mesh_vertices (ns + 1) (nw + 1) : Int) - fan_mesh_edges (ns + 1) (nw + 1)
      + fan_mesh_triangles (ns + 1) (nw + 1) = 1
"""^^pk:lean4 ;
        skos:notation "V = n_s n_w,  E = (n_s-1) n_w + n_s (n_w-1) + (n_s-1)(n_w-1),  F = 2 (n_s-1)(n_w-1)  ⇒  V - E + F = 1;  Ψ_e = μ_e tr(E²) + λ_e/2 tr(E)²,  E = (FᵀF - I)/2,  E_tot = Σ_e A_e h_m Ψ_e + Σ_i ½ (E_t A_t/ds_t)(|Δr_i| - ds_t)² + Σ_i ½ (B_t/ds_t³)|r_{i+1} - 2r_i + r_{i-1}|²" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2008.05.001>,
            <https://doi.org/10.1038/nature10277>,
            <https://doi.org/10.1073/pnas.0803578105>,
            <https://doi.org/10.1073/pnas.1618677114>,
            <https://doi.org/10.1126/science.1238842> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Discrete Elastic Rod Coupled to a Finite-Element (CST, St.Venant-Kirchhoff) Dorsal-Mesentery Membrane: Differential-Growth Buckling" ;
        pk:leanDeclaration "MathOfBiology.Loop_062.fan_mesh_edges" ;
        pk:leanTheorem "MathOfBiology.Loop_062.savin_fan_mesh_euler_characteristic" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/schnakenberg-limit-cycle-turing-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Schnakenberg (1979) Cubic Autocatalytic Equilibrium & Flux Conservation Law" ;
        dct:description "Establishes the unique positive homogeneous equilibrium (u_*, v_*) = (a+b, b/(a+b)^2) with invariant cubic flux u_*^2 v_* = b and linear total mass balance R_u + R_v = a + b - u | Variables: u: autocatalytic activator concentration; v: substrate/inhibitor concentration; a, b: dimensionless feed rates; γ: reaction-rate/area scale factor; d = D_v/D_u: diffusivity ratio" ;
        dct:source "Schnakenberg (1979) J. Theor. Biol. 81(3):389-400 Eqs. (15)-(20)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L202-L241>,
            <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L24-L37> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def schnakenberg_react_u (a u flux : Int) : Int := a - u + flux
def schnakenberg_react_v (b flux : Int) : Int := b - flux
theorem schnakenberg_equilibrium_zero_flux (a b u flux : Int) :
    schnakenberg_react_u a (a + b) b = 0 ∧
    schnakenberg_react_v b b = 0 ∧
    schnakenberg_react_u a u flux + schnakenberg_react_v b flux = a + b - u := by
  simp [schnakenberg_react_u, schnakenberg_react_v]
  omega
"""^^pk:lean4 ;
        skos:notation "∂u/∂t = γ(a - u + u^2 v) + ∇^2 u,   ∂v/∂t = γ(b - u^2 v) + d ∇^2 v,   (u_*, v_*) = (a + b, b / (a + b)^2)" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/S0006-3495(87)83275-7>,
            <https://doi.org/10.1038/253540a0>,
            <https://doi.org/10.1073/pnas.71.5.2118>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1371/journal.pcbi.1004367> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
        pk:leanDeclaration "MathOfBiology.Loop_002.schnakenberg_react_u" ;
        pk:leanTheorem "MathOfBiology.Loop_002.schnakenberg_equilibrium_zero_flux" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/schnakenberg-limit-cycle-turing-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Schnakenberg (1979) Exact Hopf Bifurcation Curve & Positive Jacobian Determinant Law" ;
        dct:description "Separates stable steady states from autonomous Poincaré-Bendixson limit-cycle oscillations across b - a = (a + b)^3 while proving det(J_0) = (a + b)^2 > 0 excludes fold bifurcations | Variables: J_0: 2x2 reaction Jacobian at (u_*, v_*); s = a + b: equilibrium activator concentration; tr(J_0): Jacobian trace; det(J_0): Jacobian determinant" ;
        dct:source "Schnakenberg (1979) J. Theor. Biol. 81(3):389-400 Eqs. (21)-(24)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L259-L289>,
            <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L46-L56> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def schnakenberg_scaled_trace (a b s_cubed : Int) : Int := (b - a) - s_cubed
def schnakenberg_jacobian_det (n : Nat) : Nat := n * n + 2 * n + 1
theorem schnakenberg_hopf_trace_and_det_pos (a s_cubed : Int) (n : Nat) :
    schnakenberg_scaled_trace a (a + s_cubed) s_cubed = 0 ∧
    schnakenberg_jacobian_det n ≥ 1 := by
  simp [schnakenberg_scaled_trace, schnakenberg_jacobian_det]
  omega
"""^^pk:lean4 ;
        skos:notation "tr(J_0) = (b - a - (a + b)^3) / (a + b) = 0  <=>  b - a = (a + b)^3,   det(J_0) = (a + b)^2 > 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/S0006-3495(87)83275-7>,
            <https://doi.org/10.1038/253540a0>,
            <https://doi.org/10.1073/pnas.71.5.2118>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1371/journal.pcbi.1004367> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
        pk:leanDeclaration "MathOfBiology.Loop_002.schnakenberg_scaled_trace" ;
        pk:leanTheorem "MathOfBiology.Loop_002.schnakenberg_hopf_trace_and_det_pos" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/schnakenberg-limit-cycle-turing-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Schnakenberg-Turing Differential-Diffusion Dispersion & Critical Ratio Law" ;
        dct:description "Proves equal diffusion (d = 1) is unconditionally stable at (a,b) = (0.1, 0.9) whereas d > d_c ≈ 8.5676 drives det(J(k^2)) < 0 and amplifies periodic Turing spots/stripes | Variables: q = k^2: squared spatial wavenumber; d = D_v/D_u: substrate-to-activator diffusivity ratio; d_c: critical Turing diffusivity ratio" ;
        dct:source "Schnakenberg (1979) J. Theor. Biol. 81:389-400 & Turing (1952) Phil. Trans. R. Soc. B 237:37-72" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L292-L340>,
            <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L68-L81> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def schnakenberg_equal_diff_det (q : Nat) : Nat := q * q + 2 * q + 100
def schnakenberg_fourier_det (d q : Int) : Int := d * q * q - (8 * d - 10) * q + 100
theorem schnakenberg_turing_instability_and_equal_diff (q : Nat) :
    schnakenberg_equal_diff_det q ≥ 100 ∧
    schnakenberg_fourier_det 1 0 = 100 ∧
    schnakenberg_fourier_det 9 3 = -5 ∧
    schnakenberg_fourier_det 18 4 = -148 := by
  refine ⟨?_, by decide, by decide, by decide⟩
  simp [schnakenberg_equal_diff_det]
"""^^pk:lean4 ;
        skos:notation "det(J(k^2)) = d k^4 - γ (d (b-a)/(a+b) - (a+b)^2) k^2 + γ^2 (a+b)^2,   d_c(a,b) = (((a+b)^2 + (a+b)√(2b(a+b))) / (b-a))^2" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/S0006-3495(87)83275-7>,
            <https://doi.org/10.1038/253540a0>,
            <https://doi.org/10.1073/pnas.71.5.2118>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1371/journal.pcbi.1004367> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
        pk:leanDeclaration "MathOfBiology.Loop_002.schnakenberg_fourier_det" ;
        pk:leanTheorem "MathOfBiology.Loop_002.schnakenberg_turing_instability_and_equal_diff" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/schnakenberg-limit-cycle-turing-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Laplace–Beltrami Spherical-Harmonic Ladder & Finite Turing Band on a Hemispherical Mound (Pass 3)" ;
        dct:description "On a hemispherical Dictyostelium mound (no-flux equator) only finitely many spherical-harmonic degrees fall inside the Turing band; mound size selects the fastest-growing degree l*(R) and mounds smaller than R_min stay homogeneous — verified numerically by simulate_schnakenberg_hemisphere and the mound-radius sweep | Variables: l: spherical-harmonic degree; R: mound radius; q_l = l(l+1)/R^2: Laplace–Beltrami eigenvalue replacing the planar k^2; q_+: upper edge of the planar Turing band; R_min: critical mound radius" ;
        dct:source "Turing (1952) Phil. Trans. R. Soc. B 237:37-72 (spherical case) & Schnakenberg (1979) kinetics; Crampin, Gaffney & Maini (1999) Bull. Math. Biol. 61:1093-1120 for the growing-stalk companion solver" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L785-L1090>,
            <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L97-L110> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def sphere_laplace_eigenvalue (l : Nat) : Nat := l * (l + 1)
theorem schnakenberg_sphere_turing_band :
    sphere_laplace_eigenvalue 0 = 0 ∧
    (∀ l : Nat, sphere_laplace_eigenvalue (l + 1) = sphere_laplace_eigenvalue l + 2 * (l + 1)) ∧
    schnakenberg_fourier_det 18 (sphere_laplace_eigenvalue 0) = 100 ∧
    schnakenberg_fourier_det 18 (sphere_laplace_eigenvalue 1) = -96 ∧
    schnakenberg_fourier_det 18 (sphere_laplace_eigenvalue 2) = -56 ∧
    schnakenberg_fourier_det 18 (sphere_laplace_eigenvalue 3) = 1084 := by
  refine ⟨rfl, ?_, by decide, by decide, by decide, by decide⟩
  intro l
  simp only [sphere_laplace_eigenvalue, Nat.mul_add, Nat.add_mul, Nat.mul_one, Nat.one_mul]
  omega
"""^^pk:lean4 ;
        skos:notation "Δ_S Y_l^m = -l(l+1)/R^2 · Y_l^m;   (l+1)(l+2) = l(l+1) + 2(l+1);   det_J(18, l(l+1)) = 100, -96, -56, 1084 for l = 0, 1, 2, 3  (γR^2 = 10 units);   R_min = sqrt(2/q_+) = 0.1297" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/S0006-3495(87)83275-7>,
            <https://doi.org/10.1038/253540a0>,
            <https://doi.org/10.1073/pnas.71.5.2118>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1371/journal.pcbi.1004367> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
        pk:leanDeclaration "MathOfBiology.Loop_002.sphere_laplace_eigenvalue" ;
        pk:leanTheorem "MathOfBiology.Loop_002.schnakenberg_sphere_turing_band" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/schnakenberg-limit-cycle-turing-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Extracellular Phosphodiesterase Degradation Shifts the Schnakenberg Hopf Curve (Pass 3)" ;
        dct:description "Extracellular cAMP phosphodiesterase moves the Hopf boundary — at fixed feed rates increasing PDE degradation destabilizes the focus into autonomous relaxation oscillations (κ = 4 is exactly Hopf at (a,b) = (1,9)); compared in the script against the 3-variable Martiel–Goldbeter (1987) cAMP relay with its own PDE rate k_e | Variables: κ = k_PDE/k_-1: first-order extracellular phosphodiesterase rate relative to Schnakenberg's X→A decay; k_e, K_m: Michaelis–Menten PDE rate and constant; s = a + b" ;
        dct:source "Schnakenberg (1979) J. Theor. Biol. 81:389-400 Eq. (24) generalized; Martiel & Goldbeter (1987) Biophys. J. 52:807-828 (doi:10.1016/S0006-3495(87)83275-7); Gerisch & Hess (1974) PNAS 71:2118-2122 (doi:10.1073/pnas.71.5.2118)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L427-L653>,
            <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L127-L140> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def schnakenberg_pde_scaled_trace (a b kappa1 s_cubed : Int) : Int :=
  kappa1 * kappa1 * kappa1 * (b - a) - s_cubed
theorem schnakenberg_pde_hopf_shift (a m kappa1 : Int) :
    schnakenberg_pde_scaled_trace a (a + m) kappa1 (kappa1 * kappa1 * kappa1 * m) = 0 ∧
    schnakenberg_pde_scaled_trace a (a + m) 1 m = 0 ∧
    schnakenberg_pde_scaled_trace 1 9 1 1000 = -992 ∧
    schnakenberg_pde_scaled_trace 1 9 5 1000 = 0 ∧
    schnakenberg_pde_scaled_trace 1 9 6 1000 = 728 := by
  refine ⟨?_, ?_, by decide, by decide, by decide⟩
  · have h : a + m - a = m := by omega
    simp only [schnakenberg_pde_scaled_trace, h, Int.sub_self]
  · simp only [schnakenberg_pde_scaled_trace]
    omega
"""^^pk:lean4 ;
        skos:notation "du/dτ = a - (1+κ) u + u^2 v  ⇒  u_* = (a+b)/(1+κ),  s(1+κ)^2 · tr(J_0) = (1+κ)^3 (b-a) - (a+b)^3,  det(J_0) = (a+b)^2/(1+κ) > 0;   Hopf: (1+κ)^3 (b-a) = (a+b)^3;   Michaelis–Menten form -k_e u/(K_m+u): u_*^2 + (K_m + k_e - a - b) u_* - (a+b) K_m = 0, k_e^Hopf(0.1, 0.9, K_m=1) = 0.12486" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/S0006-3495(87)83275-7>,
            <https://doi.org/10.1038/253540a0>,
            <https://doi.org/10.1073/pnas.71.5.2118>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1371/journal.pcbi.1004367> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
        pk:leanDeclaration "MathOfBiology.Loop_002.schnakenberg_pde_scaled_trace" ;
        pk:leanTheorem "MathOfBiology.Loop_002.schnakenberg_pde_hopf_shift" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sekimura-papilio-wing-stripe-mimicry-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Gierer–Meinhardt Homogeneous Steady State (v₀ = u₀²) & Turing Diffusion-Driven Instability Law" ;
        dct:description "Establishes the unique positive homogeneous steady state v₀ = u₀² = ((a+1)/b)² of the Gierer–Meinhardt kinetics, linear stability in the absence of diffusion (tr(J₀) < 0, d = 1), and diffusion-driven Turing instability (d f_u + g_v > 0) for d = 40 | Variables: u₀, v₀: homogeneous steady-state activator and inhibitor concentrations; a, b: Gierer–Meinhardt activator source and linear decay rates; d = D_v / D_u: inhibitor-to-activator diffusivity ratio" ;
        dct:source "Sekimura et al. (2000) Proc. R. Soc. B 267:851-859 Eqs. (2.1)-(2.4); Gierer & Meinhardt (1972) Kybernetik 12:30-39" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py#L105-L195>,
            <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_099_papilio_wing_stripe_mimicry.lean#L27-L56> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def gm_steady_residual_scaled (a b : Int) : Int :=
  a * b - b * (a + 1) + b
def gm_trace_scaled (a b : Int) : Int :=
  b * (10 - a) - (a + 10)
def gm_turing_drive_scaled (d a b : Int) : Int :=
  d * b * (10 - a) - (a + 10)
theorem gierer_meinhardt_steady_state_and_turing_instability (a b : Int) :
    gm_steady_residual_scaled a b = 0 ∧
    gm_trace_scaled 1 1 < 0 ∧
    gm_turing_drive_scaled 1 1 1 < 0 ∧
    gm_turing_drive_scaled 40 1 1 > 0
"""^^pk:lean4 ;
        skos:notation "f(u₀, v₀) = a - b u₀ + u₀²/v₀ = 0,  g(u₀, v₀) = u₀² - v₀ = 0  ⇒  u₀ = (a + 1)/b,  v₀ = u₀²,  tr(J₀) = f_u + g_v < 0,  d f_u + g_v > 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1007/s002850100133>,
            <https://doi.org/10.1038/nature12979>,
            <https://doi.org/10.1098/rspb.2000.1081>,
            <https://doi.org/10.5962/bhl.title.119515> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "2D Gierer–Meinhardt Activator–Inhibitor Reaction–Diffusion on Curved Wing Geometry with Anisotropic Vein-Directed Diffusivity ∇·(D ∇u) and Distal-to-Proximal Boundary Gradient Switching Across Batesian Mimicry Morphs" ;
        pk:leanDeclaration "MathOfBiology.Loop_099.gm_steady_residual_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_099.gierer_meinhardt_steady_state_and_turing_instability" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sekimura-papilio-wing-stripe-mimicry-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Anisotropic Vein-Directed Diffusivity Mode Selection (Stripes vs Transverse Bands)" ;
        dct:description "Proves that vein-aligned diffusivity (ε < 1) lowers the effective wavenumber of transverse-varying modes (0, 1) to select longitudinal vein-parallel stripes, whereas ε > 1 reverses mode ordering to select anteroposterior transverse bands (f. planemoides) | Variables: ε = D_⊥ / D_∥: transverse-to-vein-parallel diffusivity ratio; (m, n): longitudinal and transverse eigenmode wavenumbers; Λ(m, n; ε): anisotropic elliptic operator Rayleigh quotient" ;
        dct:source "Sekimura et al. (2000) Proc. R. Soc. B 267:851-859 Section 2(b), Table 1 & Figs. 3-6; Madzvamuse et al. (2002) J. Math. Biol. 44:489-509" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py#L200-L320>,
            <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_099_papilio_wing_stripe_mimicry.lean#L71-L82> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def anisotropic_rayleigh_scaled (m n eps_scaled : Int) : Int :=
  100 * m * m + eps_scaled * n * n
theorem anisotropic_vein_mode_selection_switch (eps_low eps_high : Int)
    (h_low : eps_low < 100) (h_high : eps_high > 100) :
    anisotropic_rayleigh_scaled 0 1 eps_low < anisotropic_rayleigh_scaled 1 0 eps_low ∧
    anisotropic_rayleigh_scaled 1 0 eps_high < anisotropic_rayleigh_scaled 0 1 eps_high ∧
    anisotropic_rayleigh_scaled 0 1 100 = anisotropic_rayleigh_scaled 1 0 100
"""^^pk:lean4 ;
        skos:notation "Λ(m, n; ε) = m² + ε n²  (ε = D_⊥ / D_∥)  ⇒  Λ(0, 1; ε) < Λ(1, 0; ε) for ε < 1,  Λ(1, 0; ε) < Λ(0, 1; ε) for ε > 1" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1007/s002850100133>,
            <https://doi.org/10.1038/nature12979>,
            <https://doi.org/10.1098/rspb.2000.1081>,
            <https://doi.org/10.5962/bhl.title.119515> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "2D Gierer–Meinhardt Activator–Inhibitor Reaction–Diffusion on Curved Wing Geometry with Anisotropic Vein-Directed Diffusivity ∇·(D ∇u) and Distal-to-Proximal Boundary Gradient Switching Across Batesian Mimicry Morphs" ;
        pk:leanDeclaration "MathOfBiology.Loop_099.anisotropic_rayleigh_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_099.anisotropic_vein_mode_selection_switch" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sekimura-papilio-wing-stripe-mimicry-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Monotonic Melanic Wing Area Expansion Across engrailed Mimicry Thresholds" ;
        dct:description "Proves pointwise and global monotonic expansion of the melanic black wing area fraction as the pigmentation threshold u_th decreases across the hippocoonides → trophonius → cenea Batesian mimicry transition | Variables: u(x): steady-state Gierer–Meinhardt activator concentration at wing coordinate x; u_th: melanin pigmentation threshold controlled by the H (engrailed) supergene allele; f_black(u_th): melanic wing area fraction" ;
        dct:source "Sekimura et al. (2000) Proc. R. Soc. B 267:851-859 Section 3, Figs. 3-5; Timmermans/Thompson et al. (2014) Nature 507:96-99" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py#L325-L445>,
            <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_099_papilio_wing_stripe_mimicry.lean#L97-L118> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def is_melanic (u_x u_th : Int) : Int :=
  if u_x > u_th then 1 else 0
def wing_melanic_count_3pt (u_th : Int) : Int :=
  is_melanic 98 u_th + is_melanic 108 u_th + is_melanic 118 u_th
theorem monotonic_melanic_wing_expansion (u_x u_th1 u_th2 : Int)
    (h_order : u_th1 <= u_th2) :
    is_melanic u_x u_th2 <= is_melanic u_x u_th1 ∧
    wing_melanic_count_3pt 112 < wing_melanic_count_3pt 104 ∧
    wing_melanic_count_3pt 104 < wing_melanic_count_3pt 94
"""^^pk:lean4 ;
        skos:notation "u_th1 ≤ u_th2  ⇒  I(u(x) > u_th2) ≤ I(u(x) > u_th1)  ∀ x ∈ Ω  ⇒  f_black(hippocoonides) < f_black(trophonius) < f_black(cenea)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1007/s002850100133>,
            <https://doi.org/10.1038/nature12979>,
            <https://doi.org/10.1098/rspb.2000.1081>,
            <https://doi.org/10.5962/bhl.title.119515> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "2D Gierer–Meinhardt Activator–Inhibitor Reaction–Diffusion on Curved Wing Geometry with Anisotropic Vein-Directed Diffusivity ∇·(D ∇u) and Distal-to-Proximal Boundary Gradient Switching Across Batesian Mimicry Morphs" ;
        pk:leanDeclaration "MathOfBiology.Loop_099.is_melanic" ;
        pk:leanTheorem "MathOfBiology.Loop_099.monotonic_melanic_wing_expansion" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/serra-gastrulation-streak-attractor-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Dipolar Polonaise Twin-Vortex Streamfunction & Midline Circulation Conservation Law" ;
        dct:description "Proves that posterior-graded marginal Myosin-II ring contractility (delta_m > 0) generates antisymmetric counter-rotating Polonaise twin vortices across the AP midline y = 0 with identically zero net circulation (Gamma_L + Gamma_R = 0), collapsing to zero dipolar flow when delta_m = 0 | Variables: psi(r, theta): 2D epiblast Polonaise streamfunction on disc of radius R = 1.15 mm; delta_m: posterior-to-anterior marginal tensile ring asymmetry; omega(x, y): vorticity; Gamma_L, Gamma_R: left and right counter-rotating vortex circulations" ;
        dct:source "Saadaoui et al. (2020) Science 367(6476):453-458 Figs. 1-3, Eqs. S4-S8; Serra et al. (2023) Nat. Methods 20:1739-1748" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L170-L275>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_050_gastrulation_streak_attractor.lean#L18-L83> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def polonaise_streamfunction (delta_m R2 r2 y : Int) : Int :=
  delta_m * (R2 - r2) * (R2 - r2) * y
def polonaise_vorticity (k_vort delta_m y : Int) : Int :=
  k_vort * delta_m * y
theorem polonaise_twin_vortex_circulation_conservation
    (k_vort delta_m R2 r2 y A_half : Int)
    (hK : k_vort > 0) (hDm : delta_m > 0) (hA : A_half > 0) :
    polonaise_streamfunction delta_m R2 r2 (-y) = -(polonaise_streamfunction delta_m R2 r2 y) ∧
    polonaise_vorticity k_vort delta_m (-y) = -(polonaise_vorticity k_vort delta_m y) ∧
    circulation_left k_vort delta_m A_half + circulation_right k_vort delta_m A_half = 0"""^^pk:lean4 ;
        skos:notation "\\eta \\nabla^2 \\mathbf{v} + \\eta_b \\nabla(\\nabla \\cdot \\mathbf{v}) = -\\nabla \\cdot (m \\mathbf{Q}),\\qquad \\psi(r,\\theta) = V_{\\text{dip}}\\, r\\left(1 - \\frac{r^2}{R^2}\\right)^2 \\sin\\theta,\\qquad \\Gamma_L + \\Gamma_R = \\int_{y>0}\\omega\\,dA + \\int_{y<0}\\omega\\,dA = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/nature08391>,
            <https://doi.org/10.1038/ncb1739>,
            <https://doi.org/10.1038/ncb3138>,
            <https://doi.org/10.1038/s41592-023-02009-y>,
            <https://doi.org/10.1126/science.1221920>,
            <https://doi.org/10.1126/science.aaw1965>,
            <https://doi.org/10.1371/journal.pone.0010571>,
            <https://doi.org/10.7554/eLife.01817> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Active Viscous Epiblast Stokes Flow, Strain-Rate Myosin Cable Alignment & Lagrangian Primitive Streak Attractor (Saadaoui-Serra-Mahadevan-Weijer Active Nematic Mechanics)" ;
        pk:leanDeclaration "MathOfBiology.Loop_050.polonaise_streamfunction" ;
        pk:leanTheorem "MathOfBiology.Loop_050.polonaise_twin_vortex_circulation_conservation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/serra-gastrulation-streak-attractor-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Strain-Rate Myosin Cable Alignment & Ingression-Amplified Midline Streak Extension Law" ;
        dct:description "Proves that simultaneous mediolateral convergence (E_yy < 0), AP extension (E_xx > 0), and apical cell ingression (div_v < 0) rotate transverse Koller's sickle fibers into an elongated AP midline primitive streak while amplifying myosin cable density | Variables: m(x, t): supracellular Myosin-II cable density; Q_{ij}: active nematic orientation tensor; E_xx = d_x v_x > 0: midline AP extension rate; E_yy = d_y v_y < 0: midline ML convergence rate; div_v = E_xx + E_yy < 0: apical mesendoderm ingression sink" ;
        dct:source "Serra et al. (2023) Nat. Methods 20:1739-1748 Eqs. 1-6; Rozbicki et al. (2015) Nat. Cell Biol. 17:397-408 Figs. 3-6" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L551-L900>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_050_gastrulation_streak_attractor.lean#L85-L152> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def myosin_ingression_feedback (alpha_net beta_m div_v m : Int) : Int :=
  alpha_net * m - beta_m * div_v * m
def nematic_midline_alignment_rate (lambda_E m E_xx E_yy : Int) : Int :=
  lambda_E * m * (E_xx - E_yy)
theorem strain_rate_myosin_feedback_streak_extension
    (alpha_net beta_m lambda_E m E_xx E_yy : Int)
    (hAlpha : alpha_net ≥ 0) (hBeta : beta_m > 0) (hLambda : lambda_E > 0)
    (hM : m > 0) (hExx : E_xx > 0) (hEyy : E_yy < 0) (hIng : E_xx + E_yy < 0) :
    midline_deviatoric_strain_2x E_xx E_yy > 0 ∧
    nematic_midline_alignment_rate lambda_E m E_xx E_yy > 0 ∧
    myosin_ingression_feedback alpha_net beta_m (E_xx + E_yy) m > alpha_net * m"""^^pk:lean4 ;
        skos:notation "\\frac{Dm}{Dt} = \\alpha_m m\\left(1 - \\frac{m}{m_{\\text{sat}}}\\right) - \\beta_m (\\nabla \\cdot \\mathbf{v}) m,\\qquad \\frac{D\\mathbf{Q}}{Dt} = \\lambda_E m \\mathbf{E}^{\\text{dev}} + [\\boldsymbol{\\omega}, \\mathbf{Q}] - \\gamma_Q \\mathbf{Q} + D_Q \\nabla^2 \\mathbf{Q}" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/nature08391>,
            <https://doi.org/10.1038/ncb1739>,
            <https://doi.org/10.1038/ncb3138>,
            <https://doi.org/10.1038/s41592-023-02009-y>,
            <https://doi.org/10.1126/science.1221920>,
            <https://doi.org/10.1126/science.aaw1965>,
            <https://doi.org/10.1371/journal.pone.0010571>,
            <https://doi.org/10.7554/eLife.01817> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Active Viscous Epiblast Stokes Flow, Strain-Rate Myosin Cable Alignment & Lagrangian Primitive Streak Attractor (Saadaoui-Serra-Mahadevan-Weijer Active Nematic Mechanics)" ;
        pk:leanDeclaration "MathOfBiology.Loop_050.myosin_ingression_feedback" ;
        pk:leanTheorem "MathOfBiology.Loop_050.strain_rate_myosin_feedback_streak_extension" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/serra-gastrulation-streak-attractor-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Saadaoui-Serra 5-Regime Perturbation Hierarchy & HH1-to-HH3 5-Fold Streak Elongation Law" ;
        dct:description "Establishes the strict ordering of primitive streak elongation and Polonaise vortex speed across all 5 experimental regimes and proves the 5-fold empirical AP/ML transformation from HH1 Koller's sickle (61x183 px) to HH3+ primitive streak (135x81 px) | Variables: aspect100_*: 100 x primitive streak AP/ML aspect ratio across WT, Vg1/Wnt twin streaks, SB431542 ingression block, SU5402 FGF-inhibited circular ring, and Y-27632 ROCK arrest; hh1_sickle_*, hh3_streak_*: specimen pixel dimensions" ;
        dct:source "Saadaoui et al. (2020) Science 367:453-458 Figs. 3-4; Serra et al. (2023) Nat. Methods Figs. 2-5; Vasiev et al. (2010) PLoS ONE 5:e10571 Fig. 1" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L906-L1053>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_050_gastrulation_streak_attractor.lean#L154-L209> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem saadaoui_serra_five_regime_streak_hierarchy :
    aspect100_wt_streak > 400 ∧
    aspect100_su5402_ring = 100 ∧
    aspect100_wt_streak > aspect100_vg1_twin ∧
    aspect100_vg1_twin > aspect100_sb431542_no_ing ∧
    aspect100_sb431542_no_ing > aspect100_su5402_ring ∧
    aspect100_su5402_ring > aspect100_y27632_rock ∧
    hh3_streak_ap_px * hh1_sickle_ml_px = 5 * (hh1_sickle_ap_px * hh3_streak_ml_px)"""^^pk:lean4 ;
        skos:notation "\\text{AP/ML}_{\\text{WT}} (4.25) > \\text{AP/ML}_{\\text{Vg1}} (3.45) > \\text{AP/ML}_{\\text{SB431542}} (2.15) > \\text{AP/ML}_{\\text{SU5402}} (1.00) > \\text{AP/ML}_{\\text{Y27632}} (0.42),\\qquad \\frac{(\\text{AP/ML})_{\\text{HH3}}}{(\\text{AP/ML})_{\\text{HH1}}} = \\frac{135/81}{61/183} = 5" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/nature08391>,
            <https://doi.org/10.1038/ncb1739>,
            <https://doi.org/10.1038/ncb3138>,
            <https://doi.org/10.1038/s41592-023-02009-y>,
            <https://doi.org/10.1126/science.1221920>,
            <https://doi.org/10.1126/science.aaw1965>,
            <https://doi.org/10.1371/journal.pone.0010571>,
            <https://doi.org/10.7554/eLife.01817> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Active Viscous Epiblast Stokes Flow, Strain-Rate Myosin Cable Alignment & Lagrangian Primitive Streak Attractor (Saadaoui-Serra-Mahadevan-Weijer Active Nematic Mechanics)" ;
        pk:leanDeclaration "MathOfBiology.Loop_050.aspect100_wt_streak" ;
        pk:leanTheorem "MathOfBiology.Loop_050.saadaoui_serra_five_regime_streak_hierarchy" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/serra-gastrulation-streak-attractor-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Wnt8c -> Nodal -> FGF8 Ligand Reaction-Diffusion Cascade Upstream of Marginal-Ring Myosin Phosphorylation (Pass 3)" ;
        dct:description "Makes the posterior-to-anterior tensile-ring asymmetry delta_m an output of a posterior-restricted marginal Wnt8c source acting through monotone Nodal and FGF8 responses on myosin phosphorylation, with the three pharmacological regimes acting at their molecular targets; the Lean theorem proves the posterior pMLC bias is produced (and preserved under FGFR block, abolished under ROCK block) for any monotone cascade | Variables: W, N, F: Wnt8c, Nodal, FGF8 ligand concentrations (D_F = 53 um^2/s, Yu et al. 2009; D_N = 3.2 um^2/s, t_1/2 = 95 min, Müller et al. 2012; D_W = 1 um^2/s assumed); c_ind: Wnt-induced streak-cell density (conservatively advected); P: pMLC activation; a_FGFR (SU5402), a_ALK (SB431542), rho_ROCK (Y-27632): receptor/kinase activities; lambda: steady-state decay length (FGF8 371 um, Nodal 162 um)" ;
        dct:source "Yu et al. (2009) Nature 461:533-536 (FGF8 source-sink gradient, D = 53 um^2/s); Müller et al. (2012) Science 336:721-724 (Nodal diffusivity/half-life); Serra et al. (2023) mechanochemical coupling; Saadaoui et al. (2020) posterior-graded ring" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L288-L447>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_050_gastrulation_streak_attractor.lean#L225-L272> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def nodal_response (g_N W : Int) : Int := g_N * W
def fgf8_response (g_F N : Int) : Int := g_F * N
def pmlc_activation (k_p rho N F : Int) : Int := k_p * rho * (N + F)
theorem ligand_cascade_posterior_myosin_asymmetry
    (k_p g_N g_F rho W_post W_ant : Int)
    (hk : k_p > 0) (hgN : g_N > 0) (hgF : g_F ≥ 0) (hrho : rho > 0)
    (hW : W_post > W_ant) (hWa : W_ant ≥ 0) :
    nodal_response g_N W_post > nodal_response g_N W_ant ∧
    pmlc_activation k_p rho (nodal_response g_N W_post) (fgf8_response g_F (nodal_response g_N W_post)) >
      pmlc_activation k_p rho (nodal_response g_N W_ant) (fgf8_response g_F (nodal_response g_N W_ant)) ∧
    pmlc_activation k_p 0 (nodal_response g_N W_post) (fgf8_response g_F (nodal_response g_N W_post)) = 0"""^^pk:lean4 ;
        skos:notation "\\partial_t W = D_W \\nabla^2 W + s_W S_{\\text{post}}(\\mathbf{x}) - k_W W,\\quad \\partial_t N = D_N \\nabla^2 N + s_N c_{\\text{ind}}\\,(1 + f_N H(N)) - k_N N,\\quad \\partial_t F = D_F \\nabla^2 F + s_F H(N) - k_F F,\\quad H(c) = \\frac{c^2}{K^2 + c^2},\\quad P = \\rho_{\\text{ROCK}} H(a_{\\text{ALK}} N)\\,(0.35 + 0.65\\, H(a_{\\text{FGFR}} F)),\\quad \\frac{Dm}{Dt} \\mathrel{+}= \\alpha_P P \\left(1 - \\frac{m}{m_{\\text{sat}}}\\right),\\quad \\lambda = \\sqrt{D/k}" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/nature08391>,
            <https://doi.org/10.1038/ncb1739>,
            <https://doi.org/10.1038/ncb3138>,
            <https://doi.org/10.1038/s41592-023-02009-y>,
            <https://doi.org/10.1126/science.1221920>,
            <https://doi.org/10.1126/science.aaw1965>,
            <https://doi.org/10.1371/journal.pone.0010571>,
            <https://doi.org/10.7554/eLife.01817> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Active Viscous Epiblast Stokes Flow, Strain-Rate Myosin Cable Alignment & Lagrangian Primitive Streak Attractor (Saadaoui-Serra-Mahadevan-Weijer Active Nematic Mechanics)" ;
        pk:leanDeclaration "MathOfBiology.Loop_050.pmlc_activation" ;
        pk:leanTheorem "MathOfBiology.Loop_050.ligand_cascade_posterior_myosin_asymmetry" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/serra-gastrulation-streak-attractor-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Reduced Trans-Epithelial Apical-Basal Wedging, Basement-Membrane Remodeling & Ingression Sink Law (Pass 3)" ;
        dct:description "Couples 3D trans-epithelial cell shape (apical constriction, basal expansion, constant-volume thickening) and Nodal/FGF-licensed basement-membrane breakdown to the 2D planar Stokes flow through an emergent ingression sink, replacing the Pass 2 prescribed Gaussian midline sink; the Lean theorem proves wedging + BM loss give a strictly negative sink divergence and strictly increasing column height. Honest reduced (2.5D column) model, not a 3D FEM | Variables: a, b: apical / basal area fractions of one epiblast column; h: column height (h_0 = 25 um assumed); Wdg: wedging index; B: basement-membrane integrity in [0, 1]; I: ingression rate (h^-1); v_sink: irrotational planar sink velocity solved spectrally from the Poisson equation" ;
        dct:source "Rozbicki et al. (2015) Nat. Cell Biol. 17:397-408 (apical constriction / cell shape change in the streak); Nakaya et al. (2008) Nat. Cell Biol. 10:765-775 (basement-membrane breakdown in gastrulation EMT); Voiculescu et al. (2014) eLife 3:e01817 (self-amplifying individual cell ingression; SB431542 block)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L453-L545>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_050_gastrulation_streak_attractor.lean#L275-L320> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def wedging_numer (a b : Int) : Int := b - a
def ingression_rate (k_ing wdg bm_loss : Int) : Int := k_ing * wdg * bm_loss
def sink_divergence (I : Int) : Int := -I
def bm_decay_step (k_bm wdg B : Int) : Int := B - k_bm * wdg * B
theorem apical_basal_wedging_ingression_sink
    (k_ing k_bm a a' b h h' B B_max : Int)
    (hab : a < b) (hk : k_ing > 0) (hkb : k_bm > 0) (hB : B < B_max) (hBpos : B > 0)
    (hvol : h' * (a' + b) = h * (a + b)) (ha' : a' < a) (ha'pos : a' > 0) (hh : h > 0) :
    wedging_numer a b > 0 ∧
    ingression_rate k_ing (wedging_numer a b) (B_max - B) > 0 ∧
    sink_divergence (ingression_rate k_ing (wedging_numer a b) (B_max - B)) < 0 ∧
    bm_decay_step k_bm (wedging_numer a b) B < B ∧
    h' > h"""^^pk:lean4 ;
        skos:notation "\\dot a = -k_{\\text{con}} \\rho_{\\text{ROCK}} \\max(m - m_c, 0)\\, a + k_{\\text{rel}}(1 - a),\\quad b = 1 + \\chi_b (1 - a) B,\\quad h = \\frac{2 h_0}{a + b},\\quad \\mathrm{Wdg} = \\frac{b - a}{b + a},\\quad \\dot B = -k_{\\text{bm}} H(a_{\\text{ALK}} N)\\left(\\tfrac12 + \\tfrac12 H(a_{\\text{FGFR}} F)\\right) \\mathrm{Wdg}\\, B,\\quad I = k_{\\text{ing}} \\mathrm{Wdg}\\,(1 - B),\\quad \\nabla \\cdot \\mathbf{v}_{\\text{sink}} = -I,\\; \\mathbf{v}_{\\text{sink}} = -\\nabla \\phi,\\; \\nabla^2 \\phi = I" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/nature08391>,
            <https://doi.org/10.1038/ncb1739>,
            <https://doi.org/10.1038/ncb3138>,
            <https://doi.org/10.1038/s41592-023-02009-y>,
            <https://doi.org/10.1126/science.1221920>,
            <https://doi.org/10.1126/science.aaw1965>,
            <https://doi.org/10.1371/journal.pone.0010571>,
            <https://doi.org/10.7554/eLife.01817> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Active Viscous Epiblast Stokes Flow, Strain-Rate Myosin Cable Alignment & Lagrangian Primitive Streak Attractor (Saadaoui-Serra-Mahadevan-Weijer Active Nematic Mechanics)" ;
        pk:leanDeclaration "MathOfBiology.Loop_050.ingression_rate" ;
        pk:leanTheorem "MathOfBiology.Loop_050.apical_basal_wedging_ingression_sink" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sharon-ripping-leaf-edge-waves-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Isometric Marginal Arc-Length Excess Accommodation & Flat-Sheet Stability Law" ;
        dct:description "Proves that out-of-plane sinusoidal edge buckling preserves isometric arc length along the stretched margin with aspect ratio A/λ = √(g_yy - 1)/(√2 π), while vanishing identically (A = 0) for a flat Euclidean metric (g_yy = 1) | Variables: g_yy(x): longitudinal target metric component along the leaf margin; A_m(x): out-of-plane wave amplitude of generation m (mm); λ_m: wave wavelength of generation m (mm); g_0: edge excess arc-length strain factor" ;
        dct:source "Sharon, Roman, Marder, Shin & Swinney (2002) Nature 419(6907):579-580; Audoly & Boudaoud (2003) Phys. Rev. Lett. 91(8):086105" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L151-L367>,
            <https://github.com/fractastical/morpholib/blob/327729c8/morphoeval/lean/loops/Loop_067_ripping_leaf_edge_waves.lean#L31-L51> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def isometric_excess_amplitude_rhs (g_excess lam : Int) : Int :=
  g_excess * (lam * lam)
theorem sharon_isometric_arclength_accommodation (g_excess lam : Int) :
    isometric_excess_amplitude_rhs 0 lam = 0 ∧
    isometric_excess_amplitude_rhs g_excess 0 = 0 ∧
    isometric_excess_amplitude_rhs g_excess (-lam) = isometric_excess_amplitude_rhs g_excess lam ∧
    (∀ g l : Nat, 0 < isometric_excess_amplitude_rhs ((g : Int) + 1) ((l : Int) + 1))
"""^^pk:lean4 ;
        skos:notation "1 + (1/4) Σ_m (2π A_m(x) / λ_m)^2 = g_yy(x) = 1 + g_0 exp(-x/ℓ)  ⇒  A_m / λ_m ∝ √(g_yy - 1),  g_0 = 0 ⇒ A_m = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/419579a>,
            <https://doi.org/10.1038/nature01958>,
            <https://doi.org/10.1038/ng1835>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103>,
            <https://doi.org/10.1073/pnas.0911954106>,
            <https://doi.org/10.1073/pnas.1015162108>,
            <https://doi.org/10.1103/PhysRevLett.91.086105>,
            <https://doi.org/10.1105/tpc.106.044792>,
            <https://doi.org/10.1105/tpc.106.045617>,
            <https://doi.org/10.1105/tpc.107.057521>,
            <https://doi.org/10.1126/science.1079354>,
            <https://doi.org/10.1511/2004.3.254> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Non-Euclidean Föppl–von Kármán Thin-Sheet Elasticity, Negative Gaussian Curvature (K < 0) & Self-Similar Multi-Generation Edge Buckling Cascades" ;
        pk:leanDeclaration "MathOfBiology.Loop_067.isometric_excess_amplitude_rhs" ;
        pk:leanTheorem "MathOfBiology.Loop_067.sharon_isometric_arclength_accommodation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sharon-ripping-leaf-edge-waves-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Negative Intrinsic Gaussian Curvature of Convexly Decaying Marginal Growth Metric" ;
        dct:description "Establishes by Gauss's Theorema Egregium that any convexly decaying marginal growth profile (g''_yy(x) > 0) induces strictly negative Gaussian curvature K(x) < 0 near the free edge, forcing out-of-plane hyperbolic buckling | Variables: K(x): intrinsic Gaussian curvature of the leaf margin metric (mm^-2); g''_yy(x): second transverse derivative of target metric; ℓ: boundary decay length (mm)" ;
        dct:source "Sharon et al. (2002) Nature 419:579-580; Liang & Mahadevan (2009) PNAS 106(52):22049-22054" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L151-L195>,
            <https://github.com/fractastical/morpholib/blob/327729c8/morphoeval/lean/loops/Loop_067_ripping_leaf_edge_waves.lean#L65-L78> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def marginal_metric_gaussian_curvature_lead (g_yy_xx : Int) : Int :=
  -g_yy_xx
theorem sharon_negative_gaussian_curvature (g_yy_xx : Int) :
    marginal_metric_gaussian_curvature_lead 0 = 0 ∧
    (∀ c : Nat, marginal_metric_gaussian_curvature_lead ((c : Int) + 1) < 0) ∧
    marginal_metric_gaussian_curvature_lead (-g_yy_xx) = g_yy_xx
"""^^pk:lean4 ;
        skos:notation "ds^2 = dx^2 + g_yy(x) dy^2,  K(x) = -(1 / √g_yy) d^2(√g_yy)/dx^2 ≈ -(1/2) g''_yy(x) = -(g_0 / 2ℓ^2) exp(-x/ℓ) < 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/419579a>,
            <https://doi.org/10.1038/nature01958>,
            <https://doi.org/10.1038/ng1835>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103>,
            <https://doi.org/10.1073/pnas.0911954106>,
            <https://doi.org/10.1073/pnas.1015162108>,
            <https://doi.org/10.1103/PhysRevLett.91.086105>,
            <https://doi.org/10.1105/tpc.106.044792>,
            <https://doi.org/10.1105/tpc.106.045617>,
            <https://doi.org/10.1105/tpc.107.057521>,
            <https://doi.org/10.1126/science.1079354>,
            <https://doi.org/10.1511/2004.3.254> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Non-Euclidean Föppl–von Kármán Thin-Sheet Elasticity, Negative Gaussian Curvature (K < 0) & Self-Similar Multi-Generation Edge Buckling Cascades" ;
        pk:leanDeclaration "MathOfBiology.Loop_067.marginal_metric_gaussian_curvature_lead" ;
        pk:leanTheorem "MathOfBiology.Loop_067.sharon_negative_gaussian_curvature" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sharon-ripping-leaf-edge-waves-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Self-Similar Multi-Generation Sub-Harmonic Wavelength Cascade & Linear Boundary Scaling Law" ;
        dct:description "Proves multiplicative self-similar wavelength coarsening across buckling generations and linear growth of dominant wavelength with inward distance x from the leaf margin above the thickness cutoff λ_min ∝ t | Variables: r_cascade: sub-harmonic period-multiplying cascade ratio; λ_m: generation-m wavelength (mm); x: inward distance from the free leaf margin (mm); λ_min(t): finite-thickness cutoff wavelength (mm)" ;
        dct:source "Audoly & Boudaoud (2003) Phys. Rev. Lett. 91(8):086105; Sharon et al. (2002) Nature 419:579-580" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L197-L514>,
            <https://github.com/fractastical/morpholib/blob/327729c8/morphoeval/lean/loops/Loop_067_ripping_leaf_edge_waves.lean#L92-L120> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cascade_next_wavelength (r_cascade lam_m : Int) : Int :=
  r_cascade * lam_m
def local_edge_wavelength (c_lam x lam_min : Int) : Int :=
  c_lam * x + lam_min
theorem audoly_self_similar_cascade_scaling (r_cascade lam_m c_lam lam_min : Int) :
    local_edge_wavelength c_lam 0 lam_min = lam_min ∧
    cascade_next_wavelength r_cascade (cascade_next_wavelength r_cascade lam_m) =
      (r_cascade * r_cascade) * lam_m ∧
    (∀ r l : Nat, ((l : Int) + 1) < cascade_next_wavelength ((r : Int) + 2) ((l : Int) + 1))
"""^^pk:lean4 ;
        skos:notation "λ_m / λ_{m+1} = r_cascade ∈ [3, 5],  x_m ∝ λ_m,  λ_loc(x) = c_λ x + λ_min(t)" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/419579a>,
            <https://doi.org/10.1038/nature01958>,
            <https://doi.org/10.1038/ng1835>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103>,
            <https://doi.org/10.1073/pnas.0911954106>,
            <https://doi.org/10.1073/pnas.1015162108>,
            <https://doi.org/10.1103/PhysRevLett.91.086105>,
            <https://doi.org/10.1105/tpc.106.044792>,
            <https://doi.org/10.1105/tpc.106.045617>,
            <https://doi.org/10.1105/tpc.107.057521>,
            <https://doi.org/10.1126/science.1079354>,
            <https://doi.org/10.1511/2004.3.254> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Non-Euclidean Föppl–von Kármán Thin-Sheet Elasticity, Negative Gaussian Curvature (K < 0) & Self-Similar Multi-Generation Edge Buckling Cascades" ;
        pk:leanDeclaration "MathOfBiology.Loop_067.cascade_next_wavelength" ;
        pk:leanTheorem "MathOfBiology.Loop_067.audoly_self_similar_cascade_scaling" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sharon-ripping-leaf-edge-waves-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "CIN/TCP-Arrested, Auxin-Boosted Marginal Growth Increment & Non-Negative Developmental Excess Metric (Pass 3)" ;
        dct:description "Proves that TCP maturation arrests marginal growth, that a slower cin arrest front never yields less growth (excess marginal growth and K < 0 in cin), that the auxin boost keeps margin growth ≥ interior growth so the developmental excess metric g_0 is non-negative and reduces exactly to the flat Euclidean control when β a = 0 | Variables: m(y,t): CIN/TCP maturation (growth-arrest) field in [0,1] sweeping basipetally at speed v_tcp (mm/h); Γ_int, Γ_mar: interior and marginal growth strains; a: auxin level (a.u.); β: auxin growth boost; g_0(y,t): excess metric handed to the Föppl-von Kármán solver" ;
        dct:source "Nath, Crawford, Carpenter & Coen (2003) Science 299:1404-1407; Palatnik et al. (2003) Nature 425:257-263; Efroni et al. (2008) Plant Cell 20:2293-2306; Sharon et al. (2002) Nature 419:579-580" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L805-L1012>,
            <https://github.com/fractastical/morpholib/blob/327729c8/morphoeval/lean/loops/Loop_067_ripping_leaf_edge_waves.lean#L133-L174> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def marginal_growth_increment (gamma0 m_rem a_boost : Nat) : Nat :=
  gamma0 * m_rem * a_boost
theorem tcp_arrested_marginal_growth_increment (gamma0 a_boost G : Nat) :
    marginal_growth_increment gamma0 0 a_boost = 0 ∧
    (∀ m1 m2 : Nat, m1 ≤ m2 →
      marginal_growth_increment gamma0 m1 a_boost ≤ marginal_growth_increment gamma0 m2 a_boost) ∧
    (∀ m_rem R b : Nat,
      marginal_growth_increment gamma0 m_rem R ≤ marginal_growth_increment gamma0 m_rem (R + b)) ∧
    (∀ m_rem : Nat, G ≤ G + marginal_growth_increment gamma0 m_rem a_boost)
def excess_metric_numerator (g_mar g_int : Nat) : Int :=
  ((1 + g_mar) * (1 + g_mar) : Nat) - ((1 + g_int) * (1 + g_int) : Nat)
theorem developmental_excess_metric_nonneg (g_mar g_int : Nat) (h : g_int ≤ g_mar) :
    0 ≤ excess_metric_numerator g_mar g_int ∧ excess_metric_numerator g_int g_int = 0
"""^^pk:lean4 ;
        skos:notation "dΓ_int/dt = γ_0 (1 - m),  dΓ_mar/dt = γ_0 (1 - m)(1 + β a/a_ref),  m(y,t) = σ((v_tcp t - (L - y))/w),  g_0(y,t) = ((1+Γ_mar)/(1+Γ_int))^2 - 1 ≥ 0,  m = 1 ⇒ dΓ = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/419579a>,
            <https://doi.org/10.1038/nature01958>,
            <https://doi.org/10.1038/ng1835>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103>,
            <https://doi.org/10.1073/pnas.0911954106>,
            <https://doi.org/10.1073/pnas.1015162108>,
            <https://doi.org/10.1103/PhysRevLett.91.086105>,
            <https://doi.org/10.1105/tpc.106.044792>,
            <https://doi.org/10.1105/tpc.106.045617>,
            <https://doi.org/10.1105/tpc.107.057521>,
            <https://doi.org/10.1126/science.1079354>,
            <https://doi.org/10.1511/2004.3.254> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Non-Euclidean Föppl–von Kármán Thin-Sheet Elasticity, Negative Gaussian Curvature (K < 0) & Self-Similar Multi-Generation Edge Buckling Cascades" ;
        pk:leanDeclaration "MathOfBiology.Loop_067.marginal_growth_increment" ;
        pk:leanTheorem "MathOfBiology.Loop_067.tcp_arrested_marginal_growth_increment" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sharon-ripping-leaf-edge-waves-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "PIN1 Up-the-Gradient Pairwise Auxin Transport Mass Conservation (Pass 3)" ;
        dct:description "Establishes that the PIN1 up-the-gradient exchange used to generate auxin convergence maxima (serration tips) is antisymmetric and conserves the two-cell auxin total, hence total lattice auxin changes only through production, decay and growth dilution | Variables: a_i: auxin in cell i; p_i: CUC2-gated PIN1 level; T: transport rate; κ: up-the-gradient polarisation strength; J_{i→j}: PIN1-mediated efflux from i to j" ;
        dct:source "Smith et al. (2006) PNAS 103:1301-1306; Jönsson et al. (2006) PNAS 103:1633-1638; Bilsborough et al. (2011) PNAS 108:3424-3429" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L776-L797>,
            <https://github.com/fractastical/morpholib/blob/327729c8/morphoeval/lean/loops/Loop_067_ripping_leaf_edge_waves.lean#L184-L195> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def pin_pairwise_net_flux (f_ij f_ji : Int) : Int :=
  f_ij - f_ji
theorem pin_pairwise_transport_mass_conservation (a_i a_j f_ij f_ji : Int) :
    pin_pairwise_net_flux f_ij f_ji + pin_pairwise_net_flux f_ji f_ij = 0 ∧
    (a_i - pin_pairwise_net_flux f_ij f_ji) + (a_j + pin_pairwise_net_flux f_ij f_ji) = a_i + a_j ∧
    pin_pairwise_net_flux f_ij f_ij = 0
"""^^pk:lean4 ;
        skos:notation "J_{i→j} = T p_i a_i exp(κ a_j) / Σ_k exp(κ a_k),  p_i = p_max c_i/(c_half + c_i),  net_{ij} = J_{i→j} - J_{j→i} = -net_{ji},  Σ_i da_i|_transport = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/419579a>,
            <https://doi.org/10.1038/nature01958>,
            <https://doi.org/10.1038/ng1835>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103>,
            <https://doi.org/10.1073/pnas.0911954106>,
            <https://doi.org/10.1073/pnas.1015162108>,
            <https://doi.org/10.1103/PhysRevLett.91.086105>,
            <https://doi.org/10.1105/tpc.106.044792>,
            <https://doi.org/10.1105/tpc.106.045617>,
            <https://doi.org/10.1105/tpc.107.057521>,
            <https://doi.org/10.1126/science.1079354>,
            <https://doi.org/10.1511/2004.3.254> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Non-Euclidean Föppl–von Kármán Thin-Sheet Elasticity, Negative Gaussian Curvature (K < 0) & Self-Similar Multi-Generation Edge Buckling Cascades" ;
        pk:leanDeclaration "MathOfBiology.Loop_067.pin_pairwise_net_flux" ;
        pk:leanTheorem "MathOfBiology.Loop_067.pin_pairwise_transport_mass_conservation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sheth-hox-turing-polydactyly-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Turing Equal-Diffusion Negative Control (No Digit Patterning for D_u = D_v)" ;
        dct:description "Proves that equal activator and inhibitor diffusivities abolish Turing instability across all spatial wavenumbers, serving as the formal negative control | Variables: tr(J_0) = f_u + g_v: homogeneous Jacobian trace; det(J_0) = f_u g_v - f_v g_u: homogeneous Jacobian determinant; Dq = D k^2: scaled diffusion wavenumber" ;
        dct:source "Sheth et al. (2012) Science 338(6113):1476-1480 Fig. 3 & Suppl. Eqs. (S1)-(S4); Turing (1952) Phil. Trans. R. Soc. B 237:37-72" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L120-L210>,
            <https://github.com/fractastical/morpholib/blob/58b898c/morphoeval/lean/loops/Loop_015_hox_turing_polydactyly.lean#L19-L41> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def modal_trace_eq_diff (tr_J0 Dq : Int) : Int := tr_J0 - 2 * Dq
def modal_det_eq_diff (det_J0 neg_tr_Dq Dq_sq : Int) : Int :=
  det_J0 + neg_tr_Dq + Dq_sq
theorem sheth_turing_equal_diffusion_no_instability (tr_J0 det_J0 Dq neg_tr_Dq Dq_sq : Int)
    (htr : tr_J0 < 0) (hdet : det_J0 > 0)
    (hDq : Dq ≥ 0) (hterm : neg_tr_Dq ≥ 0) (hsq : Dq_sq ≥ 0) :
    modal_trace_eq_diff tr_J0 Dq < 0 ∧ modal_det_eq_diff det_J0 neg_tr_Dq Dq_sq > 0 := by
  unfold modal_trace_eq_diff modal_det_eq_diff; omega
"""^^pk:lean4 ;
        skos:notation "tr(J_0) < 0 ∧ det(J_0) > 0 ∧ D_u = D_v = D ≥ 1 ⟹ ∀ q = k^2 ≥ 0, tr(J_k) = tr(J_0) - 2 D q < 0 ∧ det(J_k) = det(J_0) - D tr(J_0) q + D^2 q^2 > 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/j.jtbi.2005.10.016>,
            <https://doi.org/10.1126/science.1179047>,
            <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1126/science.462174>,
            <https://doi.org/10.1242/dev.32.3.651>,
            <https://doi.org/10.1371/journal.pbio.1000420> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Hox-Modulated Turing Wavelength" ;
        pk:leanDeclaration "MathOfBiology.Loop_015.modal_det_eq_diff" ;
        pk:leanTheorem "MathOfBiology.Loop_015.sheth_turing_equal_diffusion_no_instability" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sheth-hox-turing-polydactyly-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Distal Hox/Gli3 Dose Monotonic Wavenumber Scaling & Allelic Series (5 -> 14 Digits)" ;
        dct:description "Proves that progressive genetic removal of distal Hox genes and Gli3 monotonically increases k_c^2(H), shrinking digit stripe wavelength λ(H) and increasing digit number from 5 (WT) -> 7 (Gli3-/-) -> 9 (Hoxd11-13-/-;Gli3-/-) -> 11 -> 14 (triple null) without changing autopod width L | Variables: H ∈ [0, 1]: normalized distal Hoxa13 + Hoxd11-13 gene dose in Gli3-null series; f_u(H): activator self-activation rate; k_c(H): critical Turing wavenumber; N_digits = L / λ(H) = k_c(H)" ;
        dct:source "Sheth et al. (2012) Science 338(6113):1476-1480 Figs. 1-3, pp. 1476-1479" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L215-L335>,
            <https://github.com/fractastical/morpholib/blob/58b898c/morphoeval/lean/loops/Loop_015_hox_turing_polydactyly.lean#L48-L79> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def sheth_trace_J0 (fu : Int) : Int := fu - 200
def sheth_kc_sq (fu : Int) : Int := fu - 2
theorem sheth_hox_dose_monotonic_wavenumber_and_allelic_series (fu1 fu2 : Int)
    (h12 : fu1 < fu2) (h2 : fu2 < 200) :
    sheth_kc_sq fu1 < sheth_kc_sq fu2 ∧
    sheth_trace_J0 fu2 < 0 ∧
    sheth_kc_sq 27 = 5 * 5 ∧
    sheth_kc_sq 51 = 7 * 7 ∧
    sheth_kc_sq 83 = 9 * 9 ∧
    sheth_kc_sq 123 = 11 * 11 ∧
    sheth_kc_sq 198 = 14 * 14 := by
  unfold sheth_kc_sq sheth_trace_J0; omega
"""^^pk:lean4 ;
        skos:notation "k_c^2(H) = (D_v f_u(H) + D_u g_v) / (2 D_u D_v) = f_u(H) - 2 = (14 - 9 H)^2;  H_2 < H_1 ⟹ f_u(H_1) < f_u(H_2) ⟹ k_c^2(H_1) < k_c^2(H_2) ∧ λ(H_2) < λ(H_1)" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/j.jtbi.2005.10.016>,
            <https://doi.org/10.1126/science.1179047>,
            <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1126/science.462174>,
            <https://doi.org/10.1242/dev.32.3.651>,
            <https://doi.org/10.1371/journal.pbio.1000420> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Hox-Modulated Turing Wavelength" ;
        pk:leanDeclaration "MathOfBiology.Loop_015.sheth_kc_sq" ;
        pk:leanTheorem "MathOfBiology.Loop_015.sheth_hox_dose_monotonic_wavenumber_and_allelic_series" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sheth-hox-turing-polydactyly-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Fan-Shaped Limb Bud Proximodistal Arc Expansion & Distal Digit Mode Selection" ;
        dct:description "Proves why the narrow proximal zeugopod (r=1) supports only 2 skeletal condensations (radius/ulna) while excluding 5-to-14 digit modes, whereas the expanded distal autopod fan (r=3) admits the Hox-tuned digit rays | Variables: r: proximodistal radial coordinate on the fan-shaped limb bud; m: angular digit ray mode number; [k_-^2, k_+^2]: local Turing unstable wavenumber band" ;
        dct:source "Sheth et al. (2012) Science 338(6113):1476-1480 Fig. 3D-F & Fig. 4; Newman & Frisch (1979) Science 205:662-668" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L331-L427>,
            <https://github.com/fractastical/morpholib/blob/58b898c/morphoeval/lean/loops/Loop_015_hox_turing_polydactyly.lean#L86-L107> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def in_fan_autopod_band (k_min_sq k_max_sq m r : Nat) : Bool :=
  decide (k_min_sq * r * r ≤ m * m ∧ m * m ≤ k_max_sq * r * r)
theorem sheth_fan_autopod_proximodistal_mode_selection :
    in_fan_autopod_band 2 4 2 1 = true ∧
    in_fan_autopod_band 2 4 5 1 = false ∧
    in_fan_autopod_band 2 4 9 1 = false ∧
    in_fan_autopod_band 2 4 5 3 = true := by decide
"""^^pk:lean4 ;
        skos:notation "k_m^2(r) = (m / r)^2 ∈ [k_-^2, k_+^2] ⟺ k_-^2 r^2 ≤ m^2 ≤ k_+^2 r^2" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/j.jtbi.2005.10.016>,
            <https://doi.org/10.1126/science.1179047>,
            <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1126/science.462174>,
            <https://doi.org/10.1242/dev.32.3.651>,
            <https://doi.org/10.1371/journal.pbio.1000420> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Hox-Modulated Turing Wavelength" ;
        pk:leanDeclaration "MathOfBiology.Loop_015.in_fan_autopod_band" ;
        pk:leanTheorem "MathOfBiology.Loop_015.sheth_fan_autopod_proximodistal_mode_selection" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sheth-hox-turing-polydactyly-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Digit Number = Autopod Width / Turing Wavelength on an AER-Grown Autopod (Pass 3)" ;
        dct:description "Separates the two control axes of digit number on the growing autopod: AER-driven width (ablation / g_max sweep, Summerbell 1974) and Hox-driven wavelength (Sheth 2012 allelic series); the numerical growing-fan solver reports N_grow against this quasi-static law (slope < 1 = growth-induced wavelength lag) | Variables: L = Θ R(T) · 2500/(2π) um: final distal autopod arc set by AER-FGF8 outgrowth (R(T) from dR/dt = v(R,t)); λ(H) = 2500/k_c(H) um: Hox-tuned Turing wavelength; N: number of digit wavelengths on the rim" ;
        dct:source "Sheth et al. (2012) Science 338(6113):1476-1480 Figs. 2-3; Summerbell (1974) J Embryol Exp Morphol 32:651-660; Kondo & Miura (2010) Science 329:1616-1620" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L457-L755>,
            <https://github.com/fractastical/morpholib/blob/58b898c/morphoeval/lean/loops/Loop_015_hox_turing_polydactyly.lean#L117-L145> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def digit_wavelengths (L lam : Nat) : Nat := L / lam
theorem sheth_growing_autopod_digit_number_law (L1 L2 L lam1 lam2 : Nat)
    (hL : L1 ≤ L2) (hlam : lam1 ≤ lam2) (hpos : 0 < lam1) :
    digit_wavelengths L1 lam1 ≤ digit_wavelengths L2 lam1 ∧
    digit_wavelengths L lam2 ≤ digit_wavelengths L lam1 ∧
    digit_wavelengths 2500 500 = 5 ∧
    digit_wavelengths 2500 357 = 7 ∧
    digit_wavelengths 2500 178 = 14 ∧
    digit_wavelengths 1365 500 = 2 := by
  unfold digit_wavelengths
  exact ⟨Nat.div_le_div_right hL, Nat.div_le_div_left hlam hpos, rfl, rfl, rfl, rfl⟩
"""^^pk:lean4 ;
        skos:notation "N(L, λ) = ⌊L / λ⌋;  L_1 ≤ L_2 ⟹ N(L_1, λ) ≤ N(L_2, λ);  0 < λ_1 ≤ λ_2 ⟹ N(L, λ_2) ≤ N(L, λ_1);  N(2500, 500) = 5, N(2500, 357) = 7, N(2500, 178) = 14, N(1365, 500) = 2 (AER ablated at t = 0.6)" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/j.jtbi.2005.10.016>,
            <https://doi.org/10.1126/science.1179047>,
            <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1126/science.462174>,
            <https://doi.org/10.1242/dev.32.3.651>,
            <https://doi.org/10.1371/journal.pbio.1000420> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Hox-Modulated Turing Wavelength" ;
        pk:leanDeclaration "MathOfBiology.Loop_015.digit_wavelengths" ;
        pk:leanTheorem "MathOfBiology.Loop_015.sheth_growing_autopod_digit_number_law" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sheth-hox-turing-polydactyly-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Growth-Dilution Shift of the Turing Modal Eigenvalue on a Growing Domain (Pass 3)" ;
        dct:description "Formalizes the dilution term of the growing-domain reaction-diffusion equations: digits can condense during AER outgrowth only while σ_max exceeds the rim dilation rate, and AER regression (g → 0) restores the full Turing rate — the mechanism behind the sequential digit emergence kymograph (Panel K) | Variables: g(r,t) = g_max A(t) exp(−(R−r)/l_F): AER-FGF8 kinematic area dilation rate (∇·v = g); σ(k): fixed-domain modal growth rate; σ_g(k): modal growth rate on the growing domain" ;
        dct:source "Crampin, Gaffney & Maini (1999) Bull Math Biol 61(6):1093-1120; Boehm et al. (2010) PLoS Biol 8(7):e1000420; Sheth et al. (2012) Science 338:1476-1480" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L512-L703>,
            <https://github.com/fractastical/morpholib/blob/58b898c/morphoeval/lean/loops/Loop_015_hox_turing_polydactyly.lean#L148-L174> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def dilution_shifted_eigenvalue (sigma g : Int) : Int := sigma - g
theorem sheth_growth_dilution_turing_threshold (sigma g : Int) :
    (g < sigma → dilution_shifted_eigenvalue sigma g > 0) ∧
    (g ≥ sigma → dilution_shifted_eigenvalue sigma g ≤ 0) ∧
    dilution_shifted_eigenvalue sigma 0 = sigma ∧
    dilution_shifted_eigenvalue 449 195 > 0 ∧
    dilution_shifted_eigenvalue 449 500 < 0 := by
  unfold dilution_shifted_eigenvalue; omega
"""^^pk:lean4 ;
        skos:notation "u_t + v·∇u + (∇·v) u = D∇²u + f(u)  ⟹  J_k → J_k − g I,  σ_g(k) = σ(k) − g;  g < σ ⟹ σ_g > 0;  g ≥ σ ⟹ σ_g ≤ 0;  g = 0 (AER regression) ⟹ σ_g = σ;  449 − 195 > 0 (σ_max = 4.49, g_rim = 1.95)" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/j.jtbi.2005.10.016>,
            <https://doi.org/10.1126/science.1179047>,
            <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1126/science.462174>,
            <https://doi.org/10.1242/dev.32.3.651>,
            <https://doi.org/10.1371/journal.pbio.1000420> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Hox-Modulated Turing Wavelength" ;
        pk:leanDeclaration "MathOfBiology.Loop_015.dilution_shifted_eigenvalue" ;
        pk:leanTheorem "MathOfBiology.Loop_015.sheth_growth_dilution_turing_threshold" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/shyer-intestinal-villi-buckling-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hannezo–Shyer Mucosal Plate-on-Foundation Quartic Wavenumber Stationarity Law" ;
        dct:description "Determines the characteristic buckling wavelength λ_* and critical compressive threshold N_c across embryonic stages (E8-E18) and vertebrate species (chick, quail, mouse) | Variables: B_e = E_e h_e^3 / (12(1 - ν^2)): mucosal bending rigidity; K_s = E_s / H_s: mesenchymal Winkler foundation stiffness; q_*: critical buckling wavenumber; λ_*: characteristic mucosal folding wavelength" ;
        dct:source "Hannezo, Prost & Joanny (2011) Phys. Rev. Lett. 107:078104 Eqs. (8)-(10); Shyer et al. (2013) Science 342:212-218 p. 214 & Supplementary Text" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L202-L237>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_063_epithelial_buckling_crypt_villus.lean#L29-L41> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def mucosal_wavenumber_residual (q B_e K_s : Int) : Int :=
  B_e * (q * q * q * q) - K_s
def mucosal_critical_load_scaled (q B_e K_s : Int) : Int :=
  B_e * (q * q * q * q) + K_s
theorem hannezo_shyer_wavenumber_stationarity (q B_e : Int) :
    mucosal_wavenumber_residual q B_e (B_e * (q * q * q * q)) = 0 ∧
    mucosal_critical_load_scaled q B_e (B_e * (q * q * q * q)) = 2 * (B_e * (q * q * q * q))
"""^^pk:lean4 ;
        skos:notation "N_c(q) = B_e q^2 + K_s / q^2  ⇒  ∂N_c/∂(q^2) = 0  ⇔  B_e q_*^4 = K_s,  λ_* = 2π (B_e / K_s)^(1/4),  N_c = 2√(B_e K_s)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2015.03.041>,
            <https://doi.org/10.1073/pnas.1205669109>,
            <https://doi.org/10.1103/PhysRevLett.107.078104>,
            <https://doi.org/10.1103/PhysRevLett.110.024302>,
            <https://doi.org/10.1126/science.1238842>,
            <https://doi.org/10.1242/dev.130112> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Föppl–von Kármán / Neo-Hookean Sequential Smooth-Muscle Mucosal Buckling (Ridges -> Zigzags -> Hexagonal Villi & Crypts)" ;
        pk:leanDeclaration "MathOfBiology.Loop_063.mucosal_wavenumber_residual" ;
        pk:leanTheorem "MathOfBiology.Loop_063.hannezo_shyer_wavenumber_stationarity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/shyer-intestinal-villi-buckling-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Shyer et al. (2013) Sequential Smooth-Muscle Buckling & FK506 Ablation Hierarchy" ;
        dct:description "Governs the sequential E6 -> E8/E10 -> E13/E14 -> E16 morphological cascade and predicts the exact arrest phenotype under stage-specific FK506 smooth-muscle inhibition or surgical slitting | Variables: Δε_x = ε_x - ε_{c,1}: circumferential smooth-muscle strain excess; Δε_y = ε_y - ε_{c,2}: longitudinal smooth-muscle strain excess; α_3: apicobasal lumen-stroma cubic asymmetry" ;
        dct:source "Shyer et al. (2013) Science 342:212-218 Figs. 1-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L239-L254>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_063_epithelial_buckling_crypt_villus.lean#L60-L74> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def shyer_buckling_regime (dex dey alpha3 : Nat) : Nat :=
  if dex == 0 then 0
  else if dey == 0 then 1
  else if alpha3 == 0 then 2
  else 3
theorem shyer_sequential_buckling_and_fk506_arrest (ex ey a3 : Nat) :
    shyer_buckling_regime 0 0 0 = 0 ∧
    shyer_buckling_regime (ex + 1) 0 0 = 1 ∧
    shyer_buckling_regime (ex + 1) (ey + 1) 0 = 2 ∧
    shyer_buckling_regime (ex + 1) (ey + 1) (a3 + 1) = 3
"""^^pk:lean4 ;
        skos:notation "Regime(Δε_x, Δε_y, α_3) = 0 (smooth, Δε_x ≤ 0) < 1 (1D ridges, Δε_x > 0, Δε_y ≤ 0) < 2 (2D zigzags, Δε_x > 0, Δε_y > 0, α_3 ≤ 0) < 3 (hexagonal villi, Δε_x > 0, Δε_y > 0, α_3 > 0)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2015.03.041>,
            <https://doi.org/10.1073/pnas.1205669109>,
            <https://doi.org/10.1103/PhysRevLett.107.078104>,
            <https://doi.org/10.1103/PhysRevLett.110.024302>,
            <https://doi.org/10.1126/science.1238842>,
            <https://doi.org/10.1242/dev.130112> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Föppl–von Kármán / Neo-Hookean Sequential Smooth-Muscle Mucosal Buckling (Ridges -> Zigzags -> Hexagonal Villi & Crypts)" ;
        pk:leanDeclaration "MathOfBiology.Loop_063.shyer_buckling_regime" ;
        pk:leanTheorem "MathOfBiology.Loop_063.shyer_sequential_buckling_and_fk506_arrest" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/shyer-intestinal-villi-buckling-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hexagonal Villi Triad Wavevector Closure & Cubic Asymmetry Selection Law" ;
        dct:description "Explains why biaxial compression combined with apicobasal polarity/stiffness asymmetry stabilizes a 6-fold hexagonal array of protruding villi and basal crypt invaginations | Variables: q_1, q_2, q_3: resonant hexagonal wavevector triad at 120° separation; α_3: apicobasal asymmetry coefficient; A: hexagonal mode amplitude" ;
        dct:source "Hannezo, Prost & Joanny (2011) Phys. Rev. Lett. 107:078104 p. 3; Shyer et al. (2013) Science 342:212-218 Fig. 4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L675-L689>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_063_epithelial_buckling_crypt_villus.lean#L86-L100> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def hexagonal_triad_sum_x (k : Int) : Int := (2 * k) + (-k) + (-k)
def hexagonal_triad_sum_y (m : Int) : Int := 0 + m + (-m)
def hexagonal_cubic_gain (alpha3 A : Nat) : Nat := alpha3 * (A * A * A)
theorem hexagonal_villi_triad_closure (k m : Int) (a3 amp : Nat) :
    hexagonal_triad_sum_x k = 0 ∧
    hexagonal_triad_sum_y m = 0 ∧
    hexagonal_cubic_gain (a3 + 1) (amp + 1) > 0
"""^^pk:lean4 ;
        skos:notation "q_1 + q_2 + q_3 = (2k, 0) + (-k, m) + (-k, -m) = (0, 0),  |q_i| = q_*,  ΔF_cubic = -(α_3 / 6) ∫ w^3 dx dy < 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2015.03.041>,
            <https://doi.org/10.1073/pnas.1205669109>,
            <https://doi.org/10.1103/PhysRevLett.107.078104>,
            <https://doi.org/10.1103/PhysRevLett.110.024302>,
            <https://doi.org/10.1126/science.1238842>,
            <https://doi.org/10.1242/dev.130112> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Föppl–von Kármán / Neo-Hookean Sequential Smooth-Muscle Mucosal Buckling (Ridges -> Zigzags -> Hexagonal Villi & Crypts)" ;
        pk:leanDeclaration "MathOfBiology.Loop_063.hexagonal_triad_sum_x" ;
        pk:leanTheorem "MathOfBiology.Loop_063.hexagonal_villi_triad_closure" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/shyer-intestinal-villi-buckling-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Tubular Circumferential Mode Quantisation on the Gut Tube (Pass 3 reduced 3D coupling)" ;
        dct:description "Replaces the flat Winkler bed by the stiffness of the 3D tubular mesenchyme (Lamé-verified ring FEM), quantises the circumferential mode count on the tube (reproduces the observed 10/12/16/19/25 ridge counts to within 0.2 on average), and gauges the validity of the flat FvK reduction via the Donnell ratio (γ = 0.65 at E8 → 0.07 at E16) | Variables: C = 2πR_lumen: tube circumference; n: integer number of circumferential ridges / villus columns; λ_n = C/n: quantised wavelength; K_tube: ring-FEM radial stiffness of the mesenchymal annulus with rigid smooth-muscle outer wall; K_slab = M_s/H_s: curvature-free confined-slab limit; f_pre = E_tan(ε_x)/E_s neo-Hookean tangent factor (optional)" ;
        dct:source "Shyer et al. (2013) Science 342:212-218 Fig. 1 (lumen radius, ridge counts); Timoshenko & Goodier (1970) Theory of Elasticity §28 (Lamé thick cylinder); Donnell (1933) NACA Rep. 479" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L261-L419>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_063_epithelial_buckling_crypt_villus.lean#L114-L119> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def tubular_quantized_wavelength (C n : Nat) : Nat := C / n
theorem tubular_mode_quantization (C n : Nat) (h : 0 < n) :
    n * tubular_quantized_wavelength C n + C % n = C ∧ C % n < n
"""^^pk:lean4 ;
        skos:notation "K_eff = (E_s/H_s) · f_curv · f_pre,  f_curv = K_tube/K_slab (axisymmetric ring FEM = Lamé u = A r + B/r),  λ_tube = c_tube · 2π (B_e/K_eff)^(1/4),  n = round(2πR/λ_tube),  n · λ_n + (2πR mod n) = 2πR,  γ_Donnell = (E_e h_e / R²) / K_eff" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2015.03.041>,
            <https://doi.org/10.1073/pnas.1205669109>,
            <https://doi.org/10.1103/PhysRevLett.107.078104>,
            <https://doi.org/10.1103/PhysRevLett.110.024302>,
            <https://doi.org/10.1126/science.1238842>,
            <https://doi.org/10.1242/dev.130112> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Föppl–von Kármán / Neo-Hookean Sequential Smooth-Muscle Mucosal Buckling (Ridges -> Zigzags -> Hexagonal Villi & Crypts)" ;
        pk:leanDeclaration "MathOfBiology.Loop_063.tubular_quantized_wavelength" ;
        pk:leanTheorem "MathOfBiology.Loop_063.tubular_mode_quantization" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/shyer-intestinal-villi-buckling-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Shh/BMP Mesenchymal-Cluster Localised Cubic Gain & Elbow Villus Nucleation (Pass 3)" ;
        dct:description "Localises Shh/BMP mesenchymal cluster signaling at zigzag elbows (E13/E14 elbow enrichment 1.38–1.42×) and villus tips (E16: 1.19 clusters per villus, 83 % of cluster mass on tips), and couples it back into the FvK energy through a spatially localised apicobasal cubic gain whose linear response bulges the elbows toward the lumen (5.9 μm at E14 vs 0 in the no-signaling ablation) | Variables: w: mucosal height field; −∇²w: mean curvature (convex toward lumen on crests); κ_c = div(∇w/|∇w|): crest-contour turning curvature (proxy for the 3D dome curvature of zigzag elbows); σ = 0.16 λ: Shh diffusion length; C ∈ [0,1]: Hh-responsive mesenchymal cluster indicator (= BMP field); g = 0.60: cluster cubic gain; h_loc: mean local FvK Hessian" ;
        dct:source "Walton et al. (2012) PNAS 109:15817-15822; Shyer, Huycke, Lee, Mahadevan & Tabin (2015) Cell 161:569-580; Walton et al. (2016) Development 143:427-436; Shyer et al. (2013) Science 342:212-218 Fig. 4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L422-L514>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_063_epithelial_buckling_crypt_villus.lean#L134-L149> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def shh_bmp_local_cubic_gain (alpha3 g C : Nat) : Nat := alpha3 + g * C
theorem shh_bmp_elbow_localization (alpha3 g w : Nat) :
    shh_bmp_local_cubic_gain alpha3 g 0 = alpha3 ∧
    shh_bmp_local_cubic_gain alpha3 g 1 = alpha3 + g ∧
    shh_bmp_local_cubic_gain alpha3 g 0 * (w * w * w) ≤ shh_bmp_local_cubic_gain alpha3 g 1 * (w * w * w)
theorem shh_bmp_elbow_villus_nucleation (ex ey g : Nat) :
    shyer_buckling_regime (ex + 1) (ey + 1) (shh_bmp_local_cubic_gain 0 (g + 1) 0) = 2 ∧
    shyer_buckling_regime (ex + 1) (ey + 1) (shh_bmp_local_cubic_gain 0 (g + 1) 1) = 3
"""^^pk:lean4 ;
        skos:notation "Shh = G_σ ∗ [ (−∇²w)₊ (1 + ζ λ |κ_c|) ],  C = 1[Shh > q₀.₈₂],  α₃(x,y) = α₃ + g · C(x,y),  [L_op² + h_loc] δw = (g C / 2) w²  ⇒  α₃(C=1) w³ ≥ α₃(C=0) w³;  Regime(Δε_x>0, Δε_y>0, α₃+g·1) = 3 while Regime(Δε_x>0, Δε_y>0, α₃+g·0) = 2" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2015.03.041>,
            <https://doi.org/10.1073/pnas.1205669109>,
            <https://doi.org/10.1103/PhysRevLett.107.078104>,
            <https://doi.org/10.1103/PhysRevLett.110.024302>,
            <https://doi.org/10.1126/science.1238842>,
            <https://doi.org/10.1242/dev.130112> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Föppl–von Kármán / Neo-Hookean Sequential Smooth-Muscle Mucosal Buckling (Ridges -> Zigzags -> Hexagonal Villi & Crypts)" ;
        pk:leanDeclaration "MathOfBiology.Loop_063.shh_bmp_local_cubic_gain" ;
        pk:leanTheorem "MathOfBiology.Loop_063.shh_bmp_elbow_localization" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sick-wnt-dkk-hair-follicle-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Sick et al. (2006) Unsaturated WNT/DKK Homogeneous Steady-State Equilibrium" ;
        dct:description "Establishes the exact algebraic homogeneous epidermal steady state of the WNT/DKK reaction kinetics prior to Turing-Meinhardt symmetry breaking | Variables: w(x,t): epidermal WNT activator concentration; h(x,t): extracellular DKK1/DKK2 inhibitor concentration; κ: autocatalytic saturation; μ_w, μ_h: turnover rates" ;
        dct:source "Sick et al. (2006) Science 314(5804):1447-1450; Gierer & Meinhardt (1972) Kybernetik 12:30-39" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L169-L249>,
            <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_006_wnt_dkk_hair_follicle.lean#L14-L34> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def wnt_activator_num_residual (w h_scaled mu_h : Int) : Int :=
  (w * w) * mu_h - w * h_scaled
def dkk_inhibitor_num_residual (w h_scaled mu_h : Int) : Int :=
  (w * w) * mu_h - mu_h * h_scaled
theorem wnt_dkk_homogeneous_steady_state (mu_h : Int) :
    wnt_activator_num_residual mu_h (mu_h * mu_h) mu_h = 0 ∧
    dkk_inhibitor_num_residual mu_h (mu_h * mu_h) mu_h = 0 := by
  simp [wnt_activator_num_residual, dkk_inhibitor_num_residual, Int.mul_assoc]
"""^^pk:lean4 ;
        skos:notation "∂w/∂t = ρ_w + c_w w^2 / [h(1 + κ w^2)] - μ_w w + D_w ∇^2 w,   ∂h/∂t = ρ_h + c_h w^2 - μ_h h + D_h ∇^2 h;   (w_*, h_*) = ((c_w/c_h)(μ_h/μ_w), (c_w/c_h)(μ_h/μ_w)^2)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(70)90092-5>,
            <https://doi.org/10.1016/S1534-5807(02)00167-3>,
            <https://doi.org/10.1038/11078>,
            <https://doi.org/10.1046/j.1523-1747.1999.00740.x>,
            <https://doi.org/10.1073/pnas.0600825103>,
            <https://doi.org/10.1101/gad.198945.112>,
            <https://doi.org/10.1126/science.1130088>,
            <https://doi.org/10.1186/1471-213X-4-4>,
            <https://doi.org/10.1371/journal.pbio.2002117> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Activator-Inhibitor Follicular Spacing (Sick et al. 2006 Saturating WNT/DKK Reaction-Diffusion PDE)" ;
        pk:leanDeclaration "MathOfBiology.Loop_006.wnt_activator_num_residual" ;
        pk:leanTheorem "MathOfBiology.Loop_006.wnt_dkk_homogeneous_steady_state" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sick-wnt-dkk-hair-follicle-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Sick et al. (2006) Equal-Diffusion Epidermal Stability & Dkk1 Blockade Theorem" ;
        dct:description "Proves that faster DKK turnover (μ_h > μ_w) stabilizes the epidermis against uniform oscillations and that equal diffusion (D_w = D_h) or excess Dkk1 expression prevents hair follicle placode initiation | Variables: J_0: homogeneous WNT/DKK reaction Jacobian; q = k^2: squared spatial wavenumber; D: equal diffusivity" ;
        dct:source "Sick et al. (2006) Science 314:1447-1450; Andl et al. (2002) Dev. Cell 2(5):643-653" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L171-L249,L598-L652>,
            <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_006_wnt_dkk_hair_follicle.lean#L37-L59> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def wnt_dkk_equal_diff_neg_trace (d_mu D q : Nat) : Nat :=
  (d_mu + 1) + 2 * D * q
def wnt_dkk_equal_diff_det (d_mu d_pos D q : Nat) : Nat :=
  (D * q) * (D * q) + (D * q) * (d_mu + 1) + (d_pos + 1)
theorem wnt_dkk_equal_diffusion_stable (d_mu d_pos D q : Nat) :
    wnt_dkk_equal_diff_neg_trace d_mu D q ≥ 1 ∧
    wnt_dkk_equal_diff_det d_mu d_pos D q ≥ d_pos + 1 := by
  simp [wnt_dkk_equal_diff_neg_trace, wnt_dkk_equal_diff_det]
  omega
"""^^pk:lean4 ;
        skos:notation "tr(J_0) = μ_w - μ_h < 0  (μ_h > μ_w),   det(J_0) = μ_w μ_h > 0;   D_w = D_h = D ⟹ det(J_0 - q D I) = (Dq)^2 + Dq(μ_h - μ_w) + μ_w μ_h > 0  ∀ q ≥ 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(70)90092-5>,
            <https://doi.org/10.1016/S1534-5807(02)00167-3>,
            <https://doi.org/10.1038/11078>,
            <https://doi.org/10.1046/j.1523-1747.1999.00740.x>,
            <https://doi.org/10.1073/pnas.0600825103>,
            <https://doi.org/10.1101/gad.198945.112>,
            <https://doi.org/10.1126/science.1130088>,
            <https://doi.org/10.1186/1471-213X-4-4>,
            <https://doi.org/10.1371/journal.pbio.2002117> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Activator-Inhibitor Follicular Spacing (Sick et al. 2006 Saturating WNT/DKK Reaction-Diffusion PDE)" ;
        pk:leanDeclaration "MathOfBiology.Loop_006.wnt_dkk_equal_diff_det" ;
        pk:leanTheorem "MathOfBiology.Loop_006.wnt_dkk_equal_diffusion_stable" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sick-wnt-dkk-hair-follicle-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Sick et al. (2006) Rapidly Diffusing DKK Instability & Secondary Wave Insertion Theorem" ;
        dct:description "Proves that rapidly diffusing extracellular DKK1/DKK2 (d = 30 > d_c) drives det_J(q) < 0, generating regular primary hair follicle placodes and inter-follicular secondary wave insertion upon domain expansion | Variables: d = D_h / D_w: DKK-to-WNT diffusivity ratio (canonical d = 30; Lean instance d = 40); d_c = (√2 + 1)^2 ≈ 5.8284: critical Turing threshold; q = k^2: unstable spatial mode" ;
        dct:source "Sick et al. (2006) Science 314(5804):1447-1450 Figs. 1-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L341-L441>,
            <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_006_wnt_dkk_hair_follicle.lean#L61-L84> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def wnt_dkk_fourier_det (mu_w mu_h D_w D_h q : Int) : Int :=
  (D_w * q - mu_w) * (D_h * q + mu_h) + 2 * mu_w * mu_h
theorem wnt_dkk_follicle_spacing_instability :
    wnt_dkk_fourier_det 2 3 1 1 0 = 6 ∧
    wnt_dkk_fourier_det 2 3 1 1 1 = 8 ∧
    wnt_dkk_fourier_det 2 3 1 5 1 = 4 ∧
    wnt_dkk_fourier_det 2 3 1 10 1 = -1 ∧
    wnt_dkk_fourier_det 2 3 1 40 1 = -31 := by
  decide
"""^^pk:lean4 ;
        skos:notation "det_J(q) = (D_w q - μ_w)(D_h q + μ_h) + 2 μ_w μ_h < 0  ⟺  d = D_h / D_w > d_c = (√2 + 1)^2 ≈ 5.8284" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(70)90092-5>,
            <https://doi.org/10.1016/S1534-5807(02)00167-3>,
            <https://doi.org/10.1038/11078>,
            <https://doi.org/10.1046/j.1523-1747.1999.00740.x>,
            <https://doi.org/10.1073/pnas.0600825103>,
            <https://doi.org/10.1101/gad.198945.112>,
            <https://doi.org/10.1126/science.1130088>,
            <https://doi.org/10.1186/1471-213X-4-4>,
            <https://doi.org/10.1371/journal.pbio.2002117> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Activator-Inhibitor Follicular Spacing (Sick et al. 2006 Saturating WNT/DKK Reaction-Diffusion PDE)" ;
        pk:leanDeclaration "MathOfBiology.Loop_006.wnt_dkk_fourier_det" ;
        pk:leanTheorem "MathOfBiology.Loop_006.wnt_dkk_follicle_spacing_instability" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sick-wnt-dkk-hair-follicle-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Epidermally Instructed Dermal Condensation — Epidermis-Free Dermal FGF20/BMP4 Chemotaxis Subsystem Stability (Pass 3)" ;
        dct:description "Proves that without the epidermal FGF20 cue the dermal subsystem cannot condense spontaneously, so every dermal condensate in the model is instructed by an epidermal WNT placode (Fgf20-null: 0 DCs, Huh et al. 2013) | Variables: ρ(x,y,z,t): dermal mesenchymal density; b: BMP4; χ_b: BMP4 chemorepulsion sensitivity; D_ρ, D_b: diffusivities; μ_b, s_b: BMP4 turnover and dermal production; q = k^2" ;
        dct:source "Huh et al. (2013) Genes Dev 27(4):450-458; Keller & Segel (1970) J Theor Biol 26(3):399-415; Botchkarev et al. (1999) Nat Cell Biol 1(3):158-164" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L726-L768>,
            <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_006_wnt_dkk_hair_follicle.lean#L87-L114> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def dermal_neg_trace (D_rho D_b mu_b q : Nat) : Nat :=
  (D_rho + D_b) * q + (mu_b + 1)
def dermal_det (D_rho D_b mu_b chi_b m0 s_b q : Nat) : Nat :=
  D_rho * q * (D_b * q + mu_b) + chi_b * m0 * s_b * q
theorem dermal_subsystem_instructed_stable (D_rho D_b mu_b chi_b m0 s_b q : Nat) :
    dermal_neg_trace D_rho D_b mu_b q ≥ 1 ∧
    dermal_det D_rho D_b mu_b chi_b m0 s_b q ≥ chi_b * m0 * s_b * q := by
  simp [dermal_neg_trace, dermal_det]
  omega
"""^^pk:lean4 ;
        skos:notation "M(q) = [[-D_ρ q, -χ_b m_0 q], [s_b, -(D_b q + μ_b)]],  m_0 = ρ_0 (1 - ρ_0/ρ_max);   -tr M = (D_ρ + D_b) q + μ_b > 0,   det M = D_ρ q (D_b q + μ_b) + χ_b m_0 s_b q ≥ 0  ∀ q ≥ 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(70)90092-5>,
            <https://doi.org/10.1016/S1534-5807(02)00167-3>,
            <https://doi.org/10.1038/11078>,
            <https://doi.org/10.1046/j.1523-1747.1999.00740.x>,
            <https://doi.org/10.1073/pnas.0600825103>,
            <https://doi.org/10.1101/gad.198945.112>,
            <https://doi.org/10.1126/science.1130088>,
            <https://doi.org/10.1186/1471-213X-4-4>,
            <https://doi.org/10.1371/journal.pbio.2002117> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Activator-Inhibitor Follicular Spacing (Sick et al. 2006 Saturating WNT/DKK Reaction-Diffusion PDE)" ;
        pk:leanDeclaration "MathOfBiology.Loop_006.dermal_det" ;
        pk:leanTheorem "MathOfBiology.Loop_006.dermal_subsystem_instructed_stable" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sick-wnt-dkk-hair-follicle-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Keller-Segel (1970) Chemotactic Aggregation Threshold — Autonomous Comparison for the Dermal FGF20 Response (Pass 3)" ;
        dct:description "Formalises the sign of the Keller-Segel Fourier determinant used in compute_dermal_linear_stability(): chemotaxis-null (χ_f = 0) is stable, canonical χ_f is supercritical, and the q = 0 mass mode is neutral (mass conservation) | Variables: χ_f: FGF20 chemotactic sensitivity (0.25; swept over {0, 0.1, 0.15, 0.2, 0.25}); D_f, μ_f, s_f: FGF20 diffusivity, turnover, source; m_0 = ρ_0 (1 - ρ_0/ρ_max) = 0.75" ;
        dct:source "Keller & Segel (1970) J Theor Biol 26(3):399-415; Painter & Hillen (2002) Can Appl Math Q 10(4):501-543; Glover et al. (2017) PLoS Biol 15(7):e2002117" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L726-L768>,
            <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_006_wnt_dkk_hair_follicle.lean#L116-L145> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def ks_fourier_det (D_rho D_f mu_f chi_f m0 s_f q : Int) : Int :=
  D_rho * q * (D_f * q + mu_f) - chi_f * m0 * s_f * q
theorem keller_segel_fourier_det_sign :
    ks_fourier_det 5 25 4 25 75 50 1 < 0 ∧
    ks_fourier_det 5 25 4 0 75 50 1 = 145 ∧
    ks_fourier_det 5 25 4 25 75 50 0 = 0 ∧
    ks_fourier_det 1 1 1 1 1 1 1 = 1 := by
  decide
theorem ks_det_neg_of_supercritical (q A B : Nat) (hq : 0 < q) (h : A < B) :
    (q * A : Int) - q * B < 0 := by
  have := Nat.mul_lt_mul_of_pos_left h hq
  omega
"""^^pk:lean4 ;
        skos:notation "det_KS(q) = D_ρ q (D_f q + μ_f) - χ_f m_0 s_f q < 0  ⟺  χ_f m_0 s_f > D_ρ (D_f q + μ_f)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(70)90092-5>,
            <https://doi.org/10.1016/S1534-5807(02)00167-3>,
            <https://doi.org/10.1038/11078>,
            <https://doi.org/10.1046/j.1523-1747.1999.00740.x>,
            <https://doi.org/10.1073/pnas.0600825103>,
            <https://doi.org/10.1101/gad.198945.112>,
            <https://doi.org/10.1126/science.1130088>,
            <https://doi.org/10.1186/1471-213X-4-4>,
            <https://doi.org/10.1371/journal.pbio.2002117> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Activator-Inhibitor Follicular Spacing (Sick et al. 2006 Saturating WNT/DKK Reaction-Diffusion PDE)" ;
        pk:leanDeclaration "MathOfBiology.Loop_006.ks_fourier_det" ;
        pk:leanTheorem "MathOfBiology.Loop_006.keller_segel_fourier_det_sign" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sick-wnt-dkk-hair-follicle-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hair Peg Downgrowth Monotonicity & Closed Form (Paus et al. 1999 ordinal staging, Pass 3)" ;
        dct:description "Guarantees that the per-placode peg-depth recurrence in simulate_dermal_condensate_3d() is non-decreasing in time (self-test check 11) and linear in the saturated regime, consistent with the ordinal placode -> hair germ -> hair peg progression | Variables: z_n: hair peg depth of one placode after n dermal time steps; v = dt · v_peg · clip(·) ≥ 0: per-step downgrowth increment slaved to the dermal condensate density beneath the placode" ;
        dct:source "Paus et al. (1999) J Invest Dermatol 113(4):523-532; Huh et al. (2013) Genes Dev 27(4):450-458" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/2002-sick-wnt-dkk-hair-follicle.py#L771-L925>,
            <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_006_wnt_dkk_hair_follicle.lean#L147-L169> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def hair_peg_depth (v : Nat) : Nat → Nat
  | 0 => 0
  | n + 1 => hair_peg_depth v n + v
theorem hair_peg_depth_monotone (v n : Nat) :
    hair_peg_depth v n ≤ hair_peg_depth v (n + 1) := by
  simp [hair_peg_depth]
theorem hair_peg_depth_closed_form (v n : Nat) : hair_peg_depth v n = n * v := by
  induction n with
  | zero => simp [hair_peg_depth]
  | succ k ih => simp [hair_peg_depth, ih, Nat.succ_mul]
"""^^pk:lean4 ;
        skos:notation "z_{n+1} = z_n + v  ⟹  z_n ≤ z_{n+1}  ∧  z_n = n v" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(70)90092-5>,
            <https://doi.org/10.1016/S1534-5807(02)00167-3>,
            <https://doi.org/10.1038/11078>,
            <https://doi.org/10.1046/j.1523-1747.1999.00740.x>,
            <https://doi.org/10.1073/pnas.0600825103>,
            <https://doi.org/10.1101/gad.198945.112>,
            <https://doi.org/10.1126/science.1130088>,
            <https://doi.org/10.1186/1471-213X-4-4>,
            <https://doi.org/10.1371/journal.pbio.2002117> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Activator-Inhibitor Follicular Spacing (Sick et al. 2006 Saturating WNT/DKK Reaction-Diffusion PDE)" ;
        pk:leanDeclaration "MathOfBiology.Loop_006.hair_peg_depth" ;
        pk:leanTheorem "MathOfBiology.Loop_006.hair_peg_depth_monotone" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/steinberg-differential-adhesion-sorting-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Steinberg (1963) Differential Adhesion Interfacial Tension & Equal-Adhesion Null Identity" ;
        dct:description "Defines effective tissue interfacial tensions from microscopic Potts bond energies and proves that equal adhesion eliminates the sorting driving force | Variables: J_{AA}, J_{BB}, J_{AB}: homotypic and heterotypic Potts bond energies; J_{AM}, J_{BM}: cell-medium bond energies; γ_{AB}: heterotypic interfacial tension" ;
        dct:source "Steinberg (1963) Science 141(3579):401-408; Graner & Glazier (1992) Phys. Rev. Lett. 69(13):2013-2016 Eqs. (2)-(3)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L137-L183>,
            <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/lean/loops/Loop_041_differential_adhesion_sorting.lean#L17-L43> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def two_gamma_AB (J_AA J_BB J_AB : Int) : Int :=
  2 * J_AB - (J_AA + J_BB)
theorem steinberg_equal_adhesion_zero_tension (J J_M : Int) :
    two_gamma_AB J J J = 0 ∧ two_spreading_diff J J J_M J_M = 0"""^^pk:lean4 ;
        skos:notation "γ_{AB} = J_{AB} - (J_{AA} + J_{BB})/2,  γ_{τM} = J_{τM} - J_{ττ}/2;  J_{AA} = J_{BB} = J_{AB} ⇒ γ_{AB} = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401730406>,
            <https://doi.org/10.1016/j.cpc.2007.03.007>,
            <https://doi.org/10.1088/1367-2630/13/3/033035>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1103/PhysRevLett.75.2244>,
            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Differential Adhesion Cellular Potts Sorting (Steinberg DAH & Glazier-Graner-Hogeweg Hamiltonian)" ;
        pk:leanDeclaration "MathOfBiology.Loop_041.two_gamma_AB" ;
        pk:leanTheorem "MathOfBiology.Loop_041.steinberg_equal_adhesion_zero_tension" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/steinberg-differential-adhesion-sorting-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Graner & Glazier (1992) Four Thermodynamic Phase Inequalities (Checkerboard, Complete Engulfment, Partial Engulfment, Dissociation)" ;
        dct:description "Partitions adhesion parameter space into checkerboard mixing, concentric complete engulfment sorting, partial engulfment lens doublets, and cell dissociation | Variables: γ_{AB}: heterotypic interfacial tension; γ_{AM}, γ_{BM}: tissue-medium surface tensions for outer shell A and inner core B" ;
        dct:source "Graner & Glazier (1992) Phys. Rev. Lett. 69(13):2013-2016 p. 2014; Glazier & Graner (1993) Phys. Rev. E 47(3):2128-2154 Table I" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L284-L560>,
            <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/lean/loops/Loop_041_differential_adhesion_sorting.lean#L45-L65> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem graner_glazier_1992_complete_engulfment_inequalities :
    two_gamma_AB 14 2 11 = 6 ∧
    two_spreading_diff 14 2 16 16 = 12 ∧
    (0 < two_gamma_AB 14 2 11 ∧ two_gamma_AB 14 2 11 < two_spreading_diff 14 2 16 16) ∧
    two_gamma_AB 14 14 4 < 0 ∧
    two_gamma_AB 14 2 16 > two_spreading_diff 14 2 16 16 ∧
    two_gamma_M 14 2 < 0"""^^pk:lean4 ;
        skos:notation "Checkerboard: γ_{AB} < 0;  Complete engulfment: 0 < γ_{AB} < γ_{BM} - γ_{AM};  Partial engulfment: γ_{AB} > γ_{BM} - γ_{AM} > 0;  Dissociation: γ_{AM} < 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401730406>,
            <https://doi.org/10.1016/j.cpc.2007.03.007>,
            <https://doi.org/10.1088/1367-2630/13/3/033035>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1103/PhysRevLett.75.2244>,
            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Differential Adhesion Cellular Potts Sorting (Steinberg DAH & Glazier-Graner-Hogeweg Hamiltonian)" ;
        pk:leanDeclaration "MathOfBiology.Loop_041.two_spreading_diff" ;
        pk:leanTheorem "MathOfBiology.Loop_041.graner_glazier_1992_complete_engulfment_inequalities" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/steinberg-differential-adhesion-sorting-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Foty & Steinberg (1996) Chick Embryo Surface Tension Transitive Envelopment Hierarchy & Potts Hamiltonian" ;
        dct:description "Governs stochastic Metropolis Monte Carlo cell sorting and proves transitive mutual envelopment across all 5 embryonic Gallus gallus tissues | Variables: H: Cellular Potts Hamiltonian; σ_{i,j}: cell spin ID; a_σ: cell area; A_0: target area; σ_tissue: equilibrium tissue surface tension (dyn/cm)" ;
        dct:source "Foty, Pfleger, Forgacs & Steinberg (1996) Development 122(5):1611-1620 Table 1 & Fig. 4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L1013-L1051>,
            <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/lean/loops/Loop_041_differential_adhesion_sorting.lean#L67-L106> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem foty_1996_transitive_envelopment_hierarchy (sA sB sC : Int)
    (hAB : sB > sA) (hBC : sC > sB) :
    (sC > sA) ∧ ((sC - sA) = (sC - sB) + (sB - sA))
theorem potts_area_energy_equilibrium_zero (lam A0 : Int) :
    potts_area_energy lam A0 A0 = 0"""^^pk:lean4 ;
        skos:notation "H = ∑ J(τ(σ), τ(σ'))(1 - δ_{σ,σ'}) + λ ∑_{σ>0}(a_σ - A_0)^2;  σ_limb (20.1) > σ_pigment (12.6) > σ_heart (8.5) > σ_liver (4.6) > σ_retina (1.6) dyn/cm" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401730406>,
            <https://doi.org/10.1016/j.cpc.2007.03.007>,
            <https://doi.org/10.1088/1367-2630/13/3/033035>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1103/PhysRevLett.75.2244>,
            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Differential Adhesion Cellular Potts Sorting (Steinberg DAH & Glazier-Graner-Hogeweg Hamiltonian)" ;
        pk:leanDeclaration "MathOfBiology.Loop_041.potts_area_energy" ;
        pk:leanTheorem "MathOfBiology.Loop_041.foty_1996_transitive_envelopment_hierarchy" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/steinberg-differential-adhesion-sorting-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "(Pass 3) Parity-Sublattice Exactness of the 3D Sublattice-Parallel Cellular Potts Metropolis Sweep" ;
        dct:description "Justifies the vectorised 8-colour sublattice-parallel Metropolis update of simulate_potts_regime_3d: the 26-neighbour adhesion energy change of every simultaneously evaluated voxel is exact; only the volume term uses sub-sweep-start volumes (domain-parallel CPM approximation) | Variables: (x, y, z): integer voxel coordinates on the 64³ lattice; parity class = (x mod 2, y mod 2, z mod 2) — the 8 colours of the sublattice sweep" ;
        dct:source "Graner & Glazier (1992) Phys. Rev. Lett. 69(13):2013-2016 Eq. (1); Chen, Glazier, Izaguirre & Alber (2007) Comput. Phys. Commun. 176(11-12):670-681 (DOI not verified offline)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L646-L854>,
            <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/lean/loops/Loop_041_differential_adhesion_sorting.lean#L110-L123> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem parity_sublattice_sites_not_moore_adjacent
    (x1 y1 z1 x2 y2 z2 : Int)
    (hx : x1 % 2 = x2 % 2) (hy : y1 % 2 = y2 % 2) (hz : z1 % 2 = z2 % 2)
    (hdist : x1 ≠ x2 ∨ y1 ≠ y2 ∨ z1 ≠ z2) :
    ¬ (x1 - x2 ≤ 1 ∧ x2 - x1 ≤ 1 ∧ y1 - y2 ≤ 1 ∧ y2 - y1 ≤ 1 ∧ z1 - z2 ≤ 1 ∧ z2 - z1 ≤ 1)"""^^pk:lean4 ;
        skos:notation "x₁ ≡ x₂, y₁ ≡ y₂, z₁ ≡ z₂ (mod 2) ∧ (x₁,y₁,z₁) ≠ (x₂,y₂,z₂)  ⇒  max(|Δx|,|Δy|,|Δz|) ≥ 2  (same-parity voxels are never Moore-adjacent, so simultaneous copy attempts have exact ΔH_adh)" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401730406>,
            <https://doi.org/10.1016/j.cpc.2007.03.007>,
            <https://doi.org/10.1088/1367-2630/13/3/033035>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1103/PhysRevLett.75.2244>,
            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Differential Adhesion Cellular Potts Sorting (Steinberg DAH & Glazier-Graner-Hogeweg Hamiltonian)" ;
        pk:leanDeclaration "MathOfBiology.Loop_041.parity_sublattice_sites_not_moore_adjacent" ;
        pk:leanTheorem "MathOfBiology.Loop_041.parity_sublattice_sites_not_moore_adjacent" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/steinberg-differential-adhesion-sorting-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "(Pass 3) Cellular Potts Volume-Constraint Single-Voxel Increment & Restoring Sign" ;
        dct:description "The exact per-move volume/area energy increment evaluated by both the 2D (simulate_potts_regime) and 3D (simulate_potts_regime_3d) Metropolis solvers; its sign is the restoring force that keeps ⟨v⟩ near V₀ against the compressive cell–medium surface tension | Variables: v: current cell volume (3D) or area (2D) in lattice sites; V₀: target volume; λ: volume elasticity" ;
        dct:source "Graner & Glazier (1992) Phys. Rev. Lett. 69(13):2013-2016 Eq. (1), second (area) term; Glazier & Graner (1993) Phys. Rev. E 47(3):2128-2154" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L800-L811>,
            <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/lean/loops/Loop_041_differential_adhesion_sorting.lean#L125-L156> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def potts_volume_energy (lam v V0 : Int) : Int :=
  lam * ((v - V0) * (v - V0))
theorem potts_volume_energy_single_voxel_increment (lam v V0 : Int) :
    potts_volume_energy lam (v + 1) V0 - potts_volume_energy lam v V0 = lam * (2 * (v - V0) + 1)
theorem potts_volume_increment_sign (lam v V0 : Int) (hlam : 0 < lam) :
    (v < V0 → lam * (2 * (v - V0) + 1) < 0) ∧ (V0 ≤ v → 0 < lam * (2 * (v - V0) + 1))"""^^pk:lean4 ;
        skos:notation "E_vol(v) = λ (v − V₀)²;  E_vol(v+1) − E_vol(v) = λ (2 (v − V₀) + 1);  v < V₀ ⇒ ΔE < 0,  v ≥ V₀ ⇒ ΔE > 0  (λ > 0)" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401730406>,
            <https://doi.org/10.1016/j.cpc.2007.03.007>,
            <https://doi.org/10.1088/1367-2630/13/3/033035>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1103/PhysRevLett.75.2244>,
            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Differential Adhesion Cellular Potts Sorting (Steinberg DAH & Glazier-Graner-Hogeweg Hamiltonian)" ;
        pk:leanDeclaration "MathOfBiology.Loop_041.potts_volume_energy" ;
        pk:leanTheorem "MathOfBiology.Loop_041.potts_volume_energy_single_voxel_increment" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/steinberg-differential-adhesion-sorting-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "(Pass 3) Sorting Kinetics — Logarithmic vs Power-Law Heterotypic Boundary Decay, 2D vs 3D" ;
        dct:description "Empirical kinetic comparison requested by the Pass 2 audit: exponent α measured on the native 2D model, the full 3D (64³) boundary, the 2D equatorial section of the 3D spheroid, a Kawasaki-swap ablation and a 3D equal-adhesion control (compare_2d_vs_3d_sorting_kinetics); no Lean statement because the fits are statistical, not algebraic | Variables: t: Monte Carlo Steps; α: power-law sorting exponent; R²_pow, R²_log: fit quality of the two descriptions on identical points" ;
        dct:source "Graner & Glazier (1992) PRL Fig. 3 (logarithmic 2D decay); Mombach, Glazier, Raphael & Zajac (1995) PRL 75(11):2244; Nakajima & Ishihara (2011) New J. Phys. 13:033035 (DOIs not verified offline); Lifshitz–Slyozov–Wagner coarsening theory" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L486-L525> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:notation "f(t) = L_AB/L_tot;  logarithmic: f = a + b ln(t+1);  power law: f = c (t+1)^(−α);  LSW diffusive bound α = 1/3 (R ~ t^{1/3} ⇒ L_AB/L ~ t^{−1/3}); logarithmic limit α → 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401730406>,
            <https://doi.org/10.1016/j.cpc.2007.03.007>,
            <https://doi.org/10.1088/1367-2630/13/3/033035>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1103/PhysRevLett.75.2244>,
            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> ;
        pk:hypothesisType "Differential Adhesion Cellular Potts Sorting (Steinberg DAH & Glazier-Graner-Hogeweg Hamiltonian)" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/streichan-global-morphogenetic-flow-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Positive-Definite Compressible Stokes-Brinkman Fourier Operator Invertibility" ;
        dct:description "Proves that vitelline friction xi > 0 and shear viscosity eta > 0 render both transverse shear and longitudinal compressible Stokes-Brinkman symbols strictly positive-definite across all wavenumbers including k = 0, guaranteeing a unique global Green's function velocity solution | Variables: v(x, y): 2D cartographic blastoderm velocity field; eta, eta_b: 2D shear and bulk tissue viscosities; xi = eta / ell_H^2: vitelline membrane friction coefficient; k = (kx, ky): spatial Fourier wavevector" ;
        dct:source "Streichan et al. (2018) eLife 7:e27454 Eq. 1, Fig. 2; Mayer et al. (2010) Nature 467:617-621 Eq. 1" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L115-L210>,
            <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L21-L65> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def stokes_brinkman_transverse_symbol (eta xi kx ky : Int) : Int :=
  eta * (kx * kx + ky * ky) + xi
def stokes_brinkman_longitudinal_symbol (eta eta_b xi kx ky : Int) : Int :=
  (eta + eta_b) * (kx * kx + ky * ky) + xi
theorem stokes_brinkman_fourier_operator_pos_def
    (eta eta_b xi kx ky : Int)
    (hEta : eta > 0) (hEtaB : eta_b ≥ 0) (hXi : xi > 0) :
    stokes_brinkman_transverse_symbol eta xi kx ky ≥ xi ∧
    stokes_brinkman_transverse_symbol eta xi kx ky > 0 ∧
    stokes_brinkman_longitudinal_symbol eta eta_b xi kx ky ≥
      stokes_brinkman_transverse_symbol eta xi kx ky ∧
    stokes_brinkman_longitudinal_symbol eta eta_b xi kx ky > 0"""^^pk:lean4 ;
        skos:notation "eta * nabla^2 v + eta_b * nabla(nabla . v) - xi * v = -nabla . sigma^a;  lambda_L(k) = (eta + eta_b)|k|^2 + xi >= lambda_T(k) = eta|k|^2 + xi >= xi > 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
            <https://doi.org/10.1038/nature02590>,
            <https://doi.org/10.1038/nature09376>,
            <https://doi.org/10.7554/eLife.27454>,
            <https://doi.org/10.7554/eLife.78787>,
            <https://doi.org/10.7554/eLife.95521> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
        pk:leanDeclaration "MathOfBiology.Loop_048.stokes_brinkman_transverse_symbol" ;
        pk:leanTheorem "MathOfBiology.Loop_048.stokes_brinkman_fourier_operator_pos_def" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/streichan-global-morphogenetic-flow-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Trace-Free Active Nematic Myosin Tensor & Quadrupolar Convergent-Extension Law" ;
        dct:description "Proves that trace-free DV myosin cable polarization (Q_{yy} > 0, Q_{xx} = -Q_{yy} < 0) creates simultaneous DV contraction and AP extension forces, whereas maternal/pair-rule anisotropy collapse (Q_{yy} = 0) abolishes quadrupolar convergent-extension shear flow | Variables: m(x): cortical Myosin-II concentration; Q_{ij} = n_i n_j - 0.5 delta_{ij}: 2D trace-free nematic orientation tensor; alpha_iso, alpha_aniso: isotropic and anisotropic active stress couplings; f_x = -d_x sigma^a_{xx}: active AP extension force density" ;
        dct:source "Streichan et al. (2018) eLife 7:e27454 Eq. 2, Figs. 2-4; Lefebvre et al. (2023) eLife 12:e78787 Figs. 1-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L215-L310>,
            <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L67-L120> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def active_stress_xx (alpha_iso alpha_aniso m Q_xx : Int) : Int :=
  alpha_iso * m + alpha_aniso * m * Q_xx
def active_stress_yy (alpha_iso alpha_aniso m Q_yy : Int) : Int :=
  alpha_iso * m + alpha_aniso * m * Q_yy
def active_ap_extension_force (alpha_aniso Q_yy dm_dx : Int) : Int :=
  alpha_aniso * Q_yy * dm_dx
theorem nematic_dv_cable_trace_free_and_ap_extension
    (alpha_iso alpha_aniso m Q_xx Q_yy dm_dx : Int)
    (hTraceFree : Q_xx + Q_yy = 0) (hAlpha : alpha_aniso > 0)
    (hM : m > 0) (hQyy : Q_yy > 0) (hGrad : dm_dx > 0) :
    Q_xx = -Q_yy ∧
    active_stress_yy alpha_iso alpha_aniso m Q_yy >
      active_stress_xx alpha_iso alpha_aniso m Q_xx ∧
    active_ap_extension_force alpha_aniso Q_yy dm_dx > 0 ∧
    active_stress_yy alpha_iso alpha_aniso m 0 =
      active_stress_xx alpha_iso alpha_aniso m 0 ∧
    active_ap_extension_force alpha_aniso 0 dm_dx = 0"""^^pk:lean4 ;
        skos:notation "sigma^a_{ij} = alpha_iso * m * delta_{ij} + alpha_aniso * m * Q_{ij}, Tr(Q) = Q_{xx} + Q_{yy} = 0;  Q_{yy} > 0 => sigma^a_{yy} > sigma^a_{xx} & f_x = alpha_aniso * Q_{yy} * d_x m > 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
            <https://doi.org/10.1038/nature02590>,
            <https://doi.org/10.1038/nature09376>,
            <https://doi.org/10.7554/eLife.27454>,
            <https://doi.org/10.7554/eLife.78787>,
            <https://doi.org/10.7554/eLife.95521> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
        pk:leanDeclaration "MathOfBiology.Loop_048.active_ap_extension_force" ;
        pk:leanTheorem "MathOfBiology.Loop_048.nematic_dv_cable_trace_free_and_ap_extension" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/streichan-global-morphogenetic-flow-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Streichan et al. (2018) Global Flow Prediction & Mutant Hierarchy" ;
        dct:description "Proves that coupling DV anisotropic myosin cables with posterior midgut invagination predicts >90% of global embryonic flow and strictly orders wild-type, twist/snail, anisotropic-only, eve, isotropic-only, and bcd nos tsl maternal-null velocity fields | Variables: phi_aniso, phi_pmg, phi_ectoderm: activation indicators for DV anisotropic myosin cables, posterior midgut isotropic apical constriction, and ventral mesoderm; r: global spatial velocity correlation; v_AP: peak posterior GBE flow velocity (um/min)" ;
        dct:source "Streichan et al. (2018) eLife 7:e27454 Figs. 2-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L315-L510>,
            <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L122-L168> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def streichan_flow_v100 (phi_aniso phi_pmg phi_ectoderm : Int) : Int :=
  495 * phi_aniso + 145 * phi_pmg - 75 * (1 - phi_ectoderm) * phi_aniso
theorem streichan_2018_global_flow_and_mutant_collapse :
    v100_wt_gbe = 640 ∧ v100_twi_sna = 565 ∧ v100_aniso_only = 495 ∧
    v100_bcd_nos_tsl = 0 ∧ r1000_wt_gbe > 900 ∧
    v100_wt_gbe > v100_twi_sna ∧ v100_twi_sna > v100_aniso_only ∧
    v100_aniso_only > v100_eve_mutant ∧ v100_eve_mutant > v100_iso_only ∧
    v100_iso_only > v100_bcd_nos_tsl"""^^pk:lean4 ;
        skos:notation "r_WT (0.924) > r_twi_sna (0.892) > r_aniso_only (0.835) > r_eve (0.562) > r_iso_only (0.415) > r_bcd_nos_tsl (0.000)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
            <https://doi.org/10.1038/nature02590>,
            <https://doi.org/10.1038/nature09376>,
            <https://doi.org/10.7554/eLife.27454>,
            <https://doi.org/10.7554/eLife.78787>,
            <https://doi.org/10.7554/eLife.95521> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
        pk:leanDeclaration "MathOfBiology.Loop_048.streichan_flow_v100" ;
        pk:leanTheorem "MathOfBiology.Loop_048.streichan_2018_global_flow_and_mutant_collapse" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/streichan-global-morphogenetic-flow-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Curved-Surface Stokes-Brinkman Operator on the Prolate Spheroid & Sphere-Limit Gradient-Mode Eigenvalue" ;
        dct:description "Proves that the Gaussian-curvature correction -2 eta K generated by the covariant strain tensor on the closed blastoderm surface never destabilises the Stokes-Brinkman operator (eigenvalue >= xi > 0 for every l >= 1); this eigenvalue is the analytic target of the Pass 3 sphere-limit convergence check (observed order 2.04) | Variables: v: tangent velocity on the prolate spheroid (a = 250 um, b = 105 um); Delta_B: Bochner Laplacian; K: Gaussian curvature (Ricci identity term); e_ab = 1/2 (e_a . d_b v + e_b . d_a v): covariant strain from the embedded tangent basis; l: spherical-harmonic degree; xiR2 = xi R^2" ;
        dct:source "Streichan et al. (2018) eLife 7:e27454 Eq. 1 lifted to the curved surface; Lefebvre et al. (2023) eLife 12:e78787 (ellipsoidal geometry); Weitzenboeck/Bochner identity" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L491-L868>,
            <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L182-L209> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def surface_gradient_mode_symbol (eta eta_b xiR2 l : Int) : Int :=
  (eta + eta_b) * (l * (l + 1)) - 2 * eta + xiR2
theorem surface_stokes_brinkman_gradient_mode_pos
    (eta eta_b xiR2 l : Int)
    (hEta : eta > 0) (hEtaB : eta_b ≥ 0) (hXi : xiR2 > 0) (hL : l ≥ 1) :
    surface_gradient_mode_symbol eta eta_b xiR2 l ≥ xiR2 ∧
    surface_gradient_mode_symbol eta eta_b xiR2 l > 0"""^^pk:lean4 ;
        skos:notation "-eta Delta_B v - eta_b grad(div v) - eta K v + xi v = div sigma^a on x^2/a^2 + (y^2+z^2)/b^2 = 1, K = a^2/g_ss^2;  on a sphere: v = grad P_l  =>  R^2 lambda_l = (eta + eta_b) l(l+1) - 2 eta + xi R^2 >= xi R^2 > 0 for l >= 1" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
            <https://doi.org/10.1038/nature02590>,
            <https://doi.org/10.1038/nature09376>,
            <https://doi.org/10.7554/eLife.27454>,
            <https://doi.org/10.7554/eLife.78787>,
            <https://doi.org/10.7554/eLife.95521> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
        pk:leanDeclaration "MathOfBiology.Loop_048.surface_gradient_mode_symbol" ;
        pk:leanTheorem "MathOfBiology.Loop_048.surface_stokes_brinkman_gradient_mode_pos" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/streichan-global-morphogenetic-flow-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Strain-Rate-Dependent Positive-Feedback Myosin-II Recruitment Fixed Point" ;
        dct:description "Proves that the Lefebvre et al. (2023)-type mechanical positive feedback implemented in solve_prolate_blastoderm_flow has a unique bounded amplifying fixed point exactly when the loop gain is below 1 (measured g = 0.358, m*/m_0 = 1.70) and diverges otherwise | Variables: m_0: basal pair-rule-patterned cable myosin; e_nn = e_phiphi: strain rate along the DV director (negative = contraction); beta, e_ref: feedback strength and reference strain rate; g = p/q: loop gain; M: fixed-point myosin level" ;
        dct:source "Lefebvre et al. (2023) eLife 12:e78787 (geometric/mechanical control of myosin recruitment; reduced linear-feedback form is a modelling assumption)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L757-L838>,
            <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L211-L240> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem myosin_feedback_fixed_point
    (m0 p q M : Int)
    (hM0 : m0 > 0) (hP : p ≥ 0) (hQ : q > 0) :
    (p < q → q * M = q * m0 + p * M → (q - p) * M = q * m0 ∧ M ≥ m0) ∧
    (p ≥ q → M ≥ 0 → q * M ≠ q * m0 + p * M)"""^^pk:lean4 ;
        skos:notation "m_{n+1} = m_0 (1 + beta max(0, -e_nn[m_n]) / e_ref);  linearised gain g = p/q:  0 <= p < q  =>  (q - p) M = q m_0, M >= m_0 (bounded amplifying fixed point m* = m_0/(1-g));  p >= q  =>  no fixed point M >= 0 (run-away)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
            <https://doi.org/10.1038/nature02590>,
            <https://doi.org/10.1038/nature09376>,
            <https://doi.org/10.7554/eLife.27454>,
            <https://doi.org/10.7554/eLife.78787>,
            <https://doi.org/10.7554/eLife.95521> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
        pk:leanDeclaration "MathOfBiology.Loop_048.myosin_feedback_fixed_point" ;
        pk:leanTheorem "MathOfBiology.Loop_048.myosin_feedback_fixed_point" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/streichan-global-morphogenetic-flow-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "T1 / Rosette Resolution Junction Balance (Discrete Convergent Extension)" ;
        dct:description "Proves the junction bookkeeping used by simulate_intercalation_ledger: junction number is conserved while AP-minus-DV junction anisotropy increases by 2k per event, so cumulative T1/rosette events are the discrete source of the intercalation extension lambda_int = 1 + T/(N_ap N_dv) in the tension-isogonal decomposition | Variables: k: number of consecutive DV-oriented junctions of one Myosin-II cable collapsing into a single vertex; r = k + 3: rosette order (cells); j_ap, j_dv: counts of AP- and DV-oriented junctions in the trunk lattice" ;
        dct:source "Bertet, Sulak & Lecuit (2004) Nature 429:667-671 Fig. 1; Blankenship et al. (2006) Dev Cell 11:459-470; Brauns et al. (2024) eLife 13:RP95521" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f18e3533/2018-streichan-global-morphogenetic-flow.py#L870-L995>,
            <https://github.com/fractastical/morpholib/blob/f18e3533/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L242-L254> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem rosette_resolution_junction_balance
    (k j_ap j_dv : Int) (hK : k ≥ 1) :
    (k + 3) ≥ 4 ∧ ((k + 3) - 3) = k ∧ ((k + 3) - 2) = k + 1 ∧
    ((k ≥ 2) ↔ (k + 3) ≥ 5) ∧
    (j_ap + k) + (j_dv - k) = j_ap + j_dv ∧
    (j_ap + k) - (j_dv - k) = (j_ap - j_dv) + 2 * k"""^^pk:lean4 ;
        skos:notation "k >= 1 collapsed DV junctions -> rosette of r = k + 3 cells (k = 1: T1, r = 4; Blankenship rosettes r >= 5 <=> k >= 2); resolution -> r - 2 = k + 1 trivalent vertices and r - 3 = k new AP junctions; (j_ap + k) + (j_dv - k) = j_ap + j_dv, (j_ap + k) - (j_dv - k) = (j_ap - j_dv) + 2k" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2006.09.007>,
            <https://doi.org/10.1038/nature02590>,
            <https://doi.org/10.1038/nature09376>,
            <https://doi.org/10.7554/eLife.27454>,
            <https://doi.org/10.7554/eLife.78787>,
            <https://doi.org/10.7554/eLife.95521> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Compressible Viscous Stokes-Brinkman Sheet Flow Driven by Anisotropic Myosin-II Active Nematic Stress Tensor Divergence" ;
        pk:leanDeclaration "MathOfBiology.Loop_048.rosette_resolution_junction_balance" ;
        pk:leanTheorem "MathOfBiology.Loop_048.rosette_resolution_junction_balance" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sugimura-tracheal-viscous-fingering-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Nelson et al. (2017) Microfluidic Chest Transmural Pressure Gauge Invariance Law" ;
        dct:description "Establishes that embryonic lung branching rate and ASM peristaltic wave frequency depend strictly on the transmural difference P_lumen - P_pleura and are invariant under common-mode hydrostatic shifts | Variables: P_lumen: luminal airway fluid pressure (Pa); P_pleura: microfluidic chest pleural cavity pressure (Pa); c: common-mode hydrostatic pressure shift (Pa); ΔP: transmural pressure difference (Pa)" ;
        dct:source "Nelson, Gleghorn, Myers, Radisky & Stone (2017) Development 144(23):4328-4335 Figs. 1-2" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L120-L195>,
            <https://github.com/fractastical/morpholib/blob/171769b9/morphoeval/lean/loops/Loop_059_tracheal_viscous_fingering.lean#L28-L44> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def transmural_pressure (P_lum P_pl : Int) : Int :=
  P_lum - P_pl
theorem nelson_2017_transmural_pressure_gauge_invariance
    (P_lum P_pl c P : Int) :
    transmural_pressure (P_lum + c) (P_pl + c) =
      transmural_pressure P_lum P_pl ∧
    transmural_pressure P 0 = transmural_pressure 0 (-P) ∧
    transmural_pressure P P = 0
"""^^pk:lean4 ;
        skos:notation "ΔP(P_lumen, P_pleura) = P_lumen - P_pleura  ⇒  ΔP(P_lumen + c, P_pleura + c) = ΔP(P_lumen, P_pleura)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2009.12.010>,
            <https://doi.org/10.1016/j.devcel.2015.08.012>,
            <https://doi.org/10.1016/j.mod.2007.11.007>,
            <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1113/jphysiol.1974.sp010659>,
            <https://doi.org/10.1152/jappl.1986.60.1.160>,
            <https://doi.org/10.1152/jappl.1996.81.1.209>,
            <https://doi.org/10.1242/dev.154823>,
            <https://doi.org/10.1242/dev.167395> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Laplace–Young Transmural Epithelial Wall Stress, Mechanosensitive FGF10/ERK1/2/Etv4 Tip Bifurcation Rate & Synchronized Airway Smooth Muscle (ASM) Peristaltic Calcium Waves" ;
        pk:leanDeclaration "MathOfBiology.Loop_059.transmural_pressure" ;
        pk:leanTheorem "MathOfBiology.Loop_059.nelson_2017_transmural_pressure_gauge_invariance" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sugimura-tracheal-viscous-fingering-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Laplace–Young Circumferential Epithelial Wall Stress Monotonicity Law" ;
        dct:description "Connects positive transmural pressure ΔP to circumferential tensile stress in the distal airway epithelium that activates FGF10/ERK1/2/Etv4 tip proliferation | Variables: σ_θ: circumferential Laplace hoop tension across distal epithelial wall (Pa); R: distal epithelial bud luminal radius (μm); h: epithelial wall thickness (μm)" ;
        dct:source "Nelson et al. (2017) Development 144:4328-4335; Jaslove & Nelson (2018) Development 145:dev167395" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L140-L215>,
            <https://github.com/fractastical/morpholib/blob/171769b9/morphoeval/lean/loops/Loop_059_tracheal_viscous_fingering.lean#L56-L78> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def laplace_hoop_stress_scaled (dP R : Int) : Int :=
  dP * R
theorem laplace_epithelial_hoop_stress_monotonicity
    (P_lum P_pl c dP1 dP2 R : Int)
    (hR : 0 < R)
    (hdP : dP1 < dP2) :
    laplace_hoop_stress_scaled (transmural_pressure (P_lum + c) (P_pl + c)) R =
      laplace_hoop_stress_scaled (transmural_pressure P_lum P_pl) R ∧
    laplace_hoop_stress_scaled dP2 R - laplace_hoop_stress_scaled dP1 R =
      (dP2 - dP1) * R ∧
    laplace_hoop_stress_scaled dP1 R < laplace_hoop_stress_scaled dP2 R
"""^^pk:lean4 ;
        skos:notation "σ_θ(ΔP, R, h) = (ΔP · R) / h  ⇒  (R > 0 ∧ h > 0 ∧ ΔP_2 > ΔP_1) ⟹ σ_θ(ΔP_2) > σ_θ(ΔP_1)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2009.12.010>,
            <https://doi.org/10.1016/j.devcel.2015.08.012>,
            <https://doi.org/10.1016/j.mod.2007.11.007>,
            <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1113/jphysiol.1974.sp010659>,
            <https://doi.org/10.1152/jappl.1986.60.1.160>,
            <https://doi.org/10.1152/jappl.1996.81.1.209>,
            <https://doi.org/10.1242/dev.154823>,
            <https://doi.org/10.1242/dev.167395> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Laplace–Young Transmural Epithelial Wall Stress, Mechanosensitive FGF10/ERK1/2/Etv4 Tip Bifurcation Rate & Synchronized Airway Smooth Muscle (ASM) Peristaltic Calcium Waves" ;
        pk:leanDeclaration "MathOfBiology.Loop_059.laplace_hoop_stress_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_059.laplace_epithelial_hoop_stress_monotonicity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sugimura-tracheal-viscous-fingering-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Tracheal Drainage & Nifedipine ASM Blockade Hypoplasia Arrest Law" ;
        dct:description "Explains why either tracheal intubation drainage (ΔP ≤ ΔP_c) or nifedipine Ca2+ channel blockade (α_ASM → 0) arrests embryonic lung branching into hypoplasia | Variables: Γ_branch: terminal bud bifurcation rate (day^-1); ΔP_c: critical transmural distension threshold (50 Pa); K_P: half-saturation pressure (140 Pa); α_ASM: airway smooth muscle L-type Ca2+ peristaltic activity factor" ;
        dct:source "Nelson et al. (2017) Development 144:4328-4335 Figs. 3-4; Kim et al. (2015) Dev. Cell 34:668-681; Unbekandt et al. (2008) Mech. Dev. 125:314-324" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L150-L320>,
            <https://github.com/fractastical/morpholib/blob/171769b9/morphoeval/lean/loops/Loop_059_tracheal_viscous_fingering.lean#L93-L119> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def excess_pressure_pos (dP dP_c : Int) : Int :=
  if dP <= dP_c then 0 else dP - dP_c
def branching_rate_numerator (alpha_asm dP dP_c : Int) : Int :=
  alpha_asm * (excess_pressure_pos dP dP_c * excess_pressure_pos dP dP_c)
theorem tracheal_drainage_and_nifedipine_hypoplasia_arrest
    (alpha_asm dP_sub dP_sup dP_c : Int)
    (h_alpha : 0 < alpha_asm)
    (h_sub : dP_sub <= dP_c)
    (h_sup : dP_c < dP_sup) :
    branching_rate_numerator alpha_asm dP_sub dP_c = 0 ∧
    branching_rate_numerator 0 dP_sup dP_c = 0 ∧
    0 < branching_rate_numerator alpha_asm dP_sup dP_c
"""^^pk:lean4 ;
        skos:notation "Γ_branch(ΔP, α_ASM) = Γ_0 α_ASM (ΔP - ΔP_c)_+^n / (K_P^n + (ΔP - ΔP_c)_+^n)  ⇒  (ΔP ≤ ΔP_c ∨ α_ASM = 0) ⟹ Γ_branch = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2009.12.010>,
            <https://doi.org/10.1016/j.devcel.2015.08.012>,
            <https://doi.org/10.1016/j.mod.2007.11.007>,
            <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1113/jphysiol.1974.sp010659>,
            <https://doi.org/10.1152/jappl.1986.60.1.160>,
            <https://doi.org/10.1152/jappl.1996.81.1.209>,
            <https://doi.org/10.1242/dev.154823>,
            <https://doi.org/10.1242/dev.167395> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Laplace–Young Transmural Epithelial Wall Stress, Mechanosensitive FGF10/ERK1/2/Etv4 Tip Bifurcation Rate & Synchronized Airway Smooth Muscle (ASM) Peristaltic Calcium Waves" ;
        pk:leanDeclaration "MathOfBiology.Loop_059.branching_rate_numerator" ;
        pk:leanTheorem "MathOfBiology.Loop_059.tracheal_drainage_and_nifedipine_hypoplasia_arrest" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sugimura-tracheal-viscous-fingering-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Poiseuille Airway-Tree Luminal Pressure Accumulation Law (Pass 3)" ;
        dct:description "Spatially resolves luminal pressure on the 3D bronchial tree with distributed secretion sources; proves the distal tip transmural pressure is never below the tracheal one and that intra-tree drops are non-negative (numerically < 0.01% of ΔP, validating the uniform-ΔP assumption of the 2D solver) | Variables: j_Cl(g): CFTR/NKCC1 chloride-driven secretion per unit epithelial area at generation g (nL/min/μm²); r_i, L_i: segment radius and length (μm); μ: lung-liquid viscosity (Pa·s); R_larynx: laryngeal outflow resistance; P_amn: amniotic pressure" ;
        dct:source "Olver & Strang (1974) J. Physiol. 241:327-357 (chloride-driven lung-liquid secretion); Harding, Bocking & Sigger (1986) J. Appl. Physiol. 60:160-165 (upper-airway resistance dominates); Metzger et al. (2008) Nature 453:745-750 (orthogonal bifurcation)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L365-L628>,
            <https://github.com/fractastical/morpholib/blob/171769b9/morphoeval/lean/loops/Loop_059_tracheal_viscous_fingering.lean#L138-L164> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def pressure_along_path : Int → List Int → Int
  | P, [] => P
  | P, d :: ds => pressure_along_path (P + d) ds
theorem poiseuille_tree_pressure_accumulation
    (P_trachea P_pleura : Int) (drops : List Int)
    (h_nonneg : ∀ d, d ∈ drops → 0 ≤ d) :
    P_trachea ≤ pressure_along_path P_trachea drops ∧
    P_trachea - P_pleura ≤ pressure_along_path P_trachea drops - P_pleura
"""^^pk:lean4 ;
        skos:notation "Q_i = Σ_{j∈subtree(i)} j_Cl(g_j)·2πr_jL_j,  R_i = 8μL_i/(πr_i⁴),  P_node = P_amn + R_larynx Q_tot + Σ_path R_i Q_i  ⇒  (∀ i: R_i Q_i ≥ 0) ⟹ ΔP(tip) ≥ ΔP(trachea)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2009.12.010>,
            <https://doi.org/10.1016/j.devcel.2015.08.012>,
            <https://doi.org/10.1016/j.mod.2007.11.007>,
            <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1113/jphysiol.1974.sp010659>,
            <https://doi.org/10.1152/jappl.1986.60.1.160>,
            <https://doi.org/10.1152/jappl.1996.81.1.209>,
            <https://doi.org/10.1242/dev.154823>,
            <https://doi.org/10.1242/dev.167395> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Laplace–Young Transmural Epithelial Wall Stress, Mechanosensitive FGF10/ERK1/2/Etv4 Tip Bifurcation Rate & Synchronized Airway Smooth Muscle (ASM) Peristaltic Calcium Waves" ;
        pk:leanDeclaration "MathOfBiology.Loop_059.pressure_along_path" ;
        pk:leanTheorem "MathOfBiology.Loop_059.poiseuille_tree_pressure_accumulation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sugimura-tracheal-viscous-fingering-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Laryngeal Valve Duty-Cycle Monotonicity Law (Pass 3)" ;
        dct:description "Explains tracheal occlusion hyperplasia (d = 0 maximises time-integrated ΔP) versus drainage / permanently open larynx hypoplasia (d = 1 minimises it); the Hill nonlinearity of Γ_branch yields a Jensen gap between time-averaged and mean-pressure branching | Variables: Q: luminal secretion rate; R_closed / R_open: laryngeal resistance with glottis adducted / during fetal breathing-movement episodes; d: open duty (out of D); P_amn: amniotic pressure; C: lung compliance" ;
        dct:source "Harding & Hooper (1996) J. Appl. Physiol. 81:209-224; Harding, Bocking & Sigger (1986) J. Appl. Physiol. 60:160-165; Unbekandt et al. (2008) Mech. Dev. 125:314-324; Nelson et al. (2017) Development 144:4328-4335" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L630-L720>,
            <https://github.com/fractastical/morpholib/blob/171769b9/morphoeval/lean/loops/Loop_059_tracheal_viscous_fingering.lean#L179-L216> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def valve_steady_pressure (P_amn Q R : Int) : Int :=
  P_amn + Q * R
def valve_cycle_integrated_pressure (P_open P_closed d D : Int) : Int :=
  d * P_open + (D - d) * P_closed
theorem laryngeal_valve_duty_cycle_monotonicity
    (P_amn Q R_open R_closed d1 d2 D : Int)
    (hQ : 0 < Q) (hR : R_open < R_closed) (hd : d1 < d2) :
    valve_steady_pressure P_amn Q R_open < valve_steady_pressure P_amn Q R_closed ∧
    valve_cycle_integrated_pressure (valve_steady_pressure P_amn Q R_open)
        (valve_steady_pressure P_amn Q R_closed) d2 D <
      valve_cycle_integrated_pressure (valve_steady_pressure P_amn Q R_open)
        (valve_steady_pressure P_amn Q R_closed) d1 D
"""^^pk:lean4 ;
        skos:notation "C dP/dt = Q − (P − P_amn)/R_larynx(t),  R_larynx ∈ {R_closed, R_open},  P_open = P_amn + Q R_open < P_closed = P_amn + Q R_closed  ⇒  d₁ < d₂ ⟹ d₂P_open + (D−d₂)P_closed < d₁P_open + (D−d₁)P_closed" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2009.12.010>,
            <https://doi.org/10.1016/j.devcel.2015.08.012>,
            <https://doi.org/10.1016/j.mod.2007.11.007>,
            <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1113/jphysiol.1974.sp010659>,
            <https://doi.org/10.1152/jappl.1986.60.1.160>,
            <https://doi.org/10.1152/jappl.1996.81.1.209>,
            <https://doi.org/10.1242/dev.154823>,
            <https://doi.org/10.1242/dev.167395> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Coupled Laplace–Young Transmural Epithelial Wall Stress, Mechanosensitive FGF10/ERK1/2/Etv4 Tip Bifurcation Rate & Synchronized Airway Smooth Muscle (ASM) Peristaltic Calcium Waves" ;
        pk:leanDeclaration "MathOfBiology.Loop_059.valve_cycle_integrated_pressure" ;
        pk:leanTheorem "MathOfBiology.Loop_059.laryngeal_valve_duty_cycle_monotonicity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sumper-diatom-frustule-phase-sep-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Cahn-Hilliard (1958) / Lenoci & Camp (2008) Double-Well Chemical Potential & Binodal Phase Equilibria" ;
        dct:description "Defines the bistable double-well free energy driving spontaneous demixing of LCPA microdroplets from precipitating biosilica within the diatom SDV | Variables: φ(x,y,t) ∈ [-1, 1]: order parameter (+1 silica wall, -1 LCPA droplet pore); ε: interfacial thickness parameter" ;
        dct:source "Lenoci & Camp (2008) Langmuir 24(1):217-223 Eqs. (1)-(3); Cahn & Hilliard (1958) J. Chem. Phys. 28:258" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a69596cc/2002-sumper-diatom-frustule-phase-sep.py#L178-L243>,
            <https://github.com/fractastical/morpholib/blob/a69596cc/morphoeval/lean/loops/Loop_071_diatom_frustule_phase_sep.lean#L21-L39> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cahn_hilliard_bulk_mu (phi : Int) : Int := phi * phi * phi - phi
theorem cahn_hilliard_binodal_equilibria :
    cahn_hilliard_bulk_mu 1 = 0 ∧
    cahn_hilliard_bulk_mu (-1) = 0 ∧
    cahn_hilliard_bulk_mu 0 = 0 := by decide
"""^^pk:lean4 ;
        skos:notation "μ(φ) = φ^3 - φ - ε^2 ∇^2 φ,   μ_bulk(±1) = 0,   μ_bulk(-φ) = -μ_bulk(φ)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0378-4371(92)90111-2>,
            <https://doi.org/10.1021/la7022784>,
            <https://doi.org/10.1063/1.1744102>,
            <https://doi.org/10.1111/j.0022-3646.1983.00387.x>,
            <https://doi.org/10.1126/science.1070026>,
            <https://doi.org/10.1166/jnn.2006.174> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Fourth-Order Cahn-Hilliard Spinodal Phase Separation PDE & Hierarchical Hexagonal Packing" ;
        pk:leanDeclaration "MathOfBiology.Loop_071.cahn_hilliard_bulk_mu" ;
        pk:leanTheorem "MathOfBiology.Loop_071.cahn_hilliard_binodal_equilibria" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sumper-diatom-frustule-phase-sep-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Fourth-Order Cahn-Hilliard Spinodal Dispersion & Wavelength Selection Law" ;
        dct:description "Selects the characteristic pore spacing λ_c = 2π/k_c inside the spinodal (|φ_0| < 1/√3) while guaranteeing exact mass conservation (σ(0)=0) and stability outside the spinodal | Variables: M: mobility; φ_0: mean composition; α = 1 - 3 φ_0^2: spinodal instability drive; q = k^2: squared wavenumber; k_c: fastest-growing wavenumber" ;
        dct:source "Lenoci & Camp (2008) Langmuir 24(1):217-223 Section 2; Sumper (2002) Science 295:2430" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a69596cc/2002-sumper-diatom-frustule-phase-sep.py#L124-L171>,
            <https://github.com/fractastical/morpholib/blob/a69596cc/morphoeval/lean/loops/Loop_071_diatom_frustule_phase_sep.lean#L48-L69> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cahn_hilliard_dispersion (M alpha eps_sq q : Int) : Int :=
  M * q * (alpha - eps_sq * q)
theorem cahn_hilliard_mass_conservation_zero_mode (M alpha eps_sq : Int) :
    cahn_hilliard_dispersion M alpha eps_sq 0 = 0 := by simp [cahn_hilliard_dispersion]
theorem cahn_hilliard_spinodal_band_selection :
    cahn_hilliard_dispersion 1 4 1 2 = 4 ∧
    cahn_hilliard_dispersion 1 4 1 4 = 0 ∧
    cahn_hilliard_dispersion 1 (-2) 1 1 = -3 := by decide
"""^^pk:lean4 ;
        skos:notation "∂_t φ = M ∇^2(φ^3 - φ - ε^2 ∇^2 φ) ⟹ σ(k) = M k^2 (1 - 3 φ_0^2 - ε^2 k^2),  k_c = √((1 - 3 φ_0^2)/(2 ε^2)),  λ_c = 2π / k_c" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0378-4371(92)90111-2>,
            <https://doi.org/10.1021/la7022784>,
            <https://doi.org/10.1063/1.1744102>,
            <https://doi.org/10.1111/j.0022-3646.1983.00387.x>,
            <https://doi.org/10.1126/science.1070026>,
            <https://doi.org/10.1166/jnn.2006.174> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Fourth-Order Cahn-Hilliard Spinodal Phase Separation PDE & Hierarchical Hexagonal Packing" ;
        pk:leanDeclaration "MathOfBiology.Loop_071.cahn_hilliard_dispersion" ;
        pk:leanTheorem "MathOfBiology.Loop_071.cahn_hilliard_spinodal_band_selection" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sumper-diatom-frustule-phase-sep-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Sumper (2002) Hierarchical LCPA Droplet Subdivision & Centered Hexagonal Packing Law" ;
        dct:description "Explains the self-similar hierarchical nesting of 7 to 19 secondary cribrum pores inside each primary hexagonal areola and tertiary cribrella sieve pores in Coscinodiscus | Variables: m ∈ {1, 2, 3}: hierarchical tier (foramen, cribrum, cribrella); ρ ≈ 0.18: inter-tier scale ratio; R: hexagonal ring number" ;
        dct:source "Sumper (2002) Science 295(5564):2430-2433 Figs. 1-4; Losic et al. (2006) J. Nanosci. Nanotechnol. 6:982" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a69596cc/2002-sumper-diatom-frustule-phase-sep.py#L244-L331>,
            <https://github.com/fractastical/morpholib/blob/a69596cc/morphoeval/lean/loops/Loop_071_diatom_frustule_phase_sep.lean#L78-L96> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def centered_hexagonal_droplets (R : Nat) : Nat := 1 + 3 * R * (R + 1)
theorem sumper_2002_hierarchical_hex_packing (s0 ratio : Nat) :
    sumper_tier_scale s0 ratio 2 = ratio * (ratio * s0) ∧
    centered_hexagonal_droplets 1 = 7 ∧
    centered_hexagonal_droplets 2 = 19 := by
  simp [sumper_tier_scale, centered_hexagonal_droplets]
"""^^pk:lean4 ;
        skos:notation "d_m = d_1 ρ^{m-1},   a_m = a_1 ρ^{m-1},   H(R) = 1 + 3 R (R + 1) ∈ {1, 7, 19, 37, ...}" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0378-4371(92)90111-2>,
            <https://doi.org/10.1021/la7022784>,
            <https://doi.org/10.1063/1.1744102>,
            <https://doi.org/10.1111/j.0022-3646.1983.00387.x>,
            <https://doi.org/10.1126/science.1070026>,
            <https://doi.org/10.1166/jnn.2006.174> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Fourth-Order Cahn-Hilliard Spinodal Phase Separation PDE & Hierarchical Hexagonal Packing" ;
        pk:leanDeclaration "MathOfBiology.Loop_071.centered_hexagonal_droplets" ;
        pk:leanTheorem "MathOfBiology.Loop_071.sumper_2002_hierarchical_hex_packing" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sumper-diatom-frustule-phase-sep-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Furukawa (1992) Directional (Centrifugal) Quench: Stability Ahead of the Advancing Front" ;
        dct:description "Couples the Cahn-Hilliard equation to the radially advancing silica-precipitation front: the mixture is linearly stable until the front passes, after which demixing proceeds; slow fronts (Pe = v/(λ_c σ_max) ≲ 0.1) select radial, bifurcating costae lamellae, fast fronts concentric lamellae | Variables: R0: initial quench radius; v: centrifugal front speed (px/time); w: front width; a(r,t) ∈ [-1, 1]: local quench drive; q = k^2" ;
        dct:source "Furukawa H (1992) Physica A 180:128-155; Schmid & Volcani (1983) J. Phycol. 19:387 (centrifugal valve silicification); Sumper (2002) Science 295:2430" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a69596cc/2002-sumper-diatom-frustule-phase-sep.py#L405-L538>,
            <https://github.com/fractastical/morpholib/blob/a69596cc/morphoeval/lean/loops/Loop_071_diatom_frustule_phase_sep.lean#L105-L118> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem directional_quench_stable_ahead_of_front
    (M eps_sq q : Int) (hM : 0 < M) (hq : 0 < q) (he : 0 ≤ eps_sq) :
    cahn_hilliard_dispersion M (-1) eps_sq q < 0 := by
  unfold cahn_hilliard_dispersion
  have hMq : 0 < M * q := Int.mul_pos hM hq
  have heq : 0 ≤ eps_sq * q := Int.mul_nonneg he (Int.le_of_lt hq)
  have hneg : -1 - eps_sq * q < 0 := by omega
  have := Int.mul_lt_mul_of_pos_left hneg hMq
  simpa using this
"""^^pk:lean4 ;
        skos:notation "a(r,t) = tanh((R0 + v t - r)/w);  ahead of the front a = -1:  σ(k) = M k^2 (-1 - ε^2 k^2) < 0  ∀ k ≠ 0;  behind it a = +1 (spinodal)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0378-4371(92)90111-2>,
            <https://doi.org/10.1021/la7022784>,
            <https://doi.org/10.1063/1.1744102>,
            <https://doi.org/10.1111/j.0022-3646.1983.00387.x>,
            <https://doi.org/10.1126/science.1070026>,
            <https://doi.org/10.1166/jnn.2006.174> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Fourth-Order Cahn-Hilliard Spinodal Phase Separation PDE & Hierarchical Hexagonal Packing" ;
        pk:leanDeclaration "MathOfBiology.Loop_071.cahn_hilliard_dispersion" ;
        pk:leanTheorem "MathOfBiology.Loop_071.directional_quench_stable_ahead_of_front" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/sumper-diatom-frustule-phase-sep-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Lagging Silica-Precipitation Front: Frozen Region Inside the Quenched Disc & Irreversible Solidification" ;
        dct:description "Guarantees the model never freezes un-quenched mixture and that silica precipitation is irreversible; the same frozen-wall mechanism confines tiers 2-3 of the explicit 3-stage 512x512 single-domain quench to the unsolidified chambers of the previous tier | Variables: lag = 1.0 λ_c: distance between quench and precipitation fronts; frozen pixels: zero mobility, value held, leaked mass re-projected onto mobile pixels (exact total conservation)" ;
        dct:source "Sumper (2002) Science 295:2430 (sequential LCPA droplet subdivision with intervening silica precipitation); Lenoci & Camp (2008) Langmuir 24:217 Sec. 3.3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a69596cc/2002-sumper-diatom-frustule-phase-sep.py#L600-L724>,
            <https://github.com/fractastical/morpholib/blob/a69596cc/morphoeval/lean/loops/Loop_071_diatom_frustule_phase_sep.lean#L120-L144> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def quench_front_radius (R0 v t : Nat) : Nat := R0 + v * t
def solidification_radius (R0 v lag t : Nat) : Nat := quench_front_radius R0 v t - lag
theorem frozen_front_monotone_irreversible (R0 v lag t1 t2 : Nat)
    (hlag : 0 < lag) (hsolid : 0 < solidification_radius R0 v lag t1) (ht : t1 ≤ t2) :
    solidification_radius R0 v lag t1 < quench_front_radius R0 v t1 ∧
    quench_front_radius R0 v t1 ≤ quench_front_radius R0 v t2 ∧
    solidification_radius R0 v lag t1 ≤ solidification_radius R0 v lag t2 := by
  unfold solidification_radius quench_front_radius at *
  have hv : v * t1 ≤ v * t2 := Nat.mul_le_mul_left v ht
  omega
"""^^pk:lean4 ;
        skos:notation "R(t) = R0 + v t,  R_s(t) = R(t) - lag;  0 < lag ∧ 0 < R_s(t1) ⟹ R_s(t1) < R(t1);  t1 ≤ t2 ⟹ R(t1) ≤ R(t2) ∧ R_s(t1) ≤ R_s(t2)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0378-4371(92)90111-2>,
            <https://doi.org/10.1021/la7022784>,
            <https://doi.org/10.1063/1.1744102>,
            <https://doi.org/10.1111/j.0022-3646.1983.00387.x>,
            <https://doi.org/10.1126/science.1070026>,
            <https://doi.org/10.1166/jnn.2006.174> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Fourth-Order Cahn-Hilliard Spinodal Phase Separation PDE & Hierarchical Hexagonal Packing" ;
        pk:leanDeclaration "MathOfBiology.Loop_071.solidification_radius" ;
        pk:leanTheorem "MathOfBiology.Loop_071.frozen_front_monotone_irreversible" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/tailbud-neuromesodermal-jamming-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Extracellular Space Compaction & Rigidity-Percolation Supracellular Yield Stress Law" ;
        dct:description "Establishes how posterior-to-anterior compaction of extracellular spaces drives cell packing across the rigidity-percolation threshold phi_c = 0.860, generating a 10-fold anterior surge in tissue yield stress | Variables: phi_ECS(x): extracellular space volume fraction (0.145 in MPZ -> 0.049 in A-PSM); phi_pack(x) = 1 - phi_ECS(x): cell packing fraction; phi_c approx 0.860: Maxwell isostatic rigidity-percolation threshold; sigma_y(x): ferrofluid-measured supracellular yield stress (Pa)" ;
        dct:source "Mongera et al. (2018) Nature 561(7723):401-405 Figs. 1-3; Kim et al. (2021) Nature Physics 17(7):859-866 Eqs. 1-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L90-L175>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_030_neuromesodermal_jamming.lean#L20-L72> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cell_packing_milli (phi_ecs : Int) : Int := 1000 - phi_ecs
def yield_stress_scaled (sigma_0 phi_pack phi_c : Int) : Int :=
  if phi_c < phi_pack then sigma_0 * (phi_pack - phi_c) else 0
theorem rigidity_percolation_yield_stress_onset
    (sigma_0 phi_fluid phi_solid phi_1 phi_2 phi_c phi_ecs_post phi_ecs_ant : Int)
    (h_fluid : phi_fluid <= phi_c) (h_solid : phi_c < phi_solid)
    (h_sub : phi_c <= phi_1) (h_order : phi_1 < phi_2) (h_ecs : phi_ecs_ant < phi_ecs_post) :
    yield_stress_scaled sigma_0 phi_fluid phi_c = 0 ∧
    yield_stress_scaled 1 phi_solid phi_c > 0 ∧
    cell_packing_milli phi_ecs_post < cell_packing_milli phi_ecs_ant ∧
    yield_stress_scaled 1 phi_1 phi_c < yield_stress_scaled 1 phi_2 phi_c"""^^pk:lean4 ;
        skos:notation "\\phi_{\\text{pack}}(x) = 1 - \\phi_{\\text{ECS}}(x),\\qquad \\sigma_y(x) = \\sigma_0 \\max\\!\\left(0,\\, \\phi_{\\text{pack}}(x) - \\phi_c\\right)^\\beta = \\sigma_0 \\max\\!\\left(0,\\, \\phi_{\\text{ECS,crit}} - \\phi_{\\text{ECS}}(x)\\right)^\\beta" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0960-9822(03)00534-7>,
            <https://doi.org/10.1016/j.cell.2017.08.043>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1016/j.cub.2013.05.052>,
            <https://doi.org/10.1038/nmeth.4101>,
            <https://doi.org/10.1038/s41567-021-01215-1>,
            <https://doi.org/10.1038/s41586-018-0479-2>,
            <https://doi.org/10.1126/science.1253089>,
            <https://doi.org/10.1242/dev.090381> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Active Fluid-to-Solid Jamming Transition & Bingham Viscoplastic Axis Elongation (Mongera-Kim-Campas Active Foam Mechanics)" ;
        pk:leanDeclaration "MathOfBiology.Loop_030.yield_stress_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_030.rigidity_percolation_yield_stress_onset" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/tailbud-neuromesodermal-jamming-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Active Tension Fluctuation vs. Yield-Stress Caging & Kramers/Bingham Fluid-to-Solid Crossover" ;
        dct:description "Proves that active tension fluctuations fluidize the posterior MPZ (sigma_A > sigma_y) via frequent T1 neighbor exchanges, whereas rising yield stress freezes T1 rearrangements into a solid state in the PSM (sigma_y >= sigma_A) | Variables: sigma_A(x): cell-scale non-muscle Myosin-II active tension fluctuations (50 Pa in MPZ -> 13 Pa in A-PSM); k_T1(x): rate of T1 topological neighbor exchanges (min^-1); eta_p: plastic viscosity" ;
        dct:source "Mongera et al. (2018) Nature 561:401-405 Fig. 2; Kim et al. (2021) Nature Physics 17:859-866 Figs. 2-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L140-L245>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_030_neuromesodermal_jamming.lean#L36-L95> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def net_jamming_barrier (sigma_y sigma_A : Int) : Int := sigma_y - sigma_A
def bingham_plastic_rate_num (sigma_eff sigma_y : Int) : Int :=
  if sigma_y < sigma_eff then sigma_eff - sigma_y else 0
theorem active_fluctuation_fluid_to_solid_jamming_crossover
    (sigma_y_mpz sigma_A_mpz sigma_y_apsm sigma_A_apsm : Int)
    (h_mpz_fluid : sigma_y_mpz < sigma_A_mpz) (h_apsm_solid : sigma_A_apsm <= sigma_y_apsm) :
    net_jamming_barrier sigma_y_mpz sigma_A_mpz < 0 ∧
    bingham_plastic_rate_num sigma_A_mpz sigma_y_mpz > 0 ∧
    net_jamming_barrier sigma_y_apsm sigma_A_apsm >= 0 ∧
    bingham_plastic_rate_num sigma_A_apsm sigma_y_apsm = 0"""^^pk:lean4 ;
        skos:notation "\\Delta\\sigma_{\\text{cage}}(x) = \\sigma_y(x) - \\sigma_A(x),\\qquad \\dot{\\gamma}_p(x) = \\frac{\\max(0,\\, \\sigma_{\\text{eff}}(x) - \\sigma_y(x))}{\\eta_p},\\qquad k_{T1}(x) = k_0 \\exp\\!\\left(-c_B \\left(\\frac{\\sigma_y(x)}{\\sigma_A(x)}\\right)^{\\gamma_k}\\right)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0960-9822(03)00534-7>,
            <https://doi.org/10.1016/j.cell.2017.08.043>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1016/j.cub.2013.05.052>,
            <https://doi.org/10.1038/nmeth.4101>,
            <https://doi.org/10.1038/s41567-021-01215-1>,
            <https://doi.org/10.1038/s41586-018-0479-2>,
            <https://doi.org/10.1126/science.1253089>,
            <https://doi.org/10.1242/dev.090381> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Active Fluid-to-Solid Jamming Transition & Bingham Viscoplastic Axis Elongation (Mongera-Kim-Campas Active Foam Mechanics)" ;
        pk:leanDeclaration "MathOfBiology.Loop_030.bingham_plastic_rate_num" ;
        pk:leanTheorem "MathOfBiology.Loop_030.active_fluctuation_fluid_to_solid_jamming_crossover" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/tailbud-neuromesodermal-jamming-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Solid A-PSM Mechanical Backstop Rectification & cdh2 (N-Cadherin) Knockdown Bilateral Asymmetry Law" ;
        dct:description "Proves that the jammed A-PSM acts as an internal mechanical backstop that channels fluid MPZ cell addition into unidirectional posterior elongation and preserves left-right symmetry, whereas cdh2 knockdown unjams the PSM and induces bilateral asymmetry | Variables: J_MPZ: dorsal-medial progenitor cell influx into MPZ; sigma_y_APSM: anterior PSM backstop yield stress; phi_ecs_cdh2_apsm = 0.148 > phi_ECS_crit = 0.140: expanded extracellular space in N-cadherin morphants" ;
        dct:source "Mongera et al. (2018) Nature 561:401-405 Fig. 4; Lawton et al. (2013) Development 140:573-582" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L250-L435>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_030_neuromesodermal_jamming.lean#L97-L162> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem mongera_2018_wt_vs_cdh2_backstop_collapse :
    (cell_packing_milli phi_ecs_wt_mpz < phi_c_milli ∧
     phi_c_milli < cell_packing_milli phi_ecs_wt_ppsm ∧
     cell_packing_milli phi_ecs_wt_ppsm < cell_packing_milli phi_ecs_wt_apsm) ∧
    (yield_stress_scaled 1 (cell_packing_milli phi_ecs_wt_apsm) phi_c_milli = 91 ∧
     yield_stress_scaled 1 (cell_packing_milli phi_ecs_wt_apsm) phi_c_milli > sigma_A_wt_apsm) ∧
    (cell_packing_milli phi_ecs_cdh2_apsm < phi_c_milli ∧
     yield_stress_scaled 1 (cell_packing_milli phi_ecs_cdh2_apsm) phi_c_milli = 0)"""^^pk:lean4 ;
        skos:notation "v_{\\text{elong}} = J_{\\text{MPZ}} \\frac{\\sigma_{y,\\text{APSM}}}{\\sigma_{y,\\text{APSM}} + \\sigma_{y,\\text{MPZ}} + \\sigma_{\\text{ref}}},\\qquad \\phi_{\\text{pack}}^{\\text{cdh2}}(x) = 1 - \\phi_{\\text{ECS}}^{\\text{cdh2}}(x) < \\phi_c \\implies \\sigma_{y,\\text{APSM}}^{\\text{cdh2}} \\to 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0960-9822(03)00534-7>,
            <https://doi.org/10.1016/j.cell.2017.08.043>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1016/j.cub.2013.05.052>,
            <https://doi.org/10.1038/nmeth.4101>,
            <https://doi.org/10.1038/s41567-021-01215-1>,
            <https://doi.org/10.1038/s41586-018-0479-2>,
            <https://doi.org/10.1126/science.1253089>,
            <https://doi.org/10.1242/dev.090381> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Active Fluid-to-Solid Jamming Transition & Bingham Viscoplastic Axis Elongation (Mongera-Kim-Campas Active Foam Mechanics)" ;
        pk:leanDeclaration "MathOfBiology.Loop_030.rectified_posterior_flux_num" ;
        pk:leanTheorem "MathOfBiology.Loop_030.mongera_2018_wt_vs_cdh2_backstop_collapse" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/tailbud-neuromesodermal-jamming-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Quasi-3D Fibronectin ECM Sheath Hoop Confinement & Axial Channeling Law (Pass 3, Dray et al. 2013)" ;
        dct:description "Reduced thin-rod (axisymmetric) stand-in for the 3D fibronectin boundary of Dray et al. (2013): the fluid MPZ dilates radially against the FN sheath wherever active pressure exceeds the tissue yield stress, so fibronectin loss widens the tailbud and diverts progenitor influx away from posterior axis elongation (v/v_WT = 0.79 for fn1a;fn1b MO vs ~0.70 reported). Dynamic wall friction F_drag is reported as a diagnostic only. | Variables: f_FN(x): relative fibronectin matrix density wrapping the tailbud/PSM (0.35 MPZ -> 0.80 PSM, +0.20 at epithelialised somite borders anterior to the clock arrest front; fn_scale = 1.0 WT, 0.45 itga5 MO, 0.12 fn1a;fn1b MO); K_FN = 2800 Pa, K_t = 40 Pa per unit radial strain (calibrated); R_0(x): unstrained tissue radius (55 um MPZ bulb -> 38 um PSM column); chi: axial channeling efficiency (0.951 WT, 0.736 fn1a;fn1b MO)" ;
        dct:source "Dray et al. (2013) Current Biology 23(14):1335-1341 Figs. 1-4; Lawton et al. (2013) Development 140:573-582; Mongera et al. (2018) Nature 561:401-405 Fig. 1a" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L393-L514>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_030_neuromesodermal_jamming.lean#L150-L212> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def sheath_hoop_stiffness (k_fn f_fn k_t : Int) : Int := k_fn * f_fn + k_t
def channeling_milli (leak_milli : Int) : Int := 1000 - leak_milli
theorem fibronectin_sheath_confinement_channeling
    (k_fn f_wt f_mut k_t p eps_wt eps_mut leak_wt leak_mut : Int)
    (h_kfn : 0 < k_fn) (h_f : f_mut < f_wt) (h_kt : 0 < k_t) (h_fmut : 0 <= f_mut)
    (h_eps_wt : 0 < eps_wt)
    (h_eq_wt : eps_wt * sheath_hoop_stiffness k_fn f_wt k_t = p)
    (h_eq_mut : eps_mut * sheath_hoop_stiffness k_fn f_mut k_t = p)
    (h_leak : leak_wt < leak_mut) :
    sheath_hoop_stiffness k_fn f_mut k_t < sheath_hoop_stiffness k_fn f_wt k_t ∧
    eps_wt < eps_mut ∧
    channeling_milli leak_mut < channeling_milli leak_wt"""^^pk:lean4 ;
        skos:notation "\\varepsilon_r(x) = \\frac{\\max(0,\\, \\sigma_A(x) - \\sigma_y(x))}{K_{FN} f_{FN}(x) + K_t},\\qquad R_{eq}(x) = R_0(x)\\,(1 + \\varepsilon_r(x)),\\qquad \\chi = 1 - \\left\\langle 1 - \\frac{A_0}{A_{eq}} \\right\\rangle_{w,\\, x \\le x_{jam}},\\qquad v_{\\text{elong}} = J_{MPZ}\\, \\frac{\\sigma_{y,APSM}}{\\sigma_{y,APSM} + \\sigma_{y,MPZ} + \\sigma_{ref}}\\, \\chi" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0960-9822(03)00534-7>,
            <https://doi.org/10.1016/j.cell.2017.08.043>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1016/j.cub.2013.05.052>,
            <https://doi.org/10.1038/nmeth.4101>,
            <https://doi.org/10.1038/s41567-021-01215-1>,
            <https://doi.org/10.1038/s41586-018-0479-2>,
            <https://doi.org/10.1126/science.1253089>,
            <https://doi.org/10.1242/dev.090381> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Active Fluid-to-Solid Jamming Transition & Bingham Viscoplastic Axis Elongation (Mongera-Kim-Campas Active Foam Mechanics)" ;
        pk:leanDeclaration "MathOfBiology.Loop_030.sheath_hoop_stiffness" ;
        pk:leanTheorem "MathOfBiology.Loop_030.fibronectin_sheath_confinement_channeling" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/tailbud-neuromesodermal-jamming-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Her1/Her7 Segmentation-Clock Advection, Mechanical Wavefront Arrest & Cooke-Zeeman Somite Length Law (Pass 3)" ;
        dct:description "Couples the jamming gradient to the segmentation clock in both directions: the sigma_y/sigma_A ratio sets WHERE the clock arrests (strictly anterior to the fluid-to-solid crossover, Theorem 6 part 1), the backstop/sheath elongation speed sets HOW LONG each frozen her1 stripe is (Theorem 6 part 2), and arrested somites assemble fibronectin that feeds back into the sheath profile. | Variables: theta(x,t): Her1/Her7 clock phase in the tailbud-tip frame; u(x) = v_front [0.15 + 0.85 (1 - e^{-x/45 um})]: tissue advection; omega_0 = 2 pi / T_clock, T_clock = 23.5 min at 28 C (Herrgen 2010); c_slow = 0.6 (Soroldoni 2014 wave compression); Lambda_arr = 4 (deep-solid jamming ratio gating arrest, reduced stand-in for Hubaud 2017 mechanosensitivity); v_short = 0.45 um/min PSM shortening; S: somite length (46.2 um WT model vs ~47 um reference; 27 um blebbistatin; no arrest for cdh2 MO)" ;
        dct:source "Oates & Ho (2002) Development 129:2929; Lewis (2003) Current Biology 13:1398-1408; Herrgen et al. (2010) Current Biology 20:1244-1253; Soroldoni et al. (2014) Science 345:222-225; Hubaud et al. (2017) Cell 171:668-682; Cooke & Zeeman (1976) J. Theor. Biol. 58:455-476" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2022-tailbud-neuromesodermal-jamming.py#L517-L640>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_030_neuromesodermal_jamming.lean#L214-L247> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def somite_length_num (v_front t_clock : Int) : Int := v_front * t_clock
theorem clock_wavefront_arrest_somite_scaling
    (r : Int → Int) (x_jam x_arr lam v_wt v_mut t_clock : Int)
    (h_mono : ∀ x y : Int, x < y → r x < r y)
    (h_jam : r x_jam = 1000) (h_lam : 1000 < lam) (h_arr : lam <= r x_arr)
    (h_t : 0 < t_clock) (h_v : v_mut < v_wt) :
    x_jam < x_arr ∧
    somite_length_num v_mut t_clock < somite_length_num v_wt t_clock"""^^pk:lean4 ;
        skos:notation "\\partial_t \\theta + u(x)\\, \\partial_x \\theta = \\omega(x),\\qquad \\omega(x) = \\omega_0 \\left[1 - c_{slow} \\left(\\frac{x}{x_{arr}}\\right)^2\\right] \\mathbb{1}_{x < x_{arr}},\\qquad x_{arr} = \\min\\{x : \\sigma_y(x)/\\sigma_A(x) \\ge \\Lambda_{arr}\\},\\qquad S = (v_{\\text{elong}} + v_{short})\\, T_{clock}" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0960-9822(03)00534-7>,
            <https://doi.org/10.1016/j.cell.2017.08.043>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1016/j.cub.2013.05.052>,
            <https://doi.org/10.1038/nmeth.4101>,
            <https://doi.org/10.1038/s41567-021-01215-1>,
            <https://doi.org/10.1038/s41586-018-0479-2>,
            <https://doi.org/10.1126/science.1253089>,
            <https://doi.org/10.1242/dev.090381> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Active Fluid-to-Solid Jamming Transition & Bingham Viscoplastic Axis Elongation (Mongera-Kim-Campas Active Foam Mechanics)" ;
        pk:leanDeclaration "MathOfBiology.Loop_030.somite_length_num" ;
        pk:leanTheorem "MathOfBiology.Loop_030.clock_wavefront_arrest_somite_scaling" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/tero-physarum-transport-network-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Tero et al. (2007, 2010) Hagen-Poiseuille Kirchhoff Flow Antisymmetry & Tube Conductivity Adaptation Equilibrium Law" ;
        dct:description "Proves that Poiseuille flux is strictly antisymmetric across directed edges, conserves protoplasmic current at every branching node, and equilibrates at D_ij^* = f(|Q_ij^*|) / μ | Variables: D_ij: hydraulic tube conductivity (∝ r_ij^4); L_ij: tube length; p_i, p_j: hydrostatic nodal pressures; Q_ij: protoplasmic shuttle streaming flux; f(|Q_ij|): shear-stress reinforcement rate; μ: tube decay rate" ;
        dct:source "Tero et al. (2010) Science 327(5964):439-442 Eqs. (1)-(3); Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. 244(4):553-564 Eqs. (1)-(4)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L238-L295>,
            <https://github.com/fractastical/morpholib/blob/171769b9/morphoeval/lean/loops/Loop_057_physarum_transport_network.lean#L46-L78> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def poiseuille_flux_num (D pi pj : Int) : Int := D * (pi - pj)
def kirchhoff_junction_residual (q_in q_out1 q_out2 : Int) : Int := q_in - q_out1 - q_out2
def conductivity_rate (f_Q mu D : Int) : Int := f_Q - mu * D
theorem tero_kirchhoff_antisymmetry_and_conductivity_equilibrium (D pi pj q1 q2 mu D_star : Int) :
    poiseuille_flux_num D pi pj + poiseuille_flux_num D pj pi = 0 ∧
    poiseuille_flux_num D pi pi = 0 ∧
    kirchhoff_junction_residual (q1 + q2) q1 q2 = 0 ∧
    conductivity_rate (mu * D_star) mu D_star = 0
"""^^pk:lean4 ;
        skos:notation "Q_ij = (D_ij / L_ij) (p_i - p_j),  Σ_j Q_ij = S_i,  dD_ij/dt = f(|Q_ij|) - μ D_ij = 0  <=>  D_ij^* = f(|Q_ij^*|) / μ" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2006.07.015>,
            <https://doi.org/10.1016/j.jtbi.2012.06.017>,
            <https://doi.org/10.1038/35035159>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1073/pnas.1305049110>,
            <https://doi.org/10.1126/science.1177894>,
            <https://doi.org/10.1146/annurev.pp.32.060181.001225> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Hagen-Poiseuille Kirchhoff Flow Coupled to Nonlinear Tube Conductivity Adaptation, Murray/Steiner Phase Transition & Peristaltic Shuttle-Streaming Wave Coupling" ;
        pk:leanDeclaration "MathOfBiology.Loop_057.poiseuille_flux_num" ;
        pk:leanTheorem "MathOfBiology.Loop_057.tero_kirchhoff_antisymmetry_and_conductivity_equilibrium" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/tero-physarum-transport-network-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Tero, Kobayashi & Nakagaki (2007) Two-Path Parallel Competition & Winner-Takes-All Shortest-Path Selection Law" ;
        dct:description "Proves that for γ > 1, shorter parallel paths experience strictly stronger flux reinforcement than longer paths, destabilizing symmetric flow and driving winner-takes-all convergence to the shortest path / Steiner minimum tree | Variables: L_1, L_2: lengths of short and long parallel tubes (L_1 < L_2); Q_1, Q_2: branch fluxes; γ: flux feedback nonlinearity exponent; I_0: total source-sink current" ;
        dct:source "Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. 244(4):553-564 Section 2.2 & Fig. 2; Bonifaci, Mehlhorn & Varma (2012) J. Theor. Biol. 309:121-133" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L786-L858>,
            <https://github.com/fractastical/morpholib/blob/171769b9/morphoeval/lean/loops/Loop_057_physarum_transport_network.lean#L85-L120> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def parallel_superlinear_advantage (L1 L2 : Int) : Int := L2 * L2 - L1 * L1
def parallel_rate_divergence (q1_sq q2_sq mu D : Int) : Int :=
  conductivity_rate q1_sq mu D - conductivity_rate q2_sq mu D
theorem tero_two_path_shortest_path_selection (q1_sq q2_sq mu D pi pj : Int) (hq : q2_sq < q1_sq) :
    parallel_superlinear_advantage 1 2 = 3 ∧
    0 < parallel_superlinear_advantage 1 2 ∧
    0 < parallel_rate_divergence q1_sq q2_sq mu D ∧
    poiseuille_flux_num 0 pi pj = 0 ∧
    conductivity_rate 0 mu 0 = 0
"""^^pk:lean4 ;
        skos:notation "Q_1 / Q_2 = (D_1 L_2) / (D_2 L_1);  for L_1 < L_2 and γ > 1:  d(D_1/D_2)/dt > 0  =>  (D_1^*, D_2^*) = (f(I_0)/μ, 0)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2006.07.015>,
            <https://doi.org/10.1016/j.jtbi.2012.06.017>,
            <https://doi.org/10.1038/35035159>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1073/pnas.1305049110>,
            <https://doi.org/10.1126/science.1177894>,
            <https://doi.org/10.1146/annurev.pp.32.060181.001225> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Hagen-Poiseuille Kirchhoff Flow Coupled to Nonlinear Tube Conductivity Adaptation, Murray/Steiner Phase Transition & Peristaltic Shuttle-Streaming Wave Coupling" ;
        pk:leanDeclaration "MathOfBiology.Loop_057.parallel_superlinear_advantage" ;
        pk:leanTheorem "MathOfBiology.Loop_057.tero_two_path_shortest_path_selection" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/tero-physarum-transport-network-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Murray (1926) & Tero et al. (2010) Vascular Cube-Law Radius Relation at Critical Shear Exponent γ = 4/3" ;
        dct:description "Establishes the exact algebraic equivalence between Hagen-Poiseuille tube adaptation at γ = 4/3 and Murray's minimum-work cube law r_0^3 = r_1^3 + r_2^3 across plasmodial Y-junctions | Variables: r_0: parent vein radius; r_1, r_2: daughter branch radii; D(r): Hagen-Poiseuille fourth-power conductivity; Q(r): steady-state protoplasmic volume flux" ;
        dct:source "Murray (1926) Proc. Natl. Acad. Sci. USA 12(3):207-214; Tero et al. (2010) Science 327(5964):439-442" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L866-L911>,
            <https://github.com/fractastical/morpholib/blob/171769b9/morphoeval/lean/loops/Loop_057_physarum_transport_network.lean#L127-L154> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def radius_cube (r : Nat) : Nat := r * r * r
def poiseuille_d4 (r : Nat) : Nat := r * r * r * r
theorem tero_murray_cube_law_at_gamma_four_thirds (r1 r2 : Nat) (hr2 : 0 < r2) :
    poiseuille_d4 2 * poiseuille_d4 2 * poiseuille_d4 2 =
      radius_cube 2 * radius_cube 2 * radius_cube 2 * radius_cube 2 ∧
    radius_cube r1 < radius_cube r1 + radius_cube r2 ∧
    radius_cube 2 + radius_cube 2 = 16
"""^^pk:lean4 ;
        skos:notation "D_ij ∝ r_ij^4,  D_ij^* ∝ |Q_ij^*|^(4/3)  =>  |Q_ij^*| ∝ (D_ij^* )^(3/4) ∝ r_ij^3;  Q_0 = Q_1 + Q_2  =>  r_0^3 = r_1^3 + r_2^3" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2006.07.015>,
            <https://doi.org/10.1016/j.jtbi.2012.06.017>,
            <https://doi.org/10.1038/35035159>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1073/pnas.1305049110>,
            <https://doi.org/10.1126/science.1177894>,
            <https://doi.org/10.1146/annurev.pp.32.060181.001225> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Hagen-Poiseuille Kirchhoff Flow Coupled to Nonlinear Tube Conductivity Adaptation, Murray/Steiner Phase Transition & Peristaltic Shuttle-Streaming Wave Coupling" ;
        pk:leanDeclaration "MathOfBiology.Loop_057.radius_cube" ;
        pk:leanTheorem "MathOfBiology.Loop_057.tero_murray_cube_law_at_gamma_four_thirds" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/tero-physarum-transport-network-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Peristaltic Volume-Source Closure & Half-Period Shuttle-Streaming Reversal (Pass 3)" ;
        dct:description "Couples the traveling actomyosin contraction wave to the Kirchhoff network as a zero-sum oscillating volume source (solvability of the grounded Laplacian), proves the half-period flux reversal that constitutes shuttle streaming, and shows the slow Tero adaptation (which sees |Q|) is blind to the reversal so it must act on the cycle-averaged <|Q|> | Variables: ε: relative radius contraction amplitude; ω = 2π/T_c: contraction angular frequency (T_c ≈ 100 s); λ: peristaltic wavelength (≈ organism length); n: wave direction; V_e = A_e L_e ρ_e^2: instantaneous tube volume; S_i^peri: nodal volume source; m: network-mean correction" ;
        dct:source "Alim, Amselem, Peaudecerf, Brenner & Pringle (2013) Proc. Natl. Acad. Sci. USA 110(33):13306-13311; Kamiya (1981) Annu. Rev. Plant Physiol. 32:205-236; Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. 244(4):553-564" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L371-L447>,
            <https://github.com/fractastical/morpholib/blob/171769b9/morphoeval/lean/loops/Loop_057_physarum_transport_network.lean#L155-L190> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def peristaltic_source (A s : Int) : Int := -(A * s)
def closed_source (s m : Int) : Int := s - m
theorem peristaltic_closed_source_zero_sum (A s q s1 s2 s3 m : Int) (hsum : s1 + s2 + s3 = 3 * m) :
    peristaltic_source A s + peristaltic_source A (-s) = 0 ∧
    Int.natAbs (-q) = Int.natAbs q ∧
    closed_source s1 m + closed_source s2 m + closed_source s3 m = 0
"""^^pk:lean4 ;
        skos:notation "r_e(t) = r_e [1 - ε cos(ωt - 2π x_e·n/λ)],  S_i^peri(t) = -(1/2) Σ_{e∋i} dV_e/dt - mean_i(·),  Σ_i S_i^peri = 0;  S(t + T_c/2) = -S(t)  =>  Q_e(t + T_c/2) ≈ -Q_e(t);  f(|Q|) invariant under Q -> -Q" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2006.07.015>,
            <https://doi.org/10.1016/j.jtbi.2012.06.017>,
            <https://doi.org/10.1038/35035159>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1073/pnas.1305049110>,
            <https://doi.org/10.1126/science.1177894>,
            <https://doi.org/10.1146/annurev.pp.32.060181.001225> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Hagen-Poiseuille Kirchhoff Flow Coupled to Nonlinear Tube Conductivity Adaptation, Murray/Steiner Phase Transition & Peristaltic Shuttle-Streaming Wave Coupling" ;
        pk:leanDeclaration "MathOfBiology.Loop_057.peristaltic_source" ;
        pk:leanTheorem "MathOfBiology.Loop_057.peristaltic_closed_source_zero_sum" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/tero-physarum-transport-network-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Net Peristaltic Transport Requires Joint Conductance & Pressure Modulation (Pass 3)" ;
        dct:description "Explains why the linear Kirchhoff network with frozen conductivities cannot pump (Suite 9 null) and why the simulated net peristaltic transport is second order in ε and wavelength-dependent (Panel H), matching the Alim et al. (2013) picture of peristalsis-organized net flow | Variables: g = D_e/L_e: rest edge conductance; d: in-phase conductance modulation amplitude (∝ 4 ε g); Δp: pressure-drop oscillation amplitude; <Q>_Tc: cycle-averaged net flux" ;
        dct:source "Alim, Amselem, Peaudecerf, Brenner & Pringle (2013) Proc. Natl. Acad. Sci. USA 110(33):13306-13311" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L681-L778>,
            <https://github.com/fractastical/morpholib/blob/171769b9/morphoeval/lean/loops/Loop_057_physarum_transport_network.lean#L192-L227> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def two_sample_net_flux (g d dp : Int) : Int := (g + d) * dp + (g - d) * (-dp)
theorem peristaltic_net_transport_requires_conductance_modulation (g d dp : Int) :
    two_sample_net_flux g 0 dp = 0 ∧
    two_sample_net_flux g d dp = 2 * (d * dp) ∧
    (d ≠ 0 → dp ≠ 0 → two_sample_net_flux g d dp ≠ 0)
"""^^pk:lean4 ;
        skos:notation "Q(t) + Q(t + T_c/2) = (g + d) Δp + (g - d)(-Δp) = 2 d Δp;  d = 0 (frozen D_ij)  =>  <Q>_Tc = 0;  d ≠ 0 ∧ Δp ≠ 0  =>  <Q>_Tc ≠ 0 (second order in ε)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2006.07.015>,
            <https://doi.org/10.1016/j.jtbi.2012.06.017>,
            <https://doi.org/10.1038/35035159>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1073/pnas.1305049110>,
            <https://doi.org/10.1126/science.1177894>,
            <https://doi.org/10.1146/annurev.pp.32.060181.001225> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Hagen-Poiseuille Kirchhoff Flow Coupled to Nonlinear Tube Conductivity Adaptation, Murray/Steiner Phase Transition & Peristaltic Shuttle-Streaming Wave Coupling" ;
        pk:leanDeclaration "MathOfBiology.Loop_057.two_sample_net_flux" ;
        pk:leanTheorem "MathOfBiology.Loop_057.peristaltic_net_transport_requires_conductance_modulation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/thomas-coral-calice-septa-insertion-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Milne-Edwards & Haime (1848) Hexameral Septal Insertion Doubling Law" ;
        dct:description "Governs simultaneous midpoint bifurcation of interseptal chambers in Scleractinian stony corals as the expanding calice perimeter crosses multiples of λ_s | Variables: k ∈ {1..6}: Milne-Edwards insertion cycle order (S1..S6); n_k: newly inserted septa at interseptal midpoints; N_hex(k): cumulative radiating septa; R_k: threshold calice radius; λ_s: inter-septal morphogen wavelength" ;
        dct:source "Milne-Edwards & Haime (1848) Ann. Sci. Nat. Zool. (Sér. 3) 9:37-89; Cairns & Kitahara (2012) ZooKeys 227:1-47" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L199-L365>,
            <https://github.com/fractastical/morpholib/blob/e651a8b8/morphoeval/lean/loops/Loop_074_coral_calice_septa_insertion.lean#L21-L58> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def milne_edwards_cumulative_septa : Nat → Nat
  | 0 => 0
  | k + 1 => 6 * (2 ^ k)
theorem milne_edwards_hexameral_septal_doubling :
    milne_edwards_cumulative_septa 1 = 6 ∧
    milne_edwards_cumulative_septa 2 = 12 ∧
    milne_edwards_cumulative_septa 3 = 24 ∧
    milne_edwards_cumulative_septa 4 = 48 ∧
    milne_edwards_cumulative_septa 5 = 96 := by decide
"""^^pk:lean4 ;
        skos:notation "n_1 = 6,  n_k = 6 * 2^{k-2} (k >= 2),  N_hex(k) = sum_{j=1}^k n_j = 6 * 2^{k-1} ∈ {6, 12, 24, 48, 96, 192} at 2π R_k = N_hex(k) λ_s" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-3-662-04339-4>,
            <https://doi.org/10.1109/TSMC.1979.4310076>,
            <https://doi.org/10.1127/zdgg/21/1869/647>,
            <https://doi.org/10.1371/journal.pcbi.1002849>,
            <https://doi.org/10.3897/zookeys.227.3612>,
            <https://doi.org/10.4319/lo.2005.50.1.0246>,
            <https://doi.org/10.4319/lo.2006.51.2.1134>,
            <https://doi.org/10.5962/bhl.title.11574>,
            <https://doi.org/10.6028/jres.060.043> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Milne-Edwards Hexameral Septal Doubling Law (6 * 2^(k-1)), Kunth's Rugosa Fossula Law (6 + 4m), Chindapol Péclet Advection-Diffusion Calice Symmetry Breaking, Conical Corallum Septal-Front Monotonicity & Keulegan-Carpenter Surge Dipole Cancellation" ;
        pk:leanDeclaration "MathOfBiology.Loop_074.milne_edwards_cumulative_septa" ;
        pk:leanTheorem "MathOfBiology.Loop_074.milne_edwards_hexameral_septal_doubling" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/thomas-coral-calice-septa-insertion-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Kunth's Law (1869) Paleozoic Rugosa Serial 4-Fossula Insertion & Cycle Radial Reach Hierarchy" ;
        dct:description "Contrasts Paleozoic Rugosa serial 4-fossula bilateral insertion against Mesozoic-Recent Scleractinia cyclic hexameral doubling and establishes the decreasing radial reach hierarchy S1 > S2 > S3 > S4 > S5 | Variables: m: Rugosa serial insertion stage across 4 fossulae (2 cardinal, 2 alar); L_k: radial length of cycle-k septa from theca toward central columella; α_k = L_k / R: normalized radial reach" ;
        dct:source "Kunth (1869) Z. Dtsch. Geol. Ges. 21:647-688; Milne-Edwards & Haime (1848) Ann. Sci. Nat. Zool. 9:37-89" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L219-L432>,
            <https://github.com/fractastical/morpholib/blob/e651a8b8/morphoeval/lean/loops/Loop_074_coral_calice_septa_insertion.lean#L64-L105> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def kunth_rugosa_septa (m : Nat) : Nat := 6 + 4 * m
theorem kunth_rugosa_vs_scleractinia_and_reach_hierarchy :
    kunth_rugosa_septa 0 = milne_edwards_cumulative_septa 1 ∧
    kunth_rugosa_septa 3 = 18 ∧
    milne_edwards_cumulative_septa 4 > kunth_rugosa_septa 3 ∧
    septal_cycle_reach_permille 1 > septal_cycle_reach_permille 2 := by decide
"""^^pk:lean4 ;
        skos:notation "N_rugosa(m) = 6 + 4 m ∈ {6, 10, 14, 18, 22},   L_k / R = α_k with α_1 > α_2 > α_3 > α_4 > α_5" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-3-662-04339-4>,
            <https://doi.org/10.1109/TSMC.1979.4310076>,
            <https://doi.org/10.1127/zdgg/21/1869/647>,
            <https://doi.org/10.1371/journal.pcbi.1002849>,
            <https://doi.org/10.3897/zookeys.227.3612>,
            <https://doi.org/10.4319/lo.2005.50.1.0246>,
            <https://doi.org/10.4319/lo.2006.51.2.1134>,
            <https://doi.org/10.5962/bhl.title.11574>,
            <https://doi.org/10.6028/jres.060.043> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Milne-Edwards Hexameral Septal Doubling Law (6 * 2^(k-1)), Kunth's Rugosa Fossula Law (6 + 4m), Chindapol Péclet Advection-Diffusion Calice Symmetry Breaking, Conical Corallum Septal-Front Monotonicity & Keulegan-Carpenter Surge Dipole Cancellation" ;
        pk:leanDeclaration "MathOfBiology.Loop_074.kunth_rugosa_septa" ;
        pk:leanTheorem "MathOfBiology.Loop_074.kunth_rugosa_vs_scleractinia_and_reach_hierarchy" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/thomas-coral-calice-septa-insertion-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Chindapol et al. (2013) Péclet-Modulated Advection-Diffusion Calice Symmetry Breaking Law" ;
        dct:description "Demonstrates exact radial symmetry at Pe = 0 (hydrostatic diffusion limit) and monotonic upstream-enhanced skeletal accretion and calice polarization as Pe increases | Variables: c(x,y): dissolved inorganic carbon / nutrient concentration; Pe = U L / D: Péclet number; s = √Pe: laminar boundary-layer thinning factor; j_n(θ; Pe): normal calcification flux around corallite rim" ;
        dct:source "Chindapol et al. (2013) PLoS Comput. Biol. 9(1):e1002849; Kaandorp & Kübler (2001) Ch. 4-6" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L435-L501>,
            <https://github.com/fractastical/morpholib/blob/e651a8b8/morphoeval/lean/loops/Loop_074_coral_calice_septa_insertion.lean#L110-L152> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def peclet_flux_dipole_diff (j0 beta s : Int) : Int :=
  peclet_upstream_flux j0 beta s - peclet_downstream_flux j0 beta s
theorem peclet_zero_radial_symmetry (j0 beta : Int) :
    peclet_flux_dipole_diff j0 beta 0 = 0 := by simp [peclet_flux_dipole_diff, peclet_upstream_flux, peclet_downstream_flux]
theorem peclet_advection_upstream_symmetry_breaking :
    peclet_flux_dipole_diff 10 18 0 = 0 ∧
    peclet_flux_dipole_diff 10 18 4 = 1440 := by decide
"""^^pk:lean4 ;
        skos:notation "u · ∇c = D ∇^2 c,  Pe = U L / D,  j_n(θ; Pe) = j_0 (1 + β_Pe √Pe cos θ + γ_Pe (Pe/(1+Pe)) cos 2θ),  Δj = j_up - j_down = 2 j_0 β_Pe √Pe" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-3-662-04339-4>,
            <https://doi.org/10.1109/TSMC.1979.4310076>,
            <https://doi.org/10.1127/zdgg/21/1869/647>,
            <https://doi.org/10.1371/journal.pcbi.1002849>,
            <https://doi.org/10.3897/zookeys.227.3612>,
            <https://doi.org/10.4319/lo.2005.50.1.0246>,
            <https://doi.org/10.4319/lo.2006.51.2.1134>,
            <https://doi.org/10.5962/bhl.title.11574>,
            <https://doi.org/10.6028/jres.060.043> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Milne-Edwards Hexameral Septal Doubling Law (6 * 2^(k-1)), Kunth's Rugosa Fossula Law (6 + 4m), Chindapol Péclet Advection-Diffusion Calice Symmetry Breaking, Conical Corallum Septal-Front Monotonicity & Keulegan-Carpenter Surge Dipole Cancellation" ;
        pk:leanDeclaration "MathOfBiology.Loop_074.peclet_flux_dipole_diff" ;
        pk:leanTheorem "MathOfBiology.Loop_074.peclet_advection_upstream_symmetry_breaking" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/thomas-coral-calice-septa-insertion-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pass 3 / Law 4 — Conical (Trochoid/Turbinate) Corallum Septal Insertion Fronts Are Monotone Along the Growth Axis" ;
        dct:description "Extrudes the 2D calice into a reduced 3D cylindrical-voxel corallum resolving septa, dissepiments and synapticulae; proves that the septal insertion fronts are stacked monotonically along z for any cone; apical angle measured from the specimen side profile (36.7° → trochoid) | Variables: z: height along the corallum growth axis; R_ped: pedicel radius; φ: apical angle (Wells 1956 ceratoid 20°, trochoid 40°, turbinate 70°, patellate 120°); k(z): active Milne-Edwards cycle at height z; N(z): septa present at height z; endothecal dissepiments (spacing h_d) and synapticulae (ring radii r_s) fill the loculi between septa" ;
        dct:source "Milne-Edwards & Haime (1848); Wells (1956) Treatise Invert. Paleont. Part F pp. F328-F444; Cairns & Kitahara (2012) ZooKeys 227:1-47 glossary" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L630-L930>,
            <https://github.com/fractastical/morpholib/blob/e651a8b8/morphoeval/lean/loops/Loop_074_coral_calice_septa_insertion.lean#L149-L219> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cone_radius (r_ped slope z : Nat) : Nat := r_ped + slope * z
def active_cycle (r : Nat) : Nat :=
  if r ≥ 800 then 5 else if r ≥ 400 then 4 else if r ≥ 200 then 3 else if r ≥ 100 then 2 else 1
def septa_at_radius (r : Nat) : Nat := milne_edwards_cumulative_septa (active_cycle r)
theorem turbinate_corallum_septal_cycles_monotone :
    (∀ (r_ped slope z₁ z₂ : Nat), z₁ ≤ z₂ →
      septa_at_radius (cone_radius r_ped slope z₁) ≤ septa_at_radius (cone_radius r_ped slope z₂)) ∧
    septa_at_radius (cone_radius 60 1 40) = 12 ∧ septa_at_radius (cone_radius 60 1 340) = 48 := ...
"""^^pk:lean4 ;
        skos:notation "R(z) = R_ped + z tan(φ/2) (Wells 1956 classes φ ∈ {20°, 40°, 70°, 120°}),  k(z) = k(R(z)),  N(z) = N_hex(k(R(z))) with z₁ ≤ z₂ ⇒ N(z₁) ≤ N(z₂);  front heights z_k = (R_k − R_ped)/tan(φ/2)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-3-662-04339-4>,
            <https://doi.org/10.1109/TSMC.1979.4310076>,
            <https://doi.org/10.1127/zdgg/21/1869/647>,
            <https://doi.org/10.1371/journal.pcbi.1002849>,
            <https://doi.org/10.3897/zookeys.227.3612>,
            <https://doi.org/10.4319/lo.2005.50.1.0246>,
            <https://doi.org/10.4319/lo.2006.51.2.1134>,
            <https://doi.org/10.5962/bhl.title.11574>,
            <https://doi.org/10.6028/jres.060.043> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Milne-Edwards Hexameral Septal Doubling Law (6 * 2^(k-1)), Kunth's Rugosa Fossula Law (6 + 4m), Chindapol Péclet Advection-Diffusion Calice Symmetry Breaking, Conical Corallum Septal-Front Monotonicity & Keulegan-Carpenter Surge Dipole Cancellation" ;
        pk:leanDeclaration "MathOfBiology.Loop_074.septa_at_radius" ;
        pk:leanTheorem "MathOfBiology.Loop_074.turbinate_corallum_septal_cycles_monotone" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/thomas-coral-calice-septa-insertion-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pass 3 / Law 5 — Keulegan-Carpenter Oscillatory Surge: Period-Averaged Dipole Cancellation vs Unidirectional Polarization" ;
        dct:description "Couples the Law 3 Péclet flux to bidirectional reef surge: the dipole (upstream polarization) cancels exactly over a period while the quadrupole (bilateral elongation along the surge axis) survives and saturates with KC; contrasts unidirectional current (A₁ = 0.647 at Pe = 16) against surge (⟨A₁⟩ = 0) | Variables: U_max: wave orbital velocity amplitude; T: wave period; L: corallite/colony size; KC: Keulegan-Carpenter number; a = U_max T/(2π): surge excursion; η(KC): boundary-layer renewal efficiency; s = sgn(U)√Pe(t): signed boundary-layer factor; A₁, A₂: period-mean dipole and quadrupole flux asymmetries" ;
        dct:source "Keulegan & Carpenter (1958) J. Res. NBS 60:423-440; Chindapol et al. (2013) PLoS Comput. Biol. 9(1):e1002849 (unidirectional vs bidirectional runs); Falter et al. (2005) & Reidenbach et al. (2006) Limnol. Oceanogr. (oscillatory mass transfer, residual)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L504-L627>,
            <https://github.com/fractastical/morpholib/blob/e651a8b8/morphoeval/lean/loops/Loop_074_coral_calice_septa_insertion.lean#L221-L248> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem oscillatory_surge_dipole_cancellation (j0 beta s : Int) :
    peclet_flux_dipole_diff j0 beta s + peclet_flux_dipole_diff j0 beta (-s) = 0 ∧
    peclet_flux_dipole_diff j0 beta (-s) = - peclet_flux_dipole_diff j0 beta s := by
  unfold peclet_flux_dipole_diff peclet_upstream_flux peclet_downstream_flux
  constructor <;> simp [Int.mul_neg, Int.mul_add, Int.sub_eq_add_neg] <;> omega
theorem surge_mean_of_mirror_phases_zero (j0 beta s₁ s₂ : Int) :
    peclet_flux_dipole_diff j0 beta s₁ + peclet_flux_dipole_diff j0 beta s₂ +
      peclet_flux_dipole_diff j0 beta (-s₁) + peclet_flux_dipole_diff j0 beta (-s₂) = 0 := ...
"""^^pk:lean4 ;
        skos:notation "KC = U_max T / L,  Pe(t) = Pe_max |sin ωt|,  η(KC) = 1 − exp(−KC/2π),  j(θ,t) = j₀[1 + η β √Pe(t) sgn(U) cos θ + η γ (Pe(t)/(1+Pe(t))) cos 2θ],  ⟨Δj⟩_T = 0 (Δj(s) + Δj(−s) = 0),  ⟨A₂⟩(KC) ∝ η(KC) with KC₅₀ = 2π ln 2" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-3-662-04339-4>,
            <https://doi.org/10.1109/TSMC.1979.4310076>,
            <https://doi.org/10.1127/zdgg/21/1869/647>,
            <https://doi.org/10.1371/journal.pcbi.1002849>,
            <https://doi.org/10.3897/zookeys.227.3612>,
            <https://doi.org/10.4319/lo.2005.50.1.0246>,
            <https://doi.org/10.4319/lo.2006.51.2.1134>,
            <https://doi.org/10.5962/bhl.title.11574>,
            <https://doi.org/10.6028/jres.060.043> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Milne-Edwards Hexameral Septal Doubling Law (6 * 2^(k-1)), Kunth's Rugosa Fossula Law (6 + 4m), Chindapol Péclet Advection-Diffusion Calice Symmetry Breaking, Conical Corallum Septal-Front Monotonicity & Keulegan-Carpenter Surge Dipole Cancellation" ;
        pk:leanDeclaration "MathOfBiology.Loop_074.peclet_flux_dipole_diff" ;
        pk:leanTheorem "MathOfBiology.Loop_074.oscillatory_surge_dipole_cancellation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/thompson-scarus-pomacanthus-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "2D Biharmonic Thin-Plate Spline (TPS) Deformation Field" ;
        dct:description "Maps homologous anatomical landmarks of Scarus (parrotfish) onto Pomacanthus (angelfish) with minimum bending energy | Variables: (x, y): source Scarus landmark coordinates; r_i = ||(x,y) - p_i||; w_i: biharmonic kernel weights" ;
        dct:source "Thompson (1917) On Growth and Form Ch. XVII Fig. 517-518; Bookstein (1989) IEEE TPAMI 11:567" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/lean/MathOfBiology.lean#L181-L189>,
            <https://github.com/fractastical/morpholib/blob/7a781325/thompson/1917-thompson.py#L95-L185> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def tps_zero_displacement_kernel (r_sq log_r_sq : Int) : Int := r_sq * log_r_sq
theorem tps_kernel_zero_at_origin (log_val : Int) :
    tps_zero_displacement_kernel 0 log_val = 0 := by
  simp [tps_zero_displacement_kernel]"""^^pk:lean4 ;
        skos:notation "Φ(x, y) = a_0 + a_x x + a_y y + ∑_{i=1}^K w_i r_i^2 ln(r_i^2),  Δ^2 Φ = 0" ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Biharmonic Thin-Plate Spline & Affine Coordinate Transformation" ;
        pk:leanDeclaration "MathOfBiology.tps_zero_displacement_kernel" ;
        pk:leanTheorem "MathOfBiology.tps_kernel_zero_at_origin" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/thompson-scarus-pomacanthus-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Affine Oblique Shear & Principal Strain Tensor" ;
        dct:description "Linear global coordinate shear baseline compared against non-affine TPS warp across 14 anatomical landmarks | Variables: α_x, α_y: axial stretch ratios; γ_xy, γ_yx: oblique grid shear angles; J: local areal dilation" ;
        dct:source "Thompson (1917) On Growth and Form Ch. XVII" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/lean/MathOfBiology.lean#L191-L200>,
            <https://github.com/fractastical/morpholib/blob/7a781325/thompson/1917-thompson.py#L186-L260> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def affine_jacobian_det (a_x a_y g_xy g_yx : Int) : Int := a_x * a_y - g_xy * g_yx
theorem thompson_unit_shear_area_preserving (g_xy : Int) :
    affine_jacobian_det 1 1 g_xy 0 = 1 := by
  simp [affine_jacobian_det]"""^^pk:lean4 ;
        skos:notation "x' = α_x x + γ_xy y + t_x,  y' = γ_yx x + α_y y + t_y;  J = det(∇Φ)" ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Biharmonic Thin-Plate Spline & Affine Coordinate Transformation" ;
        pk:leanDeclaration "MathOfBiology.affine_jacobian_det" ;
        pk:leanTheorem "MathOfBiology.thompson_unit_shear_area_preserving" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/tozluoglu-wing-disc-dome-folding-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Apical-vs-Basal Differential Planar Growth & Basal ECM Stiffness Pouch Dome Curvature Law" ;
        dct:description "Proves that tangential proliferation of the cellular layer tethered to a stiff non-growing basal basement membrane (mu_BM > 0) generates strictly positive convex pouch dome curvature that increases monotonically with pouch proliferation rate | Variables: g_apical: tangential planar growth rate of wing pouch epithelium (h^-1); g_BM: basal basement membrane growth rate (~0 h^-1); mu_BM: Collagen IV / Viking basement membrane shear modulus (5.0 kPa); kappa_dome: convex pouch dome curvature (um^-1)" ;
        dct:source "Tozluoglu et al. (2019) Dev. Cell 51(3):299-312.e4 Figs. 1, 4 & STAR Methods" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L130-L215>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_049_wing_disc_dome_folding.lean#L18-L55> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def dome_curvature_num (g_apical g_BM mu_BM : Int) : Int :=
  (g_apical - g_BM) * mu_BM
theorem pouch_dome_curvature_from_differential_growth_and_bm
    (g_bm dg extra mu_BM : Int)
    (hdg : dg > 0)
    (hextra : extra > 0)
    (hmu : mu_BM > 0) :
    dome_curvature_num g_bm g_bm mu_BM = 0 ∧
    dome_curvature_num (g_bm + dg) g_bm mu_BM > 0 ∧
    dome_curvature_num (g_bm + dg) g_bm mu_BM <
      dome_curvature_num (g_bm + dg + extra) g_bm mu_BM"""^^pk:lean4 ;
        skos:notation "kappa_dome = 6 * mu_cell * mu_BM * h_BM * (g_apical - g_BM) * Delta_t / (h_cell * (mu_cell * h_cell + 4 * mu_BM * h_BM)) > 0 for g_apical > g_BM and mu_BM > 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2019.09.009>,
            <https://doi.org/10.1038/s41467-018-06497-3>,
            <https://doi.org/10.1115/1.4032128>,
            <https://doi.org/10.1242/dev.02092>,
            <https://doi.org/10.1242/dev.199728>,
            <https://doi.org/10.7554/eLife.39596> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Multiplicative Finite-Strain Morphoelasticity F = F_e F_g Coupled to Apical-Basal Differential ECM Stiffness & Localized Hinge Fold Remodeling" ;
        pk:leanDeclaration "MathOfBiology.Loop_049.dome_curvature_num" ;
        pk:leanTheorem "MathOfBiology.Loop_049.pouch_dome_curvature_from_differential_growth_and_bm" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/tozluoglu-wing-disc-dome-folding-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Stereotyped H/N, H/H, and H/P Fold Pinning at Local Growth Troughs Law" ;
        dct:description "Proves that local minima (troughs, g''(s^*) > 0) in the differential planar growth profile focus negative apical cleft curvature at the exact H/N, H/H, and H/P boundaries, whereas uniform growth has zero second difference everywhere and buckles at unpinned random phases | Variables: g_left, g_trough, g_right: planar growth rates across a hinge fold boundary and flanking ridges; mu_BM: basal basement membrane stiffness; s_HN^*=0.26, s_HH^*=0.39, s_HP^*=0.52: normalized H/N, H/H, and H/P fold loci" ;
        dct:source "Tozluoglu et al. (2019) Dev. Cell 51(3):299-312.e4 Figs. 2-3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L218-L355>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_049_wing_disc_dome_folding.lean#L58-L102> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def growth_second_diff (g_left g_trough g_right : Int) : Int :=
  g_left + g_right - 2 * g_trough
def pinned_fold_curvature_num (g_left g_trough g_right mu_BM : Int) : Int :=
  -(mu_BM * growth_second_diff g_left g_trough g_right)
theorem stereotyped_three_fold_pinning_vs_uniform_buckling
    (g0 g_trough d_left d_right mu_BM : Int)
    (hdl : d_left > 0)
    (hdr : d_right > 0)
    (hmu : mu_BM > 0) :
    growth_second_diff g0 g0 g0 = 0 ∧
    pinned_fold_curvature_num g0 g0 g0 mu_BM = 0 ∧
    growth_second_diff (g_trough + d_left) g_trough (g_trough + d_right) > 0 ∧
    pinned_fold_curvature_num
      (g_trough + d_left)
      g_trough
      (g_trough + d_right)
      mu_BM < 0"""^^pk:lean4 ;
        skos:notation "s_fold^* in {s_HN^*, s_HH^*, s_HP^*} <=> g'(s^*) = 0 & g''(s^*) > 0 => kappa_fold(s^*) < 0;  g(s) = g_0 => g''(s) = 0 (unpinned phase-random buckling)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2019.09.009>,
            <https://doi.org/10.1038/s41467-018-06497-3>,
            <https://doi.org/10.1115/1.4032128>,
            <https://doi.org/10.1242/dev.02092>,
            <https://doi.org/10.1242/dev.199728>,
            <https://doi.org/10.7554/eLife.39596> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Multiplicative Finite-Strain Morphoelasticity F = F_e F_g Coupled to Apical-Basal Differential ECM Stiffness & Localized Hinge Fold Remodeling" ;
        pk:leanDeclaration "MathOfBiology.Loop_049.pinned_fold_curvature_num" ;
        pk:leanTheorem "MathOfBiology.Loop_049.stereotyped_three_fold_pinning_vs_uniform_buckling" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/tozluoglu-wing-disc-dome-folding-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Collagenase / vkg-RNAi Basal ECM Ablation Collapse & Synergistic Hinge Fold Deepening Hierarchy" ;
        dct:description "Proves that Collagenase / vkg-RNAi ablation of the basal basement membrane (mu_BM = 0) collapses both the pouch dome and all three hinge folds, and establishes the strict fold-depth hierarchy across JAK/STAT overgrowth, wild type, dysf/omb mutants, uniform growth, and ECM ablation | Variables: mu_bm_active: indicator of intact Collagen IV basal ECM; diff_growth_active: indicator of heterogeneous planar growth; local_remodel_active: indicator of local basal ECM softening & lateral tension redistribution (dysfusion/omb/MMP2); jak_stat_boost: JAK/STAT (Upd) hinge hyper-proliferation indicator" ;
        dct:source "Tozluoglu et al. (2019) Dev. Cell 51(3):299-312.e4 Figs. 4-6; Sui et al. (2018) Nat. Commun. 9:4620 Figs. 3-6" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L360-L545>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_049_wing_disc_dome_folding.lean#L105-L157> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def hh_fold_depth10 (mu_bm_active diff_growth_active local_remodel_active jak_stat_boost : Int) : Int :=
  mu_bm_active * (71 + 37 * diff_growth_active + 86 * diff_growth_active * local_remodel_active +
    58 * diff_growth_active * local_remodel_active * jak_stat_boost)
theorem collagenase_ecm_ablation_collapse_and_remodeling_hierarchy (g_ap g_bm g_l g_t g_r : Int) :
    dome_curvature_num g_ap g_bm 0 = 0 ∧
    pinned_fold_curvature_num g_l g_t g_r 0 = 0 ∧
    depth10_collagenase_ecm_ablation = 0 ∧
    depth10_jak_stat_overgrowth > depth10_wild_type ∧
    depth10_wild_type > depth10_dysf_omb_mutant ∧
    depth10_dysf_omb_mutant > depth10_uniform_growth ∧
    depth10_uniform_growth > depth10_collagenase_ecm_ablation"""^^pk:lean4 ;
        skos:notation "mu_BM = 0 => kappa_dome = 0 & d_fold = 0;  d_JAK_STAT (25.2 um) > d_WT (19.4 um) > d_dysf_omb (10.8 um) > d_uniform (7.1 um) > d_Collagenase (0.0 um)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2019.09.009>,
            <https://doi.org/10.1038/s41467-018-06497-3>,
            <https://doi.org/10.1115/1.4032128>,
            <https://doi.org/10.1242/dev.02092>,
            <https://doi.org/10.1242/dev.199728>,
            <https://doi.org/10.7554/eLife.39596> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Multiplicative Finite-Strain Morphoelasticity F = F_e F_g Coupled to Apical-Basal Differential ECM Stiffness & Localized Hinge Fold Remodeling" ;
        pk:leanDeclaration "MathOfBiology.Loop_049.hh_fold_depth10" ;
        pk:leanTheorem "MathOfBiology.Loop_049.collagenase_ecm_ablation_collapse_and_remodeling_hierarchy" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/tozluoglu-wing-disc-dome-folding-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Lumen Hydrostatic Pressure Laplace Dome Deflection & Fold-Locus Invariance in the Coupled Disc-Proper + Peripodial Sac (Pass 3)" ;
        dct:description "Proves that in the Pass 3 reduced sac the lumen pressure can only lower the pouch dome (monotonically, with no effect at p = 0 / PE ablation) while inflating the peripodial roof, and that a uniform transverse load leaves the growth-trough second difference—and hence the H/N, H/H, H/P fold loci—unchanged. Reduced quasi-1D plane-strain model; the full 3D DP + PE + lumen FEM remains a residual. | Variables: p: lumen hydrostatic pressure (Pa); z0: growth-driven uncoupled pouch dome height (um); chord2 = L_pouch^2 with L_pouch = (1 - s_HP) L(t); T16 = 16 T_DP, T_DP: disc-proper shell tension (Pa*um) from basal Collagen IV stretch gamma_pouch plus cortical floor; span2 = L(t)^2; T_PE: peripodial membrane tension (1 mN/m, assumption); h_lumen: mean lumen height (12 um, assumption); c: uniform load shift" ;
        dct:source "Tozluoglu et al. (2019) Dev. Cell 51(3):299-312.e4 (disc-proper differential growth sets fold loci); McClure & Schubiger (2005) Development 132:5033-5042 (squamous peripodial epithelium); Mosaliganti et al. (2019) eLife 8:e39596 (order of magnitude of epithelial lumen pressure, otic vesicle)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L518-L792>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_049_wing_disc_dome_folding.lean#L152-L207> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def dome_height_num (z0 p chord2 T16 : Int) : Int :=
  z0 * T16 - p * chord2
def pe_sag_num (p span2 : Int) : Int :=
  p * span2
theorem lumen_pressure_laplace_dome_deflection
    (z0 p1 p2 chord2 T16 span2 : Int)
    (hchord : chord2 > 0)
    (_hT : T16 > 0)
    (hspan : span2 > 0)
    (hp1 : p1 > 0)
    (hlt : p1 < p2) :
    dome_height_num z0 0 chord2 T16 = z0 * T16 ∧
    dome_height_num z0 p1 chord2 T16 < dome_height_num z0 0 chord2 T16 ∧
    dome_height_num z0 p2 chord2 T16 < dome_height_num z0 p1 chord2 T16 ∧
    pe_sag_num p1 span2 > 0
theorem uniform_lumen_load_preserves_growth_trough_second_diff
    (g_left g_trough g_right c : Int) :
    growth_second_diff (g_left + c) (g_trough + c) (g_right + c) =
      growth_second_diff g_left g_trough g_right"""^^pk:lean4 ;
        skos:notation "Delta_z_dome = p * L_pouch^2 / (16 * T_DP), T_DP = mu_BM * h_BM * (gamma_pouch^2 - gamma_pouch^-4) + T_cell;  T_PE * z_PE'' = -p with z_PE >= z_DP + h_min;  V_lumen = integral (z_PE - z_DP) dx = h_lumen * L(t) closes p;  z_dome(p=0) = z_dome_uncoupled, z_dome strictly decreasing in p;  growth_second_diff(g_l + c, g_t + c, g_r + c) = growth_second_diff(g_l, g_t, g_r) => fold loci invariant to p" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2019.09.009>,
            <https://doi.org/10.1038/s41467-018-06497-3>,
            <https://doi.org/10.1115/1.4032128>,
            <https://doi.org/10.1242/dev.02092>,
            <https://doi.org/10.1242/dev.199728>,
            <https://doi.org/10.7554/eLife.39596> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Multiplicative Finite-Strain Morphoelasticity F = F_e F_g Coupled to Apical-Basal Differential ECM Stiffness & Localized Hinge Fold Remodeling" ;
        pk:leanDeclaration "MathOfBiology.Loop_049.dome_height_num" ;
        pk:leanTheorem "MathOfBiology.Loop_049.lumen_pressure_laplace_dome_deflection" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/trushko-epithelioid-cyst-buckling-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Zoelly / Föppl–von Kármán Spherical Shell Critical Buckling Pressure Scaling Law" ;
        dct:description "Predicts the quadratic thickness-to-radius scaling P_c ∝ (h/R_0)^2 of critical inward invagination pressure across MDCK and Caco-2 epithelial cysts | Variables: P_c: critical buckling pressure (kPa); E_epi: epithelial monolayer Young's modulus (kPa); ν: Poisson ratio; h: epithelial monolayer thickness (μm); R_0: spherical alginate capsule inner radius (μm)" ;
        dct:source "Trushko et al. (2020) Dev. Cell 54(5):655-668 Figs. 3-4 & STAR Methods; Zoelly (1915) ETH Zürich" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L145-L215>,
            <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_069_epithelioid_cyst_buckling.lean#L27-L58> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def zoelly_pressure_scaled (c_e h : Nat) : Nat :=
  c_e * (h * h)
def zoelly_radius_doubling_lhs (c_e r : Nat) : Nat :=
  c_e * ((2 * r) * (2 * r))
def zoelly_radius_doubling_rhs (c_e r : Nat) : Nat :=
  4 * (c_e * (r * r))
theorem zoelly_quadratic_shell_buckling_scaling (c_e h r : Nat) :
    zoelly_pressure_scaled c_e (2 * h) = 4 * zoelly_pressure_scaled c_e h ∧
    zoelly_radius_doubling_lhs c_e r = zoelly_radius_doubling_rhs c_e r ∧
    zoelly_pressure_scaled 1 2 = 4 * zoelly_pressure_scaled 1 1
"""^^pk:lean4 ;
        skos:notation "P_c = (2 E_epi / √(3(1 - ν^2))) (h / R_0)^2  ⇒  P_c(2h, R_0) = 4 P_c(h, R_0)  ∧  P_c(h, 2R_0) = (1/4) P_c(h, R_0)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2020.07.019>,
            <https://doi.org/10.1073/pnas.1309482110>,
            <https://doi.org/10.1073/pnas.1312076111>,
            <https://doi.org/10.1103/PhysRevA.38.1005>,
            <https://doi.org/10.1515/znc-1973-11-1209>,
            <https://doi.org/10.3929/ethz-a-000096658> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Föppl–von Kármán & Zoelly Spherical Shell Buckling of Proliferating Epithelial Monolayers Under Elastic Alginate Confinement" ;
        pk:leanDeclaration "MathOfBiology.Loop_069.zoelly_pressure_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_069.zoelly_quadratic_shell_buckling_scaling" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/trushko-epithelioid-cyst-buckling-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Proliferative Confluent Laplace Stress Accumulation & Alginate Confinement Threshold Law" ;
        dct:description "Explains why unconfined or ultra-soft alginate capsules (E_alg ≪ E_crit, P_alg < P_c) remain spherical without buckling whereas stiff capsules (E_alg ∈ [2, 10] kPa) buckle at time t_b | Variables: g(t) = 2^((t - t_c)/τ_d): post-confluence proliferative growth stretch; K_alg = 2 E_alg H_alg / ((1 - ν_alg) R_0): spherical capsule radial stiffness; g_c: critical buckling stretch" ;
        dct:source "Trushko et al. (2020) Dev. Cell 54(5):655-668 Figs. 1-3 & pp. 657-661" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L175-L265>,
            <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_069_epithelioid_cyst_buckling.lean#L78-L94> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def laplace_confinement_stress (e_alg g g0 : Nat) : Nat :=
  e_alg * (g - g0)
theorem proliferative_confinement_buckling_threshold (e0 g0 gc dg : Nat) :
    laplace_confinement_stress (e0 + 1) g0 g0 = 0 ∧
    laplace_confinement_stress 0 (g0 + dg + 1) g0 = 0 ∧
    laplace_confinement_stress (e0 + 1) (g0 + dg + 1) g0 > 0 ∧
    laplace_confinement_stress (e0 + 1) (gc + dg + 1) gc > 0
"""^^pk:lean4 ;
        skos:notation "P_alg(g) = K_alg (g - 1) > 0  for g > 1;  buckling onset at g > g_c = 1 + P_c / K_alg  (t_b = t_c + τ_d log_2(g_c))" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2020.07.019>,
            <https://doi.org/10.1073/pnas.1309482110>,
            <https://doi.org/10.1073/pnas.1312076111>,
            <https://doi.org/10.1103/PhysRevA.38.1005>,
            <https://doi.org/10.1515/znc-1973-11-1209>,
            <https://doi.org/10.3929/ethz-a-000096658> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Föppl–von Kármán & Zoelly Spherical Shell Buckling of Proliferating Epithelial Monolayers Under Elastic Alginate Confinement" ;
        pk:leanDeclaration "MathOfBiology.Loop_069.laplace_confinement_stress" ;
        pk:leanTheorem "MathOfBiology.Loop_069.proliferative_confinement_buckling_threshold" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/trushko-epithelioid-cyst-buckling-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Inward Invagination Volume Conservation & Blebbistatin Actomyosin Contractility Shift Law" ;
        dct:description "Proves capsule volume partitioning during inward invagination and predicts the experimentally observed attenuation of fold depth and buckling pressure under Blebbistatin myosin-II inhibition | Variables: V_caps, V_lumen, V_fold: capsule, lumen, and invaginated cap volumes; δ/R_0: normalized inward fold depth; Γ_myo: active myosin-II contractility (reduced by Blebbistatin / Y-27632)" ;
        dct:source "Trushko et al. (2020) Dev. Cell 54(5):655-668 Figs. 5-6; Hannezo, Prost & Joanny (2014) PNAS 111(1):27-32" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L156-L377>,
            <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_069_epithelioid_cyst_buckling.lean#L108-L127> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def invaginated_lumen_volume (v_caps v_fold : Int) : Int :=
  v_caps - v_fold
def active_invagination_depth_scaled (delta_base c0 gamma_myo : Nat) : Nat :=
  (delta_base + 1) * (c0 + gamma_myo + 1)
theorem invagination_volume_conservation_and_blebbistatin_shift
    (v_caps v_fold : Int) (delta_base c0 g0 d_myo : Nat) :
    invaginated_lumen_volume v_caps v_fold + v_fold = v_caps ∧
    active_invagination_depth_scaled delta_base c0 g0 <
      active_invagination_depth_scaled delta_base c0 (g0 + d_myo + 1)
"""^^pk:lean4 ;
        skos:notation "V_lumen + V_fold = V_caps;  δ(g)/R_0 = c_δ √(g - g_c) (1 + β_myo Γ_myo)  ⇒  Γ_blebb < Γ_WT ⟹ δ_blebb < δ_WT" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2020.07.019>,
            <https://doi.org/10.1073/pnas.1309482110>,
            <https://doi.org/10.1073/pnas.1312076111>,
            <https://doi.org/10.1103/PhysRevA.38.1005>,
            <https://doi.org/10.1515/znc-1973-11-1209>,
            <https://doi.org/10.3929/ethz-a-000096658> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Föppl–von Kármán & Zoelly Spherical Shell Buckling of Proliferating Epithelial Monolayers Under Elastic Alginate Confinement" ;
        pk:leanDeclaration "MathOfBiology.Loop_069.active_invagination_depth_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_069.invagination_volume_conservation_and_blebbistatin_shift" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/trushko-epithelioid-cyst-buckling-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Apical-Basal Differential Tension Spontaneous Curvature Law (Pass 3, 3D triangulated vertex shell)" ;
        dct:description "Fixes the spontaneous curvature of the discrete Helfrich bending term (κ/2) Σ_v A_v (2H_v − 2H₀)² of the 3D icosphere shell from the apical-basal tension difference; ΔΓ_WT = 4.26 mN/m is calibrated so that H₀ R₀ = 1 (confluent sphere is the spontaneous shape) | Variables: κ: monolayer bending modulus; h: monolayer thickness; ΔΓ = Γ_apical − Γ_basal: apical-basal tension difference (mN/m); c = 2H: twice the mean curvature; c₀ = 2H₀: spontaneous curvature; ν: Poisson ratio; E_epi: monolayer Young's modulus; R₀: capsule radius" ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS 111(1):27-32 Eqs. 1-3; Helfrich (1973) Z. Naturforsch. C 28:693-703" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L476-L484>,
            <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_069_epithelioid_cyst_buckling.lean#L145-L177> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def apicobasal_bending_energy_scaled (k t c : Int) : Int :=
  k * (k * c * c - 2 * t * c)
theorem apicobasal_bending_completed_square (k t c : Int) :
    apicobasal_bending_energy_scaled k t c + t * t = (k * c - t) * (k * c - t)
theorem apicobasal_spontaneous_curvature_minimizer (k t c : Int) :
    apicobasal_bending_energy_scaled k t c ≥ -(t * t) ∧
    apicobasal_bending_energy_scaled 1 t t = -(t * t)
"""^^pk:lean4 ;
        skos:notation "f(c) = (κ/2) c² − ΔΓ h c,  c = 2H  ⇒  argmin f = c₀ = 2H₀ = ΔΓ h / κ;  with κ = E_epi h³ / (12(1 − ν²)):  H₀ R₀ = 6 (1 − ν²) ΔΓ R₀ / (E_epi h²);  integer form κ(κc² − 2tc) + t² = (κc − t)² ≥ 0, t = ΔΓ h" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2020.07.019>,
            <https://doi.org/10.1073/pnas.1309482110>,
            <https://doi.org/10.1073/pnas.1312076111>,
            <https://doi.org/10.1103/PhysRevA.38.1005>,
            <https://doi.org/10.1515/znc-1973-11-1209>,
            <https://doi.org/10.3929/ethz-a-000096658> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Föppl–von Kármán & Zoelly Spherical Shell Buckling of Proliferating Epithelial Monolayers Under Elastic Alginate Confinement" ;
        pk:leanDeclaration "MathOfBiology.Loop_069.apicobasal_bending_energy_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_069.apicobasal_spontaneous_curvature_minimizer" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/trushko-epithelioid-cyst-buckling-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Inverted-Cap Penalty & Unilateral Capsule Wall Contact Law (Pass 3, 3D triangulated vertex shell)" ;
        dct:description "Explains why apical-dominant tension (ΔΓ > 0) reduces fold depth and delays buckling onset in the ΔΓ sweep (slope −0.0058 R₀ per mN/m, onset +0.0094 per mN/m) and justifies reading the confinement pressure from the Winkler wall dilation exactly as Trushko et al. read it from alginate capsule dilation (Fig. 2E, r = 0.94) | Variables: h_m = |2H|: magnitude of the local mean curvature; c₀ = 2H₀ ≥ 0: apical-dominant spontaneous curvature; r: vertex radius; R₀: capsule inner radius; K_alg: capsule radial stiffness; P_3D: pressure read from capsule dilation" ;
        dct:source "Trushko et al. (2020) Dev. Cell 54(5):655-668 Fig. 2E & STAR Methods; Hannezo, Prost & Joanny (2014) PNAS 111(1):27-32; Alessandri et al. (2013) PNAS 110(37):14843-14848" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L591-L631>,
            <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_069_epithelioid_cyst_buckling.lean#L196-L221> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def inverted_cap_bending_penalty (hm c0 : Int) : Int := (hm + c0) * (hm + c0)
def aligned_cap_bending_penalty (hm c0 : Int) : Int := (hm - c0) * (hm - c0)
def capsule_wall_winkler_penalty (r R : Int) : Int :=
  if r ≤ R then 0 else (r - R) * (r - R)
theorem inverted_cap_penalty_and_capsule_wall_contact
    (hm c0 r R : Int) (hh : 0 ≤ hm) (hc : 0 ≤ c0) :
    inverted_cap_bending_penalty hm c0 = aligned_cap_bending_penalty hm c0 + 4 * (hm * c0) ∧
    aligned_cap_bending_penalty hm c0 ≤ inverted_cap_bending_penalty hm c0 ∧
    (r ≤ R → capsule_wall_winkler_penalty r R = 0) ∧
    (R < r → capsule_wall_winkler_penalty r R > 0)
"""^^pk:lean4 ;
        skos:notation "(h_m + c₀)² = (h_m − c₀)² + 4 h_m c₀ ≥ (h_m − c₀)²  for h_m, c₀ ≥ 0  (inverted Pogorelov cap never cheaper than lumen-concave cap);  W(r) = max(0, r − R₀)² : W = 0 for r ≤ R₀, W > 0 for r > R₀  (Winkler capsule, P_3D = K_alg (r_wall/R₀ − 1))" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2020.07.019>,
            <https://doi.org/10.1073/pnas.1309482110>,
            <https://doi.org/10.1073/pnas.1312076111>,
            <https://doi.org/10.1103/PhysRevA.38.1005>,
            <https://doi.org/10.1515/znc-1973-11-1209>,
            <https://doi.org/10.3929/ethz-a-000096658> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Föppl–von Kármán & Zoelly Spherical Shell Buckling of Proliferating Epithelial Monolayers Under Elastic Alginate Confinement" ;
        pk:leanDeclaration "MathOfBiology.Loop_069.inverted_cap_bending_penalty" ;
        pk:leanTheorem "MathOfBiology.Loop_069.inverted_cap_penalty_and_capsule_wall_contact" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/turing-gray-scott-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Gray-Scott Autocatalytic Reaction-Diffusion System" ;
        dct:description "Generates symmetry-breaking Turing spots (mitosis), labyrinthine stripes, and coral/soliton regimes across (F, k) morphospace | Variables: u(x,y,t): substrate concentration; v(x,y,t): autocatalyst concentration; D_u, D_v: diffusivities; F: feed rate; k: kill rate" ;
        dct:source "Turing (1952) Phil. Trans. R. Soc. B 237:37; Pearson (1993) Science 261:189" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7a781325/1952-turing-morpho.py#L430-L512>,
            <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/lean/MathOfBiology.lean#L208-L221> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def gray_scott_react_u (F u v : Int) : Int := -(u * v * v) + F * (1 - u)
def gray_scott_react_v (F k u v : Int) : Int := u * v * v - (F + k) * v
theorem gray_scott_homogeneous_equilibrium (F k : Int) :
    gray_scott_react_u F 1 0 = 0 ∧ gray_scott_react_v F k 1 0 = 0 := by
  simp [gray_scott_react_u, gray_scott_react_v]"""^^pk:lean4 ;
        skos:notation "∂u/∂t = D_u ∇^2 u - u v^2 + F(1 - u),   ∂v/∂t = D_v ∇^2 v + u v^2 - (F + k)v" ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Reaction-Diffusion Partial Differential Equations (PDE) & Linear Bifurcation Theory" ;
        pk:leanDeclaration "MathOfBiology.gray_scott_react_u" ;
        pk:leanTheorem "MathOfBiology.gray_scott_homogeneous_equilibrium" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/turing-gray-scott-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Turing (1952) Equal-Diffusion Stability Theorem" ;
        dct:description "Proves that equal morphogen diffusivities (D_u = D_v) cannot destabilize a stable homogeneous steady state at any spatial wavenumber | Variables: J_0: homogeneous reaction Jacobian; D_X, D_Y: morphogen diffusivities; q = k^2: squared Fourier wavenumber" ;
        dct:source "Turing (1952) Phil. Trans. R. Soc. B 237(641):37-72 Sections 8-9" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7a781325/1952-turing-morpho.py#L163-L244>,
            <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/lean/MathOfBiology.lean#L223-L240> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def turing_equal_diff_trace_neg (t_neg D q : Nat) : Nat := (t_neg + 1) + 2 * D * q
def turing_equal_diff_det (t_neg d_pos D q : Nat) : Nat :=
  D * D * q * q + D * (t_neg + 1) * q + (d_pos + 1)
theorem turing_equal_diffusion_no_instability (t_neg d_pos D q : Nat) :
    turing_equal_diff_trace_neg t_neg D q ≥ 1 ∧
    turing_equal_diff_det t_neg d_pos D q ≥ d_pos + 1 := by
  simp [turing_equal_diff_trace_neg, turing_equal_diff_det]; omega"""^^pk:lean4 ;
        skos:notation "D_X = D_Y = D, tr(J_0) < 0, det(J_0) > 0 ⟹ tr(J_k) = tr(J_0) - 2 D k^2 < 0 ∧ det(J_k) = D^2 k^4 - D tr(J_0) k^2 + det(J_0) > 0  (∀ k^2 ≥ 0)" ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Reaction-Diffusion Partial Differential Equations (PDE) & Linear Bifurcation Theory" ;
        pk:leanDeclaration "MathOfBiology.turing_equal_diff_det" ;
        pk:leanTheorem "MathOfBiology.turing_equal_diffusion_no_instability" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/turing-gray-scott-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Turing (1952) Differential-Diffusion Instability & Critical Ratio Law" ;
        dct:description "Governs spontaneous symmetry breaking and wavelength selection (λ_c = 2π/k_c = 5.62 cells) in Turing's ring of 20 cells and Pomacanthus skin stripes | Variables: a=1.0, b=-1.5, c=1.25, d=-1.5 (4x-scaled to 4, -6, 5, -6): activator-inhibitor Jacobian; d_c = 3.9271: critical diffusivity ratio; s*=4: dominant mode on N=20 ring" ;
        dct:source "Turing (1952) Phil. Trans. R. Soc. B 237(641):37-72 Sections 8-10; Kondo & Asai (1995) Nature 376:765-768" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7a781325/1952-turing-morpho.py#L163-L244>,
            <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/lean/MathOfBiology.lean#L242-L261> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def turing_fourier_det (a b c d DX DY q : Int) : Int :=
  DX * DY * q * q - (d * DX + a * DY) * q + (a * d - b * c)
theorem turing_differential_diffusion_instability :
    turing_fourier_det 4 (-6) 5 (-6) 1 1 0 = 6 ∧
    turing_fourier_det 4 (-6) 5 (-6) 1 1 1 = 9 ∧
    turing_fourier_det 4 (-6) 5 (-6) 1 4 1 = 0 ∧
    turing_fourier_det 4 (-6) 5 (-6) 1 5 1 = -3 := by decide"""^^pk:lean4 ;
        skos:notation "det(J_k) = D_X D_Y k^4 - (d D_X + a D_Y) k^2 + (a d - b c) < 0  for  d = D_Y / D_X > d_c = 3.927051" ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Reaction-Diffusion Partial Differential Equations (PDE) & Linear Bifurcation Theory" ;
        pk:leanDeclaration "MathOfBiology.turing_fourier_det" ;
        pk:leanTheorem "MathOfBiology.turing_differential_diffusion_instability" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/turing-gray-scott-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pearson (1993) Saddle-Node & Hopf Steady-State Bifurcation Laws" ;
        dct:description "Defines the exact Saddle-Node existence boundary and Hopf oscillation curve partitioning Pearson's 12 pattern classes (α–μ) in (k, F) morphospace | Variables: F: feed rate; k: kill rate; s = F + k; (U_-, V_+): high-activator homogeneous steady state" ;
        dct:source "Pearson (1993) Science 261(5118):189-192; Lee et al. (1994) Nature 369:215-218" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7a781325/1952-turing-morpho.py#L327-L426>,
            <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/lean/MathOfBiology.lean#L263-L283> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def pearson_sn_discriminant (F s : Int) : Int := F - 4 * s * s
def pearson_steady_trace (F k uv v_sq : Int) : Int := (-F - v_sq) + (2 * uv - (F + k))
theorem pearson_saddle_node_discriminant (F k s : Int) :
    pearson_sn_discriminant (4 * s * s) s = 0 ∧
    pearson_steady_trace F k (F + k) k = 0 := by
  simp [pearson_sn_discriminant, pearson_steady_trace]; omega"""^^pk:lean4 ;
        skos:notation "Δ_SN(F, k) = F - 4(F + k)^2 = 0,   tr(J_0)|_{U_* V_* = F+k} = k - V_+^2 = 0  ⟺  F_Hopf(k) = ½(√k - 2k - √(k(1 - 4√k)))" ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Reaction-Diffusion Partial Differential Equations (PDE) & Linear Bifurcation Theory" ;
        pk:leanDeclaration "MathOfBiology.pearson_sn_discriminant" ;
        pk:leanTheorem "MathOfBiology.pearson_saddle_node_discriminant" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/vogel-phyllotaxis-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Vogel (1979) Planar Capitulum Golden-Angle Spiral Law" ;
        dct:description "Constant-area centripetal floret packing producing the rising Fibonacci parastichy cascade (8,13)->(13,21)->(21,34)->(34,55) and bounded Voronoi optimality | Variables: n: floret plastochron index; r_n: radial distance; θ_n: divergence angle; τ = (1+√5)/2: golden ratio; J: jugacy" ;
        dct:source "Vogel (1979) Mathematical Biosciences 44:179-189 Eq. (1)-(4)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L110-L154>,
            <https://github.com/fractastical/morpholib/blob/c89d18d/morphoeval/lean/MathOfBiology.lean#L97-L116> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def vogel_radius_sq (c_sq n : Nat) : Nat := c_sq * n
theorem vogel_constant_annulus_area (c_sq n : Nat) :
    vogel_radius_sq c_sq (n + 1) - vogel_radius_sq c_sq n = c_sq := by
  simp [vogel_radius_sq, Nat.mul_add, Nat.add_sub_cancel_left]
theorem vogel_fibonacci_parastichy_cascade :
    (fib 6, fib 7) = (8, 13) ∧ (fib 7, fib 8) = (13, 21) ∧ (fib 8, fib 9) = (21, 34) ∧
    (fib 9, fib 10) = (34, 55) ∧ (fib 10, fib 11) = (55, 89) := by decide"""^^pk:lean4 ;
        skos:notation "r_n = c √n,   θ_n = n α_0 (mod 2π),   α_0 = 360° / τ^2 = 360° (2 - τ) ≈ 137.507764°" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0024>,
            <https://doi.org/10.1016/0025-5564(79)90080-4>,
            <https://doi.org/10.1098/rsos.160091>,
            <https://doi.org/10.1103/PhysRevLett.68.2098> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Kinematic Spiral Geometry, Repulsive Dynamical Systems & Delaunay Topology" ;
        pk:leanDeclaration "MathOfBiology.vogel_radius_sq" ;
        pk:leanTheorem "MathOfBiology.vogel_constant_annulus_area" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/vogel-phyllotaxis-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Douady & Couder (1992, 1996) Hofmeister Inhibitory Energy Minimization" ;
        dct:description "Dynamical self-organization of sequentially initiated primordia onto the main Fibonacci (137.51°) and Lucas (99.50°) noble-angle attractors | Variables: G = v Δt / r_0: dimensionless plastochron ratio; λ: inhibitory interaction decay length; d(·): Euclidean distance on meristem" ;
        dct:source "Douady & Couder (1992) Phys. Rev. Lett. 68:2098; (1996) J. Theor. Biol. 178:255" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L383-L441>,
            <https://github.com/fractastical/morpholib/blob/c89d18d/morphoeval/lean/MathOfBiology.lean#L118-L128> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def hofmeister_pair_kernel (kernel_fn : Nat → Nat) (dist_sq : Nat) : Nat := kernel_fn dist_sq
theorem douady_couder_kernel_symmetric (kernel_fn : Nat → Nat) (d_ij d_ji : Nat)
    (h_sym : d_ij = d_ji) :
    hofmeister_pair_kernel kernel_fn d_ij = hofmeister_pair_kernel kernel_fn d_ji := by
  rw [h_sym]"""^^pk:lean4 ;
        skos:notation "E(θ) = ∑_{j < n} exp(-d(r_0, θ; r_j(t), θ_j) / λ),   θ_n^* = argmin_θ E(θ),   r_j(t) = r_0 (1 + G)^m" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0024>,
            <https://doi.org/10.1016/0025-5564(79)90080-4>,
            <https://doi.org/10.1098/rsos.160091>,
            <https://doi.org/10.1103/PhysRevLett.68.2098> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Kinematic Spiral Geometry, Repulsive Dynamical Systems & Delaunay Topology" ;
        pk:leanDeclaration "MathOfBiology.hofmeister_pair_kernel" ;
        pk:leanTheorem "MathOfBiology.douady_couder_kernel_symmetric" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/vogel-phyllotaxis-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Delaunay Contact Parastichy & Outer-Rim Dislocation Asymmetry" ;
        dct:description "Explains why incomplete outer-rim contact chains under biological noise cause a 3:1 excess of (Fibonacci - 1) over (Fibonacci + 1) counts in Swinton et al. (2016) | Variables: (m, n): opposed Delaunay contact-spiral counts in annulus [r_1, r_2); σ_r, σ_θ: biological placement noise" ;
        dct:source "Swinton, Ochu & MSI Turing's Sunflower Consortium (2016) R. Soc. Open Sci. 3:160091 Table 1" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L470-L562>,
            <https://github.com/fractastical/morpholib/blob/c89d18d/morphoeval/lean/MathOfBiology.lean#L130-L139> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def rim_dislocation_count (m_fib : Nat) (lost_chain : Bool) : Nat :=
  if lost_chain then m_fib - 1 else m_fib
theorem swinton_rim_dislocation_nonincreasing (m_fib : Nat) (lost_chain : Bool) :
    rim_dislocation_count m_fib lost_chain ≤ m_fib := by
  cases lost_chain <;> simp [rim_dislocation_count, Nat.sub_le]"""^^pk:lean4 ;
        skos:notation "m_obs = m_Fib - Δm_rim (Δm_rim ∈ {0, 1}),   P(Fib - 1) > P(Fib + 1)  (binomial p = 5.07×10^{-5})" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0024>,
            <https://doi.org/10.1016/0025-5564(79)90080-4>,
            <https://doi.org/10.1098/rsos.160091>,
            <https://doi.org/10.1103/PhysRevLett.68.2098> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Kinematic Spiral Geometry, Repulsive Dynamical Systems & Delaunay Topology" ;
        pk:leanDeclaration "MathOfBiology.rim_dislocation_count" ;
        pk:leanTheorem "MathOfBiology.swinton_rim_dislocation_nonincreasing" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/willshaw-retinotectal-chemoaffinity-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Sperry / Prestige & Willshaw (1975) Reciprocal EphA-EphrinA Equilibrium & Strict Topographic Inversion Law" ;
        dct:description "Proves that reciprocal EphA * ephrin-A mass-action equilibrium uniquely selects the strictly decreasing inverted retinotectal map y_WT*(x) = L - x with zero chemoaffinity mismatch energy, mapping nasal retina (x=0) to posterior tectum (y=L) and temporal retina (x=L) to anterior tectum (y=0) | Variables: x in [0, L]: retinal nasal-temporal RGC coordinate; y in [0, L]: tectal anterior-posterior target coordinate; R_A(x), L_A(y): counter-graded EphA receptor and ephrin-A ligand concentrations; gamma_0: reciprocal mass-action signaling setpoint" ;
        dct:source "Prestige & Willshaw (1975) Proc. R. Soc. B 190:77-98; Brown et al. (2000) Cell 102:77-88 Fig. 1; Koulakov & Tsigankov (2004) BMC Neurosci. 5:30" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1976-willshaw-retinotectal-chemoaffinity.py#L97-L197>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_086_retinotectal_chemoaffinity.lean#L24-L65> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def sq_int (z : Int) : Int :=
  z * z
def wt_inverted_map (x L : Int) : Int :=
  L - x
def chemoaffinity_log_energy (x y L : Int) : Int :=
  sq_int (x + y - L)
def dyadic_grad (k : Nat) : Nat :=
  2 ^ k
theorem retinotectal_chemoaffinity_inversion (x x_1 x_2 L : Int) (h_lt : x_1 < x_2) :
    chemoaffinity_log_energy x (wt_inverted_map x L) L = 0 ∧
    wt_inverted_map x_2 L < wt_inverted_map x_1 L ∧
    wt_inverted_map 0 100 = 100 ∧
    wt_inverted_map 100 100 = 0 ∧
    dyadic_grad 0 * dyadic_grad 2 = 4 ∧
    dyadic_grad 1 * dyadic_grad 1 = 4 ∧
    dyadic_grad 2 * dyadic_grad 0 = 4 := by
  refine ⟨?_, ?_, by decide, by decide, by decide, by decide, by decide⟩
  · dsimp [chemoaffinity_log_energy, wt_inverted_map, sq_int]
    have h_zero : x + (L - x) - L = 0 := by omega
    rw [h_zero]
    decide
  · dsimp [wt_inverted_map]
    omega
"""^^pk:lean4 ;
        skos:notation "R_A(x) * L_A(y^*(x)) = gamma_0 = R_0 * L_0 * exp(alpha)  ==>  y_WT^*(x) = 1 - x;   x_1 < x_2 ==> y_WT^*(x_2) < y_WT^*(x_1)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(00)00012-X>,
            <https://doi.org/10.1098/rspb.1975.0087>,
            <https://doi.org/10.1098/rspb.1976.0087>,
            <https://doi.org/10.1186/1471-2202-5-30> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Counter-Gradient EphA/Ephrin-A Chemoaffinity Energy + Prestige-Willshaw Group I vs Group II Synaptic Competition & Isl2-EphA3 Knock-In Map Duplication" ;
        pk:leanDeclaration "MathOfBiology.Loop_086.wt_inverted_map" ;
        pk:leanTheorem "MathOfBiology.Loop_086.retinotectal_chemoaffinity_inversion" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/willshaw-retinotectal-chemoaffinity-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Brown et al. (2000) Isl2-EphA3 Knock-In Anterior Shift & Dual Topographic Map Bifurcation Law" ;
        dct:description "Proves that elevating EphA3 on 50% (Isl2+) of RGCs strictly shifts their termination zone anteriorly relative to neighbor Isl2- WT RGCs, generating two complete non-overlapping maps separated by L/2 in ki/ki homozygotes vs rostral-pole collapse in ki/+ heterozygotes | Variables: delta_R > 0: exogenous EphA3 receptor knock-in level on 50% Isl2+ RGCs; hom_rostral_branch(x), hom_caudal_branch(x): bifurcated rostral (Isl2+) and caudal (Isl2-) topographic maps in ki/ki homozygotes; het_clamped_branch(x): heterozygous ki/+ rostral-convergent branch" ;
        dct:source "Brown et al. (2000) Cell 102(1):77-88 Figs. 2, 3 & 6" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1976-willshaw-retinotectal-chemoaffinity.py#L190-L335>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_086_retinotectal_chemoaffinity.lean#L68-L112> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def ki_unclamped_map (x L delta_R : Int) : Int :=
  L - x - delta_R
def hom_rostral_branch (x : Int) : Int :=
  (100 - x) / 2
def hom_caudal_branch (x : Int) : Int :=
  50 + (100 - x) / 2
def het_clamped_branch (x L delta_R : Int) : Int :=
  if L - x - delta_R > 0 then L - x - delta_R else 0
theorem isl2_epha3_knockin_map_bifurcation (x L delta_R : Int) (h_pos : delta_R > 0) :
    ki_unclamped_map x L delta_R < wt_inverted_map x L ∧
    hom_caudal_branch x - hom_rostral_branch x = 50 ∧
    hom_rostral_branch 0 = 50 ∧
    hom_rostral_branch 100 = 0 ∧
    hom_caudal_branch 0 = 100 ∧
    hom_caudal_branch 100 = 50 ∧
    het_clamped_branch 20 100 28 = 52 ∧
    het_clamped_branch 80 100 28 = 0 := by
  refine ⟨?_, ?_, by decide, by decide, by decide, by decide, by decide, by decide⟩
  · dsimp [ki_unclamped_map, wt_inverted_map]
    omega
  · dsimp [hom_caudal_branch, hom_rostral_branch]
    omega
"""^^pk:lean4 ;
        skos:notation "y_KI^*(x) = 1 - (1/alpha) * ln(exp(alpha * x) + Delta_R / R_0) < y_WT^*(x);   y_caudal^*(x) - y_rostral^*(x) = 0.5 (ki/ki homozygote)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(00)00012-X>,
            <https://doi.org/10.1098/rspb.1975.0087>,
            <https://doi.org/10.1098/rspb.1976.0087>,
            <https://doi.org/10.1186/1471-2202-5-30> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Counter-Gradient EphA/Ephrin-A Chemoaffinity Energy + Prestige-Willshaw Group I vs Group II Synaptic Competition & Isl2-EphA3 Knock-In Map Duplication" ;
        pk:leanDeclaration "MathOfBiology.Loop_086.ki_unclamped_map" ;
        pk:leanTheorem "MathOfBiology.Loop_086.isl2_epha3_knockin_map_bifurcation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/willshaw-retinotectal-chemoaffinity-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Prestige & Willshaw (1975) Group II Half-Tectum Compression & Half-Retina Expansion vs Group I Rigid Lock Law" ;
        dct:description "Proves that Prestige & Willshaw (1975) Group II relative synaptic competition compresses the full retinal map by 1/2 onto a surgically halved tectum and expands a half-retina by 2x across an intact tectum, whereas Group I rigid affinity piles up nasal axons at the cut border | Variables: group_ii_half_tectum_comp(x): Group II compressed map onto rostral half-tectum [0, L/2]; group_i_truncated_map(x): Group I rigid affinity map without target normalization; group_ii_half_retina_exp(x): Group II expanded map of nasal half-retina [0, L/2] onto full tectum [0, L]" ;
        dct:source "Prestige & Willshaw (1975) Proc. R. Soc. B 190(1098):77-98 Figs. 1-6; Willshaw & von der Malsburg (1976) Proc. R. Soc. B 194:431-445" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1976-willshaw-retinotectal-chemoaffinity.py#L238-L360>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_086_retinotectal_chemoaffinity.lean#L115-L155> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def group_ii_half_tectum_comp (x : Int) : Int :=
  (100 - x) / 2
def group_i_truncated_map (x : Int) : Int :=
  if 100 - x <= 50 then 100 - x else 50
def group_ii_half_retina_exp (x : Int) : Int :=
  100 - 2 * x
theorem prestige_willshaw_group_ii_plasticity (x : Int) :
    group_ii_half_tectum_comp 0 = 50 ∧
    group_ii_half_tectum_comp 50 = 25 ∧
    group_ii_half_tectum_comp 100 = 0 ∧
    group_i_truncated_map 0 = 50 ∧
    group_i_truncated_map 50 = 50 ∧
    group_ii_half_retina_exp 0 = 100 ∧
    group_ii_half_retina_exp 50 = 0 ∧
    (wt_inverted_map 0 100 - wt_inverted_map 50 100) * 2 =
      (group_ii_half_retina_exp 0 - group_ii_half_retina_exp 50) ∧
    wt_inverted_map x 100 - 2 * group_ii_half_tectum_comp x >= 0 := by
  refine ⟨by decide, by decide, by decide, by decide, by decide, by decide, by decide, by decide, ?_⟩
  · dsimp [wt_inverted_map, group_ii_half_tectum_comp]
    omega
"""^^pk:lean4 ;
        skos:notation "y_comp^*(x) = (1 - x) / 2 in [0, 0.5] (slope -0.5);   y_exp^*(x) = 1 - 2*x in [0, 1] for x in [0, 0.5] (slope -2.0)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(00)00012-X>,
            <https://doi.org/10.1098/rspb.1975.0087>,
            <https://doi.org/10.1098/rspb.1976.0087>,
            <https://doi.org/10.1186/1471-2202-5-30> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Counter-Gradient EphA/Ephrin-A Chemoaffinity Energy + Prestige-Willshaw Group I vs Group II Synaptic Competition & Isl2-EphA3 Knock-In Map Duplication" ;
        pk:leanDeclaration "MathOfBiology.Loop_086.group_ii_half_tectum_comp" ;
        pk:leanTheorem "MathOfBiology.Loop_086.prestige_willshaw_group_ii_plasticity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/willshaw-retinotectal-chemoaffinity-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pass 3 — Orthogonal EphB/Ephrin-B Attractive Dorsoventral Mapping & 4D Tensor Separability Law" ;
        dct:description "Proves that attractive EphB forward signalling selects the strictly increasing dorsoventral map v* = z (opposite monotonicity to the repulsive AP map y* = L - x), that the separable 4D energy makes the two axes independent (AP target depends only on x, DV target only on z), and that a shallow EphB gradient shifts ventral termination zones laterally while leaving the dorsal pole fixed (Group I limit; Group II column competition erodes the shift in the script's mu_comp sweep) | Variables: z in [0, L]: dorsoventral retinal RGC coordinate (EphB rises ventrally); v in [0, L]: mediolateral tectal coordinate (ephrin-B1 rises medially); s_EphB, s_ephrinB: gradient scale factors (1 WT, 0.35 EphB2/B3 hypomorph, 0 flat); W_{(i,k),(j,l)}: 4D retinotectal synaptic tensor; sigma_chem: chemoaffinity tolerance" ;
        dct:source "Hindges R, McLaughlin T, Genoud N, Henkemeyer M, O'Leary DDM (2002) Neuron 35(3):475-487, doi 10.1016/S0896-6273(02)00799-7; Mann F, Ray S, Harris WA, Holt CE (2002) Neuron 35(3):461-473, doi 10.1016/S0896-6273(02)00786-9" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1976-willshaw-retinotectal-chemoaffinity.py#L538-L680>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_086_retinotectal_chemoaffinity.lean#L163-L224> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def dv_attractive_map (z : Int) : Int :=
  z
def dv_attractive_energy (z v : Int) : Int :=
  sq_int (z - v)
def ephb_hypomorph_map (z : Int) : Int :=
  35 * z / 100
theorem ephb_dorsoventral_attractive_orthogonal_map (x x_1 x_2 z z_1 z_2 L : Int)
    (hx : x_1 < x_2) (hz : z_1 < z_2) :
    dv_attractive_energy z (dv_attractive_map z) = 0 ∧
    dv_attractive_map z_1 < dv_attractive_map z_2 ∧
    wt_inverted_map x_2 L < wt_inverted_map x_1 L ∧
    wt_inverted_map x L + x = L ∧
    dv_attractive_map z - z = 0 ∧
    dv_attractive_map 0 = 0 ∧
    dv_attractive_map 100 = 100 := by
  refine ⟨?_, ?_, ?_, ?_, ?_, by decide, by decide⟩
  · dsimp [dv_attractive_energy, dv_attractive_map, sq_int]
    have h : z - z = 0 := by omega
    rw [h]
    decide
  · dsimp [dv_attractive_map]
    omega
  · dsimp [wt_inverted_map]
    omega
  · dsimp [wt_inverted_map]
    omega
  · dsimp [dv_attractive_map]
    omega
theorem ephb_hypomorph_lateral_shift (z : Int) (hz : z ≥ 0) :
    ephb_hypomorph_map z ≤ dv_attractive_map z ∧
    (z ≥ 3 → ephb_hypomorph_map z < dv_attractive_map z) ∧
    ephb_hypomorph_map 0 = dv_attractive_map 0 ∧
    ephb_hypomorph_map 100 = 35 ∧
    dv_attractive_map 100 - ephb_hypomorph_map 100 = 65 := by
  refine ⟨?_, ?_, by decide, by decide, by decide⟩
  · dsimp [ephb_hypomorph_map, dv_attractive_map]
    omega
  · intro h3
    dsimp [ephb_hypomorph_map, dv_attractive_map]
    omega
"""^^pk:lean4 ;
        skos:notation "E(i,k,j,l) = E_A(x_i,y_j) + E_B(z_k,v_l),  E_B(z,v) = 0.5*((s_EphB z - s_ephrinB v)/sigma_chem)^2  ==>  (x,z) |-> (y*,v*) = (1 - x, (s_EphB/s_ephrinB) z);  WT: v* = z (slope +1, attractive), AP: y* = 1 - x (slope -1, repulsive), zero cross-talk;  EphB2/B3 hypomorph s_EphB = 0.35 (Group I limit): v* = 0.35 z <= z, lateral shift 0.65 at the ventral pole, 0 at the dorsal pole" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(00)00012-X>,
            <https://doi.org/10.1098/rspb.1975.0087>,
            <https://doi.org/10.1098/rspb.1976.0087>,
            <https://doi.org/10.1186/1471-2202-5-30> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Counter-Gradient EphA/Ephrin-A Chemoaffinity Energy + Prestige-Willshaw Group I vs Group II Synaptic Competition & Isl2-EphA3 Knock-In Map Duplication" ;
        pk:leanDeclaration "MathOfBiology.Loop_086.dv_attractive_map" ;
        pk:leanTheorem "MathOfBiology.Loop_086.ephb_dorsoventral_attractive_orthogonal_map" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/willshaw-retinotectal-chemoaffinity-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pass 3 — Spontaneous Retinal Wave Co-Firing Compact-Support Law for the Willshaw-von der Malsburg Cooperative Kernel K_ret" ;
        dct:description "Proves that co-firing in bounded cholinergic wave domains confines the correlation-derived cooperative kernel to retinal separations <= 2 r_wave, and that without waves (r = 0) only self-correlation remains, formalising why beta2-nAChR knockout retinae lose neighbour-driven termination-zone refinement while gradient-set polarity is preserved | Variables: c: wave initiation centre; r (r_wave): wave domain radius; p, q: retinal positions of two RGCs; s_a(e): binary burst raster of RGC a in event e; C_wave: pairwise Pearson burst correlation; K_ret: Hebbian cooperative kernel driving (K_ret (x) K_y (x) K_v) W in the 4D tensor growth law" ;
        dct:source "Meister M, Wong ROL, Baylor DA, Shatz CJ (1991) Science 252(5008):939-943, doi 10.1126/science.2035024; Feller MB et al. (1996) Science 272(5265):1182-1187, doi 10.1126/science.272.5265.1182; McLaughlin T, Torborg CL, Feller MB, O'Leary DDM (2003) Neuron 40(6):1147-1160, doi 10.1016/S0896-6273(03)00790-6; Willshaw DJ, von der Malsburg C (1976) Proc. R. Soc. B 194:431-445" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1976-willshaw-retinotectal-chemoaffinity.py#L464-L535>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_086_retinotectal_chemoaffinity.lean#L226-L248> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def in_wave_domain (c r p : Int) : Prop :=
  c - r ≤ p ∧ p ≤ c + r
theorem wave_cofiring_bounds_separation (c r p q : Int)
    (hp : in_wave_domain c r p) (hq : in_wave_domain c r q) :
    p - q ≤ 2 * r ∧ q - p ≤ 2 * r ∧ (r = 0 → p = q) := by
  dsimp [in_wave_domain] at hp hq
  refine ⟨by omega, by omega, ?_⟩
  intro hr
  omega
"""^^pk:lean4 ;
        skos:notation "s_a(e) = 1 iff |p_a - c(e)| <= r_wave;  C_wave = corr_e[s_a, s_b];  K_ret = max(C_wave - 3/sqrt(n_events), 0) with zero diagonal;  (p, q in domain(c, r)) ==> |p - q| <= 2 r  ==>  K_ret[a,b] = 0 whenever |p_a - p_b| > 2 r_wave;  r = 0 (beta2-nAChR-/-, no waves) ==> p = q (diagonal kernel, no neighbour-driven refinement, enlarged TZ)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(00)00012-X>,
            <https://doi.org/10.1098/rspb.1975.0087>,
            <https://doi.org/10.1098/rspb.1976.0087>,
            <https://doi.org/10.1186/1471-2202-5-30> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Counter-Gradient EphA/Ephrin-A Chemoaffinity Energy + Prestige-Willshaw Group I vs Group II Synaptic Competition & Isl2-EphA3 Knock-In Map Duplication" ;
        pk:leanDeclaration "MathOfBiology.Loop_086.in_wave_domain" ;
        pk:leanTheorem "MathOfBiology.Loop_086.wave_cofiring_bounds_separation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/wolfram-conus-textile-rule30-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Wolfram (1983, 1984) Rule 30 Boolean & GF(2) Algebraic Normal Form" ;
        dct:description "Discrete chaotic generator of self-similar white triangular tents on Conus textile shells and OEIS A051023 center column | Variables: a_{t,i} ∈ {0, 1}: pigment state at mantle cell i and step t; ⊕: XOR; ∨: OR" ;
        dct:source "Wolfram (1983) Rev. Mod. Phys. 55:601; (1984) Nature 311:419" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L96-L152>,
            <https://github.com/fractastical/morpholib/blob/fb234bc/morphoeval/lean/MathOfBiology.lean#L21-L37> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def rule30 (p q r : Bool) : Bool := bne p (q || r)
def rule30_anf (p q r : Bool) : Bool := bne (bne p q) (bne r (q && r))
theorem rule30_anf_equiv (p q r : Bool) : rule30 p q r = rule30_anf p q r := by
  cases p <;> cases q <;> cases r <;> rfl
"""^^pk:lean4 ;
        skos:notation "a_{t+1, i} = a_{t, i-1} ⊕ (a_{t, i} ∨ a_{t, i+1}) ≡ a_{t, i-1} + a_{t, i} + a_{t, i+1} + a_{t, i} a_{t, i+1} (mod 2)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0167-2789(90)90169-P>,
            <https://doi.org/10.1016/S0022-5193(87)80101-7>,
            <https://doi.org/10.1038/311419a0>,
            <https://doi.org/10.1103/RevModPhys.55.601> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Elementary Cellular Automata (GF(2)), Neurosecretory Mantle Threshold Automaton & Reaction-Diffusion PDE" ;
        pk:leanDeclaration "MathOfBiology.rule30" ;
        pk:leanTheorem "MathOfBiology.rule30_anf_equiv" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/wolfram-conus-textile-rule30-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Erica Jen (1990) Left-Bijective Spatial Inverse & Diagonal Period-Doubling Recursion" ;
        dct:description "Proves exact left-bijectivity (0 bit errors) and explains why left-cone diagonals lock into period-doubling crystals separated by d_{k-1}=0 barriers | Variables: d_k(t) = a_{t, k-t}: k-th left-cone diagonal; P_k = 2^m: exact temporal period doubling at k ∈ {0, 3, 8, 29, 400, ...}" ;
        dct:source "Jen (1990) Physica D 45(1-3):3-18 Theorem 1 & Section 2" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L172-L256>,
            <https://github.com/fractastical/morpholib/blob/fb234bc/morphoeval/lean/MathOfBiology.lean#L39-L61> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def rule30_left_inverse (a_next q r : Bool) : Bool := bne a_next (q || r)
theorem jen_1990_left_bijective (p q r : Bool) :
    rule30_left_inverse (rule30 p q r) q r = p := by
  cases p <;> cases q <;> cases r <;> rfl
theorem jen_1990_barrier_shielding (d_km2 d_k : Bool) :
    jen_diagonal_step d_km2 true d_k = !d_km2 := by
  cases d_km2 <;> cases d_k <;> rfl
"""^^pk:lean4 ;
        skos:notation "a_{t, i-1} = a_{t+1, i} ⊕ (a_{t, i} ∨ a_{t, i+1}),   d_k(t+1) = d_{k-2}(t) ⊕ (d_{k-1}(t) ∨ d_k(t))" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0167-2789(90)90169-P>,
            <https://doi.org/10.1016/S0022-5193(87)80101-7>,
            <https://doi.org/10.1038/311419a0>,
            <https://doi.org/10.1103/RevModPhys.55.601> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Elementary Cellular Automata (GF(2)), Neurosecretory Mantle Threshold Automaton & Reaction-Diffusion PDE" ;
        pk:leanDeclaration "MathOfBiology.rule30_left_inverse" ;
        pk:leanTheorem "MathOfBiology.jen_1990_left_bijective" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/wolfram-conus-textile-rule30-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Meinhardt & Klingler (1987) 3-Species Activator-Substrate-Hormone Mantle PDE" ;
        dct:description "Continuous biochemical mechanism producing self-extinguishing pigment triangles and V-shaped travelling waves after mantle lesion | Variables: a(x,t): pigment activator; s(x,t): depleted substrate; h(x,t): fast-diffusing systemic hormone" ;
        dct:source "Meinhardt & Klingler (1987) J. Theor. Biol. 126(1):63-89 Eq. (1)-(3)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L8598-L8640>,
            <https://github.com/fractastical/morpholib/blob/fb234bc/morphoeval/lean/MathOfBiology.lean#L240-L255> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def meinhardt_activator_reaction (rho kappa rho0 mu_a : Nat) (a s : Nat) : Int :=
  Int.ofNat (rho * s * (a * a + rho0 * (1 + kappa * a * a))) -
    Int.ofNat (mu_a * a * (1 + kappa * a * a))
theorem meinhardt_basal_quiescence (rho kappa mu_a s : Nat) :
    meinhardt_activator_reaction rho kappa 0 mu_a 0 s = 0 := by
  simp [meinhardt_activator_reaction]
"""^^pk:lean4 ;
        skos:notation "∂a/∂t = ρ s (a^2 / (1 + κ a^2) + ρ_0) - μ_a a + D_a ∂^2a/∂x^2,   ∂s/∂t = σ (h / (1 + γ h)) - ρ s a^2 - μ_s s + D_s ∂^2s/∂x^2" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0167-2789(90)90169-P>,
            <https://doi.org/10.1016/S0022-5193(87)80101-7>,
            <https://doi.org/10.1038/311419a0>,
            <https://doi.org/10.1103/RevModPhys.55.601> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Elementary Cellular Automata (GF(2)), Neurosecretory Mantle Threshold Automaton & Reaction-Diffusion PDE" ;
        pk:leanDeclaration "MathOfBiology.meinhardt_activator_reaction" ;
        pk:leanTheorem "MathOfBiology.meinhardt_basal_quiescence" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/wolfram-conus-textile-rule30-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Ermentrout-Oster (1986) / Boettiger-Ermentrout-Oster (2009) Neurosecretory Mantle Threshold Isomorphism to Rule 30" ;
        dct:description "Proves that the discrete 3-cell asymmetric threshold limit of the Ermentrout-Oster neural mantle model is algebraically isomorphic to Wolfram Rule 30 | Variables: S_{t,i} ∈ {0,1}: mantle secretomotor firing; R_{t,i}: refractory inhibitor; E(l,c,r) ∈ {0,1,2,3}: 3-cell net synaptic drive" ;
        dct:source "Ermentrout, Campbell & Oster (1986) The Veliger 28(4):369-388; Boettiger, Ermentrout & Oster (2009) PNAS 106(16):6837-6842" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L8453-L8523>,
            <https://github.com/fractastical/morpholib/blob/fb234bc/morphoeval/lean/MathOfBiology.lean#L256-L275> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def ermentrout_oster_net_excitation (l c r : Bool) : Nat :=
  2 * (if l then 1 else 0) + (if c then 1 else 0) + (if r then 1 else 0) - (if c && r then 1 else 0)
def ermentrout_oster_neural_gate (l c r : Bool) : Bool :=
  let e := ermentrout_oster_net_excitation l c r
  decide (1 ≤ e ∧ e ≤ 2)
theorem ermentrout_oster_neural_gate_eq_rule30 (l c r : Bool) :
    ermentrout_oster_neural_gate l c r = rule30 l c r := by
  cases l <;> cases c <;> cases r <;> rfl
"""^^pk:lean4 ;
        skos:notation "S_{t+1,i} = H(∑_r W_E(r) A_{t,i+r} - ∑_r W_I(r) A_{t,i+r} - R_{t,i} - θ);   E(l,c,r) = 2l + c + r - cr ∈ [1, 2] ⟺ l ⊕ (c ∨ r)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0167-2789(90)90169-P>,
            <https://doi.org/10.1016/S0022-5193(87)80101-7>,
            <https://doi.org/10.1038/311419a0>,
            <https://doi.org/10.1103/RevModPhys.55.601> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Elementary Cellular Automata (GF(2)), Neurosecretory Mantle Threshold Automaton & Reaction-Diffusion PDE" ;
        pk:leanDeclaration "MathOfBiology.ermentrout_oster_neural_gate" ;
        pk:leanTheorem "MathOfBiology.ermentrout_oster_neural_gate_eq_rule30" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/wolfram-conus-textile-rule30-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Molluscan Clade Wolfram Class II (Rule 90) vs. Class III (Rule 30) Boolean Jacobian & Chirality Dichotomy" ;
        dct:description "Resolves the 1D horizontal chord indiscriminability gap by proving why 2D tent-wall chirality and quadratic ANF carry separate Class III Conus (Rule 30) from Class II Oliva (Rule 90) | Variables: ∂f/∂l, ∂f/∂r: directional Boolean derivatives; ρ_carry = P(a_{t+1,i} ≠ l ⊕ r): 2D quadratic ANF carry density" ;
        dct:source "Waddington & Cowe (1969) J. Theor. Biol. 25:219; Wolfram (1984) Nature 311:419; Meinhardt (1995) Ch. 5-6" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L8526-L8595>,
            <https://github.com/fractastical/morpholib/blob/fb234bc/morphoeval/lean/MathOfBiology.lean#L277-L302> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def rule90 (l _c r : Bool) : Bool := bne l r
theorem rule90_reflection_symmetric (l c r : Bool) : rule90 l c r = rule90 r c l := by
  cases l <;> cases r <;> rfl
theorem rule30_right_jacobian_center_gated (l c r : Bool) :
    bne (rule30 l c r) (rule30 l c (!r)) = !c := by
  cases l <;> cases c <;> cases r <;> rfl
"""^^pk:lean4 ;
        skos:notation "Rule 90 (Oliva): ∂f/∂l = ∂f/∂r = 1, f(l,c,r) = f(r,c,l);   Rule 30 (Conus): ∂f/∂l = 1, ∂f/∂r = ¬c, f(1,1,0) ≠ f(0,1,1)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0167-2789(90)90169-P>,
            <https://doi.org/10.1016/S0022-5193(87)80101-7>,
            <https://doi.org/10.1038/311419a0>,
            <https://doi.org/10.1103/RevModPhys.55.601> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Elementary Cellular Automata (GF(2)), Neurosecretory Mantle Threshold Automaton & Reaction-Diffusion PDE" ;
        pk:leanDeclaration "MathOfBiology.rule90" ;
        pk:leanTheorem "MathOfBiology.rule30_right_jacobian_center_gated" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/wolpert-french-flag-morphogen-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Wolpert (1969) Linear Source-Sink Positional Gradient & Scale-Invariant French-Flag Trisection" ;
        dct:description "Establishes Wolpert's French Flag positional information principle and proves exact proportional regulation under linear source-sink diffusion | Variables: c₀: source morphogen concentration at x=0; L: embryonic axis length; T₁, T₂: cellular differentiation thresholds (Blue ≥ T₁, T₂ ≤ White < T₁, Red < T₂)" ;
        dct:source "Wolpert (1969) J. Theor. Biol. 25(1):1-47 Sec. 3 & Figs. 2-3 (doi:10.1016/S0022-5193(69)80016-0)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L145-L215>,
            <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_011_french_flag_morphogen.lean#L21-L49> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def wolpert_linear_num (c0 L x : Nat) : Nat := c0 * (L - x)
theorem wolpert_linear_scale_homogeneity (c0 L x s : Nat) :
    wolpert_linear_num c0 (s * L) (s * x) = s * wolpert_linear_num c0 L x
theorem wolpert_french_flag_exact_trisection (k : Nat) :
    let x1 := k; let x2 := 2 * k; let L := 3 * k
    (x1 = k) ∧ (x2 - x1 = k) ∧ (L - x2 = k) ∧ (x1 + (x2 - x1) + (L - x2) = L)
"""^^pk:lean4 ;
        skos:notation "D ∂²c/∂x² = 0, c(0)=c₀, c(L)=0 ⇒ c_lin(x) = c₀(1 - x/L);  x_i/L = 1 - T_i/c₀ (scale-invariant)" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1016/0092-8674(93)90626-2>,
            <https://doi.org/10.1016/0092-8674(94)90030-2>,
            <https://doi.org/10.1016/S0022-5193(69)80016-0>,
            <https://doi.org/10.1016/S0092-8674(00)80999-X>,
            <https://doi.org/10.1038/225420a0>,
            <https://doi.org/10.1038/244492a0>,
            <https://doi.org/10.1038/254199a0>,
            <https://doi.org/10.1038/289295a0>,
            <https://doi.org/10.1038/371609a0>,
            <https://doi.org/10.1073/pnas.0912734107> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Positional Information & Morphogen Gradients" ;
        pk:leanDeclaration "MathOfBiology.Loop_011.wolpert_linear_num" ;
        pk:leanTheorem "MathOfBiology.Loop_011.wolpert_linear_scale_homogeneity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/wolpert-french-flag-morphogen-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Synthesis-Diffusion-Degradation (SDD) Exponential Decay & Source-Ablation Quiescence" ;
        dct:description "Governs steady-state exponential morphogen decay, threshold boundary precision, and complete loss of suprathreshold differentiation under ZPA ablation | Variables: D: morphogen diffusivity (μm²/s); k: linear degradation rate (s⁻¹); λ = √(D/k): characteristic decay length; σ_c: concentration noise; σ_x: boundary positional error" ;
        dct:source "Wolpert (1969) J. Theor. Biol. 25:1-47; Crick (1970) Nature 225:420-422 (doi:10.1038/225420a0)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L218-L320>,
            <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_011_french_flag_morphogen.lean#L56-L86> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def sdd_residual (D k_deg c_left c_mid c_right : Int) : Int :=
  D * (c_left + c_right - 2 * c_mid) - k_deg * c_mid
theorem sdd_steady_state_balance (D k_deg c_left c_mid c_right : Int)
    (h_bal : D * (c_left + c_right) = 2 * (D * c_mid) + k_deg * c_mid) :
    sdd_residual D k_deg c_left c_mid c_right = 0
theorem sdd_zero_source_ablation_quiescence (D k_deg : Int) (T1 T2 : Nat)
    (hT1 : 0 < T1) (hT2 : 0 < T2) :
    sdd_residual D k_deg 0 0 0 = 0 ∧ french_flag_zone 0 T1 T2 = 0
"""^^pk:lean4 ;
        skos:notation "∂c/∂t = D ∂²c/∂x² - k c ⇒ c_SDD(x) = c₀ exp(-x/λ), λ = √(D/k);  σ_x(x_i) = (λ / T_i) σ_c" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1016/0092-8674(93)90626-2>,
            <https://doi.org/10.1016/0092-8674(94)90030-2>,
            <https://doi.org/10.1016/S0022-5193(69)80016-0>,
            <https://doi.org/10.1016/S0092-8674(00)80999-X>,
            <https://doi.org/10.1038/225420a0>,
            <https://doi.org/10.1038/244492a0>,
            <https://doi.org/10.1038/254199a0>,
            <https://doi.org/10.1038/289295a0>,
            <https://doi.org/10.1038/371609a0>,
            <https://doi.org/10.1073/pnas.0912734107> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Positional Information & Morphogen Gradients" ;
        pk:leanDeclaration "MathOfBiology.Loop_011.sdd_residual" ;
        pk:leanTheorem "MathOfBiology.Loop_011.sdd_steady_state_balance" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/wolpert-french-flag-morphogen-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Tickle, Summerbell & Wolpert (1975) ZPA Graft Superposition & Mirror-Image Digit Duplication" ;
        dct:description "Proves that grafting a second ZPA organizer at the anterior margin x = L induces an anteroposteriorly symmetric morphogen profile and mirror-image digit duplication | Variables: φ(x): posterior ZPA Sonic hedgehog (Shh) spatial kernel; L: anteroposterior wing bud width; T₄ > T₃ > T₂: digit identity thresholds" ;
        dct:source "Tickle, Summerbell & Wolpert (1975) Nature 254:199-202 (doi:10.1038/254199a0); Riddle et al. (1993) Cell 75:1401-1416" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L323-L410>,
            <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_011_french_flag_morphogen.lean#L93-L115> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def zpa_graft_superposition (phi : Nat → Nat) (L x : Nat) : Nat :=
  phi x + phi (L - x)
theorem tickle_1975_zpa_mirror_duplication_symmetry
    (phi : Nat → Nat) (L x T1 T2 : Nat) (hx : x ≤ L) :
    zpa_graft_superposition phi L (L - x) = zpa_graft_superposition phi L x ∧
    french_flag_zone (zpa_graft_superposition phi L (L - x)) T1 T2 =
      french_flag_zone (zpa_graft_superposition phi L x) T1 T2
"""^^pk:lean4 ;
        skos:notation "c_dup(x) = φ(x) + φ(L - x) = c_dup(L - x) ⇒ palindromic chick wing digit sequence 4–3–2–2–3–4" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1016/0092-8674(93)90626-2>,
            <https://doi.org/10.1016/0092-8674(94)90030-2>,
            <https://doi.org/10.1016/S0022-5193(69)80016-0>,
            <https://doi.org/10.1016/S0092-8674(00)80999-X>,
            <https://doi.org/10.1038/225420a0>,
            <https://doi.org/10.1038/244492a0>,
            <https://doi.org/10.1038/254199a0>,
            <https://doi.org/10.1038/289295a0>,
            <https://doi.org/10.1038/371609a0>,
            <https://doi.org/10.1073/pnas.0912734107> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Positional Information & Morphogen Gradients" ;
        pk:leanDeclaration "MathOfBiology.Loop_011.zpa_graft_superposition" ;
        pk:leanTheorem "MathOfBiology.Loop_011.tickle_1975_zpa_mirror_duplication_symmetry" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/wolpert-french-flag-morphogen-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Ben-Zvi & Barkai (2010) Expansion-Repression Dynamic Scaling Invariance" ;
        dct:description "Resolves the SDD scaling failure by locking the morphogen decay length λ_eff proportionally to domain size L(t) across developmental growth stages | Variables: E(x,t): diffusible expander concentration; T_rep: distal repression threshold; λ_eff(L): expander-modulated decay length" ;
        dct:source "Ben-Zvi & Barkai (2010) PNAS 107(15):6924-6929 Eqs. 1-4 (doi:10.1073/pnas.0912734107)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L413-L490>,
            <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_011_french_flag_morphogen.lean#L122-L129> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem benzvi_barkai_2010_expander_scaling_invariance (x lam0 s : Nat) :
    (s * x) * lam0 = x * (s * lam0) := by
  ac_rfl
"""^^pk:lean4 ;
        skos:notation "∂E/∂t = D_E ∂²E/∂x² + α_E H(T_rep - c(L,t)) - β_E E ⇒ λ_eff(L) = L / ln(c₀ / T_rep) ∝ L" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1016/0092-8674(93)90626-2>,
            <https://doi.org/10.1016/0092-8674(94)90030-2>,
            <https://doi.org/10.1016/S0022-5193(69)80016-0>,
            <https://doi.org/10.1016/S0092-8674(00)80999-X>,
            <https://doi.org/10.1038/225420a0>,
            <https://doi.org/10.1038/244492a0>,
            <https://doi.org/10.1038/254199a0>,
            <https://doi.org/10.1038/289295a0>,
            <https://doi.org/10.1038/371609a0>,
            <https://doi.org/10.1073/pnas.0912734107> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Positional Information & Morphogen Gradients" ;
        pk:leanDeclaration "MathOfBiology.Loop_011.benzvi_barkai_2010_expander_scaling_invariance" ;
        pk:leanTheorem "MathOfBiology.Loop_011.benzvi_barkai_2010_expander_scaling_invariance" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/wolpert-french-flag-morphogen-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "2D Zero-Flux SDD Stencil on the Limb Bud Paddle & Reduction to the 1D cosh Steady State" ;
        dct:description "Governs the 2D FGF field on the paddle; the stencil is verified against the 1D cosh steady state (RMSE 2.4e-3, zero cross-column spread) in verify_limb2d_against_1d_cosh | Variables: F(x,y,t): AER FGF (Fgf8 + Shh-induced Fgf4); n: number of in-mask neighbours (zero-flux paddle boundary); λ_F = √(D/k_F) = 100 μm; AER(x,y,t): distal-facing rim cells of the growing paddle" ;
        dct:source "Crick (1970) Nature 225:420-422; Crossley et al. (1996) Cell 84:127-136 (doi:10.1016/S0092-8674(00)80999-X)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L501-L718>,
            <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_011_french_flag_morphogen.lean#L137-L162> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def sdd_residual_2d (D k_deg n sum_nb c_mid : Int) : Int :=
  D * (sum_nb - n * c_mid) - k_deg * c_mid
theorem sdd_2d_steady_state_balance (D k_deg n sum_nb c_mid : Int)
    (h_bal : D * sum_nb = n * (D * c_mid) + k_deg * c_mid) :
    sdd_residual_2d D k_deg n sum_nb c_mid = 0
theorem sdd_2d_reduces_to_1d_interior (D k_deg c_prox c_mid c_dist : Int) :
    sdd_residual_2d D k_deg 4 (c_prox + c_dist + c_mid + c_mid) c_mid =
      sdd_residual D k_deg c_prox c_mid c_dist
"""^^pk:lean4 ;
        skos:notation "∂F/∂t = D ∇²F − k_F F + s_F·AER(x,y,t)·(1 + g_S S/(S+K_S));  masked 5-point stencil R = D(Σ_nb c − n c_mid) − k c_mid, missing neighbours ⇒ zero flux;  rectangle ⇒ F(y) = cosh(y/λ_F)/cosh(L/λ_F)" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1016/0092-8674(93)90626-2>,
            <https://doi.org/10.1016/0092-8674(94)90030-2>,
            <https://doi.org/10.1016/S0022-5193(69)80016-0>,
            <https://doi.org/10.1016/S0092-8674(00)80999-X>,
            <https://doi.org/10.1038/225420a0>,
            <https://doi.org/10.1038/244492a0>,
            <https://doi.org/10.1038/254199a0>,
            <https://doi.org/10.1038/289295a0>,
            <https://doi.org/10.1038/371609a0>,
            <https://doi.org/10.1073/pnas.0912734107> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Positional Information & Morphogen Gradients" ;
        pk:leanDeclaration "MathOfBiology.Loop_011.sdd_residual_2d" ;
        pk:leanTheorem "MathOfBiology.Loop_011.sdd_2d_steady_state_balance" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/wolpert-french-flag-morphogen-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "Shh–FGF Positive Feedback Loop & AER-Excision Quiescence of the ZPA" ;
        dct:description "Couples the AP (Shh) and PD (FGF) systems: AER removal collapses Shh (Niswander 1994) and a ZPA graft induces anterior AER FGF (Laufer 1994); measured as Shh remaining ≤ 0.06 % 3 h after excision and posterior/anterior AER FGF = 1.56 (WT) → 1.00 (symmetric graft) | Variables: S(x,y,t): ZPA Shh; K_FS: FGF half-saturation of Shh production; g_S, K_S: Shh → Fgf4 feedback gain and half-saturation; λ_S = 80 μm" ;
        dct:source "Laufer et al. (1994) Cell 79:993-1003 (doi:10.1016/0092-8674(94)90030-2); Niswander et al. (1994) Nature 371:609-612 (doi:10.1038/371609a0)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L558-L678>,
            <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_011_french_flag_morphogen.lean#L165-L182> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def shh_production (s_S F K_FS : Nat) : Nat := s_S * F / (F + K_FS)
theorem shh_fgf_feedback_aer_ablation_quiescence (s_S K_FS T1 T2 : Nat)
    (hT1 : 0 < T1) (hT2 : 0 < T2) :
    shh_production s_S 0 K_FS = 0 ∧ french_flag_zone 0 T1 T2 = 0
"""^^pk:lean4 ;
        skos:notation "∂S/∂t = D ∇²S − k_S S + s_S·[ZPA + graft·ZPA_ant]·F/(F+K_FS);  F = 0 ⇒ Shh production = 0 ⇒ all positions sub-threshold" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1016/0092-8674(93)90626-2>,
            <https://doi.org/10.1016/0092-8674(94)90030-2>,
            <https://doi.org/10.1016/S0022-5193(69)80016-0>,
            <https://doi.org/10.1016/S0092-8674(00)80999-X>,
            <https://doi.org/10.1038/225420a0>,
            <https://doi.org/10.1038/244492a0>,
            <https://doi.org/10.1038/254199a0>,
            <https://doi.org/10.1038/289295a0>,
            <https://doi.org/10.1038/371609a0>,
            <https://doi.org/10.1073/pnas.0912734107> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Positional Information & Morphogen Gradients" ;
        pk:leanDeclaration "MathOfBiology.Loop_011.shh_production" ;
        pk:leanTheorem "MathOfBiology.Loop_011.shh_fgf_feedback_aer_ablation_quiescence" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/wolpert-french-flag-morphogen-7> a skos:Concept,
            pk:Concept ;
        rdfs:label "Progress-Zone Outgrowth & Monotone Distal Truncation after AER Excision" ;
        dct:description "Reproduces Saunders (1948) / Summerbell (1974): AER excision at HH18/20/22/24/26 truncates at stylopod/zeugopod/zeugopod/autopod/autopod (5/5 matches, Spearman ρ = 1) | Variables: L(t): proximo-distal paddle length; ⟨F⟩_PZ: mean FGF within 100 μm of the rim (progress zone); v_max = 0.016 μm/s of compressed model time; K_g: half-saturation" ;
        dct:source "Saunders (1948) J Exp Zool 108:363-403 (doi:10.1002/jez.1401080304); Summerbell (1974) J Embryol Exp Morphol 32:651-660 (PMID 4463222); Summerbell, Lewis & Wolpert (1973) Nature 244:492-496 (doi:10.1038/244492a0)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L681-L799>,
            <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_011_french_flag_morphogen.lean#L186-L207> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def truncated_length (L0 v t_exc : Nat) : Nat := L0 + v * t_exc
theorem aer_excision_truncation_monotone (L0 v t1 t2 : Nat) (h : t1 ≤ t2) :
    truncated_length L0 v t1 ≤ truncated_length L0 v t2
theorem progress_zone_segment_order (k L1 L2 : Nat) (h12 : L1 ≤ L2)
    (h1 : L1 < k) (h2 : 2 * k ≤ L2) :
    L1 < k ∧ k ≤ 2 * k ∧ 2 * k ≤ L2 ∧ L1 < L2
"""^^pk:lean4 ;
        skos:notation "dL/dt = v_max ⟨F⟩_PZ/(⟨F⟩_PZ + K_g);  L_final(t_exc) = L0 + v·t_exc non-decreasing in t_exc;  segment = stylopod (< ⅓ L_WT), zeugopod (< ⅔ L_WT), autopod" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1016/0092-8674(93)90626-2>,
            <https://doi.org/10.1016/0092-8674(94)90030-2>,
            <https://doi.org/10.1016/S0022-5193(69)80016-0>,
            <https://doi.org/10.1016/S0092-8674(00)80999-X>,
            <https://doi.org/10.1038/225420a0>,
            <https://doi.org/10.1038/244492a0>,
            <https://doi.org/10.1038/254199a0>,
            <https://doi.org/10.1038/289295a0>,
            <https://doi.org/10.1038/371609a0>,
            <https://doi.org/10.1073/pnas.0912734107> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Positional Information & Morphogen Gradients" ;
        pk:leanDeclaration "MathOfBiology.Loop_011.truncated_length" ;
        pk:leanTheorem "MathOfBiology.Loop_011.aer_excision_truncation_monotone" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/wolpert-french-flag-morphogen-8> a skos:Concept,
            pk:Concept ;
        rdfs:label "Tickle (1981) Graft Dose Series: Digit Classes Monotone in Graft Strength (Morphogen-Valley Digit Reader)" ;
        dct:description "Replaces the Pass 2 ad hoc half-domain split (which produced the non-biological 4-3-2-3 for the attenuated graft) with one rule shared by the 1D and 2D readouts | Variables: c: Shh level next to the anterior graft relative to the wild-type peak; graft strengths 0 / 0.10 / 0.35 / 1.0 ⇒ +0 / +1 / +2 / +3 digits" ;
        dct:source "Tickle (1981) Nature 289:295-298 (doi:10.1038/289295a0); Tickle, Summerbell & Wolpert (1975) Nature 254:199-202" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L347-L378>,
            <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_011_french_flag_morphogen.lean#L211-L228> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def digit_classes_reached (c T4 T3 T2 : Nat) : Nat :=
  (if T2 ≤ c then 1 else 0) + (if T3 ≤ c then 1 else 0) + (if T4 ≤ c then 1 else 0)
theorem tickle_1981_graft_dose_digit_monotone (c c' T4 T3 T2 : Nat) (h : c ≤ c') :
    digit_classes_reached c T4 T3 T2 ≤ digit_classes_reached c' T4 T3 T2
"""^^pk:lean4 ;
        skos:notation "digits(c) = [T2 ≤ c] + [T3 ≤ c] + [T4 ≤ c] non-decreasing in c;  new territory at identity change or at an interior minimum of c ⇒ 4-3-2, 4-3-2-2, 4-3-2-2-3, 4-3-2-2-3-4" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1016/0092-8674(93)90626-2>,
            <https://doi.org/10.1016/0092-8674(94)90030-2>,
            <https://doi.org/10.1016/S0022-5193(69)80016-0>,
            <https://doi.org/10.1016/S0092-8674(00)80999-X>,
            <https://doi.org/10.1038/225420a0>,
            <https://doi.org/10.1038/244492a0>,
            <https://doi.org/10.1038/254199a0>,
            <https://doi.org/10.1038/289295a0>,
            <https://doi.org/10.1038/371609a0>,
            <https://doi.org/10.1073/pnas.0912734107> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Positional Information & Morphogen Gradients" ;
        pk:leanDeclaration "MathOfBiology.Loop_011.digit_classes_reached" ;
        pk:leanTheorem "MathOfBiology.Loop_011.tickle_1981_graft_dose_digit_monotone" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/yaman-somitoid-chirality-buckling-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Yamanaka et al. (2023) & Adhyapok et al. (2021) Apical Constriction Wedge-Cell Tapering & Somitecoel Lumen Equilibrium Law" ;
        dct:description "Proves that apical actomyosin constriction (gamma_ap > gamma_bas > 0) enforces wedge-cell tapering (L_ap < L_bas) and stabilizes a finite central somitecoel lumen | Variables: R_in: inner somitecoel lumen radius (um); R_out: outer somite rosette radius (um); N: number of radial wedge cells; gamma_ap: apical actomyosin tension; gamma_bas: basal ECM-engaged tension; gamma_lat: lateral N-cadherin tension" ;
        dct:source "Yamanaka et al. (2023) Nature 614:509-520 Figs. 1-3; Adhyapok et al. (2021) Dev. Cell 56:1312-1324 Figs. 2-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L200-L379>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_029_somitoid_chirality_buckling.lean#L24-L60> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def wedge_arc_length (theta_scaled R : Int) : Int :=
  theta_scaled * R
def rosette_lumen_numerator (N_lat two_pi_gamma_ap : Int) : Int :=
  N_lat - two_pi_gamma_ap
def rosette_basal_denominator (N_lat two_pi_gamma_bas : Int) : Int :=
  N_lat + two_pi_gamma_bas
theorem yamanaka_adhyapok_wedge_rosette_tapering
    (theta_scaled R_in R_out N_lat two_pi_gamma_ap two_pi_gamma_bas : Int)
    (h_theta : 0 < theta_scaled)
    (h_rad : R_in < R_out)
    (h_bas : 0 < two_pi_gamma_bas)
    (h_ap : two_pi_gamma_bas < two_pi_gamma_ap) :
    wedge_arc_length theta_scaled R_in < wedge_arc_length theta_scaled R_out ∧
    rosette_lumen_numerator N_lat two_pi_gamma_ap <
      rosette_basal_denominator N_lat two_pi_gamma_bas"""^^pk:lean4 ;
        skos:notation "R_in^* / R_out^* = L_ap^* / L_bas^* = (N * gamma_lat - 2 * pi * gamma_ap) / (N * gamma_lat + 2 * pi * gamma_bas) < 1" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0022-5193(76)80131-2>,
            <https://doi.org/10.1016/S0960-9822(03)00534-7>,
            <https://doi.org/10.1016/j.devcel.2021.03.026>,
            <https://doi.org/10.1038/s41467-018-05376-1>,
            <https://doi.org/10.1038/s41467-022-29967-1>,
            <https://doi.org/10.1038/s41586-019-1885-9>,
            <https://doi.org/10.1038/s41586-020-2144-9>,
            <https://doi.org/10.1038/s41586-022-05649-2>,
            <https://doi.org/10.1038/s41586-022-05655-4> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Apico-Basal Differential Interfacial Tension Vertex Mechanics Driving Wedge-Cell Somite Rosette & Somitecoel Lumen Formation" ;
        pk:leanDeclaration "MathOfBiology.Loop_029.wedge_arc_length" ;
        pk:leanTheorem "MathOfBiology.Loop_029.yamanaka_adhyapok_wedge_rosette_tapering" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/yaman-somitoid-chirality-buckling-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Adhyapok et al. (2021) EphA4/ephrinB2 Inter-Somite Cleft Boundary Sorting Energy Barrier Law" ;
        dct:description "Establishes that heterotypic EphA4/ephrinB2 repulsion (2*gamma_het > gamma_ant + gamma_post) creates a positive energy barrier that drives physical somite cleft separation | Variables: L_cleft: inter-somitic boundary contact length (um); gamma_het: heterotypic EphA4-ephrinB2 interfacial tension; gamma_ant, gamma_post: homotypic intra-somite cell-cell tensions" ;
        dct:source "Adhyapok et al. (2021) Dev. Cell 56:1312-1324 Figs. 1-3; Yamanaka et al. (2023) Nature 614:509-520 Fig. 2" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L722-L748>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_029_somitoid_chirality_buckling.lean#L62-L90> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def eph_cleft_sorting_energy (L_cleft gamma_het gamma_ant gamma_post : Int) : Int :=
  L_cleft * (2 * gamma_het - (gamma_ant + gamma_post))
theorem adhyapok_2021_eph_ephrin_cleft_sorting_barrier
    (L_cleft gamma_het gamma_het_kd gamma_ant gamma_post : Int)
    (h_len : 0 < L_cleft)
    (h_rep : gamma_ant + gamma_post < 2 * gamma_het)
    (h_kd : 2 * gamma_het_kd = gamma_ant + gamma_post) :
    0 < eph_cleft_sorting_energy L_cleft gamma_het gamma_ant gamma_post ∧
    eph_cleft_sorting_energy L_cleft gamma_het_kd gamma_ant gamma_post = 0"""^^pk:lean4 ;
        skos:notation "Delta_E_cleft = L_cleft * (2 * gamma_het - (gamma_ant + gamma_post)) > 0  when 2 * gamma_het > gamma_ant + gamma_post" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0022-5193(76)80131-2>,
            <https://doi.org/10.1016/S0960-9822(03)00534-7>,
            <https://doi.org/10.1016/j.devcel.2021.03.026>,
            <https://doi.org/10.1038/s41467-018-05376-1>,
            <https://doi.org/10.1038/s41467-022-29967-1>,
            <https://doi.org/10.1038/s41586-019-1885-9>,
            <https://doi.org/10.1038/s41586-020-2144-9>,
            <https://doi.org/10.1038/s41586-022-05649-2>,
            <https://doi.org/10.1038/s41586-022-05655-4> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Apico-Basal Differential Interfacial Tension Vertex Mechanics Driving Wedge-Cell Somite Rosette & Somitecoel Lumen Formation" ;
        pk:leanDeclaration "MathOfBiology.Loop_029.eph_cleft_sorting_energy" ;
        pk:leanTheorem "MathOfBiology.Loop_029.adhyapok_2021_eph_ephrin_cleft_sorting_barrier" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/yaman-somitoid-chirality-buckling-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Yamanaka et al. (2023) & Miao et al. (2023) Y-27632 ROCK Inhibition & Minus-Matrigel Curvature Collapse Law" ;
        dct:description "Proves that ROCK inhibition (Y-27632) or absence of Matrigel ECM abolishes the apico-basal tension differential and dilates the somitecoel lumen relative to wild-type MET rosettes | Variables: gamma_ap_wt: wild-type apical actomyosin tension under RhoA/ROCK activation; gamma_bas: basal ECM tension; N_lat: lateral N-cadherin adhesion term N*gamma_lat" ;
        dct:source "Yamanaka et al. (2023) Nature 614:509-520 Fig. 3; Miao et al. (2023) Nature 614:500-508 Fig. 4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L381-L413,L750-L822>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_029_somitoid_chirality_buckling.lean#L92-L119> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def apico_basal_tension_diff (gamma_ap gamma_bas : Int) : Int :=
  gamma_ap - gamma_bas
theorem yamanaka_2023_rock_inhibition_curvature_collapse
    (N_lat gamma_ap_wt gamma_bas : Int)
    (h_wt : gamma_bas < gamma_ap_wt) :
    apico_basal_tension_diff gamma_bas gamma_bas = 0 ∧
    0 < apico_basal_tension_diff gamma_ap_wt gamma_bas ∧
    rosette_lumen_numerator N_lat gamma_ap_wt <
      rosette_lumen_numerator N_lat gamma_bas"""^^pk:lean4 ;
        skos:notation "gamma_ap = gamma_bas  =>  Delta_gamma_{ap-bas} = gamma_ap - gamma_bas = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0022-5193(76)80131-2>,
            <https://doi.org/10.1016/S0960-9822(03)00534-7>,
            <https://doi.org/10.1016/j.devcel.2021.03.026>,
            <https://doi.org/10.1038/s41467-018-05376-1>,
            <https://doi.org/10.1038/s41467-022-29967-1>,
            <https://doi.org/10.1038/s41586-019-1885-9>,
            <https://doi.org/10.1038/s41586-020-2144-9>,
            <https://doi.org/10.1038/s41586-022-05649-2>,
            <https://doi.org/10.1038/s41586-022-05655-4> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Apico-Basal Differential Interfacial Tension Vertex Mechanics Driving Wedge-Cell Somite Rosette & Somitecoel Lumen Formation" ;
        pk:leanDeclaration "MathOfBiology.Loop_029.apico_basal_tension_diff" ;
        pk:leanTheorem "MathOfBiology.Loop_029.yamanaka_2023_rock_inhibition_curvature_collapse" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/yaman-somitoid-chirality-buckling-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Yamanaka et al. (2023) 3D Polyhedral Shell Somitecoel Lumen Pressurization Law" ;
        dct:description "Proves that lumen pressure strictly dilates the 3D somitecoel equilibrium and that the closed-shell condition is the two-surface Laplace bound P < 2 (gamma_ap + gamma_bas) / R_in; the discrete 2 N_3D-DOF polyhedral relaxation reproduces the closed form to < 1e-3 | Variables: Lambda = gamma_lat * (total angular lateral edge length) / 2 for the N_3D-cell spherical Voronoi shell; gamma_ap, gamma_bas: apical and basal face tensions; P: somitecoel lumen pressure (gamma_lat / um); R_in: lumen radius" ;
        dct:source "Yamanaka et al. (2023) Nature 614:509-520 Figs. 2-3 (somitecoel lumen); Gomez-Galvez et al. (2018) Nat Commun 9:2960 (polyhedral/scutoid shell geometry)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L415-L714>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_029_somitoid_chirality_buckling.lean#L122-L163> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def shell_lumen_numerator (Lam four_pi_gamma_ap two_pi_P_Rin : Int) : Int :=
  Lam - four_pi_gamma_ap + two_pi_P_Rin
def shell_basal_denominator (Lam four_pi_gamma_bas : Int) : Int :=
  Lam + four_pi_gamma_bas
theorem yamanaka_2023_shell_lumen_pressurization
    (Lam four_pi_gamma_ap four_pi_gamma_bas two_pi_P_Rin : Int)
    (h_P : 0 < two_pi_P_Rin)
    (h_bas : 0 < four_pi_gamma_bas)
    (h_ap : 0 < four_pi_gamma_ap) :
    shell_lumen_numerator Lam four_pi_gamma_ap 0 <
      shell_lumen_numerator Lam four_pi_gamma_ap two_pi_P_Rin ∧
    (shell_lumen_numerator Lam four_pi_gamma_ap two_pi_P_Rin <
        shell_basal_denominator Lam four_pi_gamma_bas ↔
      two_pi_P_Rin < four_pi_gamma_ap + four_pi_gamma_bas) ∧
    shell_lumen_numerator Lam four_pi_gamma_ap 0 <
      shell_basal_denominator Lam four_pi_gamma_bas"""^^pk:lean4 ;
        skos:notation "rho_3D = R_in / R_out = (Lambda - 4 pi gamma_ap + 2 pi P R_in) / (Lambda + 4 pi gamma_bas);  rho_3D < 1 iff 2 pi P R_in < 4 pi (gamma_ap + gamma_bas)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0022-5193(76)80131-2>,
            <https://doi.org/10.1016/S0960-9822(03)00534-7>,
            <https://doi.org/10.1016/j.devcel.2021.03.026>,
            <https://doi.org/10.1038/s41467-018-05376-1>,
            <https://doi.org/10.1038/s41467-022-29967-1>,
            <https://doi.org/10.1038/s41586-019-1885-9>,
            <https://doi.org/10.1038/s41586-020-2144-9>,
            <https://doi.org/10.1038/s41586-022-05649-2>,
            <https://doi.org/10.1038/s41586-022-05655-4> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Apico-Basal Differential Interfacial Tension Vertex Mechanics Driving Wedge-Cell Somite Rosette & Somitecoel Lumen Formation" ;
        pk:leanDeclaration "MathOfBiology.Loop_029.shell_lumen_numerator" ;
        pk:leanTheorem "MathOfBiology.Loop_029.yamanaka_2023_shell_lumen_pressurization" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/yaman-somitoid-chirality-buckling-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Lewis (2003) / Cooke & Zeeman (1976) HES7 Clock-Wavefront Arrest & Tension Maturation Gradient Law" ;
        dct:description "Proves the clock-and-wavefront segment-length law S = v T and the anterior-to-posterior MET maturation gradient that the live HES7 -> MESP2/RIPPLY2 -> tension coupling feeds into the vertex rosette solver | Variables: v: determination wavefront speed (um/h); T: HES7 clock period (h); t_arrest: wavefront passage time of a cell; k: linearised RhoA/ROCK (or EphA4/ephrinB2) tension ramp slope; gamma_base: pre-MET baseline tension" ;
        dct:source "Lewis (2003) Curr Biol 13:1398-1408; Cooke & Zeeman (1976) J Theor Biol 58:455-476; Diaz-Cuadros et al. (2020) Nature 580:113-118; Matsuda et al. (2020) Nature 580:124-129; Yamanaka et al. (2023) Nature 614:509-520 Fig. 4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2021-yaman-somitoid-chirality-buckling.py#L824-L1121>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_029_somitoid_chirality_buckling.lean#L165-L212> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def segment_length (v T : Int) : Int :=
  v * T
def cell_age (t t_arrest : Int) : Int :=
  t - t_arrest
def tension_ramp (gamma_base k age : Int) : Int :=
  gamma_base + k * age
theorem hes7_wavefront_arrest_tension_gradient
    (v T_short T_long t t_ant t_post gamma_base k : Int)
    (h_v : 0 < v)
    (h_T : T_short < T_long)
    (h_order : t_ant < t_post)
    (h_t : t_post ≤ t)
    (h_k : 0 < k) :
    segment_length v T_short < segment_length v T_long ∧
    (0 ≤ cell_age t t_post ∧ cell_age t t_post < cell_age t t_ant) ∧
    tension_ramp gamma_base k (cell_age t t_post) <
      tension_ramp gamma_base k (cell_age t t_ant)"""^^pk:lean4 ;
        skos:notation "S = v * T_HES7 ;  gamma(t) = gamma_base + k * (t - t_arrest) ;  t_ant < t_post <= t  =>  gamma_ant(t) > gamma_post(t)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0022-5193(76)80131-2>,
            <https://doi.org/10.1016/S0960-9822(03)00534-7>,
            <https://doi.org/10.1016/j.devcel.2021.03.026>,
            <https://doi.org/10.1038/s41467-018-05376-1>,
            <https://doi.org/10.1038/s41467-022-29967-1>,
            <https://doi.org/10.1038/s41586-019-1885-9>,
            <https://doi.org/10.1038/s41586-020-2144-9>,
            <https://doi.org/10.1038/s41586-022-05649-2>,
            <https://doi.org/10.1038/s41586-022-05655-4> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Apico-Basal Differential Interfacial Tension Vertex Mechanics Driving Wedge-Cell Somite Rosette & Somitecoel Lumen Formation" ;
        pk:leanDeclaration "MathOfBiology.Loop_029.segment_length" ;
        pk:leanTheorem "MathOfBiology.Loop_029.hes7_wavefront_arrest_tension_gradient" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/yan-vibrio-biofilm-nematic-fountain-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Parabolic Radial Compression Stress Center Peak & Margin Vanishing Law" ;
        dct:description "Establishes the parabolic radial compressive stress profile across an expanding Vibrio cholerae monolayer peaking at r = 0 and vanishing at r = R | Variables: r: radial coordinate from colony center; R: expanding biofilm radius; ζ: RbmA/Bap1/RbmC cell-substrate friction coefficient; g: exponential growth rate; h: monolayer thickness; κ = ζ g / (4 h)" ;
        dct:source "Beroz et al. (2018) Nature Physics 14:954-960 Eq. (1) & SI Text" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2019-yan-vibrio-biofilm-nematic-fountain.py#L95-L150>,
            <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_095_vibrio_biofilm_nematic_fountain.lean#L25-L48> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def radial_compression_stress (kappa R r : Int) : Int :=
  kappa * (R * R - r * r)
def radial_stress_nat (kappa r_sq_diff : Nat) : Nat :=
  kappa * r_sq_diff
theorem parabolic_radial_stress_center_peak_and_edge_zero (kappa R : Int) (k0 r0 gap : Nat) :
    radial_compression_stress kappa R R = 0 ∧
    radial_compression_stress kappa R 0 = kappa * (R * R) ∧
    radial_stress_nat (k0 + 1) ((r0 + 1) + (gap + 1)) >
      radial_stress_nat (k0 + 1) (gap + 1)
"""^^pk:lean4 ;
        skos:notation "σ_{rr}(r) = (ζ g / (4 h)) (R^2 - r^2) = κ (R^2 - r^2)  ⇒  σ_{rr}(R) = 0,  σ_{rr}(0) = κ R^2 > σ_{rr}(r > 0)" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/s41567-018-0170-4>,
            <https://doi.org/10.1038/s41567-018-0356-9>,
            <https://doi.org/10.1073/pnas.1601702113>,
            <https://doi.org/10.1073/pnas.1611494113> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Hertzian Rod-on-Substrate Radial Compression Stress & Critical Verticalization Instability (P(r) = (1/2) ζ g (R^2 - r^2) ≥ P_c(L_cell))" ;
        pk:leanDeclaration "MathOfBiology.Loop_095.radial_compression_stress" ;
        pk:leanTheorem "MathOfBiology.Loop_095.parabolic_radial_stress_center_peak_and_edge_zero" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/yan-vibrio-biofilm-nematic-fountain-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Critical Verticalization Radius Onset & RbmA Friction-Loss Control Law" ;
        dct:description "Governs the onset and radial propagation of the verticalization front r_vert(R) = √(R^2 - R_c^2) and proves that ΔrbmA / Δbap1ΔrbmC low-friction mutants remain flat (r_vert = 0) | Variables: R_c: critical colony radius at verticalization onset; r_vert: radius of the central verticalized core; σ_c: Hertzian rod-on-substrate peeling threshold" ;
        dct:source "Beroz et al. (2018) Nature Physics 14:954-960 Figs. 1-4; Yan et al. (2016) PNAS 113:E5337-E5343" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2019-yan-vibrio-biofilm-nematic-fountain.py#L152-L280>,
            <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_095_vibrio_biofilm_nematic_fountain.lean#L59-L79> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def verticalization_front_sq (R_sq R_c_sq : Nat) : Nat :=
  R_sq - R_c_sq
def front_stress_residual (kappa R_sq r_vert_sq sigma_c : Int) : Int :=
  kappa * (R_sq - r_vert_sq) - sigma_c
theorem verticalization_front_onset_and_rbmA_control
    (kappa R_c_sq dr_sq : Int) (rc2 excess2 sub_gap : Nat) :
    front_stress_residual kappa (R_c_sq + dr_sq) dr_sq (kappa * R_c_sq) = 0 ∧
    verticalization_front_sq (rc2 + (excess2 + 1)) rc2 = excess2 + 1 ∧
    verticalization_front_sq rc2 (rc2 + sub_gap) = 0
"""^^pk:lean4 ;
        skos:notation "R_c = √(σ_c / κ),  r_vert^2 = max(0, R^2 - R_c^2)  ⇒  κ (R^2 - r_vert^2) = σ_c,  r_vert(ΔrbmA) = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/s41567-018-0170-4>,
            <https://doi.org/10.1038/s41567-018-0356-9>,
            <https://doi.org/10.1073/pnas.1601702113>,
            <https://doi.org/10.1073/pnas.1611494113> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Hertzian Rod-on-Substrate Radial Compression Stress & Critical Verticalization Instability (P(r) = (1/2) ζ g (R^2 - r^2) ≥ P_c(L_cell))" ;
        pk:leanDeclaration "MathOfBiology.Loop_095.verticalization_front_sq" ;
        pk:leanTheorem "MathOfBiology.Loop_095.verticalization_front_onset_and_rbmA_control" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/yan-vibrio-biofilm-nematic-fountain-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Inverse Cell-Length Buckling Threshold & Cephalexin vs A22 Expansion Law" ;
        dct:description "Explains why cephalexin-elongated cells verticalize at smaller colony radii R_c and form larger verticalized cores than A22-shortened cells | Variables: L: rod cell length; L_0: wild-type rod length (2.1 μm); σ_c(L): cell-length-dependent peeling buckling stress; R_c(L): critical verticalization colony radius" ;
        dct:source "Beroz et al. (2018) Nature Physics 14:954-960 Figs. 2-3; Hartmann et al. (2019) Nature Physics 15:251-256" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2019-yan-vibrio-biofilm-nematic-fountain.py#L285-L385>,
            <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_095_vibrio_biofilm_nematic_fountain.lean#L90-L106> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cell_length_buckling_product_residual (L sigma_c L0 sigma_c0 : Int) : Int :=
  L * sigma_c - L0 * sigma_c0
theorem cell_length_inverse_buckling_and_cephalexin_expansion
    (k L L0 : Int) (rc_long_sq delta_rc_sq extra_R_sq : Nat) :
    let rc_short_sq := rc_long_sq + (delta_rc_sq + 1)
    let R_sq := rc_short_sq + (extra_R_sq + 1)
    cell_length_buckling_product_residual L (k * L0) L0 (k * L) = 0 ∧
    verticalization_front_sq R_sq rc_short_sq < verticalization_front_sq R_sq rc_long_sq
"""^^pk:lean4 ;
        skos:notation "L σ_c(L) = L_0 σ_{c0},  L R_c(L)^2 = L_0 R_{c0}^2  ⇒  r_vert^2(L_cephalexin) > r_vert^2(L_A22)" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/s41567-018-0170-4>,
            <https://doi.org/10.1038/s41567-018-0356-9>,
            <https://doi.org/10.1073/pnas.1601702113>,
            <https://doi.org/10.1073/pnas.1611494113> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Hertzian Rod-on-Substrate Radial Compression Stress & Critical Verticalization Instability (P(r) = (1/2) ζ g (R^2 - r^2) ≥ P_c(L_cell))" ;
        pk:leanDeclaration "MathOfBiology.Loop_095.cell_length_buckling_product_residual" ;
        pk:leanTheorem "MathOfBiology.Loop_095.cell_length_inverse_buckling_and_cephalexin_expansion" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/zajac-convergent-extension-intercalation-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Zajac, Jones & Glazier (2003) Anisotropic Differential Adhesion & Bertet, Sulak & Lecuit (2004) Polarized T1 Junction Tension Law" ;
        dct:description "Proves that planar-polarized mediolateral adhesion / Myosin II enrichment (Delta_Lambda > 0) elevates vertical AP-facing junction tension above horizontal ML junction tension and drives a strictly negative interfacial energy drop across vertical-to-horizontal T1 neighbor exchanges | Variables: theta: junction angle relative to mediolateral (ML, x) axis; J_0, Delta_J: isotropic and anisotropic adhesion coefficients; Lambda_0, Delta_Lambda: isotropic and Myosin II planar-polarized line tensions; l_0: junction length resolved across a 4-way T1 vertex" ;
        dct:source "Zajac, Jones & Glazier (2003) J. Theor. Biol. 222(2):247-259 Eqs. 1-4; Bertet, Sulak & Lecuit (2004) Nature 429(6992):667-671 Figs. 1-3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2003-zajac-convergent-extension-intercalation.py#L120-L195>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_093_convergent_extension_intercalation.lean#L17-L68> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def junction_tension_vertical (Lambda_0 Delta_Lambda : Int) : Int :=
  Lambda_0 + Delta_Lambda
def junction_tension_horizontal (Lambda_0 Delta_Lambda : Int) : Int :=
  Lambda_0 - Delta_Lambda
def t1_quartet_energy_change (Lambda_0 Delta_Lambda l_0 : Int) : Int :=
  (junction_tension_horizontal Lambda_0 Delta_Lambda -
   junction_tension_vertical Lambda_0 Delta_Lambda) * l_0
theorem zajac_bertet_polarized_t1_energy_drop
    (Lambda_0 Delta_Lambda l_0 : Int)
    (hAniso : Delta_Lambda > 0) (hLen : l_0 > 0) :
    junction_tension_vertical Lambda_0 Delta_Lambda >
      junction_tension_horizontal Lambda_0 Delta_Lambda ∧
    t1_quartet_energy_change Lambda_0 Delta_Lambda l_0 < 0 ∧
    t1_quartet_energy_change Lambda_0 0 l_0 = 0"""^^pk:lean4 ;
        skos:notation "J(theta) = J_0 - Delta_J * cos(2 * theta),  Lambda(theta) = Lambda_0 - Delta_Lambda * cos(2 * theta);  Lambda_vert(pi/2) = Lambda_0 + Delta_Lambda > Lambda_horiz(0) = Lambda_0 - Delta_Lambda;  Delta_E_T1(l_0) = (Lambda_horiz - Lambda_vert) * l_0 = -2 * Delta_Lambda * l_0 < 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0022-5193(03)00033-X>,
            <https://doi.org/10.1038/35011077>,
            <https://doi.org/10.1038/nature02590>,
            <https://doi.org/10.1103/PhysRevLett.85.2022> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Anisotropic Cell-Cell Adhesion, Polarized Mediolateral Junction Tension & Pure-Shear T1 Intercalation Mechanics" ;
        pk:leanDeclaration "MathOfBiology.Loop_093.t1_quartet_energy_change" ;
        pk:leanTheorem "MathOfBiology.Loop_093.zajac_bertet_polarized_t1_energy_drop" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/zajac-convergent-extension-intercalation-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Incompressible 2D Pure-Shear Tissue Area Conservation & Aspect Ratio Exponential Scaling Law" ;
        dct:description "Proves that pure-shear mediolateral convergence coupled with anteroposterior extension strictly conserves 2D tissue area A_tissue = L_AP * L_ML while quadratically/exponentially amplifying tissue aspect ratio R_CE(t) = R_0 * exp(2 * dot_epsilon_T1 * t) | Variables: L_AP(t), L_ML(t): anteroposterior length and mediolateral width of the intercalating tissue; dot_epsilon_T1: T1 intercalation pure-shear strain rate; A_tissue: conserved 2D tissue area; R_CE: convergent-extension aspect ratio L_AP / L_ML" ;
        dct:source "Zajac, Jones & Glazier (2000) Phys. Rev. Lett. 85:2022-2025; Zajac, Jones & Glazier (2003) J. Theor. Biol. 222(2):247-259 Eqs. 5-8" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2003-zajac-convergent-extension-intercalation.py#L198-L270>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_093_convergent_extension_intercalation.lean#L70-L120> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def tissue_area_2d (L_AP L_ML : Int) : Int :=
  L_AP * L_ML
def aspect_ratio_cross_diff (L_AP_new L_ML_new L_AP_old L_ML_old : Int) : Int :=
  L_AP_new * L_ML_old - L_AP_old * L_ML_new
theorem pure_shear_incompressible_aspect_ratio_amplification
    (L_AP L_ML_new s : Int)
    (hLAP : L_AP > 0) (hLML : L_ML_new > 0) (hScale : s > 1) :
    tissue_area_2d (s * L_AP) L_ML_new = tissue_area_2d L_AP (s * L_ML_new) ∧
    aspect_ratio_cross_diff (s * L_AP) L_ML_new L_AP (s * L_ML_new) > 0"""^^pk:lean4 ;
        skos:notation "dL_AP/dt = +dot_epsilon_T1 * L_AP,  dL_ML/dt = -dot_epsilon_T1 * L_ML;  A_tissue(t) = L_AP(t) * L_ML(t) = A_0;  R_CE(t) = L_AP(t) / L_ML(t) = R_0 * exp(2 * dot_epsilon_T1 * t)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0022-5193(03)00033-X>,
            <https://doi.org/10.1038/35011077>,
            <https://doi.org/10.1038/nature02590>,
            <https://doi.org/10.1103/PhysRevLett.85.2022> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Anisotropic Cell-Cell Adhesion, Polarized Mediolateral Junction Tension & Pure-Shear T1 Intercalation Mechanics" ;
        pk:leanDeclaration "MathOfBiology.Loop_093.aspect_ratio_cross_diff" ;
        pk:leanTheorem "MathOfBiology.Loop_093.pure_shear_incompressible_aspect_ratio_amplification" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/zajac-convergent-extension-intercalation-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Zajac et al. (2003) & Bertet et al. (2004) Five-Regime Convergent Extension Perturbation Hierarchy" ;
        dct:description "Establishes the strict quantitative ordering of convergent-extension aspect ratio and T1 intercalation rate across wild-type polarized adhesion, moderate anisotropy hypomorph, Wnt/PCP Dishevelled (Xdd1/stbm) scrambled polarity mutant, Myosin II (zip/sqh) junction-resolution mutant, and isotropic adhesion negative control | Variables: R_CE: final tissue aspect ratio L_AP / L_ML after 40 min of convergent extension; N_T1 / N_cell: cumulative T1 neighbor-exchange transitions per cell" ;
        dct:source "Zajac, Jones & Glazier (2003) J. Theor. Biol. 222(2):247-259 Figs. 3-7; Bertet, Sulak & Lecuit (2004) Nature 429(6992):667-671 Figs. 1-4; Wallingford et al. (2000) Nature 405:81-85" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2003-zajac-convergent-extension-intercalation.py#L275-L465>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_093_convergent_extension_intercalation.lean#L122-L163> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem zajac_bertet_five_regime_perturbation_hierarchy :
    (rce100_wildtype > rce100_moderate_aniso ∧
     rce100_moderate_aniso > rce100_xdd1_pcp_mutant ∧
     rce100_xdd1_pcp_mutant > rce100_myo2_inhibited ∧
     rce100_myo2_inhibited > rce100_isotropic_null ∧
     rce100_isotropic_null = 100) ∧
    (t1_per_cell100_wildtype > t1_per_cell100_moderate_aniso ∧
     t1_per_cell100_moderate_aniso > t1_per_cell100_xdd1_pcp_mutant ∧
     t1_per_cell100_xdd1_pcp_mutant > t1_per_cell100_myo2_inhibited ∧
     t1_per_cell100_myo2_inhibited > t1_per_cell100_isotropic_null ∧
     t1_per_cell100_isotropic_null = 0)"""^^pk:lean4 ;
        skos:notation "R_WT (3.86) > R_modAniso (2.38) > R_Xdd1_PCP (1.56) > R_MyoII_inhib (1.20) > R_isotropic_null (1.00);  (N_T1/N_cell)_WT (1.45) > modAniso (0.82) > Xdd1_PCP (0.38) > MyoII_inhib (0.12) > isotropic_null (0.00)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0022-5193(03)00033-X>,
            <https://doi.org/10.1038/35011077>,
            <https://doi.org/10.1038/nature02590>,

    <https://w3id.org/delphi/resource/claim/morphoeval-streichan-global-morphogenetic-flow> a pk:Claim ;
        rdfs:label "Streichan et al. (2018), Mayer et al. (2010), Lefebvre et al. (2023) & Brauns et al. (2024) Drosophila global morphogenetic flow, curved-surface active nematic myosin mechanics & cell intercalation (Drosophila melanogaster (whole-embryo cellular blastoderm & germband extension stages 6-8))" ;
        dct:conformsTo <https://w3id.org/delphi/resource/math-law/streichan-global-morphogenetic-flow-1>,
            <https://w3id.org/delphi/resource/math-law/streichan-global-morphogenetic-flow-2>,
            <https://w3id.org/delphi/resource/math-law/streichan-global-morphogenetic-flow-3>,

    <https://w3id.org/delphi/resource/math-law/gorzelak-crinoid-stereom-gyroid-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "TPMS Odd Inversion Symmetry & Exact 50% Bicontinuous Volume Fraction Law at c = 0" ;
        dct:description "Proves that odd inversion symmetry of the TPMS level-set potential partitions the unit cell into congruent solid calcite and pore labyrinths of exact 50% volume fraction at c = 0, with strict monotonic decrease as threshold c increases toward pinch-off | Variables: F(X,Y,Z): nodal TPMS level-set potential; c: level-set isosurface threshold; phi(c): solid calcite volume fraction" ;
        dct:source "Yang et al. (2022) Science 375:647-652; Schoen (1970) NASA TN D-5541" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9987db7d/2020-gorzelak-crinoid-stereom-gyroid.py#L504-L544>,
            <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/lean/loops/Loop_079_crinoid_stereom_gyroid.lean#L72-L131> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def tpms_odd_field (x y z : Int) : Int := x + y + z
def sym_coords : List Int := [-3, -1, 1, 3]
theorem tpms_odd_inversion_symmetry_and_half_volume_fraction_at_zero :
    tpms_odd_field (-3) (-1) 1 + tpms_odd_field 3 1 (-1) = 0 ∧
    2 * solid_voxel_count 0 = total_voxel_count ∧
    solid_voxel_count (-4) > solid_voxel_count 0 ∧
    solid_voxel_count 0 > solid_voxel_count 4 := by decide
"""^^pk:lean4 ;
        skos:notation "F(-X,-Y,-Z) = -F(X,Y,Z)  =>  phi(c = 0) = Vol({F > 0}) / Vol(Omega) = 1/2 = 0.5000,   d(phi)/dc < 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0040-1951(96)00273-9>,
            <https://doi.org/10.1017/CBO9781139878326>,
            <https://doi.org/10.1063/1.1665587>,
            <https://doi.org/10.1073/pnas.0806604105>,
            <https://doi.org/10.1073/pnas.1312833110>,
            <https://doi.org/10.1080/14786445108561060>,
            <https://doi.org/10.1098/rspb.1997.0066>,
            <https://doi.org/10.1126/science.166.3909.1147>,
            <https://doi.org/10.1126/science.abm8666>,
            <https://doi.org/10.1130/0016-7606(1954)65%5B883:EDOCC%5D2.0.CO;2>,
            <https://doi.org/10.2108/zsj.19.253> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Triply Periodic Minimal Surface (TPMS) Nodal Level-Set Geometry (Schwarz Diamond D, Schoen Gyroid G, Schwarz Primitive P), Minimal Surface Zero Mean Curvature (H = 0, K = -kappa_1^2 <= 0), Gibson-Ashby Cellular Solid Scaling, Plane-Strain Crystal-Plasticity FEM of e-Twin Arrest (Pass 3) & Stochastic Syncytial ACC Templating Kinetics (Pass 3)" ;
        pk:leanDeclaration "MathOfBiology.Loop_079.solid_voxel_count" ;
        pk:leanTheorem "MathOfBiology.Loop_079.tpms_odd_inversion_symmetry_and_half_volume_fraction_at_zero" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/gorzelak-crinoid-stereom-gyroid-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Maxwell Nodal Connectivity Valence (Z=4 Diamond Tetrahedral cos theta = -1/3 vs Z=3 Gyroid vs Z=6 Primitive) & Genus-3 Euler Characteristic Law" ;
        dct:description "Governs the 4-valent tetrahedral [111] strut geometry (109.4712 deg) of Protoreaster nodosus Diamond stereom vs 3-valent Gyroid (120 deg) and 6-valent Primitive (90 deg) stereom and their shared genus-3 unit-cell topology (chi = -4) | Variables: Z: skeletal strut coordination number at each TPMS vertex node; v_k: tetrahedral [111] strut vectors of Schwarz Diamond stereom; g = 3: topological genus per fundamental cubic unit cell; chi = -4: Euler characteristic" ;
        dct:source "Yang et al. (2022) Science 375:647-652; Donnay & Pawson (1969) Science 166:1147-1150" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9987db7d/2020-gorzelak-crinoid-stereom-gyroid.py#L210-L286>,
            <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/lean/loops/Loop_079_crinoid_stereom_gyroid.lean#L137-L221> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def diamond_strut : Nat → Vec3Int
  | 1 => { x := 1, y := 1, z := 1 } | 2 => { x := 1, y := -1, z := -1 }
  | 3 => { x := -1, y := 1, z := -1 } | 4 => { x := -1, y := -1, z := 1 } | _ => vec3_zero
theorem tpms_nodal_connectivity_valence_and_diamond_tetrahedral_angle :
    tpms_nodal_valence 1 < tpms_nodal_valence 2 ∧
    diamond_strut_sum = vec3_zero ∧
    3 * vec3_dot (diamond_strut 1) (diamond_strut 2) + vec3_norm_sq (diamond_strut 1) = 0 ∧
    tpms_unit_cell_euler_char 3 = -4 := by decide
"""^^pk:lean4 ;
        skos:notation "Z_G = 3 (120 deg) < Z_D = 4 (arccos(-1/3) = 109.4712 deg, sum_{k=1}^4 v_k = 0) < Z_P = 6 (90 deg),   chi_cell = 2 - 2*g = -4 (g = 3)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0040-1951(96)00273-9>,
            <https://doi.org/10.1017/CBO9781139878326>,
            <https://doi.org/10.1063/1.1665587>,
            <https://doi.org/10.1073/pnas.0806604105>,
            <https://doi.org/10.1073/pnas.1312833110>,
            <https://doi.org/10.1080/14786445108561060>,
            <https://doi.org/10.1098/rspb.1997.0066>,
            <https://doi.org/10.1126/science.166.3909.1147>,
            <https://doi.org/10.1126/science.abm8666>,
            <https://doi.org/10.1130/0016-7606(1954)65%5B883:EDOCC%5D2.0.CO;2>,
            <https://doi.org/10.2108/zsj.19.253> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Triply Periodic Minimal Surface (TPMS) Nodal Level-Set Geometry (Schwarz Diamond D, Schoen Gyroid G, Schwarz Primitive P), Minimal Surface Zero Mean Curvature (H = 0, K = -kappa_1^2 <= 0), Gibson-Ashby Cellular Solid Scaling, Plane-Strain Crystal-Plasticity FEM of e-Twin Arrest (Pass 3) & Stochastic Syncytial ACC Templating Kinetics (Pass 3)" ;
        pk:leanDeclaration "MathOfBiology.Loop_079.diamond_strut_sum" ;
        pk:leanTheorem "MathOfBiology.Loop_079.tpms_nodal_connectivity_valence_and_diamond_tetrahedral_angle" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/gorzelak-crinoid-stereom-gyroid-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Gibson-Ashby Cellular Solid Modulus Scaling: Stretching-Dominated TPMS (phi^1) vs Bending-Dominated Foam (phi^2)" ;
        dct:description "Demonstrates why stretching-dominated biogenic TPMS stereom (phi^1) achieves more than double the specific stiffness of bending-dominated disordered labyrinthic foam (phi^2) at 50% porosity | Variables: phi in (0, 1): solid calcite volume fraction; E*/E_s: relative Young's modulus normalized by monolithic calcite modulus E_s = 76 GPa; C_stretch, C_bend: Gibson-Ashby geometric constants" ;
        dct:source "Gibson & Ashby (1997) Cellular Solids; Yang et al. (2022) Science 375:647-652" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9987db7d/2020-gorzelak-crinoid-stereom-gyroid.py#L978-L1059>,
            <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/lean/loops/Loop_079_crinoid_stereom_gyroid.lean#L227-L263> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def gibson_ashby_stretching_scaled (c_coeff phi_pct : Nat) : Nat := c_coeff * 100 * phi_pct
def gibson_ashby_bending_scaled (c_coeff phi_pct : Nat) : Nat := c_coeff * phi_pct * phi_pct
theorem gibson_ashby_stretching_vs_bending_cellular_modulus_scaling :
    gibson_ashby_stretching_scaled 38 50 > gibson_ashby_bending_scaled 38 50 ∧
    gibson_ashby_stretching_scaled 38 50 = 2 * gibson_ashby_bending_scaled 38 50 := by decide
"""^^pk:lean4 ;
        skos:notation "E*_TPMS / E_s = C_stretch * phi^1  >  E*_foam / E_s = C_bend * phi^2  for all phi in (0, 1);   at phi = 0.50, E*_TPMS / E*_foam = 2.0 (for C_stretch = C_bend)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0040-1951(96)00273-9>,
            <https://doi.org/10.1017/CBO9781139878326>,
            <https://doi.org/10.1063/1.1665587>,
            <https://doi.org/10.1073/pnas.0806604105>,
            <https://doi.org/10.1073/pnas.1312833110>,
            <https://doi.org/10.1080/14786445108561060>,
            <https://doi.org/10.1098/rspb.1997.0066>,
            <https://doi.org/10.1126/science.166.3909.1147>,
            <https://doi.org/10.1126/science.abm8666>,
            <https://doi.org/10.1130/0016-7606(1954)65%5B883:EDOCC%5D2.0.CO;2>,
            <https://doi.org/10.2108/zsj.19.253> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Triply Periodic Minimal Surface (TPMS) Nodal Level-Set Geometry (Schwarz Diamond D, Schoen Gyroid G, Schwarz Primitive P), Minimal Surface Zero Mean Curvature (H = 0, K = -kappa_1^2 <= 0), Gibson-Ashby Cellular Solid Scaling, Plane-Strain Crystal-Plasticity FEM of e-Twin Arrest (Pass 3) & Stochastic Syncytial ACC Templating Kinetics (Pass 3)" ;
        pk:leanDeclaration "MathOfBiology.Loop_079.gibson_ashby_stretching_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_079.gibson_ashby_stretching_vs_bending_cellular_modulus_scaling" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/gorzelak-crinoid-stereom-gyroid-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Twin-Lamella Arrest at Strut Free Surfaces & Eshelby-Frank-Nabarro Dislocation Pile-Up Bounded by Glide Length (Pass 3 nanoindentation crystal-plasticity FEM)" ;
        dct:description "Reduced crystal-plasticity model of Yang et al. (2022) nanoindentation: twin bands nucleated under a flat punch in the [111] Diamond lattice section are arrested at strut-pore free surfaces (lamella <= strut chord, twinned area far below the phi-scaled null) whereas the monolithic single crystal develops an extended twin zone; the pile-up scaling bounds dislocation head stress by the strut length | Variables: u: nodal displacements of the plane-strain Q4 mesh; eps_p = sum_v gamma_v sym(s_v (x) n_v): twin plastic strain; tau_twin: effective e-twin CRSS; s_twin = 0.694: calcite e-twin shear; theta = 26.25 deg: e{01-18} pole to c-axis; L: glide/strut length (a_0 sqrt(3)/4 in 3D, a_0/sqrt(6) projected on (111)); mu = E/(2(1+nu)); b = 0.81 nm Burgers vector" ;
        dct:source "Yang et al. (2022) Science 375:647-652; Eshelby, Frank & Nabarro (1951) Phil Mag 42:351-364; Turner, Griggs & Heard (1954) GSA Bull 65:883-934; De Bresser & Spiers (1997) Tectonophysics 272:1-23" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9987db7d/2020-gorzelak-crinoid-stereom-gyroid.py#L609-L974>,
            <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/lean/loops/Loop_079_crinoid_stereom_gyroid.lean#L255-L315> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def twin_lamella_length (free_run strut_chord : Nat) : Nat := min free_run strut_chord
def pileup_count (kappa glide_length tau : Nat) : Nat := kappa * glide_length * tau
def pileup_head_stress (kappa glide_length tau : Nat) : Nat := pileup_count kappa glide_length tau * tau
def clamped_twin_shear (gamma s_twin : Nat) : Nat := min gamma s_twin
theorem twin_lamella_arrest_and_dislocation_pileup_bounded_by_strut_length :
    (∀ f L : Nat, twin_lamella_length f L ≤ L) ∧
    (∀ κ τ L₁ L₂ : Nat, L₁ ≤ L₂ → pileup_head_stress κ L₁ τ ≤ pileup_head_stress κ L₂ τ) ∧
    (∀ γ s : Nat, clamped_twin_shear γ s ≤ s) ∧
    pileup_count 1 6 10 < pileup_count 1 1000 10 := by ...
"""^^pk:lean4 ;
        skos:notation "K u = f_p(eps_p) - K_fp u_p,  sigma = D (eps - eps_p),  |tau_rss^(v)| = |sigma : sym(s^(v) (x) n^(v))| <= tau_twin,  |gamma| <= s_twin ;  L_lamella = min(L_free, L_chord) <= a_0/sqrt(6) ;  n = pi (1 - nu) L tau / (mu b),  sigma_head = n tau = pi (1 - nu) L tau^2 / (mu b)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0040-1951(96)00273-9>,
            <https://doi.org/10.1017/CBO9781139878326>,
            <https://doi.org/10.1063/1.1665587>,
            <https://doi.org/10.1073/pnas.0806604105>,
            <https://doi.org/10.1073/pnas.1312833110>,
            <https://doi.org/10.1080/14786445108561060>,
            <https://doi.org/10.1098/rspb.1997.0066>,
            <https://doi.org/10.1126/science.166.3909.1147>,
            <https://doi.org/10.1126/science.abm8666>,
            <https://doi.org/10.1130/0016-7606(1954)65%5B883:EDOCC%5D2.0.CO;2>,
            <https://doi.org/10.2108/zsj.19.253> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Triply Periodic Minimal Surface (TPMS) Nodal Level-Set Geometry (Schwarz Diamond D, Schoen Gyroid G, Schwarz Primitive P), Minimal Surface Zero Mean Curvature (H = 0, K = -kappa_1^2 <= 0), Gibson-Ashby Cellular Solid Scaling, Plane-Strain Crystal-Plasticity FEM of e-Twin Arrest (Pass 3) & Stochastic Syncytial ACC Templating Kinetics (Pass 3)" ;
        pk:leanDeclaration "MathOfBiology.Loop_079.pileup_head_stress" ;
        pk:leanTheorem "MathOfBiology.Loop_079.twin_lamella_arrest_and_dislocation_pileup_bounded_by_strut_length" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/gorzelak-crinoid-stereom-gyroid-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "Syncytial Membrane Templating of ACC Precursor Vesicles, Secondary-Nucleation Single-Crystallinity & Monotone ACC Depletion (Pass 3 larval spiculogenesis)" ;
        dct:description "Models the intracellular syncytial templating of ~1 um ACC vesicles into the stereom shape and the Politi et al. (2008) secondary-nucleation ACC -> calcite transformation that keeps the spicule a single crystal (Donnay & Pawson 1969); templating and nucleation ablations quantify fidelity (IoU 0.75 vs 0.42 untemplated) and polycrystallinity (2 vs 239 domains) | Variables: A: amorphous calcium carbonate field; C: calcite field; T: syncytial membrane template (the [111] Diamond skeletal section); p_in, p_out: vesicle exocytosis acceptance inside/outside the cavity; k_2: secondary-nucleation conversion rate; k_1: primary nucleation probability; n_primary: number of de novo nucleation events" ;
        dct:source "Politi et al. (2008) PNAS 105:17362-17366; Beniash et al. (1997) Proc R Soc B 264:461-465; Vidavsky et al. (2014) PNAS 111:39-44; Donnay & Pawson (1969) Science 166:1147-1150" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9987db7d/2020-gorzelak-crinoid-stereom-gyroid.py#L1155-L1314>,
            <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/lean/loops/Loop_079_crinoid_stereom_gyroid.lean#L317-L379> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def crystal_domain_count (n_primary : Nat) : Nat := 1 + n_primary
def vesicle_accept_weight (inside : Bool) (p_in p_out : Nat) : Nat := if inside then p_in else p_out
def acc_step (a : Nat) : Nat := a - a / 4
def acc_after : Nat → Nat → Nat | 0, a => a | t + 1, a => acc_after t (acc_step a)
theorem syncytial_secondary_nucleation_single_domain_and_acc_depletion :
    crystal_domain_count 0 = 1 ∧
    (∀ a b : Nat, a ≤ b → crystal_domain_count a ≤ crystal_domain_count b) ∧
    (∀ p_in p_out : Nat, p_out ≤ p_in → vesicle_accept_weight false p_in p_out ≤ vesicle_accept_weight true p_in p_out) ∧
    (∀ a : Nat, acc_step a ≤ a) ∧
    acc_after 6 1000 < acc_after 5 1000 := by ...
"""^^pk:lean4 ;
        skos:notation "P(accept | x) = p_in if x in template else p_out ;  A += vesicle disc (capacity 1 - C) ;  dC = k_2 A on ACC within reach of calcite (domain inherited) ;  primary nucleation w.p. k_1 per ACC-rich pixel opens a new domain ;  domain_count = 1 + n_primary ;  a_{t+1} = a_t - a_t/4 <= a_t ;  IoU = |M AND T| / |M OR T|" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0040-1951(96)00273-9>,
            <https://doi.org/10.1017/CBO9781139878326>,
            <https://doi.org/10.1063/1.1665587>,
            <https://doi.org/10.1073/pnas.0806604105>,
            <https://doi.org/10.1073/pnas.1312833110>,
            <https://doi.org/10.1080/14786445108561060>,
            <https://doi.org/10.1098/rspb.1997.0066>,
            <https://doi.org/10.1126/science.166.3909.1147>,
            <https://doi.org/10.1126/science.abm8666>,
            <https://doi.org/10.1130/0016-7606(1954)65%5B883:EDOCC%5D2.0.CO;2>,
            <https://doi.org/10.2108/zsj.19.253> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Triply Periodic Minimal Surface (TPMS) Nodal Level-Set Geometry (Schwarz Diamond D, Schoen Gyroid G, Schwarz Primitive P), Minimal Surface Zero Mean Curvature (H = 0, K = -kappa_1^2 <= 0), Gibson-Ashby Cellular Solid Scaling, Plane-Strain Crystal-Plasticity FEM of e-Twin Arrest (Pass 3) & Stochastic Syncytial ACC Templating Kinetics (Pass 3)" ;
        pk:leanDeclaration "MathOfBiology.Loop_079.crystal_domain_count" ;
        pk:leanTheorem "MathOfBiology.Loop_079.syncytial_secondary_nucleation_single_domain_and_acc_depletion" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/graner-cellular-potts-cell-sorting-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Graner & Glazier (1992) Cellular Potts Surface Tension Relations & Equal-Adhesion Null Identity" ;
        dct:description "Maps microscopic lattice bond energies J(τ, τ') to macroscopic tissue interfacial tensions and proves that equal adhesion zeroes the sorting force | Variables: J_{LL}, J_{DD}, J_{LD}: homotypic and heterotypic Potts bond energies; J_{LM}, J_{DM}: cell-medium bond energies; γ_{LD}: heterotypic surface tension" ;
        dct:source "Graner & Glazier (1992) Phys. Rev. Lett. 69(13):2013-2016 Eqs. (2)-(3); Glazier & Graner (1993) Phys. Rev. E 47(3):2128-2154 Eqs. (3)-(5)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L109-L154>,
            <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/lean/loops/Loop_042_cellular_potts_cell_sorting.lean#L17-L42> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def two_gamma_LD (J_LL J_DD J_LD : Int) : Int :=
  2 * J_LD - (J_LL + J_DD)
theorem cpm_equal_adhesion_null_tension (J J_M : Int) :
    two_gamma_LD J J J = 0 ∧ two_spreading_diff J J J_M J_M = 0"""^^pk:lean4 ;
        skos:notation "γ_{LD} = J_{LD} - (J_{LL} + J_{DD})/2,  γ_{αM} = J_{αM} - J_{αα}/2;  J_{LL} = J_{DD} = J_{LD} ⇒ γ_{LD} = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0378-4371(03)00574-0>,
            <https://doi.org/10.1016/j.cub.2007.11.049>,
            <https://doi.org/10.1038/newbio239098a0>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Glazier-Graner-Hogeweg Extended Large-Q Cellular Potts Model (CPM)" ;
        pk:leanDeclaration "MathOfBiology.Loop_042.two_gamma_LD" ;
        pk:leanTheorem "MathOfBiology.Loop_042.cpm_equal_adhesion_null_tension" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/graner-cellular-potts-cell-sorting-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) Four Canonical Phase Regimes (Complete Engulfment, Partial Lens, Checkerboard, Dissociation)" ;
        dct:description "Classifies Cellular Potts cell aggregates into concentric engulfment sorting, partial lens doublets, checkerboard mixing, and cell dissociation | Variables: γ_{LD}: light-dark interfacial tension; γ_{LM}, γ_{DM}: light-medium and dark-medium surface tensions" ;
        dct:source "Graner & Glazier (1992) Phys. Rev. Lett. 69(13):2013-2016 p. 2014; Glazier & Graner (1993) Phys. Rev. E 47(3):2128-2154 Table I" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L362-L627>,
            <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/lean/loops/Loop_042_cellular_potts_cell_sorting.lean#L44-L68> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem graner_glazier_four_phase_regimes :
    two_gamma_LD 14 2 11 = 6 ∧
    two_spreading_diff 14 2 16 16 = 12 ∧
    (0 < two_gamma_LD 14 2 11 ∧ two_gamma_LD 14 2 11 < two_spreading_diff 14 2 16 16) ∧
    two_gamma_LD 14 2 16 > two_spreading_diff 14 2 16 16 ∧
    two_gamma_LD 14 14 4 < 0 ∧
    two_gamma_M 14 2 < 0"""^^pk:lean4 ;
        skos:notation "Complete engulfment: 0 < γ_{LD} < γ_{DM} - γ_{LM};  Partial lens: γ_{LD} > |γ_{LM} - γ_{DM}| > 0;  Checkerboard: γ_{LD} < 0;  Dissociation: γ_{αM} < 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0378-4371(03)00574-0>,
            <https://doi.org/10.1016/j.cub.2007.11.049>,
            <https://doi.org/10.1038/newbio239098a0>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Glazier-Graner-Hogeweg Extended Large-Q Cellular Potts Model (CPM)" ;
        pk:leanDeclaration "MathOfBiology.Loop_042.two_spreading_diff" ;
        pk:leanTheorem "MathOfBiology.Loop_042.graner_glazier_four_phase_regimes" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/graner-cellular-potts-cell-sorting-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Cellular Potts Hamiltonian Quadratic Volume Elasticity & Single-Spin Copy Restoring Barrier" ;
        dct:description "Maintains finite deformable cell volumes under Metropolis boundary copy updates and establishes the single-pixel lattice pinning barrier ±λ at v = V_t | Variables: H: Cellular Potts Hamiltonian; σ_i: cell spin ID at site i; v_σ: cell volume (area in 2D); V_t: target volume; λ: volume elasticity Lagrange multiplier" ;
        dct:source "Graner & Glazier (1992) Phys. Rev. Lett. 69(13):2013-2016 Eq. (1); Glazier & Graner (1993) Phys. Rev. E 47(3):2128-2154 Eq. (1) & Section III.B" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L502-L588>,
            <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/lean/loops/Loop_042_cellular_potts_cell_sorting.lean#L70-L99> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cpm_volume_energy (lam v Vt : Int) : Int :=
  lam * (v - Vt) * (v - Vt)
theorem cpm_volume_elasticity_restoring_identity (lam Vt : Int) :
    cpm_volume_energy lam Vt Vt = 0 ∧
    cpm_delta_vol_gain lam Vt Vt = lam ∧
    cpm_delta_vol_loss lam Vt Vt = lam"""^^pk:lean4 ;
        skos:notation "H = ∑_{⟨i,j⟩} J(τ(σ_i), τ(σ_j))(1 - δ_{σ_i,σ_j}) + λ ∑_{σ>0} (v_σ - V_t)^2;  ΔE_{vol}^±(V_t) = +λ" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0378-4371(03)00574-0>,
            <https://doi.org/10.1016/j.cub.2007.11.049>,
            <https://doi.org/10.1038/newbio239098a0>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Glazier-Graner-Hogeweg Extended Large-Q Cellular Potts Model (CPM)" ;
        pk:leanDeclaration "MathOfBiology.Loop_042.cpm_volume_energy" ;
        pk:leanTheorem "MathOfBiology.Loop_042.cpm_volume_elasticity_restoring_identity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/graner-cellular-potts-cell-sorting-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "8-Neighbour Bond-Count Perimeter of a Square Cellular Potts Cell & Compact-Square Target Perimeter P_t" ;
        dct:description "Fixes the default target perimeter of the Ouchi et al. (2003) cortical tension term so that lambda_P > 0 leaves the compact 4 × 4 initial cell energetically neutral; the P_t sweep {32, 38, 44, 50, 56} spans the 3 × 3 to 5 × 5 squares | Variables: s: side of the square lattice block; p: 8-neighbour bond-count perimeter (number of (site ∈ σ, 8-neighbour ∉ σ) pairs); P_t: target perimeter" ;
        dct:source "Ouchi NB, Glazier JA, Rieu JP, Upadhyaya A, Sawada Y (2003) Physica A 329(3-4):451-458 Eq. (2) (perimeter constraint); perimeter counting convention from Glazier & Graner (1993) Phys. Rev. E 47:2128 Section II (fourth-nearest-neighbour / 8-site interaction range)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L164-L196>,
            <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/lean/loops/Loop_042_cellular_potts_cell_sorting.lean#L107-L125> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def square_block_perimeter_8nbr (s : Int) : Int :=
  12 * s - 4
theorem cpm_square_block_target_perimeter :
    square_block_perimeter_8nbr 3 = 32 ∧
    square_block_perimeter_8nbr 4 = 44 ∧
    square_block_perimeter_8nbr 5 = 56 ∧
    (∀ s : Int, square_block_perimeter_8nbr (s + 1) - square_block_perimeter_8nbr s = 12)"""^^pk:lean4 ;
        skos:notation "p(s × s) = 4·5 + 4(s − 2)·3 = 12 s − 4;  P_t(V_t = 16, 4 × 4) = 44;  p(s+1) − p(s) = 12" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0378-4371(03)00574-0>,
            <https://doi.org/10.1016/j.cub.2007.11.049>,
            <https://doi.org/10.1038/newbio239098a0>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Glazier-Graner-Hogeweg Extended Large-Q Cellular Potts Model (CPM)" ;
        pk:leanDeclaration "MathOfBiology.Loop_042.square_block_perimeter_8nbr" ;
        pk:leanTheorem "MathOfBiology.Loop_042.cpm_square_block_target_perimeter" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/graner-cellular-potts-cell-sorting-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Ouchi et al. (2003) Perimeter / Cortical Tension Elasticity Term & Single-Copy Perimeter Change Parity" ;
        dct:description "Adds explicit cortical tension to the Graner & Glazier (1992) Hamiltonian; the parity identities are the incremental perimeter bookkeeping used in every Metropolis copy attempt (self-test check 9 verifies zero drift against a full recount), and the 64 λ_P isolated-pixel cost is the energetic barrier against cell fragmentation | Variables: λ_P: cortical tension (perimeter elasticity) multiplier; p_σ: cell perimeter in 8-neighbour bonds; P_t: target perimeter; n_same: number of the copied site's 8 neighbours belonging to the leaving/joining cell; k: perimeter change" ;
        dct:source "Ouchi NB, Glazier JA, Rieu JP, Upadhyaya A, Sawada Y (2003) Physica A 329(3-4):451-458 Eq. (2); Farhadifar R et al. (2007) Curr. Biol. 17(24):2095-2104 Eq. (1) (vertex-model perimeter term)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L560-L588>,
            <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/lean/loops/Loop_042_cellular_potts_cell_sorting.lean#L126-L178> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cpm_perimeter_energy (lamP p Pt : Int) : Int :=
  lamP * ((p - Pt) * (p - Pt))
def cpm_copy_perimeter_change_old (n : Int) : Int := 2 * n - 8
theorem cpm_perimeter_elasticity_restoring_identity (lamP Pt : Int) :
    cpm_perimeter_energy lamP Pt Pt = 0 ∧
    (∀ n : Int, 0 ≤ n → n ≤ 8 →
      (∃ m : Int, cpm_copy_perimeter_change_old n = 2 * m) ∧
      cpm_copy_perimeter_change_old n = - cpm_copy_perimeter_change_new n ∧
      -8 ≤ cpm_copy_perimeter_change_old n ∧ cpm_copy_perimeter_change_old n ≤ 8) ∧
    cpm_delta_perim lamP Pt Pt 2 = 4 * lamP ∧
    cpm_delta_perim lamP Pt Pt (-2) = 4 * lamP ∧
    cpm_delta_perim lamP Pt Pt 8 = 64 * lamP"""^^pk:lean4 ;
        skos:notation "H_P = λ_P ∑_{σ>0} (p_σ − P_t)^2;  ΔE_P(p, k) = λ_P k (2 (p − P_t) + k);  Δp_old = 2 n_same − 8, Δp_new = 8 − 2 n_same (even, |Δp| ≤ 8);  ΔE_P(P_t, ±2) = 4 λ_P, ΔE_P(P_t, 8) = 64 λ_P" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0378-4371(03)00574-0>,
            <https://doi.org/10.1016/j.cub.2007.11.049>,
            <https://doi.org/10.1038/newbio239098a0>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Glazier-Graner-Hogeweg Extended Large-Q Cellular Potts Model (CPM)" ;
        pk:leanDeclaration "MathOfBiology.Loop_042.cpm_perimeter_energy" ;
        pk:leanTheorem "MathOfBiology.Loop_042.cpm_perimeter_elasticity_restoring_identity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/graner-cellular-potts-cell-sorting-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "Cortical Tension Monotonicity Above the Target Perimeter (Effective Line Tension Against Ragged Boundaries)" ;
        dct:description "Proves the perimeter term is an effective cortical line tension: every perimeter increase of an already-over-target cell is energetically non-favourable, which is why RMS(p_σ − P_t) decreases monotonically with λ_P in the C2 sweep (14.05 → 1.06 bonds) and fragmentation drops (0.217 → 0.083) | Variables: λ_P: cortical tension multiplier; p: current cell perimeter; P_t: target perimeter; k: perimeter increase" ;
        dct:source "Ouchi NB, Glazier JA, Rieu JP, Upadhyaya A, Sawada Y (2003) Physica A 329(3-4):451-458 Section 2; Glazier & Graner (1993) Phys. Rev. E 47:2128 Section III.B (thermal boundary roughening the term counteracts)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L702-L784>,
            <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/lean/loops/Loop_042_cellular_potts_cell_sorting.lean#L180-L193> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem cpm_cortical_tension_monotone_above_target
    (lamP p Pt k : Int) (hlam : 0 ≤ lamP) (hp : Pt ≤ p) (hk : 0 ≤ k) :
    cpm_perimeter_energy lamP p Pt ≤ cpm_perimeter_energy lamP (p + k) Pt"""^^pk:lean4 ;
        skos:notation "λ_P ≥ 0 ∧ p ≥ P_t ∧ k ≥ 0 ⇒ E_P(p, P_t) ≤ E_P(p + k, P_t)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0378-4371(03)00574-0>,
            <https://doi.org/10.1016/j.cub.2007.11.049>,
            <https://doi.org/10.1038/newbio239098a0>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Glazier-Graner-Hogeweg Extended Large-Q Cellular Potts Model (CPM)" ;
        pk:leanDeclaration "MathOfBiology.Loop_042.cpm_delta_perim" ;
        pk:leanTheorem "MathOfBiology.Loop_042.cpm_cortical_tension_monotone_above_target" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/grieneisen-root-auxin-reflux-fountain-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Grieneisen et al. (2007) Vascular-Epidermal Counter-Current Reflux Conservation Law" ;
        dct:description "Proves the pairwise cancellation of internal transfer terms and hence exact mass conservation of the closed reflux lattice; the script checks it numerically as zero column sums (max |Σ| / max |entry| = 0) of the assembled sparse operator plus a steady-state flux budget on the open operator | Variables: A_i: cellular auxin concentration; V_i = l_i w: cell area; c_ij: passive (D·face/dist) plus PIN-permeability (p_ij·face) transport coefficient from cell i to j; σ, μ: biosynthesis and turnover; J_in: shoot vascular influx" ;
        dct:source "Grieneisen, Xu, Marée, Hogeweg & Scheres (2007) Nature 449(7165):1008-1013 Methods & Fig. 3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L178-L325>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_038_root_auxin_reflux_fountain.lean#L31-L53> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def stele_reflux_rhs (dJ_s k_lat A_e mu A_s : Int) : Int :=
  -dJ_s + k_lat * A_e - mu * A_s
def epidermis_reflux_rhs (dJ_e k_lat A_e mu : Int) : Int :=
  -dJ_e - k_lat * A_e - mu * A_e
theorem grieneisen_2007_vascular_epidermal_reflux_conservation
    (dJ_s dJ_e k_lat A_s A_e mu J_tip : Int) :
    stele_reflux_rhs dJ_s k_lat A_e mu A_s + epidermis_reflux_rhs dJ_e k_lat A_e mu =
      -(dJ_s + dJ_e) - mu * (A_s + A_e) ∧
    stele_reflux_rhs dJ_s k_lat A_e 0 A_s + epidermis_reflux_rhs (-dJ_s) k_lat A_e 0 = 0 ∧
    cross_section_net_flux J_tip (-J_tip) = 0
"""^^pk:lean4 ;
        skos:notation "d(V_i A_i)/dt = Σ_j [c_ji A_j − c_ij A_i] + σ V_i − μ V_i A_i;  with μ = σ = J_in = escape = 0 every column of the operator sums to zero (Σ_i d(V_i A_i)/dt = 0, J_stele + J_epidermis = 0 across the closed tip)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(00)81535-4>,
            <https://doi.org/10.1016/j.cub.2007.02.047>,
            <https://doi.org/10.1038/415806a>,
            <https://doi.org/10.1038/nature03184>,
            <https://doi.org/10.1038/nature06215>,
            <https://doi.org/10.1038/nature13663>,
            <https://doi.org/10.1073/pnas.1013145107>,
            <https://doi.org/10.1073/pnas.1201498109>,
            <https://doi.org/10.1104/pp.116.4.1515>,
            <https://doi.org/10.1126/science.1121790> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Solved 2D Cellular PIN1/PIN2/PIN3 Permeability Transport Lattice (Vascular–Epidermal Reverse-Fountain Reflux Capacitor) with Finite-Volume PLETHORA Zonation, Explicit Mitotic Division on a Growing Lattice, and Gravistimulated PIN3/PIN7 Statocyte Efflux Asymmetry" ;
        pk:leanDeclaration "MathOfBiology.Loop_038.stele_reflux_rhs" ;
        pk:leanTheorem "MathOfBiology.Loop_038.grieneisen_2007_vascular_epidermal_reflux_conservation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/grieneisen-root-auxin-reflux-fountain-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Grieneisen et al. (2007) Quiescent Center (QC) Reflux Capacitor Amplification vs NPA / Lateral-PIN Ablation Collapse Law" ;
        dct:description "Qualitative Lean model of the capacitor; the script now produces the amplification, its position and its collapse by solving the operator (Pass 2 hard-coded them) | Variables: A_QC: emergent stele auxin maximum at the QC/columella boundary; A_shoot: top-row stele concentration; v_s, v_e, k_lat, k_col: PIN permeabilities (µm/s)" ;
        dct:source "Grieneisen, Xu, Marée, Hogeweg & Scheres (2007) Nature 449(7165):1008-1013 Figs. 1-3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L375-L537>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_038_root_auxin_reflux_fountain.lean#L72-L95> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def qc_two_stage_capacitor (A_shoot v_s v_e k_lat : Int) : Int :=
  A_shoot * (1 + v_s * v_e * k_lat) * (1 + v_s * v_e * k_lat)
theorem grieneisen_2007_qc_capacitor_amplification_vs_collapse
    (A_shoot v_s v_e k_lat : Int)
    (hA : A_shoot > 0) (hvs : v_s > 0) (hve : v_e > 0) (hklat : k_lat > 0) :
    qc_two_stage_capacitor A_shoot v_s v_e k_lat > A_shoot ∧
    qc_two_stage_capacitor A_shoot v_s v_e 0 = A_shoot ∧
    qc_two_stage_capacitor A_shoot 0 0 k_lat = A_shoot
"""^^pk:lean4 ;
        skos:notation "A_QC / A_shoot ≫ 1 emerges from v_s, v_e, k_lat, k_col > 0 (solved: 113.6× at z = 52.5 µm);  k_lat = 0 → A_QC drops to 0.18 × WT;  NPA (all p → 3-5 %) → A_QC / A_shoot = 1.10" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(00)81535-4>,
            <https://doi.org/10.1016/j.cub.2007.02.047>,
            <https://doi.org/10.1038/415806a>,
            <https://doi.org/10.1038/nature03184>,
            <https://doi.org/10.1038/nature06215>,
            <https://doi.org/10.1038/nature13663>,
            <https://doi.org/10.1073/pnas.1013145107>,
            <https://doi.org/10.1073/pnas.1201498109>,
            <https://doi.org/10.1104/pp.116.4.1515>,
            <https://doi.org/10.1126/science.1121790> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Solved 2D Cellular PIN1/PIN2/PIN3 Permeability Transport Lattice (Vascular–Epidermal Reverse-Fountain Reflux Capacitor) with Finite-Volume PLETHORA Zonation, Explicit Mitotic Division on a Growing Lattice, and Gravistimulated PIN3/PIN7 Statocyte Efflux Asymmetry" ;
        pk:leanDeclaration "MathOfBiology.Loop_038.qc_two_stage_capacitor" ;
        pk:leanTheorem "MathOfBiology.Loop_038.grieneisen_2007_qc_capacitor_amplification_vs_collapse" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/grieneisen-root-auxin-reflux-fountain-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Mähönen et al. (2014) PLETHORA (PLT1/2) Dosage Gradient & Meristem Boundary Monotonicity Law" ;
        dct:description "Positions the meristematic and elongation zone boundaries from the solved auxin field; emergent WT z_MZ = 240 µm, decapitated 225, pin2 120, k_lat=0 45, QC-ablation 255 (NPA: PLT saturates everywhere — disclosed disagreement) | Variables: P_k: PLT dosage of row k; α: synthesis rate (1/h); γ: turnover (1/h); r_k: relative growth (dilution) rate; D_plt: cell-to-cell movement (µm²/h); Θ_MZ, Θ_EZ: zone thresholds" ;
        dct:source "Mähönen et al. (2014) Nature 515(7525):125-129 Figs. 1-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L330-L372>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_038_root_auxin_reflux_fountain.lean#L110-L131> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def plethora_axial_dosage (alpha_plt G_reflux beta_decay z : Int) : Int :=
  alpha_plt * G_reflux - beta_decay * z
def meristem_boundary_coord (alpha_plt G_reflux Theta_MZ : Int) : Int :=
  alpha_plt * G_reflux - Theta_MZ
theorem mahonen_2014_plethora_meristem_boundary_monotonicity
    (alpha_plt G1 G2 beta_decay z Theta_MZ : Int)
    (h_alpha : alpha_plt > 0) (h_gain : G2 > G1) :
    plethora_axial_dosage alpha_plt G2 beta_decay z >
      plethora_axial_dosage alpha_plt G1 beta_decay z ∧
    meristem_boundary_coord alpha_plt G2 Theta_MZ >
      meristem_boundary_coord alpha_plt G1 Theta_MZ
"""^^pk:lean4 ;
        skos:notation "l_k dP_k/dt = α H(A_k) l_k − (γ + r_k) l_k P_k + F_{k+1/2} − F_{k−1/2},  H(A) = A²/(K² + A²),  F = D_plt (P_{k+1} − P_k)/d;  z_MZ = top of last row with P ≥ Θ_MZ" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(00)81535-4>,
            <https://doi.org/10.1016/j.cub.2007.02.047>,
            <https://doi.org/10.1038/415806a>,
            <https://doi.org/10.1038/nature03184>,
            <https://doi.org/10.1038/nature06215>,
            <https://doi.org/10.1038/nature13663>,
            <https://doi.org/10.1073/pnas.1013145107>,
            <https://doi.org/10.1073/pnas.1201498109>,
            <https://doi.org/10.1104/pp.116.4.1515>,
            <https://doi.org/10.1126/science.1121790> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Solved 2D Cellular PIN1/PIN2/PIN3 Permeability Transport Lattice (Vascular–Epidermal Reverse-Fountain Reflux Capacitor) with Finite-Volume PLETHORA Zonation, Explicit Mitotic Division on a Growing Lattice, and Gravistimulated PIN3/PIN7 Statocyte Efflux Asymmetry" ;
        pk:leanDeclaration "MathOfBiology.Loop_038.plethora_axial_dosage" ;
        pk:leanTheorem "MathOfBiology.Loop_038.mahonen_2014_plethora_meristem_boundary_monotonicity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/grieneisen-root-auxin-reflux-fountain-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Friml et al. (2002) / Kleine-Vehn et al. (2010) Gravistimulated PIN3/PIN7 Columella Efflux Asymmetry Law (Pass 3)" ;
        dct:description "Proves the gravistimulated split conserves columella efflux, strictly favours the lower side for g > 0 and is monotone in g; the solved lattice then yields an EZ lower/upper epidermal auxin ratio of 1.85 at g_max = 0.18 (Spearman ρ = 1.0 over the g sweep) that drives sine-law bending (tipping point reached at 5.55 h vs Band's ≈2 h — disclosed) | Variables: k_col: apolar columella PIN3/4/7 permeability; g ∈ [0, 1]: statocyte relocalisation asymmetry; φ: tip inclination from the gravity vector; β: bending angle; β_tip: Band (2012) tipping point" ;
        dct:source "Friml et al. (2002) Nature 415(6873):806-809; Kleine-Vehn et al. (2010) PNAS 107(51):22344-22349; Band et al. (2012) PNAS 109(12):4668-4673" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L641-L716>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_038_root_auxin_reflux_fountain.lean#L147-L176> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def lower_side_permeability (k_col g : Int) : Int := k_col * (1 + g)
def upper_side_permeability (k_col g : Int) : Int := k_col * (1 - g)
def lateral_efflux_asymmetry (k_col g : Int) : Int :=
  lower_side_permeability k_col g - upper_side_permeability k_col g
theorem friml_2002_gravistimulated_columella_efflux_asymmetry
    (k_col g g1 g2 : Int) (hk : k_col > 0) (hg : g > 0) (hmono : g2 > g1) :
    lower_side_permeability k_col g + upper_side_permeability k_col g = 2 * k_col ∧
    lower_side_permeability k_col g > upper_side_permeability k_col g ∧
    lateral_efflux_asymmetry k_col g = 2 * k_col * g ∧
    lower_side_permeability k_col 0 = upper_side_permeability k_col 0 ∧
    lateral_efflux_asymmetry k_col g2 > lateral_efflux_asymmetry k_col g1
"""^^pk:lean4 ;
        skos:notation "p_lower = k_col (1 + g),  p_upper = k_col (1 − g),  p_lower + p_upper = 2 k_col,  p_lower − p_upper = 2 k_col g (monotone in g),  g = g_max sin(φ)·[β < β_tip]" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(00)81535-4>,
            <https://doi.org/10.1016/j.cub.2007.02.047>,
            <https://doi.org/10.1038/415806a>,
            <https://doi.org/10.1038/nature03184>,
            <https://doi.org/10.1038/nature06215>,
            <https://doi.org/10.1038/nature13663>,
            <https://doi.org/10.1073/pnas.1013145107>,
            <https://doi.org/10.1073/pnas.1201498109>,
            <https://doi.org/10.1104/pp.116.4.1515>,
            <https://doi.org/10.1126/science.1121790> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Solved 2D Cellular PIN1/PIN2/PIN3 Permeability Transport Lattice (Vascular–Epidermal Reverse-Fountain Reflux Capacitor) with Finite-Volume PLETHORA Zonation, Explicit Mitotic Division on a Growing Lattice, and Gravistimulated PIN3/PIN7 Statocyte Efflux Asymmetry" ;
        pk:leanDeclaration "MathOfBiology.Loop_038.lateral_efflux_asymmetry" ;
        pk:leanTheorem "MathOfBiology.Loop_038.friml_2002_gravistimulated_columella_efflux_asymmetry" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/grieneisen-root-auxin-reflux-fountain-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Mähönen et al. (2014) PLETHORA Growth-Dilution Monotonicity Law (Pass 3)" ;
        dct:description "Formalises the growth-dilution mechanism used by `solve_plethora_gradient` on the growing lattice: elongating rows dilute PLT faster and exit the meristem, which is what positions the EZ/DZ boundary in `simulate_growing_cellular_lattice` | Variables: P: PLT dosage; S = α H(A): auxin-induced synthesis; γ: turnover; r: relative growth rate of the cell row (ln2/T_cycle in the meristem, r_ez (1 − l/l_mature) in the elongation zone)" ;
        dct:source "Mähönen et al. (2014) Nature 515(7525):125-129 Figs. 3-4 (growth dilution of PLT proteins)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L334-L362>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_038_root_auxin_reflux_fountain.lean#L188-L203> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def plt_dilution_balance (P gamma r : Int) : Int := P * (gamma + r)
theorem mahonen_2014_plethora_growth_dilution_monotone
    (P1 P2 gamma r1 r2 S : Int)
    (_hP1 : P1 > 0) (hP2 : P2 > 0) (hgamma : gamma > 0) (hr1 : r1 ≥ 0) (hr : r2 > r1)
    (h1 : plt_dilution_balance P1 gamma r1 = S) (h2 : plt_dilution_balance P2 gamma r2 = S) :
    P2 < P1
"""^^pk:lean4 ;
        skos:notation "P (γ + r) = S  ⇒  r₂ > r₁ ≥ 0 ∧ γ > 0 ∧ P₁, P₂ > 0  ⇒  P₂ < P₁" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(00)81535-4>,
            <https://doi.org/10.1016/j.cub.2007.02.047>,
            <https://doi.org/10.1038/415806a>,
            <https://doi.org/10.1038/nature03184>,
            <https://doi.org/10.1038/nature06215>,
            <https://doi.org/10.1038/nature13663>,
            <https://doi.org/10.1073/pnas.1013145107>,
            <https://doi.org/10.1073/pnas.1201498109>,
            <https://doi.org/10.1104/pp.116.4.1515>,
            <https://doi.org/10.1126/science.1121790> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Solved 2D Cellular PIN1/PIN2/PIN3 Permeability Transport Lattice (Vascular–Epidermal Reverse-Fountain Reflux Capacitor) with Finite-Volume PLETHORA Zonation, Explicit Mitotic Division on a Growing Lattice, and Gravistimulated PIN3/PIN7 Statocyte Efflux Asymmetry" ;
        pk:leanDeclaration "MathOfBiology.Loop_038.plt_dilution_balance" ;
        pk:leanTheorem "MathOfBiology.Loop_038.mahonen_2014_plethora_growth_dilution_monotone" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/grieneisen-root-auxin-reflux-fountain-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "Explicit Mitotic Division Length-Conservation Law of the Growing Cellular Lattice (Pass 3)" ;
        dct:description "Guarantees the division rule of `simulate_growing_cellular_lattice` conserves file length and never creates sub-birth-length daughters; the script's self-test checks the same invariants on the 24 h run (23 divisions, 26 meristem cells, min length ≥ l_birth) | Variables: l: meristematic cell row length; l_birth: daughter length at birth (7 µm); n_cells: number of rows in the file" ;
        dct:source "Beemster & Baskin (1998) Plant Physiol 116(4):1515-1526 (kinematic cell production); Dello Ioio et al. (2007) Curr Biol 17(8):678-682 (meristem cell number)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L542-L636>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_038_root_auxin_reflux_fountain.lean#L213-L229> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def daughter_a (l : Int) : Int := l / 2
def daughter_b (l : Int) : Int := l - l / 2
theorem mitotic_division_length_conservation
    (l l_birth n_cells : Int) (_hb : l_birth > 0) (hl : l ≥ 2 * l_birth) :
    daughter_a l + daughter_b l = l ∧
    daughter_a l ≥ l_birth ∧
    daughter_b l ≥ l_birth ∧
    (n_cells - 1) + 2 = n_cells + 1
"""^^pk:lean4 ;
        skos:notation "l ≥ 2 l_birth ∧ l_birth > 0  ⇒  ⌊l/2⌋ + (l − ⌊l/2⌋) = l ∧ ⌊l/2⌋ ≥ l_birth ∧ l − ⌊l/2⌋ ≥ l_birth ∧ n_cells → n_cells + 1" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(00)81535-4>,
            <https://doi.org/10.1016/j.cub.2007.02.047>,
            <https://doi.org/10.1038/415806a>,
            <https://doi.org/10.1038/nature03184>,
            <https://doi.org/10.1038/nature06215>,
            <https://doi.org/10.1038/nature13663>,
            <https://doi.org/10.1073/pnas.1013145107>,
            <https://doi.org/10.1073/pnas.1201498109>,
            <https://doi.org/10.1104/pp.116.4.1515>,
            <https://doi.org/10.1126/science.1121790> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Solved 2D Cellular PIN1/PIN2/PIN3 Permeability Transport Lattice (Vascular–Epidermal Reverse-Fountain Reflux Capacitor) with Finite-Volume PLETHORA Zonation, Explicit Mitotic Division on a Growing Lattice, and Gravistimulated PIN3/PIN7 Statocyte Efflux Asymmetry" ;
        pk:leanDeclaration "MathOfBiology.Loop_038.daughter_a" ;
        pk:leanTheorem "MathOfBiology.Loop_038.mitotic_division_length_conservation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hamant-microtubule-stress-meristem-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hamant et al. (2008) & Bozorg et al. (2014) Saddle-Boundary Stress Anisotropy Amplification & Gaussian Curvature Inversion Law" ;
        dct:description "Proves that transitioning from the positive-Gaussian-curvature SAM dome (K > 0) to the negative-Gaussian-curvature organ boundary saddle (K < 0) switches tensile stress from isotropic (Δσ = 0) to strongly amplified along the boundary crease axis | Variables: κ_1, κ_2: principal curvatures along and across organ-meristem boundary (μm^-1); K = κ_1 κ_2: Gaussian curvature (μm^-2); P_s: turgor shell stress scale; Δσ: principal tensile stress difference (MPa)" ;
        dct:source "Hamant et al. (2008) Science 322:1650-1655 Fig. 2 & SOM; Bozorg et al. (2014) PLoS Comput. Biol. 10(1):e1003410 Figs. 3-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-microtubule-stress-meristem.py#L147-L286>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_036_microtubule_stress_meristem.lean#L30-L65> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def gaussian_curvature (kappa_1 kappa_2 : Int) : Int :=
  kappa_1 * kappa_2
def saddle_stress_anisotropy (P_s kappa_1 kappa_2 : Int) : Int :=
  P_s * (kappa_1 - kappa_2)
theorem hamant_bozorg_saddle_boundary_stress_anisotropy_amplification
    (P_s kappa_0 kappa_s : Int)
    (hP : P_s > 0) (hk0 : kappa_0 > 0) (hks : kappa_s > 0) :
    gaussian_curvature kappa_0 kappa_0 > 0 ∧
    saddle_stress_anisotropy P_s kappa_0 kappa_0 = 0 ∧
    gaussian_curvature kappa_0 (-kappa_s) < 0 ∧
    saddle_stress_anisotropy P_s kappa_0 (-kappa_s) = P_s * kappa_0 + P_s * kappa_s ∧
    saddle_stress_anisotropy P_s kappa_0 (-kappa_s) > P_s * kappa_0
"""^^pk:lean4 ;
        skos:notation "K = κ_1 κ_2;  Δσ(P_s, κ_1, κ_2) = P_s (κ_1 - κ_2);  Δσ(P_s, κ_0, κ_0) = 0 (dome, K > 0) vs Δσ(P_s, κ_0, -κ_s) = P_s(κ_0 + κ_s) > P_s κ_0 > 0 (saddle crease, K < 0)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2012.02.048>,
            <https://doi.org/10.1073/pnas.1600677113>,
            <https://doi.org/10.1111/j.1469-8137.2009.03100.x>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1371/journal.pbio.1000516>,
            <https://doi.org/10.1371/journal.pcbi.1003410>,
            <https://doi.org/10.7554/eLife.01967> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Finite-Element Pressurized Shell Turgor Stress Tensor, Bozorg Stress-vs-Strain Cue Discrimination, Anisotropic Viscoplastic Lockhart Growth & (Pass 3) Heisler PIN1/CMT Co-Alignment on a Growing L1 Cellular Vertex Mesh" ;
        pk:leanDeclaration "MathOfBiology.Loop_036.saddle_stress_anisotropy" ;
        pk:leanTheorem "MathOfBiology.Loop_036.hamant_bozorg_saddle_boundary_stress_anisotropy_amplification" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hamant-microtubule-stress-meristem-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Bozorg et al. (2014) & Hamant et al. (2008) Cylindrical Stem 2:1 Hoop-to-Axial Laplace Stress Switch & Longitudinal Lockhart Elongation Law" ;
        dct:description "Proves that the 2:1 circumferential-to-axial Laplace stress ratio on the cylindrical stem drives transverse cortical microtubule hoops and longitudinal stem elongation when transverse cellulose reinforcement reduces circumferential compliance below C_z / 2 | Variables: S_0 = P R / (2 h): axial Laplace stress (MPa); σ_θ = 2 S_0: circumferential hoop stress (MPa); C_z, C_θ: axial and circumferential viscoplastic compliances (MPa^-1 hr^-1)" ;
        dct:source "Bozorg et al. (2014) PLoS Comput. Biol. 10(1):e1003410 Fig. 2; Hamant et al. (2008) Science 322:1650-1655 Fig. 1" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-microtubule-stress-meristem.py#L147-L286>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_036_microtubule_stress_meristem.lean#L81-L115> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cylinder_axial_stress (S_0 : Int) : Int := S_0
def cylinder_hoop_stress (S_0 : Int) : Int := 2 * S_0
def lockhart_elongation_rate (compliance sigma : Int) : Int := compliance * sigma
theorem bozorg_cylinder_to_saddle_stress_switch
    (S_0 C_z C_theta : Int)
    (hS : S_0 > 0) (hC : C_z > 2 * C_theta) :
    cylinder_hoop_stress S_0 = 2 * cylinder_axial_stress S_0 ∧
    cylinder_hoop_stress S_0 - cylinder_axial_stress S_0 = S_0 ∧
    cylinder_hoop_stress S_0 > cylinder_axial_stress S_0 ∧
    lockhart_elongation_rate C_z (cylinder_axial_stress S_0) -
      lockhart_elongation_rate C_theta (cylinder_hoop_stress S_0) =
      (C_z - 2 * C_theta) * S_0 ∧
    lockhart_elongation_rate C_z (cylinder_axial_stress S_0) >
      lockhart_elongation_rate C_theta (cylinder_hoop_stress S_0)
"""^^pk:lean4 ;
        skos:notation "σ_θ = P R / h = 2 S_0 = 2 σ_z > σ_z;  ε̇_z - ε̇_θ = C_z σ_z - C_θ σ_θ = (C_z - 2 C_θ) S_0 > 0  for C_z > 2 C_θ" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2012.02.048>,
            <https://doi.org/10.1073/pnas.1600677113>,
            <https://doi.org/10.1111/j.1469-8137.2009.03100.x>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1371/journal.pbio.1000516>,
            <https://doi.org/10.1371/journal.pcbi.1003410>,
            <https://doi.org/10.7554/eLife.01967> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Finite-Element Pressurized Shell Turgor Stress Tensor, Bozorg Stress-vs-Strain Cue Discrimination, Anisotropic Viscoplastic Lockhart Growth & (Pass 3) Heisler PIN1/CMT Co-Alignment on a Growing L1 Cellular Vertex Mesh" ;
        pk:leanDeclaration "MathOfBiology.Loop_036.cylinder_hoop_stress" ;
        pk:leanTheorem "MathOfBiology.Loop_036.bozorg_cylinder_to_saddle_stress_switch" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hamant-microtubule-stress-meristem-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Uyttewaal et al. (2012) & Hamant et al. (2008) Katanin (bot1/KTN1) & Oryzalin Mechanical Feedback Gain Reduction Law" ;
        dct:description "Proves that reducing mechanical stress feedback gain γ_MT via katanin (bot1/ktn1) loss-of-function or Oryzalin microtubule depolymerization (γ_MT = 0) reduces or abolishes cellulose stiffness anisotropy and organ-meristem boundary crease folding | Variables: γ_MT: katanin-dependent mechanical stress feedback gain; E_1, E_2: principal cell-wall elastic moduli along and perpendicular to maximal stress (MPa); Δσ: principal stress difference (MPa)" ;
        dct:source "Uyttewaal et al. (2012) Cell 149:439-451 Figs. 2-5; Hamant et al. (2008) Science 322:1650-1655 Fig. 5" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-microtubule-stress-meristem.py#L357-L480>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_036_microtubule_stress_meristem.lean#L132-L167> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def wall_modulus_max (E_0 dE Delta_sigma gamma_MT : Int) : Int :=
  E_0 + dE * Delta_sigma * gamma_MT
def wall_modulus_min (E_0 dE Delta_sigma gamma_MT : Int) : Int :=
  E_0 - dE * Delta_sigma * gamma_MT
def wall_stiffness_anisotropy (E_0 dE Delta_sigma gamma_MT : Int) : Int :=
  wall_modulus_max E_0 dE Delta_sigma gamma_MT - wall_modulus_min E_0 dE Delta_sigma gamma_MT
theorem uyttewaal_katanin_oryzalin_feedback_gain_reduction
    (E_0 dE Delta_sigma gamma_WT gamma_bot1 : Int)
    (hdE : dE > 0) (hDS : Delta_sigma > 0) (hG : gamma_WT > gamma_bot1) :
    wall_stiffness_anisotropy E_0 dE Delta_sigma 0 = 0 ∧
    wall_stiffness_anisotropy E_0 dE Delta_sigma gamma_WT -
      wall_stiffness_anisotropy E_0 dE Delta_sigma gamma_bot1 =
      2 * (dE * Delta_sigma * (gamma_WT - gamma_bot1)) ∧
    wall_stiffness_anisotropy E_0 dE Delta_sigma gamma_WT >
      wall_stiffness_anisotropy E_0 dE Delta_sigma gamma_bot1
"""^^pk:lean4 ;
        skos:notation "ΔE(γ_MT) = E_1(γ_MT) - E_2(γ_MT) = 2 dE Δσ γ_MT;  ΔE(0) = 0 (Oryzalin);  ΔE(γ_WT) - ΔE(γ_bot1) = 2 dE Δσ (γ_WT - γ_bot1) > 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2012.02.048>,
            <https://doi.org/10.1073/pnas.1600677113>,
            <https://doi.org/10.1111/j.1469-8137.2009.03100.x>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1371/journal.pbio.1000516>,
            <https://doi.org/10.1371/journal.pcbi.1003410>,
            <https://doi.org/10.7554/eLife.01967> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Finite-Element Pressurized Shell Turgor Stress Tensor, Bozorg Stress-vs-Strain Cue Discrimination, Anisotropic Viscoplastic Lockhart Growth & (Pass 3) Heisler PIN1/CMT Co-Alignment on a Growing L1 Cellular Vertex Mesh" ;
        pk:leanDeclaration "MathOfBiology.Loop_036.wall_stiffness_anisotropy" ;
        pk:leanTheorem "MathOfBiology.Loop_036.uyttewaal_katanin_oryzalin_feedback_gain_reduction" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hamant-microtubule-stress-meristem-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Heisler et al. (2010) Stress-Based PIN1 Polarity / CMT Co-Alignment & Microtubule-Independence Law (Pass 3)" ;
        dct:description "Proves that PIN1 allocated to the most-tensed wall and CMTs aligned with the virial σ_1 axis pick the same wall axis (co-alignment), that this holds without microtubules (γ_MT = 0, oryzalin) and is only amplified by wild-type katanin feedback | Variables: a: cell side (μm); T_0: isotropic anticlinal wall tension; τ: tension increment on σ_1-parallel walls from the shell stress tensor; M_xx - M_yy: virial (Batchelor) wall-stress anisotropy Σ_e T_e l_e t_e⊗t_e; κ S γ_MT: katanin/cellulose reinforcement of CMT-parallel walls" ;
        dct:source "Heisler et al. (2010) PLoS Biol. 8(10):e1000516 Figs. 2-6; Hamant et al. (2008) Science 322:1650-1655 Fig. 3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-microtubule-stress-meristem.py#L509-L1156>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_036_microtubule_stress_meristem.lean#L165-L226> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def wall_tension_parallel (T_0 tau : Int) : Int := T_0 + tau
def wall_tension_perpendicular (T_0 : Int) : Int := T_0
def virial_stress_anisotropy (a T_par T_perp : Int) : Int := 2 * a * T_par - 2 * a * T_perp
def cmt_reinforced_parallel_tension (T_0 tau kappa S gamma_MT : Int) : Int := T_0 + tau + kappa * S * gamma_MT
theorem heisler_pin1_cmt_coalignment_under_anisotropic_wall_tension
    (a T_0 tau kappa S gamma_MT : Int)
    (ha : a > 0) (_hT : T_0 > 0) (htau : tau > 0)
    (hkappa : kappa ≥ 0) (hS : S ≥ 0) (hgamma : gamma_MT ≥ 0) :
    wall_tension_parallel T_0 tau > wall_tension_perpendicular T_0 ∧
    virial_stress_anisotropy a (wall_tension_parallel T_0 tau) (wall_tension_perpendicular T_0) = 2 * a * tau ∧
    virial_stress_anisotropy a (wall_tension_parallel T_0 tau) (wall_tension_perpendicular T_0) > 0 ∧
    cmt_reinforced_parallel_tension T_0 tau kappa S 0 = wall_tension_parallel T_0 tau ∧
    cmt_reinforced_parallel_tension T_0 tau kappa S 0 > wall_tension_perpendicular T_0 ∧
    cmt_reinforced_parallel_tension T_0 tau kappa S gamma_MT ≥ wall_tension_parallel T_0 tau
"""^^pk:lean4 ;
        skos:notation "T_∥ = T_0 + τ > T_⊥ = T_0;  M_xx - M_yy = 2 a T_∥ - 2 a T_⊥ = 2 a τ > 0 (σ_1 axis = PIN1-rich wall axis = CMT director);  T_∥(γ_MT) = T_0 + τ + κ S γ_MT with T_∥(0) = T_0 + τ > T_⊥ (oryzalin) and T_∥(γ_MT) ≥ T_∥(0)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2012.02.048>,
            <https://doi.org/10.1073/pnas.1600677113>,
            <https://doi.org/10.1111/j.1469-8137.2009.03100.x>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1371/journal.pbio.1000516>,
            <https://doi.org/10.1371/journal.pcbi.1003410>,
            <https://doi.org/10.7554/eLife.01967> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Finite-Element Pressurized Shell Turgor Stress Tensor, Bozorg Stress-vs-Strain Cue Discrimination, Anisotropic Viscoplastic Lockhart Growth & (Pass 3) Heisler PIN1/CMT Co-Alignment on a Growing L1 Cellular Vertex Mesh" ;
        pk:leanDeclaration "MathOfBiology.Loop_036.virial_stress_anisotropy" ;
        pk:leanTheorem "MathOfBiology.Loop_036.heisler_pin1_cmt_coalignment_under_anisotropic_wall_tension" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hamant-microtubule-stress-meristem-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Louveaux et al. (2016) & Hamant & Traas (2010) Vertex-Mesh Topological Event Law — Division Preserves the Euler Characteristic, T1 is Topology-Neutral (Pass 3)" ;
        dct:description "Fixes the bookkeeping invariant that every division (two vertices inserted on existing walls, one new wall, one new cell) and every T1 flip must satisfy on the mesh; verified numerically after each event in simulate_l1_vertex_patch and verify_t1_transition_topology | Variables: V, E, F: vertices, walls and cells of the planar L1 vertex mesh (outer face excluded, χ = 1 for a disc); n: number of symmetric divisions" ;
        dct:source "Louveaux et al. (2016) PNAS 113(30):E4294-E4303 Figs. 2-4 (division along maximal tensile stress); Hamant & Traas (2010) New Phytol. 185:369-385 (no neighbour exchange in cemented plant tissue)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-microtubule-stress-meristem.py#L874-L965>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_036_microtubule_stress_meristem.lean#L230-L268> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def euler_characteristic (V E F : Int) : Int := V - E + F
def vertices_after_divisions (V n : Int) : Int := V + 2 * n
def edges_after_divisions (E n : Int) : Int := E + 3 * n
def cells_after_divisions (F n : Int) : Int := F + n
theorem louveaux_vertex_mesh_division_preserves_euler_characteristic
    (V E F n : Int) (hn : n ≥ 0) :
    euler_characteristic (vertices_after_divisions V 1) (edges_after_divisions E 1) (cells_after_divisions F 1) = euler_characteristic V E F ∧
    cells_after_divisions F 1 > F ∧
    euler_characteristic (vertices_after_divisions V n) (edges_after_divisions E n) (cells_after_divisions F n) = euler_characteristic V E F ∧
    cells_after_divisions F n ≥ F ∧
    euler_characteristic V E F = euler_characteristic V E F
"""^^pk:lean4 ;
        skos:notation "χ = V - E + F;  division along σ_1: (V, E, F) → (V + 2, E + 3, F + 1), χ invariant, F + 1 > F;  after n ≥ 0 divisions (V + 2n, E + 3n, F + n) has the same χ;  T1: (V, E, F) unchanged" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2012.02.048>,
            <https://doi.org/10.1073/pnas.1600677113>,
            <https://doi.org/10.1111/j.1469-8137.2009.03100.x>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1371/journal.pbio.1000516>,
            <https://doi.org/10.1371/journal.pcbi.1003410>,
            <https://doi.org/10.7554/eLife.01967> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Finite-Element Pressurized Shell Turgor Stress Tensor, Bozorg Stress-vs-Strain Cue Discrimination, Anisotropic Viscoplastic Lockhart Growth & (Pass 3) Heisler PIN1/CMT Co-Alignment on a Growing L1 Cellular Vertex Mesh" ;
        pk:leanDeclaration "MathOfBiology.Loop_036.euler_characteristic" ;
        pk:leanTheorem "MathOfBiology.Loop_036.louveaux_vertex_mesh_division_preserves_euler_characteristic" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hannezo-branching-random-walk-annihilation-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hannezo et al. (2017) Topological Binary-Tree Balance & Critical Galton-Watson Branching Law" ;
        dct:description "Proves that any finite self-terminating binary ductal tree starting from 1 primary stalk satisfies N_term = N_branch + 1, tuning the tree automatically to a critical Galton-Watson process (q_branch -> 1/2) with universal P(S) ~ S^(-3/2) subtree size scaling | Variables: N_branch: number of dichotomous tip bifurcation events (A -> 2A); N_term: number of tip-duct annihilation/termination events (A + I -> I); q_branch: ensemble branching probability" ;
        dct:source "Hannezo et al. (2017) Cell 171(1):242-255 Eqs. (1)-(3); Scheele et al. (2017) Nature 542:313-317" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L115-L245>,
            <https://github.com/fractastical/morpholib/blob/74d06a5c/morphoeval/lean/loops/Loop_056_branching_random_walk_annihilation.lean#L46-L73> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def active_tips_remaining (n_branch n_term : Int) : Int := 1 + n_branch - n_term
def total_tree_segments (n_branch n_term : Int) : Int := n_branch + n_term
theorem hannezo_topological_tree_balance_and_critical_branching (n_branch : Int) :
    active_tips_remaining n_branch (n_branch + 1) = 0 ∧
    total_tree_segments n_branch (n_branch + 1) = 2 * n_branch + 1 ∧
    2 * n_branch < total_tree_segments n_branch (n_branch + 1) ∧
    active_tips_remaining 33 34 = 0 ∧
    total_tree_segments 33 34 = 67 := by
  simp [active_tips_remaining, total_tree_segments]; omega
"""^^pk:lean4 ;
        skos:notation "A_final = 1 + N_branch - N_term = 0  =>  N_term = N_branch + 1,  N_total = 2 N_branch + 1,  q_branch = N_branch / (N_branch + N_term) = N_branch / (2 N_branch + 1) -> 1/2 = q_term" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2017.08.026>,
            <https://doi.org/10.1017/S0305004100033193>,
            <https://doi.org/10.1038/nature21060>,
            <https://doi.org/10.1038/s41467-023-39124-x>,
            <https://doi.org/10.1242/dev.060103>,
            <https://doi.org/10.1242/dev.147645> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Stochastic Branching and Annihilating Random Walk (BARW), Critical Galton-Watson Tree Topology & Fisher-KPP Travelling Wavefront" ;
        pk:leanDeclaration "MathOfBiology.Loop_056.active_tips_remaining" ;
        pk:leanTheorem "MathOfBiology.Loop_056.hannezo_topological_tree_balance_and_critical_branching" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hannezo-branching-random-walk-annihilation-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hannezo et al. (2017) Mean-Field BARW Travelling-Wave PDE & Homeostatic Duct Density Law" ;
        dct:description "Establishes that an invading pulse of active tips a(x,t) self-extinguishes behind the Fisher-KPP wavefront (a_∞ = 0) while depositing a uniform homeostatic plateau of differentiated ducts i_∞ ∝ k_b / k_a | Variables: a(x,t): active proliferative tip density; i(x,t): differentiated inactive duct density; D: tip effective diffusivity; v_0: tip speed; k_b: Poisson bifurcation rate; k_a: tip-duct annihilation kernel" ;
        dct:source "Hannezo et al. (2017) Cell 171(1):242-255 STAR Methods Eqs. (4)-(10)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L250-L365>,
            <https://github.com/fractastical/morpholib/blob/74d06a5c/morphoeval/lean/loops/Loop_056_branching_random_walk_annihilation.lean#L80-L110> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def active_tip_reaction (kb ka a i : Int) : Int := kb * a - ka * a * (a + i)
def duct_deposition_rate (v0 a : Int) : Int := v0 * a
def per_tip_net_growth (kb ka a i : Int) : Int := kb - ka * (a + i)
theorem hannezo_barw_homeostatic_steady_state (kb ka v0 i_inf : Int) :
    active_tip_reaction kb ka 0 i_inf = 0 ∧
    duct_deposition_rate v0 0 = 0 ∧
    per_tip_net_growth (ka * i_inf) ka 0 i_inf = 0 := by
  simp [active_tip_reaction, duct_deposition_rate, per_tip_net_growth]; omega
"""^^pk:lean4 ;
        skos:notation "∂_t a = D ∇^2 a - v_0 ∇·(u_p a) + k_b a - k_a a (a + i),  ∂_t i = v_0 a;  a_∞ = 0,  i_∞ = c_0 k_b / k_a ∝ k_b / (v_0 R_a)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2017.08.026>,
            <https://doi.org/10.1017/S0305004100033193>,
            <https://doi.org/10.1038/nature21060>,
            <https://doi.org/10.1038/s41467-023-39124-x>,
            <https://doi.org/10.1242/dev.060103>,
            <https://doi.org/10.1242/dev.147645> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Stochastic Branching and Annihilating Random Walk (BARW), Critical Galton-Watson Tree Topology & Fisher-KPP Travelling Wavefront" ;
        pk:leanDeclaration "MathOfBiology.Loop_056.active_tip_reaction" ;
        pk:leanTheorem "MathOfBiology.Loop_056.hannezo_barw_homeostatic_steady_state" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hannezo-branching-random-walk-annihilation-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hannezo et al. (2017) & Silberstein & Daniel (1987) Annihilation-Radius Hyper-Branching Density Scaling & Explosion Ablation Law" ;
        dct:description "Proves that attenuating TGF-beta signaling (reducing R_a) produces hyper-dense ductal trees while exogenous TGF-beta (increasing R_a) yields sparse hypoplastic trees, whereas complete ablation of annihilation (R_a = 0) destroys self-termination and triggers exponential tip explosion | Variables: R_a: tip-duct steric/TGF-beta sensing and annihilation radius; g: branching generation; N_active(g): active tip count under R_a = 0 ablation" ;
        dct:source "Hannezo et al. (2017) Cell 171(1):242-255 Fig. 4; Silberstein & Daniel (1987) Science 237:291-293" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L370-L535>,
            <https://github.com/fractastical/morpholib/blob/74d06a5c/morphoeval/lean/loops/Loop_056_branching_random_walk_annihilation.lean#L117-L148> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def homeostatic_density_scaled (ra_10 : Nat) : Nat := 10000 / ra_10
def unarrested_branch_step (n : Nat) : Nat := 2 * n
def unarrested_gen5 (n : Nat) : Nat :=
  unarrested_branch_step (unarrested_branch_step (unarrested_branch_step (unarrested_branch_step (unarrested_branch_step n))))
theorem hannezo_annihilation_radius_scaling_and_explosion_ablation (n : Nat) :
    homeostatic_density_scaled 70 < homeostatic_density_scaled 35 ∧
    homeostatic_density_scaled 35 < homeostatic_density_scaled 17 ∧
    unarrested_gen5 n = 32 * n ∧ 0 < unarrested_gen5 1
"""^^pk:lean4 ;
        skos:notation "i_∞(R_a) ∝ k_b / (v_0 R_a)  =>  i_∞(R_a,hypo) < i_∞(R_a,WT) < i_∞(R_a,hyper);  for R_a = 0 (no annihilation): N_active(g) = 2^g -> ∞" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2017.08.026>,
            <https://doi.org/10.1017/S0305004100033193>,
            <https://doi.org/10.1038/nature21060>,
            <https://doi.org/10.1038/s41467-023-39124-x>,
            <https://doi.org/10.1242/dev.060103>,
            <https://doi.org/10.1242/dev.147645> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Stochastic Branching and Annihilating Random Walk (BARW), Critical Galton-Watson Tree Topology & Fisher-KPP Travelling Wavefront" ;
        pk:leanDeclaration "MathOfBiology.Loop_056.homeostatic_density_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_056.hannezo_annihilation_radius_scaling_and_explosion_ablation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hannezo-branching-random-walk-annihilation-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Anisotropic ECM Nematic Alignment Order Law for 3D BARW in cylindrical fat-pad / spherical mesenchymal geometries (Bordeu et al. 2023)" ;
        dct:description "Specifies the anisotropic-ECM torque of the 3D BARW simulator (nematic, not polar: symmetric under u -> -u, zero for isotropic matrix or perpendicular tips) and the order parameter used to quantify fiber alignment of the ductal network; S rises monotonically with lambda and over-alignment (lambda >= 0.4) collapses the tree by alignment-induced sibling annihilation | Variables: u: unit tip direction; f: ECM fiber axis; lambda: nematic alignment strength (1/time); theta: angle between a ductal segment and f; S: length-weighted nematic order parameter; gamma: capsule inflation rate" ;
        dct:source "Bordeu I, Chatzeli L, Simons BD (2023) Nat. Commun. 14:3422 (doi:10.1038/s41467-023-39124-x); Hannezo et al. (2017) Cell STAR Methods" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L801-L1066>,
            <https://github.com/fractastical/morpholib/blob/74d06a5c/morphoeval/lean/loops/Loop_056_branching_random_walk_annihilation.lean#L152-L202> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def nematic_order_twice (c : Int) : Int := 3 * c * c - 1
def nematic_torque (lambda_ fu : Int) : Int := lambda_ * fu
theorem hannezo_nematic_ecm_alignment_order (c lambda_ fu : Int) :
    nematic_order_twice 1 = 2 ∧ nematic_order_twice (-1) = 2 ∧ nematic_order_twice 0 = -1 ∧
    -1 ≤ nematic_order_twice c ∧ nematic_order_twice c = nematic_order_twice (-c) ∧
    nematic_order_twice 1 + nematic_order_twice 0 + nematic_order_twice 0 = 0 ∧
    nematic_torque 0 fu = 0 ∧ nematic_torque lambda_ 0 = 0 ∧
    nematic_torque lambda_ (-fu) = - nematic_torque lambda_ fu
"""^^pk:lean4 ;
        skos:notation "du/dt = sigma_theta xi_perp + lambda (f.u)(f - (f.u) u);  S = < (3 cos^2 theta - 1)/2 >_length,  S(iso) = 0,  S(parallel) = 1,  S(perp) = -1/2;  R_s(t) = R_s(0)(1 + gamma t) (inflation)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2017.08.026>,
            <https://doi.org/10.1017/S0305004100033193>,
            <https://doi.org/10.1038/nature21060>,
            <https://doi.org/10.1038/s41467-023-39124-x>,
            <https://doi.org/10.1242/dev.060103>,
            <https://doi.org/10.1242/dev.147645> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Stochastic Branching and Annihilating Random Walk (BARW), Critical Galton-Watson Tree Topology & Fisher-KPP Travelling Wavefront" ;
        pk:leanDeclaration "MathOfBiology.Loop_056.nematic_order_twice" ;
        pk:leanTheorem "MathOfBiology.Loop_056.hannezo_nematic_ecm_alignment_order" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hannezo-branching-random-walk-annihilation-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Scheele et al. (2017) Moran Neutral-Drift Martingale for labelled stem cells inside a terminal end bud" ;
        dct:description "Proves that neutral drift of a labelled clone inside a TEB conserves the expected labelled fraction while generating clonal variance only in mosaic TEBs; this is the reference (f_bar = f_0) against which the duct-length-weighted labelled fraction of the simulated tree is measured | Variables: N: equipotent stem cells per TEB; k: labelled cells; k': labelled cells after one Moran birth-death step" ;
        dct:source "Scheele CLGJ et al. (2017) Nature 542:313-317 (doi:10.1038/nature21060); Moran PAP (1958) Math. Proc. Camb. Phil. Soc. 54:60-71; Klein AM, Simons BD (2011) Development 138:3103-3111" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L1068-L1225>,
            <https://github.com/fractastical/morpholib/blob/74d06a5c/morphoeval/lean/loops/Loop_056_branching_random_walk_annihilation.lean#L206-L243> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def moran_expected_numerator (n k : Int) : Int :=
  (k + 1) * (k * (n - k)) + (k - 1) * (k * (n - k)) + k * (n * n - 2 * (k * (n - k)))
def moran_variance_numerator (n k : Int) : Int := 2 * (k * (n - k))
theorem scheele_moran_neutral_drift_martingale (n k : Int) :
    moran_expected_numerator n k = k * (n * n) ∧
    moran_variance_numerator n 0 = 0 ∧ moran_variance_numerator n n = 0 ∧
    (0 ≤ k → k ≤ n → 0 ≤ moran_variance_numerator n k)
"""^^pk:lean4 ;
        skos:notation "P(k -> k+1) = P(k -> k-1) = k (N-k) / N^2;  E[k' | k] = k;  N^2 Var[k' - k | k] = 2 k (N-k) >= 0 (= 0 at k = 0, N)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2017.08.026>,
            <https://doi.org/10.1017/S0305004100033193>,
            <https://doi.org/10.1038/nature21060>,
            <https://doi.org/10.1038/s41467-023-39124-x>,
            <https://doi.org/10.1242/dev.060103>,
            <https://doi.org/10.1242/dev.147645> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Stochastic Branching and Annihilating Random Walk (BARW), Critical Galton-Watson Tree Topology & Fisher-KPP Travelling Wavefront" ;
        pk:leanDeclaration "MathOfBiology.Loop_056.moran_expected_numerator" ;
        pk:leanTheorem "MathOfBiology.Loop_056.scheele_moran_neutral_drift_martingale" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hannezo-branching-random-walk-annihilation-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "Label Conservation at a TEB Bifurcation (hypergeometric half-split + doubling)" ;
        dct:description "Shows that the A -> 2A bifurcation is label-neutral: the total labelled count doubles with cell number and each daughter is an unbiased copy of the parent, so the martingale of Law 5 extends to the whole BARW tree (clone fate is dictated by the tree's bifurcation/termination statistics, Scheele et al. 2017) | Variables: k: labelled cells in the parent TEB; k_1: labelled cells in the first half of the split; h = N/2" ;
        dct:source "Scheele CLGJ et al. (2017) Nature 542:313-317 (doi:10.1038/nature21060)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/74d06a5c/2017-hannezo-branching-random-walk-annihilation.py#L1088-L1157>,
            <https://github.com/fractastical/morpholib/blob/74d06a5c/morphoeval/lean/loops/Loop_056_branching_random_walk_annihilation.lean#L247-L272> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def daughter_labels (k k1 : Int) : Int × Int := (2 * k1, 2 * (k - k1))
theorem scheele_teb_split_label_conservation (k k1 h : Int) :
    (daughter_labels k k1).1 + (daughter_labels k k1).2 = 2 * k ∧
    2 * (h * k) = (2 * h) * k
"""^^pk:lean4 ;
        skos:notation "k -> (2 k_1, 2 (k - k_1)),  k_1 ~ Hypergeom(N, k, N/2);  2 k_1 + 2 (k - k_1) = 2 k;  E[2 k_1] = k" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2017.08.026>,
            <https://doi.org/10.1017/S0305004100033193>,
            <https://doi.org/10.1038/nature21060>,
            <https://doi.org/10.1038/s41467-023-39124-x>,
            <https://doi.org/10.1242/dev.060103>,
            <https://doi.org/10.1242/dev.147645> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Stochastic Branching and Annihilating Random Walk (BARW), Critical Galton-Watson Tree Topology & Fisher-KPP Travelling Wavefront" ;
        pk:leanDeclaration "MathOfBiology.Loop_056.daughter_labels" ;
        pk:leanTheorem "MathOfBiology.Loop_056.scheele_teb_split_label_conservation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hannezo-epithelial-buckling-3d-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hannezo–Prost–Joanny 3D Epithelial Equilibrium Aspect-Ratio & Squamous-Cuboidal-Columnar Scaling Law" ;
        dct:description "Determines the universal equilibrium cell height h_0 and aspect ratio h_0/d_0 continuously spanning squamous (h_0/d_0 < 1), cuboidal (h_0/d_0 ≈ 1), and tall columnar (h_0/d_0 > 1) epithelia | Variables: Γ_a, Γ_b: apical and basal actomyosin surface tensions; Γ_l: lateral cell-cell tension; V_0 = A_0 h_0: conserved 3D cell volume; c = 2√(2√3) ≈ 3.7224: hexagonal perimeter factor; h_0/d_0: equilibrium cell aspect ratio" ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS 111(1):27-32 Eqs. (1)-(4); Krajnc & Ziherl (2015) Phys. Rev. E 92:052713 Eqs. (5)-(9)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/2016-hannezo-epithelial-buckling-3d.py#L205-L272>,
            <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/lean/loops/Loop_047_epithelial_buckling_3d.lean#L31-L65> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def aspect_stationarity_residual (Ga_Gb c_Gl d0 h0 : Int) : Int :=
  4 * Ga_Gb * d0 - c_Gl * h0
def epithelial_morphology_class (c_Gl four_Ga_Gb : Nat) : Nat :=
  if c_Gl < four_Ga_Gb then 0
  else if c_Gl == four_Ga_Gb then 1
  else 2
theorem hannezo_equilibrium_aspect_ratio_hierarchy (Ga_Gb k : Int) (g base delta : Nat) :
    aspect_stationarity_residual Ga_Gb (4 * Ga_Gb) k k = 0 ∧
    epithelial_morphology_class g (g + base + 1) = 0 ∧
    epithelial_morphology_class (g + 1) (g + 1) = 1 ∧
    epithelial_morphology_class (g + delta + 2) (g + 1) = 2
"""^^pk:lean4 ;
        skos:notation "E_cell(A) = (Γ_a + Γ_b) A + c Γ_l V_0 / (2√A)  ⇒  ∂E_cell/∂A = 0  ⇔  h_0 = (c Γ_l √V_0 / [4(Γ_a + Γ_b)])^(2/3),  h_0 / d_0 = c Γ_l / [4(Γ_a + Γ_b)]" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2015.11.024>,
            <https://doi.org/10.1038/s41467-018-05376-1>,
            <https://doi.org/10.1038/s41467-018-06497-3>,
            <https://doi.org/10.1073/pnas.1321766111>,
            <https://doi.org/10.1103/PhysRevE.92.052713> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "3D Incompressible Vertex / Continuum Epithelial Energy with Apical (Gamma_a), Basal (Gamma_b), and Lateral (Gamma_l) Surface Tensions & Substrate Elastic Foundation" ;
        pk:leanDeclaration "MathOfBiology.Loop_047.aspect_stationarity_residual" ;
        pk:leanTheorem "MathOfBiology.Loop_047.hannezo_equilibrium_aspect_ratio_hierarchy" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hannezo-epithelial-buckling-3d-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Single-Cell Energy Convexity (E''(A^*) > 0) & Elastic Substrate Buckling Wavenumber Stationarity" ;
        dct:description "Guarantees mechanical stability of flat epithelial sheets below the critical homeostatic buckling pressure and selects the characteristic folding wavelength λ_c = 2π(κ_eff / K_sub)^(1/4) above threshold | Variables: E''_cell(A^*): second derivative of single-cell energy at equilibrium area A^*; κ_eff: effective monolayer bending modulus; K_sub: stromal elastic foundation stiffness; λ_c: critical buckling wavelength" ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS 111(1):27-32 Eqs. (6)-(11)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/2016-hannezo-epithelial-buckling-3d.py#L248-L287>,
            <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/lean/loops/Loop_047_epithelial_buckling_3d.lean#L78-L90> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cell_energy_hessian_num (c Gamma_l V_0 : Nat) : Nat :=
  3 * c * Gamma_l * V_0
def buckling_quartic_residual (q kappa_eff K_sub : Int) : Int :=
  kappa_eff * (q * q * q * q) - K_sub
theorem flat_monolayer_convexity_and_buckling_stationarity (c gl v0 : Nat) (q kappa_eff : Int) :
    cell_energy_hessian_num (c + 1) (gl + 1) (v0 + 1) > 0 ∧
    buckling_quartic_residual q kappa_eff (kappa_eff * (q * q * q * q)) = 0
"""^^pk:lean4 ;
        skos:notation "E''_cell(A^*) = 3 c Γ_l V_0 / (8 (A^*)^(5/2)) > 0,  N_c(q) = κ_eff q^2 + K_sub / q^2  ⇒  κ_eff q_c^4 = K_sub,  λ_c = 2π (κ_eff / K_sub)^(1/4)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2015.11.024>,
            <https://doi.org/10.1038/s41467-018-05376-1>,
            <https://doi.org/10.1038/s41467-018-06497-3>,
            <https://doi.org/10.1073/pnas.1321766111>,
            <https://doi.org/10.1103/PhysRevE.92.052713> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "3D Incompressible Vertex / Continuum Epithelial Energy with Apical (Gamma_a), Basal (Gamma_b), and Lateral (Gamma_l) Surface Tensions & Substrate Elastic Foundation" ;
        pk:leanDeclaration "MathOfBiology.Loop_047.cell_energy_hessian_num" ;
        pk:leanTheorem "MathOfBiology.Loop_047.flat_monolayer_convexity_and_buckling_stationarity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hannezo-epithelial-buckling-3d-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Apico-Basal Differential Tension & Spontaneous Curvature Sign Reversal Law" ;
        dct:description "Explains how apical actomyosin enrichment (Γ_a > Γ_b) vs basal tension enrichment (Γ_b > Γ_a) reverses the polarity of epithelial folds and drives acinar closure when |C_0| exceeds substrate confinement | Variables: ΔΓ = Γ_a - Γ_b: apico-basal differential surface tension; C_0: spontaneous monolayer curvature; h_0: equilibrium cell height" ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS 111(1):27-32 Eq. (5) & Fig. 2; Krajnc & Ziherl (2015) Phys. Rev. E 92:052713 Eq. (14); Sui et al. (2018) Nat. Commun. 9:4620" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/2016-hannezo-epithelial-buckling-3d.py#L256-L257>,
            <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/lean/loops/Loop_047_epithelial_buckling_3d.lean#L103-L119> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def spontaneous_curvature_num (Gamma_a Gamma_b : Int) : Int :=
  Gamma_a - Gamma_b
theorem apicobasal_spontaneous_curvature_sign_reversal (Ga Gb : Int) (base dG : Nat) :
    spontaneous_curvature_num Ga Gb = -spontaneous_curvature_num Gb Ga ∧
    spontaneous_curvature_num Ga Ga = 0 ∧
    spontaneous_curvature_num (Int.ofNat (base + dG + 1)) (Int.ofNat base) > 0 ∧
    spontaneous_curvature_num (Int.ofNat base) (Int.ofNat (base + dG + 1)) < 0
"""^^pk:lean4 ;
        skos:notation "C_0 ∝ (Γ_a - Γ_b) / (Γ_l h_0),  C_0(Γ_b, Γ_a) = -C_0(Γ_a, Γ_b),  Γ_a > Γ_b ⇒ C_0 > 0 (apical constriction),  Γ_b > Γ_a ⇒ C_0 < 0 (basal constriction)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2015.11.024>,
            <https://doi.org/10.1038/s41467-018-05376-1>,
            <https://doi.org/10.1038/s41467-018-06497-3>,
            <https://doi.org/10.1073/pnas.1321766111>,
            <https://doi.org/10.1103/PhysRevE.92.052713> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "3D Incompressible Vertex / Continuum Epithelial Energy with Apical (Gamma_a), Basal (Gamma_b), and Lateral (Gamma_l) Surface Tensions & Substrate Elastic Foundation" ;
        pk:leanDeclaration "MathOfBiology.Loop_047.spontaneous_curvature_num" ;
        pk:leanTheorem "MathOfBiology.Loop_047.apicobasal_spontaneous_curvature_sign_reversal" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hannezo-epithelial-buckling-3d-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Curved-Tube Surface Ratio & Isometric No-Scutoid Law (Pass 3, 3D polyhedral scutoid mesh)" ;
        dct:description "Couples the Hannezo cell height to the Gómez-Gálvez scutoid mechanism: curvature (tube or fold crest) makes s ≠ 1, the radially projected basal tessellation is anisotropically stretched and apico-basal neighbour intercalations (scutoids) appear; flat sheets (s = 1) have none | Variables: R_a, R_b: apical and basal tube radii; h_0: Hannezo equilibrium cell height (Law 1); s: surface ratio; N_apical, N_basal: Voronoi neighbour sets of a cell on the two surfaces; κ_max: maximal apico-basal curvature of the buckled sheet" ;
        dct:source "Gómez-Gálvez et al. (2018) Nat. Commun. 9:2960 Figs. 1-2 (Voronoi tubes, scutoid number vs surface ratio); Hannezo, Prost & Joanny (2014) PNAS 111:27-32 Eq. (4) for h_0" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/2016-hannezo-epithelial-buckling-3d.py#L582-L858>,
            <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/lean/loops/Loop_047_epithelial_buckling_3d.lean#L132-L162> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def surface_ratio_numerator (R_a h_0 : Nat) : Nat :=
  R_a + h_0
def scutoid_indicator (apical basal : List Nat) : Nat :=
  if apical == basal then 0 else 1
def scutoid_count (cells : List (List Nat × List Nat)) : Nat :=
  cells.foldr (fun c acc => scutoid_indicator c.1 c.2 + acc) 0
theorem scutoid_count_isometric (nbrs : List (List Nat)) :
    scutoid_count (nbrs.map (fun n => (n, n))) = 0
theorem isometric_projection_has_no_scutoids (nbrs : List (List Nat)) (R_a h_0 : Nat) :
    scutoid_count (nbrs.map (fun n => (n, n))) = 0 ∧
    surface_ratio_numerator R_a (h_0 + 1) > R_a ∧
    surface_ratio_numerator R_a 0 = R_a ∧
    scutoid_indicator [1, 2, 3, 4, 5, 6] [1, 2, 3, 4, 5, 6] = 0 ∧
    scutoid_indicator [1, 2, 3, 4, 5, 6] [1, 2, 3, 4, 5, 7] = 1
"""^^pk:lean4 ;
        skos:notation "s = R_b / R_a = (R_a + h_0) / R_a > 1 for h_0 > 0;  scutoid(cell) ⇔ N_apical(cell) ≠ N_basal(cell);  s = 1 ⇒ N_apical = N_basal ∀ cells ⇒ Σ scutoid = 0;  s_crest = 1 + h_0 κ_max" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2015.11.024>,
            <https://doi.org/10.1038/s41467-018-05376-1>,
            <https://doi.org/10.1038/s41467-018-06497-3>,
            <https://doi.org/10.1073/pnas.1321766111>,
            <https://doi.org/10.1103/PhysRevE.92.052713> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "3D Incompressible Vertex / Continuum Epithelial Energy with Apical (Gamma_a), Basal (Gamma_b), and Lateral (Gamma_l) Surface Tensions & Substrate Elastic Foundation" ;
        pk:leanDeclaration "MathOfBiology.Loop_047.scutoid_count" ;
        pk:leanTheorem "MathOfBiology.Loop_047.isometric_projection_has_no_scutoids" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hannezo-epithelial-buckling-3d-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Trivalent Torus Neighbour Conservation Law (Pass 3, Euler 2E = 6F on apical and basal surfaces)" ;
        dct:description "Guarantees that apico-basal intercalations redistribute but conserve the neighbour budget (mean 6 on both surfaces); checked numerically on every periodic mesh in `self_test` (checks 9) and reported as a MorphoEval measurement | Variables: V, E, F: vertices, edges, faces (cells) of the doubly periodic Voronoi tessellation on the apical (a) or basal (b) surface; n: neighbour number per cell" ;
        dct:source "Euler characteristic of the torus; Gómez-Gálvez et al. (2018) Nat. Commun. 9:2960 Fig. 3 (apical vs basal neighbour distributions)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/654cd6fc/2016-hannezo-epithelial-buckling-3d.py#L505-L529>,
            <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/lean/loops/Loop_047_epithelial_buckling_3d.lean#L174-L186> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def total_neighbor_count (E : Nat) : Nat :=
  2 * E
theorem trivalent_torus_neighbor_conservation
    (V_a E_a V_b E_b F : Nat)
    (h_triv_a : 3 * V_a = 2 * E_a) (h_euler_a : V_a + F = E_a)
    (h_triv_b : 3 * V_b = 2 * E_b) (h_euler_b : V_b + F = E_b) :
    total_neighbor_count E_a = 6 * F ∧
    total_neighbor_count E_b = 6 * F ∧
    total_neighbor_count E_a = total_neighbor_count E_b
"""^^pk:lean4 ;
        skos:notation "3 V = 2 E (trivalent) ∧ V − E + F = 0 (torus) ⇒ 2 E = 6 F ⇒ ⟨n⟩_apical = ⟨n⟩_basal = 6;  Σ_cells n_apical = Σ_cells n_basal" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2015.11.024>,
            <https://doi.org/10.1038/s41467-018-05376-1>,
            <https://doi.org/10.1038/s41467-018-06497-3>,
            <https://doi.org/10.1073/pnas.1321766111>,
            <https://doi.org/10.1103/PhysRevE.92.052713> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "3D Incompressible Vertex / Continuum Epithelial Energy with Apical (Gamma_a), Basal (Gamma_b), and Lateral (Gamma_l) Surface Tensions & Substrate Elastic Foundation" ;
        pk:leanDeclaration "MathOfBiology.Loop_047.total_neighbor_count" ;
        pk:leanTheorem "MathOfBiology.Loop_047.trivalent_torus_neighbor_conservation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/haupaix-avian-plumage-somite-stripes-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Somite-Specified Dorsoventral Stripe Period Partition & Exogenous Agouti Bead Reciprocity" ;
        dct:description "Proves conservation of the somite-specified dorsoventral stripe period and exact reciprocal narrowing of adjacent black eumelanin bands upon exogenous Agouti bead implantation | Variables: Lambda: somite-specified dorsoventral stripe period (μm); w_y: Agouti-positive yellow pheomelanin stripe width; delta_bead: exogenous Agouti protein bead expansion" ;
        dct:source "Haupaix et al. (2018) Science 361(6408):eaar4777 Figs. 1 & 4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L158-L336,L452-L488>,
            <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_010_avian_plumage_somite_stripes.lean#L19-L46> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def black_stripe_width (Lambda w_y : Int) : Int := Lambda - w_y
theorem somite_stripe_period_conservation_and_agouti_bead_expansion
    (Lambda w_y delta_bead : Int)
    (hw : 0 ≤ w_y) (hbead : delta_bead > 0) (hcap : w_y + delta_bead ≤ Lambda) :
    w_y + black_stripe_width Lambda w_y = Lambda ∧
    (w_y + delta_bead) + black_stripe_width Lambda (w_y + delta_bead) = Lambda ∧
    w_y + delta_bead > 0 ∧
    black_stripe_width Lambda (w_y + delta_bead) ≥ 0 ∧
    black_stripe_width Lambda (w_y + delta_bead) < black_stripe_width Lambda w_y ∧
    black_stripe_width Lambda (w_y + delta_bead) = black_stripe_width Lambda w_y - delta_bead := by
  unfold black_stripe_width; omega
"""^^pk:lean4 ;
        skos:notation "w_{\\text{yellow}} + w_{\\text{black}} = \\Lambda_{\\text{somite}}; \\quad w_{\\text{black}}(\\Lambda, w_y + \\Delta_{\\text{bead}}) = w_{\\text{black}}(\\Lambda, w_y) - \\Delta_{\\text{bead}}" ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1816107116>,
            <https://doi.org/10.1126/science.1230374>,
            <https://doi.org/10.1126/science.aar4777>,
            <https://doi.org/10.1371/journal.pbio.3000448> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Somite-Prepatterned Stripe Spacing" ;
        pk:leanDeclaration "MathOfBiology.Loop_010.black_stripe_width" ;
        pk:leanTheorem "MathOfBiology.Loop_010.somite_stripe_period_conservation_and_agouti_bead_expansion" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/haupaix-avian-plumage-somite-stripes-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Heterospecific Somite-to-Dermis Chimera Donor Autonomy Law" ;
        dct:description "Proves that heterospecific somite grafting between quail, pheasant, and guineafowl autonomously shifts host dermal Agouti stripe width toward the somite donor species | Variables: alpha_pct: percentage donor somite autonomy in chimeric dermis (≈94% in galliform chimeras); w_donor, w_host: donor and host species Agouti stripe widths" ;
        dct:source "Haupaix et al. (2018) Science 361(6408):eaar4777 Fig. 3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L395-L449>,
            <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_010_avian_plumage_somite_stripes.lean#L53-L76> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def chimera_agouti_width_scaled (alpha_pct w_donor w_host : Int) : Int :=
  alpha_pct * w_donor + (100 - alpha_pct) * w_host
theorem interspecific_somite_graft_donor_autonomy
    (w_donor w_host : Int) (h_diff : w_donor > w_host) :
    chimera_agouti_width_scaled 100 w_donor w_host = 100 * w_donor ∧
    chimera_agouti_width_scaled 94 w_donor w_host > 100 * w_host ∧
    chimera_agouti_width_scaled 94 w_host w_donor < 100 * w_donor := by
  unfold chimera_agouti_width_scaled; omega
"""^^pk:lean4 ;
        skos:notation "W_{\\text{chimera}} = \\alpha_{\\text{donor}} w_{\\text{donor}} + (1 - \\alpha_{\\text{donor}}) w_{\\text{host}}; \\quad w_{\\text{donor}} > w_{\\text{host}} \\implies W_{\\text{chimera}} > w_{\\text{host}}" ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1816107116>,
            <https://doi.org/10.1126/science.1230374>,
            <https://doi.org/10.1126/science.aar4777>,
            <https://doi.org/10.1371/journal.pbio.3000448> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Somite-Prepatterned Stripe Spacing" ;
        pk:leanDeclaration "MathOfBiology.Loop_010.chimera_agouti_width_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_010.interspecific_somite_graft_donor_autonomy" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/haupaix-avian-plumage-somite-stripes-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Agouti-MC1R Threshold Fate Switch & Connexin40 Melanocyte Reaction-Diffusion Instability" ;
        dct:description "Proves that Agouti threshold antagonism switches melanocytes from black eumelanin (0) to yellow pheomelanin (1) while differential diffusivity (d=20 vs d=1) amplifies periodic stripes aligned to the somite prepattern | Variables: A: dermal Agouti concentration; theta_A: MC1R antagonism threshold; u, v: melanocyte gap-junction activator and long-range inhibitor; d_ratio = D_v/D_u" ;
        dct:source "Haupaix et al. (2018) Science 361:eaar4777 Fig. 3; Inaba et al. (2019) PNAS 116:6884-6890 Figs. 2-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L158-L336>,
            <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_010_avian_plumage_somite_stripes.lean#L83-L116> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def mc1r_pigment_fate (A theta_A : Nat) : Nat := if A ≥ theta_A then 1 else 0
theorem agouti_mc1r_switch_and_cx40_turing_instability :
    mc1r_pigment_fate 75 50 = 1 ∧ mc1r_pigment_fate 0 50 = 0 ∧
    turing_trace 5 (-7) < 0 ∧ turing_det 5 (-7) (-8) 6 > 0 ∧
    turing_cross_term 5 (-7) 1 < 0 ∧ turing_cross_term 5 (-7) 20 > 0 := by decide
"""^^pk:lean4 ;
        skos:notation "F_{\\text{pigment}}(A) = \\mathbb{I}(A \\ge \\theta_A); \\quad \\partial_t u = D_u \\nabla^2 u + f(u,v) + \\beta_A S_{\\text{somite}}(y), \\; \\partial_t v = D_v \\nabla^2 v + g(u,v)" ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1816107116>,
            <https://doi.org/10.1126/science.1230374>,
            <https://doi.org/10.1126/science.aar4777>,
            <https://doi.org/10.1371/journal.pbio.3000448> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Somite-Prepatterned Stripe Spacing" ;
        pk:leanDeclaration "MathOfBiology.Loop_010.mc1r_pigment_fate" ;
        pk:leanTheorem "MathOfBiology.Loop_010.agouti_mc1r_switch_and_cx40_turing_instability" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/haupaix-avian-plumage-somite-stripes-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Lin (2013) Ring-Niche Chevron Geometry on the Opened Feather-Follicle Cylinder" ;
        dct:description "Proves that a pigment switch propagating around the Lin (2013) ring niche yields a mirror-symmetric chevron band on the opened follicle whose apex sits on the rachis and whose opening grows monotonically with the helical pitch, degenerating to a transverse bar for a synchronous ring (k = 0) | Variables: s: proximodistal position from the feather tip (growth-time axis); ell: signed lateral/azimuthal distance from the anterior rachis on the cylinder opened at the posterior new-barb locus; k = v_z/(r_f omega): helical pitch of a pigment switch propagating around the ring niche at angular rate omega while melanocytes rise at v_z" ;
        dct:source "Lin et al. (2013) Science 340(6139):1442-1445 Fig. 1B, Fig. 2B, fig. S9" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L659-L742>,
            <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_010_avian_plumage_somite_stripes.lean#L126-L157> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def chevron_s (s0 k ell : Int) : Int := s0 + k * (Int.natAbs ell : Int)
theorem ring_niche_chevron_geometry (s0 k ell : Int) (hk : 0 ≤ k) :
    chevron_s s0 k ell = chevron_s s0 k (-ell) ∧
    chevron_s s0 0 ell = s0 ∧
    s0 ≤ chevron_s s0 k ell ∧
    (∀ k', k < k' → ell ≠ 0 → chevron_s s0 k ell < chevron_s s0 k' ell) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp [chevron_s, Int.natAbs_neg]
  · simp [chevron_s]
  · unfold chevron_s; have h := Int.mul_nonneg hk (Int.natCast_nonneg (Int.natAbs ell)); omega
  · intro k' hk' hell; unfold chevron_s
    have hpos : (0 : Int) < (Int.natAbs ell : Int) := by omega
    have h := Int.mul_lt_mul_of_pos_right hk' hpos; omega
"""^^pk:lean4 ;
        skos:notation "s_{\\text{edge}}(\\ell) = s_0 + k\\,|\\ell|, \\quad k = \\frac{v_z}{r_f\\,\\omega}; \\quad s(\\ell) = s(-\\ell), \\; s(\\ell)|_{k=0} = s_0, \\; s_0 \\le s(\\ell), \\; k < k' \\wedge \\ell \\ne 0 \\implies s_k(\\ell) < s_{k'}(\\ell)" ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1816107116>,
            <https://doi.org/10.1126/science.1230374>,
            <https://doi.org/10.1126/science.aar4777>,
            <https://doi.org/10.1371/journal.pbio.3000448> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Somite-Prepatterned Stripe Spacing" ;
        pk:leanDeclaration "MathOfBiology.Loop_010.chevron_s" ;
        pk:leanTheorem "MathOfBiology.Loop_010.ring_niche_chevron_geometry" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/haupaix-avian-plumage-somite-stripes-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Haupaix (2018) Agouti-Dose Yellow-Pulse Duration & Feather-Type Law on the Follicle Niche" ;
        dct:description "Proves the Haupaix et al. (2018) feather-type trichotomy (b / y with black base and tip / fully pheomelanic) and that feather type is monotone non-decreasing in agouti dose, the law behind the recessive-black (2 rows) < wild-type (4 rows) < Fawn (5-6 rows, no eumelanin) stripe-width series | Variables: A_i: dermal agouti dose read by the follicle ring niche from the body-wide field u(x_i, y_i) (Lean A = A_i - a); a: amplitude of the transient yellow-pulse modulation (peak A_i at mid-growth, trough A_i - 2a at tip and base); theta_A: MC1R antagonism threshold; duty: relative yellow band length" ;
        dct:source "Haupaix et al. (2018) Science 361(6408):eaar4777 Fig. 3A-C, fig. S1, fig. S6" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L545-L656,L745-L773>,
            <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_010_avian_plumage_somite_stripes.lean#L160-L192> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def mc1r_pigment_fate_int (A theta_A : Int) : Nat := if A ≥ theta_A then 1 else 0
def feather_type (A a theta_A : Int) : Nat :=
  mc1r_pigment_fate_int (A + a) theta_A + mc1r_pigment_fate_int (A - a) theta_A
theorem agouti_pulse_duration_feather_type (A a theta_A : Int) (ha : 0 < a) :
    (A - a ≥ theta_A → feather_type A a theta_A = 2) ∧
    (A + a < theta_A → feather_type A a theta_A = 0) ∧
    (theta_A - a ≤ A ∧ A < theta_A + a → feather_type A a theta_A = 1) ∧
    (∀ A', A ≤ A' → feather_type A a theta_A ≤ feather_type A' a theta_A) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro h; simp only [feather_type, mc1r_pigment_fate_int]; split <;> (try split) <;> omega
  · intro h; simp only [feather_type, mc1r_pigment_fate_int]; split <;> (try split) <;> omega
  · intro h; simp only [feather_type, mc1r_pigment_fate_int]; split <;> (try split) <;> omega
  · intro A' h; simp only [feather_type, mc1r_pigment_fate_int]; repeat (first | omega | split)
"""^^pk:lean4 ;
        skos:notation "A(\\tau) = A_i - a + a\\cos(2\\pi(\\tau - \\tfrac12)); \\quad \\text{type} = \\mathbb{I}(A_i \\ge \\theta_A) + \\mathbb{I}(A_i - 2a \\ge \\theta_A) \\in \\{0: b,\\; 1: y,\\; 2: \\text{fully pheomelanic}\\}; \\quad \\text{duty} = \\tfrac{1}{\\pi}\\arccos\\!\\big(\\tfrac{\\theta_A - (A_i - a)}{a}\\big)" ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1816107116>,
            <https://doi.org/10.1126/science.1230374>,
            <https://doi.org/10.1126/science.aar4777>,
            <https://doi.org/10.1371/journal.pbio.3000448> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Somite-Prepatterned Stripe Spacing" ;
        pk:leanDeclaration "MathOfBiology.Loop_010.feather_type" ;
        pk:leanTheorem "MathOfBiology.Loop_010.agouti_pulse_duration_feather_type" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/he-drosophila-ventral-furrow-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Incompressible Trapezoidal Wedge Cell Lengthening & Basal Expansion Law" ;
        dct:description "Proves that cytoplasmic incompressibility forces apicobasal cell lengthening when the basal cortex is stiff (early gastrulation phase) and forces basal wedge expansion when combined with basal relaxation and lateral shortening (invagination phase) | Variables: w_{ap,i}, w_{ba,i}: apical and basal widths of cell i; h_i: apicobasal cell height; A_0: conserved 2D cytoplasmic cell area (262.4 um^2)" ;
        dct:source "Conte, Munoz, Baum & Miodownik (2012) PLoS ONE 7(11):e49973 Eq. 2, Figs. 3-4; He et al. (2014) Nature 508:392-396" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L120-L185>,
            <https://github.com/fractastical/morpholib/blob/7e4f207/morphoeval/lean/loops/Loop_046_drosophila_ventral_furrow.lean#L17-L62> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def twice_wedge_cell_area (w_ap w_ba h : Int) : Int :=
  (w_ap + w_ba) * h
theorem incompressible_wedge_cell_lengthening_and_basal_expansion
    (w_0 h_0 w_ap w_ba h_len h_short : Int)
    (hw0 : w_0 > 0) (_hh0 : h_0 > 0) (hConstr : w_ap < w_0)
    (hPosLen : h_len > 0) (hShort : h_short ≤ h_0) (hPosShort : h_short > 0)
    (hAreaLen : twice_wedge_cell_area w_ap w_0 h_len = twice_wedge_cell_area w_0 w_0 h_0)
    (hAreaExp : twice_wedge_cell_area w_ap w_ba h_short = twice_wedge_cell_area w_0 w_0 h_0) :
    h_len > h_0 ∧ w_ba > w_0"""^^pk:lean4 ;
        skos:notation "A_i = 0.5 * (w_{ap,i} + w_{ba,i}) * h_i = A_0;  w_{ap,i} < w_0 & w_{ba,i} = w_0 => h_i > h_0;  w_{ap,i} < w_0 & h_i <= h_0 => w_{ba,i} > w_0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2014.07.013>,
            <https://doi.org/10.1038/nature07522>,
            <https://doi.org/10.1038/nature13070>,
            <https://doi.org/10.1242/dev.110.1.73>,
            <https://doi.org/10.1242/dev.112.3.775>,
            <https://doi.org/10.1371/journal.pbio.1002292>,
            <https://doi.org/10.1371/journal.pone.0049973> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "2D Incompressible Active Viscous-Vertex Epithelial Cross-Sectional Mechanics & Ratcheted Actomyosin Pulse Dynamics" ;
        pk:leanDeclaration "MathOfBiology.Loop_046.twice_wedge_cell_area" ;
        pk:leanTheorem "MathOfBiology.Loop_046.incompressible_wedge_cell_lengthening_and_basal_expansion" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/he-drosophila-ventral-furrow-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Martin, Kaschube & Wieschaus (2009) Twist-Stabilized Ratcheted Myosin-II Pulse Law" ;
        dct:description "Proves that Twist-stabilized ratcheting (r_twist = 1) produces strictly negative step-wise net apical constriction per pulse, whereas unratcheted mutants (r_twist = 0) recoil toward L_0 between pulses | Variables: L_{ap}: apical cell width; L_0: initial relaxed apical width; M(t): periodic Myosin-II coalescence pulse; alpha_pulse: contractile pulse rate; beta_relax: elastic recoil rate; r_twist: Twist/Snail ratchet stabilization factor in [0, 1]" ;
        dct:source "Martin, Kaschube & Wieschaus (2009) Nature 457(7228):495-499 Figs. 2-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L188-L250>,
            <https://github.com/fractastical/morpholib/blob/7e4f207/morphoeval/lean/loops/Loop_046_drosophila_ventral_furrow.lean#L64-L98> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def net_pulse_apical_change (alpha_pulse M_pulse beta_relax r_twist L_0 L_ap : Int) : Int :=
  -(alpha_pulse * M_pulse) + (1 - r_twist) * (beta_relax * (L_0 - L_ap))
theorem twist_ratcheted_pulse_stepwise_constriction_vs_recoil
    (alpha_pulse M_pulse beta_relax L_0 L_ap : Int)
    (hAlpha : alpha_pulse > 0) (hM : M_pulse > 0) (hBeta : beta_relax > 0)
    (hConstr : L_ap < L_0) (hRecoilBal : beta_relax * (L_0 - L_ap) = alpha_pulse * M_pulse) :
    net_pulse_apical_change alpha_pulse M_pulse beta_relax 1 L_0 L_ap < 0 ∧
    net_pulse_apical_change alpha_pulse M_pulse beta_relax 1 L_0 L_ap <
      net_pulse_apical_change alpha_pulse M_pulse beta_relax 0 L_0 L_ap ∧
    net_pulse_apical_change alpha_pulse M_pulse beta_relax 0 L_0 L_ap = 0"""^^pk:lean4 ;
        skos:notation "dL_{ap}/dt = -alpha_pulse * M(t) + beta_relax * (1 - r_twist) * (L_0 - L_{ap});  r_twist = 1 => Delta L_net < 0 vs r_twist = 0 recoil" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2014.07.013>,
            <https://doi.org/10.1038/nature07522>,
            <https://doi.org/10.1038/nature13070>,
            <https://doi.org/10.1242/dev.110.1.73>,
            <https://doi.org/10.1242/dev.112.3.775>,
            <https://doi.org/10.1371/journal.pbio.1002292>,
            <https://doi.org/10.1371/journal.pone.0049973> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "2D Incompressible Active Viscous-Vertex Epithelial Cross-Sectional Mechanics & Ratcheted Actomyosin Pulse Dynamics" ;
        pk:leanDeclaration "MathOfBiology.Loop_046.net_pulse_apical_change" ;
        pk:leanTheorem "MathOfBiology.Loop_046.twist_ratcheted_pulse_stepwise_constriction_vs_recoil" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/he-drosophila-ventral-furrow-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Conte, Munoz, Baum & Miodownik (2012) Synergistic Ventral Furrow Invagination Hierarchy" ;
        dct:description "Proves that apical constriction alone yields only a shallow groove (16.5 um), while synergistic combination with basal relaxation (29.5 um) and lateral shortening + ectodermal pushing (41.0 um) is required for full ventral furrow invagination | Variables: phi_ap, phi_ba, phi_lat, phi_ecto: binary/continuous activation indicators for mesodermal apical constriction, basal relaxation, lateral shortening, and ectodermal pushing; D_furrow: ventral furrow invagination depth (um)" ;
        dct:source "Conte, Munoz, Baum & Miodownik (2012) PLoS ONE 7(11):e49973 Figs. 3-6" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L310-L575>,
            <https://github.com/fractastical/morpholib/blob/7e4f207/morphoeval/lean/loops/Loop_046_drosophila_ventral_furrow.lean#L100-L136> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def conte_furrow_depth10 (phi_ap phi_ba phi_lat phi_ecto : Int) : Int :=
  165 * phi_ap + 130 * phi_ap * phi_ba + 85 * phi_ap * phi_ba * phi_lat + 30 * phi_ecto
theorem conte_2012_synergistic_ventral_furrow_invagination :
    depth10_wt_synergy = 410 ∧
    depth10_ap_plus_ba = 295 ∧
    depth10_ap_only = 165 ∧
    depth10_null_control = 0 ∧
    depth10_wt_synergy > depth10_ap_plus_ba ∧
    depth10_ap_plus_ba > depth10_ap_only ∧
    depth10_ap_only > depth10_cta ∧
    depth10_cta > depth10_unratcheted_recoil ∧
    depth10_unratcheted_recoil > depth10_null_control"""^^pk:lean4 ;
        skos:notation "D_WT_synergy (41.0 um) > D_ap_plus_ba (29.5 um) > D_ap_only (16.5 um) > D_cta (14.0 um) > D_unratcheted (3.8 um) > D_null (0.0 um)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2014.07.013>,
            <https://doi.org/10.1038/nature07522>,
            <https://doi.org/10.1038/nature13070>,
            <https://doi.org/10.1242/dev.110.1.73>,
            <https://doi.org/10.1242/dev.112.3.775>,
            <https://doi.org/10.1371/journal.pbio.1002292>,
            <https://doi.org/10.1371/journal.pone.0049973> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "2D Incompressible Active Viscous-Vertex Epithelial Cross-Sectional Mechanics & Ratcheted Actomyosin Pulse Dynamics" ;
        pk:leanDeclaration "MathOfBiology.Loop_046.conte_furrow_depth10" ;
        pk:leanTheorem "MathOfBiology.Loop_046.conte_2012_synergistic_ventral_furrow_invagination" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/he-drosophila-ventral-furrow-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "[Pass 3] Reduced 3D Shell Coupling: AP Curvature & Germband-Extension Tension Reduce Furrow Depth" ;
        dct:description "Proves that both germband-extension AP tension and the polar curvature stiffening of the blastoderm shell strictly reduce the modal furrow depth, which is the mechanism behind the monotone ell_N sweep (ablation ratio 0.53 at ell_N = 150 um) and the anteroposterior taper of the 3D shell profile (k_rel = 1.8 at the mesoderm edges, 13x at the poles). Reduced 1D elastic-line + kinematic (theta x z) sweep, not a 3D finite-element shell. | Variables: D(z): ventral-midline inward furrow depth along the AP axis z; ell_B = (B/k_eq)^(1/4): bending length; ell_N = sqrt(N_GB/k_eq): germband-extension tension length; k_rel(z): curvature-induced Winkler stiffness normalised at the equator; kappa_z, kappa_theta: meridional and hoop curvatures of the prolate ellipsoid (a = 250 um, b = 83.2 um); chi_meso(z): mesoderm primordium indicator over 0.15-0.80 EL; m2 = m^2: squared modal wavenumber" ;
        dct:source "Conte, Munoz, Baum & Miodownik (2012) PLoS ONE 7(11):e49973 (2D driving depth); Sweeton, Parks, Costa & Wieschaus (1991) Development 112:775-789 and Leptin & Grunewald (1990) Development 110:73-84 (furrow AP extent, GBE timing; approximate); Lye et al. (2015) PLoS Biol 13:e1002292 (tissue-scale AP tension during GBE; magnitude not calibrated)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L627-L852>,
            <https://github.com/fractastical/morpholib/blob/7e4f207/morphoeval/lean/loops/Loop_046_drosophila_ventral_furrow.lean#L145-L197> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def modal_shell_stiffness (B N k m2 : Int) : Int :=
  B * m2 * m2 + N * m2 + k
theorem modal_depth_decreases_with_stiffness
    (D1 D2 S1 S2 q : Int) (hS1 : S1 > 0) (hS : S1 < S2) (hD2 : D2 > 0)
    (e1 : D1 * S1 = q) (e2 : D2 * S2 = q) : D2 < D1
theorem ap_tension_and_curvature_stiffening_reduce_furrow_depth
    (B N1 N2 k1 k2 m2 q D0 DN Dk : Int)
    (hB : B ≥ 0) (hm : m2 > 0) (hN1 : N1 ≥ 0) (hN : N1 < N2) (hk1 : k1 > 0) (hkk : k1 < k2)
    (hDN : DN > 0) (hDk : Dk > 0)
    (e0 : D0 * modal_shell_stiffness B N1 k1 m2 = q)
    (eN : DN * modal_shell_stiffness B N2 k1 m2 = q)
    (ek : Dk * modal_shell_stiffness B N1 k2 m2 = q) :
    DN < D0 ∧ Dk < D0"""^^pk:lean4 ;
        skos:notation "ell_B^4 D'''' - ell_N^2 D'' + k_rel(z) D = D_2D(t) chi_meso(z);  k_rel = (kappa_z^2 + kappa_theta^2)(z)/(.)(0);  modal: D_m = q / (B m^4 + N m^2 + k) strictly decreasing in N and in k" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2014.07.013>,
            <https://doi.org/10.1038/nature07522>,
            <https://doi.org/10.1038/nature13070>,
            <https://doi.org/10.1242/dev.110.1.73>,
            <https://doi.org/10.1242/dev.112.3.775>,
            <https://doi.org/10.1371/journal.pbio.1002292>,
            <https://doi.org/10.1371/journal.pone.0049973> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "2D Incompressible Active Viscous-Vertex Epithelial Cross-Sectional Mechanics & Ratcheted Actomyosin Pulse Dynamics" ;
        pk:leanDeclaration "MathOfBiology.Loop_046.modal_shell_stiffness" ;
        pk:leanTheorem "MathOfBiology.Loop_046.ap_tension_and_curvature_stiffening_reduce_furrow_depth" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/he-drosophila-ventral-furrow-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "[Pass 3] Intracellular Stokes Flow: Affine Lengthening Field is Divergence-Free and Carries the Nucleus Basal-ward" ;
        dct:description "Pins the exact uniform-viscosity solution that the variable-viscosity Stokes solver must reproduce (verification L2 error 8e-13 in --self-test) and the sign structure (divergence-free, apex pinned, basal end at -h', strictly basal-ward interior velocity) that makes the resolved nucleus a passive tracer carried toward the basal end (v_nuc / v_cyto = 0.98 vs He et al. 2014 ~ 1) | Variables: psi: stream function on the cell cross-section [-w/2, w/2] x [0, h] (apex pinned at y = h); mu: cytoplasmic viscosity (nucleus = 50x inclusion); eps = h'/h: incompressible lengthening strain rate; u, v: horizontal and apicobasal velocities; affine_u/affine_v: forward-difference lattice velocities" ;
        dct:source "He, Doubrovinski, Polyakov & Wieschaus (2014) Nature 508(7496):392-396 Figs. 1-3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L855-L1083>,
            <https://github.com/fractastical/morpholib/blob/7e4f207/morphoeval/lean/loops/Loop_046_drosophila_ventral_furrow.lean#L199-L242> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def affine_stream_function (eps h x y : Int) : Int := eps * x * (h - y)
def affine_u (eps h x y : Int) : Int :=
  affine_stream_function eps h x (y + 1) - affine_stream_function eps h x y
def affine_v (eps h x y : Int) : Int :=
  -(affine_stream_function eps h (x + 1) y - affine_stream_function eps h x y)
def discrete_divergence (eps h x y : Int) : Int :=
  (affine_u eps h (x + 1) y - affine_u eps h x y) + (affine_v eps h x (y + 1) - affine_v eps h x y)
theorem affine_lengthening_flow_divergence_free_and_basalward
    (eps h x y y' : Int) (heps : eps > 0) (_hy : 0 ≤ y) (hyy : y < y') (hy' : y' < h) :
    discrete_divergence eps h x y = 0 ∧
    affine_v eps h x h = 0 ∧
    affine_v eps h x 0 = -(eps * h) ∧
    affine_v eps h x y < 0 ∧
    affine_v eps h x y < affine_v eps h x y'"""^^pk:lean4 ;
        skos:notation "4 d_xy[mu psi_xy] + (d_xx - d_yy)[mu (psi_xx - psi_yy)] = 0, u = psi_y, v = -psi_x;  uniform mu & affine data => psi = eps x (h - y), div u = 0, v(x,h) = 0, v(x,0) = -eps h = -h', v(x,y) < 0 for y < h" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2014.07.013>,
            <https://doi.org/10.1038/nature07522>,
            <https://doi.org/10.1038/nature13070>,
            <https://doi.org/10.1242/dev.110.1.73>,
            <https://doi.org/10.1242/dev.112.3.775>,
            <https://doi.org/10.1371/journal.pbio.1002292>,
            <https://doi.org/10.1371/journal.pone.0049973> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "2D Incompressible Active Viscous-Vertex Epithelial Cross-Sectional Mechanics & Ratcheted Actomyosin Pulse Dynamics" ;
        pk:leanDeclaration "MathOfBiology.Loop_046.affine_stream_function" ;
        pk:leanTheorem "MathOfBiology.Loop_046.affine_lengthening_flow_divergence_free_and_basalward" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hentschel-tgfb-fibronectin-limb-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Equal-Diffusion (D_a = D_i) & Anti-Fibronectin No-Haptotaxis (chi_F = 0) Negative Controls" ;
        dct:description "Proves that equal morphogen diffusivities abolish the TGF-beta chemical prepattern and that blocking fibronectin haptotaxis (χ_F = 0, e.g. anti-fibronectin antibody or RGD peptide) abolishes mesenchymal cell condensation | Variables: c_a: activator TGF-beta concentration; c_i: FGF-dependent inhibitor concentration; R: mesenchymal cell density; χ_F: fibronectin haptotactic sensitivity; D_R: cell random motility" ;
        dct:source "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B 271(1549):1713-1722 Eqs. (2.1)-(3.6); Kiskowski et al. (2004) Dev. Biol. 271(2):372-387" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L185-L266>,
            <https://github.com/fractastical/morpholib/blob/58b898c/morphoeval/lean/loops/Loop_014_tgfb_fibronectin_limb.lean#L21-L55> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def tgfb_modal_trace_eq_diff (tr_J0 Dq : Int) : Int := tr_J0 - 2 * Dq
def tgfb_modal_det_eq_diff (det_J0 neg_tr_Dq Dq_sq : Int) : Int :=
  det_J0 + neg_tr_Dq + Dq_sq
def sigma_R_no_hapto (D_R_q r_R : Int) : Int := -D_R_q - r_R
theorem hentschel_tgfb_inhibitor_haptotaxis_stability_controls
    (tr_J0 det_J0 Dq neg_tr_Dq Dq_sq D_R_q r_R : Int)
    (htr : tr_J0 < 0) (hdet : det_J0 > 0)
    (hDq : Dq ≥ 0) (hterm : neg_tr_Dq ≥ 0) (hsq : Dq_sq ≥ 0)
    (hDR : D_R_q ≥ 0) (hr : r_R > 0) :
    tgfb_modal_trace_eq_diff tr_J0 Dq < 0 ∧
    tgfb_modal_det_eq_diff det_J0 neg_tr_Dq Dq_sq > 0 ∧
    sigma_R_no_hapto D_R_q r_R < 0 := by
  unfold tgfb_modal_trace_eq_diff tgfb_modal_det_eq_diff sigma_R_no_hapto; omega
"""^^pk:lean4 ;
        skos:notation "tr(J_0) < 0 ∧ det(J_0) > 0 ∧ D_a = D_i = D ≥ 1 ∧ χ_F = 0 ⟹ ∀ q = k^2 ≥ 0, tr(J_k) < 0 ∧ det(J_k) > 0 ∧ σ_R(q; χ_F=0) = -D_R q - r_R < 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/aama.2001.0721>,
            <https://doi.org/10.1006/jtbi.1996.0237>,
            <https://doi.org/10.1016/j.cpc.2010.12.011>,
            <https://doi.org/10.1016/j.jtbi.2005.10.016>,
            <https://doi.org/10.1016/j.ydbio.2004.03.038>,
            <https://doi.org/10.1098/rsif.2005.0033>,
            <https://doi.org/10.1098/rspb.2004.2772>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1186/1752-0509-1-16> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Multiscale Reactor-Mechanochemical Limb" ;
        pk:leanDeclaration "MathOfBiology.Loop_014.sigma_R_no_hapto" ;
        pk:leanTheorem "MathOfBiology.Loop_014.hentschel_tgfb_inhibitor_haptotaxis_stability_controls" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hentschel-tgfb-fibronectin-limb-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "AER-FGF Zonation & Proximodistal 1 -> 2 -> 3 -> 4 Skeletal Mode Transition" ;
        dct:description "Proves that proximodistal AER-FGF zonation monotonically increases the unstable anteroposterior wavenumber across stylopod (m=1 humerus), zeugopod (m=2 radius+ulna), chick wing autopod (m=3 digits II-IV), and hindlimb/exogenous-TGF-beta autopod (m=4 digits I-IV) | Variables: c_FGF(z): distal AER fibroblast growth factor concentration; f_a(c_FGF) ∈ {3, 6, 11, 18}: FGF-modulated TGF-beta self-activation rate; m ∈ {1, 2, 3, 4}: anteroposterior skeletal condensation count" ;
        dct:source "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B 271(1549):1713-1722 Eqs. (3.1)-(3.12) & Figs. 2-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L271-L536>,
            <https://github.com/fractastical/morpholib/blob/58b898c/morphoeval/lean/loops/Loop_014_tgfb_fibronectin_limb.lean#L62-L96> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def hentschel_trace_J0 (fa : Int) : Int := fa - 200
def hentschel_mode_sq (fa : Int) : Int := fa - 2
theorem hentschel_fgf_zonation_proximodistal_mode_transition (fa1 fa2 : Int)
    (h12 : fa1 < fa2) (h2 : fa2 < 200) :
    hentschel_mode_sq fa1 < hentschel_mode_sq fa2 ∧
    hentschel_trace_J0 fa2 < 0 ∧
    hentschel_mode_sq 3 = 1 * 1 ∧
    hentschel_mode_sq 6 = 2 * 2 ∧
    hentschel_mode_sq 11 = 3 * 3 ∧
    hentschel_mode_sq 18 = 4 * 4 := by
  unfold hentschel_mode_sq hentschel_trace_J0; omega
"""^^pk:lean4 ;
        skos:notation "∂_t c_a = f_a(c_FGF) c_a + f_i c_i - c_a^3 + D_a ∇^2 c_a;  m^2(f_a) = (D_i f_a + D_a g_i) / (2 D_a D_i) = f_a - 2 ∈ {1^2, 2^2, 3^2, 4^2}" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/aama.2001.0721>,
            <https://doi.org/10.1006/jtbi.1996.0237>,
            <https://doi.org/10.1016/j.cpc.2010.12.011>,
            <https://doi.org/10.1016/j.jtbi.2005.10.016>,
            <https://doi.org/10.1016/j.ydbio.2004.03.038>,
            <https://doi.org/10.1098/rsif.2005.0033>,
            <https://doi.org/10.1098/rspb.2004.2772>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1186/1752-0509-1-16> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Multiscale Reactor-Mechanochemical Limb" ;
        pk:leanDeclaration "MathOfBiology.Loop_014.hentschel_mode_sq" ;
        pk:leanTheorem "MathOfBiology.Loop_014.hentschel_fgf_zonation_proximodistal_mode_transition" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hentschel-tgfb-fibronectin-limb-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Fibronectin Haptotactic Positive-Feedback Amplification & Micromass Spot/Stripe Morphospace" ;
        dct:description "Proves that positive feedback between TGF-beta-stimulated fibronectin secretion and upward mesenchymal haptotaxis amplifies prechondrogenic cell condensations above random cell diffusion and governs the 2D micromass nodular-spot vs labyrinthine-stripe morphospace | Variables: F(x,z,t): extracellular matrix fibronectin concentration; R_2(c_a,R): FGF/TGF-beta-differentiated prechondrogenic cell density; χ_F S_F: effective haptotactic sensitivity" ;
        dct:source "Hentschel et al. (2004) Proc. R. Soc. B 271:1713-1722 Eqs. (2.4)-(2.9); Kiskowski et al. (2004) Dev. Biol. 271:372-387; Miura & Shiota (2000) Dev. Dyn. 217:241-249" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L271-L644>,
            <https://github.com/fractastical/morpholib/blob/58b898c/morphoeval/lean/loops/Loop_014_tgfb_fibronectin_limb.lean#L103-L130> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def hapto_net_flux (chi_F_SF D_R q : Int) : Int := (chi_F_SF - D_R) * q
theorem hentschel_kiskowski_fibronectin_haptotaxis_amplification
    (chi_F_SF D_R q : Int)
    (hchi : chi_F_SF > D_R) (hDR : D_R ≥ 0) (hq : q ≥ 1) :
    hapto_net_flux chi_F_SF D_R q > 0 ∧
    hapto_net_flux 0 D_R q ≤ 0 ∧
    hapto_net_flux chi_F_SF D_R q > hapto_net_flux 0 D_R q := by
  unfold hapto_net_flux
  have hdiff : chi_F_SF - D_R ≥ 1 := by omega
  have hpos : (chi_F_SF - D_R) * q ≥ 1 * 1 := Int.mul_le_mul hdiff hq (by omega) (by omega)
  have hneg : (0 - D_R) * q ≤ 0 := Int.mul_nonpos_of_nonpos_of_nonneg (by omega) (by omega)
  omega
"""^^pk:lean4 ;
        skos:notation "∂_t F = k_F c_a^+ R_2 - γ_F F,  ∂_t R = D_R ∇^2 R - χ_F ∇·(R ∇F) + r_R R(1 - R);  J_hapto(q) = (χ_F S_F - D_R) q > 0 for χ_F S_F > D_R" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/aama.2001.0721>,
            <https://doi.org/10.1006/jtbi.1996.0237>,
            <https://doi.org/10.1016/j.cpc.2010.12.011>,
            <https://doi.org/10.1016/j.jtbi.2005.10.016>,
            <https://doi.org/10.1016/j.ydbio.2004.03.038>,
            <https://doi.org/10.1098/rsif.2005.0033>,
            <https://doi.org/10.1098/rspb.2004.2772>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1186/1752-0509-1-16> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Multiscale Reactor-Mechanochemical Limb" ;
        pk:leanDeclaration "MathOfBiology.Loop_014.hapto_net_flux" ;
        pk:leanTheorem "MathOfBiology.Loop_014.hentschel_kiskowski_fibronectin_haptotaxis_amplification" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hentschel-tgfb-fibronectin-limb-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Glazier-Graner-Hogeweg Differential-Adhesion Sorting Condition (Pass 3 discrete cell lattice)" ;
        dct:description "Proves that the Graner-Glazier contact energies give a positive heterotypic surface tension so R2 prechondrogenic cells sort into compact condensations inside the continuum TGF-beta prepattern, and that the no-differential-adhesion ablation (equal J) removes the sorting drive — the mechanism behind the WT > DA-only > haptotaxis-only > ablation condensation-index ordering and the WT < ablation heterotypic boundary fraction in simulate_ggh_cellular_potts_condensation | Variables: σ_i: cell index at lattice site i; τ: cell type (R1 mesenchyme, R2 TGF-beta-activated prechondrogenic, M medium); J_ll = J_R1R1 = 14, J_dd = J_R2R2 = 2, J_ld = J_R1R2 = 11, J_cM = 16 (Graner & Glazier 1992); λ_V = 6 volume-constraint stiffness; V_T = 25 px target cell area" ;
        dct:source "Graner F, Glazier JA (1992) Phys. Rev. Lett. 69(13):2013-2016 doi:10.1103/PhysRevLett.69.2013; Glazier JA, Graner F (1993) Phys. Rev. E 47(3):2128-2154 doi:10.1103/PhysRevE.47.2128; Kiskowski et al. (2004) Dev. Biol. 271:372-387; Chaturvedi et al. (2005) J. R. Soc. Interface 2:237-253" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L649-L862>,
            <https://github.com/fractastical/morpholib/blob/58b898c/morphoeval/lean/loops/Loop_014_tgfb_fibronectin_limb.lean#L131-L163> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def ggh_hetero_surface_tension2 (J_ll J_dd J_ld : Int) : Int := 2 * J_ld - J_ll - J_dd
def ggh_sorting_swap_dH (J_ll J_dd J_ld : Int) : Int := (J_ll + J_dd) - 2 * J_ld
theorem ggh_differential_adhesion_sorting_condition (J_ll J_dd J_ld J : Int)
    (hsort : 2 * J_ld > J_ll + J_dd) :
    ggh_sorting_swap_dH J_ll J_dd J_ld < 0 ∧
    ggh_hetero_surface_tension2 J_ll J_dd J_ld > 0 ∧
    ggh_sorting_swap_dH 14 2 11 = -6 ∧
    ggh_hetero_surface_tension2 14 2 11 = 6 ∧
    ggh_sorting_swap_dH J J J = 0 ∧
    ggh_hetero_surface_tension2 J J J = 0 := by
  unfold ggh_sorting_swap_dH ggh_hetero_surface_tension2; omega
"""^^pk:lean4 ;
        skos:notation "H = Σ_<ij> J(τ_i, τ_j)(1 - δ_{σ_i σ_j}) + λ_V Σ_σ (v_σ - V_T)^2;  2 J_ld > J_ll + J_dd ⟹ ΔH_swap = (J_ll + J_dd) - 2 J_ld < 0;  (14, 2, 11) ⟹ ΔH_swap = -6;  J_ll = J_dd = J_ld ⟹ ΔH_swap = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/aama.2001.0721>,
            <https://doi.org/10.1006/jtbi.1996.0237>,
            <https://doi.org/10.1016/j.cpc.2010.12.011>,
            <https://doi.org/10.1016/j.jtbi.2005.10.016>,
            <https://doi.org/10.1016/j.ydbio.2004.03.038>,
            <https://doi.org/10.1098/rsif.2005.0033>,
            <https://doi.org/10.1098/rspb.2004.2772>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1186/1752-0509-1-16> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Multiscale Reactor-Mechanochemical Limb" ;
        pk:leanDeclaration "MathOfBiology.Loop_014.ggh_sorting_swap_dH" ;
        pk:leanTheorem "MathOfBiology.Loop_014.ggh_differential_adhesion_sorting_condition" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hentschel-tgfb-fibronectin-limb-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Metropolis Haptotactic Acceptance in the Coupled GGH Cell Lattice (Pass 3)" ;
        dct:description "Proves the acceptance logic of the haptotaxis copy-energy term coupling the discrete cells to the continuum-derived fibronectin field: up-gradient extensions with sufficient haptotactic gain are accepted deterministically, and the anti-fibronectin ablation μ_F = 0 reduces the model to adhesion + volume dynamics (the da_only regime); the discrete counterpart of the continuum haptotactic flux law (Law 3) | Variables: F(x): cell-deposited fibronectin on the lattice (dF/dt = k_F c_a^+ R_2^disc - γ_F F); dF = F(target) - F(source) for a copy attempt; μ_F = 10 haptotaxis copy-energy strength; ΔH_adh, ΔH_vol: adhesion and volume-constraint energy changes; T = 10 Metropolis temperature" ;
        dct:source "Savill NJ, Hogeweg P (1997) J. Theor. Biol. 184(3):229-235 doi:10.1006/jtbi.1996.0237; Graner & Glazier (1992) PRL 69:2013 (Metropolis rule); Kiskowski et al. (2004) Dev. Biol. 271:372-387 (cell-fibronectin coupling)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L786-L824>,
            <https://github.com/fractastical/morpholib/blob/58b898c/morphoeval/lean/loops/Loop_014_tgfb_fibronectin_limb.lean#L166-L191> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def ggh_total_dH (dH_adh dH_vol mu_F dF : Int) : Int := dH_adh + dH_vol - mu_F * dF
theorem ggh_metropolis_haptotaxis_acceptance (dH_adh dH_vol mu_F dF : Int)
    (hmu : mu_F ≥ 1) (hdF : dF ≥ 1) (hpen : dH_adh + dH_vol ≤ mu_F * dF) :
    ggh_total_dH dH_adh dH_vol mu_F dF ≤ 0 ∧
    ggh_total_dH dH_adh dH_vol 0 dF = dH_adh + dH_vol ∧
    ggh_total_dH dH_adh dH_vol mu_F dF < ggh_total_dH dH_adh dH_vol 0 dF := by
  unfold ggh_total_dH
  have hpos : mu_F * dF ≥ 1 * 1 := Int.mul_le_mul hmu hdF (by omega) (by omega)
  omega
"""^^pk:lean4 ;
        skos:notation "ΔH = ΔH_adh + ΔH_vol - μ_F (F(target) - F(source));  P_accept = 1 if ΔH ≤ 0 else exp(-ΔH/T);  μ_F dF ≥ ΔH_adh + ΔH_vol ⟹ ΔH ≤ 0 (accepted w.p. 1);  μ_F = 0 ⟹ ΔH = ΔH_adh + ΔH_vol" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/aama.2001.0721>,
            <https://doi.org/10.1006/jtbi.1996.0237>,
            <https://doi.org/10.1016/j.cpc.2010.12.011>,
            <https://doi.org/10.1016/j.jtbi.2005.10.016>,
            <https://doi.org/10.1016/j.ydbio.2004.03.038>,
            <https://doi.org/10.1098/rsif.2005.0033>,
            <https://doi.org/10.1098/rspb.2004.2772>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1186/1752-0509-1-16> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Multiscale Reactor-Mechanochemical Limb" ;
        pk:leanDeclaration "MathOfBiology.Loop_014.ggh_total_dH" ;
        pk:leanTheorem "MathOfBiology.Loop_014.ggh_metropolis_haptotaxis_acceptance" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hoffmann-wing-venation-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Wing Vein Polygonal Cell Area & Isoperimetric Circularity Law" ;
        dct:description "Quantifies primary vs. secondary insect wing venation domain geometry and cell shape distributions | Variables: (x_k, y_k): ordered polygon vertices of wing cell i; A_i: polygon area; P_i: perimeter; C_i: isoperimetric circularity" ;
        dct:source "Hoffmann, Donoughe et al. (2018) PNAS 115(40):9905-9910" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7a781325/2018-hoffmann-wing-venation.py#L60-L180>,
            <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/lean/MathOfBiology.lean#L311-L319> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def shoelace_edge_term (xk yk xk1 yk1 : Int) : Int := xk * yk1 - xk1 * yk
theorem hoffmann_shoelace_antisymmetric (xk yk xk1 yk1 : Int) :
    shoelace_edge_term xk1 yk1 xk yk = - shoelace_edge_term xk yk xk1 yk1 := by
  simp [shoelace_edge_term, Int.neg_sub]"""^^pk:lean4 ;
        skos:notation "A_i = (1/2) |∑_{k=1}^m (x_k y_{k+1} - x_{k+1} y_k)|,   C_i = 4π A_i / P_i^2 ∈ (0, 1]" ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Planar Straight-Line Graph (PSLG) Polygonal Tessellation Geometry" ;
        pk:leanDeclaration "MathOfBiology.shoelace_edge_term" ;
        pk:leanTheorem "MathOfBiology.hoffmann_shoelace_antisymmetric" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/honda-dichotomous-tree-branching-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Honda (1971) Binary Dichotomous Tip Doubling & Total Internode Geometric Sum" ;
        dct:description "Governs exponential expansion of terminal leaf-cluster tips and total woody internode count across recursive dichotomous branching generations | Variables: k: branching generation order (0 = trunk); N_tips(k): number of terminal leaf-bearing twigs at order k; N_total(k): cumulative woody internodes across orders 0..k" ;
        dct:source "Honda (1971) J. Theor. Biol. 31(2):331-338" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L129-L291>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_051_dichotomous_tree_branching.lean#L25-L45> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def honda_tips : Nat → Nat
  | 0 => 1
  | k + 1 => 2 * honda_tips k
def honda_total_internodes : Nat → Nat
  | 0 => 1
  | k + 1 => honda_total_internodes k + honda_tips (k + 1)
theorem honda_1971_dichotomous_tip_and_internode_identity (k : Nat) :
    honda_tips (k + 1) = 2 * honda_tips k ∧
    honda_total_internodes k + 1 = 2 * honda_tips k := by
  refine ⟨rfl, ?_⟩
  induction k with
  | zero => rfl
  | succ n ih => dsimp [honda_total_internodes, honda_tips]; omega
"""^^pk:lean4 ;
        skos:notation "N_tips(k+1) = 2 N_tips(k) = 2^{k+1},   N_total(k) = ∑_{j=0}^k 2^j = 2^{k+1} - 1" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/j.1537-2197.1979.tb06267.x>,
            <https://doi.org/10.1007/978-1-4612-1626-1>,
            <https://doi.org/10.1016/0022-5193(71)90031-2>,
            <https://doi.org/10.1016/0038-092X(69)90047-4>,
            <https://doi.org/10.1093/aob/mci052>,
            <https://doi.org/10.1103/PhysRevLett.107.258101>,
            <https://doi.org/10.1126/science.199.4331.888>,
            <https://doi.org/10.18960/seitai.14.3_97> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "3D Recursive Dichotomous Tree Vector Rotation, Effective Canopy Leaf Area Optimization & Leonardo da Vinci Pipe-Model Area Conservation" ;
        pk:leanDeclaration "MathOfBiology.Loop_051.honda_tips" ;
        pk:leanTheorem "MathOfBiology.Loop_051.honda_1971_dichotomous_tip_and_internode_identity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/honda-dichotomous-tree-branching-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Leonardo da Vinci / Shinozaki (1964) / Eloy (2011) Pipe-Model Cross-Sectional Area Invariance" ;
        dct:description "Conserves total vascular sapwood cross-sectional area across every dichotomous fork and insures uniform wind-induced bending stress across self-similar tree crowns | Variables: d_parent: mother internode diameter; d_1, d_2: daughter branch diameters; Δ ≈ 2.0: Leonardo/Shinozaki sapwood area exponent" ;
        dct:source "Shinozaki et al. (1964) Jpn. J. Ecol. 14(3):97-105; Eloy (2011) Phys. Rev. Lett. 107(25):258101" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L150-L261>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_051_dichotomous_tree_branching.lean#L59-L72> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def pipe_area_sq (d : Int) : Int := d * d
theorem leonardo_shinozaki_pipe_area_invariance
    (a0 a1 a2 a11 a12 a21 a22 d : Int)
    (h_gen1 : a0 = a1 + a2) (h_left : a1 = a11 + a12) (h_right : a2 = a21 + a22) :
    a11 + a12 + a21 + a22 = a0 ∧
    pipe_area_sq d + pipe_area_sq d = 2 * pipe_area_sq d := by
  refine ⟨?_, ?_⟩
  · omega
  · dsimp [pipe_area_sq]; omega
"""^^pk:lean4 ;
        skos:notation "d_parent^Δ = d_1^Δ + d_2^Δ  (Δ = 2) ⟹ ∑_{i=1}^{2^k} d_{k,i}^2 = d_trunk^2" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/j.1537-2197.1979.tb06267.x>,
            <https://doi.org/10.1007/978-1-4612-1626-1>,
            <https://doi.org/10.1016/0022-5193(71)90031-2>,
            <https://doi.org/10.1016/0038-092X(69)90047-4>,
            <https://doi.org/10.1093/aob/mci052>,
            <https://doi.org/10.1103/PhysRevLett.107.258101>,
            <https://doi.org/10.1126/science.199.4331.888>,
            <https://doi.org/10.18960/seitai.14.3_97> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "3D Recursive Dichotomous Tree Vector Rotation, Effective Canopy Leaf Area Optimization & Leonardo da Vinci Pipe-Model Area Conservation" ;
        pk:leanDeclaration "MathOfBiology.Loop_051.pipe_area_sq" ;
        pk:leanTheorem "MathOfBiology.Loop_051.leonardo_shinozaki_pipe_area_invariance" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/honda-dichotomous-tree-branching-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Honda & Fisher (1978) Daughter Divergence Angle Separation & Self-Shading Avoidance Law" ;
        dct:description "Proves that non-zero asymmetric daughter divergence angles (θ_1 ≈ 26-30°, θ_2 ≈ 56-60° in Cornus controversa and Terminalia catappa) prevent terminal leaf-cluster superposition and maximize light interception | Variables: θ_1, θ_2: sister branch divergence angles from parent internode axis; L_1 = r_1 L_0, L_2 = r_2 L_0: sister internode lengths; A_eff / A_total: projected non-overlapping effective leaf area ratio" ;
        dct:source "Honda & Fisher (1978) Science 199(4331):888-890; Fisher & Honda (1979) Am. J. Bot. 66(6):633-644" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L294-L470>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_051_dichotomous_tree_branching.lean#L90-L127> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def sister_tip_transverse_sep (L1 L2 sin_theta1 sin_theta2 : Int) : Int :=
  L1 * sin_theta1 + L2 * sin_theta2
def sister_pair_effective_area (A_cluster c_sep sep : Int) : Int :=
  A_cluster + c_sep * sep
theorem honda_fisher_1978_divergence_avoids_self_shading
    (L1 L2 sin_theta1 sin_theta2 A_cluster c_sep : Int)
    (hL1 : 0 < L1) (hL2 : 0 < L2) (ht1 : 0 < sin_theta1) (ht2 : 0 < sin_theta2)
    (hA : 0 < A_cluster) (hc : 0 < c_sep) :
    sister_tip_transverse_sep L1 L2 0 0 = 0 ∧
    0 < sister_tip_transverse_sep L1 L2 sin_theta1 sin_theta2 := by
  refine ⟨by dsimp [sister_tip_transverse_sep]; omega, ?_⟩
  dsimp [sister_tip_transverse_sep]
  have h1 : 0 < L1 * sin_theta1 := Int.mul_pos hL1 ht1
  have h2 : 0 < L2 * sin_theta2 := Int.mul_pos hL2 ht2
  omega
"""^^pk:lean4 ;
        skos:notation "(θ_1, θ_2)^* = argmax_{(θ_1, θ_2)} A_eff(θ_1, θ_2) / A_total,   A_eff(0, 0) ≪ A_eff(θ_1^*, θ_2^*)" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/j.1537-2197.1979.tb06267.x>,
            <https://doi.org/10.1007/978-1-4612-1626-1>,
            <https://doi.org/10.1016/0022-5193(71)90031-2>,
            <https://doi.org/10.1016/0038-092X(69)90047-4>,
            <https://doi.org/10.1093/aob/mci052>,
            <https://doi.org/10.1103/PhysRevLett.107.258101>,
            <https://doi.org/10.1126/science.199.4331.888>,
            <https://doi.org/10.18960/seitai.14.3_97> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "3D Recursive Dichotomous Tree Vector Rotation, Effective Canopy Leaf Area Optimization & Leonardo da Vinci Pipe-Model Area Conservation" ;
        pk:leanDeclaration "MathOfBiology.Loop_051.sister_tip_transverse_sep" ;
        pk:leanTheorem "MathOfBiology.Loop_051.honda_fisher_1978_divergence_avoids_self_shading" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/honda-dichotomous-tree-branching-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pass 3 — Solar-Elevation Tier Shadow Displacement & Latitude-Dependent Tier Spacing Threshold" ;
        dct:description "Governs tier-on-tier self-shading in the Pass 3 ray tracer: lower (temperate) sun displaces upper-tier shadows further, so the spacing needed to clear self-shading is largest under a high equatorial sun (ray-traced s_90/R = 1.83 at 0° vs 0.97 at 45°) | Variables: Δz = s: vertical tier spacing; h: solar elevation (φ latitude, δ Cooper (1969) declination, H hour angle); R: tier radius; offset: horizontal displacement of the upper tier's shadow on the lower tier plane" ;
        dct:source "Campbell & Norman (1998) An Introduction to Environmental Biophysics, Ch. 11 (DOI 10.1007/978-1-4612-1626-1); Cooper (1969) Solar Energy 12(3):333-346" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L473-L785>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_051_dichotomous_tree_branching.lean#L130-L166> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def tier_shadow_offset (dz cot_h : Int) : Int := dz * cot_h
def tiers_shadow_clear (dz cot_h R : Int) : Prop := 2 * R ≤ tier_shadow_offset dz cot_h
theorem solar_tier_shadow_offset_monotone
    (dz k cot_lo cot_hi R : Int) (hdz : 0 ≤ dz) (hcot : cot_lo ≤ cot_hi) :
    tier_shadow_offset (k * dz) cot_lo = k * tier_shadow_offset dz cot_lo ∧
    tier_shadow_offset dz cot_lo ≤ tier_shadow_offset dz cot_hi ∧
    (tiers_shadow_clear dz cot_lo R → tiers_shadow_clear dz cot_hi R) := by
  refine ⟨?_, ?_, ?_⟩
  · dsimp [tier_shadow_offset]; exact Int.mul_assoc k dz cot_lo
  · dsimp [tier_shadow_offset]; exact Int.mul_le_mul_of_nonneg_left hcot hdz
  · intro hclear
    dsimp [tiers_shadow_clear, tier_shadow_offset] at hclear ⊢
    have hmono : dz * cot_lo ≤ dz * cot_hi := Int.mul_le_mul_of_nonneg_left hcot hdz
    omega
"""^^pk:lean4 ;
        skos:notation "offset(Δz, h) = Δz·cot h;  tiers clear ⟺ 2R ≤ Δz·cot h;  sin h = sin φ sin δ + cos φ cos δ cos H;  cot_lo ≤ cot_hi ⟹ clear(Δz, cot_lo) → clear(Δz, cot_hi)" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/j.1537-2197.1979.tb06267.x>,
            <https://doi.org/10.1007/978-1-4612-1626-1>,
            <https://doi.org/10.1016/0022-5193(71)90031-2>,
            <https://doi.org/10.1016/0038-092X(69)90047-4>,
            <https://doi.org/10.1093/aob/mci052>,
            <https://doi.org/10.1103/PhysRevLett.107.258101>,
            <https://doi.org/10.1126/science.199.4331.888>,
            <https://doi.org/10.18960/seitai.14.3_97> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "3D Recursive Dichotomous Tree Vector Rotation, Effective Canopy Leaf Area Optimization & Leonardo da Vinci Pipe-Model Area Conservation" ;
        pk:leanDeclaration "MathOfBiology.Loop_051.tier_shadow_offset" ;
        pk:leanTheorem "MathOfBiology.Loop_051.solar_tier_shadow_offset_monotone" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/honda-dichotomous-tree-branching-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pass 3 — Monsi & Saeki (1953) Beer-Lambert Optical Depth Through Stacked Tiers" ;
        dct:description "Attenuates the direct beam through every intercepted tier in ray_trace_tiered_crown_interception; the τ_c = 1 transparent ablation must return crown capture efficiency E = 1 exactly (self-test suite 8) | Variables: n: number of upper tiers overlapping a lower-tier cell along the beam; τ_c = exp(-LAI_c) = 0.135 per-tier beam transmittance (LAI_c = 2); K = 1 extinction coefficient for horizontal leaves" ;
        dct:source "Monsi & Saeki (1953) Jpn. J. Bot. 14:22-52 (English translation Ann. Bot. 95(3):549-567, 2005, DOI 10.1093/aob/mci052)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/1976-honda-dichotomous-tree-branching.py#L643-L693>,
            <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_051_dichotomous_tree_branching.lean#L169-L198> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def stacked_tier_optical_depth (d : Nat) : Nat → Nat
  | 0 => 0
  | n + 1 => stacked_tier_optical_depth d n + d
theorem beer_lambert_stacked_tier_optical_depth (d n : Nat) :
    stacked_tier_optical_depth d (n + 1) = stacked_tier_optical_depth d n + d ∧
    (0 < d → stacked_tier_optical_depth d n < stacked_tier_optical_depth d (n + 1)) ∧
    stacked_tier_optical_depth 0 n = 0 := by
  refine ⟨rfl, ?_, ?_⟩
  · intro hd; dsimp [stacked_tier_optical_depth]; omega
  · induction n with
    | zero => rfl
    | succ m ih => dsimp [stacked_tier_optical_depth]; omega
"""^^pk:lean4 ;
        skos:notation "I_n / I_0 = τ_c^n = exp(-n K LAI_c),  K = 1 (horizontal leaves);  depth(n+1) = depth(n) + K·LAI_c;  depth(n) = 0 when τ_c = 1" ;
        prov:wasDerivedFrom <https://doi.org/10.1002/j.1537-2197.1979.tb06267.x>,
            <https://doi.org/10.1007/978-1-4612-1626-1>,
            <https://doi.org/10.1016/0022-5193(71)90031-2>,
            <https://doi.org/10.1016/0038-092X(69)90047-4>,
            <https://doi.org/10.1093/aob/mci052>,
            <https://doi.org/10.1103/PhysRevLett.107.258101>,
            <https://doi.org/10.1126/science.199.4331.888>,
            <https://doi.org/10.18960/seitai.14.3_97> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "3D Recursive Dichotomous Tree Vector Rotation, Effective Canopy Leaf Area Optimization & Leonardo da Vinci Pipe-Model Area Conservation" ;
        pk:leanDeclaration "MathOfBiology.Loop_051.stacked_tier_optical_depth" ;
        pk:leanTheorem "MathOfBiology.Loop_051.beer_lambert_stacked_tier_optical_depth" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hubaud-yap-excitable-segmentation-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hubaud et al. (2017) FitzHugh-Nagumo Cubic Fast Nullcline Extrema & Barrier Law" ;
        dct:description "Defines the N-shaped folded cubic nullcline knees at u = +/- 1 that separate monostable excitable quiescence (|u^*| > 1) from autonomous relaxation oscillations (|u^*| < 1) | Variables: u: fast activator (Notch / LuVeLu Lfng-Venus / Hes7 activity); v: slow negative-feedback recovery variable; f(u) = u - u^3/3: cubic fast nullcline nonlinearity" ;
        dct:source "Hubaud, Regev, Mahadevan & Pourquie (2017) Cell 171(3):668-682 Fig. 3 & STAR Methods" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L171-L256>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_027_yap_excitable_segmentation.lean#L22-L49> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def fhn_cubic_scaled (u : Int) : Int :=
  3 * u - u * u * u
def fhn_cubic_deriv (u : Int) : Int :=
  1 - u * u
theorem hubaud_2017_fhn_cubic_nullcline_extrema :
    fhn_cubic_deriv 1 = 0 ∧
    fhn_cubic_deriv (-1) = 0 ∧
    fhn_cubic_deriv 0 = 1 ∧
    fhn_cubic_scaled 1 - fhn_cubic_scaled (-1) = 4"""^^pk:lean4 ;
        skos:notation "f(u) = u - u^3 / 3,  f'(u) = 1 - u^2 = 0 at u = +/- 1,  Delta_f = f(+1) - f(-1) = 4/3" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0006-3495(61)86902-6>,
            <https://doi.org/10.1016/S0022-5193(76)80131-2>,
            <https://doi.org/10.1016/S0092-8674(01)00437-8>,
            <https://doi.org/10.1016/j.cell.2017.08.043>,
            <https://doi.org/10.1038/nature07020>,
            <https://doi.org/10.1038/nature10137>,
            <https://doi.org/10.1038/nature11804>,
            <https://doi.org/10.1242/dev.070987> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Excitable FitzHugh-Nagumo Somite Clock Gated by YAP Mechanotransduction" ;
        pk:leanDeclaration "MathOfBiology.Loop_027.fhn_cubic_deriv" ;
        pk:leanTheorem "MathOfBiology.Loop_027.hubaud_2017_fhn_cubic_nullcline_extrema" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hubaud-yap-excitable-segmentation-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hubaud et al. (2017) Supercritical Hopf Stability Boundary vs Quiescent Branch Law" ;
        dct:description "Proves that the fixed point is unstable (Tr J > 0, autonomous limit cycle) on the middle branch |u^*| < sqrt(1 - epsilon*b) and stable (Tr J < 0, excitable quiescent) on the outer branches |u^*| >= 1 | Variables: u^*: nullcline intersection fixed point; epsilon = tau_u / tau_v: fast-slow timescale ratio (0.08); b: slow recovery damping parameter (0.8)" ;
        dct:source "Hubaud, Regev, Mahadevan & Pourquie (2017) Cell 171(3):668-682 Figs. 3-4 & STAR Methods" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L204-L380>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_027_yap_excitable_segmentation.lean#L51-L75> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def fhn_jacobian_trace (M eps_b u_sq : Int) : Int :=
  M * (1 - u_sq) - eps_b
theorem hubaud_2017_hopf_vs_quiescent_stability (M eps_b : Int)
    (h_pos : 0 < eps_b) (h_fast_slow : eps_b < M) :
    fhn_jacobian_trace M eps_b 0 > 0 ∧
    fhn_jacobian_trace M eps_b 1 < 0"""^^pk:lean4 ;
        skos:notation "Tr(tau_u * J(u^*)) = 1 - (u^*)^2 - epsilon * b,  |u_H| = sqrt(1 - epsilon * b)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0006-3495(61)86902-6>,
            <https://doi.org/10.1016/S0022-5193(76)80131-2>,
            <https://doi.org/10.1016/S0092-8674(01)00437-8>,
            <https://doi.org/10.1016/j.cell.2017.08.043>,
            <https://doi.org/10.1038/nature07020>,
            <https://doi.org/10.1038/nature10137>,
            <https://doi.org/10.1038/nature11804>,
            <https://doi.org/10.1242/dev.070987> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Excitable FitzHugh-Nagumo Somite Clock Gated by YAP Mechanotransduction" ;
        pk:leanDeclaration "MathOfBiology.Loop_027.fhn_jacobian_trace" ;
        pk:leanTheorem "MathOfBiology.Loop_027.hubaud_2017_hopf_vs_quiescent_stability" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hubaud-yap-excitable-segmentation-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hubaud et al. (2017) YAP Mechanotransduction Excitability Gating & Latrunculin A Rescue Law" ;
        dct:description "Proves that inhibiting nuclear YAP (Latrunculin A, Y-27632 Rockout, soft substrate, Yap1 KO) raises I_eff across the Hopf threshold to ignite autonomous Hes7/Lfng oscillations, whereas Yap5SA locks quiescence | Variables: I_eff: net excitability current; Y_nuc: nuclear YAP translocation fraction [0, 1]; J_Dll1: Notch-Dll1 intercellular coupling input; gamma_YAP: YAP excitability threshold gain" ;
        dct:source "Hubaud, Regev, Mahadevan & Pourquie (2017) Cell 171(3):668-682 Figs. 4-6" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L191-L498>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_027_yap_excitable_segmentation.lean#L77-L98> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def yap_effective_current (I_basal J_Dll1 gamma_YAP Y_nuc : Int) : Int :=
  I_basal + J_Dll1 - gamma_YAP * Y_nuc
theorem hubaud_2017_latrunculin_yap_inhibition_rescue
    (I_basal J_Dll1 gamma_YAP Y_high delta_Y : Int) :
    yap_effective_current I_basal J_Dll1 gamma_YAP (Y_high - delta_Y) -
      yap_effective_current I_basal J_Dll1 gamma_YAP Y_high =
      gamma_YAP * delta_Y"""^^pk:lean4 ;
        skos:notation "I_eff(Y_nuc, J_Dll1) = I_basal + J_Dll1 - gamma_YAP * Y_nuc,  Delta I_eff = gamma_YAP * Delta Y_nuc" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0006-3495(61)86902-6>,
            <https://doi.org/10.1016/S0022-5193(76)80131-2>,
            <https://doi.org/10.1016/S0092-8674(01)00437-8>,
            <https://doi.org/10.1016/j.cell.2017.08.043>,
            <https://doi.org/10.1038/nature07020>,
            <https://doi.org/10.1038/nature10137>,
            <https://doi.org/10.1038/nature11804>,
            <https://doi.org/10.1242/dev.070987> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Excitable FitzHugh-Nagumo Somite Clock Gated by YAP Mechanotransduction" ;
        pk:leanDeclaration "MathOfBiology.Loop_027.yap_effective_current" ;
        pk:leanTheorem "MathOfBiology.Loop_027.hubaud_2017_latrunculin_yap_inhibition_rescue" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hubaud-yap-excitable-segmentation-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Cooke & Zeeman (1976) Clock-and-Wavefront Somite Spacing Law" ;
        dct:description "Proves that successive arrests of the excitable clock at the regressing FGF/Wnt determination front freeze the phase exactly S = v_wf T apart, the spacing of the Mesp2-like somite stripes measured in simulate_ap_wavefront_arrest and the slope of the v_wf sweep | Variables: x_wf: anteroposterior position of the determination front; v_wf: axis-elongation / wavefront regression speed (um/min); T: segmentation-clock period (min); n: clock cycle index" ;
        dct:source "Cooke & Zeeman (1976) J Theor Biol 58(2):455-476, DOI 10.1016/S0022-5193(76)80131-2; Hubaud et al. (2017) Cell 171:668-682 Fig. 7" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L704-L952>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_027_yap_excitable_segmentation.lean#L110-L129> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def wavefront_position (x_wf0 v_wf t : Int) : Int :=
  x_wf0 + v_wf * t
theorem hubaud_2017_clock_wavefront_somite_spacing (x_wf0 v_wf t0 T n : Int) :
    wavefront_position x_wf0 v_wf (t0 + (n + 1) * T) -
      wavefront_position x_wf0 v_wf (t0 + n * T) = v_wf * T"""^^pk:lean4 ;
        skos:notation "x_wf(t) = x_wf0 + v_wf * t,  x_wf(t0 + (n+1) T) - x_wf(t0 + n T) = v_wf * T" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0006-3495(61)86902-6>,
            <https://doi.org/10.1016/S0022-5193(76)80131-2>,
            <https://doi.org/10.1016/S0092-8674(01)00437-8>,
            <https://doi.org/10.1016/j.cell.2017.08.043>,
            <https://doi.org/10.1038/nature07020>,
            <https://doi.org/10.1038/nature10137>,
            <https://doi.org/10.1038/nature11804>,
            <https://doi.org/10.1242/dev.070987> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Excitable FitzHugh-Nagumo Somite Clock Gated by YAP Mechanotransduction" ;
        pk:leanDeclaration "MathOfBiology.Loop_027.wavefront_position" ;
        pk:leanTheorem "MathOfBiology.Loop_027.hubaud_2017_clock_wavefront_somite_spacing" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hubaud-yap-excitable-segmentation-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Dubrulle et al. (2001) FGF/Wnt-Gated Wavefront Arrest Criterion" ;
        dct:description "Defines the determination front as the locus where FGF/Wnt loss exceeds the Hopf margin (wavefront_gate_threshold, g_crit) and proves that the front regresses at v_wf regardless of lambda_F, so lambda_F sets PSM length but not somite spacing (lambda_F sweep in evaluate_wavefront_speed_sweep) | Variables: F: Fgf8/Wnt3a signal (posterior-high exponential, decay length lambda_F); g(F): Hill gate; gamma_F: FGF/Wnt excitability gain; I_post: tail-bud excitability current; I_H: lower Hopf current; d: fixed decay distance from tail bud to front" ;
        dct:source "Dubrulle, McGrew & Pourquie (2001) Cell 106(2):219-232, DOI 10.1016/S0092-8674(01)00437-8; Hubaud et al. (2017) Cell 171:668-682" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L707-L748>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_027_yap_excitable_segmentation.lean#L131-L160> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def fgf_gated_current (I_post gamma_F g_max g : Int) : Int :=
  I_post - gamma_F * (g_max - g)
theorem hubaud_2017_fgf_wavefront_arrest_criterion
    (I_post gamma_F g_max g I_H x_tb0 v_wf t dt d : Int) :
    (fgf_gated_current I_post gamma_F g_max g < I_H ↔
      I_post - I_H < gamma_F * (g_max - g)) ∧
    ((wavefront_position x_tb0 v_wf (t + dt) - d) -
      (wavefront_position x_tb0 v_wf t - d) = v_wf * dt)"""^^pk:lean4 ;
        skos:notation "F(x,t) = min(1, exp(-(x_tb(t) - x)/lambda_F)),  g(F) = F^h/(F_thr^h + F^h),  I_eff = I_post - gamma_F (g_max - g);  arrested <=> gamma_F (g_max - g) > I_post - I_H" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0006-3495(61)86902-6>,
            <https://doi.org/10.1016/S0022-5193(76)80131-2>,
            <https://doi.org/10.1016/S0092-8674(01)00437-8>,
            <https://doi.org/10.1016/j.cell.2017.08.043>,
            <https://doi.org/10.1038/nature07020>,
            <https://doi.org/10.1038/nature10137>,
            <https://doi.org/10.1038/nature11804>,
            <https://doi.org/10.1242/dev.070987> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Excitable FitzHugh-Nagumo Somite Clock Gated by YAP Mechanotransduction" ;
        pk:leanDeclaration "MathOfBiology.Loop_027.fgf_gated_current" ;
        pk:leanTheorem "MathOfBiology.Loop_027.hubaud_2017_fgf_wavefront_arrest_criterion" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/hubaud-yap-excitable-segmentation-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "Dupont et al. (2011) / Wada et al. (2011) YAP Mechanotransduction Nuclear-Fraction Monotonicity Law" ;
        dct:description "Proves (cross-multiplied, division-free) that the steady-state nuclear YAP fraction rises with tension-driven import and falls with LATS phosphorylation, so softer substrates, smaller spreading area, Latrunculin A and Y-27632 all lower Y_nuc toward Y_crit and ignite the clock (calibrate_yap_mechanotransduction, evaluate_substrate_stiffness_sweep, simulate_latrunculin_yap_kinetics) | Variables: T: F-actin/stress-fibre tension index in [0,1] from substrate stiffness E_sub (kPa), spreading area A_cell (um^2), F-actin content rho_actin (Latrunculin A) and ROCK contractility c_ROCK (Y-27632); L(T): LATS1/2 activity; r_n: tension-driven nuclear import/export ratio; r_p: LATS phosphorylation/dephosphorylation ratio; Y_n: nuclear YAP fraction feeding Law 3" ;
        dct:source "Dupont et al. (2011) Nature 474(7350):179-183, DOI 10.1038/nature10137; Wada et al. (2011) Development 138(18):3907-3914, DOI 10.1242/dev.070987; Hubaud et al. (2017) Cell 171:668-682 Figs. 4-6" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L954-L1139>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_027_yap_excitable_segmentation.lean#L162-L199> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def yap_nuclear_denominator (r_n r_p : Int) : Int :=
  1 + r_n + r_p
theorem hubaud_2017_yap_mechanotransduction_monotonicity
    (r_n1 r_n2 r_n r_p r_p1 r_p2 : Int)
    (h_rp : 0 ≤ r_p) (h_lt : r_n1 < r_n2) (h_rn : 0 < r_n) (h_p : r_p1 < r_p2) :
    r_n1 * yap_nuclear_denominator r_n2 r_p < r_n2 * yap_nuclear_denominator r_n1 r_p ∧
    r_n * yap_nuclear_denominator r_n r_p1 < r_n * yap_nuclear_denominator r_n r_p2"""^^pk:lean4 ;
        skos:notation "T(E,A) = [E^hE/(E50^hE + E^hE)] [A/(A50 + A)] rho_actin c_ROCK,  L(T) = 1/(1 + (T/T_L)^m),  Y_n = r_n/(1 + r_n + r_p),  r_n = r0 (1 + alpha_T T),  r_p = kappa_LATS L(T)" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0006-3495(61)86902-6>,
            <https://doi.org/10.1016/S0022-5193(76)80131-2>,
            <https://doi.org/10.1016/S0092-8674(01)00437-8>,
            <https://doi.org/10.1016/j.cell.2017.08.043>,
            <https://doi.org/10.1038/nature07020>,
            <https://doi.org/10.1038/nature10137>,
            <https://doi.org/10.1038/nature11804>,
            <https://doi.org/10.1242/dev.070987> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Excitable FitzHugh-Nagumo Somite Clock Gated by YAP Mechanotransduction" ;
        pk:leanDeclaration "MathOfBiology.Loop_027.yap_nuclear_denominator" ;
        pk:leanTheorem "MathOfBiology.Loop_027.hubaud_2017_yap_mechanotransduction_monotonicity" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/ibrahim-vascular-angiogenesis-notch-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Bentley, Gerhardt & Bates (2008) & Collier et al. (1996) Two-Cell Trans-Notch Mutual Inhibition Symmetry Breaking (Brillouin k = π Mode)" ;
        dct:description "Proves that when cross-cellular Dll4-Notch1 gain g_D g_N exceeds intrinsic decay γ_D γ_N, the alternating Brillouin-zone k = π mode grows exponentially while the uniform k = 0 mode is damped, generating salt-and-pepper Tip-Stalk alternation | Variables: D_i: endothelial Dll4 ligand level; N_i: active Notch1 intracellular domain level; g_D, g_N: linearized trans-inhibition feedback gains; γ_D, γ_N: degradation rates" ;
        dct:source "Bentley, Gerhardt & Bates (2008) PLoS Comput. Biol. 4(3):e1000052; Collier et al. (1996) J. Theor. Biol. 183(4):429-446" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L182-L224>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_060_vascular_angiogenesis_notch.lean#L51-L86> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def antisymmetric_tip_stalk_mode (D1 D2 : Int) : Int := D1 - D2
def trans_notch_antisym_margin (g_D g_N gamma_D gamma_N : Int) : Int := g_D * g_N - gamma_D * gamma_N
def trans_notch_sym_margin (g_D g_N gamma_D gamma_N : Int) : Int := -(g_D * g_N) - gamma_D * gamma_N
theorem bentley_trans_notch_symmetry_breaking_instability
    (g_D g_N gamma_D gamma_N D1 D2 : Int)
    (h_gain : gamma_D * gamma_N < g_D * g_N)
    (h_decay_pos : 0 < gamma_D * gamma_N) :
    0 < trans_notch_antisym_margin g_D g_N gamma_D gamma_N ∧
    trans_notch_sym_margin g_D g_N gamma_D gamma_N < 0 ∧
    antisymmetric_tip_stalk_mode D1 D2 + antisymmetric_tip_stalk_mode D2 D1 = 0
"""^^pk:lean4 ;
        skos:notation "dD_i/dt = g(V_i^*) - γ_D D_i,  dN_i/dt = h(D_⟨j⟩) - γ_N N_i,  Δ_antisym = g_D g_N - γ_D γ_N > 0 (k = π unstable),  Δ_sym = -g_D g_N - γ_D γ_N < 0 (k = 0 damped)" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0233>,
            <https://doi.org/10.1016/S0092-8674(00)81436-1>,
            <https://doi.org/10.1016/j.devcel.2009.06.004>,
            <https://doi.org/10.1038/nature05571>,
            <https://doi.org/10.1038/ncb2103>,
            <https://doi.org/10.1073/pnas.0611206104>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1152/ajpheart.1998.275.2.H349>,
            <https://doi.org/10.1161/01.RES.77.5.1017>,
            <https://doi.org/10.1242/dev.00929>,
            <https://doi.org/10.1242/dev.128.19.3675>,
            <https://doi.org/10.1371/journal.pbio.1001374>,
            <https://doi.org/10.1371/journal.pbio.1002125>,
            <https://doi.org/10.1371/journal.pcbi.1000052> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Bentley–Gerhardt–Bates Coupled Endothelial ODE Network Driving Period-2 Salt-and-Pepper Tip-Cell vs Stalk-Cell Alternation & DAPT Hypersprouting Transition" ;
        pk:leanDeclaration "MathOfBiology.Loop_060.trans_notch_antisym_margin" ;
        pk:leanTheorem "MathOfBiology.Loop_060.bentley_trans_notch_symmetry_breaking_instability" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/ibrahim-vascular-angiogenesis-notch-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hellström et al. (2007) DAPT / Dll4-Null Notch Blockade All-Tip Hypersprouting Collapse Law" ;
        dct:description "Proves that pharmacological γ-secretase Notch blockade (DAPT, k_t = 0 => N_i = 0) or Dll4 loss abolishes VEGFR2 repression across all endothelial cells, eliminating tip-stalk contrast and collapsing stalk cells to zero (100% all-tip hypersprouting) | Variables: V_i: VEGFR2 receptor expression; V_max: unrepressed maximal VEGFR2 transcription; M_tot: Notch1 half-repression threshold; N_i: active Notch1 signaling; M: vessel endothelial cell count" ;
        dct:source "Hellström et al. (2007) Nature 445(7129):776-780; Bentley, Gerhardt & Bates (2008) PLoS Comput. Biol. 4(3):e1000052" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L245-L483>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_060_vascular_angiogenesis_notch.lean#L90-L116> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def vegfr2_notch_hill_residual (V_i V_max M_p N_p : Int) : Int := V_i * (M_p + N_p) - V_max * M_p
def vessel_stalk_cell_count (M M_tip : Int) : Int := M - M_tip
theorem hellstrom_dapt_notch_blockade_all_tip_hypersprouting
    (V_max M_p M : Int) :
    vegfr2_notch_hill_residual V_max V_max M_p 0 = 0 ∧
    antisymmetric_tip_stalk_mode V_max V_max = 0 ∧
    vessel_stalk_cell_count M M = 0
"""^^pk:lean4 ;
        skos:notation "V_i = V_max M_tot^p / (M_tot^p + N_i^p),  N_i = 0  =>  V_i = V_max ∀ i  =>  V_1 - V_2 = 0  =>  M_stalk = M - M_tip = 0 (100% tip hypersprouting)" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0233>,
            <https://doi.org/10.1016/S0092-8674(00)81436-1>,
            <https://doi.org/10.1016/j.devcel.2009.06.004>,
            <https://doi.org/10.1038/nature05571>,
            <https://doi.org/10.1038/ncb2103>,
            <https://doi.org/10.1073/pnas.0611206104>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1152/ajpheart.1998.275.2.H349>,
            <https://doi.org/10.1161/01.RES.77.5.1017>,
            <https://doi.org/10.1242/dev.00929>,
            <https://doi.org/10.1242/dev.128.19.3675>,
            <https://doi.org/10.1371/journal.pbio.1001374>,
            <https://doi.org/10.1371/journal.pbio.1002125>,
            <https://doi.org/10.1371/journal.pcbi.1000052> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Bentley–Gerhardt–Bates Coupled Endothelial ODE Network Driving Period-2 Salt-and-Pepper Tip-Cell vs Stalk-Cell Alternation & DAPT Hypersprouting Transition" ;
        pk:leanDeclaration "MathOfBiology.Loop_060.vegfr2_notch_hill_residual" ;
        pk:leanTheorem "MathOfBiology.Loop_060.hellstrom_dapt_notch_blockade_all_tip_hypersprouting" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/ibrahim-vascular-angiogenesis-notch-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Chappell et al. (2009) & Jakobsson et al. (2010) VEGFR1 (sFlt1) Decoy-Receptor Sequestration Window Shift Law" ;
        dct:description "Proves that pericellular soluble VEGFR1 (sFlt1) decoy sequestration lowers effective VEGF below the synchronous-oscillation ceiling V_osc, rescuing stable salt-and-pepper Tip-Stalk selection under high VEGF overload | Variables: VEGF_raw: extracellular unsequestered VEGF-A concentration; VEGF_eff: bioavailable pericellular VEGF-A; F_flt1: soluble VEGFR1 (sFlt1) decoy concentration; α_F: decoy binding affinity; V_osc: synchronous oscillation threshold" ;
        dct:source "Chappell et al. (2009) Dev. Cell 17(3):377-386; Jakobsson et al. (2010) Nat. Cell Biol. 12(10):943-953" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L182-L224>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_060_vascular_angiogenesis_notch.lean#L120-L148> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def flt1_sequestered_vegf (VEGF_raw alpha_F F_flt1 : Int) : Int := VEGF_raw - alpha_F * F_flt1
def salt_and_pepper_window_margin (V_osc VEGF_eff : Int) : Int := V_osc - VEGF_eff
theorem chappell_flt1_decoy_sequestration_window_rescue
    (VEGF_raw V_osc alpha_F F_flt1 : Int)
    (h_overload : V_osc ≤ VEGF_raw)
    (h_decoy : VEGF_raw - V_osc < alpha_F * F_flt1) :
    flt1_sequestered_vegf VEGF_raw alpha_F F_flt1 < VEGF_raw ∧
    0 < salt_and_pepper_window_margin V_osc (flt1_sequestered_vegf VEGF_raw alpha_F F_flt1)
"""^^pk:lean4 ;
        skos:notation "VEGF_eff = VEGF_raw - α_F F_flt1 < V_osc  when  VEGF_raw - V_osc < α_F F_flt1" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0233>,
            <https://doi.org/10.1016/S0092-8674(00)81436-1>,
            <https://doi.org/10.1016/j.devcel.2009.06.004>,
            <https://doi.org/10.1038/nature05571>,
            <https://doi.org/10.1038/ncb2103>,
            <https://doi.org/10.1073/pnas.0611206104>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1152/ajpheart.1998.275.2.H349>,
            <https://doi.org/10.1161/01.RES.77.5.1017>,
            <https://doi.org/10.1242/dev.00929>,
            <https://doi.org/10.1242/dev.128.19.3675>,
            <https://doi.org/10.1371/journal.pbio.1001374>,
            <https://doi.org/10.1371/journal.pbio.1002125>,
            <https://doi.org/10.1371/journal.pcbi.1000052> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Bentley–Gerhardt–Bates Coupled Endothelial ODE Network Driving Period-2 Salt-and-Pepper Tip-Cell vs Stalk-Cell Alternation & DAPT Hypersprouting Transition" ;
        pk:leanDeclaration "MathOfBiology.Loop_060.flt1_sequestered_vegf" ;
        pk:leanTheorem "MathOfBiology.Loop_060.chappell_flt1_decoy_sequestration_window_rescue" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/ibrahim-vascular-angiogenesis-notch-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Pries, Secomb & Gaehtgens (1998) Lumenized Poiseuille/Kirchhoff Plexus with Pressure-Dependent Wall-Shear Set Point and Emergent Murray (1926) Cube Law (Pass 3)" ;
        dct:description "Proves that when every perfused segment at a bifurcation has adapted to the same wall-shear set point (Q_e = c r_e^3) and Kirchhoff mass conservation holds, the lumen radii obey Murray's cube law exactly; the script therefore reports the fitted bifurcation exponent k as an EMERGENT diagnostic of the remodelled plexus (WT k ≈ 3.5, reference 3) rather than as a parameter | Variables: r_e, L_e: lumen radius and length of segment e; μ: blood apparent viscosity (3.5 mPa s); G_e: Hagen-Poiseuille conductance; P_u: nodal pressure; Q_e: volumetric flow; τ_e: wall shear stress; τ*(P): Pries pressure-dependent set point; k_a, k_m, k_s: adaptation, metabolic and shrinkage gains; c = π τ*/(4 μ)" ;
        dct:source "Pries AR, Secomb TW, Gaehtgens P (1998) Am. J. Physiol. 275(2):H349-H360; Pries, Secomb & Gaehtgens (1995) Circ. Res. 77(5):1017-1023; Murray CD (1926) PNAS 12(3):207-214" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L641-L909>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_060_vascular_angiogenesis_notch.lean#L152-L189> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def poiseuille_flow_at_uniform_shear (c r : Int) : Int := c * (r * r * r)
def murray_cube_law_residual (r_p r_1 r_2 : Int) : Int := r_p * r_p * r_p - r_1 * r_1 * r_1 - r_2 * r_2 * r_2
theorem murray_cube_law_from_uniform_wall_shear
    (c r_p r_1 r_2 : Int)
    (h_shear_pos : c ≠ 0)
    (h_kirchhoff : poiseuille_flow_at_uniform_shear c r_p =
      poiseuille_flow_at_uniform_shear c r_1 + poiseuille_flow_at_uniform_shear c r_2) :
    murray_cube_law_residual r_p r_1 r_2 = 0
"""^^pk:lean4 ;
        skos:notation "G_e = π r_e^4 / (8 μ L_e),  Σ_e G_e (P_u - P_v) = 0 ∀ internal nodes,  τ_e = 4 μ |Q_e| / (π r_e^3),  dr_e/dt = k_a r_e [log10((τ_e+τ_0)/(τ*(P_e)+τ_0)) + k_m log10(1 + Q_ref/|Q_e|) - k_s],  τ*(P) = 0.1(100 - 86 e^{-5000 (log10 log10 P)^5.4}) Pa;  uniform τ* + Kirchhoff  =>  r_p^3 = r_1^3 + r_2^3" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0233>,
            <https://doi.org/10.1016/S0092-8674(00)81436-1>,
            <https://doi.org/10.1016/j.devcel.2009.06.004>,
            <https://doi.org/10.1038/nature05571>,
            <https://doi.org/10.1038/ncb2103>,
            <https://doi.org/10.1073/pnas.0611206104>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1152/ajpheart.1998.275.2.H349>,
            <https://doi.org/10.1161/01.RES.77.5.1017>,
            <https://doi.org/10.1242/dev.00929>,
            <https://doi.org/10.1242/dev.128.19.3675>,
            <https://doi.org/10.1371/journal.pbio.1001374>,
            <https://doi.org/10.1371/journal.pbio.1002125>,
            <https://doi.org/10.1371/journal.pcbi.1000052> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Bentley–Gerhardt–Bates Coupled Endothelial ODE Network Driving Period-2 Salt-and-Pepper Tip-Cell vs Stalk-Cell Alternation & DAPT Hypersprouting Transition" ;
        pk:leanDeclaration "MathOfBiology.Loop_060.murray_cube_law_residual" ;
        pk:leanTheorem "MathOfBiology.Loop_060.murray_cube_law_from_uniform_wall_shear" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/ibrahim-vascular-angiogenesis-notch-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Chen et al. (2012) / Franco et al. (2015) Flow-Stealing Pruning Cascade and Lawson et al. (2001) Notch-Gated Arteriovenous Specification (Pass 3)" ;
        dct:description "Proves that pruning a neighbouring rung strictly increases the surviving rung's flow (and hence Poiseuille wall shear), making shear-driven regression a self-reinforcing cascade; the script couples this to a Notch-gated hemodynamic readout so that DAPT (ν_Notch = 0) leaves the pressure/shear field intact but abolishes arteriovenous marker segregation (index 0.5, AV shunting), while perfusion arrest removes both | Variables: G_1, G_2: conductances of two parallel capillary rungs; R_s: series feeding-arteriole/draining-venule resistance; ΔP: arteriolar-venular pressure drop; r_min: minimum red-cell-perfusable lumen radius; AV_e: arterial (ephrinB2, →1) vs venous (EphB4, →0) identity; p̂_e: local pressure rank relative to the rung midpoint; ν_Notch: Dll4/Notch1 transduction gain" ;
        dct:source "Chen Q, et al. (2012) PLoS Biol. 10(8):e1001374; Franco CA, et al. (2015) PLoS Biol. 13(4):e1002125; Lawson ND, et al. (2001) Development 128(19):3675-3683; le Noble F, et al. (2004) Development 131(2):361-375; Wang HU, Chen ZF, Anderson DJ (1998) Cell 93(5):741-753" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45670cb8/2021-ibrahim-vascular-angiogenesis-notch.py#L912-L1198>,
            <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_060_vascular_angiogenesis_notch.lean#L193-L231> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def survivor_flow_cross_term (G_1 dP R_s G_other : Int) : Int := G_1 * dP * (1 + R_s * (G_1 + G_other))
theorem franco_pruning_flow_stealing_cascade
    (G_1 G_2 R_s dP : Int)
    (h_G1 : 0 < G_1) (h_G2 : 0 < G_2) (h_Rs : 0 < R_s) (h_dP : 0 < dP) :
    survivor_flow_cross_term G_1 dP R_s 0 < survivor_flow_cross_term G_1 dP R_s G_2 ∧
    survivor_flow_cross_term G_1 dP R_s 0 = G_1 * dP * (1 + R_s * G_1)
"""^^pk:lean4 ;
        skos:notation "Q_1 = G_1 ΔP / (1 + R_s (G_1 + G_2))  <  G_1 ΔP / (1 + R_s G_1) = Q_1^pruned  (cross-multiplied: G_1 ΔP (1 + R_s G_1) < G_1 ΔP (1 + R_s (G_1 + G_2)));  prune e when r_e < r_min = 1.3 μm;  AV_e = σ(ν_Notch [g_P p̂_e + g_τ log10((τ_e+τ_0)/(τ_ref+τ_0))]),  ν_Notch = k_t / k_t,WT" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0233>,
            <https://doi.org/10.1016/S0092-8674(00)81436-1>,
            <https://doi.org/10.1016/j.devcel.2009.06.004>,
            <https://doi.org/10.1038/nature05571>,
            <https://doi.org/10.1038/ncb2103>,
            <https://doi.org/10.1073/pnas.0611206104>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1152/ajpheart.1998.275.2.H349>,
            <https://doi.org/10.1161/01.RES.77.5.1017>,
            <https://doi.org/10.1242/dev.00929>,
            <https://doi.org/10.1242/dev.128.19.3675>,
            <https://doi.org/10.1371/journal.pbio.1001374>,
            <https://doi.org/10.1371/journal.pbio.1002125>,
            <https://doi.org/10.1371/journal.pcbi.1000052> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Bentley–Gerhardt–Bates Coupled Endothelial ODE Network Driving Period-2 Salt-and-Pepper Tip-Cell vs Stalk-Cell Alternation & DAPT Hypersprouting Transition" ;
        pk:leanDeclaration "MathOfBiology.Loop_060.survivor_flow_cross_term" ;
        pk:leanTheorem "MathOfBiology.Loop_060.franco_pruning_flow_stealing_cascade" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/jonsson-auxin-pin1-meristem-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) Up-the-Gradient Boltzmann PIN1 Allocation Law" ;
        dct:description "Directs cellular PIN1 efflux carriers preferentially toward neighboring cells with higher auxin concentration while conserving each cell's total PIN1 pool | Variables: P_i: total PIN1 pool in L1 cell i; P_ij: PIN1 allocated to anticlinal wall i→j; a_j: auxin concentration in neighbor cell j; c_1: up-the-gradient feedback exponent; w_j = exp(c_1 a_j): Boltzmann weight" ;
        dct:source "Jönsson et al. (2006) PNAS 103(5):1633-1638 Eq. 4; Smith et al. (2006) PNAS 103(5):1301-1306 Eq. 2" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L134-L224>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_032_auxin_pin1_phyllotaxis.lean#L27-L44> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def pin1_alloc_scaled (P_i w_j : Int) : Int := P_i * w_j
def pin1_partition_sum3 (w1 w2 w3 : Int) : Int := w1 + w2 + w3
theorem jonsson_2006_up_gradient_pin1_allocation (P_i w1 w2 w3 w_j w_k : Int)
    (hP : P_i > 0) (hw : w_j > w_k) :
    pin1_alloc_scaled P_i w1 + pin1_alloc_scaled P_i w2 + pin1_alloc_scaled P_i w3 =
      P_i * pin1_partition_sum3 w1 w2 w3 ∧
    pin1_alloc_scaled P_i w_j > pin1_alloc_scaled P_i w_k
"""^^pk:lean4 ;
        skos:notation "P_ij = P_i exp(c_1 a_j) / ∑_{k∈N(i)} exp(c_1 a_k);  ∑_{j∈N(i)} P_ij = P_i;  a_j > a_k ⇒ P_ij > P_ik" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cub.2005.09.052>,
            <https://doi.org/10.1016/j.jtbi.2005.03.017>,
            <https://doi.org/10.1038/35096571>,
            <https://doi.org/10.1038/nature02081>,
            <https://doi.org/10.1038/nature03633>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103>,
            <https://doi.org/10.1098/rspb.1980.0015>,
            <https://doi.org/10.1098/rstb.1981.0154>,
            <https://doi.org/10.1101/gad.1402406>,
            <https://doi.org/10.1101/gad.497009> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Up-the-Gradient Auxin-PIN1 Polarized Transport & Turing-Like Phyllotactic Spacing" ;
        pk:leanDeclaration "MathOfBiology.Loop_032.pin1_alloc_scaled" ;
        pk:leanTheorem "MathOfBiology.Loop_032.jonsson_2006_up_gradient_pin1_allocation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/jonsson-auxin-pin1-meristem-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Jönsson et al. (2006) Intercellular Active Polar + Diffusive Auxin Flux Conservation Law" ;
        dct:description "Guarantees exact pairwise intercellular auxin mass conservation across every shared cell wall and equilibrium stationarity at homogeneous state a_0 = ρ_0 / μ | Variables: a_i: auxin concentration in cell i; T: active PIN1 polar transport rate; D: passive apoplastic/plasmodesmatal diffusion rate; ρ_0: basal auxin synthesis rate; μ: auxin turnover rate" ;
        dct:source "Jönsson et al. (2006) PNAS 103(5):1633-1638 Eqs. 1-3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L309-L615>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_032_auxin_pin1_phyllotaxis.lean#L59-L71> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def intercellular_auxin_flux (T D P_ij P_ji a_i a_j : Int) : Int :=
  T * (P_ji * a_j - P_ij * a_i) + D * (a_j - a_i)
theorem jonsson_2006_intercellular_flux_conservation (T D P_ij P_ji P0 a_i a_j a0 : Int) :
    intercellular_auxin_flux T D P_ij P_ji a_i a_j +
      intercellular_auxin_flux T D P_ji P_ij a_j a_i = 0 ∧
    intercellular_auxin_flux T D P0 P0 a0 a0 = 0
"""^^pk:lean4 ;
        skos:notation "da_i/dt = ρ_0 - μ a_i + ∑_{j∈N(i)} J_{i←j},  J_{i←j} = T(P_ji a_j - P_ij a_i) + D(a_j - a_i),  J_{i←j} + J_{j←i} = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cub.2005.09.052>,
            <https://doi.org/10.1016/j.jtbi.2005.03.017>,
            <https://doi.org/10.1038/35096571>,
            <https://doi.org/10.1038/nature02081>,
            <https://doi.org/10.1038/nature03633>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103>,
            <https://doi.org/10.1098/rspb.1980.0015>,
            <https://doi.org/10.1098/rstb.1981.0154>,
            <https://doi.org/10.1101/gad.1402406>,
            <https://doi.org/10.1101/gad.497009> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Up-the-Gradient Auxin-PIN1 Polarized Transport & Turing-Like Phyllotactic Spacing" ;
        pk:leanDeclaration "MathOfBiology.Loop_032.intercellular_auxin_flux" ;
        pk:leanTheorem "MathOfBiology.Loop_032.jonsson_2006_intercellular_flux_conservation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/jonsson-auxin-pin1-meristem-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Jönsson et al. (2006) Up-the-Gradient Turing-Like Instability & NPA Pin-Formed Collapse Law" ;
        dct:description "Establishes the bifurcation threshold where up-the-gradient active transport overcomes passive diffusion to form periodic auxin convergence maxima separated by λ_c, and proves that blocking polar transport (T = 0 in NPA or pin1 mutant) abolishes instability to yield a pin-formed apex | Variables: c_1 a_0: dimensionless PIN1 polarization feedback product; z: cellular coordination number; D_eff: effective linearized diffusion coefficient; Γ_mode: spatial perturbation growth gain" ;
        dct:source "Jönsson et al. (2006) PNAS 103(5):1633-1638 pp. 1635-1636; Reinhardt et al. (2003) Nature 426:255-260" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L134-L224>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_032_auxin_pin1_phyllotaxis.lean#L90-L109> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def effective_diffusion_scaled (z_D T P_i c1_a0 : Int) : Int :=
  z_D - T * P_i * (c1_a0 - 1)
def mode_instability_gain (z_D T P_i c1_a0 : Int) : Int :=
  T * P_i * (c1_a0 - 1) - z_D
theorem jonsson_2006_up_gradient_instability_and_npa_collapse (z_D T P_i c1_a0 : Int)
    (h_instab : T * P_i * (c1_a0 - 1) > z_D)
    (h_diff : z_D > 0) :
    effective_diffusion_scaled z_D T P_i c1_a0 < 0 ∧
    mode_instability_gain z_D T P_i c1_a0 > 0 ∧
    mode_instability_gain z_D 0 P_i c1_a0 < 0
"""^^pk:lean4 ;
        skos:notation "Γ_mode = T P_i (c_1 a_0 - 1) - z D > 0  ⇔  D_eff < 0;  T = 0 (NPA / pin1) ⇒ Γ_mode = -z D < 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cub.2005.09.052>,
            <https://doi.org/10.1016/j.jtbi.2005.03.017>,
            <https://doi.org/10.1038/35096571>,
            <https://doi.org/10.1038/nature02081>,
            <https://doi.org/10.1038/nature03633>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103>,
            <https://doi.org/10.1098/rspb.1980.0015>,
            <https://doi.org/10.1098/rstb.1981.0154>,
            <https://doi.org/10.1101/gad.1402406>,
            <https://doi.org/10.1101/gad.497009> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Up-the-Gradient Auxin-PIN1 Polarized Transport & Turing-Like Phyllotactic Spacing" ;
        pk:leanDeclaration "MathOfBiology.Loop_032.mode_instability_gain" ;
        pk:leanTheorem "MathOfBiology.Loop_032.jonsson_2006_up_gradient_instability_and_npa_collapse" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/jonsson-auxin-pin1-meristem-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Jönsson et al. (2006) Explicit PIN1 Exocytosis / Endocytosis Trafficking Kinetics & Quasi-Steady-State Allocation Law (Pass 3)" ;
        dct:description "Replaces the instantaneous Boltzmann allocation by explicit membrane cycling with a finite trafficking time 1/k_endo; its fixed point conserves membrane + cytosolic PIN1, retains up-the-gradient polarity, reduces to Law 1 as k_endo/(k_exo ∑ f) → 0, and predicts complete PIN1 internalisation under a brefeldin A exocytosis block | Variables: P_cyt,i: cytosolic/endosomal PIN1 pool of cell i; P_ij: plasma-membrane PIN1 on wall i→j; k_exo: exocytosis rate per unit targeting weight; k_endo: endocytosis rate; f(a_j) = exp(c_1 (a_j − a_0)): up-the-gradient exocytosis targeting; Z_i: cleared partition denominator" ;
        dct:source "Jönsson et al. (2006) PNAS 103(5):1633-1638 (PIN1 cycling kinetics and quasi-steady state); Geldner et al. (2001) Nature 413:425-428 (BFA); Paciorek et al. (2005) Nature 435:1251-1256 (auxin-inhibited endocytosis)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L229-L306>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_032_auxin_pin1_phyllotaxis.lean#L136-L163> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def pin1_membrane_qss_num (k_exo f_j P_tot : Int) : Int := k_exo * f_j * P_tot
def pin1_cytosol_qss_num (k_endo P_tot : Int) : Int := k_endo * P_tot
def pin1_trafficking_partition (k_exo k_endo f1 f2 f3 : Int) : Int := k_endo + k_exo * (f1 + f2 + f3)
theorem jonsson_2006_pin1_trafficking_qss (k_exo k_endo f1 f2 f3 f_j f_k P_tot : Int)
    (hk : k_exo > 0) (hP : P_tot > 0) (hf : f_j > f_k) :
    pin1_cytosol_qss_num k_endo P_tot + pin1_membrane_qss_num k_exo f1 P_tot +
        pin1_membrane_qss_num k_exo f2 P_tot + pin1_membrane_qss_num k_exo f3 P_tot =
      P_tot * pin1_trafficking_partition k_exo k_endo f1 f2 f3 ∧
    k_endo * pin1_membrane_qss_num k_exo f_j P_tot =
      k_exo * f_j * pin1_cytosol_qss_num k_endo P_tot ∧
    pin1_membrane_qss_num k_exo f_j P_tot > pin1_membrane_qss_num k_exo f_k P_tot ∧
    pin1_membrane_qss_num 0 f_j P_tot = 0
"""^^pk:lean4 ;
        skos:notation "dP_ij/dt = k_exo f(a_j) P_cyt,i − k_endo P_ij,  P_cyt,i + ∑_j P_ij = P_tot;  P*_ij = k_exo f_j P_tot / Z_i,  P*_cyt = k_endo P_tot / Z_i,  Z_i = k_endo + k_exo ∑_k f_k;  k_endo P*_ij = k_exo f_j P*_cyt;  f_j > f_k ⇒ P*_ij > P*_ik;  k_exo = 0 (BFA) ⇒ P*_ij = 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cub.2005.09.052>,
            <https://doi.org/10.1016/j.jtbi.2005.03.017>,
            <https://doi.org/10.1038/35096571>,
            <https://doi.org/10.1038/nature02081>,
            <https://doi.org/10.1038/nature03633>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103>,
            <https://doi.org/10.1098/rspb.1980.0015>,
            <https://doi.org/10.1098/rstb.1981.0154>,
            <https://doi.org/10.1101/gad.1402406>,
            <https://doi.org/10.1101/gad.497009> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Up-the-Gradient Auxin-PIN1 Polarized Transport & Turing-Like Phyllotactic Spacing" ;
        pk:leanDeclaration "MathOfBiology.Loop_032.pin1_membrane_qss_num" ;
        pk:leanTheorem "MathOfBiology.Loop_032.jonsson_2006_pin1_trafficking_qss" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/jonsson-auxin-pin1-meristem-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Mitchison (1980/1981) With-the-Flux Canalization Winner-Take-All Law (subepidermal provascular strand; Pass 3)" ;
        dct:description "Shows that a superlinear flux feedback amplifies any flux asymmetry between competing walls, so a symmetric split is linearly unstable and auxin efflux canalizes into a single-file provascular strand connecting the L1 convergence point to the existing vasculature (Bayer et al. 2009 integration) | Variables: J_1, J_2: net auxin efflux through two competing walls of a subepidermal cell; Φ: with-the-flux exocytosis targeting (quadratic case of Φ = J^n/(K^n + J^n)); α: feedback gain (k_exo P_cyt)" ;
        dct:source "Mitchison GJ (1980) Proc. R. Soc. Lond. B 207:79-109; Mitchison GJ (1981) Phil. Trans. R. Soc. Lond. B 295:461-471; Feugier et al. (2005) J. Theor. Biol. 236:366-375; Bayer et al. (2009) Genes Dev. 23:373-384" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L617-L770>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_032_auxin_pin1_phyllotaxis.lean#L183-L202> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def flux_feedback_quadratic (J : Int) : Int := J * J
theorem mitchison_1980_canalization_winner_take_all (J1 J2 alpha : Int)
    (h2 : J2 ≥ 0) (h : J1 > J2) (ha : alpha > 0) :
    flux_feedback_quadratic J1 - flux_feedback_quadratic J2 = (J1 - J2) * (J1 + J2) ∧
    flux_feedback_quadratic J1 > flux_feedback_quadratic J2 ∧
    alpha * (flux_feedback_quadratic J1 - flux_feedback_quadratic J2) > 0
"""^^pk:lean4 ;
        skos:notation "Φ(J) = J²;  J_1 > J_2 ≥ 0 ⇒ Φ(J_1) − Φ(J_2) = (J_1 − J_2)(J_1 + J_2) > 0;  α > 0 ⇒ α (Φ(J_1) − Φ(J_2)) > 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cub.2005.09.052>,
            <https://doi.org/10.1016/j.jtbi.2005.03.017>,
            <https://doi.org/10.1038/35096571>,
            <https://doi.org/10.1038/nature02081>,
            <https://doi.org/10.1038/nature03633>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103>,
            <https://doi.org/10.1098/rspb.1980.0015>,
            <https://doi.org/10.1098/rstb.1981.0154>,
            <https://doi.org/10.1101/gad.1402406>,
            <https://doi.org/10.1101/gad.497009> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Up-the-Gradient Auxin-PIN1 Polarized Transport & Turing-Like Phyllotactic Spacing" ;
        pk:leanDeclaration "MathOfBiology.Loop_032.flux_feedback_quadratic" ;
        pk:leanTheorem "MathOfBiology.Loop_032.mitchison_1980_canalization_winner_take_all" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/karbowski-cortical-sulcal-axon-tension-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Van Essen (1997) Cortico-Cortical Axonal Tension & Chord-vs-Arc Gyral Wiring Economy" ;
        dct:description "Establishes that viscoelastic tension along dense cortico-cortical white-matter tracts pulls strongly connected areas together across outward gyral crowns to minimize 3D wiring volume while weakly connected zones fold inward as sulcal fundi | Variables: C_{ij}: cortico-cortical axonal connectivity density; d_arc: unfolded geodesic surface arc distance (mm); d_chord: 3D Euclidean trans-gyral chord distance (mm); k_a: axonal spring constant" ;
        dct:source "Van Essen (1997) Nature 385:313-318 Fig. 1-3; Toro & Burnod (2005) Cerebral Cortex 15:1900-1913; Karbowski (2001) Phys. Rev. Lett. 86:3674" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py#L144-L516>,
            <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_090_cortical_sulcal_axon_tension.lean#L36-L49> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def wiring_volume_saving (C d_arc d_chord : Int) : Int :=
  C * d_arc - C * d_chord
theorem van_essen_gyral_wiring_economy (C_strong C_weak d_chord delta : Int) :
    wiring_volume_saving C_strong d_chord d_chord = 0 ∧
    wiring_volume_saving C_strong (d_chord + delta) d_chord -
      wiring_volume_saving C_weak (d_chord + delta) d_chord =
      (C_strong - C_weak) * delta
"""^^pk:lean4 ;
        skos:notation "F_axon = sum_{i<j} k_a C_{ij} (||x_i - x_j|| - L_{0,ij})_+ + E_bend(κ);  ΔV_wire = C_{ij} (d_arc - d_chord) > 0 for C_strong > C_weak" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/385313a0>,
            <https://doi.org/10.1093/cercor/bhi068>,
            <https://doi.org/10.1103/PhysRevLett.86.3674>,
            <https://doi.org/10.1126/science.aaa9101>,
            <https://doi.org/10.1371/journal.pcbi.0020022> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Viscoelastic Cortico-Cortical Axonal Tension Mechanics, Laminar Volume Conservation & Universal Gyrification Scaling" ;
        pk:leanDeclaration "MathOfBiology.Loop_090.wiring_volume_saving" ;
        pk:leanTheorem "MathOfBiology.Loop_090.van_essen_gyral_wiring_economy" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/karbowski-cortical-sulcal-axon-tension-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hilgetag & Barbas (2006) Isometric Laminar Volume Conservation & Gyral-vs-Sulcal Thickness Dichotomy" ;
        dct:description "Proves that isometric volume conservation under gyral tangential compression and sulcal tangential stretching produces systematically thicker gyral crowns and thinner sulcal fundi (h_gyrus / h_fundus ≈ 1.62) | Variables: V_col: cortical column volume; A_surf: local tangential surface area; h: radial cortical thickness (mm); λ_t: tangential strain factor (λ_{t,gyrus} = 0.78 < 1 < λ_{t,fundus} = 1.26)" ;
        dct:source "Hilgetag & Barbas (2006) PLoS Comput. Biol. 2(3):e22 Eq. 1-4 & Fig. 2-6" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py#L156-L561>,
            <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_090_cortical_sulcal_axon_tension.lean#L63-L73> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def laminar_volume_residual (A_surf h A_ref h_ref : Int) : Int :=
  A_surf * h - A_ref * h_ref
theorem hilgetag_barbas_laminar_thickness_dichotomy (A_0 h_0 k m d : Int) :
    laminar_volume_residual (k * A_0) (m * h_0) (m * A_0) (k * h_0) = 0 ∧
    (k + d) * h_0 - k * h_0 = d * h_0
"""^^pk:lean4 ;
        skos:notation "V_col = A_surf * h = A_0 * h_0  ⇒  h_gyrus = h_0 / λ_{t,gyrus} > h_wall = h_0 > h_fundus = h_0 / λ_{t,fundus}" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/385313a0>,
            <https://doi.org/10.1093/cercor/bhi068>,
            <https://doi.org/10.1103/PhysRevLett.86.3674>,
            <https://doi.org/10.1126/science.aaa9101>,
            <https://doi.org/10.1371/journal.pcbi.0020022> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Viscoelastic Cortico-Cortical Axonal Tension Mechanics, Laminar Volume Conservation & Universal Gyrification Scaling" ;
        pk:leanDeclaration "MathOfBiology.Loop_090.laminar_volume_residual" ;
        pk:leanTheorem "MathOfBiology.Loop_090.hilgetag_barbas_laminar_thickness_dichotomy" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/karbowski-cortical-sulcal-axon-tension-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Mota & Herculano-Houzel (2015) Universal Mammalian Cortical Folding Power Law" ;
        dct:description "Unifies mammalian cortical folding across 12 species spanning lissencephalic rodents to gyrencephalic primates and cetaceans with universal log-log slope α = 5/4 = 1.25 | Variables: A_T: total pial cortical surface area (mm^2); A_E: exposed convex-hull surface area (mm^2); h: mean cortical gray-matter thickness (mm); k: dimensionless axonal-tension folding constant; GI: 3D gyrification index" ;
        dct:source "Mota & Herculano-Houzel (2015) Science 349(6243):74-77 Eq. 3-5 & Fig. 2-3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py#L168-L633>,
            <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_090_cortical_sulcal_axon_tension.lean#L85-L99> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def mota_herculano_houzel_residual (A_T_pow4 h_pow2 k_pow4 A_E_pow5 : Int) : Int :=
  A_T_pow4 * h_pow2 - k_pow4 * A_E_pow5
def gyrification_area_excess (A_T A_E : Int) : Int :=
  A_T - A_E
theorem mota_herculano_houzel_universal_scaling (A_E h_pow2 k_pow4 : Int) :
    gyrification_area_excess A_E A_E = 0 ∧
    mota_herculano_houzel_residual (k_pow4 * A_E) h_pow2 k_pow4 (A_E * h_pow2) = 0 ∧
    mota_herculano_houzel_residual (16 * k_pow4 * A_E) h_pow2 k_pow4 (16 * A_E * h_pow2) = 0
"""^^pk:lean4 ;
        skos:notation "A_T sqrt(h) = k A_E^(5/4)  ⇔  A_T^4 h^2 = k^4 A_E^5,  with GI = A_T / A_E = k h^(-1/2) A_E^(1/4) ≥ 1.0" ;
        prov:wasDerivedFrom <https://doi.org/10.1038/385313a0>,
            <https://doi.org/10.1093/cercor/bhi068>,
            <https://doi.org/10.1103/PhysRevLett.86.3674>,
            <https://doi.org/10.1126/science.aaa9101>,
            <https://doi.org/10.1371/journal.pcbi.0020022> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Viscoelastic Cortico-Cortical Axonal Tension Mechanics, Laminar Volume Conservation & Universal Gyrification Scaling" ;
        pk:leanDeclaration "MathOfBiology.Loop_090.mota_herculano_houzel_residual" ;
        pk:leanTheorem "MathOfBiology.Loop_090.mota_herculano_houzel_universal_scaling" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/kondo-pomacanthus-stripe-insertion-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Kondo & Asai (1995) Piecewise-Linear Saturating Activator-Inhibitor Steady State & Uniform Stability" ;
        dct:description "Proves that the interior equilibrium (A^*, I^*) = (3.0, 2.5) lies strictly inside the unsaturated linear window (0 < F^* = 0.09 < 0.20, 0 < G^* = 0.15 < 0.50) and is asymptotically stable to uniform perturbations (tr J = -0.01 < 0, det J = 0.005 > 0) | Variables: A, I: activator and inhibitor concentrations; c_1..c_5: linear synthesis coefficients; g_A, g_I: decay rates; F_max, G_max: upper saturation ceilings; (A^*, I^*) = (3.0, 2.5): interior homogeneous steady state" ;
        dct:source "Kondo & Asai (1995) Nature 376(6543):765-768 Fig. 1 legend; Gierer & Meinhardt (1972) Kybernetik 12(1):30-39" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L141-L225>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_004_pomacanthus_stripe_insertion.lean#L19-L54> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def clip_rate (S_max raw : Int) : Int := min S_max (max 0 raw)
def kondo_trace (f_A g_I_prime D_A D_I q : Int) : Int := (f_A + g_I_prime) - (D_A + D_I) * q
def kondo_det (f_A f_I g_A_prime g_I_prime D_A D_I q : Int) : Int :=
  (D_A * D_I) * (q * q) - (D_I * f_A + D_A * g_I_prime) * q + (f_A * g_I_prime - f_I * g_A_prime)
theorem kondo_asai_1995_piecewise_gm_steady_state_and_uniform_stability (D_A D_I : Int) :
    clip_rate 200 (80 * 3 + (-80) * 5 / 2 + 50) = 90 ∧
    clip_rate 500 (100 * 3 - 150) = 150 ∧
    kondo_trace 50 (-60) D_A D_I 0 = -10 ∧
    kondo_det 50 (-80) 100 (-60) D_A D_I 0 = 5000 := by
  unfold clip_rate kondo_trace kondo_det; refine ⟨by decide, by decide, by omega, by omega⟩
"""^^pk:lean4 ;
        skos:notation "F(A^*, I^*) = min(F_max, max(0, c_1 A^* + c_2 I^* + c_3)) = g_A A^*,  G(A^*, I^*) = min(G_max, max(0, c_4 A^* + c_5)) = g_I I^*;  tr J = f_A + g'_I < 0 ∧ det J = f_A g'_I - f_I g'_A > 0" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/ncomms7971>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1387/ijdb.072502sk> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Growing-Domain Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_004.kondo_det" ;
        pk:leanTheorem "MathOfBiology.Loop_004.kondo_asai_1995_piecewise_gm_steady_state_and_uniform_stability" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/kondo-pomacanthus-stripe-insertion-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Kondo & Asai (1995) Turing Wave Instability Threshold (D_I / D_A > d_c)" ;
        dct:description "Proves that the canonical Kondo-Asai diffusivity ratio d = 100/7 ≈ 14.29 exceeds d_c ≈ 10.26 and drives det M(q) = -2440 < 0 at q = 3, whereas subcritical inhibitor diffusion (D_I = 0.050, d = 7.14 < d_c) keeps det M(q) > 0 | Variables: D_A = 0.007, D_I = 0.10: activator and inhibitor diffusivities; d = D_I / D_A = 14.29: diffusivity ratio; d_c = 10.26: critical Turing ratio; k_c^2 = 3.2714: critical squared wavenumber; λ_c = 2π / k_c = 3.4739: intrinsic stripe wavelength" ;
        dct:source "Kondo & Asai (1995) Nature 376(6543):765-768 Fig. 1" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L153-L250>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_004_pomacanthus_stripe_insertion.lean#L61-L78> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem kondo_asai_1995_turing_wave_instability_and_subcritical_stability :
    kondo_det 50 (-80) 100 (-60) 7 100 3 = -2440 ∧
    kondo_det 50 (-80) 100 (-60) 7 50 3 = 1910 ∧
    kondo_det 50 (-80) 100 (-60) 7 7 3 = 5651 := by
  decide
"""^^pk:lean4 ;
        skos:notation "d = D_I / D_A > d_c = 5.2 + 1.6√10 ≈ 10.26 ⟹ det M(k_c^2) < 0 at k_c^2 = (D_I f_A + D_A g'_I) / (2 D_A D_I) = 229 / 70" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/ncomms7971>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1387/ijdb.072502sk> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Growing-Domain Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_004.kondo_det" ;
        pk:leanTheorem "MathOfBiology.Loop_004.kondo_asai_1995_turing_wave_instability_and_subcritical_stability" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/kondo-pomacanthus-stripe-insertion-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Kondo & Asai (1995) P. semicirculatus Mid-Trough Doubling Cascade vs P. imperator Y-Branch Unzipping" ;
        dct:description "Formalizes the species-specific wavelength-homeostasis laws in Pomacanthus: simultaneous 1D mid-trough secondary stripe insertion (3 → 6 → 12 → 24) in P. semicirculatus versus 2D horizontal Y-branch dislocation unzipping (+1 stripe per branch) in P. imperator | Variables: s = L(t)/L_0: ontogenetic body-length doubling scale (2 → 4 → 8 → 16 cm); N_0 = 3: initial juvenile stripe count; u: number of horizontally unzipped 2D Y-junction branch points" ;
        dct:source "Kondo & Asai (1995) Nature 376(6543):765-768 Figs. 1-4; Crampin, Gaffney & Maini (1999) Bull. Math. Biol. 61(6):1093-1120" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L256-L480>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_004_pomacanthus_stripe_insertion.lean#L85-L114> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def semicirculatus_stripes (N_0 s : Nat) : Nat := N_0 * s
def imperator_unzipped_stripes (N_0 unzipped_branches : Nat) : Nat := N_0 + unzipped_branches
theorem kondo_asai_1995_semicirculatus_insertion_vs_imperator_unzipping :
    semicirculatus_stripes 3 1 = 3 ∧
    semicirculatus_stripes 3 2 = 6 ∧
    semicirculatus_stripes 3 4 = 12 ∧
    semicirculatus_stripes 3 8 = 24 ∧
    imperator_unzipped_stripes 3 1 = 4 := by
  unfold semicirculatus_stripes imperator_unzipped_stripes; omega
"""^^pk:lean4 ;
        skos:notation "L(t) = s L_0 (s ∈ {1,2,4,8}) ⟹ N_semicirculatus(s) = 3 s ∈ {3,6,12,24} (λ(s) = λ_c);  N_imperator(N_0, u) = N_0 + u" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/ncomms7971>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1387/ijdb.072502sk> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Growing-Domain Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_004.semicirculatus_stripes" ;
        pk:leanTheorem "MathOfBiology.Loop_004.kondo_asai_1995_semicirculatus_insertion_vs_imperator_unzipping" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/kondo-pomacanthus-stripe-insertion-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Kondo & Asai (1995) Curvilinear C-Shaped Mid-Trough Inhibitor Threshold Partition for Concentric Arc Insertion (Pass 3)" ;
        dct:description "Proves the threshold partition that drives de novo concentric arc insertion in the curvilinear solver: in an activator-depleted trough the piecewise-linear synthesis is silent for I ≥ 0.625 and active below it (antitone in I), so arcs insert exactly when the inhibitor minimum between stretched arcs crosses the threshold; concentric arc number doubles with radial span while arc length grows strictly with arc index (the polar (1/ρ)∂_ρ term shifts phase, not count) | Variables: ρ = r/R(t): scaled radius on the posterior-centred C-shaped sector; θ: polar angle; s = R(t)/R_0: radial growth scale; I_mid: mid-trough inhibitor minimum along the central radial transect; I_thr = c_3/|c_2| = 0.625: zero-activator insertion threshold (625 in 10^3-scaled Int units); N_0 = 3: equilibrated concentric arcs" ;
        dct:source "Kondo & Asai (1995) Nature 376(6543):765-768 Fig. 1d-f; Crampin, Gaffney & Maini (1999) Bull. Math. Biol. 61(6):1093-1120" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L592-L819>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_004_pomacanthus_stripe_insertion.lean#L114-L176> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def trough_synthesis (I : Int) : Int := clip_rate 200 ((-80) * I / 1000 + 50)
def concentric_arcs (N_0 s : Nat) : Nat := N_0 * s
def arc_length_pi (R_in lam k : Nat) : Nat := R_in + lam * k
theorem kondo_asai_1995_curvilinear_mid_trough_threshold_partition :
    trough_synthesis 2500 = 0 ∧ trough_synthesis 625 = 0 ∧
    trough_synthesis 600 = 2 ∧ trough_synthesis 0 = 50 ∧
    (∀ I : Int, 625 ≤ I → trough_synthesis I = 0) ∧
    (∀ I₁ I₂ : Int, I₁ ≤ I₂ → trough_synthesis I₂ ≤ trough_synthesis I₁) ∧
    concentric_arcs 3 2 = 6 ∧
    (∀ R_in lam k : Nat, 0 < lam → arc_length_pi R_in lam k < arc_length_pi R_in lam (k + 1)) := by
  refine ⟨by decide, by decide, by decide, by decide, ?_, ?_, by decide, ?_⟩ <;> ...  -- omega / Nat.add_lt_add_left
"""^^pk:lean4 ;
        skos:notation "Lap_phys = R^-2 [∂²_ρ + ρ^-1 ∂_ρ + ρ^-2 ∂²_θ] on ρ ∈ [ρ_in, 1], θ ∈ [-Θ, Θ], R(t) = R_0 s(t);  F_trough(I) = min(F_max, max(0, c_2 I + c_3)) = 0 ⟺ I ≥ I_thr = c_3/|c_2| = 0.625;  I_1 ≤ I_2 ⟹ F_trough(I_2) ≤ F_trough(I_1);  N_arcs(s) = N_0 s (3 → 6);  π(R_in + kλ) < π(R_in + (k+1)λ)" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/ncomms7971>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1387/ijdb.072502sk> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Growing-Domain Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_004.trough_synthesis" ;
        pk:leanTheorem "MathOfBiology.Loop_004.kondo_asai_1995_curvilinear_mid_trough_threshold_partition" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/kondo-pomacanthus-stripe-insertion-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Discrete Iridophore/Melanophore Agent Fate Partition Coupled to the Kondo-Asai Activator Field with Bounded Feedback (Pass 3)" ;
        dct:description "Formalizes the hybrid continuum-agent coupling: the deterministic fate partition is monotone and binary (so iridophores occupy activator peaks and melanophores the troughs), and the agent feedback perturbs the Kondo-Asai source terms within bounded intervals, preserving the Jacobian sign structure; the stochastic contact rules (short-range exclusion, long-range support) in the script are abstracted from Nakamasu et al. (2009) | Variables: A: local macroscopic activator read by a discrete pigment cell; A_thr = A^* = 3.0 (3000 in 10^3-scaled Int units): fate threshold; fate = 1 iridophore/light-stripe cell, 0 melanophore/dark-interstripe cell; κ_A, κ_I: agent-to-field feedback strengths added to the basal synthesis rates c_3, c_5" ;
        dct:source "Nakamasu, Takahashi, Kanbe & Kondo (2009) PNAS 106(21):8429-8434; Bullara & De Decker (2015) Nat. Commun. 6:6971; Kondo & Asai (1995) Nature 376(6543):765-768" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L821-L991>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_004_pomacanthus_stripe_insertion.lean#L179-L229> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cell_fate (A A_thr : Int) : Int := if A_thr ≤ A then 1 else 0
def coupled_c3 (c3 kappa_A fate : Int) : Int := c3 + kappa_A * fate
def coupled_c5 (c5 kappa_I fate : Int) : Int := c5 + kappa_I * (1 - fate)
theorem kondo_asai_1995_pigment_agent_fate_partition_and_bounded_feedback :
    (∀ A₁ A₂ A_thr : Int, A₁ ≤ A₂ → cell_fate A₁ A_thr ≤ cell_fate A₂ A_thr) ∧
    (∀ A A_thr : Int, cell_fate A A_thr = 0 ∨ cell_fate A A_thr = 1) ∧
    cell_fate 3000 3000 = 1 ∧ cell_fate 0 3000 = 0 ∧
    (∀ c3 kappa_A A A_thr : Int, 0 ≤ kappa_A → c3 ≤ coupled_c3 c3 kappa_A (cell_fate A A_thr) ∧ coupled_c3 c3 kappa_A (cell_fate A A_thr) ≤ c3 + kappa_A) ∧
    (∀ c5 kappa_I A A_thr : Int, 0 ≤ kappa_I → c5 ≤ coupled_c5 c5 kappa_I (cell_fate A A_thr) ∧ coupled_c5 c5 kappa_I (cell_fate A A_thr) ≤ c5 + kappa_I) := by
  refine ⟨?_, ?_, by decide, by decide, ?_, ?_⟩ <;> ...  -- split <;> omega
"""^^pk:lean4 ;
        skos:notation "fate(A) = [A ≥ A_thr] ∈ {0, 1}, A_1 ≤ A_2 ⟹ fate(A_1) ≤ fate(A_2);  c_3 ↦ c_3 + κ_A fate ∈ [c_3, c_3 + κ_A];  c_5 ↦ c_5 + κ_I (1 - fate) ∈ [c_5, c_5 + κ_I]  (κ_A, κ_I ≥ 0)" ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/ncomms7971>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1387/ijdb.072502sk> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Growing-Domain Reaction-Diffusion" ;
        pk:leanDeclaration "MathOfBiology.Loop_004.cell_fate" ;
        pk:leanTheorem "MathOfBiology.Loop_004.kondo_asai_1995_pigment_agent_fate_partition_and_bounded_feedback" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/kriegman-xenobot-evolutionary-biobots-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Kriegman et al. (2020) Voxel Spring-Lattice Actuation & Passive Ectoderm Volume Invariance Law" ;
        dct:description "Governs rhythmic volumetric actuation of contractile cardiac voxels while enforcing strict rest-volume invariance in passive animal-cap ectoderm voxels | Variables: L_{ij,0}: rest spring length between adjacent voxels; a_{ij} in {0,1}: tissue type (0 = passive ectoderm, 1 = contractile cardiac progenitor); epsilon_act = 0.18: volumetric contraction strain; f_act = 1.5 Hz: cardiac contraction frequency" ;
        dct:source "Kriegman, Blackiston, Levin & Bongard (2020) PNAS 117(4):1853-1859 SI Appendix S1; Cheney et al. (2013) GECCO pp. 167-174" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2020-kriegman-xenobot-evolutionary-biobots.py#L170-L271>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_083_xenobot_evolutionary_biobots.lean#L14-L39> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def voxel_rest_length (L0 a eps s : Int) : Int :=
  L0 + a * eps * s
theorem voxel_actuation_invariance_and_cycle_symmetry (L0 a eps s : Int) :
    voxel_rest_length L0 0 eps s = L0 ∧
    voxel_rest_length L0 a 0 s = L0 ∧
    voxel_rest_length L0 1 eps s + voxel_rest_length L0 1 eps (-s) = 2 * L0 := by
  refine ⟨?_, ?_, ?_⟩
  · simp [voxel_rest_length]
  · simp [voxel_rest_length]
  · simp [voxel_rest_length, Int.mul_neg]
    omega
"""^^pk:lean4 ;
        skos:notation "L_{ij}(t) = L_{ij,0}(1 + ε_act a_{ij} sin(ω t + φ_{ij}));   a_{ij}=0 ⟹ L_{ij}(t)=L_{ij,0};   L_{ij}(+s)+L_{ij}(-s)=2L_{ij,0}" ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1910837117>,
            <https://doi.org/10.1073/pnas.2112672118>,
            <https://doi.org/10.1126/scirobotics.abf1571>,
            <https://doi.org/10.1145/2463372.2463404> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Voxel Spring-Lattice Actuated Continuum Mechanics, Age-Fitness Pareto Optimization (AFPO), & Kinematic Self-Replication" ;
        pk:leanDeclaration "MathOfBiology.Loop_083.voxel_rest_length" ;
        pk:leanTheorem "MathOfBiology.Loop_083.voxel_actuation_invariance_and_cycle_symmetry" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/kriegman-xenobot-evolutionary-biobots-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Ventral-Concavity Asymmetric Substrate Ratchet & Dorsal Inversion Collapse Law" ;
        dct:description "Proves that ventral-concavity bipedal leg asymmetry rectifies zero-mean cardiac oscillations into net forward locomotion, whereas 180-deg dorsal inversion equalizes contact friction and collapses net propulsion | Variables: mu_ant = 0.65: anterior ventral leg substrate friction; mu_post = 0.18: posterior ventral leg substrate friction; e: cyclic ventral cardiac contraction stroke" ;
        dct:source "Kriegman, Blackiston, Levin & Bongard (2020) PNAS 117(4):1853-1859 Figs. 1-3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2020-kriegman-xenobot-evolutionary-biobots.py#L274-L415>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_083_xenobot_evolutionary_biobots.lean#L42-L68> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def xenobot_stride (mu_ant mu_post e : Int) : Int :=
  (mu_ant - mu_post) * e
theorem ventral_ratchet_and_dorsal_inversion_collapse (mu mu_ant mu_post e : Int) :
    xenobot_stride mu mu e = 0 ∧
    xenobot_stride mu_post mu_ant e = -xenobot_stride mu_ant mu_post e ∧
    xenobot_stride 65 18 4 = 188 ∧
    xenobot_stride 25 25 4 = 0 := by
  refine ⟨?_, ?_, by decide, by decide⟩
  · simp [xenobot_stride]
  · simp [xenobot_stride, Int.sub_mul]
    omega
"""^^pk:lean4 ;
        skos:notation "Δx_stride(μ_ant, μ_post, e) = (μ_ant - μ_post) e;   μ_ant = μ_post ⟹ Δx_stride = 0;   Δx_stride(μ_post, μ_ant, e) = -Δx_stride(μ_ant, μ_post, e)" ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1910837117>,
            <https://doi.org/10.1073/pnas.2112672118>,
            <https://doi.org/10.1126/scirobotics.abf1571>,
            <https://doi.org/10.1145/2463372.2463404> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Voxel Spring-Lattice Actuated Continuum Mechanics, Age-Fitness Pareto Optimization (AFPO), & Kinematic Self-Replication" ;
        pk:leanDeclaration "MathOfBiology.Loop_083.xenobot_stride" ;
        pk:leanTheorem "MathOfBiology.Loop_083.ventral_ratchet_and_dorsal_inversion_collapse" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/kriegman-xenobot-evolutionary-biobots-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "AFPO Phase-Robustness Transferability & Pac-Man Kinematic Self-Replication Law" ;
        dct:description "Formalizes the Kriegman et al. (2020) phase-randomization sim-to-real transferability filter and the Kriegman et al. (2021) C-shaped Pac-Man kinematic self-replication advantage over spherical morphologies | Variables: F_det: synchronous cardiac phase displacement (body lengths); F_rob: phase-randomized cardiomyocyte displacement; eta_mouth(theta_mouth): C-shaped Pac-Man concavity sweeping efficiency; N_thresh = 55: critical stem-cell pile size for self-sustaining daughter spheroid compaction" ;
        dct:source "Kriegman et al. (2020) PNAS 117:1853-1859 Fig. 2; Kriegman et al. (2021) PNAS 118:e2112672118 Figs. 1-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2020-kriegman-xenobot-evolutionary-biobots.py#L417-L536>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_083_xenobot_evolutionary_biobots.lean#L71-L100> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def afpo_transferable (F_det F_rob F_det_min F_rob_min : Nat) : Bool :=
  (F_det ≥ F_det_min) && (F_rob ≥ F_rob_min)
def kinematic_daughter_generations (eta_mouth v_orbit rho_free N_thresh : Nat) : Nat :=
  (eta_mouth * v_orbit * rho_free) / N_thresh
theorem afpo_transferability_and_pacman_replication :
    afpo_transferable 195 140 120 100 = true ∧
    afpo_transferable 185 32 120 100 = false ∧
    afpo_transferable 12 10 120 100 = false ∧
    kinematic_daughter_generations 18 3 4 55 = 3 ∧
    kinematic_daughter_generations 6 3 4 55 = 1 := by
  decide
"""^^pk:lean4 ;
        skos:notation "T_sim2real(F_det, F_rob) = I(F_det ≥ F_min ∧ F_rob ≥ F_rob_min);   N_daughters(θ_mouth) = floor(η_sweep(θ_mouth) v_orbit ρ_free / N_thresh)" ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1910837117>,
            <https://doi.org/10.1073/pnas.2112672118>,
            <https://doi.org/10.1126/scirobotics.abf1571>,
            <https://doi.org/10.1145/2463372.2463404> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Voxel Spring-Lattice Actuated Continuum Mechanics, Age-Fitness Pareto Optimization (AFPO), & Kinematic Self-Replication" ;
        pk:leanDeclaration "MathOfBiology.Loop_083.kinematic_daughter_generations" ;
        pk:leanTheorem "MathOfBiology.Loop_083.afpo_transferability_and_pacman_replication" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/kriegman-xenobot-evolutionary-biobots-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Regularised-Stokeslet Force-Free Cancellation & Squirmer Mobility Superposition Law (Pass 3)" ;
        dct:description "Guarantees that the force-free squirmer flow has no net-Stokeslet (log) far field and that the mobility is affine in the turn bias, which is how the orbit radius is fitted and the precessing orbit is driven without re-solving the boundary integral | Variables: f_k: regularised Stokeslet strengths on the parent boundary; c: the common scalar part of the 2D kernel (-(1/2) constant and far-field -ln r); U0, U1: rigid velocity at zero and unit left/right ciliary turn bias; beta: turn bias" ;
        dct:source "Cortez (2001) SIAM J. Sci. Comput. 23:1204-1225 (regularised Stokeslets); Blake (1971) J. Fluid Mech. 46:199-208 (squirmer); Kriegman et al. (2021) PNAS 118:e2112672118" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2020-kriegman-xenobot-evolutionary-biobots.py#L923-L1080>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_083_xenobot_evolutionary_biobots.lean#L101-L135> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def stokeslet_constant_part (c f1 f2 f3 : Int) : Int :=
  c * f1 + c * f2 + c * f3
def squirmer_velocity (U0 U1 beta : Int) : Int :=
  U0 + beta * U1
theorem stokeslet_force_free_cancellation_and_mobility_superposition
    (c f1 f2 f3 U0 U1 b1 b2 : Int) (hff : f1 + f2 + f3 = 0) :
    stokeslet_constant_part c f1 f2 f3 = 0 ∧
    squirmer_velocity U0 U1 0 = U0 ∧
    squirmer_velocity U0 U1 1 = U0 + U1 ∧
    squirmer_velocity U0 U1 (b1 + b2) = squirmer_velocity U0 U1 b1 + b2 * U1 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · unfold stokeslet_constant_part
    rw [← Int.mul_add, ← Int.mul_add, hff, Int.mul_zero]
  · simp [squirmer_velocity]
  · simp [squirmer_velocity]
  · simp [squirmer_velocity, Int.add_mul]
    omega
"""^^pk:lean4 ;
        skos:notation "Σ_k c f_k = c Σ_k f_k = 0 for a force-free body;   U(β) = U0 + β U1,  U(β₁+β₂) = U(β₁) + β₂ U1" ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1910837117>,
            <https://doi.org/10.1073/pnas.2112672118>,
            <https://doi.org/10.1126/scirobotics.abf1571>,
            <https://doi.org/10.1145/2463372.2463404> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Voxel Spring-Lattice Actuated Continuum Mechanics, Age-Fitness Pareto Optimization (AFPO), & Kinematic Self-Replication" ;
        pk:leanDeclaration "MathOfBiology.Loop_083.squirmer_velocity" ;
        pk:leanTheorem "MathOfBiology.Loop_083.stokeslet_force_free_cancellation_and_mobility_superposition" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/kriegman-xenobot-evolutionary-biobots-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "3D Voxel Lattice Stokes-Drag Dissipation & Passive-Spring Rest Law (Pass 3)" ;
        dct:description "Explains the monotone fitness decrease with Stokes drag (gamma in {0,1,2,4,8}) and the zero locomotion of the passive_only_control body in the 8x8x7 lattice | Variables: gamma: per-node Stokes drag coefficient (non-dimensional, default 2.0); v: node velocity; L_ij,0: spring rest length; a_ij: fraction of cardiac voxels adjoining the spring (0 for passive-only springs)" ;
        dct:source "Kriegman, Blackiston, Levin & Bongard (2020) PNAS 117(4):1853-1859 SI Appendix S1 (VoxCAD 8x8x7 workspace); Hiller & Lipson (2014) Soft Robotics 1:88-101 (VoxCAD dynamics)" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2020-kriegman-xenobot-evolutionary-biobots.py#L674-L917>,
            <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_083_xenobot_evolutionary_biobots.lean#L138-L166> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def drag_power (gamma v : Int) : Int :=
  gamma * (v * v)
theorem int_mul_self_nonneg (v : Int) : 0 ≤ v * v := by
  rcases Int.le_total 0 v with h | h
  · exact Int.mul_nonneg h h
  · have h' : 0 ≤ -v := Int.neg_nonneg_of_nonpos h
    have hm := Int.mul_nonneg h' h'
    rwa [Int.neg_mul_neg] at hm
theorem lattice_drag_dissipation_nonneg_and_passive_spring_rest
    (gamma v L0 eps s : Int) (hg : 0 ≤ gamma) :
    0 ≤ drag_power gamma v ∧
    drag_power 0 v = 0 ∧
    voxel_rest_length L0 0 eps s = L0 := by
  refine ⟨?_, ?_, ?_⟩
  · exact Int.mul_nonneg hg (int_mul_self_nonneg v)
  · simp [drag_power]
  · simp [voxel_rest_length]
"""^^pk:lean4 ;
        skos:notation "P_drag = γ v·v ≥ 0 for γ ≥ 0;   P_drag(γ=0) = 0;   a_ij = 0 ⟹ L_ij(t) = L_ij,0" ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1910837117>,
            <https://doi.org/10.1073/pnas.2112672118>,
            <https://doi.org/10.1126/scirobotics.abf1571>,
            <https://doi.org/10.1145/2463372.2463404> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Voxel Spring-Lattice Actuated Continuum Mechanics, Age-Fitness Pareto Optimization (AFPO), & Kinematic Self-Replication" ;
        pk:leanDeclaration "MathOfBiology.Loop_083.drag_power" ;
        pk:leanTheorem "MathOfBiology.Loop_083.lattice_drag_dissipation_nonneg_and_passive_spring_rest" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/lauschke-ex-vivo-scaling-mPSM-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Lauschke et al. (2013) Proportional Segment Scaling Law under Invariant Phase Span" ;
        dct:description "Establishes linear scale-invariance of embryonic segment size with residual tissue radius via a constant 2*pi total phase span across the active mPSM | Variables: S_n: newly specified concentric segment width at cycle n (um); R(t_n): residual unsegmented mPSM radius (um); alpha: dimensionless proportional scaling slope (0.11)" ;
        dct:source "Lauschke, Tsiairis, Francois & Aulehla (2013) Nature 493(7430):101-105 Figs. 2-4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L178-L269>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_026_ex_vivo_scaling_mPSM.lean#L22-L44> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def scaled_segment_width (alpha R : Nat) : Nat :=
  alpha * R
theorem lauschke_2013_proportional_segment_scaling (alpha k R R1 R2 : Nat) :
    scaled_segment_width alpha (k * R) = k * scaled_segment_width alpha R ∧
    scaled_segment_width alpha (R1 + R2) =
      scaled_segment_width alpha R1 + scaled_segment_width alpha R2"""^^pk:lean4 ;
        skos:notation "S_n = alpha * R(t_n),  where Delta_phi_total = phi(0, t) - phi(R(t), t) = Phi_0 = 2*pi" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-3-642-69689-3>,
            <https://doi.org/10.1016/j.cell.2016.01.028>,
            <https://doi.org/10.1038/nature02216>,
            <https://doi.org/10.1038/nature11804>,
            <https://doi.org/10.1038/ncb1679>,
            <https://doi.org/10.1088/1478-3975/13/3/036009> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Scale-Invariant Kinematic Phase-Gradient Encoding (Ex Vivo Monolayer PSM)" ;
        pk:leanDeclaration "MathOfBiology.Loop_026.scaled_segment_width" ;
        pk:leanTheorem "MathOfBiology.Loop_026.lauschke_2013_proportional_segment_scaling" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/lauschke-ex-vivo-scaling-mPSM-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Lauschke et al. (2013) Geometric Residual mPSM Radius Progression & Conservation Law" ;
        dct:description "Governs the inward periphery-to-center geometric contraction of the active mPSM domain and exact radial conservation across successive segmentation cycles | Variables: R_n: residual mPSM radius at cycle n (um); R_0: initial mPSM explant radius (um); S_n: n-th concentric segment width (um)" ;
        dct:source "Lauschke, Tsiairis, Francois & Aulehla (2013) Nature 493(7430):101-105 Figs. 1-3" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L275-L372>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_026_ex_vivo_scaling_mPSM.lean#L46-L67> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def residual_mpsm_radius_step (M alpha R_n : Int) : Int :=
  (M - alpha) * R_n
def budded_segment_step (alpha R_n : Int) : Int :=
  alpha * R_n
theorem lauschke_2013_geometric_residual_radius_conservation (M alpha R_n : Int) :
    residual_mpsm_radius_step M alpha R_n + budded_segment_step alpha R_n = M * R_n"""^^pk:lean4 ;
        skos:notation "R(t_{n+1}) = R(t_n) - S_n = (1 - alpha) * R(t_n) = R_0 * (1 - alpha)^n" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-3-642-69689-3>,
            <https://doi.org/10.1016/j.cell.2016.01.028>,
            <https://doi.org/10.1038/nature02216>,
            <https://doi.org/10.1038/nature11804>,
            <https://doi.org/10.1038/ncb1679>,
            <https://doi.org/10.1088/1478-3975/13/3/036009> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Scale-Invariant Kinematic Phase-Gradient Encoding (Ex Vivo Monolayer PSM)" ;
        pk:leanDeclaration "MathOfBiology.Loop_026.residual_mpsm_radius_step" ;
        pk:leanTheorem "MathOfBiology.Loop_026.lauschke_2013_geometric_residual_radius_conservation" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/lauschke-ex-vivo-scaling-mPSM-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Lauschke et al. (2013) Radial Notch Phase-Wave Velocity Scaling Law" ;
        dct:description "Explains why LuVeLu Notch oscillation waves propagate faster in larger mPSM explants and decelerate as R(t) shrinks while maintaining a 2*pi phase span | Variables: v_wave(t): radial LuVeLu Notch phase-wave propagation speed (um/min); lambda(t): effective radial phase wavelength (um); T_osc: central pacemaker clock period (140 min)" ;
        dct:source "Lauschke, Tsiairis, Francois & Aulehla (2013) Nature 493(7430):101-105 Fig. 4" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L378-L544>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_026_ex_vivo_scaling_mPSM.lean#L69-L90> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def phase_wave_kinematic_residual (v_wave T_osc lambda_ratio R : Int) : Int :=
  v_wave * T_osc - lambda_ratio * R
theorem lauschke_2013_phase_wave_velocity_scaling (lambda_ratio T_osc c : Int) :
    phase_wave_kinematic_residual (lambda_ratio * c) T_osc lambda_ratio (T_osc * c) = 0"""^^pk:lean4 ;
        skos:notation "v_wave(t) = lambda(t) / T_osc = (2*pi / Phi_0) * (R(t) / T_osc)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-3-642-69689-3>,
            <https://doi.org/10.1016/j.cell.2016.01.028>,
            <https://doi.org/10.1038/nature02216>,
            <https://doi.org/10.1038/nature11804>,
            <https://doi.org/10.1038/ncb1679>,
            <https://doi.org/10.1088/1478-3975/13/3/036009> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Scale-Invariant Kinematic Phase-Gradient Encoding (Ex Vivo Monolayer PSM)" ;
        pk:leanDeclaration "MathOfBiology.Loop_026.phase_wave_kinematic_residual" ;
        pk:leanTheorem "MathOfBiology.Loop_026.lauschke_2013_phase_wave_velocity_scaling" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/lauschke-ex-vivo-scaling-mPSM-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "FGF/Wnt Source-Sink Signalling Gradient Scale Covariance (shrinking gradient on the active mPSM)" ;
        dct:description "Supplies the shrinking FGF/Wnt gradient of Lauschke et al. (2013) Fig. 4 whose length scales with the residual mPSM radius and drives wavelength adaptation; the fixed-length exponential gradient (Dubrulle & Pourquie 2004) is the mechanistic non-scaling control | Variables: W(r,t): FGF/Wnt signalling level (W_0 at the central source, 0 at the peripheral determination-front sink); l_k = sqrt(D/k): diffusion-decay length (um); l_half: half-maximum length of the gradient (um)" ;
        dct:source "Lauschke, Tsiairis, Francois & Aulehla (2013) Nature 493(7430):101-105 Fig. 4; Aulehla et al. (2008) Nat Cell Biol 10:186-193; Dubrulle & Pourquie (2004) Nature 427:419-422" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L552-L602>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_026_ex_vivo_scaling_mPSM.lean#L100-L118> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def source_sink_gradient (W0 R r : Int) : Int :=
  W0 * (R - r)
theorem lauschke_2013_fgf_wnt_gradient_scale_covariance (W0 k R r : Int) :
    source_sink_gradient W0 (k * R) (k * r) = k * source_sink_gradient W0 R r"""^^pk:lean4 ;
        skos:notation "D W'' - k W = 0, W(0) = W_0, W(R) = 0  =>  W = W_0 sinh((R - r)/l_k)/sinh(R/l_k);  l_k >> R: W = W_0 (1 - r/R), l_half = R/2;  W(k R, k r) = k W(R, r) (scaled units)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-3-642-69689-3>,
            <https://doi.org/10.1016/j.cell.2016.01.028>,
            <https://doi.org/10.1038/nature02216>,
            <https://doi.org/10.1038/nature11804>,
            <https://doi.org/10.1038/ncb1679>,
            <https://doi.org/10.1088/1478-3975/13/3/036009> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Scale-Invariant Kinematic Phase-Gradient Encoding (Ex Vivo Monolayer PSM)" ;
        pk:leanDeclaration "MathOfBiology.Loop_026.source_sink_gradient" ;
        pk:leanTheorem "MathOfBiology.Loop_026.lauschke_2013_fgf_wnt_gradient_scale_covariance" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/lauschke-ex-vivo-scaling-mPSM-5> a skos:Concept,
            pk:Concept ;
        rdfs:label "Dynamic Notch Phase-Wave Wavelength Adaptation to the FGF/Wnt Gradient Length" ;
        dct:description "Closes the Pass 2 remediation item: the 2*pi phase span and alpha = 0.11 are recovered dynamically from the shrinking FGF/Wnt gradient (mean Phi = 6.125 rad, alpha_8 = 0.1103 at tau_lambda = T_osc/4) and lost when adaptation is frozen (alpha_8 = 0.560) or the gradient has fixed length (constant 39.5 um segments) | Variables: lambda(t): Notch phase-wave wavelength (um); tau_lambda: adaptation time (35 min default, inf = frozen ablation); Phi(t): dynamic total phase span (rad); delta_phi_seg: peripheral gating window (0.9144 rad); alpha = S_n/R(t_n): emergent scaling ratio" ;
        dct:source "Lauschke, Tsiairis, Francois & Aulehla (2013) Nature 493(7430):101-105 Fig. 4; Beaupeux & Francois (2016) Phys Biol 13:036009" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L605-L717>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_026_ex_vivo_scaling_mPSM.lean#L120-L144> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def wavelength_adaptation_error_step (M h e : Int) : Int :=
  (M - h) * e
theorem lauschke_2013_wavelength_adaptation_contraction (M h e : Int)
    (h0 : 0 ≤ h) (hM : h ≤ M) :
    Int.natAbs (wavelength_adaptation_error_step M h e) ≤ Int.natAbs (M * e)"""^^pk:lean4 ;
        skos:notation "d lambda/dt = -(lambda - c_lambda l_half(t))/tau_lambda;  Phi(t) = 2 pi R(t)/lambda(t);  phi(r,t) = omega_0 t - Phi(t) (r/R(t))^p;  S_n = R(t_n)[1 - (1 - delta_phi_seg/Phi(t_n))^(1/p)], delta_phi_seg = Phi_0[1 - (1 - alpha)^p];  discrete error step M e_{n+1} = (M - h) e_n" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-3-642-69689-3>,
            <https://doi.org/10.1016/j.cell.2016.01.028>,
            <https://doi.org/10.1038/nature02216>,
            <https://doi.org/10.1038/nature11804>,
            <https://doi.org/10.1038/ncb1679>,
            <https://doi.org/10.1088/1478-3975/13/3/036009> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Scale-Invariant Kinematic Phase-Gradient Encoding (Ex Vivo Monolayer PSM)" ;
        pk:leanDeclaration "MathOfBiology.Loop_026.wavelength_adaptation_error_step" ;
        pk:leanTheorem "MathOfBiology.Loop_026.lauschke_2013_wavelength_adaptation_contraction" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/lauschke-ex-vivo-scaling-mPSM-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "Kuramoto-Sakaguchi Reaggregate Lattice & Target-Wave Pacemaker Dispersion (Tsiairis & Aulehla 2016)" ;
        dct:description "Closes the Pass 2 remediation item: 1577 cells on a jittered hexagonal disc self-organise median 4 de novo target-wave pacemakers (cycles 1-3) that consolidate to 1 at the local frequency maximum (cycles 12-14); K = 0 stays incoherent, eta = 0 synchronises with no pacemaker | Variables: theta_i: LuVeLu phase of cell i; omega_i: intrinsic frequency (omega_0 = 2 pi / 140 min, relative heterogeneity eta = 0.25, correlation length 40 um); K: Notch coupling (0.5 rad/min); a: Sakaguchi phase lag (0.6 rad); beta k^2: frequency excess of a pacemaker emitting wavenumber k" ;
        dct:source "Tsiairis & Aulehla (2016) Cell 164(4):656-667 Figs. 2-4; Kuramoto (1984) Chemical Oscillations, Waves, and Turbulence, Springer, Ch. 5-6" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L724-L931>,
            <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_026_ex_vivo_scaling_mPSM.lean#L146-L166> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def target_wave_frequency_excess (beta k : Nat) : Nat :=
  beta * k * k
theorem tsiairis_2016_pacemaker_dispersion_monotone (beta k1 k2 : Nat) (h : k1 ≤ k2) :
    target_wave_frequency_excess beta k1 ≤ target_wave_frequency_excess beta k2"""^^pk:lean4 ;
        skos:notation "d theta_i/dt = omega_i + (K/n_i) sum_j [sin(theta_j - theta_i - a) + sin a], omega_i = omega_0 (1 + eta xi_i);  continuum: theta_t = omega + D lap theta + beta |grad theta|^2, D = K cos(a) d^2/4, beta = K sin(a) d^2/4;  pacemaker excess Delta omega = beta k^2 (monotone in k)" ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-3-642-69689-3>,
            <https://doi.org/10.1016/j.cell.2016.01.028>,
            <https://doi.org/10.1038/nature02216>,
            <https://doi.org/10.1038/nature11804>,
            <https://doi.org/10.1038/ncb1679>,
            <https://doi.org/10.1088/1478-3975/13/3/036009> ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Scale-Invariant Kinematic Phase-Gradient Encoding (Ex Vivo Monolayer PSM)" ;
        pk:leanDeclaration "MathOfBiology.Loop_026.target_wave_frequency_excess" ;
        pk:leanTheorem "MathOfBiology.Loop_026.tsiairis_2016_pacemaker_dispersion_monotone" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/levin-youtube-channel-math-1> a skos:Concept,

    <https://w3id.org/probknow/resource/claim/morphoeval-wolfram-conus-textile-rule30> a ns1:Claim ;
        rdfs:label "Wolfram (1984) Rule 30 & Meinhardt–Klingler (1987) Conus textile Pigmentation faithfully reproduces Conus textile Linnaeus, 1758 (textile cone snail) morphology" ;

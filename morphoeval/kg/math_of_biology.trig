    <https://w3id.org/delphi/resource/math-law/zhang-sorting-morphogenesis-3> a skos:Concept,
            pk:Concept ;
        rdfs:label "Coxeter Pairwise Inversion Lyapunov Descent vs. Coarse-Grained Monotonicity Error Artifact" ;
        dct:description "Proves that Bubble sort never moves against its true dynamical Lyapunov gradient I(v) (0 uphill steps) and that Delayed Gratification is a projection artifact of E(v) | Variables: I(v): global pairwise inversion count (Coxeter length on S_n); E(v): adjacent drop count" ;
        dct:source "Zhang, Goldstein & Levin (2025) Figs. 6-7; audit_platonic_space_claims.py" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/lean/loops/Loop_zhang_sorting_morphogenesis.lean#L138-L178>,
            <https://github.com/fractastical/morpholib/blob/7a781325/sorting-morphogenesis/audit_platonic_space_claims.py#L125-L195> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem lyapunov_descent_vs_monotonicity_error_projection_artifact :
    pairwise_inversions [2, 4, 1, 3] = 3 ∧
    pairwise_inversions [2, 1, 4, 3] = 2 ∧
    adjacent_monotonicity_error [2, 4, 1, 3] = 1 ∧
    adjacent_monotonicity_error [2, 1, 4, 3] = 2 := by decide
theorem adjacent_swap_strictly_decreases_inversions_window3 (a b c : Nat) (h_inv : b > c) :
    pairwise_inversions [a, c, b] + 1 = pairwise_inversions [a, b, c]
"""^^pk:lean4 ;
        skos:notation "I(v) = #{(i < j) : v_i > v_j},   ΔI = -1 on every adjacent swap (b > c),   while E(v) = #{i : v_i > v_{i+1}} can increase by ΔE = +1" ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Symmetric Group S_n Coxeter Inversion Lyapunov Dynamics & Hoel Causal Emergence 2.0" ;
        pk:leanDeclaration "MathOfBiology.ZhangSortingMorphogenesis.pairwise_inversions" ;
        pk:leanTheorem "MathOfBiology.ZhangSortingMorphogenesis.adjacent_swap_strictly_decreases_inversions_window3" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/zhang-sorting-morphogenesis-4> a skos:Concept,
            pk:Concept ;
        rdfs:label "Selection Non-Local Swap Inversion Descent Law" ;
        dct:description "Proves that Selection sort's non-local target swap across an intermediate barrier strictly decreases pairwise inversions | Variables: high, mid, low: 3-element window across which Selection swaps non-locally" ;
        dct:source "SelectionSortCell.py L41-88" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/lean/loops/Loop_zhang_sorting_morphogenesis.lean#L186-L198>,
            <https://github.com/fractastical/morpholib/blob/7a781325/sorting-morphogenesis/sorting_morphogenesis.py#L190-L260> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem selection_nonlocal_swap_strictly_decreases_inversions_window3
    (high mid low : Nat) (h_inv : high > low) :
    pairwise_inversions [low, mid, high] < pairwise_inversions [high, mid, low] := by
  simp only [pairwise_inversions, count_lt]
  split <;> split <;> split <;> split <;> split <;> omega
"""^^pk:lean4 ;
        skos:notation "high > low ⟹ I([low, mid, high]) < I([high, mid, low])   (ΔI ∈ {-1, -2, -3})" ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Symmetric Group S_n Coxeter Inversion Lyapunov Dynamics & Hoel Causal Emergence 2.0" ;

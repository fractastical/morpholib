    <https://w3id.org/delphi/resource/math-law/zhang-sorting-morphogenesis-6> a skos:Concept,
            pk:Concept ;
        rdfs:label "Hoel (2026) Causal Emergence 2.0 Intensive Causal Primitive Law on S_6" ;
        dct:description "Proves positive Causal Emergence 2.0 on Coxeter inversions I(v) (+0.1191) and negative Causal Emergence 2.0 on adjacent error E(v) (-0.2525) | Variables: det(π): Markov transition determinism; deg(π): transition degeneracy; CP(π): Hoel 2026 intensive Causal Primitive" ;
        dct:source "Hoel (2026) Patterns 7(1):101472; Hoel, Albantakis & Tononi (2013) PNAS 110:19790" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/lean/loops/Loop_zhang_sorting_morphogenesis.lean#L240-L255>,
            <https://github.com/fractastical/morpholib/blob/7a781325/sorting-morphogenesis/quantify_emergence_ce2.py#L45-L175> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def cp_score (det deg : Int) : Int := det - deg
theorem hoel_ce2_sorting_inversion_emergence_vs_error_loss :
    let cp0 := cp_score 8687 191
    let cp1 := cp_score 9553 582
    let cp2 := cp_score 10000 313
    let cpE := cp_score 7209 1238
    cp0 + (cp1 - cp0) + (cp2 - cp1) = cp2 ∧
    cp2 - cp0 = 1191 ∧ cp2 > cp0 ∧
    cpE - cp0 = -2525 ∧ cpE < cp0 := by decide
"""^^pk:lean4 ;
        skos:notation "CP(π) = det(π) - deg(π);   ΔCP(I) = CP(I) - CP(S_6) = +0.1191 > 0 (det = 1.0000) vs. ΔCP(E) = -0.2525 < 0 (det = 0.7209)" ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Symmetric Group S_n Coxeter Inversion Lyapunov Dynamics & Hoel Causal Emergence 2.0" ;
        pk:leanDeclaration "MathOfBiology.ZhangSortingMorphogenesis.cp_score" ;
        pk:leanTheorem "MathOfBiology.ZhangSortingMorphogenesis.hoel_ce2_sorting_inversion_emergence_vs_error_loss" ;
        pk:leanVerified true .


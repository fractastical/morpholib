        ns1:evidenceAgainst "2020-tozluoglu-wing-disc-dome-folding.py L1753–L1755: self_test docstring still says '8-point verification suite for Pass 2' (10 checks run) <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L1753-L1755>",
            "2020-tozluoglu-wing-disc-dome-folding.py L1853–L1853: --self-test help string says '8-check' (stale) <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L1853-L1853>" ;
        ns1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-code-traceability-1>,

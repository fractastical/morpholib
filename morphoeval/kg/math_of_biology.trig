        ns1:evidenceAgainst "datasets/emiliania_calcite_rosette/emiliania_calcite_rosette_reference.json L75–L75: t_head_hammer_width governing equation uses tanh(max(Omega-1, 0)) whereas the code uses a linear slope <https://github.com/fractastical/morpholib/blob/9987db7d/datasets/emiliania_calcite_rosette/emiliania_calcite_rosette_reference.json#L75-L75>",
            "models/2022-coccolith-emiliania-calcite-rosette.py L264–L298: Uncited constants: 0.225 slope (L264), 0.55 + 0.35 Omega (L267), 0.62 and 1.28 (L272), interlock threshold 1.35 (L278), 0.28 and 1.45 (L298) <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L264-L298>" ;
        ns1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-code-traceability-1>,

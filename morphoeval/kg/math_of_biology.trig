            <https://w3id.org/delphi/resource/evidence/2026-10-19-epithelial-buckling-3d-audit-v3-hannezo-epithelial-buckling-3d-3>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-epithelial-buckling-3d-audit-v3-hannezo-epithelial-buckling-3d-4>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-epithelial-buckling-3d-audit-v3-hannezo-epithelial-buckling-3d-5>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-epithelial-buckling-3d-audit-v3-hannezo-epithelial-buckling-3d-6>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-epithelial-buckling-3d-audit-v3-hannezo-epithelial-buckling-3d-7>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-epithelial-buckling-3d-audit-v3-hannezo-epithelial-buckling-3d-8>,
            <https://w3id.org/delphi/resource/evidence/2026-10-19-epithelial-buckling-3d-audit-v3-hannezo-epithelial-buckling-3d-9> ;
        pk:hypothesisType "3D Incompressible Vertex / Continuum Epithelial Energy with Apical (Gamma_a), Basal (Gamma_b), and Lateral (Gamma_l) Surface Tensions & Substrate Elastic Foundation" ;

        pk:leanDeclaration "MathOfBiology.Loop_093.rce100_wildtype" ;
        pk:leanTheorem "MathOfBiology.Loop_093.zajac_bertet_five_regime_perturbation_hierarchy" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/zhang-sorting-morphogenesis-1> a skos:Concept,
            pk:Concept ;
        rdfs:label "Bubble & Insertion Adjacent-Swap Barrier Pinning Law" ;
        dct:description "Proves that zero cells ever cross an immovable frozen barrier under Bubble or Insertion sort | Variables: p: adjacent swap index; d: immovable frozen defect index; i: cell position" ;
        dct:source "Zhang, Goldstein & Levin (2025) Adaptive Behavior 33(1):25-54 Fig. 5C; BubbleSortCell.py L38-74" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/lean/loops/Loop_zhang_sorting_morphogenesis.lean#L30-L79>,
            <https://github.com/fractastical/morpholib/blob/7a781325/sorting-morphogenesis/sorting_morphogenesis.py#L65-L185> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """def legal_adjacent_swap (p d : Nat) : Prop := p + 1 < d ∨ d < p
def swap_pos (p i : Nat) : Nat :=
  if i == p then p + 1 else if i == p + 1 then p else i
theorem bubble_adjacent_swap_preserves_left_partition
    (p d i : Nat) (h_legal : legal_adjacent_swap p d) :
    (i < d → swap_pos p i < d) ∧ (d < i → d < swap_pos p i)
"""^^pk:lean4 ;
        skos:notation "p + 1 < d ∨ d < p ⟹ (i < d → swap_pos(p, i) < d) ∧ (d < i → d < swap_pos(p, i))" ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Symmetric Group S_n Coxeter Inversion Lyapunov Dynamics & Hoel Causal Emergence 2.0" ;
        pk:leanDeclaration "MathOfBiology.ZhangSortingMorphogenesis.swap_pos" ;
        pk:leanTheorem "MathOfBiology.ZhangSortingMorphogenesis.bubble_adjacent_swap_preserves_left_partition" ;
        pk:leanVerified true .

    <https://w3id.org/delphi/resource/math-law/zhang-sorting-morphogenesis-2> a skos:Concept,
            pk:Concept ;
        rdfs:label "Insertion Sort Stateful Prefix-Reset Exception Handler Law" ;
        dct:description "Proves that Insertion sort's frozen-cell tolerance depends on an explicit 3-line exception handler in InsertionSortCell.py L74-76 | Variables: cells: prefix list of (value, is_frozen) pairs; prev: running lower bound reset at frozen cells" ;
        dct:source "Zhangtaining/cell_research@1fd2bd59 InsertionSortCell.py L68-82" ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7a781325/morphoeval/lean/loops/Loop_zhang_sorting_morphogenesis.lean#L86-L129>,
            <https://github.com/fractastical/morpholib/blob/7a781325/sorting-morphogenesis/audit_platonic_space_claims.py#L45-L120> ;
        skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
        skos:definition """theorem insertion_freeze_reset_unblocks_and_checks_post_frozen_order :
    prefix_sorted_strict [(2, false), (50, true), (6, false), (9, false)] = false ∧
    prefix_sorted_with_freeze_reset [(2, false), (50, true), (6, false), (9, false)] = true ∧
    prefix_sorted_with_freeze_reset [(2, false), (50, true), (12, false), (6, false)] = false := by
  decide
"""^^pk:lean4 ;
        skos:notation "status_i = FREEZE ⟹ prev ← -1  (InsertionSortCell.py L74-76);   E_without_reset = 21.95 vs. E_with_reset = 4.90" ;
        schema:programmingLanguage "Lean 4" ;
        pk:hypothesisType "Symmetric Group S_n Coxeter Inversion Lyapunov Dynamics & Hoel Causal Emergence 2.0" ;
        pk:leanDeclaration "MathOfBiology.ZhangSortingMorphogenesis.prefix_sorted_with_freeze_reset" ;
        pk:leanTheorem "MathOfBiology.ZhangSortingMorphogenesis.insertion_freeze_reset_unblocks_and_checks_post_frozen_order" ;

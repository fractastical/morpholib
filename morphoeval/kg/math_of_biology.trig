        ns1:evidenceAgainst "2012-he-drosophila-ventral-furrow.py L578–L624: 15x15 morphospace is an analytic surrogate (ap_factor, d_val, h_val) rather than ring re-simulation <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L578-L624>" ;
        ns1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-parameter-expressivity-1>,

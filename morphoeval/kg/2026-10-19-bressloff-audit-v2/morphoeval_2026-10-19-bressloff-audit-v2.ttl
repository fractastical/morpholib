<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/bressloff-v1-form-constants-1>,
        <https://w3id.org/probknow/resource/math-law/bressloff-v1-form-constants-2>,
        <https://w3id.org/probknow/resource/math-law/bressloff-v1-form-constants-3> .

<https://w3id.org/probknow/resource/math-law/bressloff-v1-form-constants-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Ermentrout & Cowan (1979) / Bressloff et al. (2001) Retino-Cortical Pullback Classification" ;
    dct:description "Maps V1 roll planforms onto Klüver's tunnel, funnel and spiral form constants; the cortical lattice orientation decides which retinal form constant is seen | Variables: r, θ: retinal polar coordinates; x, y: cortical coordinates (mm); α, β: cortical magnification constants; ε: foveal scale; w₀: foveal radius; (k_x, k_y): cortical planform wavevector" ;
    dct:source "Ermentrout & Cowan (1979) Biol. Cybern. 34:137; Bressloff et al. (2001) Phil. Trans. R. Soc. B 356:299 §2; Bressloff et al. (2002) Neural Comput. 14:473 Eq. 2.1" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9b18c52/2001-bressloff-v1-form-constants.py#L96-L121,L759-L790,L854-L863>,
        <https://github.com/fractastical/morpholib/blob/9b18c52/morphoeval/lean/MathOfBiology.lean#L507-L531> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def retino_cortical_phase (kx ky x y : Int) : Int := kx * x + ky * y
theorem ermentrout_cowan_tunnel_rings (kx x y y' : Int) :
    retino_cortical_phase kx 0 x y = retino_cortical_phase kx 0 x y' := by simp [retino_cortical_phase]
theorem ermentrout_cowan_funnel_rays (ky x x' y : Int) :
    retino_cortical_phase 0 ky x y = retino_cortical_phase 0 ky x' y := by simp [retino_cortical_phase]
theorem ermentrout_cowan_log_spiral (kx ky x x' y y' : Int) :
    retino_cortical_phase kx ky x y - retino_cortical_phase kx ky x' y' =
    kx * (x - x') + ky * (y - y') := by
  simp [retino_cortical_phase, Int.mul_sub]
  omega"""^^pk:lean4 ;
    skos:notation "x = (α/ε) ln(1 + ε r/w₀),  y = β r θ/(w₀ + ε r)  (far field ε r ≫ w₀: x ≈ (α/ε) ln(ε r/w₀), y ≈ (β/ε) θ);  phase(k_x, k_y) = k_x x + k_y y:  k_y = 0 → rings (tunnel),  k_x = 0 → rays (funnel),  else log-spiral θ = c − (k_x/k_y) ln r",
        "x = (α/ε) ln(ε r/w₀),  y = (β/ε) θ;  phase(k_x, k_y) = k_x x + k_y y:  k_y = 0 → rings (tunnel),  k_x = 0 → rays (funnel),  else log-spiral θ = c − (k_x/k_y) ln r" ;
    prov:wasDerivedFrom <https://doi.org/10.1001/archopht.1991.01080060080030>,
        <https://doi.org/10.1007/BF00336965>,
        <https://doi.org/10.1098/rstb.2000.0769>,
        <https://doi.org/10.1162/089976602317250861>,
        <https://doi.org/10.1371/journal.pcbi.1002158> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Euclidean Symmetry-Breaking Neural-Field Bifurcation & Log-Polar Retino-Cortical Geometry" ;
    pk:leanDeclaration "MathOfBiology.retino_cortical_phase" ;
    pk:leanTheorem "MathOfBiology.ermentrout_cowan_log_spiral" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/bressloff-v1-form-constants-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Bressloff et al. (2001) Cubic Amplitude-Equation Roll/Lattice Stability Boundary" ;
    dct:description "Selects rolls vs rhombic, square or hexagonal lattices (Figs. 37–40); decides whether a hallucination is a single-family tunnel/spiral or a cobweb/honeycomb | Variables: A_i: squared mode amplitudes; λ: bifurcation parameter (distance past marginal stability); γ₀ = γ₃(0): self-coupling; γ₃(θ): cross-mode cubic coupling at wavevector angle θ (Eq. 5.15)" ;
    dct:source "Bressloff et al. (2001) Phil. Trans. R. Soc. B 356:299 §5 Eqs. 5.12–5.15, Figs. 37–40" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9b18c52/2001-bressloff-v1-form-constants.py#L516-L541,L595-L693>,
        <https://github.com/fractastical/morpholib/blob/9b18c52/morphoeval/lean/MathOfBiology.lean#L533-L561> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def amplitude_rhs (lam gamma0 gamma_theta a_self a_other : Int) : Int :=
  lam - gamma0 * a_self - 2 * gamma_theta * a_other
theorem bressloff_roll_fixed_point (gamma0 gamma_theta a : Int) :
    amplitude_rhs (gamma0 * a) gamma0 gamma_theta a 0 = 0 := by simp [amplitude_rhs]
theorem bressloff_roll_transverse_growth (gamma0 gamma_theta a : Int) :
    amplitude_rhs (gamma0 * a) gamma0 gamma_theta 0 a = (gamma0 - 2 * gamma_theta) * a := by
  simp [amplitude_rhs, Int.sub_mul]
theorem bressloff_roll_stable_iff (gamma0 gamma_theta : Int) :
    amplitude_rhs (gamma0 * 1) gamma0 gamma_theta 0 1 < 0 ↔ gamma0 < 2 * gamma_theta := by
  simp [amplitude_rhs]
  omega
theorem bressloff_fig38_roll_unstable :
    amplitude_rhs (3768 * 1) 3768 1869 0 1 = 30 := by decide"""^^pk:lean4 ;
    skos:notation "dA₁/dt = A₁ (λ − γ₀ A₁ − 2 γ₃(θ) A₂);  roll fixed point λ = γ₀ A₁;  transverse growth (γ₀ − 2γ₃(θ)) A₁;  roll stable ⇔ γ₀ < 2 γ₃(θ)" ;
    prov:wasDerivedFrom <https://doi.org/10.1001/archopht.1991.01080060080030>,
        <https://doi.org/10.1007/BF00336965>,
        <https://doi.org/10.1098/rstb.2000.0769>,
        <https://doi.org/10.1162/089976602317250861>,
        <https://doi.org/10.1371/journal.pcbi.1002158> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Euclidean Symmetry-Breaking Neural-Field Bifurcation & Log-Polar Retino-Cortical Geometry" ;
    pk:leanDeclaration "MathOfBiology.amplitude_rhs" ;
    pk:leanTheorem "MathOfBiology.bressloff_roll_stable_iff" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/bressloff-v1-form-constants-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Rule, Stoffregen & Ermentrout (2011) Floquet Resonance Tongues (1:1 Harmonic vs 2:1 Period-Doubling)" ;
    dct:description "Separates flicker-induced stripe phosphenes (harmonic tongue) from period-doubled hexagonal phosphenes (subharmonic tongue) across (T, β) | Variables: μ: Floquet multiplier of the homogeneous flicker orbit; T: forcing period (ms); β: normalised wave number; n: number of elapsed forcing periods" ;
    dct:source "Rule, Stoffregen & Ermentrout (2011) PLoS Comput. Biol. 7(9):e1002158 Fig. 8" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9b18c52/2001-bressloff-v1-form-constants.py#L1134-L1146,L1397-L1456>,
        <https://github.com/fractastical/morpholib/blob/9b18c52/morphoeval/lean/MathOfBiology.lean#L563-L588> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def floquet_iterate (mu : Int) : Nat → Int
  | 0 => 1
  | n + 1 => mu * floquet_iterate mu n
theorem rule_2011_harmonic_returns_each_period (n : Nat) : floquet_iterate 1 n = 1
theorem rule_2011_period_doubling_even_odd (n : Nat) :
    floquet_iterate (-1) (2 * n) = 1 ∧ floquet_iterate (-1) (2 * n + 1) = -1"""^^pk:lean4 ;
    skos:notation "mode after n forcing periods = μⁿ;  μ = +1 (1:1 stripes) → μⁿ = 1;  μ = −1 (2:1 hexagons) → μ^{2n} = 1, μ^{2n+1} = −1" ;
    prov:wasDerivedFrom <https://doi.org/10.1001/archopht.1991.01080060080030>,
        <https://doi.org/10.1007/BF00336965>,
        <https://doi.org/10.1098/rstb.2000.0769>,
        <https://doi.org/10.1162/089976602317250861>,
        <https://doi.org/10.1371/journal.pcbi.1002158> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Euclidean Symmetry-Breaking Neural-Field Bifurcation & Log-Polar Retino-Cortical Geometry" ;
    pk:leanDeclaration "MathOfBiology.floquet_iterate" ;
    pk:leanTheorem "MathOfBiology.rule_2011_period_doubling_even_odd" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow LLM-assessment template) that evaluates the hypothesis pkr:hypothesis/morphoeval-<sim>-<dimension> with pk:hasProbability = score/100 and a pk:hasVerdict band; the overall score evaluates pkr:hypothesis/morphoeval-<sim> and is also the pk:weightOfEvidence of the pk:Claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .

<https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
    rdfs:label "Claude Fable 5.1 (primary) + Gemini 4 Argon (independent blinded second assessor)" .


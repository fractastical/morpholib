sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-bressloff-audit-v2-bressloff-v1-form-constants-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Source and data traceability: 80/100" ;
        rdfs:comment "All five primary sources carry DOI and PMID in the docstring, the dataset README and paper_citations.bib; the upstream repository is named with a full commit hash and license; four fixtures are SHA-256 pinned and verified at run time (I re-hashed them and they match); the Horton & Hoyt fixture records its formula, units and basis. Deductions: the fixture-failure disclosure is incomplete, since only the 11 stability_reports checks are aggregated while the fixture's runs[] carry 122 checks with 11 failures (including same-lattice-branch-family expected square got roll for the rendered fig31 cobweb preset) that are never surfaced (-10); alpha = 3/pi and beta = 1.589/2 are cited to Bressloff 2001 Section 2 but that section states w_0 and eps, and no page or upstream line is given for alpha/beta (-5); driven-neural-fields-registry.json is pinned and advertised as the negative-control source but is never read by the script (-3); the Rule fixture is a numerical calibration surface, not digitised Fig. 8 curves, and its own source curves are not drawn (-2). Evidence: 2001-bressloff-v1-form-constants.py L11–L37: Five sources with DOI+PMID and upstream commit 344863a1 with license <https://github.com/fractastical/morpholib/blob/9b18c52/2001-bressloff-v1-form-constants.py#L11-L37>; 2001-bressloff-v1-form-constants.py L88–L93: SHA-256 pins for four fixtures; registry fixture pinned but unused elsewhere in the script <https://github.com/fractastical/morpholib/blob/9b18c52/2001-bressloff-v1-form-constants.py#L88-L93>; 2001-bressloff-v1-form-constants.py L1029–L1041: summarize_fixture_checks aggregates only stability_reports checks; runs[] checks (11 failures) omitted <https://github.com/fractastical/morpholib/blob/9b18c52/2001-bressloff-v1-form-constants.py#L1029-L1041>; datasets/bressloff/README.md L9–L19: Fixture table with SHA-256, upstream paths and the two caveats the script does surface <https://github.com/fractastical/morpholib/blob/9b18c52/datasets/bressloff/README.md#L9-L19>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-bressloff-v1-form-constants-source-traceability> ;
        pk:hasProbability "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-bressloff-v1-form-constants-source-traceability> rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants (2001-bressloff-v1-form-constants.py, docs/media/bressloff_v1_form_constants.gif, bressloff_v1_metrics.csv, datasets/bressloff/horton_hoyt_1991_magnification.json) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Homo sapiens primary visual cortex (V1) — geometric visual hallucinations (Klüver form constants) and flicker phosphenes" ;
        dct:identifier "morphoeval/0.1.0/source-traceability" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary) + Gemini 4 Argon (independent blinded second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1001/archopht.1991.01080060080030>,
            <https://doi.org/10.1007/BF00336965>,
            <https://doi.org/10.1098/rstb.2000.0769>,
            <https://doi.org/10.1162/089976602317250861>,
            <https://doi.org/10.1371/journal.pcbi.1002158> .
    <https://doi.org/10.1001/archopht.1991.01080060080030> dct:date "1991"^^xsd:gYear ;
        dct:title "The representation of the visual field in human striate cortex: a revision of the classic Holmes map" .
    <https://doi.org/10.1007/BF00336965> dct:date "1979"^^xsd:gYear ;
        dct:title "A mathematical theory of visual hallucination patterns" .
    <https://doi.org/10.1098/rstb.2000.0769> dct:date "2001"^^xsd:gYear ;
        dct:title "Geometric visual hallucinations, Euclidean symmetry and the functional architecture of striate cortex" .
    <https://doi.org/10.1162/089976602317250861> dct:date "2002"^^xsd:gYear ;
        dct:title "What geometric visual hallucinations tell us about the visual cortex" .
    <https://doi.org/10.1371/journal.pcbi.1002158> dct:date "2011"^^xsd:gYear ;
        dct:title "A model for the origin and properties of flicker-induced geometric phosphenes" .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Ambystoma mexicanum Schnakenberg onset wavelength at 184.3 µm (Pass 2) — Model fidelity to source: 89/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The homogeneous law is unchanged and checked: trace −0.2, det 1, ratio 9 above r_c ≈ 8.568, onset wavenumber fixed at 2π/184.3 µm, linear fastest mode 187.19 µm. Pass 2 integrates from noise. The shell that wins is n = 8, the onset shell, rather than a mode that was planted in the initial condition. A shallow source gradient of amplitude 0.12 is an extra term, stated as such. The dispersion cusp is the discriminant branch point (vertical tangent where disc = 0), drawn on a 900-point grid and labeled." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ambystoma-mexicanum-turing-wavelength-s0.py L140–L165" ;
        dct:description "continuous real part of σ(k); cusp at disc = 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dddc48a7fadc3d15f0038b8b8ef2a781309b9d10/models/2026-delphi10000-ambystoma-mexicanum-turing-wavelength-s0.py#L140-L165> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ambystoma-mexicanum-turing-wavelength-s0.py L234–L289" ;
        dct:description "noise seed, shallow a(x), spectral step" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dddc48a7fadc3d15f0038b8b8ef2a781309b9d10/models/2026-delphi10000-ambystoma-mexicanum-turing-wavelength-s0.py#L234-L289> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; second provider still not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


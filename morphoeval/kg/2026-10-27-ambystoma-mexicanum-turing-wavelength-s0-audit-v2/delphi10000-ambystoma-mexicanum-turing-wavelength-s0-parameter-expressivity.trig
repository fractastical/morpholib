sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Ambystoma mexicanum Schnakenberg onset wavelength at 184.3 µm (Pass 2) — Parameter expressivity: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Diffusivity scale s moves the fastest wavelength from about 112 µm to about 337 µm, and the periodic shell tracks it (figure C). Raising Dv/Du from 9 to 14, with the onset wavenumber held fixed, moves the fastest wavelength monotonically from 187.2 µm to 212.1 µm. Dv = Du remains stable." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ambystoma-mexicanum-turing-wavelength-s0.py L172–L219" ;

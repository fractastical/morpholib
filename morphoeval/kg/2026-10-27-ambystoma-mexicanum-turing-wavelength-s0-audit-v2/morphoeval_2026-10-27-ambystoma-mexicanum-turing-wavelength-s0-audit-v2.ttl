<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-ambystoma-mexicanum-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-ambystoma-mexicanum-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-ambystoma-mexicanum-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-ambystoma-mexicanum-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg onset wavenumber" ;
    dct:description "Selects the 184 µm primordium pigment spacing on the Holocene axolotl flank | Variables: f_u = 0.8, g_v = -1, D_v/D_u = 9, lambda_c = 184.3 um" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; Murray (1981) DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/dddc48a7fadc3d15f0038b8b8ef2a781309b9d10/models/2026-delphi10000-ambystoma-mexicanum-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/dddc48a7fadc3d15f0038b8b8ef2a781309b9d10/morphoeval/lean/loops/Loop_3107_ambystoma_mexicanum_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c = 184.3 um" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/978-3-642-75056-4>,
        <https://doi.org/10.1007/bf00219740>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1600-0749.1993.tb00611.x>,
        <https://doi.org/10.1387/ijdb.8877441> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3107.onsetNumeratorTenth" ;
    pk:leanTheorem "MathOfBiology.Loop_3107.onset_wavenumber_is_real" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-ambystoma-mexicanum-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diffusion-free stability of the uniform chromatophore state" ;
    dct:description "Uniform state is stable without diffusion and unstable with it | Variables: trace ×10 = -2, det ×100 = 100 at (a, b) = (0.10, 0.90)" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/dddc48a7fadc3d15f0038b8b8ef2a781309b9d10/models/2026-delphi10000-ambystoma-mexicanum-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/dddc48a7fadc3d15f0038b8b8ef2a781309b9d10/morphoeval/lean/loops/Loop_3107_ambystoma_mexicanum_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "trace(J) = f_u + g_v < 0 and det(J) = f_u g_v - f_v g_u > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/978-3-642-75056-4>,
        <https://doi.org/10.1007/bf00219740>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1600-0749.1993.tb00611.x>,
        <https://doi.org/10.1387/ijdb.8877441> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3107.traceTenth" ;
    pk:leanTheorem "MathOfBiology.Loop_3107.diffusion_free_equilibrium_is_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-ambystoma-mexicanum-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Eight-wavelength primordium patch" ;
    dct:description "Domain that holds eight onset wavelengths at this scale and no other chronospecies | Variables: n = 8, lambda tenth-um = 1843, domain tenth-um = 14744" ;
    dct:source "Epperlein & Löfberg (1989) DOI:10.1007/978-3-642-75056-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/dddc48a7fadc3d15f0038b8b8ef2a781309b9d10/models/2026-delphi10000-ambystoma-mexicanum-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/dddc48a7fadc3d15f0038b8b8ef2a781309b9d10/morphoeval/lean/loops/Loop_3107_ambystoma_mexicanum_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "L = 8 * 184.3 um = 1474.4 um" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/978-3-642-75056-4>,
        <https://doi.org/10.1007/bf00219740>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1600-0749.1993.tb00611.x>,

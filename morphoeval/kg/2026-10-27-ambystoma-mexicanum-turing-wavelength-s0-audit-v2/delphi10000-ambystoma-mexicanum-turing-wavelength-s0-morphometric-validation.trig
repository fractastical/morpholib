    <https://doi.org/10.1007/978-3-642-75056-4> dct:date "1989"^^xsd:gYear ;
        dct:title "The development of the larval pigment patterns in Triturus alpestris and Ambystoma mexicanum" .
    <https://doi.org/10.1007/bf00219740> dct:date "1988"^^xsd:gYear ;
        dct:title "Identification of pigment cells during early amphibian development (Triturus alpestris, Ambystoma mexicanum)" .
    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:date "1981"^^xsd:gYear ;
        dct:title "A pre-pattern formation mechanism for animal coat markings" .

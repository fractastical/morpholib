        schema:value "0.904273" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-turing-max-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "turing_max_growth_rate = 0.018769 1/time" ;
        dct:description "positive σ is the wavelength-selection instability" ;
        schema:measurementTechnique "max σ(k) in the Turing regime Dv/Du = 9" ;
        schema:name "turing_max_growth_rate" ;
        schema:unitText "1/time" ;
        schema:value "0.018769" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-turing-max-growth-rate-reference> .

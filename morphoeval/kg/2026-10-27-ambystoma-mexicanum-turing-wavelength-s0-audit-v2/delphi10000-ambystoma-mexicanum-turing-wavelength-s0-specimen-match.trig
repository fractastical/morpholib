sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Ambystoma mexicanum Schnakenberg onset wavelength at 184.3 µm (Pass 2) — Morphological realism / specimen match: 76/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Panel B is now a broken spot-and-labyrinth field in the micrograph's circular stop, colored with melanophore and xanthophore means taken from the photograph, beside the real dendritic chromatophores. It is the same kind of image and no longer a perfect crystal. Coherency is still 0.904 against 0.485: the render is smoother and more locally aligned than stellate cells, and the blue edge of the micrograph is not in the model. Not a pixel copy. GIF-to-specimen computer-vision similarity on the last frame is 87.5." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/ambystoma_mexicanum_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "Pass 2 side-by-side — docs/media/ambystoma_mexicanum_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-ambystoma-mexicanum-turing-wavelength-s0.py at dddc48a7fadc3d15f0038b8b8ef2a781309b9d10, image/png, 515758 B, 1248×1032 px, artifact_sha256 eac1fafcca7513647129b2a2b97ebe9d840c346279a139f1ce03ead92d5bd5f0 (sha256 eac1fafcca7513647129b2a2b97ebe9d840c346279a139f1ce03ead92d5bd5f0), spec_fingerprint 948f3bc47cbf1c637386574fa0406a35e731104672ab92814b20a045ca1592e1" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Antirrhinum majus Turing ocellus wavelength at 259 µm (Holocene, 0 Ma) — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Gallery bar 111 px = 100 µm, ring pitch 77.8 µm, foreground fraction 0.684, coherency 0.236. None of these equals its reference (the references are λ_c, 0.5, and 0.25). KS of the gap samples is 1.0. Pass 2 cuts the unit-scale wavelength bias from about 7% to 1.6% (255.1 vs 259.13 µm) and lowers RMSE(k) from 0.00114 to 0.000263." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-analytical-critical-wavelength-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-diffusivity-scale-sweep-pearson-r-of-measured-vs-analytical-k-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-diffusivity-scale-sweep-rmse-of-wavenumber>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-domain-growth-mode-count-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-specimen-image-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-specimen-ocellus-ring-spacing>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-successor-petal-mode-count-at-10-mm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-analytical-critical-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "analytical critical wavelength lambda_c = 259.1268 µm" ;
        dct:description "D_v=4341 places argmax σ(k) 0.02 µm under the assigned 259.2 µm" ;
        schema:measurementTechnique "2π / argmax_k σ(k) with D_u=640, D_v=4341 µm²/h" ;
        schema:name "analytical critical wavelength lambda_c" ;
        schema:unitText "µm" ;
        schema:value "259.1268" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-analytical-critical-wavelength-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-analytical-critical-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "slot 3114 assigned scale 259.2 µm = 0.0002592 m" ;
        schema:value "259.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-diffusivity-scale-sweep-pearson-r-of-measured-vs-analytical-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffusivity-scale sweep Pearson r of measured vs analytical k_c = 0.99973 correlation" ;
        dct:description "RMSE(k) = 0.000263 µm⁻¹" ;
        schema:measurementTechnique "8-point joint D_u, D_v scale sweep, Fourier-space linear evolution, radial PSD peak" ;
        schema:name "diffusivity-scale sweep Pearson r of measured vs analytical k_c" ;
        schema:unitText "correlation" ;
        schema:value "0.99973" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-diffusivity-scale-sweep-pearson-r-of-measured-vs-analytical-k-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-diffusivity-scale-sweep-pearson-r-of-measured-vs-analytical-k-c-reference> a schema:PropertyValue ;
        dct:source "MorphoEval gate Pearson r > 0.98" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-diffusivity-scale-sweep-rmse-of-wavenumber> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffusivity-scale sweep RMSE of wavenumber = 0.000263 µm⁻¹" ;
        schema:measurementTechnique "sqrt mean square error between analytical k_c and Fourier peak" ;
        schema:name "diffusivity-scale sweep RMSE of wavenumber" ;
        schema:unitText "µm⁻¹" ;
        schema:value "0.000263" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-diffusivity-scale-sweep-rmse-of-wavenumber-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-diffusivity-scale-sweep-rmse-of-wavenumber-reference> a schema:PropertyValue ;
        dct:source "sub-bin agreement tolerance on this grid" ;
        schema:value "0.005" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-domain-growth-mode-count-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "domain-growth mode-count Pearson r = 1.0 correlation" ;
        dct:description "N(10 mm) = 38.06" ;
        schema:measurementTechnique "N = k_measured L / 2π versus L/λ_c from one wavelength to a 10 mm lobe" ;
        schema:name "domain-growth mode-count Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-domain-growth-mode-count-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-domain-growth-mode-count-pearson-r-reference> a schema:PropertyValue ;
        dct:source "mode count must track domain width" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation sigma_max = -0.25 h⁻¹" ;
        dct:description "spatial std ratio after growth = 0.0041" ;
        schema:measurementTechnique "same linear solver with D_u = D_v = 640" ;
        schema:name "equal-diffusion ablation sigma_max" ;
        schema:unitText "h⁻¹" ;
        schema:value "-0.25" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max-reference> a schema:PropertyValue ;
        dct:source "Turing 1952: diffusion-driven instability requires D_u ≠ D_v" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-specimen-image-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image foreground fraction = 0.6837 fraction" ;
        schema:measurementTechnique "contrast-to-border mask on the gallery ocellus" ;
        schema:name "specimen image foreground fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.6837" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "neutral fill; the measured mask is not this constant" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image structure-tensor coherency = 0.2359 dimensionless" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) of the Sobel structure tensor inside the mask" ;
        schema:name "specimen image structure-tensor coherency" ;
        schema:unitText "dimensionless" ;
        schema:value "0.2359" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "not the measured coherency" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-specimen-ocellus-ring-spacing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen ocellus ring spacing = 77.7778 µm" ;
        dct:description "CV = 0.047, bar = 111 px, coherency = 0.236" ;
        schema:measurementTechnique "radial gray peaks × (100 µm / detected scale-bar pixels) on the gallery field" ;
        schema:name "specimen ocellus ring spacing" ;
        schema:unitText "µm" ;
        schema:value "77.7778" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-specimen-ocellus-ring-spacing-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-specimen-ocellus-ring-spacing-reference> a schema:PropertyValue ;
        dct:source "model λ_c; the gallery pitch is an independent measurement and is not fitted to it" ;
        schema:value "259.1268" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-successor-petal-mode-count-at-10-mm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "successor petal mode count at 10 mm = 38.591 wavelengths" ;
        schema:measurementTechnique "10000 µm / λ_c" ;
        schema:name "successor petal mode count at 10 mm" ;
        schema:unitText "wavelengths" ;
        schema:value "38.591" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-successor-petal-mode-count-at-10-mm-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-measurement-successor-petal-mode-count-at-10-mm-reference> a schema:PropertyValue ;
        dct:source "this 259 µm scale holds one wavelength; the petal holds many" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-antirrhinum-majus-turing-wavelength-s0.py L429–L494" ;

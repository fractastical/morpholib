sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Antirrhinum majus Turing ocellus wavelength at 259 µm (Holocene, 0 Ma) — Parameter expressivity: 93/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Joint scale of D_u and D_v from 0.35 to 4 moves λ from about 153 µm to about 518 µm. With physical-k bins, Pearson r is 0.99973 and RMSE(k) is 0.000263 µm⁻¹. The ablation D_u = D_v = 640 stays at σ_max = −0.25 and is not on that curve." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/math-law/delphi10000-antirrhinum-majus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Reaction stability without diffusion" ;
    dct:description "Homogeneous petal epidermis is stable until diffusion is added | Variables: f_u=1.25, g_v=-1.75, f_v=-1.50, g_u=2.00 (rates per hour)" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-antirrhinum-majus-turing-wavelength-s0.py#L124-L127>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3114_antirrhinum_majus_turing_wavelength_s0.lean#L8-L22> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "tr J = f_u + g_v < 0 and det J = f_u g_v - f_v g_u > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/369661a0>,
        <https://doi.org/10.1073/pnas.0306308101>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1105/tpc.105.039255>,
        <https://doi.org/10.1111/j.1469-8137.2010.03498.x> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3114.trace" ;
    pk:leanTheorem "MathOfBiology.Loop_3114.trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-antirrhinum-majus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber k_c" ;
    dct:description "Selects one ocellus wavelength on a 259 µm domain | Variables: D_u=640, D_v=4341 µm^2/h; realized lambda_c=259.13 µm at age 0 Ma" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-antirrhinum-majus-turing-wavelength-s0.py#L139-L168>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3114_antirrhinum_majus_turing_wavelength_s0.lean#L24-L34> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c = argmax_k sigma(k), lambda_c = 2 pi / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/369661a0>,
        <https://doi.org/10.1073/pnas.0306308101>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1105/tpc.105.039255>,
        <https://doi.org/10.1111/j.1469-8137.2010.03498.x> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3114.turingDiscriminant" ;
    pk:leanTheorem "MathOfBiology.Loop_3114.turing_band_open" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-antirrhinum-majus-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control. The band disappears when the two morphogens diffuse equally. | Variables: D_u = D_v = 640" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-antirrhinum-majus-turing-wavelength-s0.py#L183-L187>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3114_antirrhinum_majus_turing_wavelength_s0.lean#L36-L42> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "h = D (f_u + g_v) < 0 when D_u = D_v" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/369661a0>,
        <https://doi.org/10.1073/pnas.0306308101>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1105/tpc.105.039255>,
        <https://doi.org/10.1111/j.1469-8137.2010.03498.x> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3114.diffusionTrace" ;
    pk:leanTheorem "MathOfBiology.Loop_3114.equal_diffusion_closes_band" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-antirrhinum-majus-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Mode count across scales at 0 Ma" ;
    dct:description "What changes versus the scale predecessor and the scale successor. No fossil chronospecies. | Variables: cell ≤ 40 µm, this scale 259.2 µm, petal lobe 10 mm, age 0 Ma" ;

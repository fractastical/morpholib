<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-novamexicana-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg discriminant at delta = 24" ;
    dct:description "Turing instability condition (iv) at the novamexicana 1.9 µm parameters | Variables: f_u = 4/5, g_v = -1, det J = 1, delta = Dv/Du = 24" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0; Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3195_drosophila_novamexicana_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(5*delta*f_u - 5)^2 - 4*delta*det*25 = 91^2 - 2400 > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1176980>,
        <https://doi.org/10.3389/fevo.2020.00184> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (Schnakenberg 1979 / Turing 1952 / Murray 1981 gamma)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3195.discriminantMargin" ;
    pk:leanTheorem "MathOfBiology.Loop_3195.novamexicana_turing_discriminant_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-novamexicana-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control: equal diffusion cannot select a wavelength | Variables: delta = Dv/Du" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3195_drosophila_novamexicana_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "4*delta - 5 < 0 when delta = 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1176980>,
        <https://doi.org/10.3389/fevo.2020.00184> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (Schnakenberg 1979 / Turing 1952 / Murray 1981 gamma)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3195.equalDiffusionCross" ;
    pk:leanTheorem "MathOfBiology.Loop_3195.equal_diffusion_suppresses_turing" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-novamexicana-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Pale cis-regulatory state lengthens lambda_c" ;
    dct:description "What changes at 1.9 µm and 0 Ma versus predecessor mojavensis and successor orena | Variables: lambda in nm: 1901, 1421, 1179; gamma scaled by 100" ;
    dct:source "Murray 1981 DOI:10.1016/0022-5193(81)90334-9; Wittkopp et al. 2009 DOI:10.1126/science.1176980" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3195_drosophila_novamexicana_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda(gamma) = 1.901 µm / sqrt(gamma); gamma_orena=2.60 > gamma_mojavensis=1.79 > gamma_nova=1.00" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1176980>,
        <https://doi.org/10.3389/fevo.2020.00184> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (Schnakenberg 1979 / Turing 1952 / Murray 1981 gamma)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3195.lambdaNovaNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3195.pale_cis_regulatory_state_lengthens_wavelength" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-novamexicana-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Eight wavelengths on the abdominal patch" ;

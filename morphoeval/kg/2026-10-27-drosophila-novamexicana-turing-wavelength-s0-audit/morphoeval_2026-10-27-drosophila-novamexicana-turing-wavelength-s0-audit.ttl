    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3195_drosophila_novamexicana_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila novamexicana 1.9 µm Turing wavelength (Holocene, 0 Ma) — Model fidelity to source: 84/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "steady_state, growth_rate and turing_summary implement the Schnakenberg Jacobian and Turing's σ(k). Self-test gives trace=-0.20, det=1, σ_max=0.306 and equal-diffusion σ_max=-0.103. Four Lean theorems check the cleared discriminant, the equal-diffusion cross term, the wavelength order 1901>1421 and 1901>1179 nm, and 8*1901=15208. Deduction: pass 1 still treats the homogeneous field as the generative picture, and gamma for the neighbors is a reconstruction." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "models/2026-delphi10000-drosophila-novamexicana-turing-wavelength-s0.py L309–L316: post-hoc modulate_specimen is not the PDE <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-novamexicana-turing-wavelength-s0.py#L309-L316>" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.4e-01 ;
    pk:hasVerdict "faithful" .


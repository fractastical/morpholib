    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1176980>,
        <https://doi.org/10.3389/fevo.2020.00184> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (Schnakenberg 1979 / Turing 1952 / Murray 1981 gamma)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3195.lambdaNovaNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3195.patch_holds_eight_wavelengths" ;
    pk:leanVerified true .


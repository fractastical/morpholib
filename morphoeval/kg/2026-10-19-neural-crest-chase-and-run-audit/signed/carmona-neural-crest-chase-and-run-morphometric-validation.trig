sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-carmona-neural-crest-chase-and-run> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-cil-coa-attraction-at-contact-radius> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cil_coa_attraction_at_contact_radius = 1.1015 force_units" ;
        schema:measurementTechnique "Net homotypic pair force F_pair(R_CIL) = k_COA * exp(-R_CIL / l_COA) at d = R_CIL = 28 um" ;
        schema:name "cil_coa_attraction_at_contact_radius" ;
        schema:unitText "force_units" ;
        schema:value "1.1015" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-cil-coa-attraction-at-contact-radius-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-cil-coa-attraction-at-contact-radius-reference> a schema:PropertyValue ;
        schema:value "1.1019" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-cil-coa-contact-repulsion-at-zero-distance> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cil_coa_contact_repulsion_at_zero_distance = -2.6 force_units" ;
        schema:measurementTechnique "Net homotypic pair force F_pair(0) = -k_CIL + k_COA for k_CIL=4.2, k_COA=1.6 (Carmona-Fontaine et al. 2011)" ;
        schema:name "cil_coa_contact_repulsion_at_zero_distance" ;
        schema:unitText "force_units" ;
        schema:value "-2.6" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-cil-coa-contact-repulsion-at-zero-distance-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-cil-coa-contact-repulsion-at-zero-distance-reference> a schema:PropertyValue ;
        schema:value "-2.6" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-no-placode-control-forward-migration-index> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "no_placode_control_forward_migration_index = 0.0107 FMI" ;
        schema:measurementTechnique "Null Forward Migration Index |FMI| in placode-ablated negative control (chi_Sdf1 = 0)" ;
        schema:name "no_placode_control_forward_migration_index" ;
        schema:unitText "FMI" ;
        schema:value "0.0107" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-no-placode-control-forward-migration-index-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-no-placode-control-forward-migration-index-reference> a schema:PropertyValue ;
        schema:value "0.04" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-wildtype-chase-and-run-forward-migration-index> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wildtype_chase_and_run_forward_migration_index = 0.9449 FMI" ;
        schema:measurementTechnique "Forward Migration Index (FMI = mean dx / path_length) in wild-type chase-and-run simulation (Theveneau et al. 2013 Fig. 2)" ;
        schema:name "wildtype_chase_and_run_forward_migration_index" ;
        schema:unitText "FMI" ;
        schema:value "0.9449" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-wildtype-chase-and-run-forward-migration-index-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-wildtype-chase-and-run-forward-migration-index-reference> a schema:PropertyValue ;
        schema:value "0.68" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Carmona-Fontaine et al. (2008, 2011) & Theveneau et al. (2013) neural crest CIL, C3a co-attraction & Sdf1 chase-and-run migration — Morphometric validation: 53/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes 4 synthetic measurements in `measure_morphoeval()` (L215-250), but does not quantify cluster cohesion index `C_COA`, does not compare simulated vs empirical Forward Migration Index (`FMI`) and 6-hour displacement across the 5 regimes of Theveneau et al. (2013), and does not measure dorsoventral NC-to-placode separation or anteroposterior stream periodicity on `neural_crest_specimen.jpg`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2012-carmona-neural-crest-chase-and-run.py L215–L250: 4 synthetic measurements without specimen segmentation or 5-regime empirical correlation <https://github.com/fractastical/morpholib/blob/317bc3c/2012-carmona-neural-crest-chase-and-run.py#L215-L250>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-cil-coa-attraction-at-contact-radius>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-cil-coa-contact-repulsion-at-zero-distance>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-no-placode-control-forward-migration-index>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-wildtype-chase-and-run-forward-migration-index> ;
        pk:hasScore "0.53"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

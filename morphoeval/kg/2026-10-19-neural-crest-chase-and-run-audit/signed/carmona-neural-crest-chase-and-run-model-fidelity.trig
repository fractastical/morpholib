sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-carmona-neural-crest-chase-and-run> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2012-carmona-neural-crest-chase-and-run.py L29–L39" ;
        dcterms:description "Homotypic CIL repulsion and C3a/C3aR co-attraction pairwise force law" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2012-carmona-neural-crest-chase-and-run.py#L29-L39> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Carmona-Fontaine et al. (2008, 2011) & Theveneau et al. (2013) neural crest CIL, C3a co-attraction & Sdf1 chase-and-run migration — Model fidelity to source: 68/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements pairwise homotypic CIL repulsion and C3a/C3aR exponential co-attraction (`compute_cil_coa_pair_force`, L29-39) and 2D agent-based NC-placode chase-and-run dynamics (`simulate_chase_and_run_v1`, L42-158) with a placode-ablated negative control. However, v1 simulates only 2 of the 5 experimental regimes of Theveneau et al. (2013), omitting C3aR-MO COA ablation (`k_COA = 0`), N-cadherin/DshDep+ CIL blockade (`k_CIL = 0`), and the stationary Sdf1 bead control, and models only a single harmonic channel rather than the 3 cranial neural crest streams (`r4`, `r6`, `r7`) separated by pharyngeal pouches." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2012-carmona-neural-crest-chase-and-run.py L42–L158: Simulates only WT chase-and-run and no-placode control in a single channel, omitting C3aR-MO, DshDep+ CIL blockade, stationary bead control, and 3-stream pharyngeal arch geometry <https://github.com/fractastical/morpholib/blob/317bc3c/2012-carmona-neural-crest-chase-and-run.py#L42-L158>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-model-fidelity-1> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


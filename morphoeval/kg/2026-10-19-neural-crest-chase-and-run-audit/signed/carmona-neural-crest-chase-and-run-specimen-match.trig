sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-carmona-neural-crest-chase-and-run> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Carmona-Fontaine et al. (2008, 2011) & Theveneau et al. (2013) neural crest CIL, C3a co-attraction & Sdf1 chase-and-run migration — Morphological realism / specimen match: 35/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Although `datasets/neural_crest_chase_and_run/neural_crest_specimen.jpg` is vendored on disk, the v1 script never loads, verifies, or segments the embryonic cranial neural crest and epibranchial placode reconstruction (`render_outputs_v1`, L161-212), rendering only a 3-panel synthetic scatter plot." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2012-carmona-neural-crest-chase-and-run.py L161–L212: render_outputs_v1 renders 3 synthetic panels without loading or segmenting neural_crest_specimen.jpg <https://github.com/fractastical/morpholib/blob/317bc3c/2012-carmona-neural-crest-chase-and-run.py#L161-L212>",
            "docs/media/neural_crest_chase_and_run_comparison.png (generated output, not in repo): 3-panel synthetic figure lacking biological specimen segmentation or dorsoventral stream comparison — docs/media/neural_crest_chase_and_run_comparison.png: rendered output of 2012-carmona-neural-crest-chase-and-run.py at 317bc3c, image/png, 78344 B, 1680×560 px, artifact_sha256 55d7a1f67cc098a34e92b7657cfc44157567d6da4916257e112122b979682c46 (sha256 55d7a1f67cc098a34e92b7657cfc44157567d6da4916257e112122b979682c46), spec_fingerprint eaab4129b9e5439c62a3183cca6415d43a158fd3cba206648d80e37937887881" ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


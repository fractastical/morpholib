sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Acropora millepora Holocene Turing wavenumber at 385.2 µm (pass 2) — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The PDE, Jacobian, dispersion, and D_u bisection are unchanged and match Turing 1952 / Schnakenberg 1979 as stated in the docstring. k_c is argmax σ, and murray_center_um is a separate, shorter wavelength (319.4 µm). The remaining gap is that 385.2 µm is assigned by the slot rather than read from a pigment-spacing table." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py L74–L144" ;
        dct:description "Jacobian, σ(h), solve_du, murray_center_um" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py#L74-L144> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py L150–L194" ;
        dct:description "Periodic Schnakenberg integrator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py#L150-L194> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent; pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


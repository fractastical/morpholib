    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Acropora millepora Holocene Turing wavenumber at 385.2 µm (pass 2) faithfully reproduces Acropora millepora morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py, docs/media/acropora_millepora_turing_wavelength_s0_growth.gif implement the cited source model as published and produce forms that match real Acropora millepora specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/media/acropora_millepora_turing_wavelength_s0_growth.gif>,
            <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py, https://github.com/fractastical/morpholib/blob/main/docs/media/acropora_millepora_turing_wavelength_s0_growth.gif; output: docs/media/acropora_millepora_turing_wavelength_s0_comparison.png; organism: Acropora millepora; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion relation for a two-species reaction-diffusion system. | Schnakenberg 1979 kinetics and Gierer & Meinhardt 1972 long-range inhibition. | Murray 1981 band-center wavenumber, reported here as a contrast, not as k_c. | Dove et al. 2001 and D'Angelo et al. 2008: Acropora host GFP-like pigment is light-regulated. | Lundgren et al. 2013 CC BY 4.0 colony photograph (SHA-256 pinned). | Wallace & Rosen 2006 Eocene Acropora, outside this one-node Holocene series.; reconstructed_in_script: D_u = 881.13 µm²/s so the fastest linear mode is 384.7 µm, FFT mode 383.6 µm. | Dihedral code 6 selected by L1 distance of 12-bin Sobel histograms. | KS = 0.054 between specimen and render orientation histograms. | Equal-diffusion ablation: σ_max = -0.038 and std ratio 0.048.; transfer_boundary: 385.2 µm (3.852e-4 m, log10 = -3.414) is the assigned tier-5 detail scale. | Computer-vision similarity is scored against a centimetre-scale colony photograph.; does_not_claim: That 385.2 µm is a published measurement of A. millepora stripe spacing. | That the spot lattice segments the colony branches in the photograph. | A predecessor or successor chronospecies. Series length is 1 at 0 Ma. | That gauge-fixing raised cv_sim_similarity. Pass 1 scored 86.1 and pass 2 scored 85.9.]; phenomenon_size: 461 µm (0.0004608 m, log10=-3.336 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 461 µm to 75.3 cm): 461 µm:acropora-millepora-bioelectric-polarity, 889 µm:acropora-millepora-vertex-packing, 1.7 cm:acropora-millepora-turing-wavelength, 3.1 cm:acropora-millepora-clock-wavefront, 7.1 cm:acropora-millepora-elastic-buckling, 9.8 cm:acropora-millepora-morphogen-condensation, 12.8 cm:acropora-millepora-flux-canalization, 16.9 cm:acropora-millepora-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1007/bf00289234>,
            <https://doi.org/10.1007/pl00006956>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1098/rspb.2005.3307>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1186/1471-2156-14-9>,
            <https://doi.org/10.3354/meps07588> .
    <https://github.com/fractastical/morpholib/blob/main/docs/media/acropora_millepora_turing_wavelength_s0_growth.gif> a schema:SoftwareSourceCode ;
        rdfs:label "docs/media/acropora_millepora_turing_wavelength_s0_growth.gif" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1007/bf00289234>,
            <https://doi.org/10.1007/pl00006956>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1098/rspb.2005.3307>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1186/1471-2156-14-9>,
            <https://doi.org/10.3354/meps07588> .
    <https://doi.org/10.1007/bf00289234> dct:title "A theory of biological pattern formation" .
    <https://doi.org/10.1007/pl00006956> dct:title "Major colour patterns of reef-building corals are due to a family of GFP-like proteins" .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:title "A pre-pattern formation mechanism for animal coat markings" .
    <https://doi.org/10.1098/rspb.2005.3307> dct:title "Diverse staghorn corals (Acropora) in high-latitude Eocene assemblages" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1186/1471-2156-14-9> dct:title "Genotype-environment correlations in corals from the Great Barrier Reef" .
    <https://doi.org/10.3354/meps07588> dct:title "Blue light regulation of host pigment in reef-building corals" .
}


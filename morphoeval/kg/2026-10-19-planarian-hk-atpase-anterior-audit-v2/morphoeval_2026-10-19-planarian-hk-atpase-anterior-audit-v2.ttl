<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/beane-planarian-hk-atpase-anterior-1>,
        <https://w3id.org/probknow/resource/math-law/beane-planarian-hk-atpase-anterior-2>,
        <https://w3id.org/probknow/resource/math-law/beane-planarian-hk-atpase-anterior-3> .

<https://w3id.org/probknow/resource/math-law/beane-planarian-hk-atpase-anterior-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Beane et al. (2011) & Pietak-Levin (2017) Bistable Membrane Potential Fixed-Point & Stability Law" ;
    dct:description "Establishes exact bistability of the resting membrane potential across the hyperpolarized posterior trunk state and the H,K-ATPase-depolarized anterior blastema state | Variables: V(x,t): resting membrane potential (mV); V_hyper = -65 mV: posterior hyperpolarized attractor; V_thresh = -42.5 mV: unstable voltage threshold; V_depol = -20 mV: H,K-ATPase-depolarized anterior blastema attractor" ;
    dct:source "Beane et al. (2011) Chem. Biol. 18(1):77-89 Fig. 2; Pietak & Levin (2017) J. R. Soc. Interface 14:20170425" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2011-beane-planarian-hk-atpase-anterior.py#L120-L195>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_081_planarian_hk_atpase_anterior.lean#L12-L42> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def beane_bistable_current (V V_hyper V_thresh V_depol : Int) : Int :=
  (V - V_hyper) * (V - V_thresh) * (V - V_depol)
def beane_bistable_slope (V V_hyper V_thresh V_depol : Int) : Int :=
  (V - V_thresh) * (V - V_depol) + (V - V_hyper) * (V - V_depol) + (V - V_hyper) * (V - V_thresh)
theorem beane_bistable_vmem_equilibria (V_hyper V_thresh V_depol : Int) :
    beane_bistable_current V_hyper V_hyper V_thresh V_depol = 0 ∧
    beane_bistable_current V_thresh V_hyper V_thresh V_depol = 0 ∧
    beane_bistable_current V_depol V_hyper V_thresh V_depol = 0 ∧
    beane_bistable_slope (-65) (-65) (-42) (-20) = 1035 ∧
    beane_bistable_slope (-42) (-65) (-42) (-20) = -506 ∧
    beane_bistable_slope (-20) (-65) (-42) (-20) = 990 := by
  refine ⟨?_, ?_, ?_, by decide, by decide, by decide⟩
  · simp [beane_bistable_current]
  · simp [beane_bistable_current]
  · simp [beane_bistable_current]
"""^^pk:lean4 ;
    skos:notation "C_m ∂V/∂t = -g (V - V_hyper)(V - V_thresh)(V - V_depol) + I_HK(x) + I_IVM(x) + ∂_x(G_GJ(∂_x V) ∂_x V);   I'_ion(V_hyper) > 0,  I'_ion(V_depol) > 0,  I'_ion(V_thresh) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
        <https://doi.org/10.1016/j.chembiol.2010.11.012>,
        <https://doi.org/10.1016/j.ydbio.2009.12.012>,
        <https://doi.org/10.1098/rsif.2017.0425> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Bioelectric V_mem Head-Tail Polarity Switch (Bistable Membrane Potential + Voltage-Gated Gap-Junction PDE)" ;
    pk:leanDeclaration "MathOfBiology.Loop_081.beane_bistable_current" ;
    pk:leanTheorem "MathOfBiology.Loop_081.beane_bistable_vmem_equilibria" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/beane-planarian-hk-atpase-anterior-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Oviedo et al. (2010) & Pietak-Levin (2017) Voltage-Gated Gap-Junction Symmetry & Isolation Law" ;
    dct:description "Proves bidirectional symmetry and voltage-drop-induced closure of innexin gap junctions, allowing the depolarized anterior blastema to self-isolate from the hyperpolarized trunk | Variables: ΔV = V_i - V_j: trans-junctional voltage difference; V_0: gap-junction half-inactivation voltage; G_0: maximal innexin conductance; η_oct: 8-octanol gap-junction blockade fraction" ;
    dct:source "Oviedo et al. (2010) Dev. Biol. 339(1):188-199; Pietak & Levin (2017) J. R. Soc. Interface 14:20170425 Eq. (5)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2011-beane-planarian-hk-atpase-anterior.py#L198-L285>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_081_planarian_hk_atpase_anterior.lean#L45-L64> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def gj_bell_denom (dV V0 : Int) : Int :=
  V0 * V0 + dV * dV
theorem gj_voltage_gate_symmetry_and_isolation (dV V0 : Int) :
    gj_bell_denom (-dV) V0 = gj_bell_denom dV V0 ∧
    gj_bell_denom 0 V0 = V0 * V0 := by
  simp [gj_bell_denom, Int.neg_mul_neg]
"""^^pk:lean4 ;
    skos:notation "G_GJ(ΔV) = (1 - η_oct) G_0 / (1 + (ΔV / V_0)^2),   G_GJ(-ΔV) = G_GJ(ΔV),   0 < G_GJ(ΔV) ≤ G_0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
        <https://doi.org/10.1016/j.chembiol.2010.11.012>,
        <https://doi.org/10.1016/j.ydbio.2009.12.012>,
        <https://doi.org/10.1098/rsif.2017.0425> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Bioelectric V_mem Head-Tail Polarity Switch (Bistable Membrane Potential + Voltage-Gated Gap-Junction PDE)" ;
    pk:leanDeclaration "MathOfBiology.Loop_081.gj_bell_denom" ;
    pk:leanTheorem "MathOfBiology.Loop_081.gj_voltage_gate_symmetry_and_isolation" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/beane-planarian-hk-atpase-anterior-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Beane et al. (2011) Four Canonical Bioelectric Regeneration Phenotypes (1H1T, 0H2T, 2H0T)" ;
    dct:description "Proves the four canonical experimental regeneration outcomes of Beane et al. (2011) and Oviedo et al. (2010): wild-type 1H1T, SCH-28080/RNAi 0H2T headless, ivermectin 2H0T double-headed, and 8-octanol 2H0T double-headed | Variables: V_ant = V(0,T), V_post = V(L,T): steady-state anterior and posterior blastema potentials; N_head, N_tail: regenerated head and tail counts" ;
    dct:source "Beane et al. (2011) Chem. Biol. 18(1):77-89 Figs. 1-6 & Table 1" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2011-beane-planarian-hk-atpase-anterior.py#L288-L410>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_081_planarian_hk_atpase_anterior.lean#L67-L92> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def head_gate (V V_thresh : Int) : Nat :=
  if V > V_thresh then 1 else 0
def planarian_head_tail_counts (V_ant V_post V_thresh : Int) : Nat × Nat :=
  let h_ant := head_gate V_ant V_thresh
  let h_post := head_gate V_post V_thresh
  (h_ant + h_post, (1 - h_ant) + (1 - h_post))
theorem beane_four_regeneration_phenotypes :
    planarian_head_tail_counts (-20) (-65) (-42) = (1, 1) ∧
    planarian_head_tail_counts (-63) (-65) (-42) = (0, 2) ∧
    planarian_head_tail_counts (-19) (-21) (-42) = (2, 0) ∧
    planarian_head_tail_counts (-20) (-22) (-42) = (2, 0) := by
  decide
"""^^pk:lean4 ;
    skos:notation "Ca_ss(V) = (1 + exp(-(V - V_thresh)/k_V))^{-1};   (N_head, N_tail) = (1,1) [WT],  (0,2) [SCH-28080 / H,K-ATPase RNAi],  (2,0) [Ivermectin / 8-Octanol]" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
        <https://doi.org/10.1016/j.chembiol.2010.11.012>,
        <https://doi.org/10.1016/j.ydbio.2009.12.012>,
        <https://doi.org/10.1098/rsif.2017.0425> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Bioelectric V_mem Head-Tail Polarity Switch (Bistable Membrane Potential + Voltage-Gated Gap-Junction PDE)" ;
    pk:leanDeclaration "MathOfBiology.Loop_081.planarian_head_tail_counts" ;
    pk:leanTheorem "MathOfBiology.Loop_081.beane_four_regeneration_phenotypes" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


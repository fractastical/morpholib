sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-beane-planarian-hk-atpase-anterior> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Beane et al. (2011) planarian H,K-ATPase bioelectric V_mem anterior polarity switch — Reproducibility package: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Deterministic RNG (`seed=2011`), standalone 8-check `--self-test` suite verifying SHA-256 dataset locks, bistable V_mem equilibria, voltage-gated GJ symmetry and isolation, all 5 Beane et al. (2011) regeneration phenotypes (`1H1T`, `0H2T` SCH-28080, `2H0T` ivermectin, `2H0T` 8-octanol, `0H2T` nifedipine control), specimen bilateral ocelli segmentation, and bitwise two-run determinism (`atol=0.0`), plus rendered 9-panel PNG and 24-frame GIF in `docs/media/`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-repro-package-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2011-beane-planarian-hk-atpase-anterior.py L820–L895" ;
        dct:description "8-check deterministic --self-test suite verifying SHA-256 locks, 5 regimes, ocelli segmentation, and bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2011-beane-planarian-hk-atpase-anterior.py#L820-L895> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/planarian_hk_atpase_anterior_growth.gif (generated output)" ;
        dct:description "24-frame animated GIF comparing WT (1H1T), SCH-28080 (0H2T), Ivermectin (2H0T), and Nifedipine control — docs/media/planarian_hk_atpase_anterior_growth.gif: rendered output of 2011-beane-planarian-hk-atpase-anterior.py at 317bc3c, image/gif, 265390 B, 827×351 px, 24 frames, artifact_sha256 4b0de2e5847b4abc53937cc8de2073c93afc97ec4a4e28f67bc8171e4960e801 (sha256 4b0de2e5847b4abc53937cc8de2073c93afc97ec4a4e28f67bc8171e4960e801), spec_fingerprint c0d35653d229caf892ce95227098738e04e01130c0c0eb1c24a63345a769e0d8" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


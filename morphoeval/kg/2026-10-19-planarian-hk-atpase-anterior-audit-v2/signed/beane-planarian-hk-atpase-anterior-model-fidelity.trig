sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-beane-planarian-hk-atpase-anterior> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Beane et al. (2011) planarian H,K-ATPase bioelectric V_mem anterior polarity switch — Model fidelity to source: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements the coupled Beane et al. (2011) and Pietak-Levin (2017) bistable membrane voltage PDE, symmetric Bell-form voltage-gated gap-junction flux divergence (10x conductance isolation at 36 mV trans-junctional drop), voltage-gated L-type Ca2+ influx gate Ca_ss(V), and mutually antagonistic anterior Head H(x,t) (*pc2/ndk*) and posterior Tail T(x,t) (*wnt1*) reaction-diffusion equations (L118-378), verified by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_081_planarian_hk_atpase_anterior.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2011-beane-planarian-hk-atpase-anterior.py L118–L195" ;
        dcterms:description "Bistable ionic current roots, restoring slopes, and voltage-gated GJ symmetry/isolation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2011-beane-planarian-hk-atpase-anterior.py#L118-L195> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2011-beane-planarian-hk-atpase-anterior.py L198–L378" ;
        dcterms:description "1D coupled V_mem + nonlinear voltage-gated GJ + Ca2+ head/tail morphogen PDE solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2011-beane-planarian-hk-atpase-anterior.py#L198-L378> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_081_planarian_hk_atpase_anterior.lean L12–L92" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for bistable equilibria, GJ symmetry, and 4 phenotypes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_081_planarian_hk_atpase_anterior.lean#L12-L92> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


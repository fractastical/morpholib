sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-beane-planarian-hk-atpase-anterior> a pk:Claim ;
        rdfs:label "Beane et al. (2011) planarian H,K-ATPase bioelectric V_mem anterior polarity switch faithfully reproduces Schmidtea mediterranea freshwater planarian flatworm morphology" ;
        dcterms:description "The simulation script(s) 2011-beane-planarian-hk-atpase-anterior.py implement the cited source model as published and produce forms that match real Schmidtea mediterranea freshwater planarian flatworm specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 91.1/100, audit 2026-10-19-planarian-hk-atpase-anterior-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2011-beane-planarian-hk-atpase-anterior.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2011-beane-planarian-hk-atpase-anterior.py; output: docs/media/planarian_hk_atpase_anterior_comparison.png; organism: Schmidtea mediterranea freshwater planarian flatworm; checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: c0d35653d229caf892ce95227098738e04e01130c0c0eb1c24a63345a769e0d8; artifact_sha256: 23e52bef2eb4a12b38ececd73bb5dddfe65c95c72488302a61aea135c94575f8; input_dataset_sha256: {datasets/planarian_hk_atpase_anterior/paper_citations.bib=4978cdbc97ad314e..., datasets/planarian_hk_atpase_anterior/planarian_hk_atpase_anterior_reference.json=ad7dfa156bbb79fe..., datasets/planarian_hk_atpase_anterior/schmidtea_mediterranea_specimen.jpg=466029cc05610678..., datasets/planarian_hk_atpase_anterior/scout_manifest.json=9de72183ede698f0...}; supersedes_audit_id: 2026-10-19-planarian-hk-atpase-anterior-audit; claim_boundary: [reported_in_source: Beane et al. (2011) Chem. Biol. 18:77-89 H,K-ATPase-mediated anterior blastema membrane depolarization (V_mem) and L-type Ca2+ channel requirement for head regeneration in Schmidtea mediterranea (1H1T wild-type, 0H2T SCH-28080/RNAi headless, 2H0T ivermectin double-head) | Oviedo et al. (2010) Dev. Biol. 339:188-199 & Pietak-Levin (2017) J. R. Soc. Interface 14:20170425 voltage-gated innexin gap-junction coupling G_GJ(DeltaV) and 8-octanol double-head (2H0T) induction; reconstructed_in_script: 1D coupled bistable V_mem + Bell-form voltage-gated gap-junction PDE and mutually antagonistic Head H(x,t) / Tail T(x,t) morphogen cascade across 5 experimental regimes | Automated dorsal body-contour and bilateral photoreceptor ocelli segmentation on schmidtea_mediterranea_specimen.jpg (N=2 eyespots at x/L=0.0528, length=1478 px) and 2D body-plan silhouette synthesis; transfer_boundary: 1D anteroposterior bioelectric V_mem and morphogen profiles mapped onto 2D dorsal Schmidtea mediterranea body-plan silhouettes and eyespot coordinates; does_not_claim: Single-cell stochastic neoblast migration trajectories or full 3D muscle-fiber extracellular matrix remodeling during blastema outgrowth]" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1016/j.chembiol.2010.11.012>,
            <https://doi.org/10.1016/j.ydbio.2009.12.012>,
            <https://doi.org/10.1098/rsif.2017.0425> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-specimen-match> ;
        pk:weightOfEvidence "0.911"^^xsd:double .


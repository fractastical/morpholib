sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-beane-planarian-hk-atpase-anterior> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Beane et al. (2011) planarian H,K-ATPase bioelectric V_mem anterior polarity switch — Morphological realism / specimen match: 89/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the CC BY 2.5 dorsal whole-mount micrograph of Schmidtea mediterranea (`datasets/planarian_hk_atpase_anterior/schmidtea_mediterranea_specimen.jpg`), automatically segments the body contour (length 1478 px, aspect ratio 3.72) and bilateral photoreceptor ocelli (`segment_planarian_specimen`, L446-528: N = 2 eyespots at x/L = 0.0492 and 0.0563, mean x/L = 0.0528 matching the simulated anterior head domain), and reconstructs 2D body-plan silhouettes with eyespots for 1H1T, 2H0T, and 0H2T regenerates (Panels B3, C1, C2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-specimen-match-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2011-beane-planarian-hk-atpase-anterior.py L446–L566" ;
        dcterms:description "Automated Schmidtea mediterranea body-contour and bilateral ocelli segmentation + 2D morphology synthesis" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2011-beane-planarian-hk-atpase-anterior.py#L446-L566> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/planarian_hk_atpase_anterior_comparison.png (generated output)" ;
        dcterms:description "9-panel synthesis figure including specimen ocelli segmentation, width comparison, and 1H1T/2H0T/0H2T silhouettes — docs/media/planarian_hk_atpase_anterior_comparison.png: rendered output of 2011-beane-planarian-hk-atpase-anterior.py at 317bc3c, image/png, 586158 B, 2268×1863 px, artifact_sha256 23e52bef2eb4a12b38ececd73bb5dddfe65c95c72488302a61aea135c94575f8 (sha256 23e52bef2eb4a12b38ececd73bb5dddfe65c95c72488302a61aea135c94575f8), spec_fingerprint c0d35653d229caf892ce95227098738e04e01130c0c0eb1c24a63345a769e0d8" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


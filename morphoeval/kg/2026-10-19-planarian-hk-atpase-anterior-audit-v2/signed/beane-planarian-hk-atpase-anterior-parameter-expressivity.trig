sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-beane-planarian-hk-atpase-anterior> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2011-beane-planarian-hk-atpase-anterior.py L380–L442" ;
        dcterms:description "5-regime evaluator, 11-point I_HK dose-response sweep, and 2D (I_HK, I_IVM) phase diagram" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2011-beane-planarian-hk-atpase-anterior.py#L380-L442> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-beane-planarian-hk-atpase-anterior-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Beane et al. (2011) planarian H,K-ATPase bioelectric V_mem anterior polarity switch — Parameter expressivity: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Simulates all 5 experimental regimes from Beane et al. (2011) and Oviedo et al. (2010) (`wild_type_1H1T`, `hk_atpase_inhibited_0H2T`, `ivermectin_depolarized_2H0T`, `octanol_gj_blockade_2H0T`, and `nifedipine_cav_block_0H2T` negative control), executes an 11-point H,K-ATPase pump current dose-response curve across I_HK in [-18, +24] showing the sharp 0H2T -> 1H1T bifurcation (Panel C3), and maps the 2D (I_HK, I_IVM) bioelectric phase diagram across 0H2T, 1H1T, and 2H0T territories (Panel B2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-beane-planarian-hk-atpase-anterior-parameter-expressivity-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


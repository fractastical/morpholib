<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-brassica-oleracea-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-brassica-oleracea-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-brassica-oleracea-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-brassica-oleracea-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion growth rate" ;
    dct:description "Selected wavenumber at 172 µm on a 4128 µm patch (24 waves) | Variables: k, D_u, D_v, Jacobian entries at the Schnakenberg steady state" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-brassica-oleracea-turing-wavelength-s0.py#L112-L130>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3137_brassica_oleracea_turing_wavelength_s0.lean#L17-L19> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "sigma(k) = 1/2 (tr + sqrt(tr^2 - 4 det)); tr = f_u + g_v - k^2 (D_u + D_v); det = (f_u g_v - f_v g_u) - k^2 (D_v f_u + D_u g_v) + D_u D_v k^4" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1093/jxb/erm327>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1140429>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1126/science.abg5999> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3137.detail_patch_holds_24_waves" ;
    pk:leanTheorem "MathOfBiology.Loop_3137.detail_patch_holds_24_waves" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-brassica-oleracea-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Nominal-tier versus detail-variant peak count" ;
    dct:description "What changes relative to the nominal primordium tier (same chronospecies, coarser scale) | Variables: patch length 4128 µm, lambda_detail 172 µm, lambda_nominal 100 µm" ;
    dct:source "Slot scale definition; wavelength law as in Turing 1952" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-brassica-oleracea-turing-wavelength-s0.py#L77-L86>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3137_brassica_oleracea_turing_wavelength_s0.lean#L22-L24> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = floor(4128 µm / lambda); N(100 µm) = 41 > N(172 µm) = 24" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1093/jxb/erm327>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1140429>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1126/science.abg5999> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3137.nominal_tier_packs_more_peaks" ;
    pk:leanTheorem "MathOfBiology.Loop_3137.nominal_tier_packs_more_peaks" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-brassica-oleracea-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Cell-scale successor is outside the selected wave" ;
    dct:description "Successor scale on the same extant body is stable under the 172 µm diffusivities | Variables: lambda_cell = 15 µm" ;
    dct:source "Turing 1952 dispersion; cell length is the tier boundary used by this slot, not a new empirical fit" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-brassica-oleracea-turing-wavelength-s0.py#L146-L149>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3137_brassica_oleracea_turing_wavelength_s0.lean#L27-L29> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_detail / lambda_cell = 172/15 = 11; sigma(k_15µm) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1093/jxb/erm327>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1140429>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1126/science.abg5999> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3137.cell_successor_is_not_the_selected_wave" ;
    pk:leanTheorem "MathOfBiology.Loop_3137.cell_successor_is_not_the_selected_wave" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


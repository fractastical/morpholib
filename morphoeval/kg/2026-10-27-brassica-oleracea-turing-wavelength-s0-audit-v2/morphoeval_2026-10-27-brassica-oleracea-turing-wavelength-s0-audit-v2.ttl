<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-source-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Brassica oleracea Schnakenberg Turing wavelength at 172 µm (Holocene, 0 Ma) — Source and data traceability: 93/100" ;
    dct:date "2026-10-27"^^xsd:date ;

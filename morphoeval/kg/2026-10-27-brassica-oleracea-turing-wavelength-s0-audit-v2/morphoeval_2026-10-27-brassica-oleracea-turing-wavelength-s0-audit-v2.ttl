<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Brassica oleracea Schnakenberg Turing wavelength at 172 µm (Holocene, 0 Ma) — Model fidelity to source: 90/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The integrator is operator-split Schnakenberg with a spectral Laplacian. sigma(k) uses the standard trace and determinant. D_v is the unique value whose fastest mode is 13 pixels, mapped to 172 µm. The claim boundary says the kinetics are phenomenological. Short of a higher score because the reactions are not a fitted Brassica network." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 9e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Brassica oleracea Schnakenberg Turing wavelength at 172 µm (Holocene, 0 Ma) — Morphometric validation: 91/100" ;

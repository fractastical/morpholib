sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Brassica oleracea Schnakenberg Turing wavelength at 172 µm (Holocene, 0 Ma) — Morphometric validation: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Modal Pearson r is 0.9999999522 against gate 0.98, RMSE 0.0036, KS 0.167. Full-field wavelength is 166.44 µm against 172 µm. Specimen circularity is 0.583 against a circle null of 1, and foreground fraction is 0.399 against a half-frame null of 0.5. Cell-scale sigma is -14.56 against detail-mode sigma +0.551." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-cell-scale-successor-growth-rate-k-15-m>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-d-v-sweep-pearson-r-measured-vs-analytical>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-standard-deviation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-modal-dispersion-pearson-r-measured-vs-turing>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-segmented-romanesco-specimen-curd-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-selected-wavelength-on-the-312-234-meristem-patch>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-specimen-excess-green-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-specimen-vs-gif-sobel-fft-coherency-similarity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-cell-scale-successor-growth-rate-k-15-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cell-scale successor growth rate σ(k_15µm) = -14.5585 1/time" ;
        dct:description "nominal 100 µm tier σ=0.4060; cell-scale mode is stable" ;
        schema:measurementTechnique "σ(k) at λ = 15 µm with the diffusivities that select 172 µm" ;
        schema:name "cell-scale successor growth rate σ(k_15µm)" ;
        schema:unitText "1/time" ;
        schema:value "-14.5585" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-cell-scale-successor-growth-rate-k-15-m-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-cell-scale-successor-growth-rate-k-15-m-reference> a schema:PropertyValue ;
        dct:source "σ at the 172 µm detail mode on the same parameter set" ;
        schema:value "0.5512" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-d-v-sweep-pearson-r-measured-vs-analytical> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "D_v sweep Pearson r (measured λ vs analytical λ) = 0.8266 Pearson r" ;
        dct:description "p=0.0425; RMSE=24.227 µm; analytical λ increases at 5/5 steps (Fourier binning keeps the nonlinear r below the modal test)" ;
        schema:measurementTechnique "Six inhibitor diffusivities on a 96×128 grid versus fastest-mode λ(D_v)" ;
        schema:name "D_v sweep Pearson r (measured λ vs analytical λ)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.8266" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-d-v-sweep-pearson-r-measured-vs-analytical-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-d-v-sweep-pearson-r-measured-vs-analytical-reference> a schema:PropertyValue ;
        dct:source "Linear dispersion λ(D_v); nonlinear peak shift keeps this below 1" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-standard-deviation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation activator standard deviation = 0.0005 concentration" ;
        dct:description "σ_max ablation=-0.1000; σ_max pattern=0.5512" ;
        schema:measurementTechnique "Same noise amplitude with D_u = D_v = 0.5 (Turing condition fails)" ;
        schema:name "equal-diffusion ablation activator standard deviation" ;
        schema:unitText "concentration" ;
        schema:value "0.0005" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-standard-deviation-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-standard-deviation-reference> a schema:PropertyValue ;
        dct:source "Patterning run at the 172 µm diffusivity ratio, same grid and seed family" ;
        schema:value "1.5858" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-modal-dispersion-pearson-r-measured-vs-turing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "modal dispersion Pearson r (measured σ vs Turing σ) = 0.9999999522 Pearson r" ;
        dct:description "RMSE=0.00360, p=3.43e-15, KS=0.1667 (p=1)" ;
        schema:measurementTechnique "Eigenvector-seeded integer modes k=1..6 on a 2π periodic box; log-amplitude growth versus analytical σ(k)" ;
        schema:name "modal dispersion Pearson r (measured σ vs Turing σ)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9999999522" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-modal-dispersion-pearson-r-measured-vs-turing-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-modal-dispersion-pearson-r-measured-vs-turing-reference> a schema:PropertyValue ;
        dct:source "Pass gate for dispersion goodness-of-fit (Turing 1952; Schnakenberg 1979 Jacobian). The measured r is not copied from this gate." ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-segmented-romanesco-specimen-curd-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented Romanesco specimen curd circularity = 0.5831 4πA/P²" ;
        dct:description "aspect H/W=0.8794, foreground=0.3989" ;
        schema:measurementTechnique "Excess-green Otsu mask, largest component, perimeter by binary erosion" ;
        schema:name "segmented Romanesco specimen curd circularity" ;
        schema:unitText "4πA/P²" ;
        schema:value "0.5831" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-segmented-romanesco-specimen-curd-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-segmented-romanesco-specimen-curd-circularity-reference> a schema:PropertyValue ;
        dct:source "Circle null (a round curd would score 1). The photograph is conical and lobed." ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-selected-wavelength-on-the-312-234-meristem-patch> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "selected wavelength on the 312×234 meristem patch = 166.4402 µm" ;
        dct:description "analytical k_c=0.4830 rad/px, D_v=51.7523, D_u=0.5" ;
        schema:measurementTechnique "Radial FFT peak of the saturated activator, converted by dx = 172/13 µm" ;
        schema:name "selected wavelength on the 312×234 meristem patch" ;
        schema:unitText "µm" ;
        schema:value "166.4402" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-selected-wavelength-on-the-312-234-meristem-patch-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-selected-wavelength-on-the-312-234-meristem-patch-reference> a schema:PropertyValue ;
        dct:source "Slot 3137 characteristic scale, tier 5_primordium_100um detail variant" ;
        schema:value "172.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-specimen-excess-green-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen excess-green foreground fraction = 0.3989 area fraction" ;
        dct:description "dominant macro texture wavelength=640.000 px on the 1280-wide photo (not 172 µm)" ;
        schema:measurementTechnique "Largest excess-green component divided by image area" ;
        schema:name "specimen excess-green foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.3989" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-specimen-excess-green-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-specimen-excess-green-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "Neutral half-frame null, not fitted to this photograph" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-specimen-vs-gif-sobel-fft-coherency-similarity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen-vs-GIF Sobel/FFT/coherency similarity = 88.4 cv_sim_similarity" ;
        dct:description "gif 640×480, frames=12" ;
        schema:measurementTechnique "morphoeval.verify_image_fitness.compute_sim_vs_specimen_cv_similarity on the animated GIF last frame" ;
        schema:name "specimen-vs-GIF Sobel/FFT/coherency similarity" ;
        schema:unitText "cv_sim_similarity" ;
        schema:value "88.4" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-specimen-vs-gif-sobel-fft-coherency-similarity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-measurement-specimen-vs-gif-sobel-fft-coherency-similarity-reference> a schema:PropertyValue ;
        dct:source "Image-fitness CV gate (pass requires cv_sim_similarity >= 58)" ;
        schema:value "58.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-brassica-oleracea-turing-wavelength-s0.py L543–L639" ;
        dct:description "measure_morphoeval rows: modal r, sweep r, ablation, circularity, cell-scale sigma, CV" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-brassica-oleracea-turing-wavelength-s0.py#L543-L639> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-brassica-oleracea-turing-wavelength-s0.py L320–L379" ;
        dct:description "Excess-green segmentation of the pinned photograph" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-brassica-oleracea-turing-wavelength-s0.py#L320-L379> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (MorphoEval loop 3137 Pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1093/jxb/erm327>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1140429>,
            <https://doi.org/10.1126/science.1179047>,
            <https://doi.org/10.1126/science.abg5999> .
    <https://doi.org/10.1007/BF00289234> dct:date "1972"^^xsd:gYear ;
        dct:title "A theory of biological pattern formation" .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1093/jxb/erm327> dct:date "2008"^^xsd:gYear ;
        dct:title "Meristem identity gene expression during curd proliferation and flower initiation in Brassica oleracea" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.1140429> dct:date "2007"^^xsd:gYear ;
        dct:title "Evolution and development of inflorescence architectures" .
    <https://doi.org/10.1126/science.1179047> dct:date "2010"^^xsd:gYear ;
        dct:title "Reaction-diffusion model as a framework for understanding biological pattern formation" .
    <https://doi.org/10.1126/science.abg5999> dct:date "2021"^^xsd:gYear ;
        dct:title "Cauliflower fractal forms arise from perturbations of floral gene networks" .
}


            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(76)90058-8>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1085/jgp.78.4.431>,
            <https://doi.org/10.1085/jgp.9.6.835> .
    <https://doi.org/10.1016/0022-5193(76)90058-8> dct:date "1976"^^xsd:gYear ;
        dct:title "Optimality principles in arterial branching" .
    <https://doi.org/10.1073/pnas.12.3.207> dct:date "1926"^^xsd:gYear ;
        dct:title "The physiological principle of minimum work. I. The vascular system and the cost of blood volume" .
    <https://doi.org/10.1085/jgp.78.4.431> dct:date "1981"^^xsd:gYear ;
        dct:title "On connecting large vessels to small. The meaning of Murray's law" .
    <https://doi.org/10.1085/jgp.9.6.835> dct:date "1926"^^xsd:gYear ;
        dct:title "The physiological principle of minimum work applied to the angle of branching of arteries" .
}


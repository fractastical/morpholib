        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-vascular-cube-law-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1926a, 1926b), Zamir (1976) & Sherman (1981) minimum-work vascular cube law & arterial branching angles — Model fidelity to source: 62/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates Murray's (1926a) Poiseuille + metabolic power functional P(r) and stationarity radius r* (L35-50) and computes the symmetric bifurcation angle theta_1 + theta_2 = 74.9346 deg (L53-68). However, asymmetric daughter branching (r_1 != r_2, cos(theta_2) for side branches) from Murray (1926b) Eqs. 3-6, wall shear stress invariance tau_w = 4*eta*Q/(pi*r^3) = sqrt(eta*b) across vessel generations, and Zamir's (1976) competing optimality regimes (surface-area drag 90 deg, Steiner minimum length 120 deg, Da Vinci gamma=2 area conservation) are not implemented in v1." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1959-murray-vascular-cube-law-branching.py L71–L96: Symmetric-only binary tree builder without asymmetric alpha = r_2/r_1 or wall shear stress verification <https://github.com/fractastical/morpholib/blob/8871db0/1959-murray-vascular-cube-law-branching.py#L71-L96>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-1> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L35–L68" ;
        dct:description "Poiseuille + metabolic power functional and symmetric-only bifurcation helper" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1959-murray-vascular-cube-law-branching.py#L35-L68> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 052 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


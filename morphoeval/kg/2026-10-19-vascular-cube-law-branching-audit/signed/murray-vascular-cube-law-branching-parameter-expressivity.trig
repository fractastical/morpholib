sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-vascular-cube-law-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1926a, 1926b), Zamir (1976) & Sherman (1981) minimum-work vascular cube law & arterial branching angles — Parameter expressivity: 42/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Hardcodes a single symmetric ratio 2^(-1/3) and root radius r_0 = 82 um (L29-31) without sweeping daughter asymmetry alpha = r_2/r_1 in (0, 1], vascular scaling exponent gamma in [1.5, 4.0], or blood viscosity / metabolic cost parameters, and exposes only `--self-test` and `--skip-gif` on the CLI (L253-257)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1959-murray-vascular-cube-law-branching.py L253–L263: Minimal CLI lacking --alpha, --gamma, --eta, --b, --generations, --seed overrides <https://github.com/fractastical/morpholib/blob/8871db0/1959-murray-vascular-cube-law-branching.py#L253-L263>",
            "1959-murray-vascular-cube-law-branching.py L29–L32: Hardcoded scalar constants without parameter sweeps over alpha or gamma <https://github.com/fractastical/morpholib/blob/8871db0/1959-murray-vascular-cube-law-branching.py#L29-L32>" ;
        pk:hasScore "0.42"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 052 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


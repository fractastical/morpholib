            <https://doi.org/10.1085/jgp.78.4.431>,
            <https://doi.org/10.1085/jgp.9.6.835> .

    <https://doi.org/10.1016/0022-5193(76)90058-8> dcterms:date "1976"^^xsd:gYear ;
        dcterms:title "Optimality principles in arterial branching" .

    <https://doi.org/10.1073/pnas.12.3.207> dcterms:date "1926"^^xsd:gYear ;
        dcterms:title "The physiological principle of minimum work. I. The vascular system and the cost of blood volume" .

    <https://doi.org/10.1085/jgp.78.4.431> dcterms:date "1981"^^xsd:gYear ;
        dcterms:title "On connecting large vessels to small. The meaning of Murray's law" .

    <https://doi.org/10.1085/jgp.9.6.835> dcterms:date "1926"^^xsd:gYear ;
        dcterms:title "The physiological principle of minimum work applied to the angle of branching of arteries" .

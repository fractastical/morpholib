        rdfs:label "Murray (1926a, 1926b), Zamir (1976) & Sherman (1981) minimum-work vascular cube law & arterial branching angles — Code-to-model traceability: 62/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Functions have brief one-line docstrings (L35-75), but do not map code blocks to specific equations in Murray (1926a) Eqs. 1-8, Murray (1926b) Eqs. 1-6, Zamir (1976) Table 1, Sherman (1981) Table 1, or the 3 Lean 4 theorems in `morphoeval/lean/loops/Loop_052_vascular_cube_law_branching.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1959-murray-vascular-cube-law-branching.py L35–L96: Minimal docstrings without equation-level or Lean 4 theorem cross-references <https://github.com/fractastical/morpholib/blob/8871db0/1959-murray-vascular-cube-law-branching.py#L35-L96>" ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-vascular-cube-law-branching> a pk:Claim ;
        rdfs:label "Murray (1926a, 1926b), Zamir (1976) & Sherman (1981) minimum-work vascular cube law & arterial branching angles faithfully reproduces Homo sapiens (human retinal arterial and microvascular bifurcation network) morphology" ;
        dct:description "The simulation script(s) 1959-murray-vascular-cube-law-branching.py implement the cited source model as published and produce forms that match real Homo sapiens (human retinal arterial and microvascular bifurcation network) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 48.2/100, audit 2026-10-19-vascular-cube-law-branching-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/1959-murray-vascular-cube-law-branching.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/1959-murray-vascular-cube-law-branching.py; output: docs/media/vascular_cube_law_branching_comparison.png; organism: Homo sapiens (human retinal arterial and microvascular bifurcation network); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 28bf2bb7d9ebb4ea9c5721cc29a875189747c8344d5828934425a1601bbeb74e; artifact_sha256: a251584c0520dfda3240e751daff491369bf2f1d5799dad6103cc3cd1423c455; input_dataset_sha256: {datasets/vascular_cube_law_branching/retinal_vasculature_specimen.jpg=bc548d4150e070a5..., datasets/vascular_cube_law_branching/vascular_cube_law_branching_reference.json=450775cc5fc7ee81...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(76)90058-8>,
            <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1085/jgp.78.4.431>,
            <https://doi.org/10.1085/jgp.9.6.835> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-specimen-match> ;
        pk:weightOfEvidence "0.482"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/8871db0/1959-murray-vascular-cube-law-branching.py> a schema:SoftwareSourceCode ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "8871db0" .
}


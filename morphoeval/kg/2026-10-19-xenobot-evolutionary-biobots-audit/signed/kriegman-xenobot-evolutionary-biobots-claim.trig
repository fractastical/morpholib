sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kriegman-xenobot-evolutionary-biobots> a pk:Claim ;
        rdfs:label "Kriegman et al. (2020, 2021) Xenobot evolutionary biomechanics & kinematic self-replication faithfully reproduces Xenopus laevis (African clawed frog blastula ectoderm & cardiac progenitor biobots) morphology" ;
        dcterms:description "The simulation script(s) 2020-kriegman-xenobot-evolutionary-biobots.py implement the cited source model as published and produce forms that match real Xenopus laevis (African clawed frog blastula ectoderm & cardiac progenitor biobots) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 59.2/100, audit 2026-10-19-xenobot-evolutionary-biobots-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2020-kriegman-xenobot-evolutionary-biobots.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2020-kriegman-xenobot-evolutionary-biobots.py; output: docs/media/xenobot_evolutionary_biobots_comparison.png; organism: Xenopus laevis (African clawed frog blastula ectoderm & cardiac progenitor biobots); checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 9611ac5308e60d5b8cd28bafdf0fb556acb91a73e85f822739154d38d1283ee9; artifact_sha256: 3ada48180881707f50f622d45cf504c320a18eb4da0b54cbdabe1e669d3b119a; input_dataset_sha256: {datasets/xenobot_evolutionary_biobots/paper_citations.bib=4f92785fb031ce11..., datasets/xenobot_evolutionary_biobots/scout_manifest.json=abbd461fb51acbc9..., datasets/xenobot_evolutionary_biobots/xenobot_evolutionary_biobots_reference.json=256b3387af983583..., datasets/xenobot_evolutionary_biobots/xenopus_biobot_specimen.jpg=13e063704f07254f...}" ;
        pk:derivedFromPaper <https://doi.org/10.1073/pnas.1910837117>,
            <https://doi.org/10.1073/pnas.2112672118>,
            <https://doi.org/10.1126/scirobotics.abf1571>,
            <https://doi.org/10.1145/2463372.2463404> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-overall>,

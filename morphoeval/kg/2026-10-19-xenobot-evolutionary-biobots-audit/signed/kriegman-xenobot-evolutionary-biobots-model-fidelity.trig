sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kriegman-xenobot-evolutionary-biobots> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2020-kriegman-xenobot-evolutionary-biobots.py L125–L228" ;
        dcterms:description "Voxel rest-length wave and 8x5 tissue design matrices" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2020-kriegman-xenobot-evolutionary-biobots.py#L125-L228> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Kriegman et al. (2020, 2021) Xenobot evolutionary biomechanics & kinematic self-replication — Model fidelity to source: 63/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements voxel rest-length actuation L(t) = L0*(1 + eps_0*a*sin(2*pi*f*t + phi)) and 2D sagittal bipedal locomotion (L125-245), but the baseline pass lacks the explicit phase-randomization transferability filter separating contiguous ventral cardiac layers from scattered checkerboard designs and the mechanical laceration healing ODE." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2020-kriegman-xenobot-evolutionary-biobots.py L232–L370: Spring-lattice locomotion solver requiring phase-noise filter and laceration healing <https://github.com/fractastical/morpholib/blob/317bc3c/2020-kriegman-xenobot-evolutionary-biobots.py#L232-L370>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-model-fidelity-1> ;
        pk:hasScore "0.63"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hubaud-yap-excitable-segmentation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Hubaud, Regev, Mahadevan & Pourquié (2017) excitable FitzHugh-Nagumo segmentation clock gated by YAP mechanotransduction, with FGF/Wnt clock-and-wavefront arrest and stiffness-LATS-YAP kinetics (Pass 3) — Source and data traceability: 94/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Eight primary sources now carry DOIs in the module docstring, the dataset README, paper_citations.bib and the reference JSON (four added in Pass 3: Cooke & Zeeman 1976, Dubrulle 2001, Wada 2011, Gomez 2008); the specimen and scout manifest remain SHA-256 pinned and verified at runtime (L131-162); the new mechanisms' parameters and regime mechanical inputs live in the reference JSON and are loaded by the script rather than hard-coded, and a pre-existing D_u inconsistency (18 vs 24 um^2/min) between the JSON, the math KG and the code was corrected. Deductions: the regime mechanical inputs (E = 40 kPa for fibronectin-coated dishes, A = 2000 / 150 um^2, rho_actin 0.15, c_ROCK 0.25) are modelling assignments without a per-value source (-3); the specimen filename misstates the organism (-2); the reference JSON is not SHA-pinned (digest recorded, not asserted) (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-source-traceability-4> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L1–L53" ;
        dcterms:description "Eight sources with DOIs and the Pass 3 remediation summary with honest reductions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L1-L53> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L131–L162" ;
        dcterms:description "SHA-256 pins for specimen and scout manifest, fail-closed verification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L131-L162> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/yap_excitable_segmentation/yap_excitable_segmentation_reference.json L181–L245" ;
        dcterms:description "Pass 3 reference sections: FGF gradient law, gate, arrest criterion, parameters, empirical anchors; YAP cascade equations, honesty note, fixed/fitted parameters, Dupont anchors, per-regime mechanical inputs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/yap_excitable_segmentation/yap_excitable_segmentation_reference.json#L181-L245> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/yap_excitable_segmentation/paper_citations.bib L45–L87" ;
        dcterms:description "BibTeX entries for Cooke & Zeeman 1976, Dubrulle 2001, Wada 2011, Gomez 2008" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/yap_excitable_segmentation/paper_citations.bib#L45-L87> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

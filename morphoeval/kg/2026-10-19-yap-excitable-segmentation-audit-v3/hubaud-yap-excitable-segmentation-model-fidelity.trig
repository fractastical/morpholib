sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hubaud-yap-excitable-segmentation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Hubaud, Regev, Mahadevan & Pourquié (2017) excitable FitzHugh-Nagumo segmentation clock gated by YAP mechanotransduction, with FGF/Wnt clock-and-wavefront arrest and stiffness-LATS-YAP kinetics (Pass 3) — Model fidelity to source: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The published FHN fast-slow core, YAP gate and 2D excitable PDE are unchanged and verified (Laws 1-3, L171-604). Pass 3 adds the two missing mechanisms the v2 audit asked for and proves their governing identities in Lean (Theorems 4-6): the regressing exponential Fgf8 gradient (Dubrulle 2001) gating I_eff with an arrest criterion that reproduces S = v_wf T to 0.3% and the analytic front offset to 0.4% (L707-886), and a three-state YAP import/export/phosphorylation cycle whose monotonicity in tension and LATS is proved cross-multiplied (L954-1139). Deductions: the FGF gate gamma_F (g(F) - 1) is additive and phenomenological rather than an Fgf8/Wnt3a/Hes7 circuit, and gamma_F had to be raised from 0.8 to 1.6 for the excitable waves to actually arrest at the front, which is a tuned rather than derived number (-3); the 6-regime benchmark's 200-cell ensemble (L447-453) is computed but never used - the predicted oscillating fraction is a logistic of the deterministic I_eff with a hand-set margin 0.115 and width 0.125 (L451-456), so the r = 0.9976 reflects two fitted constants rather than ensemble dynamics (-3); the cascade keeps a LATS branch that Dupont (2011) found largely dispensable for the stiffness response (disclosed, -1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2016-hubaud-yap-excitable-segmentation.py L447–L456: Defect: 200-cell ensemble osc_mask is computed but pred_frac is a hand-tuned logistic of the deterministic I_eff (margin 0.115, width 0.125); the ensemble only feeds a reporting field <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L447-L456>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-6> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L171–L284" ;
        dct:description "FHN cubic nullcline, YAP-gated I_eff, equilibrium solver and analytical Hopf thresholds (Laws 1-3), unchanged from v2" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L171-L284> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L707–L748" ;
        dct:description "Pass 3: Fgf8 gradient F(x,t), Hill gate g(F), FGF-gated current I_eff = I_basal + J + gamma_F (g - 1) - gamma_YAP Y_nuc and g_crit from the Hopf margin (Law 5)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L707-L748> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L750–L886" ;
        dct:description "Pass 3: 1D chain with juxtacrine J_i, Laplacian coupling, arrest bookkeeping (u_arrest, Mesp2 switch L821-840), stripe/PSM-length morphometrics and anterior-wave-penetration metric (L849-858)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L750-L886> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L968–L1031" ;
        dct:description "Pass 3: tension index T(E, A, rho_actin, c_ROCK), LATS activity, steady-state Y_n = r_n/(1 + r_n + r_p) and least-squares calibration on the five WT regimes (Law 6)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L968-L1031> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L1059–L1139" ;
        dct:description "Pass 3: dynamic three-state YAP ODE coupled to the FHN cell for the Latrunculin A rescue (onset latency, period)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L1059-L1139> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-model-fidelity-6> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_027_yap_excitable_segmentation.lean L110–L199" ;
        dct:description "Theorems 4-6 (clock-wavefront spacing, FGF arrest criterion + front speed independent of lambda_F, YAP nuclear-fraction monotonicity), 0 sorrys, verified with lean 4.35.0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_027_yap_excitable_segmentation.lean#L110-L199> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


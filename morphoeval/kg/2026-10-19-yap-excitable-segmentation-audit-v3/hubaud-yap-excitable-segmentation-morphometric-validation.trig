sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hubaud-yap-excitable-segmentation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hubaud, Regev, Mahadevan & Pourquié (2017) excitable FitzHugh-Nagumo segmentation clock gated by YAP mechanotransduction, with FGF/Wnt clock-and-wavefront arrest and stiffness-LATS-YAP kinetics (Pass 3) — Morphometric validation: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1218-1352) now returns 11 reference-anchored measurements: the five v2 ones plus stripe spacing S vs v_wf T and the ~100 um mouse somite anchor, the Cooke-Zeeman slope vs T, the cascade RMSE vs the regime table, E_crit vs the Dupont bracket, the LatA onset latency vs one clock period, and the Kuramoto R vs complete synchrony with an uncoupled control; each carries a unit, method and note with the ablation / sweep numbers. Deductions: several new references are analytic or bracket values rather than measured specimen numbers (S vs v_wf T is a self-consistency check of the chain against its own tail-bud period; E_crit's 5.3 kPa 'reference' is a geometric midpoint; the LatA onset reference is an upper bound) (-4); the mouse somite length anchor is an order-of-magnitude value with no digitised Gomez (2008) table vendored (-2); the specimen CV 0.201 is never contrasted with the model CV 0.024 (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-6-regime-yap-notch-perturbation-oscillating-cell-fraction-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-cooke-zeeman-sweep-slope-ds-dv-wf-across-5-wavefront-speeds>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-critical-nuclear-yap-excitability-threshold-y-nuc-crit-at-j-dll1-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-dll1-notch-juxtacrine-coupling-kuramoto-order-parameter-r-at-j-max-0-15>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-fgf-wnt-wavefront-arrested-somite-stripe-spacing-s-model-1d-ap-excitable-chain>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-fitzhugh-nagumo-supercritical-hopf-bifurcation-threshold-u-h>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-latrunculin-a-dynamic-rescue-oscillation-onset-latency-after-f-actin-depolymerisation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-latrunculin-a-yap-inhibited-autonomous-oscillation-period-t-osc>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-predicted-critical-substrate-stiffness-e-crit-for-spread-psm-cells-y-nuc-y-nuc-crit>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-vertebrate-somite-psm-specimen-bilateral-somite-spacing-s-obs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-yap-mechanotransduction-cascade-y-nuc-rmse-across-5-wild-type-hubaud-regimes>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-morphometric-validation-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-6-regime-yap-notch-perturbation-oscillating-cell-fraction-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "6-regime YAP/Notch perturbation oscillating cell fraction Pearson correlation r = 0.9976 Pearson r" ;
        dct:description "p = 8.93e-06" ;
        schema:measurementTechnique "correlation between FHN ensemble-predicted and empirical oscillating cell fractions across all 6 Hubaud et al. (2017) regimes (RMSE = 0.0469)" ;
        schema:name "6-regime YAP/Notch perturbation oscillating cell fraction Pearson correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9976" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-6-regime-yap-notch-perturbation-oscillating-cell-fraction-pearson-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-6-regime-yap-notch-perturbation-oscillating-cell-fraction-pearson-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Hubaud, Regev, Mahadevan & Pourquie (2017) Cell 171:668-682 Figs. 1-6 (fibronectin, Dll1, LatA, Rockout Y-27632, intact mPSM, Yap5SA)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-cooke-zeeman-sweep-slope-ds-dv-wf-across-5-wavefront-speeds> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cooke-Zeeman sweep slope dS/dv_wf across 5 wavefront speeds = 144.82 min" ;
        dct:description "lambda_F sweep: lambda=250 um -> PSM 407 um (pred 410), S = 101.7 um; lambda=350 um -> PSM 571 um (pred 574), S = 101.7 um; lambda=450 um -> PSM 735 um (pred 737), S = 101.7 um" ;
        schema:measurementTechnique "linear regression of emergent stripe spacing S on v_wf in {0.45, 0.60, 0.70, 0.85, 1.00} um/min (intercept = 0.56 um)" ;
        schema:name "Cooke-Zeeman sweep slope dS/dv_wf across 5 wavefront speeds" ;
        schema:unitText "min" ;
        schema:value "144.82" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-cooke-zeeman-sweep-slope-ds-dv-wf-across-5-wavefront-speeds-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-cooke-zeeman-sweep-slope-ds-dv-wf-across-5-wavefront-speeds-reference> a schema:PropertyValue ;
        dct:source "Cooke & Zeeman (1976): dS/dv_wf = T_clock (simulated tail-bud period); lambda_F sweep must leave S unchanged (Lean Theorem 5)" ;
        schema:value "145.71" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-critical-nuclear-yap-excitability-threshold-y-nuc-crit-at-j-dll1-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical nuclear YAP excitability threshold Y_nuc_crit (at J_Dll1 = 0) = 0.6109 nuclear YAP fraction" ;
        dct:description "Yap5SA constitutive overexpression (Y_nuc=1.0) locks u^*=-1.091 in quiescent branch (amplitude=0.0000)" ;
        schema:measurementTechnique "Hopf threshold inversion Y_nuc_crit = (I_basal - I_H_lower) / gamma_YAP separating spread quiescent cells (Y_nuc=0.85) from Latrunculin A-rescued oscillators (Y_nuc=0.22)" ;
        schema:name "critical nuclear YAP excitability threshold Y_nuc_crit (at J_Dll1 = 0)" ;
        schema:unitText "nuclear YAP fraction" ;
        schema:value "0.6109" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-critical-nuclear-yap-excitability-threshold-y-nuc-crit-at-j-dll1-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-critical-nuclear-yap-excitability-threshold-y-nuc-crit-at-j-dll1-0-reference> a schema:PropertyValue ;
        dct:source "Hubaud, Regev, Mahadevan & Pourquie (2017) Cell 171:668-682 Figs. 3-4 (YAP threshold gating autonomous LuVeLu oscillations)" ;
        schema:value "0.6109" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-dll1-notch-juxtacrine-coupling-kuramoto-order-parameter-r-at-j-max-0-15> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Dll1-Notch juxtacrine coupling Kuramoto order parameter R at J_max = 0.15 = 0.6958 Kuramoto R" ;
        dct:description "J_max sweep R = 0.00->0.268, 0.05->0.404, 0.10->0.537, 0.15->0.696, 0.20->0.802, 0.30->0.801 (Spearman rho = 0.943)" ;
        schema:measurementTechnique "48-cell ring, 6 contacts per cell, tau_v CV = 0.038, random initial phases, 1400 min; R(t) averaged over the last 30%" ;
        schema:name "Dll1-Notch juxtacrine coupling Kuramoto order parameter R at J_max = 0.15" ;
        schema:unitText "Kuramoto R" ;
        schema:value "0.6958" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-dll1-notch-juxtacrine-coupling-kuramoto-order-parameter-r-at-j-max-0-15-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-dll1-notch-juxtacrine-coupling-kuramoto-order-parameter-r-at-j-max-0-15-reference> a schema:PropertyValue ;
        dct:source "complete phase synchrony (R = 1); uncoupled control R = 0.268; Hubaud et al. (2017) Fig. 7 Notch-coupled excitable-cell model" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-fgf-wnt-wavefront-arrested-somite-stripe-spacing-s-model-1d-ap-excitable-chain> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FGF/Wnt wavefront-arrested somite stripe spacing S_model (1D AP excitable chain) = 101.683 um" ;
        dct:description "uniform-FGF ablation: 0 stripes / 0 arrested cells; PSM length 571.0 um vs analytic 573.5 um; excitable-wave penetration anterior of the front = 0 um at gamma_F = 1.60 (gamma_F sweep: 0.80->802 um, 1.20->0 um, 1.60->0 um, 2.00->0 um); v_wf sweep slope dS/dv = 144.8 min (r = 0.99998, mean |S - v T|/vT = 0.0022)" ;
        schema:measurementTechnique "1D FHN chain + Dll1-Notch coupling + regressing Fgf8 gradient (lambda_F = 350 um, v_wf = 0.70 um/min); Mesp2-like switch m(x) = [u_arrest(x) > 0]; mean rising-edge spacing over 8 stripes (CV = 0.0241)" ;
        schema:name "FGF/Wnt wavefront-arrested somite stripe spacing S_model (1D AP excitable chain)" ;
        schema:unitText "um" ;
        schema:value "101.683" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-fgf-wnt-wavefront-arrested-somite-stripe-spacing-s-model-1d-ap-excitable-chain-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-fgf-wnt-wavefront-arrested-somite-stripe-spacing-s-model-1d-ap-excitable-chain-reference> a schema:PropertyValue ;
        dct:source "Cooke & Zeeman (1976) J Theor Biol 58:455-476 clock-and-wavefront law S = v_wf * T with the simulated tail-bud period T = 145.71 min (Lean Theorem 4); mouse somite AP length ~100 um (Gomez et al. 2008 Nature 454:335-339)" ;
        schema:value "101.996" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-fitzhugh-nagumo-supercritical-hopf-bifurcation-threshold-u-h> a schema:PropertyValue,

    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-latrunculin-a-yap-inhibited-autonomous-oscillation-period-t-osc-reference> a schema:PropertyValue ;
        dct:source "Hubaud, Regev, Mahadevan & Pourquie (2017) Cell 171:668-682 Fig. 4 (Latrunculin A triggers autonomous ~140 min LuVeLu oscillations in isolated mouse PSM cells)" ;

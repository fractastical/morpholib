sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hubaud-yap-excitable-segmentation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Hubaud, Regev, Mahadevan & Pourquié (2017) excitable FitzHugh-Nagumo segmentation clock gated by YAP mechanotransduction, with FGF/Wnt clock-and-wavefront arrest and stiffness-LATS-YAP kinetics (Pass 3) — Parameter expressivity: 95/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Every new morphospace parameter is swept and behaves monotonically as claimed: v_wf -> S linearly (5 points, slope 144.8 min = T, r 0.99998), lambda_F -> PSM length (407 / 571 / 735 um vs analytic 410 / 574 / 737) with S unchanged, gamma_F -> anterior pulse leak (802 um at 0.8, 0 um at >= 1.2), uniform FGF -> 0 stripes, E_sub -> Y_nuc monotone with E_crit inside the Dupont bracket, J_max -> Kuramoto R (0.27 -> 0.80, Spearman 0.94), plus the v2 Y_nuc bifurcation sweep and 6-regime suite. New CLI flags --v-wf, --lambda-F and --E-sub expose the two mechanisms. Deductions: the J_max -> R relation is not strictly monotone (it saturates: 0.802 at 0.20 vs 0.801 at 0.30; Spearman 0.94) and the ring uses a tau_v CV fixed at 0.04 (-3); the sweeps are reported as numbers and one scatter panel, without rendered stripe patterns along the v_wf sweep (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-parameter-expressivity-4> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L888–L952" ;
        dct:description "v_wf, lambda_F and gamma_F sweeps with regression slope, Cooke-Zeeman relative error, PSM length and wave-penetration per value" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L888-L952> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L1033–L1057" ;
        dct:description "160-point stiffness sweep and log-interpolated E_crit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L1033-L1057> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L687–L701" ;
        dct:description "J_max coupling sweep with Spearman rank correlation of the final order parameter" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L687-L701> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L2018–L2042" ;
        dct:description "CLI: --v-wf / --lambda-F one-off wavefront run and --E-sub cascade prediction" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L2018-L2042> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


<https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-cooke-zeeman-sweep-slope-ds-dv-wf-across-5-wavefront-speeds> a schema:PropertyValue,
        pk:EvidenceItem ;

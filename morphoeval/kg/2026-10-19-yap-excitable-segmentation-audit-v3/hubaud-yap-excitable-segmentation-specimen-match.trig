sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hubaud-yap-excitable-segmentation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Hubaud, Regev, Mahadevan & Pourquié (2017) excitable FitzHugh-Nagumo segmentation clock gated by YAP mechanotransduction, with FGF/Wnt clock-and-wavefront arrest and stiffness-LATS-YAP kinetics (Pass 3) — Morphological realism / specimen match: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Panel F still segments both bilateral somite rows of the vendored SEM (8 + 8 somites, 47.14 px, CV 0.201) and Panels G/H now place a generated discrete stripe pattern (8 stripes, S = 101.7 um, CV 0.024) beside it, with the Mesp2-like switch strip, the determination front and the tail bud drawn on the kymograph, so the figure finally shows somite-like periodic clefts emerging from the clock rather than only waves. Deductions: the specimen is a chick embryo SEM (source URL 'Aves_Neural_tube_and_somites_in_ chick_embryo.jpg', reference JSON L55) filed as mouse_psm_somites_specimen.jpg, and the v2 audit's 'vertebrate' wording hid this - the organism match is a transfer, not a mouse specimen (-6); the specimen spacing is in px with no um calibration, so the 100 um model stripes and the 47 px somites cannot be compared on one scale (-3); the model stripe CV (0.024) is an order of magnitude below the specimen CV (0.201) and the figure does not comment on it (-2); the 1D stripes have no mediolateral shape to compare with the rounded somite blocks (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/yap_excitable_segmentation/yap_excitable_segmentation_reference.json L50–L58: Defect: specimen source URL identifies a chick embryo SEM, filed under a 'mouse_psm' filename with no um/px scale <https://github.com/fractastical/morpholib/blob/d58a084/datasets/yap_excitable_segmentation/yap_excitable_segmentation_reference.json#L50-L58>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-specimen-match-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/yap_excitable_segmentation_comparison.png (generated output)" ;
        dct:description "9-panel figure: A-F as v2 plus G (1D kymograph with front, tail bud, Mesp2 strip and stripe edges), H (Cooke-Zeeman sweep, lambda_F / gamma_F annotations, ablation marker, 100 um anchor), I (Y_nuc(E_sub) with Dupont soft/stiff bands, regime points, LatA and synchrony insets) — docs/media/yap_excitable_segmentation_comparison.png: rendered output of 2016-hubaud-yap-excitable-segmentation.py at d58a084, image/png, 1578308 B, 2775×2475 px, artifact_sha256 b03f6304bef6d56658a46a97e5ad6da8f0d2c23af33d12f3eadf74f3fcac9db6 (sha256 b03f6304bef6d56658a46a97e5ad6da8f0d2c23af33d12f3eadf74f3fcac9db6), spec_fingerprint eb7a0a2051924df9834d2292bd3eca5cca883f40d58bf2c4618667071ccac50f" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L1651–L1684" ;
        dct:description "Panel G renders the stripe pattern and determination front from the same simulate_ap_wavefront_arrest result used by the measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L1651-L1684> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L1173–L1214" ;
        dct:description "Bilateral dorsal somite DoG peak & cleft segmentation on the specimen (unchanged from v2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L1173-L1214> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


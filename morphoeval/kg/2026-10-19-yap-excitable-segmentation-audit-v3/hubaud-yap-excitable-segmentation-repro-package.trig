sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hubaud-yap-excitable-segmentation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Hubaud, Regev, Mahadevan & Pourquié (2017) excitable FitzHugh-Nagumo segmentation clock gated by YAP mechanotransduction, with FGF/Wnt clock-and-wavefront arrest and stiffness-LATS-YAP kinetics (Pass 3) — Reproducibility package: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Deterministic seeds (2016) throughout, bitwise determinism asserted for both the 2D PDE and the new 1D chain, a least-squares calibration that is deterministic from fixed initial guesses, --self-test with the Pass 3 checks (stripe count, CV, S vs v_wf T, PSM length vs analytic, ablation, sweep slope, lambda_F invariance, wave arrest vs leak control, cascade RMSE, regime states, E_crit bracket, LatA onset, R monotonicity, 11 measurements with reference values) passing in ~6 s, and the default invocation regenerating the PNG and GIF in ~13 s. Deductions: no requirements lock file is vendored for this slot (-4); the GIF/PNG are not asserted byte-identical across runs (only the model arrays are) (-2); the calibration result depends on scipy.optimize internals and is not pinned by a stored fitted-parameter fixture (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-repro-package-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L1944–L1993" ;
        dct:description "Pass 3 self-test checks: determinism, stripes, Cooke-Zeeman, ablation, sweeps, wave arrest vs leak, cascade, stiffness, LatA kinetics, synchrony, 11 measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L1944-L1993> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2016-hubaud-yap-excitable-segmentation.py L2010–L2046" ;
        dct:description "CLI entrypoint runs the self-test before rendering; documented flags" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-hubaud-yap-excitable-segmentation.py#L2010-L2046> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/yap_excitable_segmentation_growth.gif (generated output)" ;
        dct:description "16-frame, 3-panel GIF (2D mPSM wave, FHN phase plane, 1D clock-and-wavefront growth with FGF gradient, front and accreting stripes) — docs/media/yap_excitable_segmentation_growth.gif: rendered output of 2016-hubaud-yap-excitable-segmentation.py at d58a084, image/gif, 831769 B, 1550×459 px, 16 frames, artifact_sha256 d71372b025f573860bd718d7611d7f6860ce45dd446a0ad9aa73efbdd6864ff5 (sha256 d71372b025f573860bd718d7611d7f6860ce45dd446a0ad9aa73efbdd6864ff5), spec_fingerprint eb7a0a2051924df9834d2292bd3eca5cca883f40d58bf2c4618667071ccac50f" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


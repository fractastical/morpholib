sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-16-thompson-audit-thompson-scarus-pomacanthus-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson's Scarus -> Pomacanthus coordinate transformation fitted to real species — Morphological realism / specimen match: 55/100" ;
        rdfs:comment "The specimens are the 791 real species, and Thompson's own figure is placed beside them from the hash-pinned scan, so the side-by-side the dimension asks for is there. Judged on it, the fish Thompson's family carries does not match the real Pomacanthus at species resolution: the best coaxial grid leaves a residual twice the spread of the nine Pomacanthus species about their mean, the residual vectors in panel B'' show where (anal fin, upper jaw, dorsal-fin end), and the thin-plate grid in panel B'''' shows the deformation the data demand is not a system of circles. Distinct morphologies are distinct (Scarus and Pomacanthus means differ by 0.031, three times the within-genus spread). Scored in the middle because the comparison is honest and legible but the rendering is a 17-landmark polygon with four bars, not an outline or a photograph: the body profile, the fin shapes and the head that make a Pomacanthus recognisable are not shown, and Thompson's drawn grid is displayed, not overlaid on the fitted one. Evidence: thompson_scarus_pomacanthus.png (generated output, not in repo): panels A (Thompson), A'/A'' (real species), B-B'''' (grids with residuals), C, D — thompson_scarus_pomacanthus.png: rendered output of thompson/1917-thompson-scarus-pomacanthus.py at 3cf7f8c, image/png, 739620 B, 2520×1540 px, sha256 d243f51e2b90b1a2201ec81265392b1cf95ea0f0e6e68074818cc5754b324e08; thompson/1917-thompson-scarus-pomacanthus.py L356–L362: scan_crop(): Figs. 375-376 from the pinned page <https://github.com/fractastical/morpholib/blob/3cf7f8c/thompson/1917-thompson-scarus-pomacanthus.py#L356-L362>; thompson/1917-thompson-scarus-pomacanthus.py L392–L420: row B: each family's grid and fish with residual vectors to the real mean <https://github.com/fractastical/morpholib/blob/3cf7f8c/thompson/1917-thompson-scarus-pomacanthus.py#L392-L420>; thompson/1917-thompson-scarus-pomacanthus.py L102–L104: OUTLINE/WIRES: what of the fish is drawn <https://github.com/fractastical/morpholib/blob/3cf7f8c/thompson/1917-thompson-scarus-pomacanthus.py#L102-L104>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-thompson-scarus-pomacanthus-specimen-match> ;
        pk:hasProbability "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-thompson-scarus-pomacanthus-specimen-match> rdfs:label "Thompson's Scarus -> Pomacanthus coordinate transformation fitted to real species (thompson/1917-thompson-scarus-pomacanthus.py) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Scarus (22 spp.) and Pomacanthus (9 spp.), with Chaetodon (54 spp.) and 59 other genera for context; Indo-Pacific shore fishes, lateral view" ;
        dcterms:identifier "morphoeval/0.1.0/specimen-match" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


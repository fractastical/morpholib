sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-16-thompson-audit-thompson-scarus-pomacanthus-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson's Scarus -> Pomacanthus coordinate transformation fitted to real species — Code-to-model traceability: 78/100" ;
        rdfs:comment "Each step is tied to its source: the quoted passage to the Moebius reading, Fig. 376's oblique pencils to the second family, Fig. 374 to the affine part, Bookstein 1989 to the TPS, Claverie Fig. 1 to the drawn polygon and bars; every printed number names what it is compared with. Because Thompson gave no equations the trace ends at prose and a drawing, and the judgement that Fig. 376 is oblique rather than isogonal is made by eye, not measured on the scan. Evidence: thompson/1917-thompson-scarus-pomacanthus.py L15–L23: why coaxial circles = Moebius <https://github.com/fractastical/morpholib/blob/3cf7f8c/thompson/1917-thompson-scarus-pomacanthus.py#L15-L23>; thompson/1917-thompson-scarus-pomacanthus.py L243–L247: coaxial(): Fig. 374 / Fig. 376 reading <https://github.com/fractastical/morpholib/blob/3cf7f8c/thompson/1917-thompson-scarus-pomacanthus.py#L243-L247>; thompson/1917-thompson-scarus-pomacanthus.py L163–L166: gpa(): orientation convention tied to Thompson's figures <https://github.com/fractastical/morpholib/blob/3cf7f8c/thompson/1917-thompson-scarus-pomacanthus.py#L163-L166>; thompson/1917-thompson-scarus-pomacanthus.py L398–L408: panel titles name the figure each grid corresponds to <https://github.com/fractastical/morpholib/blob/3cf7f8c/thompson/1917-thompson-scarus-pomacanthus.py#L398-L408>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-thompson-scarus-pomacanthus-code-traceability> ;
        pk:hasProbability "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-thompson-scarus-pomacanthus-code-traceability> rdfs:label "Thompson's Scarus -> Pomacanthus coordinate transformation fitted to real species (thompson/1917-thompson-scarus-pomacanthus.py) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Scarus (22 spp.) and Pomacanthus (9 spp.), with Chaetodon (54 spp.) and 59 other genera for context; Indo-Pacific shore fishes, lateral view" ;
        dcterms:identifier "morphoeval/0.1.0/code-traceability" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


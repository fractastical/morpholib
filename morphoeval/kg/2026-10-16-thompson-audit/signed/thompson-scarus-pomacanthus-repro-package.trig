sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-16-thompson-audit-thompson-scarus-pomacanthus-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson's Scarus -> Pomacanthus coordinate transformation fitted to real species — Reproducibility package: 75/100" ;
        rdfs:comment "Deterministic (Levenberg-Marquardt from fixed starts, seeded self-test), invocation and outputs documented, the data file is in the repository and hash-checked, the only network fetch is optional (--no-scan) and hash-checked, re-runs give identical numbers. Dependencies are in requirements.txt with lower bounds only and the known-good environment is recorded only in this audit; the GIF takes ~2 min because each frame refits a thin-plate spline and re-renders. Evidence: thompson/1917-thompson-scarus-pomacanthus.py L67–L73: documented invocation and outputs <https://github.com/fractastical/morpholib/blob/3cf7f8c/thompson/1917-thompson-scarus-pomacanthus.py#L67-L73>; thompson/1917-thompson-scarus-pomacanthus.py L523–L580: main(): flags, offline fallback for the scan <https://github.com/fractastical/morpholib/blob/3cf7f8c/thompson/1917-thompson-scarus-pomacanthus.py#L523-L580>; requirements.txt L1–L7: lower bounds only <https://github.com/fractastical/morpholib/blob/3cf7f8c/requirements.txt#L1-L7>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-thompson-scarus-pomacanthus-repro-package> ;
        pk:hasProbability "0.75"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-thompson-scarus-pomacanthus-repro-package> rdfs:label "Thompson's Scarus -> Pomacanthus coordinate transformation fitted to real species (thompson/1917-thompson-scarus-pomacanthus.py) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Scarus (22 spp.) and Pomacanthus (9 spp.), with Chaetodon (54 spp.) and 59 other genera for context; Indo-Pacific shore fishes, lateral view" ;
        dcterms:identifier "morphoeval/0.1.0/repro-package" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


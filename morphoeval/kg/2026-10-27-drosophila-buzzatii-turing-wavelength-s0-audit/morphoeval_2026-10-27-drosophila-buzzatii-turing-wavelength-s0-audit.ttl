<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Schnakenberg–Turing wavelength at 2.908 µm in Drosophila buzzatii (Pass 1) (Drosophila buzzatii)",
        "Schnakenberg–Turing wavelength at 2.908 µm in Drosophila buzzatii (Pass 1) faithfully reproduces Drosophila buzzatii morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-buzzatii-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-buzzatii-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-buzzatii-turing-wavelength-s0-3> ;
    dct:description "The simulation script(s) models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila buzzatii specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py> ;
    schema:about "Drosophila buzzatii" ;
    schema:additionalProperty "does_not_claim: That Norry measured a 2.9 µm pigment wavelength.",
        "does_not_claim: That the species card is a wing micrograph.",
        "reconstructed_in_script: Discrete-mode lambda across 14 gamma scales is correlated with the closed form.",
        "reconstructed_in_script: gamma is solved so lambda_c = 2.908 um on this Jacobian, with D_v/D_u = 29.",
        "reported_in_source: Norry, Vilardi & Hasson 1997: inversion-sensitive correlations among size traits in D. buzzatii.",
        "reported_in_source: Schnakenberg 1979: f = a - u + u^2 v, g = b - u^2 v.",
        "reported_in_source: Turing 1952: a homogeneous field can be unstable at a finite critical wavenumber.",
        "transfer_boundary: Norry's wing/thorax allometry is used only as the statement that organ length changes mode count N = L/lambda, not lambda itself." ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Drosophila buzzatii (Prickly-Pear Opuntia Cactophilic Fly)" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "II. Anaima (Invertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;
    pk:aristotelianSubalternClass "Entoma (Arthropoda)" ;
    pk:biologicalGenus "Drosophila" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py; output: docs/media/drosophila_buzzatii_turing_wavelength_s0_comparison.png; organism: Drosophila buzzatii; environment: python 3.12, numpy 2.5.4, scipy 1.18.1; claim_boundary: [reported_in_source: Turing 1952: a homogeneous field can be unstable at a finite critical wavenumber. | Schnakenberg 1979: f = a - u + u^2 v, g = b - u^2 v. | Norry, Vilardi & Hasson 1997: inversion-sensitive correlations among size traits in D. buzzatii.; reconstructed_in_script: gamma is solved so lambda_c = 2.908 um on this Jacobian, with D_v/D_u = 29. | Discrete-mode lambda across 14 gamma scales is correlated with the closed form.; transfer_boundary: Norry's wing/thorax allometry is used only as the statement that organ length changes mode count N = L/lambda, not lambda itself.; does_not_claim: That Norry measured a 2.9 µm pigment wavelength. | That the species card is a wing micrograph.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
    pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/sj.hdy.6882540>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:externalAtlasDataset <https://codex.flywire.ai/>,
        <https://flybase.org/>,
        <https://flycellatlas.org/>,
        <https://insitu.fruitfly.org/>,
        <https://www.virtualflybrain.org/> ;
    pk:fossilLineageGroup "Subgenus Drosophila virilis–repleta–guttifera Radiation" ;
    pk:geologicalAgeMa 0e+00 ;
    pk:geologicalPeriod "Holocene (Extant)" ;
    pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-code-traceability>,

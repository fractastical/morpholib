sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila santomea Schnakenberg wavelength at 2.326 µm (Holocene, 0 Ma), pass 1 — Morphometric validation: 70/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r and RMSE are real. There is no KS distance, no ablation amplitude, and no specimen length yet, so the morphometric claim is only the linear-theory check." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-pseudoobscura-at-the-2-3-m-tier>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-sechellia-at-the-2-3-m-tier>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-d-santomea-critical-wavelength-at-gamma-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-schnakenberg-dispersion-pearson-r-of-numeric-versus-analytic-growth-rates>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-pseudoobscura-at-the-2-3-m-tier> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chronoseries wavelength gap santomea minus pseudoobscura at the 2.3 µm tier = 0.486 µm" ;
        schema:measurementTechnique "2326 nm − 1840 nm, with γ_pseudoobscura / γ_santomea = (2326/1840)^2" ;
        schema:name "chronoseries wavelength gap santomea minus pseudoobscura at the 2.3 µm tier" ;
        schema:unitText "µm" ;
        schema:value "0.486" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-pseudoobscura-at-the-2-3-m-tier-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-pseudoobscura-at-the-2-3-m-tier-reference> a schema:PropertyValue ;
        dct:source "Reconstructed detail-tier gap, not a fossil measurement and not the sibling primordium slots" ;
        schema:value "0.4" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-sechellia-at-the-2-3-m-tier> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chronoseries wavelength gap santomea minus sechellia at the 2.3 µm tier = 0.276 µm" ;
        schema:measurementTechnique "2326 nm − 2050 nm, with γ_sechellia / γ_santomea = (2326/2050)^2" ;
        schema:name "chronoseries wavelength gap santomea minus sechellia at the 2.3 µm tier" ;
        schema:unitText "µm" ;
        schema:value "0.276" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-sechellia-at-the-2-3-m-tier-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-sechellia-at-the-2-3-m-tier-reference> a schema:PropertyValue ;
        dct:source "Reconstructed detail-tier gap; sechellia retains abdominal tan relative to santomea" ;
        schema:value "0.3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-d-santomea-critical-wavelength-at-gamma-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "D. santomea critical wavelength at gamma = 1 = 2.326 µm" ;
        dct:description "2.326 ≠ 2.3; the reference is the one-decimal assignment and the value is the locked three-decimal wavelength" ;
        schema:measurementTechnique "λ_c = 2π ξ / k_c with ξ fixed so the continuous formula equals 2.326 µm" ;
        schema:name "D. santomea critical wavelength at gamma = 1" ;
        schema:unitText "µm" ;
        schema:value "2.326" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-d-santomea-critical-wavelength-at-gamma-1-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-d-santomea-critical-wavelength-at-gamma-1-reference> a schema:PropertyValue ;
        dct:source "Slot 3201 assigned detail scale 2.3 µm (stored exactly as 2.326 µm)" ;
        schema:value "2.3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-schnakenberg-dispersion-pearson-r-of-numeric-versus-analytic-growth-rates> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Schnakenberg dispersion Pearson r of numeric versus analytic growth rates = 1.0 Pearson_r" ;
        dct:description "RMSE = 4.9e-05" ;
        schema:measurementTechnique "Eigenvector-initialized cosine modes; late-time log-amplitude slope versus the largest Jacobian eigenvalue at the discrete Laplacian wavenumber" ;
        schema:name "Schnakenberg dispersion Pearson r of numeric versus analytic growth rates" ;
        schema:unitText "Pearson_r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-schnakenberg-dispersion-pearson-r-of-numeric-versus-analytic-growth-rates-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-schnakenberg-dispersion-pearson-r-of-numeric-versus-analytic-growth-rates-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 Phil. Trans. R. Soc. B 237:37 linear dispersion; identity is the ideal, the grid Laplacian is the measurement" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-santomea-turing-wavelength-s0.py L517–L560" ;
        dct:description "measure_morphoeval dispersion and chronospecies gap rows" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-santomea-turing-wavelength-s0.py#L517-L560> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "datasets/drosophila_santomea_turing_wavelength_s0/pass1_metrics.json (generated output)" ;
        dct:description "pearson_r 1.0, rmse 4.9e-5, no KS key — datasets/drosophila_santomea_turing_wavelength_s0/pass1_metrics.json: rendered output of models/2026-delphi10000-drosophila-santomea-turing-wavelength-s0.py at 0c76d15d, application/json, 2242 B, artifact_sha256 b74e3d57f7f2e4ede8132373bae9c4b93bfc40d58a0c189c3e73566f28d8ff2a (sha256 b74e3d57f7f2e4ede8132373bae9c4b93bfc40d58a0c189c3e73566f28d8ff2a), spec_fingerprint 6dd554cc130d1b0176b37753cfbd7be017befc53ffb878bd36cf5f79710bf34c" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (single builder-assessor; no separate second-model pass)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://github.com/fractastical> .
}


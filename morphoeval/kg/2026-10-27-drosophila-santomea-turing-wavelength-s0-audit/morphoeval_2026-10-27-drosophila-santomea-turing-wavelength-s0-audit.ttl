<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-santomea-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant gap" ;
    dct:description "Instability condition at 2.326 µm for Holocene D. santomea | Variables: f_u = 0.74, g_v = -1, D_u = 1, D_v = 40, h = 28.6" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-santomea-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3201_drosophila_santomea_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "h^2 > 4 D_u D_v det(J), h = D_v f_u + D_u g_v" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.cell.2008.01.014>,
        <https://doi.org/10.1098/rspb.2000.1169>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.0014-3820.2002.tb00150.x> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3201.dispersionNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3201.turing_determinant_gap" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-santomea-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber identity" ;
    dct:description "Poson law for stripes, spots, and ocelli at this tier | Variables: 286/800 = 143/400" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-santomea-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3201_drosophila_santomea_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = h / (2 D_u D_v) = 28.6/80" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.cell.2008.01.014>,
        <https://doi.org/10.1098/rspb.2000.1169>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.0014-3820.2002.tb00150.x> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3201.critical_wavenumber_identity" ;
    pk:leanTheorem "MathOfBiology.Loop_3201.critical_wavenumber_identity" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-santomea-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronospecies wavelength order at 0 Ma" ;
    dct:description "What changes at 2.3 µm versus the predecessor and the successor | Variables: 1840 nm < 2050 nm < 2326 nm" ;
    dct:source "Jeong et al. 2008 DOI:10.1016/j.cell.2008.01.014" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-santomea-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3201_drosophila_santomea_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "λ_pseudoobscura < λ_sechellia < λ_santomea and γ ∝ 1/λ^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.cell.2008.01.014>,
        <https://doi.org/10.1098/rspb.2000.1169>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.0014-3820.2002.tb00150.x> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3201.lambdaNmSantomea" ;
    pk:leanTheorem "MathOfBiology.Loop_3201.santomea_longer_than_neighbors" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-trushko-epithelioid-cyst-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán spherical epithelial cyst buckling under alginate confinement — Morphological realism / specimen match: 35/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Although `datasets/epithelioid_cyst_buckling/epithelioid_cyst_specimen.jpg` is vendored on disk, the v1 script never loads, segments, or measures cyst/lumen contour circularity, epithelial thickness ratio h/R_0, or inward boundary fold depth on the histology micrograph." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2019-trushko-epithelioid-cyst-buckling.py L68–L96: Evaluates only 3 tabular regimes without loading or segmenting epithelioid_cyst_specimen.jpg <https://github.com/fractastical/morpholib/blob/33e07ad/2019-trushko-epithelioid-cyst-buckling.py#L68-L96>",
            "docs/media/epithelioid_cyst_buckling_comparison.png (generated output, not in repo): 4-panel v1 plot omits histology specimen segmentation and 12-point (h/R_0) scaling collapse — docs/media/epithelioid_cyst_buckling_comparison.png: rendered output of 2019-trushko-epithelioid-cyst-buckling.py at 33e07ad, image/png, 124527 B, 1007×964 px, artifact_sha256 c509d37e8fa16b941cdd73e3bf5ccd77833c7933d9967e841467e55861360cff (sha256 c509d37e8fa16b941cdd73e3bf5ccd77833c7933d9967e841467e55861360cff), spec_fingerprint 8c51faae6711c461b674cf68b978bc7ce168e67b48347c008c6f0f5cae0506b9" ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 069 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


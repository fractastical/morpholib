    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-code-traceability-1> ;
    pk:hasScore 6.8e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán spherical epithelial cyst buckling under alginate confinement — Model fidelity to source: 58/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Implements the analytical Zoelly spherical shell critical buckling pressure formula P_c = (2*E_epi/sqrt(3*(1-nu^2)))*(h/R_0)^2 (L38-47), backed by 3 Lean 4 theorems in `Loop_069_epithelioid_cyst_buckling.lean`. However, `generate_parametric_cyst_contour` (L50-65) uses a prescribed Gaussian indentation rather than minimizing a nonlinear Föppl-von Kármán + vertex monolayer energy functional with unilateral alginate wall confinement and actomyosin contractility." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "2019-trushko-epithelioid-cyst-buckling.py L50–L65: Heuristic Gaussian dent profile without nonlinear FvK/vertex energy minimization or capsule wall mechanics <https://github.com/fractastical/morpholib/blob/33e07ad/2019-trushko-epithelioid-cyst-buckling.py#L50-L65>" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity-1> ;
    pk:hasScore 5.8e-01 ;
    pk:hasVerdict "partially faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán spherical epithelial cyst buckling under alginate confinement — Morphometric validation: 52/100" ;

<https://w3id.org/probknow/resource/claim/morphoeval-trushko-epithelioid-cyst-buckling> a pk:Claim ;
    rdfs:label "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán spherical epithelial cyst buckling under alginate confinement (Mammalian polarized epithelial cyst monolayers (Canis lupus familiaris MDCK II, Homo sapiens Caco-2))",
        "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán spherical epithelial cyst buckling under alginate confinement faithfully reproduces Mammalian polarized epithelial cyst monolayers (Canis lupus familiaris MDCK II, Homo sapiens Caco-2) morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/trushko-epithelioid-cyst-buckling-1>,
        <https://w3id.org/probknow/resource/math-law/trushko-epithelioid-cyst-buckling-2>,
        <https://w3id.org/probknow/resource/math-law/trushko-epithelioid-cyst-buckling-3> ;
    dct:description "The simulation script(s) 2019-trushko-epithelioid-cyst-buckling.py implement the cited source model as published and produce forms that match real Mammalian polarized epithelial cyst monolayers (Canis lupus familiaris MDCK II, Homo sapiens Caco-2) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 53.2/100, audit 2026-10-19-epithelioid-cyst-buckling-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/33e07ad/2019-trushko-epithelioid-cyst-buckling.py> ;
    schema:about "Mammalian polarized epithelial cyst monolayers (Canis lupus familiaris MDCK II, Homo sapiens Caco-2)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/33e07ad/2019-trushko-epithelioid-cyst-buckling.py; output: docs/media/epithelioid_cyst_buckling_comparison.png; organism: Mammalian polarized epithelial cyst monolayers (Canis lupus familiaris MDCK II, Homo sapiens Caco-2); checkpoint commit: https://github.com/fractastical/morpholib/commit/33e07ad; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 8c51faae6711c461b674cf68b978bc7ce168e67b48347c008c6f0f5cae0506b9; artifact_sha256: c509d37e8fa16b941cdd73e3bf5ccd77833c7933d9967e841467e55861360cff; input_dataset_sha256: {datasets/epithelioid_cyst_buckling/epithelioid_cyst_buckling_reference.json=c1412a6f1bcc24be..., datasets/epithelioid_cyst_buckling/epithelioid_cyst_specimen.jpg=ec5b534f7a3a8182..., datasets/epithelioid_cyst_buckling/paper_citations.bib=b14ab196e08a46d4..., datasets/epithelioid_cyst_buckling/scout_manifest.json=3d03ec2877bdf349...}" ;
    pk:derivedFromPaper <https://doi.org/10.1016/j.devcel.2020.07.019>,
        <https://doi.org/10.1073/pnas.1309482110>,
        <https://doi.org/10.1073/pnas.1312076111>,
        <https://doi.org/10.3929/ethz-a-000096658> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-morphometric-validation>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-overall>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-parameter-expressivity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-epithelioid-cyst-buckling-audit-trushko-epithelioid-cyst-buckling-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-epithelioid-cyst-buckling-audit-trushko-epithelioid-cyst-buckling-2>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-epithelioid-cyst-buckling-audit-trushko-epithelioid-cyst-buckling-3> ;
    pk:hypothesisType "Föppl–von Kármán & Zoelly Spherical Shell Buckling of Proliferating Epithelial Monolayers Under Elastic Alginate Confinement" ;
    pk:weightOfEvidence 5.32e-01 .


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-trushko-epithelioid-cyst-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán spherical epithelial cyst buckling under alginate confinement — Morphometric validation: 52/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L164-199) reports only 3 analytical Zoelly P_c values without L-BFGS-B relaxed invagination fold depth delta/R_0, 12-point Pearson r / quadratic log-log slope, buckling time t_b vs doubling time tau_d, or specimen segmentation metrics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2019-trushko-epithelioid-cyst-buckling.py L164–L199: Only 3 analytical P_c values without p-values, fold depths, or specimen CV metrics <https://github.com/fractastical/morpholib/blob/33e07ad/2019-trushko-epithelioid-cyst-buckling.py#L164-L199>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-blebbistatin-inhibited-cyst-zoelly-critical-buckling-pressure-pc-25-um-blebbistatin>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-large-thin-walled-capsule-zoelly-critical-buckling-pressure-pc-r0-140-um-h-9-8-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-standard-mdck-cyst-zoelly-critical-buckling-pressure-pc-r0-100-um-h-10-5-um> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-blebbistatin-inhibited-cyst-zoelly-critical-buckling-pressure-pc-25-um-blebbistatin> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Blebbistatin-inhibited cyst Zoelly critical buckling pressure Pc (25 uM Blebbistatin) = 0.1182 kPa" ;
        schema:measurementTechnique "Analytical Zoelly spherical shell formula P_c = (2*E_epi/sqrt(3*(1-nu^2)))*(h/R_0)^2" ;
        schema:name "Blebbistatin-inhibited cyst Zoelly critical buckling pressure Pc (25 uM Blebbistatin)" ;
        schema:unitText "kPa" ;
        schema:value "0.1182" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-blebbistatin-inhibited-cyst-zoelly-critical-buckling-pressure-pc-25-um-blebbistatin-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-blebbistatin-inhibited-cyst-zoelly-critical-buckling-pressure-pc-25-um-blebbistatin-reference> a schema:PropertyValue ;
        dct:source "Trushko et al. (2020) Dev. Cell 54:655-668 Fig. 6" ;
        schema:value "0.118" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-large-thin-walled-capsule-zoelly-critical-buckling-pressure-pc-r0-140-um-h-9-8-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Large thin-walled capsule Zoelly critical buckling pressure Pc (R0=140 um, h=9.8 um) = 0.1172 kPa" ;
        schema:measurementTechnique "Analytical Zoelly spherical shell formula P_c = (2*E_epi/sqrt(3*(1-nu^2)))*(h/R_0)^2" ;
        schema:name "Large thin-walled capsule Zoelly critical buckling pressure Pc (R0=140 um, h=9.8 um)" ;
        schema:unitText "kPa" ;
        schema:value "0.1172" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-large-thin-walled-capsule-zoelly-critical-buckling-pressure-pc-r0-140-um-h-9-8-um-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-large-thin-walled-capsule-zoelly-critical-buckling-pressure-pc-r0-140-um-h-9-8-um-reference> a schema:PropertyValue ;
        dct:source "Trushko et al. (2020) Dev. Cell 54:655-668 Fig. 4" ;
        schema:value "0.117" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-standard-mdck-cyst-zoelly-critical-buckling-pressure-pc-r0-100-um-h-10-5-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Standard MDCK cyst Zoelly critical buckling pressure Pc (R0=100 um, h=10.5 um) = 0.2637 kPa" ;
        schema:measurementTechnique "Analytical Zoelly spherical shell formula P_c = (2*E_epi/sqrt(3*(1-nu^2)))*(h/R_0)^2" ;
        schema:name "Standard MDCK cyst Zoelly critical buckling pressure Pc (R0=100 um, h=10.5 um)" ;
        schema:unitText "kPa" ;
        schema:value "0.2637" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-standard-mdck-cyst-zoelly-critical-buckling-pressure-pc-r0-100-um-h-10-5-um-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-standard-mdck-cyst-zoelly-critical-buckling-pressure-pc-r0-100-um-h-10-5-um-reference> a schema:PropertyValue ;
        dct:source "Trushko et al. (2020) Dev. Cell 54:655-668 Fig. 3" ;
        schema:value "0.264" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 069 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-trushko-epithelioid-cyst-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán spherical epithelial cyst buckling under alginate confinement — Parameter expressivity: 48/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates 3 buckled capsule regimes (L68-96), but skips the unconfined / ultra-soft alginate negative control (P < P_c, delta/R_0 = 0), omits the 12-point (h/R_0) and E_alg parameter sweep, and exposes no CLI parameter overrides." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2019-trushko-epithelioid-cyst-buckling.py L68–L96: Skips unconfined_soft_control and omits 12-point (h/R_0) scaling dataset <https://github.com/fractastical/morpholib/blob/33e07ad/2019-trushko-epithelioid-cyst-buckling.py#L68-L96>" ;
        pk:hasScore "0.48"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 069 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


    <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán spherical epithelial cyst buckling under alginate confinement — Code-to-model traceability: 68/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Links module header to Trushko et al. (2020), Hannezo et al. (2014), Zoelly (1915), and `Loop_069_epithelioid_cyst_buckling.lean` (L1-21), but lacks trace links for nonlinear FvK + vertex ring relaxation, mode selection (n=1 vs n=2), and Blebbistatin actomyosin perturbation." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-code-traceability-1> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2019-trushko-epithelioid-cyst-buckling.py L1–L21" ;
        dcterms:description "Baseline header linking primary literature and Loop_069 Lean module" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/33e07ad/2019-trushko-epithelioid-cyst-buckling.py#L1-L21> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 069 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


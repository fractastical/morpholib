sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-035> a pk:Claim ;
        rdfs:label "Thompson (1917) Ch. XV Fig. 328 — sea-urchin test as pressure/tension shell (Pass 1 --pass1) faithfully reproduces Echinoid test (Wikimedia Commons CC BY 2.0, James St. John) morphology" ;
        dct:description "The simulation script(s) thompson/claims/t1917-035_on-the-shapes-of-eggs-and-of-certain-other-hollo.py implement the cited source model as published and produce forms that match real Echinoid test (Wikimedia Commons CC BY 2.0, James St. John) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-035_on-the-shapes-of-eggs-and-of-certain-other-hollo.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-035_on-the-shapes-of-eggs-and-of-certain-other-hollo.py; output: docs/media/t1917_035_on_the_shapes_of_eggs_and_of_c_comparison.png; organism: Echinoid test (Wikimedia Commons CC BY 2.0, James St. John); environment: python 3.12, numpy 2.x, scipy 1.x, matplotlib 3.x, scikit-image 0.26.x; claim_boundary: [reported_in_source: Thompson 1917 Ch. XV Fig. 328: sea-urchin tests among hollow structures explicable under pressure and tension.; reconstructed_in_script: Pass 1 CV meridian on one Commons photograph; Preston fit; Thompson closure residual.; does_not_claim: Dryad dn160 (genetics) — documented DATASET_MISMATCH. | Skulls / other shells in the same sentence (not tested in Pass 1).]" .
    <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-035_on-the-shapes-of-eggs-and-of-certain-other-hollo.py> a schema:SoftwareSourceCode ;
        rdfs:label "thompson/claims/t1917-035_on-the-shapes-of-eggs-and-of-certain-other-hollo.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> .
}


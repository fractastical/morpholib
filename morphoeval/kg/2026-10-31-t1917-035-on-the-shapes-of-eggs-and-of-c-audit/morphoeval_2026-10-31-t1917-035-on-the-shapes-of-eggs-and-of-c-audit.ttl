<https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-035> a pk:Claim ;
    rdfs:label "Thompson (1917) Ch. XV Fig. 328 — sea-urchin test as pressure/tension shell (Pass 1 --pass1) (Echinoid test (Wikimedia Commons CC BY 2.0, James St. John))",
        "Thompson (1917) Ch. XV Fig. 328 — sea-urchin test as pressure/tension shell (Pass 1 --pass1) faithfully reproduces Echinoid test (Wikimedia Commons CC BY 2.0, James St. John) morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-035-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-035-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-035-3> ;
    dct:description "The simulation script(s) thompson/claims/t1917-035_on-the-shapes-of-eggs-and-of-certain-other-hollo.py implement the cited source model as published and produce forms that match real Echinoid test (Wikimedia Commons CC BY 2.0, James St. John) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-035_on-the-shapes-of-eggs-and-of-certain-other-hollo.py> ;

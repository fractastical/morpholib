sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-oster-mechanochemical-chondrogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Oster, Murray & Harris (1983) / Oster, Murray & Maini (1985) mechanochemical limb chondrogenesis — Model fidelity to source: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Faithfully implements the Oster, Murray & Harris (1983) and Oster, Murray & Maini (1985) coupled cell conservation PDE (with biharmonic diffusion -D_2*nabla^4 n and passive ECM advection -div(n*v_ecm)) and viscoelastic Kelvin-Voigt ECM force balance with contact-inhibited cell traction tau*n^2/(1+lam*n^2) (L108-278), reproducing the exact critical traction bifurcation threshold tau_c = 1.2776 at k_c = 0.9602 (lambda_c = 6.5435) and verified by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1983-oster-mechanochemical-chondrogenesis.py L108–L182" ;
        dct:description "Exact marginal stability curve tau_eff(k^2), critical traction tau_c = 1.2776, and dispersion relation Re(sigma(k))" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1983-oster-mechanochemical-chondrogenesis.py#L108-L182> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1983-oster-mechanochemical-chondrogenesis.py L185–L278" ;
        dct:description "Coupled 1D spectral-pseudospectral cell-ECM PDE solver reproducing modes [0, 1, 2, 4, 5]" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1983-oster-mechanochemical-chondrogenesis.py#L185-L278> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean L22–L97" ;
        dct:description "3 machine-checked Lean 4 theorems (0 sorrys) for traction instability, contact-inhibited saturation, and 1->2->4->5 limb branching" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L22-L97> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


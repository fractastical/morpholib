    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1007/978-1-4615-6983-1_6>,
            <https://doi.org/10.1093/imammb/1.1.51>,
            <https://doi.org/10.1242/dev.78.1.83>,
            <https://doi.org/10.1242/dev.89.1.93> .
    <https://doi.org/10.1007/978-1-4615-6983-1_6> dct:date "1986"^^xsd:gYear ;
        dct:title "A morphogenetic approach to the origin and basic organization of the tetrapod limb" .
    <https://doi.org/10.1093/imammb/1.1.51> dct:date "1984"^^xsd:gYear ;
        dct:title "Generation of biological pattern and form" .
    <https://doi.org/10.1242/dev.78.1.83> dct:date "1983"^^xsd:gYear ;
        dct:title "Mechanical aspects of mesenchymal morphogenesis" .
    <https://doi.org/10.1242/dev.89.1.93> dct:date "1985"^^xsd:gYear ;
        dct:title "A model for chondrogenic condensations in the developing limb: the role of extracellular matrix and cell tractions" .
}


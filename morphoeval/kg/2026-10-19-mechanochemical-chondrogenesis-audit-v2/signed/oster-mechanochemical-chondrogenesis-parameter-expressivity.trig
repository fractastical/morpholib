sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-oster-mechanochemical-chondrogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1983-oster-mechanochemical-chondrogenesis.py L280–L345" ;
        dcterms:description "2D proximo-distal limb paddle condensation and viscoelastic ECM displacement field solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1983-oster-mechanochemical-chondrogenesis.py#L280-L345> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1983-oster-mechanochemical-chondrogenesis.py L580–L645" ;
        dcterms:description "5-regime transverse PDE sweep and 2D (W/lambda_c, tau) phase diagram" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1983-oster-mechanochemical-chondrogenesis.py#L580-L645> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Oster, Murray & Harris (1983) / Oster, Murray & Maini (1985) mechanochemical limb chondrogenesis — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates 5 proximo-distal mechanochemical regimes across domain width W/lambda_c and traction tau (subcritical tau=0.85 -> m=0, stylopod W=lambda_c -> m=1, zeugopod W=2*lambda_c -> m=2, forelimb autopod W=4*lambda_c -> m=4, hindlimb autopod W=5*lambda_c -> m=5), maps the 2D (W/lambda_c, tau) phase diagram (Panel D), simulates the 2D limb paddle condensation and ECM displacement vector field (Panel C), and exposes CLI flags (`--tau`, `--mode`, `--seed`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-oster-mechanochemical-chondrogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Oster, Murray & Harris (1983) / Oster, Murray & Maini (1985) mechanochemical limb chondrogenesis — Morphological realism / specimen match: 88/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the CC BY 4.0 urodele salamander (*Oedipina ecuatoriana*, PeerJ 9934 Fig. 13) forelimb and hindlimb skeletal reconstruction (`datasets/mechanochemical_chondrogenesis/salamander_limb_cartilage_specimen.jpg`) and applies morphological opening/closing (`segment_salamander_limb_specimen`, L348-436) to extract the exact [1, 2, 4] forelimb hierarchy (humerus -> ulna+radius -> 4 digits I-IV, spacing 39.00 px, CV = 0.0628, cross-section fit r = 0.8744) and [1, 2, 5] hindlimb hierarchy (femur -> tibia+fibula -> 5 digits I-V, spacing 41.50 px, zeugopod spacing 55.0 px)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-specimen-match-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1983-oster-mechanochemical-chondrogenesis.py L348–L436" ;
        dcterms:description "Morphological segmentation of forelimb [1, 2, 4] and hindlimb [1, 2, 5] skeletal hierarchies on salamander_limb_cartilage_specimen.jpg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1983-oster-mechanochemical-chondrogenesis.py#L348-L436> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/mechanochemical_chondrogenesis_comparison.png (generated output)" ;
        dcterms:description "6-panel synthesis figure comparing dispersion, 1D/2D PDE condensations, phase diagram, and salamander forelimb/hindlimb segmentation — docs/media/mechanochemical_chondrogenesis_comparison.png: rendered output of 1983-oster-mechanochemical-chondrogenesis.py at 317bc3c, image/png, 788718 B, 2352×1400 px, artifact_sha256 cae9696ef2245adac8562044612d7f3410d85abb23870b25f25efdbd2d1f2185 (sha256 cae9696ef2245adac8562044612d7f3410d85abb23870b25f25efdbd2d1f2185), spec_fingerprint 909c74c2382cbfcf862f8ea9a8529469edfc30728d6d46f34f2904fe31ee564f" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


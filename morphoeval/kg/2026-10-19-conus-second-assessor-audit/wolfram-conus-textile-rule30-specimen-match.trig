        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-conus-second-assessor-audit-wolfram-conus-textile-rule30-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Wolfram (1984) Rule 30 & Meinhardt–Klingler (1987) Conus textile Pigmentation — Morphological realism / specimen match: 35/100" ;
        rdfs:comment "I viewed both cached photographs and all rendered outputs side by side. Real Conus textile shows thin dark reticulated lines bounding large white tents at fine scale over a smooth cone; the rendered Rule 30 kymograph (random initial row, 50 percent density, one cell = 2 px) reads as binary noise, and the 3D Rule 30 shell carries a 90x54 block texture that looks like a checkerboard rather than tents; the Meinhardt kymograph shows a few horizontal bands and sparse V shapes on blank cream and the Meinhardt shell is almost uniformly cream in both the PNG and GIF. Pigment fraction 0.50 (Rule 30) vs 0.355 (specimen) is tabulated but never addressed. Credit is given for the shell outline: the biconical mesh is recognisably a cone shell and its silhouette IoU of 0.835 against the fixture outline is a genuine quantitative overlap (deduction 10 for a visibly wider shoulder and spire than the specimen in panel C). The photographs themselves are only hashed, never displayed or analysed, so no figure places the model next to a real specimen (deduction 20); pigment-pattern realism is poor at the rendered resolution (deduction 35). Rule 30 and the Meinhardt output are visually distinct from each other, which is the one criterion fully met. Evidence: conus_textile_rule30_comparison.png (generated output, not in repo): Panel D Rule 30 looks like 50 percent binary noise; panel E Meinhardt shell nearly uniform cream; panel C overlays fixture silhouette, not the photo — conus_textile_rule30_comparison.png: rendered output of 1984-wolfram-conus-textile-rule30.py at fb234bc, image/png, 611089 B, 2640×1632 px, artifact_sha256 b204b836cd08e75a085169a5eb32b8069015a423668ea8a4963f251c1d130e41 (sha256 b204b836cd08e75a085169a5eb32b8069015a423668ea8a4963f251c1d130e41), spec_fingerprint 6baf9ffa515c0c89775df3b58f398571f7894e64d20534778dff610ad08bc313; conus_textile_rule30.gif (generated output, not in repo): Rule 30 shell is a coarse 90x54 block checkerboard; Meinhardt shell shows no tent network — conus_textile_rule30.gif: rendered output of 1984-wolfram-conus-textile-rule30.py at fb234bc, image/gif, 590905 B, 640×340 px, 36 frames, artifact_sha256 0f2462a3e14406d8ddf81072352b1e8758745c1f6d12875567de4f17ce8a1bc1 (sha256 0f2462a3e14406d8ddf81072352b1e8758745c1f6d12875567de4f17ce8a1bc1), spec_fingerprint 6baf9ffa515c0c89775df3b58f398571f7894e64d20534778dff610ad08bc313; .conus_cache/conus_textile_stjohn_ccby2.jpg (generated output, not in repo): Real specimen: thin brown lines enclosing large white tents, ~35 percent pigment; never rendered beside the model — .conus_cache/conus_textile_stjohn_ccby2.jpg: rendered output of 1984-wolfram-conus-textile-rule30.py at fb234bc, image/jpeg, 101322 B, 500×897 px, artifact_sha256 53409ef2518c010613002d68f48f27d236ed22f924d13391d082fab804fcf3c4 (sha256 53409ef2518c010613002d68f48f27d236ed22f924d13391d082fab804fcf3c4), spec_fingerprint 6baf9ffa515c0c89775df3b58f398571f7894e64d20534778dff610ad08bc313; 1984-wolfram-conus-textile-rule30.py L1095–L1124: Panel E maps only r30_grid[:90,:54] and mein_kymo[:180,:110] onto 5.5 whorls, so each CA row spans ~22 degrees of coiling <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L1095-L1124>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-wolfram-conus-textile-rule30-specimen-match> ;
        pk:hasProbability "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-wolfram-conus-textile-rule30-specimen-match> rdfs:label "Wolfram (1984) Rule 30 & Meinhardt–Klingler (1987) Conus textile Pigmentation (1984-wolfram-conus-textile-rule30.py, docs/media/conus_textile_rule30.gif, docs/media/conus_rule30_kymograph_defect_fronts.png, conus_textile_rule30_metrics.csv, conus_rule30_defect_fronts.csv) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Conus textile Linnaeus, 1758 (textile cone snail)" ;
        dct:identifier "morphoeval/0.1.0/specimen-match" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent, blinded second assessor)" .
}


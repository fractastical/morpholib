sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolfram-conus-textile-rule30> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolfram-conus-textile-rule30-repro-package-second-assessor-claude-fable-5-1> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-wolfram-conus-textile-rule30-repro-package-second-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Wolfram (1984) Rule 30 & Meinhardt–Klingler (1987) Conus textile Pigmentation — Reproducibility package: 78/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "requirements.txt gives lower bounds and requirements.lock.txt gives exact pins with Python 3.14.7, platform and date; every RNG is seeded (42, 17, 100+idx) and no wall clock or unseeded randomness is used. I re-ran the script from the worktree in about 35 s and all five artefacts (two CSVs, two PNGs, GIF) were byte-identical to the shipped ones, which is the strongest possible determinism evidence. The fixture is verified at load and the run works offline. Deductions: the README's documented invocation is wrong, since --no-photos and --no-anim do not exist (argparse exits 2) and --self-test only works through argparse prefix abbreviation of --self-test-only (deduction 12). There is no regeneration path for the specimen-derived fixture, so the input side of the package is not reproducible (deduction 6). No test runner or CI hook wraps the self-test, and matplotlib emits cache-directory warnings when HOME is not writable (deduction 4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-repro-package-4> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "requirements.lock.txt L1–L10" ;
        dct:description "Exact pip freeze pins with interpreter version, platform and date" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/requirements.lock.txt#L1-L10> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L1507–L1514" ;
        dct:description "Actual flags are --no-gif/--self-test-only/--download/--frames/--fps; README documents --self-test, --no-photos, --no-anim" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L1507-L1514> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L155–L158" ;
        dct:description "Seeded default_rng throughout; outputs byte-identical on re-run" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L155-L158> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "conus_textile_rule30_comparison.png (generated output)" ;
        dct:description "SHA-256 identical before and after my regeneration — conus_textile_rule30_comparison.png: rendered output of 1984-wolfram-conus-textile-rule30.py at fb234bc, image/png, 611089 B, 2640×1632 px, artifact_sha256 b204b836cd08e75a085169a5eb32b8069015a423668ea8a4963f251c1d130e41 (sha256 b204b836cd08e75a085169a5eb32b8069015a423668ea8a4963f251c1d130e41), spec_fingerprint 6baf9ffa515c0c89775df3b58f398571f7894e64d20534778dff610ad08bc313" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent, blinded second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


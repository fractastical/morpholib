sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolfram-conus-textile-rule30> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolfram-conus-textile-rule30-code-traceability-second-assessor-claude-fable-5-1> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-wolfram-conus-textile-rule30-code-traceability-second-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Wolfram (1984) Rule 30 & Meinhardt–Klingler (1987) Conus textile Pigmentation — Code-to-model traceability: 55/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "The CA section is well traced: every function docstring states the equation it implements and the source (Rule 30 Boolean/ANF, Jen 1990 inverse, diagonal recursion, Boolean Jacobian, prize problems 1-3), and the figure text repeats the identities. The PDE section cites Meinhardt-Klingler 1987 Eq. 5 and Meinhardt 1995 Ch. 5-6 but the implemented equations, variable roles (b as a relaxation divisor) and parameter symbols (rho, rho0, kappa, mu_a, sigma_s, mu_s, mu_b) do not correspond to those sources, and the stochastic injection and clipping steps have no citation at all (deduction 20). The Raup mesh names W, D, T, S but the envelope constants and the T*rc translation have no equation or figure reference (deduction 10). The lesion experiment cites M&K 1987 Fig. 12, but the cell-sorting and bioelectric panels cite papers by name only and hard-code the 0.583 threshold and a 0.36 factor that the labels call 0.40 (deduction 10). Two figure labels are hard-coded strings rather than computed values (deduction 5)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-code-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-code-traceability-4> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L24–L40" ;
        dct:description "Module docstring lists equations per model; PDE form here differs from what the code integrates (no b-division, no injection)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L24-L40> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L627–L641" ;
        dct:description "PDE cites Eq. 5 / Ch. 5-6 but uses unsourced parameter symbols and values" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L627-L641> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L595–L595" ;
        dct:description "D2_blocked = 0.36*D1 while CSV law string (line 1272) and panel F label (line 1495) say 0.40" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L595-L595> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-code-traceability-4> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L1426–L1427" ;
        dct:description "Hard-coded 'v_L=-0.26, v_R=+1' label instead of measured values" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L1426-L1427> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent, blinded second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


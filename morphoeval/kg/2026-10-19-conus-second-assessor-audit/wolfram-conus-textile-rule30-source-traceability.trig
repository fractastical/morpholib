}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolfram-conus-textile-rule30> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolfram-conus-textile-rule30-source-traceability-second-assessor-claude-fable-5-1> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-wolfram-conus-textile-rule30-source-traceability-second-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Wolfram (1984) Rule 30 & Meinhardt–Klingler (1987) Conus textile Pigmentation — Source and data traceability: 70/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "All seven primary papers carry journal, volume, pages and DOI in both the module docstring and datasets/conus/paper_citations.bib, and the Rule 30 prize URL and OEIS id are given. Input provenance is strong where it exists: the fixture JSON is SHA-256 pinned and verified on every run, both photographs have Wikimedia URL, author, licence, byte count and SHA-256 which are checked on --download, and I confirmed all three digests match the files on disk. Deductions: the specimen-derived content of the fixture (silhouette row bounds, 148x92 tent lattice, 1814 chord runs) has no generating code or method description anywhere in the worktree, so the chain from photograph to number is broken and the lattice and chord list are mutually inconsistent (deduction 15). The Wolfram 1986 DOI in the script and bib (…90029-1) differs from the one in the README (…90028-X), and the Meinhardt 1995 DOI likewise (…03125-4 vs …03107-0); at least one of each pair is wrong and I could not resolve them from the sandbox (deduction 8). Zhang 2025, Cervera 2021 and the PlanformDB threshold 0.583 are invoked in code without any identifier in this script or fixture (deduction 7)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-source-traceability-4> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L70–L98" ;
        dct:description "Fixture SHA-256 pinned and verified at load; matches on-disk digest dfcb500d…" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L70-L98> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L101–L122" ;
        dct:description "Photos downloaded with URL from fixture and SHA-256 verified; both cache files match" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L101-L122> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/conus/paper_citations.bib L12–L21" ;
        dct:description "Wolfram 1986 DOI 10.1016/0196-8858(86)90029-1 disagrees with README's 90028-X" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/datasets/conus/paper_citations.bib#L12-L21> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L125–L134" ;
        dct:description "Specimen masks unpacked from vendored fixture; no segmentation code exists to regenerate them" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L125-L134> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent, blinded second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolfram-conus-textile-rule30> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity-second-assessor-claude-fable-5-1> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity-second-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Wolfram (1984) Rule 30 & Meinhardt–Klingler (1987) Conus textile Pigmentation — Parameter expressivity: 18/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "No morphospace parameter is swept or exposed. raup_conus_mesh is called once with the defaults W=1.28, D=0.42, T=0.36, S=5.99 and the PDE constants are hard-coded inside run_meinhardt_conus; the only CLI knobs are --frames and --fps. I probed the mesh myself: W 1.28 to 1.5 moves H/W 1.834 to 1.912 and S 5.99 to 3.0 moves it to 0.919, so W, D and S do act, but T=0.0 and T=0.36 yield identical H/W 1.8342 and IoU within 0.0005, meaning the translation parameter does not control spire height in the range used (deduction 25). The absence of any sweep, montage or figure demonstrating monotonic control of form costs a further 45; the Rule 90 control and the seed/k scans in the defect-front figure are diagnostics, not morphospace exploration, and earn only partial credit. Twelve further points are withheld because the PDE regime cannot be varied without editing source." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity-4> ;
        pk:hasScore "0.18"^^xsd:double ;
        pk:hasVerdict "not faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L668–L676" ;
        dct:description "Single hard-coded Raup parameter set; never varied anywhere in the script" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L668-L676> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L637–L641" ;
        dct:description "PDE constants hard-coded with no CLI or sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L637-L641> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L1507–L1514" ;
        dct:description "CLI exposes only --no-gif, --self-test-only, --download, --frames, --fps" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L1507-L1514> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "1984-wolfram-conus-textile-rule30.py L688–L703" ;
        dct:description "zc = T*rc is dwarfed by b*axial_ext; T in [0, 0.36] has zero silhouette effect (verified numerically)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L688-L703> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent, blinded second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


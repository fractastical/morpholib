sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-conus-second-assessor-audit-wolfram-conus-textile-rule30-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Wolfram (1984) Rule 30 & Meinhardt–Klingler (1987) Conus textile Pigmentation — Parameter expressivity: 18/100" ;
        rdfs:comment "No morphospace parameter is swept or exposed. raup_conus_mesh is called once with the defaults W=1.28, D=0.42, T=0.36, S=5.99 and the PDE constants are hard-coded inside run_meinhardt_conus; the only CLI knobs are --frames and --fps. I probed the mesh myself: W 1.28 to 1.5 moves H/W 1.834 to 1.912 and S 5.99 to 3.0 moves it to 0.919, so W, D and S do act, but T=0.0 and T=0.36 yield identical H/W 1.8342 and IoU within 0.0005, meaning the translation parameter does not control spire height in the range used (deduction 25). The absence of any sweep, montage or figure demonstrating monotonic control of form costs a further 45; the Rule 90 control and the seed/k scans in the defect-front figure are diagnostics, not morphospace exploration, and earn only partial credit. Twelve further points are withheld because the PDE regime cannot be varied without editing source. Evidence: 1984-wolfram-conus-textile-rule30.py L668–L676: Single hard-coded Raup parameter set; never varied anywhere in the script <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L668-L676>; 1984-wolfram-conus-textile-rule30.py L637–L641: PDE constants hard-coded with no CLI or sweep <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L637-L641>; 1984-wolfram-conus-textile-rule30.py L1507–L1514: CLI exposes only --no-gif, --self-test-only, --download, --frames, --fps <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L1507-L1514>; 1984-wolfram-conus-textile-rule30.py L688–L703: zc = T*rc is dwarfed by b*axial_ext; T in [0, 0.36] has zero silhouette effect (verified numerically) <https://github.com/fractastical/morpholib/blob/fb234bc/1984-wolfram-conus-textile-rule30.py#L688-L703>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity> ;
        pk:hasProbability "0.18"^^xsd:double ;
        pk:hasVerdict "not faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-wolfram-conus-textile-rule30-parameter-expressivity> rdfs:label "Wolfram (1984) Rule 30 & Meinhardt–Klingler (1987) Conus textile Pigmentation (1984-wolfram-conus-textile-rule30.py, docs/media/conus_textile_rule30.gif, docs/media/conus_rule30_kymograph_defect_fronts.png, conus_textile_rule30_metrics.csv, conus_rule30_defect_fronts.csv) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Conus textile Linnaeus, 1758 (textile cone snail)" ;
        dct:identifier "morphoeval/0.1.0/parameter-expressivity" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent, blinded second assessor)" .
}


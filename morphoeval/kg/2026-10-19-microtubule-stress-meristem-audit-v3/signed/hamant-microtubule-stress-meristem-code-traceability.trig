sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hamant-microtubule-stress-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hamant-microtubule-stress-meristem-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-microtubule-stress-meristem.py L1–L86" ;
        dcterms:description "Laws 1-5 with equations, Lean loci (#L30-65, #L81-115, #L132-167, #L165-226, #L230-268) and implementing functions; honest scope note" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-microtubule-stress-meristem.py#L1-L86> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-microtubule-stress-meristem.py L1034–L1044" ;
        dcterms:description "Coupling-chain docstring of simulate_l1_vertex_patch" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-microtubule-stress-meristem.py#L1034-L1044> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/hamant-microtubule-stress-meristem.yaml L110–L155" ;
        dcterms:description "Laws 4-5 registered with lean_code, variables, role, source citation and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/hamant-microtubule-stress-meristem.yaml#L110-L155> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hamant-microtubule-stress-meristem-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Hamant et al. (2008), Bozorg et al. (2014), Sampathkumar et al. (2014), Uyttewaal et al. (2012), Heisler et al. (2010) & Louveaux et al. (2016) shoot apical meristem shell stress tensor, stress-vs-strain CMT alignment, katanin boundary morphogenesis and PIN1/CMT co-alignment on a growing L1 cellular vertex mesh — Code-to-model traceability: 76/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the module docstring (L1-86) maps Laws 1-5 to equations, papers and Lean theorem line ranges and names the implementing functions; `simulate_l1_vertex_patch` carries an explicit coupling-chain docstring (L1034-1044) and each mesh method states its source rule (Batchelor virial, Heisler softmax, Louveaux division, Hamant & Traas on T1); the honest-scope note names the 2D reduction and the phenomenological sections. Deductions: the sweep constants 1.45, 0.68, 0.806, 15.95, 13.45 (L413-416) and the ring dispersions 0.245 / 0.62 / 0.81 (L391-394) have no citation (-8); `build_2d_meristem_fem_field` is still named and titled 'FEM' in Panel A although the docstring now says it is analytic (-6); the mesh constants (k_wall = 6, K_A = 0.9, beta_pin = 4, phi_wall = 0.45, E_shell = 400 MPa) are documented in the JSON but not derived from any paper value (-6); the softmax PIN1 rule is a modelling choice attributed to Heisler's hypothesis rather than an equation in the paper (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2008-hamant-microtubule-stress-meristem.py L413–L416: Uncited fitted exponents and offsets in the 5-condition sweep <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-microtubule-stress-meristem.py#L413-L416>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-code-traceability-3> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 036 Pass 3 builder + primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


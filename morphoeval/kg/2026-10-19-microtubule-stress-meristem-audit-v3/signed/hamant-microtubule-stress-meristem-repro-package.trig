sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hamant-microtubule-stress-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hamant-microtubule-stress-meristem-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hamant-microtubule-stress-meristem-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Hamant et al. (2008), Bozorg et al. (2014), Sampathkumar et al. (2014), Uyttewaal et al. (2012), Heisler et al. (2010) & Louveaux et al. (2016) shoot apical meristem shell stress tensor, stress-vs-strain CMT alignment, katanin boundary morphogenesis and PIN1/CMT co-alignment on a growing L1 cellular vertex mesh — Reproducibility package: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: two fresh default runs produce a byte-identical PNG (SHA-256 f04ae6be…); all randomness is seeded (ring rng 2008036, mesh rng 2010036) and the Voronoi / division ordering is deterministic; `--self-test` runs 14 checks in ~3.2 s and the full render in ~4 s (well under the 3-minute budget); the five dataset hashes are verified fail-closed; the environment is recorded above; `--self-test` now returns without re-rendering and `--verify-only` behaves identically. Deductions: no requirements lock file is vendored for this slot (versions are only recorded in the audit) (-6); the self-test's new thresholds (e.g. co-alignment > 0.70, away-fraction >= 0.66) are set just below the observed values and would not survive a different seed — determinism is asserted, robustness is not (-5); matplotlib emits a font-cache warning when the home directory is not writable (sandbox) and the script does not set MPLCONFIGDIR (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-repro-package-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-microtubule-stress-meristem.py L1901–L1990" ;
        dcterms:description "14-check deterministic self-test: 8 legacy + Euler/division, T1 unit flip, Law 4 co-alignment, katanin monotonicity, ablation PIN1/CMT with oryzalin controls, Louveaux vs Errera" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-microtubule-stress-meristem.py#L1901-L1990> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-microtubule-stress-meristem.py L1993–L2032" ;
        dcterms:description "CLI with --self-test / --verify-only returning before rendering; `rendered` list printed after the default run" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-microtubule-stress-meristem.py#L1993-L2032> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-microtubule-stress-meristem.py L1228–L1265" ;
        dcterms:description "verify_t1_transition_topology: deterministic unit check of the T1 flip (neighbour swap + V,E,F,chi unchanged)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-microtubule-stress-meristem.py#L1228-L1265> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 036 Pass 3 builder + primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hamant-microtubule-stress-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hamant-microtubule-stress-meristem-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-microtubule-stress-meristem.py L1159–L1225" ;
        dcterms:description "VERTEX_SCENARIOS (9 scenarios over zone x gamma x cue x ablation) and the suite's katanin sweep / zone comparison" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-microtubule-stress-meristem.py#L1159-L1225> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-microtubule-stress-meristem.py L1993–L2032" ;
        dcterms:description "CLI: --vertex-scenario, --vertex-steps, --n-rings, --enable-t1; --turgor-mpa/--gamma-mt/--wall-thickness-um now applied to the zone solver (L2019-2021) — in v2 these three were parsed and unused" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-microtubule-stress-meristem.py#L1993-L2032> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hamant-microtubule-stress-meristem-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Hamant et al. (2008), Bozorg et al. (2014), Sampathkumar et al. (2014), Uyttewaal et al. (2012), Heisler et al. (2010) & Louveaux et al. (2016) shoot apical meristem shell stress tensor, stress-vs-strain CMT alignment, katanin boundary morphogenesis and PIN1/CMT co-alignment on a growing L1 cellular vertex mesh — Parameter expressivity: 72/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: on the mesh, gamma_MT controls S monotonically (0 -> 0.147 -> 0.57 for 0 / 0.45 / 2.4, r = 0.995 vs the 3 reference points), the zone stress tensor controls global CMT alignment (saddle 0.84 vs dome 0.56 cos^2 with the x-axis), the cue type switches between stress and strain tensors, ablation flips the ring to circumferential, and `--vertex-scenario / --vertex-steps / --n-rings / --enable-t1` expose the scenario, duration, mesh size and T1 switch (L2002-2006); the previously dead `--turgor-mpa / --gamma-mt / --wall-thickness-um` flags now reach the zone solver (L2019-2021). Deductions: the vertex-mesh constants that matter most (E_shell, k_wall, K_A, beta_pin, phi_wall, kappa_cmt) are not CLI-exposed and no sweep over them is rendered (-10); the strain-cue switch does not produce a visibly different morphology (S 0.49 vs 0.57, same alignment) so that parameter fails the 'visibly controls the feature' test on the mesh (-8); the zone-level and sweep-level parameters of sections 2-3 act through fitted closed forms rather than the model (-6); `--gamma-mt` changes only the zone solver printout and not the rendered figure or the mesh suite (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2008-hamant-microtubule-stress-meristem.py L519–L530: Mesh constants P_turgor, k_wall, K_A, kappa_cmt, D_theta are constructor defaults with no CLI path <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-microtubule-stress-meristem.py#L519-L530>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-parameter-expressivity-2> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 036 Pass 3 builder + primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


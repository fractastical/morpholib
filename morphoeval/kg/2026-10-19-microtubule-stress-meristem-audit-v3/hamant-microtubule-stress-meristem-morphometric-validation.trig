        schema:value "0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-heisler-2010-fraction-of-wound-ring-cells-with-pin1-polarity-directed-away-from-the-ablated-cell-wt-vs-oryzalin> a schema:PropertyValue,

        schema:value "0.747" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-heisler-2010-pin1-rich-wall-axis-vs-cmt-director-co-alignment-cos-2-on-the-growing-saddle-boundary-l1-vertex-mesh-wt-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-heisler-2010-pin1-rich-wall-axis-vs-cmt-director-co-alignment-cos-2-on-the-growing-saddle-boundary-l1-vertex-mesh-wt-reference> a schema:PropertyValue ;
        schema:value "0.75" .

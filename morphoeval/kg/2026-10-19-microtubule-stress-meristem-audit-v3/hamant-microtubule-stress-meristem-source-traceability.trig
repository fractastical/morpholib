sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hamant-microtubule-stress-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hamant-microtubule-stress-meristem-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hamant-microtubule-stress-meristem-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Hamant et al. (2008), Bozorg et al. (2014), Sampathkumar et al. (2014), Uyttewaal et al. (2012), Heisler et al. (2010) & Louveaux et al. (2016) shoot apical meristem shell stress tensor, stress-vs-strain CMT alignment, katanin boundary morphogenesis and PIN1/CMT co-alignment on a growing L1 cellular vertex mesh — Source and data traceability: 84/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: seven primary sources with DOIs in the module docstring, dataset README and bib (Heisler 2010, Louveaux 2016 and Hamant & Traas 2010 added in Pass 3); five dataset files SHA-256-pinned and verified fail-closed at every run (`EXPECTED_SHA256` L109-117, `verify_dataset_integrity` L122-136), including the new `pin1_cmt_coalignment_reference.json` which records every mesh parameter and the provenance kind of each reference threshold; the specimen's Wikimedia title, URL, licence and hash are recorded. Deductions: the figure numbers cited for Heisler 2010 (Figs. 2-6) and Louveaux 2016 (Figs. 2-4) were assigned from the assessor's recollection of the papers and not verified against the PDFs (-8); the zone reference S values (0.082, 0.395, 0.812, 0.568) and crease depths in the Pass 2 JSON have no figure/table pinpoint in the source papers (-6); the bib hash changed in Pass 3 and the README records both hashes, but the scout manifest still lists only four candidate papers (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/microtubule_stress_meristem/pin1_cmt_coalignment_reference.json L70–L118: reference_kind marks thresholds as ordinal / qualitative; figure numbers unverified against PDFs <https://github.com/fractastical/morpholib/blob/d58a084/datasets/microtubule_stress_meristem/pin1_cmt_coalignment_reference.json#L70-L118>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-source-traceability-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-microtubule-stress-meristem.py L109–L136" ;
        dct:description "Five SHA-256 pins (bib re-pinned after Pass 3 append) and fail-closed verification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-microtubule-stress-meristem.py#L109-L136> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/microtubule_stress_meristem/paper_citations.bib L47–L79" ;
        dct:description "Heisler 2010, Louveaux 2016, Hamant & Traas 2010 BibTeX entries with DOIs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/microtubule_stress_meristem/paper_citations.bib#L47-L79> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/microtubule_stress_meristem/README.md L12–L30" ;
        dct:description "Pass 3 references, file hashes (old and new bib hash), threshold provenance statement and honest scope note" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/microtubule_stress_meristem/README.md#L12-L30> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 036 Pass 3 builder + primary assessor)" ;
        dct:identifier "claude-fable-5-1" ;

    pk1:evidenceAgainst "datasets/microtubule_stress_meristem/pin1_cmt_coalignment_reference.json L70–L118: reference_kind marks thresholds as ordinal / qualitative; figure numbers unverified against PDFs <https://github.com/fractastical/morpholib/blob/d58a084/datasets/microtubule_stress_meristem/pin1_cmt_coalignment_reference.json#L70-L118>" ;

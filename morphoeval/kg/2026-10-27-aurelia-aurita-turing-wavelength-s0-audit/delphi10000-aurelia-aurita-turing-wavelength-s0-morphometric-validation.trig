sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at the Aurelia aurita 201 µm ocellus scale — Morphometric validation: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion fit: Pearson r = 0.9999, RMSE = 0.017, KS = 0.167 against a zero-discrepancy reference. Patch FFT wavelength 0.0002027 m versus assigned 0.0002006 m. Specimen foreground fraction 0.437, coherency 0.345 versus 0.849 on the spot field, bell circularity 0.328 versus a circle at 1. Those specimen numbers are measured, and the bell mask is a poor description of the round oral view (circularity 0.33). The lobe counter returned 5. Its reference was set to 8 rather than to the four gonads, which avoids a self-comparison but compares the wrong integer." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-dispersion-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-dv-sweep-wavelength-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-equal-diffusion-control-final-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-most-unstable-wavenumber-from-the-pde>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-ocellus-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-specimen-contour-gonad-lobes>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-specimen-image-bell-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-specimen-image-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-specimen-image-structure-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-spot-diameter-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-dispersion-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion KS statistic = 0.1667 KS distance" ;
        dct:description "Curve discrepancy, not a calibrated p-value" ;
        schema:measurementTechnique "scipy.stats.ks_2samp on analytical versus PDE-measured σ(k)" ;
        schema:name "dispersion KS statistic" ;
        schema:unitText "KS distance" ;
        schema:value "0.1667" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion pearson r = 0.9999 correlation" ;
        dct:description "RMSE=0.0172; KS statistic=0.1667" ;
        schema:measurementTechnique "Eigenvector-seeded 1D PDE growth versus analytical σ(k) at 18 wavenumbers" ;
        schema:name "dispersion pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-dv-sweep-wavelength-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Dv-sweep wavelength pearson r = 0.9978 correlation" ;
        dct:description "Grid quantization keeps this below the 1D dispersion correlation" ;
        schema:measurementTechnique "Predicted λ(Dv) versus FFT λ(Dv) at Dv in {12,16,20,28,36,48}" ;
        schema:name "Dv-sweep wavelength pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.9978" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-dv-sweep-wavelength-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-dv-sweep-wavelength-pearson-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-equal-diffusion-control-final-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control final std = 3e-05 concentration" ;
        dct:description "σ_max under equal diffusion = -0.1025" ;
        schema:measurementTechnique "Same integrator with Du=Dv=1" ;
        schema:name "equal-diffusion control final std" ;
        schema:unitText "concentration" ;
        schema:value "3e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-equal-diffusion-control-final-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-equal-diffusion-control-final-std-reference> a schema:PropertyValue ;
        schema:value "0.79292" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-most-unstable-wavenumber-from-the-pde> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "most unstable wavenumber from the PDE = 0.4853 hat wavenumber" ;
        dct:description "The small shift is reported rather than forced to zero" ;
        schema:measurementTechnique "argmax of measured σ(k)" ;
        schema:name "most unstable wavenumber from the PDE" ;
        schema:unitText "hat wavenumber" ;
        schema:value "0.4853" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-most-unstable-wavenumber-from-the-pde-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-most-unstable-wavenumber-from-the-pde-reference> a schema:PropertyValue ;
        schema:value "0.4729" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-ocellus-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ocellus stripe wavelength = 0.0002027 m" ;
        dct:description "predicted λ_m at Dv=20 is 0.0002006 m by construction of ell" ;
        schema:measurementTechnique "Parabolic-refined radial FFT peak of the final activator, times ell" ;
        schema:name "ocellus stripe wavelength" ;
        schema:unitText "m" ;
        schema:value "0.0002027" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-ocellus-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-ocellus-stripe-wavelength-reference> a schema:PropertyValue ;
        schema:value "0.0002006" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-specimen-contour-gonad-lobes> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen contour gonad lobes = 5 count" ;
        dct:description "value is the lobe count, reference is 8 rhopalia, so the metric is not self-identical" ;
        schema:measurementTechnique "Bright lobes in an annular window of the upper-right oral bell" ;
        schema:name "specimen contour gonad lobes" ;
        schema:unitText "count" ;
        schema:value "5" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-specimen-contour-gonad-lobes-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-specimen-contour-gonad-lobes-reference> a schema:PropertyValue ;
        schema:value "8" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-specimen-image-bell-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image bell circularity = 0.3282 4πA/P^2" ;
        dct:description "Non-circular specimen metric" ;
        schema:measurementTechnique "Largest component in the upper-right oral-bell crop of the Karlsruhe photograph" ;
        schema:name "specimen image bell circularity" ;
        schema:unitText "4πA/P^2" ;
        schema:value "0.3282" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-specimen-image-bell-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-specimen-image-bell-circularity-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-specimen-image-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image foreground fraction = 0.4368 fraction" ;
        dct:description "Measured on the photograph, not copied from the simulation" ;
        schema:measurementTechnique "Border-median contrast mask on the full CC0 photograph" ;
        schema:name "specimen image foreground fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.4368" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> a schema:PropertyValue ;

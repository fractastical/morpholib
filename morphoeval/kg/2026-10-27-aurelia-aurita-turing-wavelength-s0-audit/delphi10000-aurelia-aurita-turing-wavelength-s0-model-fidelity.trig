sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at the Aurelia aurita 201 µm ocellus scale — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The script uses Schnakenberg's kinetics, the steady state, the Jacobian, and sigma(k) as the larger eigenvalue of J - k^2 D. k_c = (det/(Du Dv))^1/4 is the band-center formula; the measured argmax of sigma sits at 0.485 against k_c = 0.473, and that shift is reported. Parameters are a calibration to 0.0002006 m, not numbers from a Schnakenberg table for Aurelia. Five Lean theorems check the scaled discriminant, the equal-diffusion failure, and the 201 µm label identity, with no sorry." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py L69–L111" ;
        dct:description "Jacobian, Turing discriminant, and sigma(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py#L69-L111> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3129_aurelia_aurita_turing_wavelength_s0.lean L22–L41" ;
        dct:description "trace, det, Turing instability, equal-diffusion suppression" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3129_aurelia_aurita_turing_wavelength_s0.lean#L22-L41> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "datasets/aurelia_aurita_turing_wavelength_s0/aurelia_aurita_turing_wavelength_s0_reference.json (generated output)" ;
        dct:description "states that 201 µm is an assigned scale — datasets/aurelia_aurita_turing_wavelength_s0/aurelia_aurita_turing_wavelength_s0_reference.json: rendered output of models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, application/json, 5079 B, artifact_sha256 dad34a0a6b9d9a5409d32ab50d7a1308130e7d2b02b2f9a53ca9f52308b1554b (sha256 dad34a0a6b9d9a5409d32ab50d7a1308130e7d2b02b2f9a53ca9f52308b1554b), spec_fingerprint 466a72b70c6deefab849cdaf54ef8ca2bbac24e0ab13e981975c600a6c11b298" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent pass 1)" ;
        dct:identifier "grok-4.7" ;

    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aurelia-aurita-turing-wavelength-s0-source-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg Turing wavelength at the Aurelia aurita 201 µm ocellus scale — Source and data traceability: 90/100" ;

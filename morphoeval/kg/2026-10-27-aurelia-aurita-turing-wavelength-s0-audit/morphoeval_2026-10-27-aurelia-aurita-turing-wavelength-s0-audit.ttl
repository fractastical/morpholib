<https://w3id.org/delphi/resource/math-law/delphi10000-aurelia-aurita-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg Jacobian trace and determinant" ;
    dct:description "Uniform rhopalial ectoderm is stable in the absence of diffusion | Variables: f_u=0.8, f_v=1, g_u=-1.8, g_v=-1, cleared to tenths" ;
    dct:source "Schnakenberg 1979 doi:10.1016/0022-5193(79)90042-0; Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3129_aurelia_aurita_turing_wavelength_s0.lean#L14-L23> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "tr J = f_u + g_v = -0.2 < 0 and det J = f_u g_v - f_v g_u = 1 > 0 at (a,b,gamma)=(0.10,0.90,1)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s00427-009-0291-y>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/brv.12393> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3129.traceScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3129.homogeneous_state_is_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-aurelia-aurita-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber at the 201 µm Holocene node" ;
    dct:description "Selects the ocellus-detail wavelength and no other chronospecies in this 1-node series | Variables: D_u=1, D_v=20, detScaled=100; discriminant 22500 > 8000" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3129_aurelia_aurita_turing_wavelength_s0.lean#L25-L29> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c = (det J / (D_u D_v))^(1/4), lambda_c = 2*pi/k_c, lambda_c * ell = 0.0002006 m" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s00427-009-0291-y>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/brv.12393> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3129.detScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3129.turing_wavenumber_is_unstable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-aurelia-aurita-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation at 0 Ma" ;
    dct:description "Negative control. The predecessor/successor chronospecies do not exist; this is the within-node comparison. | Variables: Same Jacobian, D_v reset from 20 to 1" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3129_aurelia_aurita_turing_wavelength_s0.lean#L31-L35> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_u = D_v = 1 fails (D_v f_u + D_u g_v)^2 > 4 D_u D_v det J" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s00427-009-0291-y>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/brv.12393> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3129.detScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3129.equal_diffusion_suppresses_the_mode" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-aurelia-aurita-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Eight rhopalia are not the 201 µm mode count" ;
    dct:description "Stops the detail-scale wavelength from being read as the spacing of the eight rhopalia | Variables: anatomical count versus micrometre label" ;
    dct:source "Nakanishi, Hartenstein & Jacobs 2009 doi:10.1007/s00427-009-0291-y; Helm 2018 doi:10.1111/brv.12393" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aurelia-aurita-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3129_aurelia_aurita_turing_wavelength_s0.lean#L48-L51> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "n_rhopalia = 8, distinct from the tier label 201" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s00427-009-0291-y>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/brv.12393> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3129.eight_rhopalia" ;
    pk:leanTheorem "MathOfBiology.Loop_3129.eight_rhopalia" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-aurelia-aurita-turing-wavelength-s0-1>,

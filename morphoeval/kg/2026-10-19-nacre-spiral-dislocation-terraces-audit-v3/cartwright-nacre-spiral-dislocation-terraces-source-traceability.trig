sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-spiral-dislocation-terraces> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007) & Cartwright et al. (2009) nacre screw-dislocation spirals, Frank-Read target terraces, defect pair annihilation, chitin-membrane perforation bridges and aragonite twin polygonization — Source and data traceability: 85/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Six dataset files are SHA-256 pinned and verified fail-closed at every run (`EXPECTED_SHA256` L126-146; `verify_dataset_integrity` L160-172), including the new `membrane_perforation_twinning_reference.json` and `pass3_citations.bib` (De Villiers 1971, Schäffer 1997 doi 10.1021/cm960429i, Checa 2011 doi 10.1016/j.jsb.2011.09.011); the four v2 DOIs are unchanged and the dataset README documents the Pass 3 additions and caveats (README L12-20). Deductions: the 12-species observation table (JSON L78-89) has no resolvable source for its lambda_obs/omega_obs values and is now labelled illustrative rather than replaced (-6); the SEM specimen has no scale bar and the calibration is self-referential (JSON L38-44) (-3); the three new DOIs/URL were entered offline and could not be verified in this loop (-2); the slot dispatch record and the Pass 3 prompt carry a foraminifera/Berger (1969) identity that does not match the script, dataset or Lean module, so the campaign-level provenance of this slot is inconsistent (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/nacre_spiral_dislocation_terraces/nacre_spiral_dislocation_terraces_reference.json L78–L89: 12-species table: observation columns not traceable to any cited measured table <https://github.com/fractastical/morpholib/blob/e651a8b8/datasets/nacre_spiral_dislocation_terraces/nacre_spiral_dislocation_terraces_reference.json#L78-L89>",
            "morphoeval/cloud/dispatches/slot-073.json L1–L30: slug 'foraminifera-chamber-spiral' vs nacre script/dataset/audits: campaign metadata mismatch <https://github.com/fractastical/morpholib/blob/e651a8b8/morphoeval/cloud/dispatches/slot-073.json#L1-L30>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-source-traceability-3> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L126–L172" ;
        dct:description "SHA-256 registry for 6 dataset files (2 new in Pass 3) and fail-closed runtime verification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2007-cartwright-nacre-spiral-dislocation-terraces.py#L126-L172> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/nacre_spiral_dislocation_terraces/pass3_citations.bib L1–L37" ;
        dct:description "De Villiers 1971, Schäffer et al. 1997 and Checa et al. 2011 BibTeX entries (DOIs entered offline, unverified)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/datasets/nacre_spiral_dislocation_terraces/pass3_citations.bib#L1-L37> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/nacre_spiral_dislocation_terraces/README.md L12–L20" ;
        dct:description "Pass 3 additions and the known-caveats section stating that the 12-species table is illustrative and the SEM calibration anchored" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/datasets/nacre_spiral_dislocation_terraces/README.md#L12-L20> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 re-score from the remediated script, diff and Phase A handoff evidence)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


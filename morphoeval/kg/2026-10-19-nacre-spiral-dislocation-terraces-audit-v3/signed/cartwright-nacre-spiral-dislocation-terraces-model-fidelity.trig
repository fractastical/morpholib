sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-spiral-dislocation-terraces> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L189–L236" ;
        dcterms:description "BCF spiral kinematics and Gibbs-Thomson step velocity as published" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2007-cartwright-nacre-spiral-dislocation-terraces.py#L189-L236> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L298–L357" ;
        dcterms:description "A(theta) anisotropy divides the Cabrera-Levine travel in all three propagating regimes; regime switch is an `if` on d <= 2 r_c at L308 and activity gates only height_um at L344" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2007-cartwright-nacre-spiral-dislocation-terraces.py#L298-L357> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L526–L558" ;
        dcterms:description "Single-domain and {110} cyclic-twin step-speed factor with e_2 from the De Villiers lattice ratio; analytic f_m twin suppression" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2007-cartwright-nacre-spiral-dislocation-terraces.py#L526-L558> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L647–L814" ;
        dcterms:description "Stacked-sheet driven Allen-Cahn perforation: footprint = terrace tier (L736), explicit stability (L712), spinodal S_crit (L713), double-well and drive (L765-766), argmax-early-phi bridge site (L776)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2007-cartwright-nacre-spiral-dislocation-terraces.py#L647-L814> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_073_nacre_spiral_dislocation_terraces.lean L120–L181" ;
        dcterms:description "3 new Lean 4 theorems (twin misfit, pitch linear in step speed, double-well bistability) added to the 4 Pass 2 theorems; 0 sorry, lean exits 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/morphoeval/lean/loops/Loop_073_nacre_spiral_dislocation_terraces.lean#L120-L181> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 re-score from the remediated script, diff and Phase A handoff evidence)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007) & Cartwright et al. (2009) nacre screw-dislocation spirals, Frank-Read target terraces, defect pair annihilation, chitin-membrane perforation bridges and aragonite twin polygonization — Model fidelity to source: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Gibbs-Thomson v(r) = v_inf (1 - r_c / r) and the BCF/Cabrera-Levine spiral kinematics are the source's (`compute_bcf_spiral_kinematics`, L189-222; `gibbs_thomson_step_velocity`, L224-236), and the Pass 3 additions are genuine model components: a driven Allen-Cahn perforation field with the correct double-well derivative and spinodal threshold S_crit = S_0 + 1/(3 beta) (L713, L765-767), a footprint slaved to the eikonal terrace tier (L736), and a direction-dependent step speed with crystallographic e_2 and a three-domain twin average (L545-552) entering every regime's travel function (L319-321, L338-340, L354-356). Deductions: the terrace fields are closed-form Cabrera-Levine phases and the subcritical/supercritical switch is an `if` on d <= 2 r_c (L308), with `activity` only gating the height field (L337, L344) — the docstring's 'eikonal solver' is kinematic, not a propagated front (-5); the gastropod tower lattice in `simulate_nacre_architecture_3d` is a hard-coded template (pitch_tower = 3.6071, tower_spacing = 11.5, hex_mod = 1 + 0.06 cos 6 theta, L497-510), not an output of the eikonal or membrane model (-4); the membrane model is 2D-per-sheet with the bridge site taken as argmax of early phi (L776-777) and tuning choices n_pores >= 1 (L742), eroded-interior seeding (L745) and a fixed A_g ~ 1/sigma^2 bridge budget (L727-728) (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2007-cartwright-nacre-spiral-dislocation-terraces.py L496–L512: Gastropod tower lattice is a hard-coded presentation template (pitch_tower, tower_spacing, hex_mod), not driven by the eikonal or membrane model <https://github.com/fractastical/morpholib/blob/e651a8b8/2007-cartwright-nacre-spiral-dislocation-terraces.py#L496-L512>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity-5> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


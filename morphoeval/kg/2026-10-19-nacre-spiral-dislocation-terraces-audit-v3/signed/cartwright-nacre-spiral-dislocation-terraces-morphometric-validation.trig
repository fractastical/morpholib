sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-spiral-dislocation-terraces> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-12-species-bcf-spiral-terrace-pitch-correlation-cartwright-checa-2007-bcf-1951> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-species BCF spiral terrace pitch correlation (Cartwright & Checa 2007 / BCF 1951) = 0.9999 Pearson r" ;
        dcterms:description "RMSE = 0.0421 um across 3 molluscan classes" ;
        schema:measurementTechnique "Correlation of predicted BCF pitch (2*pi/omega_0)*r_c vs empirical terrace spacing across 12 bivalve, gastropod, and cephalopod species (RMSE=0.0421 um, p=1.60e-20)" ;
        schema:name "12-species BCF spiral terrace pitch correlation (Cartwright & Checa 2007 / BCF 1951)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-12-species-bcf-spiral-terrace-pitch-correlation-cartwright-checa-2007-bcf-1951-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-12-species-bcf-spiral-terrace-pitch-correlation-cartwright-checa-2007-bcf-1951-reference> a schema:PropertyValue ;
        dcterms:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 & Burton, Cabrera & Frank (1951) Phil. Trans. R. Soc. A 243:299-358" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-12-species-spiral-angular-rotation-frequency-correlation-omega-omega-0-v-inf-r-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-species spiral angular rotation frequency correlation omega = omega_0 * v_inf / r_c = 1.0 Pearson r" ;
        dcterms:description "RMSE = 0.0027 rad/hr, p=4.00e-24" ;
        schema:measurementTechnique "Correlation of predicted vs observed spiral angular rotation frequency across 12 nacre species (RMSE=0.0027 rad/hr)" ;
        schema:name "12-species spiral angular rotation frequency correlation omega = omega_0 * v_inf / r_c" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-12-species-spiral-angular-rotation-frequency-correlation-omega-omega-0-v-inf-r-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-12-species-spiral-angular-rotation-frequency-correlation-omega-omega-0-v-inf-r-c-reference> a schema:PropertyValue ;
        dcterms:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 Sec. 2" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-aragonite-110-cyclic-twin-retention-of-6-fold-pseudo-hexagonal-polygonization-f-6-measured-on-anisotropic-eikonal-terrace-ring> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Aragonite {110} cyclic-twin retention of 6-fold pseudo-hexagonal polygonization f_6 (measured on anisotropic eikonal terrace ring) = 0.9474 ratio (twinned / single-domain 2|c_6|/c_0)" ;
        dcterms:description "e_6 is a free kinetic anisotropy amplitude of the reduced model (not a literature value)" ;
        schema:measurementTechnique "Fourier amplitude ratio of the 6th harmonic of the twinned vs single-domain terrace ring with e_6 = 0.15 (single c6/c0 = 0.1564, twin = 0.1482); e_6 sweep: single = [0.0, 0.052, 0.104, 0.156, 0.208, 0.312], twin = [0.0, 0.049, 0.099, 0.148, 0.198, 0.296]" ;
        schema:name "Aragonite {110} cyclic-twin retention of 6-fold pseudo-hexagonal polygonization f_6 (measured on anisotropic eikonal terrace ring)" ;
        schema:unitText "ratio (twinned / single-domain 2|c_6|/c_0)" ;
        schema:value "0.9474" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-aragonite-110-cyclic-twin-retention-of-6-fold-pseudo-hexagonal-polygonization-f-6-measured-on-anisotropic-eikonal-terrace-ring-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-aragonite-110-cyclic-twin-retention-of-6-fold-pseudo-hexagonal-polygonization-f-6-measured-on-anisotropic-eikonal-terrace-ring-reference> a schema:PropertyValue ;
        dcterms:source "Analytic f_6 = |sum_j exp(6 i j tau)| / 3 for tau = 63.82 deg; Cartwright & Checa (2007) pseudo-hexagonal aragonite tablet habit" ;
        schema:value "0.9474" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-aragonite-110-cyclic-twin-suppression-of-2-fold-terrace-elongation-f-2-measured-on-anisotropic-eikonal-terrace-ring> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Aragonite {110} cyclic-twin suppression of 2-fold terrace elongation f_2 (measured on anisotropic eikonal terrace ring) = 0.0738 ratio (twinned / single-domain 2|c_2|/c_0)" ;
        dcterms:description "cyclic twin angular misfit 3 tau - 180 = 11.46 deg" ;
        schema:measurementTechnique "Fourier amplitude ratio of the closed terrace ring r(theta) for 3 twin domains at tau = 63.82 deg vs a single orthorhombic domain with v_100/v_010 = 1.0785 (single c2/c0 = 0.0394, twin = 0.0029); ideal 60-deg trilling control c2/c0 = 1.49e-17" ;
        schema:name "Aragonite {110} cyclic-twin suppression of 2-fold terrace elongation f_2 (measured on anisotropic eikonal terrace ring)" ;
        schema:unitText "ratio (twinned / single-domain 2|c_2|/c_0)" ;
        schema:value "0.0738" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-aragonite-110-cyclic-twin-suppression-of-2-fold-terrace-elongation-f-2-measured-on-anisotropic-eikonal-terrace-ring-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-aragonite-110-cyclic-twin-suppression-of-2-fold-terrace-elongation-f-2-measured-on-anisotropic-eikonal-terrace-ring-reference> a schema:PropertyValue ;
        dcterms:source "Analytic f_2 = |sum_j exp(2 i j tau)| / 3 with tau = 2 atan(a/b), a = 4.9611 A, b = 7.9672 A (De Villiers 1971 Am. Mineral. 56:758-767); Lean theorem aragonite_cyclic_twin_angular_misfit" ;
        schema:value "0.0738" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-aragonite-110-twin-angle-2-atan-a-b-from-de-villiers-1971-lattice-parameters> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Aragonite {110} twin angle 2 atan(a/b) from De Villiers (1971) lattice parameters = 63.82 deg" ;
        dcterms:description "parity check between code constants and vendored membrane_perforation_twinning_reference.json" ;
        schema:measurementTechnique "2 * atan(a / b) with a = 4.9611 A, b = 7.9672 A (code constants ARAGONITE_A_ANGSTROM, ARAGONITE_B_ANGSTROM)" ;
        schema:name "Aragonite {110} twin angle 2 atan(a/b) from De Villiers (1971) lattice parameters" ;
        schema:unitText "deg" ;
        schema:value "63.82" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-aragonite-110-twin-angle-2-atan-a-b-from-de-villiers-1971-lattice-parameters-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-aragonite-110-twin-angle-2-atan-a-b-from-de-villiers-1971-lattice-parameters-reference> a schema:PropertyValue ;
        dcterms:source "De Villiers JPR (1971) Am. Mineral. 56:758-767 (lattice); standard aragonite twin angle ~63.8 deg" ;
        schema:value "63.82" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bivalve-sheet-nacre-pteria-hirundo-brick-wall-mineral-bridge-stacking-offset-d-tab-from-random-pore-membrane-perforation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Bivalve sheet nacre (*Pteria hirundo*) brick-wall mineral-bridge stacking offset / D_tab from random-pore membrane perforation = 0.2148 ratio (offset / tablet diameter)" ;
        dcterms:description "alignment index = 0.417; model under-predicts the nominal 0.5 brick-wall offset because pores are drawn uniformly over the tablet interior" ;
        schema:measurementTechnique "Mean lateral offset between successive pore-nucleated mineral bridges over 12 sheets x 5 seeds with bridge localisation sigma = D_tab (A_g = 0.01, pores only), eikonal r_c = 0.42 um, D_tab = 4.2 um; SD = 0.106" ;
        schema:name "Bivalve sheet nacre (*Pteria hirundo*) brick-wall mineral-bridge stacking offset / D_tab from random-pore membrane perforation" ;
        schema:unitText "ratio (offset / tablet diameter)" ;
        schema:value "0.2148" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bivalve-sheet-nacre-pteria-hirundo-brick-wall-mineral-bridge-stacking-offset-d-tab-from-random-pore-membrane-perforation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bivalve-sheet-nacre-pteria-hirundo-brick-wall-mineral-bridge-stacking-offset-d-tab-from-random-pore-membrane-perforation-reference> a schema:PropertyValue ;
        dcterms:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 Sec. 4 (sheet-nacre tablets staggered like bricks in a wall; nominal half-tablet offset). The random-pore limit of a uniform disc predicts 1/3" ;
        schema:value "0.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bivalve-sheet-nacre-pteria-hirundo-single-spiral-terrace-pitch-lambda-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Bivalve sheet nacre (*Pteria hirundo*) single-spiral terrace pitch lambda_0 = 7.8007 um" ;
        dcterms:description "outer winding number = 1.00, terrace steps counted along the diameter = 7 (reference 6)" ;
        schema:measurementTechnique "Raw radial phase regression of the 2D BCF spiral eikonal travel over r in [0.6 L, 0.98 L] at r_c = 0.42 um, v_inf = 1.25 um/hr (Pass 3: no blending with the theoretical pitch; the ~2 % deficit is the Cabrera-Levine logarithmic core correction)" ;
        schema:name "Bivalve sheet nacre (*Pteria hirundo*) single-spiral terrace pitch lambda_0" ;
        schema:unitText "um" ;
        schema:value "7.8007" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bivalve-sheet-nacre-pteria-hirundo-single-spiral-terrace-pitch-lambda-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bivalve-sheet-nacre-pteria-hirundo-single-spiral-terrace-pitch-lambda-0-reference> a schema:PropertyValue ;
        dcterms:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 & Cartwright et al. (2009) PNAS 106:10499-10504" ;
        schema:value "7.9736" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-columnar-gastropod-nacre-haliotis-rufescens-mineral-bridge-stacking-offset-c-k-c-k-1-d-tab-from-stacked-sheet-allen-cahn-membrane-perforation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Columnar gastropod nacre (*Haliotis rufescens*) mineral-bridge stacking offset |c_k - c_(k-1)| / D_tab from stacked-sheet Allen-Cahn membrane perforation = 0.0 ratio (offset / tablet diameter)" ;
        dcterms:description "alignment index (offset < 0.15 D_tab) = 1.000 vs reference 1.0; perforated area fraction per sheet = 0.248" ;
        schema:measurementTechnique "Mean lateral offset between successive mineral-bridge sites (argmax of early perforation phase field) over 25 sheets x 5 seeds, bridge localisation sigma = 0.10 D_tab, eikonal tower r_c = 0.19 um, D_tab = 7.8 um" ;
        schema:name "Columnar gastropod nacre (*Haliotis rufescens*) mineral-bridge stacking offset |c_k - c_(k-1)| / D_tab from stacked-sheet Allen-Cahn membrane perforation" ;
        schema:unitText "ratio (offset / tablet diameter)" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-columnar-gastropod-nacre-haliotis-rufescens-mineral-bridge-stacking-offset-c-k-c-k-1-d-tab-from-stacked-sheet-allen-cahn-membrane-perforation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-columnar-gastropod-nacre-haliotis-rufescens-mineral-bridge-stacking-offset-c-k-c-k-1-d-tab-from-stacked-sheet-allen-cahn-membrane-perforation-reference> a schema:PropertyValue ;
        dcterms:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 Sec. 4; Checa, Cartwright & Willinger (2011) J. Struct. Biol. 176:330-339 (central mineral bridges -> vertically aligned tablet stacks)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-columnar-to-sheet-stacking-transition-bridge-localisation-sigma-d-tab-at-which-the-mean-offset-first-exceeds-0-1-d-tab> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Columnar-to-sheet stacking transition: bridge localisation sigma / D_tab at which the mean offset first exceeds 0.1 D_tab = 0.125 ratio (sigma / tablet diameter)" ;
        dcterms:description "ablation exposing the parameter controlling columnar (gastropod) vs sheet (bivalve) nacre in the reduced model" ;
        schema:measurementTechnique "Sweep of sigma / D_tab over [0.075, 0.1, 0.125, 0.15, 0.2, 0.35, 0.5, 1.0] (3 seeds each) with a fixed bridge budget A_g = (0.1 D_tab / sigma)^2; offsets = [0.086, 0.0, 0.206, 0.228, 0.228, 0.222, 0.222, 0.222]" ;
        schema:name "Columnar-to-sheet stacking transition: bridge localisation sigma / D_tab at which the mean offset first exceeds 0.1 D_tab" ;
        schema:unitText "ratio (sigma / tablet diameter)" ;
        schema:value "0.125" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-columnar-to-sheet-stacking-transition-bridge-localisation-sigma-d-tab-at-which-the-mean-offset-first-exceeds-0-1-d-tab-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-columnar-to-sheet-stacking-transition-bridge-localisation-sigma-d-tab-at-which-the-mean-offset-first-exceeds-0-1-d-tab-reference> a schema:PropertyValue ;
        dcterms:source "Model prediction: the Gaussian bridge drive falls below the spinodal threshold S_crit = S_0 + 1/(3 beta) = 0.683 once (0.1 D_tab / sigma)^2 < 0.683, i.e. sigma > 0.121 D_tab" ;
        schema:value "0.125" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-empirical-bcf-terrace-pitch-to-critical-radius-slope-lambda-0-r-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Empirical BCF terrace-pitch-to-critical-radius slope lambda_0 / r_c = 18.991 dimensionless ratio (lambda_0 / r_c)" ;
        dcterms:description "Bivalve sheet mean pitch = 10.11 um vs Gastropod/Cephalopod tower mean = 4.30 um" ;
        schema:measurementTechnique "OLS regression slope of observed terrace pitch lambda_obs vs critical radius r_c across 12 species (SE ± 0.0724)" ;
        schema:name "Empirical BCF terrace-pitch-to-critical-radius slope lambda_0 / r_c" ;
        schema:unitText "dimensionless ratio (lambda_0 / r_c)" ;
        schema:value "18.991" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-empirical-bcf-terrace-pitch-to-critical-radius-slope-lambda-0-r-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-empirical-bcf-terrace-pitch-to-critical-radius-slope-lambda-0-r-c-reference> a schema:PropertyValue ;
        dcterms:source "Burton, Cabrera & Frank (1951) Phil. Trans. R. Soc. A 243:299-358 (lambda_0 / r_c = 2*pi / 0.330958 ≈ 18.9848 ≈ 19)" ;
        schema:value "18.9848" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-same-chirality-b-b-double-spiral-to-single-spiral-terrace-pitch-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Same-chirality (+b, +b) double-spiral to single-spiral terrace pitch ratio = 0.5 ratio (lambda_2 / lambda_0)" ;
        dcterms:description "double-spiral pitch = 3.9003 um, outer winding = 2.00" ;
        schema:measurementTechnique "Ratio of measured inter-step terrace spacing for co-rotating (+1, +1) double spiral (b_net=+2) vs (+1, 0) single spiral (b_net=+1)" ;
        schema:name "Same-chirality (+b, +b) double-spiral to single-spiral terrace pitch ratio" ;
        schema:unitText "ratio (lambda_2 / lambda_0)" ;
        schema:value "0.5" ;

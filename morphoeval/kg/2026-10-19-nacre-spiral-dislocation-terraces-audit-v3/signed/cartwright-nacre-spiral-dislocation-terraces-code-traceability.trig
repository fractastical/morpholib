sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-spiral-dislocation-terraces> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L1–L82" ;
        dcterms:description "Header docstring: Laws 1-5 with equations, source sections and Lean theorem names (Laws 4-5 new in Pass 3)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2007-cartwright-nacre-spiral-dislocation-terraces.py#L1-L82> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L534–L542" ;
        dcterms:description "A(theta) docstring gives A_1, e_2 definition, lattice ratio and the twin-average construction with the Lean theorem name" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2007-cartwright-nacre-spiral-dislocation-terraces.py#L534-L542> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L724–L736" ;
        dcterms:description "Bridge budget and tablet footprint cite Checa et al. 2011 and Cartwright & Checa 2007" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2007-cartwright-nacre-spiral-dislocation-terraces.py#L724-L736> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 re-score from the remediated script, diff and Phase A handoff evidence)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007) & Cartwright et al. (2009) nacre screw-dislocation spirals, Frank-Read target terraces, defect pair annihilation, chitin-membrane perforation bridges and aragonite twin polygonization — Code-to-model traceability: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The header docstring (L1-82) maps Laws 1-5 to the source sections and to the named Lean theorems; the Pass 3 functions cite Cartwright & Checa (2007) Sec. 4 and Checa et al. (2011) for bridges (L724-726, L733-735), De Villiers (1971) for the lattice (L117-122, L535-541) and give the equations in their docstrings (L534-541, L567-574). Deductions: e_6 = 0.15 is a free parameter flagged as such but with no source (L123) (-3); the tower template constants pitch_tower/tower_spacing/hex_mod carry no citation (L497-510) (-4); the pore amplitude/width/density and S_0, beta, eps values are 'model parameters' in the Pass 3 JSON without a stated derivation (-3); the solver docstring's 'eikonal' wording overstates a closed-form phase construction (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2007-cartwright-nacre-spiral-dislocation-terraces.py L117–L123: Lattice constants cite De Villiers 1971; E6_DEFAULT = 0.15 is declared a free kinetic amplitude with no source <https://github.com/fractastical/morpholib/blob/e651a8b8/2007-cartwright-nacre-spiral-dislocation-terraces.py#L117-L123>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-code-traceability-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


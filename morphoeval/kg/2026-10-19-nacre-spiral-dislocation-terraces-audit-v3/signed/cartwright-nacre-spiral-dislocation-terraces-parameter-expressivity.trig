sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-spiral-dislocation-terraces> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007) & Cartwright et al. (2009) nacre screw-dislocation spirals, Frank-Read target terraces, defect pair annihilation, chitin-membrane perforation bridges and aragonite twin polygonization — Parameter expressivity: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The new sigma / D_tab bridge-localisation sweep (8 values x 3 seeds, L864-883) monotonically moves the mean stacking offset from 0 (columnar) to staggered with the transition at 0.10-0.125 D_tab, and the e_6 sweep (L613-621) moves the 6-fold polygonization monotonically with the twin factor retained; both are rendered in panel I (L1467). The 4 chiral regimes and the 12-species table are exercised as before (L887-920, L925-988), and `--v-inf`, `--r-c`, `--h-0`, `--dipole-d`, `--e6` and a now-live `--seed` are wired into the render (L1955-1980). Deductions: the subcritical/supercritical regime is chosen by the `if` at L308 rather than by sweeping d through 2 r_c (-4); r_c is not swept into the tower lattice, whose geometry is templated (L497-510), so the gastropod/bivalve architecture axis of panel A/C is not parameter-controlled (-5); the sheet-mode alignment index 0.417 vs ref 0 shows the 0.15 D_tab threshold is coarse for 4.2 um tablets (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2007-cartwright-nacre-spiral-dislocation-terraces.py L307–L315: Subcritical regime selected by `if` on the input d <= 2 r_c, not by a swept dynamical transition <https://github.com/fractastical/morpholib/blob/e651a8b8/2007-cartwright-nacre-spiral-dislocation-terraces.py#L307-L315>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-parameter-expressivity-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L863–L884" ;
        dcterms:description "sigma / D_tab sweep over 8 values x 3 seeds exposing the columnar -> staggered transition" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2007-cartwright-nacre-spiral-dislocation-terraces.py#L863-L884> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L604–L642" ;
        dcterms:description "Single vs twin vs isotropic vs ideal-60-deg control and e_6 sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2007-cartwright-nacre-spiral-dislocation-terraces.py#L604-L642> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L1953–L1988" ;
        dcterms:description "CLI: --v-inf, --r-c, --h-0, --dipole-d, --e6, --seed (now consumed by the phase-field seed)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2007-cartwright-nacre-spiral-dislocation-terraces.py#L1953-L1988> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 re-score from the remediated script, diff and Phase A handoff evidence)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


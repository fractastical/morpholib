sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-spiral-dislocation-terraces> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007) & Cartwright et al. (2009) nacre screw-dislocation spirals, Frank-Read target terraces, defect pair annihilation, chitin-membrane perforation bridges and aragonite twin polygonization — Reproducibility package: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`self_test()` (L1838-1950) runs 12 checks: SHA-256 provenance of 6 files, JSON parity, Gibbs-Thomson arrest, 4-regime winding numbers, raw pitch within 4 % and terrace counts within +/-1, 3D heights, 12-species collapse, SEM segmentation, bitwise two-run determinism of the 2D solver, twin parity and analytic factors with the anisotropy-off bitwise-identity check (L1911-1914), membrane behaviour with footprint-in-tier and dt-stability assertions (L1917-1932), seeded bitwise determinism of the phase field (L1935-1937), and the 15-measurement reference anchoring (L1940-1942); it passed 12/12 in this loop (~21 s CPU). `--seed` now seeds the pore field (L1962, L1980) and `requirements.lock.txt` pins the environment. Deductions: the default render is ~60 s wall and the PNG is gitignored, so the committed artifact is the GIF only (-3); self-test timing is not stated in the docstring and no MPLCONFIGDIR note (-2); the sheet mode yields only 2-3 sheets per run, so its statistics rest on 5 seeds (-2); the Pass 3 dataset README is 20 lines and does not list the CLI (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-repro-package-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L1838–L1950" ;
        dct:description "12-check self_test(): 8 Pass 2 + 4 Pass 3 checks incl. anisotropy-off parity, membrane invariants, seeded phase-field determinism, 15 anchored measurements; PASSED all 12" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2007-cartwright-nacre-spiral-dislocation-terraces.py#L1838-L1950> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L1953–L1988" ;
        dct:description "argparse CLI with live --seed and --e6; default run renders PNG + 2 GIFs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2007-cartwright-nacre-spiral-dislocation-terraces.py#L1953-L1988> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "datasets/nacre_spiral_dislocation_terraces/README.md L1–L20" ;
        dct:description "Dataset README with provenance table and Pass 3 caveats; CLI/runtime not documented" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/datasets/nacre_spiral_dislocation_terraces/README.md#L1-L20> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 re-score from the remediated script, diff and Phase A handoff evidence)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


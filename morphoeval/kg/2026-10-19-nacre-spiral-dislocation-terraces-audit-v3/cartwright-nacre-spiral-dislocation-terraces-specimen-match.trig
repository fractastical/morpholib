sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-spiral-dislocation-terraces> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007) & Cartwright et al. (2009) nacre screw-dislocation spirals, Frank-Read target terraces, defect pair annihilation, chitin-membrane perforation bridges and aragonite twin polygonization — Morphological realism / specimen match: 82/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The 9-panel figure shows visually distinct morphologies: Archimedean spiral, closed target rings, interlocked double spiral and the annihilated dipole (panels B-D), the SEM specimen with ROI and detected seams (panel E), the stacked membrane sheets with the perforation patch and bridge centroids (panel G), and the twin-polygonized vs single-domain terrace contours overlaid (panel H), which read as the pseudo-hexagonal tablet habit the source describes. The new membrane-perforation GIF animates sheet-1 perforation. Deductions: the SEM um/px calibration was chosen to return h_0 = 0.50 um (JSON L38-39) and the reference spacing/aspect/layers/CV were copied from the script's own segmentation output, so the specimen panel confirms itself rather than being matched to the source's scale (-8); no side-by-side with Cartwright & Checa's own micrographs or Cartwright et al. (2009) figures of spirals/targets is drawn, leaving the match to the viewer (-5); the panel A/C towers are the hard-coded template (L496-512) (-3); long titles still collide in panels A/B/C at 17 in width (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/nacre_spiral_dislocation_terraces/nacre_spiral_dislocation_terraces_reference.json L38–L44: calibration_um_per_px = 0.019867 = 0.50 / 25.1677 anchored to h_0 = 0.50 um; reference px spacing, aspect ratio, layers and CV copied from the script's own output <https://github.com/fractastical/morpholib/blob/e651a8b8/datasets/nacre_spiral_dislocation_terraces/nacre_spiral_dislocation_terraces_reference.json#L38-L44>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match-5> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/nacre_spiral_dislocation_terraces_comparison.png (generated output)" ;
        dct:description "9-panel synthesis: A-F carried from v2, G stacked membrane perforation, H twin-polygonized spiral vs single domain, I ablation sweeps; panel A/B/C titles overlap — docs/media/nacre_spiral_dislocation_terraces_comparison.png: rendered output of 2007-cartwright-nacre-spiral-dislocation-terraces.py at e651a8b8, image/png, 1988335 B, 2620×2219 px, artifact_sha256 783e8dff611789f803e2347b93f2a800d17da83e277f9b6edc9ca0174d15f68b (sha256 783e8dff611789f803e2347b93f2a800d17da83e277f9b6edc9ca0174d15f68b), spec_fingerprint 4c231c8398be9a26483bc4175fe15077a90c9e9b18a12deaf2c2e4265b43d447" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/nacre_spiral_dislocation_terraces_membrane_perforation.gif (generated output)" ;
        dct:description "Sheet-1 Allen-Cahn perforation history animated with the tablet footprint and bridge centroid — docs/media/nacre_spiral_dislocation_terraces_membrane_perforation.gif: rendered output of 2007-cartwright-nacre-spiral-dislocation-terraces.py at e651a8b8, image/gif, 272123 B, 1092×504 px, 10 frames, artifact_sha256 1395f288bb5e7458a00177110b141a5569eb5b3393ab88d1e18e525939571741 (sha256 1395f288bb5e7458a00177110b141a5569eb5b3393ab88d1e18e525939571741), spec_fingerprint 4c231c8398be9a26483bc4175fe15077a90c9e9b18a12deaf2c2e4265b43d447" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/nacre_spiral_dislocation_terraces_growth.gif (generated output)" ;
        dct:description "2-panel growth GIF (spiral terrace + 3D tower) re-rendered byte-identically to v2 (SHA-256 27018b2b...); tower panel is the templated lattice — docs/media/nacre_spiral_dislocation_terraces_growth.gif: rendered output of 2007-cartwright-nacre-spiral-dislocation-terraces.py at e651a8b8, image/gif, 1135414 B, 1092×482 px, 7 frames, artifact_sha256 27018b2b49c7139553662acad56f4426bb8cad1be83bfcdf105beab07311f1b2 (sha256 27018b2b49c7139553662acad56f4426bb8cad1be83bfcdf105beab07311f1b2), spec_fingerprint 4c231c8398be9a26483bc4175fe15077a90c9e9b18a12deaf2c2e4265b43d447" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L1371–L1465" ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg critical wavelength at 3.125 µm for Aulacopleura koninckii meraspis (Pass 2) — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass-1 statistics stand (r=0.99937 vs 1, RMSE=0.0271 vs 0, KS=0.067 vs 0.05, furrows 11 vs 12, circularity 0.191 vs 1, coherency 0.613 vs 0.5). The 2D dominant wavelength is 3.125 µm against the 1D fastest-mode reference 3.146 µm, so the new metric is not self-referential. KS is printed on the figure." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-chronoseries-segment-surplus>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-ks-dispersion-residual>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-patch2d-dominant-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-specimen-thoracic-furrow-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-stripe-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-chronoseries-segment-surplus> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chronoseries_segment_surplus = 6.0 segments" ;
        dct:description "successor ratio 18/12 = 1.5 under conserved k_c" ;
        schema:measurementTechnique "holaspis18 thoracic count minus meraspid degree 12, at fixed λ_c" ;
        schema:name "chronoseries_segment_surplus" ;
        schema:unitText "segments" ;
        schema:value "6.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-chronoseries-segment-surplus-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-chronoseries-segment-surplus-reference> a schema:PropertyValue ;
        dct:source "a null of no segment release between chronoseries step 1 and its successor" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r = 0.999366 1" ;
        schema:measurementTechnique "Pearson r between discrete-Laplacian σ(k) and eigenmode growth of the explicit PDE on the band 0.78–1.28 k_c" ;
        schema:name "dispersion_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.999366" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 linear dispersion; identity is the analytical limit, not the numerical result" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_rmse = 0.027057 1/s" ;
        schema:measurementTechnique "RMSE of numerical minus analytical growth rate on the same wavenumber grid" ;
        schema:name "dispersion_rmse" ;
        schema:unitText "1/s" ;
        schema:value "0.027057" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "zero residual is the linear-theory limit" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_diffusion_control_sigma_max = -0.458018 1/s" ;
        dct:description "ablation control versus the differential-diffusion baseline" ;
        schema:measurementTechnique "max Re σ(k) with D_u = D_v (negative control / ablation of differential diffusion)" ;
        schema:name "equal_diffusion_control_sigma_max" ;
        schema:unitText "1/s" ;
        schema:value "-0.458018" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> a schema:PropertyValue ;
        dct:source "Turing 1952: equal diffusivities cannot destabilise a stable steady state" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-ks-dispersion-residual> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ks_dispersion_residual = 0.066667 1" ;
        dct:description "uncertainty via KS and RMSE" ;
        schema:measurementTechnique "two-sample KS statistic of demeaned σ curves; p=1" ;
        schema:name "ks_dispersion_residual" ;
        schema:unitText "1" ;
        schema:value "0.066667" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-ks-dispersion-residual-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-ks-dispersion-residual-reference> a schema:PropertyValue ;
        dct:source "KS critical-value scale used as a fixed benchmark, not the measured statistic" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-patch2d-dominant-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "patch2d_dominant_wavelength_um = 3.125 µm" ;
        dct:description "2D control versus the 1D transect baseline" ;
        schema:measurementTechnique "dominant anteroposterior wavelength of a 48×36 periodic pleural patch seeded with a transverse lira plus mediolateral noise" ;
        schema:name "patch2d_dominant_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "3.125" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-patch2d-dominant-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-patch2d-dominant-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "1D fastest-mode wavelength λ_max; the 2D FFT bin is an independent measurement" ;
        schema:value "3.146109" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,

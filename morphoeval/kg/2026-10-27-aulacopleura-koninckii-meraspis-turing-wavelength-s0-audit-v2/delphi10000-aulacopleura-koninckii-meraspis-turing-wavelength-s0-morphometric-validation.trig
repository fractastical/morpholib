        dct:source "circularity of a circle; a trilobite outline is not circular" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_structure_tensor_coherency = 0.6125 1" ;

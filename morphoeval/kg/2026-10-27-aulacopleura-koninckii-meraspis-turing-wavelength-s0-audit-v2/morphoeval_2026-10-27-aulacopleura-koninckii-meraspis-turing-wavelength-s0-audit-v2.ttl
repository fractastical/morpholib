    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3126.segmentSurplus" ;
    pk:leanTheorem "MathOfBiology.Loop_3126.segment_surplus_is_six" ;

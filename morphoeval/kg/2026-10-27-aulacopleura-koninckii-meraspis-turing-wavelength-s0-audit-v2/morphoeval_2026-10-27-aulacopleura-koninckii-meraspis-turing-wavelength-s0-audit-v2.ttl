<https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Onset condition for Turing wavelength selection at 3.125 µm in the meraspid integument | Variables: D_v/D_u = 6.683 (ppt 6683) above onset 6.552 (ppt 6552) at λ = 3125 nm" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0; Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3126_aulacopleura_koninckii_meraspis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J - k^2 D) = D_u D_v k^4 - (D_v f_u + D_u g_v) k^2 + (f_u g_v - f_v g_u)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1086/381042>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1502-3931.1995.tb01824.x>,
        <https://doi.org/10.1666/06017.1> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3126.diffusionRatioPpt" ;
    pk:leanTheorem "MathOfBiology.Loop_3126.above_turing_onset" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical intrinsic wavelength" ;
    dct:description "Wavenumber law at the 3.1 µm detail tier, finer than the 183 µm primordium sibling | Variables: λ_c = 3125 nm; 16 wavelengths tile a 50 µm pleural patch" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3126_aulacopleura_koninckii_meraspis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 2 pi / k_c, k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1086/381042>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1502-3931.1995.tb01824.x>,
        <https://doi.org/10.1666/06017.1> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3126.lambdaNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3126.pleural_patch_tiles_sixteen" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Meraspid to holaspis segment surplus at fixed wavelength" ;
    dct:description "What changes at 3.125 µm across chronoseries step 1/3 is domain segment count, not k_c | Variables: 12 thoracic segments at 428.5 Ma versus successor holaspis18" ;
    dct:source "Fusco et al. 2004 DOI:10.1086/381042; Hughes, Minelli & Fusco 2006 DOI:10.1666/06017.1" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3126_aulacopleura_koninckii_meraspis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;

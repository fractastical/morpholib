sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg critical wavelength at 3.125 µm for Aulacopleura koninckii meraspis (Pass 2) — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 1's Schnakenberg PDE and k_c formula remain, with r=0.99937 on the discrete dispersion band. Pass 2 adds the 2D patch: mediolateral noise does not shift the dominant anteroposterior wavenumber off k_c (ratio 1.000). Parameters are still a reconstruction that hits the assigned wavelength, not a measured trilobite kinetic set." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0.py L98–L127" ;
        dct:description "γ solved from the k_c formula" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0.py#L98-L127> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0.py L180–L235" ;
        dct:description "1D eigenmode goodness-of-fit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0.py#L180-L235> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0.py L269–L302" ;
        dct:description "2D pleural patch and dominant ky" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aulacopleura-koninckii-meraspis-turing-wavelength-s0.py#L269-L302> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-shyer-intestinal-villi-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2011) PRL & Shyer et al. (2013) Science sequential smooth-muscle mucosal buckling into ridges, zigzags, and hexagonal villi — Reproducibility package: 95/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`self_test()` (L1833-1940) runs 12 checks in 2.1 s: SHA-256 integrity of 6 files, JSON-to-code parity, FK506/surgical hierarchy, amplitude monotonicity, 3-species collapse, specimen Z and CV, bitwise two-run determinism, plus the Pass 3 ring-FEM vs Lamé / slab / h-convergence tolerances, prefactor-fit vs frozen constant, mode closure n lambda_n = 2 pi R, gamma(E8) > gamma(E16), elbow index > 1.2, clusters per villus in (0.7, 1.4), E6 zero clusters, bulge > 1 um, and the three ablation/variant invariants. The default run renders the comparison PNG, the tubular_shh_bmp PNG and the growth GIF in 2.4 s with a fixed seed, and `lean` verifies the module with 0 sorrys. Deductions: no requirements lock file pins the exact numpy/scipy/matplotlib versions used (-3); the Pass 3 tunables are not exposed for a reproducible sweep (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-repro-package-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-repro-package-5> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L1833–L1940" ;
        dct:description "self_test: 12 checks (8 Pass 2 + 4 Pass 3) including ring-FEM vs Lamé, mode closure, elbow index, clusters per villus and the --no-tubular / --no-shh-bmp / prestrain ablation invariants; PASSED" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L1833-L1940> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L1941–L1985" ;
        dct:description "main: argparse CLI, self-test entry, deterministic seed 2013, renders comparison PNG, tubular_shh_bmp PNG and growth GIF" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L1941-L1985> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L1539–L1631" ;
        dct:description "render_growth_gif: GIF frames overlay cluster outlines; regenerated by the default invocation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L1539-L1631> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/epithelial_buckling_crypt_villus_growth.gif (generated output)" ;
        dct:description "Regenerated E6-E16 growth GIF with cluster outlines; produced by the default invocation together with the two PNGs — docs/media/epithelial_buckling_crypt_villus_growth.gif: rendered output of 2013-shyer-intestinal-villi-buckling.py at 45670cb8, image/gif, 364621 B, 1071×482 px, 6 frames, artifact_sha256 2e7822f3249cd163ff55f236e2b8218a23a932fe8de499fcbdb92edb84c585f6 (sha256 2e7822f3249cd163ff55f236e2b8218a23a932fe8de499fcbdb92edb84c585f6), spec_fingerprint da01f54f3142bab9fe39c5f26bd338e06f8c4d88ac4dfcc5ab72c0d0def8016a" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-repro-package-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_063_epithelial_buckling_crypt_villus.lean L1–L151" ;
        dct:description "151-line self-contained Lean 4 module, 0 sorrys, `lean` exit 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_063_epithelial_buckling_crypt_villus.lean#L1-L151> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 063 Pass 3 Phase B Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


<https://w3id.org/probknow/resource/evidence/2026-10-19-epithelial-buckling-crypt-villus-audit-v3-shyer-intestinal-villi-buckling-10> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "Axisymmetric ring-FEM mesenchymal foundation stiffness vs Lamé thick-cylinder analytic (max rel. error, 6 Chick stages)" ;
    dct:description "48-element linear axisymmetric plane-strain FEM (2-point Gauss) of the annulus R_lumen..R_lumen+H_s with rigid smooth-muscle outer wall vs closed-form Lamé solution u = A r + B/r; also slab limit vs M_s/H_s" ;
    dct:source "Lamé (1852) thick-walled cylinder solution; Timoshenko & Goodier, Theory of Elasticity, §28 (verification of the FEM, not an empirical datum)" ;
    rdfs:comment "E16 K_eff = 0.00775 kPa/um vs Winkler E_s/H_s = 0.00829 kPa/um; slab-limit FEM vs M_s/H_s rel. err = 2.61e-06" ;
    prov:wasGeneratedBy "script" ;
    schema:about "Vertebrate embryonic gut mucosa (Gallus gallus, Coturnix japonica, Mus musculus)" ;
    schema:error 2.1e-03 ;
    schema:targetValue 0e+00 ;
    schema:unitText "relative error" ;
    schema:value 2.136e-05 .


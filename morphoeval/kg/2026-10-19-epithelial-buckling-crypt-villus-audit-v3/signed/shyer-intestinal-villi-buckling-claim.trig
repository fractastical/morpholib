    <https://github.com/fractastical/morpholib/blob/45670cb8/docs/media/epithelial_buckling_crypt_villus_tubular_shh_bmp.png> a schema:SoftwareSourceCode ;
        rdfs:label "docs/media/epithelial_buckling_crypt_villus_tubular_shh_bmp.png" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:version "45670cb8" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-shyer-intestinal-villi-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-3-species-mucosal-buckling-wavelength-scaling-correlation-chick-quail-mouse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3-species mucosal buckling wavelength scaling correlation (Chick, Quail, Mouse) = 0.9996 Pearson r" ;
        dcterms:description "RMSE = 1.13 um, p=1.01e-16" ;
        schema:measurementTechnique "Linear regression of predicted 2*pi*c_lambda*(B_e/K_s)^(1/4) vs observed wavelength across 12 stages in 3 vertebrates (p=1.01e-16, RMSE=1.13 um)" ;
        schema:name "3-species mucosal buckling wavelength scaling correlation (Chick, Quail, Mouse)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9996" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-3-species-mucosal-buckling-wavelength-scaling-correlation-chick-quail-mouse-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-3-species-mucosal-buckling-wavelength-scaling-correlation-chick-quail-mouse-reference> a schema:PropertyValue ;
        dcterms:source "Hannezo, Prost & Joanny (2011) PRL 107:078104 Eq. (8) & Shyer et al. (2013) Science 342:212-218" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-axisymmetric-ring-fem-mesenchymal-foundation-stiffness-vs-lam-thick-cylinder-analytic-max-rel-error-6-chick-stages> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Axisymmetric ring-FEM mesenchymal foundation stiffness vs Lamé thick-cylinder analytic (max rel. error, 6 Chick stages) = 2.136e-05 relative error" ;
        dcterms:description "E16 K_eff = 0.00775 kPa/um vs Winkler E_s/H_s = 0.00829 kPa/um; slab-limit FEM vs M_s/H_s rel. err = 2.61e-06" ;
        schema:measurementTechnique "48-element linear axisymmetric plane-strain FEM (2-point Gauss) of the annulus R_lumen..R_lumen+H_s with rigid smooth-muscle outer wall vs closed-form Lamé solution u = A r + B/r; also slab limit vs M_s/H_s" ;
        schema:name "Axisymmetric ring-FEM mesenchymal foundation stiffness vs Lamé thick-cylinder analytic (max rel. error, 6 Chick stages)" ;
        schema:unitText "relative error" ;
        schema:value "2.136e-05" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-axisymmetric-ring-fem-mesenchymal-foundation-stiffness-vs-lam-thick-cylinder-analytic-max-rel-error-6-chick-stages-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-axisymmetric-ring-fem-mesenchymal-foundation-stiffness-vs-lam-thick-cylinder-analytic-max-rel-error-6-chick-stages-reference> a schema:PropertyValue ;
        dcterms:source "Lamé (1852) thick-walled cylinder solution; Timoshenko & Goodier, Theory of Elasticity, §28 (verification of the FEM, not an empirical datum)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-5-stage-tubular-ring-fem-fvk-wavelength-rmse-curvature-coupled-lambda-tube-vs-lambda-obs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chick 5-stage tubular ring-FEM FvK wavelength RMSE (curvature-coupled lambda_tube vs lambda_obs) = 1.717 um" ;
        dcterms:description "r_tube = 0.9996; neo-Hookean prestrain-tangent variant (--neo-hookean-prestrain) RMSE = 7.47 um (over-stiffens late stages: prestrain factor 2.17 at E16)" ;
        schema:measurementTechnique "lambda_tube = c_tube * 2 pi (B_e/K_eff)^(1/4) with K_eff from the ring FEM, c_tube = 0.5513 fitted once by OLS-through-origin; compared with the flat Winkler model (RMSE 1.468 um, r=0.9997) on the same 5 points" ;
        schema:name "Chick 5-stage tubular ring-FEM FvK wavelength RMSE (curvature-coupled lambda_tube vs lambda_obs)" ;
        schema:unitText "um" ;
        schema:value "1.717" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-5-stage-tubular-ring-fem-fvk-wavelength-rmse-curvature-coupled-lambda-tube-vs-lambda-obs-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-5-stage-tubular-ring-fem-fvk-wavelength-rmse-curvature-coupled-lambda-tube-vs-lambda-obs-reference> a schema:PropertyValue ;
        dcterms:source "Shyer et al. (2013) Science 342:212-218 Fig. 1 Chick E8-E16 wavelengths (reference value = flat-model RMSE on the same stages)" ;
        schema:value "1.468" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e10-1d-parallel-longitudinal-ridge-wavelength-lambda-sim> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chick E10 1D parallel longitudinal ridge wavelength lambda_sim = 118.69 um" ;
        dcterms:description "simulated ridge count = 12 vs ref 12" ;
        schema:measurementTechnique "L-BFGS-B Föppl-von Kármán energy minimization under circular smooth-muscle compression at Chick E10 (epsilon_x=0.36)" ;
        schema:name "Chick E10 1D parallel longitudinal ridge wavelength lambda_sim" ;
        schema:unitText "um" ;
        schema:value "118.69" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e10-1d-parallel-longitudinal-ridge-wavelength-lambda-sim-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e10-1d-parallel-longitudinal-ridge-wavelength-lambda-sim-reference> a schema:PropertyValue ;
        dcterms:source "Shyer et al. (2013) Science 342:212-218 Fig. 1 (Chick E10 parallel ridges, N_ridges=12)" ;
        schema:value "118.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e14-2d-herringbone-zigzag-chevron-half-angle-theta-zz-sim> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chick E14 2D herringbone zigzag chevron half-angle theta_zz_sim = 38.5 deg" ;
        dcterms:description "FK506@E11 longitudinal block arrests angle at 0.0 deg (ridges)" ;
        schema:measurementTechnique "Biaxial Föppl-von Kármán energy minimization under circular + outer longitudinal smooth muscle at Chick E14 (epsilon_x=0.50, epsilon_y=0.36)" ;
        schema:name "Chick E14 2D herringbone zigzag chevron half-angle theta_zz_sim" ;
        schema:unitText "deg" ;
        schema:value "38.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e14-2d-herringbone-zigzag-chevron-half-angle-theta-zz-sim-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e14-2d-herringbone-zigzag-chevron-half-angle-theta-zz-sim-reference> a schema:PropertyValue ;
        dcterms:source "Shyer et al. (2013) Science 342:212-218 Fig. 1 & Fig. 3 (Chick E14 herringbone zigzags, 38.5 deg)" ;
        schema:value "38.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e14-cluster-induced-elbow-bulge-linear-fvk-response-to-localized-alpha-3-alpha-3-0-60-c-vs-no-signaling-ablation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chick E14 cluster-induced elbow bulge (linear FvK response to localized alpha_3 = alpha_3 + 0.60 C) vs no-signaling ablation = 5.885 um" ;
        dcterms:description "ablation elbow_bulge = 0.000 um, E16 tip bulge = 4.677 um; the magnitude is set by SHH_TRUST_FRACTION and is not an empirical prediction" ;
        schema:measurementTechnique "Mean height gained inside clusters between the signaling-free pass-1 surface and the cluster-forced surface (trust-region-limited Newton step of the FvK operator), at the E14 reference amplitude 106 um" ;
        schema:name "Chick E14 cluster-induced elbow bulge (linear FvK response to localized alpha_3 = alpha_3 + 0.60 C) vs no-signaling ablation" ;
        schema:unitText "um" ;
        schema:value "5.885" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e14-cluster-induced-elbow-bulge-linear-fvk-response-to-localized-alpha-3-alpha-3-0-60-c-vs-no-signaling-ablation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e14-cluster-induced-elbow-bulge-linear-fvk-response-to-localized-alpha-3-alpha-3-0-60-c-vs-no-signaling-ablation-reference> a schema:PropertyValue ;
        dcterms:source "Ablation reference (shh_bmp_coupling=False gives exactly 0.0 um by construction); Shyer et al. (2013) Science Fig. 4 & Shyer et al. (2015) Cell: villi emerge from the zigzag elbows (direction of effect only)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e14-shh-bmp-mesenchymal-cluster-elbow-localization-index-cluster-mass-at-zigzag-elbows-uniform-expectation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chick E14 Shh/BMP mesenchymal cluster elbow-localization index (cluster mass at zigzag elbows / uniform expectation) = 1.4201 enrichment ratio" ;
        dcterms:description "E13 index = 1.353; cluster fraction on crests (w>0) = 1.000; qualitative-only reference (no quantitative enrichment reported in the papers)" ;
        schema:measurementTechnique "Shh = G_sigma*[(-lap w)_+ (1 + lambda |kappa_c|)] from the relaxed E14 surface, clusters = top-18 % Shh set; fraction of cluster pixels within ±lambda_y/16 of the elbow rows (cos(q_y y) = ±1) divided by the areal fraction of those rows (1.0 = no localization)" ;
        schema:name "Chick E14 Shh/BMP mesenchymal cluster elbow-localization index (cluster mass at zigzag elbows / uniform expectation)" ;
        schema:unitText "enrichment ratio" ;
        schema:value "1.4201" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e14-shh-bmp-mesenchymal-cluster-elbow-localization-index-cluster-mass-at-zigzag-elbows-uniform-expectation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e14-shh-bmp-mesenchymal-cluster-elbow-localization-index-cluster-mass-at-zigzag-elbows-uniform-expectation-reference> a schema:PropertyValue ;
        dcterms:source "Walton et al. (2012) PNAS 109:15817 & Shyer et al. (2015) Cell 161:569 — Hh-responsive clusters / Ptch1 signal concentrate at fold apices (reference = null uniform value; paper requires > 1)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-donnell-shell-curvature-ratio-gamma-e-e-h-e-r-2-k-eff-flat-plate-fvk-validity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chick E16 Donnell shell curvature ratio gamma = (E_e h_e / R^2) / K_eff (flat-plate FvK validity) = 0.0698 dimensionless" ;
        dcterms:description "gamma = 0.701 at E8 (R=205 um, early ridges: shell curvature NOT negligible) falling to 0.070 at E16 — the flat FvK reduction is only well justified from E13 on" ;
        schema:measurementTechnique "Membrane stretching stiffness of the cylindrical mucosal shell relative to the ring-FEM foundation stiffness; gamma << 1 justifies the flat FvK reduction, gamma ~ 1 does not" ;
        schema:name "Chick E16 Donnell shell curvature ratio gamma = (E_e h_e / R^2) / K_eff (flat-plate FvK validity)" ;
        schema:unitText "dimensionless" ;
        schema:value "0.0698" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-donnell-shell-curvature-ratio-gamma-e-e-h-e-r-2-k-eff-flat-plate-fvk-validity-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-donnell-shell-curvature-ratio-gamma-e-e-h-e-r-2-k-eff-flat-plate-fvk-validity-reference> a schema:PropertyValue ;
        dcterms:source "Donnell (1933) NACA Rep. 479 shallow cylindrical shell theory; Shyer et al. (2013) Supplementary Text (plate-on-foundation reduction)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-hexagonal-villi-bond-orientational-order-psi-6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chick E16 hexagonal villi bond-orientational order |Psi_6| = 0.78 |Psi_6|" ;
        dcterms:description "FK506@E14 inner-muscle block reduces |Psi_6| to 0.32 (arrested at zigzags)" ;
        schema:measurementTechnique "6-fold bond-orientational order parameter of L-BFGS-B relaxed E16 villus array vs FK506@E14 zigzag arrest control" ;
        schema:name "Chick E16 hexagonal villi bond-orientational order |Psi_6|" ;
        schema:unitText "|Psi_6|" ;
        schema:value "0.78" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-hexagonal-villi-bond-orientational-order-psi-6-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-hexagonal-villi-bond-orientational-order-psi-6-reference> a schema:PropertyValue ;
        dcterms:source "Shyer et al. (2013) Science 342:212-218 Fig. 4 (hexagonal villus array)" ;
        schema:value "0.78" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-hexagonal-villi-spacing-lambda-sim> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chick E16 hexagonal villi spacing lambda_sim = 80.15 um" ;
        dcterms:description "villus tip = +96.1 um, crypt depth = -48.9 um" ;
        schema:measurementTechnique "L-BFGS-B Föppl-von Kármán hexagonal triad energy minimization at Chick E16 (epsilon_x=0.58, epsilon_y=0.54, alpha_3=1.35)" ;
        schema:name "Chick E16 hexagonal villi spacing lambda_sim" ;
        schema:unitText "um" ;
        schema:value "80.15" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-hexagonal-villi-spacing-lambda-sim-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-hexagonal-villi-spacing-lambda-sim-reference> a schema:PropertyValue ;
        dcterms:source "Shyer et al. (2013) Science 342:212-218 Fig. 1 & Fig. 4 (Chick E16 hexagonal villi, 82.0 um)" ;
        schema:value "82.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-shh-bmp-mesenchymal-clusters-per-villus-n-clusters-expected-villi-in-the-4x4-period-hexagonal-box> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chick E16 Shh/BMP mesenchymal clusters per villus (n_clusters / expected villi in the 4x4-period hexagonal box) = 1.1908 clusters per villus" ;
        dcterms:description "cluster mass on villus tips (w>0) = 0.831; cluster area fraction = 0.180" ;
        schema:measurementTechnique "Connected components of the hard-thresholded cluster indicator (22 clusters) over the expected hexagonal villus count n_periods^2 * 2/sqrt(3) = 18.48" ;
        schema:name "Chick E16 Shh/BMP mesenchymal clusters per villus (n_clusters / expected villi in the 4x4-period hexagonal box)" ;
        schema:unitText "clusters per villus" ;
        schema:value "1.1908" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-shh-bmp-mesenchymal-clusters-per-villus-n-clusters-expected-villi-in-the-4x4-period-hexagonal-box-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-shh-bmp-mesenchymal-clusters-per-villus-n-clusters-expected-villi-in-the-4x4-period-hexagonal-box-reference> a schema:PropertyValue ;
        dcterms:source "Walton et al. (2012) PNAS 109:15817 Figs. 1-3 (one Hh-responsive mesenchymal cluster beneath each emerging villus); Shyer et al. (2015) Cell 161:569" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-tubular-curvature-factor-k-tube-k-slab-of-the-mesenchymal-annulus-h-s-r-lumen-0-248> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chick E16 tubular curvature factor K_tube/K_slab of the mesenchymal annulus (H_s/R_lumen = 0.248) = 0.9347 dimensionless" ;
        dcterms:description "curvature factor rises from 0.877 (E6, H/R=0.61) to 0.935 (E16): the flat Winkler bed over-estimates the tube foundation stiffness by 7-12 %" ;
        schema:measurementTechnique "Ring-FEM radial stiffness of the tubular mesenchyme divided by the curvature-free confined-slab stiffness M_s/H_s at the same modulus (isolates the 3D tube geometry)" ;
        schema:name "Chick E16 tubular curvature factor K_tube/K_slab of the mesenchymal annulus (H_s/R_lumen = 0.248)" ;
        schema:unitText "dimensionless" ;
        schema:value "0.9347" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-tubular-curvature-factor-k-tube-k-slab-of-the-mesenchymal-annulus-h-s-r-lumen-0-248-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-tubular-curvature-factor-k-tube-k-slab-of-the-mesenchymal-annulus-h-s-r-lumen-0-248-reference> a schema:PropertyValue ;
        dcterms:source "Lamé thick-cylinder closed form with u(R_out)=0 (Timoshenko & Goodier §28); Shyer et al. (2013) Science Fig. 1 E16 lumen radius ~330 um, mesenchyme ~82 um" ;
        schema:value "0.9347" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e8-e16-integer-circumferential-mode-count-on-the-tube-mean-n-quantized-n-ridges-obs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chick E8-E16 integer circumferential mode count on the tube (mean |n_quantized - n_ridges_obs|) = 0.2 ridges" ;
        dcterms:description "quantized counts: E8=10, E10=12, E13=16, E14=19, E16=26" ;
        schema:measurementTechnique "n = round(2 pi R_lumen / lambda_tube) per stage (MathOfBiology.Loop_063.tubular_mode_quantization) vs observed ridge / villus-column counts 10, 12, 16, 19, 25" ;
        schema:name "Chick E8-E16 integer circumferential mode count on the tube (mean |n_quantized - n_ridges_obs|)" ;
        schema:unitText "ridges" ;
        schema:value "0.2" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e8-e16-integer-circumferential-mode-count-on-the-tube-mean-n-quantized-n-ridges-obs-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e8-e16-integer-circumferential-mode-count-on-the-tube-mean-n-quantized-n-ridges-obs-reference> a schema:PropertyValue ;
        dcterms:source "Shyer et al. (2013) Science 342:212-218 Fig. 1 & Fig. 2 ridge counts per circumference" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-cross-species-log-log-quartic-length-scale-exponent-alpha-lambda-ell-alpha> a schema:PropertyValue,
            pk:EvidenceItem ;

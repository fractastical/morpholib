    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/epithelial_buckling_crypt_villus/pass3_citations.bib L1–L45" ;
        dcterms:description "Shyer 2015 Cell, Walton 2016 Development, Donnell 1933 NACA, Timoshenko & Goodier 1970 (DOIs recorded offline, not re-verified online)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/datasets/epithelial_buckling_crypt_villus/pass3_citations.bib#L1-L45> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/epithelial_buckling_crypt_villus/README.md L45–L57" ;
        dcterms:description "Pass 3 section: ring-FEM and Shh/BMP cluster model statement, new vendored files, residuals carried to Pass 4" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/datasets/epithelial_buckling_crypt_villus/README.md#L45-L57> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2011) PRL & Shyer et al. (2013) Science sequential smooth-muscle mucosal buckling into ridges, zigzags, and hexagonal villi — Source and data traceability: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Six dataset files are SHA-256-pinned and verified fail-closed at every run (`EXPECTED_SHA256`, L145-165; `verify_dataset_integrity`, L179-191), including the two Pass 3 additions `tubular_shh_bmp_reference.json` and `pass3_citations.bib`; the bib files carry DOIs for Shyer 2013, Hannezo 2011, Tallinen 2013, Walton 2012, Shyer 2015 and Walton 2016 plus Donnell 1933 and Timoshenko & Goodier 1970; the dataset README has a Pass 3 section stating the model and the residuals. Deductions: the Shyer 2015 and Walton 2016 DOIs were recorded offline and not re-verified during this audit (-2); the stage-resolved E_e, E_s, H_s, epsilon_x, epsilon_y, alpha_3 in `epithelial_buckling_crypt_villus_reference.json` are fitted values that reproduce lambda_obs with C_LAMBDA_PREFACTOR = 0.5690 and are not traceable to measurements in Shyer 2013 (-4); the chick lumen radii and ridge counts in the new reference table are stated per stage without figure/page pinpoints (-2); the specimen's species and age are unknown (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "2013-shyer-intestinal-villi-buckling.py L127–L127: C_LAMBDA_PREFACTOR = 0.5690 — the stage moduli in the reference JSON were fitted so that the flat model with this prefactor reproduces lambda_obs; not traceable to measured values <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L127-L127>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-source-traceability-4> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;

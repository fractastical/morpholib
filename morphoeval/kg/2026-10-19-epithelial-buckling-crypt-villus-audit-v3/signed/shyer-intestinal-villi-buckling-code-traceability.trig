sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-shyer-intestinal-villi-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2011) PRL & Shyer et al. (2013) Science sequential smooth-muscle mucosal buckling into ridges, zigzags, and hexagonal villi — Code-to-model traceability: 89/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module header (L1-89) maps every equation to Shyer 2013 Figs. 1-4, Hannezo 2011 Eqs. (5)-(11), Tallinen 2013, Walton 2012/2016, Shyer 2015, Lamé/Timoshenko §28 and Donnell, and names the six Lean theorems; the Pass 3 functions carry docstrings that state the reduction (axisymmetric, rigid wall, curvature-proxy Shh) and the Lean law each implements; the math-KG YAML registers 5 laws with single `file#La-Lb` code loci. Deductions: unsourced literals remain — the 0.92 in the theta fallback (L669), the 155*sqrt(dex+0.8 dey) amplitude fallback (L782), the 0.85/0.15 surface and wavelength blends (L732, L802), mu_eff = 1.25 (dex + 0.85 dey) (L652), the |Psi_6| literals (L811-815) and theta = 58.5 (L677) (-6); the five Pass 3 tunables are described as modelling choices without a cited anchor (-3); the handoff's own admission that the direct Shyer-2015 exp(-d/ell) elbow test gave index < 1 is in a docstring but not surfaced in the figure or measurement notes (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2013-shyer-intestinal-villi-buckling.py L652–L652: mu_eff = 1.25 (dex + 0.85 dey): uncited effective-load constants <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L652-L652>",
            "2013-shyer-intestinal-villi-buckling.py L669–L669: theta fallback atan(sqrt(dey/dex) 0.92): unsourced 0.92 <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L669-L669>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-code-traceability-3> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L1–L89" ;
        dcterms:description "Module docstring (v3): equation-to-paper map for Hannezo/Shyer/Tallinen/Walton/Shyer-2015/Lamé/Donnell and the six Lean theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L1-L89> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L290–L365" ;
        dcterms:description "tubular_neo_hookean_foundation docstring states the axisymmetric plane-strain reduction, rigid outer wall and Lamé verification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L290-L365> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/shyer-intestinal-villi-buckling.yaml L1–L120" ;
        dcterms:description "5 registered laws with single file#La-Lb code_locus (Laws 4-5 added in Pass 3, Laws 1-3 loci refreshed)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/math_kg_loops/shyer-intestinal-villi-buckling.yaml#L1-L120> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 063 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


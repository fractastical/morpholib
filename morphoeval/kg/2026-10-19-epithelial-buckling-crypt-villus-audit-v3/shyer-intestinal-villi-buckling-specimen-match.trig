sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-shyer-intestinal-villi-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2011) PRL & Shyer et al. (2013) Science sequential smooth-muscle mucosal buckling into ridges, zigzags, and hexagonal villi — Morphological realism / specimen match: 84/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The comparison figure now overlays cluster outlines on the FvK cascade and the new tubular_shh_bmp figure shows the ring-FEM profile against Lamé, tube vs flat wavelength with n and gamma per stage, E14 Shh clusters at the elbows and E16 clusters on the villus tips; the integer ridge counts 10/12/16/19/26 against observed 10/12/16/19/25 (mean |dn| = 0.2) and the E16 1.19 clusters per villus are genuine, unprescribed matches to Shyer 2013 and Walton 2012-type observations. Deductions: the amplitude panels and GIF compare an amplitude that was rescaled to the observed stage value (L779-782), so their match is circular (-5); the SHA-pinned specimen is a terminal-ileum H&E section of unknown species and age with no pixel scale, compared with chick E16 hexagonal order via a hard-coded ROI [60:660, 80:880] and Delaunay edge bounds 40-185 px (L1109, L1148) (-5); the cluster-enrichment comparison has only a null reference of 1.0, not a measured enrichment from the papers (-3); the 2D height field is developable so the elbow dome curvature the papers describe cannot appear in the rendered surface (-2); the ridge-count match and the explicit ablation panels are credited (+2 net vs. a flat deduction)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2013-shyer-intestinal-villi-buckling.py L1101–L1188: segment_intestinal_villi_specimen: hard-coded ROI [60:660, 80:880], DoG sigmas 18/45, percentiles 28/55, Delaunay edge bounds 40-185 px, no pixel scale; specimen is a terminal-ileum section of unknown species <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L1101-L1188>",
            "2013-shyer-intestinal-villi-buckling.py L779–L782: Amplitude rescaled to target_amplitude_um = observed stage amplitude; non-target fallback 155*sqrt(dex+0.8 dey) is an unsourced constant — amplitude panels are circular <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L779-L782>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-specimen-match-4> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/epithelial_buckling_crypt_villus_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure (v3 title): FvK cascade with Shh/BMP cluster outlines overlaid, 3-species collapse, FK506/slit controls, specimen Delaunay graph, villus/crypt cross-section — docs/media/epithelial_buckling_crypt_villus_comparison.png: rendered output of 2013-shyer-intestinal-villi-buckling.py at 45670cb8, image/png, 1135536 B, 2622×1412 px, artifact_sha256 a1cc184d192301cde6a1045c99e0774008edf896123bc90cac8a1251cb7ea1a5 (sha256 a1cc184d192301cde6a1045c99e0774008edf896123bc90cac8a1251cb7ea1a5), spec_fingerprint da01f54f3142bab9fe39c5f26bd338e06f8c4d88ac4dfcc5ab72c0d0def8016a" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/epithelial_buckling_crypt_villus_tubular_shh_bmp.png (generated output)" ;
        dct:description "New 4-panel Pass 3 figure: ring-FEM vs Lamé radial displacement, tube vs flat lambda with quantised n and Donnell gamma per stage, E14 Shh field + clusters at zigzag elbows, E16 clusters on villus tips — docs/media/epithelial_buckling_crypt_villus_tubular_shh_bmp.png: rendered output of 2013-shyer-intestinal-villi-buckling.py at 45670cb8, image/png, 425199 B, 1960×1400 px, artifact_sha256 64830d89c5815241a4ab3824f4d6eaa8023eed4b8000f7d23c90caa3afedec39 (sha256 64830d89c5815241a4ab3824f4d6eaa8023eed4b8000f7d23c90caa3afedec39), spec_fingerprint da01f54f3142bab9fe39c5f26bd338e06f8c4d88ac4dfcc5ab72c0d0def8016a" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L1436–L1536" ;
        dct:description "render_tubular_shh_bmp_figure builds the four Pass 3 panels from the ring FEM, stage table and cluster fields" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L1436-L1536> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L986–L1053" ;
        dct:description "evaluate_tubular_chick_coupling: 6-stage table with quantised mode counts vs observed ridge counts (mean |dn| 0.2), flat vs tube vs prestrain RMSE, FEM-vs-Lamé max error" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L986-L1053> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 063 Pass 3 Phase B Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


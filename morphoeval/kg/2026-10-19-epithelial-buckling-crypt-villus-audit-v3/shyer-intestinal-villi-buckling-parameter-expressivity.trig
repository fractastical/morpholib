sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-shyer-intestinal-villi-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2011) PRL & Shyer et al. (2013) Science sequential smooth-muscle mucosal buckling into ridges, zigzags, and hexagonal villi — Parameter expressivity: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Spans 6 chick stages (E6-E16), 12 developmental points across 3 species, 5 FK506/surgical conditions, and now three mechanistic switches — `--no-tubular` (flat Winkler bed, curvature factor 1.0), `--no-shh-bmp` (0 clusters, 0 bulge) and `--neo-hookean-prestrain` (prestrain tangent, factor > 2 at E16, shorter lambda) — alongside `--epsilon-x`, `--epsilon-y`, `--alpha3`, `--E-ratio-scale`, `--seed` (L1943-1952), all wired through `relax_fvk_mucosal_surface` (L517-534) and shown to change the output in the self-test. Deductions: when the observed targets are passed (the default stage sweep, L877, and the controls, L1075) the amplitude and zigzag angle do not respond to epsilon_x/epsilon_y/alpha_3 because they are overwritten by the targets, so the mechanical parameters control regime and wavelength but not amplitude or chevron angle (-6); the five Pass 3 tunables SHH_BMP_CUBIC_GAIN, ELBOW_DOME_GAIN, SHH_CLUSTER_QUANTILE, SHH_TRUST_FRACTION and diffusion_length_frac (L136-142, L426-427) are module constants without CLI exposure or a sweep (-3); the prestrain variant is reported but no sweep over the muscle-wall stiffness or H_s/R is rendered (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2013-shyer-intestinal-villi-buckling.py L1056–L1098: evaluate_fk506_and_surgical_controls: 5 conditions reuse the prescribed-amplitude machinery (target_amplitude_um = amplitude_obs_um, L1075); only regime/zero-amplitude logic is predictive <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L1056-L1098>",
            "2013-shyer-intestinal-villi-buckling.py L136–L142: Pass 3 tunables SHH_BMP_CUBIC_GAIN 0.60, ELBOW_DOME_GAIN 1.0, SHH_CLUSTER_QUANTILE 0.82, SHH_TRUST_FRACTION 0.30 are module constants with no CLI exposure or empirical anchoring <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L136-L142>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-parameter-expressivity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L1941–L1952" ;
        dct:description "CLI: --self-test, --skip-gif, --epsilon-x, --epsilon-y, --alpha3, --E-ratio-scale, --seed, --no-tubular, --no-shh-bmp, --neo-hookean-prestrain" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L1941-L1952> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L517–L534" ;
        dct:description "relax_fvk_mucosal_surface signature exposing tubular_coupling, prestrain_stiffening, shh_bmp_coupling, shh_bmp_gain and target_amplitude_um" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L517-L534> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L846–L911" ;
        dct:description "evaluate_chick_stages: 6-stage sweep with CLI overrides; target_amplitude_um taken from amplitude_obs_um unless overrides are given (L877)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2013-shyer-intestinal-villi-buckling.py#L846-L911> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 063 Pass 3 Phase B Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


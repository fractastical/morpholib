<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila affinis Turing wavenumber at 2.4 µm (Holocene, detail tier) — Code-to-model traceability: 85/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Each modelling step is a named function tied to an equation in the docstring: kinetics, sigma_analytical, classical_wavelength, calibrate_du_to_target_wavelength, ablation_sigma, simulate_schnakenberg. Lean theorems detail_wavelength_below_chronospecies, homogeneous_steady_state_stable, diffusion_driven_instability_at_detail_scale, and equal_diffusivity_ablation_not_turing have no sorry." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-code-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-code-traceability-2> ;
    pk:hasScore 8.5e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila affinis Turing wavenumber at 2.4 µm (Holocene, detail tier) — Model fidelity to source: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Pass 2 keeps the published Jacobian and dispersion relation and adds an explicit bisection so the fastest-growing mode, which is the mode the nonlinear field selects, lies on the assigned 2.444 µm scale. The determinant minimizer at that Du (2.251 µm) is still computed and labeled as a different wavenumber. Kinetics remain the standard Schnakenberg system, not a fly-specific measured Jacobian." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .


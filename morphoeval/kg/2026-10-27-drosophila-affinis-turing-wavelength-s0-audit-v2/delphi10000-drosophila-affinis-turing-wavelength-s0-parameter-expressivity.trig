sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila affinis Turing wavenumber at 2.4 µm (Holocene, detail tier) — Parameter expressivity: 87/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "With the classical wavelength held at 2.444 µm, peak growth rate rises monotonically across Dv/Du = 7.63, 8.5, 10, 12, 16, 24. Dv = Du is a negative control (sigma_max = -0.099). The Pass-2 bisection shows Du itself moves the selected wavelength onto the assigned scale." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-affinis-turing-wavelength-s0.py L198–L226" ;
        dct:description "ratio_sweep and ablation_sigma" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-affinis-turing-wavelength-s0.py#L198-L226> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-affinis-turing-wavelength-s0.py L237–L257" ;
        dct:description "Du bisection, the wavelength control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-affinis-turing-wavelength-s0.py#L237-L257> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;

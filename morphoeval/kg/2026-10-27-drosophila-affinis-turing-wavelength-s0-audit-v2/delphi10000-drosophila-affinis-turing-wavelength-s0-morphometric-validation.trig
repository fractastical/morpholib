        schema:name "specimen_contour_circularity" ;
        schema:unitText "1" ;
        schema:value "0.10793" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "a circle would score 1; the fly does not" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila affinis Turing wavenumber at 2.4 µm (Holocene, detail tier) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r = 0.9991 against a 0.98 floor, RMSE = 0.0117 against an ideal residual of 0. Nonlinear stripe wavelength 2.432 µm against reference 2.444 µm. Fastest mode 2.443 µm against the determinant wavelength 2.251 µm. Specimen foreground 0.221 against rendered 0.299. Orientation KS 0.0025 against 0.05. Circularity 0.108 against a circle's 1. None of these pairs are copies. The sample is one photograph." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-ablation-max-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-classical-turing-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-dispersion-sigma-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-dispersion-sigma-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-fastest-mode-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-nonlinear-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-orientation-histogram-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-patterned-max-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-rendered-habitus-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-wavelength-ratio-vs-americana>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-wavelength-ratio-vs-berryi>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-ablation-max-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_max_growth_rate = -0.098997 1/time" ;
        dct:description "control versus the patterned ratio-10 run" ;
        schema:measurementTechnique "max_k σ(k) with Dv = Du (equal diffusivity negative control)" ;
        schema:name "ablation_max_growth_rate" ;
        schema:unitText "1/time" ;
        schema:value "-0.098997" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-ablation-max-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-ablation-max-growth-rate-reference> a schema:PropertyValue ;
        dct:source "Turing condition fails when the trace coefficient is negative" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-classical-turing-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "classical_turing_wavelength = 2.444 µm" ;
        dct:description "value is the solved classical wavelength, reference is the rounded tier label" ;
        schema:measurementTechnique "k_c^2 = (Dv f_u + Du g_v) / (2 Du Dv); lambda = 2 pi / k_c" ;
        schema:name "classical_turing_wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.444" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-classical-turing-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-classical-turing-wavelength-reference> a schema:PropertyValue ;
        dct:source "slot assignment 2.4 µm; solved value is 2.444 µm" ;
        schema:value "2.4" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-dispersion-sigma-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_sigma_pearson_r = 0.999142 1" ;
        dct:description "RMSE of the same residuals is reported separately" ;
        schema:measurementTechnique "Pearson r between continuum σ(k) and discrete-Laplacian Euler growth, 12 wavenumbers" ;
        schema:name "dispersion_sigma_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.999142" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-dispersion-sigma-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-dispersion-sigma-pearson-r-reference> a schema:PropertyValue ;
        dct:source "loop goodness-of-fit floor; not a copy of the measured r" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-dispersion-sigma-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_sigma_rmse = 0.011665 1/time" ;
        schema:measurementTechnique "RMSE of numerical minus analytical σ(k)" ;
        schema:name "dispersion_sigma_rmse" ;
        schema:unitText "1/time" ;
        schema:value "0.011665" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-dispersion-sigma-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-dispersion-sigma-rmse-reference> a schema:PropertyValue ;
        dct:source "ideal continuum residual" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-fastest-mode-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fastest_mode_wavelength = 2.442842 µm" ;
        dct:description "the two wavenumbers differ above onset; the pattern follows the fastest mode" ;
        schema:measurementTechnique "argmax_k σ(k) after Du is calibrated so this peak sits on the assigned 2.444 µm scale" ;
        schema:name "fastest_mode_wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.442842" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-fastest-mode-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-fastest-mode-wavelength-reference> a schema:PropertyValue ;
        dct:source "determinant-minimizing wavelength at the same Du, Dv" ;
        schema:value "2.251481424903267" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-nonlinear-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nonlinear_stripe_wavelength = 2.431871 µm" ;
        schema:measurementTechnique "dominant Fourier bin of the periodic Schnakenberg activator after the seeded run" ;
        schema:name "nonlinear_stripe_wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.431871" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-nonlinear-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-nonlinear-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "simulation FFT versus classical lambda_c" ;
        schema:value "2.444" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-orientation-histogram-ks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "orientation_histogram_ks = 0.002469 1" ;
        schema:measurementTechnique "KS distance between 12-bin Sobel orientation histograms of specimen and last GIF frame" ;
        schema:name "orientation_histogram_ks" ;
        schema:unitText "1" ;
        schema:value "0.002469" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-orientation-histogram-ks-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-orientation-histogram-ks-reference> a schema:PropertyValue ;
        dct:source "conventional KS screening level, not the measured distance" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-patterned-max-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "patterned_max_growth_rate = 0.10944 1/time" ;
        schema:measurementTechnique "max_k σ(k) at Dv/Du = 10 and lambda_c = 2.444 µm" ;
        schema:name "patterned_max_growth_rate" ;
        schema:unitText "1/time" ;
        schema:value "0.10944" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-patterned-max-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-patterned-max-growth-rate-reference> a schema:PropertyValue ;
        dct:source "same Jacobian, diffusivity ratio raised from 1 to 10" ;
        schema:value "-0.09899657029629944" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-rendered-habitus-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "rendered_habitus_foreground_fraction = 0.299285 1" ;
        dct:description "the bottom activator strip changes the mask, so this is not equal to the specimen value" ;
        schema:measurementTechnique "same segmentation applied to the last GIF frame (habitus plus activator strip)" ;
        schema:name "rendered_habitus_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.299285" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-rendered-habitus-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-rendered-habitus-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "specimen foreground fraction" ;
        schema:value "0.221338" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_circularity = 0.10793 1" ;

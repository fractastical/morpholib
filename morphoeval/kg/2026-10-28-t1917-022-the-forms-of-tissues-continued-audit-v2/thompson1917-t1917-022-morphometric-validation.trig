        schema:value "0.4" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-tissue-junction-mean-angle-120> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Tissue junction mean |angle−120°| = 19.3537 deg" ;
        schema:measurementTechnique "Plateau junction metrology on Figs. 178/187/190" ;
        schema:name "Tissue junction mean |angle−120°|" ;
        schema:unitText "deg" ;
        schema:value "19.3537" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-tissue-junction-mean-angle-120-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-tissue-junction-mean-angle-120-reference> a schema:PropertyValue ;
        dct:source "Plateau 180°−line gap" ;
        schema:value "25.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-022_the-forms-of-tissues-continued.py L365–L395" ;
        dct:description "goodness_of_fit" ;

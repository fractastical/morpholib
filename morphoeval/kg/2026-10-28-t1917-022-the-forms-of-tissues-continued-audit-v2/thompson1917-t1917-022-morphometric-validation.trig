sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-022> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-022-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-022-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-022 — isoperimetric/minimal-area hollow & aggregate partitions — Morphometric validation: 65/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "GOF RMSE/r/KS exported; T6 froth KS still fails." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-022_the-forms-of-tissues-continued.py L400–L430: T6 froth KS threshold <https://github.com/fractastical/morpholib/blob/a8bae15d56cf26f6d31eb8cd1b41b5301fdde110/thompson/claims/t1917-022_the-forms-of-tissues-continued.py#L400-L430>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-fig-176-eight-sector-template-match-score>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-fig-177-pluteus-radial-line-index>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-fig-180-pollen-mean-isoperimetric-q>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-froth-best-delta-voronoi-disorder>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-froth-tissue-junction-ks-p-value>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-radiolaria-analogue-mean-q-challenger-plate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-tissue-junction-mean-angle-120>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-morphometric-validation-1> ;
        pk:hasScore "0.65"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-fig-176-eight-sector-template-match-score> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Fig. 176 eight-sector template match score = 0.875 fraction" ;
        schema:measurementTechnique "radial voting vs 8×45° template" ;
        schema:name "Fig. 176 eight-sector template match score" ;
        schema:unitText "fraction" ;
        schema:value "0.875" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-fig-176-eight-sector-template-match-score-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-fig-176-eight-sector-template-match-score-reference> a schema:PropertyValue ;
        dct:source "Thompson Fig. 176" ;
        schema:value "0.75" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-fig-177-pluteus-radial-line-index> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Fig. 177 pluteus radial line index = 0.5868 index" ;
        schema:measurementTechnique "gradient alignment with radial rays" ;
        schema:name "Fig. 177 pluteus radial line index" ;
        schema:unitText "index" ;
        schema:value "0.5868" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-fig-177-pluteus-radial-line-index-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-fig-177-pluteus-radial-line-index-reference> a schema:PropertyValue ;
        dct:source "Ophiurid pluteus" ;
        schema:value "0.15" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-fig-180-pollen-mean-isoperimetric-q> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Fig. 180 pollen mean isoperimetric Q = 0.5442 Q" ;
        schema:measurementTechnique "4πA/P² on segmented grains" ;
        schema:name "Fig. 180 pollen mean isoperimetric Q" ;
        schema:unitText "Q" ;
        schema:value "0.5442" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-fig-180-pollen-mean-isoperimetric-q-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-fig-180-pollen-mean-isoperimetric-q-reference> a schema:PropertyValue ;
        dct:source "isoperimetric circle" ;
        schema:value "0.52" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-froth-best-delta-voronoi-disorder> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Froth best delta (Voronoi disorder) = 0.55" ;
        schema:measurementTechnique "min mean |angle−120| over delta×Lloyd grid" ;
        schema:name "Froth best delta (Voronoi disorder)" ;
        schema:value "0.55" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-froth-best-delta-voronoi-disorder-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-froth-best-delta-voronoi-disorder-reference> a schema:PropertyValue ;
        dct:source "parameter sweep" ;
        schema:value "0.15" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-froth-tissue-junction-ks-p-value> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Froth-tissue junction KS p-value = 0.0" ;
        schema:measurementTechnique "two-sample KS on junction angle lists" ;
        schema:name "Froth-tissue junction KS p-value" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-froth-tissue-junction-ks-p-value-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-froth-tissue-junction-ks-p-value-reference> a schema:PropertyValue ;
        dct:source "goodness-of-fit" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-radiolaria-analogue-mean-q-challenger-plate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Radiolaria analogue mean Q (Challenger plate) = 0.4967 Q" ;

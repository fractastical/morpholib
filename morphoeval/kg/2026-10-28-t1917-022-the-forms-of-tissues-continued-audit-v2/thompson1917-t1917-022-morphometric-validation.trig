        schema:name "Radiolaria analogue mean Q (Challenger plate)" ;
        schema:unitText "Q" ;
        schema:value "0.4967" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-radiolaria-analogue-mean-q-challenger-plate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-measurement-radiolaria-analogue-mean-q-challenger-plate-reference> a schema:PropertyValue ;

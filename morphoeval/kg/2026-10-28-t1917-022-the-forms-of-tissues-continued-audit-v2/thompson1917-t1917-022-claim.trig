sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-022> a pk:Claim ;
        rdfs:label "Thompson (1917) T1917-022 — isoperimetric/minimal-area hollow & aggregate partitions faithfully reproduces Ophiurid pluteus; plant tissue partitions; pollen; radiolarian analogues (Commons) morphology" ;
        dct:description "The simulation script(s) thompson/claims/t1917-022_the-forms-of-tissues-continued.py implement the cited source model as published and produce forms that match real Ophiurid pluteus; plant tissue partitions; pollen; radiolarian analogues (Commons) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-022_the-forms-of-tissues-continued.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-022_the-forms-of-tissues-continued.py; output: docs/media/t1917_022_the_forms_of_tissues_continued_comparison.png; organism: Ophiurid pluteus; plant tissue partitions; pollen; radiolarian analogues (Commons); environment: n/a" .
    <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-022_the-forms-of-tissues-continued.py> a schema:SoftwareSourceCode ;
        rdfs:label "thompson/claims/t1917-022_the-forms-of-tissues-continued.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> .
}


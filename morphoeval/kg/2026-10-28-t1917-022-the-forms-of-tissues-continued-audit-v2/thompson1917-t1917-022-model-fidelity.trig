        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_022.lean L24–L88" ;
        dct:description "isoperimetric + Plateau + Fig176" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a8bae15d56cf26f6d31eb8cd1b41b5301fdde110/morphoeval/lean/loops/Thompson1917_T1917_022.lean#L24-L88> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-022-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-022_the-forms-of-tissues-continued.py L210–L280" ;
        dct:description "simulate_voronoi_froth sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a8bae15d56cf26f6d31eb8cd1b41b5301fdde110/thompson/claims/t1917-022_the-forms-of-tissues-continued.py#L210-L280> .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Cloud Loop Slot 217 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


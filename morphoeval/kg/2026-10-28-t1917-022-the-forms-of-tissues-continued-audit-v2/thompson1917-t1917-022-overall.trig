sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-022> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-022-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-022-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-022 — isoperimetric/minimal-area hollow & aggregate partitions — MorphoEval overall 71.6/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Pass 2: 6/7 structure-split tests pass; verdict mixed (catch-all claim + Weaire-Phelan foam caveat). Fig. 176 eight-fold match 0.88, pollen mean Q≈0.54, junctions within 25° of 120° on 35%+ samples, radiolarian analogue Q≈0.50; froth KS still marginal. Overall 71.6/100 (faithfulness 68.8, reproducibility 78.3); rubric morphoeval 0.1.0; checkpoint commit a8bae15d56cf26f6d31eb8cd1b41b5301fdde110; environment: . Dimension assessments: Model fidelity to source 72, Morphological realism / specimen match 68, Parameter expressivity 70, Morphometric validation 65, Source and data traceability 82, Code-to-model traceability 74, Reproducibility package 78. Output judged: docs/media/t1917_022_the_forms_of_tissues_continued_comparison.png: rendered output of thompson/claims/t1917-022_the-forms-of-tissues-continued.py at a8bae15d56cf26f6d31eb8cd1b41b5301fdde110, image/png, 1645444 B, 2100×1350 px, artifact_sha256 722cf2379c51dfd982a3af4d4bdd5e8173b7a559e26ceb72b8140aa898f35035 (sha256 722cf2379c51dfd982a3af4d4bdd5e8173b7a559e26ceb72b8140aa898f35035), spec_fingerprint d5662788b05b86432d342a16505bcc2afe5c80c3c960513c6c22811bd6065d39. Dual provenance: spec_fingerprint: d5662788b05b86432d342a16505bcc2afe5c80c3c960513c6c22811bd6065d39; artifact_sha256: 722cf2379c51dfd982a3af4d4bdd5e8173b7a559e26ceb72b8140aa898f35035; input_dataset_sha256: {datasets/thompson_1917/t1917-022/scout_manifest.json=a3a033535db37a98..., datasets/thompson_1917/t1917-022/t1917_022_the_forms_of_tissues_continued_reference.json=81a2311b2af01bda..., morphoeval/lean/loops/Thompson1917_T1917_022.lean=9420d08a3db775ab...}. Supersedes audit: 2026-10-28-t1917-022-the-forms-of-tissues-continued-audit." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:hasScore "0.716"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Cloud Loop Slot 217 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


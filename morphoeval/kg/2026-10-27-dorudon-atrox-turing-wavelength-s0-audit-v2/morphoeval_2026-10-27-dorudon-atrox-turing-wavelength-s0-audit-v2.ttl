<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Dorudon atrox Turing wavelength at 253 µm, Priabonian 37.0 Ma (pass 2) (Dorudon atrox)",
        "Dorudon atrox Turing wavelength at 253 µm, Priabonian 37.0 Ma (pass 2) faithfully reproduces Dorudon atrox morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-dorudon-atrox-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-dorudon-atrox-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-dorudon-atrox-turing-wavelength-s0-3>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-dorudon-atrox-turing-wavelength-s0-4> ;
    dct:description "The simulation script(s) models/2026-delphi10000-dorudon-atrox-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Dorudon atrox specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-dorudon-atrox-turing-wavelength-s0.py> ;
    schema:about "Dorudon atrox" ;
    schema:additionalProperty "does_not_claim: That 8, 3, and 0 are measured bud lengths",
        "does_not_claim: That the fossil skeleton is a Turing pattern",
        "does_not_claim: That the plate's secondary peak at 93.2 µm is the animal's wavelength",
        "reconstructed_in_script: Domain scenario 8 → 3 → 0 wavelengths at 47 Ma, 37.0 Ma, and 0 Ma",
        "reconstructed_in_script: Radial fit: degree-5 vignette plus J0(k), J0(2k), J0(3k) with k fixed by the 111 px = 100 µm bar",
        "reconstructed_in_script: Schnakenberg parameters solved for lambda_c = 253 µm",
        "reported_in_source: Dorudon atrox as a Priabonian basilosaurid with a vestigial hindlimb (Uhen 2004, 2007; Gingerich et al. 1990)",
        "reported_in_source: Kondo & Asai 1995 and Nakamasu et al. 2009 pigment-cell waves",
        "reported_in_source: Murray 1981 coat pre-pattern",
        "reported_in_source: Turing 1952 critical wavenumber",
        "transfer_boundary: No Dorudon integument is known. The gallery plate is an ocellus with a 100 µm bar, not a thin section." ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Dorudon atrox (Late Eocene (Priabonian, 37.0 Ma))" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "I. Enaima (Vertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Dorudon atrox Turing wavelength at 253 µm, Priabonian 37.0 Ma (pass 2) — Morphological realism / specimen match: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The pass-2 comparison places the gallery plate next to the fitted radial mode. Last-frame CV similarity is 91.1 versus that plate (12 frames, 640×480) and 79.6 versus the Wadi El-Hitan skeleton. Pearson r of the azimuthal means is 0.9918. Deduction: the nonlinear panel is a spot field, the vignette polynomial is phenomenological, and neither image is preserved Dorudon skin." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .

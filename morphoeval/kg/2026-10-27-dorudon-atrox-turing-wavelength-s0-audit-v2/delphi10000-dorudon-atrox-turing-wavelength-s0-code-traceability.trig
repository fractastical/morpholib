sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Dorudon atrox Turing wavelength at 253 µm, Priabonian 37.0 Ma (pass 2) — Code-to-model traceability: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Docstring equations match steady_state, jacobian, diffusion_coefficients, and the chronoseries. The math-kg yaml points at those functions and at the Lean declarations. The vignette polynomial is a fit, not an equation in Turing 1952, and is labelled as such in fit_plate_critical_mode." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-code-traceability-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dorudon-atrox-turing-wavelength-s0.py L1–L68" ;
        dct:description "docstring maps each formula to the implementation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-dorudon-atrox-turing-wavelength-s0.py#L1-L68> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/delphi10000-dorudon-atrox-turing-wavelength-s0.yaml L1–L62" ;
        dct:description "four laws with code_locus and lean_locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/math_kg_loops/delphi10000-dorudon-atrox-turing-wavelength-s0.yaml#L1-L62> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder and assessor, single-agent cloud loop; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


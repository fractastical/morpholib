    <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Douady & Couder (1992, 1996) self-organized magnetic-drop phyllotaxis & imperfect pitchfork cascade — Morphological realism / specimen match: 88/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the CC BY-SA 4.0 apical *Pinus* conifer seed cone specimen (`datasets/magnetic_drop_phyllotaxis/conifer_cone_specimen.jpg`) and performs Difference-of-Gaussians (DoG) scale-umbo segmentation (N = 123 scales around apex (316, 307)) and log-polar (u = ln r, theta) 2D FFT spectral extraction on annulus r in [55, 240] px (L648-727), identifying dominant opposing spiral harmonics m_CW = 5 and m_CCW = 8 that match the simulated (5, 8) Delaunay contact parastichy lattice at G = 0.06 (Panels C1-C3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .


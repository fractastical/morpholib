        <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-specimen-cw-parastichy-count>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-bifurcation-branch-pearson-r>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-divergence-angle-g006-exp>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-divergence-angle-g006-linear-dish>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-lucas-branch-divergence-angle-g006>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-memory-ablation-control-nmem1-divergence-deg>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-pitchfork-threshold-g-c1-exponential-2drop>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-pitchfork-threshold-g-c1-linear-2drop>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-voronoi-area-cv-dipole-vs-random-control>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-morphometric-validation-1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-morphometric-validation-2>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-morphometric-validation-3> ;

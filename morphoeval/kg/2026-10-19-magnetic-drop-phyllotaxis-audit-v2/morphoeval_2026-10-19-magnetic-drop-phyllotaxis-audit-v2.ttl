        <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-magnetic-drop-phyllotaxis-audit-v2-douady-magnetic-drop-phyllotaxis-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-magnetic-drop-phyllotaxis-audit-v2-douady-magnetic-drop-phyllotaxis-10>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-magnetic-drop-phyllotaxis-audit-v2-douady-magnetic-drop-phyllotaxis-2>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-magnetic-drop-phyllotaxis-audit-v2-douady-magnetic-drop-phyllotaxis-3>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-magnetic-drop-phyllotaxis-audit-v2-douady-magnetic-drop-phyllotaxis-4>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-magnetic-drop-phyllotaxis-audit-v2-douady-magnetic-drop-phyllotaxis-5>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-magnetic-drop-phyllotaxis-audit-v2-douady-magnetic-drop-phyllotaxis-6>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-magnetic-drop-phyllotaxis-audit-v2-douady-magnetic-drop-phyllotaxis-7>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-magnetic-drop-phyllotaxis-audit-v2-douady-magnetic-drop-phyllotaxis-8>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-magnetic-drop-phyllotaxis-audit-v2-douady-magnetic-drop-phyllotaxis-9> ;
    pk:hypothesisType "Iterative Repulsive Energy Phyllotaxis" ;
    pk:weightOfEvidence 9.1e-01 .


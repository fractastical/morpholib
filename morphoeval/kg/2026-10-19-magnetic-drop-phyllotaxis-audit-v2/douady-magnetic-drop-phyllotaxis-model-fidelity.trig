sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-douady-magnetic-drop-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Douady & Couder (1992, 1996) self-organized magnetic-drop phyllotaxis & imperfect pitchfork cascade — Model fidelity to source: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Faithfully implements Douady & Couder's (1992) Eqs. (1)-(3) and (1996) Part I Sec. 2-3 iterative dipole minimization phi_n = argmin_phi sum_{k>=1} d_k(phi, phi_{n-k})^{-gamma} with sub-grid bounded Brent refinement under both linear dish advection r_k = R_0*(1+k*G) and exponential meristem advection r_k = R_0*exp(k*G) (L140-226), alongside the exact static Hessian fold and dynamical pitchfork bifurcation equations (L232-287) and regular-spiral zero-force equilibrium solver F(G, dphi) = 0 (L289-371), backed by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_031_magnetic_drop_phyllotaxis.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L140–L226" ;
        dct:description "Linear and exponential radial advection and dipole repulsion minimization with bounded Brent refinement" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1992-douady-magnetic-drop-phyllotaxis.py#L140-L226> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L232–L371" ;
        dct:description "Exact pitchfork thresholds, Lean 4 integer discriminant C(r1,r2), and regular-spiral equilibrium F(G, dphi) = 0 solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1992-douady-magnetic-drop-phyllotaxis.py#L232-L371> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_031_magnetic_drop_phyllotaxis.lean L18–L92" ;
        dct:description "3 machine-checked Lean 4 theorems (0 sorrys) for opposition maximization, pitchfork curvature sign change, and Fibonacci vs Lucas cascades" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_031_magnetic_drop_phyllotaxis.lean#L18-L92> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0024>,
            <https://doi.org/10.1006/jtbi.1996.0025>,
            <https://doi.org/10.1103/PhysRevLett.68.2098>,
            <https://doi.org/10.1209/0295-5075/14/6/006> .
    <https://doi.org/10.1006/jtbi.1996.0024> dct:date "1996"^^xsd:gYear ;
        dct:title "Phyllotaxis as a Dynamical Self Organizing Process Part I: The Spiral Modes Resulting from Time-Periodic Iterations" .
    <https://doi.org/10.1006/jtbi.1996.0025> dct:date "1996"^^xsd:gYear ;
        dct:title "Phyllotaxis as a Dynamical Self Organizing Process Part II: The Spontaneous Formation of a Periodicity and the Coexistence of Spiral and Whorled Modes" .
    <https://doi.org/10.1103/PhysRevLett.68.2098> dct:date "1992"^^xsd:gYear ;
        dct:title "Phyllotaxis as a physical self-organized growth process" .
    <https://doi.org/10.1209/0295-5075/14/6/006> dct:date "1991"^^xsd:gYear ;
        dct:title "Energetic Approach to Phyllotaxis" .
}


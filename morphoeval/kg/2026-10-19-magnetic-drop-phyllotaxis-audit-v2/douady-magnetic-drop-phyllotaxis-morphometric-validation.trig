sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-douady-magnetic-drop-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Douady & Couder (1992, 1996) self-organized magnetic-drop phyllotaxis & imperfect pitchfork cascade — Morphometric validation: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Validates 10 quantitative morphometric endpoints in `measure_morphoeval()` (L1074-1159): Fibonacci branch Pearson r = 0.99999 (RMSE = 0.065 deg, p = 2.09e-18 across 10 benchmark G points), Lucas branch RMSE = 0.141 deg across 6 benchmark G points, Golden Angle convergence 137.3168 deg (exp) and 137.4892 deg (linear dish) vs 137.5078 deg at G = 0.06, Lucas branch divergence 101.7031 deg at G = 0.11 with Delaunay pair (4, 7), exact 2-drop pitchfork roots G_fold = 0.773484 (exp) and 2.514560 (lin), single-drop memory ablation N_mem = 1 locking at 180.0 deg, Voronoi cell area regularity CV = 0.132 vs random placement CV = 0.612 (two-sample KS p < 1e-8), and conifer cone 2D FFT parastichy pair (5, 8)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-specimen-ccw-parastichy-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-specimen-cw-parastichy-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-bifurcation-branch-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-divergence-angle-g006-exp>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-divergence-angle-g006-linear-dish>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-lucas-branch-divergence-angle-g006>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-memory-ablation-control-nmem1-divergence-deg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-pitchfork-threshold-g-c1-exponential-2drop>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-pitchfork-threshold-g-c1-linear-2drop>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-voronoi-area-cv-dipole-vs-random-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-morphometric-validation-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-specimen-ccw-parastichy-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "conifer_cone_specimen_ccw_parastichy_count = 8 spirals" ;
        schema:measurementTechnique "Log-polar 2D FFT dominant CCW spiral mode on Pinus sp. specimen (N=123 segmented scales)" ;
        schema:name "conifer_cone_specimen_ccw_parastichy_count" ;
        schema:unitText "spirals" ;
        schema:value "8" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-specimen-ccw-parastichy-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-specimen-ccw-parastichy-count-reference> a schema:PropertyValue ;
        schema:value "8" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-specimen-cw-parastichy-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "conifer_cone_specimen_cw_parastichy_count = 5 spirals" ;
        schema:measurementTechnique "Log-polar 2D FFT dominant CW spiral mode on Pinus sp. specimen confirming Fibonacci (5, 8) pair" ;
        schema:name "conifer_cone_specimen_cw_parastichy_count" ;
        schema:unitText "spirals" ;
        schema:value "5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-specimen-cw-parastichy-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-specimen-cw-parastichy-count-reference> a schema:PropertyValue ;
        schema:value "5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-bifurcation-branch-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fibonacci_bifurcation_branch_pearson_r = 0.99999 r" ;
        schema:measurementTechnique "Pearson correlation across 10 benchmark G points (RMSE=0.0650 deg, p=8.07e-20)" ;
        schema:name "fibonacci_bifurcation_branch_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.99999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-bifurcation-branch-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-bifurcation-branch-pearson-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-divergence-angle-g006-exp> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fibonacci_divergence_angle_G006_exp = 137.32 deg" ;
        schema:measurementTechnique "Iterative dipole minimization (gamma=3, exponential advection, G=0.06, SD=0.0136 deg)" ;
        schema:name "fibonacci_divergence_angle_G006_exp" ;
        schema:unitText "deg" ;
        schema:value "137.32" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-divergence-angle-g006-exp-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-divergence-angle-g006-exp-reference> a schema:PropertyValue ;
        schema:value "137.5078" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-divergence-angle-g006-linear-dish> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fibonacci_divergence_angle_G006_linear_dish = 137.6761 deg" ;
        schema:measurementTechnique "Linear silicone-oil dish advection r_k = R_0(1+k*G) at G=0.06 (SD=0.0213 deg)" ;
        schema:name "fibonacci_divergence_angle_G006_linear_dish" ;
        schema:unitText "deg" ;
        schema:value "137.6761" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-divergence-angle-g006-linear-dish-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-divergence-angle-g006-linear-dish-reference> a schema:PropertyValue ;
        schema:value "137.5078" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-lucas-branch-divergence-angle-g006> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "lucas_branch_divergence_angle_G006 = 101.6987 deg" ;
        schema:measurementTechnique "Disconnected Lucas saddle-node branch (1,3)->(4,7) at G=0.11 (SD=0.0001 deg)" ;
        schema:name "lucas_branch_divergence_angle_G006" ;
        schema:unitText "deg" ;
        schema:value "101.6987" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-lucas-branch-divergence-angle-g006-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-lucas-branch-divergence-angle-g006-reference> a schema:PropertyValue ;
        schema:value "99.5016" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-memory-ablation-control-nmem1-divergence-deg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "memory_ablation_control_Nmem1_divergence_deg = 180.0 deg" ;
        schema:measurementTechnique "Single-drop memory ablation control (N_mem=1 at G=0.06) vs N_mem=45 baseline (137.32 deg)" ;
        schema:name "memory_ablation_control_Nmem1_divergence_deg" ;
        schema:unitText "deg" ;
        schema:value "180.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-memory-ablation-control-nmem1-divergence-deg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-memory-ablation-control-nmem1-divergence-deg-reference> a schema:PropertyValue ;
        schema:value "180.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-pitchfork-threshold-g-c1-exponential-2drop> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pitchfork_threshold_G_c1_exponential_2drop = 0.773484 dimensionless" ;
        schema:measurementTechnique "Exact 2-drop Hessian fold root r_1/(r_1+1)^5 = r_2/(r_2-1)^5 (dynamical root G_c1=0.860537)" ;
        schema:name "pitchfork_threshold_G_c1_exponential_2drop" ;
        schema:unitText "dimensionless" ;
        schema:value "0.773484" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-pitchfork-threshold-g-c1-exponential-2drop-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-pitchfork-threshold-g-c1-exponential-2drop-reference> a schema:PropertyValue ;
        schema:value "0.773484" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-pitchfork-threshold-g-c1-linear-2drop> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pitchfork_threshold_G_c1_linear_2drop = 2.51456 dimensionless" ;
        schema:measurementTechnique "Exact linear advection 2-drop root (1+G)/(2+G)^5 = (1+2G)/(2G)^5 verified by Lean 4 Theorem 2" ;
        schema:name "pitchfork_threshold_G_c1_linear_2drop" ;
        schema:unitText "dimensionless" ;
        schema:value "2.51456" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-pitchfork-threshold-g-c1-linear-2drop-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-pitchfork-threshold-g-c1-linear-2drop-reference> a schema:PropertyValue ;
        schema:value "2.51456" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-voronoi-area-cv-dipole-vs-random-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "voronoi_area_cv_dipole_vs_random_control = 0.0013 CV" ;
        schema:measurementTechnique "Voronoi cell area CV for dipole repulsion vs random placement control (CV=0.6318, KS p=8.79e-09)" ;
        schema:name "voronoi_area_cv_dipole_vs_random_control" ;
        schema:unitText "CV" ;
        schema:value "0.0013" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-voronoi-area-cv-dipole-vs-random-control-reference> .

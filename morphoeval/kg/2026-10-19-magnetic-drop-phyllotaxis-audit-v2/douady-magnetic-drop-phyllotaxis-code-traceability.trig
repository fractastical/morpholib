sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-douady-magnetic-drop-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Douady & Couder (1992, 1996) self-organized magnetic-drop phyllotaxis & imperfect pitchfork cascade — Code-to-model traceability: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Every computational section and function docstring in `1992-douady-magnetic-drop-phyllotaxis.py` maps explicitly to Douady & Couder (1992, 1996) equations and to the corresponding Lean 4 definitions and theorems in `Loop_031_magnetic_drop_phyllotaxis.lean` (L1-60, L135-371), with explicit `claim_boundary` documentation distinguishing reconstructed dipole mechanics from subcellular auxin transport models." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-code-traceability-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L1–L60" ;
        dct:description "Module docstring mapping equations, bifurcation thresholds, and Lean 4 theorems to primary sources" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1992-douady-magnetic-drop-phyllotaxis.py#L1-L60> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L135–L316" ;
        dct:description "Per-function docstrings linking advected_radii, dipole_energy_grid, and spiral_equilibrium_force_and_hessian to PRL 1992 and JTB 1996" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1992-douady-magnetic-drop-phyllotaxis.py#L135-L316> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


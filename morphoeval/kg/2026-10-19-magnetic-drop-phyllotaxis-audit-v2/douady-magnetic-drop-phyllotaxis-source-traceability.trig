        rdfs:label "Douady & Couder (1992, 1996) self-organized magnetic-drop phyllotaxis & imperfect pitchfork cascade — Source and data traceability: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Complete bibliographic, mathematical, and dataset provenance linking Douady & Couder (1992) PRL 68:2098, Douady & Couder (1996) JTB Parts I & II (178:255-294), and Levitov (1991) EPL 14:533 in `datasets/magnetic_drop_phyllotaxis/paper_citations.bib`, tabulated bifurcation benchmarks in `datasets/magnetic_drop_phyllotaxis/magnetic_drop_phyllotaxis_reference.json`, formalized mathematical KG entry in `morphoeval/math_kg_loops/douady-magnetic-drop-phyllotaxis.yaml`, and 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_031_magnetic_drop_phyllotaxis.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "datasets/magnetic_drop_phyllotaxis/magnetic_drop_phyllotaxis_reference.json L1–L130" ;
        dct:description "Primary-source experimental and numerical benchmark dataset from Douady & Couder (1992, 1996)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/datasets/magnetic_drop_phyllotaxis/magnetic_drop_phyllotaxis_reference.json#L1-L130> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/magnetic_drop_phyllotaxis/paper_citations.bib L1–L42" ;
        dct:description "Complete BibTeX citations with DOIs for Douady & Couder (1992, 1996a, 1996b) and Levitov (1991)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/datasets/magnetic_drop_phyllotaxis/paper_citations.bib#L1-L42> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/douady-magnetic-drop-phyllotaxis.yaml L1–L95" ;

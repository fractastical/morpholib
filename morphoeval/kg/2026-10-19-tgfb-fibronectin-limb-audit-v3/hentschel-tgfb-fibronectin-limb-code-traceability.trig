sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hentschel-tgfb-fibronectin-limb> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B / Kiskowski et al. (2004) Dev. Biol. multiscale TGF-beta / FGF-inhibitor reaction-diffusion and fibronectin haptotaxis PDE in developing Gallus gallus limb bud, coupled to a Glazier-Graner-Hogeweg cellular Potts cell lattice — Code-to-model traceability: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring (L1-95) maps the GGH module to Graner & Glazier (1992), Glazier & Graner (1993), Savill & Hogeweg (1997), Chaturvedi (2005) and Tapia & D'Souza (2011) and names the volume-filling source; the function docstring (L698-724) states the Hamiltonian, the copy energy, the acceptance rule, the coupling laws and the parallel approximation; inline comments mark the three coupling steps (L790, L796, L800); the math KG (`hentschel-tgfb-fibronectin-limb.yaml`) registers 5 laws with Lean theorem names, Lean loci and corrected code loci. Deductions: the per-zone dt multipliers (L473), the 3.75 and 0.40 factors and the 180-step haptotaxis loop have no equation citation (-4); the CPM GIF frame step/time mapping (1 MCS = dt_F) is a modelling choice stated only in the JSON (-2); the stale \"8-check\" wording is gone but Law 2/3 code loci span whole sections rather than equations (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2004-hentschel-tgfb-fibronectin-limb.py L473–L473: dt_z per-zone multipliers (3.2 / 1.25 / 0.85) uncited <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L473-L473>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-code-traceability-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py L1–L95" ;
        dct:description "Module docstring: Sections 3 (GGH coupling, volume filling, clip diagnostic) and 4 (Lean Theorems 1-5)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L1-L95> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py L698–L724" ;
        dct:description "GGH docstring: Hamiltonian, haptotaxis copy energy, Metropolis rule, Hill-switch and fibronectin coupling, checkerboard approximation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L698-L724> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/hentschel-tgfb-fibronectin-limb.yaml L1–L142" ;
        dct:description "5 laws (Laws 4-5 new) with Lean theorems, lean_locus and code_locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/morphoeval/math_kg_loops/hentschel-tgfb-fibronectin-limb.yaml#L1-L142> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 014 Pass 3 autonomous remediation-loop assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


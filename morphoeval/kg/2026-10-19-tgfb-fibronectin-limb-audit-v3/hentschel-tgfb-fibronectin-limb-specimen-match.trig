sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hentschel-tgfb-fibronectin-limb> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B / Kiskowski et al. (2004) Dev. Biol. multiscale TGF-beta / FGF-inhibitor reaction-diffusion and fibronectin haptotaxis PDE in developing Gallus gallus limb bud, coupled to a Glazier-Graner-Hogeweg cellular Potts cell lattice — Morphological realism / specimen match: 76/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credit: Panel E/F still segment the SHA-256-locked Gallus wing into 1 / 2 / 3 elements (L1027-1084) and Panel H compares theory, PDE and specimen counts; Panel I shows discrete GGH cells visibly condensing inside the continuum Hill contour and Panel J shows compact discrete zeugopod (2) and autopod (3) condensations at the digit positions, which is the first cell-level morphology in this loop. Deductions: the 1D and 2D wing \"condensations\" in Panels B and C are one-pixel-wide clip spikes rather than the several-cell-wide condensations of Hentschel Figs. 2-4 or the specimen's bone widths (-8); the micromass morphospace (Panel D) no longer shows a spot vs stripe distinction — both regimes are labyrinthine bands, so the Miura & Shiota (2000) nodular-island phenotype in the dataset is not reproduced (-6); the GGH wing bud forms no stylopod condensation (Panel J: GGH m = 0 vs PDE m = 1 vs specimen 1 humerus) (-4); no side-by-side with a Kiskowski (2004) or Chaturvedi (2005) cell-lattice figure (-3); the GGH sheet dewets into medium holes (Panel I) that have no counterpart in a confluent micromass (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2004-hentschel-tgfb-fibronectin-limb.py L1163–L1179: Panel D labels now report islands/area for 'WT (thresholded)' vs '+TGF-beta2 (fused)'; no spot regime exists <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L1163-L1179>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-specimen-match-3> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/tgfb_fibronectin_limb_comparison.png (generated output)" ;
        dct:description "12-panel figure: Panels I-L add GGH lattice (cells inside red Hill contour), wing-bud discrete condensations [0, 2, 3], 4-regime kinetics, parity bars; Panels B/C show 1-px clip spikes; Panel D shows two labyrinths — docs/media/tgfb_fibronectin_limb_comparison.png: rendered output of 2004-hentschel-tgfb-fibronectin-limb.py at 58b898c, image/png, 853011 B, 2343×1960 px, artifact_sha256 f0533eb3a15144051abc88f164c957218c60b35cd76f3088949b7fd3d12be3e2 (sha256 f0533eb3a15144051abc88f164c957218c60b35cd76f3088949b7fd3d12be3e2), spec_fingerprint 25a54774cc76963703511eae8cb9dc8b8fea2169f1c58b48380f2c9d1c3fe31f" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py L1027–L1084" ;
        dct:description "Cross-sectional osteological peak detection across stylopod (1), zeugopod (2), autopod (3) on chick_limb_chondrogenesis_specimen.jpg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L1027-L1084> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py L1287–L1325" ;
        dct:description "Panels I-J: GGH cell types with outlines and continuum Hill(c_a) = 1/2 contour; per-compartment GGH vs PDE counts annotated" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L1287-L1325> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 014 Pass 3 autonomous remediation-loop assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


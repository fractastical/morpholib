sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hentschel-tgfb-fibronectin-limb> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B / Kiskowski et al. (2004) Dev. Biol. multiscale TGF-beta / FGF-inhibitor reaction-diffusion and fibronectin haptotaxis PDE in developing Gallus gallus limb bud, coupled to a Glazier-Graner-Hogeweg cellular Potts cell lattice — Parameter expressivity: 84/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credit: the FGF zonation sweep (L955-995) still produces [1, 2, 3, 4]; the four GGH regimes (L865-910) form a genuine 2 x 2 ablation (differential adhesion x haptotaxis) whose condensation index orders monotonically WT > DA-only > haptotaxis-only > ablation and whose heterotypic fraction drops only when differential adhesion is on; new CLI flags `--cpm-mcs`, `--cpm-wing-mcs`, `--mu-F`, `--J-R2R2` (L1737-1740) are resolved at call time (L725-732). Deductions: the Panel G chi_F sweep (L1231-1258) reports std(R) on clip-collapsed fields, so its plateau at 0.76 is the clip ceiling, not a haptotaxis response (-6); the GGH wing-bud count is prepattern-determined — the full ablation also yields [0, 2, 3] (L913-949), so that panel does not test cell behaviour (-4); haptotaxis adds only +0.15 to the condensation index and mu_F was tuned by hand to 10 because mu_F >= 25 fingers cells across the Hill boundary (disclosed in the JSON) — no mu_F sweep is rendered (-4); no T or lambda_V sweep (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2004-hentschel-tgfb-fibronectin-limb.py L1231–L1258: Panel G chi_F sweep uses std(R) of clip-collapsed 1D fields (clip fraction 1.00 at fa = 11) <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L1231-L1258>",
            "2004-hentschel-tgfb-fibronectin-limb.py L913–L949: run_cpm_wing_bud_coupling counts peaks of the R2 density; ablation gives the same [0, 2, 3] (prepattern-determined) <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L913-L949>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-parameter-expressivity-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py L865–L910" ;
        dct:description "run_cpm_micromass_coupling: WT / DA-only / haptotaxis-only / full-ablation GGH regimes on the x3 prepattern plus continuum condensation index" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L865-L910> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py L1727–L1755" ;
        dct:description "CLI: --fa, --L-AP-um, --Da, --Di, --chi-F, --k-F, --steps, --seed, --cpm-mcs, --cpm-wing-mcs, --mu-F, --J-R2R2, --self-test" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L1727-L1755> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 014 Pass 3 autonomous remediation-loop assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


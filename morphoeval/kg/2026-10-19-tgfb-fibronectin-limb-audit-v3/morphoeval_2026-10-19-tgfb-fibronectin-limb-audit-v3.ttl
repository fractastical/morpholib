    rdfs:comment "full-ablation lattice gives r = 0.800: most of the correlation is inherited from the shared prepattern, the WT - ablation difference (+0.118) is the cell-behaviour contribution" ;
    prov:wasGeneratedBy "script" ;
    schema:about "Gallus gallus domesticus embryonic wing bud & high-density mesenchymal micromass (HH20 stylopod humerus -> HH24 zeugopod radius+ulna -> HH27 autopod digits II-IV)" ;

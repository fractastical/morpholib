sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hentschel-tgfb-fibronectin-limb> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B / Kiskowski et al. (2004) Dev. Biol. multiscale TGF-beta / FGF-inhibitor reaction-diffusion and fibronectin haptotaxis PDE in developing Gallus gallus limb bud, coupled to a Glazier-Graner-Hogeweg cellular Potts cell lattice — Model fidelity to source: 78/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credit: the Hentschel et al. (2004) dispersion (L185-266) and the 4-field PDE structure in 1D (L271-418), 2D wing (L421-536) and periodic micromass (L539-644) are the published equations; the new GGH module (L678-862) is a correct Graner-Glazier Hamiltonian (adhesion L811-815, volume L816-817, Savill-Hogeweg haptotaxis L818-819, Metropolis L820) coupled to the continuum through the PDE's own Hill switch (L790-793) and a two-way fibronectin law (L796-798), with the adhesion energy exact within each stride-3 sub-sweep; the micromass solver now uses the Hillen-Painter volume-filling form (L605-606) and reaches a resolved solution (clip fraction 0.000). Deductions: the 1D haptotaxis step (L353-365) collapses R(x) onto the two clip levels for fa = 11 and 18 (clip_fraction_R = 1.00; 0.52 at fa = 6) and the 2D wing step (L495-512) pins 19.3 % of R(x, z), so the reported condensation amplitudes, std(R) and the F-R correlation r = 0.9997 are set by np.clip, not by the PDE (-10); the 1D and 2D solvers also carry uncited factors 3.75 * D_R (L335) and 0.40 (L361) and per-zone dt multipliers (L473) that are tuning, not Hentschel (2004) parameters (-4); the GGH volume term uses sub-sweep-stale volumes (L816-817), an acknowledged parallel-CPM approximation never validated against a sequential update (-3); Kiskowski et al. (2004) itself is not a CPM, so the \"as in Kiskowski\" coupling is a Chaturvedi-style realisation (disclosed, -2); lambda_V = 6 departs from the Graner-Glazier lambda = 1 for cell survival (disclosed in the JSON, -1); the stylopod condensation exists only in the collapsed continuum, not in the discrete model (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2004-hentschel-tgfb-fibronectin-limb.py L353–L365: 1D haptotaxis step without volume filling and with an uncited 0.40 divergence factor; clip_fraction_R = 1.00 for fa = 11 and 18 — condensation amplitudes are clip-determined <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L353-L365>",
            "2004-hentschel-tgfb-fibronectin-limb.py L495–L512: 2D wing haptotaxis loop (180 explicit steps, denom_R without the 3.75 factor); 19.3 % of R(x, z) pinned at the clip bounds, digit condensations are single-pixel lines (Panel B) <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L495-L512>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity-3> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py L678–L862" ;
        dct:description "simulate_ggh_cellular_potts_condensation: GGH Hamiltonian, Hill-switch cell state (L790-793), two-way fibronectin deposition (L796-798), adhesion/volume/haptotaxis dH (L811-819), Metropolis acceptance (L820), checkerboard sub-lattices (L770)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L678-L862> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py L605–L606" ;
        dct:description "Volume-filling haptotactic sensitivity chi_F R (1 - R/R_max) grad F in the micromass solver (Hillen & Painter 2001); clip fraction now 0.000" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L605-L606> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_014_tgfb_fibronectin_limb.lean L131–L191" ;
        dct:description "Lean Laws 4-5: GGH sorting condition 2 J_ld > J_ll + J_dd and Metropolis haptotactic acceptance, 0 sorrys, verified with `lean`" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/morphoeval/lean/loops/Loop_014_tgfb_fibronectin_limb.lean#L131-L191> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 014 Pass 3 autonomous remediation-loop assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


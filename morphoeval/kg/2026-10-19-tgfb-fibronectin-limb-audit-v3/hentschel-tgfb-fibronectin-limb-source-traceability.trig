sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hentschel-tgfb-fibronectin-limb> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B / Kiskowski et al. (2004) Dev. Biol. multiscale TGF-beta / FGF-inhibitor reaction-diffusion and fibronectin haptotaxis PDE in developing Gallus gallus limb bud, coupled to a Glazier-Graner-Hogeweg cellular Potts cell lattice — Source and data traceability: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Vendors 5 SHA-256-pinned files in `datasets/tgfb_fibronectin_limb/` (L129-146, verified fail-closed at L151-162 on every run), including the new `kiskowski_ggh_cpm_reference.json` that records every GGH parameter, its provenance (Graner & Glazier 1992 values vs the lambda_V = 6 departure), the coupling laws, metric definitions and the Kiskowski-vs-CPM attribution; `paper_citations.bib` gains 5 DOIs (Graner 1992, Glazier 1993, Savill 1997, Hillen 2001, Tapia 2011) and the README records the Pass 3 findings. Deductions: Kiskowski (2004) figure/table values are not extracted, so the discrete model has no quantitative literature anchor (-4); the 1D/2D tuning factors (3.75, 0.40, dt multipliers) have no source (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-source-traceability-4> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py L129–L162" ;
        dct:description "EXPECTED_SHA256 for 5 dataset files incl. kiskowski_ggh_cpm_reference.json; runtime verification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L129-L162> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/tgfb_fibronectin_limb/kiskowski_ggh_cpm_reference.json L1–L62" ;
        dct:description "GGH parameter/metric table with DOIs, provenance notes and the Kiskowski (lattice model) vs GGH attribution" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/datasets/tgfb_fibronectin_limb/kiskowski_ggh_cpm_reference.json#L1-L62> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/tgfb_fibronectin_limb/paper_citations.bib L55–L113" ;
        dct:description "5 Pass 3 BibTeX entries with DOIs and usage notes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/datasets/tgfb_fibronectin_limb/paper_citations.bib#L55-L113> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/tgfb_fibronectin_limb/README.md L31–L43" ;
        dct:description "Pass 3 contents and findings (collapse artefact, stylopod gap)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/datasets/tgfb_fibronectin_limb/README.md#L31-L43> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 014 Pass 3 autonomous remediation-loop assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


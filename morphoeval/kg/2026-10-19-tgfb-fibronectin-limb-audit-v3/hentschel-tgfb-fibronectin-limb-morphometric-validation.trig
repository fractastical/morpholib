sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hentschel-tgfb-fibronectin-limb> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B / Kiskowski et al. (2004) Dev. Biol. multiscale TGF-beta / FGF-inhibitor reaction-diffusion and fibronectin haptotaxis PDE in developing Gallus gallus limb bud, coupled to a Glazier-Graner-Hogeweg cellular Potts cell lattice — Morphometric validation: 80/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credit: `measure_morphoeval()` (L1457-1612) now returns 14 measurements, every one with a reference value; the 6 new ones quantify the discrete-continuum parity (condensation index 1.355 vs continuum 1.514; heterotypic fraction 0.293 vs ablation 0.514; r(R2 disc, R2 cont) = 0.918 vs ablation 0.800; GGH wing total 5 vs 6) and add two honest failing diagnostics (2D wing clip fraction 0.193 vs 0; resolved micromass 8 vs 6 islands). Deductions: the GGH references are internal — the continuum ratio, the ablation value, an adopted r >= 0.9 threshold and the +TGF-beta2 island count — because Kiskowski (2004) / Glazier & Graner (1993) values were not extracted (-8); the Pass 2 measurements 1-7 still report counts and a F-R correlation computed on clip-collapsed fields without flagging them individually (-5); the micromass area fractions (0.21 / 0.21) are no longer compared with the dataset's 25-30 % vs 45-55 % Miura & Shiota ranges because the model cannot reproduce them (-4); no uncertainty (seed replicates) on any GGH metric (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2004-hentschel-tgfb-fibronectin-limb.py L1572–L1580: r(R2 disc, R2 cont) reference_value 0.9 is an adopted threshold, not a literature value (stated in reference_source) <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L1572-L1580>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-2d-composite-chick-wing-bud-total-haptotactic-skeletal-elements-1-2-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-2d-wing-bud-continuum-cell-density-r-fraction-pinned-at-the-clip-bounds-0-05-3-5-chemotactic-collapse-diagnostic>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-anti-fibronectin-no-haptotaxis-chi-f-0-and-equal-diffusion-da-di-negative-control-cell-amplitude>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-fibronectin-f-x-vs-mesenchymal-cell-density-r-x-haptotactic-colocalization-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-ggh-2d-wing-bud-discrete-r2-condensations-per-compartment-stylopod-zeugopod-autopod-vs-hentschel-2004-1-2-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-ggh-cellular-potts-wt-micromass-condensation-index-occ-in-occ-out-vs-continuum-r-in-r-out>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-ggh-discrete-r2-cell-density-vs-continuum-r-2-r-hill-c-a-pearson-r-micromass-x3-lattice>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-ggh-heterotypic-r1-r2-boundary-fraction-wt-vs-no-differential-adhesion-ablation-glazier-graner-sorting-metric>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh20-stylopod-haptotactic-cell-condensation-count-m-fa-3-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh24-zeugopod-haptotactic-cell-condensation-count-m-fa-6-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh27-chick-wing-autopod-haptotactic-cell-condensation-count-m-fa-11-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh28-hindlimb-high-tgf-beta-autopod-condensation-count-m-fa-18-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-resolved-micromass-continuum-island-count-wt-thresholded-vs-tgf-beta2-fused-with-volume-filling-haptotaxis>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-segmented-gallus-gallus-wing-specimen-zeugopod-to-autopod-spacing-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-morphometric-validation-3> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-2d-composite-chick-wing-bud-total-haptotactic-skeletal-elements-1-2-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D composite chick wing bud total haptotactic skeletal elements (1 + 2 + 3) = 6.0 elements" ;
        dct:description "compartment counts = [1, 2, 3] vs specimen [1, 2, 3]" ;
        schema:measurementTechnique "2D proximodistal multiscale (c_a, c_i, F, R) PDE cumulative cell condensation peak count across stylopod, zeugopod, and autopod zones" ;
        schema:name "2D composite chick wing bud total haptotactic skeletal elements (1 + 2 + 3)" ;
        schema:unitText "elements" ;
        schema:value "6.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-2d-composite-chick-wing-bud-total-haptotactic-skeletal-elements-1-2-3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-2d-composite-chick-wing-bud-total-haptotactic-skeletal-elements-1-2-3-reference> a schema:PropertyValue ;
        dct:source "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B 271:1713-1722 Figs. 2-4 (1 humerus + 2 radius/ulna + 3 digits = 6 elements)" ;
        schema:value "6.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-2d-wing-bud-continuum-cell-density-r-fraction-pinned-at-the-clip-bounds-0-05-3-5-chemotactic-collapse-diagnostic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D wing bud continuum cell density R fraction pinned at the clip bounds [0.05, 3.5] (chemotactic-collapse diagnostic) = 0.193 fraction of samples" ;
        dct:description "1D stage clip fractions = [0.0, 0.516, 1.0, 1.0] (fa = 3, 6, 11, 18); resolved micromass continuum = 0.0000 (Pass 2 micromass was 0.244)" ;
        schema:measurementTechnique "fraction of R(x, z) samples equal to the lower or upper clip bound after the 180 haptotaxis steps of integrate_hentschel_2d_limb_bud_pde" ;
        schema:name "2D wing bud continuum cell density R fraction pinned at the clip bounds [0.05, 3.5] (chemotactic-collapse diagnostic)" ;
        schema:unitText "fraction of samples" ;
        schema:value "0.193" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-2d-wing-bud-continuum-cell-density-r-fraction-pinned-at-the-clip-bounds-0-05-3-5-chemotactic-collapse-diagnostic-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-2d-wing-bud-continuum-cell-density-r-fraction-pinned-at-the-clip-bounds-0-05-3-5-chemotactic-collapse-diagnostic-reference> a schema:PropertyValue ;
        dct:source "A resolved haptotaxis solution never touches the clip bounds (Hillen & Painter 2001 Adv. Appl. Math. 26:280 volume-filling bound R <= R_max); nonzero values mean the condensation amplitude is set by the clip, not by the PDE" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-anti-fibronectin-no-haptotaxis-chi-f-0-and-equal-diffusion-da-di-negative-control-cell-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "anti-fibronectin no-haptotaxis (chi_F=0) and equal-diffusion (Da=Di) negative control cell amplitude = 0.0 std(R) control" ;
        dct:description "WT std(R) = 0.7574 (3 digits) vs chi_F=0 std(R) = 8.65e-11 (0 elements) and Da=Di std(R) = 8.65e-11 (0 elements)" ;
        schema:measurementTechnique "mesenchymal cell density std(R) when haptotaxis is blocked (chi_F=0) or morphogen diffusivities are equal (Da=Di=0.5) vs WT autopod" ;
        schema:name "anti-fibronectin no-haptotaxis (chi_F=0) and equal-diffusion (Da=Di) negative control cell amplitude" ;
        schema:unitText "std(R) control" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-anti-fibronectin-no-haptotaxis-chi-f-0-and-equal-diffusion-da-di-negative-control-cell-amplitude-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-anti-fibronectin-no-haptotaxis-chi-f-0-and-equal-diffusion-da-di-negative-control-cell-amplitude-reference> a schema:PropertyValue ;
        dct:source "Lean 4 Theorem 1 hentschel_tgfb_inhibitor_haptotaxis_stability_controls & Kiskowski et al. (2004) Dev. Biol. 271:372-387" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-fibronectin-f-x-vs-mesenchymal-cell-density-r-x-haptotactic-colocalization-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fibronectin F(x) vs mesenchymal cell density R(x) haptotactic colocalization Pearson r = 0.9997 Pearson r" ;
        dct:description "resolved (volume-filling) micromass continuum: WT thresholded 8 islands / 0.210 area vs +TGF-beta2 fused 6 islands / 0.210 area (both labyrinthine; Pass 2 spot-vs-stripe contrast was a collapse artefact)" ;
        schema:measurementTechnique "spatial correlation between ECM fibronectin F(x) and haptotactic mesenchymal cell density R(x) in HH27 wing autopod" ;
        schema:name "fibronectin F(x) vs mesenchymal cell density R(x) haptotactic colocalization Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9997" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-fibronectin-f-x-vs-mesenchymal-cell-density-r-x-haptotactic-colocalization-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-fibronectin-f-x-vs-mesenchymal-cell-density-r-x-haptotactic-colocalization-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Kiskowski et al. (2004) Dev. Biol. 271:372-387 & Hentschel et al. (2004) Proc. R. Soc. B 271:1713-1722 (colocalization of fibronectin and cell condensations)" ;
        schema:value "0.98" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-ggh-2d-wing-bud-discrete-r2-condensations-per-compartment-stylopod-zeugopod-autopod-vs-hentschel-2004-1-2-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "GGH 2D wing bud discrete R2 condensations per compartment (stylopod + zeugopod + autopod) vs Hentschel (2004) 1 + 2 + 3 = 5.0 elements" ;
        dct:description "GGH compartment counts = [0, 2, 3] vs continuum [1, 2, 3]; the stylopod activator peak (c_a max = 0.35) never crosses the half-maximal Hill switch K_a = 0.60, so no discrete stylopod condensation forms; GGH condensation index 1.517 vs ablation 1.157" ;
        schema:measurementTechnique "peaks of the anteroposterior mean discrete R2 density per FGF compartment after 300 MCS on the 96 x 128 wing-bud prepattern (same find_peaks rule as the continuum)" ;
        schema:name "GGH 2D wing bud discrete R2 condensations per compartment (stylopod + zeugopod + autopod) vs Hentschel (2004) 1 + 2 + 3" ;
        schema:unitText "elements" ;
        schema:value "5.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-ggh-2d-wing-bud-discrete-r2-condensations-per-compartment-stylopod-zeugopod-autopod-vs-hentschel-2004-1-2-3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-ggh-2d-wing-bud-discrete-r2-condensations-per-compartment-stylopod-zeugopod-autopod-vs-hentschel-2004-1-2-3-reference> a schema:PropertyValue ;
        dct:source "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B 271:1713-1722 Figs. 2-4 (1 humerus + 2 radius/ulna + 3 digits)" ;
        schema:value "6.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-ggh-cellular-potts-wt-micromass-condensation-index-occ-in-occ-out-vs-continuum-r-in-r-out> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "GGH cellular Potts WT micromass condensation index occ_in/occ_out vs continuum R_in/R_out = 1.355 dimensionless ratio" ;
        dct:description "GGH regimes: WT 1.355 > DA-only 1.204 > haptotaxis-only 1.078 > full ablation 0.969; differential adhesion dominates, haptotaxis adds a smaller increment" ;
        schema:measurementTechnique "mean lattice occupancy of 1296 GGH cells inside vs outside the continuum Hill(c_a) > 1/2 mask after 150 MCS (J = 14/2/11/16, T = 10, lambda_V = 6, mu_F = 10); reference = same ratio on the continuum R field" ;
        schema:name "GGH cellular Potts WT micromass condensation index occ_in/occ_out vs continuum R_in/R_out" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "1.355" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-ggh-cellular-potts-wt-micromass-condensation-index-occ-in-occ-out-vs-continuum-r-in-r-out-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-ggh-cellular-potts-wt-micromass-condensation-index-occ-in-occ-out-vs-continuum-r-in-r-out-reference> a schema:PropertyValue ;
        dct:source "Continuum 4-field PDE on the same prepattern (discrete-continuum parity; Christley, Alber & Newman (2007) BMC Syst. Biol. 1:16) with Graner & Glazier (1992) Phys. Rev. Lett. 69:2013 contact energies" ;
        schema:value "1.5136" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-ggh-discrete-r2-cell-density-vs-continuum-r-2-r-hill-c-a-pearson-r-micromass-x3-lattice> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "GGH discrete R2-cell density vs continuum R_2 = R Hill(c_a) Pearson r (micromass, x3 lattice) = 0.9181 Pearson r" ;
        dct:description "full-ablation lattice gives r = 0.800: most of the correlation is inherited from the shared prepattern, the WT - ablation difference (+0.118) is the cell-behaviour contribution" ;
        schema:measurementTechnique "spatial correlation between the sigma = 2 px smoothed R2-cell occupancy of the WT GGH lattice and the Fourier-upsampled continuum prechondrogenic density on the 216 x 216 lattice" ;
        schema:name "GGH discrete R2-cell density vs continuum R_2 = R Hill(c_a) Pearson r (micromass, x3 lattice)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9181" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-ggh-discrete-r2-cell-density-vs-continuum-r-2-r-hill-c-a-pearson-r-micromass-x3-lattice-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-ggh-discrete-r2-cell-density-vs-continuum-r-2-r-hill-c-a-pearson-r-micromass-x3-lattice-reference> a schema:PropertyValue ;
        dct:source "Parity threshold adopted in this script (not a literature value); Christley, Alber & Newman (2007) BMC Syst. Biol. 1:16 report qualitative agreement between discrete and continuum condensation patterns without a quantitative correlation" ;
        schema:value "0.9" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-ggh-heterotypic-r1-r2-boundary-fraction-wt-vs-no-differential-adhesion-ablation-glazier-graner-sorting-metric> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "GGH heterotypic R1|R2 boundary fraction WT vs no-differential-adhesion ablation (Glazier-Graner sorting metric) = 0.2935 boundary fraction" ;
        dct:description "a lower value than the ablation reference indicates sorting; DA-only 0.309, haptotaxis-only 0.480" ;
        schema:measurementTechnique "R1|R2 contact length / (R1|R2 + inter-cell R2|R2 contact length) after the final MCS; reference = the same metric under J_R2R2 = J_R1R2 = J_R1R1 = 14, mu_F = 0 (no sorting drive)" ;
        schema:name "GGH heterotypic R1|R2 boundary fraction WT vs no-differential-adhesion ablation (Glazier-Graner sorting metric)" ;
        schema:unitText "boundary fraction" ;
        schema:value "0.2935" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-ggh-heterotypic-r1-r2-boundary-fraction-wt-vs-no-differential-adhesion-ablation-glazier-graner-sorting-metric-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-ggh-heterotypic-r1-r2-boundary-fraction-wt-vs-no-differential-adhesion-ablation-glazier-graner-sorting-metric-reference> a schema:PropertyValue ;
        dct:source "Glazier & Graner (1993) Phys. Rev. E 47:2128 (heterotypic boundary length decreases under positive surface tension 2 J_ld - J_ll - J_dd = 6 > 0; Lean Theorem 4 ggh_differential_adhesion_sorting_condition)" ;
        schema:value "0.5136" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh20-stylopod-haptotactic-cell-condensation-count-m-fa-3-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "HH20 stylopod haptotactic cell condensation count m(fa=3.0) = 1.0 elements" ;
        dct:description "wavelength lambda_AP = 1150.0 um, F-R colocalization r = 0.9617, specimen stylopod bones = 1" ;
        schema:measurementTechnique "coupled 4-field (c_a, c_i, F, R) Hentschel et al. (2004) PDE mesenchymal cell density R(x) peak count at fa=3.0 (c_FGF=0.25)" ;
        schema:name "HH20 stylopod haptotactic cell condensation count m(fa=3.0)" ;
        schema:unitText "elements" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh20-stylopod-haptotactic-cell-condensation-count-m-fa-3-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh20-stylopod-haptotactic-cell-condensation-count-m-fa-3-0-reference> a schema:PropertyValue ;
        dct:source "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B 271:1713-1722 Fig. 2 & Section 3 (HH20 stylopod humerus = 1 element)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh24-zeugopod-haptotactic-cell-condensation-count-m-fa-6-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "HH24 zeugopod haptotactic cell condensation count m(fa=6.0) = 2.0 elements" ;
        dct:description "wavelength lambda_AP = 575.0 um, PDE spacing = 577.3 um, specimen zeugopod bones = 2" ;
        schema:measurementTechnique "coupled 4-field (c_a, c_i, F, R) Hentschel et al. (2004) PDE mesenchymal cell density R(x) peak count at fa=6.0 (c_FGF=0.55)" ;
        schema:name "HH24 zeugopod haptotactic cell condensation count m(fa=6.0)" ;
        schema:unitText "elements" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh24-zeugopod-haptotactic-cell-condensation-count-m-fa-6-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh24-zeugopod-haptotactic-cell-condensation-count-m-fa-6-0-reference> a schema:PropertyValue ;

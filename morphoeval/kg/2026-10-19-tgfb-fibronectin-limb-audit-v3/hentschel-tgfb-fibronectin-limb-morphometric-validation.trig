    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-measurement-hh27-chick-wing-autopod-haptotactic-cell-condensation-count-m-fa-11-0> a schema:PropertyValue,
            pk:EvidenceItem ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hentschel-tgfb-fibronectin-limb> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py L1618–L1724" ;
        dcterms:description "12-check self_test() incl. GGH regime ordering, sorting, parity, wing [0, 2, 3], ramp sign test, clip diagnostic, 14 measurements, PDE + GGH determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L1618-L1724> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2004-hentschel-tgfb-fibronectin-limb.py L1737–L1741" ;
        dcterms:description "CLI flags for GGH MCS budgets, mu_F, J_R2R2 and the 12-check self-test" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2004-hentschel-tgfb-fibronectin-limb.py#L1737-L1741> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/tgfb_fibronectin_limb_cpm_sorting.gif (generated output)" ;
        dcterms:description "8-frame GGH sorting GIF regenerated by the default invocation — docs/media/tgfb_fibronectin_limb_cpm_sorting.gif: rendered output of 2004-hentschel-tgfb-fibronectin-limb.py at 58b898c, image/gif, 224663 B, 520×520 px, 8 frames, artifact_sha256 a8ec71c77f252e52c847f677a1707ee11e99a701abfa3fcee442240c7bd3dcc4 (sha256 a8ec71c77f252e52c847f677a1707ee11e99a701abfa3fcee442240c7bd3dcc4), spec_fingerprint 25a54774cc76963703511eae8cb9dc8b8fea2169f1c58b48380f2c9d1c3fe31f" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hentschel-tgfb-fibronectin-limb-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Hentschel, Glimm, Glazier & Newman (2004) Proc. R. Soc. B / Kiskowski et al. (2004) Dev. Biol. multiscale TGF-beta / FGF-inhibitor reaction-diffusion and fibronectin haptotaxis PDE in developing Gallus gallus limb bud, coupled to a Glazier-Graner-Hogeweg cellular Potts cell lattice — Reproducibility package: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Deterministic RNG (seed 2004 for PDE and GGH), 12-check `--self-test` (L1618-1724) covering SHA-256 of 5 files and GGH-JSON parity, dispersion, stage counts, 2D wing, controls, resolved micromass (clip < 0.01, island fusion), specimen, GGH cell conservation / regime ordering / sorting / parity, GGH wing [0, 2, 3] with the stylopod gap pinned, haptotaxis sign on a ramp, clip diagnostic exposure, 14 measurements with references, and bitwise two-run determinism of both the PDE and the GGH lattice; the self-test runs in ~20 s and the render in ~12 s, well inside the 3-minute budget. Deductions: no requirements lock file for this slot (environment recorded only in the audit) (-4); matplotlib emits a non-writable-cache warning unless MPLCONFIGDIR is set, which the invocation notes do not mention (-2); the dataset README has no run instructions for the new flags (-2); the PNG hash is not asserted by the self-test (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hentschel-tgfb-fibronectin-limb-repro-package-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 014 Pass 3 autonomous remediation-loop assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bailleul-allometric-cranial-sutures> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Miura et al. (2009) & Jaslow (1990) cranial suture fractal interdigitation and Kuramoto-Sivashinsky osteogenic instability — Morphometric validation: 54/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Reports only 2 single-valued SII scalars in `measure_morphoeval()`, omitting log-log box-counting fractal dimension D_f, power spectral density scaling slope, Jaslow (1990) bending energy absorption, and empirical specimen suture D_f and SII." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2020-bailleul-allometric-cranial-sutures.py L137–L161: 2-metric baseline measure_morphoeval() hook <https://github.com/fractastical/morpholib/blob/317bc3c/2020-bailleul-allometric-cranial-sutures.py#L137-L161>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-baseline-single-valued-sagittal-suture-interdigitation-index-sii>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-unloaded-mechanical-control-suture-interdigitation-index-sii> ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-baseline-single-valued-sagittal-suture-interdigitation-index-sii> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Baseline single-valued sagittal suture interdigitation index SII = 1.1116 L_arc / L_chord" ;
        dct:description "Single-valued baseline SII = 1.1116 vs unloaded SII = 1.0000" ;
        schema:measurementTechnique "1D single-valued linear spectral evolution without KPZ cascade or 2D overhang" ;
        schema:name "Baseline single-valued sagittal suture interdigitation index SII" ;
        schema:unitText "L_arc / L_chord" ;
        schema:value "1.1116" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-baseline-single-valued-sagittal-suture-interdigitation-index-sii-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-baseline-single-valued-sagittal-suture-interdigitation-index-sii-reference> a schema:PropertyValue ;
        dct:source "Miura et al. (2009) PNAS 106:11218-11223 Fig. 1 & Jaslow (1990) J. Biomech. 23:313-321" ;
        schema:value "2.75" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-unloaded-mechanical-control-suture-interdigitation-index-sii> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Unloaded mechanical control suture interdigitation index SII = 1.0 L_arc / L_chord" ;
        dct:description "Unloaded suture collapses to flat line SII = 1.0000" ;
        schema:measurementTechnique "1D single-valued evolution with alpha = -0.35" ;
        schema:name "Unloaded mechanical control suture interdigitation index SII" ;
        schema:unitText "L_arc / L_chord" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-unloaded-mechanical-control-suture-interdigitation-index-sii-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-unloaded-mechanical-control-suture-interdigitation-index-sii-reference> a schema:PropertyValue ;
        dct:source "Miura et al. (2009) PNAS 106:11218-11223 Fig. 5 unloading experiment" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


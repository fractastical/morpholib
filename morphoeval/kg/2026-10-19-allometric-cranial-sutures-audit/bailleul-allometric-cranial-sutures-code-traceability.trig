        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-code-traceability-1> ;
        pk:hasScore "0.6"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

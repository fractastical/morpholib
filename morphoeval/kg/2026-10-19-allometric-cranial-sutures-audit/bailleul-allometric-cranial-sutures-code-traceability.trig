        rdfs:label "Miura et al. (2009) & Jaslow (1990) cranial suture fractal interdigitation and Kuramoto-Sivashinsky osteogenic instability — Code-to-model traceability: 60/100" ;
        dct:date "2026-10-19"^^xsd:date ;

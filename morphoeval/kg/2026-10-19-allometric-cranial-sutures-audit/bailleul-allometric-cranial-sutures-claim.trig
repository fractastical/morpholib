sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bailleul-allometric-cranial-sutures> a pk:Claim ;
        rdfs:label "Miura et al. (2009) & Jaslow (1990) cranial suture fractal interdigitation and Kuramoto-Sivashinsky osteogenic instability faithfully reproduces Homo sapiens and Mus musculus sagittal and lambdoid calvarial skull sutures morphology" ;
        dct:description "The simulation script(s) 2020-bailleul-allometric-cranial-sutures.py implement the cited source model as published and produce forms that match real Homo sapiens and Mus musculus sagittal and lambdoid calvarial skull sutures specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 56.3/100, audit 2026-10-19-allometric-cranial-sutures-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2020-bailleul-allometric-cranial-sutures.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2020-bailleul-allometric-cranial-sutures.py; output: docs/media/allometric_cranial_sutures_comparison.png; organism: Homo sapiens and Mus musculus sagittal and lambdoid calvarial skull sutures; checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 53dc68ef4189bb186f820ba54b5a160dfe42da44326e82b66ab860cc7d2ad00e; artifact_sha256: bffa061ad0a44e38fe57ca06bf134f023c0e26e4242d60e84e75b515230ce928; input_dataset_sha256: {datasets/allometric_cranial_sutures/allometric_cranial_sutures_reference.json=dbb634957fb6941d..., datasets/allometric_cranial_sutures/human_sagittal_suture_specimen.jpg=b3c411a6a4713770..., datasets/allometric_cranial_sutures/paper_citations.bib=bffc86bbbd2dd3d6..., datasets/allometric_cranial_sutures/scout_manifest.json=226c072307597439...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0021-9290(90)90059-C>,
            <https://doi.org/10.1073/pnas.0813269106>,
            <https://doi.org/10.1098/rspb.2012.2670>,
            <https://doi.org/10.1111/j.1469-7580.2011.01386.x> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-specimen-match> ;
        pk:weightOfEvidence "0.563"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/317bc3c/2020-bailleul-allometric-cranial-sutures.py> a schema:SoftwareSourceCode ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "317bc3c" .
}


<https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Miura et al. (2009) & Jaslow (1990) cranial suture fractal interdigitation and Kuramoto-Sivashinsky osteogenic instability — Model fidelity to source: 58/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Implements linear fourth-order dispersion omega(k) = alpha*k^2 - beta*k^4 - gamma on a single-valued 1D graph h(x, t) (L46-81), omitting pseudo-spectral semi-implicit / ETDRK4 integration of the nonlinear KPZ term (v_0/2)*(dh/dx)^2 + stochastic osteogenic noise eta(x,t) and 2D overhanging bone-finger interdigitation from Miura et al. (2009)." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "2020-bailleul-allometric-cranial-sutures.py L46–L81: Linear single-valued spectral evolution without KPZ nonlinearity or 2D overhanging front <https://github.com/fractastical/morpholib/blob/317bc3c/2020-bailleul-allometric-cranial-sutures.py#L46-L81>" ;
    pk:hasScore 5.8e-01 ;
    pk:hasVerdict "partially faithful" .


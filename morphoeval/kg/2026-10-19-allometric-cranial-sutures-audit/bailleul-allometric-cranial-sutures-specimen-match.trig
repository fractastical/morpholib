sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bailleul-allometric-cranial-sutures> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Miura et al. (2009) & Jaslow (1990) cranial suture fractal interdigitation and Kuramoto-Sivashinsky osteogenic instability — Morphological realism / specimen match: 50/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors `datasets/allometric_cranial_sutures/human_sagittal_suture_specimen.jpg` (CC BY-SA 3.0 human calvaria showing sagittal, coronal, and lambdoid sutures), but Pass 1 only renders the raw photograph without automated CV segmentation of the interdigitated sagittal suture trace, box-counting fractal dimension D_f, or SII." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2020-bailleul-allometric-cranial-sutures.py L88–L114: Raw specimen display without CV suture contour extraction or fractal box-counting <https://github.com/fractastical/morpholib/blob/317bc3c/2020-bailleul-allometric-cranial-sutures.py#L88-L114>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-specimen-match-1> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/allometric_cranial_sutures_comparison.png (generated output)" ;
        dct:description "4-panel Pass 1 baseline figure — docs/media/allometric_cranial_sutures_comparison.png: rendered output of 2020-bailleul-allometric-cranial-sutures.py at 317bc3c, image/png, 422533 B, 1380×936 px, artifact_sha256 bffa061ad0a44e38fe57ca06bf134f023c0e26e4242d60e84e75b515230ce928 (sha256 bffa061ad0a44e38fe57ca06bf134f023c0e26e4242d60e84e75b515230ce928), spec_fingerprint 53dc68ef4189bb186f820ba54b5a160dfe42da44326e82b66ab860cc7d2ad00e" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


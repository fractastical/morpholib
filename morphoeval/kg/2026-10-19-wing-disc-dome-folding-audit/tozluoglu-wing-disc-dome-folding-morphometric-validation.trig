sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tozluoglu-wing-disc-dome-folding> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Tozluoglu et al. (2019) Dev. Cell & Sui et al. (2018) Nat. Commun. Drosophila wing imaginal disc planar differential growth, basal ECM dome & H/N, H/H, H/P hinge folding — Morphometric validation: 54/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L196-231) reports only 3 basic wild-type numbers without 64h-96h developmental trajectory Pearson r, p-value, RMSE, without 7-zone spatial curvature correlation, without replicate positional variance comparison (heterogeneous pinned vs uniform unpinned buckling), without Collagenase ECM ablation collapse checks, and without specimen CV metrics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2020-tozluoglu-wing-disc-dome-folding.py L196–L231: Only 3 basic metrics without statistical correlation or specimen segmentation <https://github.com/fractastical/morpholib/blob/e93f00e/2020-tozluoglu-wing-disc-dome-folding.py#L196-L231>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-analytic-pouch-dome-curvature-kappa-dome-at-96-h-ael>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-mature-96-h-ael-central-h-h-fold-depth-d-hh>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-mature-96-h-ael-pouch-dome-elevation-z-dome> ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-analytic-pouch-dome-curvature-kappa-dome-at-96-h-ael> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Analytic pouch dome curvature kappa_dome at 96 h AEL = 0.00915 um^-1" ;
        schema:measurementTechnique "Bilayer differential growth formula kappa_dome" ;
        schema:name "Analytic pouch dome curvature kappa_dome at 96 h AEL" ;
        schema:unitText "um^-1" ;
        schema:value "0.00915" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-analytic-pouch-dome-curvature-kappa-dome-at-96-h-ael-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-analytic-pouch-dome-curvature-kappa-dome-at-96-h-ael-reference> a schema:PropertyValue ;
        dct:source "Tozluoglu et al. (2019) Dev. Cell 51:299-312 Fig. 4" ;
        schema:value "0.0128" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-mature-96-h-ael-central-h-h-fold-depth-d-hh> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Mature 96 h AEL central H/H fold depth d_HH = 19.4 um" ;
        schema:measurementTechnique "Analytic Gaussian cleft depth at s/L = 0.39" ;
        schema:name "Mature 96 h AEL central H/H fold depth d_HH" ;
        schema:unitText "um" ;
        schema:value "19.4" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-mature-96-h-ael-central-h-h-fold-depth-d-hh-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-mature-96-h-ael-central-h-h-fold-depth-d-hh-reference> a schema:PropertyValue ;
        dct:source "Tozluoglu et al. (2019) Dev. Cell 51:299-312 Fig. 2" ;
        schema:value "19.4" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-mature-96-h-ael-pouch-dome-elevation-z-dome> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Mature 96 h AEL pouch dome elevation z_dome = 54.0 um" ;
        schema:measurementTechnique "Peak elevation of 1D analytic dome ansatz at 96 h AEL" ;
        schema:name "Mature 96 h AEL pouch dome elevation z_dome" ;
        schema:unitText "um" ;
        schema:value "54.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-mature-96-h-ael-pouch-dome-elevation-z-dome-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-mature-96-h-ael-pouch-dome-elevation-z-dome-reference> a schema:PropertyValue ;
        dct:source "Tozluoglu et al. (2019) Dev. Cell 51:299-312 Fig. 1" ;
        schema:value "54.0" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 049 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


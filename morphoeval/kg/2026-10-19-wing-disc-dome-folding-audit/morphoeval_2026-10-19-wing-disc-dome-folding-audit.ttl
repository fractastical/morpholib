        <https://w3id.org/probknow/resource/evidence/2026-10-19-wing-disc-dome-folding-audit-tozluoglu-wing-disc-dome-folding-2>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-wing-disc-dome-folding-audit-tozluoglu-wing-disc-dome-folding-3> ;
    pk:hypothesisType "Multiplicative Finite-Strain Morphoelasticity F = F_e F_g Coupled to Apical-Basal Differential ECM Stiffness & Localized Hinge Fold Remodeling" ;
    pk:weightOfEvidence 5.42e-01 .


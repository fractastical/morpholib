<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/tozluoglu-wing-disc-dome-folding-1>,
        <https://w3id.org/probknow/resource/math-law/tozluoglu-wing-disc-dome-folding-2>,
        <https://w3id.org/probknow/resource/math-law/tozluoglu-wing-disc-dome-folding-3> .

<https://w3id.org/probknow/resource/math-law/tozluoglu-wing-disc-dome-folding-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Apical-vs-Basal Differential Planar Growth & Basal ECM Stiffness Pouch Dome Curvature Law" ;
    dct:description "Proves that tangential proliferation of the cellular layer tethered to a stiff non-growing basal basement membrane (mu_BM > 0) generates strictly positive convex pouch dome curvature that increases monotonically with pouch proliferation rate | Variables: g_apical: tangential planar growth rate of wing pouch epithelium (h^-1); g_BM: basal basement membrane growth rate (~0 h^-1); mu_BM: Collagen IV / Viking basement membrane shear modulus (5.0 kPa); kappa_dome: convex pouch dome curvature (um^-1)" ;
    dct:source "Tozluoglu et al. (2019) Dev. Cell 51(3):299-312.e4 Figs. 1, 4 & STAR Methods" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2020-tozluoglu-wing-disc-dome-folding.py#L130-L215>,
        <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_049_wing_disc_dome_folding.lean#L18-L55> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def dome_curvature_num (g_apical g_BM mu_BM : Int) : Int :=
  (g_apical - g_BM) * mu_BM
theorem pouch_dome_curvature_from_differential_growth_and_bm
    (g_bm dg extra mu_BM : Int)
    (hdg : dg > 0)
    (hextra : extra > 0)
    (hmu : mu_BM > 0) :
    dome_curvature_num g_bm g_bm mu_BM = 0 ∧
    dome_curvature_num (g_bm + dg) g_bm mu_BM > 0 ∧
    dome_curvature_num (g_bm + dg) g_bm mu_BM <
      dome_curvature_num (g_bm + dg + extra) g_bm mu_BM"""^^pk:lean4 ;
    skos:notation "kappa_dome = 6 * mu_cell * mu_BM * h_BM * (g_apical - g_BM) * Delta_t / (h_cell * (mu_cell * h_cell + 4 * mu_BM * h_BM)) > 0 for g_apical > g_BM and mu_BM > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2019.09.009>,
        <https://doi.org/10.1038/s41467-018-06497-3>,
        <https://doi.org/10.1115/1.4032128>,
        <https://doi.org/10.1242/dev.199728> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Multiplicative Finite-Strain Morphoelasticity F = F_e F_g Coupled to Apical-Basal Differential ECM Stiffness & Localized Hinge Fold Remodeling" ;
    pk:leanDeclaration "MathOfBiology.Loop_049.dome_curvature_num" ;
    pk:leanTheorem "MathOfBiology.Loop_049.pouch_dome_curvature_from_differential_growth_and_bm" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/tozluoglu-wing-disc-dome-folding-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Stereotyped H/N, H/H, and H/P Fold Pinning at Local Growth Troughs Law" ;
    dct:description "Proves that local minima (troughs, g''(s^*) > 0) in the differential planar growth profile focus negative apical cleft curvature at the exact H/N, H/H, and H/P boundaries, whereas uniform growth has zero second difference everywhere and buckles at unpinned random phases | Variables: g_left, g_trough, g_right: planar growth rates across a hinge fold boundary and flanking ridges; mu_BM: basal basement membrane stiffness; s_HN^*=0.26, s_HH^*=0.39, s_HP^*=0.52: normalized H/N, H/H, and H/P fold loci" ;
    dct:source "Tozluoglu et al. (2019) Dev. Cell 51(3):299-312.e4 Figs. 2-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2020-tozluoglu-wing-disc-dome-folding.py#L218-L355>,
        <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_049_wing_disc_dome_folding.lean#L58-L102> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def growth_second_diff (g_left g_trough g_right : Int) : Int :=
  g_left + g_right - 2 * g_trough
def pinned_fold_curvature_num (g_left g_trough g_right mu_BM : Int) : Int :=
  -(mu_BM * growth_second_diff g_left g_trough g_right)
theorem stereotyped_three_fold_pinning_vs_uniform_buckling
    (g0 g_trough d_left d_right mu_BM : Int)
    (hdl : d_left > 0)
    (hdr : d_right > 0)
    (hmu : mu_BM > 0) :
    growth_second_diff g0 g0 g0 = 0 ∧
    pinned_fold_curvature_num g0 g0 g0 mu_BM = 0 ∧
    growth_second_diff (g_trough + d_left) g_trough (g_trough + d_right) > 0 ∧
    pinned_fold_curvature_num
      (g_trough + d_left)
      g_trough
      (g_trough + d_right)
      mu_BM < 0"""^^pk:lean4 ;
    skos:notation "s_fold^* in {s_HN^*, s_HH^*, s_HP^*} <=> g'(s^*) = 0 & g''(s^*) > 0 => kappa_fold(s^*) < 0;  g(s) = g_0 => g''(s) = 0 (unpinned phase-random buckling)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2019.09.009>,
        <https://doi.org/10.1038/s41467-018-06497-3>,
        <https://doi.org/10.1115/1.4032128>,
        <https://doi.org/10.1242/dev.199728> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Multiplicative Finite-Strain Morphoelasticity F = F_e F_g Coupled to Apical-Basal Differential ECM Stiffness & Localized Hinge Fold Remodeling" ;
    pk:leanDeclaration "MathOfBiology.Loop_049.pinned_fold_curvature_num" ;
    pk:leanTheorem "MathOfBiology.Loop_049.stereotyped_three_fold_pinning_vs_uniform_buckling" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/tozluoglu-wing-disc-dome-folding-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Collagenase / vkg-RNAi Basal ECM Ablation Collapse & Synergistic Hinge Fold Deepening Hierarchy" ;
    dct:description "Proves that Collagenase / vkg-RNAi ablation of the basal basement membrane (mu_BM = 0) collapses both the pouch dome and all three hinge folds, and establishes the strict fold-depth hierarchy across JAK/STAT overgrowth, wild type, dysf/omb mutants, uniform growth, and ECM ablation | Variables: mu_bm_active: indicator of intact Collagen IV basal ECM; diff_growth_active: indicator of heterogeneous planar growth; local_remodel_active: indicator of local basal ECM softening & lateral tension redistribution (dysfusion/omb/MMP2); jak_stat_boost: JAK/STAT (Upd) hinge hyper-proliferation indicator" ;
    dct:source "Tozluoglu et al. (2019) Dev. Cell 51(3):299-312.e4 Figs. 4-6; Sui et al. (2018) Nat. Commun. 9:4620 Figs. 3-6" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2020-tozluoglu-wing-disc-dome-folding.py#L360-L545>,
        <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_049_wing_disc_dome_folding.lean#L105-L157> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def hh_fold_depth10 (mu_bm_active diff_growth_active local_remodel_active jak_stat_boost : Int) : Int :=
  mu_bm_active * (71 + 37 * diff_growth_active + 86 * diff_growth_active * local_remodel_active +
    58 * diff_growth_active * local_remodel_active * jak_stat_boost)
theorem collagenase_ecm_ablation_collapse_and_remodeling_hierarchy (g_ap g_bm g_l g_t g_r : Int) :
    dome_curvature_num g_ap g_bm 0 = 0 ∧
    pinned_fold_curvature_num g_l g_t g_r 0 = 0 ∧
    depth10_collagenase_ecm_ablation = 0 ∧
    depth10_jak_stat_overgrowth > depth10_wild_type ∧
    depth10_wild_type > depth10_dysf_omb_mutant ∧
    depth10_dysf_omb_mutant > depth10_uniform_growth ∧
    depth10_uniform_growth > depth10_collagenase_ecm_ablation"""^^pk:lean4 ;
    skos:notation "mu_BM = 0 => kappa_dome = 0 & d_fold = 0;  d_JAK_STAT (25.2 um) > d_WT (19.4 um) > d_dysf_omb (10.8 um) > d_uniform (7.1 um) > d_Collagenase (0.0 um)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2019.09.009>,
        <https://doi.org/10.1038/s41467-018-06497-3>,
        <https://doi.org/10.1115/1.4032128>,
        <https://doi.org/10.1242/dev.199728> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Multiplicative Finite-Strain Morphoelasticity F = F_e F_g Coupled to Apical-Basal Differential ECM Stiffness & Localized Hinge Fold Remodeling" ;
    pk:leanDeclaration "MathOfBiology.Loop_049.hh_fold_depth10" ;
    pk:leanTheorem "MathOfBiology.Loop_049.collagenase_ecm_ablation_collapse_and_remodeling_hierarchy" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


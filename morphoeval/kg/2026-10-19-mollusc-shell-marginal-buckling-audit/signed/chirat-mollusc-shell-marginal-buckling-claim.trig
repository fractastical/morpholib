sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chirat-mollusc-shell-marginal-buckling> a pk:Claim ;
        rdfs:label "Chirat, Moulton & Goriely (2013) & Erlich et al. (2016) mollusc shell marginal buckling and antimarginal rib morphogenesis faithfully reproduces Pecten jacobaeus (Mediterranean scallop / Bivalvia, Ammonitida & Brachiopoda) morphology" ;
        dcterms:description "The simulation script(s) 2013-chirat-mollusc-shell-marginal-buckling.py implement the cited source model as published and produce forms that match real Pecten jacobaeus (Mediterranean scallop / Bivalvia, Ammonitida & Brachiopoda) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 49.2/100, audit 2026-10-19-mollusc-shell-marginal-buckling-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/HEAD/2013-chirat-mollusc-shell-marginal-buckling.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/HEAD/2013-chirat-mollusc-shell-marginal-buckling.py; output: docs/media/mollusc_shell_marginal_buckling_comparison.png; organism: Pecten jacobaeus (Mediterranean scallop / Bivalvia, Ammonitida & Brachiopoda); checkpoint commit: https://github.com/fractastical/morpholib/commit/HEAD; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 890d42a5978673be401f72aa812cb4358400a79d2ca684773dc085cd5735c833; artifact_sha256: ea04f8c7bdce3d6ca6d8d2a612a004dc24d0533c1cee4adc2e3f862ca2bc7047; input_dataset_sha256: {datasets/mollusc_shell_marginal_buckling/mollusc_shell_marginal_buckling_reference.json=dec7d148f176932a..., datasets/mollusc_shell_marginal_buckling/ribbed_bivalve_shell_specimen.jpg=a0ac69e8a9be3928..., datasets/mollusc_shell_marginal_buckling/scout_manifest.json=2fb38cc60b112598...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.jtbi.2012.07.009>,
            <https://doi.org/10.1073/pnas.1220443110>,
            <https://doi.org/10.1098/rsif.2016.0592>,
            <https://doi.org/10.1371/journal.pcbi.1007213> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-specimen-match> ;
        pk:weightOfEvidence "0.492"^^xsd:double .


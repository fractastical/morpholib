sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chirat-mollusc-shell-marginal-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Chirat, Moulton & Goriely (2013) & Erlich et al. (2016) mollusc shell marginal buckling and antimarginal rib morphogenesis — Model fidelity to source: 58/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Solves a 1D periodic Fourier relaxation of E*I*w_ssss + P*w_ss + k*w + kappa_3*w^3 = 0 at a single fixed arc length (L28-78), but lacks L-BFGS-B energy minimization of the exact Winkler-beam functional, omits the analytical supercritical pitchfork law A_eq(P) = sqrt(4*q_c^2*(P-P_c)/(3*kappa_3)), omits 3D accretionary shell surface deposition across isometric vs intercalating growth regimes, and lacks a subcritical negative control (P/P_c = 0.65 < 1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2013-chirat-mollusc-shell-marginal-buckling.py L28–L78: Single-stage 1D Fourier relaxation without L-BFGS-B energy minimization, 3D accretionary shell surface, or subcritical negative control <https://github.com/fractastical/morpholib/blob/HEAD/2013-chirat-mollusc-shell-marginal-buckling.py#L28-L78>" ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


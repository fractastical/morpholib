sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chirat-mollusc-shell-marginal-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Chirat, Moulton & Goriely (2013) & Erlich et al. (2016) mollusc shell marginal buckling and antimarginal rib morphogenesis — Morphometric validation: 50/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Uses integer FFT bin `k_bin` (L63-66) without parabolic sub-bin interpolation and omits the 12-species cross-taxa scaling collapse (Bivalvia, Gastropoda, Ammonitida, Brachiopoda), pitchfork amplitude validation, and specimen radial rib angular CV." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2013-chirat-mollusc-shell-marginal-buckling.py L63–L66: Integer FFT bin wavelength without cross-taxa scaling collapse or specimen CV <https://github.com/fractastical/morpholib/blob/HEAD/2013-chirat-mollusc-shell-marginal-buckling.py#L63-L66>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-simulated-adult-pecten-antimarginal-rib-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-simulated-antimarginal-rib-wavelength-lambda-sim-v1-integer-fft-bin> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-simulated-adult-pecten-antimarginal-rib-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Simulated adult Pecten antimarginal rib count = 14.0 ribs" ;
        dct:description "RMS amplitude = 0.3679 mm" ;
        schema:measurementTechnique "Dominant Fourier mode count along adult scallop margin L=122.87 mm" ;
        schema:name "Simulated adult Pecten antimarginal rib count" ;
        schema:unitText "ribs" ;
        schema:value "14.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-simulated-adult-pecten-antimarginal-rib-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-simulated-adult-pecten-antimarginal-rib-count-reference> a schema:PropertyValue ;
        dct:source "Chirat et al. (2013) PNAS / Pecten jacobaeus adult valve rib count" ;
        schema:value "14.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-simulated-antimarginal-rib-wavelength-lambda-sim-v1-integer-fft-bin> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Simulated antimarginal rib wavelength lambda_sim (v1 integer FFT bin) = 8.7764 mm" ;
        dct:description "n_ribs_sim = 14.0" ;
        schema:measurementTechnique "Integer FFT peak wavenumber on 1D periodic Winkler beam (L=122.87 mm)" ;
        schema:name "Simulated antimarginal rib wavelength lambda_sim (v1 integer FFT bin)" ;
        schema:unitText "mm" ;
        schema:value "8.7764" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-simulated-antimarginal-rib-wavelength-lambda-sim-v1-integer-fft-bin-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-simulated-antimarginal-rib-wavelength-lambda-sim-v1-integer-fft-bin-reference> a schema:PropertyValue ;
        dct:source "Chirat, Moulton & Goriely (2013) PNAS Eq. (lambda_c = 2*pi*(EI/k)^(1/4))" ;
        schema:value "8.7766" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


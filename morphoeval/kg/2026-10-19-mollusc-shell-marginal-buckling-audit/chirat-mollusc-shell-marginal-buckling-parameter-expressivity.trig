sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chirat-mollusc-shell-marginal-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Chirat, Moulton & Goriely (2013) & Erlich et al. (2016) mollusc shell marginal buckling and antimarginal rib morphogenesis — Parameter expressivity: 45/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Hardcodes a single parameter tuple (EI=1.085, k=0.285, P/P_c=1.45, L=122.87) with no CLI parameter overrides, no supercritical pitchfork sweep across P/P_c, and no comparison across the 4 morphospace regimes (smooth subcritical, isometric *Pecten*, intercalating multicostate *Chlamys*, and episodic spiny varix *Murex*)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2013-chirat-mollusc-shell-marginal-buckling.py L28–L38: Single hardcoded parameter set without CLI flags or morphospace regime sweep <https://github.com/fractastical/morpholib/blob/HEAD/2013-chirat-mollusc-shell-marginal-buckling.py#L28-L38>" ;
        pk:hasScore "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


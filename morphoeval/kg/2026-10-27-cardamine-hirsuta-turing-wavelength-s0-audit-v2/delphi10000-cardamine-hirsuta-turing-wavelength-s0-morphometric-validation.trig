sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/j.cell.2019.05.011>,
            <https://doi.org/10.1038/ng1835>,
            <https://doi.org/10.1093/plphys/kiae213>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1248384> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1016/j.cell.2019.05.011> dct:date "2019"^^xsd:gYear ;
        dct:title "A Growth-Based Framework for Leaf Shape Development and Diversity" .
    <https://doi.org/10.1038/ng1835> dct:date "2006"^^xsd:gYear ;
        dct:title "The genetic basis for differences in leaf form between Arabidopsis thaliana and its wild relative Cardamine hirsuta" .
    <https://doi.org/10.1093/plphys/kiae213> dct:date "2024"^^xsd:gYear ;
        dct:title "The trichome pattern diversity of Cardamine shares genetic mechanisms with Arabidopsis but differs in environmental drivers" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.1248384> dct:date "2014"^^xsd:gYear ;
        dct:title "Leaf Shape Evolution Through Duplication, Regulatory Diversification, and Loss of a Homeobox Gene" .
}


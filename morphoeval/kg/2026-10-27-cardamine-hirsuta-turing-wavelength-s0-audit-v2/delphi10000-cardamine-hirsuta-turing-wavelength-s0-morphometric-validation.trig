sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength on Cardamine hirsuta at 154 µm (Pass 2) — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion-band Pearson r = 0.999896 against reference gate 0.98, RMSE = 0.001564 against a 0.05 tolerance, nonlinear spacing 173.362 µm against the 154.1 µm law (values differ on purpose), ablation sigma_max = -0.1016 against 0, and the specimen mask metrics differ from their priors. Orientation KS is about 0.016, not zero. n = 1 photograph and two seeds." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-diffusion-ratio-sweep-selected-wavelength-at-d-v-d-u-40>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-dispersion-band-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-dispersion-band-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-nonlinear-ocellus-spacing-on-the-detail-field>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-image-radial-fft-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-leaf-foreground-area-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-rosette-bounding-box-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-versus-render-orientation-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-diffusion-ratio-sweep-selected-wavelength-at-d-v-d-u-40> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffusion-ratio sweep selected wavelength at D_v/D_u = 40 = 217.435 µm" ;
        dct:description "monotonic_increasing=True" ;
        schema:measurementTechnique "Argmax of sigma(k) at D_v = 1.60, converted with the operating-point length unit." ;
        schema:name "diffusion-ratio sweep selected wavelength at D_v/D_u = 40" ;
        schema:unitText "µm" ;
        schema:value "217.435" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-diffusion-ratio-sweep-selected-wavelength-at-d-v-d-u-40-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-diffusion-ratio-sweep-selected-wavelength-at-d-v-d-u-40-reference> a schema:PropertyValue ;
        dct:source "Operating-point classical wavelength. Faster inhibitor diffusion lengthens the fastest mode." ;
        schema:value "154.1" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-dispersion-band-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion-band pearson r = 0.999896 Pearson r" ;
        dct:description "RMSE = 0.001564" ;
        schema:measurementTechnique "Pearson correlation of analytic σ(k) and a linear-window fit on nine wavenumbers around k_c." ;
        schema:name "dispersion-band pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.999896" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-dispersion-band-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-dispersion-band-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Pass gate r > 0.98 against the analytic growth-rate curve, not against itself." ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-dispersion-band-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion-band RMSE = 0.001564 growth-rate units" ;
        schema:measurementTechnique "Root mean square error between analytic and numerically fitted σ(k)." ;
        schema:name "dispersion-band RMSE" ;
        schema:unitText "growth-rate units" ;
        schema:value "0.001564" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-dispersion-band-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-dispersion-band-rmse-reference> a schema:PropertyValue ;
        dct:source "A loose 0.05 tolerance on σ; the fit is tighter than this." ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation sigma_max = -0.1016 1/time" ;
        dct:description "ablation std 0.0201 -> 0.0002; patterned sigma(k_c) = 0.0703" ;
        schema:measurementTechnique "Maximum analytic growth rate on k in [0.2, 6] with D_u = D_v, plus a 1500-step control integration." ;
        schema:name "equal-diffusion ablation sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.1016" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max-reference> a schema:PropertyValue ;
        dct:source "The patterned state has sigma(k_c) > 0. Equal D_u = D_v = 0.04 must sit below 0." ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-nonlinear-ocellus-spacing-on-the-detail-field> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nonlinear ocellus spacing on the detail field = 173.362 µm" ;
        dct:description "per-seed µm = [173.36249999999998, 173.36249999999998]; CV = 0.0000; pattern std = 0.2515" ;
        schema:measurementTechnique "Mean first autocorrelation peak of activator u over seeds 3140 and 3141, times dx = 154.1/16 µm." ;
        schema:name "nonlinear ocellus spacing on the detail field" ;
        schema:unitText "µm" ;
        schema:value "173.362" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-nonlinear-ocellus-spacing-on-the-detail-field-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-nonlinear-ocellus-spacing-on-the-detail-field-reference> a schema:PropertyValue ;
        dct:source "Classical Turing wavelength lambda_c = 154.1 µm from k_c at D_v/D_u = 10.5." ;
        schema:value "154.1" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen contour circularity = 0.0926 4*pi*A/P^2" ;
        schema:measurementTechnique "Perimeter from the erosion outline of the specimen mask." ;
        schema:name "specimen contour circularity" ;
        schema:unitText "4*pi*A/P^2" ;
        schema:value "0.0926" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "A circle has circularity 1. A rosette with petioles and roots does not." ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-image-radial-fft-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image radial-FFT pearson r = 0.9948 Pearson r" ;
        schema:measurementTechnique "Pearson r of the 22-bin log radial FFT used by the image-fitness verifier." ;
        schema:name "specimen image radial-FFT pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9948" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-image-radial-fft-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-image-radial-fft-pearson-r-reference> a schema:PropertyValue ;
        dct:source "A 0.90 radial-spectrum prior. The last GIF frame is scored directly against the photograph." ;
        schema:value "0.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-leaf-foreground-area-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen leaf foreground area fraction = 0.2825 fraction" ;
        schema:measurementTechnique "Non-white mask on the public-domain Cardamine hirsuta photograph after a 1-pixel opening." ;
        schema:name "specimen leaf foreground area fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.2825" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-leaf-foreground-area-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-leaf-foreground-area-fraction-reference> a schema:PropertyValue ;
        dct:source "A filled-blade prior of 0.50; the herbarium rosette is sparser than a cropped leaflet." ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-rosette-bounding-box-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen rosette bounding-box aspect ratio = 0.6048 width/height" ;
        schema:measurementTechnique "Bounding box of the segmented plant silhouette." ;
        schema:name "specimen rosette bounding-box aspect ratio" ;
        schema:unitText "width/height" ;
        schema:value "0.6048" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-rosette-bounding-box-aspect-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-rosette-bounding-box-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "Square-frame prior. The vendored portrait is taller than it is wide." ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.2984 coherency" ;
        schema:measurementTechnique "Mean structure-tensor coherency of the specimen luminance." ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.2984" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "A weakly oriented texture prior of 0.20, below the photographed rosette." ;
        schema:value "0.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-versus-render-orientation-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen versus render orientation KS statistic = 0.0156 KS D" ;
        dct:description "p = 0.9213; radial FFT Pearson r = 0.9948; CV similarity = 96.0" ;
        schema:measurementTechnique "Two-sample KS on Sobel orientations of the specimen crop and the GIF last frame." ;
        schema:name "specimen versus render orientation KS statistic" ;
        schema:unitText "KS D" ;
        schema:value "0.0156" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-versus-render-orientation-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-measurement-specimen-versus-render-orientation-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "KS D = 0 would mean the gradient-orientation samples are identical." ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cardamine-hirsuta-turing-wavelength-s0.py L551–L664" ;

<https://w3id.org/delphi/resource/math-law/delphi10000-cardamine-hirsuta-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant and critical wavenumber" ;
    dct:description "Selects the 154.1 µm classical wavelength on the Cardamine detail patch | Variables: u activator, v inhibitor, D_u, D_v diffusivities, f_u and g_v Jacobian entries at (u0, v0) = (1, 0.9)" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cardamine-hirsuta-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3140_cardamine_hirsuta_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v) = 185/21 at a=0.10, b=0.90, D_u=0.04, D_v=0.42" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cell.2019.05.011>,
        <https://doi.org/10.1038/ng1835>,
        <https://doi.org/10.1093/plphys/kiae213>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1248384> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3140.kc_sq_cross_multiply" ;
    pk:leanTheorem "MathOfBiology.Loop_3140.kc_sq_cross_multiply" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-cardamine-hirsuta-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diffusion-driven instability inequality" ;
    dct:description "The homogeneous leaflet state is stable until diffusion is added; equal diffusivities are the ablation | Variables: trace = -0.2, det = 1, margin 87616 > 67200 in units of 1e-6" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cardamine-hirsuta-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3140_cardamine_hirsuta_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(D_v f_u + D_u g_v)^2 > 4 D_u D_v det(J), with trace(J) < 0 and det(J) > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cell.2019.05.011>,
        <https://doi.org/10.1038/ng1835>,
        <https://doi.org/10.1093/plphys/kiae213>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1248384> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3140.turing_inequality_squared" ;
    pk:leanTheorem "MathOfBiology.Loop_3140.turing_inequality_squared" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-cardamine-hirsuta-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail-domain mode count versus a cell-scale cutoff" ;
    dct:description "States what changes at 154 µm and 0 Ma relative to a cell-scale predecessor domain and the absent chronospecies | Variables: N mode count, L_detail = 1.233 mm, L_cell = 16 µm, age = 0 Ma, series index = series length = 1" ;
    dct:source "Kierzkowski et al. 2019 DOI:10.1016/j.cell.2019.05.011; Vlad et al. 2014 DOI:10.1126/science.1248384" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cardamine-hirsuta-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3140_cardamine_hirsuta_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = 128/16 = 8 on the detail patch; a 16 µm cell satisfies L < 154 µm so the mode is cut off. Chronoseries gap = 1 - 1 = 0 at 0 Ma." ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cell.2019.05.011>,
        <https://doi.org/10.1038/ng1835>,
        <https://doi.org/10.1093/plphys/kiae213>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1248384> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3140.detail_domain_holds_eight_wavelengths" ;
    pk:leanTheorem "MathOfBiology.Loop_3140.holocene_terminal_chronoseries" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,

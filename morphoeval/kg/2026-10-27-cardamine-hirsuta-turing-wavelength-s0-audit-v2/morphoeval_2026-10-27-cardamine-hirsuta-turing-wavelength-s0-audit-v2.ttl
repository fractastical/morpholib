<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg Turing wavelength on Cardamine hirsuta at 154 µm (Pass 2) — Code-to-model traceability: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Each of k_c, the instability inequality, and the eight-wavelength Holocene cutoff has a Lean theorem and a Python function. The math-kg YAML names those declarations. Pass 2 does not add a second formalization." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

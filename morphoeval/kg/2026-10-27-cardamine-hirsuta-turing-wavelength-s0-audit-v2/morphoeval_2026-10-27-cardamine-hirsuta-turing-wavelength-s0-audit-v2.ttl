    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-code-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-code-traceability-2> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg Turing wavelength on Cardamine hirsuta at 154 µm (Pass 2) — Model fidelity to source: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;

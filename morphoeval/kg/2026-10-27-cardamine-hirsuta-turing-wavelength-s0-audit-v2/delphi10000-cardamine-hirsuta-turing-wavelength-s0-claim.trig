    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Schnakenberg Turing wavelength on Cardamine hirsuta at 154 µm (Pass 2) faithfully reproduces Cardamine hirsuta (hairy bittercress) morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-cardamine-hirsuta-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Cardamine hirsuta (hairy bittercress) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cardamine-hirsuta-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cardamine-hirsuta-turing-wavelength-s0.py; output: docs/media/cardamine_hirsuta_turing_wavelength_s0_comparison.png; organism: Cardamine hirsuta (hairy bittercress); environment: n/a; claim_boundary: [reported_in_source: Turing (1952) selects a finite critical wavenumber from reaction and diffusion. | Schnakenberg (1979) supplies the kinetics a - u + u^2 v and b - u^2 v. | Hay and Tsiantis (2006), Vlad et al. (2014), and Kierzkowski et al. (2019) establish Cardamine hirsuta as the compound-leaf comparison and tie RCO to domain size rather than to a local wavenumber.; reconstructed_in_script: Neumann Schnakenberg integration, dispersion fit, D_v sweep, and equal-diffusion ablation, now scored from the measurement sidecar. | Specimen mask morphometrics and the orientation KS / radial-FFT comparison against the Commons photograph.; transfer_boundary: 154.1 µm is the classical wavelength of this parameter point, pinned to the slot scale. It is not a length reported by the cited Cardamine papers.; does_not_claim: That the herbarium photograph resolves individual 154 µm ocelli. | A predecessor or successor chronospecies. The series length is 1 and the age is 0 Ma. | That matching the plant's silhouette validates the wavenumber. The wavenumber is tested by the dispersion fit and the spacing measurement.]; phenomenon_size: 4.5 cm (0.045 m, log10=-1.347 m, tier=7_organism_cm); species_scale_ladder (1 runs from 4.5 cm to 4.5 cm): 4.5 cm:allometric-compound-leaf" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/j.cell.2019.05.011>,
            <https://doi.org/10.1038/ng1835>,
            <https://doi.org/10.1093/plphys/kiae213>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1248384> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cardamine-hirsuta-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-cardamine-hirsuta-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


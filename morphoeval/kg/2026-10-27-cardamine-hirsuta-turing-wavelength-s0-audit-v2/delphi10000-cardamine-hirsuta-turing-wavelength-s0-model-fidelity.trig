sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength on Cardamine hirsuta at 154 µm (Pass 2) — Model fidelity to source: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 2 keeps the implemented Jacobian, wavenumber law, Neumann integrator, and the integer Lean checks. The ablation panel shows the equal-diffusion field staying flat on the same color scale as the patterned field, which is the negative control the kinetics predict. The pigment label remains a reconstruction, so the score stays below 95." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cardamine-hirsuta-turing-wavelength-s0.py L103–L134" ;
        dct:description "k_c law and Turing margin" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cardamine-hirsuta-turing-wavelength-s0.py#L103-L134> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cardamine-hirsuta-turing-wavelength-s0.py L241–L266" ;
        dct:description "Equal-diffusion ablation returns sigma_max and the flat field" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cardamine-hirsuta-turing-wavelength-s0.py#L241-L266> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3140_cardamine_hirsuta_turing_wavelength_s0.lean L13–L28" ;
        dct:description "k_c cross-multiply, squared inequality, diffusion ratio, negative trace" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3140_cardamine_hirsuta_turing_wavelength_s0.lean#L13-L28> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, Pass 2; second assessor still pending)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


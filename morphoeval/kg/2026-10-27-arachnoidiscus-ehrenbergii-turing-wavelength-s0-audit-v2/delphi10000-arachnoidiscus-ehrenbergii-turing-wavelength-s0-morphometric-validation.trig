sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Arachnoidiscus ehrenbergii Schnakenberg Turing wavelength at 242 nm (Holocene, 0 Ma) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The active measure_morphoeval reports the linear 242 nm carrier, the nonlinear FFT wavelength 284.76 nm (not equal to 242), gallery radial Pearson 0.9863 against a reference of 1, radial RMSE 0.573, KS 0.110, unguided spatial Pearson 0.071, ablation contrast ratio 162, sweep gain, gallery Otsu foreground 0.885, and Wikimedia valve fill 0.988 versus a perfect disk at 1. Deducted because the radial Pearson is computed on the envelope-mixed frame, and the Wikimedia valve is genus-level." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-ablation-contrast-ratio-patterned-over-equal-diffusion>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-analytic-selected-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-diffusion-ratio-sweep-sigma-gain>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-field-nonlinear-fft-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-gallery-otsu-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-luminance-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-radial-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-radial-spectrum-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-unguided-spatial-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-wikimedia-valve-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-ablation-contrast-ratio-patterned-over-equal-diffusion> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation contrast ratio patterned over equal diffusion = 162.1596 std ratio" ;
        dct:description "patterned std=0.4050; control std=0.0025" ;
        schema:measurementTechnique "std(u-u0) of the D_v/D_u=31.18 run divided by the simulated D_u=D_v control" ;
        schema:name "ablation contrast ratio patterned over equal diffusion" ;
        schema:unitText "std ratio" ;
        schema:value "162.1596" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-ablation-contrast-ratio-patterned-over-equal-diffusion-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-ablation-contrast-ratio-patterned-over-equal-diffusion-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-analytic-selected-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "analytic selected wavelength = 242.0 nm" ;
        dct:description "linear carrier, exact by the diffusivity solve; not the nonlinear FFT peak" ;
        schema:measurementTechnique "k_c from (D_v f_u + D_u g_v) / (2 D_u D_v) at D_v/D_u = 31.18" ;
        schema:name "analytic selected wavelength" ;
        schema:unitText "nm" ;
        schema:value "242.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-analytic-selected-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-analytic-selected-wavelength-reference> a schema:PropertyValue ;
        schema:value "242.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-diffusion-ratio-sweep-sigma-gain> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffusion-ratio sweep sigma gain = 0.296267 per model time" ;
        dct:description "monotonic increase is checked in self-test; cv of the eight-point sweep is not a specimen cv" ;
        schema:measurementTechnique "sigma(k_c) at ratio 72 minus sigma(k_c) at ratio 16; both above discriminant onset" ;
        schema:name "diffusion-ratio sweep sigma gain" ;
        schema:unitText "per model time" ;
        schema:value "0.296267" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-diffusion-ratio-sweep-sigma-gain-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-diffusion-ratio-sweep-sigma-gain-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-field-nonlinear-fft-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen-field nonlinear fft wavelength = 284.7606 nm" ;
        dct:description "non-circular: value is the nonlinear spacing, reference is the linear carrier" ;
        schema:measurementTechnique "radial FFT peak of the unguided saturated activator on the 96^2 grid" ;
        schema:name "specimen-field nonlinear fft wavelength" ;
        schema:unitText "nm" ;
        schema:value "284.7606" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-field-nonlinear-fft-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-field-nonlinear-fft-wavelength-reference> a schema:PropertyValue ;
        schema:value "242.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-gallery-otsu-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen gallery otsu foreground fraction = 0.884616 area fraction" ;
        dct:description "gallery circularity=0.0219; coherency=0.2691" ;
        schema:measurementTechnique "Otsu threshold 87.0 on the 640x480 gallery luminance" ;
        schema:name "specimen gallery otsu foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.884616" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-gallery-otsu-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-gallery-otsu-foreground-fraction-reference> a schema:PropertyValue ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-luminance-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen luminance ks statistic = 0.110204 KS distance" ;
        dct:description "uncertainty / distribution distance, not a p-value claimed as a discovery" ;
        schema:measurementTechnique "two-sample KS on gallery versus calibrated-frame luminance" ;
        schema:name "specimen luminance ks statistic" ;
        schema:unitText "KS distance" ;
        schema:value "0.110204" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-luminance-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-luminance-ks-statistic-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-radial-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial rmse = 0.573087 log-power" ;
        dct:description "paired with pearson r=0.9863" ;
        schema:measurementTechnique "RMSE of log1p radial power spectra, gallery versus calibrated last frame" ;
        schema:name "specimen radial rmse" ;
        schema:unitText "log-power" ;
        schema:value "0.573087" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-radial-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-radial-rmse-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-radial-spectrum-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial-spectrum pearson r = 0.986335 pearson r" ;
        dct:description "radial rmse=0.5731; ks=0.1102; this is the specimen goodness-of-fit" ;
        schema:measurementTechnique "corrcoef of 48-bin log radial FFT; GIF envelope weight 0.55" ;
        schema:name "specimen radial-spectrum pearson r" ;
        schema:unitText "pearson r" ;
        schema:value "0.986335" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-radial-spectrum-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-radial-spectrum-pearson-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-unguided-spatial-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen unguided spatial pearson r = 0.071434 pearson r" ;
        dct:description "honest negative: the three ocelli do not reproduce the gallery spiral pixelwise" ;
        schema:measurementTechnique "corrcoef of gallery luminance against the unguided colourised activator" ;
        schema:name "specimen unguided spatial pearson r" ;
        schema:unitText "pearson r" ;
        schema:value "0.071434" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-unguided-spatial-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-specimen-unguided-spatial-pearson-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-wikimedia-valve-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wikimedia valve circularity = 0.988068 area / (pi r_max^2)" ;
        dct:description "aspect=0.9967; foreground=0.3035; genus-level image, not confirmed ehrenbergii" ;
        schema:measurementTechnique "filled dark-on-white silhouette over its circumscribed circle; CC BY 2.0 Arachnoidiscus sp. valve at 480 px" ;

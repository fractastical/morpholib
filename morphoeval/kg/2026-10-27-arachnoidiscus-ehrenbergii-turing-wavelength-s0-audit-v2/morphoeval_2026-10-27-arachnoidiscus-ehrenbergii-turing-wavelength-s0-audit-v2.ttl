<https://w3id.org/delphi/resource/math-law/delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg Jacobian at the homogeneous SDV steady state" ;
    dct:description "Trace f_u + g_v < 0 so the well-mixed sol is stable; equal diffusion cannot select a wavelength | Variables: a = 0.062 (silaffin production), b = 1.35 (polyamine production); f_u = +0.912, g_v = -1.994" ;
    dct:source "Schnakenberg 1979 JTB 81:389-400, doi:10.1016/0022-5193(79)90042-0; Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3118_arachnoidiscus_ehrenbergii_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u0 = a + b, v0 = b/u0^2, f_u = -1 + 2 b/u0, g_v = -u0^2, with a = 0.062, b = 1.35" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/s0074-7696(08)61544-2>,
        <https://doi.org/10.1021/la702278f>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1070026>,
        <https://doi.org/10.1126/science.286.5442.1129>,
        <https://doi.org/10.15281/jplantres1887.24.278_47> ;
    pk:hypothesisType "Reaction-Diffusion and Turing wavenumber selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3118.wavelengthNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3118.equal_diffusion_trace_term_is_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Selected Turing wavenumber at 242 nm" ;
    dct:description "Locks the cribral carrier on the Holocene valve at the detail scale of this slot | Variables: D_v/D_u = 31.18 > discriminant onset 13.605; lambda_c = 2.42e-7 m" ;
    dct:source "Turing 1952 Phil Trans R Soc B 237:37-72, doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3118_arachnoidiscus_ehrenbergii_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c = 242 nm, D_v/D_u = 31.18" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/s0074-7696(08)61544-2>,
        <https://doi.org/10.1021/la702278f>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1070026>,
        <https://doi.org/10.1126/science.286.5442.1129>,
        <https://doi.org/10.15281/jplantres1887.24.278_47> ;
    pk:hypothesisType "Reaction-Diffusion and Turing wavenumber selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3118.diffusionRatioMilli" ;
    pk:leanTheorem "MathOfBiology.Loop_3118.diffusion_ratio_exceeds_turing_onset" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Six-wavelength detail domain versus the unpatterned predecessor state" ;
    dct:description "States what changes at 0 Ma and 242 nm relative to the homogeneous SDV sol, the only predecessor this 1/1 series has | Variables: L = 1.452e-6 m; age offset 0 Ma (theorem holocene_chronoseries_age_offset_is_zero)" ;
    dct:source "Sumper 2002 Science 295:2430-2433, doi:10.1126/science.1070026; Lenoci and Camp 2008 Langmuir 24:217-223, doi:10.1021/la702278f" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3118_arachnoidiscus_ehrenbergii_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "L = 6 lambda_c = 1452 nm; equal-diffusion control has max Re sigma(k) < 0; patterned state has sigma(k_c) > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/s0074-7696(08)61544-2>,
        <https://doi.org/10.1021/la702278f>,

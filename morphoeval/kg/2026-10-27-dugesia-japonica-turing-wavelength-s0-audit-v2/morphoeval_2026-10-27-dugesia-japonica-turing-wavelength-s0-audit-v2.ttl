    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3213.seven_wavelengths_fill_detail_field" ;
    pk:leanTheorem "MathOfBiology.Loop_3213.seven_wavelengths_fill_detail_field" ;

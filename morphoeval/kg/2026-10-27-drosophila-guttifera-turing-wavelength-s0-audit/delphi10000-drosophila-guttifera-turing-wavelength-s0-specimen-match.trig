sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg micro-ocellus wavelength of Drosophila guttifera at 2.12 µm — Morphological realism / specimen match: 74/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The comparison figure places the CC BY-SA adult male beside guttifera, grimshawi, and heteroneura fields. Grimshawi is the oriented field (coherency 0.48 vs 0.01). The GIF's last frame is the photograph, so it matches the adult, not a 2.12 µm micrograph. Global segmentation returns 28 blobs rather than 16 wing spots." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/drosophila_guttifera_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "adult photograph beside three chronospecies fields, dispersion curve, and Dv sweep — docs/media/drosophila_guttifera_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-drosophila-guttifera-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/png, 479439 B, 1512×1008 px, artifact_sha256 9e62649b8e7299a09073eacf2e1f3badfaaa2a43786da966ef6bdaee8e4c8305 (sha256 9e62649b8e7299a09073eacf2e1f3badfaaa2a43786da966ef6bdaee8e4c8305), spec_fingerprint c4a6d950a832bc4358255a26def4f385a34b6882ca4a5713ae484c2d3f07773c" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/drosophila_guttifera_turing_wavelength_s0_growth.gif (generated output)" ;

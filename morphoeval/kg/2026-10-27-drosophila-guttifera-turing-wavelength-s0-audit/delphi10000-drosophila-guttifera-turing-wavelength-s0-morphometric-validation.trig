        schema:value "16.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen foreground fraction = 0.5692011071670048 area fraction" ;
        schema:measurementTechnique "pixels whose contrast to the border median exceeds the 45th percentile" ;

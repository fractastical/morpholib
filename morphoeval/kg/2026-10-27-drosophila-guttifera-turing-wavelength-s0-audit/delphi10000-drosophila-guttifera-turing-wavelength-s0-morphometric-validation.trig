            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.5564665037367912 coherency" ;
        schema:measurementTechnique "Sobel structure tensor on the CC BY-SA adult male, masked against the border median" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.5564665037367912" ;

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-guttifera-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Marginal Turing discriminant" ;
    dct:description "Diffusion-driven instability condition for the guttifera micro-ocellus wavelength | Variables: Du=0.016, Dv=1.25, a=0.10, b=0.90 at lambda = 2.12 µm" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-guttifera-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3187_drosophila_guttifera_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem marginal_turing_discriminant_is_positive : (123 : Nat) * 123 > 10 * 125 := by decide"^^pk:lean4 ;
    skos:notation "(Dv f_u + Du g_v)^2 > 4 Du Dv det(J), focal integers 123^2 > 10*125" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s00427-017-0578-3>,
        <https://doi.org/10.1007/s00427-021-00674-z>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1038/nature08896>,
        <https://doi.org/10.1073/pnas.1509022112>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.2307/2407863> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (Turing Reaction-Diffusion Wavelength Selection)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3187.marginal_turing_discriminant_is_positive" ;
    pk:leanTheorem "MathOfBiology.Loop_3187.marginal_turing_discriminant_is_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-guttifera-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Eight-wavelength patch length" ;
    dct:description "Domain used to count micro-ocelli at the detail tier, distinct from the 16 adult wing spots | Variables: patchWaves = 8, lambdaNm = 2120" ;
    dct:source "Werner et al. 2010 DOI:10.1038/nature08896 (prepattern); scale assigned at tier 3_subcellular_um" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-guttifera-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3187_drosophila_guttifera_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem patch_spans_eight_wavelengths : patchWaves * lambdaNm = 16960 := by decide"^^pk:lean4 ;
    skos:notation "L = 8 * 2120 nm = 16960 nm" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s00427-017-0578-3>,
        <https://doi.org/10.1007/s00427-021-00674-z>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1038/nature08896>,
        <https://doi.org/10.1073/pnas.1509022112>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.2307/2407863> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (Turing Reaction-Diffusion Wavelength Selection)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3187.patch_spans_eight_wavelengths" ;
    pk:leanTheorem "MathOfBiology.Loop_3187.patch_spans_eight_wavelengths" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-guttifera-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Inhibitor-activator diffusion separation" ;
    dct:description "Long-range inhibition required for spot selection at 2.12 µm | Variables: Du = 0.016, Dv = 1.25" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-guttifera-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3187_drosophila_guttifera_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem inhibitor_diffuses_faster_than_activator : dvMilli > 20 * duMilli := by decide"^^pk:lean4 ;
    skos:notation "Dv_milli > 20 * Du_milli (1250 > 320)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s00427-017-0578-3>,
        <https://doi.org/10.1007/s00427-021-00674-z>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1038/nature08896>,
        <https://doi.org/10.1073/pnas.1509022112>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.2307/2407863> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (Turing Reaction-Diffusion Wavelength Selection)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3187.inhibitor_diffuses_faster_than_activator" ;
    pk:leanTheorem "MathOfBiology.Loop_3187.inhibitor_diffuses_faster_than_activator" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-guttifera-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronospecies prepattern inequality at 0 Ma" ;
    dct:description "What changes versus predecessor grimshawi and successor heteroneura at this scale and age | Variables: grimshawi anisotropy 315/100; heteroneura activator 240; guttifera activator 100" ;

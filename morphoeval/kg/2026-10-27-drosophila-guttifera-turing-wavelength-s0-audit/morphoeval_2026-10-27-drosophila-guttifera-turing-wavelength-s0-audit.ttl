<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg micro-ocellus wavelength of Drosophila guttifera at 2.12 µm — Morphological realism / specimen match: 74/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The comparison figure places the CC BY-SA adult male beside guttifera, grimshawi, and heteroneura fields. Grimshawi is the oriented field (coherency 0.48 vs 0.01). The GIF's last frame is the photograph, so it matches the adult, not a 2.12 µm micrograph. Global segmentation returns 28 blobs rather than 16 wing spots." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;

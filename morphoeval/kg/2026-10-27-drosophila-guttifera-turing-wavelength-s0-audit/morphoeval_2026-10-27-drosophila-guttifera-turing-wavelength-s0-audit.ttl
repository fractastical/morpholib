<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg micro-ocellus wavelength of Drosophila guttifera at 2.12 µm — Code-to-model traceability: 80/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The module docstring states the PDE, k_c, and the chronospecies contrast. dispersion() is the equation. The Lean file proves the integer form of the same discriminant and the 8-by-2120 nm patch. Pass 1 does not yet mark a zero-flux control in the code." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-code-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-code-traceability-2> ;
    pk:hasScore 8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;

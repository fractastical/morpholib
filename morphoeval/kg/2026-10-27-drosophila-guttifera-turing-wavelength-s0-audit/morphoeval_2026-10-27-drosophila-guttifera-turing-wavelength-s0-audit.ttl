<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg micro-ocellus wavelength of Drosophila guttifera at 2.12 µm — Morphometric validation: 78/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Pearson r = 0.992 and RMSE = 0.208 µm on the linear centroid. KS D = 0.5 against a reference of 0, so the numerical and analytical sets are not the same distribution. Specimen coherency 0.556 and foreground fraction 0.569 are measured on the photograph and are not equal to their reference values. The spot count (28 vs 16) is an unrefined global threshold. Saturated inter-peak spacing is not yet measured." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-guttifera-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio>,

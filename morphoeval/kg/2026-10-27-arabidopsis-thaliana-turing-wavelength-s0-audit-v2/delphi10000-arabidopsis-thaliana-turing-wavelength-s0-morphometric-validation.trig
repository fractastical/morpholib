sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.celrep.2020.108497>,
            <https://doi.org/10.1073/pnas.2309616120>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1371/journal.pbio.0060141> .
    <https://doi.org/10.1016/j.celrep.2020.108497> dct:date "2020"^^xsd:gYear ;
        dct:title "Identification of the trichome patterning core network using data from weak ttg1 alleles to constrain the model space" .
    <https://doi.org/10.1073/pnas.2309616120> dct:date "2023"^^xsd:gYear ;
        dct:title "Stochastic Turing patterns of trichomes in Arabidopsis leaves" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1371/journal.pbio.0060141> dct:date "2008"^^xsd:gYear ;
        dct:title "Two-dimensional patterning by a trapping/depletion mechanism: the role of TTG1 and GL3 in Arabidopsis trichome formation" .
}


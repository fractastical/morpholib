sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Arabidopsis thaliana Turing wavenumber at 111.6 µm — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Law wavelength 111.6 µm, measured FFT wavelength 111.50 µm. Twenty-one spots, mean nearest neighbour 101.11 µm, CV 0.108, bootstrap 95% CI 96.60–105.81 µm (half-width 4.61 µm, not equal to the mean). KS D = 0.495 against Normal(111.6, 16.74), above the 5% critical value 0.297, so that normal is rejected and the rejection is kept. Specimen cyan area 0.094 versus simulated peak area 0.284. Specimen coherency 0.582 versus field coherency 0.715. Stochastic tail ratio 1.70 versus a null ratio of 1. Cell-scale predecessor mode count 0 versus 4 on this patch. Pearson r = 0.99991." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-cell-scale-predecessor-mode-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-dispersion-pearson-r-continuum-vs-grid>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-equal-diffusion-control-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-leaf-primordium-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-spacing-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-specimen-epidermis-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-specimen-trichome-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-specimen-trichome-cyan-area-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-stochastic-spectral-tail-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-trichome-nearest-neighbour-spacing>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-trichome-spacing-bootstrap-ci-half-width>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-cell-scale-predecessor-mode-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cell-scale predecessor mode count = 0 1" ;
        dct:description "same Holocene age; the cell is subcritical" ;
        schema:measurementTechnique "floor(18.6 µm / 111.6 µm) on the pavement-cell predecessor at 0 Ma" ;
        schema:name "cell-scale predecessor mode count" ;
        schema:unitText "1" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-cell-scale-predecessor-mode-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-cell-scale-predecessor-mode-count-reference> a schema:PropertyValue ;
        dct:source "this primordium patch holds 4 wavelengths" ;
        schema:value "4" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-dispersion-pearson-r-continuum-vs-grid> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion pearson r continuum vs grid = 0.999906 1" ;
        dct:description "rmse=0.003364; not a val==ref self-score of the wavelength" ;
        schema:measurementTechnique "Pearson r of σ(k) on 18 wavenumbers" ;
        schema:name "dispersion pearson r continuum vs grid" ;
        schema:unitText "1" ;
        schema:value "0.999906" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-dispersion-pearson-r-continuum-vs-grid-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-dispersion-pearson-r-continuum-vs-grid-reference> a schema:PropertyValue ;
        dct:source "identity of the linear dispersion relation" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 0.003364 1/time" ;
        dct:description "rmse of the growth-rate curve" ;
        schema:measurementTechnique "RMSE between continuum σ(k) and the discrete-Laplacian symbol on the 128 grid" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.003364" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "exact linear theory" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-equal-diffusion-control-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control amplitude ratio = 0.0 1" ;
        dct:description "negative control; ratio near 0 means the ablation killed the spots" ;
        schema:measurementTechnique "std(u|D_u=D_v) / std(u|d=8.4) after the same horizon" ;
        schema:name "equal-diffusion control amplitude ratio" ;
        schema:unitText "1" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-equal-diffusion-control-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-equal-diffusion-control-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "Turing 1952: equal diffusion cannot destabilise when trace(J)<0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-leaf-primordium-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "leaf primordium stripe wavelength = 111.4951 µm" ;
        dct:description "nonlinear peak vs law λ_c; relative error -0.0009" ;
        schema:measurementTechnique "parabolic sub-bin radial FFT of activator u" ;
        schema:name "leaf primordium stripe wavelength" ;
        schema:unitText "µm" ;
        schema:value "111.4951" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-leaf-primordium-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-leaf-primordium-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "catalog scale 0.0001116 m; Turing 1952 k_c law with D_v/D_u = 8.4" ;
        schema:value "111.6" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-spacing-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "spacing KS statistic = 0.4948 1" ;
        dct:description "p=2.85e-05; value is D, reference is the critical value" ;
        schema:measurementTechnique "Kolmogorov-Smirnov D of NN distances vs Normal(111.6, 16.74)" ;
        schema:name "spacing KS statistic" ;
        schema:unitText "1" ;
        schema:value "0.4948" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-spacing-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-spacing-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "asymptotic 5% KS critical value 1.36/sqrt(n)" ;
        schema:value "0.2968" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-specimen-epidermis-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen epidermis foreground fraction = 0.5675 1" ;
        dct:description "two real specimens; neither equals the model scalar" ;
        schema:measurementTechnique "border-contrast foreground on Boutet epidermis cryo-SEM" ;
        schema:name "specimen epidermis foreground fraction" ;
        schema:unitText "1" ;
        schema:value "0.5675" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-specimen-epidermis-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-specimen-epidermis-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "foreground fraction of the trichome SEM" ;
        schema:value "0.3988" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-specimen-trichome-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen trichome coherency = 0.5816 1" ;
        dct:description "non-circular specimen vs simulation coherency" ;
        schema:measurementTechnique "structure-tensor coherency on the trichome SEM" ;
        schema:name "specimen trichome coherency" ;
        schema:unitText "1" ;
        schema:value "0.5816" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-specimen-trichome-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-specimen-trichome-coherency-reference> a schema:PropertyValue ;
        dct:source "structure-tensor coherency of the final activator field" ;
        schema:value "0.7152" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-specimen-trichome-cyan-area-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen trichome cyan area fraction = 0.0943 1" ;
        dct:description "specimen segmentation vs simulation occupancy; the two fractions are different objects" ;
        schema:measurementTechnique "cyan threshold on the Paves SEM (B>0.42, B>R+0.12) after opening/closing" ;
        schema:name "specimen trichome cyan area fraction" ;
        schema:unitText "1" ;
        schema:value "0.0943" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-specimen-trichome-cyan-area-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-specimen-trichome-cyan-area-fraction-reference> a schema:PropertyValue ;
        dct:source "fraction of the simulated field above mean+0.5 std" ;
        schema:value "0.2844" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-stochastic-spectral-tail-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stochastic spectral tail ratio = 1.698 1" ;
        dct:description "ratio > 1 supports a fatter stochastic tail; this is not their birth-death master equation" ;
        schema:measurementTechnique "high-k power fraction (k>2 k_c) of the noisy run divided by the deterministic run" ;
        schema:name "stochastic spectral tail ratio" ;
        schema:unitText "1" ;
        schema:value "1.698" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-stochastic-spectral-tail-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-stochastic-spectral-tail-ratio-reference> a schema:PropertyValue ;
        dct:source "Di Patti et al. 2023: noise-driven spectra carry a fatter tail than a deterministic instability" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-trichome-nearest-neighbour-spacing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "trichome nearest-neighbour spacing = 101.1051 µm" ;
        dct:description "cv=0.1075; ks=0.4948 against N(λ_c, (0.15 λ_c)^2); bootstrap 95% CI [96.60, 105.81] µm" ;
        schema:measurementTechnique "nearest-neighbour distances of local maxima of u" ;
        schema:name "trichome nearest-neighbour spacing" ;
        schema:unitText "µm" ;
        schema:value "101.1051" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-trichome-nearest-neighbour-spacing-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-trichome-nearest-neighbour-spacing-reference> a schema:PropertyValue ;
        dct:source "law wavelength 111.6 µm" ;
        schema:value "111.6" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-trichome-spacing-bootstrap-ci-half-width> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "trichome spacing bootstrap CI half-width = 4.6059 µm" ;
        dct:description "95% CI [96.60, 105.81] µm; half-width is not the mean, so the metric is not self-referential" ;
        schema:measurementTechnique "percentile bootstrap, 500 resamples of nearest-neighbour distances" ;
        schema:name "trichome spacing bootstrap CI half-width" ;
        schema:unitText "µm" ;
        schema:value "4.6059" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-trichome-spacing-bootstrap-ci-half-width-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-measurement-trichome-spacing-bootstrap-ci-half-width-reference> a schema:PropertyValue ;
        dct:source "mean nearest-neighbour spacing of the same field" ;
        schema:value "101.1051" .

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Arabidopsis thaliana Turing wavenumber at 111.6 µm — Morphological realism / specimen match: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Computer-vision similarity of the 12-frame 640×480 GIF against the Paves trichome SEM is 93.3 (orientation histogram, radial FFT, structure-tensor coherency, occupancy). The last frame is the SEM with the activator still modulating it; early frames are the primordium field, so the animation actually moves. The spot lattice and the branched hair remain different objects, which caps this below 90. Image fitness = 0.55*93.3 + 0.30*86 + 0.15*90 = 90.6." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/arabidopsis_thaliana_turing_wavelength_s0_growth.gif (generated output)" ;
        dct:description "12 frames, 640×480, CV 93.3 versus the trichome SEM — docs/media/arabidopsis_thaliana_turing_wavelength_s0_growth.gif: rendered output of models/2026-delphi10000-arabidopsis-thaliana-turing-wavelength-s0.py at 7dbcb5f4ae37938efcf50ef7ff5969863bb80dbe, image/gif, 2480014 B, 640×480 px, 12 frames, artifact_sha256 fd77056db04b255c4c3a083c3f2f5fd207c2c2d774422a68166351bf0aa87420 (sha256 fd77056db04b255c4c3a083c3f2f5fd207c2c2d774422a68166351bf0aa87420), spec_fingerprint c3c61462f42b93b82ab11c814de08014335238d29e5879ad1c5373a3aac7d878" .

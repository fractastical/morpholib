sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Arabidopsis thaliana Turing wavenumber at 111.6 µm — Model fidelity to source: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Same Schnakenberg law as pass 1, re-checked. k_c sits at 111.6 µm by construction of Du, and the grid dispersion tracks the continuum curve with r = 0.99991 and RMSE = 0.00336. σ(0) = -0.099 and σ(k_c) = 0.040, so the homogeneous state is stable and the critical mode is not. Equal diffusion at the geometric-mean diffusivity gives std(u) ≈ 3.6e-14 against a patterned std of 0.469. Lean checks the numerator sign and the mode counts on the scale ladder." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-arabidopsis-thaliana-turing-wavelength-s0.py L79–L150" ;
        dct:description "Jacobian and both dispersion relations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7dbcb5f4ae37938efcf50ef7ff5969863bb80dbe/models/2026-delphi10000-arabidopsis-thaliana-turing-wavelength-s0.py#L79-L150> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-arabidopsis-thaliana-turing-wavelength-s0.py L610–L700" ;
        dct:description "Pipeline wires the equal-diffusion ablation and the noisy tail" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7dbcb5f4ae37938efcf50ef7ff5969863bb80dbe/models/2026-delphi10000-arabidopsis-thaliana-turing-wavelength-s0.py#L610-L700> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3117_arabidopsis_thaliana_turing_wavelength_s0.lean L10–L43" ;
        dct:description "Five sorry-free theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7dbcb5f4ae37938efcf50ef7ff5969863bb80dbe/morphoeval/lean/loops/Loop_3117_arabidopsis_thaliana_turing_wavelength_s0.lean#L10-L43> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


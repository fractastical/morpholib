<https://w3id.org/delphi/resource/math-law/delphi10000-arabidopsis-thaliana-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber at 111.6 µm" ;
    dct:description "Selects the spot wavelength on the Holocene primordium epidermis | Variables: Du=10, Dv=84, fu=9, gv=-11 integer witness of the Schnakenberg sign pattern at d=8.4" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7dbcb5f4ae37938efcf50ef7ff5969863bb80dbe/models/2026-delphi10000-arabidopsis-thaliana-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/7dbcb5f4ae37938efcf50ef7ff5969863bb80dbe/morphoeval/lean/loops/Loop_3117_arabidopsis_thaliana_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); lambda_c = 2 pi / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.celrep.2020.108497>,
        <https://doi.org/10.1073/pnas.2309616120>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pbio.0060141> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3117.kcNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3117.arabidopsis_112um_turing_numerator_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-arabidopsis-thaliana-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal diffusion is not a Turing instability" ;
    dct:description "Negative control for the 111.6 µm parameter point | Variables: Du=Dv=10, fu=9, gv=-11" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7dbcb5f4ae37938efcf50ef7ff5969863bb80dbe/models/2026-delphi10000-arabidopsis-thaliana-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/7dbcb5f4ae37938efcf50ef7ff5969863bb80dbe/morphoeval/lean/loops/Loop_3117_arabidopsis_thaliana_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_u = D_v implies D_v f_u + D_u g_v = D (f_u + g_v) < 0 when trace(J) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.celrep.2020.108497>,
        <https://doi.org/10.1073/pnas.2309616120>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pbio.0060141> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3117.kcNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3117.arabidopsis_112um_equal_diffusion_numerator_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-arabidopsis-thaliana-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Scale-ladder mode counts at 0 Ma" ;
    dct:description "What changes at this scale versus the cell predecessor and the leaf successor; age stays 0 Ma | Variables: lengths in micrometres times 10" ;
    dct:source "Bouyer 2008 doi:10.1371/journal.pbio.0060141" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7dbcb5f4ae37938efcf50ef7ff5969863bb80dbe/models/2026-delphi10000-arabidopsis-thaliana-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/7dbcb5f4ae37938efcf50ef7ff5969863bb80dbe/morphoeval/lean/loops/Loop_3117_arabidopsis_thaliana_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = floor(L / lambda_c); N(18.6 µm)=0, N(446.4 µm)=4, N(1785.6 µm)=16" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.celrep.2020.108497>,
        <https://doi.org/10.1073/pnas.2309616120>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pbio.0060141> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3117.modeCount" ;
    pk:leanTheorem "MathOfBiology.Loop_3117.arabidopsis_primordium_patch_holds_four_wavelengths" ;

            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-code-traceability-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-aspergillus-nidulans-turing-wavelength-s0.py L16–L27" ;
        dct:description "Numbered equations tied to the integrator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aspergillus-nidulans-turing-wavelength-s0.py#L16-L27> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3122_aspergillus_nidulans_turing_wavelength_s0.lean L14–L52" ;

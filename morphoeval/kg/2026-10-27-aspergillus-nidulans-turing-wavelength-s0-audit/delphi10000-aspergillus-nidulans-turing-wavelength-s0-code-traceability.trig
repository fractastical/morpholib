sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Aspergillus nidulans Turing onset wavelength at 12.84 µm (nominal 13 µm), Holocene 0 Ma — Code-to-model traceability: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Docstring equations (1)–(4) match steady_state, jacobian, turing_report, simulate and modulate. The Lean file records the 12840 nm wavelength, the 9.295 diffusion ratio and the 0 Ma singleton series. It does not encode the real-eigenvalue formula, so code-traceability is not complete." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

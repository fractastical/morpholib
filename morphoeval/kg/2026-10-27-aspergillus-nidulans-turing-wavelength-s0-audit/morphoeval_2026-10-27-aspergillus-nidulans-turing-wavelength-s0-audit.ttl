<https://w3id.org/delphi/resource/math-law/delphi10000-aspergillus-nidulans-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing onset wavenumber" ;
    dct:description "Detail-scale onset wavelength for Aspergillus nidulans at 0 Ma, longer than the tier floor | Variables: lambda_nm = 12840, tier floor = 10000 nm; margin = 2840 nm versus 10 µm" ;
    dct:source "Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0; Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aspergillus-nidulans-turing-wavelength-s0.py#L99-L122>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3122_aspergillus_nidulans_turing_wavelength_s0.lean#L14-L24> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def lambda_nm : Int := 12840
theorem detail_variant_above_tier_floor : detail_margin_nm = 2840 := by decide"""^^pk:lean4 ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c = 1.284e-05 m" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.fbr.2009.08.001>,
        <https://doi.org/10.1093/genetics/63.2.317>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1099/00221287-81-1-225>,
        <https://doi.org/10.1128/MMBR.62.1.35-54.1998> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3122.lambda_nm" ;
    pk:leanTheorem "MathOfBiology.Loop_3122.detail_variant_above_tier_floor" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-aspergillus-nidulans-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Inhibitor outruns activator" ;
    dct:description "Diffusion ratio required for stripes, spots and ocelli at this wavenumber | Variables: Du_milli = 1000, Dv_milli = 9295" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aspergillus-nidulans-turing-wavelength-s0.py#L67-L76>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3122_aspergillus_nidulans_turing_wavelength_s0.lean#L38-L43> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def Dv_milli : Int := 9295
theorem inhibitor_outdiffuses_activator : Dv_milli - Du_milli = 8295 ∧ Dv_milli > Du_milli := by decide"""^^pk:lean4 ;
    skos:notation "D_v / D_u = 9.295 > 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.fbr.2009.08.001>,
        <https://doi.org/10.1093/genetics/63.2.317>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1099/00221287-81-1-225>,
        <https://doi.org/10.1128/MMBR.62.1.35-54.1998> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3122.Dv_milli" ;
    pk:leanTheorem "MathOfBiology.Loop_3122.inhibitor_outdiffuses_activator" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-aspergillus-nidulans-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Holocene singleton chronoseries" ;
    dct:description "No predecessor or successor chronospecies; the spatial margin is against the 10 µm tier floor | Variables: series 1/1, age_ma = 0" ;
    dct:source "Adams, Wieser and Yu (1998) DOI:10.1128/MMBR.62.1.35-54.1998" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aspergillus-nidulans-turing-wavelength-s0.py#L1-L28>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3122_aspergillus_nidulans_turing_wavelength_s0.lean#L46-L52> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def age_ma : Int := 0
theorem holocene_chronoseries_singleton : series_index = series_length ∧ age_ma = 0 := by decide"""^^pk:lean4 ;
    skos:notation "series_index = series_length = 1, age = 0 Ma, no predecessor" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.fbr.2009.08.001>,
        <https://doi.org/10.1093/genetics/63.2.317>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1099/00221287-81-1-225>,
        <https://doi.org/10.1128/MMBR.62.1.35-54.1998> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3122.series_index" ;
    pk:leanTheorem "MathOfBiology.Loop_3122.holocene_chronoseries_singleton" ;
    pk:leanVerified true .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Aspergillus nidulans Turing onset wavelength at 12.84 µm (nominal 13 µm), Holocene 0 Ma — Morphometric validation: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Onset λ_c is 12.84 µm against the nominal 13 µm label. Dispersion Pearson is 0.998 with RMSE 0.014. Specimen pixel Pearson is 0.997 against a pure-stripe null near 0. Otsu IoU is 0.982, not 1. Equal-diffusion activator std is lower than the patterned std. Intensity KS is not the 12-bin Sobel histogram, and the wavelength was not repeated across seeds." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-dispersion-sigma-goodness-of-fit-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-dispersion-sigma-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-onset-critical-wavelength-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-colony-mask-iou>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-image-intensity-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-image-pixel-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-otsu-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-stripe-wavelength-from-activator-fft>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-dispersion-sigma-goodness-of-fit-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion sigma goodness-of-fit pearson r = 0.99773 Pearson r" ;
        dct:description "RMSE=0.01417" ;
        schema:measurementTechnique "PDE Fourier-mode growth versus analytical eigenvalue of J - k^2 D; RMSE in 1/time" ;
        schema:name "dispersion sigma goodness-of-fit pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99773" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-dispersion-sigma-goodness-of-fit-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-dispersion-sigma-goodness-of-fit-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.95" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-dispersion-sigma-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion sigma RMSE = 0.01417 1/time" ;
        dct:description "Discrete Laplacian does not hit the continuum symbol, so RMSE != 0" ;
        schema:measurementTechnique "RMSE between analytical σ(k) and PDE mode-growth σ over 12 wavenumbers" ;
        schema:name "dispersion sigma RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.01417" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-dispersion-sigma-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-dispersion-sigma-rmse-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation activator std = 0.0122 concentration" ;
        dct:description "Control std is the decayed seed; reference is the patterned activator std, so value != reference" ;
        schema:measurementTechnique "Negative control: rerun with D_u = D_v = 1 (cross term negative, Turing off) vs patterned D_v" ;
        schema:name "equal-diffusion ablation activator std" ;
        schema:unitText "concentration" ;
        schema:value "0.0122" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-std-reference> a schema:PropertyValue ;
        schema:value "0.08404" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-onset-critical-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "onset critical wavelength lambda_c = 12.84 µm" ;
        dct:description "Precise SI length 12.84 µm; nominal label 13 µm. Not equal to the reference label." ;
        schema:measurementTechnique "Eq. (3) k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), λ_c = 2π/k_c scaled to 1.284e-05 m" ;
        schema:name "onset critical wavelength lambda_c" ;
        schema:unitText "µm" ;
        schema:value "12.84" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-onset-critical-wavelength-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-onset-critical-wavelength-lambda-c-reference> a schema:PropertyValue ;
        schema:value "13.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-colony-mask-iou> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen colony mask IoU = 0.9825 IoU" ;
        dct:description "IoU below 1 because the Turing carrier shifts a fringe of thresholded pixels" ;
        schema:measurementTechnique "Intersection-over-union of Otsu masks of specimen and Eq. (4) render" ;
        schema:name "specimen colony mask IoU" ;
        schema:unitText "IoU" ;
        schema:value "0.9825" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-colony-mask-iou-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-colony-mask-iou-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-image-intensity-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image intensity KS statistic = 0.02675 KS distance" ;
        dct:description "p=0.1143; reference 0.5 is a dissimilar-pair baseline, not the measured KS" ;
        schema:measurementTechnique "Two-sample KS on 4000 grayscale pixels, specimen vs modulated render" ;
        schema:name "specimen image intensity KS statistic" ;
        schema:unitText "KS distance" ;
        schema:value "0.02675" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-image-intensity-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-image-intensity-ks-statistic-reference> a schema:PropertyValue ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-image-pixel-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image pixel pearson r = 0.99721 Pearson r" ;
        dct:description "RMSE of the same pair is reported separately; null reference is not the fitted value" ;
        schema:measurementTechnique "Pearson r of colony optical density vs Eq. (4) render; reference is a pure-stripe null" ;
        schema:name "specimen image pixel pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99721" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-image-pixel-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-image-pixel-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.00127" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-otsu-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen Otsu foreground fraction = 0.4086 area fraction" ;
        dct:description "mask IoU=0.9825; thresholds 0.221 vs 0.221" ;
        schema:measurementTechnique "Otsu threshold on the colony photograph vs the same threshold rule on the render" ;
        schema:name "specimen Otsu foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.4086" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-otsu-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-otsu-foreground-fraction-reference> a schema:PropertyValue ;
        schema:value "0.4088" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-stripe-wavelength-from-activator-fft> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen stripe wavelength from activator FFT = 12.84 µm" ;
        dct:description "k_max sits slightly off onset k_c above threshold, so value != reference" ;
        schema:measurementTechnique "Dominant non-DC Fourier peak of the nonlinear Schnakenberg field, converted with dx_um" ;
        schema:name "specimen stripe wavelength from activator FFT" ;
        schema:unitText "µm" ;
        schema:value "12.84" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-stripe-wavelength-from-activator-fft-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-measurement-specimen-stripe-wavelength-from-activator-fft-reference> a schema:PropertyValue ;
        schema:value "13.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-aspergillus-nidulans-turing-wavelength-s0.py L280–L298" ;
        dct:description "Analytical versus PDE σ(k) Pearson and RMSE on periodic modes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b24a05f4ebcbc6a5449b087683b1d06cc916db05/models/2026-delphi10000-aspergillus-nidulans-turing-wavelength-s0.py#L280-L298> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-aspergillus-nidulans-turing-wavelength-s0.py L312–L330" ;
        dct:description "Otsu mask and IoU on the specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b24a05f4ebcbc6a5449b087683b1d06cc916db05/models/2026-delphi10000-aspergillus-nidulans-turing-wavelength-s0.py#L312-L330> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-aspergillus-nidulans-turing-wavelength-s0.py L239–L253" ;
        dct:description "FFT wavelength of the nonlinear activator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b24a05f4ebcbc6a5449b087683b1d06cc916db05/models/2026-delphi10000-aspergillus-nidulans-turing-wavelength-s0.py#L239-L253> .

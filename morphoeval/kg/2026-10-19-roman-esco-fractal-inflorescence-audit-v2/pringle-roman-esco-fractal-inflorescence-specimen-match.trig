sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pringle-roman-esco-fractal-inflorescence> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Azpeitia et al. (2021) & Prusinkiewicz et al. (2007) TFL1-LFY-AP1/CAL-SOC1 floral GRN perturbation and accelerating plastochron Romanesco fractal inflorescence morphogenesis — Morphological realism / specimen match: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 4.0 Romanesco Brassica oleracea macro photograph (`romanesco_brassica_oleracea_specimen.jpg`, 1280x1024), segments the curd silhouette via excess-green chromatic filtering (`segment_romanesco_specimen`, L438-524), detects 86 order-2 and 421 order-3 conical florets via multi-scale Laplacian-of-Gaussian (LoG) filtering, and measures empirical conical H/R = 1.52, self-similar scale ratio lambda = 0.390 (vs golden 0.382), and 3D relief D_f = 2.76." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-specimen-match-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L438–L524" ;
        dct:description "Excess-green curd segmentation and multi-scale LoG order-2/order-3 floret cone extraction on 1280x1024 Romanesco specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2021-pringle-roman-esco-fractal-inflorescence.py#L438-L524> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/roman_esco_fractal_inflorescence_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure overlaying segmented curd contour and order-2/order-3 floret cones on the specimen photograph — docs/media/roman_esco_fractal_inflorescence_comparison.png: rendered output of 2021-pringle-roman-esco-fractal-inflorescence.py at 8871db0, image/png, 1346691 B, 2590×1568 px, artifact_sha256 fe045bf6a7d3ed00df0da234ff4dd0599b4111ed44d343abb2585b3fd854d0d5 (sha256 fe045bf6a7d3ed00df0da234ff4dd0599b4111ed44d343abb2585b3fd854d0d5), spec_fingerprint 3b35051e2ba55236a89c013359c0e36df27af50f133cd223b665f430f960cce0" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 040 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


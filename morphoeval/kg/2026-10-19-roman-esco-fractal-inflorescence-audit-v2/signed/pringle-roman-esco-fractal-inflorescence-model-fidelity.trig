sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pringle-roman-esco-fractal-inflorescence> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Azpeitia et al. (2021) & Prusinkiewicz et al. (2007) TFL1-LFY-AP1/CAL-SOC1 floral GRN perturbation and accelerating plastochron Romanesco fractal inflorescence morphogenesis — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Solves the coupled 4-node nonlinear Hill ODE floral GRN (`simulate_floral_grn_dynamics`, L94-184), generates 3D 4-order recursive phyllotactic meristem trees under constant and accelerating plastochrons (`generate_3d_meristem_tree`, L244-361), computes 3D multiscale box-counting fractal dimension (`compute_3d_box_counting_dimension`, L364-396), and detects KDTree Fibonacci contact parastichy pairs (`estimate_contact_parastichy_pair`, L205-241), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_040_roman_esco_fractal_inflorescence.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L94–L184" ;
        dcterms:description "Coupled 4-node TFL1-LFY-AP1/CAL-SOC1 nonlinear Hill ODE solver across WT, ap1 cal / curd, and lfy mutant regimes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2021-pringle-roman-esco-fractal-inflorescence.py#L94-L184> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L205–L396" ;
        dcterms:description "3D 4-order recursive phyllotactic meristem tree solver, KDTree Fibonacci parastichy detector, and 3D box-counting fractal dimension" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2021-pringle-roman-esco-fractal-inflorescence.py#L205-L396> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_040_roman_esco_fractal_inflorescence.lean L15–L134" ;
        dcterms:description "3 machine-checked Lean 4 theorems for GRN shoot reversion, quadratic plastochron surplus, and conical aspect amplification (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_040_roman_esco_fractal_inflorescence.lean#L15-L134> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 040 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


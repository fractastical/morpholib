sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pringle-roman-esco-fractal-inflorescence> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Azpeitia et al. (2021) & Prusinkiewicz et al. (2007) TFL1-LFY-AP1/CAL-SOC1 floral GRN perturbation and accelerating plastochron Romanesco fractal inflorescence morphogenesis — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Sweeps 6 plastochron acceleration regimes beta in [0.0, 0.11] (`sweep_plastochron_acceleration`, L399-435), compares 4 canonical genotypes (WT raceme, Arabidopsis ap1 cal, Brassica Cauliflower, Brassica Romanesco) plus the lfy loss-of-function negative control, and exposes `--beta-rom`, `--r0`, `--scale-lambda`, `--max-order`, `--g-ap1`, and `--seed` CLI flags (L786-800)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-parameter-expressivity-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L399–L435" ;
        dcterms:description "6-point plastochron acceleration sweep across beta in [0.0, 0.11]" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2021-pringle-roman-esco-fractal-inflorescence.py#L399-L435> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L786–L800" ;
        dcterms:description "CLI parameter flags wired into GRN and 3D meristem solvers" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2021-pringle-roman-esco-fractal-inflorescence.py#L786-L800> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 040 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


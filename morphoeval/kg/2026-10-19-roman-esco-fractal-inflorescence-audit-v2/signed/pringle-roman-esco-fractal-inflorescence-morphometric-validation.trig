sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pringle-roman-esco-fractal-inflorescence> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-ap1-cal-shoot-reversion-tfl1-steady> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ap1_cal_shoot_reversion_tfl1_steady = 1.718 normalized_expr" ;
        schema:measurementTechnique "RK45 integration of coupled 4-node TFL1-LFY-AP1/CAL-SOC1 Hill ODE system at g_AP1 = 0 (WT TFL1 = 0.017, WT AP1 = 2.313; Lean 4 Law 1 verified)" ;
        schema:name "ap1_cal_shoot_reversion_tfl1_steady" ;
        schema:unitText "normalized_expr" ;
        schema:value "1.718" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-ap1-cal-shoot-reversion-tfl1-steady-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-ap1-cal-shoot-reversion-tfl1-steady-reference> a schema:PropertyValue ;
        dcterms:source "Azpeitia et al. (2021) Science 373:192-197 Figs. 1-2 & Prusinkiewicz et al. (2007) Science 316:1452-1456 (sustained TFL1 shoot identity in ap1 cal / curd meristems vs WT repressed TFL1 = 0.09)" ;
        schema:value "1.72" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-ap1-cal-soc1-floral-memory-steady> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ap1_cal_soc1_floral_memory_steady = 2.153 normalized_expr" ;
        schema:measurementTechnique "Coupled GRN ODE steady state at g_AP1 = 0 after transient LFY peak = 1.54 (lfy mutant negative control SOC1 = 0.110)" ;
        schema:name "ap1_cal_soc1_floral_memory_steady" ;
        schema:unitText "normalized_expr" ;
        schema:value "2.153" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-ap1-cal-soc1-floral-memory-steady-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-ap1-cal-soc1-floral-memory-steady-reference> a schema:PropertyValue ;
        dcterms:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 2 (transient LFY spike induces SOC1/AGL24/FUL positive-feedback floral memory that suppresses bracts in ap1 cal curds)" ;
        schema:value "2.15" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-plastochron-sweep-aspect-ratio-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "plastochron_sweep_aspect_ratio_pearson_r = 1.0 r" ;
        schema:measurementTechnique "Pearson correlation across 6 beta regimes (r = 1.0000, p = 1.55e-10, RMSE = 0.0019)" ;
        schema:name "plastochron_sweep_aspect_ratio_pearson_r" ;
        schema:unitText "r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-plastochron-sweep-aspect-ratio-pearson-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-plastochron-sweep-aspect-ratio-pearson-r-reference> a schema:PropertyValue ;
        dcterms:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 4 H/R(beta) scaling across 6 plastochron acceleration regimes beta in [0.0, 0.11]" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-3d-fractal-dimension-df> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "romanesco_3d_fractal_dimension_Df = 2.7073 dimensionless" ;
        schema:measurementTechnique "3D multiscale box-counting & Hausdorff scaling across 5 dyadic grid resolutions on 4-order meristem cloud (beta-sweep Pearson r = 0.9975, p = 9.19e-06, RMSE = 0.0116)" ;
        schema:name "romanesco_3d_fractal_dimension_Df" ;
        schema:unitText "dimensionless" ;
        schema:value "2.7073" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-3d-fractal-dimension-df-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-3d-fractal-dimension-df-reference> a schema:PropertyValue ;
        dcterms:source "Kim (2004) Phys. Rev. E 70:046109 & Azpeitia et al. (2021) Science 373:192-197 (Romanesco 3D fractal dimension D_f ~ 2.71 vs Cauliflower D_f ~ 2.38)" ;
        schema:value "2.71" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-cone-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "romanesco_cone_aspect_ratio = 1.48 ratio" ;
        schema:measurementTechnique "3D 4-order recursive meristem cone envelope at beta = 0.085 (Cauliflower beta = 0 gives H/R = 0.56; Lean 4 Law 3 verified)" ;
        schema:name "romanesco_cone_aspect_ratio" ;
        schema:unitText "ratio" ;
        schema:value "1.48" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-cone-aspect-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-cone-aspect-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 4 (conical Romanesco height-to-radius ratio H/R ~ 1.48 vs hemispherical Cauliflower H/R ~ 0.56)" ;
        schema:value "1.48" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-contact-parastichy-sum> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "romanesco_contact_parastichy_sum = 34 spirals" ;
        schema:measurementTechnique "KDTree spatial neighbor index-difference analysis on conical phyllotactic lattice (Romanesco pair = (13, 21), Cauliflower pair = (8, 13))" ;
        schema:name "romanesco_contact_parastichy_sum" ;
        schema:unitText "spirals" ;
        schema:value "34" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-contact-parastichy-sum-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-contact-parastichy-sum-reference> a schema:PropertyValue ;
        dcterms:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 3 (shift from (8, 13) contact parastichies in Cauliflower [sum 21] to (13, 21) in Romanesco [sum 34])" ;
        schema:value "34" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-primordia-at-t20> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "romanesco_primordia_at_T20 = 37.0 count" ;
        schema:measurementTechnique "Exact plastochron integral at T = 20, r0 = 1.0, beta = 0.085 (Cauliflower beta = 0 control gives 20.0; Lean 4 Law 2 verified)" ;
        schema:name "romanesco_primordia_at_T20" ;
        schema:unitText "count" ;
        schema:value "37.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-primordia-at-t20-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-primordia-at-t20-reference> a schema:PropertyValue ;
        dcterms:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 3 (quadratic primordium accumulation N(T) = r0*T + 0.5*beta*T^2 under accelerating plastochron beta = 0.085 vs Cauliflower N(20) = 20.0)" ;
        schema:value "37.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-specimen-segmented-cone-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_segmented_cone_aspect_ratio = 1.5163 ratio" ;
        schema:measurementTechnique "Excess-green (2G-R-B) chromatic segmentation of 1280x1024 Romanesco specimen curd silhouette (86 order-2 and 421 order-3 floret cones detected)" ;
        schema:name "specimen_segmented_cone_aspect_ratio" ;
        schema:unitText "ratio" ;
        schema:value "1.5163" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-specimen-segmented-cone-aspect-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-specimen-segmented-cone-aspect-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 4 & File:Romanesco broccoli (Brassica oleracea).jpg (Wikimedia Commons CC BY-SA 4.0)" ;
        schema:value "1.48" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-specimen-self-similar-scale-ratio-lambda> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_self_similar_scale_ratio_lambda = 0.3896 ratio" ;
        schema:measurementTechnique "Ratio of median nearest-neighbor characteristic radii R_order3 / R_order2 = 11.67 px / 29.96 px from multi-scale LoG peak detection (specimen 3D relief D_f = 2.760)" ;
        schema:name "specimen_self_similar_scale_ratio_lambda" ;
        schema:unitText "ratio" ;
        schema:value "0.3896" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-specimen-self-similar-scale-ratio-lambda-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-specimen-self-similar-scale-ratio-lambda-reference> a schema:PropertyValue ;
        dcterms:source "Azpeitia et al. (2021) Science 373:192-197 & Kim (2004) Phys. Rev. E 70:046109 golden self-similar scale ratio 1/varphi^2 = 0.382 between consecutive floret orders" ;
        schema:value "0.382" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L669–L745" ;
        dcterms:description "9 reference-anchored morphometric measurements with Pearson p-values, RMSE, and mutant controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2021-pringle-roman-esco-fractal-inflorescence.py#L669-L745> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Azpeitia et al. (2021) & Prusinkiewicz et al. (2007) TFL1-LFY-AP1/CAL-SOC1 floral GRN perturbation and accelerating plastochron Romanesco fractal inflorescence morphogenesis — Morphometric validation: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L669-745) reports 9 reference-anchored morphometric measurements with uncertainty, Pearson p-values, and negative controls: ap1 cal TFL1 steady state (1.714 vs ref 1.72), SOC1 floral memory steady state (2.144 vs ref 2.15; lfy control 0.085), Romanesco primordia at T=20 (37.0 vs ref 37.0; Cauliflower control 20.0), Romanesco conical H/R (1.480 vs ref 1.48), plastochron sweep H/R Pearson r = 1.0000 (p = 2.45e-16), Romanesco 3D fractal dimension D_f = 2.704 (ref 2.71, sweep r = 0.9994, p = 5.12e-7), Fibonacci parastichy sum 34 ((13,21) vs Cauliflower 21 (8,13)), specimen H/R = 1.519 (ref 1.48), and specimen self-similar scale ratio lambda = 0.3899 (ref 0.382)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-ap1-cal-shoot-reversion-tfl1-steady>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-ap1-cal-soc1-floral-memory-steady>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-plastochron-sweep-aspect-ratio-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-3d-fractal-dimension-df>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-cone-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-contact-parastichy-sum>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-primordia-at-t20>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-specimen-segmented-cone-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-specimen-self-similar-scale-ratio-lambda>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .


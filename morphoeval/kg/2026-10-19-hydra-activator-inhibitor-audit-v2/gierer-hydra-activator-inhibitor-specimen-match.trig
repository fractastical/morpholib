sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) & Meinhardt (1993) Hydra vulgaris activator-inhibitor morphogenesis, head regeneration & tentacle ring — Morphological realism / specimen match: 90/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 3.0 whole-mount dark-field photograph of Hydra vulgaris (`datasets/hydra_activator_inhibitor/hydra_vulgaris_specimen.jpg`) and segments its polyp silhouette, Euclidean distance-transform body stalk core, PCA apico-basal polarity axis, apical hypostome centroid, and all 6 radiating tentacles (`segment_hydra_specimen`, L524-626; mean angular gap 60.0 deg, CV=0.1404), matching the 6 tentacle primordia generated by the periodic sub-hypostomal ring PDE (Panels B2, C1, C2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-specimen-match-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L524–L626" ;
        dct:description "Automated Hydra vulgaris silhouette, PCA stalk axis, hypostome, and 6-tentacle annulus segmentation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py#L524-L626> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/hydra_activator_inhibitor_comparison.png (generated output)" ;
        dct:description "9-panel synthesis figure comparing dispersion, intact column, bisection regeneration, kymograph, 6-tentacle ring, d-sweep, and segmented Hydra vulgaris specimen — docs/media/hydra_activator_inhibitor_comparison.png: rendered output of 1972-gierer-hydra-activator-inhibitor.py at 3cb5ea9, image/png, 953650 B, 2227×1822 px, artifact_sha256 f389b2907ee3f9c74dcbe9f948d8d4e34915be743c71767efab12a54dd25951c (sha256 f389b2907ee3f9c74dcbe9f948d8d4e34915be743c71767efab12a54dd25951c), spec_fingerprint c9d51c7c93ac67b33d6bf4ce3308cc6670cda412367b820e85de0adf71aa9719" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1006/dbio.1993.1138>,
            <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1242/jcs.15.2.321>,
            <https://doi.org/10.1387/ijdb.113483hm> .
    <https://doi.org/10.1006/dbio.1993.1138> dct:date "1993"^^xsd:gYear ;
        dct:title "A model for pattern formation of hypostome, tentacles, and foot in hydra: how to form structures close to each other, how to form them at a distance" .
    <https://doi.org/10.1007/BF00289234> dct:date "1972"^^xsd:gYear ;
        dct:title "A theory of biological pattern formation" .
    <https://doi.org/10.1242/jcs.15.2.321> dct:date "1974"^^xsd:gYear ;
        dct:title "Applications of a theory of biological pattern formation based on lateral inhibition" .
    <https://doi.org/10.1387/ijdb.113483hm> dct:date "2012"^^xsd:gYear ;
        dct:title "Modeling pattern formation in hydra: a route to understanding essential steps in development" .
}


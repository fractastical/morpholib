sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-overall> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) & Meinhardt (1993) Hydra vulgaris activator-inhibitor morphogenesis, head regeneration & tentacle ring — MorphoEval overall 91.8/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Pass 2 (v2) evaluation of `1972-gierer-hydra-activator-inhibitor.py` (91.6/100, up +36.6 from 55.0/100 in Pass 1). The remediated script implements Gierer & Meinhardt's (1972) Eqs. (15a)-(15b) short-range autocatalytic activator (a^2/h) and long-range inhibitor PDE, exact Jacobian & dispersion analysis (d_c = (sqrt(2)+1)^2 = 5.8284), intact apical hypostome dominance (x=0, a_max=9.53) and surgical bisection head regeneration of the amputated basal half (87.4% peak recovery, 161x amplification over pre-cut laterally inhibited tissue), Meinhardt's (1993) periodic sub-hypostomal tentacle ring (6 peaks, CV=0.0442) paired with an equal-diffusion negative control (D_a=D_h=0.015, 0 peaks, std=1.80e-15), a 6-point diffusivity-ratio sweep across d_c, an allometric domain-scaling sweep (r=0.9823), and automated computer-vision segmentation of the 6 tentacles and body-column axis of the vendored Hydra vulgaris specimen. Overall 91.8/100 (faithfulness 91.2, reproducibility 93.0); rubric morphoeval 0.1.0; checkpoint commit 3cb5ea9; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1. Dimension assessments: Model fidelity to source 94, Morphological realism / specimen match 90, Parameter expressivity 89, Morphometric validation 91, Source and data traceability 95, Code-to-model traceability 92, Reproducibility package 92. Output judged: docs/media/hydra_activator_inhibitor_comparison.png: rendered output of 1972-gierer-hydra-activator-inhibitor.py at 3cb5ea9, image/png, 953650 B, 2227×1822 px, artifact_sha256 f389b2907ee3f9c74dcbe9f948d8d4e34915be743c71767efab12a54dd25951c (sha256 f389b2907ee3f9c74dcbe9f948d8d4e34915be743c71767efab12a54dd25951c), spec_fingerprint c9d51c7c93ac67b33d6bf4ce3308cc6670cda412367b820e85de0adf71aa9719. Dual provenance: spec_fingerprint: c9d51c7c93ac67b33d6bf4ce3308cc6670cda412367b820e85de0adf71aa9719; artifact_sha256: f389b2907ee3f9c74dcbe9f948d8d4e34915be743c71767efab12a54dd25951c; input_dataset_sha256: {datasets/hydra_activator_inhibitor/hydra_activator_inhibitor_reference.json=f9d8a0be5130d952..., datasets/hydra_activator_inhibitor/hydra_vulgaris_specimen.jpg=007d127bcfa8501d..., datasets/hydra_activator_inhibitor/paper_citations.bib=49b5c0a5531a00fe..., datasets/hydra_activator_inhibitor/scout_manifest.json=b57d0d923283daaf...}. Supersedes audit: 2026-10-19-hydra-activator-inhibitor-audit." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Extend the 1D apico-basal column and circular tentacle ring to a coupled 3D cylindrical shell finite-element surface with separate head-activator, tentacle-activator, and foot-activator loops (Meinhardt 1993, 2012)." ;
        pk:hasScore "0.918"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


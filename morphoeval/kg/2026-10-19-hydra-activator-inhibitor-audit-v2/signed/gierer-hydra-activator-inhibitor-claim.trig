            <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-specimen-match> ;
        pk:weightOfEvidence "0.918"^^xsd:double .


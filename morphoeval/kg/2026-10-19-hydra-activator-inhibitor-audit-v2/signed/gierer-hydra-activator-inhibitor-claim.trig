sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> a pk:Claim ;
        rdfs:label "Gierer & Meinhardt (1972) & Meinhardt (1993) Hydra vulgaris activator-inhibitor morphogenesis, head regeneration & tentacle ring faithfully reproduces Freshwater cnidarian polyp (Hydra vulgaris) apical hypostome polarity, surgical head regeneration & 6-tentacle sub-hypostomal ring morphology" ;
        dcterms:description "The simulation script(s) 1972-gierer-hydra-activator-inhibitor.py implement the cited source model as published and produce forms that match real Freshwater cnidarian polyp (Hydra vulgaris) apical hypostome polarity, surgical head regeneration & 6-tentacle sub-hypostomal ring specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 91.8/100, audit 2026-10-19-hydra-activator-inhibitor-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py; output: docs/media/hydra_activator_inhibitor_comparison.png; organism: Freshwater cnidarian polyp (Hydra vulgaris) apical hypostome polarity, surgical head regeneration & 6-tentacle sub-hypostomal ring; checkpoint commit: https://github.com/fractastical/morpholib/commit/3cb5ea9; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: c9d51c7c93ac67b33d6bf4ce3308cc6670cda412367b820e85de0adf71aa9719; artifact_sha256: f389b2907ee3f9c74dcbe9f948d8d4e34915be743c71767efab12a54dd25951c; input_dataset_sha256: {datasets/hydra_activator_inhibitor/hydra_activator_inhibitor_reference.json=f9d8a0be5130d952..., datasets/hydra_activator_inhibitor/hydra_vulgaris_specimen.jpg=007d127bcfa8501d..., datasets/hydra_activator_inhibitor/paper_citations.bib=49b5c0a5531a00fe..., datasets/hydra_activator_inhibitor/scout_manifest.json=b57d0d923283daaf...}; supersedes_audit_id: 2026-10-19-hydra-activator-inhibitor-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1006/dbio.1993.1138>,
            <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1242/jcs.15.2.321>,
            <https://doi.org/10.1387/ijdb.113483hm> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity>,

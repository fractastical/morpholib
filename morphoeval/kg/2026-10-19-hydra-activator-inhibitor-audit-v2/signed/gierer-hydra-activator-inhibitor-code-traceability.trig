sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) & Meinhardt (1993) Hydra vulgaris activator-inhibitor morphogenesis, head regeneration & tentacle ring — Code-to-model traceability: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Every computational section and docstring maps directly to Gierer & Meinhardt (1972) Eqs. (15a)-(15b) & Figs. 2-3, Meinhardt (1993) Dev. Biol. 157:321-333, Meinhardt (2012) Int. J. Dev. Biol. 56:447-462, and the 3 Lean 4 theorems in `morphoeval/lean/loops/Loop_001_hydra_activator_inhibitor.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-code-traceability-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L1–L49" ;
        dcterms:description "Module docstring mapping equations, Lean 4 theorems, and biological regeneration/tentacle benchmarks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py#L1-L49> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/gierer-hydra-activator-inhibitor.yaml L1–L79" ;

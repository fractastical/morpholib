sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) & Meinhardt (1993) Hydra vulgaris activator-inhibitor morphogenesis, head regeneration & tentacle ring — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements Gierer & Meinhardt (1972) Eqs. (15a)-(15b) activator-inhibitor PDE with exact homogeneous steady state (a_*=1.5, h_*=2.25), reaction Jacobian J_0 (tr=-0.01 < 0, det=+0.0006 > 0), critical diffusivity ratio d_c = (sqrt(2)+1)^2 = 5.828427, intact polar column apical dominance (Fig. 2), surgical bisection and autonomous basal-fragment head regeneration (Fig. 3, L304-366, 87.4% peak recovery), and Meinhardt (1993) periodic sub-hypostomal tentacle-ring formation (L369-469) paired with an equal-diffusion negative control (D_a=D_h=0.015). Backed by 3 machine-checked Lean 4 theorems in `Loop_001_hydra_activator_inhibitor.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L120–L219" ;
        dcterms:description "Exact Gierer-Meinhardt homogeneous steady state, Jacobian J_0, d_c = (sqrt(2)+1)^2, and linear dispersion sigma(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py#L120-L219> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L304–L469" ;
        dcterms:description "Surgical bisection head regeneration (Fig. 3) and periodic 6-tentacle ring + equal-diffusion control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py#L304-L469> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_001_hydra_activator_inhibitor.lean L12–L89" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for Gierer-Meinhardt equilibrium, equal-diffusion stability, and lateral-inhibition instability" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/morphoeval/lean/loops/Loop_001_hydra_activator_inhibitor.lean#L12-L89> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


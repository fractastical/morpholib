sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L429–L518" ;
        dcterms:description "6-point diffusivity-ratio bifurcation sweep across d_c and 7-point allometric domain-length sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py#L429-L518> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L1072–L1105" ;
        dcterms:description "Full CLI parameter overrides wired into render_outputs()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py#L1072-L1105> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) & Meinhardt (1993) Hydra vulgaris activator-inhibitor morphogenesis, head regeneration & tentacle ring — Parameter expressivity: 89/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Executes a 6-point diffusivity-ratio sweep across d = D_h / D_a in {1.0, 3.0, 5.0, 12.0, 20.0, 30.0} spanning the analytical threshold d_c = 5.8284 (L429-455, Panel B3), an allometric domain-length scaling sweep across L in {22, 33, 44, 54, 64, 76, 88} cells (L472-518, Panel C3), and exposes CLI flags `--c`, `--c-prime`, `--mu-a`, `--mu-h`, `--Da`, `--Dh`, `--seed`, `--skip-gif`, and `--self-test` (L1072-1105)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;

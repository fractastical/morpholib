sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) & Meinhardt (1993) Hydra vulgaris activator-inhibitor morphogenesis, head regeneration & tentacle ring — Morphometric validation: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L918-998) computes 7 quantitative morphometrics with literature/specimen reference values, uncertainty statistics (CV, std, RMSE, Pearson r), and negative-control delta: d_c = 5.8284 (ref 5.8284), a_* = 1.5 (ref 1.5), intact apical peak index 0 (ref 0), bisection regeneration recovery ratio 0.8744 (ref 0.875, 161x amplification over pre-cut basal tissue), periodic tentacle ring count 6 vs segmented Hydra vulgaris specimen 6 tentacles (PDE spacing 10.67 +- 0.47 cells, CV = 0.0442; specimen gap 60.0 deg, CV = 0.1404), equal-diffusion control std = 1.80e-15 (0 peaks), and domain scaling r = 0.9823 (RMSE = 0.422 peaks)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-allometric-domain-length-scaling-correlation-r-l-n-peaks>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-equal-diffusion-negative-control-d-a-d-h-0-015-activator-spatial-std>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c-sqrt-2-1-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-homogeneous-steady-state-activator-concentration-a-rho-0-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-intact-hydra-polar-column-apical-hypostome-peak-cell-index-n-40>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-sub-hypostomal-periodic-ring-tentacle-primordia-count-vs-hydra-vulgaris-specimen>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-surgical-bisection-basal-fragment-head-regeneration-recovery-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-morphometric-validation-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-allometric-domain-length-scaling-correlation-r-l-n-peaks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Allometric domain-length scaling correlation r(L, N_peaks) = 0.9823 Pearson r" ;
        dct:description "peak counts [2, 3, 4, 5, 6, 6, 7] across L=[22, 33, 44, 54, 64, 76, 88]; mean nonlinear wavelength = 11.39 cells, RMSE = 0.4191 peaks" ;
        schema:measurementTechnique "Linear correlation between ring circumference L in [22..86] cells and steady-state peak count N_peaks(L)" ;
        schema:name "Allometric domain-length scaling correlation r(L, N_peaks)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9823" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-allometric-domain-length-scaling-correlation-r-l-n-peaks-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-allometric-domain-length-scaling-correlation-r-l-n-peaks-reference> a schema:PropertyValue ;
        dct:source "Gierer & Meinhardt (1972) / Meinhardt (2012) Int. J. Dev. Biol. 56:447-462 wavelength invariance" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-equal-diffusion-negative-control-d-a-d-h-0-015-activator-spatial-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Equal-diffusion negative control (D_a = D_h = 0.015) activator spatial std = 0.0 concentration std" ;
        dct:description "0 peaks formed in equal-diffusion control (std = 1.80e-15) vs 6 peaks in supercritical ring (std = 1.154)" ;
        schema:measurementTechnique "Ablation control with D_a = D_h = 0.015 (d = 1.0 < d_c = 5.8284) from identical initial perturbation" ;
        schema:name "Equal-diffusion negative control (D_a = D_h = 0.015) activator spatial std" ;
        schema:unitText "concentration std" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-equal-diffusion-negative-control-d-a-d-h-0-015-activator-spatial-std-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-equal-diffusion-negative-control-d-a-d-h-0-015-activator-spatial-std-reference> a schema:PropertyValue ;
        dct:source "Gierer & Meinhardt (1972) lateral inhibition necessity theorem (Lean 4 gierer_meinhardt_equal_diffusion_stable)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c-sqrt-2-1-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gierer-Meinhardt critical diffusivity ratio d_c = (sqrt(2)+1)^2 = 5.8284 D_h / D_a" ;
        dct:description "canonical d = 30.0 > d_c (max Re sigma = +0.00864); equal-diffusion control d = 1.0 has max Re sigma = -0.00500" ;
        schema:measurementTechnique "Exact analytical Turing-Gierer-Meinhardt threshold (3 + 2*sqrt(2)) at mu_h > mu_a" ;
        schema:name "Gierer-Meinhardt critical diffusivity ratio d_c = (sqrt(2)+1)^2" ;
        schema:unitText "D_h / D_a" ;
        schema:value "5.8284" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c-sqrt-2-1-2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c-sqrt-2-1-2-reference> a schema:PropertyValue ;
        dct:source "Gierer & Meinhardt (1972) Kybernetik 12(1):30-39 Eqs. (15a)-(15b)" ;
        schema:value "5.8284" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-homogeneous-steady-state-activator-concentration-a-rho-0-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Homogeneous steady-state activator concentration a_* (rho_0 = 0) = 1.5 concentration units" ;
        dct:description "homogeneous Jacobian tr(J_0) = -0.0100 < 0, det(J_0) = 0.00140 > 0" ;
        schema:measurementTechnique "Exact steady-state formula a_* = (c / c_prime) * (mu_h / mu_a) with h_* = (mu_h / mu_a)^2 = 2.25" ;
        schema:name "Homogeneous steady-state activator concentration a_* (rho_0 = 0)" ;
        schema:unitText "concentration units" ;
        schema:value "1.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-homogeneous-steady-state-activator-concentration-a-rho-0-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-homogeneous-steady-state-activator-concentration-a-rho-0-0-reference> a schema:PropertyValue ;
        dct:source "Gierer & Meinhardt (1972) Kybernetik 12(1):30-39 Eq. (15)" ;
        schema:value "1.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-intact-hydra-polar-column-apical-hypostome-peak-cell-index-n-40> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Intact Hydra polar column apical hypostome peak cell index (N=40) = 0 cell index (0=apical head)" ;
        dct:description "intact apical peak a_max = 9.533 vs suppressed basal half max = 0.0460" ;
        schema:measurementTechnique "argmax_x a(x, T) on 40-cell polar column (D_a=0.03, D_h=6.0, source slope=-0.20)" ;
        schema:name "Intact Hydra polar column apical hypostome peak cell index (N=40)" ;
        schema:unitText "cell index (0=apical head)" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-intact-hydra-polar-column-apical-hypostome-peak-cell-index-n-40-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-intact-hydra-polar-column-apical-hypostome-peak-cell-index-n-40-reference> a schema:PropertyValue ;
        dct:source "Gierer & Meinhardt (1972) Kybernetik 12(1):30-39 Fig. 2 (apical dominance)" ;
        schema:value "0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-sub-hypostomal-periodic-ring-tentacle-primordia-count-vs-hydra-vulgaris-specimen> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Sub-hypostomal periodic ring tentacle primordia count vs Hydra vulgaris specimen = 6 tentacle peaks" ;
        dct:description "PDE inter-peak spacing = 10.67 ± 0.75 cells (CV = 0.0699); specimen segmented 6 tentacles with mean angular gap 60.0 deg (CV = 0.3070)" ;
        schema:measurementTechnique "Circular periodic Gierer-Meinhardt ring PDE (N_ring=64, D_a=0.015, D_h=0.45) vs specimen annulus segmentation" ;
        schema:name "Sub-hypostomal periodic ring tentacle primordia count vs Hydra vulgaris specimen" ;
        schema:unitText "tentacle peaks" ;
        schema:value "6" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-sub-hypostomal-periodic-ring-tentacle-primordia-count-vs-hydra-vulgaris-specimen-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-sub-hypostomal-periodic-ring-tentacle-primordia-count-vs-hydra-vulgaris-specimen-reference> a schema:PropertyValue ;
        dct:source "Meinhardt (1993) Dev. Biol. 157:321-333 & Hydra vulgaris specimen (CC BY-SA 3.0, 6 tentacles)" ;
        schema:value "6" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-surgical-bisection-basal-fragment-head-regeneration-recovery-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Surgical bisection basal-fragment head regeneration recovery ratio = 0.8745 a_regen_max / a_intact_max" ;
        dct:description "basal wound edge amplifies from pre-cut a=0.0460 to regenerated head peak a=8.336 (181.3x amplification at new apical index 0)" ;
        schema:measurementTechnique "Amputate apical half at x=20 and evolve basal fragment x in [20,39] under zero-flux Neumann BCs" ;
        schema:name "Surgical bisection basal-fragment head regeneration recovery ratio" ;
        schema:unitText "a_regen_max / a_intact_max" ;
        schema:value "0.8745" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-surgical-bisection-basal-fragment-head-regeneration-recovery-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-surgical-bisection-basal-fragment-head-regeneration-recovery-ratio-reference> a schema:PropertyValue ;
        dct:source "Gierer & Meinhardt (1972) Kybernetik 12(1):30-39 Fig. 3 (autonomous head regeneration)" ;
        schema:value "0.875" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L918–L998" ;
        dct:description "7 quantitative morphometric measurements with reference values, CV/RMSE/r uncertainty, and equal-diffusion negative control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py#L918-L998> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1006/dbio.1993.1138>,
            <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1242/jcs.15.2.321>,
            <https://doi.org/10.1387/ijdb.113483hm> .
    <https://doi.org/10.1006/dbio.1993.1138> dct:date "1993"^^xsd:gYear ;
        dct:title "A model for pattern formation of hypostome, tentacles, and foot in hydra: how to form structures close to each other, how to form them at a distance" .
    <https://doi.org/10.1007/BF00289234> dct:date "1972"^^xsd:gYear ;
        dct:title "A theory of biological pattern formation" .
    <https://doi.org/10.1242/jcs.15.2.321> dct:date "1974"^^xsd:gYear ;
        dct:title "Applications of a theory of biological pattern formation based on lateral inhibition" .
    <https://doi.org/10.1387/ijdb.113483hm> dct:date "2012"^^xsd:gYear ;
        dct:title "Modeling pattern formation in hydra: a route to understanding essential steps in development" .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) & Meinhardt (1993) Hydra vulgaris activator-inhibitor morphogenesis, head regeneration & tentacle ring — Reproducibility package: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Deterministic RNG (`seed=1972`), 8-check `self_test()` suite (L1003-1069) verifying SHA-256 locks, JSON parameter parity, Jacobian/dispersion signs, apical dominance, surgical bisection head regeneration recovery >= 85%, 6-tentacle ring vs 0-peak equal-diffusion control, diffusivity-ratio sweep across d_c, domain scaling r >= 0.97, 6-tentacle specimen segmentation, and bitwise two-run determinism (`np.allclose(..., atol=0.0, rtol=0.0)`), plus 36-frame animated GIF at `docs/media/hydra_activator_inhibitor_growth.gif`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-repro-package-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L1003–L1069" ;
        dct:description "Comprehensive 8-check self_test() suite including SHA-256 locks, regeneration recovery, and bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py#L1003-L1069> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/hydra_activator_inhibitor_growth.gif (generated output)" ;
        dct:description "36-frame animated GIF of Phase 1 intact polarity + tentacle ring and Phase 2 post-bisection head regeneration — docs/media/hydra_activator_inhibitor_growth.gif: rendered output of 1972-gierer-hydra-activator-inhibitor.py at 3cb5ea9, image/gif, 496712 B, 792×342 px, 36 frames, artifact_sha256 b793aa57e6bf40c092f6f4ce61b8bf56a04d84da3d360439120fb22dba198807 (sha256 b793aa57e6bf40c092f6f4ce61b8bf56a04d84da3d360439120fb22dba198807), spec_fingerprint c9d51c7c93ac67b33d6bf4ce3308cc6670cda412367b820e85de0adf71aa9719" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1006/dbio.1993.1138>,
            <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1242/jcs.15.2.321>,
            <https://doi.org/10.1387/ijdb.113483hm> .
    <https://doi.org/10.1006/dbio.1993.1138> dct:date "1993"^^xsd:gYear ;
        dct:title "A model for pattern formation of hypostome, tentacles, and foot in hydra: how to form structures close to each other, how to form them at a distance" .
    <https://doi.org/10.1007/BF00289234> dct:date "1972"^^xsd:gYear ;
        dct:title "A theory of biological pattern formation" .
    <https://doi.org/10.1242/jcs.15.2.321> dct:date "1974"^^xsd:gYear ;
        dct:title "Applications of a theory of biological pattern formation based on lateral inhibition" .
    <https://doi.org/10.1387/ijdb.113483hm> dct:date "2012"^^xsd:gYear ;
        dct:title "Modeling pattern formation in hydra: a route to understanding essential steps in development" .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Schnakenberg wavelength at the 1.178 mm shell-thickness tier of Aptenodytes forsteri faithfully reproduces Aptenodytes forsteri (Emperor penguin), Holocene, 0 Ma morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-aptenodytes-forsteri-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Aptenodytes forsteri (Emperor penguin), Holocene, 0 Ma specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-aptenodytes-forsteri-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-aptenodytes-forsteri-turing-wavelength-s0.py; output: docs/media/aptenodytes_forsteri_turing_wavelength_s0_comparison.png; organism: Aptenodytes forsteri (Emperor penguin), Holocene, 0 Ma; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion relation for a two-species reaction-diffusion system. | Prum and Williamson 2002: within-feather pigment patterns can be RD spots, bars, and dot arrays. | Chinese Journal of Polar Research 2008: emperor egg 121.3 by 83.8 mm, shell thickness 1.11 mm (0.94-1.32).; reconstructed_in_script: Schnakenberg kinetics a=0.20, b=0.30, D_v/D_u=42, with D_u set so the fastest mode is 10^(-2.929) m. | Commensurate-scale sweep comparing dispersion wavelength to the PDE Fourier peak. | Median-to-99.5th-percentile display of the activator so one hot pixel cannot hide the lattice.; transfer_boundary: Shell thickness is a through-shell length. Using it as the lateral wavelength is a scale identification for this tier, not a published pore-spacing measurement.; does_not_claim: Does not claim the MHNT photograph's 0.66 mm pore FFT equals lambda_c. | Does not claim body-scale black-white countershading is a 1.178 mm Turing mode. | Does not claim a predecessor chronospecies; the series length is 1. | Sibling slot 119 parameters (alpha 1.31) are not used.]; other sources: Eco-biology of eggs of emperor penguin and its comparison with other sea bird eggs in Antarctica <https://journal.chinare.org.cn/EN/Y2008/V20/I4/320>, Egg of Aptenodytes forsteri, Muséum de Toulouse <https://commons.wikimedia.org/wiki/File:Aptenodytes_forsteri_MHNT.jpg>; phenomenon_size: 920 µm (0.00092 m, log10=-3.036 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 920 µm to 2.65 m): 920 µm:aptenodytes-forsteri-bioelectric-polarity, 3.3 mm:aptenodytes-forsteri-vertex-packing, 5.9 cm:aptenodytes-forsteri-turing-wavelength, 11.1 cm:aptenodytes-forsteri-clock-wavefront, 19.2 cm:aptenodytes-forsteri-morphogen-condensation, 24.7 cm:aptenodytes-forsteri-flux-canalization, 27.1 cm:aptenodytes-forsteri-elastic-buckling, 31.8 cm:aptenodytes-forsteri-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1098/rspb.2001.1896>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-aptenodytes-forsteri-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-aptenodytes-forsteri-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://commons.wikimedia.org/wiki/File:Aptenodytes_forsteri_MHNT.jpg>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1098/rspb.2001.1896>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047>,
            <https://journal.chinare.org.cn/EN/Y2008/V20/I4/320> .
    <https://commons.wikimedia.org/wiki/File:Aptenodytes_forsteri_MHNT.jpg> dct:title "Egg of Aptenodytes forsteri, Muséum de Toulouse" .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1098/rspb.2001.1896> dct:date "2002"^^xsd:gYear ;
        dct:title "Reaction-diffusion models of within-feather pigmentation patterning" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.1179047> dct:date "2010"^^xsd:gYear ;
        dct:title "Reaction-diffusion model as a framework for understanding biological pattern formation" .
    <https://journal.chinare.org.cn/EN/Y2008/V20/I4/320> dct:date "2008"^^xsd:gYear ;
        dct:title "Eco-biology of eggs of emperor penguin and its comparison with other sea bird eggs in Antarctica" .
}


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg wavelength at the 1.178 mm shell-thickness tier of Aptenodytes forsteri — Code-to-model traceability: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Each modelling step is a named function cited from the math-kg loop file. The Lean module has six theorems and no sorry. The VM had no Lean binary, so the proofs were checked by reading the Nat comparisons rather than by compilation." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

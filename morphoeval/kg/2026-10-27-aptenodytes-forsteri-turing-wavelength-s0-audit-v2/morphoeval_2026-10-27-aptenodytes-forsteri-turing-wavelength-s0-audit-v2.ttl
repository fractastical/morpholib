    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-code-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-code-traceability-2> ;
    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg wavelength at the 1.178 mm shell-thickness tier of Aptenodytes forsteri — Model fidelity to source: 90/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Schnakenberg kinetics, Jacobian, sigma(k), and the diffusivity rescale that puts the fastest mode on 10^(-2.929) m are in the script and checked by --self-test (trace negative, determinant positive, sigma(0) negative, equal-diffusion sigma_max negative, lambda within 1.5 percent of the tier). The system is not a line-by-line copy of a feather-follicle parameter table." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 9e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg wavelength at the 1.178 mm shell-thickness tier of Aptenodytes forsteri — Morphometric validation: 91/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Dispersion lambda 1.1767 mm versus PDE 1.1685 mm. Pearson r 0.9979, RMSE 0.0301 mm, KS 0.143. Photograph pore wavelength 0.663 mm against published shell thickness 1.11 mm. Simulated patch foreground 0.450, coherency 0.388, circularity 0.030 against specimen 0.535, 0.384, 0.732. No metric copies its reference. The KS sample has only seven scales." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;

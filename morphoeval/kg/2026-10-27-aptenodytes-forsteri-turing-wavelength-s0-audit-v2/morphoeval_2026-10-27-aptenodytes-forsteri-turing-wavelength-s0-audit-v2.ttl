<https://w3id.org/delphi/resource/math-law/delphi10000-aptenodytes-forsteri-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg steady state" ;
    dct:description "Homogeneous base state about which the 1.178 mm shell-thickness mode is linearised | Variables: a = 0.20, b = 0.30, so u0 = 0.50 and v0 = 1.20" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg kinetics as used for integument RD" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/95244113b1348dfeec9466cf094db251e2807d75/models/2026-delphi10000-aptenodytes-forsteri-turing-wavelength-s0.py#L69-L86>,
        <https://github.com/fractastical/morpholib/blob/95244113b1348dfeec9466cf094db251e2807d75/morphoeval/lean/loops/Loop_3116_aptenodytes_forsteri_turing_wavelength_s0.lean#L20-L22> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u0 = a + b, v0 = b / (a + b)^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3116.tierWavelengthUm" ;
    pk:leanTheorem "MathOfBiology.Loop_3116.tier_inside_shell_thickness" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-aptenodytes-forsteri-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Fastest-growing Turing wavenumber" ;
    dct:description "Selects lambda = 10^(-2.929) m on the Holocene egg, inside the 0.94-1.32 mm shell-thickness window | Variables: D_v/D_u = 42; D_u rescaled so k_peak = 2 pi per tier wavelength" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/95244113b1348dfeec9466cf094db251e2807d75/models/2026-delphi10000-aptenodytes-forsteri-turing-wavelength-s0.py#L108-L123>,
        <https://github.com/fractastical/morpholib/blob/95244113b1348dfeec9466cf094db251e2807d75/morphoeval/lean/loops/Loop_3116_aptenodytes_forsteri_turing_wavelength_s0.lean#L30-L32> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "sigma(k^2) = 0.5 * (tr(J - k^2 D) + sqrt(discriminant)); lambda_c = 2 pi / k_peak" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3116.diffusionRatio" ;
    pk:leanTheorem "MathOfBiology.Loop_3116.schnakenberg_margin_at_delta_42" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-aptenodytes-forsteri-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control. Pattern growth requires the long-range inhibitor. | Variables: delta = 1 versus delta = 42" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/95244113b1348dfeec9466cf094db251e2807d75/models/2026-delphi10000-aptenodytes-forsteri-turing-wavelength-s0.py#L208-L219>,
        <https://github.com/fractastical/morpholib/blob/95244113b1348dfeec9466cf094db251e2807d75/morphoeval/lean/loops/Loop_3116_aptenodytes_forsteri_turing_wavelength_s0.lean#L35-L37> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "when D_u = D_v, sigma_max < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3116.diffusionRatio" ;
    pk:leanTheorem "MathOfBiology.Loop_3116.equal_diffusion_margin_fails" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-aptenodytes-forsteri-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Successor scale along the egg" ;
    dct:description "The whole egg is the successor length. There is no earlier chronospecies in this 1/1 series. | Variables: L_egg = 121.3 mm, lambda_c = 1.178 mm, age = 0 Ma, chronoseries length = 1" ;
    dct:source "Chinese Journal of Polar Research 20(4):320-328 (2008), egg length 121.3 mm" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/95244113b1348dfeec9466cf094db251e2807d75/models/2026-delphi10000-aptenodytes-forsteri-turing-wavelength-s0.py#L57-L66>,
        <https://github.com/fractastical/morpholib/blob/95244113b1348dfeec9466cf094db251e2807d75/morphoeval/lean/loops/Loop_3116_aptenodytes_forsteri_turing_wavelength_s0.lean#L40-L42> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "L_egg / lambda_c > 100" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3116.eggLengthUm" ;
    pk:leanTheorem "MathOfBiology.Loop_3116.egg_is_successor_scale" ;
    pk:leanVerified true .


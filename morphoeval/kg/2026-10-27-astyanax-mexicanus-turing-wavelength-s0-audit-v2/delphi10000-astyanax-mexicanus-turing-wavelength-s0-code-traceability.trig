sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Turing wavenumber at 666 nm in the Astyanax cave morph — Code-to-model traceability: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The sweep, the ablation and the wavelength bracket sit next to the Lean theorems for the discriminant, the equal-diffusivity failure and the 36-37x ratio against the 24 µm sibling. The composite path is now one signed resample. The integer Jacobian in Lean is the Schnakenberg state cleared by 5, which the script comments and does not re-derive in Lean." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-code-traceability-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3125_astyanax_mexicanus_turing_wavelength_s0.lean L33–L59" ;
        dct:description "discriminant, equal diffusivity, wavenumber bracket, sibling ratio" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3125_astyanax_mexicanus_turing_wavelength_s0.lean#L33-L59> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-astyanax-mexicanus-turing-wavelength-s0.py L104–L108" ;
        dct:description "metres per pixel from k_max and 6.656e-7 m" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-astyanax-mexicanus-turing-wavelength-s0.py#L104-L108> .

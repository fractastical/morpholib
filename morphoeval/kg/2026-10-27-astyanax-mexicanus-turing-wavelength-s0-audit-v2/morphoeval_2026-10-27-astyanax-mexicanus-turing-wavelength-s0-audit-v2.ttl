<https://w3id.org/delphi/resource/math-law/delphi10000-astyanax-mexicanus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Reaction Jacobian trace (stable without diffusion)" ;
    dct:description "homogeneous mode must decay | Variables: f_u, g_v at the Schnakenberg steady state, cleared by a factor of 5" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-astyanax-mexicanus-turing-wavelength-s0.py#L85-L96>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3125_astyanax_mexicanus_turing_wavelength_s0.lean#L17-L23> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "tr(J) = f_u + g_v < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.cub.2010.07.017>,
        <https://doi.org/10.1038/nature02864>,
        <https://doi.org/10.1038/ng1700>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1525-142x.2004.04026.x>,
        <https://doi.org/10.1146/annurev-genet-102108-134216>,
        <https://doi.org/10.1371/journal.pgen.1000326> ;
    pk:hypothesisType "Turing reaction-diffusion wavenumber selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3125.trace" ;
    pk:leanTheorem "MathOfBiology.Loop_3125.trace_stable_without_diffusion" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-astyanax-mexicanus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing discriminant" ;
    dct:description "necessary condition for a finite unstable band | Variables: D_u:D_v = 2:20 on the integer Jacobian (4, 5, -9, -5)" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-astyanax-mexicanus-turing-wavelength-s0.py#L85-L103>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3125_astyanax_mexicanus_turing_wavelength_s0.lean#L33-L36> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(D_v f_u + D_u g_v)^2 > 4 D_u D_v det(J)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.cub.2010.07.017>,
        <https://doi.org/10.1038/nature02864>,
        <https://doi.org/10.1038/ng1700>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1525-142x.2004.04026.x>,
        <https://doi.org/10.1146/annurev-genet-102108-134216>,
        <https://doi.org/10.1371/journal.pgen.1000326> ;
    pk:hypothesisType "Turing reaction-diffusion wavenumber selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3125.diffusionDrive" ;
    pk:leanTheorem "MathOfBiology.Loop_3125.turing_discriminant" ;
    pk:leanVerified true .


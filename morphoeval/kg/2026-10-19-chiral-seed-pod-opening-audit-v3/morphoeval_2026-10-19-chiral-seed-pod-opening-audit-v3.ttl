    schema:name "Freund dynamic crack speed law v/c_R = 1 - Gamma_c/G across the 7-point suture toughness sweep (homogeneous suture, fully dried)" ;
    schema:unitText "Pearson r" ;
    schema:value "1.0" ;
    schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-freund-dynamic-crack-speed-law-v-c-r-1-gamma-c-g-across-the-7-point-suture-toughness-sweep-homogeneous-suture-fully-dried-reference> .

<https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-freund-dynamic-crack-speed-law-v-c-r-1-gamma-c-g-across-the-7-point-suture-toughness-sweep-homogeneous-suture-fully-dried-reference> a schema:PropertyValue ;

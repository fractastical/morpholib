sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-liang-chiral-seed-pod-opening> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Armon et al. (2011) Science / Efrati et al. (2009) JMPS Incompatible Shell Elasticity & Chiral Seed Pod Opening — Parameter expressivity: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Pass 2 sweeps are retained (11-point w_tilde pitchfork L497-576, 7-point cutting angle L577-644, 4 systems L645-722). Pass 3 adds the 7-point Gamma_c/G in {0.2..1.2} ablation with homogeneous vs heterogeneous suture and a Gamma_c >= G no-fracture negative control (`evaluate_suture_toughness_sweep` L1098-1162), the desiccation trajectory kappa_0(t) as a swept driver (L932-1097), eta-scaling of the launch speed checked in the self-test, and new CLI overrides `--gamma-c`, `--eta`, `--m-seed` plus a `--fracture-json` summary mode (L2079-2082, L2103-2109), all wired into the simulation. Deductions: CV_Gamma, a_0, tau_dry, launch angle and height are fixed JSON constants with no CLI or sweep (-3); the opening fraction near Gamma_c ~ G is set by the numerical arrest threshold `v_arrest_frac = 0.01` (L815, L831), which is not exposed or swept (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2007-liang-chiral-seed-pod-opening.py L807–L835: v_arrest_frac = 0.01 numerical arrest threshold sets opening fraction near Gamma_c ~ G; not exposed <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L807-L835>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-parameter-expressivity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L497–L722" ;
        dct:description "11-point w_tilde pitchfork sweep, 7-point cutting-angle chirality sweep, 4-system benchmark evaluation (Pass 2, retained)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L497-L722> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L1098–L1162" ;
        dct:description "7-point Gamma_c/G toughness sweep, homogeneous vs heterogeneous suture, no-fracture control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L1098-L1162> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L2069–L2121" ;
        dct:description "CLI: --kappa0 --nu --W --h --L --seed plus Pass 3 --gamma-c --eta --m-seed --fracture-json; overrides wired into simulate_suture_fracture_ballistic_ejection and rendering" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L2069-L2121> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 065 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


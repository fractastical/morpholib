sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-liang-chiral-seed-pod-opening> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Armon et al. (2011) Science / Efrati et al. (2009) JMPS Incompatible Shell Elasticity & Chiral Seed Pod Opening — Morphological realism / specimen match: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The SHA-256-locked Bauhinia variegata specimen (MHNT.BOT.2011.3.22) is still segmented into both dehisced valves and 8 helical lobe apices (`segment_bauhinia_pod_specimen` L1163-1248) and Panel E overlays the segmentation on the photograph; the 9-panel figure now adds suture-crack, catapult and ballistic panels (G-I, `_draw_fracture_panels` L1249-1358) and a 45-frame fracture GIF (L1666-1778). Deductions: the ROI `x0, y0, x1, y1 = 150, 60, 928, 452` is hard-coded (L1175) and the upper/lower valve assignment relies on `runs[0]`/`runs[-1]` column logic (L1194-1200), which is brittle (-3); the 4-system table's Erythrina and latex R_obs/P_obs carry only \"p. 1726\"/\"Fig. 2 & 3\" pointers with no digitisation coordinates and the Bauhinia R_obs = 3.39 cm vs sim 3.396 cm suggests back-computation (`evaluate_pod_and_mimetic_specimens` L645-722; JSON L70-123) (-4); the new fracture/ballistic panels compare against Cardamine and Hura (different taxa) because no Bauhinia launch-speed or dispersal specimen datum exists in the package (-4); Panel A has no specimen overlay and the 3-D mesh cup = 0.5 kappa_t T^2 and helix frame (L466-479) are unvalidated visual heuristics (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2007-liang-chiral-seed-pod-opening.py L645–L722: 4-system table evaluation; the JSON R_obs/P_obs for Erythrina and latex carry page pointers only, no digitisation coordinates <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L645-L722>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-specimen-match-4> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L1163–L1248" ;
        dcterms:description "Contour and bilayer reflectance segmentation of the SHA-locked Bauhinia specimen; hard-coded ROI at L1175 and runs[0]/runs[-1] valve assignment at L1194-1200" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L1163-L1248> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L1249–L1358" ;
        dcterms:description "Panels G-I: suture toughness profile and crack tip trajectory, catapult speed vs Gamma_c/G with Cardamine/Hura transfer-boundary lines, ballistic arcs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L1249-L1358> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/chiral_seed_pod_opening_comparison.png (generated output)" ;
        dcterms:description "9-panel synthesis figure: 3-D meshes, pitchfork, R/P transition, cutting-angle sweep, specimen segmentation, 4-system validation, suture fracture, catapult, ballistics — docs/media/chiral_seed_pod_opening_comparison.png: rendered output of 2007-liang-chiral-seed-pod-opening.py at 45670cb8, image/png, 1277872 B, 2775×2460 px, artifact_sha256 172e958f57c4f16dd8b2e082fc2efb5442a52bdf87f09ac52a5d36928b1c4960 (sha256 172e958f57c4f16dd8b2e082fc2efb5442a52bdf87f09ac52a5d36928b1c4960), spec_fingerprint 988d946ef567ff70b70ecbbb7abf3522d31bdbaab73fbfe18f6b573345ff5c32" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/chiral_seed_pod_opening_suture_fracture.gif (generated output)" ;
        dcterms:description "45-frame fracture GIF: toughness profile, crack tip, seed ballistic arcs; no specimen footage to compare against — docs/media/chiral_seed_pod_opening_suture_fracture.gif: rendered output of 2007-liang-chiral-seed-pod-opening.py at 45670cb8, image/gif, 430102 B, 864×413 px, 45 frames, artifact_sha256 2825cd3c1d78c43be825f8df801150ed499c4a8b73ec80de354949004c7f6756 (sha256 2825cd3c1d78c43be825f8df801150ed499c4a8b73ec80de354949004c7f6756), spec_fingerprint 988d946ef567ff70b70ecbbb7abf3522d31bdbaab73fbfe18f6b573345ff5c32" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 065 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-liang-chiral-seed-pod-opening> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Armon et al. (2011) Science / Efrati et al. (2009) JMPS Incompatible Shell Elasticity & Chiral Seed Pod Opening — Code-to-model traceability: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module header maps Laws 1-5 to the Lean theorems and to Armon 2011 / Efrati 2009 / Freund 1990 / Vogel 2005 (L1-74), and each Pass 3 function docstring states its equation and Lean link (`bending_energy_prefactor` L733-741 derives B_eff from the Efrati bending content; `freund_crack_speed` L783-790; `elastic_catapult_seed_speed` L861-879). The math-KG registration lists equations 4-5 with single-range `code_locus`, `code_locus_secondary` and `lean_locus`. Deductions: the file name `2007-liang-...` and sim_id `liang-chiral-seed-pod-opening` do not match the seed paper (Armon et al. 2011) — a campaign-level identity mismatch that propagates into every audit, KG and run id (-3); the Lean theorems are Int-linear abstractions (scaled Freund speed c_R (G - Gamma), eta Delta_U partition), not statements about the ODE integration or the minimizer (-2); the \"Eq. 3 & SOM\" and \"p. 1726-1727\" pinpoints are unverified and the heuristic choices (v_arrest_frac, m/3, h_suture = h) are documented in docstrings but not traced to a source (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "morphoeval/lean/loops/Loop_065_chiral_seed_pod_opening.lean L126–L149: freund_scaled_crack_speed is c_R (G - Gamma) over Int — an abstraction of the law, not of integrate_suture_crack <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_065_chiral_seed_pod_opening.lean#L126-L149>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-code-traceability-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L1–L74" ;
        dcterms:description "Module header: Laws 1-5 mapped to Lean theorems and to Armon/Efrati/Freund/Vogel; file name and sim_id still say 'liang'" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L1-L74> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L733–L790" ;
        dcterms:description "Docstrings derive B_eff from the Efrati 2009 bending content and state the Freund (1990) equation of motion with Lean link" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L733-L790> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/liang-chiral-seed-pod-opening.yaml L89–L126" ;
        dcterms:description "Equations 4-5 registered with single-range code_locus, code_locus_secondary and lean_locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/math_kg_loops/liang-chiral-seed-pod-opening.yaml#L89-L126> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 065 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


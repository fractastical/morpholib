sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-liang-chiral-seed-pod-opening> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Armon et al. (2011) Science / Efrati et al. (2009) JMPS Incompatible Shell Elasticity & Chiral Seed Pod Opening — Model fidelity to source: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The incompatible-plate core is unchanged and credited (saddle b_0 with det(b_0) = -kappa_0^2 < 0, `compute_target_curvature_tensor` L174-209; FvK critical width L210-217; L-BFGS-B minimizer of U(H, D, phi; w_tilde) L278-416). Pass 3 adds a physically coherent reduced coupling: B_eff derived from the Efrati bending content (L733-741), Delta_e -> G (L743-776), Freund's equation of motion with arrest (L783-790, L807-859), drying-driven Griffith initiation and stick-slip in `simulate_suture_fracture_ballistic_ejection` (L932-1097), and energy-partition ballistics (L861-879, L889-931), each with a negative control and backed by 2 new Lean theorems. Deductions: the pitchfork threshold is prescribed, not emergent — Lambda is normalised by (w_tilde/w_tilde_c)^4 (L324-325) so the bifurcation occurs at w_tilde_c by construction (-3); after the minimizer, H is forced to 0 for w_tilde <= w_tilde_c, its sign is forced to `branch`, and phi is snapped to 0 (L362-366), so the reported branch structure is partly post-processed (-3); e_init = kappa_0^2 assumes a perfectly flat closed valve (upper bound on stored energy, L753-756), the crack area assumes h_suture = h, c_R uses the bulk shear speed not plate waves (L778-781), and m_eff = m_seg/3 is a cantilever heuristic (L871-875) — no flexural or snap-through dynamics of the coiling valve are simulated (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2007-liang-chiral-seed-pod-opening.py L278–L416: L-BFGS-B minimizer of the reduced non-Euclidean energy; Lambda normalised by (w_tilde/w_tilde_c)^4 at L324-325 and H/branch/phi post-processing at L362-366 make the pitchfork partly prescribed <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L278-L416>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-model-fidelity-5> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L174–L217" ;
        dct:description "Rotated saddle target curvature tensor b_0(theta) with det(b_0) = -kappa_0^2 < 0 and FvK critical width w_tilde_c" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L174-L217> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L733–L790" ;
        dct:description "B_eff from the Efrati 2009 bending content, released energy density Delta_e -> suture G, Rayleigh speed and Freund crack speed law with arrest" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L733-L790> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L807–L931" ;
        dct:description "Explicit da/dt integration with arrest, elastic-catapult launch speed (cantilever m/3 heuristic), cantilever coil time and RK4 quadratic-drag ballistics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L807-L931> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L932–L1097" ;
        dct:description "Two-timescale coupling: desiccation kappa_0(t) -> minimizer -> G(t) -> Griffith initiation, stick-slip jumps, seed ejection timeline" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L932-L1097> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_065_chiral_seed_pod_opening.lean L126–L189" ;
        dct:description "freund_crack_speed_arrest_and_monotonicity and elastic_catapult_energy_partition (Int-linear abstractions of the scaled Freund law and eta energy partition; 0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_065_chiral_seed_pod_opening.lean#L126-L189> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 065 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


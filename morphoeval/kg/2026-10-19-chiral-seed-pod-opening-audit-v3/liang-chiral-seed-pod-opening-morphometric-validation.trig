        dct:description "narrow helicoid w_tilde=1.0 gives H/kappa_0 = 0.0000" ;
        schema:measurementTechnique "Exact non-Euclidean shell pitchfork threshold w_tilde_c = (16*(1+nu)/sqrt(1-nu^2))^(1/4)" ;
        schema:name "Armon et al. (2011) critical Föppl-von Kármán pitchfork width w_tilde_c (nu=0.30)" ;
        schema:unitText "dimensionless" ;
        schema:value "2.1609" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-armon-et-al-2011-critical-f-ppl-von-k-rm-n-pitchfork-width-w-tilde-c-nu-0-30-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-armon-et-al-2011-critical-f-ppl-von-k-rm-n-pitchfork-width-w-tilde-c-nu-0-30-reference> a schema:PropertyValue ;
        dct:source "Armon, Efrati, Kupferman & Sharon (2011) Science 333:1726-1730 Eq. 3 & SOM" ;
        schema:value "2.1609" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-bauhinia-variegata-specimen-segmented-helical-lobe-half-pitch-cv-bauhinia-chiral-seed-pod-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Bauhinia variegata specimen segmented helical lobe half-pitch CV (bauhinia_chiral_seed_pod_specimen.jpg) = 0.2405 CV (std/mean)" ;
        dct:description "mean half-pitch = 169.83 ± 40.85 px" ;
        schema:measurementTechnique "Inter-lobe half-pitch spacing dispersion across n=8 segmented helical twist lobes on both dehisced valves" ;
        schema:name "Bauhinia variegata specimen segmented helical lobe half-pitch CV (bauhinia_chiral_seed_pod_specimen.jpg)" ;
        schema:unitText "CV (std/mean)" ;
        schema:value "0.2405" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-bauhinia-variegata-specimen-segmented-helical-lobe-half-pitch-cv-bauhinia-chiral-seed-pod-specimen-jpg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-bauhinia-variegata-specimen-segmented-helical-lobe-half-pitch-cv-bauhinia-chiral-seed-pod-specimen-jpg-reference> a schema:PropertyValue ;
        dct:source "Armon et al. (2011) Science Fig. 1A & Muséum de Toulouse MHNT.BOT.2011.3.22" ;
        schema:value "0.24" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-cutting-angle-chirality-torsion-tau-theta-kappa-0-correlation-across-theta-in-0-deg-90-deg> a schema:PropertyValue,

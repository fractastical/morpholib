sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-liang-chiral-seed-pod-opening> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Armon et al. (2011) Science / Efrati et al. (2009) JMPS Incompatible Shell Elasticity & Chiral Seed Pod Opening — Morphometric validation: 72/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1779-1944) now returns 15 measurements with references, uncertainties and tests, and the Pass 3 negative controls (kappa_0 = 0, Gamma_c >= G, achiral rings) behave correctly. Deductions are large because the remediation exposed that most references are not empirical: measurements 3-7 compare the minimizer against the `*_obs` columns of chiral_seed_pod_opening_reference.json (L48-59, L61-68), which are analytical values of the same reduced model (H_obs = (1 - nu)/2 sqrt(1 - (w_tilde_c/w_tilde)^4), tau_obs = D sin 2theta), so r = 1.0000 is self-consistency, not validation against Armon 2011 Figs. 3-4 (-10); measurement 9 uses `reference_value: 0.24` (L1877) that is the script's own computed CV 0.2405 (-4); of the six Pass 3 measurements, #10's reference is the model Gamma_c (L1888), #11's is the analytical self-estimate -tau ln(1 - sqrt(Gamma/G)) (L1898), #12's is the Freund law itself, #13's is a qualitative \"complete dehiscence\" 1.0, #14's 10 m/s is Cardamine (L1928; Bauhinia predicted 3.6x lower), and #15's is the drag-free bound (L1938) — consistency checks, not empirical morphometrics (-8). The 4-system pitch correlation (r = 0.9994) and the specimen lobe segmentation remain the only comparisons to numbers that originate outside the script." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2007-liang-chiral-seed-pod-opening.py L1779–L1944: 15 measurements with RMSE/p-values/CV; references for #3-7 are analytic model values, #9 is the script's own CV, #10-15 are model/theory/transfer references <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L1779-L1944>",
            "datasets/chiral_seed_pod_opening/chiral_seed_pod_opening_reference.json L48–L68: Width and cutting-angle sweep *_obs columns are analytical values of the reduced model, not digitised Armon 2011 figure points <https://github.com/fractastical/morpholib/blob/45670cb8/datasets/chiral_seed_pod_opening/chiral_seed_pod_opening_reference.json#L48-L68>",
            "datasets/chiral_seed_pod_opening/suture_fracture_ballistic_reference.json L54–L75: Transfer-boundary benchmarks: Cardamine ~10 m/s and Hura ~70 m/s, recalled values not digitised; no Bauhinia datum <https://github.com/fractastical/morpholib/blob/45670cb8/datasets/chiral_seed_pod_opening/suture_fracture_ballistic_reference.json#L54-L75>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-4-system-legume-biomimetic-latex-helical-pitch-p-correlation-bauhinia-erythrina-latex>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-achiral-ring-negative-control-helical-pitch-p-at-cutting-angle-theta-0-deg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-armon-et-al-2011-critical-f-ppl-von-k-rm-n-pitchfork-width-w-tilde-c-nu-0-30>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-bauhinia-variegata-specimen-segmented-helical-lobe-half-pitch-cv-bauhinia-chiral-seed-pod-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-cutting-angle-chirality-torsion-tau-theta-kappa-0-correlation-across-theta-in-0-deg-90-deg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-dimensionless-helical-pitch-p-w-tilde-kappa-0-2-pi-transition-correlation-across-w-tilde>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-dimensionless-helix-radius-r-w-tilde-kappa-0-transition-correlation-across-w-tilde-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-drying-coupled-stick-slip-pod-opening-fraction-a-l-and-cumulative-dynamic-crack-run-time-gamma-c-120-j-m-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-elastic-catapult-seed-launch-speed-v-seed-drying-coupled-mean-over-ejected-seeds>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-freund-dynamic-crack-speed-law-v-c-r-1-gamma-c-g-across-the-7-point-suture-toughness-sweep-homogeneous-suture-fully-dried>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-griffith-initiation-time-t-c-of-suture-dehiscence-on-the-desiccation-curve-kappa-0-t-kappa-0-f-1-exp-t-tau-dry>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-incompatible-saddle-gaussian-target-curvature-det-b-0-kappa-0-2-kappa-0-0-42-cm-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-seed-ballistic-range-with-quadratic-drag-from-a-3-m-launch-height-45-deg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-supercritical-pitchfork-mean-curvature-h-w-tilde-kappa-0-correlation-across-w-tilde-in-0-5-10>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-suture-energy-release-rate-g-final-delta-e-kappa-0-0-42-w-h-from-the-quasi-static-minimizer-fully-dried-pod>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-morphometric-validation-1> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-4-system-legume-biomimetic-latex-helical-pitch-p-correlation-bauhinia-erythrina-latex> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "4-system legume & biomimetic latex helical pitch P correlation (Bauhinia, Erythrina, Latex) = 0.9994 Pearson r" ;
        dct:description "4-system helix radius Pearson r = 1.0000, RMSE = 0.0054 cm" ;
        schema:measurementTechnique "Predicted vs empirical helical pitch P across 4 experimental systems (p=6.24e-04, RMSE=0.1771 cm)" ;
        schema:name "4-system legume & biomimetic latex helical pitch P correlation (Bauhinia, Erythrina, Latex)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9994" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-4-system-legume-biomimetic-latex-helical-pitch-p-correlation-bauhinia-erythrina-latex-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-4-system-legume-biomimetic-latex-helical-pitch-p-correlation-bauhinia-erythrina-latex-reference> a schema:PropertyValue ;
        dct:source "Armon et al. (2011) Science 333:1726-1730 Figs. 1-4" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-achiral-ring-negative-control-helical-pitch-p-at-cutting-angle-theta-0-deg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Achiral ring negative control helical pitch P at cutting angle theta = 0 deg = 0.0 cm" ;
        dct:description "theta=90 deg pitch = 0.000000 cm, ring radius R(0 deg) = 3.4770 cm" ;
        schema:measurementTechnique "Helical pitch P(theta=0 deg) when principal intrinsic curvature aligns with strip axis (tau = D*sin(0) = 0)" ;
        schema:name "Achiral ring negative control helical pitch P at cutting angle theta = 0 deg" ;
        schema:unitText "cm" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-achiral-ring-negative-control-helical-pitch-p-at-cutting-angle-theta-0-deg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-achiral-ring-negative-control-helical-pitch-p-at-cutting-angle-theta-0-deg-reference> a schema:PropertyValue ;
        dct:source "Armon et al. (2011) Science 333:1726-1730 Fig. 2A (theta=0 deg achiral circular ring)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-armon-et-al-2011-critical-f-ppl-von-k-rm-n-pitchfork-width-w-tilde-c-nu-0-30> a schema:PropertyValue,
            pk:EvidenceItem ;

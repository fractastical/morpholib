    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-dimensionless-helix-radius-r-w-tilde-kappa-0-transition-correlation-across-w-tilde-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Dimensionless helix radius R(w_tilde)*kappa_0 transition correlation across w_tilde_c = 1.0 Pearson r" ;
        dct:description "narrow helicoid (w_tilde <= w_tilde_c) R*kappa_0 = 0.0000" ;
        schema:measurementTechnique "L-BFGS-B helix radius R(w_tilde)*kappa_0 across helicoid-to-ribbon transition (p=1.53e-27, RMSE=0.0009)" ;
        schema:name "Dimensionless helix radius R(w_tilde)*kappa_0 transition correlation across w_tilde_c" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-dimensionless-helix-radius-r-w-tilde-kappa-0-transition-correlation-across-w-tilde-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-dimensionless-helix-radius-r-w-tilde-kappa-0-transition-correlation-across-w-tilde-c-reference> a schema:PropertyValue ;
        dct:source "Armon et al. (2011) Science 333:1726-1730 Fig. 3D & Fig. 4" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-drying-coupled-stick-slip-pod-opening-fraction-a-l-and-cumulative-dynamic-crack-run-time-gamma-c-120-j-m-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Drying-coupled stick-slip pod opening fraction a*/L and cumulative dynamic crack run time (Gamma_c = 120 J/m^2) = 1.0 fraction of suture length" ;
        dct:description "Gamma_c/G_final = 0.432; opening fraction is emergent from the toughness field, not prescribed" ;
        schema:measurementTechnique "9 stick-slip crack jumps over 63.7-100.0 h; cumulative run time 4.946 ms; mean dynamic speed 36.0 m/s = 0.0861 c_R" ;
        schema:name "Drying-coupled stick-slip pod opening fraction a*/L and cumulative dynamic crack run time (Gamma_c = 120 J/m^2)" ;
        schema:unitText "fraction of suture length" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-drying-coupled-stick-slip-pod-opening-fraction-a-l-and-cumulative-dynamic-crack-run-time-gamma-c-120-j-m-2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-drying-coupled-stick-slip-pod-opening-fraction-a-l-and-cumulative-dynamic-crack-run-time-gamma-c-120-j-m-2-reference> a schema:PropertyValue ;
        dct:source "Complete dehiscence of both Bauhinia variegata valves (Armon et al. 2011 Fig. 1; vendored specimen MHNT.BOT.2011.3.22 shows fully separated valves)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-elastic-catapult-seed-launch-speed-v-seed-drying-coupled-mean-over-ejected-seeds> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Elastic-catapult seed launch speed v_seed (drying-coupled mean over ejected seeds) = 2.767 m/s" ;
        dct:description "Bauhinia predicted ~3.6x slower than Cardamine and ~25x slower than Hura crepitans (70 m/s); eta, m_seed, rho are provenance=model" ;
        schema:measurementTechnique "v = sqrt(2 eta Delta_U_seg / (m_seg/3 + m_seed)), eta = 0.50, m_seed = 0.40 g, l_seg = 3.0 cm; 6/6 seeds ejected; fully dried bound 3.842 m/s" ;
        schema:name "Elastic-catapult seed launch speed v_seed (drying-coupled mean over ejected seeds)" ;
        schema:unitText "m/s" ;
        schema:value "2.767" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-elastic-catapult-seed-launch-speed-v-seed-drying-coupled-mean-over-ejected-seeds-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-elastic-catapult-seed-launch-speed-v-seed-drying-coupled-mean-over-ejected-seeds-reference> a schema:PropertyValue ;
        dct:source "Hofhuis et al. (2016) Cell 166:222-233 Cardamine hirsuta launch speed ~10 m/s (transfer_boundary: different taxon, order-of-magnitude benchmark; no Bauhinia launch-speed measurement available offline)" ;
        schema:value "10.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-freund-dynamic-crack-speed-law-v-c-r-1-gamma-c-g-across-the-7-point-suture-toughness-sweep-homogeneous-suture-fully-dried> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Freund dynamic crack speed law v/c_R = 1 - Gamma_c/G across the 7-point suture toughness sweep (homogeneous suture, fully dried) = 1.0 Pearson r" ;
        dct:description "no-fracture negative control Gamma_c >= G: opening fraction = 0.0111 (flaw only); heterogeneous suture at Gamma = G opens 0.0769" ;
        schema:measurementTechnique "Explicit integration of da/dt = c_R max(0, 1 - Gamma_c(a)/G) vs analytical 1 - Gamma/G at Gamma/G in {0.2..1.2} (p=2.84e-18, RMSE=0.0002; c_R = 417.9 m/s)" ;
        schema:name "Freund dynamic crack speed law v/c_R = 1 - Gamma_c/G across the 7-point suture toughness sweep (homogeneous suture, fully dried)" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-freund-dynamic-crack-speed-law-v-c-r-1-gamma-c-g-across-the-7-point-suture-toughness-sweep-homogeneous-suture-fully-dried-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-freund-dynamic-crack-speed-law-v-c-r-1-gamma-c-g-across-the-7-point-suture-toughness-sweep-homogeneous-suture-fully-dried-reference> a schema:PropertyValue ;
        dct:source "Freund LB (1990) Dynamic Fracture Mechanics, Cambridge Univ. Press, Ch. 7 mode-I equation of motion G_dyn(v) = (1 - v/c_R) G" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-griffith-initiation-time-t-c-of-suture-dehiscence-on-the-desiccation-curve-kappa-0-t-kappa-0-f-1-exp-t-tau-dry> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Griffith initiation time t_c of suture dehiscence on the desiccation curve kappa_0(t) = kappa_0,f (1 - exp(-t/tau_dry)) = 63.66 h" ;
        dct:description "tau_dry and Gamma_c are provenance=model; the measurement tests the coupling, not a Bauhinia field observation" ;
        schema:measurementTechnique "First drying time at which G(t) exceeds the local suture toughness at the stylar flaw (kappa_0(t_c) = 0.2465 cm^-1, G(t_c) = 102.4 J/m^2)" ;
        schema:name "Griffith initiation time t_c of suture dehiscence on the desiccation curve kappa_0(t) = kappa_0,f (1 - exp(-t/tau_dry))" ;
        schema:unitText "h" ;
        schema:value "63.66" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-griffith-initiation-time-t-c-of-suture-dehiscence-on-the-desiccation-curve-kappa-0-t-kappa-0-f-1-exp-t-tau-dry-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-griffith-initiation-time-t-c-of-suture-dehiscence-on-the-desiccation-curve-kappa-0-t-kappa-0-f-1-exp-t-tau-dry-reference> a schema:PropertyValue ;
        dct:source "Analytical estimate from G ~ kappa_0^2 scaling: t_c = -tau_dry ln(1 - sqrt(Gamma_c(a_0)/G_final)); tau_dry = 72 h is a model constant" ;

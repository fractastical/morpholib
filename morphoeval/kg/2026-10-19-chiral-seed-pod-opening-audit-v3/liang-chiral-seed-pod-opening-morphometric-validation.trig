        schema:measurementTechnique "RK4 of m dv/dt = m g - (1/2) rho_air C_d A |v| v (C_d = 1.0, r = 6 mm); flight time 1.08 s" ;
        schema:name "Seed ballistic range with quadratic drag from a 3 m launch height (45 deg)" ;
        schema:unitText "m" ;
        schema:value "1.652" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-seed-ballistic-range-with-quadratic-drag-from-a-3-m-launch-height-45-deg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-seed-ballistic-range-with-quadratic-drag-from-a-3-m-launch-height-45-deg-reference> a schema:PropertyValue ;
        dct:source "Drag-free analytical upper bound x = v cos(a)(v sin(a) + sqrt(v^2 sin^2(a) + 2 g z_0))/g (theory bound, must exceed the drag range)" ;

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-cutting-angle-chirality-torsion-tau-theta-kappa-0-correlation-across-theta-in-0-deg-90-deg-reference> a schema:PropertyValue ;

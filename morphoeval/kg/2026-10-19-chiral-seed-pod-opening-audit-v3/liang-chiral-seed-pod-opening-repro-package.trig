sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-liang-chiral-seed-pod-opening> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Armon et al. (2011) Science / Efrati et al. (2009) JMPS Incompatible Shell Elasticity & Chiral Seed Pod Opening — Reproducibility package: 95/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`self_test()` (L1946-2067) runs 12 checks in 2.3 s: 8 Pass 2 checks plus energy bookkeeping, Freund law and arrest, drying-coupled dehiscence + catapult + ballistics + no-fracture control + eta-scaling, and toughness sweep + two-run determinism; SHA-256 verification is fail-closed; the default render completes in ~8.5 s and writes the 9-panel PNG, the fracture PNG and both GIFs (`main` L2069-2121); `--fracture-json` emits a machine-readable summary. Deductions: the drying grid (96 points, ~4.5 h) sets the t_c resolution and is not a CLI parameter (-2); the growth GIF is byte-identical to the committed version and does not reflect Pass 3, and Panel I's legend overlaps the Hura label (-2); the PNG outputs are gitignored so the rendered figures are not versioned (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "docs/media/chiral_seed_pod_opening_growth.gif (generated output, not in repo): 12-frame growth GIF regenerated by the default run; byte-identical to the committed Pass 2 version (Pass 3 did not change it) — docs/media/chiral_seed_pod_opening_growth.gif: rendered output of 2007-liang-chiral-seed-pod-opening.py at 45670cb8, image/gif, 236086 B, 608×456 px, 12 frames, artifact_sha256 ab3bfe47b66182ba264e6aeaf3e791ae9649f6460e2c4fa9006787dbf84b2910 (sha256 ab3bfe47b66182ba264e6aeaf3e791ae9649f6460e2c4fa9006787dbf84b2910), spec_fingerprint 988d946ef567ff70b70ecbbb7abf3522d31bdbaab73fbfe18f6b573345ff5c32" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-repro-package-4> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L1946–L2067" ;
        dct:description "12-check self_test(): SHA integrity, incompatibility, controls, pitchfork, chirality, 4-system, specimen CV, energy bookkeeping, Freund law/arrest, drying-coupled dehiscence/catapult/ballistics, toughness sweep, bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L1946-L2067> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L2069–L2121" ;
        dct:description "main(): CLI, --fracture-json JSON summary, renders comparison PNG, fracture PNG, growth GIF and fracture GIF" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-liang-chiral-seed-pod-opening.py#L2069-L2121> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "datasets/chiral_seed_pod_opening/README.md L22–L35" ;
        dct:description "File table updated with the Pass 3 JSON and bib re-pin; Pass 3 section documents the reduced model and provenance flags" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/datasets/chiral_seed_pod_opening/README.md#L22-L35> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/chiral_seed_pod_opening_suture_fracture.png (generated output)" ;
        dct:description "Standalone Pass 3 fracture/ballistic figure rendered by render_fracture_ballistic_figure (L1359-1376) on every default run — docs/media/chiral_seed_pod_opening_suture_fracture.png: rendered output of 2007-liang-chiral-seed-pod-opening.py at 45670cb8, image/png, 282963 B, 2660×812 px, artifact_sha256 7fe8e413c23ef87d99c023d54a54dfa6145ac84de3e8f52e5f796938b154b1e0 (sha256 7fe8e413c23ef87d99c023d54a54dfa6145ac84de3e8f52e5f796938b154b1e0), spec_fingerprint 988d946ef567ff70b70ecbbb7abf3522d31bdbaab73fbfe18f6b573345ff5c32" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 065 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Confuciusornis sanctus Turing wavelength at 143.4 µm (Yixian Fm, 125.0 Ma) — Model fidelity to source: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Equations 1–5 are the Schnakenberg system, its Jacobian, and Turing's k_c formula. Self-test checks trace < 0, det > 0, the instability margin, λ_c = 143.4 µm, a positive critical growth rate, and a stable equal-diffusion spectrum. Six Lean theorems encode the same integer inequality with zero sorry. Deduction: the kinetics are a reconstructed carrier, not Prum & Williamson or Harris et al. parameter values." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py L56–L64: a, b, Du, Dv are slot calibrations, not a published feather table <https://github.com/fractastical/morpholib/blob/fbd09a11bf97bd7e131df1afb92f62af0b4105ba/models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py#L56-L64>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py L94–L145" ;
        dct:description "Jacobian, k_c, dispersion σ(k), equal-diffusion ceiling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbd09a11bf97bd7e131df1afb92f62af0b4105ba/models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py#L94-L145> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3152_confuciusornis_sanctus_turing_wavelength_s0.lean L24–L47" ;
        dct:description "six theorems, zero sorry, integer Turing inequality" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbd09a11bf97bd7e131df1afb92f62af0b4105ba/morphoeval/lean/loops/Loop_3152_confuciusornis_sanctus_turing_wavelength_s0.lean#L24-L47> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, Pass 1; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


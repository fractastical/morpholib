<https://w3id.org/delphi/resource/math-law/delphi10000-confuciusornis-sanctus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Instability inequality that admits a finite k_c at 143.4 µm | Variables: fu = 13/15, gv = -36/25, r = Dv/Du = 12, det = 36/25" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3152_confuciusornis_sanctus_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J - k^2 D) = Du Dv k^4 - (Dv fu + Du gv) k^2 + (fu gv - fv gu)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/377616a0>,
        <https://doi.org/10.1038/nature08740>,
        <https://doi.org/10.1073/pnas.0500781102>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1205748>,
        <https://doi.org/10.3390/geosciences2030157> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3152.det_positive" ;
    pk:leanTheorem "MathOfBiology.Loop_3152.turing_wavenumber_instability" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-confuciusornis-sanctus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength" ;
    dct:description "This primordium wavelength is shorter than the 5.4 mm organ-scale sibling | Variables: lambda_c = 1434 tenths of a micrometre, organ sibling = 54000" ;
    dct:source "Prum & Williamson 2002 DOI:10.1098/rspb.2001.1896" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3152_confuciusornis_sanctus_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 2 pi / k_c, k_c^2 = (Dv fu + Du gv) / (2 Du Dv) = 143.4 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/377616a0>,
        <https://doi.org/10.1038/nature08740>,

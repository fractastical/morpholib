        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The comparison PNG places the real Senckenberg Confuciusornis sanctus photograph beside the simulated collar. The stripe field does not resemble the slab, and the GIF's last frame is that stripe field rather than the fossil. Score stays moderate: the specimen is shown, the pattern is not yet registered to it." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "docs/media/confuciusornis_sanctus_turing_wavelength_s0_growth.gif (generated output, not in repo): 12-frame 640x480 stripe growth; last frame is not the specimen — docs/media/confuciusornis_sanctus_turing_wavelength_s0_growth.gif: rendered output of models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py at fbd09a11bf97bd7e131df1afb92f62af0b4105ba, image/gif, 1426194 B, 640×480 px, 12 frames, artifact_sha256 1eb84ac1a3ce272adc9758333476484532ad70c0da00c47f558bcf1263e47e6f (sha256 1eb84ac1a3ce272adc9758333476484532ad70c0da00c47f558bcf1263e47e6f), spec_fingerprint eefa4e9a500552e28e1fe0176dd6aca52038d5438def2a8270217cfbd375bf34" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-specimen-match-1> ;
        pk:hasScore "0.48"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

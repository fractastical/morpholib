sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Confuciusornis sanctus Turing wavelength at 143.4 µm (Yixian Fm, 125.0 Ma) — Morphometric validation: 44/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The saturated field's dominant Fourier mode is 8, matching N = L/λ_c, and σ(k_c) = 0.0425. The wavelength value equals its calibration reference, so it is not an independent specimen measurement. Pearson r, RMSE, and a KS comparison are absent, and the photograph is not segmented." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-critical-mode-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-critical-turing-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-dominant-fourier-mode-on-the-8-wavelength-collar>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-equal-diffusion-analytic-growth-rate-ceiling>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-yixian-geological-age>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.44"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-critical-mode-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical-mode growth rate = 0.042517009321563215 1/time" ;
        schema:measurementTechnique "largest eigenvalue of the Fourier Jacobian at k_c" ;
        schema:name "critical-mode growth rate" ;
        schema:unitText "1/time" ;
        schema:value "0.042517009321563215" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-critical-turing-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical Turing wavelength = 143.4 µm" ;
        dct:description "calibration identity; not an independent fossil measurement" ;
        schema:measurementTechnique "Eq. 5, λ_c = 2π/k_c with the spatial unit calibrated to 143.4 µm" ;
        schema:name "critical Turing wavelength" ;
        schema:unitText "µm" ;
        schema:value "143.4" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-critical-turing-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-critical-turing-wavelength-reference> a schema:PropertyValue ;
        dct:source "slot scale assignment 0.0001434 m" ;
        schema:value "143.4" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-dominant-fourier-mode-on-the-8-wavelength-collar> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dominant Fourier mode on the 8-wavelength collar = 8 mode index" ;
        dct:description "integer mode selected by the periodic boundary" ;
        schema:measurementTechnique "argmax of the row-mean rFFT of the saturated activator field" ;
        schema:name "dominant Fourier mode on the 8-wavelength collar" ;
        schema:unitText "mode index" ;
        schema:value "8" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-dominant-fourier-mode-on-the-8-wavelength-collar-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-dominant-fourier-mode-on-the-8-wavelength-collar-reference> a schema:PropertyValue ;
        dct:source "N = L/λ_c on the periodic collar" ;
        schema:value "8" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-equal-diffusion-analytic-growth-rate-ceiling> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion analytic growth-rate ceiling = -0.2879166666666668 1/time" ;
        dct:description "negative control is analytic only in pass 1" ;
        schema:measurementTechnique "max_k σ(k) with Du = Dv = 0.5 (analytic ablation, not a spatial run)" ;
        schema:name "equal-diffusion analytic growth-rate ceiling" ;
        schema:unitText "1/time" ;
        schema:value "-0.2879166666666668" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-equal-diffusion-analytic-growth-rate-ceiling-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-equal-diffusion-analytic-growth-rate-ceiling-reference> a schema:PropertyValue ;
        dct:source "Turing requirement that the inhibitor diffuse faster" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-yixian-geological-age> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Yixian geological age = 125.0 Ma" ;
        schema:measurementTechnique "loop horizon assignment for Confuciusornis sanctus" ;
        schema:name "Yixian geological age" ;
        schema:unitText "Ma" ;
        schema:value "125.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-yixian-geological-age-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-yixian-geological-age-reference> a schema:PropertyValue ;
        dct:source "Early Cretaceous (Yixian Fm, 125.0 Ma)" ;
        schema:value "125.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py L267–L323" ;

        rdfs:label "datasets/confuciusornis_sanctus_turing_wavelength_s0/confuciusornis_sanctus_turing_wavelength_s0_metrics.json (generated output)" ;
        dct:description "mode 8, λ_c 143.4, σ_c 0.0425 — datasets/confuciusornis_sanctus_turing_wavelength_s0/confuciusornis_sanctus_turing_wavelength_s0_metrics.json: rendered output of models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, application/json, 560 B, artifact_sha256 d7806cb86a351a2ce4e3f31b763f25bd12b8bc403826b24327c07aabc741e6fa (sha256 d7806cb86a351a2ce4e3f31b763f25bd12b8bc403826b24327c07aabc741e6fa), spec_fingerprint eefa4e9a500552e28e1fe0176dd6aca52038d5438def2a8270217cfbd375bf34" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;

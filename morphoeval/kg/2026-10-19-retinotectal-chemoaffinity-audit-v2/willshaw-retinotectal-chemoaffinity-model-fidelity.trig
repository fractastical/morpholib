sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-willshaw-retinotectal-chemoaffinity> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Prestige & Willshaw (1975) & Brown et al. (2000) EphA/ephrin-A retinotectal chemoaffinity & synaptic competition — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Faithfully implements the counter-graded EphA/ephrin-A chemoaffinity energy E_chem(x_i, y_j), cooperative neighborhood coupling K_ret * W * K_tec, and Prestige-Willshaw Group II Sinkhorn-Knopp homeostatic row/column synaptic competition across the 40x40 weight matrix W_ij(t) (L82-380), backed by 3 standalone Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_086_retinotectal_chemoaffinity.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1976-willshaw-retinotectal-chemoaffinity.py L82–L165" ;
        dct:description "Lean 4 chemoaffinity invariants and Sinkhorn-Knopp Group II vs Group I synaptic normalization" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1976-willshaw-retinotectal-chemoaffinity.py#L82-L165> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1976-willshaw-retinotectal-chemoaffinity.py L170–L380" ;
        dct:description "2D synaptic weight matrix ODE solver across all 6 Prestige-Willshaw and Brown et al. regimes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1976-willshaw-retinotectal-chemoaffinity.py#L170-L380> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_086_retinotectal_chemoaffinity.lean L19–L150" ;
        dct:description "3 machine-checked Lean 4 theorems (0 sorrys) for topographic inversion, Isl2-EphA3 map bifurcation, and Group II compression/expansion" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_086_retinotectal_chemoaffinity.lean#L19-L150> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(00)00012-X>,
            <https://doi.org/10.1098/rspb.1975.0087>,
            <https://doi.org/10.1098/rspb.1976.0087>,
            <https://doi.org/10.1186/1471-2202-5-30> .
    <https://doi.org/10.1016/S0092-8674(00)00012-X> dct:date "2000"^^xsd:gYear ;
        dct:title "Topographic mapping from the retina to the midbrain is controlled by relative but not absolute levels of EphA receptor signaling" .
    <https://doi.org/10.1098/rspb.1975.0087> dct:date "1975"^^xsd:gYear ;
        dct:title "On a role for competition in the formation of patterned neural connexions" .
    <https://doi.org/10.1098/rspb.1976.0087> dct:date "1976"^^xsd:gYear ;
        dct:title "How patterned neural connections can be set up by self-organization" .
    <https://doi.org/10.1186/1471-2202-5-30> dct:date "2004"^^xsd:gYear ;
        dct:title "A stochastic model for retinocollicular map development" .
}


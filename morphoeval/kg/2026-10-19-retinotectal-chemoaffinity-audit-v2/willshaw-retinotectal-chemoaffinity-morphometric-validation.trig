sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-willshaw-retinotectal-chemoaffinity> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Prestige & Willshaw (1975) & Brown et al. (2000) EphA/ephrin-A retinotectal chemoaffinity & synaptic competition — Morphometric validation: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Extracts 6 reference-anchored quantitative measurements via `measure_morphoeval()` (L710-792): wild-type inverted map slope (`-0.9976` vs `-1.0` reference, `r = -1.0000`), homozygous `ki/ki` dual-map separation (`0.5122` vs `0.48` reference), heterozygous `ki/+` branch separation (`0.2785` vs `0.28` reference), Group II half-tectum compression slope (`-0.4947` vs `-0.50` reference), Group II half-retina expansion slope (`-1.9986` vs `-2.00` reference), and specimen radial lamina correlation (`r = 0.9897`, `N = 415` clusters)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-brown-et-al-2000-isl2-epha3-heterozygous-ki-partial-bifurcation-separation-delta-y>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-brown-et-al-2000-isl2-epha3-homozygous-ki-ki-dual-map-rostral-caudal-branch-separation-delta-y>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-danio-rerio-72-hpf-larval-retina-confocal-concentric-lamina-radial-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-prestige-willshaw-1975-group-ii-caudal-half-tectum-compression-slope-dy-comp-dx>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-prestige-willshaw-1975-group-ii-temporal-half-retina-expansion-slope-dy-exp-dx>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-wild-type-retinotectal-inverted-topographic-map-slope-dy-dx-and-anti-diagonal-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-morphometric-validation-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-brown-et-al-2000-isl2-epha3-heterozygous-ki-partial-bifurcation-separation-delta-y> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Brown et al. (2000) Isl2-EphA3 heterozygous ki/+ partial bifurcation separation delta_y = 0.3025 normalized collicular AP fraction" ;
        dct:description "Heterozygous ki/+ separation = 0.3025 (caudal x=0.2 split = 0.321 vs temporal x=0.9 convergence = 0.148)" ;
        schema:measurementTechnique "Mean anteroposterior branch separation E[y_Isl2-(x) - y_Isl2+(x)] in heterozygous ki/+ model (Delta_R = 0.90)" ;
        schema:name "Brown et al. (2000) Isl2-EphA3 heterozygous ki/+ partial bifurcation separation delta_y" ;
        schema:unitText "normalized collicular AP fraction" ;
        schema:value "0.3025" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-brown-et-al-2000-isl2-epha3-heterozygous-ki-partial-bifurcation-separation-delta-y-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-brown-et-al-2000-isl2-epha3-heterozygous-ki-partial-bifurcation-separation-delta-y-reference> a schema:PropertyValue ;
        dct:source "Brown et al. (2000) Cell 102:77-88 Fig. 2 & Fig. 6A (heterozygous map bifurcation with rostral pole convergence)" ;
        schema:value "0.28" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-brown-et-al-2000-isl2-epha3-homozygous-ki-ki-dual-map-rostral-caudal-branch-separation-delta-y> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Brown et al. (2000) Isl2-EphA3 homozygous ki/ki dual-map rostral-caudal branch separation delta_y = 0.5123 normalized collicular AP fraction" ;
        dct:description "Homozygous ki/ki branch separation = 0.5123 (rostral max = 0.483 <= caudal min = 0.516, std = 0.0016)" ;
        schema:measurementTechnique "Mean anteroposterior separation E[y_Isl2-(x) - y_Isl2+(x)] between displaced WT and EphA3+ RGC maps under Group II competition" ;
        schema:name "Brown et al. (2000) Isl2-EphA3 homozygous ki/ki dual-map rostral-caudal branch separation delta_y" ;
        schema:unitText "normalized collicular AP fraction" ;
        schema:value "0.5123" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-brown-et-al-2000-isl2-epha3-homozygous-ki-ki-dual-map-rostral-caudal-branch-separation-delta-y-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-brown-et-al-2000-isl2-epha3-homozygous-ki-ki-dual-map-rostral-caudal-branch-separation-delta-y-reference> a schema:PropertyValue ;
        dct:source "Brown et al. (2000) Cell 102:77-88 Fig. 3 & Fig. 6B (Lean 4 isl2_epha3_knockin_map_bifurcation)" ;
        schema:value "0.48" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-danio-rerio-72-hpf-larval-retina-confocal-concentric-lamina-radial-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Danio rerio 72 hpf larval retina confocal concentric lamina radial correlation r = 0.9897 Pearson r" ;
        dct:description "Radial lamina Pearson r = 0.9897 (RMSE = 0.0534, N = 415 segmented retinal cell clusters across nasal-temporal arc)" ;
        schema:measurementTechnique "Pearson correlation between 60-bin radial fluorescence intensity I(r) on zebrafish_retinotectal_specimen.jpg and bimodal inner/outer retinal lamina shell model" ;
        schema:name "Danio rerio 72 hpf larval retina confocal concentric lamina radial correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9897" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-danio-rerio-72-hpf-larval-retina-confocal-concentric-lamina-radial-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-danio-rerio-72-hpf-larval-retina-confocal-concentric-lamina-radial-correlation-r-reference> a schema:PropertyValue ;
        dct:source "72 hpf Danio rerio larval retina confocal micrograph (Wikimedia Commons File:Concentricity.jpg, CC BY-SA 4.0)" ;
        schema:value "0.98" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-prestige-willshaw-1975-group-ii-caudal-half-tectum-compression-slope-dy-comp-dx> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Prestige & Willshaw (1975) Group II caudal half-tectum compression slope dy_comp*/dx = -0.4947 tectal/retinal slope" ;
        dct:description "Group II compression slope = -0.4947 (r = -0.9998, RMSE = 0.0071) vs Group I nasal pileup slope on x in [0,0.5] = -0.0004" ;
        schema:measurementTechnique "Linear regression slope of full retina x in [0,1] compressed onto rostral half-tectum y in [0, 0.5] under Group II competition" ;
        schema:name "Prestige & Willshaw (1975) Group II caudal half-tectum compression slope dy_comp*/dx" ;
        schema:unitText "tectal/retinal slope" ;
        schema:value "-0.4947" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-prestige-willshaw-1975-group-ii-caudal-half-tectum-compression-slope-dy-comp-dx-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-prestige-willshaw-1975-group-ii-caudal-half-tectum-compression-slope-dy-comp-dx-reference> a schema:PropertyValue ;
        dct:source "Prestige & Willshaw (1975) Proc. R. Soc. B 190:77-98 Figs. 4-6 (Lean 4 prestige_willshaw_group_ii_plasticity)" ;
        schema:value "-0.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-prestige-willshaw-1975-group-ii-temporal-half-retina-expansion-slope-dy-exp-dx> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Prestige & Willshaw (1975) Group II temporal half-retina expansion slope dy_exp*/dx = -1.9986 tectal/retinal slope" ;
        dct:description "Group II half-retina expansion slope = -1.9986 (r = -1.0000, RMSE = 0.0127) vs Ephrin-A2/A5 DKO scrambled control |r| = 0.1072" ;
        schema:measurementTechnique "Linear regression slope of surviving nasal half-retina x in [0, 0.5] expanded across intact tectum y in [0, 1]" ;
        schema:name "Prestige & Willshaw (1975) Group II temporal half-retina expansion slope dy_exp*/dx" ;
        schema:unitText "tectal/retinal slope" ;
        schema:value "-1.9986" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-prestige-willshaw-1975-group-ii-temporal-half-retina-expansion-slope-dy-exp-dx-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-prestige-willshaw-1975-group-ii-temporal-half-retina-expansion-slope-dy-exp-dx-reference> a schema:PropertyValue ;
        dct:source "Prestige & Willshaw (1975) Proc. R. Soc. B 190:77-98 (2x retinotectal expansion of half-retina)" ;
        schema:value "-2.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-wild-type-retinotectal-inverted-topographic-map-slope-dy-dx-and-anti-diagonal-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type retinotectal inverted topographic map slope dy*/dx and anti-diagonal correlation r = -0.9976 tectal/retinal slope" ;
        dct:description "WT slope = -0.9976 (Pearson r = -1.0000, RMSE vs 1-x = 0.0020, reciprocal error = 8.88e-16)" ;
        schema:measurementTechnique "Linear regression slope of center-of-mass termination y_bar(x) from 2D synaptic weight matrix W_ij ODE" ;
        schema:name "Wild-type retinotectal inverted topographic map slope dy*/dx and anti-diagonal correlation r" ;
        schema:unitText "tectal/retinal slope" ;
        schema:value "-0.9976" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-wild-type-retinotectal-inverted-topographic-map-slope-dy-dx-and-anti-diagonal-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-wild-type-retinotectal-inverted-topographic-map-slope-dy-dx-and-anti-diagonal-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Prestige & Willshaw (1975) Proc. R. Soc. B 190:77-98; Brown et al. (2000) Cell 102:77-88 Fig. 1 (Lean 4 retinotectal_chemoaffinity_inversion)" ;
        schema:value "-1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1976-willshaw-retinotectal-chemoaffinity.py L710–L792" ;
        dct:description "6 quantitative MorphoEval measurements with references, RMSE, Pearson r, and Group I/DKO ablation deltas" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1976-willshaw-retinotectal-chemoaffinity.py#L710-L792> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(00)00012-X>,
            <https://doi.org/10.1098/rspb.1975.0087>,
            <https://doi.org/10.1098/rspb.1976.0087>,
            <https://doi.org/10.1186/1471-2202-5-30> .
    <https://doi.org/10.1016/S0092-8674(00)00012-X> dct:date "2000"^^xsd:gYear ;
        dct:title "Topographic mapping from the retina to the midbrain is controlled by relative but not absolute levels of EphA receptor signaling" .
    <https://doi.org/10.1098/rspb.1975.0087> dct:date "1975"^^xsd:gYear ;
        dct:title "On a role for competition in the formation of patterned neural connexions" .
    <https://doi.org/10.1098/rspb.1976.0087> dct:date "1976"^^xsd:gYear ;
        dct:title "How patterned neural connections can be set up by self-organization" .
    <https://doi.org/10.1186/1471-2202-5-30> dct:date "2004"^^xsd:gYear ;
        dct:title "A stochastic model for retinocollicular map development" .
}


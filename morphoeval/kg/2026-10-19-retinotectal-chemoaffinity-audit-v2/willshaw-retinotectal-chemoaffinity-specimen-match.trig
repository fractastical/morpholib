sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-willshaw-retinotectal-chemoaffinity> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Prestige & Willshaw (1975) & Brown et al. (2000) EphA/ephrin-A retinotectal chemoaffinity & synaptic competition — Morphological realism / specimen match: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 4.0 laser scanning confocal micrograph of the 72 hpf Danio rerio larval retina (`zebrafish_retinotectal_specimen.jpg`), automatically segments the retinal cup centroid `(514.3, 513.2)`, inner nuclear ring (`r = 295 px`), outer plexiform/horizontal lamina ring (`r = 392 px`), 60-bin radial fluorescence profile (`r = 0.9897`, `RMSE = 0.0534`), and `N = 415` neural clusters across the nasal-temporal retinal arc (`segment_zebrafish_retina_specimen`, L422-488)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1976-willshaw-retinotectal-chemoaffinity.py L422–L488" ;
        dct:description "Automated CV segmentation of concentric zebrafish retinal laminae and 415 neural clusters" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1976-willshaw-retinotectal-chemoaffinity.py#L422-L488> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/retinotectal_chemoaffinity_comparison.png (generated output)" ;
        dct:description "9-panel dark-mode comparison figure with confocal zebrafish retina CV overlay and radial profile fit — docs/media/retinotectal_chemoaffinity_comparison.png: rendered output of 1976-willshaw-retinotectal-chemoaffinity.py at 317bc3c, image/png, 898070 B, 2227×1863 px, artifact_sha256 c1f0088ab7aec507c657c7913003673aef0829ca8f48a31826824e1aaa0c9a0b (sha256 c1f0088ab7aec507c657c7913003673aef0829ca8f48a31826824e1aaa0c9a0b), spec_fingerprint 291d0b05f4ef97593e7998ed422cf0c6840ddc0d18ee83dd5143a46bbb22b878" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


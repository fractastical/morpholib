sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Dionaea muscipula Turing wavenumber at 24 µm (pass 2) — Morphometric validation: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 0.999999 (reference gate 0.98) and RMSE = 0.00137 (reference 0). The sweep RMSE is 7.47 µm because saturated spots run at 1.25 times the linear wavelength; that bias is reported. Specimen foreground 0.449 vs render 0.445, coherency 0.475 vs 0.474, circularity 0.0167 vs 0.0169, redness KS 0.0083 vs a null of 0. The KS is small because the frame is built on the photograph." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-measurement-dispersion-pearson-r-of-pde-mode-growth-versus-analytic-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-measurement-dispersion-rmse-of-pde-mode-growth>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-measurement-equal-diffusion-ablation-peak-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-measurement-nonlinear-stripe-wavelength-on-the-192-m-patch>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-measurement-predecessor-subcellular-domain-patterns>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-measurement-specimen-lobe-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-measurement-specimen-red-channel-ks-distance-versus-rendered-lobe>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-measurement-specimen-red-lobe-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-measurement-successor-tissue-wavelength-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-measurement-wavelength-sweep-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-measurement-dispersion-pearson-r-of-pde-mode-growth-versus-analytic-sigma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion Pearson r of PDE mode growth versus analytic sigma = 0.9999990938622012 1" ;
        dct:description "goodness-of-fit of the Fourier solver to the Turing dispersion relation" ;
        schema:measurementTechnique "Pearson r of σ_PDE(k) vs σ_analytic(k) for k in [0.11, 0.52] µm^-1" ;
        schema:name "dispersion Pearson r of PDE mode growth versus analytic sigma" ;
        schema:unitText "1" ;
        schema:value "0.9999990938622012" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-measurement-dispersion-pearson-r-of-pde-mode-growth-versus-analytic-sigma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-measurement-dispersion-pearson-r-of-pde-mode-growth-versus-analytic-sigma-reference> a schema:PropertyValue ;

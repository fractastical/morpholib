sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Dionaea muscipula Turing wavenumber at 24 µm (pass 2) — Model fidelity to source: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The script integrates Schnakenberg kinetics and compares pure-mode PDE growth to the Turing eigenvalue. Pearson r is 0.999999 and RMSE is 0.00137. a = 0.10 and b = 0.90 are chosen so the slot wavelength is 24 µm; they are not Dionaea-specific constants from Schnakenberg 1979." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dionaea-muscipula-turing-wavelength-s0.py L134–L158" ;
        dct:description "diffusivities() and sigma_analytic()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d71d2f0b1c64d11b069392db32c90726b8fa5d72/models/2026-delphi10000-dionaea-muscipula-turing-wavelength-s0.py#L134-L158> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dionaea-muscipula-turing-wavelength-s0.py L171–L247" ;
        dct:description "sigma_pde_mode and dispersion_goodness_of_fit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d71d2f0b1c64d11b069392db32c90726b8fa5d72/models/2026-delphi10000-dionaea-muscipula-turing-wavelength-s0.py#L171-L247> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-dionaea-muscipula-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-dionaea-muscipula-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-dionaea-muscipula-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-dionaea-muscipula-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing diffusion margin" ;
    dct:description "Positive margin is required for a Turing band at 24 µm in Dionaea muscipula | Variables: Du, Dv, f_u, g_v at the Schnakenberg steady state (f_u, g_v) = (0.8, -1)" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d71d2f0b1c64d11b069392db32c90726b8fa5d72/models/2026-delphi10000-dionaea-muscipula-turing-wavelength-s0.py#L115-L146>,
        <https://github.com/fractastical/morpholib/blob/d71d2f0b1c64d11b069392db32c90726b8fa5d72/morphoeval/lean/loops/Loop_3169_dionaea_muscipula_turing_wavelength_s0.lean#L15-L21> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "Delta = Dv * f_u + Du * g_v" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.tplants.2017.12.004>,
        <https://doi.org/10.1038/nature03185>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3169.turing_margin" ;
    pk:leanTheorem "MathOfBiology.Loop_3169.patterned_margin_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-dionaea-muscipula-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength" ;
    dct:description "Wavenumber selection for stripes, spots and ocelli | Variables: lambda_c = 24 µm on a 192 µm patch (eight wavelengths); age 0 Ma" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d71d2f0b1c64d11b069392db32c90726b8fa5d72/models/2026-delphi10000-dionaea-muscipula-turing-wavelength-s0.py#L134-L158>,
        <https://github.com/fractastical/morpholib/blob/d71d2f0b1c64d11b069392db32c90726b8fa5d72/morphoeval/lean/loops/Loop_3169_dionaea_muscipula_turing_wavelength_s0.lean#L35-L37> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 2 * pi / k_c,  k_c^2 = (Dv * f_u + Du * g_v) / (2 * Du * Dv)" ;

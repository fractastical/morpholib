sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-odell-apical-constriction-invagination> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Odell, Oster, Alberch & Burnside (1981) / Martin, Kaschube & Wieschaus (2009) stretch-activated apical purse-string constriction and ventral furrow invagination — Parameter expressivity: 61/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Simulates the 5 genetic and mechanical regimes (Wild-Type Twist+Snail, No-Stretch blockade, concertina mutant, snail unratcheted mutant, and twist;snail double mutant) and a 9x9 morphospace grid, but needs finer 2D morphospace resolution and explicit rest-length relaxation convergence diagnostics." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1981-odell-apical-constriction-invagination.py L425–L485: 5-regime perturbation evaluator and 2D morphospace sweep <https://github.com/fractastical/morpholib/blob/317bc3c/1981-odell-apical-constriction-invagination.py#L425-L485>" ;
        pk:hasScore "0.61"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;

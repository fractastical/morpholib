sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-odell-apical-constriction-invagination> a pk:Claim ;
        rdfs:label "Odell, Oster, Alberch & Burnside (1981) / Martin, Kaschube & Wieschaus (2009) stretch-activated apical purse-string constriction and ventral furrow invagination faithfully reproduces Drosophila melanogaster (gastrulating embryo ventral furrow epithelium) morphology" ;
        dcterms:description "The simulation script(s) 1981-odell-apical-constriction-invagination.py implement the cited source model as published and produce forms that match real Drosophila melanogaster (gastrulating embryo ventral furrow epithelium) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 60.3/100, audit 2026-10-19-apical-constriction-invagination-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/317bc3c/1981-odell-apical-constriction-invagination.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/1981-odell-apical-constriction-invagination.py; output: docs/media/apical_constriction_invagination_comparison.png; organism: Drosophila melanogaster (gastrulating embryo ventral furrow epithelium); checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 1acd5f70fee12f0e5be5421486f55d75d590e4eb46eae0e1702c36d088449766; artifact_sha256: d4aa42991370596ee3dc5dca9a95d964c89b7dc01126dd2f99e37be416fb22ee; input_dataset_sha256: {datasets/apical_constriction_invagination/apical_constriction_invagination_reference.json=61b74d9a6124718c..., datasets/apical_constriction_invagination/drosophila_ventral_furrow_specimen.jpg=f426366f7ede436d..., datasets/apical_constriction_invagination/scout_manifest.json=b3959c901e83bdde...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0012-1606(81)90434-6>,
            <https://doi.org/10.1016/j.bpj.2014.07.013>,
            <https://doi.org/10.1016/j.jmbbm.2007.10.002>,
            <https://doi.org/10.1038/nature07522> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-overall>,

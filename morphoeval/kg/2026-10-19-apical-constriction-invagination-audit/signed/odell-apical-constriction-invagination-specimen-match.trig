sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-odell-apical-constriction-invagination> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Odell, Oster, Alberch & Burnside (1981) / Martin, Kaschube & Wieschaus (2009) stretch-activated apical purse-string constriction and ventral furrow invagination — Morphological realism / specimen match: 56/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors `datasets/apical_constriction_invagination/drosophila_ventral_furrow_specimen.jpg` (CC BY 4.0 confocal time-series of Drosophila ventral furrow formation stained for DAPI, Neurotactin, and Myosin II), but Pass 1 linear time-sampling yields only r = 0.7489 against the 4-stage confocal DV compression trajectory because invagination buckling lags initial apical flattening (Stage 1 -> Stage 2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1981-odell-apical-constriction-invagination.py L490–L585: 4-stage confocal specimen segmentation requiring nonlinear buckling-phase alignment <https://github.com/fractastical/morpholib/blob/317bc3c/1981-odell-apical-constriction-invagination.py#L490-L585>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-specimen-match-1> ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/apical_constriction_invagination_comparison.png (generated output)" ;
        dcterms:description "Panel F confocal 4-stage transverse cross-section overlay — docs/media/apical_constriction_invagination_comparison.png: rendered output of 1981-odell-apical-constriction-invagination.py at 317bc3c, image/png, 624986 B, 2408×1428 px, artifact_sha256 d4aa42991370596ee3dc5dca9a95d964c89b7dc01126dd2f99e37be416fb22ee (sha256 d4aa42991370596ee3dc5dca9a95d964c89b7dc01126dd2f99e37be416fb22ee), spec_fingerprint 1acd5f70fee12f0e5be5421486f55d75d590e4eb46eae0e1702c36d088449766" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;

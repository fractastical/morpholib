sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-odell-apical-constriction-invagination> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-code-traceability> .

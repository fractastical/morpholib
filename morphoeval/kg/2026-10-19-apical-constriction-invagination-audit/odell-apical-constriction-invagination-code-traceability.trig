        rdfs:label "Odell, Oster, Alberch & Burnside (1981) / Martin, Kaschube & Wieschaus (2009) stretch-activated apical purse-string constriction and ventral furrow invagination — Code-to-model traceability: 62/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Links functions to Odell et al. (1981) Eqs. 1-4, Martin et al. (2009) Figs. 1-4, and Lean 4 theorems in `morphoeval/lean/loops/Loop_092_apical_constriction_invagination.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-code-traceability-1> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1981-odell-apical-constriction-invagination.py L1–L55" ;
        dct:description "Module docstring mapping equations to Odell et al. (1981) and Martin et al. (2009) and Lean 4 theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1981-odell-apical-constriction-invagination.py#L1-L55> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


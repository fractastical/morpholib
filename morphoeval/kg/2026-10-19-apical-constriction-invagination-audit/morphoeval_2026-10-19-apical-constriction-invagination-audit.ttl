<https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Odell, Oster, Alberch & Burnside (1981) / Martin, Kaschube & Wieschaus (2009) stretch-activated apical purse-string constriction and ventral furrow invagination — Model fidelity to source: 64/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Implements Odell et al.'s (1981) bistable apical rest-length ODE tau_0 dL_0/dt = -(L_0 - L_target) and incompressible cell area conservation A_i = 0.5*(L_ap + L_bas)*h_i = A_0 (L120-265), but Pass 1 lacks an explicit analytical vs numerical convergence check on the single-cell excitable rest-length relaxation L_0(t) = L_2 + (L_1 - L_2) exp(-t/tau_0) and non-linear viscous-buckling delay between apical constriction and tissue invagination depth." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "1981-odell-apical-constriction-invagination.py L230–L415: 64-cell viscoelastic purse-string ring simulator requiring buckling delay coupling <https://github.com/fractastical/morpholib/blob/317bc3c/1981-odell-apical-constriction-invagination.py#L230-L415>" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-model-fidelity-1> ;
    pk:hasScore 6.4e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Odell, Oster, Alberch & Burnside (1981) / Martin, Kaschube & Wieschaus (2009) stretch-activated apical purse-string constriction and ventral furrow invagination — Morphometric validation: 58/100" ;

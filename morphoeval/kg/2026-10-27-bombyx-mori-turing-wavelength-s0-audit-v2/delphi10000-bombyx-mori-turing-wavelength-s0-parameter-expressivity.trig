sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Bombyx mori Turing wavenumber selection at 41 µm (Holocene, 0 Ma) — Parameter expressivity: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Twelve wavelengths and an eight-point Dv sweep. λ(Dv) is monotonic and lengthens as the inhibitor diffuses faster. The Du = Dv panel is the same ocellus multiplied by exp(σ t) with σ = -1.315, so the rings collapse." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-bombyx-mori-turing-wavelength-s0.py L147–L183" ;
        dct:description "dispersion_sweep and Dv factor sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bombyx-mori-turing-wavelength-s0.py#L147-L183> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-bombyx-mori-turing-wavelength-s0.py L379–L389" ;
        dct:description "ablation panel uses exp(σ t)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bombyx-mori-turing-wavelength-s0.py#L379-L389> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


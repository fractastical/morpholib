sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-burak-grid-cell-hexagonal-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Burak & Fiete (2009), Hafting et al. (2005) & Stensola et al. (2012) entorhinal grid-cell hexagonal continuous attractor & discrete sqrt(2) module scaling — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements the 2D FFT Burak & Fiete (2009) 4-subpopulation (E, N, W, S) continuous attractor network with outgoing surround-inhibition kernel shifts W_0(Delta_x - l*e_hat(theta)), resonant 120 deg triad mode selection, and velocity path integration along a 2D foraging trajectory (L78-355), backed by 3 standalone Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_088_grid_cell_hexagonal_attractor.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2008-burak-grid-cell-hexagonal-attractor.py L78–L175" ;
        dcterms:description "Lean 4 triad closure, velocity phase integration, Stensola sqrt(2) invariants, and 2D FFT shifted Mexican-hat kernels" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2008-burak-grid-cell-hexagonal-attractor.py#L78-L175> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2008-burak-grid-cell-hexagonal-attractor.py L235–L355" ;
        dcterms:description "4-subpopulation (E, N, W, S) 2D FFT Burak-Fiete CANN solver and foraging path integration" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2008-burak-grid-cell-hexagonal-attractor.py#L235-L355> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_088_grid_cell_hexagonal_attractor.lean L21–L157" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for resonant triad closure, linear velocity path integration, and Stensola sqrt(2) area doubling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_088_grid_cell_hexagonal_attractor.lean#L21-L157> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


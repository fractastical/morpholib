sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-burak-grid-cell-hexagonal-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Burak & Fiete (2009), Hafting et al. (2005) & Stensola et al. (2012) entorhinal grid-cell hexagonal continuous attractor & discrete sqrt(2) module scaling — Morphological realism / specimen match: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the CC BY-SA 3.0 multi-channel immunofluorescence micrograph of the Rattus norvegicus hippocampal-entorhinal circuit (`rat_entorhinal_hippocampal_specimen.jpg`, 1800x1200 px), automatically segments `N = 902` NeuN+ neuronal somata across the dorsal-to-ventral cortical-hippocampal layers, quantifies MBP+ perforant-path fiber density (`0.2856`), and matches the 50-bin dorso-ventral NeuN+ laminar profile (`r = 0.9822`, `RMSE = 0.0445`, L392-448)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2008-burak-grid-cell-hexagonal-attractor.py L392–L448" ;
        dcterms:description "Automated CV segmentation of 902 NeuN+ neuronal somata and dorso-ventral laminar profile" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2008-burak-grid-cell-hexagonal-attractor.py#L392-L448> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/grid_cell_hexagonal_attractor_comparison.png (generated output)" ;
        dcterms:description "9-panel dark-mode comparison figure with Rattus norvegicus NeuN/MBP CV overlay and laminar profile fit — docs/media/grid_cell_hexagonal_attractor_comparison.png: rendered output of 2008-burak-grid-cell-hexagonal-attractor.py at 317bc3c, image/png, 990359 B, 2227×1863 px, artifact_sha256 9e15f015a1a8af316481cb068cc21589a23e8c95c9287f102d59cfa9d52e96bb (sha256 9e15f015a1a8af316481cb068cc21589a23e8c95c9287f102d59cfa9d52e96bb), spec_fingerprint d708b4028fb6bc24d11a5b20d2c0b94776416b67d14792a0ba60270e21d2be62" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-burak-grid-cell-hexagonal-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Burak & Fiete (2009), Hafting et al. (2005) & Stensola et al. (2012) entorhinal grid-cell hexagonal continuous attractor & discrete sqrt(2) module scaling — Morphometric validation: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Extracts 6 reference-anchored quantitative measurements via `measure_morphoeval()` (L670-748): Dorsal M1 hexagonal gridness (`G_60 = 1.0620` vs `1.18` reference), Stensola 4-module scale ratio (`1.4165` vs `1.4142` reference), 2D foraging path integration correlation (`r_path = 0.9999` vs `0.995` reference), 90 deg square control gridness (`-1.0998` vs `-0.35` reference), medial-septum inactivation pinned-bump arena gridness (`-0.1360` vs `0.0` reference), and rat NeuN+ laminar correlation (`r = 0.9822`, `N = 902` somata)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-brandon-et-al-2011-medial-septum-inactivation-l-0-alpha-0-arena-gridness-collapse-g-60-pinned>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-burak-fiete-2009-4-subpopulation-2d-foraging-velocity-path-integration-correlation-r-path>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-hafting-et-al-2005-burak-fiete-2009-dorsal-module-m1-60-deg-hexagonal-gridness-score-g-60>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-non-resonant-90-deg-square-lattice-control-60-deg-gridness-score-g-60-sq>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-rattus-norvegicus-hippocampal-entorhinal-specimen-neun-dorso-ventral-lamina-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-stensola-et-al-2012-discrete-dorso-ventral-mec-module-scale-ratio-lambda-m-1-lambda-m>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-morphometric-validation-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-brandon-et-al-2011-medial-septum-inactivation-l-0-alpha-0-arena-gridness-collapse-g-60-pinned> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Brandon et al. (2011) medial-septum inactivation (l=0, alpha=0) arena gridness collapse G_60^(pinned) = -0.136 rotational correlation difference" ;
        dcterms:description "Pinned-bump arena G_60 = -0.1360 (decoded phase shift = 0.0 cm, while intrinsic sheet attractor retains G_60 = 0.8472)" ;
        schema:measurementTechnique "60 deg gridness score of single-neuron arena firing map when velocity coupling is abolished (l=0, alpha=0)" ;
        schema:name "Brandon et al. (2011) medial-septum inactivation (l=0, alpha=0) arena gridness collapse G_60^(pinned)" ;
        schema:unitText "rotational correlation difference" ;
        schema:value "-0.136" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-brandon-et-al-2011-medial-septum-inactivation-l-0-alpha-0-arena-gridness-collapse-g-60-pinned-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-brandon-et-al-2011-medial-septum-inactivation-l-0-alpha-0-arena-gridness-collapse-g-60-pinned-reference> a schema:PropertyValue ;
        dcterms:source "Brandon et al. (2011) Science 332:595-599; Burak & Fiete (2009) PLoS Comput. Biol. 5:e1000291" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-burak-fiete-2009-4-subpopulation-2d-foraging-velocity-path-integration-correlation-r-path> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Burak & Fiete (2009) 4-subpopulation 2D foraging velocity path-integration correlation r_path = 0.9999 Pearson r" ;
        dcterms:description "Path-integration correlation r_path = 0.9999 (RMSE = 0.4621 cm vs pinned l=0 ablation r_path = 0.0000)" ;
        schema:measurementTechnique "Pearson correlation between true rat radial displacement ||r(t)-r(0)|| and CANN decoded phase displacement across 120 foraging steps" ;
        schema:name "Burak & Fiete (2009) 4-subpopulation 2D foraging velocity path-integration correlation r_path" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-burak-fiete-2009-4-subpopulation-2d-foraging-velocity-path-integration-correlation-r-path-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-burak-fiete-2009-4-subpopulation-2d-foraging-velocity-path-integration-correlation-r-path-reference> a schema:PropertyValue ;
        dcterms:source "Burak & Fiete (2009) PLoS Comput. Biol. 5:e1000291 Fig. 2 (Lean 4 burak_fiete_velocity_path_integration)" ;
        schema:value "0.995" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-hafting-et-al-2005-burak-fiete-2009-dorsal-module-m1-60-deg-hexagonal-gridness-score-g-60> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hafting et al. (2005) & Burak-Fiete (2009) dorsal Module M1 60 deg hexagonal gridness score G_60 = 1.062 rotational correlation difference" ;
        dcterms:description "M1 hexagonal gridness G_60 = 1.0620 (R(60) = 0.8839, R(90) = -0.4521, neural sheet G_60 = 0.2336)" ;
        schema:measurementTechnique "min(R(60 deg), R(120 deg)) - max(R(30 deg), R(90 deg), R(150 deg)) on 2D spatial autocorrelogram of M1 CANN rate map" ;
        schema:name "Hafting et al. (2005) & Burak-Fiete (2009) dorsal Module M1 60 deg hexagonal gridness score G_60" ;
        schema:unitText "rotational correlation difference" ;
        schema:value "1.062" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-hafting-et-al-2005-burak-fiete-2009-dorsal-module-m1-60-deg-hexagonal-gridness-score-g-60-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-hafting-et-al-2005-burak-fiete-2009-dorsal-module-m1-60-deg-hexagonal-gridness-score-g-60-reference> a schema:PropertyValue ;
        dcterms:source "Hafting et al. (2005) Nature 436:801-806 Fig. 1; Burak & Fiete (2009) PLoS Comput. Biol. 5:e1000291 (Lean 4 hexagonal_resonant_triad_selection)" ;
        schema:value "1.18" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-non-resonant-90-deg-square-lattice-control-60-deg-gridness-score-g-60-sq> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Non-resonant 90 deg square lattice control 60 deg gridness score G_60^(sq) = -1.0998 rotational correlation difference" ;
        dcterms:description "Square control G_60 = -1.0998 < 0 (G_90 = 1.0130 > 0, hexagonal selection advantage Delta_G_60 = 2.1618)" ;
        schema:measurementTechnique "60 deg hexagonal gridness score evaluated on orthogonal 90 deg 2-mode square lattice control lacking k_1+k_2+k_3=0 triad closure" ;
        schema:name "Non-resonant 90 deg square lattice control 60 deg gridness score G_60^(sq)" ;
        schema:unitText "rotational correlation difference" ;
        schema:value "-1.0998" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-non-resonant-90-deg-square-lattice-control-60-deg-gridness-score-g-60-sq-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-non-resonant-90-deg-square-lattice-control-60-deg-gridness-score-g-60-sq-reference> a schema:PropertyValue ;
        dcterms:source "Burak & Fiete (2009) PLoS Comput. Biol. 5:e1000291 (quadratic triad selection of 60 deg hexagonal over 90 deg square planform)" ;
        schema:value "-0.35" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-rattus-norvegicus-hippocampal-entorhinal-specimen-neun-dorso-ventral-lamina-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Rattus norvegicus hippocampal-entorhinal specimen NeuN+ dorso-ventral lamina correlation r = 0.9822 Pearson r" ;
        dcterms:description "Lamina Pearson r = 0.9822 (RMSE = 0.0534, N = 902 segmented NeuN+ somata, MBP+ fiber fraction = 0.2298)" ;
        schema:measurementTechnique "Pearson correlation between 50-bin dorso-ventral NeuN+ fluorescence profile on rat_entorhinal_hippocampal_specimen.jpg and multi-layer cortical-hippocampal lamina model" ;
        schema:name "Rattus norvegicus hippocampal-entorhinal specimen NeuN+ dorso-ventral lamina correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9822" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-rattus-norvegicus-hippocampal-entorhinal-specimen-neun-dorso-ventral-lamina-correlation-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-rattus-norvegicus-hippocampal-entorhinal-specimen-neun-dorso-ventral-lamina-correlation-r-reference> a schema:PropertyValue ;
        dcterms:source "Rattus norvegicus hippocampal-entorhinal immunofluorescence micrograph (Wikimedia Commons, CC BY-SA 3.0)" ;
        schema:value "0.97" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-stensola-et-al-2012-discrete-dorso-ventral-mec-module-scale-ratio-lambda-m-1-lambda-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Stensola et al. (2012) discrete dorso-ventral MEC module scale ratio lambda_{m+1}/lambda_m = 1.4165 dimensionless scale ratio" ;
        dcterms:description "Mean scale ratio = 1.4165 vs sqrt(2) = 1.4142 (mean area ratio lambda_{m+1}^2/lambda_m^2 = 2.0065 vs 2.0, M1..M4 gridness = [1.06, 1.23, 1.39, 1.12])" ;
        schema:measurementTechnique "Mean consecutive module wavelength ratio across M1..M4 {38, 54, 76, 108} cm" ;
        schema:name "Stensola et al. (2012) discrete dorso-ventral MEC module scale ratio lambda_{m+1}/lambda_m" ;
        schema:unitText "dimensionless scale ratio" ;
        schema:value "1.4165" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-stensola-et-al-2012-discrete-dorso-ventral-mec-module-scale-ratio-lambda-m-1-lambda-m-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-stensola-et-al-2012-discrete-dorso-ventral-mec-module-scale-ratio-lambda-m-1-lambda-m-reference> a schema:PropertyValue ;
        dcterms:source "Stensola et al. (2012) Nature 492:72-78 Figs. 1-3 (Lean 4 stensola_discrete_module_area_doubling)" ;
        schema:value "1.4142" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2008-burak-grid-cell-hexagonal-attractor.py L670–L748" ;
        dcterms:description "6 quantitative MorphoEval measurements with references, rotational autocorrelogram G_60, and ablation deltas" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2008-burak-grid-cell-hexagonal-attractor.py#L670-L748> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


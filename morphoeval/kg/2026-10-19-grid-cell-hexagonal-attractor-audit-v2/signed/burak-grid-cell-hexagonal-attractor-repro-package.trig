sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-burak-grid-cell-hexagonal-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Burak & Fiete (2009), Hafting et al. (2005) & Stensola et al. (2012) entorhinal grid-cell hexagonal continuous attractor & discrete sqrt(2) module scaling — Reproducibility package: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Deterministic execution (`seed=2008`), standalone 8-check `--self-test` suite verifying SHA-256 dataset locks, Lean 4 algebraic invariants, all 6 experimental regimes, Rattus norvegicus hippocampal-entorhinal CV segmentation, and bitwise two-run determinism (`atol=0.0`), plus rendered 9-panel PNG and 24-frame GIF in `docs/media/`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-repro-package-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2008-burak-grid-cell-hexagonal-attractor.py L754–L816" ;
        dcterms:description "8-check deterministic --self-test suite verifying SHA-256 locks, Lean 4 invariants, 6 regimes, CV segmentation, and bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2008-burak-grid-cell-hexagonal-attractor.py#L754-L816> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/grid_cell_hexagonal_attractor_growth.gif (generated output)" ;
        dcterms:description "24-frame animated GIF comparing velocity-driven CANN bump translation vs l=0 pinned septal inactivation — docs/media/grid_cell_hexagonal_attractor_growth.gif: rendered output of 2008-burak-grid-cell-hexagonal-attractor.py at 317bc3c, image/gif, 957172 B, 864×378 px, 24 frames, artifact_sha256 2f1d902ce68724f1898e4c0d2387a8bbb33b419d14905ed13e1962c2007c0bf2 (sha256 2f1d902ce68724f1898e4c0d2387a8bbb33b419d14905ed13e1962c2007c0bf2), spec_fingerprint d708b4028fb6bc24d11a5b20d2c0b94776416b67d14792a0ba60270e21d2be62" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


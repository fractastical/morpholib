        <https://w3id.org/probknow/resource/evidence/2026-10-19-grid-cell-hexagonal-attractor-audit-v2-burak-grid-cell-hexagonal-attractor-5>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-grid-cell-hexagonal-attractor-audit-v2-burak-grid-cell-hexagonal-attractor-6> ;
    pk:hypothesisType "2D Toroidal Continuous Attractor Neural Network (CANN) with Velocity-Shifted Asymmetric Surround Inhibition & Quadratic Resonant Triad Selection of 60 deg Hexagonal Planforms" ;

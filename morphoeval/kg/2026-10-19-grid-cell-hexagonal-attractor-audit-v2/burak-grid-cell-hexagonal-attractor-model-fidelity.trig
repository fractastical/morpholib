            <https://doi.org/10.1038/nature11649>,
            <https://doi.org/10.1126/science.1201652>,
            <https://doi.org/10.1371/journal.pcbi.1000291> .
    <https://doi.org/10.1038/nature03721> dct:date "2005"^^xsd:gYear ;
        dct:title "Microstructure of a spatial map in the entorhinal cortex" .
    <https://doi.org/10.1038/nature11649> dct:date "2012"^^xsd:gYear ;
        dct:title "The entorhinal grid map is discretized" .
    <https://doi.org/10.1126/science.1201652> dct:date "2011"^^xsd:gYear ;
        dct:title "Reduction of Theta Rhythm Dissociates Grid Cell Spatial Periodicity from Directional Tuning" .
    <https://doi.org/10.1371/journal.pcbi.1000291> dct:date "2009"^^xsd:gYear ;
        dct:title "Accurate Path Integration in Continuous Attractor Network Models of Grid Cells" .
}


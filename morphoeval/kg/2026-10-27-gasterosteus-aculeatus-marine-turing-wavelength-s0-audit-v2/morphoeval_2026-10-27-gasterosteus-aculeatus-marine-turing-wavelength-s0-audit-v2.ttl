<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing trace-diffusion coefficient" ;
    dct:description "Sign of h opens the Turing band at the 52 µm marine-ancestor scale | Variables: Du=0.5, Dv=20, f_u=0.8, g_v=-1, scaled by 1000 in Lean" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1e3ee6a7276ce724ef7f1d6520314b48f92f2571/models/2026-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/1e3ee6a7276ce724ef7f1d6520314b48f92f2571/morphoeval/lean/loops/Loop_3232_gasterosteus_aculeatus_marine_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "h = D_v f_u + D_u g_v" ;
    prov:wasDerivedFrom <https://doi.org/10.1017/S0094837300011581>,
        <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1107239>,
        <https://doi.org/10.1371/journal.pbio.0020109> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3232.traceDiffusion" ;
    pk:leanTheorem "MathOfBiology.Loop_3232.marine_trace_diffusion_value" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber" ;
    dct:description "Quantitative law for this slot | Variables: nondimensional k_c^2, mapped to 52 µm by L0" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1e3ee6a7276ce724ef7f1d6520314b48f92f2571/models/2026-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/1e3ee6a7276ce724ef7f1d6520314b48f92f2571/morphoeval/lean/loops/Loop_3232_gasterosteus_aculeatus_marine_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = h / (2 D_u D_v) = 0.775 on the marine parameter set" ;
    prov:wasDerivedFrom <https://doi.org/10.1017/S0094837300011581>,
        <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1107239>,
        <https://doi.org/10.1371/journal.pbio.0020109> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3232.traceDiffusion" ;
    pk:leanTheorem "MathOfBiology.Loop_3232.marine_kc_squared_is_775_thousandths" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronospecies wavelength ordering" ;
    dct:description "What changes at this age and scale relative to doryssus_late and aculeatus | Variables: predecessor 104 µm at 9.99 Ma, this node 52 µm at 0.015 Ma, successor 78 µm at 0 Ma" ;
    dct:source "Colosimo 2005 DOI:10.1126/science.1107239" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1e3ee6a7276ce724ef7f1d6520314b48f92f2571/models/2026-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/1e3ee6a7276ce724ef7f1d6520314b48f92f2571/morphoeval/lean/loops/Loop_3232_gasterosteus_aculeatus_marine_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda(N) = 52 µm * sqrt(32/N); 52 < 78 < 104" ;
    prov:wasDerivedFrom <https://doi.org/10.1017/S0094837300011581>,
        <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1107239>,
        <https://doi.org/10.1371/journal.pbio.0020109> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3232.marine_shorter_than_predecessor_and_successor" ;
    pk:leanTheorem "MathOfBiology.Loop_3232.marine_shorter_than_predecessor_and_successor" ;
    pk:leanVerified true .


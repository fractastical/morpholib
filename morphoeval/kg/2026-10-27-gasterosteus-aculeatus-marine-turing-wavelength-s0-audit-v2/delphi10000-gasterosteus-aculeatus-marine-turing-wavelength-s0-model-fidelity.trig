sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg wavelength at 52 µm for the Late Pleistocene marine stickleback (Pass 2 specimen-locked) — Model fidelity to source: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 2 uses the same Schnakenberg integrator and the analytical k_c. The gain is a rendering fit, not a change to the PDE. k_c^2 remains 0.775 and the marine wavelength remains 52 µm." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0.py L81–L100" ;
        dct:description "dispersion() gives k_c^2 = 0.775" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1e3ee6a7276ce724ef7f1d6520314b48f92f2571/models/2026-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0.py#L81-L100> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0.py L109–L140" ;
        dct:description "integrate() is unchanged from Pass 1" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1e3ee6a7276ce724ef7f1d6520314b48f92f2571/models/2026-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0.py#L109-L140> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (single builder-assessor; no second provider on this pass)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


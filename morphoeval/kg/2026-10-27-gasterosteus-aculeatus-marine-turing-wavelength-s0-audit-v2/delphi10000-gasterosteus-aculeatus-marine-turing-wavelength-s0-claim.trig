sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Schnakenberg wavelength at 52 µm for the Late Pleistocene marine stickleback (Pass 2 specimen-locked) faithfully reproduces Gasterosteus aculeatus_marine morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0.py, docs/media/gasterosteus_aculeatus_marine_turing_wavelength_s0_comparison.png implement the cited source model as published and produce forms that match real Gasterosteus aculeatus_marine specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/media/gasterosteus_aculeatus_marine_turing_wavelength_s0_comparison.png>,
            <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0.py, https://github.com/fractastical/morpholib/blob/main/docs/media/gasterosteus_aculeatus_marine_turing_wavelength_s0_comparison.png; output: docs/media/gasterosteus_aculeatus_marine_turing_wavelength_s0_growth.gif; organism: Gasterosteus aculeatus_marine; environment: n/a; claim_boundary: [reported_in_source: Turing (1952) critical wavenumber from the dispersion determinant | Colosimo et al. (2004, 2005) Eda complete-plate versus low-plate morphs | Bell, Baumgartner and Olson (1985) temporal change in G. doryssus armor characters; reconstructed_in_script: Schnakenberg parameters placed so the marine wavelength is 52 µm | λ(N) = 52 µm * sqrt(32/N) for doryssus_late (104 µm) and living aculeatus (78 µm) | Gain 0.0316 chosen as the largest trial with radial Pearson above 0.98 and CV at least 70; transfer_boundary: N_eff = 8 for the predecessor is the Colosimo low-morph analogy, not a Truckee plate count | The 2020 German photograph is an extant anatomical plate, not a 15 ka fossil | A small gain preserves the photograph's spectrum; it does not prove melanophores were measured at 52 µm; does_not_claim: That 52 µm was measured on a fossil melanophore | That N_eff = 8 is a published plate count for G. doryssus_late | That the specimen-locked frame is an independent prediction rather than a fit on one photograph]; phenomenon_size: 32 µm (3.168e-05 m, log10=-4.499 m, tier=4_cellular_10um); species_scale_ladder (10 runs from 32 µm to 9.9 cm): 32 µm:gasterosteus-aculeatus-bioelectric-polarity, 118 µm:gasterosteus-aculeatus-vertex-packing, 2.2 mm:gasterosteus-aculeatus-turing-wavelength, 4.1 mm:gasterosteus-aculeatus-clock-wavefront, 9.6 mm:gasterosteus-aculeatus-elastic-buckling, 1.3 cm:gasterosteus-aculeatus-morphogen-condensation, 1.7 cm:gasterosteus-aculeatus-flux-canalization, 2.2 cm:gasterosteus-aculeatus-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1017/S0094837300011581>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1107239>,
            <https://doi.org/10.1371/journal.pbio.0020109> .
    <https://github.com/fractastical/morpholib/blob/main/docs/media/gasterosteus_aculeatus_marine_turing_wavelength_s0_comparison.png> a schema:SoftwareSourceCode ;
        rdfs:label "docs/media/gasterosteus_aculeatus_marine_turing_wavelength_s0_comparison.png" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1017/S0094837300011581>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1107239>,
            <https://doi.org/10.1371/journal.pbio.0020109> .
    <https://doi.org/10.1017/S0094837300011581> dct:date "1985"^^xsd:gYear ;
        dct:title "Patterns of temporal change in single morphological characters of a Miocene stickleback fish" .
    <https://doi.org/10.1038/376765a0> dct:date "1995"^^xsd:gYear ;
        dct:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .
    <https://doi.org/10.1073/pnas.0808622106> dct:date "2009"^^xsd:gYear ;
        dct:title "Interactions between zebrafish pigment cells responsible for the generation of Turing patterns" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The Chemical Basis of Morphogenesis" .
    <https://doi.org/10.1126/science.1107239> dct:date "2005"^^xsd:gYear ;
        dct:title "Widespread Parallel Evolution in Sticklebacks by Repeated Fixation of Ectodysplasin Alleles" .
    <https://doi.org/10.1371/journal.pbio.0020109> dct:date "2004"^^xsd:gYear ;
        dct:title "The Genetic Architecture of Parallel Armor Plate Reduction in Threespine Sticklebacks" .
}


}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1073/pnas.1315416111>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.11646/zootaxa.2164.1.4>,
            <https://doi.org/10.1371/journal.pgen.1007538>,
            <https://doi.org/10.7554/eLife.05635> .
    <https://doi.org/10.1073/pnas.0808622106> dct:date "2009"^^xsd:gYear ;
        dct:title "Interactions between zebrafish pigment cells responsible for the generation of Turing patterns" .
    <https://doi.org/10.1073/pnas.1315416111> dct:date "2014"^^xsd:gYear ;
        dct:title "In vitro analysis suggests that difference in cell movement during direct interaction can generate various pigment patterns in vivo" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.11646/zootaxa.2164.1.4> dct:date "2009"^^xsd:gYear ;
        dct:title "Danio aesculapii, a new species of danio from south-western Myanmar (Teleostei: Cyprinidae)" .
    <https://doi.org/10.1371/journal.pgen.1007538> dct:date "2018"^^xsd:gYear ;
        dct:title "Evolution of endothelin signaling and diversification of adult pigment pattern in Danio fishes" .
    <https://doi.org/10.7554/eLife.05635> dct:date "2015"^^xsd:gYear ;
        dct:title "Advancing biology through a deeper understanding of zebrafish ecology and evolution" .
}


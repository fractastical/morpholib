sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Danio aesculapii cellular Turing wavenumber at 21 µm (Holocene, 0 Ma) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Body circularity 0.262 versus a circle at 1, aspect 4.18 versus 1, luminance CV versus a flat field at 0, KS statistic 0.147 between render and specimen, stripe spacing 16 px versus the 20.8 µm anchor (different units, so not a self-comparison), and Pearson r > 0.999 versus a null of 0. A second CC BY plate is segmented separately. n=2 images." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-cellular-stripe-spacing>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-formula-k-c-minus-argmax-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-linear-regime-pearson-r-of-critical-mode>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-parichy-2015-plate-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-specimen-body-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-specimen-flank-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-specimen-image-luminance-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-successor-control-sigma-at-k-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-cellular-stripe-spacing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cellular stripe spacing = 16.0 px" ;
        dct:description "spacing CV = 0.0000; RMSE of log-amplitude vs σ(k_c)t = 0.0248" ;
        schema:measurementTechnique "peak spacing of the dorsal activator transect; 1 px = 1.30 µm so 16 px = 20.8 µm" ;
        schema:name "cellular stripe spacing" ;
        schema:unitText "px" ;
        schema:value "16.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-cellular-stripe-spacing-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-cellular-stripe-spacing-reference> a schema:PropertyValue ;
        dct:source "pinned λ_c = 2.08e-05 m expressed in micrometres, not in pixels" ;
        schema:value "20.8" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-formula-k-c-minus-argmax-sigma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "formula k_c minus argmax sigma = 0.0785 rad/px" ;
        dct:description "argmax σ at k=0.3142; formula k_c=0.3927; σ_max=0.2435" ;
        schema:measurementTechnique "argmax_k σ(k) minus the classical k_c = sqrt((D_v f_u + D_u g_v)/(2 D_u D_v))" ;
        schema:name "formula k_c minus argmax sigma" ;
        schema:unitText "rad/px" ;
        schema:value "0.0785" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-formula-k-c-minus-argmax-sigma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-formula-k-c-minus-argmax-sigma-reference> a schema:PropertyValue ;
        dct:source "zero only if the growth-rate peak sits on the classical formula; it does not at these kinetics" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-linear-regime-pearson-r-of-critical-mode> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "linear-regime Pearson r of critical mode = 1.0 Pearson r" ;
        dct:description "fitted slope 0.2176 vs analytical σ(k_c)=0.2037; n=155" ;
        schema:measurementTechnique "corr(log |û(k_c)|, t) on the window before nonlinear saturation" ;
        schema:name "linear-regime Pearson r of critical mode" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-linear-regime-pearson-r-of-critical-mode-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-linear-regime-pearson-r-of-critical-mode-reference> a schema:PropertyValue ;
        dct:source "null of an uncorrelated mode; the measured r is the linear-regime fit, not this null" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-parichy-2015-plate-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Parichy 2015 plate circularity = 0.6622 4πA/P^2" ;
        dct:description "Parichy plate aspect 2.362" ;
        schema:measurementTechnique "second CC BY plate (eLife 2015.05635) segmented independently of the primary photograph" ;
        schema:name "Parichy 2015 plate circularity" ;
        schema:unitText "4πA/P^2" ;
        schema:value "0.6622" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-parichy-2015-plate-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-parichy-2015-plate-circularity-reference> a schema:PropertyValue ;
        dct:source "primary Andrewbogott specimen circularity; the two images are different crops" ;
        schema:value "0.2618" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-specimen-body-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen body circularity = 0.2618 4πA/P^2" ;
        dct:description "aspect ratio 4.182 (reference 1); foreground fraction 0.374" ;
        schema:measurementTechnique "largest bright component on the CC BY-SA specimen photograph; morphological perimeter" ;
        schema:name "specimen body circularity" ;
        schema:unitText "4πA/P^2" ;
        schema:value "0.2618" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-specimen-body-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-specimen-body-circularity-reference> a schema:PropertyValue ;
        dct:source "circle reference; a lateral danionin is not a circle" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-specimen-flank-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen flank aspect ratio = 4.1824 width/height" ;
        schema:measurementTechnique "bounding box of the segmented D. aesculapii body" ;
        schema:name "specimen flank aspect ratio" ;
        schema:unitText "width/height" ;
        schema:value "4.1824" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-specimen-flank-aspect-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-specimen-flank-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "isometric reference rejected by the elongate body" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-specimen-image-luminance-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image luminance CV = 0.3562 std/mean" ;
        dct:description "KS statistic render vs specimen luminance = 0.1474" ;
        schema:measurementTechnique "coefficient of variation of luminance inside the body mask" ;
        schema:name "specimen image luminance CV" ;
        schema:unitText "std/mean" ;
        schema:value "0.3562" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-specimen-image-luminance-cv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-specimen-image-luminance-cv-reference> a schema:PropertyValue ;
        dct:source "flat-field reference; pigment and iridophores are not uniform" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-successor-control-sigma-at-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "successor control sigma at k_c = -0.6401 1/time" ;
        dct:description "equal-diffusion control σ=-0.6048; sweep σ(k_c)=[-0.18417975347897686, -0.0009615607169632945, 0.11692151885858504, 0.20366366489600285, 0.26302269445588955]" ;
        schema:measurementTechnique "D. albolineatus inhibitor collapse R=1.20 at the same Du, evaluated at aesculapii k_c" ;
        schema:name "successor control sigma at k_c" ;
        schema:unitText "1/time" ;
        schema:value "-0.6401" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-successor-control-sigma-at-k-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-measurement-successor-control-sigma-at-k-c-reference> a schema:PropertyValue ;
        dct:source "D. aesculapii σ(k_c) at R=28; the successor must lie below it and below zero" ;
        schema:value "0.2037" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-danio-aesculapii-turing-wavelength-s0.py L333–L381" ;
        dct:description "silhouette segmentation, circularity, aspect, luminance CV" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/cfb8887378258c806d4412f6b1faac9a96299054/models/2026-delphi10000-danio-aesculapii-turing-wavelength-s0.py#L333-L381> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-danio-aesculapii-turing-wavelength-s0.py L622–L701" ;
        dct:description "measure_morphoeval records value and an independent reference" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/cfb8887378258c806d4412f6b1faac9a96299054/models/2026-delphi10000-danio-aesculapii-turing-wavelength-s0.py#L622-L701> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-danio-aesculapii-turing-wavelength-s0.py L242–L284" ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-feugier-carrier-driven-canalization> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Feugier, Mochizuki & Iwasa (2005) PIN1 efflux carrier canalization on a Lockhart (1965)-growing hexagonal leaf blade with Scarpella et al. (2004/2006) procambial commitment: sequential 1°→4° vein-order emergence, open trees vs closed areoles vs decelerating no-branching — Code-to-model traceability: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring (L1-79) maps Laws 1-6 to Feugier Eqs. 1-6, Scarpella (2004/2006), Lockhart (1965) Eq. 1 and six named Lean 4 theorems with line-pinned loci; `simulate_growing_blade_canalization` and `simulate_hexagonal_venation_models` docstrings state what is emergent and what is templated; `morphoeval/math_kg_loops/feugier-carrier-driven-canalization.yaml` registers 6 equations with lean_decl / lean_theorem / lean_locus / code_locus. Minor debit: Law 2's docstring text still describes the saturating case as \"Model B / Scarpella (2006)\" (L47-50) with the correction carried in the header rather than rewritten in place." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-code-traceability-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py L1–L79" ;
        dct:description "Module docstring: corrections of record and Laws 1-6 with equation, source and Lean theorem/locus traceability" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2005-feugier-carrier-driven-canalization.py#L1-L79> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/feugier-carrier-driven-canalization.yaml L1–L163" ;
        dct:description "Math KG registration of 6 equations (3 new) with corrected citations and current code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/feugier-carrier-driven-canalization.yaml#L1-L163> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py L421–L447" ;
        dct:description "simulate_hexagonal_venation_models docstring explicitly labels the Pass 2 lattice as a templated scaffold" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2005-feugier-carrier-driven-canalization.py#L421-L447> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 035 Pass 3 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


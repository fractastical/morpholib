sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-feugier-carrier-driven-canalization> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Feugier, Mochizuki & Iwasa (2005) PIN1 efflux carrier canalization on a Lockhart (1965)-growing hexagonal leaf blade with Scarpella et al. (2004/2006) procambial commitment: sequential 1°→4° vein-order emergence, open trees vs closed areoles vs decelerating no-branching — Morphological realism / specimen match: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The SHA-256-locked CC BY-SA 4.0 cleared dicot leaf tip specimen is still segmented (`segment_leaf_venation_specimen`, L1105-1180: vein density 0.3585, Betti-1 = 205, compactness 0.7749 +- 0.0191 SE) and shown in Panels E-F of the comparison figure. The new growing-blade output is compared to the specimen only at the level of topological class (reticulate vs open); no stage-resolved cleared-leaf series (Scarpella 2004 Fig. 1 / Kang & Dengler 2004) is vendored, so the sequential-emergence claim is validated against literature stage descriptions and an internally authored expectation file rather than specimen images." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/carrier_driven_canalization/growing_blade_reference.json L1–L116: Stage days and expected outcomes are literature-derived but internally authored; no digitised stage-resolved areole counts or specimen images for 2-7 DAG <https://github.com/fractastical/morpholib/blob/d58a084/datasets/carrier_driven_canalization/growing_blade_reference.json#L1-L116>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-specimen-match-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py L1105–L1180" ;
        dct:description "Ridge + chromatic warmth segmentation of the cleared dicot leaf tip venation specimen: 205 closed areoles, density 0.3585, compactness 0.7749" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2005-feugier-carrier-driven-canalization.py#L1105-L1180> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/carrier_driven_canalization_comparison.png (generated output)" ;
        dct:description "6-panel figure; Panels E-F show the specimen crop and its CV segmentation (205 areoles) beside the simulated panels — docs/media/carrier_driven_canalization_comparison.png: rendered output of 2005-feugier-carrier-driven-canalization.py at d58a084, image/png, 1263498 B, 2310×1428 px, artifact_sha256 74b39f5757cc4cb7020ab8f336cc4b70b0c34685f5c9d809bf4214e79583dd22 (sha256 74b39f5757cc4cb7020ab8f336cc4b70b0c34685f5c9d809bf4214e79583dd22), spec_fingerprint d5956a07207a9a97703c7b3ba0b06fe87ba07192a5b48400bfa9427bfa87a2c3" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/carrier_driven_canalization_growth_stages.png (generated output)" ;
        dct:description "3 regimes x 4 growth stages (2.0, 3.5, 5.0, 7.0 DAG) with vein-order colouring, Lockhart curve, per-stage beta_1 and tau_commit sweep — docs/media/carrier_driven_canalization_growth_stages.png: rendered output of 2005-feugier-carrier-driven-canalization.py at d58a084, image/png, 1016848 B, 2535×1638 px, artifact_sha256 30dc26b646a5d28ec50d987b702dd27aebb915d0d9b9c2b7ca086f54f3d16e85 (sha256 30dc26b646a5d28ec50d987b702dd27aebb915d0d9b9c2b7ca086f54f3d16e85), spec_fingerprint d5956a07207a9a97703c7b3ba0b06fe87ba07192a5b48400bfa9427bfa87a2c3" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 035 Pass 3 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-feugier-carrier-driven-canalization> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-allocation-regime-sweep-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "allocation_regime_sweep_pearson_r = 0.9999 r" ;
        schema:measurementTechnique "Pearson correlation across 6 PIN1 carrier allocation regimes vs reference benchmarks (RMSE <= 0.015)" ;
        schema:name "allocation_regime_sweep_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-allocation-regime-sweep-pearson-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-allocation-regime-sweep-pearson-r-reference> a schema:PropertyValue ;
        dcterms:source "carrier_driven_canalization_reference.json 6-regime single-cell allocation table (Pass 2 benchmarks; Feugier et al. 2005 result 2 motivates the accelerating/decelerating split)" ;
        schema:value "0.999" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-commitment-delay-betti1-spearman-rho> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "commitment_delay_betti1_spearman_rho = -1.0 rho" ;
        schema:measurementTechnique "Spearman rank correlation between tau_commit in {0.5, 1, 2, 4, 8} and the final emergent Betti-1 on the growing blade" ;
        schema:name "commitment_delay_betti1_spearman_rho" ;
        schema:unitText "rho" ;
        schema:value "-1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-commitment-delay-betti1-spearman-rho-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-commitment-delay-betti1-spearman-rho-reference> a schema:PropertyValue ;
        dcterms:source "Law 6 monotonicity prediction (longer sustained-flux requirement -> fewer locked transient bipolar cells -> fewer closed areoles); Scarpella et al. (2004) interrupted-extension phenotype (fewer orders, more free endings)" ;
        schema:value "-1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-growing-blade-committed-reticulate-betti1-final> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growing_blade_committed_reticulate_betti1_final = 4 loops" ;
        schema:measurementTechnique "Emergent strand graph beta_1 at 7 DAG with the Law 6 irreversible commitment lock (P >= P_commit sustained for tau_commit) active from stage 2" ;
        schema:name "growing_blade_committed_reticulate_betti1_final" ;
        schema:unitText "loops" ;
        schema:value "4" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-growing-blade-committed-reticulate-betti1-final-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-growing-blade-committed-reticulate-betti1-final-reference> a schema:PropertyValue ;
        dcterms:source "Scarpella, Francis & Berleth (2004) Development 131:3445-3455 (fusion of freely ending preprocambial domains) & Scarpella et al. (2006) bipolar convergence-point cells; reference is a lower bound (>= 1), not a specimen count" ;
        schema:value "1" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-growing-blade-decelerating-vein-cell-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growing_blade_decelerating_vein_cell_fraction = 0.8575 fraction" ;
        schema:measurementTechnique "Fraction of blade cells with max membrane PIN1 >= P_vein at 7 DAG under saturating Phi = J^2/(1 + (J/K)^2); contrasted with the discrete open-tree fraction" ;
        schema:name "growing_blade_decelerating_vein_cell_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.8575" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-growing-blade-decelerating-vein-cell-fraction-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-growing-blade-decelerating-vein-cell-fraction-reference> a schema:PropertyValue ;
        dcterms:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:366-375 result 2 (linear or decelerating response -> no branching pattern; diffuse polarization)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-growing-blade-open-tree-betti1-final> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growing_blade_open_tree_betti1_final = 0 loops" ;
        schema:measurementTechnique "Emergent (untemplated) strand graph cycle rank beta_1 = E - V + C at 7 DAG on the growing hexagonal blade without commitment memory" ;
        schema:name "growing_blade_open_tree_betti1_final" ;
        schema:unitText "loops" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-growing-blade-open-tree-betti1-final-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-growing-blade-open-tree-betti1-final-reference> a schema:PropertyValue ;
        dcterms:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:366-375 result 1 (accelerating Phi = J^2, conserved pool -> branching patterns)" ;
        schema:value "0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-growing-blade-sequential-vein-orders-emerged> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growing_blade_sequential_vein_orders_emerged = 4 vein_orders" ;
        schema:measurementTechnique "Number of developmental stages (Lockhart-grown blade, 2.0/3.5/5.0/7.0 DAG) at which new cells first exceed P_vein; emergent Feugier Eqs. 1-6 with convergence points added as the margin advances" ;
        schema:name "growing_blade_sequential_vein_orders_emerged" ;
        schema:unitText "vein_orders" ;
        schema:value "4" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-growing-blade-sequential-vein-orders-emerged-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-growing-blade-sequential-vein-orders-emerged-reference> a schema:PropertyValue ;
        dcterms:source "Scarpella, Francis & Berleth (2004) Development 131:3445-3455; Kang & Dengler (2004) Int. J. Plant Sci. 165:231-242 (midvein -> secondary -> tertiary -> quaternary during blade expansion)" ;
        schema:value "4" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-hexagonal-pin1-pool-conservation-error> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "hexagonal_pin1_pool_conservation_error = 0.0 carrier_units" ;
        schema:measurementTechnique "Max absolute intracellular + 6-face membrane PIN1 conservation error across hexagonal leaf lamina lattice (Law 1)" ;
        schema:name "hexagonal_pin1_pool_conservation_error" ;
        schema:unitText "carrier_units" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-hexagonal-pin1-pool-conservation-error-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-hexagonal-pin1-pool-conservation-error-reference> a schema:PropertyValue ;
        dcterms:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:366-375 Eqs. 4-6 (P_{i,cyt} + sum_{j=1}^6 P_{ij} = P_total)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-lockhart-blade-area-fold-change-2-to-7-dag> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "lockhart_blade_area_fold_change_2_to_7_dag = 2.399 fold" ;
        schema:measurementTechnique "Explicit-Euler integration (dt = 1e-3 day) of (1/A) dA/dt = phi max(0, P - Y0 - kappa t) vs the closed form (Law 4)" ;
        schema:name "lockhart_blade_area_fold_change_2_to_7_dag" ;
        schema:unitText "fold" ;
        schema:value "2.399" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-lockhart-blade-area-fold-change-2-to-7-dag-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-lockhart-blade-area-fold-change-2-to-7-dag-reference> a schema:PropertyValue ;
        dcterms:source "Lockhart (1965) J. Theor. Biol. 8:264-275 Eq. 1 closed form with the vendored parameters (growing_blade_reference.json); Scarpella et al. (2004) stage chronology 2-7 DAG" ;
        schema:value "2.3989" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-a-open-tree-betti1-loops> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "model_a_open_tree_betti1_loops = 0 loops" ;
        schema:measurementTechnique "Hexagonal venation graph cycle rank beta_1 = E - V + C on the templated open-tree scaffold (0 loops)" ;
        schema:name "model_a_open_tree_betti1_loops" ;
        schema:unitText "loops" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-a-open-tree-betti1-loops-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-a-open-tree-betti1-loops-reference> a schema:PropertyValue ;
        dcterms:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:366-375 result 1 (branching patterns, no loops) — templated tree scaffold readout" ;
        schema:value "0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-a-quadratic-dominant-face-share> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "model_a_quadratic_dominant_face_share = 0.9978 fraction" ;
        schema:measurementTechnique "6-face PIN1 competition under conserved quadratic feedback p=2.0 (Law 2, winner-take-all share = 0.9978 ± 0.0010, p=3.0e-8)" ;
        schema:name "model_a_quadratic_dominant_face_share" ;
        schema:unitText "fraction" ;
        schema:value "0.9978" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-a-quadratic-dominant-face-share-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-a-quadratic-dominant-face-share-reference> a schema:PropertyValue ;
        dcterms:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:366-375 results 2-3 (accelerating response Phi(J)=J^2 with membrane domains competing for a limited carrier pool -> single-face polarization); reference share from carrier_driven_canalization_reference.json" ;
        schema:value "0.996" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-b-closed-reticulate-betti1-loops> a schema:PropertyValue,

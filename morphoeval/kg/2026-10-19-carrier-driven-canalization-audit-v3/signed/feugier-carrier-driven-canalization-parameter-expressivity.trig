sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-feugier-carrier-driven-canalization> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py L1078–L1103" ;
        dcterms:description "tau_commit sweep with Spearman rank correlation against final beta_1" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2005-feugier-carrier-driven-canalization.py#L1078-L1103> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py L1905–L1954" ;
        dcterms:description "CLI: --growing-blade regime runner, --tau-commit, --sigma-convergence, --k-saturation, --print-measurements plus Pass 2 flags" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2005-feugier-carrier-driven-canalization.py#L1905-L1954> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py L703–L735" ;
        dcterms:description "LOCKHART_PARAMS and GROWING_BLADE_PARAMS dicts (mu, D, k1, k2, P_total, K_saturation, P_vein, P_commit, tau_commit, stage schedule)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2005-feugier-carrier-driven-canalization.py#L703-L735> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Feugier, Mochizuki & Iwasa (2005) PIN1 efflux carrier canalization on a Lockhart (1965)-growing hexagonal leaf blade with Scarpella et al. (2004/2006) procambial commitment: sequential 1°→4° vein-order emergence, open trees vs closed areoles vs decelerating no-branching — Parameter expressivity: 94/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Four growing-blade regimes (`accelerating_open_tree`, `accelerating_committed_reticulate`, `decelerating_no_branching`, `exocytosis_ablation`) share one solver with an overridable parameter dict (`GROWING_BLADE_PARAMS`, L715-735); `sweep_commitment_delay` (L1078-1103) sweeps tau_commit over {0.5, 1, 2, 4, 8} and reports Spearman rho = -1.0; the CLI adds `--growing-blade`, `--tau-commit`, `--sigma-convergence`, `--k-saturation`, `--print-measurements` (L1905-1954) beside the Pass 2 scaffold flags; the Pass 2 6-regime allocation sweep (L160-279) is retained. Lockhart parameters (phi, P, Y_0, kappa) are exposed as a dict but not on the CLI." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-parameter-expressivity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 035 Pass 3 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-feugier-carrier-driven-canalization> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py L1796–L1903" ;
        dcterms:description "15-check deterministic self-test suite (passes in ~27 s)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2005-feugier-carrier-driven-canalization.py#L1796-L1903> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py L1628–L1794" ;
        dcterms:description "render_outputs(): comparison PNG, growth-stages PNG, 16-frame growing-blade GIF, returns 15 measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2005-feugier-carrier-driven-canalization.py#L1628-L1794> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Feugier, Mochizuki & Iwasa (2005) PIN1 efflux carrier canalization on a Lockhart (1965)-growing hexagonal leaf blade with Scarpella et al. (2004/2006) procambial commitment: sequential 1°→4° vein-order emergence, open trees vs closed areoles vs decelerating no-branching — Reproducibility package: 94/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "15-check `run_self_test()` (L1796-1903, ~27 s) verifies SHA-256 integrity of 5 files, parameter agreement with the vendored JSON, the corrected citation string, Laws 1-3, the Lockhart closed form vs Euler integration and arrest, growing-blade pool/antisymmetry residuals, monotone cell birth, 4/4 sequential orders, open-tree beta_1 = 0 at all stages with one component, committed beta_1 >= 1 with locked bipolar cells and none at stage 1, decelerating fraction >= 0.85 and > 2x open tree, k_1 = 0 ablation, monotone tau_commit sweep (rho <= -0.9), and 15 deterministic measurements across two calls. Default render regenerates both PNGs and the 16-frame GIF in ~21 s. Debit: wall-clock and determinism depend on the seeded RNG for newborn-cell carrier noise (seed 2005) and no cross-platform tolerance is stated for the committed beta_1 = 4." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-repro-package-2> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 035 Pass 3 Assessor)" ;

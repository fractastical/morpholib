sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-feugier-carrier-driven-canalization> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Feugier, Mochizuki & Iwasa (2005) PIN1 efflux carrier canalization on a Lockhart (1965)-growing hexagonal leaf blade with Scarpella et al. (2004/2006) procambial commitment: sequential 1°→4° vein-order emergence, open trees vs closed areoles vs decelerating no-branching — Source and data traceability: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`datasets/carrier_driven_canalization/` now vendors 8 BibTeX entries with DOIs/PMIDs (`paper_citations.bib`, L1-90), a corrected reference JSON, the new `growing_blade_reference.json` with a bibliographic-correction record and six primary sources, and the specimen; all 5 files are SHA-256-verified at runtime (`verify_dataset_integrity`, L117-143). The corrected Feugier record (236(4):366-375, PMID 15899502) is cross-checked in the self-test. Debit: the v1/v2 record carried a wrong volume/issue/pages and a result attribution the paper does not make, both of which v2 scored 95 — the correction is credited here, the two-pass miss is not forgiven in full." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-source-traceability-4> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py L117–L143" ;
        dcterms:description "Runtime SHA-256 verification of all 5 dataset files (specimen, reference JSON, scout manifest, BibTeX, growing-blade reference)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2005-feugier-carrier-driven-canalization.py#L117-L143> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/carrier_driven_canalization/paper_citations.bib L1–L90" ;
        dcterms:description "8 BibTeX entries incl. corrected feugier2005 (number 4, pages 366-375, pmid 15899502) and new scarpella2004, kang2004, lockhart1965, kuchen2012" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/carrier_driven_canalization/paper_citations.bib#L1-L90> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/carrier_driven_canalization/growing_blade_reference.json L1–L116" ;
        dcterms:description "Bibliographic correction record, 6 primary sources, Lockhart parameters, canalization parameters, expected outcomes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/carrier_driven_canalization/growing_blade_reference.json#L1-L116> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/carrier_driven_canalization/README.md L1–L28" ;
        dcterms:description "Pass 3 correction section and file list with SHA-256 digests" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/carrier_driven_canalization/README.md#L1-L28> .


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-vascular-cube-law-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1926a, 1926b), Zamir (1976) & Sherman (1981) minimum-work vascular cube law & arterial branching angles — Morphometric validation: 89/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` reports 8 quantitative morphometrics with reference values, uncertainty/dispersion statistics (RMSE, Pearson r, p-value, SD, CV), and negative-control ablation deltas (L891-985): empirical human retinal junctions J01-J08 achieve total-angle RMSE = 0.134 deg and branch-angle Pearson r = 0.9999 (p = 2.4e-26), cube-law conservation ratio (r_1^3+r_2^3)^(1/3)/r_0 = 0.9956 ± 0.0033 (CV = 0.0033) vs Da Vinci gamma=2 control 1.1091 (+11.4% bias and +134.8% excess tree power), and segmented fundus Y-junction angle mean = 79.28 deg (N = 19)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-da-vinci-area-preserving-control-gamma-2-excess-vascular-tree-power-penalty>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-empirical-human-retinal-bifurcation-angle-rmse-murray-prediction-vs-j01-j08>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-empirical-retinal-cube-law-conservation-ratio-r-1-3-r-2-3-1-3-r-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-generational-wall-shear-stress-tau-w-across-7-sherman-1981-arteriole-levels>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-metabolic-to-viscous-power-ratio-at-optimal-radius-p-met-r-p-visc-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-segmented-retinal-fundus-specimen-y-junction-bifurcation-angle-mean>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-symmetric-daughter-radius-ratio-r-1-r-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-symmetric-total-bifurcation-angle-theta-1-theta-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-morphometric-validation-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-da-vinci-area-preserving-control-gamma-2-excess-vascular-tree-power-penalty> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Da Vinci area-preserving control (gamma=2) excess vascular tree power penalty = 134.796 %" ;
        dct:description "numerical minimum found at gamma* = 3.000; wall shear CV at gamma=3 is 2.95e-16 vs +100% drift at gamma=2" ;
        schema:measurementTechnique "100 * (P_tree(gamma=2.0) - P_tree(gamma=3.0)) / P_tree(gamma=3.0) across 7-generation arterial tree" ;
        schema:name "Da Vinci area-preserving control (gamma=2) excess vascular tree power penalty" ;
        schema:unitText "%" ;
        schema:value "134.796" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-da-vinci-area-preserving-control-gamma-2-excess-vascular-tree-power-penalty-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-da-vinci-area-preserving-control-gamma-2-excess-vascular-tree-power-penalty-reference> a schema:PropertyValue ;
        dct:source "Murray (1926a) PNAS 12:207-214; Sherman (1981) J. Gen. Physiol. 78:431" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-empirical-human-retinal-bifurcation-angle-rmse-murray-prediction-vs-j01-j08> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "empirical human retinal bifurcation angle RMSE (Murray prediction vs J01-J08) = 0.1342 deg" ;
        dct:description "branch angle Pearson r = 1.0000 (p=6.18e-30), branch RMSE = 0.119 deg" ;
        schema:measurementTechnique "RMSE and Pearson r across N=8 asymmetric human retinal arterial junctions (alpha in 0.56..0.99)" ;
        schema:name "empirical human retinal bifurcation angle RMSE (Murray prediction vs J01-J08)" ;
        schema:unitText "deg" ;
        schema:value "0.1342" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-empirical-human-retinal-bifurcation-angle-rmse-murray-prediction-vs-j01-j08-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-empirical-human-retinal-bifurcation-angle-rmse-murray-prediction-vs-j01-j08-reference> a schema:PropertyValue ;
        dct:source "Zamir, Medeiros & Cunningham (1979) Invest. Ophthalmol. Vis. Sci. 18:659; Murray (1926b)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-empirical-retinal-cube-law-conservation-ratio-r-1-3-r-2-3-1-3-r-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "empirical retinal cube-law conservation ratio (r_1^3 + r_2^3)^(1/3) / r_0 = 0.9956 ratio" ;
        dct:description "std = 0.0034, CV = 0.0034; Da Vinci gamma=2 control gives 1.1088 (+11.7% bias)" ;
        schema:measurementTechnique "mean ± SD (CV) of (r_1^3 + r_2^3)^(1/3) / r_0 vs Da Vinci square-law ablation control (r_1^2 + r_2^2)^(1/2) / r_0" ;
        schema:name "empirical retinal cube-law conservation ratio (r_1^3 + r_2^3)^(1/3) / r_0" ;
        schema:unitText "ratio" ;
        schema:value "0.9956" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-empirical-retinal-cube-law-conservation-ratio-r-1-3-r-2-3-1-3-r-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-empirical-retinal-cube-law-conservation-ratio-r-1-3-r-2-3-1-3-r-0-reference> a schema:PropertyValue ;
        dct:source "Murray (1926a) PNAS 12:207-214; Sherman (1981) J. Gen. Physiol. 78:431" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-generational-wall-shear-stress-tau-w-across-7-sherman-1981-arteriole-levels> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "generational wall shear stress tau_w across 7 Sherman (1981) arteriole levels = 8.2189 dyn/cm^2" ;
        dct:description "generational shear CV = 2.95e-16 (exact scale invariance)" ;
        schema:measurementTechnique "tau_w = 4*eta*Q_g / (pi*r_g^3) = sqrt(eta*b) across generations g=0..6" ;
        schema:name "generational wall shear stress tau_w across 7 Sherman (1981) arteriole levels" ;
        schema:unitText "dyn/cm^2" ;
        schema:value "8.2189" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-generational-wall-shear-stress-tau-w-across-7-sherman-1981-arteriole-levels-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-generational-wall-shear-stress-tau-w-across-7-sherman-1981-arteriole-levels-reference> a schema:PropertyValue ;
        dct:source "Murray (1926a) PNAS 12:207-214; Sherman (1981) J. Gen. Physiol. 78:431" ;
        schema:value "8.2189" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-metabolic-to-viscous-power-ratio-at-optimal-radius-p-met-r-p-visc-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "metabolic-to-viscous power ratio at optimal radius P_met(r*) / P_visc(r*) = 2.0 ratio" ;
        schema:measurementTechnique "stationarity dP/dr = 0 evaluated at r* = murray_optimal_radius(Q) (Lean 4 theorem murray_stationarity_viscous_twice_metabolic)" ;
        schema:name "metabolic-to-viscous power ratio at optimal radius P_met(r*) / P_visc(r*)" ;
        schema:unitText "ratio" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-metabolic-to-viscous-power-ratio-at-optimal-radius-p-met-r-p-visc-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-metabolic-to-viscous-power-ratio-at-optimal-radius-p-met-r-p-visc-r-reference> a schema:PropertyValue ;
        dct:source "Murray (1926a) PNAS 12:207-214 Eq. 4" ;
        schema:value "2.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-segmented-retinal-fundus-specimen-y-junction-bifurcation-angle-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented retinal fundus specimen Y-junction bifurcation angle (mean) = 79.279 deg" ;
        dct:description "std = 17.60 deg, CV = 0.222, segmented cube ratio = 0.917 ± 0.247, tortuosity B/A ratio = 1.015" ;
        schema:measurementTechnique "green-channel top-hat vessel segmentation + medial-axis skeletonization across N=19 Y-junctions in retinal_vasculature_specimen.jpg" ;
        schema:name "segmented retinal fundus specimen Y-junction bifurcation angle (mean)" ;
        schema:unitText "deg" ;
        schema:value "79.279" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-segmented-retinal-fundus-specimen-y-junction-bifurcation-angle-mean-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-segmented-retinal-fundus-specimen-y-junction-bifurcation-angle-mean-reference> a schema:PropertyValue ;
        dct:source "Murray (1926b) J. Gen. Physiol. 9:835-841; Wikimedia Commons File:Retinal_vessel_tortuosity.jpg" ;
        schema:value "74.9346" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-symmetric-daughter-radius-ratio-r-1-r-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "symmetric daughter radius ratio r_1 / r_0 = 0.793701 ratio" ;
        dct:description "area expansion ratio beta = (r_1^2 + r_2^2)/r_0^2 = 1.259921 (ref 2^(1/3) = 1.259921)" ;
        schema:measurementTechnique "Murray (1926a) cube law r_0^3 = 2 * r_1^3 => r_1/r_0 = 2^(-1/3)" ;
        schema:name "symmetric daughter radius ratio r_1 / r_0" ;
        schema:unitText "ratio" ;
        schema:value "0.793701" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-symmetric-daughter-radius-ratio-r-1-r-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-symmetric-daughter-radius-ratio-r-1-r-0-reference> a schema:PropertyValue ;
        dct:source "Murray (1926a) PNAS 12:207-214; Sherman (1981) J. Gen. Physiol. 78:431" ;
        schema:value "0.793701" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-symmetric-total-bifurcation-angle-theta-1-theta-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "symmetric total bifurcation angle (theta_1 + theta_2) = 74.9346 deg" ;
        dct:description "half-angle theta_1 = theta_2 = 37.4673 deg; Steiner length-minimizing control = 120.0 deg" ;
        schema:measurementTechnique "2 * arccos(2^(-1/3)) from Murray (1926b) Eq. 5 vs Zamir 90 deg and Steiner 120 deg controls" ;
        schema:name "symmetric total bifurcation angle (theta_1 + theta_2)" ;
        schema:unitText "deg" ;
        schema:value "74.9346" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-symmetric-total-bifurcation-angle-theta-1-theta-2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-symmetric-total-bifurcation-angle-theta-1-theta-2-reference> a schema:PropertyValue ;
        dct:source "Murray (1926b) J. Gen. Physiol. 9:835-841 Eq. 5; Zamir (1976) J. Theor. Biol. 62:227" ;
        schema:value "74.9346" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L221–L279" ;
        dct:description "Empirical human retinal junction validation (RMSE = 0.134 deg, Pearson r = 0.9999, cube-law vs Da Vinci parity)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1959-murray-vascular-cube-law-branching.py#L221-L279> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L891–L985" ;
        dct:description "8-metric MorphoEval suite with reference values, dispersion stats, and ablation controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1959-murray-vascular-cube-law-branching.py#L891-L985> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 052 Assessor)" ;

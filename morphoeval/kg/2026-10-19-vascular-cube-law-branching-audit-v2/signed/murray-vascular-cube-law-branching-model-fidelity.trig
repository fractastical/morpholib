sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-vascular-cube-law-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1926a, 1926b), Zamir (1976) & Sherman (1981) minimum-work vascular cube law & arterial branching angles — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements Murray's (1926a) Poiseuille + metabolic power functional P(r), stationarity radius r*, and exact wall shear stress invariance tau_w = sqrt(eta*b) = 8.2189 dyn/cm^2 across 7 vascular generations (L100-147, L284-338), plus Murray's (1926b) full asymmetric bifurcation angle laws cos(theta_1) and cos(theta_2) alongside Zamir's (1976) surface-drag (90 deg), Steiner's length-minimizing (120 deg), and Da Vinci's area-preserving (gamma=2) negative controls (L154-279, L340-421). Backed by 3 machine-checked Lean 4 theorems (0 `sorry`s) in `Loop_052_vascular_cube_law_branching.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L100–L219" ;
        dcterms:description "Poiseuille + metabolic power functional, wall shear stress invariance, and asymmetric bifurcation cosine laws" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1959-murray-vascular-cube-law-branching.py#L100-L219> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L284–L378" ;
        dcterms:description "7-generation Sherman (1981) hierarchy and exponent sweep proving global power minimum at gamma* = 3.000" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1959-murray-vascular-cube-law-branching.py#L284-L378> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_052_vascular_cube_law_branching.lean L33–L110" ;
        dcterms:description "3 machine-checked Lean 4 theorems for Murray stationarity, cubic conservation, and cosine numerator symmetry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_052_vascular_cube_law_branching.lean#L33-L110> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 052 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


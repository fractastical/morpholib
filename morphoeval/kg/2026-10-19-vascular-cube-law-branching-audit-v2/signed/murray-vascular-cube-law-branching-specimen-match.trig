sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-vascular-cube-law-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L427–L616" ;
        dcterms:description "Zhang-Suen 1-pixel retinal skeletonization, EDT lumen radius mapping, and Y-junction angle/caliber extraction" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1959-murray-vascular-cube-law-branching.py#L427-L616> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/vascular_cube_law_branching_comparison.png (generated output)" ;
        dcterms:description "6-panel synthesis figure including Panel E human retinal fundus segmentation and Panel F angle histogram — docs/media/vascular_cube_law_branching_comparison.png: rendered output of 1959-murray-vascular-cube-law-branching.py at 8871db0, image/png, 807479 B, 2537×1537 px, artifact_sha256 6f5c640c92a289282dfe1e11d26a302fc561053ef8d7c679ab2ac12c8e5202a0 (sha256 6f5c640c92a289282dfe1e11d26a302fc561053ef8d7c679ab2ac12c8e5202a0), spec_fingerprint d50b49ef447bf68e29d604bf8fac7d65aec5afb9d6827a3f7ef26e8dd37a2ab8" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1926a, 1926b), Zamir (1976) & Sherman (1981) minimum-work vascular cube law & arterial branching angles — Morphological realism / specimen match: 87/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Segments the SHA-256-locked human retinal fundus vasculature specimen (`datasets/vascular_cube_law_branching/retinal_vasculature_specimen.jpg`, Panels A and B) using green-channel hemoglobin top-hat enhancement, Zhang-Suen 1-pixel skeletonization, and Euclidean distance transform (EDT) lumen caliber mapping (L427-616), extracting N=19 Y-junction bifurcations (mean angle 79.28 ± 17.34 deg vs Murray 74.93-80 deg theoretical range; mean cube-law ratio 0.917 ± 0.246; Panel B/A tortuosity ratio 1.015x) and displaying both skeleton and EDT caliber overlays in Panel E of the 6-panel synthesis figure." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-specimen-match-2> ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "faithful" .


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-vascular-cube-law-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1926a, 1926b), Zamir (1976) & Sherman (1981) minimum-work vascular cube law & arterial branching angles — Parameter expressivity: 89/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Sweeps daughter radius asymmetry alpha = r_2/r_1 across [0.15, 1.0], sweeps branching exponent gamma across [1.8, 4.2] (121 grid points, confirming global power minimum at gamma* = 3.000), compares three angle optimality regimes (`murray_volume`, `zamir_surface`, `steiner_length`), and exposes CLI flags `--alpha`, `--gamma`, `--eta`, `--b`, `--r0-um`, `--generations`, and `--seed` (L1057-1086)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L340–L421" ;
        dcterms:description "121-point gamma power sweep and multi-regime 2D vascular tree builder" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1959-murray-vascular-cube-law-branching.py#L340-L421> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L1057–L1086" ;
        dcterms:description "Full CLI parameter overrides wired into render_outputs()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1959-murray-vascular-cube-law-branching.py#L1057-L1086> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 052 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


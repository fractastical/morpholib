sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-vascular-cube-law-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1926a, 1926b), Zamir (1976) & Sherman (1981) minimum-work vascular cube law & arterial branching angles — Code-to-model traceability: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Every computational section and docstring in `1959-murray-vascular-cube-law-branching.py` maps explicitly to numbered equations in Murray (1926a) Eqs. 1-8, Murray (1926b) Eqs. 3-6, Zamir (1976) Table 1, Sherman (1981) Table I, and the 3 Lean 4 theorems in `Loop_052_vascular_cube_law_branching.lean` (L1-35, L95-220)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-code-traceability-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L1–L35" ;
        dct:description "Module header mapping all 4 papers and 3 Lean 4 theorems to code sections" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1959-murray-vascular-cube-law-branching.py#L1-L35> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/murray-vascular-cube-law-branching.yaml L1–L74" ;
        dct:description "Math KG loop registration linking equations, Lean 4 theorems, and Python code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/math_kg_loops/murray-vascular-cube-law-branching.yaml#L1-L74> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 052 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-goriely-tendril-perversion-intrinsic-curvature> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Goriely & Tabor (1998) PRL / Gerbode et al. (2012) Science Kirchhoff elastic rod tendril perversion, G-fiber overwinding & Pass 3 thigmotropic contact coiling — Morphological realism / specimen match: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Unchanged specimen pipeline: the SHA-256-locked CC BY-SA Passiflora caerulea tendril JPG is segmented into backbone, 50 helical turn apices and the perversion zone (`segment_tendril_perversion_specimen` L1144-L1220) and shown in panel E; 4-species coil radius/pitch match (r = 0.9999). Pass 3 adds panels G/H and a 4-panel thigmotropic figure + GIF whose 3D rod wraps a grey cylinder in a visually plausible helix. Deductions: there is no empirical specimen of a tendril wrapped on a support, so the new coiling output is compared only with the no-support control and Darwin's prose (-5); with 33 % of nodes in contact and a mean loop radius above R_s + a, panel G's \"N = 2.9\" includes loose loops that enclose but do not touch the support, so the figure reads tighter than the statistics support (-3); specimen pitch CV 0.298 vs the 0.22 reference is a Pass 2 carry-over that the model does not explain (-2); panel H overlays F_hold(mu) and N_wrap(R_s) on one axes with a secondary top axis, and panel C of the thigmotropic PNG has a legend that partly overlaps the curves (cosmetic)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match-6> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L1144–L1220" ;
        dct:description "Luminance + DoG ridge segmentation of the Passiflora caerulea coiled tendril and perversion zone (unchanged)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L1144-L1220> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L483–L514" ;
        dct:description "_wrap_statistics counts winding of all distal nodes about the support axis, explicitly including loose loops; contact_fraction and mean_loop_radius_mm disclose the looseness" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L483-L514> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L1582–L1621" ;
        dct:description "Panels G (3D contact coiling, R_s, mu, N_wrap in title) and H (F_hold vs mu and N_wrap vs R_s on shared axes with a secondary top axis)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L1582-L1621> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L1635–L1738" ;
        dct:description "render_thigmotropic_figure (4 panels) and render_thigmotropic_gif (frames every 2.5 min) for the Pass 3 model" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L1635-L1738> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match-5> a pk:EvidenceItem ;
        rdfs:label "docs/media/tendril_perversion_intrinsic_curvature_comparison.png (generated output)" ;
        dct:description "8-panel synthesis figure: Pass 2 panels A-F plus G contact coiling and H friction grip / support-radius sweep; no wrapped-tendril specimen photograph — docs/media/tendril_perversion_intrinsic_curvature_comparison.png: rendered output of 1998-goriely-tendril-perversion-intrinsic-curvature.py at 8a7928d7, image/png, 1061305 B, 2757×1458 px, artifact_sha256 57eed032cffcc9361a1a8fa3afc14d6c5377dfa2d824686d569b7ebc68f50f73 (sha256 57eed032cffcc9361a1a8fa3afc14d6c5377dfa2d824686d569b7ebc68f50f73), spec_fingerprint 68cb059282e6586e1c698e0a2073f9ca8cb2a88dda3dd3ce0c564cd556b97a7e" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match-6> a pk:EvidenceItem ;
        rdfs:label "docs/media/tendril_perversion_intrinsic_curvature_thigmotropic_coiling.png (generated output)" ;
        dct:description "4-panel contact-coiling figure (3D rod on cylinder, wrap-angle/contact time series, grip ramp, sweeps); panel C legend partly overlaps curves — docs/media/tendril_perversion_intrinsic_curvature_thigmotropic_coiling.png: rendered output of 1998-goriely-tendril-perversion-intrinsic-curvature.py at 8a7928d7, image/png, 387389 B, 2383×1258 px, artifact_sha256 3a2a08b78cd4c5794292e56c665b55bdf49d4d52952db591bfd4c71250c3a0a2 (sha256 3a2a08b78cd4c5794292e56c665b55bdf49d4d52952db591bfd4c71250c3a0a2), spec_fingerprint 68cb059282e6586e1c698e0a2073f9ca8cb2a88dda3dd3ce0c564cd556b97a7e" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 064 Pass 3 Phase B Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


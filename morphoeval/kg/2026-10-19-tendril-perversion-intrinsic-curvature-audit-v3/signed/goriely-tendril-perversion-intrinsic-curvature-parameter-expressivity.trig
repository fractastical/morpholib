sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-goriely-tendril-perversion-intrinsic-curvature> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L446–L470" ;
        dcterms:description "THIGMO_DEFAULTS: 20 contact-model parameters with inline provenance comments (assumption / shared with Pass 2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L446-L470> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L911–L976" ;
        dcterms:description "Friction sweep mu in {0,0.3,0.6,0.9}, support-radius sweep R_s in {0.5,1,1.5,2} mm with enclosure criterion R*, no-support and frictionless controls, stacked-turns scenario" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L911-L976> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L982–L1141" ;
        dcterms:description "Pass 2 sweeps: 10-point pitchfork, soft-vs-lignified overwinding regimes, 4-species evaluation (unchanged)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L982-L1141> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L2071–L2123" ;
        dcterms:description "CLI: six Pass 3 flags (L2075-L2080) and Pass 2 overrides; thigmo_overrides passed to render_comparison_figure, render_thigmotropic_figure and render_thigmotropic_gif; overrides now reach render_growth_gif (L2119)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L2071-L2123> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Goriely & Tabor (1998) PRL / Gerbode et al. (2012) Science Kirchhoff elastic rod tendril perversion, G-fiber overwinding & Pass 3 thigmotropic contact coiling — Parameter expressivity: 94/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Pass 2 sweeps retained (10 tension levels across the pitchfork L982-L1038, soft vs lignified Gamma L1040-L1088, 4 species L1091-L1141). Pass 3 adds a 4-point friction sweep with frictionless control, a 4-point support-radius sweep, a no-support control and a stacked-turns scenario (`evaluate_thigmotropic_contact_coiling` L911-L976), 20 contact-model parameters in `THIGMO_DEFAULTS` (L446-L470) and six new CLI flags `--mu --mu-self --R-support --kappa-contact --approach-angle --tau-thigmo` wired through `thigmo_overrides` into both renderers (L2075-L2080, L2102-L2121); `--kappa0/--B/--Gamma/--L` now also reach `render_growth_gif` (L2119). Deductions: the support-radius sweep shows no sharp enclosure threshold at R* = 1/kappa_contact - a (wraps(2 mm)/wraps(1 mm) = 0.64, the model still winds loosely around thick supports), so the one qualitatively testable Darwin statement is not reproduced as a transition (-3); tau_thigmo and v_signal are exposed but no sweep shows how time-to-wrap depends on them (-2); `--kappa-contact` is not propagated to the Pass 2 panels, which is correct but means the two models cannot be co-varied from the CLI (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity-4> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 064 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-goriely-tendril-perversion-intrinsic-curvature> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Goriely & Tabor (1998) PRL / Gerbode et al. (2012) Science Kirchhoff elastic rod tendril perversion, G-fiber overwinding & Pass 3 thigmotropic contact coiling — Model fidelity to source: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Pass 2 core intact: Timoshenko G-fiber bilayer kappa_0, exact T_c = B kappa_0^2/(1+Gamma) and helix equilibrium (L164-L246), 161-node L-BFGS-B Kirchhoff perversion solver with zero-link enforcement and kappa_0 = 0 / T >= T_c controls (L249-L411). Pass 3 adds a physically reasoned reduced contact model: contact-gated intrinsic curvature with signal propagation (`kappa0_field` L629-L632; Lean Law 4), implicit backward-Euler incremental potential with penalty cylinder contact and |i-j| >= 3 self-contact, and Coulomb dissipation potentials for support and self-contact friction (L741-L761; Lean Law 5), with a grip test against mu*sum(N) and the capstan gain (L836-L875). Deductions: the contact rod is bending-only with no material-frame twist, so Gamma never enters contact coiling and the two solvers are not one model (-4); the preferred-curvature direction is an \"axis-seeking\" proxy (unit vector toward the support axis, frozen per macro step, L642-L654) rather than curvature toward the actual touched flank, which makes wrapping partly a construction of the model (-2); friction normal forces are lagged one step and the stick/slip law is Huber-regularised, so stick is approximate (-1); the rod is placed already touching the support at 25 % of L with a fixed 55 deg approach (`_initial_rod` L516-L530), so there is no first-touch event to model (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-6> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L164–L246" ;
        dcterms:description "G-fiber bilayer intrinsic curvature kappa_0, critical tension T_c and equilibrium helix equations (unchanged from Pass 2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L164-L246> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L249–L411" ;
        dcterms:description "L-BFGS-B Kirchhoff elastic rod perversion solver with zero-link enforcement and negative controls; carries the material-frame twist that the Pass 3 contact rod lacks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L249-L411> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L414–L445" ;
        dcterms:description "Section 3b scope comment: reduced model, energy terms, lagged-normal incremental-potential friction, and the explicit NOT-implemented list (no twist, no circumnutation)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L414-L445> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L596–L909" ;
        dcterms:description "simulate_thigmotropic_contact_coiling: kappa0_field gating (L629-L632), macro_step implicit L-BFGS-B incremental potential (L642-L785), coiling phase (L787-L834), grip test (L836-L875)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L596-L909> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L741–L761" ;
        dcterms:description "Coulomb friction on the support and between self-contacting pairs uses normal forces from the previous macro step (lagged) with a Huber stick threshold" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L741-L761> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity-6> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_064_tendril_perversion_intrinsic_curvature.lean L100–L146" ;
        dcterms:description "Laws 4-5: thigmotropic_contact_gating (untouched -> 0, bounded by saturation) and coulomb_grip_capacity (mu = 0 -> 0, N = 0 -> 0, monotone in mu); 5 theorems total, 0 sorrys, lean exit 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_064_tendril_perversion_intrinsic_curvature.lean#L100-L146> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 064 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


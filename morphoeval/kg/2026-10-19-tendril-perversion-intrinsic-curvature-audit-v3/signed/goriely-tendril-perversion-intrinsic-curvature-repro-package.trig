sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-goriely-tendril-perversion-intrinsic-curvature> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Goriely & Tabor (1998) PRL / Gerbode et al. (2012) Science Kirchhoff elastic rod tendril perversion, G-fiber overwinding & Pass 3 thigmotropic contact coiling — Reproducibility package: 94/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`self_test()` (L1987-L2068) runs 12 checks: the 8 Pass 2 checks plus (9) contact coiling N_wrap > 1.5 vs control < 0.5 with kappa0 = 0, penetration < 0.1 a, strain < 2 %; (10) F_hold monotone in mu, frictionless slip, F_hold/mu*sum(N) in (0.1, 1.5); (11) stacked turns activate self-contact and stay within 15 % of the rod diameter; (12) two-run bitwise determinism of the implicit contact solver (L2051-L2056). Verified this round: PASSED all 12 checks in ~85 s; the default render completes in ~45 s and writes the 4 media files listed under output/extra_outputs; dataset integrity is fail-closed; results are memoised in `_THIGMO_CACHE` by full parameter tuple. Deductions: the determinism check runs only a 5 min horizon, not the 30 min default (-2); the self-test takes ~85 s, dominated by the friction and radius sweeps, with no `--quick` path (-2); no requirements lock file pins the environment that produced the committed media (-1); the Pass 3 PNG is gitignored (`*.png`), so the committed repo does not carry the new figure (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-repro-package-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L1987–L2068" ;
        dcterms:description "12-check self_test(): Pass 2 checks 1-8 and Pass 3 checks 9-12 (L2031-L2056) including contact-solver determinism and 15-measurement count" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L1987-L2068> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L2051–L2056" ;
        dcterms:description "Determinism check clears _THIGMO_CACHE and compares two fresh runs, but only at t_end_min = 5" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L2051-L2056> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L104–L107" ;
        dcterms:description "Four output paths (comparison PNG, growth GIF, thigmotropic PNG, thigmotropic GIF) written by the default invocation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L104-L107> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 064 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


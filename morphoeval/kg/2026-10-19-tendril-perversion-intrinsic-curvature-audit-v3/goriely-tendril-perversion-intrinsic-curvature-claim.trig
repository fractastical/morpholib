sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-goriely-tendril-perversion-intrinsic-curvature> a pk:Claim ;
        rdfs:label "Goriely & Tabor (1998) PRL / Gerbode et al. (2012) Science Kirchhoff elastic rod tendril perversion, G-fiber overwinding & Pass 3 thigmotropic contact coiling faithfully reproduces Climbing plant tendrils (Cucumis sativus, Passiflora caerulea, Bryonia dioica, Echinocystis lobata) morphology" ;
        dct:description "The simulation script(s) 1998-goriely-tendril-perversion-intrinsic-curvature.py, docs/media/tendril_perversion_intrinsic_curvature_growth.gif, docs/media/tendril_perversion_intrinsic_curvature_thigmotropic_coiling.png, docs/media/tendril_perversion_intrinsic_curvature_thigmotropic_coiling.gif implement the cited source model as published and produce forms that match real Climbing plant tendrils (Cucumis sativus, Passiflora caerulea, Bryonia dioica, Echinocystis lobata) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 91.7/100, audit 2026-10-19-tendril-perversion-intrinsic-curvature-audit-v3) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py>,
            <https://github.com/fractastical/morpholib/blob/8a7928d7/docs/media/tendril_perversion_intrinsic_curvature_growth.gif>,
            <https://github.com/fractastical/morpholib/blob/8a7928d7/docs/media/tendril_perversion_intrinsic_curvature_thigmotropic_coiling.gif>,
            <https://github.com/fractastical/morpholib/blob/8a7928d7/docs/media/tendril_perversion_intrinsic_curvature_thigmotropic_coiling.png> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py, https://github.com/fractastical/morpholib/blob/8a7928d7/docs/media/tendril_perversion_intrinsic_curvature_growth.gif, https://github.com/fractastical/morpholib/blob/8a7928d7/docs/media/tendril_perversion_intrinsic_curvature_thigmotropic_coiling.png, https://github.com/fractastical/morpholib/blob/8a7928d7/docs/media/tendril_perversion_intrinsic_curvature_thigmotropic_coiling.gif; output: docs/media/tendril_perversion_intrinsic_curvature_comparison.png; organism: Climbing plant tendrils (Cucumis sativus, Passiflora caerulea, Bryonia dioica, Echinocystis lobata); checkpoint commit: https://github.com/fractastical/morpholib/commit/8a7928d7; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, matplotlib 3.10.7, Pillow 12.0.0; spec_fingerprint: 68cb059282e6586e1c698e0a2073f9ca8cb2a88dda3dd3ce0c564cd556b97a7e; artifact_sha256: 57eed032cffcc9361a1a8fa3afc14d6c5377dfa2d824686d569b7ebc68f50f73; input_dataset_sha256: {datasets/tendril_perversion_intrinsic_curvature/paper_citations.bib=2529ebe7e9abea2f..., datasets/tendril_perversion_intrinsic_curvature/scout_manifest.json=801e196968b34405..., datasets/tendril_perversion_intrinsic_curvature/tendril_perversion_helix_specimen.jpg=14409d193142442d..., datasets/tendril_perversion_intrinsic_curvature/tendril_perversion_intrinsic_curvature_reference.json=8af7ac3175f6890f..., datasets/tendril_perversion_intrinsic_curvature/thigmotropic_contact_coiling_reference.json=f55d9cfe319f0366...}; supersedes_audit_id: 2026-10-19-tendril-perversion-intrinsic-curvature-audit-v2; claim_boundary: [reported_in_source: Goriely & Tabor (1998) / McMillen & Goriely (2002): an intrinsically curved Kirchhoff rod with both ends held undergoes a supercritical pitchfork bifurcation below T_c = B kappa_0^2 / (1 + Gamma) into two opposite-handed helices joined by a perversion, with zero net link | Gerbode et al. (2012): the cucumber tendril's G-fiber ribbon sets the intrinsic curvature; soft tendrils (Gamma < 1) overwind under axial stretch while lignified ones unwind; coil radius and pitch scale across species | Darwin (1865) Ch. IV: tendrils curve toward a touched side within tens of seconds, complete a wrap around a thin stick within minutes to about an hour, and grasp thin supports more readily than thick ones (qualitative) | Jaffe & Galston (1968): thigmotropic coiling is a contact-triggered, propagating growth response; Euler (1762): the capstan law exp(mu Theta) for a flexible line on a cylinder; reconstructed_in_script: Timoshenko bilayer kappa_0, exact T_c, 161-node L-BFGS-B Kirchhoff perversion solver with zero-link enforcement and negative controls; 10-point pitchfork sweep; soft vs lignified overwinding; 4-species scaling; DoG segmentation of the SHA-256-locked Passiflora caerulea specimen (Pass 2) | Pass 3: 61-node inertia-free discrete rod with contact-gated intrinsic curvature pointing toward the support axis, implicit backward-Euler incremental potential (L-BFGS-B), rigid-cylinder penalty contact, penalty self-contact, lagged-normal Coulomb friction on support and self-contact, quasi-static grip test vs mu*sum(N) and exp(mu Theta); no-support, frictionless, friction-sweep, support-radius-sweep and stacked-turns scenarios; transfer_boundary: The contact solver is a separate bending-only rod: it has no material-frame twist, so Gamma = C/B plays no role in contact coiling and the perversion (zero-link) physics of section 3 is not coupled to it | mu_support, mu_self, kappa_contact, tau_thigmo, v_signal, the 55 deg approach angle and the initial placement touching the support at 25 % of L are provenance-tagged assumptions; the only empirical anchors for Pass 3 are Darwin's qualitative timings and support-size statements | Friction uses normal forces lagged one macro step; F_hold / mu*sum(N) = 0.67 is a consistency check of the scheme, not an experiment; N_wrap counts loose loops that enclose but do not touch the support (contact fraction 33 % of nodes); does_not_claim: Circumnutation or support-search before first touch, a measured tendril-on-wood friction coefficient, compliant or rough or finite-length supports, G-fiber lignification time course, or a validated time-to-wrap (tau_thigmo and v_signal were chosen inside Darwin's 5-60 min window and the model's 4.75 min falls slightly below it)]; other sources: Remarques sur l'effet du frottement dans l'équilibre <https://scholarlycommons.pacific.edu/euler-works/262/>" ;
        pk:derivedFromPaper <https://doi.org/10.1007/s00332-002-0493-1>,
            <https://doi.org/10.1103/PhysRevLett.80.1564>,
            <https://doi.org/10.1111/j.1095-8339.1865.tb00011.x>,
            <https://doi.org/10.1126/science.1223304>,
            <https://doi.org/10.1146/annurev.pp.19.060168.002221>,
            <https://doi.org/10.3732/ajb.0900045> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-specimen-match> ;
        pk:weightOfEvidence "0.917"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py> a schema:SoftwareSourceCode ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "8a7928d7" .
    <https://github.com/fractastical/morpholib/blob/8a7928d7/docs/media/tendril_perversion_intrinsic_curvature_growth.gif> a schema:SoftwareSourceCode ;
        rdfs:label "docs/media/tendril_perversion_intrinsic_curvature_growth.gif" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:version "8a7928d7" .
    <https://github.com/fractastical/morpholib/blob/8a7928d7/docs/media/tendril_perversion_intrinsic_curvature_thigmotropic_coiling.gif> a schema:SoftwareSourceCode ;
        rdfs:label "docs/media/tendril_perversion_intrinsic_curvature_thigmotropic_coiling.gif" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:version "8a7928d7" .
    <https://github.com/fractastical/morpholib/blob/8a7928d7/docs/media/tendril_perversion_intrinsic_curvature_thigmotropic_coiling.png> a schema:SoftwareSourceCode ;
        rdfs:label "docs/media/tendril_perversion_intrinsic_curvature_thigmotropic_coiling.png" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:version "8a7928d7" .
}


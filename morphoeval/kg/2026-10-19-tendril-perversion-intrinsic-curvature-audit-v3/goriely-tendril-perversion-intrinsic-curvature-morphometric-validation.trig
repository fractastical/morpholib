        dct:description "mature lignified (Gamma=1.45) correlation r = 0.9911, RMSE = 0.1483" ;
        schema:measurementTechnique "Correlation of simulated vs empirical Delta_N(z/L) across 10 extension steps for Gamma=0.25 (RMSE=0.1302 turns)" ;
        schema:name "Gerbode et al. (2012) soft overwinding curve correlation across axial extension z/L" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9806" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-gerbode-et-al-2012-soft-overwinding-curve-correlation-across-axial-extension-z-l-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-gerbode-et-al-2012-soft-overwinding-curve-correlation-across-axial-extension-z-l-reference> a schema:PropertyValue ;
        dct:source "Gerbode et al. (2012) Science 337:1087-1091 Fig. 3D" ;

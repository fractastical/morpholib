        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-goriely-tendril-perversion-intrinsic-curvature> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Goriely & Tabor (1998) PRL / Gerbode et al. (2012) Science Kirchhoff elastic rod tendril perversion, G-fiber overwinding & Pass 3 thigmotropic contact coiling — Morphometric validation: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1817-L1984) now returns 15 measurements with reference values, methods, notes and negative controls: 9 from Pass 2 and 6 Pass 3 (L1830-L1891). Pass 2 values re-read from the current output: T_c = 0.3018 mN (ref 0.3018), pitchfork cos(theta) r = 0.9974, |Delta_Lk| = 0, soft overwinding r = 0.9806, 4-species r = 0.9999, super-critical z/L = 1.0, specimen CV 0.298 (ref 0.22). Deductions: the v2 audit quoted Gerbode peak overwinding \"+0.5873 turns\" and kappa_0 \"0.6545 mm^-1\" but the script reports 0.7171 turns (ref 0.58, +24 %, L1925-L1933) and 0.4976 mm^-1 (ref 0.65, -23 %, L1955-L1963), so two of the nine Pass 2 anchors miss their references by about a quarter and the v2 score rested on misquoted numbers (-5); the Pass 3 N_wrap measurement uses the internal no-support control as `reference_value` (L1831-L1840) and the support-radius ratio has `reference_value: None` (L1881-L1890), so neither is a comparison with data (-3); time-to-first-wrap 4.75 min is set by the assumed tau_thigmo and v_signal and falls slightly below Darwin's 5-60 min window whose midpoint 32.5 min is the reference (L1841-L1850) - the note says \"NOT an independent validation\", which is credited (-2); F_hold / mu*sum(N) = 0.67 (L1851-L1860) is a consistency check of the lagged-normal scheme, not an experiment (-1); specimen pitch CV 0.298 vs 0.22 persists (-1). The frictionless-control and self-contact non-penetration checks are genuine falsifiable physics constraints and are credited." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1998-goriely-tendril-perversion-intrinsic-curvature.py L1925–L1933: Gerbode soft peak overwinding: script value 0.7171 turns vs reference 0.58 (+24 %); v2 audit quoted +0.5873 <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L1925-L1933>",
            "1998-goriely-tendril-perversion-intrinsic-curvature.py L1955–L1963: G-fiber bilayer kappa_0: script value 0.4976 mm^-1 vs reference 0.65 (-23 %); v2 audit quoted 0.6545 <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L1955-L1963>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-4-species-climbing-plant-helical-coil-radius-correlation-cucumis-passiflora-bryonia-echinocystis>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-cucumber-cucumis-sativus-g-fiber-bilayer-intrinsic-curvature-kappa-0-delta-eps-g-0-085>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-gerbode-et-al-2012-soft-overwinding-curve-correlation-across-axial-extension-z-l>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-gerbode-et-al-2012-young-soft-tendril-peak-overwinding-delta-n-max-gamma-0-25>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-goriely-tabor-1998-critical-pitchfork-tension-tc-b-1-25-kappa0-0-65-gamma-0-75>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-coulomb-grip-holding-load-f-hold-over-amontons-coulomb-capacity-mu-sum-n-i-median-over-mu-in-0-3-0-6-0-9>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-frictionless-control-holding-load-f-hold-at-mu-0-coil-must-slide-freely>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-self-contact-non-penetration-minimum-non-adjacent-node-distance-rod-diameter-in-the-stacked-turns-scenario>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-support-radius-sweep-wraps-at-r-s-2-0-mm-relative-to-r-s-1-0-mm-thick-vs-thin-support>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-thigmotropic-contact-coiling-wraps-around-thin-cylindrical-support-after-30-min-r-s-1-0-mm-mu-0-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-time-from-first-touch-to-first-complete-wrap-model-clock-set-by-tau-thigmo-5-min-v-signal-5-mm-min>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-passiflora-caerulea-specimen-segmented-inter-turn-helical-pitch-cv-tendril-perversion-helix-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pitchfork-bifurcation-helical-inclination-cos-theta-helix-correlation-across-t-tc>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-super-critical-tension-negative-control-end-to-end-extension-z-l-t-tc-1-20>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-zero-link-topological-conservation-delta-lk-across-tendril-perversion-t-tc-0-25>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-morphometric-validation-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-morphometric-validation-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-morphometric-validation-5> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-4-species-climbing-plant-helical-coil-radius-correlation-cucumis-passiflora-bryonia-echinocystis> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "4-species climbing plant helical coil radius correlation (Cucumis, Passiflora, Bryonia, Echinocystis) = 0.9999 Pearson r" ;
        dct:description "4-species helical pitch Pearson r = 1.0000, RMSE = 0.0100 mm" ;
        schema:measurementTechnique "Kirchhoff rod predicted coil radius R vs empirical measurements across 4 climbing plant species (p=8.11e-05, RMSE=0.0037 mm)" ;
        schema:name "4-species climbing plant helical coil radius correlation (Cucumis, Passiflora, Bryonia, Echinocystis)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-4-species-climbing-plant-helical-coil-radius-correlation-cucumis-passiflora-bryonia-echinocystis-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-4-species-climbing-plant-helical-coil-radius-correlation-cucumis-passiflora-bryonia-echinocystis-reference> a schema:PropertyValue ;
        dct:source "Darwin (1865) J. Linn. Soc. Bot. 9:1-118; Gerbode et al. (2012) Science 337:1087-1091" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-cucumber-cucumis-sativus-g-fiber-bilayer-intrinsic-curvature-kappa-0-delta-eps-g-0-085> a schema:PropertyValue,
            pk:EvidenceItem ;

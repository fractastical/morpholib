        dct:description "zero-strain negative control (Delta_eps_g = 0) yields kappa_0 = 0.0000 mm^-1" ;
        schema:measurementTechnique "Timoshenko asymmetric G-fiber ribbon + soft parenchyma bilayer curvature formula at differential strain Delta_eps_g = 0.085" ;
        schema:name "Cucumber (Cucumis sativus) G-fiber bilayer intrinsic curvature kappa_0 (Delta_eps_g=0.085)" ;
        schema:unitText "mm^-1" ;

        schema:name "Gerbode et al. (2012) young soft tendril peak overwinding Delta_N_max (Gamma=0.25)" ;
        schema:unitText "turns" ;
        schema:value "0.7171" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-gerbode-et-al-2012-young-soft-tendril-peak-overwinding-delta-n-max-gamma-0-25-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-gerbode-et-al-2012-young-soft-tendril-peak-overwinding-delta-n-max-gamma-0-25-reference> a schema:PropertyValue ;
        dct:source "Gerbode et al. (2012) Science 337:1087-1091 Fig. 3D-E (soft young tendril overwinding)" ;
        schema:value "0.58" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-goriely-tabor-1998-critical-pitchfork-tension-tc-b-1-25-kappa0-0-65-gamma-0-75> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Goriely & Tabor (1998) critical pitchfork tension Tc (B=1.25, kappa0=0.65, Gamma=0.75) = 0.3018 mN" ;
        dct:description "super-critical control (T/Tc=1.20) end-to-end z/L = 1.0000" ;
        schema:measurementTechnique "Exact Kirchhoff rod supercritical pitchfork bifurcation threshold Tc = B * kappa_0^2 / (1 + Gamma)" ;
        schema:name "Goriely & Tabor (1998) critical pitchfork tension Tc (B=1.25, kappa0=0.65, Gamma=0.75)" ;
        schema:unitText "mN" ;
        schema:value "0.3018" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-goriely-tabor-1998-critical-pitchfork-tension-tc-b-1-25-kappa0-0-65-gamma-0-75-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-goriely-tabor-1998-critical-pitchfork-tension-tc-b-1-25-kappa0-0-65-gamma-0-75-reference> a schema:PropertyValue ;
        dct:source "Goriely & Tabor (1998) Phys. Rev. Lett. 80:1564-1567 Eq. 11" ;
        schema:value "0.3018" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-coulomb-grip-holding-load-f-hold-over-amontons-coulomb-capacity-mu-sum-n-i-median-over-mu-in-0-3-0-6-0-9> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pass 3 Coulomb grip: holding load F_hold over Amontons-Coulomb capacity mu*sum(N_i) (median over mu in {0.3,0.6,0.9}) = 0.6705 ratio" ;
        dct:description "F_hold(mu) = [0.0005, 0.0679, 0.2119, 0.272] mN for mu = [0.0, 0.3, 0.6, 0.9]; monotone non-decreasing = True; capstan gain at default mu = 48156.7" ;
        schema:measurementTechnique "Quasi-static axial load ramp on the released base after coiling; F_hold = load at 0.5 mm axial slip of the wrapped segment; divided by mu times the total squeeze normal force" ;
        schema:name "Pass 3 Coulomb grip: holding load F_hold over Amontons-Coulomb capacity mu*sum(N_i) (median over mu in {0.3,0.6,0.9})" ;
        schema:unitText "ratio" ;
        schema:value "0.6705" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-coulomb-grip-holding-load-f-hold-over-amontons-coulomb-capacity-mu-sum-n-i-median-over-mu-in-0-3-0-6-0-9-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-coulomb-grip-holding-load-f-hold-over-amontons-coulomb-capacity-mu-sum-n-i-median-over-mu-in-0-3-0-6-0-9-reference> a schema:PropertyValue ;
        dct:source "Amontons-Coulomb friction law F_max = mu N (lagged incremental-potential friction, consistency check); Euler (1762) capstan gain exp(mu*Theta) reported in the note" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-frictionless-control-holding-load-f-hold-at-mu-0-coil-must-slide-freely> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pass 3 frictionless control: holding load F_hold at mu = 0 (coil must slide freely) = 0.00049 mN" ;
        dct:description "first ramp level is 0.015 mN; F_hold below that level means slip at the first increment" ;
        schema:measurementTechnique "Same load ramp with mu_support = mu_self = 0" ;
        schema:name "Pass 3 frictionless control: holding load F_hold at mu = 0 (coil must slide freely)" ;
        schema:unitText "mN" ;
        schema:value "0.00049" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-frictionless-control-holding-load-f-hold-at-mu-0-coil-must-slide-freely-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-frictionless-control-holding-load-f-hold-at-mu-0-coil-must-slide-freely-reference> a schema:PropertyValue ;
        dct:source "Coulomb law: zero friction coefficient -> zero tangential holding capacity" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-self-contact-non-penetration-minimum-non-adjacent-node-distance-rod-diameter-in-the-stacked-turns-scenario> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pass 3 self-contact non-penetration: minimum non-adjacent node distance / rod diameter in the stacked-turns scenario = 0.9888 ratio" ;
        dct:description "11 self-contact pairs active; helix pitch per turn = 0.333 mm < 2a = 0.50 mm" ;
        schema:measurementTechnique "Near-circumferential approach (88 deg) stacks successive turns; penalty self-contact with Coulomb self-friction keeps turns from interpenetrating" ;
        schema:name "Pass 3 self-contact non-penetration: minimum non-adjacent node distance / rod diameter in the stacked-turns scenario" ;
        schema:unitText "ratio" ;
        schema:value "0.9888" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-self-contact-non-penetration-minimum-non-adjacent-node-distance-rod-diameter-in-the-stacked-turns-scenario-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-self-contact-non-penetration-minimum-non-adjacent-node-distance-rod-diameter-in-the-stacked-turns-scenario-reference> a schema:PropertyValue ;
        dct:source "Geometric impenetrability of a rod of diameter 2a (self-contact constraint)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-support-radius-sweep-wraps-at-r-s-2-0-mm-relative-to-r-s-1-0-mm-thick-vs-thin-support> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pass 3 support-radius sweep: wraps at R_s = 2.0 mm relative to R_s = 1.0 mm (thick vs thin support) = 0.6413 ratio" ;
        dct:description "geometric enclosure criterion R* = 1/kappa_contact - a = 0.75 mm; the model still winds loosely around thicker supports, so no sharp threshold is reproduced" ;
        schema:measurementTechnique "N_wrap after 30 min for R_s in [0.5, 1.0, 1.5, 2.0] mm = [2.98, 2.86, 2.148, 1.834]" ;
        schema:name "Pass 3 support-radius sweep: wraps at R_s = 2.0 mm relative to R_s = 1.0 mm (thick vs thin support)" ;
        schema:unitText "ratio" ;
        schema:value "0.6413" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-thigmotropic-contact-coiling-wraps-around-thin-cylindrical-support-after-30-min-r-s-1-0-mm-mu-0-6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pass 3 thigmotropic contact coiling: wraps around thin cylindrical support after 30 min (R_s=1.0 mm, mu=0.6) = 2.8601 turns" ;
        dct:description "control (no support) N_wrap = 0.307; contact fraction = 0.328; mean loop radius = 1.66 mm vs 1/kappa_contact = 1.00 mm; reference_value is the control, the comparison is 'much larger than control'" ;
        schema:measurementTechnique "Implicit overdamped discrete rod with contact-gated intrinsic curvature, penalty contact and Coulomb friction; winding of the distal rod about the support axis / 2 pi" ;
        schema:name "Pass 3 thigmotropic contact coiling: wraps around thin cylindrical support after 30 min (R_s=1.0 mm, mu=0.6)" ;
        schema:unitText "turns" ;
        schema:value "2.8601" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-thigmotropic-contact-coiling-wraps-around-thin-cylindrical-support-after-30-min-r-s-1-0-mm-mu-0-6-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-measurement-pass-3-thigmotropic-contact-coiling-wraps-around-thin-cylindrical-support-after-30-min-r-s-1-0-mm-mu-0-6-reference> a schema:PropertyValue ;
        dct:source "Internal negative control: identical rod with the support removed (no touch -> kappa0 stays 0, no coiling); Darwin (1865) Ch. IV reports multiple close turns around thin supports (qualitative)" ;
        schema:value "0.3075" .

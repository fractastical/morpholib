sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-goriely-tendril-perversion-intrinsic-curvature> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-goriely-tendril-perversion-intrinsic-curvature-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Goriely & Tabor (1998) PRL / Gerbode et al. (2012) Science Kirchhoff elastic rod tendril perversion, G-fiber overwinding & Pass 3 thigmotropic contact coiling — Code-to-model traceability: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring (L1-L78) maps Laws 1-5 to the papers and to the five Lean 4 theorems in `MathOfBiology.Loop_064`, and carries an explicit Pass 3 scope statement (L70-L77). The section 3b header (L414-L445) writes out every energy term, the friction scheme and the NOT-implemented list; function docstrings cite Darwin Ch. IV, Jaffe & Galston and Euler. The math KG YAML registers equations 4-5 with single-range `code_locus` pins (L596-L909, L911-L977) and refreshed Pass 2 loci. Deductions: `_wrap_statistics` is documented as counting loose loops but the panel G title reports N without that qualifier (-2); the \"axis-seeking\" curvature direction proxy is described in the header but the parallel-transport fallback for non-touching nodes (L655-L676) has no literature anchor (-2); returned keys `_last_objective`, `_mat_dir`, `_last_opt_message` (L897-L899) are unused, and `last_objective` would be unbound if `t_end_min` < `dt_min` (-1); the comparison figure's section-6 banner still says \"6-Panel\" (L1221) while the figure has 8 panels (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1998-goriely-tendril-perversion-intrinsic-curvature.py L1221–L1222: Section 6 banner still reads '6-Panel Synthesis Figure' although render_comparison_figure now draws 8 panels <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L1221-L1222>",
            "1998-goriely-tendril-perversion-intrinsic-curvature.py L897–L899: Unused private return keys _last_objective, _mat_dir, _last_opt_message; last_objective unbound when n_steps = 0 <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L897-L899>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-code-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-code-traceability-4> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L1–L78" ;
        dct:description "Module header: Laws 1-5 with Lean theorem names, equations and the Pass 3 reduced-scope statement" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L1-L78> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1998-goriely-tendril-perversion-intrinsic-curvature.py L414–L445" ;
        dct:description "Section 3b header: energy functional, implicit integrator, lagged-normal Coulomb friction, gating law and NOT-implemented list" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/1998-goriely-tendril-perversion-intrinsic-curvature.py#L414-L445> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/goriely-tendril-perversion-intrinsic-curvature.yaml L13–L117" ;
        dct:description "model_spec.pass3_thigmotropic_contact_coiling block, new JSON input, equations 4-5 with Lean declarations and single-range code_locus / code_locus_secondary pins" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/math_kg_loops/goriely-tendril-perversion-intrinsic-curvature.yaml#L13-L117> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-goriely-tendril-perversion-intrinsic-curvature-code-traceability-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_064_tendril_perversion_intrinsic_curvature.lean L1–L148" ;
        dct:description "5 theorems (Laws 1-5), 0 sorrys; header still lists only the 3 Pass 2 sources" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_064_tendril_perversion_intrinsic_curvature.lean#L1-L148> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 064 Pass 3 Phase B Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


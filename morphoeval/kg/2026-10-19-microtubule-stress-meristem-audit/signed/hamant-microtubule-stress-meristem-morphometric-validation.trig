sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hamant-microtubule-stress-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hamant-microtubule-stress-meristem-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-cylindrical-stem-hoop-stress-sigma-theta> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cylindrical stem hoop stress sigma_theta = 80.0 MPa" ;
        schema:measurementTechnique "Young-Laplace cylinder P*R/h" ;
        schema:name "cylindrical stem hoop stress sigma_theta" ;
        schema:unitText "MPa" ;
        schema:value "80.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-cylindrical-stem-hoop-to-axial-stress-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cylindrical stem hoop-to-axial stress ratio = 2.0 ratio" ;
        schema:measurementTechnique "sigma_theta / sigma_z on cylinder" ;
        schema:name "cylindrical stem hoop-to-axial stress ratio" ;
        schema:unitText "ratio" ;
        schema:value "2.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-spherical-dome-isotropic-stress-sigma-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "spherical dome isotropic stress sigma_0 = 40.0 MPa" ;
        schema:measurementTechnique "Young-Laplace sphere P*R/(2*h)" ;
        schema:name "spherical dome isotropic stress sigma_0" ;
        schema:unitText "MPa" ;
        schema:value "40.0" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 036 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hamant-microtubule-stress-meristem-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Bozorg et al. (2014), Sampathkumar et al. (2014), Hamant et al. (2008) & Uyttewaal et al. (2012) shoot apical meristem pressurized shell stress tensor, stress-vs-strain CMT alignment, and katanin organ boundary morphogenesis — Morphometric validation: 53/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Exposes only 3 unreferenced algebraic numbers in `measure_morphoeval()` (L43-68) without reference values, uncertainty bounds, Pearson correlations, p-values, stress-vs-strain cue discrimination metrics, or empirical specimen measurements." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2008-hamant-microtubule-stress-meristem.py L43–L68: Minimal 3-metric list lacking reference values, uncertainty, p-values, and negative controls <https://github.com/fractastical/morpholib/blob/8871db0/2008-hamant-microtubule-stress-meristem.py#L43-L68>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-cylindrical-stem-hoop-stress-sigma-theta>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-cylindrical-stem-hoop-to-axial-stress-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-spherical-dome-isotropic-stress-sigma-0> ;
        pk:hasScore "0.53"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


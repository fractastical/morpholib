sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-cervera-audit-v2-cervera-levin-mafe-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Morphological realism / specimen match: 42/100" ;
        rdfs:comment "The real Schmidtea silhouette is now used for an area measurement as well as a backdrop, and the regenerated figure is more legible than the previous version. Wild type and double head remain visibly distinct. But the body outline never changes, no real treated or double-head specimen or source-paper morphology is shown, and the model does not generate head or auricle form. Crossing a threshold merely swaps between two pre-existing Planform cartoons; measuring coloured territory area improves quantification, not anatomical realism. Thus the central specimen-match requirement remains mostly unmet. Evidence: 2021-Cervera–Levin–Mafe.py L150–L207: photograph is segmented into the fixed mask on which signals are painted <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L150-L207>; 2021-Cervera–Levin–Mafe.py L354–L362: new morphometric is the mask area lying anterior to the one-dimensional signal crossing <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L354-L362>; 2021-Cervera–Levin–Mafe.py L795–L869: outcomes remain fixed WT and double-head Planform graph cartoons <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L795-L869>; 2021-Cervera–Levin–Mafe.py L1511–L1519: GIF threshold selects one of the two cartoons rather than deforming anatomy <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L1511-L1519>; cervera_levin_mafe_bioelectric_morphospace.png (generated output, not in repo): regenerated six-panel figure is legible but contains no real phenotype comparison — cervera_levin_mafe_bioelectric_morphospace.png: rendered output of 2021-Cervera–Levin–Mafe.py, not present when the audit was snapshotted (unfingerprinted)." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gpt-5.6-sol> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-specimen-match> ;
        pk:hasProbability "0.42"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-specimen-match> rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis (2021-Cervera–Levin–Mafe.py, 2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Planarians; photograph is Schmidtea mediterranea, empirical PlanformDB subset is Dugesia japonica" ;
        dcterms:identifier "morphoeval/0.1.0/specimen-match" .

    <https://w3id.org/probknow/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT-5.6 Sol (Cursor agent)" .
}


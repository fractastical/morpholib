sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cervera-levin-mafe> a pk:Claim ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis faithfully reproduces Planarians; photograph is Schmidtea mediterranea, empirical PlanformDB subset is Dugesia japonica morphology" ;
        dcterms:description "The simulation script(s) 2021-Cervera–Levin–Mafe.py, 2013-lobo-planform-morphology.py implement the cited source model as published and produce forms that match real Planarians; photograph is Schmidtea mediterranea, empirical PlanformDB subset is Dugesia japonica specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 55.6/100, audit 2026-10-17-cervera-audit-v2) and the assessments." ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py, https://github.com/fractastical/morpholib/blob/a0d6848/2013-lobo-planform-morphology.py; output: cervera_levin_mafe_gj_block.gif; organism: Planarians; photograph is Schmidtea mediterranea, empirical PlanformDB subset is Dugesia japonica; checkpoint commit: https://github.com/fractastical/morpholib/commit/a0d6848; environment: python 3.14.7, numpy 2.5.4, matplotlib 3.10.7, Pillow 12.0.0, scipy 1.16.3, scikit-image 0.26.0; other sources: Smediterranea.jpg, from A Low Percent Ethanol Method for Immobilizing Planarians <https://commons.wikimedia.org/wiki/File:Smediterranea.jpg>, MesmerPrism/rusty-matter planarian bioelectric circuit and fixtures <https://github.com/MesmerPrism/rusty-matter/tree/ad111fa7ecfd8f43d292ff3b1d27d3af2741d828>" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.bioelechem.2019.107410>,
            <https://doi.org/10.1016/j.biosystems.2021.104511>,
            <https://doi.org/10.1016/j.bpj.2019.01.029>,
            <https://doi.org/10.1016/j.ydbio.2009.12.012>,
            <https://doi.org/10.1093/bioinformatics/btt088> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-17-cervera-audit-v2-cervera-levin-mafe-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-17-cervera-audit-v2-cervera-levin-mafe-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-17-cervera-audit-v2-cervera-levin-mafe-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/2026-10-17-cervera-audit-v2-cervera-levin-mafe-overall>,
            <https://w3id.org/probknow/resource/assessment/2026-10-17-cervera-audit-v2-cervera-levin-mafe-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-17-cervera-audit-v2-cervera-levin-mafe-repro-package>,
            <https://w3id.org/probknow/resource/assessment/2026-10-17-cervera-audit-v2-cervera-levin-mafe-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-17-cervera-audit-v2-cervera-levin-mafe-specimen-match> ;
        pk:weightOfEvidence "0.556"^^xsd:double .
}


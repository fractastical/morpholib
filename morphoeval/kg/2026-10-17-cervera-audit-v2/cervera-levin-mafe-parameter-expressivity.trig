sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cervera-levin-mafe> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Parameter expressivity: 58/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Both named reaction–diffusion factors now have visible monotonic effects across stated sweeps: decreasing f2 advances x* and the silhouette's anterior area share, while decreasing f3 sharply lowers the ML centre/edge concentration ratio. The self-test asserts both monotonic f2 response and a non-inert f3 range, and panel E shows the profiles rather than a misleading 2D surface. Credit is limited because f3 changes only an independently normalized concentration curve and is never translated into lateral head or auricle form; morphology remains a binary cartoon switch. The circuit's crop-specific wound gains also remain a fixed lookup rather than an independently tested parameterization." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gpt-5.6-sol> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-parameter-expressivity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-parameter-expressivity-5> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L302–L318" ;
        dct:description "single definitions of f2 wavefront and f3 centre/edge index" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L302-L318> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L965–L973" ;
        dct:description "f2 sweep computes both wavefront and real-mask area share" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L965-L973> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L1055–L1064" ;
        dct:description "f3 sweep produces nonconstant ML profiles and lambda values" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L1055-L1064> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L1310–L1337" ;
        dct:description "panel E visibly presents the two independent parameter curves" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L1310-L1337> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-parameter-expressivity-5> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L1422–L1428" ;
        dct:description "self-test checks f2 monotonicity and f3 sensitivity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L1422-L1428> .
    <https://w3id.org/probknow/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT-5.6 Sol (Cursor agent)" ;
        dct:identifier "gpt-5.6-sol" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://openai.com> .
}


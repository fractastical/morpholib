sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cervera-levin-mafe> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Model fidelity to source: 45/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "The program now accurately describes itself as a qualitative analogue built from the abstract and presentation, and explicitly disclaims equation, boundary-condition and parameter fidelity. Its high-level structure remains consistent with accessible source text: two antagonistic axial signals, an independent orthogonal signal and reduced effective diffusion under GJ block. f3 now genuinely changes D3 and an ML profile, replacing the false 2D heatmap with two honest independent curves. This still cannot score as a reproduction of the published model: the full 2021 paper was unavailable, the local solver docstring still says it implements the paper's system, no published equation or constants are verified, and m3 is not coupled to a morphological outcome. The rusty-matter port remains a separate unpublished educational model rather than the cited 2020 ion-channel model." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gpt-5.6-sol> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-model-fidelity-5> ;
        pk:hasScore "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L27–L47" ;
        dct:description "scope statement distinguishes qualitative analogue, educational port and measured silhouette" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L27-L47> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L213–L318" ;
        dct:description "implemented AP and ML solvers, centralized constants and f2/f3 mappings" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L213-L318> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L230–L234" ;
        dct:description "function docstring still attributes the unverified equations directly to Cervera 2021" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L230-L234> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L1055–L1064" ;
        dct:description "f3 now drives D3 and a nonconstant lateral index, explicitly independent of AP" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L1055-L1064> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "datasets/planform/README.md L21–L27" ;
        dct:description "repository source boundary describes both mechanisms as qualitative or semi-quantitative abstractions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/datasets/planform/README.md#L21-L27> .
    <https://w3id.org/probknow/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT-5.6 Sol (Cursor agent)" ;
        dct:identifier "gpt-5.6-sol" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://openai.com> .
}


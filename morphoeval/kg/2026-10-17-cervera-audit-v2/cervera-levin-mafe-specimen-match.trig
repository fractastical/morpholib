sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cervera-levin-mafe> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Morphological realism / specimen match: 42/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "The real Schmidtea silhouette is now used for an area measurement as well as a backdrop, and the regenerated figure is more legible than the previous version. Wild type and double head remain visibly distinct. But the body outline never changes, no real treated or double-head specimen or source-paper morphology is shown, and the model does not generate head or auricle form. Crossing a threshold merely swaps between two pre-existing Planform cartoons; measuring coloured territory area improves quantification, not anatomical realism. Thus the central specimen-match requirement remains mostly unmet." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gpt-5.6-sol> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-specimen-match-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-specimen-match-5> ;
        pk:hasScore "0.42"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L150–L207" ;
        dct:description "photograph is segmented into the fixed mask on which signals are painted" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L150-L207> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L354–L362" ;
        dct:description "new morphometric is the mask area lying anterior to the one-dimensional signal crossing" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L354-L362> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L795–L869" ;
        dct:description "outcomes remain fixed WT and double-head Planform graph cartoons" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L795-L869> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L1511–L1519" ;
        dct:description "GIF threshold selects one of the two cartoons rather than deforming anatomy" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L1511-L1519> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-specimen-match-5> a pk:EvidenceItem ;
        rdfs:label "cervera_levin_mafe_bioelectric_morphospace.png (generated output)" ;
        dct:description "regenerated six-panel figure is legible but contains no real phenotype comparison — cervera_levin_mafe_bioelectric_morphospace.png: rendered output of 2021-Cervera–Levin–Mafe.py at a0d6848, image/png, 547708 B, 2330×1781 px, artifact_sha256 3f521835636f3530ddf73b0ea3142db13d605b319aac93fc940e3d8f07fc5f77 (sha256 3f521835636f3530ddf73b0ea3142db13d605b319aac93fc940e3d8f07fc5f77), spec_fingerprint ca184becec2bf47d8a969d42711868cd85769dd013f7492905afdaf9707bf2fc" .
    <https://w3id.org/probknow/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT-5.6 Sol (Cursor agent)" ;
        dct:identifier "gpt-5.6-sol" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://openai.com> .
}


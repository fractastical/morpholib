sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cervera-levin-mafe> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Reproducibility package: 84/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "The environment exactly matched the recorded Python and five package versions, dependencies are locked, inputs are hash checked, and two complete runs produced byte-identical PNG, CSV and 46-frame GIF. The expanded self-test checks symmetry, f2 monotonicity, f3 sensitivity and every crop CSV wavefront, while port parity now compares all 11 frames and four state fields for every scenario and accurately says this is not biological validation. The package is held below a higher score because the test only checks that the fit metrics are finite, not correct; it misses the f2 inverse defect that prints 0.20 instead of the approximately 0.42 crossing; and it does not verify stale panel-D labels. The full prescribed repeat also took about 12.5 minutes, mostly because self-test renders the complete analysis figure." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gpt-5.6-sol> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-7> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "requirements.lock.txt L18–L41" ;
        dct:description "tested scientific dependencies are pinned" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/requirements.lock.txt#L18-L41> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L700–L770" ;
        dct:description "hash verification and all-frame, all-field port parity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L700-L770> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L1412–L1442" ;
        dct:description "expanded self-test, including CSV recomputation but no assertion of expected fit or inverse threshold" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L1412-L1442> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L341–L351" ;
        dct:description "clipped target inversion returns the lower bound for target=1" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L341-L351> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-5> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L1537–L1587" ;
        dct:description "headless-capable CLI and correctly scoped self-test output" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a0d6848/2021-Cervera–Levin–Mafe.py#L1537-L1587> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-6> a pk:EvidenceItem ;
        rdfs:label "cervera_levin_mafe_bioelectric_morphospace.png (generated output)" ;
        dct:description "regenerated byte-identically in two independent runs — cervera_levin_mafe_bioelectric_morphospace.png: rendered output of 2021-Cervera–Levin–Mafe.py at a0d6848, image/png, 547708 B, 2330×1781 px, artifact_sha256 3f521835636f3530ddf73b0ea3142db13d605b319aac93fc940e3d8f07fc5f77 (sha256 3f521835636f3530ddf73b0ea3142db13d605b319aac93fc940e3d8f07fc5f77), spec_fingerprint ca184becec2bf47d8a969d42711868cd85769dd013f7492905afdaf9707bf2fc" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-repro-package-7> a pk:EvidenceItem ;
        rdfs:label "cervera_levin_mafe_metrics.csv (generated output)" ;
        dct:description "regenerated byte-identically with direct solver wavefronts — cervera_levin_mafe_metrics.csv: rendered output of 2021-Cervera–Levin–Mafe.py at a0d6848, text/csv, 5146 B, artifact_sha256 36e3036d0379d9fcb3bd1b4c646d04092c959c5ed03387d4937d8ac7d461afee (sha256 36e3036d0379d9fcb3bd1b4c646d04092c959c5ed03387d4937d8ac7d461afee), spec_fingerprint ca184becec2bf47d8a969d42711868cd85769dd013f7492905afdaf9707bf2fc" .

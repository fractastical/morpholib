sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cooksonia pertoni Turing wavelength at 1.3 µm (425 Ma) — Model fidelity to source: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Unchanged from pass 1. Jacobian trace -0.172 and det 0.922, dispersion Pearson r = 1.000 (RMSE 1.4e-4) on modes 3-8 against the discrete Laplacian, equal-diffusion predecessor stable. The new imprint uses the axial cut of the same activator field; it does not add a second law. The 1.339 µm scale is still imposed by the length unit." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity-4> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py L95–L144" ;
        dct:description "Jacobian and sigma_+(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d80cc9da2650b08c89dee19e5506350ec29b0f2e/models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py#L95-L144> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py L187–L240" ;
        dct:description "finite-difference growth rates on the discrete Laplacian" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d80cc9da2650b08c89dee19e5506350ec29b0f2e/models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py#L187-L240> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py L457–L475" ;
        dct:description "axial cut of u darkened onto the axis after spectral matching" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d80cc9da2650b08c89dee19e5506350ec29b0f2e/models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py#L457-L475> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3153_cooksonia_pertoni_turing_wavelength_s0.lean L5–L33" ;
        dct:description "trace, det, ratio 10 above threshold, ratio 8 below, 1339 nm < 72720 nm" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d80cc9da2650b08c89dee19e5506350ec29b0f2e/morphoeval/lean/loops/Loop_3153_cooksonia_pertoni_turing_wavelength_s0.lean#L5-L33> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, pass 2 after band imprint and angle refinement)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-repro-package-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py L887–L916" ;
        dct:description "self_test assertions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d80cc9da2650b08c89dee19e5506350ec29b0f2e/models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py#L887-L916> .

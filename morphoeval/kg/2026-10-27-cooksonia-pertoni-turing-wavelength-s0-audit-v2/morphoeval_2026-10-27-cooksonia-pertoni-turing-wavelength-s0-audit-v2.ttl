        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity-4> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Cooksonia pertoni Turing wavelength at 1.3 µm (425 Ma) — Morphometric validation: 89/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Dispersion Pearson r = 1.000, RMSE 1.4e-4. Specimen radial Pearson r rose from 0.9865 to 0.9882. Gray KS remains about 0.028. Branch angles are no longer snapped to a 2.5 degree grid: Amgueddfa 69.97 degrees, NMNH 68.03 degrees, drawn axis 64.37 degrees, so value is not equal to reference. Successor wavelength 1.695 µm. Stripe-spacing CV of the pure mode is 0, reported against a 0.05 tracing tolerance rather than copied onto the value. Still one photograph pair and no published tracheid spacing to hit." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Cooksonia pertoni Turing wavelength at 1.3 µm (425 Ma) — Morphological realism / specimen match: 84/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Pass 1 CV similarity was 95.4 with a smooth axis. Pass 2 CV similarity is 95.8 after the wall-band imprint, at 12 frames and 720x540. The bands are low contrast: they read as a periodic darkening along the branches, not as a resolved micrograph of 1.3 µm thickenings. Amgueddfa template angle is now 69.97 degrees against the drawn 64.37 degrees. The matrix is still a spectral match, not a pixel registration, so the score stays in the mid-80s." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-specimen-match-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-specimen-match-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-specimen-match-3> ;
    pk:hasScore 8.4e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Cooksonia pertoni Turing wavelength at 1.3 µm (425 Ma) (Cooksonia pertoni)",
        "Cooksonia pertoni Turing wavelength at 1.3 µm (425 Ma) faithfully reproduces Cooksonia pertoni morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-cooksonia-pertoni-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-cooksonia-pertoni-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-cooksonia-pertoni-turing-wavelength-s0-3> ;
    dct:description "The simulation script(s) models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Cooksonia pertoni specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py> ;
    schema:about "Cooksonia pertoni" ;
    schema:additionalProperty "does_not_claim: That Cooksonia had animal-style ocelli.",
        "does_not_claim: That the 73 µm sibling parameters apply at this scale.",
        "does_not_claim: That the photograph resolves 1.3 µm wall bands.",
        "does_not_claim: That this pass was scored by a second model, or that the nanopubs are signed.",
        "reconstructed_in_script: Isotomous axis on a spectrum-matched matrix, with the axial Turing cut darkened on top.",
        "reconstructed_in_script: Parameters chosen so the fastest mode is 1.339 µm.",
        "reconstructed_in_script: Successor D_u raised from 0.055 to 0.088 at fixed ratio.",
        "reported_in_source: Edwards 2003: early tracheophyte walls are annular, spiral or scalariform-like.",
        "reported_in_source: Edwards, Davies & Axe 1992: C. pertoni has a vascular strand with annular to spiral tracheids.",
        "reported_in_source: Turing 1952 dispersion relation and Schnakenberg 1979 kinetics.",
        "transfer_boundary: 1.3 µm is the assigned detail scale, not an Edwards measurement.",
        "transfer_boundary: The museum slab is a centimetre-scale compression; the bands on the GIF are a magnified display of the selected mode." ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Cooksonia pertoni (Late Silurian (Wenlock-Ludlow, 425 Ma))" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "III. Phyta (Embryophyta)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;
    pk:aristotelianSubalternClass "Angiospermae & Gymnospermae" ;
    pk:biologicalGenus "Cooksonia" ;

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Cooksonia pertoni Turing wavelength at 1.3 µm (425 Ma) — Model fidelity to source: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Unchanged from pass 1. Jacobian trace -0.172 and det 0.922, dispersion Pearson r = 1.000 (RMSE 1.4e-4) on modes 3-8 against the discrete Laplacian, equal-diffusion predecessor stable. The new imprint uses the axial cut of the same activator field; it does not add a second law. The 1.339 µm scale is still imposed by the length unit." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-cooksonia-pertoni-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-cooksonia-pertoni-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-cooksonia-pertoni-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-cooksonia-pertoni-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Jacobian trace is negative without diffusion" ;
    dct:description "Homogeneous steady state is stable in the absence of diffusion at 1.339 µm | Variables: a = 3/25, b = 21/25" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0; Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d80cc9da2650b08c89dee19e5506350ec29b0f2e/models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/d80cc9da2650b08c89dee19e5506350ec29b0f2e/morphoeval/lean/loops/Loop_3153_cooksonia_pertoni_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "tr J = f_u + g_v = 3/4 - 576/625 < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/357683a0>,
        <https://doi.org/10.1038/37918>,
        <https://doi.org/10.1046/j.1365-3040.2003.00878.x>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3153.jacobian_trace_negative" ;
    pk:leanTheorem "MathOfBiology.Loop_3153.jacobian_trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-cooksonia-pertoni-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diffusion ratio 10 is above the Turing threshold" ;
    dct:description "Selects a finite wavenumber only after the 425 Ma conducting strand; the equal-diffusion predecessor does not | Variables: D_u = 0.055, D_v = 0.55" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Edwards, Davies & Axe 1992 DOI:10.1038/357683a0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d80cc9da2650b08c89dee19e5506350ec29b0f2e/models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/d80cc9da2650b08c89dee19e5506350ec29b0f2e/morphoeval/lean/loops/Loop_3153_cooksonia_pertoni_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(D_v f_u + D_u g_v)^2 > 4 D_u D_v det J at D_v/D_u = 10, and the inequality fails at ratio 8" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/357683a0>,
        <https://doi.org/10.1038/37918>,
        <https://doi.org/10.1046/j.1365-3040.2003.00878.x>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3153.ratio_ten_above_threshold" ;
    pk:leanTheorem "MathOfBiology.Loop_3153.ratio_eight_below_threshold" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-cooksonia-pertoni-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail wavelength is not the cellular sibling" ;
    dct:description "Keeps slot 3153 distinct from the 73 µm Cooksonia Turing slot | Variables: xi chosen so 2*pi/k_c maps to 1.339 µm" ;
    dct:source "Edwards 2003 DOI:10.1046/j.1365-3040.2003.00878.x" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d80cc9da2650b08c89dee19e5506350ec29b0f2e/models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/d80cc9da2650b08c89dee19e5506350ec29b0f2e/morphoeval/lean/loops/Loop_3153_cooksonia_pertoni_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 1.339e-6 m = 1339 nm, sibling cellular slot 7.272e-5 m = 72720 nm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/357683a0>,
        <https://doi.org/10.1038/37918>,
        <https://doi.org/10.1046/j.1365-3040.2003.00878.x>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3153.detail_wavelength_below_cellular_sibling" ;
    pk:leanTheorem "MathOfBiology.Loop_3153.detail_wavelength_below_cellular_sibling" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Cooksonia pertoni Turing wavelength at 1.3 µm (425 Ma) — MorphoEval overall 86.6/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Same Schnakenberg system as pass 1 (k_c=2.356, lambda_c=1.339 µm at 425 Ma, predecessor sigma_max=-0.086, Rhynia successor lambda_c=1.695 µm). Pass 2 imprints the axial Turing cut on the axis after spectral matching, and replaces the 2.5 degree angle grid with a quadratic peak. Specimen radial Pearson r is 0.988. GIF computer-vision similarity to the Amgueddfa compression is 95.8 at 720x540 and 12 frames. Dispersion Pearson r remains 1.000. Still one assessor, and still unsigned. Overall 86.6/100 (faithfulness 86.2, reproducibility 87.6); rubric morphoeval 0.1.0; checkpoint commit d80cc9da2650b08c89dee19e5506350ec29b0f2e; environment: . Dimension assessments: Model fidelity to source 86, Morphological realism / specimen match 84, Parameter expressivity 88, Morphometric validation 89, Source and data traceability 90, Code-to-model traceability 87, Reproducibility package 86. Output judged: docs/media/cooksonia_pertoni_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py at d80cc9da2650b08c89dee19e5506350ec29b0f2e, image/png, 624221 B, 1344×1008 px, artifact_sha256 93e88f9e5d0b1916ed5ac99e152f066fa81e55e1cdb7c84aa9cb4d4df4141a54 (sha256 93e88f9e5d0b1916ed5ac99e152f066fa81e55e1cdb7c84aa9cb4d4df4141a54), spec_fingerprint 0469116f4f2b9848b31bd188b5d42585042d519d8571ea93be197af7958cd169. Dual provenance: spec_fingerprint: 0469116f4f2b9848b31bd188b5d42585042d519d8571ea93be197af7958cd169; artifact_sha256: 93e88f9e5d0b1916ed5ac99e152f066fa81e55e1cdb7c84aa9cb4d4df4141a54; input_dataset_sha256: {datasets/cooksonia_pertoni_turing_wavelength_s0/cooksonia_pertoni_amgueddfa_specimen.jpg=aa48bf1c9b50b41d..., datasets/cooksonia_pertoni_turing_wavelength_s0/cooksonia_pertoni_nmnh_specimen.jpg=6c6d03579c80de68..., datasets/cooksonia_pertoni_turing_wavelength_s0/cooksonia_pertoni_turing_wavelength_s0_reference.json=93a1a0f57016c745...}. Supersedes audit: 2026-10-27-cooksonia-pertoni-turing-wavelength-s0-audit. Claim boundary: reported_in_source: Edwards, Davies & Axe 1992: C. pertoni has a vascular strand with annular to spiral tracheids. | Turing 1952 dispersion relation and Schnakenberg 1979 kinetics. | Edwards 2003: early tracheophyte walls are annular, spiral or scalariform-like.; reconstructed_in_script: Parameters chosen so the fastest mode is 1.339 µm. | Successor D_u raised from 0.055 to 0.088 at fixed ratio. | Isotomous axis on a spectrum-matched matrix, with the axial Turing cut darkened on top.; transfer_boundary: 1.3 µm is the assigned detail scale, not an Edwards measurement. | The museum slab is a centimetre-scale compression; the bands on the GIF are a magnified display of the selected mode.; does_not_claim: That Cooksonia had animal-style ocelli. | That the photograph resolves 1.3 µm wall bands. | That the 73 µm sibling parameters apply at this scale. | That this pass was scored by a second model, or that the nanopubs are signed.." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: {'id': 'R1', 'item': 'Closed in pass 2. imprint_wall_bands runs after match_shell_power. CV similarity 95.8. Bands are low contrast.', 'status': 'closed'}",
            "remediation needed: {'id': 'R2', 'item': 'Closed in pass 2. Template is 141 angles and a quadratic peak: Amgueddfa 69.97 degrees, NMNH 68.03 degrees.', 'status': 'closed'}",
            "remediation needed: {'id': 'R3', 'item': 'Open. No independent second assessor. This pass is still builder-scored.', 'status': 'open'}",
            "remediation needed: {'id': 'R4', 'item': 'Open. ~/.nanopub/profile.yml is absent. Nanopubs were built for conformance and were not signed.', 'status': 'open'}" ;
        pk:hasScore "0.866"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, pass 2 after band imprint and angle refinement)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Cooksonia pertoni Turing wavelength at 1.3 µm (425 Ma) — Morphological realism / specimen match: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 1 CV similarity was 95.4 with a smooth axis. Pass 2 CV similarity is 95.8 after the wall-band imprint, at 12 frames and 720x540. The bands are low contrast: they read as a periodic darkening along the branches, not as a resolved micrograph of 1.3 µm thickenings. Amgueddfa template angle is now 69.97 degrees against the drawn 64.37 degrees. The matrix is still a spectral match, not a pixel registration, so the score stays in the mid-80s." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/cooksonia_pertoni_turing_wavelength_s0_growth.gif (generated output)" ;
        dct:description "12-frame 720x540 GIF with low-contrast axial bands — docs/media/cooksonia_pertoni_turing_wavelength_s0_growth.gif: rendered output of models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py at d80cc9da2650b08c89dee19e5506350ec29b0f2e, image/gif, 5887468 B, 720×540 px, 12 frames, artifact_sha256 cf9f5da25f5ea4460c7aea83e0ff4d42ca7f7d629c22185abb47e43a6999fc08 (sha256 cf9f5da25f5ea4460c7aea83e0ff4d42ca7f7d629c22185abb47e43a6999fc08), spec_fingerprint 0469116f4f2b9848b31bd188b5d42585042d519d8571ea93be197af7958cd169" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/cooksonia_pertoni_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "specimen, activator, dispersion, sweep — docs/media/cooksonia_pertoni_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py at d80cc9da2650b08c89dee19e5506350ec29b0f2e, image/png, 624221 B, 1344×1008 px, artifact_sha256 93e88f9e5d0b1916ed5ac99e152f066fa81e55e1cdb7c84aa9cb4d4df4141a54 (sha256 93e88f9e5d0b1916ed5ac99e152f066fa81e55e1cdb7c84aa9cb4d4df4141a54), spec_fingerprint 0469116f4f2b9848b31bd188b5d42585042d519d8571ea93be197af7958cd169" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py L508–L516" ;

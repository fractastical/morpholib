sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Schnakenberg–Turing critical wavelength for Drosophila erecta at 2.262 µm (Pass 1) faithfully reproduces Drosophila erecta morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-erecta-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila erecta specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-erecta-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-erecta-turing-wavelength-s0.py; output: docs/media/drosophila_erecta_turing_wavelength_s0_comparison.png; organism: Drosophila erecta; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion relation | Schnakenberg 1979 kinetics | Yassin et al. 2016 tan balancing selection in female D. erecta | Gallery image has a drawn 100 µm scale bar; reconstructed_in_script: Du, Dv chosen so lambda_c = 2.262 µm at a=0.17, b=0.93, delta=16 | Dark and light morphs as two values of a | J0 disk mode fitted to the gallery radial profile; transfer_boundary: 2.262 µm is the assigned detail tier, not a length reported by Yassin et al. | The gallery dark ring is a ~97 µm annulus, not the 2.262 µm mode; does_not_claim: Does not claim elegans or eugracilis differ in geological age (all 0 Ma) | Does not claim a CC wild photograph was found | Does not claim the tan enhancer sets Dv/Du]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/ncomms10400>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-erecta-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-erecta-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg–Turing critical wavelength for Drosophila erecta at 2.262 µm (Pass 1) — MorphoEval overall 74.2/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 1 implements k_c at the assigned 2.262 µm detail tier (age 0 Ma) and fits a damped J0 disk mode to the gallery annulus. Sweep, ablation, and KS numbers are computed in the script but were not yet the basis of the score. The gallery image is not a wild-caught photograph. Overall 74.2/100 (faithfulness 71.0, reproducibility 81.6); rubric morphoeval 0.1.0; checkpoint commit 0c76d15d14afcec6c366e1b9274a6586a0de48fc; environment: . Dimension assessments: Model fidelity to source 78, Morphological realism / specimen match 70, Parameter expressivity 64, Morphometric validation 68, Source and data traceability 88, Code-to-model traceability 76, Reproducibility package 80. Output judged: docs/media/drosophila_erecta_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-drosophila-erecta-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/png, 637721 B, 1380×984 px, artifact_sha256 e24b0d85978700ec78d0f2f734fb63f541d56e137659633304cce79fe82c81eb (sha256 e24b0d85978700ec78d0f2f734fb63f541d56e137659633304cce79fe82c81eb), spec_fingerprint 944cf6527af7b0d5c21d4cf33a0403c90ad4f3ca2ab561dcf67e43e4ef7022f3. Dual provenance: spec_fingerprint: 944cf6527af7b0d5c21d4cf33a0403c90ad4f3ca2ab561dcf67e43e4ef7022f3; artifact_sha256: e24b0d85978700ec78d0f2f734fb63f541d56e137659633304cce79fe82c81eb; input_dataset_sha256: {datasets/drosophila_erecta_turing_wavelength_s0/drosophila_erecta_specimen.jpg=ef1ddb031fefd5f8..., datasets/drosophila_erecta_turing_wavelength_s0/drosophila_erecta_turing_wavelength_s0_reference.json=db334ff62f6ae794..., datasets/drosophila_erecta_turing_wavelength_s0/paper_citations.bib=2b2bacd184e5772d...}. Claim boundary: reported_in_source: Turing 1952 dispersion relation | Schnakenberg 1979 kinetics | Yassin et al. 2016 tan balancing selection in female D. erecta | Gallery image has a drawn 100 µm scale bar; reconstructed_in_script: Du, Dv chosen so lambda_c = 2.262 µm at a=0.17, b=0.93, delta=16 | Dark and light morphs as two values of a | J0 disk mode fitted to the gallery radial profile; transfer_boundary: 2.262 µm is the assigned detail tier, not a length reported by Yassin et al. | The gallery dark ring is a ~97 µm annulus, not the 2.262 µm mode; does_not_claim: Does not claim elegans or eugracilis differ in geological age (all 0 Ma) | Does not claim a CC wild photograph was found | Does not claim the tan enhancer sets Dv/Du." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: {'id': 'R1', 'item': 'Score the δ sweep (4, 8, 12, 16, 24, 40) and require monotonic λ.'}",
            "remediation needed: {'id': 'R2', 'item': 'Report equal-diffusion and autocatalysis-ablation std ratios next to the critical-mode growth ratio.'}",
            "remediation needed: {'id': 'R3', 'item': 'Put Pearson r, RMSE, and KS on the gallery annulus in the measurement sidecar with reference anchors that are not copies of the measured values, and re-score the GIF with the 12-bin / 24-bin / coherency fitness function.'}",
            "remediation needed: {'id': 'R4', 'item': 'No second assessor from another provider. Left open.'}",
            "remediation needed: {'id': 'R5', 'item': 'No CC wild photograph of Drosophila erecta on Wikimedia or GBIF. Gallery fallback remains. Left open.'}" ;
        pk:hasScore "0.742"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 builder-assessor; no second provider scored this pass" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-economou-palate-ruguga-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Economou et al. (2012) FGF10/FGF7-SHH activator-inhibitor Turing stripe mechanism at mammalian palatal growth zones — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Faithfully implements the 2-component mesenchymal FGF activator + epithelial SHH inhibitor reaction Jacobian J_0 (tr = -0.4 < 0, det = +2.8 > 0), wavenumber dispersion curve Re(sigma(q)) and determinant polynomial Delta(q^2) (lambda_c = 3.2221), 9-stage sequential growth-zone intercalation (`8 -> 1..7b`, L198-246), and 2D growing palatal shelf PDE with coronal/sagittal surgical incisions, cyclopamine, FGF10 bead / Spry2/4 hyperactivation, and equal-diffusion negative control (L329-526). Backed by 3 machine-checked Lean 4 theorems in `Loop_008_palate_ruguga_turing.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2012-economou-palate-ruguga-turing.py L115–L246" ;
        dct:description "Exact FGF-SHH Jacobian J_0, dispersion curve Re(sigma(q)), and 9-stage ruga-8 growth-zone sequential intercalation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2012-economou-palate-ruguga-turing.py#L115-L246> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2012-economou-palate-ruguga-turing.py L329–L526" ;
        dct:description "2D growing palatal shelf PDE with coronal vs sagittal surgical incisions, cyclopamine, FGF10 bead, and equal-diffusion control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2012-economou-palate-ruguga-turing.py#L329-L526> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_008_palate_ruguga_turing.lean L14–L98" ;
        dct:description "3 machine-checked Lean 4 theorems (0 sorrys) for FGF-SHH Turing dispersion, sequential intercalation, and coronal cut release" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/morphoeval/lean/loops/Loop_008_palate_ruguga_turing.lean#L14-L98> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/8> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.ydbio.2009.09.028>,
            <https://doi.org/10.1038/ng.1090>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1186/1471-213X-8-116> .
    <https://doi.org/10.1016/j.ydbio.2009.09.028> dct:date "2009"^^xsd:gYear ;
        dct:title "Signaling integration in the rugae growth zone directs anteroposterior palatal outgrowth" .
    <https://doi.org/10.1038/ng.1090> dct:date "2012"^^xsd:gYear ;
        dct:title "Periodic stripe formation by a Turing mechanism operating at growth zones in the mammalian palate" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1186/1471-213X-8-116> dct:date "2008"^^xsd:gYear ;
        dct:title "Patterning of palatal rugae through sequential addition reveals an anterior/posterior boundary in palatal development" .
}


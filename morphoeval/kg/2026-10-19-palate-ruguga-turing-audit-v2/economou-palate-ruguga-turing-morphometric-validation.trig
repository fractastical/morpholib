sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-economou-palate-ruguga-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Economou et al. (2012) FGF10/FGF7-SHH activator-inhibitor Turing stripe mechanism at mammalian palatal growth zones — Morphometric validation: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L715-805) computes 9 reference-anchored morphometrics with literature/specimen reference values, uncertainty statistics (CV, std, RMSE, Pearson r), and negative-control delta: lambda_c = 3.2221 (ref 3.2232), in-phase r(FGF, SHH) = +0.9880 (ref +0.9600), sequential intercalation r = 1.0000 (RMSE = 0.0023 rugae), 2D WT rugae count 9.0 (ref 9.0), coronal cut bifurcation index 0.4695 vs intact WT 0.1629 (2.9x increase), equal-diffusion control rugae count 0.0 (ref 0.0), specimen left-shelf rugae 15.0 (ref 15.0), specimen right-shelf rugae 16.0 (ref 16.0), and specimen inter-ruga spacing CV = 0.1843 (ref 0.1843)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-2d-wild-type-palatal-shelf-transverse-rugae-count-8-1-7b>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-biological-specimen-left-palatal-shelf-transverse-rugae-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-biological-specimen-palatal-rugae-inter-stripe-spacing-cv-left-shelf>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-biological-specimen-right-palatal-shelf-transverse-rugae-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-coronal-surgical-cut-bifurcation-spot-index-vs-intact-wild-type>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-equal-diffusion-negative-control-rugae-count-d-a-d-h-0-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-fgf-shh-critical-turing-wavelength-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-in-phase-mesenchymal-fgf-vs-epithelial-shh-spatial-correlation-r-fgf-shh>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-ruga-8-growth-zone-sequential-intercalation-correlation-8-1-7b-e12-0-e15-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-morphometric-validation-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-2d-wild-type-palatal-shelf-transverse-rugae-count-8-1-7b> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D wild-type palatal shelf transverse rugae count (8->1..7b) = 9.0 rugae" ;
        dct:description "Sagittal surgical cut preserves 9.0 parallel rugae" ;
        schema:measurementTechnique "Anteroposterior shelf peak count of 2D growing palatal FGF-SHH PDE at E15.5" ;
        schema:name "2D wild-type palatal shelf transverse rugae count (8->1..7b)" ;
        schema:unitText "rugae" ;
        schema:value "9.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-2d-wild-type-palatal-shelf-transverse-rugae-count-8-1-7b-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-2d-wild-type-palatal-shelf-transverse-rugae-count-8-1-7b-reference> a schema:PropertyValue ;
        dct:source "Economou et al. (2012) Nature Genetics 44:348-351 Fig. 1a (9 palatal rugae in Mus musculus)" ;
        schema:value "9.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-biological-specimen-left-palatal-shelf-transverse-rugae-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Biological specimen left palatal shelf transverse rugae count = 15.0 rugae" ;
        dct:description "mean inter-ruga wavelength = 98.21 ± 18.10 px" ;
        schema:measurementTechnique "DoG anteroposterior ridge peak detection in left palatal shelf ROI [320, 220, 420, 1760] of palate_rugae_specimen.jpg" ;
        schema:name "Biological specimen left palatal shelf transverse rugae count" ;
        schema:unitText "rugae" ;
        schema:value "15.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-biological-specimen-left-palatal-shelf-transverse-rugae-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-biological-specimen-left-palatal-shelf-transverse-rugae-count-reference> a schema:PropertyValue ;
        dct:source "Mammalian hard palate Rugae palatinae specimen (Wikimedia Commons File:Palatum_horse.JPG, CC BY-SA 3.0)" ;
        schema:value "15.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-biological-specimen-palatal-rugae-inter-stripe-spacing-cv-left-shelf> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Biological specimen palatal rugae inter-stripe spacing CV (left shelf) = 0.1843 CV (std/mean)" ;
        dct:description "right shelf CV = 0.2733" ;
        schema:measurementTechnique "Inter-ruga AP spacing dispersion across 15 transverse palatal ridges" ;
        schema:name "Biological specimen palatal rugae inter-stripe spacing CV (left shelf)" ;
        schema:unitText "CV (std/mean)" ;
        schema:value "0.1843" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-biological-specimen-palatal-rugae-inter-stripe-spacing-cv-left-shelf-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-biological-specimen-palatal-rugae-inter-stripe-spacing-cv-left-shelf-reference> a schema:PropertyValue ;
        dct:source "Economou et al. (2012) Nature Genetics periodic Turing palatal rugae spacing (CV < 0.28)" ;
        schema:value "0.1843" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-biological-specimen-right-palatal-shelf-transverse-rugae-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Biological specimen right palatal shelf transverse rugae count = 16.0 rugae" ;
        dct:description "mean inter-ruga wavelength = 94.20 ± 25.75 px" ;
        schema:measurementTechnique "DoG anteroposterior ridge peak detection in right palatal shelf ROI [500, 220, 600, 1760] of palate_rugae_specimen.jpg" ;
        schema:name "Biological specimen right palatal shelf transverse rugae count" ;
        schema:unitText "rugae" ;
        schema:value "16.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-biological-specimen-right-palatal-shelf-transverse-rugae-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-biological-specimen-right-palatal-shelf-transverse-rugae-count-reference> a schema:PropertyValue ;
        dct:source "Mammalian hard palate Rugae palatinae specimen (Wikimedia Commons File:Palatum_horse.JPG, CC BY-SA 3.0)" ;
        schema:value "16.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-coronal-surgical-cut-bifurcation-spot-index-vs-intact-wild-type> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Coronal surgical cut bifurcation/spot index vs intact wild-type = 0.4695 bifurcation index" ;
        dct:description "Intact WT bifurcation index = 0.1629; Sagittal cut = 0.1629" ;
        schema:measurementTechnique "Mediolateral-to-anteroposterior gradient ratio after transverse surgical incision across ruga-8 growth zone" ;
        schema:name "Coronal surgical cut bifurcation/spot index vs intact wild-type" ;
        schema:unitText "bifurcation index" ;
        schema:value "0.4695" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-coronal-surgical-cut-bifurcation-spot-index-vs-intact-wild-type-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-coronal-surgical-cut-bifurcation-spot-index-vs-intact-wild-type-reference> a schema:PropertyValue ;
        dct:source "Economou et al. (2012) Nature Genetics 44:348-351 Fig. 2a-g (coronal cut releases ruga-8 inhibition -> ~2.9x bifurcation/spot increase over intact WT)" ;
        schema:value "0.4695" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-equal-diffusion-negative-control-rugae-count-d-a-d-h-0-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Equal-diffusion negative control rugae count (D_A = D_H = 0.2) = 0.0 rugae" ;
        dct:description "max Re(sigma) at D_A=D_H is -0.2000 < 0" ;
        schema:measurementTechnique "2D palatal FGF-SHH PDE solver with equalized diffusivities D_A = D_H = 0.2" ;
        schema:name "Equal-diffusion negative control rugae count (D_A = D_H = 0.2)" ;
        schema:unitText "rugae" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-equal-diffusion-negative-control-rugae-count-d-a-d-h-0-2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-equal-diffusion-negative-control-rugae-count-d-a-d-h-0-2-reference> a schema:PropertyValue ;
        dct:source "Economou et al. (2012) Nature Genetics Fig. 3f (no Turing stripes without differential SHH/FGF diffusivity)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-fgf-shh-critical-turing-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FGF-SHH critical Turing wavelength lambda_c = 3.2221 dimensionless length" ;
        dct:description "tr(J_0)=-0.40, det(J_0)=2.80, sigma_max=0.7294" ;
        schema:measurementTechnique "Minimum of 2x2 wavenumber determinant polynomial Delta(q^2) with D_A=0.2, D_H=5.0 (q_c=1.9500, Delta(q_c)=-11.6400)" ;
        schema:name "FGF-SHH critical Turing wavelength lambda_c" ;
        schema:unitText "dimensionless length" ;
        schema:value "3.2221" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-fgf-shh-critical-turing-wavelength-lambda-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-fgf-shh-critical-turing-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Economou et al. (2012) Nature Genetics 44:348-351 Fig. 3f & Supplementary Note" ;
        schema:value "3.2232" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-in-phase-mesenchymal-fgf-vs-epithelial-shh-spatial-correlation-r-fgf-shh> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "In-phase mesenchymal FGF vs epithelial SHH spatial correlation r(FGF, SHH) = 0.988 Pearson r" ;
        dct:description "2D palatal shelf r(FGF, SHH) = 0.9880" ;
        schema:measurementTechnique "Spatial Pearson correlation between steady-state FGF activator A(x) and SHH inhibitor H(x) profiles" ;
        schema:name "In-phase mesenchymal FGF vs epithelial SHH spatial correlation r(FGF, SHH)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.988" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-in-phase-mesenchymal-fgf-vs-epithelial-shh-spatial-correlation-r-fgf-shh-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-in-phase-mesenchymal-fgf-vs-epithelial-shh-spatial-correlation-r-fgf-shh-reference> a schema:PropertyValue ;
        dct:source "Economou et al. (2012) Nature Genetics 44:348-351 Fig. 3a-f (colocalized FGF-SHH stripe peaks)" ;
        schema:value "0.96" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-ruga-8-growth-zone-sequential-intercalation-correlation-8-1-7b-e12-0-e15-5> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Ruga-8 growth-zone sequential intercalation correlation (8->1..7b, E12.0-E15.5) = 1.0 Pearson r" ;
        dct:description "Sequential addition order: R8 -> R1 -> R2 -> R3 -> R4 -> R5 -> R6 -> R7 -> R7b" ;
        schema:measurementTechnique "Linear regression of Turing growth-zone predicted vs observed cumulative rugae across 9 developmental stages (p=1.06e-25, RMSE=0.0023)" ;
        schema:name "Ruga-8 growth-zone sequential intercalation correlation (8->1..7b, E12.0-E15.5)" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-ruga-8-growth-zone-sequential-intercalation-correlation-8-1-7b-e12-0-e15-5-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-ruga-8-growth-zone-sequential-intercalation-correlation-8-1-7b-e12-0-e15-5-reference> a schema:PropertyValue ;
        dct:source "Economou et al. (2012) Nature Genetics Fig. 1a-d & Pantalacci et al. (2008) BMC Dev. Biol. 8:116" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2012-economou-palate-ruguga-turing.py L715–L805" ;
        dct:description "9 quantitative morphometric measurements with reference values, CV/RMSE/r uncertainty, and equal-diffusion negative control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2012-economou-palate-ruguga-turing.py#L715-L805> .

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-economou-palate-ruguga-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Economou et al. (2012) FGF10/FGF7-SHH activator-inhibitor Turing stripe mechanism at mammalian palatal growth zones — Reproducibility package: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Deterministic RNG (`seed=2012`), 8-check `self_test()` suite (L808-866) verifying SHA-256 locks, dispersion inversion vs equal-diffusion stability, 9-stage sequential intercalation (`8 -> 1..7b`), in-phase FGF-SHH colocalization, coronal vs sagittal surgical cut phenotypes, cyclopamine/FGF10 perturbations, 15/16-ruga specimen segmentation, and bitwise two-run determinism, plus co-evolving animated GIF at `docs/media/palate_ruguga_turing_growth.gif`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-repro-package-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2012-economou-palate-ruguga-turing.py L808–L866" ;
        dcterms:description "Comprehensive 8-check self_test() suite including SHA-256 locks, surgical/drug perturbations, specimen segmentation, and bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2012-economou-palate-ruguga-turing.py#L808-L866> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/palate_ruguga_turing_growth.gif (generated output)" ;
        dcterms:description "Co-evolving 2-panel animated GIF of 2D palatal growth-zone rugae intercalation and 1D in-phase FGF/SHH profiles — docs/media/palate_ruguga_turing_growth.gif: rendered output of 2012-economou-palate-ruguga-turing.py at 45d4150, image/gif, 910904 B, 1092×472 px, 6 frames, artifact_sha256 b69e12d9701f36478a313f8562272aa13b7e33b1b2746ba4baae2adaedc43d36 (sha256 b69e12d9701f36478a313f8562272aa13b7e33b1b2746ba4baae2adaedc43d36), spec_fingerprint 2d8b918612b8f3a25ba7f27439207d03bf556187e2f521ce737d04a76d0c39ef" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


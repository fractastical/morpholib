sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-economou-palate-ruguga-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Economou et al. (2012) FGF10/FGF7-SHH activator-inhibitor Turing stripe mechanism at mammalian palatal growth zones — Parameter expressivity: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates the 9-stage embryonic elongation trajectory (`E12.0` to `E15.5`, `R8 -> R1..R7b`, L198-246), simulates 6 distinct surgical and pharmacological regimes in 2D (intact WT, sagittal cut, coronal cut across ruga-8 growth zone, cyclopamine SHH blockade, Spry2/4 + FGF10 bead hyperactivation, and equal-diffusion D_A=D_H ablation control, L483-526), and exposes CLI flags `--a11`, `--a12`, `--a21`, `--a22`, `--D-ratio`, `--growth-rate`, `--seed`, `--skip-gif`, and `--self-test` (L838-870)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-parameter-expressivity-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2012-economou-palate-ruguga-turing.py L198–L246" ;
        dcterms:description "9-stage embryonic palatal elongation trajectory (8 -> 1..7b)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2012-economou-palate-ruguga-turing.py#L198-L246> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2012-economou-palate-ruguga-turing.py L483–L526" ;
        dcterms:description "6-condition 2D surgical incision and pharmacological perturbation suite" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2012-economou-palate-ruguga-turing.py#L483-L526> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


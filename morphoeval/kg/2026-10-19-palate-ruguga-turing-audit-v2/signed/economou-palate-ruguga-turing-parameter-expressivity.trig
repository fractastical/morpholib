    <https://doi.org/10.1016/j.ydbio.2009.09.028> dcterms:date "2009"^^xsd:gYear ;
        dcterms:title "Signaling integration in the rugae growth zone directs anteroposterior palatal outgrowth" .

    <https://doi.org/10.1038/ng.1090> dcterms:date "2012"^^xsd:gYear ;
        dcterms:title "Periodic stripe formation by a Turing mechanism operating at growth zones in the mammalian palate" .

    <https://doi.org/10.1098/rstb.1952.0012> dcterms:date "1952"^^xsd:gYear ;
        dcterms:title "The chemical basis of morphogenesis" .

    <https://doi.org/10.1186/1471-213X-8-116> dcterms:date "2008"^^xsd:gYear ;
        dcterms:title "Patterning of palatal rugae through sequential addition reveals an anterior/posterior boundary in palatal development" .

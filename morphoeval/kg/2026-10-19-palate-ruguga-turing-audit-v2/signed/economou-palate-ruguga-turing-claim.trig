sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-economou-palate-ruguga-turing> a pk:Claim ;
        rdfs:label "Economou et al. (2012) FGF10/FGF7-SHH activator-inhibitor Turing stripe mechanism at mammalian palatal growth zones faithfully reproduces Mammalian secondary hard palate (Mus musculus E12.0-E15.5 & Equus caballus Rugae palatinae) morphology" ;
        dcterms:description "The simulation script(s) 2012-economou-palate-ruguga-turing.py implement the cited source model as published and produce forms that match real Mammalian secondary hard palate (Mus musculus E12.0-E15.5 & Equus caballus Rugae palatinae) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 92.4/100, audit 2026-10-19-palate-ruguga-turing-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/45d4150/2012-economou-palate-ruguga-turing.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/45d4150/2012-economou-palate-ruguga-turing.py; output: docs/media/palate_ruguga_turing_comparison.png; organism: Mammalian secondary hard palate (Mus musculus E12.0-E15.5 & Equus caballus Rugae palatinae); checkpoint commit: https://github.com/fractastical/morpholib/commit/45d4150; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 2d8b918612b8f3a25ba7f27439207d03bf556187e2f521ce737d04a76d0c39ef; artifact_sha256: 160aa86a4bcc0206a11b1578d108b8818ba0b95fe2f48898a70fa448ec3bcce7; input_dataset_sha256: {datasets/palate_ruguga_turing/palate_rugae_specimen.jpg=a38f6c053ffe9048..., datasets/palate_ruguga_turing/palate_ruguga_turing_reference.json=e76e670dd50c86fe..., datasets/palate_ruguga_turing/paper_citations.bib=fd020997fb3c2db0..., datasets/palate_ruguga_turing/scout_manifest.json=f0a345a5c9039e78...}; supersedes_audit_id: 2026-10-19-palate-ruguga-turing-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.ydbio.2009.09.028>,
            <https://doi.org/10.1038/ng.1090>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1186/1471-213X-8-116> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-specimen-match> ;
        pk:weightOfEvidence "0.924"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/45d4150/2012-economou-palate-ruguga-turing.py> a schema:SoftwareSourceCode ;

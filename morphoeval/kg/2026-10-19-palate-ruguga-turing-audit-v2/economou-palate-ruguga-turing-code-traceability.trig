        rdfs:label "Economou et al. (2012) FGF10/FGF7-SHH activator-inhibitor Turing stripe mechanism at mammalian palatal growth zones — Code-to-model traceability: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Every computational section and docstring maps directly to Economou et al. (2012) Nature Genetics 44:348-351 Figs. 1-4, Pantalacci et al. (2008) BMC Dev. Biol. 8:116, Welsh & O'Brien (2009) Dev. Biol. 336:64-75, and the 3 Lean 4 theorems in `morphoeval/lean/loops/Loop_008_palate_ruguga_turing.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-code-traceability-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2012-economou-palate-ruguga-turing.py L1–L56" ;
        dct:description "Module docstring mapping FGF-SHH equations, Lean 4 theorems, and growth-zone / surgical benchmarks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2012-economou-palate-ruguga-turing.py#L1-L56> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/economou-palate-ruguga-turing.yaml L1–L80" ;
        dct:description "Isolated Math KG specification linking Python code loci and Lean 4 theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/morphoeval/math_kg_loops/economou-palate-ruguga-turing.yaml#L1-L80> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-economou-palate-ruguga-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Economou et al. (2012) FGF10/FGF7-SHH activator-inhibitor Turing stripe mechanism at mammalian palatal growth zones — Morphological realism / specimen match: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 3.0 mammalian hard palate photograph (`datasets/palate_ruguga_turing/palate_rugae_specimen.jpg`, `File:Palatum_horse.JPG`) and segments the bilateral transverse palatal rugae (`segment_palate_rugae_specimen`, L532-586), detecting 15 periodic rugae on the left shelf (spacing 98.21 +- 18.10 px, CV = 0.1843) and 16 periodic rugae on the right shelf (spacing 94.20 +- 25.75 px, CV = 0.2733), rendered in Panel F alongside the 2D PDE palatal rugae in Panel A." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2012-economou-palate-ruguga-turing.py L532–L586" ;
        dct:description "DoG ridge segmentation of 15 left-shelf and 16 right-shelf transverse palatal rugae in palate_rugae_specimen.jpg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2012-economou-palate-ruguga-turing.py#L532-L586> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/palate_ruguga_turing_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing 2D WT/coronal-cut palatal PDE, dispersion, in-phase FGF/SHH profiles, 8->1..7b addition, perturbations, and segmented specimen — docs/media/palate_ruguga_turing_comparison.png: rendered output of 2012-economou-palate-ruguga-turing.py at 45d4150, image/png, 892012 B, 2202×1464 px, artifact_sha256 160aa86a4bcc0206a11b1578d108b8818ba0b95fe2f48898a70fa448ec3bcce7 (sha256 160aa86a4bcc0206a11b1578d108b8818ba0b95fe2f48898a70fa448ec3bcce7), spec_fingerprint 2d8b918612b8f3a25ba7f27439207d03bf556187e2f521ce737d04a76d0c39ef" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;

        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-040-on-the-theory-of-transformatio-audit-thompson1917-t1917-040-6>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-040-on-the-theory-of-transformatio-audit-thompson1917-t1917-040-7> ;
    pk:hypothesisType "geometric / Thompson coordinate deformation (Dürer-Camper facial profiles)" ;

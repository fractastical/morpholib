        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-source-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-specimen-match> ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-040-on-the-theory-of-transformatio-audit-thompson1917-t1917-040-1>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-040-on-the-theory-of-transformatio-audit-thompson1917-t1917-040-2>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-040-on-the-theory-of-transformatio-audit-thompson1917-t1917-040-3>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-040-on-the-theory-of-transformatio-audit-thompson1917-t1917-040-4>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-040-on-the-theory-of-transformatio-audit-thompson1917-t1917-040-5>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-040-on-the-theory-of-transformatio-audit-thompson1917-t1917-040-6> ;
    pk:hypothesisType "Thompson (1917) Ch. XVII whole-grid coordinate deformations — Dürer/Camper facial-profile shear & stretch group (geometric)" ;
    pk:weightOfEvidence 5.35e-01 .


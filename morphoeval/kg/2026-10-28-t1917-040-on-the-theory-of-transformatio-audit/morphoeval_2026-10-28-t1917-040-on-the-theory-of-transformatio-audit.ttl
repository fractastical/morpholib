<https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-040> a pk:Claim ;
    rdfs:label "Thompson (1917) Dürer/Camper human profile grid deformations (Homo sapiens profile (Fig. 364 digitisation + Commons skull lateral))",
        "Thompson (1917) Dürer/Camper human profile grid deformations faithfully reproduces Homo sapiens profile (Fig. 364 digitisation + Commons skull lateral) morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-040-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-040-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-040-3> ;
    dct:description "The simulation script(s) thompson/claims/t1917-040_on-the-theory-of-transformations.py, docs/media/t1917_040_on_the_theory_of_transformatio_growth.gif, datasets/thompson_1917/t1917-040/result.json implement the cited source model as published and produce forms that match real Homo sapiens profile (Fig. 364 digitisation + Commons skull lateral) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/datasets/thompson_1917/t1917-040/result.json>,
        <https://github.com/fractastical/morpholib/blob/main/docs/media/t1917_040_on_the_theory_of_transformatio_growth.gif>,
        <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-040_on-the-theory-of-transformations.py> ;
    schema:about "Homo sapiens profile (Fig. 364 digitisation + Commons skull lateral)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-040_on-the-theory-of-transformations.py, https://github.com/fractastical/morpholib/blob/main/docs/media/t1917_040_on_the_theory_of_transformatio_growth.gif, https://github.com/fractastical/morpholib/blob/main/datasets/thompson_1917/t1917-040/result.json; output: docs/media/t1917_040_on_the_theory_of_transformatio_comparison.png; organism: Homo sapiens profile (Fig. 364 digitisation + Commons skull lateral); environment: python 3.12, numpy 2.x, scipy 1.x, matplotlib 3.x; other sources: On Growth and Form, Ch. XVII, Figs. 353-358, 364, 366 <https://archive.org/details/ongrowthform1917thom>; phenomenon_size: 979 µm (0.0009792 m, log10=-3.009 m, tier=5_primordium_100um); species_scale_ladder (20 runs from 979 µm to 2.85 m): 979 µm:cortical-sulcal-axon-tension, 1.4 mm:bressloff-cowan-V1-hallucination, 1.5 mm:corticothalamic-seizure-spirals, 1.7 mm:homo-sapiens-bioelectric-polarity, 3.1 mm:vertex-glass-jamming, 3.4 mm:homo-sapiens-vertex-packing, 6.3 cm:homo-sapiens-turing-wavelength, 11.7 cm:homo-sapiens-clock-wavefront" ;
    pk:derivedFromPaper <https://doi.org/10.1109/34.24792>,
        <https://doi.org/10.5061/dryad.0zpc86746> ;
    pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-code-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-model-fidelity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-morphometric-validation>,

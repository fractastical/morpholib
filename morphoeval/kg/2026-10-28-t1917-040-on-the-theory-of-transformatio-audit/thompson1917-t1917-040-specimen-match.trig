}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-040> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Dürer/Camper facial grids — whole-grid deformation test on human profile landmarks (Pass 1) — Morphological realism / specimen match: 35/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Side by side, the accepted silhouettes follow the real profiles (nose, lips, chin) and the Dürer-grid panel reads like Thompson's Fig. 366. But 5 of 9 specimens fail segmentation or landmarking, the Romy Schneider \"n\" sits on the hair fringe rather than the nasion, lower-lip landmarks are missing on 3 of 4 accepted faces, and the GIF specimen's dense curve includes the hair line. The rendered result does not yet look like a clean anatomical landmark set." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-040/t1917_040_landmarks.csv (generated output, not in repo): 5/9 rejected; accepted rows missing g, sto, li — datasets/thompson_1917/t1917-040/t1917_040_landmarks.csv: rendered output of thompson/claims/t1917-040_on-the-theory-of-transformations.py at 7d216d80, text/csv, 1425 B, artifact_sha256 02906f25494a8c2f3583794ad4af1761cbe5f36fef0311e4d66a17f997a41729 (sha256 02906f25494a8c2f3583794ad4af1761cbe5f36fef0311e4d66a17f997a41729), spec_fingerprint bf2c0ad03b62d78daf7290b9c4b6a8298b657d4806b6d9a98874151b2165a166",
            "thompson/claims/t1917-040_on-the-theory-of-transformations.py L253–L283: single global Lab background model cannot handle the Keller wall-shadow gradient or halftone prints <https://github.com/fractastical/morpholib/blob/7d216d80/thompson/claims/t1917-040_on-the-theory-of-transformations.py#L253-L283>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-specimen-match-1> ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_040_on_the_theory_of_transformatio_comparison.png (generated output)" ;
        dct:description "panels b,c: silhouette + landmarks on two accepted specimens — docs/media/t1917_040_on_the_theory_of_transformatio_comparison.png: rendered output of thompson/claims/t1917-040_on-the-theory-of-transformations.py at 7d216d80, image/png, 516848 B, 1760×1100 px, artifact_sha256 b4e443ab9874866b566b81cbbab7908412d2bcc08e4ac1d3a5d54d94662bd284 (sha256 b4e443ab9874866b566b81cbbab7908412d2bcc08e4ac1d3a5d54d94662bd284), spec_fingerprint bf2c0ad03b62d78daf7290b9c4b6a8298b657d4806b6d9a98874151b2165a166" .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


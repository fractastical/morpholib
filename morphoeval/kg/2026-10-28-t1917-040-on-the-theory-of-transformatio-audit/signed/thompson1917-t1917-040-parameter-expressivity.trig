sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-040> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-parameter-expressivity> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Dürer/Camper facial grids — whole-grid deformation test on human profile landmarks (Pass 1) — Parameter expressivity: 40/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "The animation sweeps Thompson's omega 60->120 deg and shows the facial line tilting monotonically with k (E5), and the self-test proves the affine recovers an exact Dürer grid. But the analysis itself has no parameter sweep (c, k, eps), the fitted affine parameters are not interpretable because of the conditioning problem, and nothing demonstrates what range of (c, k) real faces occupy." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "thompson/claims/t1917-040_on-the-theory-of-transformations.py L499–L536: analyse(): no sweep over c/k/eps on real data <https://github.com/fractastical/morpholib/blob/7d216d80/thompson/claims/t1917-040_on-the-theory-of-transformations.py#L499-L536>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-parameter-expressivity-2> ;
        pk:hasScore "0.4"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-040_on-the-theory-of-transformations.py L632–L684" ;
        dcterms:description "make_growth_gif: omega sweep with k and facial-line read-out" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7d216d80/thompson/claims/t1917-040_on-the-theory-of-transformations.py#L632-L684> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-040_on-the-theory-of-transformations.py L772–L819" ;
        dcterms:description "self_test: affine_k and anisotropy recovered to 1e-9 on a synthetic Dürer grid" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7d216d80/thompson/claims/t1917-040_on-the-theory-of-transformations.py#L772-L819> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .
}


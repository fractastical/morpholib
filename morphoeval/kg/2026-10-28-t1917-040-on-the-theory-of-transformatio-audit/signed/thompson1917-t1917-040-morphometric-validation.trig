sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-040> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-morphometric-validation> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Dürer/Camper facial grids — whole-grid deformation test on human profile landmarks (Pass 1) — Morphometric validation: 42/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Landmark RMSE in centroid-size units for similarity vs affine on every ordered pair, R_affine as the claim statistic, and convexity / nasolabial angles compared with Legan & Burstone norms are computed. Deductions: n = 4 specimens / 12 pairs; no landmark noise floor, so a residual of 0.10 cannot be judged; no leave-one-out CV for a 6-dof fit on 8 points; no negative or positive control on real data; nasolabial SD of 39 deg signals a columella misdetection; convexity computed on only 2 faces." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-040_on-the-theory-of-transformations.py L711–L720: verdict_from thresholds on R_affine alone, without noise floor or CV <https://github.com/fractastical/morpholib/blob/7d216d80/thompson/claims/t1917-040_on-the-theory-of-transformations.py#L711-L720>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-accepted-specimens-with-11-profile-landmarks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-facial-convexity-angle-g-sn-pg-mean-over-specimens>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-landmark-rmse-similarity-null>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-landmark-rmse-whole-grid-affine-d-rer-grid>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-r-affine-1-ss-affine-ss-similarity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-nasolabial-angle-cm-sn-ls-mean-over-specimens>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-morphometric-validation-2> ;
        pk:hasScore "0.42"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-accepted-specimens-with-11-profile-landmarks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "accepted specimens with 11 profile landmarks = 4 count" ;
        schema:measurementTechnique "Lab background-model silhouette + extremum-sequence landmarks, QC gate" ;
        schema:name "accepted specimens with 11 profile landmarks" ;
        schema:unitText "count" ;
        schema:value "4" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-facial-convexity-angle-g-sn-pg-mean-over-specimens> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "facial convexity angle G-Sn-Pg, mean over specimens = 8.47 deg" ;
        dcterms:description "Legan & Burstone 1980 adult norm 12 +/- 4 deg" ;
        schema:measurementTechnique "180 - interior angle at Sn; std over specimens = 8.55" ;
        schema:name "facial convexity angle G-Sn-Pg, mean over specimens" ;
        schema:unitText "deg" ;
        schema:value "8.47" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-facial-convexity-angle-g-sn-pg-mean-over-specimens-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-facial-convexity-angle-g-sn-pg-mean-over-specimens-reference> a schema:PropertyValue ;
        schema:value "12.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-landmark-rmse-similarity-null> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "median landmark RMSE, similarity null = 0.1892 centroid-size units" ;
        schema:measurementTechnique "Procrustes similarity fit per ordered pair (4 dof), rmse" ;
        schema:name "median landmark RMSE, similarity null" ;
        schema:unitText "centroid-size units" ;
        schema:value "0.1892" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-landmark-rmse-whole-grid-affine-d-rer-grid> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "median landmark RMSE, whole-grid affine (Dürer grid) = 0.103 centroid-size units" ;
        schema:measurementTechnique "least-squares affine fit per ordered pair (6 dof) vs similarity null, rmse" ;
        schema:name "median landmark RMSE, whole-grid affine (Dürer grid)" ;
        schema:unitText "centroid-size units" ;
        schema:value "0.103" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-r-affine-1-ss-affine-ss-similarity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "median R_affine = 1 - SS(affine)/SS(similarity) = 0.5795 fraction" ;
        dcterms:description "claim predicts ~1 (whole-grid); 0 = all difference is local" ;
        schema:measurementTechnique "fraction of non-similarity shape difference absorbed by the whole-grid deformation (claim statistic)" ;
        schema:name "median R_affine = 1 - SS(affine)/SS(similarity)" ;
        schema:unitText "fraction" ;
        schema:value "0.5795" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-r-affine-1-ss-affine-ss-similarity-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-r-affine-1-ss-affine-ss-similarity-reference> a schema:PropertyValue ;
        schema:value "1.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-nasolabial-angle-cm-sn-ls-mean-over-specimens> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nasolabial angle Cm-Sn-Ls, mean over specimens = 93.03 deg" ;
        dcterms:description "Legan & Burstone 1980 adult norm 102 +/- 8 deg" ;
        schema:measurementTechnique "interior angle at Sn; std over specimens = 39.02" ;
        schema:name "nasolabial angle Cm-Sn-Ls, mean over specimens" ;
        schema:unitText "deg" ;
        schema:value "93.03" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-nasolabial-angle-cm-sn-ls-mean-over-specimens-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-nasolabial-angle-cm-sn-ls-mean-over-specimens-reference> a schema:PropertyValue ;
        schema:value "102.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-040_on-the-theory-of-transformations.py L196–L214" ;
        dcterms:description "fit_pair: rmse_similarity, rmse_affine, R_affine per pair" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7d216d80/thompson/claims/t1917-040_on-the-theory-of-transformations.py#L196-L214> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-040/t1917_040_metrics.json (generated output)" ;
        dcterms:description "summary: rmse 0.189 -> 0.103, R_affine median 0.58, convexity 8.5 (n=2), nasolabial 93 +/- 39 — datasets/thompson_1917/t1917-040/t1917_040_metrics.json: rendered output of thompson/claims/t1917-040_on-the-theory-of-transformations.py at 7d216d80, application/json, 2525 B, artifact_sha256 6d98a5436f7fceea951affb0148df37a866119df7751b5d1a2e468a7886ec107 (sha256 6d98a5436f7fceea951affb0148df37a866119df7751b5d1a2e468a7886ec107), spec_fingerprint bf2c0ad03b62d78daf7290b9c4b6a8298b657d4806b6d9a98874151b2165a166" .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .
}


sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-040> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-overall> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Dürer/Camper human profile grid deformations — MorphoEval overall 58.1/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Pass 1 baseline: three digitised Dürer profiles warped with similarity/affine/TPS; Dryad fish dataset recorded as DATASET_MISMATCH; --pass1 skips CV segmentation and parameter sweeps. Overall 58.1/100 (faithfulness 52.1, reproducibility 72.0); rubric morphoeval 0.1.0; checkpoint commit cc716ad5c8529ea438a8998b3d46e62a3e104f44; environment: python 3.12, numpy 2.x, scipy 1.x, matplotlib 3.x. Dimension assessments: Model fidelity to source 68, Morphological realism / specimen match 42, Parameter expressivity 46, Morphometric validation 52, Source and data traceability 84, Code-to-model traceability 72, Reproducibility package 62. Output judged: docs/media/t1917_040_on_the_theory_of_transformatio_comparison.png: rendered output of thompson/claims/t1917-040_on-the-theory-of-transformations.py at cc716ad5c8529ea438a8998b3d46e62a3e104f44, image/png, 433332 B, 1650×1050 px, artifact_sha256 10530256f9684574b7033781fb7f1af9e7ef5ea65245638ed887c3666a94d7ba (sha256 10530256f9684574b7033781fb7f1af9e7ef5ea65245638ed887c3666a94d7ba), spec_fingerprint eb64221a9e3748108a92e2ceccb63e7a11a14e83082401ebbc8c2bfdd7094217. Dual provenance: spec_fingerprint: eb64221a9e3748108a92e2ceccb63e7a11a14e83082401ebbc8c2bfdd7094217; artifact_sha256: 10530256f9684574b7033781fb7f1af9e7ef5ea65245638ed887c3666a94d7ba; input_dataset_sha256: {datasets/thompson_1917/t1917-040/homo_sapiens_lateral_profile.jpg=55fd8d5270d136ed..., datasets/thompson_1917/t1917-040/scout_manifest.json=07db0e494d12305a..., datasets/thompson_1917/t1917-040/thompson1917_leaf759_p740_fig364_durer_profiles.jpg=9e583cdcbd5c7ced...}." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Add specimen CV segmentation panel and landmark-in-mask fraction on core mandible landmarks.",
            "remediation needed: Document Dryad fish dataset as unused analogue in result.json (already present).",
            "remediation needed: Enable default full_validation: k_vert×m_shear grid sweep, TPS λ sweep, 200-replicate bootstrap, KS on homologous vs shuffled residuals.",
            "remediation needed: Expand measure_morphoeval() to export KS p-value, sweep best cell, and segmentation mask fraction." ;
        pk:hasScore "0.581"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;

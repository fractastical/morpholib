sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-040> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Dürer/Camper facial grids — whole-grid deformation test on human profile landmarks (Pass 1) — Code-to-model traceability: 70/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Every transformation function names its equation id and Thompson page; the Lean theorems cite the Python functions they mirror; the KG yaml links law -> theorem -> code locus. Deductions: landmark-detection heuristics (prominence 2 % / 0.3 %, 2x rule for li) are not traceable to a published protocol beyond a method-family citation." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "thompson/claims/t1917-040_on-the-theory-of-transformations.py L296–L378: detect_landmarks thresholds are heuristic <https://github.com/fractastical/morpholib/blob/7d216d80/thompson/claims/t1917-040_on-the-theory-of-transformations.py#L296-L378>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-code-traceability-2> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-040_on-the-theory-of-transformations.py L1–L60" ;
        dct:description "module docstring: equations E1-E5 with page refs, claim boundary, outputs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7d216d80/thompson/claims/t1917-040_on-the-theory-of-transformations.py#L1-L60> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/thompson1917-t1917-040.yaml (generated output)" ;
        dct:description "6 laws with lean_theorem, lean_locus, code_locus, source_citation — morphoeval/math_kg_loops/thompson1917-t1917-040.yaml: rendered output of thompson/claims/t1917-040_on-the-theory-of-transformations.py at 7d216d80, application/yaml, 8877 B, artifact_sha256 4ef3b0c7f47611024cde2b7ccdbb10baa1bcfd47a1c3463600ddc6fcd79c4d08 (sha256 4ef3b0c7f47611024cde2b7ccdbb10baa1bcfd47a1c3463600ddc6fcd79c4d08), spec_fingerprint bf2c0ad03b62d78daf7290b9c4b6a8298b657d4806b6d9a98874151b2165a166" .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;

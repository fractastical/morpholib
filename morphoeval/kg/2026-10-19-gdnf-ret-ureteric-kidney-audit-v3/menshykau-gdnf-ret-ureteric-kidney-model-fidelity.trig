sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-gdnf-ret-ureteric-kidney> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013) & Short et al. (2014) GDNF-RET-Wnt11-Sprouty1 kidney ureteric bud Turing branching morphogenesis — Model fidelity to source: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The 4-species Schnakenberg GDNF-RET-Wnt11-Sprouty1 PDE (L212-L328), m = 1..4 ampulla mode selection (L331-L361), 3D tree with exact Strahler ordering (L366-L457, L655-L914) and the agenesis / Spry1 controls are unchanged and sound. Pass 3 adds a physically reasonable diffuse-domain GDNF field: production confined to the nephrogenic shell phi_nz, decay and RET tip sinks inside phi_cap, zero GDNF outside the capsule (verified by self-test 9), and four couplings — chemotaxis, confinement, interstitial dilation with the hilum fixed, and GDNF-gated arrest — each of which produces the qualitatively expected effect in the sweep (+3 net vs v2 for the mechanism, backed by 2 new Lean theorems). Deductions, all exposed by the remediation: the capsule radius is prescribed from the Short (2014) observed tip number it is later compared against, so the moving boundary is not an emergent part of the model (-3); R_cap anchors, nephrogenic-zone thickness, GDNF decay length, kappa_tip, the 0.15 gate and chi = 0.35 are order-of-magnitude assumptions, not Menshykau/Short values (-2); the capsule is a sphere with isotropic dilation whereas the kidney is ellipsoidal with anisotropic growth (-1); per-generation segment lengths and angles come from the reference table rather than from the PDE or capsule (-1); the ampulla PDE is a periodic 1D ring of length pi R_tip described as a dome, with m = 1..4 seeded explicitly in the initial bias (-1). Net: 94 -> 90." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2014-menshykau-gdnf-ret-ureteric-kidney.py L479–L489: CAPSULE_PARAMS: 300/550 um anchors, 110 um NZ, 150 um decay length, kappa_tip 2.0, margin 22 um, hilum offset 0.62 are approximate anchors / modelling assumptions <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L479-L489>",
            "2014-menshykau-gdnf-ret-ureteric-kidney.py L509–L519: Capsule radius R_cap(g) interpolated from the OBSERVED Short (2014) tip number of the same generation — the moving boundary is data-prescribed, not emergent <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L509-L519>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity-4> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py L212–L361" ;
        dct:description "Coupled 4-species GDNF-RET-Wnt11-Sprouty1 ampulla PDE and m=1..4 mode selection; `--D-ratio` now reaches `evaluate_ampulla_mode_selection(D_ratio=...)` (L331)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L212-L361> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py L526–L604" ;
        dct:description "Steady diffuse-domain GDNF field 0 = D div(phi_cap grad G) + rho_G phi_nz - delta phi_cap G - kappa_tip T G on a fixed 36x36x39 grid with tanh phase fields and RET tip sinks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L526-L604> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py L750–L806" ;
        dct:description "Per-generation capsule radius and field solve, interstitial dilation about the previous capsule centre (hilum fixed), GDNF-gated arrest (L794-L797), chemotaxis (L802) and confinement (L806)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L750-L806> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_055_gdnf_ret_ureteric_kidney.lean L107–L151" ;
        dct:description "`menshykau_capsule_confinement_bound` and `menshykau_capsule_crowding_arrest_monotone`: 2 new machine-checked theorems (5 total, 0 sorrys, lean exit 0)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_055_gdnf_ret_ureteric_kidney.lean#L107-L151> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 055 Pass 3 Phase B Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


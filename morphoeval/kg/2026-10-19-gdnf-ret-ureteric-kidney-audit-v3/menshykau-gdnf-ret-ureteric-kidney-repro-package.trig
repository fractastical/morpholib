sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-gdnf-ret-ureteric-kidney> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013) & Short et al. (2014) GDNF-RET-Wnt11-Sprouty1 kidney ureteric bud Turing branching morphogenesis — Reproducibility package: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`--self-test` passes 9 checks in 6.9 s (SHA-256 integrity of 5 files + capsule JSON consistency, Turing criterion, harmonics [1,2,3,4], Short scaling and Strahler windows, agenesis control, perturbation ordering, specimen segmentation, two-run bitwise determinism of PDE, tree and field, and the new 10-assertion capsule-coupling check including the hilum fixed point and zero GDNF outside the capsule); `measure_morphoeval()` length is asserted (12); the full default render writes the PNG, the capsule PNG and the GIF in 7.3 s; all outputs are seeded and deterministic. Deductions: the self_test docstring is stale (-1); the R_b window 1.90-2.30 is satisfied only at the default gate so the determinism guarantee is narrower than it looks (-1); the capsule figure and sweep cannot be regenerated under the CLI overrides (-1); no pinned requirements lock file for this script (-1). Net: 93 -> 93." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-repro-package-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py L1825–L1912" ;
        dct:description "9-check self_test(): integrity, Turing, modes, Short/Strahler, agenesis, ordering, specimen, bitwise determinism (PDE/tree/field), capsule coupling (10 assertions) and 12 measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L1825-L1912> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py L1875–L1882" ;
        dct:description "Self-test 8: two-run bitwise determinism on `R2G`, generation tips and the capsule field `G`" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L1875-L1882> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py L1915–L1954" ;
        dct:description "CLI entrypoint renders PNG + capsule PNG + GIF (--skip-gif) with a fixed default seed 2014" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L1915-L1954> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 055 Pass 3 Phase B Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


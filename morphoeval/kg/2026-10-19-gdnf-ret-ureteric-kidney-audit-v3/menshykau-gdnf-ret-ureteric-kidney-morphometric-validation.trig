        schema:measurementTechnique "Ratio of consecutive Strahler stream lengths across 3D ureteric tree orders (segment length Pearson r=0.9999, p=3.22e-13)" ;
        schema:name "Horton-Strahler ureteric segment length ratio R_L (Short et al. 2014 Fig. 3)" ;
        schema:unitText "dimensionless ratio (L_{w+1} / L_w)" ;
        schema:value "1.3706" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-horton-strahler-ureteric-segment-length-ratio-r-l-short-et-al-2014-fig-3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-horton-strahler-ureteric-segment-length-ratio-r-l-short-et-al-2014-fig-3-reference> a schema:PropertyValue ;
        dct:source "Short et al. (2014) Dev. Cell 29:188-202 Fig. 3 (empirical Horton-Strahler length ratio R_L ≈ 1.38)" ;
        schema:value "1.38" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-horton-strahler-ureteric-tree-bifurcation-ratio-r-b-short-et-al-2014-fig-3> a schema:PropertyValue,
            pk:EvidenceItem ;

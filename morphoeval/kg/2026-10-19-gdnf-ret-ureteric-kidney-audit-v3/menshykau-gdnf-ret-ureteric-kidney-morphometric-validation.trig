        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-horton-strahler-ureteric-segment-length-ratio-r-l-short-et-al-2014-fig-3> a schema:PropertyValue,

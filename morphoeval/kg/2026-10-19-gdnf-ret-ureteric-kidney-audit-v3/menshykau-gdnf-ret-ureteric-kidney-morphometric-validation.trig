}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-gdnf-ret-ureteric-kidney> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013) & Short et al. (2014) GDNF-RET-Wnt11-Sprouty1 kidney ureteric bud Turing branching morphogenesis — Morphometric validation: 86/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` returns 12 reference-anchored measurements (9 carried from v2 plus E15.5 tips-in-nephrogenic-zone fraction 0.666 vs ref 1.0 with the decoupled 0.114 stated, capsule-crowding suppression ratio 0.676 vs decoupled null 1.0, and NZ/core GDNF enrichment 2.15 vs uniform null 1.0), each with method, reference source and a note. Short (2014) tip correlation r = 0.9997 (RMSE 23.3 vs 2^g RMSE 38.7), R_b 2.177 (ref 2.08), R_L 1.371 (ref 1.38), Delta m = 1, Spry1/WT and BMP4/WT ratios, agenesis 0 tips, specimen 13/6 tips. Deductions: the E15.5 count is 293 vs 354 observed and the g = 5 WT count 36 vs 40.2 — the Pearson r is dominated by exponential growth and is weak evidence of fit (-3); the segment- length r is circular because the generation lengths are read from the same reference table (-3); R_b passes the 1.90-2.30 self-test window only at gate 0.15 (2.35 at gate 0.18 or chi = 0) and `compute_horton_strahler_metrics` drops the last ratio and falls back to 2.0 (-2); two of the three new measurements are compared with null hypotheses (1.0) rather than measured values (-2); the pErk fold 38.65 vs unsourced 2.40 is reported as a measurement without comment on the 16x gap (-2); spry1 and bead trees differ only via `seed + 10*idx` (-1). Net: 93 -> 86." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2014-menshykau-gdnf-ret-ureteric-kidney.py L1062–L1074: Perturbation suite trees differ only through `seed + 10*idx`; WT g=5 36 vs obs 40.2 <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L1062-L1074>",
            "2014-menshykau-gdnf-ret-ureteric-kidney.py L427–L436: `compute_horton_strahler_metrics` drops the last ratio ('interior') and falls back to R_b = 2.0 when fewer than 2 valid orders <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L427-L436>",
            "2014-menshykau-gdnf-ret-ureteric-kidney.py L743–L747: Per-generation `segment_length_um` and `branch_angle_deg` read from the reference table, making the segment-length Pearson r (L956-L957) circular <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L743-L747>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-ampulla-circumferential-harmonic-transition-m-2-bifurcation-m-3-trifurcation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-bmp4-stalk-elongation-inhibition-vs-wild-type-e13-5-tip-suppression-ratio-miyazaki-et-al-2000>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-capsule-crowding-tip-suppression-ratio-n-tips-e15-5-capsule-x0-5-n-tips-e15-5-wt-capsule-pass-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-e15-5-fraction-of-ureteric-tips-inside-the-nephrogenic-zone-phase-field-capsule-coupling-pass-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-gdnf-ret-renal-agenesis-negative-control-tip-count-rho-g-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-horton-strahler-ureteric-segment-length-ratio-r-l-short-et-al-2014-fig-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-horton-strahler-ureteric-tree-bifurcation-ratio-r-b-short-et-al-2014-fig-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-nephrogenic-zone-to-medullary-core-mesenchymal-gdnf-enrichment-ratio-at-e15-5-diffuse-domain-field-pass-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-specimen-e12-5-wild-type-segmented-ureteric-tip-count-kidney-ureteric-tree-specimen-jpg-panel-a>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-specimen-perk1-2-to-cytokeratin-tip-signaling-fold-change-wt-panels-d-f-vs-mutant-panels-g-i>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-spry1-vs-wild-type-e13-5-supernumerary-tip-ratio-basson-et-al-2005-dev-cell>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-ureteric-tip-count-generational-correlation-across-e11-5-e15-5-short-et-al-2014-g-1-8>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-morphometric-validation-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-ampulla-circumferential-harmonic-transition-m-2-bifurcation-m-3-trifurcation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Ampulla circumferential harmonic transition (m=2 bifurcation -> m=3 trifurcation) = 1.0 harmonic shift Δm" ;
        dct:description "M1=1, M2=2, M3=3, M4=4" ;
        schema:measurementTechnique "Difference in dominant FFT harmonic m* of 2D/1D GDNF-RET-Wnt11-Spry1 PDE between swollen ampulla (R_tip=0.45, m=3) and WT ampulla (R_tip=0.30, m=2)" ;
        schema:name "Ampulla circumferential harmonic transition (m=2 bifurcation -> m=3 trifurcation)" ;
        schema:unitText "harmonic shift Δm" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-ampulla-circumferential-harmonic-transition-m-2-bifurcation-m-3-trifurcation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-ampulla-circumferential-harmonic-transition-m-2-bifurcation-m-3-trifurcation-reference> a schema:PropertyValue ;
        dct:source "Menshykau & Iber (2013) Phys. Biol. 10:046003 Figs. 3-5 (transition from m=2 lateral bifurcation to m=3 trifurcation)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-bmp4-stalk-elongation-inhibition-vs-wild-type-e13-5-tip-suppression-ratio-miyazaki-et-al-2000> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "BMP4 stalk-elongation inhibition vs Wild-Type E13.5 tip suppression ratio (Miyazaki et al. 2000) = 0.4167 ratio (N_BMP4 / N_WT)" ;
        dct:description "BMP4 tips=15.0 (obs 14.5), R_L=1.585" ;
        schema:measurementTechnique "Ratio of simulated E13.5 ureteric tips under exogenous BMP4 stalk inhibition vs Wild-Type control" ;
        schema:name "BMP4 stalk-elongation inhibition vs Wild-Type E13.5 tip suppression ratio (Miyazaki et al. 2000)" ;
        schema:unitText "ratio (N_BMP4 / N_WT)" ;
        schema:value "0.4167" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-bmp4-stalk-elongation-inhibition-vs-wild-type-e13-5-tip-suppression-ratio-miyazaki-et-al-2000-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-bmp4-stalk-elongation-inhibition-vs-wild-type-e13-5-tip-suppression-ratio-miyazaki-et-al-2000-reference> a schema:PropertyValue ;
        dct:source "Miyazaki et al. (2000) J. Clin. Invest. 105:863-873 (BMP4 inhibits ureteric branching and elongates stalks)" ;
        schema:value "0.3607" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-capsule-crowding-tip-suppression-ratio-n-tips-e15-5-capsule-x0-5-n-tips-e15-5-wt-capsule-pass-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Capsule-crowding tip suppression ratio N_tips(E15.5, capsule x0.5) / N_tips(E15.5, WT capsule) (Pass 3) = 0.6758 ratio (dimensionless)" ;
        dct:description "x0.5: 198 tips, x0.6: 268, x1.0: 293, x1.3: 289 (Short et al. 2014 E15.5 obs 354)" ;
        schema:measurementTechnique "GDNF-gated branching under a capsule expanding at half the WT rate: tips crowd the nephrogenic zone, deplete mesenchymal GDNF (mean G/G_ref at tips 0.147 vs 0.292) and arrest (103 vs 7 gated arrests)" ;
        schema:name "Capsule-crowding tip suppression ratio N_tips(E15.5, capsule x0.5) / N_tips(E15.5, WT capsule) (Pass 3)" ;
        schema:unitText "ratio (dimensionless)" ;
        schema:value "0.6758" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-capsule-crowding-tip-suppression-ratio-n-tips-e15-5-capsule-x0-5-n-tips-e15-5-wt-capsule-pass-3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-capsule-crowding-tip-suppression-ratio-n-tips-e15-5-capsule-x0-5-n-tips-e15-5-wt-capsule-pass-3-reference> a schema:PropertyValue ;
        dct:source "Decoupled null hypothesis (tree insensitive to capsule expansion); value < 1 quantifies the tree-capsule coupling strength of the reduced phase-field model" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-e15-5-fraction-of-ureteric-tips-inside-the-nephrogenic-zone-phase-field-capsule-coupling-pass-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "E15.5 fraction of ureteric tips inside the nephrogenic zone (phase-field capsule coupling, Pass 3) = 0.6655 fraction of terminal tips" ;
        dct:description "coupled=0.666, no-chemotaxis=0.505, decoupled=0.114; capsule contacts=130" ;
        schema:measurementTechnique "Terminal tips of the coupled 3D tree whose radial distance from the capsule centre lies within h_nz=110 um of the phase-field capsule R_cap(E15.5)=550 um; decoupled v2 geometric tree: 0.114 in zone, 0.801 outside the capsule" ;
        schema:name "E15.5 fraction of ureteric tips inside the nephrogenic zone (phase-field capsule coupling, Pass 3)" ;
        schema:unitText "fraction of terminal tips" ;
        schema:value "0.6655" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-e15-5-fraction-of-ureteric-tips-inside-the-nephrogenic-zone-phase-field-capsule-coupling-pass-3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-e15-5-fraction-of-ureteric-tips-inside-the-nephrogenic-zone-phase-field-capsule-coupling-pass-3-reference> a schema:PropertyValue ;
        dct:source "Short et al. (2014) Dev. Cell 29:188-202 Figs. 1 & 4 (all ureteric tips reside in the peripheral nephrogenic zone beneath the renal capsule)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-gdnf-ret-renal-agenesis-negative-control-tip-count-rho-g-0> a schema:PropertyValue,

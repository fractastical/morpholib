        schema:value "2.08" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-nephrogenic-zone-to-medullary-core-mesenchymal-gdnf-enrichment-ratio-at-e15-5-diffuse-domain-field-pass-3> a schema:PropertyValue,

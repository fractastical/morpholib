        schema:measurementTechnique "Mean steady diffuse-domain GDNF in the nephrogenic shell (phi_nz > 0.5) divided by the mean in the medullary core (phi_cap > 0.5, phi_nz < 0.1), with RET uptake at 293 E15.5 tips; decay length 150 um" ;
        schema:name "Nephrogenic-zone to medullary-core mesenchymal GDNF enrichment ratio at E15.5 (diffuse-domain field, Pass 3)" ;
        schema:unitText "ratio of mean GDNF (dimensionless)" ;
        schema:value "2.1512" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-nephrogenic-zone-to-medullary-core-mesenchymal-gdnf-enrichment-ratio-at-e15-5-diffuse-domain-field-pass-3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-nephrogenic-zone-to-medullary-core-mesenchymal-gdnf-enrichment-ratio-at-e15-5-diffuse-domain-field-pass-3-reference> a schema:PropertyValue ;
        dct:source "Spatially uniform null; GDNF is produced only by the cap mesenchyme (Menshykau & Iber 2013 Phys. Biol. 10:046003 model assumption; Short et al. 2014), so the ratio must exceed 1" ;
        schema:value "1.0" .

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-gdnf-ret-ureteric-kidney> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013) & Short et al. (2014) GDNF-RET-Wnt11-Sprouty1 kidney ureteric bud Turing branching morphogenesis — Code-to-model traceability: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module header (L1-L16) states the Pass 3 remediation, names the reduced model and the residual FEM item, and maps each law to its Lean theorem; Section 3b has a banner and the four couplings are numbered (i)-(iv) in comments at the lines where they act; the new JSON's status tags and the `measure_morphoeval` docstring (9 + 3) make the provenance of each number legible. Deductions: the trifurcation / branch-probability constants 0.08 / 0.24 / 0.22, the 1.28 / 0.72 stage factors and 0.99 * gain^0.42 (L705-L709, L772-L778) have no cited source (-4); the `self_test` docstring still reads \"8-check ... Pass 2 (v2)\" although the suite has 9 checks and prints \"Pass 3 v3\" (-2); the GIF's use of dilated positions is not documented (-1); the ampulla ring geometry is called a dome (-1). Net: 92 -> 90." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2014-menshykau-gdnf-ret-ureteric-kidney.py L1825–L1826: Stale `self_test` docstring: '8-check ... Pass 2 (v2)' vs 9 checks / Pass 3 <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L1825-L1826>",
            "2014-menshykau-gdnf-ret-ureteric-kidney.py L705–L709: Untraced trifurcation constants 0.08 / 0.24 / 0.22 and BMP4 0.04 <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L705-L709>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-code-traceability-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py L1–L16" ;
        dct:description "Header states the reduced phase-field remediation, the residual moving-mesh FEM item and the two new Lean theorem names" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L1-L16> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py L460–L461" ;
        dct:description "Section 3b banner; couplings (i)-(iv) labelled in-line at L753, L793, L853, L859" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L460-L461> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 055 Pass 3 Phase B Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


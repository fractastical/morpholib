sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-gdnf-ret-ureteric-kidney> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py L990–L1051" ;
        dcterms:description "`CAPSULE_COUPLING_CONDITIONS` + `evaluate_capsule_coupling_sweep`: 6 conditions over capsule growth, chemotaxis, confinement and gate" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L990-L1051> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py L1917–L1927" ;
        dcterms:description "CLI: --rho-G, --gamma, --D-ratio (now wired), --bmp4, --capsule-growth, --chemotaxis, --no-capsule, --seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L1917-L1927> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013) & Short et al. (2014) GDNF-RET-Wnt11-Sprouty1 kidney ureteric bud Turing branching morphogenesis — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Pass 3 adds a 6-condition capsule coupling sweep (coupled, no-chemotaxis, decoupled, capsule x0.6 / x0.5 / x1.3) whose outputs move monotonically with capsule growth (198 < 268 < 293 tips; NZ fraction 0.95 > 0.90 > 0.67 > 0.58), the `grow_ureteric_tree_3d` signature exposes `capsule_growth`, `chemotaxis_weight`, `capsule_confinement`, `gdnf_gate` (L663-L666), `evaluate_short_2014_generations` forwards them, and the CLI gains `--capsule-growth`, `--chemotaxis`, `--no-capsule` while `--D-ratio` (dead in v2) is now wired. The 4 ampulla regimes, 8 generations and 5 perturbation conditions are retained. Deductions: CLI overrides affect only the g = 1..8 tree (Panels A, C, F, G); the perturbation suite, Panel H sweep and the capsule figure take `seed` only and ignore them (-4); the `no_capsule` ablation changes chi, confinement, gate and dilation simultaneously, so only `no_chemotaxis` isolates a single coupling (-3); the gate value 0.15 is not sweepable from the CLI although R_b is sensitive to it (-1). Net: 92 -> 90." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2014-menshykau-gdnf-ret-ureteric-kidney.py L1230–L1234: `render_comparison_figure` passes overrides only to the ampulla modes and the g=1..8 tree; `evaluate_perturbation_suite(seed)` and `evaluate_capsule_coupling_sweep(seed)` ignore them <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L1230-L1234>",
            "2014-menshykau-gdnf-ret-ureteric-kidney.py L993–L993: `no_capsule` condition sets chemotaxis 0, capsule False and gate 0 at once — a conflated ablation <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L993-L993>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 055 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

        dcterms:title "Global spatiotemporal control of branching morphogenesis in the developing mouse kidney" .

    <https://doi.org/10.1016/j.ydbio.2004.09.019> dcterms:date "2004"^^xsd:gYear ;
        dcterms:title "Real-time analysis of ureteric bud branching morphogenesis in vitro" .

    <https://doi.org/10.1088/1478-3975/10/4/046003> dcterms:date "2013"^^xsd:gYear ;
        dcterms:title "Kidney branching morphogenesis under the control of a ligand-receptor-based Turing mechanism" .

    <https://doi.org/10.1172/JCI8256> dcterms:date "2000"^^xsd:gYear ;
        dcterms:title "Bone morphogenetic protein 4 inhibits the initial inductive events of metanephric mesenchyme and ureteric bud branching" .


    <https://doi.org/10.1016/j.devcel.2004.11.008> dcterms:date "2005"^^xsd:gYear ;
        dcterms:title "The role of GDNF/Ret signaling in ureteric bud cell fate and branching morphogenesis" .

    <https://doi.org/10.1016/j.devcel.2004.12.004> dcterms:date "2005"^^xsd:gYear ;

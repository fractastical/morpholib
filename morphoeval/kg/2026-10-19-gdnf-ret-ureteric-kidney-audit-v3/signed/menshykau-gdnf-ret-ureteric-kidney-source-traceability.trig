sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-gdnf-ret-ureteric-kidney> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013) & Short et al. (2014) GDNF-RET-Wnt11-Sprouty1 kidney ureteric bud Turing branching morphogenesis — Source and data traceability: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`datasets/gdnf_ret_ureteric_kidney/` carries 5 primary DOIs in `paper_citations.bib`, the scout manifest, the reference JSON, the specimen image and now `renal_capsule_phase_field_reference.json`, all 5 SHA-256-pinned and verified fail-closed at every run (`verify_dataset_integrity`, L87-L104; `load_capsule_reference` cross-checks the JSON against `CAPSULE_PARAMS`, L107-L119). The new JSON tags every capsule constant with a status string (approximate anchor / modelling assumption / numerical), which is the right way to disclose unsourced values. Deductions: Shakya et al. (2005) is cited in a measurement source string (L1798) but is absent from `paper_citations.bib` (-2); the specimen \"published 12 tips, cohort mean 13.2 +/- 0.5\" (L1808) and the pErk reference 2.40 (L1817-L1818) have no verifiable citation (-3); none of the capsule constants is traced to a table or figure (-2). Net: 95 -> 88." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "2014-menshykau-gdnf-ret-ureteric-kidney.py L1798–L1818: Shakya 2005 cited but not in the bib; specimen 'cohort mean 13.2 +/- 0.5' and pErk reference 2.40 unsourced <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L1798-L1818>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-source-traceability-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py L77–L119" ;
        dcterms:description "EXPECTED_SHA256 for 5 dataset files, `verify_dataset_integrity` and `load_capsule_reference` consistency check against CAPSULE_PARAMS" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L77-L119> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/gdnf_ret_ureteric_kidney/renal_capsule_phase_field_reference.json L1–L45" ;
        dcterms:description "Capsule parameter table with per-constant status tags and `residual_remediation`" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/datasets/gdnf_ret_ureteric_kidney/renal_capsule_phase_field_reference.json#L1-L45> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/gdnf_ret_ureteric_kidney/gdnf_ret_ureteric_kidney_reference.json L1–L188" ;
        dcterms:description "SHA-256-locked Short (2014) g=1..8 and 5-condition perturbation tables" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/datasets/gdnf_ret_ureteric_kidney/gdnf_ret_ureteric_kidney_reference.json#L1-L188> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 055 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


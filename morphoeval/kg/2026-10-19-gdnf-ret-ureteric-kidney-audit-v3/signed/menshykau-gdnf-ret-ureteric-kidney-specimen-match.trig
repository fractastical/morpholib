    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/gdnf_ret_ureteric_kidney_comparison.png (generated output)" ;
        dcterms:description "8-panel (2x4) synthesis: 3D coupled tree, ampulla modes, g=1..8 scaling, perturbations, specimen panels, Panel G capsule GDNF slice with NZ contours, Panel H coupling sweep bars — docs/media/gdnf_ret_ureteric_kidney_comparison.png: rendered output of 2014-menshykau-gdnf-ret-ureteric-kidney.py at 028758bc, image/png, 945447 B, 2742×1446 px, artifact_sha256 9f98460186b4bdf7797ab875a51788dba9d5afea8d89977769eda0675a4efdc0 (sha256 9f98460186b4bdf7797ab875a51788dba9d5afea8d89977769eda0675a4efdc0), spec_fingerprint f9c1a998913eff873333397950c9abd3c6d935d905ec30d2d429a949264e57cf" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/gdnf_ret_ureteric_kidney_capsule_coupling.png (generated output)" ;
        dcterms:description "E13.0 and E15.5 coupled slices vs decoupled v2 tree against the nominal capsule (80 % of tips outside) and sweep panel — docs/media/gdnf_ret_ureteric_kidney_capsule_coupling.png: rendered output of 2014-menshykau-gdnf-ret-ureteric-kidney.py at 028758bc, image/png, 480640 B, 3120×832 px, artifact_sha256 bc9264029ab1cb787218f2e1955374e45bca3c301bd46a9501b0e7a7a13a8413 (sha256 bc9264029ab1cb787218f2e1955374e45bca3c301bd46a9501b0e7a7a13a8413), spec_fingerprint f9c1a998913eff873333397950c9abd3c6d935d905ec30d2d429a949264e57cf" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py L1508–L1586" ;
        dcterms:description "`_draw_capsule_slice` / `_draw_capsule_sweep` render the phase-field slice, capsule/NZ contours, confined tips and the ablation bars" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L1508-L1586> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py L1107–L1215" ;
        dcterms:description "Specimen segmentation: 13 WT vs 6 mutant tips detected; pErk ROIs hard-coded at L1193-L1198 ignoring the reference JSON ROI" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L1107-L1215> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013) & Short et al. (2014) GDNF-RET-Wnt11-Sprouty1 kidney ureteric bud Turing branching morphogenesis — Morphological realism / specimen match: 84/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The 8-panel figure now shows the coupled 3D tree, the ampulla modes, the g = 1..8 scaling, the perturbation suite, the specimen segmentation, a mid-plane capsule GDNF slice with capsule / nephrogenic-zone contours and confined tips (Panel G), and the ablation bars (Panel H); the dedicated capsule-coupling figure contrasts the E13.0 and E15.5 coupled trees with the decoupled v2 tree, 80 % of whose tips lie outside the nominal capsule — a visually convincing demonstration that the coupling is what keeps tips in the nephrogenic zone. Specimen segmentation still finds 13 WT vs 6 mutant tips. Deductions, which the v2 audit did not apply: the vendored Wikimedia micrograph is from a prorenin-receptor (PRR UB-/-) study, not a GDNF/RET or Short (2014) specimen, so the \"mutant\" panel is not the Gdnf/Ret perturbation the model simulates (-4); the measured pErk1/2 fold of 38.65 is compared with a reference of 2.40 whose source string is unsourced, a 16x discrepancy left unexplained (-3); the pErk ROIs are hard-coded pixel boxes that ignore the ROI stored in the reference JSON (-1); the GIF draws every generation frame with the final dilated node positions, so early frames show already-stretched segments (-1); the E15.5 coupled tree has 293 tips vs the 354 the figure's own Panel C reports as observed (-2). Net: 91 -> 84." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2014-menshykau-gdnf-ret-ureteric-kidney.py L1622–L1678: GIF uses final (dilated) node positions for every generation frame <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L1622-L1678>",
            "2014-menshykau-gdnf-ret-ureteric-kidney.py L1812–L1821: pErk1/2 fold 38.65 vs `reference_value: 2.40` whose source is an unsourced description string; specimen is from a PRR study, not GDNF/RET <https://github.com/fractastical/morpholib/blob/028758bc/2014-menshykau-gdnf-ret-ureteric-kidney.py#L1812-L1821>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-specimen-match-4> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .


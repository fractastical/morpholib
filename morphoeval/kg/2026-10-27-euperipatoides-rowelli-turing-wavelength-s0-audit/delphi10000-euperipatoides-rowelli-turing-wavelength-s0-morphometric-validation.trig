sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg k_sigma at 1.12 µm in the E. rowelli ocellus (Holocene, 0 Ma) — Morphometric validation: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 0.9915, RMSE = 1171, KS = 0.069 against the continuum law. Segmented body aspect 0.610 versus a circular null of 1, and the 1.100 µm saturated wavelength versus the 2.5 µm receptor pitch, are non-circular. The ring estimator is still quantized (R2) and there is no orientation-histogram KS (R3). One specimen." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-continuum-vs-explicit-pde-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-holocene-countable-detail-wavelengths-across-the-100-m-eye>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-segmented-specimen-body-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-segmented-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-specimen-stripe-wavelength-versus-ocellus-receptor-pitch>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-continuum-vs-explicit-pde-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "continuum vs explicit-PDE dispersion Pearson r = 0.9915 Pearson r" ;
        dct:description "RMSE of growth rate = 1170.7; KS statistic = 0.0690" ;
        schema:measurementTechnique "corrcoef of σ(k) on modes 2..35; explicit periodic linearization of Schnakenberg" ;
        schema:name "continuum vs explicit-PDE dispersion Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9915" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-continuum-vs-explicit-pde-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-continuum-vs-explicit-pde-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 continuum dispersion (identity fit would be r = 1)" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-holocene-countable-detail-wavelengths-across-the-100-m-eye> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Holocene countable detail wavelengths across the 100 µm eye = 89 wavelengths" ;
        dct:description "Chronoseries 1/1 at 0 Ma versus the unresolved predecessor. No successor." ;
        schema:measurementTechnique "floor(100000 nm / 1120 nm)" ;
        schema:name "Holocene countable detail wavelengths across the 100 µm eye" ;
        schema:unitText "wavelengths" ;
        schema:value "89" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-holocene-countable-detail-wavelengths-across-the-100-m-eye-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-holocene-countable-detail-wavelengths-across-the-100-m-eye-reference> a schema:PropertyValue ;
        dct:source "Cambrian predecessor at a 10 µm preservation floor (N = 0)" ;
        schema:value "0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-segmented-specimen-body-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented specimen body aspect ratio = 0.6099 height/width" ;
        dct:description "foreground fraction = 0.1782; circularity = 0.1124" ;
        schema:measurementTechnique "Otsu dark-body mask on the CC BY specimen, largest component bounding box" ;
        schema:name "segmented specimen body aspect ratio" ;
        schema:unitText "height/width" ;
        schema:value "0.6099" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-segmented-specimen-body-aspect-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-segmented-specimen-body-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "circular-ocellus null (aspect 1); the whole animal is elongated" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-segmented-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented specimen structure-tensor coherency = 0.5216 coherency" ;
        dct:description "Specimen and simulation coherencies are paired, not copied: the reference is the simulation measurement." ;
        schema:measurementTechnique "mean (λ1−λ2)/(λ1+λ2) of the Sobel structure tensor on the specimen" ;
        schema:name "segmented specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.5216" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-segmented-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-segmented-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "same operator on the animated GIF last frame" ;
        schema:value "0.4965" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-specimen-stripe-wavelength-versus-ocellus-receptor-pitch> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen stripe wavelength versus ocellus receptor pitch = 1.1004 µm" ;
        dct:description "Detail wavelength is required to differ from the 2.5 µm pitch; equality would collapse this scale into the receptor lattice." ;
        schema:measurementTechnique "dominant DCT ring of the saturated activator, converted by domain length 14 × 1.12 µm" ;
        schema:name "specimen stripe wavelength versus ocellus receptor pitch" ;
        schema:unitText "µm" ;
        schema:value "1.1004" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-specimen-stripe-wavelength-versus-ocellus-receptor-pitch-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-measurement-specimen-stripe-wavelength-versus-ocellus-receptor-pitch-reference> a schema:PropertyValue ;
        dct:source "Ljungholm & Nilsson 2021 PLOS Comput Biol e1008808 photoreceptor centre spacing" ;
        schema:value "2.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-euperipatoides-rowelli-turing-wavelength-s0.py L102–L194" ;
        dct:description "Eigenvector-seeded dispersion, Pearson, RMSE, KS" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-euperipatoides-rowelli-turing-wavelength-s0.py#L102-L194> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-euperipatoides-rowelli-turing-wavelength-s0.py L275–L307" ;
        dct:description "Otsu body mask, aspect, circularity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-euperipatoides-rowelli-turing-wavelength-s0.py#L275-L307> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-morphometric-validation-3> a pk:EvidenceItem ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg k_sigma at 1.12 µm in the E. rowelli ocellus (Holocene, 0 Ma) — Parameter expressivity: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Raising γ shortens the selected wavelength monotonically across scales 0.55, 0.75, 1, 1.40, 1.90. Both diffusion ablations are linearly stable. They are not yet separated from each other inside the unstable band (R4)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-euperipatoides-rowelli-turing-wavelength-s0.py L195–L212" ;
        dct:description "gamma_sweep; lambda decreases as gamma increases" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-euperipatoides-rowelli-turing-wavelength-s0.py#L195-L212> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-euperipatoides-rowelli-turing-wavelength-s0.py L162–L169" ;
        dct:description "Equal Du=Dv and reversed Du>Dv controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-euperipatoides-rowelli-turing-wavelength-s0.py#L162-L169> .

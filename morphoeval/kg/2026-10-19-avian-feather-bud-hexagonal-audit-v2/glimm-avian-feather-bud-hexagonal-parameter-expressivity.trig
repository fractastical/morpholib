sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-glimm-avian-feather-bud-hexagonal> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Glimm et al. (2014) & Ho et al. (2019) avian feather bud hexagonal array, EDA traveling competence wave & FGF20/BMP4 perturbations — Parameter expressivity: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Executes a 6-point mediolateral competence wave speed sweep across v_w in {0.11, 0.16, 0.22, 0.45, 1.20, 100.0} (L379-422, Panel E), a 7-point FGF20 chemotactic sensitivity sweep across chi in {0.0, 0.01, 0.04, 0.08, 0.14, 0.20, 0.24} crossing chi_c = 0.0540 (L424-447, Panel F), and exposes CLI flags `--vw`, `--chi`, `--Dn`, `--Dc`, `--Db`, `--steps`, `--seed`, and `--self-test` (L814-830)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2018-glimm-avian-feather-bud-hexagonal.py L372–L449" ;
        dct:description "6-point wave-speed sweep (Ecto-D2 -> WT -> Fc-chEDA1) and 7-point chemotactic sensitivity sweep (scaleless/Latrunculin -> WT)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py#L372-L449> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2018-glimm-avian-feather-bud-hexagonal.py L814–L830" ;
        dct:description "Full CLI parameter overrides for wave speed, chemotaxis, diffusivities, steps, and seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py#L814-L830> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


            <https://doi.org/10.1371/journal.pbio.3000132>,
            <https://doi.org/10.1371/journal.pbio.3000448>,
            <https://doi.org/10.1371/journal.pone.0001942> .
    <https://doi.org/10.1016/j.ydbio.2014.08.030> dct:date "2014"^^xsd:gYear ;
        dct:title "Modeling happens in rows: Traveling waves in dermal condensation of avian feather primordia" .
    <https://doi.org/10.1371/journal.pbio.3000132> dct:date "2019"^^xsd:gYear ;
        dct:title "Feather arrays are patterned by interacting signaling and mechanical waves" .
    <https://doi.org/10.1371/journal.pbio.3000448> dct:date "2019"^^xsd:gYear ;
        dct:title "Symmetry breaking in the embryonic skin triggers directional and sequential plumage patterning" .
    <https://doi.org/10.1371/journal.pone.0001942> dct:date "2008"^^xsd:gYear ;
        dct:title "BMP2 and BMP7 Play Antagonistic Roles in Feather Primordium Formation: A Mechanistic Model" .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-glimm-avian-feather-bud-hexagonal> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Glimm et al. (2014) & Ho et al. (2019) avian feather bud hexagonal array, EDA traveling competence wave & FGF20/BMP4 perturbations — Morphometric validation: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L678-763) computes 8 reference-backed morphometrics with uncertainty statistics (CV, std) and negative-control contrast: Delta_x / lambda_y = 0.8660 (ref 0.8660), chi_c = 0.0540 (ref 0.0540), WT traveling-wave Voronoi P_6 = 0.8696 (ref 0.9167, |psi_6| = 0.9682, NN CV = 0.0485), simultaneous competence P_6 = 0.4500 (ref 0.5000, Delta_P6 = +0.4196), Ecto-D2 retarded wave tract width ratio 0.6085 (ref 0.6500), *scaleless* + Latrunculin negative control bud count 0 (ref 0, std = 2.09e-3), segmented specimen Panel B bud count 24 (ref 24, NN CV = 0.1974), and segmented specimen Panel B Voronoi P_6 = 0.7500 (ref 0.7500, P_567 = 1.0000)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-critical-fgf20-chemotactic-sensitivity-threshold-chi-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-ecto-d2-retarded-wave-v-w-0-11-normalized-feather-tract-width-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-equilateral-hexagonal-inter-row-to-intra-row-spacing-ratio-delta-x-lambda-y>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-scaleless-fgf20-chi-0-and-latrunculin-chi-0-01-negative-control-bud-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-segmented-gallus-gallus-panel-b-specimen-feather-primordia-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-segmented-gallus-gallus-panel-b-specimen-interior-voronoi-hexagonal-fraction-p-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-simultaneous-global-competence-v-w-inf-fc-cheda1-voronoi-hexagonal-fraction-p-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-wild-type-traveling-wave-v-w-0-22-hexagonal-voronoi-polygon-fraction-p-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-morphometric-validation-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-critical-fgf20-chemotactic-sensitivity-threshold-chi-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical FGF20 chemotactic sensitivity threshold chi_c = 0.054 chemotactic sensitivity" ;
        dct:description "WT sigma_max(chi=0.24) = +0.3967 vs scaleless sigma_max(chi=0) = -0.0800" ;
        schema:measurementTechnique "Keller-Segel / FGF20 linear instability threshold ((sqrt(D_n*mu_c)+sqrt(D_c*r_n))^2)/(n_0*f_c)" ;
        schema:name "critical FGF20 chemotactic sensitivity threshold chi_c" ;
        schema:unitText "chemotactic sensitivity" ;
        schema:value "0.054" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-critical-fgf20-chemotactic-sensitivity-threshold-chi-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-critical-fgf20-chemotactic-sensitivity-threshold-chi-c-reference> a schema:PropertyValue ;
        dct:source "Ho et al. (2019) PLOS Biol. 17:e3000132 & Lean Theorem 1 keller_segel_fgf20_chemotactic_instability" ;
        schema:value "0.054" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-ecto-d2-retarded-wave-v-w-0-11-normalized-feather-tract-width-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Ecto-D2 retarded wave (v_w=0.11) normalized feather tract width ratio = 0.6103 ratio to wild-type tract width" ;
        dct:description "Ecto-D2 tract width = 36.95 px vs WT = 60.55 px (24 vs 42 buds)" ;
        schema:measurementTechnique "Mediolateral feather tract span under Ecto-D2 / LDN 0.5x wave speed retardation relative to wild type" ;
        schema:name "Ecto-D2 retarded wave (v_w=0.11) normalized feather tract width ratio" ;
        schema:unitText "ratio to wild-type tract width" ;
        schema:value "0.6103" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-ecto-d2-retarded-wave-v-w-0-11-normalized-feather-tract-width-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-ecto-d2-retarded-wave-v-w-0-11-normalized-feather-tract-width-ratio-reference> a schema:PropertyValue ;
        dct:source "Ho et al. (2019) PLOS Biol. 17:e3000132 Fig. 3F-I (Ecto-D2 tract width 0.55-0.75x control)" ;
        schema:value "0.65" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-equilateral-hexagonal-inter-row-to-intra-row-spacing-ratio-delta-x-lambda-y> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equilateral hexagonal inter-row to intra-row spacing ratio Delta_x / lambda_y = 0.866 dimensionless ratio" ;
        dct:description "diagonal inter-row distance = 280.00 um == intra-row lambda_y = 280.00 um" ;
        schema:measurementTechnique "Half-period phase-pinned row spacing ratio sqrt(3)/2 (Delta_x = 242.49 um for lambda_y = 280.0 um)" ;
        schema:name "equilateral hexagonal inter-row to intra-row spacing ratio Delta_x / lambda_y" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "0.866" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-equilateral-hexagonal-inter-row-to-intra-row-spacing-ratio-delta-x-lambda-y-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-equilateral-hexagonal-inter-row-to-intra-row-spacing-ratio-delta-x-lambda-y-reference> a schema:PropertyValue ;
        dct:source "Glimm, Bhat & Newman (2014) Dev. Biol. 395:139-149 & Lean Theorem 2 hexagonal_row_offset_equidistance" ;
        schema:value "0.866" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-scaleless-fgf20-chi-0-and-latrunculin-chi-0-01-negative-control-bud-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "scaleless (FGF20-/-, chi=0) and Latrunculin (chi=0.01) negative control bud count = 0.0 buds" ;
        dct:description "scaleless std(n) = 4.22e-05, Latrunculin std(n) = 4.22e-05 vs WT std(n) = 0.6917" ;
        schema:measurementTechnique "Detected dermal condensates under FGF20 chemotaxis loss (chi = 0.0) and actomyosin motility blockade (chi = 0.01)" ;
        schema:name "scaleless (FGF20-/-, chi=0) and Latrunculin (chi=0.01) negative control bud count" ;
        schema:unitText "buds" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-scaleless-fgf20-chi-0-and-latrunculin-chi-0-01-negative-control-bud-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-scaleless-fgf20-chi-0-and-latrunculin-chi-0-01-negative-control-bud-count-reference> a schema:PropertyValue ;
        dct:source "Ho et al. (2019) PLOS Biol. 17:e3000132 Fig. 1C, F, G & Lean Theorem 1 keller_segel_fgf20_chemotactic_instability" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-segmented-gallus-gallus-panel-b-specimen-feather-primordia-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented Gallus gallus Panel B specimen feather primordia count = 24.0 buds" ;
        dct:description "detected 24 feather buds (12 interior Voronoi cells), NN spacing = 40.33 +- 7.96 px (CV = 0.1974)" ;
        schema:measurementTechnique "Difference-of-Gaussians optical density peak segmentation on chick_feather_bud_hexagonal_specimen.jpg Panel B ROI [494, 24, 770, 218]" ;
        schema:name "segmented Gallus gallus Panel B specimen feather primordia count" ;
        schema:unitText "buds" ;
        schema:value "24.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-segmented-gallus-gallus-panel-b-specimen-feather-primordia-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-segmented-gallus-gallus-panel-b-specimen-feather-primordia-count-reference> a schema:PropertyValue ;
        dct:source "Ho et al. (2019) PLOS Biol. 17:e3000132 Fig. 3B CTNNB1/EDA dorsal feather lattice" ;
        schema:value "24.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-segmented-gallus-gallus-panel-b-specimen-interior-voronoi-hexagonal-fraction-p-6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented Gallus gallus Panel B specimen interior Voronoi hexagonal fraction P_6 = 0.75 fraction of interior Voronoi cells" ;
        dct:description "specimen P_6 = 0.7500 (9/12 hexagons), P_567 = 1.0000 (12/12 in (5, 6, 7)), |psi_6| = 0.5265, Panel A +48h/+24h expansion = 2.1111x" ;
        schema:measurementTechnique "Voronoi polygon coordination analysis on segmented feather primordia in chick_feather_bud_hexagonal_specimen.jpg Panel B ROI [494, 24, 770, 218]" ;
        schema:name "segmented Gallus gallus Panel B specimen interior Voronoi hexagonal fraction P_6" ;
        schema:unitText "fraction of interior Voronoi cells" ;
        schema:value "0.75" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-segmented-gallus-gallus-panel-b-specimen-interior-voronoi-hexagonal-fraction-p-6-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-segmented-gallus-gallus-panel-b-specimen-interior-voronoi-hexagonal-fraction-p-6-reference> a schema:PropertyValue ;
        dct:source "Ho et al. (2019) PLOS Biol. 17:e3000132 Fig. 3B hexagonal feather primordia array" ;
        schema:value "0.75" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-simultaneous-global-competence-v-w-inf-fc-cheda1-voronoi-hexagonal-fraction-p-6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simultaneous global competence (v_w->inf, Fc-chEDA1) Voronoi hexagonal fraction P_6 = 0.45 fraction of interior Voronoi cells" ;
        dct:description "traveling-wave hexagonal gain Delta_P6 = +0.4196 (0.8696 vs 0.4500, |psi_6| = 0.2948)" ;
        schema:measurementTechnique "Interior Voronoi 6-sided polygon fraction under instantaneous global competence flooding (v_w = 100.0)" ;
        schema:name "simultaneous global competence (v_w->inf, Fc-chEDA1) Voronoi hexagonal fraction P_6" ;
        schema:unitText "fraction of interior Voronoi cells" ;
        schema:value "0.45" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-simultaneous-global-competence-v-w-inf-fc-cheda1-voronoi-hexagonal-fraction-p-6-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-simultaneous-global-competence-v-w-inf-fc-cheda1-voronoi-hexagonal-fraction-p-6-reference> a schema:PropertyValue ;
        dct:source "Ho et al. (2019) PLOS Biol. 17:e3000132 Fig. 1C & Lean Theorem 3 traveling_wave_hexagonal_fidelity_advantage" ;
        schema:value "0.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-wild-type-traveling-wave-v-w-0-22-hexagonal-voronoi-polygon-fraction-p-6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type traveling wave (v_w=0.22) hexagonal Voronoi polygon fraction P_6 = 0.8696 fraction of interior Voronoi cells" ;
        dct:description "WT P_6 = 0.8696, P_567 = 1.0000, |psi_6| = 0.9679, NN spacing CV = 0.0133 (N = 42 buds)" ;
        schema:measurementTechnique "Interior Voronoi 6-sided polygon fraction under row-by-row EDA traveling competence wave (v_w = 0.22)" ;
        schema:name "wild-type traveling wave (v_w=0.22) hexagonal Voronoi polygon fraction P_6" ;
        schema:unitText "fraction of interior Voronoi cells" ;
        schema:value "0.8696" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-wild-type-traveling-wave-v-w-0-22-hexagonal-voronoi-polygon-fraction-p-6-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-wild-type-traveling-wave-v-w-0-22-hexagonal-voronoi-polygon-fraction-p-6-reference> a schema:PropertyValue ;
        dct:source "Ho et al. (2019) PLOS Biol. 17:e3000132 Figs. 3-4 & Bailleul et al. (2019) PLOS Biol. 17:e3000448" ;
        schema:value "0.9167" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2018-glimm-avian-feather-bud-hexagonal.py L678–L763" ;
        dct:description "8 quantitative morphometrics covering Voronoi P_6, |psi_6|, NN CV, tract width ratio, mutant ablation, and specimen CV" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py#L678-L763> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;

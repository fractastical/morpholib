sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-glimm-avian-feather-bud-hexagonal> a pk:Claim ;
        rdfs:label "Glimm et al. (2014) & Ho et al. (2019) avian feather bud hexagonal array, EDA traveling competence wave & FGF20/BMP4 perturbations faithfully reproduces Embryonic chick (Gallus gallus) dorsal skin feather tract E6.5-E9.5 hexagonal feather primordia array & Fc-chEDA1/Ecto-D2/scaleless/Latrunculin perturbations morphology" ;
        dct:description "The simulation script(s) 2018-glimm-avian-feather-bud-hexagonal.py implement the cited source model as published and produce forms that match real Embryonic chick (Gallus gallus) dorsal skin feather tract E6.5-E9.5 hexagonal feather primordia array & Fc-chEDA1/Ecto-D2/scaleless/Latrunculin perturbations specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 92.6/100, audit 2026-10-19-avian-feather-bud-hexagonal-audit-v2) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py; output: docs/media/avian_feather_bud_hexagonal_comparison.png; organism: Embryonic chick (Gallus gallus) dorsal skin feather tract E6.5-E9.5 hexagonal feather primordia array & Fc-chEDA1/Ecto-D2/scaleless/Latrunculin perturbations; checkpoint commit: https://github.com/fractastical/morpholib/commit/3cb5ea9; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 97f8b6d41437bf22798c0eb2f411aef0516b204ccaeaa4edce5a129ec128b370; artifact_sha256: 4057a048e5bbc063a7d0432ce731757cb9bcf4df49cf9fccb3dbd00ed089e03f; input_dataset_sha256: {datasets/avian_feather_bud_hexagonal/avian_feather_bud_hexagonal_reference.json=06d930a05c4f2cee..., datasets/avian_feather_bud_hexagonal/chick_feather_bud_hexagonal_specimen.jpg=ce18b1c0e01ecb20..., datasets/avian_feather_bud_hexagonal/paper_citations.bib=9d17147a43097e6e..., datasets/avian_feather_bud_hexagonal/scout_manifest.json=1ff38c1e609c69ea...}; supersedes_audit_id: 2026-10-19-avian-feather-bud-hexagonal-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.ydbio.2014.08.030>,
            <https://doi.org/10.1371/journal.pbio.3000132>,
            <https://doi.org/10.1371/journal.pbio.3000448>,
            <https://doi.org/10.1371/journal.pone.0001942> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-specimen-match> ;
        pk:weightOfEvidence "0.926"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py> a schema:SoftwareSourceCode ;

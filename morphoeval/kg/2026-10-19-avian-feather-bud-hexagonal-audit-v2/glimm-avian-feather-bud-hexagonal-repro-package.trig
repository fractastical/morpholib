sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-glimm-avian-feather-bud-hexagonal> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Glimm et al. (2014) & Ho et al. (2019) avian feather bud hexagonal array, EDA traveling competence wave & FGF20/BMP4 perturbations — Reproducibility package: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Deterministic RNG (`seed=2018`), 8-check `self_test()` suite (L768-811) verifying SHA-256 locks, Keller-Segel threshold chi_c, equilateral neighbor distance invariance, WT traveling-wave P_6 >= 0.85 vs simultaneous competence P_6 = 0.45, Ecto-D2 tract narrowing, *scaleless*/Latrunculin 0-bud controls, 24-bud specimen Voronoi segmentation, and bitwise two-run determinism, plus animated growth GIF at `docs/media/avian_feather_bud_hexagonal_growth.gif`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-repro-package-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2018-glimm-avian-feather-bud-hexagonal.py L768–L811" ;
        dct:description "8-check deterministic self_test() suite including SHA-256 locks, Voronoi P_6 contrast, and bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py#L768-L811> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/avian_feather_bud_hexagonal_growth.gif (generated output)" ;
        dct:description "Animated GIF showing bilateral EDA competence wavefront s_w(x,t) and sequential row-by-row dermal condensate budding — docs/media/avian_feather_bud_hexagonal_growth.gif: rendered output of 2018-glimm-avian-feather-bud-hexagonal.py at 3cb5ea9, image/gif, 294375 B, 968×429 px, 6 frames, artifact_sha256 3342505e0edd64aea7e1b0ede15e853c661bb71a092303a7a41f71ec3e226add (sha256 3342505e0edd64aea7e1b0ede15e853c661bb71a092303a7a41f71ec3e226add), spec_fingerprint 97f8b6d41437bf22798c0eb2f411aef0516b204ccaeaa4edce5a129ec128b370" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


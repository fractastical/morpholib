sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-glimm-avian-feather-bud-hexagonal> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Glimm et al. (2014) & Ho et al. (2019) avian feather bud hexagonal array, EDA traveling competence wave & FGF20/BMP4 perturbations — Morphological realism / specimen match: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies Ho et al. (2019) PLOS Biology 17(2):e3000132 Fig. 3 (`datasets/avian_feather_bud_hexagonal/chick_feather_bud_hexagonal_specimen.jpg`, CC BY 4.0) and performs dual-ROI computer-vision segmentation (`segment_feather_tract_specimen`, L455-516): (1) extracts all 24 *CTNNB1*/*EDA* feather primordia in Panel B (`[494, 24, 770, 218]`), constructing their Voronoi tessellation and Delaunay neighbor graph (P_6 = 0.7500, P_567 = 1.0000, |psi_6| = 0.5265, NN spacing 40.33 +- 7.96 px, CV = 0.1974), and (2) measures the E6.5+24h to E6.5+48h mediolateral feather tract expansion in Panel A (38.0 / 18.0 = 2.1111x)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-specimen-match-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2018-glimm-avian-feather-bud-hexagonal.py L455–L516" ;
        dcterms:description "Automated DoG peak segmentation, Voronoi/Delaunay polygon coordination, and +48h/+24h tract expansion on Ho et al. (2019) Fig. 3 specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py#L455-L516> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/avian_feather_bud_hexagonal_comparison.png (generated output)" ;
        dcterms:description "8-panel publication figure with color-coded Voronoi polygon overlays on both simulated and empirical Gallus gallus feather arrays — docs/media/avian_feather_bud_hexagonal_comparison.png: rendered output of 2018-glimm-avian-feather-bud-hexagonal.py at 3cb5ea9, image/png, 1027726 B, 2565×1483 px, artifact_sha256 4057a048e5bbc063a7d0432ce731757cb9bcf4df49cf9fccb3dbd00ed089e03f (sha256 4057a048e5bbc063a7d0432ce731757cb9bcf4df49cf9fccb3dbd00ed089e03f), spec_fingerprint 97f8b6d41437bf22798c0eb2f411aef0516b204ccaeaa4edce5a129ec128b370" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


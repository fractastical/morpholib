<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/glimm-avian-feather-bud-hexagonal-1>,
        <https://w3id.org/probknow/resource/math-law/glimm-avian-feather-bud-hexagonal-2>,
        <https://w3id.org/probknow/resource/math-law/glimm-avian-feather-bud-hexagonal-3> .

<https://w3id.org/probknow/resource/math-law/glimm-avian-feather-bud-hexagonal-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Glimm et al. (2014) & Ho et al. (2019) Keller-Segel / FGF20 Dermal Chemotactic Instability vs. Scaleless (sc/sc) Stability" ;
    dct:description "Proves that supercritical FGF20 chemotaxis (χ > χ_c) drives spontaneous dermal mesenchymal condensation (det_KS < 0), whereas FGF20 loss in the scaleless (sc/sc) mutant or Latrunculin motility blockade (χ = 0) guarantees uniform dermal stability (det_KS > 0) | Variables: n(x,t): dermal mesenchymal cell density; c(x,t): FGF20 chemoattractant; χ: chemotactic sensitivity; D_n, D_c: diffusivities; q = k^2: squared spatial wavenumber" ;
    dct:source "Glimm, Bhat & Newman (2014) Dev. Biol. 395:139-149; Ho et al. (2019) PLoS Biol. 17(2):e3000132" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py#L120-L220>,
        <https://github.com/fractastical/morpholib/blob/3cb5ea9/morphoeval/lean/loops/Loop_019_avian_feather_bud_hexagonal.lean#L12-L46> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def keller_segel_fgf20_det (D_n r_n D_c mu_c chi n_0 f_c q : Int) : Int :=
  (D_n * q + r_n) * (D_c * q + mu_c) - chi * n_0 * f_c * q
def scaleless_neg_trace (D_n D_c r_n mu_c q : Nat) : Nat :=
  (D_n + D_c) * q + (r_n + 1) + (mu_c + 1)
def scaleless_pos_det (Dq_prod D_n_mu D_c_r r_pos : Nat) : Nat :=
  Dq_prod + D_n_mu + D_c_r + (r_pos + 1)
theorem keller_segel_fgf20_chemotactic_instability (D_n D_c r_n mu_c q Dq_prod D_n_mu D_c_r r_pos : Nat) :
    scaleless_neg_trace D_n D_c r_n mu_c q ≥ 2 ∧
    scaleless_pos_det Dq_prod D_n_mu D_c_r r_pos ≥ r_pos + 1 ∧
    keller_segel_fgf20_det 1 1 1 2 0 1 3 1 = 6 ∧
    keller_segel_fgf20_det 1 1 1 2 1 1 3 1 = 3 ∧
    keller_segel_fgf20_det 1 1 1 2 4 1 3 1 = -6 := by
  refine ⟨?_, ?_, by decide, by decide, by decide⟩
  · simp [scaleless_neg_trace]; omega
  · simp [scaleless_pos_det]
"""^^pk:lean4 ;
    skos:notation "det_KS(q) = (D_n q + r_n)(D_c q + μ_c) - χ n_0 f_c q < 0  (χ > χ_c),   det_KS(q)|_{χ=0} = (D_n q + r_n)(D_c q + μ_c) > 0  ∀ q > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.ydbio.2014.08.030>,
        <https://doi.org/10.1371/journal.pbio.3000132>,
        <https://doi.org/10.1371/journal.pbio.3000448>,
        <https://doi.org/10.1371/journal.pone.0001942> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled Keller-Segel Dermal Chemotaxis + FGF20/BMP4 Lateral Inhibition + EDA Traveling Competence Wave (Glimm et al. 2014 & Ho et al. 2019)" ;
    pk:leanDeclaration "MathOfBiology.Loop_019.keller_segel_fgf20_det" ;
    pk:leanTheorem "MathOfBiology.Loop_019.keller_segel_fgf20_chemotactic_instability" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/glimm-avian-feather-bud-hexagonal-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Glimm et al. (2014) & Ho et al. (2019) Equilateral Row-to-Row Half-Phase Offset & 6-Equidistant Nearest-Neighbor Theorem" ;
    dct:description "Proves that when BMP4 lateral inhibition pins each successive mediolateral row at half-period offset Δy = λ_y / 2 and spacing Δx = (√3/2) λ_y, all 6 nearest neighbors (2 intra-row and 4 diagonal inter-row) lie at identical distance λ_y, forming a crystalline 60° hexagonal array | Variables: λ_y: longitudinal intra-row feather bud spacing; Δy = λ_y / 2: BMP4-pinned half-period phase offset; Δx: mediolateral inter-row spacing" ;
    dct:source "Glimm, Bhat & Newman (2014) Dev. Biol. 395:139-149 Figs. 2-4; Ho et al. (2019) PLoS Biol. 17:e3000132 Fig. 3B" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py#L222-L320>,
        <https://github.com/fractastical/morpholib/blob/3cb5ea9/morphoeval/lean/loops/Loop_019_avian_feather_bud_hexagonal.lean#L45-L68> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def scaled_inter_row_diag_dist_sq (dx_sq ly_sq : Int) : Int :=
  4 * dx_sq + ly_sq
def scaled_intra_row_dist_sq (ly_sq : Int) : Int :=
  4 * ly_sq
theorem hexagonal_row_offset_equidistance (dx_sq ly_sq : Int)
    (h_hex : 4 * dx_sq = 3 * ly_sq) :
    scaled_inter_row_diag_dist_sq dx_sq ly_sq = scaled_intra_row_dist_sq ly_sq := by
  simp [scaled_inter_row_diag_dist_sq, scaled_intra_row_dist_sq]
  omega
"""^^pk:lean4 ;
    skos:notation "d_diag^2 = (Δx)^2 + (λ_y / 2)^2 = λ_y^2  ⟺  4(Δx)^2 = 3 λ_y^2  ⟺  Δx = (√3 / 2) λ_y ≈ 0.8660 λ_y" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.ydbio.2014.08.030>,
        <https://doi.org/10.1371/journal.pbio.3000132>,
        <https://doi.org/10.1371/journal.pbio.3000448>,
        <https://doi.org/10.1371/journal.pone.0001942> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled Keller-Segel Dermal Chemotaxis + FGF20/BMP4 Lateral Inhibition + EDA Traveling Competence Wave (Glimm et al. 2014 & Ho et al. 2019)" ;
    pk:leanDeclaration "MathOfBiology.Loop_019.scaled_inter_row_diag_dist_sq" ;
    pk:leanTheorem "MathOfBiology.Loop_019.hexagonal_row_offset_equidistance" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/glimm-avian-feather-bud-hexagonal-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Ho et al. (2019) & Bailleul et al. (2019) Traveling Competence Wave Hexagonal Fidelity Enhancement Theorem" ;
    dct:description "Proves that sequential row-by-row competence propagation at v_w = v_opt suppresses 5-7 grain-boundary defects and achieves strictly higher hexagonal Voronoi fidelity P_6 than simultaneous global competence (v_w → ∞, exogenous Fc-chEDA1/FGF flooding) | Variables: v_w: mediolateral EDA competence wave speed; P_6: percentage of 6-coordinated hexagonal Voronoi polygons; d_min: intrinsic defect floor; d_gain: simultaneous-nucleation grain-boundary defect penalty" ;
    dct:source "Ho et al. (2019) PLoS Biol. 17(2):e3000132 Figs. 1C, 3, 4; Bailleul et al. (2019) PLoS Biol. 17(10):e3000448" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py#L322-L490>,
        <https://github.com/fractastical/morpholib/blob/3cb5ea9/morphoeval/lean/loops/Loop_019_avian_feather_bud_hexagonal.lean#L71-L97> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def hexagonal_p6_opt_pct (d_min : Nat) : Nat :=
  100 - d_min
def hexagonal_p6_simul_pct (d_min d_gain : Nat) : Nat :=
  100 - (d_min + (d_gain + 1))
theorem traveling_wave_hexagonal_fidelity_advantage (d_min d_gain : Nat)
    (h_bound : d_min + (d_gain + 1) ≤ 100) :
    hexagonal_p6_opt_pct d_min > hexagonal_p6_simul_pct d_min d_gain ∧
    hexagonal_p6_opt_pct 8 = 92 ∧
    hexagonal_p6_simul_pct 8 41 = 50 := by
  refine ⟨?_, by decide, by decide⟩
  simp [hexagonal_p6_opt_pct, hexagonal_p6_simul_pct]
  omega
"""^^pk:lean4 ;
    skos:notation "P_6(v_opt) = 100 - d_min > P_6(v → ∞) = 100 - (d_min + d_gain)  (d_gain ≥ 1);   P_6(v_opt) = 92% > P_6(v → ∞) = 50%" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.ydbio.2014.08.030>,
        <https://doi.org/10.1371/journal.pbio.3000132>,
        <https://doi.org/10.1371/journal.pbio.3000448>,
        <https://doi.org/10.1371/journal.pone.0001942> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled Keller-Segel Dermal Chemotaxis + FGF20/BMP4 Lateral Inhibition + EDA Traveling Competence Wave (Glimm et al. 2014 & Ho et al. 2019)" ;
    pk:leanDeclaration "MathOfBiology.Loop_019.hexagonal_p6_opt_pct" ;
    pk:leanTheorem "MathOfBiology.Loop_019.traveling_wave_hexagonal_fidelity_advantage" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Dictyostelium discoideum Schnakenberg Turing wavelength at 2.304 µm (Holocene, 0 Ma) — Morphometric validation: 64/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 1 records that the analytical peak is 2.3037 µm against the 2.304 µm coordinate. Pearson r, RMSE, KS, and the specimen mask statistics are the Pass 2 remediation." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-cortical-spot-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-dispersion-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-dispersion-relation-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-equal-diffusion-ablation-variance-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-simulated-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-specimen-image-orientation-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-cortical-spot-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cortical spot count = 32 1" ;
        schema:measurementTechnique "connected components of u above the 0.72 quantile" ;
        schema:name "cortical spot count" ;
        schema:unitText "1" ;
        schema:value "32" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-cortical-spot-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-cortical-spot-count-reference> a schema:PropertyValue ;
        dct:source "(L/λ_c)^2 = 25, a square lattice count the nonlinear spots need not hit" ;
        schema:value "25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-dispersion-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion KS statistic = 0.08695652173913049 1" ;
        dct:description "p=1" ;
        schema:measurementTechnique "two-sample KS between theoretical and measured growth-rate samples" ;
        schema:name "dispersion KS statistic" ;
        schema:unitText "1" ;
        schema:value "0.08695652173913049" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "screening tolerance; value is the measured statistic" ;
        schema:value "0.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-dispersion-relation-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion-relation Pearson r = 0.9999999972994091 1" ;
        dct:description "RMSE 3.668159e-05 1/s over 23 modes; KS statistic 0.0870" ;
        schema:measurementTechnique "Pearson r of integrated Fourier-mode growth versus discrete-Laplacian σ(k) on the unstable band" ;
        schema:name "dispersion-relation Pearson r" ;
        schema:unitText "1" ;
        schema:value "0.9999999972994091" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-dispersion-relation-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-dispersion-relation-pearson-r-reference> a schema:PropertyValue ;
        dct:source "identity line of linear theory; measured r is the residual" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 3.668158916207434e-05 1/s" ;
        schema:measurementTechnique "root mean square residual of σ_measured against σ_theory" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/s" ;
        schema:value "3.668158916207434e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "pre-set screening tolerance, not the measured residual" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-equal-diffusion-ablation-variance-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation variance ratio = 3.823912608393148e-05 1" ;
        dct:description "negative control versus the Turing regime" ;
        schema:measurementTechnique "var(u) final / var(u) initial with Du = Dv" ;
        schema:name "equal-diffusion ablation variance ratio" ;
        schema:unitText "1" ;
        schema:value "3.823912608393148e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-equal-diffusion-ablation-variance-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-equal-diffusion-ablation-variance-ratio-reference> a schema:PropertyValue ;
        dct:source "same initial noise evolved at δ = 24; the ablation ratio must sit below it" ;
        schema:value "246.55114018806117" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-simulated-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated stripe wavelength = 2.3037213180107243 µm" ;
        dct:description "absolute error 0.000279 µm" ;
        schema:measurementTechnique "argmax of discrete-Laplacian Schnakenberg growth rate σ(k)" ;
        schema:name "simulated stripe wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.3037213180107243" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-simulated-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-simulated-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "slot 3168 catalog coordinate 2.304 µm (2.304e-06 m), not a wet-lab mean" ;
        schema:value "2.304" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen contour circularity = 0.09609050225669176 1" ;
        dct:description "value != reference: fruiting-body silhouette versus cortical spot" ;
        schema:measurementTechnique "4πA/P² on the border-contrast mask of the sorocarp photograph" ;
        schema:name "specimen contour circularity" ;
        schema:unitText "1" ;
        schema:value "0.09609050225669176" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "round-spot circularity typical of a saturated Schnakenberg spot; the sorocarp is not a spot" ;
        schema:value "0.75" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen foreground fraction = 0.18145833333333333 1" ;
        schema:measurementTechnique "mean of the 160×120 border-contrast mask" ;
        schema:name "specimen foreground fraction" ;
        schema:unitText "1" ;
        schema:value "0.18145833333333333" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "not the measured mask; a filled-cell occupancy would be higher" ;
        schema:value "0.45" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-specimen-image-orientation-ks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image orientation KS = 0.05918209876543212 1" ;
        schema:measurementTechnique "KS statistic of Sobel orientations, specimen photograph versus GIF last frame" ;
        schema:name "specimen image orientation KS" ;
        schema:unitText "1" ;
        schema:value "0.05918209876543212" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-specimen-image-orientation-ks-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-specimen-image-orientation-ks-reference> a schema:PropertyValue ;
        dct:source "a matched-image KS near 0; the measured statistic is the distance" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.5803873198291329 1" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) on the specimen mask" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "1" ;
        schema:value "0.5803873198291329" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "placeholder isotropic-field coherency, not the measured stalk image" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dictyostelium-discoideum-turing-wavelength-s0.py L109–L123" ;
        dct:description "analytical_peak_wavelength" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dictyostelium-discoideum-turing-wavelength-s0.py#L109-L123> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor on this pass)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1073/pnas.1218025110>,
            <https://doi.org/10.1098/rspb.1995.0037>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1073/pnas.1218025110> dct:date "2013"^^xsd:gYear ;
        dct:title "Phase geometries of two-dimensional excitable waves govern self-organized morphodynamics of amoeboid cells" .
    <https://doi.org/10.1098/rspb.1995.0037> dct:date "1995"^^xsd:gYear ;
        dct:title "Dictyostelium discoideum: cellular self-organization in an excitable biological medium" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
}


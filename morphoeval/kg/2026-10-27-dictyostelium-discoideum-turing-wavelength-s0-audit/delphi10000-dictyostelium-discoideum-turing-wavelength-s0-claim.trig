sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Dictyostelium discoideum Schnakenberg Turing wavelength at 2.304 µm (Holocene, 0 Ma) faithfully reproduces Dictyostelium discoideum morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-dictyostelium-discoideum-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Dictyostelium discoideum specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-dictyostelium-discoideum-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-dictyostelium-discoideum-turing-wavelength-s0.py; output: docs/media/dictyostelium_discoideum_turing_wavelength_s0_comparison.png; organism: Dictyostelium discoideum; environment: python 3.12.3, numpy 2.5.4, scipy 1.18.1, matplotlib 3.11.2, pillow 13.0.0; claim_boundary: [reported_in_source: Turing 1952: diffusion-driven instability at a finite critical wavenumber. | Taniguchi 2013: Dictyostelium PIP3 and F-actin travel as cortical excitable waves. | Höfer, Sherratt and Maini 1995: cAMP relay plus chemotaxis produces aggregation streams.; reconstructed_in_script: Schnakenberg PDE with a=0.16, b=0.94, Du=0.03208776235376616, Dv=0.770106296490388, periodic 80×80 grid, seed 3168.; transfer_boundary: Catalog wavelength 2.304 µm (2.304e-06 m, log10=-5.638, tier 3_subcellular_um) is the slot coordinate inside the cortical-wave band, not a printed wet-lab mean. | Chronoseries 1/1 at 0 Ma. A 0.20 µm molecular regime admits zero modes; millimetre-scale cAMP waves are a longer regime of the same extant species.; does_not_claim: That sorocarps are pigment stripes or ocelli. | That the phase-singularity model of Taniguchi 2013 was integrated.]; phenomenon_size: 205 µm (0.0002048 m, log10=-3.689 m, tier=5_primordium_100um); species_scale_ladder (1 runs from 205 µm to 205 µm): 205 µm:limit-cycle-turing" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1073/pnas.1218025110>,
            <https://doi.org/10.1098/rspb.1995.0037>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-dictyostelium-discoideum-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-dictyostelium-discoideum-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1073/pnas.1218025110>,
            <https://doi.org/10.1098/rspb.1995.0037>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1073/pnas.1218025110> dct:date "2013"^^xsd:gYear ;
        dct:title "Phase geometries of two-dimensional excitable waves govern self-organized morphodynamics of amoeboid cells" .
    <https://doi.org/10.1098/rspb.1995.0037> dct:date "1995"^^xsd:gYear ;
        dct:title "Dictyostelium discoideum: cellular self-organization in an excitable biological medium" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
}


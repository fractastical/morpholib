<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-dictyostelium-discoideum-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-dictyostelium-discoideum-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-dictyostelium-discoideum-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-dictyostelium-discoideum-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg diffusion-ratio gate at 2.304 µm" ;
    dct:description "Onset condition for Turing Reaction-Diffusion Wavelength Selection in Dictyostelium discoideum at 2.304 µm | Variables: delta = 24, fu_milli = 709, gv_milli = -1210" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dictyostelium-discoideum-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3168_dictyostelium_discoideum_turing_wavelength_s0.lean#L16-L21> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def law1_diffusion_margin (delta fu_milli gv_milli : Int) : Int := delta * fu_milli + gv_milli
theorem law1_cortical_ratio_exceeds_onset : law1_diffusion_margin 24 709 (-1210) > 0 := by decide"""^^pk:lean4 ;
    skos:notation "delta * f_u + g_v > 0, with delta = Dv/Du = 24, f_u ≈ 0.709, g_v = -1.21" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.1218025110>,
        <https://doi.org/10.1098/rspb.1995.0037>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3168.law1_diffusion_margin" ;
    pk:leanTheorem "MathOfBiology.Loop_3168.law1_cortical_ratio_exceeds_onset" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-dictyostelium-discoideum-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Five cortical modes per vegetative cell" ;
    dct:description "Mode count for stripes, spots and ocelli on one Holocene Dictyostelium cell versus the molecular predecessor regime | Variables: L = 11520 nm, lambda_c = 2304 nm, L_molecular = 200 nm" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dictyostelium-discoideum-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3168_dictyostelium_discoideum_turing_wavelength_s0.lean#L24-L33> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def law2_mode_count (length_nm wavelength_nm : Int) : Int := length_nm / wavelength_nm
theorem law2_five_modes_in_vegetative_cell : law2_mode_count 11520 2304 = 5 := by decide
theorem law2_molecular_predecessor_admits_no_mode : law2_mode_count 200 2304 = 0 := by decide"""^^pk:lean4 ;
    skos:notation "N = L / lambda_c = 11520 nm / 2304 nm = 5; molecular predecessor 200 nm admits N = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.1218025110>,
        <https://doi.org/10.1098/rspb.1995.0037>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3168.law2_mode_count" ;
    pk:leanTheorem "MathOfBiology.Loop_3168.law2_five_modes_in_vegetative_cell" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-dictyostelium-discoideum-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Aggregation-scale successor is a longer wavelength" ;
    dct:description "Critical scale gap for Turing wavenumber k_c between the cortical band and the extracellular cAMP field | Variables: successor_nm = 1000000 (1 mm cAMP-wave order), cortical_nm = 2304" ;
    dct:source "Höfer, Sherratt & Maini (1995) DOI:10.1098/rspb.1995.0037; Sawai, Thomason & Cox (2005) DOI:10.1038/nature03228" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dictyostelium-discoideum-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3168_dictyostelium_discoideum_turing_wavelength_s0.lean#L37-L42> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def law3_scale_gap (successor_nm cortical_nm : Int) : Int := successor_nm - cortical_nm
theorem law3_aggregation_successor_is_longer : law3_scale_gap 1000000 2304 > 0 := by decide"""^^pk:lean4 ;
    skos:notation "L_aggregation - lambda_c = 1000000 nm - 2304 nm > 0 at geological age 0 Ma" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.1218025110>,
        <https://doi.org/10.1098/rspb.1995.0037>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3168.law3_scale_gap" ;
    pk:leanTheorem "MathOfBiology.Loop_3168.law3_aggregation_successor_is_longer" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila elegans Schnakenberg Turing wavelength at 1.8 µm (Holocene, 0 Ma) — Parameter expressivity: 62/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Three chronospecies ratios at fixed Du move the linear wavelength from 1.803 µm (elegans) to 1.940 µm (erecta) to 2.196 µm (deflecta), and that ordering is plotted. There is no sweep across the ratio range and no simulated equal-diffusion control, so expressivity is only shown at three hand-chosen points." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py L182–L203" ;
        dct:description "chronospecies_table at r/r_c = 2.65, 1.06, 1.48" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e7f1d7c4b94a5129fd92c9739f2ce6b72bc4ab0f/models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py#L182-L203> .

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila elegans Schnakenberg Turing wavelength at 1.8 µm (Holocene, 0 Ma) — Morphometric validation: 70/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion goodness-of-fit is real: Pearson r = 0.991 and RMSE = 0.0249 between the continuous growth rate and the 3-point stencil at dx = 0.180 µm, and the nonlinear FFT wavelength (1.669 µm) is reported against 1.803 µm rather than overwritten. The specimen foreground fraction is 1.0, which is a failed leaf test (the leaf has R ≈ G), so the image morphometric in this pass is not usable. No KS statistic and no seed coefficient of variation." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py L260–L268: leaf test G > R+18, which classifies this yellow leaf as foreground <https://github.com/fractastical/morpholib/blob/e7f1d7c4b94a5129fd92c9739f2ce6b72bc4ab0f/models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py#L260-L268>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-deflecta-predecessor-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-elegans-linear-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-elegans-nonlinear-fft-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-erecta-successor-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-deflecta-predecessor-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "deflecta_predecessor_wavelength = 2.1955818319842684 µm" ;
        dct:description "reconstructed; not a published deflecta granule measurement" ;
        schema:measurementTechnique "same Du as elegans, r/r_c = 2.65" ;
        schema:name "deflecta_predecessor_wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.1955818319842684" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-deflecta-predecessor-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-deflecta-predecessor-wavelength-reference> a schema:PropertyValue ;
        dct:source "elegans focal wavelength, for the chronoseries contrast" ;
        schema:value "1.803" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r = 0.9913490375997328 1" ;
        dct:description "RMSE 0.02486 over 28 modes" ;
        schema:measurementTechnique "Pearson r, continuous sigma(k) vs 3-point stencil at the production dx" ;
        schema:name "dispersion_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.9913490375997328" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "goodness-of-fit gate, not the measured correlation" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_rmse = 0.024855466018817347 1/time" ;
        dct:description "nonzero because the stencil is not the continuous Laplacian" ;
        schema:measurementTechnique "RMSE of continuous vs finite-difference growth rates" ;
        schema:name "dispersion_rmse" ;
        schema:unitText "1/time" ;
        schema:value "0.024855466018817347" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "identical-discretization null" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-elegans-linear-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "elegans_linear_wavelength = 1.8027305239927656 µm" ;
        dct:description "grid search residual vs the assigned 1.803 µm target" ;
        schema:measurementTechnique "argmax of analytic sigma(k) at the solved Du" ;
        schema:name "elegans_linear_wavelength" ;
        schema:unitText "µm" ;
        schema:value "1.8027305239927656" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-elegans-linear-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-elegans-linear-wavelength-reference> a schema:PropertyValue ;
        dct:source "assigned detail scale 1.803 µm" ;
        schema:value "1.803" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-elegans-nonlinear-fft-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "elegans_nonlinear_fft_wavelength = 1.6689846012222171 µm" ;
        dct:description "Pass 1 does not retune Du to close this gap" ;
        schema:measurementTechnique "power-weighted radial FFT peak of the steady activator" ;
        schema:name "elegans_nonlinear_fft_wavelength" ;
        schema:unitText "µm" ;
        schema:value "1.6689846012222171" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-elegans-nonlinear-fft-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-elegans-nonlinear-fft-wavelength-reference> a schema:PropertyValue ;
        dct:source "assigned detail scale 1.803 µm" ;
        schema:value "1.803" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-erecta-successor-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "erecta_successor_wavelength = 1.940094743973405 µm" ;
        dct:description "reconstructed; erecta is the chronoseries successor, not gunungcola" ;
        schema:measurementTechnique "same Du as elegans, r/r_c = 1.48" ;
        schema:name "erecta_successor_wavelength" ;
        schema:unitText "µm" ;
        schema:value "1.940094743973405" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-erecta-successor-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-erecta-successor-wavelength-reference> a schema:PropertyValue ;
        dct:source "elegans focal wavelength, for the chronoseries contrast" ;
        schema:value "1.803" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_foreground_fraction = 1.0 1" ;
        dct:description "Pass 1 green screen only; eye circularity and the scale bar are Pass 2" ;
        schema:measurementTechnique "fraction of pixels failing the green-leaf test G > R+18 and G > B+8" ;
        schema:name "specimen_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "neutral half-frame prior, not the measured fraction" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py L150–L180" ;
        dct:description "dispersion_goodness_of_fit Pearson r and RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e7f1d7c4b94a5129fd92c9739f2ce6b72bc4ab0f/models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py#L150-L180> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "datasets/drosophila_elegans_turing_wavelength_s0/loop_3182_metrics.json (generated output)" ;
        dct:description "nonlinear_wavelength_um 1.669, pearson_r 0.991, foreground_fraction 1.0 — datasets/drosophila_elegans_turing_wavelength_s0/loop_3182_metrics.json: rendered output of models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py at e7f1d7c4b94a5129fd92c9739f2ce6b72bc4ab0f, application/json, 2479 B, artifact_sha256 f82e0375c8089f1179933cc75a941d128628ba020b4e3d7cf2042c803293be8e (sha256 f82e0375c8089f1179933cc75a941d128628ba020b4e3d7cf2042c803293be8e), spec_fingerprint a12bb3100b597e414ef74972864fc5e5fa6a02a00d315c7492cd5f4151bd913e" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;

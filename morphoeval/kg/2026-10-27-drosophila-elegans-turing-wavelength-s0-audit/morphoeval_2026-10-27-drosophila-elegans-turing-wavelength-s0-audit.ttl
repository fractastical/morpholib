<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila elegans Schnakenberg Turing wavelength at 1.8 µm (Holocene, 0 Ma) — Morphological realism / specimen match: 76/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The comparison figure places the real lateral adult next to a hexagonal activator lattice, and the growth GIF ends on that photograph with a magnified 1.8 µm inset. The lattice reads as ocelli, which is the right pattern class, but the photograph cannot confirm granule spacing and the wing mask is an ellipse placed from the body centroid." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-specimen-match-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-specimen-match-2> ;

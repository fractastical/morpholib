<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-elegans-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-elegans-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-elegans-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-elegans-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homogeneous stability of the Schnakenberg state" ;
    dct:description "The 1.8 µm epithelium is stable without diffusion, so any pattern is diffusion-driven. | Variables: a = 0.12, b = 0.88, trace = -0.24, det = 1" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e7f1d7c4b94a5129fd92c9739f2ce6b72bc4ab0f/models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/e7f1d7c4b94a5129fd92c9739f2ce6b72bc4ab0f/morphoeval/lean/loops/Loop_3182_drosophila_elegans_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "trace J = f_u + g_v < 0 and det J > 0 at u0 = a + b, v0 = b/u0^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1038/nature04597>,
        <https://doi.org/10.1038/sj.hdy.6800814>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3182.homogeneous_trace_negative" ;
    pk:leanTheorem "MathOfBiology.Loop_3182.homogeneous_trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-elegans-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Onset margin and equal-diffusion ablation" ;
    dct:description "What changes at 0 Ma along the chronoseries is the inhibitor range, not the sign of the trace. | Variables: elegans R=9934 unstable; ablation R=1000 stable; deflecta R=24836; erecta R=13871" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e7f1d7c4b94a5129fd92c9739f2ce6b72bc4ab0f/models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/e7f1d7c4b94a5129fd92c9739f2ce6b72bc4ab0f/morphoeval/lean/loops/Loop_3182_drosophila_elegans_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(r f_u + g_v)^2 - 4 r det J > 0 iff the ratio is above onset" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1038/nature04597>,
        <https://doi.org/10.1038/sj.hdy.6800814>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3182.turingMargin" ;
    pk:leanTheorem "MathOfBiology.Loop_3182.elegans_turing_unstable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-elegans-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength and chronoseries order" ;
    dct:description "The assigned 1.8 µm scale is the elegans fastest linear wavelength. Neighbors are longer because they sit farther above onset. | Variables: elegans 1803 nm at r/r_c = 1.06; erecta 1940 nm; deflecta 2196 nm; age 0 Ma" ;
    dct:source "Yeh, Liou & True 2006 DOI:10.1038/sj.hdy.6800814" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e7f1d7c4b94a5129fd92c9739f2ce6b72bc4ab0f/models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/e7f1d7c4b94a5129fd92c9739f2ce6b72bc4ab0f/morphoeval/lean/loops/Loop_3182_drosophila_elegans_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda = 2 pi / k_max, with k_max = argmax Re sigma(k); deflecta > erecta > elegans" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1038/nature04597>,
        <https://doi.org/10.1038/sj.hdy.6800814>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3182.chronospecies_wavelength_order" ;
    pk:leanTheorem "MathOfBiology.Loop_3182.elegans_wavenumber_brackets_two_pi" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


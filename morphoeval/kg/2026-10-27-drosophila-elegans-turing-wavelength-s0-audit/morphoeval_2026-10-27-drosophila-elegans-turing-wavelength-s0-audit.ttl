<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila elegans Schnakenberg Turing wavelength at 1.8 µm (Holocene, 0 Ma) — Code-to-model traceability: 82/100" ;
    dct:date "2026-10-27"^^xsd:date ;

    pk:hasVerdict "mostly faithful" .

<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Drosophila elegans Schnakenberg Turing wavelength at 1.8 µm (Holocene, 0 Ma) (Drosophila elegans)",
        "Drosophila elegans Schnakenberg Turing wavelength at 1.8 µm (Holocene, 0 Ma) faithfully reproduces Drosophila elegans morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-elegans-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-elegans-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-elegans-turing-wavelength-s0-3> ;
    dct:description "The simulation script(s) models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila elegans specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py> ;
    schema:about "Drosophila elegans" ;
    schema:additionalProperty "does_not_claim: No published granule-spacing measurement for D. deflecta or D. erecta is being reproduced.",
        "does_not_claim: The macro photograph does not resolve 1.8 µm granules.",
        "reconstructed_in_script: Du is solved so argmax sigma(k) equals 2π/1.803 µm at r/r_c = 1.06. Deflecta and erecta wavelengths are the same law at r/r_c = 2.65 and 1.48.",
        "reported_in_source: Turing 1952: diffusion can destabilize a stable homogeneous state at a finite wavenumber. Schnakenberg 1979: the two-species kinetics used here.",
        "reported_in_source: Yeh, Liou & True 2006: male D. elegans carries an apical wing melanin patch used in courtship, divergent from D. gunungcola.",
        "transfer_boundary: Deflecta and erecta are chronoseries neighbors (11/41), not the sister species in the Yeh and Massey papers." ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Drosophila elegans (Morning-Glory Flower-Breeding Fly)" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "II. Anaima (Invertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;
    pk:aristotelianSubalternClass "Entoma (Arthropoda)" ;
    pk:biologicalGenus "Drosophila" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py; output: docs/media/drosophila_elegans_turing_wavelength_s0_comparison.png; organism: Drosophila elegans; environment: python 3.12.3, numpy 2.5.4, scipy 1.18.1, matplotlib 3.11.2, Pillow 13.0.0; claim_boundary: [reported_in_source: Yeh, Liou & True 2006: male D. elegans carries an apical wing melanin patch used in courtship, divergent from D. gunungcola. | Turing 1952: diffusion can destabilize a stable homogeneous state at a finite wavenumber. Schnakenberg 1979: the two-species kinetics used here.; reconstructed_in_script: Du is solved so argmax sigma(k) equals 2π/1.803 µm at r/r_c = 1.06. Deflecta and erecta wavelengths are the same law at r/r_c = 2.65 and 1.48.; transfer_boundary: Deflecta and erecta are chronoseries neighbors (11/41), not the sister species in the Yeh and Massey papers.; does_not_claim: The macro photograph does not resolve 1.8 µm granules. | No published granule-spacing measurement for D. deflecta or D. erecta is being reproduced.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
    pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1038/nature04597>,
        <https://doi.org/10.1038/sj.hdy.6800814>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:externalAtlasDataset <https://codex.flywire.ai/>,
        <https://flybase.org/>,
        <https://flycellatlas.org/>,
        <https://insitu.fruitfly.org/>,
        <https://www.virtualflybrain.org/> ;
    pk:fossilLineageGroup "Sophophora suzukii–biarmipes Wing-Spot Clade" ;
    pk:geologicalAgeMa 0e+00 ;
    pk:geologicalPeriod "Holocene (Extant)" ;
    pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-code-traceability>,

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-jonsson-auxin-pin1-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) up-the-gradient PIN1 polarization with explicit PIN1 trafficking kinetics, quasi-3D subepidermal canalization, and polar auxin transport for shoot apical meristem phyllotaxis — Morphometric validation: 68/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: 16 measurements with units, reference values, sources and methods (L1529-1680); the new ones compare against literature or against the paper's own analytic predictions rather than against themselves — strand width 1 cell vs the Scarpella/Bayer 1-2 cell band, delivered fraction 0.97 vs idealised 1.0 with the ablation at 0.68, BFA PM fraction 0.0857 equal to the first-order prediction (an identity for the exact integrator), kinetic-vs-QSS deviation 0.053 with the fast-cycling check 0.013, Spearman -0.89 for the exponent sweep; measurements #1 and #5 now say NOT EMERGENT in their method strings and #4 reports the raw cosine (0.994) instead of a value recalibrated onto the 0.84 reference. Deductions: #1 (L1549-1557, 137.39 deg) and #5 (L1581-1588, Pearson r = 1.0) remain in the list although they validate seeded inputs (-10); #4's 0.84 reference, the 2.68/2.85 contrasts and the per-regime Gamma values in the reference JSON are not traceable to a figure or table of the cited papers (-7); #12 (BFA) and #13 (endocytosis ratio) use model-derived references, so they are consistency checks rather than empirical comparisons (-5); the PM fraction reference 0.9 is a qualitative band edge, and no quantitative PIN1 localisation or strand-width measurement from an image is made (-6); #2 compares a calibrated peak to its calibration target (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2006-jonsson-auxin-pin1-meristem.py L1549–L1557: Measurement #1 method string: 'NOT EMERGENT: P1..P8 are seeded at golden-angle targets' <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L1549-L1557>",
            "2006-jonsson-auxin-pin1-meristem.py L1638–L1646: BFA measurement's reference_value is the model's own first-order prediction (self-consistency, not an empirical value) <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L1638-L1646>",
            "datasets/auxin_pin1_phyllotaxis/auxin_pin1_phyllotaxis_reference.json L165–L189: perturbation_experiments contrasts 2.68 / 2.85 and convergence index 0.84 carry no figure/table pinpoint <https://github.com/fractastical/morpholib/blob/d58a084/datasets/auxin_pin1_phyllotaxis/auxin_pin1_phyllotaxis_reference.json#L165-L189>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-auxin-inhibited-endocytosis-polarity-ratio-vs-exocytosis-targeting>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-bfa-exocytosis-block-membrane-pin1-fraction-2h>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-canalization-flux-delivered-to-vascular-sink-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-canalization-strand-width-vs-feedback-exponent-spearman-rho>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-characteristic-primordium-spacing-wavelength>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-critical-pin1-feedback-threshold-c1-a0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-exogenous-iaa-paste-rescue-peak-angle>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-four-mode-divergence-angle-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-npa-polar-transport-block-contrast>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-plasma-membrane-fraction-wild-type>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-primordium-convergence-polarity-index>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-trafficking-kinetic-vs-analytic-qss-max-abs-deviation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-specimen-rosette-azimuthal-sector-coverage>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-specimen-rosette-leaf-spacing-regularity-1-minus-cv>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-spiral-phyllotaxis-divergence-angle-mean>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-subepidermal-provascular-strand-width-mid-depth>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-morphometric-validation-2> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-auxin-inhibited-endocytosis-polarity-ratio-vs-exocytosis-targeting> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "auxin_inhibited_endocytosis_polarity_ratio_vs_exocytosis_targeting = 0.3643 ratio" ;
        schema:measurementTechnique "|p|/P_tot under auxin-inhibited endocytosis = 0.2126 (raw convergence cosine 0.900) vs exocytosis-targeted 0.5838" ;
        schema:name "auxin_inhibited_endocytosis_polarity_ratio_vs_exocytosis_targeting" ;
        schema:unitText "ratio" ;
        schema:value "0.3643" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-auxin-inhibited-endocytosis-polarity-ratio-vs-exocytosis-targeting-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-auxin-inhibited-endocytosis-polarity-ratio-vs-exocytosis-targeting-reference> a schema:PropertyValue ;
        dct:source "Paciorek et al. (2005) Nature 435:1251-1256: auxin inhibits PIN endocytosis; as the sole polarity mechanism (uniform exocytosis, k_endo(a_j) = k_endo / (1 + (a_j/K_a)^2)) its polynomial QSS weighting is weaker than the exponential up-the-gradient targeting (ratio < 1 expected; model-internal comparison)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-bfa-exocytosis-block-membrane-pin1-fraction-2h> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "bfa_exocytosis_block_membrane_pin1_fraction_2h = 0.0857 fraction" ;
        schema:measurementTechnique "k_exo set to 0 from t = 10 h in the coupled dome; PM fraction after 2.0 h = 0.0857, polarity |p|/P_tot = 0.0516 vs WT 0.5838" ;
        schema:name "bfa_exocytosis_block_membrane_pin1_fraction_2h" ;
        schema:unitText "fraction" ;
        schema:value "0.0857" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-bfa-exocytosis-block-membrane-pin1-fraction-2h-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-bfa-exocytosis-block-membrane-pin1-fraction-2h-reference> a schema:PropertyValue ;
        dct:source "Geldner et al. (2001) Nature 413:425-428 Figs. 1-2: brefeldin A blocks PIN1 exocytosis and internalises plasma-membrane PIN1 into BFA compartments within 1-2 h (model reference = first-order prediction PM(t_BFA) exp(-k_endo * 2 h), Lean 4 Law 4 part 4)" ;
        schema:value "0.0857" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-canalization-flux-delivered-to-vascular-sink-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "canalization_flux_delivered_to_vascular_sink_fraction = 0.9665 fraction" ;
        schema:measurementTechnique "Downward flux into the sink row / L1 source flux 1.91 a.u./h at t = 240 h (no-feedback ablation delivers 0.68); strand flux concentration = 0.635" ;
        schema:name "canalization_flux_delivered_to_vascular_sink_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.9665" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-canalization-flux-delivered-to-vascular-sink-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-canalization-flux-delivered-to-vascular-sink-fraction-reference> a schema:PropertyValue ;
        dct:source "Mitchison (1980) Proc. R. Soc. B 207:79-109 & Sachs canalization hypothesis: a canalized strand conducts the entire source flux to the pre-existing vasculature (idealised 1.0)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-canalization-strand-width-vs-feedback-exponent-spearman-rho> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "canalization_strand_width_vs_feedback_exponent_spearman_rho = -0.8944 rho" ;
        schema:measurementTechnique "Spearman rank correlation between n in [1.0, 1.5, 2.0, 2.5, 3.0] and mean strand width [15, 6, 1, 1, 1] cells (p = 0.041; ties at width 1 cap |rho| below 1)" ;
        schema:name "canalization_strand_width_vs_feedback_exponent_spearman_rho" ;
        schema:unitText "rho" ;
        schema:value "-0.8944" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-canalization-strand-width-vs-feedback-exponent-spearman-rho-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-canalization-strand-width-vs-feedback-exponent-spearman-rho-reference> a schema:PropertyValue ;
        dct:source "Feugier et al. (2005) J. Theor. Biol. 236:366-375: canalization into discrete strands requires a superlinear (n > 1) flux feedback; width should decrease monotonically with n (Lean 4 Law 5)" ;
        schema:value "-1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-characteristic-primordium-spacing-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "characteristic_primordium_spacing_wavelength = 5.196 cells" ;
        schema:measurementTechnique "Linearized dispersion eigenvalue peak k_max*l_0 = 1.2093 rad/cell (sigma_max = 0.2017 h^-1, lambda_c = 36.37 um)" ;
        schema:name "characteristic_primordium_spacing_wavelength" ;
        schema:unitText "cells" ;
        schema:value "5.196" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-characteristic-primordium-spacing-wavelength-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-characteristic-primordium-spacing-wavelength-reference> a schema:PropertyValue ;
        dct:source "Jönsson et al. (2006) PNAS 103:1633-1638 pp. 1635-1636 & Fig. 2 linear Turing-like dispersion peak wavelength (~5.2 cells / 36.4 um)" ;
        schema:value "5.2" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-critical-pin1-feedback-threshold-c1-a0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical_pin1_feedback_threshold_c1_a0 = 1.75 dimensionless" ;
        schema:measurementTechnique "Exact linear stability threshold where D_eff_scaled = -2.3400 < 0 (Lean 4 Law 3 verified)" ;
        schema:name "critical_pin1_feedback_threshold_c1_a0" ;
        schema:unitText "dimensionless" ;
        schema:value "1.75" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-critical-pin1-feedback-threshold-c1-a0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-critical-pin1-feedback-threshold-c1-a0-reference> a schema:PropertyValue ;
        dct:source "Jönsson et al. (2006) PNAS 103:1633-1638 Eq. 1-4 bifurcation threshold c_1*a_0 = 1 + z*D/(T*P_i) = 1.75 (operating c_1*a_0 = 3.70)" ;
        schema:value "1.75" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-exogenous-iaa-paste-rescue-peak-angle> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "exogenous_iaa_paste_rescue_peak_angle = 60.0 deg" ;
        schema:measurementTechnique "Exogenous IAA source at phi_paste = 60.0 deg on NPA/pin1 ring (angular localization error = 0.00 deg, rescued primordia = 1, contrast = 2.73)" ;
        schema:name "exogenous_iaa_paste_rescue_peak_angle" ;
        schema:unitText "deg" ;
        schema:value "60.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-exogenous-iaa-paste-rescue-peak-angle-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-exogenous-iaa-paste-rescue-peak-angle-reference> a schema:PropertyValue ;
        dct:source "Reinhardt et al. (2003) Nature 426:255-260 Fig. 2 & Smith et al. (2006) PNAS Fig. 5 localized IAA microapplication rescues single primordium at paste site (60.0 deg)" ;
        schema:value "60.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-four-mode-divergence-angle-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "four_mode_divergence_angle_pearson_r = 1.0 r" ;
        schema:measurementTechnique "NOT EMERGENT: the distichous/decussate/tricussate angles are the mode's nominal angle plus seeded noise and the spiral angle is placed at k*137.5 deg by construction (r = 1.0000, p = 2.23e-05, RMSE = 0.24 deg); carried as a Pass 4 remediation item" ;
        schema:name "four_mode_divergence_angle_pearson_r" ;
        schema:unitText "r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-four-mode-divergence-angle-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-four-mode-divergence-angle-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Smith et al. (2006) PNAS 103:1301-1306 Figs. 3-4 transitions across Spiral (137.5 deg), Distichous (180 deg), Decussate (90 deg), and Tricussate (120 deg) modes" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-npa-polar-transport-block-contrast> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "npa_polar_transport_block_contrast = 1.0 ratio" ;
        schema:measurementTechnique "Negative perturbation control T = 0.0 h^-1 (primordia count = 0 vs WT 5, WT contrast = 2.28)" ;
        schema:name "npa_polar_transport_block_contrast" ;
        schema:unitText "ratio" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-npa-polar-transport-block-contrast-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-npa-polar-transport-block-contrast-reference> a schema:PropertyValue ;
        dct:source "Reinhardt et al. (2003) Nature 426:255-260 Fig. 1 (10 uM NPA or pin1-1 mutant abolishes auxin maxima -> bare pin-formed apex with contrast 1.0 and 0 primordia)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-plasma-membrane-fraction-wild-type> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pin1_plasma_membrane_fraction_wild_type = 0.9446 fraction" ;
        schema:measurementTechnique "Mean over 180 L1 cells of sum_j P_ij / P_tot at t = 12 h under explicit exocytosis-targeted kinetics (cytosolic fraction = 0.0554); polarity half-time = 1.65 h" ;
        schema:name "pin1_plasma_membrane_fraction_wild_type" ;
        schema:unitText "fraction" ;
        schema:value "0.9446" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-plasma-membrane-fraction-wild-type-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-plasma-membrane-fraction-wild-type-reference> a schema:PropertyValue ;
        dct:source "Geldner et al. (2001) Nature 413:425-428 Fig. 1 & Heisler et al. (2005) Curr. Biol. 15:1899-1911: PIN1 predominantly plasma-membrane localised in untreated meristem cells (qualitative; >= 0.9 used as a band edge, not a measured value)" ;
        schema:value "0.9" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-primordium-convergence-polarity-index> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pin1_primordium_convergence_polarity_index = 0.9936 index" ;
        schema:measurementTechnique "RAW (uncalibrated) mean cosine between explicit-kinetics PIN1 polarity vectors and the direction to the nearest young primordium over 37 corona cells; Pass 2 reported an affine recalibration 0.842 + 0.04 (raw - 0.72) which is removed (membrane+cytosol PIN1 conservation err = 0.00e+00, flux err = 1.33e-14); the 0.84 reference is a qualitative Heisler 2005 anchor, not a published index" ;
        schema:name "pin1_primordium_convergence_polarity_index" ;
        schema:unitText "index" ;
        schema:value "0.9936" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-primordium-convergence-polarity-index-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-primordium-convergence-polarity-index-reference> a schema:PropertyValue ;
        dct:source "Heisler et al. (2005) Curr. Biol. 15:1899-1911 & Jönsson et al. (2006) PNAS Fig. 3 PIN1 efflux convergence toward nascent primordia" ;
        schema:value "0.84" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-trafficking-kinetic-vs-analytic-qss-max-abs-deviation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pin1_trafficking_kinetic_vs_analytic_qss_max_abs_deviation = 0.0527 PIN1 fraction" ;
        schema:measurementTechnique "max_ij |P_ij(t_end) - P_ij*(a(t_end))| after 12 h of coupled explicit kinetics (k_exo = 3.0, k_endo = 1.2 h^-1); residual = trafficking lag behind the still-evolving auxin field; fast-cycling x1000 run reaches max|P - Boltzmann| = 0.0131" ;
        schema:name "pin1_trafficking_kinetic_vs_analytic_qss_max_abs_deviation" ;
        schema:unitText "PIN1 fraction" ;
        schema:value "0.0527" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-trafficking-kinetic-vs-analytic-qss-max-abs-deviation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-trafficking-kinetic-vs-analytic-qss-max-abs-deviation-reference> a schema:PropertyValue ;
        dct:source "Jönsson et al. (2006) PNAS 103:1633-1638 PIN1 cycling quasi-steady state P_ij* = k_exo f_j P_tot / (k_endo + k_exo sum_k f_k) (Lean 4 Law 4); exact agreement expected only when auxin is stationary" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-specimen-rosette-azimuthal-sector-coverage> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_rosette_azimuthal_sector_coverage = 1.0 fraction" ;
        schema:measurementTechnique "ExG + DoG segmentation of N = 410 imbricated rosette leaves around SAM center (651.5, 563.1) px" ;
        schema:name "specimen_rosette_azimuthal_sector_coverage" ;
        schema:unitText "fraction" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-specimen-rosette-azimuthal-sector-coverage-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-specimen-rosette-azimuthal-sector-coverage-reference> a schema:PropertyValue ;
        dct:source "File:Aeonium tabuliforme 0.jpg (Wikimedia Commons CC BY-SA 3.0) full 360-deg spiral rosette leaf coverage across 12 azimuthal sectors" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-specimen-rosette-leaf-spacing-regularity-1-minus-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_rosette_leaf_spacing_regularity_1_minus_cv = 0.7737 index" ;
        schema:measurementTechnique "Nearest-neighbor Euclidean distance distribution across 410 segmented rosette leaves (mean = 23.4 px, CV = 0.2263)" ;
        schema:name "specimen_rosette_leaf_spacing_regularity_1_minus_cv" ;

        <https://doi.org/10.1098/rstb.1981.0154>,
        <https://doi.org/10.1101/gad.1402406>,
        <https://doi.org/10.1101/gad.497009> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Up-the-Gradient Auxin-PIN1 Polarized Transport & Turing-Like Phyllotactic Spacing" ;

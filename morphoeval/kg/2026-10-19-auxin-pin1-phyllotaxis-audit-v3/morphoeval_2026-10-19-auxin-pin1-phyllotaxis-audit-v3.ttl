        pk:EvidenceItem ;
    rdfs:label "bfa_exocytosis_block_membrane_pin1_fraction_2h" ;
    dct:description "k_exo set to 0 from t = 10 h in the coupled dome; PM fraction after 2.0 h = 0.0857, polarity |p|/P_tot = 0.0516 vs WT 0.5838" ;
    dct:source "Geldner et al. (2001) Nature 413:425-428 Figs. 1-2: brefeldin A blocks PIN1 exocytosis and internalises plasma-membrane PIN1 into BFA compartments within 1-2 h (model reference = first-order prediction PM(t_BFA) exp(-k_endo * 2 h), Lean 4 Law 4 part 4)" ;
    schema:about "Arabidopsis thaliana (shoot apical meristem L1 epidermis & subepidermal provascular strand); Aeonium tabuliforme (spiral rosette specimen)" ;
    schema:error 0e+00 ;
    schema:targetValue 8.57e-02 ;
    schema:unitText "fraction" ;
    schema:value 8.57e-02 .

<https://w3id.org/delphi/resource/evidence/2026-10-19-auxin-pin1-phyllotaxis-audit-v3-jonsson-auxin-pin1-meristem-13> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "auxin_inhibited_endocytosis_polarity_ratio_vs_exocytosis_targeting" ;
    dct:description "|p|/P_tot under auxin-inhibited endocytosis = 0.2126 (raw convergence cosine 0.900) vs exocytosis-targeted 0.5838" ;
    dct:source "Paciorek et al. (2005) Nature 435:1251-1256: auxin inhibits PIN endocytosis; as the sole polarity mechanism (uniform exocytosis, k_endo(a_j) = k_endo / (1 + (a_j/K_a)^2)) its polynomial QSS weighting is weaker than the exponential up-the-gradient targeting (ratio < 1 expected; model-internal comparison)" ;
    schema:about "Arabidopsis thaliana (shoot apical meristem L1 epidermis & subepidermal provascular strand); Aeonium tabuliforme (spiral rosette specimen)" ;
    schema:error 6.357e+01 ;
    schema:targetValue 1e+00 ;
    schema:unitText "ratio" ;
    schema:value 3.643e-01 .


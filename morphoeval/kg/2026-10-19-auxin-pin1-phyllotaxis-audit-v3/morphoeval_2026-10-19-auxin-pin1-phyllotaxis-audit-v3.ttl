<https://w3id.org/delphi/resource/evidence/2026-10-19-auxin-pin1-phyllotaxis-audit-v3-jonsson-auxin-pin1-meristem-10> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "pin1_trafficking_kinetic_vs_analytic_qss_max_abs_deviation" ;
    dct:description "max_ij |P_ij(t_end) - P_ij*(a(t_end))| after 12 h of coupled explicit kinetics (k_exo = 3.0, k_endo = 1.2 h^-1); residual = trafficking lag behind the still-evolving auxin field; fast-cycling x1000 run reaches max|P - Boltzmann| = 0.0131" ;
    dct:source "Jönsson et al. (2006) PNAS 103:1633-1638 PIN1 cycling quasi-steady state P_ij* = k_exo f_j P_tot / (k_endo + k_exo sum_k f_k) (Lean 4 Law 4); exact agreement expected only when auxin is stationary" ;
    schema:about "Arabidopsis thaliana (shoot apical meristem L1 epidermis & subepidermal provascular strand); Aeonium tabuliforme (spiral rosette specimen)" ;
    schema:error 5.27e+00 ;
    schema:targetValue 0e+00 ;
    schema:unitText "PIN1 fraction" ;
    schema:value 5.27e-02 .


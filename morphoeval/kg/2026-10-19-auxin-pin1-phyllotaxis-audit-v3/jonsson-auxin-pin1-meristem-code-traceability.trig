sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-jonsson-auxin-pin1-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) up-the-gradient PIN1 polarization with explicit PIN1 trafficking kinetics, quasi-3D subepidermal canalization, and polar auxin transport for shoot apical meristem phyllotaxis — Code-to-model traceability: 80/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: the module docstring maps Laws 1-5 to Jönsson Eqs. 1-4, Smith Eq. 2, Reinhardt Figs. 1-2, Geldner 2001, Paciorek 2005, Mitchison 1980/1981, Feugier 2005 and Bayer 2009, and to the five Lean theorems with line loci (L1-66); every Pass 3 function docstring states its equations and which paper step it reduces (L238-262, L309-347, L617-651, L773-779, L820-836); the math KG YAML registers Laws 4-5 with code loci that match the current file. Deductions: the dome scaffolding constants (pz centre 33 um / width 11.5, envelope 1.35/0.55/2.65, weights 0.14 and 0.38, corona 3.5-11.5 um) are uncited (L407-415, L508-513, L543-549) (-8); the canalization constants f_0 = 0.1, K = 1.0, T_periclinal = 0.3 and a_sink = 0.2 are model choices documented in the JSON but not derived from any paper (-5); kappa_4 is described as 'calibrated' without stating that this makes lambda_c an input (-3); the Panel E/C titles were only relabelled in Pass 3 and still display prescribed values (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2006-jonsson-auxin-pin1-meristem.py L404–L415: pz_profile / prim_envelope constants (33, 11.5, 4.6, 0.055, 0.15, 0.35) carry no citation <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L404-L415>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-code-traceability-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L1–L66" ;
        dct:description "Module docstring: Pass 3 scope statement, Laws 1-5 with equations, sources and Lean loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L1-L66> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/jonsson-auxin-pin1-meristem.yaml L1–L130" ;
        dct:description "Laws 4-5 registered with lean_code, variables, roles and current code loci; Laws 1-3 loci refreshed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/jonsson-auxin-pin1-meristem.yaml#L1-L130> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 032 Pass 3 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


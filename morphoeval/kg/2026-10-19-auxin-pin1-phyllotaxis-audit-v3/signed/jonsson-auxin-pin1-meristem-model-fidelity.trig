sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-jonsson-auxin-pin1-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L238–L306" ;
        dcterms:description "Exact exponential integrator and analytic QSS of the PIN1 exocytosis/endocytosis kinetics (Law 4); verified in self-test 5 to 1e-9 against the frozen-field fixed point" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L238-L306> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L460–L499" ;
        dcterms:description "Coupled dome step: explicit kinetics or QSS ablation, BFA switch (L463), per-wall endocytosis variant with substeps (L477-487), membrane+cytosol conservation (L491) and antisymmetric flux (L495-499)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L460-L499> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L617–L770" ;
        dcterms:description "Quasi-3D subepidermal canalization slice: net wall flux, Hill flux feedback f_0 + J^n/(K^n+J^n) (L712), uniform Dirichlet sink row (L722), strand width/concentration/delivery metrics (L728-744)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L617-L770> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_032_auxin_pin1_phyllotaxis.lean L136–L202" ;
        dcterms:description "Laws 4 and 5 (trafficking QSS conservation/fixed point/monotonicity/BFA; quadratic flux feedback winner-take-all) machine-checked, 0 sorrys; Laws 1-3 at L31-111" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_032_auxin_pin1_phyllotaxis.lean#L136-L202> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) up-the-gradient PIN1 polarization with explicit PIN1 trafficking kinetics, quasi-3D subepidermal canalization, and polar auxin transport for shoot apical meristem phyllotaxis — Model fidelity to source: 72/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the Boltzmann allocation and antisymmetric active + diffusive flux (L434-439, L495-499) match Jönsson Eqs. 1-4 / Smith Eq. 2; the new trafficking kinetics dP_ij/dt = k_exo f P_cyt - k_endo P_ij with pool conservation are the paper's PIN1 cycling scheme and are solved exactly (L238-284), with the QSS, BFA (k_exo = 0) and fast-cycling limits all behaving as Law 4 predicts (L820-886); the canalization slice implements the Mitchison/Feugier with-the-flux rule with the same trafficking kinetics (L705-716) and reproduces winner-take-all strand formation (Law 5). Deductions: the dome's auxin equation is not Jönsson Eq. 1 — the transport term is down-weighted by 0.14 and the field is relaxed at rate 0.38 toward a hand-built envelope target_a = 1.35 + 0.55 pz + 2.65 prim (L508-513), with the primordia seeded at golden-angle targets (L396-397), so the convergence maxima are imposed (-10); the four phyllotactic regimes are not simulated at all — nominal angle plus seeded noise (L944-957) and golden placement by construction (L923-931) (-8); the WT ring profile is a sum of five hand-placed Gaussians (L1025-1028) (-3); kappa_4 is calibrated so the dispersion peak hits the 5.2-cell reference (L180-184), so lambda_c is an input (-3); the canalization is a single non-growing slice with a uniform sink row rather than the requested 3D tissue (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2006-jonsson-auxin-pin1-meristem.py L180–L184: kappa_4 = alpha_eff / s*(5.2 cells): the dispersion peak is calibrated to the reference it is later compared against <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L180-L184>",
            "2006-jonsson-auxin-pin1-meristem.py L396–L415: P1..P8 seeded at (k+1)*golden + N(0, 0.012 rad) and the initial auxin field pre-shaped by prim_envelope: primordium positions are inputs <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L396-L415>",
            "2006-jonsson-auxin-pin1-meristem.py L506–L514: da/dt = rho0 - mu a + 0.14 sum J + 0.38 (target_a - a): a relaxation toward a prescribed envelope, not Jönsson Eq. 1 <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L506-L514>",
            "2006-jonsson-auxin-pin1-meristem.py L921–L960: Four 'regimes': spiral placed at k*137.5 deg by construction; distichous/decussate/tricussate = nominal angle + seeded noise; Gamma unused in the dynamics <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L921-L960>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-4> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 032 Pass 3 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-jonsson-auxin-pin1-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/auxin_pin1_phyllotaxis_comparison.png (generated output)" ;
        dcterms:description "9-panel figure: A dome with explicit-kinetics PIN1 polarity, G trafficking time courses (5 regimes), H canalized strand with 20 % flux contour, I width-vs-exponent sweep with 1-2 cell reference band, F rosette segmentation — docs/media/auxin_pin1_phyllotaxis_comparison.png: rendered output of 2006-jonsson-auxin-pin1-meristem.py at d58a084, image/png, 1867745 B, 2548×2352 px, artifact_sha256 2b06a6ed998e8eaa0669c12d96a5cab8df703b0a27180f87a7433246768cfcb9 (sha256 2b06a6ed998e8eaa0669c12d96a5cab8df703b0a27180f87a7433246768cfcb9), spec_fingerprint 4bb87fc40e78808765bf8caaa78c3f40f08c88fe6ce9f43531ffe4997786d304" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/auxin_pin1_phyllotaxis_growth.gif (generated output)" ;
        dcterms:description "18 frames x 3 panels: dome polarity build-up from a fully internalised PIN1 start, ring profiles, and the subepidermal strand narrowing to one file — docs/media/auxin_pin1_phyllotaxis_growth.gif: rendered output of 2006-jonsson-auxin-pin1-meristem.py at d58a084, image/gif, 1301812 B, 1560×480 px, 18 frames, artifact_sha256 80c6cf085702abc04662d1c2bc249c9378b8bd31014c0ba434a27472378b24e1 (sha256 80c6cf085702abc04662d1c2bc249c9378b8bd31014c0ba434a27472378b24e1), spec_fingerprint 4bb87fc40e78808765bf8caaa78c3f40f08c88fe6ce9f43531ffe4997786d304" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L1094–L1176" ;
        dcterms:description "ExG + DoG segmentation of the SHA-256-locked Aeonium tabuliforme specimen; 410 tips, 12/12 sectors" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L1094-L1176> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) up-the-gradient PIN1 polarization with explicit PIN1 trafficking kinetics, quasi-3D subepidermal canalization, and polar auxin transport for shoot apical meristem phyllotaxis — Morphological realism / specimen match: 74/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Judged on the regenerated PNG and GIF: Panel A shows PIN1 polarity vectors converging on discrete auxin maxima in a hexagonal L1 lattice, visually consistent with Heisler 2005 / Jönsson Fig. 3 convergence points; Panel H shows a single-file strand of high auxin with PIN1 polarised downward from the source to the sink, resembling the midvein strand of Bayer 2009 Fig. 3 and Scarpella 2006 PIN1::GFP files; Panel F overlays 410 detected leaf tips and the rosette mask on the Aeonium specimen with 12/12 sector coverage; the GIF shows the strand canalizing over 240 h. Deductions: the convergence pattern in Panel A is imposed by the seeded envelope, so its resemblance to live-imaging data is not evidence for the model (-8); the specimen is a Crassulaceae rosette, not an Arabidopsis meristem, and no PIN1 immunolocalization or provascular-strand image is vendored for side-by-side comparison of Panels A, G or H (-10); the parastichy spiral overlays in Panel F are fixed curves (L1348-1353), not fitted to the detected tips (-4); the Panel D wild-type profile is hand-drawn (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2006-jonsson-auxin-pin1-meristem.py L1346–L1354: Parastichy 'overlay' curves phi = 5.2 t and -3.4 t + 1.1 are hard-coded, not fitted to the detected leaf tips <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L1346-L1354>",
            "datasets/auxin_pin1_phyllotaxis/README.md L1–L20: Only specimen is a top-down Aeonium rosette; no Arabidopsis SAM PIN1 image or strand image is vendored <https://github.com/fractastical/morpholib/blob/d58a084/datasets/auxin_pin1_phyllotaxis/README.md#L1-L20>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-specimen-match-3> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 032 Pass 3 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;

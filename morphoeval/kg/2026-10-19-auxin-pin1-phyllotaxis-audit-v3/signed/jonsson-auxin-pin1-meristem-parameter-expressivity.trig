sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-jonsson-auxin-pin1-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L773–L814" ;
        dcterms:description "Hill-exponent sweep + no-feedback ablation with Spearman monotonicity test" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L773-L814> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L820–L886" ;
        dcterms:description "Five trafficking regimes (explicit, QSS, BFA, endocytosis, fast-cycling) run on the same dome and compared" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L820-L886> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L1792–L1812" ;
        dcterms:description "CLI: 8 new Pass 3 flags for kinetics, mechanism, rates, BFA onset, canalization exponent/K and ablation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L1792-L1812> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) up-the-gradient PIN1 polarization with explicit PIN1 trafficking kinetics, quasi-3D subepidermal canalization, and polar auxin transport for shoot apical meristem phyllotaxis — Parameter expressivity: 70/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the with-the-flux Hill exponent visibly and monotonically controls strand width (15 -> 6 -> 1 -> 1 -> 1 cells; Spearman rho -0.89) with a no-feedback ablation at 14 cells (L773-814, Panel I); the trafficking regime switch changes polarity as expected (explicit 0.58, QSS 0.67, endocytosis-only 0.21, BFA 0.05) and k_exo/k_endo set the polarity half-time (L820-886, Panel G); --pin1-kinetics, --polarity-mechanism, --k-exo, --k-endo, --bfa-onset-h, --canal-hill-n, --canal-K-flux and --no-flux-feedback are wired through main() (L1802-1809, L1830-1855) alongside the existing --T-polar/--D-diff/--c1-gain/--rho0/--mu. Deductions: the headline morphospace parameter Gamma does not control anything — the four-regime panel is prescribed (L944-957) (-15); --T-polar/--D-diff/--c1-gain reach the dome only through a 0.14-weighted transport term under a 0.38 envelope relaxation, so their effect on the auxin pattern is muted and the dome's divergence angle is independent of them (-8); K_flux and f_basal are not swept and the width metric saturates at 1 cell for n >= 2, so the sweep shows a threshold rather than a graded control (-4); the endocytosis variant's K_a and Hill h are not exposed (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2006-jonsson-auxin-pin1-meristem.py L944–L957: Gamma regimes: divs = nominal +/- N(0, 0.55-0.65); no model parameter enters <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L944-L957>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-parameter-expressivity-3> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 032 Pass 3 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


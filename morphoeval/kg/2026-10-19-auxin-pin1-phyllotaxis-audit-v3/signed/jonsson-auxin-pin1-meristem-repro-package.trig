sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-jonsson-auxin-pin1-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) up-the-gradient PIN1 polarization with explicit PIN1 trafficking kinetics, quasi-3D subepidermal canalization, and polar auxin transport for shoot apical meristem phyllotaxis — Reproducibility package: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: `--self-test` runs 13 deterministic checks in ~7 s (SHA-256, Laws 1-5, exact integrator vs analytic QSS to 1e-9, BFA, fast-cycling limit, canalization width/delivery and sweep monotonicity, modes, NPA/IAA, segmentation, 16-measurement schema, bitwise determinism of dome and slice) (L1685-1789); the default render takes ~12 s and the PNG/GIF regenerate from `./venv/bin/python3 2006-jonsson-auxin-pin1-meristem.py`; seeds are explicit and the exact integrator removes the stiffness risk of an explicit scheme; all CLI flags are documented in argparse. Deductions: no per-script requirements lock (the repo-level requirements.txt is unpinned) and the environment is recorded only in this audit (-5); the endocytosis variant uses fixed explicit substeps (n_sub = 8, L478-482) without a stability guard if k_exo is raised via --k-exo (-3); matplotlib emits a cache-directory warning when MPLCONFIGDIR is not writable, which the invocation notes do not mention (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2006-jonsson-auxin-pin1-meristem.py L476–L487: Endocytosis variant: fixed 8 explicit substeps, no CFL-style guard on k_exo * sum f <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L476-L487>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-repro-package-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L1685–L1789" ;
        dcterms:description "13-check self-test incl. frozen-field QSS fixed point (check 5), BFA (6), Boltzmann limit (7), canalization (8-9), determinism (13)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L1685-L1789> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L1792–L1868" ;
        dcterms:description "main(): argparse with all flags, default render writes PNG + GIF and prints key metrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-jonsson-auxin-pin1-meristem.py#L1792-L1868> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 032 Pass 3 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


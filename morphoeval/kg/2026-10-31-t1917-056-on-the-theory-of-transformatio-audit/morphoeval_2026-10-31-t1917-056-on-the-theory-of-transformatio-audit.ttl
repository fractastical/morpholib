<https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-056> a pk:Claim ;
    rdfs:label "Thompson (1917) Eohippus→Equus equid skull coordinate deformation (Equidae cranial lateral (Eohippus/Hyracotherium vs Equus; Heilmann intermediates))",
        "Thompson (1917) Eohippus→Equus equid skull coordinate deformation faithfully reproduces Equidae cranial lateral (Eohippus/Hyracotherium vs Equus; Heilmann intermediates) morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-056-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-056-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-056-3> ;
    dct:description "The simulation script(s) thompson/claims/t1917-056_on-the-theory-of-transformations.py, docs/media/t1917_056_on_the_theory_of_transformatio_growth.gif, datasets/thompson_1917/t1917-056/result.json implement the cited source model as published and produce forms that match real Equidae cranial lateral (Eohippus/Hyracotherium vs Equus; Heilmann intermediates) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/datasets/thompson_1917/t1917-056/result.json>,
        <https://github.com/fractastical/morpholib/blob/main/docs/media/t1917_056_on_the_theory_of_transformatio_growth.gif>,
        <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-056_on-the-theory-of-transformations.py> ;
    schema:about "Equidae cranial lateral (Eohippus/Hyracotherium vs Equus; Heilmann intermediates)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-056_on-the-theory-of-transformations.py, https://github.com/fractastical/morpholib/blob/main/docs/media/t1917_056_on_the_theory_of_transformatio_growth.gif, https://github.com/fractastical/morpholib/blob/main/datasets/thompson_1917/t1917-056/result.json; output: docs/media/t1917_056_on_the_theory_of_transformatio_comparison.png; organism: Equidae cranial lateral (Eohippus/Hyracotherium vs Equus; Heilmann intermediates); environment: python 3.12, numpy 2.x, scipy 1.x, matplotlib 3.x; other sources: On Growth and Form, Ch. XVII, pp. 765-767, Figs. 401-402 <https://archive.org/details/ongrowthform1917thom>" ;
    pk:derivedFromPaper <https://doi.org/10.1017/pab.2026.10096>,
        <https://doi.org/10.5061/dryad.crjdfn3g3> ;

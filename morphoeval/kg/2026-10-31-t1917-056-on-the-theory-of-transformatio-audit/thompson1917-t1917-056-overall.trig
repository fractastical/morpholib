sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-056> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-056-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-056-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Eohippus→Equus equid skull coordinate deformation — MorphoEval overall 57.2/100" ;
        dct:date "2026-10-31"^^xsd:date ;
        dct:description "Pass 1 baseline: 18-landmark digitisation; TPS phi_t vs Heilmann stages; Dryad equid GM identified but not fetched; --pass1 skips CV segmentation and parameter sweeps. Overall 57.2/100 (faithfulness 50.6, reproducibility 72.7); rubric morphoeval 0.1.0; checkpoint commit local; environment: python 3.12, numpy 2.x, scipy 1.x, matplotlib 3.x. Dimension assessments: Model fidelity to source 70, Morphological realism / specimen match 38, Parameter expressivity 44, Morphometric validation 50, Source and data traceability 82, Code-to-model traceability 74, Reproducibility package 64. Output judged: docs/media/t1917_056_on_the_theory_of_transformatio_comparison.png: rendered output of thompson/claims/t1917-056_on-the-theory-of-transformations.py at local, image/png, 151288 B, 1800×1200 px, artifact_sha256 642c269d14e132d255f9eecbd90ddb468c219c65086203e082117c133f411f8d (sha256 642c269d14e132d255f9eecbd90ddb468c219c65086203e082117c133f411f8d), spec_fingerprint 885385f32cc021aefedec35731f59225d662ddf2cdd8959acb551369644bc14a. Dual provenance: spec_fingerprint: 885385f32cc021aefedec35731f59225d662ddf2cdd8959acb551369644bc14a; artifact_sha256: 642c269d14e132d255f9eecbd90ddb468c219c65086203e082117c133f411f8d; input_dataset_sha256: {datasets/thompson_1917/t1917-056/scout_manifest.json=cb62934529ec73bd..., datasets/thompson_1917/t1917-056/thompson_fig401_402_landmarks.json=e2d755701d463a2e...}." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Add specimen CV segmentation panel and landmark-in-mask fraction on equid gallery photo.",
            "remediation needed: Attempt IA page vendoring for Fig. 401-402 when archive.org accessible.",
            "remediation needed: Default full_validation: TPS lambda sweep, shuffled-label ablation, KS on pairwise distances.",
            "remediation needed: Document Dryad fetch failure vs species match in result.json (partial test boundary)." ;
        pk:hasScore "0.572"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval loop thompson1917-t1917-056 Pass 1)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


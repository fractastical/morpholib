<https://w3id.org/delphi/resource/math-law/delphi10000-clytia-hemisphaerica-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg diffusion-ratio Turing margin" ;
    dct:description "Instability threshold that the equal-diffusion ablation violates | Variables: ratio = D_v/D_u = 20 at this slot; f_u = 0.8; g_v = -1" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd8176806dee28731b94a3866aa6609c1d9d4ba2/models/2026-delphi10000-clytia-hemisphaerica-turing-wavelength-s0.py#L101-L117>,
        <https://github.com/fractastical/morpholib/blob/bd8176806dee28731b94a3866aa6609c1d9d4ba2/morphoeval/lean/loops/Loop_3150_clytia_hemisphaerica_turing_wavelength_s0.lean#L12-L15> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_v f_u - D_u |g_v| > 0, cleared as 4*(D_v/D_u) - 5 > 0 at f_u = 4/5" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00226774>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/s41559-019-0833-2>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pbio.0050070>,
        <https://doi.org/10.7554/eLife.29555> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3150.turingMargin" ;
    pk:leanTheorem "MathOfBiology.Loop_3150.slot_ratio_is_turing_unstable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-clytia-hemisphaerica-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Selected Turing wavelength at the detail scale" ;
    dct:description "Quantitative wavenumber law pinned to the assigned 8.64 µm detail length | Variables: lambda_star = 8.64 µm; age_Ma = 0" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd8176806dee28731b94a3866aa6609c1d9d4ba2/models/2026-delphi10000-clytia-hemisphaerica-turing-wavelength-s0.py#L132-L151>,
        <https://github.com/fractastical/morpholib/blob/bd8176806dee28731b94a3866aa6609c1d9d4ba2/morphoeval/lean/loops/Loop_3150_clytia_hemisphaerica_turing_wavelength_s0.lean#L18-L22> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_star = argmax Re sigma(k); lambda_star = 2 pi / k_star = 8640 nm" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00226774>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/s41559-019-0833-2>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pbio.0050070>,
        <https://doi.org/10.7554/eLife.29555> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3150.selectedWavelengthNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3150.selected_wavelength_is_detail_scale" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-clytia-hemisphaerica-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail-scale mode count versus an organism-scale bell" ;
    dct:description "What changes at this scale when the chronoseries has no temporal neighbour | Variables: L_planula = 250000 nm reconstructed; L_bell = 2000000 nm; lambda = 8640 nm" ;
    dct:source "Murray 1981 DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd8176806dee28731b94a3866aa6609c1d9d4ba2/models/2026-delphi10000-clytia-hemisphaerica-turing-wavelength-s0.py#L546-L590>,

    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = floor(L / lambda_star); N(250 µm) < N(2 mm)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00226774>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/s41559-019-0833-2>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pbio.0050070>,
        <https://doi.org/10.7554/eLife.29555> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3150.modeCount" ;
    pk:leanTheorem "MathOfBiology.Loop_3150.detail_scale_has_fewer_modes_than_bell" ;
    pk:leanVerified true .


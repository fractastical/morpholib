    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Clytia hemisphaerica Schnakenberg wavelength at 8.64 µm (Pass 2) — Morphological realism / specimen match: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Computer-vision similarity against the real planula is 82.1 (12-bin orientation, 24-bin radial FFT, structure-tensor coherency). The body, background, and endoderm shading read as the same larva. The contour is still harder than the DIC halo; feathering that edge cut CV to 60.5 and was not kept." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

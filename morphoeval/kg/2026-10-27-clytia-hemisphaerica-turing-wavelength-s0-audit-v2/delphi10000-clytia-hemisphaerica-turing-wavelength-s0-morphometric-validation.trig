sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Clytia hemisphaerica Schnakenberg wavelength at 8.64 µm (Pass 2) — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass-2 Pearson r = 0.999301, RMSE = 0.01406 s⁻¹, both with references that are not copies of the value. Planula aspect 3.2304 versus a circular null of 1, circularity 0.3711 versus 1, interior KS 0.1908 versus 0. Ablation std 0.00132 versus wild-type 0.0193." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-dispersion-probe-pearson-r-eigenvector-pass-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-dispersion-probe-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-u>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-pass-1-transient-probe-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-planula-versus-medusa-bell-mode-count-at-8-64-m>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-selected-turing-wavelength-lambda>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-simulation-interior-gray-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-specimen-contour-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-specimen-interior-luminance-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-dispersion-probe-pearson-r-eigenvector-pass-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion-probe Pearson r (eigenvector, pass 2) = 0.999301 1" ;
        dct:description "RMSE 0.0141 s⁻¹; gate is r > 0.98" ;
        schema:measurementTechnique "PDE Fourier-mode growth vs Jacobian σ at the discrete Laplacian wavenumber" ;
        schema:name "dispersion-probe Pearson r (eigenvector, pass 2)" ;
        schema:unitText "1" ;
        schema:value "0.999301" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-dispersion-probe-pearson-r-eigenvector-pass-2-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-dispersion-probe-pearson-r-eigenvector-pass-2-reference> a schema:PropertyValue ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-dispersion-probe-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion-probe RMSE = 0.01406 s^-1" ;
        dct:description "zero would be an exact eigenmode of the discrete Laplacian" ;
        schema:measurementTechnique "root mean square of σ_numeric − σ_analytic over the probed band" ;
        schema:name "dispersion-probe RMSE" ;
        schema:unitText "s^-1" ;
        schema:value "0.01406" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-dispersion-probe-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-dispersion-probe-rmse-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-u> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation std(u) = 0.0013248623997750928 1" ;
        dct:description "reference_value is the wild-type std; ablation must sit far below it" ;
        schema:measurementTechnique "Dv=Du integrated on the same grid and horizon as wild type" ;
        schema:name "equal-diffusion ablation std(u)" ;
        schema:unitText "1" ;
        schema:value "0.0013248623997750928" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-u-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-u-reference> a schema:PropertyValue ;
        schema:value "0.0192708407717446" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-pass-1-transient-probe-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pass-1 transient probe Pearson r = 0.506133 1" ;
        dct:description "below the gate; this is why pass 2 changes the probe" ;
        schema:measurementTechnique "activator-only initial data, growth fit from t=0 (biased eigenspace)" ;
        schema:name "pass-1 transient probe Pearson r" ;
        schema:unitText "1" ;
        schema:value "0.506133" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-pass-1-transient-probe-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-pass-1-transient-probe-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-planula-versus-medusa-bell-mode-count-at-8-64-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "planula versus medusa-bell mode count at 8.64 µm = 28 stripes" ;
        dct:description "reference is floor(2000 µm / λ_*) on a medusa bell; detail scale holds fewer repeats. Age delta vs the 1/1 Holocene series is 0 Ma" ;
        schema:measurementTechnique "floor(L/λ_*) with reconstructed L_planula=250 µm" ;
        schema:name "planula versus medusa-bell mode count at 8.64 µm" ;
        schema:unitText "stripes" ;
        schema:value "28" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-planula-versus-medusa-bell-mode-count-at-8-64-m-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-planula-versus-medusa-bell-mode-count-at-8-64-m-reference> a schema:PropertyValue ;
        schema:value "231" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-selected-turing-wavelength-lambda> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "selected Turing wavelength lambda_* = 8.6464 µm" ;
        dct:description "γ is pinned so k_* realises the assigned 8.64 µm detail length" ;
        schema:measurementTechnique "argmax_k Re σ(k) of the Schnakenberg Jacobian at Du=1 µm²/s, Dv/Du=20" ;
        schema:name "selected Turing wavelength lambda_*" ;
        schema:unitText "µm" ;
        schema:value "8.6464" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-selected-turing-wavelength-lambda-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-selected-turing-wavelength-lambda-reference> a schema:PropertyValue ;
        schema:value "8.64" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-simulation-interior-gray-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulation interior gray std = 17.3421 gray" ;
        dct:description "reference is the first frame; growth must move the luminance distribution" ;
        schema:measurementTechnique "std of the GIF last frame luminance, including background" ;
        schema:name "simulation interior gray std" ;
        schema:unitText "gray" ;
        schema:value "17.3421" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-simulation-interior-gray-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-simulation-interior-gray-std-reference> a schema:PropertyValue ;
        schema:value "17.1185" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-specimen-contour-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen contour aspect ratio = 3.2304 1" ;
        dct:description "null reference is a circular body; the planula is elongate" ;
        schema:measurementTechnique "bounding-box height/width of the segmented day-2 planula mask" ;
        schema:name "specimen contour aspect ratio" ;
        schema:unitText "1" ;
        schema:value "3.2304" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-specimen-contour-aspect-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-specimen-contour-aspect-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen contour circularity = 0.3711 1" ;
        dct:description "a circle would score 1; the larva does not" ;
        schema:measurementTechnique "4πA/P² on the segmented planula outline" ;
        schema:name "specimen contour circularity" ;
        schema:unitText "1" ;
        schema:value "0.3711" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-specimen-interior-luminance-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen interior luminance KS statistic = 0.1908 1" ;
        dct:description "0 would be a pixel copy; a positive KS is a real distributional distance" ;
        schema:measurementTechnique "two-sample KS between specimen and simulation interior gray values" ;
        schema:name "specimen interior luminance KS statistic" ;
        schema:unitText "1" ;
        schema:value "0.1908" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-specimen-interior-luminance-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-measurement-specimen-interior-luminance-ks-statistic-reference> a schema:PropertyValue ;
        schema:value "0.0" .

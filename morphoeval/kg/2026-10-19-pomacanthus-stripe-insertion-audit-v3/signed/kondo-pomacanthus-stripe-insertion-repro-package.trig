sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kondo-pomacanthus-stripe-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L1864–L1913" ;
        dcterms:description "Pass 3 self-test blocks 4-6: Laplacian unit tests, curvilinear insertion checks, agent ablation checks, specimen fit checks, 9-measurement contract" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L1864-L1913> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L656–L690" ;
        dcterms:description "Deterministic seeded solver with parameter-keyed memo cache so render/measure/self-test share one run" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L656-L690> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/pomacanthus_stripe_insertion_growth.gif (generated output)" ;
        dcterms:description "24-frame animated GIF of planar mid-trough stripe insertion on the expanding skin domain, regenerated by the default invocation (10.5 s) — docs/media/pomacanthus_stripe_insertion_growth.gif: rendered output of 1995-kondo-pomacanthus-stripe-insertion.py at d58a084, image/gif, 938761 B, 900×500 px, 24 frames, artifact_sha256 7e81613cc8dbe53b823231cb70519b475d3cef6f0e63fe8d74b3fa61e9db6778 (sha256 7e81613cc8dbe53b823231cb70519b475d3cef6f0e63fe8d74b3fa61e9db6778), spec_fingerprint 9fca66f1ec5b7b985311e657c901c9004c5c9be93f2d029fa8365f8bf5322678" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Kondo & Asai (1995) Pomacanthus reaction-diffusion stripe insertion & Y-branch unzipping — Reproducibility package: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`run_self_test` (L1817-1925) grows from 3 to 6 numbered blocks: the polar Laplacian is unit-tested, the curvilinear solver is checked for 3 -> 6 arcs on all transects, lambda_c recovery, coherence, insertion window, monotone I_mid and cache/bitwise determinism; the agent model is checked for 6 = 6 stripes, concordance >= 0.9, monotone contrast gain and seeded determinism; the specimen fit for arc count, spacing bounds and a plausible centre; and the 9 measurements for references. Runtime is 9.4 s (self-test) and 10.5 s (PNG + GIF), well under the 3-minute budget. Deductions: the two `pcolormesh` shading warnings on Panel G are not silenced (-2); the GIF was not extended to the curvilinear or agent mechanisms, so the animated artifact lags the figure (-3); the reference JSON is not SHA-pinned (see source-traceability) and the run writes a matplotlib cache unless MPLCONFIGDIR is set (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "1995-kondo-pomacanthus-stripe-insertion.py L1738–L1811: GIF renderer unchanged from Pass 2: shows only the 1D planar insertion kymograph <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L1738-L1811>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-repro-package-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

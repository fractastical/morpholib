sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kondo-pomacanthus-stripe-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Kondo & Asai (1995) Pomacanthus reaction-diffusion stripe insertion & Y-branch unzipping — Parameter expressivity: 93/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "In addition to the v2 sweeps (D_I dispersion family, 5 ontogenetic regimes, continuous growth), Pass 3 adds a continuous radial-growth axis s in [1, 2.6] on the curved domain with the arc count and I_mid recorded every 50 steps (L743-761), and a feedback-strength ablation `agent_coupling_ablation_sweep` over kappa in {0, 0.005, 0.01, 0.02} (L964-991) whose uncoupled kappa = 0 member is a genuine control; concordance, iridophore fraction and contrast gain all respond monotonically in the expected direction. Deductions: the sector shape parameters (rho_in, theta_half) and the agent rule probabilities are not swept, so their influence on arc curvature and concordance is unknown (-4); on the periodic agent domain the wavelength cannot respond to kappa (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1995-kondo-pomacanthus-stripe-insertion.py L659–L672: rho_in, theta_half_deg, nudge, s_final are exposed as arguments but only the defaults are exercised <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L659-L672>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-parameter-expressivity-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L964–L991" ;
        dcterms:description "kappa ablation sweep with uncoupled control and amplitude-gain metric" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L964-L991> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L743–L761" ;
        dcterms:description "Per-50-step tracking of s, N(s), I_mid(s) and spacing along the growing curved domain" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L743-L761> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L1551–L1584" ;
        dcterms:description "Panel E overlays the fitted concentric circles and centre on the specimen photograph" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L1551-L1584> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/pomacanthus_stripe_insertion_comparison.png (generated output)" ;
        dcterms:description "9-panel figure: Panels E/F specimen segmentation + concentric fit, Panel G simulated concentric C-arcs (3 -> 6), Panel H I_mid threshold trace, Panel I agent lattice — docs/media/pomacanthus_stripe_insertion_comparison.png: rendered output of 1995-kondo-pomacanthus-stripe-insertion.py at d58a084, image/png, 1309313 B, 2310×2044 px, artifact_sha256 92f926e73a7ebb81a69b893404cb09fadddfe38cba44064f55014e57a01e18c0 (sha256 92f926e73a7ebb81a69b893404cb09fadddfe38cba44064f55014e57a01e18c0), spec_fingerprint 9fca66f1ec5b7b985311e657c901c9004c5c9be93f2d029fa8365f8bf5322678" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Kondo & Asai (1995) Pomacanthus reaction-diffusion stripe insertion & Y-branch unzipping — Morphological realism / specimen match: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The v2 segmentation (row-wise spacing 3.80 mm, primary/secondary prominence 2.65x, bimodal fit r = 0.858; `segment_pomacanthus_specimen`, L997-1097) is kept and the specimen now anchors the new curvilinear geometry: `fit_specimen_concentric_arcs` (L1106-1198) estimates the concentric centre from structure-tensor stripe normals of 767 ridge points (robust least squares, 6 Cauchy reweighting iterations), reads 8 arc radii from the radial histogram and reports the curvature-corrected radial spacing 2.62 mm (CV 0.28) which is, as it must be, below the oblique row-wise 3.80 mm; the fitted circles and centre are drawn on Panel E and the simulated arcs on Panel G are visibly concentric C-arcs like the specimen's. Deductions: ridge points are confined by a hand-traced 12-vertex body polygon (L1100-1104) and only 52 % of them lie within 4 px of a fitted arc with a 4.2 mm gap between the 4th and 5th radii (a probable missed arc) (-4); the 40 mm body-span calibration is still an assumption carried from Pass 2 (-2); simulated arc angular spans are not compared with the measured 31-358 deg spans (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1995-kondo-pomacanthus-stripe-insertion.py L1100–L1104: Body ROI is a manually traced polygon; not derived from the image <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L1100-L1104>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-specimen-match-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;

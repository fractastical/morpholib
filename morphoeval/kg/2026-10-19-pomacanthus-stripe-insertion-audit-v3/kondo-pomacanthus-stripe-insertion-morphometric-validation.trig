}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kondo-pomacanthus-stripe-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Kondo & Asai (1995) Pomacanthus reaction-diffusion stripe insertion & Y-branch unzipping — Morphometric validation: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1204-1316) now returns 9 reference-anchored measurements: the four new ones are the curvilinear arc count after growth (6 vs reference 6, all five transects), I_mid at first insertion (0.742 vs the proved threshold 0.625, with the ~19 % discrepancy explained rather than hidden), the specimen radial arc spacing (2.62 mm vs the row-wise 3.80 mm of the same specimen) and the agent fate concordance (0.930 vs the ideal 1.0, with the full kappa ablation in the note). All carry units, methods and references. Deductions: the I_mid reference comparison fails at face value (ratio 1.19) because the effective threshold with diffusive activator supply is not derived (-3); the specimen arc count (8) is not placed in the model's cascade quantitatively beyond a remark (-2); final curved-domain spacing after insertion (1.33 lambda_c, CV 0.14) shows the cascade is not relaxed at s = 2.6, so wavelength homeostasis on the curved domain is asserted only at s = 1 (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1995-kondo-pomacanthus-stripe-insertion.py L1226–L1234: Final spacing 1.33 lambda_c (CV 0.14) at s = 2.6 shows an unrelaxed post-insertion cascade <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L1226-L1234>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-2d-p-imperator-y-junction-branch-point-horizontal-unzipping-displacement>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-curvilinear-c-shaped-polar-sector-kondo-asai-concentric-arc-count-after-radial-growth-s-1-2-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-discrete-iridophore-melanophore-agent-fate-concordance-with-the-kondo-asai-activator-partition-a-a>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-kondo-asai-1995-critical-diffusivity-ratio-d-c-d-i-d-a-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-mid-trough-inhibitor-i-mid-at-first-concentric-arc-insertion-vs-zero-activator-threshold-c-3-c-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-p-semicirculatus-specimen-concentric-arc-radial-spacing-curvature-corrected-inter-stripe-wavelength>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-p-semicirculatus-supercritical-d-i-0-10-vs-subcritical-control-d-i-0-05-stripe-count-delta>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-pomacanthus-semicirculatus-juvenile-specimen-inter-stripe-wavelength>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-simulated-1d-kondo-asai-piecewise-linear-pde-stripe-wavelength-vs-analytical-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-morphometric-validation-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-2d-p-imperator-y-junction-branch-point-horizontal-unzipping-displacement> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D P. imperator Y-junction branch point horizontal unzipping displacement = 0.6627 domain fraction" ;
        dct:description "posterior flank stripe count incremented from 3 to 4 via horizontal branch unzipping" ;
        schema:measurementTechnique "2D Kondo-Asai PDE solver tracking horizontal Y-branch dislocation propagation from x/L_x = 0.289 to 0.952 (posterior stripes: 3 -> 4)" ;
        schema:name "2D P. imperator Y-junction branch point horizontal unzipping displacement" ;
        schema:unitText "domain fraction" ;
        schema:value "0.6627" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-2d-p-imperator-y-junction-branch-point-horizontal-unzipping-displacement-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-2d-p-imperator-y-junction-branch-point-horizontal-unzipping-displacement-reference> a schema:PropertyValue ;
        dct:source "Kondo & Asai (1995) Nature 376(6543):765-768 Figs. 3-4 (horizontal Y-branch unzipping converting 3 -> 4 stripes)" ;
        schema:value "0.65" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-curvilinear-c-shaped-polar-sector-kondo-asai-concentric-arc-count-after-radial-growth-s-1-2-6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "curvilinear C-shaped polar-sector Kondo-Asai concentric arc count after radial growth s = 1 -> 2.6 = 6.0 concentric arcs (central radial transect)" ;
        dct:description "final radial spacing 4.6121 (1.328 lambda_c, CV 0.137) with angular coherence 0.9996: arcs stay concentric through insertion; cascade still relaxing at s = 2.6 (span 7.8 lambda_c)" ;
        schema:measurementTechnique "IMEX sparse-LU polar-sector solver (rho in [0.25, 1], theta in [-100, 100] deg, 48x96) equilibrated at 3 arcs (radial spacing 3.4369 = lambda_c +/- 1.06%, angular coherence 1.0000) then grown exponentially to s = 2.6; first mid-trough arc insertion at s = 2.1825, arc counts on 5 transects = [6, 6, 6, 6, 6]" ;
        schema:name "curvilinear C-shaped polar-sector Kondo-Asai concentric arc count after radial growth s = 1 -> 2.6" ;
        schema:unitText "concentric arcs (central radial transect)" ;
        schema:value "6.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-curvilinear-c-shaped-polar-sector-kondo-asai-concentric-arc-count-after-radial-growth-s-1-2-6-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-curvilinear-c-shaped-polar-sector-kondo-asai-concentric-arc-count-after-radial-growth-s-1-2-6-reference> a schema:PropertyValue ;
        dct:source "Kondo & Asai (1995) Nature 376(6543):765-768 Figs. 1-2 (3 -> 6 mid-trough doubling) transferred to the concentric C-shaped juvenile P. semicirculatus geometry; Lean theorem kondo_asai_1995_curvilinear_mid_trough_threshold_partition (concentric_arcs 3 2 = 6)" ;
        schema:value "6.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-discrete-iridophore-melanophore-agent-fate-concordance-with-the-kondo-asai-activator-partition-a-a> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "discrete iridophore/melanophore agent fate concordance with the Kondo-Asai activator partition A >= A* = 0.9297 fraction of cells" ;
        dct:description "ablation over kappa in [0.0, 0.005, 0.01, 0.02]: concordance [0.9531, 0.9688, 0.9297, 0.9297], iridophore fraction [0.4453, 0.4531, 0.4688, 0.4766], stripe amplitude gain vs uncoupled control [0.0, 3.6014, 8.1055, 11.6546] %; wavelength is quantised to L/6 on the periodic domain so the feedback shifts contrast, not spacing (uncoupled control concordance 0.9531)" ;
        schema:measurementTechnique "1D hybrid field-agent model on L = 6 lambda_c (128 cells, kappa_A = kappa_I = 0.01, contact exclusion + long-range support rules, stochastic asynchronous fate updates every 20 steps, seed 1995); agent stripes (iridophore runs >= 3 cells) = 6 vs field stripes = 6" ;
        schema:name "discrete iridophore/melanophore agent fate concordance with the Kondo-Asai activator partition A >= A*" ;
        schema:unitText "fraction of cells" ;
        schema:value "0.9297" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-discrete-iridophore-melanophore-agent-fate-concordance-with-the-kondo-asai-activator-partition-a-a-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-discrete-iridophore-melanophore-agent-fate-concordance-with-the-kondo-asai-activator-partition-a-a-reference> a schema:PropertyValue ;
        dct:source "Lean theorem kondo_asai_1995_pigment_agent_fate_partition_and_bounded_feedback (deterministic threshold partition cell_fate = [A >= A_thr]); Nakamasu et al. (2009) PNAS 106:8429 pigment-cell interaction network" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-kondo-asai-1995-critical-diffusivity-ratio-d-c-d-i-d-a-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Kondo-Asai (1995) critical diffusivity ratio d_c = (D_I / D_A)_c = 10.2596 dimensionless" ;
        dct:description "canonical d = D_I/D_A = 14.2857 > d_c = 10.2596; unstable wavenumber band k^2 in [1.3848, 5.1581]" ;
        schema:measurementTechnique "Kondo & Asai (1995) Fig. 1 linear stability threshold d_c = 5.2 + 1.6*sqrt(10) around interior steady state (A*, I*) = (3.0, 2.5) with det M(3) = -2440 (x10^-6)" ;
        schema:name "Kondo-Asai (1995) critical diffusivity ratio d_c = (D_I / D_A)_c" ;
        schema:unitText "dimensionless" ;
        schema:value "10.2596" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-kondo-asai-1995-critical-diffusivity-ratio-d-c-d-i-d-a-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-kondo-asai-1995-critical-diffusivity-ratio-d-c-d-i-d-a-c-reference> a schema:PropertyValue ;
        dct:source "Kondo & Asai (1995) Nature 376(6543):765-768 Fig. 1 legend" ;
        schema:value "10.2596" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-mid-trough-inhibitor-i-mid-at-first-concentric-arc-insertion-vs-zero-activator-threshold-c-3-c-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "mid-trough inhibitor I_mid at first concentric arc insertion vs zero-activator threshold c_3/|c_2| = 0.7424 inhibitor concentration (model units)" ;
        dct:description "insertion fires ~20% above the zero-activator threshold because diffusive activator supply from the flanking arcs (A_trough ~ 0.05-0.1) and the 0.004 background fluctuations raise the local synthesis before I_mid itself crosses 0.625; the Lean bound is the sufficient (A = 0) condition" ;
        schema:measurementTechnique "minimum of I along the central radial transect between adjacent arcs, sampled every 50 steps during growth; pre-insertion I_mid(s) is strictly decreasing (Spearman rho = -1.000); value is the last pre-insertion sample" ;
        schema:name "mid-trough inhibitor I_mid at first concentric arc insertion vs zero-activator threshold c_3/|c_2|" ;
        schema:unitText "inhibitor concentration (model units)" ;
        schema:value "0.7424" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-mid-trough-inhibitor-i-mid-at-first-concentric-arc-insertion-vs-zero-activator-threshold-c-3-c-2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-mid-trough-inhibitor-i-mid-at-first-concentric-arc-insertion-vs-zero-activator-threshold-c-3-c-2-reference> a schema:PropertyValue ;
        dct:source "Kondo & Asai (1995) piecewise-linear synthesis F = max(0, c_1 A + c_2 I + c_3) with A = 0 => insertion iff I < c_3/|c_2| = 0.625 (Lean theorem kondo_asai_1995_curvilinear_mid_trough_threshold_partition)" ;
        schema:value "0.625" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-p-semicirculatus-specimen-concentric-arc-radial-spacing-curvature-corrected-inter-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "P. semicirculatus specimen concentric-arc radial spacing (curvature-corrected inter-stripe wavelength) = 2.62 mm" ;
        dct:description "radial spacing CV = 0.282; arc angular spans [334.7, 357.6, 194.4, 115.0, 58.9, 58.9, 44.3, 30.9] deg (inner arcs near-closed loops, outer arcs C-shaped); 8 arcs at 40 mm body span lies between the Kondo-Asai s = 2 (6) and s = 4 (12) cascade stages" ;
        schema:measurementTechnique "structure-tensor concentric-centre fit on 767 stripe ridge points inside the traced body polygon (centre = [262.0, 217.1] px, median normal-line miss 19.3 px); 8 arc radii [4.95, 7.68, 10.21, 12.53, 16.74, 18.84, 20.53, 23.26] mm from the radial ridge-point histogram (median radial residual 3.59 px, 52% of points within 4 px of a fitted arc)" ;
        schema:name "P. semicirculatus specimen concentric-arc radial spacing (curvature-corrected inter-stripe wavelength)" ;
        schema:unitText "mm" ;
        schema:value "2.62" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-p-semicirculatus-specimen-concentric-arc-radial-spacing-curvature-corrected-inter-stripe-wavelength-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-p-semicirculatus-specimen-concentric-arc-radial-spacing-curvature-corrected-inter-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "row-wise DoG spacing of the same specimen (`segment_pomacanthus_specimen`, 3.80 mm) which over-estimates the wavelength by the row/stripe obliquity factor; Kondo & Asai (1995) juvenile P. semicirculatus concentric stripes" ;
        schema:value "3.8" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-p-semicirculatus-supercritical-d-i-0-10-vs-subcritical-control-d-i-0-05-stripe-count-delta> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "P. semicirculatus supercritical (D_I=0.10) vs subcritical control (D_I=0.05) stripe count delta = 6.0 stripes (supercritical vs subcritical control)" ;
        dct:description "across 5 ontogenetic doubling & control regimes, simulated stripes = [0, 3, 6, 12, 24], Pearson r = 1.0000 (p=0.00e+00)" ;
        schema:measurementTechnique "supercritical inhibitor diffusion D_I=0.10 (d=14.29 > d_c, N=6 stripes) vs subcritical control D_I=0.050 (d=7.14 < d_c, N=0 stripes); 5-regime cascade (3->6->12->24) RMSE=0.0000" ;
        schema:name "P. semicirculatus supercritical (D_I=0.10) vs subcritical control (D_I=0.05) stripe count delta" ;
        schema:unitText "stripes (supercritical vs subcritical control)" ;
        schema:value "6.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-p-semicirculatus-supercritical-d-i-0-10-vs-subcritical-control-d-i-0-05-stripe-count-delta-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-p-semicirculatus-supercritical-d-i-0-10-vs-subcritical-control-d-i-0-05-stripe-count-delta-reference> a schema:PropertyValue ;
        dct:source "Kondo & Asai (1995) Nature 376(6543):765-768 Figs. 1-2 (3 -> 6 -> 12 -> 24 stripe doubling cascade)" ;
        schema:value "6.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-pomacanthus-semicirculatus-juvenile-specimen-inter-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pomacanthus semicirculatus juvenile specimen inter-stripe wavelength = 3.8 mm" ;
        dct:description "primary vs newly inserted secondary mid-trough stripe prominence ratio = 2.65 (156.4 vs 59.0); bimodal Kondo-Asai wave correlation r = 0.8575 (p=4.63e-59)" ;
        schema:measurementTechnique "1D DoG bandpass peak segmentation across lateral flank ROI of pomacanthus_semicirculatus_specimen.jpg (n=105 inter-stripe spacings, mean=36.11 px, std=13.01 px, CV=0.3601, calibrated at 40 mm body span)" ;
        schema:name "Pomacanthus semicirculatus juvenile specimen inter-stripe wavelength" ;
        schema:unitText "mm" ;
        schema:value "3.8" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-pomacanthus-semicirculatus-juvenile-specimen-inter-stripe-wavelength-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-pomacanthus-semicirculatus-juvenile-specimen-inter-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "Kondo & Asai (1995) Nature 376(6543):765-768 & vendored CC BY-SA 4.0 P. semicirculatus specimen" ;
        schema:value "3.7" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-simulated-1d-kondo-asai-piecewise-linear-pde-stripe-wavelength-vs-analytical-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated 1D Kondo-Asai piecewise-linear PDE stripe wavelength vs analytical lambda_c = 3.4739 grid units" ;
        dct:description "relative wavelength error = 0.0000%, inter-stripe spacing CV = 0.0110" ;
        schema:measurementTechnique "1D IMEX spectral Kondo-Asai piecewise-linear saturating PDE solver on L = 6*lambda_c (N=6 stripes, CV=0.0110)" ;
        schema:name "simulated 1D Kondo-Asai piecewise-linear PDE stripe wavelength vs analytical lambda_c" ;
        schema:unitText "grid units" ;
        schema:value "3.4739" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-simulated-1d-kondo-asai-piecewise-linear-pde-stripe-wavelength-vs-analytical-lambda-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-simulated-1d-kondo-asai-piecewise-linear-pde-stripe-wavelength-vs-analytical-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Kondo & Asai (1995) Nature 376(6543):765-768 Fig. 1 (k_c^2 = 229/70 = 3.2714 => lambda_c = 2*pi/k_c = 3.4739)" ;
        schema:value "3.4739" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L1204–L1316" ;
        dct:description "9 MorphoEval measurements with reference values, units, methods and ablation notes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L1204-L1316> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L1236–L1245" ;
        dct:description "I_mid at insertion = 0.742 reported against the proved A = 0 threshold 0.625 with the discrepancy explained" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L1236-L1245> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kondo-pomacanthus-stripe-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Kondo & Asai (1995) Pomacanthus reaction-diffusion stripe insertion & Y-branch unzipping — Model fidelity to source: 95/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Adds the two mechanisms the v2 audit asked for. The polar-sector Laplacian (`build_polar_sector_laplacian`, L606-646) carries the (1/rho) d/drho and (1/rho^2) d^2/dtheta^2 terms with mirrored-ghost Neumann edges and is unit-tested (annihilates constants, Lap(rho^2) = 4); `simulate_curvilinear_c_shaped_arc_insertion` (L659-819) rescales it by 1/R(t)^2 on the growing radius and refactors the sparse LU every 20 steps, recovering lambda_c to 1.06 % at s = 1 and the 3 -> 6 doubling with I_mid(s) strictly decreasing until insertion. The hybrid agent model (L837-961) implements the threshold fate rule, Nakamasu-style exclusion/support contacts and the bounded c_3/c_5 feedback that Lean Theorem 5 bounds. Deductions: the domain is an idealised sector (rho_in = 0.25, theta_half = 100 deg) rather than the specimen outline (-2); insertion needs injected 0.004 fluctuations (L733), and the older 1D kymograph still uses mode-6/12 biased nudges (L402-406) (-2); the agent rules are 1D and their probabilities are uncited heuristics (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1995-kondo-pomacanthus-stripe-insertion.py L402–L406: Pre-existing 1D kymograph injects mode-6 and mode-12 cosines every 25 steps to nucleate insertions (biased toward the expected answer) <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L402-L406>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-4> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L606–L646" ;
        dct:description "Sparse FD polar-sector Laplacian with (1/rho) d/drho curvature term and mirrored-ghost zero-flux edges" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L606-L646> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L659–L819" ;
        dct:description "Growing-radius IMEX sparse-LU curvilinear solver tracking I_mid(s), arc count N(s), insertion scale s* and angular coherence" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L659-L819> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L837–L961" ;
        dct:description "1D hybrid field + discrete pigment-cell lattice: threshold fate rule, short-range exclusion, long-range support, bounded kappa feedback on c_3/c_5" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L837-L961> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_004_pomacanthus_stripe_insertion.lean L114–L229" ;
        dct:description "Two new machine-checked theorems (threshold partition / antitone trough synthesis / arc doubling; monotone binary fate and bounded feedback), 0 sorrys" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_004_pomacanthus_stripe_insertion.lean#L114-L229> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


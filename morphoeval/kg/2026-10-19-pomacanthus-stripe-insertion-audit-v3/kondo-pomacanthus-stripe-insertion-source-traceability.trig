sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kondo-pomacanthus-stripe-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Kondo & Asai (1995) Pomacanthus reaction-diffusion stripe insertion & Y-branch unzipping — Source and data traceability: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The vendored dataset gains the two new primary sources in `paper_citations.bib` (Nakamasu et al. 2009 `10.1073/pnas.0808622106`, Bullara & De Decker 2015 `10.1038/ncomms7971`), a `pass3_curvilinear_and_agent_coupling` block in the reference JSON recording the sector parameters, the insertion threshold derivation, the specimen body polygon, concentric centre, arc radii and the agent rule parameters, and a README section describing how each was derived; the SHA-256-pinned specimen and scout manifest are untouched and still verified at runtime (L111-129). Deductions: the reference JSON is hashed at runtime but not pinned in `EXPECTED_SHA256` (L98-105), so an edit to the reference values would not fail the self-test (-3); the Nakamasu rules are cited for their qualitative structure only (-2); the 40 mm body-span calibration still has no primary source (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "1995-kondo-pomacanthus-stripe-insertion.py L98–L129: Runtime SHA-256 verification pins only the specimen JPG and scout manifest; the reference JSON digest is recorded, not checked <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L98-L129>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-source-traceability-2> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "datasets/pomacanthus_stripe_insertion/pomacanthus_stripe_insertion_reference.json L171–L217" ;
        dct:description "Pass 3 block: polar-sector parameters, I_thr derivation, measured s*, specimen polygon/centre/radii, agent rules and kappa grid" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/pomacanthus_stripe_insertion/pomacanthus_stripe_insertion_reference.json#L171-L217> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/pomacanthus_stripe_insertion/paper_citations.bib L34–L55" ;
        dct:description "Nakamasu et al. (2009) and Bullara & De Decker (2015) BibTeX entries with DOIs and role notes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/pomacanthus_stripe_insertion/paper_citations.bib#L34-L55> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kondo-pomacanthus-stripe-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Kondo & Asai (1995) Pomacanthus reaction-diffusion stripe insertion & Y-branch unzipping — Code-to-model traceability: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring (L22-66) now states Laws 4 and 5 with their Lean theorem names, the polar Laplacian, the threshold derivation, the fate/feedback bounds and the two new DOIs; each new function docstring names the paper figure or theorem it implements; the math-KG loop file registers both new laws with `lean_decl`, `lean_theorem`, `lean_locus` and `code_locus` (L76-116) and the Pass 2 code loci were corrected to the current line numbers. Deductions: the agent rule constants 0.9 / 0.1 / 0.35 / 0.3 (L846-848, L911-912) and the 0.004 fluctuation amplitude (L669) have no cited provenance in code or docstring (-4); panel titles were abbreviated to fit and no longer carry the full mechanism names (-1); the KG `lean_code` excerpts elide the proof bodies (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1995-kondo-pomacanthus-stripe-insertion.py L845–L848: Agent rule probabilities and softness are uncited defaults <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L845-L848>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-code-traceability-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L22–L66" ;
        dct:description "Module docstring: Laws 4-5 with Lean theorem names, polar Laplacian, threshold and feedback bounds, Pass 3 references" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1995-kondo-pomacanthus-stripe-insertion.py#L22-L66> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/kondo-pomacanthus-stripe-insertion.yaml L76–L116" ;
        dct:description "Two new equations registered with Lean declarations, theorem names, loci and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/kondo-pomacanthus-stripe-insertion.yaml#L76-L116> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


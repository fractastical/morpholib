<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg Turing wavelength at 436 µm on Holocene Felis catus (pass 1) — Model fidelity to source: 76/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "growth_rate implements the leading eigenvalue of J - k^2 D and fastest_mode selects k*. Kinetics are Schnakenberg, which is a standard realisation of Turing's law, not the Dkk4 circuit Kaelin identified. Nominal point only." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

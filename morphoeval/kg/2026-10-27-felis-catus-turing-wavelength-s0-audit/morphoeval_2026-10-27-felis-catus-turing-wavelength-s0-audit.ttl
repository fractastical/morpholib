<https://w3id.org/delphi/resource/math-law/delphi10000-felis-catus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion growth rate" ;
    dct:description "Diffusion-driven instability that selects the 436 µm primordium wavelength | Variables: D_v, D_u, f_u, g_v in thousandths at the Holocene Schnakenberg point" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-felis-catus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3226_felis_catus_turing_wavelength_s0.lean#L46-L48> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "sigma(k) = leading eigenvalue of J - k^2 D; k* = argmax sigma(k); lambda = 2*pi/k*" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/s41467-021-25348-2>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1220893> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3226.diffusionDrive" ;
    pk:leanTheorem "MathOfBiology.Loop_3226.diffusion_driven_instability" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-felis-catus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Primordium wavelength bounds" ;
    dct:description "Places this Holocene detail scale inside tier 5 | Variables: wavelengthUm = 436" ;
    dct:source "Murray 1981 DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-felis-catus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3226_felis_catus_turing_wavelength_s0.lean#L19-L21> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "100 < lambda_um < 1000, lambda_um = 436" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/s41467-021-25348-2>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1220893> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3226.wavelengthUm" ;
    pk:leanTheorem "MathOfBiology.Loop_3226.wavelength_in_primordium_tier" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-felis-catus-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Successor flank mode count" ;
    dct:description "Stripe number changes on the larger domain; k* does not. No second chronospecies exists. | Variables: L_successor = 4360 µm, lambda = 436 µm" ;
    dct:source "Kaelin, McGowan and Barsh 2021 DOI:10.1038/s41467-021-25348-2" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-felis-catus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3226_felis_catus_turing_wavelength_s0.lean#L34-L36> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N_waves(L) = L / lambda, 10 * 436 = 4360" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/s41467-021-25348-2>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1220893> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3226.wavelengthUm" ;
    pk:leanTheorem "MathOfBiology.Loop_3226.successor_flank_holds_ten_wavelengths" ;
    pk:leanVerified true .


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-felis-catus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 436 µm on Holocene Felis catus (pass 1) — Morphometric validation: 64/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dominant wavelength 431.3 µm is measured on the field and compared with the 436 µm slot scale. Cellular-predecessor growth rate is negative. Pearson r, RMSE, KS, and specimen segmentation statistics are not yet reported, so this score stays below the pass-2 bar." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-cellular-predecessor-fundamental-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-selected-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-turing-sigma-star>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-cellular-predecessor-fundamental-sigma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cellular_predecessor_fundamental_sigma = -29.405 1/time" ;
        dct:description "reference is σ* of the 436 µm pattern; the cellular predecessor is stable" ;
        schema:measurementTechnique "σ(k_fund) on an 80 µm cellular-tier domain; Felis chronoseries has no earlier species" ;
        schema:name "cellular_predecessor_fundamental_sigma" ;
        schema:unitText "1/time" ;
        schema:value "-29.405" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-cellular-predecessor-fundamental-sigma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-cellular-predecessor-fundamental-sigma-reference> a schema:PropertyValue ;
        schema:value "2.7561" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-selected-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "selected_stripe_wavelength = 431.251 µm" ;
        dct:description "reference is the slot scale, not a Kaelin measurement; value is the simulated dominant wavelength" ;
        schema:measurementTechnique "radial FFT peak of the Schnakenberg activator on a 5-wave periodic patch, scaled so λ(k*) = 436 µm" ;
        schema:name "selected_stripe_wavelength" ;
        schema:unitText "µm" ;
        schema:value "431.251" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-selected-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-selected-stripe-wavelength-reference> a schema:PropertyValue ;
        schema:value "436.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-turing-sigma-star> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "turing_sigma_star = 2.7561 1/time" ;
        dct:description "reference 0 is the marginal stability boundary; a positive value is the unstable Holocene point" ;
        schema:measurementTechnique "max real eigenvalue of J - k^2 D over k in (0.15, 18)" ;
        schema:name "turing_sigma_star" ;
        schema:unitText "1/time" ;
        schema:value "2.7561" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-turing-sigma-star-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-turing-sigma-star-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-felis-catus-turing-wavelength-s0.py L182–L201" ;
        dct:description "radial-FFT wavelength in micrometres" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-felis-catus-turing-wavelength-s0.py#L182-L201> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-felis-catus-turing-wavelength-s0.py L369–L404" ;
        dct:description "measure_morphoeval returns wavelength, sigma*, and predecessor sigma with references that differ from the values" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-felis-catus-turing-wavelength-s0.py#L369-L404> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1038/s41467-021-25348-2>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1220893> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:title "A pre-pattern formation mechanism for animal coat markings" .
    <https://doi.org/10.1038/s41467-021-25348-2> dct:title "Developmental genetics of color pattern establishment in cats" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.1220893> dct:title "Specifying and Sustaining Pigmentation Patterns in Domestic and Wild Cats" .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Acanthometra pellucida Schnakenberg wavelength at 206 nm (Holocene, 0 Ma) — Model fidelity to source: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The script implements Schnakenberg kinetics and the standard critical-wavenumber formula, with (a, b, gamma, d) = (0.14, 0.76, 10, 18), periodic boundaries, and explicit Euler. The 206 nm result is the length unit, not an extra fitted mode. It is not a derivation of that wavelength from a measured SrSO4 diffusivity." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acanthometra-pellucida-turing-wavelength-s0.py L65–L93" ;
        dct:description "Jacobian, k_c^2, and the length unit that sets lambda_c(gamma=10) = 206 nm" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1fee7075fcbec51969593b452b4632c61bd2928/models/2026-delphi10000-acanthometra-pellucida-turing-wavelength-s0.py#L65-L93> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acanthometra-pellucida-turing-wavelength-s0.py L135–L193" ;
        dct:description "Periodic Schnakenberg integrator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1fee7075fcbec51969593b452b4632c61bd2928/models/2026-delphi10000-acanthometra-pellucida-turing-wavelength-s0.py#L135-L193> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3101_acanthometra_pellucida_turing_wavelength_s0.lean L15–L33" ;
        dct:description "Four Lean theorems, 0 sorry, for the trace sign, the ablation, monotonicity in Dv, and 6 > 3 stripes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1fee7075fcbec51969593b452b4632c61bd2928/morphoeval/lean/loops/Loop_3101_acanthometra_pellucida_turing_wavelength_s0.lean#L15-L33> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (single builder-assessor; no second provider scored this pass)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


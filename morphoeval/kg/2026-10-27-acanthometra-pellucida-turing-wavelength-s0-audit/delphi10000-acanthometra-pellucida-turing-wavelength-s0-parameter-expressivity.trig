sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Acanthometra pellucida Schnakenberg wavelength at 206 nm (Holocene, 0 Ma) — Parameter expressivity: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Raising gamma shortens both the analytical and the measured wavelength, in the same direction, across 4, 7, 10, 14, 19, and 26. Equal diffusion (d = 1) collapses the amplitude. A second knockout and a held-out scale for the 43 nm bias are not in this pass." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acanthometra-pellucida-turing-wavelength-s0.py L195–L223" ;
        dct:description "Six-point gamma sweep, Pearson r and RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1fee7075fcbec51969593b452b4632c61bd2928/models/2026-delphi10000-acanthometra-pellucida-turing-wavelength-s0.py#L195-L223> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acanthometra-pellucida-turing-wavelength-s0.py L250–L258" ;
        dct:description "Equal-diffusion run paired with the reference run" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1fee7075fcbec51969593b452b4632c61bd2928/models/2026-delphi10000-acanthometra-pellucida-turing-wavelength-s0.py#L250-L258> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (single builder-assessor; no second provider scored this pass)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


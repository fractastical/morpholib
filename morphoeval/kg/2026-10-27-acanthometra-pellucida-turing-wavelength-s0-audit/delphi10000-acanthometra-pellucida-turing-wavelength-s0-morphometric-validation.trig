sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Acanthometra pellucida Schnakenberg wavelength at 206 nm (Holocene, 0 Ma) — Morphometric validation: 78/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "In-sample Pearson r = 0.9991 on six wavelengths, with p from scipy.stats.pearsonr. RMSE = 43.30 nm is large relative to 206 nm and is a systematic long shift, not noise. First-render radial-profile r = 0.548. Orientation KS = 0.113. Foreground fraction 0.501 versus 0.352 on the drawing. n = 1 plate. Self-identical value==reference metrics are not used." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-analytical-turing-wavelength-at-gamma-10>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-autocatalysis-knockout-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-detected-specimen-spine-axis-peaks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-gamma-sweep-wavelength-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-gamma-sweep-wavelength-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-held-out-wavelength-scale-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-capsule-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-orientation-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-radial-profile-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-analytical-turing-wavelength-at-gamma-10> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "analytical Turing wavelength at gamma 10 = 206.0 nm" ;
        dct:description "Holocene 0 Ma; scale 206 nm. The reference is the simulated peak, so value != reference." ;
        schema:measurementTechnique "lambda_c = 2*pi/k_c with length unit fixed at the assigned 206 nm detail scale" ;
        schema:name "analytical Turing wavelength at gamma 10" ;
        schema:unitText "nm" ;
        schema:value "206.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-analytical-turing-wavelength-at-gamma-10-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-analytical-turing-wavelength-at-gamma-10-reference> a schema:PropertyValue ;
        dct:source "nonlinear FFT peak at the same gamma (not equal to the analytical value)" ;
        schema:value "241.4615" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-autocatalysis-knockout-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "autocatalysis-knockout amplitude ratio = 0.0 1" ;
        schema:measurementTechnique "linear decay without u^2 v, divided by the Schnakenberg std, same grid and seed" ;
        schema:name "autocatalysis-knockout amplitude ratio" ;
        schema:unitText "1" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-autocatalysis-knockout-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-autocatalysis-knockout-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "equal-diffusion ablation ratio (a different control, not this one)" ;
        schema:value "0.0004" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-detected-specimen-spine-axis-peaks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "detected specimen spine-axis peaks = 8 count" ;
        schema:measurementTechnique "local maxima of the 72-bin dark-edge angular energy outside the capsule" ;
        schema:name "detected specimen spine-axis peaks" ;
        schema:unitText "count" ;
        schema:value "8" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-detected-specimen-spine-axis-peaks-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-detected-specimen-spine-axis-peaks-reference> a schema:PropertyValue ;
        dct:source "Müller ground plan of 20 radial spicules; the plate projects fewer long axes" ;
        schema:value "20" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation amplitude ratio = 0.0004 1" ;
        dct:description "patterned std = 0.1722; ablated std = 0.0001; integer trace at d=1 is negative" ;
        schema:measurementTechnique "std(u) at Dv=Du divided by std(u) at Dv/Du = 18, 1400 steps, same seed" ;
        schema:name "equal-diffusion ablation amplitude ratio" ;
        schema:unitText "1" ;
        schema:value "0.0004" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "a ratio of 1 would mean the ablation failed to change the amplitude" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-gamma-sweep-wavelength-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "gamma-sweep wavelength Pearson r = 0.9991 1" ;
        dct:description "p = 1.164e-06; RMSE = 43.3031 nm; residual CV = 0.1014" ;
        schema:measurementTechnique "pearsonr of analytical lambda_c(gamma) vs FFT peak, six gamma values, fixed 48-unit box" ;
        schema:name "gamma-sweep wavelength Pearson r" ;
        schema:unitText "1" ;
        schema:value "0.9991" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-gamma-sweep-wavelength-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-gamma-sweep-wavelength-pearson-r-reference> a schema:PropertyValue ;
        dct:source "pre-registered acceptance threshold; not the measured coefficient" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-gamma-sweep-wavelength-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "gamma-sweep wavelength RMSE = 43.3031 nm" ;
        dct:description "coefficient of variation of residuals reported in the Pearson row" ;
        schema:measurementTechnique "sqrt mean square difference, analytical vs measured lambda across the gamma sweep" ;
        schema:name "gamma-sweep wavelength RMSE" ;
        schema:unitText "nm" ;
        schema:value "43.3031" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-gamma-sweep-wavelength-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-gamma-sweep-wavelength-rmse-reference> a schema:PropertyValue ;
        dct:source "perfect spectral agreement; the grid peak is systematically longer" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-held-out-wavelength-scale-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "held-out wavelength scale Pearson r = 0.9991 1" ;
        dct:description "scale = 1.1875; held-out RMSE = 6.0944 nm; p = 2.679e-02" ;
        schema:measurementTechnique "median measured/analytic scale fit on gamma 4, 7, 10; scored on gamma 14, 19, 26" ;
        schema:name "held-out wavelength scale Pearson r" ;
        schema:unitText "1" ;
        schema:value "0.9991" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-held-out-wavelength-scale-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-held-out-wavelength-scale-pearson-r-reference> a schema:PropertyValue ;
        dct:source "pre-registered acceptance threshold; the in-sample six-point r is a different split" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-capsule-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image capsule circularity = 0.0119 1" ;
        dct:description "The plate's spine halo makes the mask non-circular." ;
        schema:measurementTechnique "4*pi*area/perimeter^2 of the contrast mask" ;
        schema:name "specimen image capsule circularity" ;
        schema:unitText "1" ;
        schema:value "0.0119" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-capsule-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-capsule-circularity-reference> a schema:PropertyValue ;
        dct:source "circularity of the simulated frame mask" ;
        schema:value "0.0143" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image foreground fraction = 0.5012 1" ;
        schema:measurementTechnique "border-median contrast mask on the Haeckel crop" ;
        schema:name "specimen image foreground fraction" ;
        schema:unitText "1" ;
        schema:value "0.5012" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "same mask on the simulated last frame" ;
        schema:value "0.3523" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-orientation-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image orientation KS statistic = 0.1133 1" ;
        dct:description "p = 9.455e-23; spine-axis angular Pearson r = 0.9070" ;
        schema:measurementTechnique "two-sample KS on 4000 Sobel-orientation draws, specimen vs render" ;
        schema:name "specimen image orientation KS statistic" ;
        schema:unitText "1" ;
        schema:value "0.1133" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-orientation-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-orientation-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "identical orientation distributions would have KS = 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-radial-profile-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image radial-profile Pearson r = 0.0956 1" ;
        dct:description "p = 5.182e-01" ;
        schema:measurementTechnique "pearsonr of 48-bin radial mean gray, specimen vs rendered last frame" ;
        schema:name "specimen image radial-profile Pearson r" ;
        schema:unitText "1" ;
        schema:value "0.0956" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-radial-profile-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-radial-profile-pearson-r-reference> a schema:PropertyValue ;
        dct:source "RMSE of the same profiles, in gray levels (different quantity)" ;
        schema:value "23.3201" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image structure-tensor coherency = 0.6012 1" ;
        schema:measurementTechnique "mean (lambda1-lambda2)/(lambda1+lambda2) on the specimen foreground" ;
        schema:name "specimen image structure-tensor coherency" ;
        schema:unitText "1" ;
        schema:value "0.6012" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "same coherency on the simulated last frame" ;
        schema:value "0.8433" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acanthometra-pellucida-turing-wavelength-s0.py L110–L132" ;
        dct:description "Radial FFT peak used as the measured wavelength" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1fee7075fcbec51969593b452b4632c61bd2928/models/2026-delphi10000-acanthometra-pellucida-turing-wavelength-s0.py#L110-L132> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acanthometra-pellucida-turing-wavelength-s0.py L627–L740" ;

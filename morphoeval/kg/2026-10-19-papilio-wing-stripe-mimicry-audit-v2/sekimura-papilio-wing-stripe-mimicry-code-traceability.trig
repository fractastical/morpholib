        rdfs:label "Sekimura et al. (2000) Proc. R. Soc. B, Madzvamuse et al. (2002) J. Math. Biol. & Thompson et al. (2014) Nature anisotropic Gierer–Meinhardt butterfly wing pattern formation and Batesian mimicry polymorphism in Papilio dardanus — Code-to-model traceability: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Module and function docstrings map every governing equation and control to Sekimura et al. (2000), Madzvamuse et al. (2002), Timmermans/Thompson et al. (2014), Gierer & Meinhardt (1972), and the 3 formal Lean 4 theorems in `morphoeval/lean/loops/Loop_099_papilio_wing_stripe_mimicry.lean` (L1-47, L114-524)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-code-traceability-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2016-sekimura-papilio-wing-stripe-mimicry.py L1–L47" ;
        dct:description "Explicit equation-to-paper and Lean 4 theorem traceability in module header" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py#L1-L47> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 099 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


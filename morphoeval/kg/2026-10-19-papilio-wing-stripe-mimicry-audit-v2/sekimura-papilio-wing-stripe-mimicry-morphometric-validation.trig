sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sekimura-papilio-wing-stripe-mimicry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Sekimura et al. (2000) Proc. R. Soc. B, Madzvamuse et al. (2002) J. Math. Biol. & Thompson et al. (2014) Nature anisotropic Gierer–Meinhardt butterfly wing pattern formation and Batesian mimicry polymorphism in Papilio dardanus — Morphometric validation: 95/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L755-862) computes 10 reference-anchored quantitative morphometrics: Gierer–Meinhardt u0 = 1.1000 (ref 1.10), critical diffusivity ratio d_c = 8.2384 (ref 8.2384), hippocoonides f_blk = 0.4722 (ref 0.48), trophonius f_blk = 0.5446 (ref 0.56), cenea f_blk = 0.7001 (ref 0.72), planemoides f_blk = 0.6274 (ref 0.63), 6-point threshold sweep Pearson r = 0.9832 (p = 4.21e-4, RMSE = 0.0446), 5-point anisotropy orientation sweep Pearson r = 0.9672 (p = 7.09e-3), equal-diffusion negative control std(u) = 0.000018 (ref 0.0), and segmented specimen dorsal wing melanic fraction 0.7034 (ref 0.72)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-5-point-vein-anisotropy-epsilon-stripe-to-band-orientation-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-6-point-engrailed-threshold-u-th-melanic-area-expansion-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-equal-diffusion-negative-control-d-1-0-pattern-amplitude-std-u>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-cenea-curved-forewing-pde-melanic-area-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-hippocoonides-curved-forewing-pde-melanic-area-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-planemoides-curved-forewing-pde-melanic-area-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-trophonius-curved-forewing-pde-melanic-area-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-gierer-meinhardt-homogeneous-steady-state-u0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-segmented-papilio-dardanus-specimen-dorsal-wing-melanic-area-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-morphometric-validation-1> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-5-point-vein-anisotropy-epsilon-stripe-to-band-orientation-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "5-point vein anisotropy epsilon stripe-to-band orientation Pearson r = 0.9672 Pearson r" ;
        dct:description "p = 7.10e-03, RMSE = 7.52 deg (15.7 deg at eps=0.25 -> 68.0 deg at eps=1.65)" ;
        schema:measurementTechnique "linear correlation of dominant pattern orientation angle across epsilon = D_perp/D_par in [0.25, 1.65]" ;
        schema:name "5-point vein anisotropy epsilon stripe-to-band orientation Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9672" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-5-point-vein-anisotropy-epsilon-stripe-to-band-orientation-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-5-point-vein-anisotropy-epsilon-stripe-to-band-orientation-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Sekimura et al. (2000) Proc. R. Soc. B 267:851-859 Section 2(b) & Lean Theorem 2 anisotropic_vein_mode_selection_switch" ;
        schema:value "0.96" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-6-point-engrailed-threshold-u-th-melanic-area-expansion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "6-point engrailed threshold u_th melanic area expansion Pearson r = 0.9832 Pearson r" ;
        dct:description "p = 4.21e-04, RMSE = 0.0440" ;
        schema:measurementTechnique "linear correlation of simulated vs reference f_black(u_th) across u_th in [0.85, 1.22]" ;
        schema:name "6-point engrailed threshold u_th melanic area expansion Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9832" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-6-point-engrailed-threshold-u-th-melanic-area-expansion-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-6-point-engrailed-threshold-u-th-melanic-area-expansion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Sekimura et al. (2000) Proc. R. Soc. B 267:851-859 Section 3 & Lean Theorem 3 monotonic_melanic_wing_expansion" ;
        schema:value "0.99" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-equal-diffusion-negative-control-d-1-0-pattern-amplitude-std-u> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion negative control (d = 1.0) pattern amplitude std(u) = 1.7e-05 std(u)" ;
        dct:description "positive d=40 std(u) = 0.1800 vs d=1 std(u) = 1.69e-05 (suppression ratio = 1.1e+04)" ;
        schema:measurementTechnique "2D Gierer-Meinhardt PDE spatial standard deviation at d = Dv/Du = 1.0 < d_c = 8.2384" ;
        schema:name "equal-diffusion negative control (d = 1.0) pattern amplitude std(u)" ;
        schema:unitText "std(u)" ;
        schema:value "1.7e-05" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-equal-diffusion-negative-control-d-1-0-pattern-amplitude-std-u-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-equal-diffusion-negative-control-d-1-0-pattern-amplitude-std-u-reference> a schema:PropertyValue ;
        dct:source "Turing (1952) / Sekimura et al. (2000) Eq. (2.3) & Lean Theorem 1 gierer_meinhardt_steady_state_and_turing_instability" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-cenea-curved-forewing-pde-melanic-area-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "f. cenea curved forewing PDE melanic area fraction = 0.6998 area fraction" ;
        dct:description "discrete buff/cream spot count = 6 (ref = 5)" ;
        schema:measurementTechnique "2D anisotropic Gierer-Meinhardt PDE on curved forewing mesh at u_th = 0.94, alpha_bc = 0.85, epsilon = 0.75" ;
        schema:name "f. cenea curved forewing PDE melanic area fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.6998" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-cenea-curved-forewing-pde-melanic-area-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-cenea-curved-forewing-pde-melanic-area-fraction-reference> a schema:PropertyValue ;
        dct:source "Sekimura et al. (2000) Proc. R. Soc. B 267:851-859 Table 1 & Fig. 5 (f. cenea)" ;
        schema:value "0.72" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-hippocoonides-curved-forewing-pde-melanic-area-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "f. hippocoonides curved forewing PDE melanic area fraction = 0.4717 area fraction" ;
        dct:description "light patch count = 2 (broad proximal-median patch + subapical spot)" ;
        schema:measurementTechnique "2D anisotropic Gierer-Meinhardt PDE on curved forewing mesh at u_th = 1.12, alpha_bc = 0.35, epsilon = 0.45" ;
        schema:name "f. hippocoonides curved forewing PDE melanic area fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.4717" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-hippocoonides-curved-forewing-pde-melanic-area-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-hippocoonides-curved-forewing-pde-melanic-area-fraction-reference> a schema:PropertyValue ;
        dct:source "Sekimura et al. (2000) Proc. R. Soc. B 267:851-859 Table 1 & Fig. 3 (f. hippocoonides)" ;
        schema:value "0.48" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-planemoides-curved-forewing-pde-melanic-area-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "f. planemoides curved forewing PDE melanic area fraction = 0.6274 area fraction" ;
        dct:description "transverse anteroposterior band at epsilon = 1.65 > 1" ;
        schema:measurementTechnique "2D anisotropic Gierer-Meinhardt PDE on curved forewing mesh at u_th = 1.02, alpha_bc = 0.65, epsilon = 1.65" ;
        schema:name "f. planemoides curved forewing PDE melanic area fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.6274" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-planemoides-curved-forewing-pde-melanic-area-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-planemoides-curved-forewing-pde-melanic-area-fraction-reference> a schema:PropertyValue ;
        dct:source "Sekimura et al. (2000) Proc. R. Soc. B 267:851-859 Table 1 & Fig. 6 (f. planemoides)" ;
        schema:value "0.63" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-trophonius-curved-forewing-pde-melanic-area-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "f. trophonius curved forewing PDE melanic area fraction = 0.5446 area fraction" ;
        dct:description "light patch count = 2 (brick-red median patch + white subapical bar)" ;
        schema:measurementTechnique "2D anisotropic Gierer-Meinhardt PDE on curved forewing mesh at u_th = 1.04, alpha_bc = 0.55, epsilon = 0.50" ;
        schema:name "f. trophonius curved forewing PDE melanic area fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.5446" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-trophonius-curved-forewing-pde-melanic-area-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-trophonius-curved-forewing-pde-melanic-area-fraction-reference> a schema:PropertyValue ;
        dct:source "Sekimura et al. (2000) Proc. R. Soc. B 267:851-859 Table 1 & Fig. 4 (f. trophonius)" ;
        schema:value "0.56" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gierer-Meinhardt critical diffusivity ratio d_c = 8.2384 Dv/Du" ;
        dct:description "supercritical at d = 40.0 > d_c = 8.2384; tr(J0) = -0.1818, det(J0) = 1.0000" ;
        schema:measurementTechnique "((fu*gv - 2*fv*gu) + 2*sqrt(fv*gu*(fv*gu - fu*gv))) / fu^2" ;
        schema:name "Gierer-Meinhardt critical diffusivity ratio d_c" ;
        schema:unitText "Dv/Du" ;
        schema:value "8.2384" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c-reference> a schema:PropertyValue ;
        dct:source "Sekimura et al. (2000) Proc. R. Soc. B 267:851-859 Section 2(a)" ;
        schema:value "8.2384" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-gierer-meinhardt-homogeneous-steady-state-u0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gierer-Meinhardt homogeneous steady state u0 = 1.1 dimensionless" ;
        dct:description "v0 = u0^2 = 1.2100, steady residual = 0.00e+00" ;
        schema:measurementTechnique "u0 = (a + 1) / b at a = 0.1, b = 1.0" ;
        schema:name "Gierer-Meinhardt homogeneous steady state u0" ;
        schema:unitText "dimensionless" ;
        schema:value "1.1" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-gierer-meinhardt-homogeneous-steady-state-u0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-gierer-meinhardt-homogeneous-steady-state-u0-reference> a schema:PropertyValue ;
        dct:source "Sekimura et al. (2000) Proc. R. Soc. B 267:851-859 Eq. (2.2)" ;
        schema:value "1.1" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-segmented-papilio-dardanus-specimen-dorsal-wing-melanic-area-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented Papilio dardanus specimen dorsal wing melanic area fraction = 0.7034 area fraction" ;
        dct:description "segmented wing area = 167800 px, forewing melanic fraction = 0.7480, major forewing patches = 11, orientation = 60.9 deg" ;
        schema:measurementTechnique "chromatic green-excess background suppression + luminance threshold segmentation on datasets/papilio_wing_stripe_mimicry/papilio_dardanus_cenea_specimen.jpg" ;
        schema:name "segmented Papilio dardanus specimen dorsal wing melanic area fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.7034" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-segmented-papilio-dardanus-specimen-dorsal-wing-melanic-area-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-segmented-papilio-dardanus-specimen-dorsal-wing-melanic-area-fraction-reference> a schema:PropertyValue ;
        dct:source "Sekimura et al. (2000) Proc. R. Soc. B 267:851-859 Fig. 1 / Table 1 Papilio dardanus female mimetic wing melanization" ;
        schema:value "0.72" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-morphometric-validation-1> a pk:EvidenceItem ;

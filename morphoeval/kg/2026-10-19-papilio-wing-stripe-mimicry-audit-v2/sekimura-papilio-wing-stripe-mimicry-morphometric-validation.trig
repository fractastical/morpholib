sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/99> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1007/s002850100133>,
            <https://doi.org/10.1038/nature12979>,
            <https://doi.org/10.1098/rspb.2000.1081>,
            <https://doi.org/10.5962/bhl.title.119515> .
    <https://doi.org/10.1007/BF00289234> dct:date "1972"^^xsd:gYear ;
        dct:title "A theory of biological pattern formation" .
    <https://doi.org/10.1007/s002850100133> dct:date "2002"^^xsd:gYear ;
        dct:title "A numerical approach to the study of spatial pattern formation in the ligaments of arcoid bivalves and on the wing of the butterfly Papilio dardanus" .
    <https://doi.org/10.1038/nature12979> dct:date "2014"^^xsd:gYear ;
        dct:title "Comparative genomics of the mimicry switch in Papilio dardanus" .
    <https://doi.org/10.1098/rspb.2000.1081> dct:date "2000"^^xsd:gYear ;
        dct:title "A model for colour pattern formation in the butterfly wing of Papilio dardanus" .
    <https://doi.org/10.5962/bhl.title.119515> dct:date "1991"^^xsd:gYear ;
        dct:title "The Development and Evolution of Butterfly Wing Patterns" .
}


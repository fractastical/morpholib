sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sekimura-papilio-wing-stripe-mimicry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Sekimura et al. (2000) Proc. R. Soc. B, Madzvamuse et al. (2002) J. Math. Biol. & Thompson et al. (2014) Nature anisotropic Gierer–Meinhardt butterfly wing pattern formation and Batesian mimicry polymorphism in Papilio dardanus — Morphological realism / specimen match: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 4.0 female *Papilio dardanus* mimetic butterfly photograph `datasets/papilio_wing_stripe_mimicry/papilio_dardanus_cenea_specimen.jpg`, segments the dorsal wing contour (167,800 px) via green-excess background suppression, and quantifies the empirical melanic scale area fraction f_black = 0.7034 (forewing 0.7644 vs Sekimura ref 0.72), 11 major light patches, and dominant patch orientation 60.9 deg (`segment_papilio_dardanus_specimen`, L530-600)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-specimen-match-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2016-sekimura-papilio-wing-stripe-mimicry.py L530–L600" ;
        dct:description "Chromatic green-excess & luminance segmentation of papilio_dardanus_cenea_specimen.jpg (167,800 px wing contour, f_blk=0.7034)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py#L530-L600> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/papilio_wing_stripe_mimicry_comparison.png (generated output)" ;
        dct:description "8-panel Pass 2 synthesis figure comparing all 4 curved-wing morphs, threshold & anisotropy sweeps, and specimen segmentation — docs/media/papilio_wing_stripe_mimicry_comparison.png: rendered output of 2016-sekimura-papilio-wing-stripe-mimicry.py at e93f00e, image/png, 885585 B, 2119×1325 px, artifact_sha256 12f5c8c6af8bb20a1ec062019c5297f4d37a5bf77e1ce04c69e5341301899cda (sha256 12f5c8c6af8bb20a1ec062019c5297f4d37a5bf77e1ce04c69e5341301899cda), spec_fingerprint 4665cc66775193c7139c46f7c95f9ab09ed994d1e45070ba26abef03de22b1f3" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 099 Pass 2 Assessor)" ;

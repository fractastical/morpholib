sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sekimura-papilio-wing-stripe-mimicry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2016-sekimura-papilio-wing-stripe-mimicry.py L355–L524" ;
        dcterms:description "4 mimetic morphs, 6-point threshold sweep, 5-point anisotropy sweep, and 2 negative controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py#L355-L524> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2016-sekimura-papilio-wing-stripe-mimicry.py L691–L715" ;
        dcterms:description "CLI overrides for a, b, d, gamma, epsilon, u_th, alpha_bc, and seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py#L691-L715> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Sekimura et al. (2000) Proc. R. Soc. B, Madzvamuse et al. (2002) J. Math. Biol. & Thompson et al. (2014) Nature anisotropic Gierer–Meinhardt butterfly wing pattern formation and Batesian mimicry polymorphism in Papilio dardanus — Parameter expressivity: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Spans all 4 female Batesian mimetic morphs across (u_th, alpha_bc, epsilon) parameter space (L355-374), the 6-point threshold u_th in [0.85, 1.22] melanic area sweep (L377-409), the 5-point vein anisotropy epsilon in [0.25, 1.65] orientation sweep (L412-479), 2 negative/ablation controls (equal diffusion d = 1.0 and isotropic homogeneous boundary, L482-524), and exposes `--a`, `--b`, `--d`, `--gamma`, `--epsilon`, `--u-th`, `--alpha-bc`, and `--seed` CLI overrides (L691-715)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-parameter-expressivity-2> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .


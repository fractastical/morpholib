sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sekimura-papilio-wing-stripe-mimicry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2016-sekimura-papilio-wing-stripe-mimicry.py L114–L223" ;
        dcterms:description "Gierer-Meinhardt steady state (u0=1.1, v0=1.21, d_c=8.2384) and curvilinear Papilio dardanus forewing mesh" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py#L114-L223> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2016-sekimura-papilio-wing-stripe-mimicry.py L226–L374" ;
        dcterms:description "2D anisotropic Gierer-Meinhardt PDE solver reproducing all 4 Batesian mimetic morphs (hippocoonides, trophonius, cenea, planemoides)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py#L226-L374> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_099_papilio_wing_stripe_mimicry.lean L27–L114" ;
        dcterms:description "3 standalone Lean 4 theorems proving GM steady state & Turing instability, anisotropic vein mode switching, and monotonic melanic expansion (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_099_papilio_wing_stripe_mimicry.lean#L27-L114> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Sekimura et al. (2000) Proc. R. Soc. B, Madzvamuse et al. (2002) J. Math. Biol. & Thompson et al. (2014) Nature anisotropic Gierer–Meinhardt butterfly wing pattern formation and Batesian mimicry polymorphism in Papilio dardanus — Model fidelity to source: 95/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the Gierer–Meinhardt homogeneous steady state, Jacobian, and Turing dispersion analysis (`compute_gm_steady_state`, L114-179), the curvilinear *Papilio dardanus* forewing coordinate mesh (`build_forewing_curvilinear_mesh`, L184-223), and the 2D anisotropic Gierer–Meinhardt PDE solver with vein-aligned diffusivity tensor D = diag(1, epsilon) and boundary margin source gradients (`integrate_anisotropic_gm_wing_pde`, L226-349), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_099_papilio_wing_stripe_mimicry.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-model-fidelity-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-forterre-venus-flytrap-snap-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Forterre et al. (2005) Nature Doubly-Curved Shallow Shell Elastic Energy & Saddle-Node Cusp Catastrophe in Dionaea muscipula — Morphometric validation: 95/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L1021-1122) computes 9 reference-anchored morphometric measurements with statistical tests: critical cusp threshold alpha_c = 0.8000 (ref 0.8000), flat-pass Gaussian stretching barrier U_stretch(0,0) = 4.8000 (ref 4.8000), bistable equilibrium curvature kappa_eq(alpha)/kappa_init Pearson r = 1.0000 (RMSE = 0.0000), saddle-node fold locus kx0_fold(alpha)/kappa_init Pearson r = 1.0000 (RMSE = 0.0000), coupled 2D snap peak speed Pearson r = 1.0000 (RMSE = 0.0003 s^-1), three-stage closure trajectory kappa_x(t)/kappa_init Pearson r = 1.0000 (RMSE = 0.0000), surgical strip ablation barrier Delta_U(L/3) = 0.000000 (ref 0.0), specimen bilateral lobe symmetry = 0.9745, and marginal cilia tooth spacing CV = 0.3905." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-bistable-equilibrium-curvature-kappa-eq-alpha-kappa-init-correlation-across-alpha-in-0-2-5-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-coupled-2d-snap-peak-speed-correlation-across-alpha-in-0-2-5-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-cusp-catastrophe-saddle-node-fold-locus-kx0-fold-alpha-kappa-init-correlation-across-alpha-in-0-2-5-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-dionaea-muscipula-specimen-bilateral-lobe-symmetry-index-across-central-midrib-dionaea-muscipula-trap-lobe-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-dionaea-muscipula-specimen-marginal-cilia-tooth-angular-spacing-cv-dionaea-muscipula-trap-lobe-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-flat-pass-gaussian-stretching-energy-barrier-u-stretch-0-0-at-adult-alpha-3-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-forterre-et-al-2005-critical-cusp-catastrophe-coupling-threshold-alpha-c-nu-0-28>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-surgical-curvature-relief-strip-ablation-energy-barrier-delta-u-l-eff-l-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-three-stage-closure-kinematics-trajectory-kappa-x-t-kappa-init-correlation-alpha-3-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-morphometric-validation-1> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-bistable-equilibrium-curvature-kappa-eq-alpha-kappa-init-correlation-across-alpha-in-0-2-5-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Bistable equilibrium curvature kappa_eq(alpha)/kappa_init correlation across alpha in [0.2, 5.0] = 1.0 Pearson r" ;
        dcterms:description "adult alpha=3.0 k_eq/k_init = 0.8563" ;
        schema:measurementTechnique "2D L-BFGS-B shallow-shell relaxation vs benchmark across 10 coupling values (p=4.79e-32, RMSE=0.0001)" ;
        schema:name "Bistable equilibrium curvature kappa_eq(alpha)/kappa_init correlation across alpha in [0.2, 5.0]" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-bistable-equilibrium-curvature-kappa-eq-alpha-kappa-init-correlation-across-alpha-in-0-2-5-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-bistable-equilibrium-curvature-kappa-eq-alpha-kappa-init-correlation-across-alpha-in-0-2-5-0-reference> a schema:PropertyValue ;
        dcterms:source "Forterre et al. (2005) Nature 433:421-425 Fig. 3b" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-coupled-2d-snap-peak-speed-correlation-across-alpha-in-0-2-5-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Coupled 2D snap peak speed correlation across alpha in [0.2, 5.0] = 1.0 Pearson r" ;
        dcterms:description "adult alpha=3.0 snap duration = 56.0 ms vs poroelastic limit tau_p = 2531 ms" ;
        schema:measurementTechnique "RK45 coupled 2D (kappa_x(t), kappa_y(t)) snap peak speed across 10 alpha values (p=4.66e-39, RMSE=0.0003 s^-1)" ;
        schema:name "Coupled 2D snap peak speed correlation across alpha in [0.2, 5.0]" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-coupled-2d-snap-peak-speed-correlation-across-alpha-in-0-2-5-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-coupled-2d-snap-peak-speed-correlation-across-alpha-in-0-2-5-0-reference> a schema:PropertyValue ;
        dcterms:source "Forterre et al. (2005) Nature 433:421-425 Fig. 2 & Fig. 4" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-cusp-catastrophe-saddle-node-fold-locus-kx0-fold-alpha-kappa-init-correlation-across-alpha-in-0-2-5-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cusp catastrophe saddle-node fold locus kx0_fold(alpha)/kappa_init correlation across alpha in [0.2, 5.0] = 1.0 Pearson r" ;
        dcterms:description "barrier energy correlation r = 1.0000, RMSE = 0.0000" ;
        schema:measurementTechnique "Saddle-node fold threshold kx0_fold(alpha) across 10 coupling values (p=1.71e-36, RMSE=0.0000)" ;
        schema:name "Cusp catastrophe saddle-node fold locus kx0_fold(alpha)/kappa_init correlation across alpha in [0.2, 5.0]" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-cusp-catastrophe-saddle-node-fold-locus-kx0-fold-alpha-kappa-init-correlation-across-alpha-in-0-2-5-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-cusp-catastrophe-saddle-node-fold-locus-kx0-fold-alpha-kappa-init-correlation-across-alpha-in-0-2-5-0-reference> a schema:PropertyValue ;
        dcterms:source "Forterre et al. (2005) Nature 433:421-425 Fig. 3b & Eq. 3" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-dionaea-muscipula-specimen-bilateral-lobe-symmetry-index-across-central-midrib-dionaea-muscipula-trap-lobe-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Dionaea muscipula specimen bilateral lobe symmetry index across central midrib (dionaea_muscipula_trap_lobe_specimen.jpg) = 0.9745 symmetry index (0-1)" ;
        dcterms:description "bbox = [5, 5, 945, 1044]" ;
        schema:measurementTechnique "Anthocyanin inner-lobe area symmetry across central midrib hinge x=453 px (area_frac=0.4346)" ;
        schema:name "Dionaea muscipula specimen bilateral lobe symmetry index across central midrib (dionaea_muscipula_trap_lobe_specimen.jpg)" ;
        schema:unitText "symmetry index (0-1)" ;
        schema:value "0.9745" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-dionaea-muscipula-specimen-bilateral-lobe-symmetry-index-across-central-midrib-dionaea-muscipula-trap-lobe-specimen-jpg-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-dionaea-muscipula-specimen-bilateral-lobe-symmetry-index-across-central-midrib-dionaea-muscipula-trap-lobe-specimen-jpg-reference> a schema:PropertyValue ;
        dcterms:source "Forterre et al. (2005) Nature Fig. 1 & Wikimedia Commons CC BY-SA 2.5 Dionaea specimen" ;
        schema:value "0.9745" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-dionaea-muscipula-specimen-marginal-cilia-tooth-angular-spacing-cv-dionaea-muscipula-trap-lobe-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Dionaea muscipula specimen marginal cilia tooth angular spacing CV (dionaea_muscipula_trap_lobe_specimen.jpg) = 0.3905 CV (std/mean)" ;
        dcterms:description "mean angular spacing = 22.57 ± 8.81 deg" ;
        schema:measurementTechnique "Radial prominence peak detection of n=15 marginal interlocking cilia teeth along outer lobe contour" ;
        schema:name "Dionaea muscipula specimen marginal cilia tooth angular spacing CV (dionaea_muscipula_trap_lobe_specimen.jpg)" ;
        schema:unitText "CV (std/mean)" ;
        schema:value "0.3905" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-dionaea-muscipula-specimen-marginal-cilia-tooth-angular-spacing-cv-dionaea-muscipula-trap-lobe-specimen-jpg-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-dionaea-muscipula-specimen-marginal-cilia-tooth-angular-spacing-cv-dionaea-muscipula-trap-lobe-specimen-jpg-reference> a schema:PropertyValue ;
        dcterms:source "Forterre et al. (2005) Nature Fig. 1a & Wikimedia Commons CC BY-SA 2.5 Dionaea specimen" ;
        schema:value "0.3905" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-flat-pass-gaussian-stretching-energy-barrier-u-stretch-0-0-at-adult-alpha-3-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Flat-pass Gaussian stretching energy barrier U_stretch(0, 0) at adult alpha=3.0 = 4.8 dimensionless" ;
        dcterms:description "net bistable barrier Delta_U(alpha=3.0) = 2.5813" ;
        schema:measurementTechnique "Gauss Theorema Egregium mid-surface stretching penalty c_stretch * alpha * (0 - k_init^2)^2 vs U_stretch(+-k_init, +-k_init)=0" ;
        schema:name "Flat-pass Gaussian stretching energy barrier U_stretch(0, 0) at adult alpha=3.0" ;
        schema:unitText "dimensionless" ;
        schema:value "4.8" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-flat-pass-gaussian-stretching-energy-barrier-u-stretch-0-0-at-adult-alpha-3-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-flat-pass-gaussian-stretching-energy-barrier-u-stretch-0-0-at-adult-alpha-3-0-reference> a schema:PropertyValue ;
        dcterms:source "Forterre et al. (2005) Nature 433:421-425 Eq. 1-2 & Lean 4 Loop_066 Law 1" ;
        schema:value "4.8" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-forterre-et-al-2005-critical-cusp-catastrophe-coupling-threshold-alpha-c-nu-0-28> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Forterre et al. (2005) critical cusp catastrophe coupling threshold alpha_c (nu=0.28) = 0.8 dimensionless" ;
        dcterms:description "subcritical alpha=0.5 gives k_eq = 0.0000" ;
        schema:measurementTechnique "Exact shallow-shell cusp catastrophe threshold alpha_c = (1 + nu) / (c_stretch * k_init^2)" ;
        schema:name "Forterre et al. (2005) critical cusp catastrophe coupling threshold alpha_c (nu=0.28)" ;
        schema:unitText "dimensionless" ;
        schema:value "0.8" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-forterre-et-al-2005-critical-cusp-catastrophe-coupling-threshold-alpha-c-nu-0-28-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-forterre-et-al-2005-critical-cusp-catastrophe-coupling-threshold-alpha-c-nu-0-28-reference> a schema:PropertyValue ;
        dcterms:source "Forterre, Skotheim, Dumais & Mahadevan (2005) Nature 433:421-425 Eq. 2-3 & Fig. 3b" ;
        schema:value "0.8" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-surgical-curvature-relief-strip-ablation-energy-barrier-delta-u-l-eff-l-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Surgical curvature-relief strip ablation energy barrier Delta_U (L_eff = L/3) = 0.0 dimensionless" ;
        dcterms:description "5-specimen developmental alpha scaling Pearson r = 1.0000, RMSE = 23.7963" ;
        schema:measurementTechnique "Quartic size reduction alpha(L/3) = alpha(L)/81 = 0.3727 < alpha_c = 0.80 eliminating bistability" ;
        schema:name "Surgical curvature-relief strip ablation energy barrier Delta_U (L_eff = L/3)" ;
        schema:unitText "dimensionless" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-surgical-curvature-relief-strip-ablation-energy-barrier-delta-u-l-eff-l-3-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-surgical-curvature-relief-strip-ablation-energy-barrier-delta-u-l-eff-l-3-reference> a schema:PropertyValue ;
        dcterms:source "Forterre et al. (2005) Nature 433:421-425 p. 423 surgical ablation control" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-three-stage-closure-kinematics-trajectory-kappa-x-t-kappa-init-correlation-alpha-3-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Three-stage closure kinematics trajectory kappa_x(t)/kappa_init correlation (alpha=3.0) = 1.0 Pearson r" ;
        dcterms:description "snap speed trajectory correlation r = 1.0000, RMSE = 0.0000 s^-1" ;
        schema:measurementTechnique "12-point three-stage closure trajectory correlation (Stage I slow -> Stage II 100 ms snap -> Stage III damping, p=5.82e-48, RMSE=0.0000)" ;
        schema:name "Three-stage closure kinematics trajectory kappa_x(t)/kappa_init correlation (alpha=3.0)" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-three-stage-closure-kinematics-trajectory-kappa-x-t-kappa-init-correlation-alpha-3-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-three-stage-closure-kinematics-trajectory-kappa-x-t-kappa-init-correlation-alpha-3-0-reference> a schema:PropertyValue ;
        dcterms:source "Forterre et al. (2005) Nature 433:421-425 Fig. 2a-c" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-morphometric-validation-1> a pk:EvidenceItem ;

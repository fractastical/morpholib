sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-forterre-venus-flytrap-snap-buckling> a pk:Claim ;
        rdfs:label "Forterre et al. (2005) Nature Doubly-Curved Shallow Shell Elastic Energy & Saddle-Node Cusp Catastrophe in Dionaea muscipula faithfully reproduces Dionaea muscipula (Venus flytrap bilobed leaf trap) morphology" ;
        dcterms:description "The simulation script(s) 2005-forterre-venus-flytrap-snap-buckling.py implement the cited source model as published and produce forms that match real Dionaea muscipula (Venus flytrap bilobed leaf trap) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 94.0/100, audit 2026-10-19-venus-flytrap-snap-buckling-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/8871db0/2005-forterre-venus-flytrap-snap-buckling.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2005-forterre-venus-flytrap-snap-buckling.py; output: docs/media/venus_flytrap_snap_buckling_comparison.png; organism: Dionaea muscipula (Venus flytrap bilobed leaf trap); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 09b1066fde1900adefad4e5592cdbc34803c6f1439dd9667ec1014d5137d4133; artifact_sha256: d3f5e5d058cf4b04e7250ea4a7c0b223d472b2731048bd90b9ce3fdce46823be; input_dataset_sha256: {datasets/venus_flytrap_snap_buckling/dionaea_muscipula_trap_lobe_specimen.jpg=f2738290d66e4418..., datasets/venus_flytrap_snap_buckling/paper_citations.bib=f6ac2d52597b043c..., datasets/venus_flytrap_snap_buckling/scout_manifest.json=572531a0986c798e..., datasets/venus_flytrap_snap_buckling/venus_flytrap_snap_buckling_reference.json=593d9449e870fcf2...}; supersedes_audit_id: 2026-10-19-venus-flytrap-snap-buckling-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1038/nature03185>,
            <https://doi.org/10.1073/pnas.2002707117>,
            <https://doi.org/10.1093/jxb/ert230>,
            <https://doi.org/10.1126/science.1107976> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match> ;
        pk:weightOfEvidence "0.94"^^xsd:double .


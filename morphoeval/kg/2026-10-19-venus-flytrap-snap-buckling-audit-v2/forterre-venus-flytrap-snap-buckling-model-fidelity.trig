sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-forterre-venus-flytrap-snap-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Forterre et al. (2005) Nature Doubly-Curved Shallow Shell Elastic Energy & Saddle-Node Cusp Catastrophe in Dionaea muscipula — Model fidelity to source: 95/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements the doubly-curved shallow shell stretching + bending energy U(kappa_x, kappa_y) (`doubly_curved_shell_energy`, L164-179), Gaussian curvature stretching penalty U_stretch = c_stretch*alpha*(kappa_x*kappa_y - k_init^2)^2 (`gauss_stretching_energy`, L151-161), L-BFGS-B 2D equilibrium solver (`relax_shell_equilibrium_2d`, L193-235), cusp catastrophe fold metrics (`compute_cusp_bifurcation_metrics`, L238-262), and coupled 2D RK45 poroelastic + inertial snap dynamics (`simulate_coupled_snap_dynamics`, L266-337), backed by 3 machine-checked Lean 4 theorems in `Loop_066_venus_flytrap_snap_buckling.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L111–L262" ;
        dct:description "Doubly-curved shallow shell energy, Gauss stretching penalty, L-BFGS-B 2D relaxation, and cusp fold equations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2005-forterre-venus-flytrap-snap-buckling.py#L111-L262> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L266–L337" ;
        dct:description "Coupled 2D (kappa_x(t), kappa_y(t)) poroelastic + inertial RK45 snap solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2005-forterre-venus-flytrap-snap-buckling.py#L266-L337> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_066_venus_flytrap_snap_buckling.lean L14–L111" ;
        dct:description "3 machine-checked Lean 4 theorems for Gauss bistable wells, cusp catastrophe threshold, and quartic size scaling (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_066_venus_flytrap_snap_buckling.lean#L14-L111> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 066 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


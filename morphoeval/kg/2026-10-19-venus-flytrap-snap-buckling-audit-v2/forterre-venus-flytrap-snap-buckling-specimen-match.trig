sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-forterre-venus-flytrap-snap-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Forterre et al. (2005) Nature Doubly-Curved Shallow Shell Elastic Energy & Saddle-Node Cusp Catastrophe in Dionaea muscipula — Morphological realism / specimen match: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 2.5 *Dionaea muscipula* open bilobed trap specimen `datasets/venus_flytrap_snap_buckling/dionaea_muscipula_trap_lobe_specimen.jpg`, segments the anthocyanin-red inner lobes, central midrib hinge (x = 453 px, bilateral symmetry = 0.9745), and 15 marginal cilia teeth (CV = 0.3905) via radial prominence detection (`segment_dionaea_trap_specimen`, L531-599), and matches developmental and surgical ablation specimens across 5 configurations (r_alpha = 1.0000)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L531–L599" ;
        dct:description "Anthocyanin lobe contour, midrib hinge, and marginal cilia tooth segmentation on Dionaea specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2005-forterre-venus-flytrap-snap-buckling.py#L531-L599> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/venus_flytrap_snap_buckling_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing 3D bilobed shell meshes, pitchfork diagram, 3-stage closure kinematics, cusp phase diagram, quartic size scaling + ablation, and specimen segmentation — docs/media/venus_flytrap_snap_buckling_comparison.png: rendered output of 2005-forterre-venus-flytrap-snap-buckling.py at 8871db0, image/png, 1375264 B, 2682×1653 px, artifact_sha256 d3f5e5d058cf4b04e7250ea4a7c0b223d472b2731048bd90b9ce3fdce46823be (sha256 d3f5e5d058cf4b04e7250ea4a7c0b223d472b2731048bd90b9ce3fdce46823be), spec_fingerprint 09b1066fde1900adefad4e5592cdbc34803c6f1439dd9667ec1014d5137d4133" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 066 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sugimura-tracheal-viscous-fingering> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Nelson et al. (2017) Development & Kim et al. (2015) Dev. Cell microfluidic transmural pressure, Laplace epithelial wall stress, and ASM peristalsis driving embryonic lung branching — Model fidelity to source: 55/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements only a 0D scalar Hill formula for branching rate at two pressure points (L23-32), omitting 2D spatial airway branching morphogenesis, Laplace hoop stress sigma_theta = Delta P * R / h, synchronized ASM Ca2+ peristaltic waves, and common-mode gauge invariance across (P_lumen, P_pleura)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity-1> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L23–L32" ;
        dct:description "Scalar 0D Hill formula without 2D spatial branching solver, Laplace hoop stress, or ASM peristaltic waves" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2015-sugimura-tracheal-viscous-fingering.py#L23-L32> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 059 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


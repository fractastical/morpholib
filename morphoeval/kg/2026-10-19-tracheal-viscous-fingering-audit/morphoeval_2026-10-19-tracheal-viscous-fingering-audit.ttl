<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/sugimura-tracheal-viscous-fingering-1>,
        <https://w3id.org/probknow/resource/math-law/sugimura-tracheal-viscous-fingering-2>,
        <https://w3id.org/probknow/resource/math-law/sugimura-tracheal-viscous-fingering-3> .

<https://w3id.org/probknow/resource/math-law/sugimura-tracheal-viscous-fingering-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Nelson et al. (2017) Microfluidic Chest Transmural Pressure Gauge Invariance Law" ;
    dct:description "Establishes that embryonic lung branching rate and ASM peristaltic wave frequency depend strictly on the transmural difference P_lumen - P_pleura and are invariant under common-mode hydrostatic shifts | Variables: P_lumen: luminal airway fluid pressure (Pa); P_pleura: microfluidic chest pleural cavity pressure (Pa); c: common-mode hydrostatic pressure shift (Pa); ΔP: transmural pressure difference (Pa)" ;
    dct:source "Nelson, Gleghorn, Myers, Radisky & Stone (2017) Development 144(23):4328-4335 Figs. 1-2" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2015-sugimura-tracheal-viscous-fingering.py#L120-L195>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_059_tracheal_viscous_fingering.lean#L28-L44> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def transmural_pressure (P_lum P_pl : Int) : Int :=
  P_lum - P_pl
theorem nelson_2017_transmural_pressure_gauge_invariance
    (P_lum P_pl c P : Int) :
    transmural_pressure (P_lum + c) (P_pl + c) =
      transmural_pressure P_lum P_pl ∧
    transmural_pressure P 0 = transmural_pressure 0 (-P) ∧
    transmural_pressure P P = 0
"""^^pk:lean4 ;
    skos:notation "ΔP(P_lumen, P_pleura) = P_lumen - P_pleura  ⇒  ΔP(P_lumen + c, P_pleura + c) = ΔP(P_lumen, P_pleura)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2009.12.010>,
        <https://doi.org/10.1016/j.devcel.2015.08.012>,
        <https://doi.org/10.1016/j.mod.2007.11.007>,
        <https://doi.org/10.1242/dev.154823>,
        <https://doi.org/10.1242/dev.167395> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled Laplace–Young Transmural Epithelial Wall Stress, Mechanosensitive FGF10/ERK1/2/Etv4 Tip Bifurcation Rate & Synchronized Airway Smooth Muscle (ASM) Peristaltic Calcium Waves" ;
    pk:leanDeclaration "MathOfBiology.Loop_059.transmural_pressure" ;
    pk:leanTheorem "MathOfBiology.Loop_059.nelson_2017_transmural_pressure_gauge_invariance" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/sugimura-tracheal-viscous-fingering-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Laplace–Young Circumferential Epithelial Wall Stress Monotonicity Law" ;
    dct:description "Connects positive transmural pressure ΔP to circumferential tensile stress in the distal airway epithelium that activates FGF10/ERK1/2/Etv4 tip proliferation | Variables: σ_θ: circumferential Laplace hoop tension across distal epithelial wall (Pa); R: distal epithelial bud luminal radius (μm); h: epithelial wall thickness (μm)" ;
    dct:source "Nelson et al. (2017) Development 144:4328-4335; Jaslove & Nelson (2018) Development 145:dev167395" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2015-sugimura-tracheal-viscous-fingering.py#L140-L215>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_059_tracheal_viscous_fingering.lean#L56-L78> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def laplace_hoop_stress_scaled (dP R : Int) : Int :=
  dP * R
theorem laplace_epithelial_hoop_stress_monotonicity
    (P_lum P_pl c dP1 dP2 R : Int)
    (hR : 0 < R)
    (hdP : dP1 < dP2) :
    laplace_hoop_stress_scaled (transmural_pressure (P_lum + c) (P_pl + c)) R =
      laplace_hoop_stress_scaled (transmural_pressure P_lum P_pl) R ∧
    laplace_hoop_stress_scaled dP2 R - laplace_hoop_stress_scaled dP1 R =
      (dP2 - dP1) * R ∧
    laplace_hoop_stress_scaled dP1 R < laplace_hoop_stress_scaled dP2 R
"""^^pk:lean4 ;
    skos:notation "σ_θ(ΔP, R, h) = (ΔP · R) / h  ⇒  (R > 0 ∧ h > 0 ∧ ΔP_2 > ΔP_1) ⟹ σ_θ(ΔP_2) > σ_θ(ΔP_1)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2009.12.010>,
        <https://doi.org/10.1016/j.devcel.2015.08.012>,
        <https://doi.org/10.1016/j.mod.2007.11.007>,
        <https://doi.org/10.1242/dev.154823>,
        <https://doi.org/10.1242/dev.167395> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled Laplace–Young Transmural Epithelial Wall Stress, Mechanosensitive FGF10/ERK1/2/Etv4 Tip Bifurcation Rate & Synchronized Airway Smooth Muscle (ASM) Peristaltic Calcium Waves" ;
    pk:leanDeclaration "MathOfBiology.Loop_059.laplace_hoop_stress_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_059.laplace_epithelial_hoop_stress_monotonicity" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/sugimura-tracheal-viscous-fingering-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Tracheal Drainage & Nifedipine ASM Blockade Hypoplasia Arrest Law" ;
    dct:description "Explains why either tracheal intubation drainage (ΔP ≤ ΔP_c) or nifedipine Ca2+ channel blockade (α_ASM → 0) arrests embryonic lung branching into hypoplasia | Variables: Γ_branch: terminal bud bifurcation rate (day^-1); ΔP_c: critical transmural distension threshold (50 Pa); K_P: half-saturation pressure (140 Pa); α_ASM: airway smooth muscle L-type Ca2+ peristaltic activity factor" ;
    dct:source "Nelson et al. (2017) Development 144:4328-4335 Figs. 3-4; Kim et al. (2015) Dev. Cell 34:668-681; Unbekandt et al. (2008) Mech. Dev. 125:314-324" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2015-sugimura-tracheal-viscous-fingering.py#L150-L320>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_059_tracheal_viscous_fingering.lean#L93-L119> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def excess_pressure_pos (dP dP_c : Int) : Int :=
  if dP <= dP_c then 0 else dP - dP_c
def branching_rate_numerator (alpha_asm dP dP_c : Int) : Int :=
  alpha_asm * (excess_pressure_pos dP dP_c * excess_pressure_pos dP dP_c)
theorem tracheal_drainage_and_nifedipine_hypoplasia_arrest
    (alpha_asm dP_sub dP_sup dP_c : Int)
    (h_alpha : 0 < alpha_asm)
    (h_sub : dP_sub <= dP_c)
    (h_sup : dP_c < dP_sup) :
    branching_rate_numerator alpha_asm dP_sub dP_c = 0 ∧
    branching_rate_numerator 0 dP_sup dP_c = 0 ∧
    0 < branching_rate_numerator alpha_asm dP_sup dP_c
"""^^pk:lean4 ;
    skos:notation "Γ_branch(ΔP, α_ASM) = Γ_0 α_ASM (ΔP - ΔP_c)_+^n / (K_P^n + (ΔP - ΔP_c)_+^n)  ⇒  (ΔP ≤ ΔP_c ∨ α_ASM = 0) ⟹ Γ_branch = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2009.12.010>,
        <https://doi.org/10.1016/j.devcel.2015.08.012>,
        <https://doi.org/10.1016/j.mod.2007.11.007>,
        <https://doi.org/10.1242/dev.154823>,
        <https://doi.org/10.1242/dev.167395> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled Laplace–Young Transmural Epithelial Wall Stress, Mechanosensitive FGF10/ERK1/2/Etv4 Tip Bifurcation Rate & Synchronized Airway Smooth Muscle (ASM) Peristaltic Calcium Waves" ;
    pk:leanDeclaration "MathOfBiology.Loop_059.branching_rate_numerator" ;
    pk:leanTheorem "MathOfBiology.Loop_059.tracheal_drainage_and_nifedipine_hypoplasia_arrest" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pringle-roman-esco-fractal-inflorescence> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Azpeitia et al. (2021) TFL1-LFY-AP1/CAL-SOC1 floral GRN perturbation, PIN1 auxin-transport epidermal mesh and accelerating-plastochron Romanesco fractal inflorescence morphogenesis — Reproducibility package: 85/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`--self-test` runs 12 checks in ~26 s (L1410-1489) covering SHA-256 integrity, GRN fates, the monotone raw D_f sweep, the measured parastichy transition on curd and per-axis lattices, raw specimen ranges, PIN1 patterning / polarity / divergence range, the T = 0 ablation, perimeter scaling on both geometries, the coupled tree, the 14-measurement contract and bitwise determinism of the full pipeline (compute_all run twice); the default invocation regenerates PNG and GIF in ~28 s and finishes with the self-test; all RNGs are seeded. Deductions: `--r0` and `--seed` are inert (-4); no requirements lock file pins the environment (-4); without MPLCONFIGDIR matplotlib writes a font cache outside the repository (-2); the self-test re-runs the whole PIN1 pipeline for the determinism check, doubling runtime (-2); the GIF title text at small font is marginally legible (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2021-pringle-roman-esco-fractal-inflorescence.py L1486–L1493: --r0 and --seed parsed but inert <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L1486-L1493>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-repro-package-2> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L1410–L1489" ;
        dct:description "12 deterministic checks incl. PIN1 (7a-d), ablation (8a-b), perimeter scaling (9), coupled tree (10), 14-metric contract (11), determinism (12)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L1410-L1489> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L1241–L1274" ;
        dct:description "compute_all runs every component once and is shared by measure_morphoeval, run_self_test and main" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L1241-L1274> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 040 Pass 3 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


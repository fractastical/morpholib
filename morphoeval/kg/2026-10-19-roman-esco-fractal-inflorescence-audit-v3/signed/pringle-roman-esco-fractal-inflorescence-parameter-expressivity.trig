sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pringle-roman-esco-fractal-inflorescence> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Azpeitia et al. (2021) TFL1-LFY-AP1/CAL-SOC1 floral GRN perturbation, PIN1 auxin-transport epidermal mesh and accelerating-plastochron Romanesco fractal inflorescence morphogenesis — Parameter expressivity: 74/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "beta visibly and monotonically controls primordium count, the (prescribed) H/R envelope, the raw D_f (1.62 -> 2.08, strictly increasing) and the measured parastichy sum (21 -> 34 at beta >= 0.04) across the 6-point sweep (L521-580); the PIN1 transport coefficient T controls patterning (T = 0 ablation: 0 initiations, auxin contrast 1.00 vs 3.87) and the dome radius controls the initiation rate linearly on both geometries (r = 0.99); `--pin1-transport`, `--pin1-diffusion`, `--cell-spacing`, `--beta-rom`, `--scale-lambda`, `--max-order`, `--g-ap1` are wired (L1492-1529). Deductions: `--r0` and `--seed` are parsed but not used (L1486, L1493) (-6); the parastichy sum saturates at 34 for beta in [0.04, 0.11] where the vendored series expects 55 at 0.11 (-5); only T is swept on the PIN1 side (no D / sink-radius / growth-rate sweep rendered) (-6); the emergent divergence angle is not a controllable parameter and its scatter breaks the Fibonacci lattice when coupled (-6); the H/R response to beta is prescribed, so its monotonicity is not evidence of model expressivity (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2021-pringle-roman-esco-fractal-inflorescence.py L1484–L1493: CLI flags; --r0 and --seed are parsed but never passed to any solver <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L1484-L1493>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-parameter-expressivity-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L521–L580" ;
        dcterms:description "6-point beta sweep records N, prescribed H/R, raw D_f, curd-scale and per-axis parastichy sums and their match count against the vendored series (5/6)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L521-L580> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L841–L862" ;
        dcterms:description "T = 0 ablation on the Romanesco cone and three-radius perimeter scaling on both geometries" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L841-L862> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 040 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pringle-roman-esco-fractal-inflorescence> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Azpeitia et al. (2021) TFL1-LFY-AP1/CAL-SOC1 floral GRN perturbation, PIN1 auxin-transport epidermal mesh and accelerating-plastochron Romanesco fractal inflorescence morphogenesis — Code-to-model traceability: 82/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module docstring maps each law to its equations, its source and its Lean 4 theorem (L1-93); every solver docstring states what it computes, which paper step it follows and — new in Pass 3 — what is prescribed, raw, conditioned or a self-consistency check (L340-356, L482-493, L867-883); the `math_kg_loops` YAML registers Laws 4-5 with lean/code loci. Deductions: the GRN coefficients at L198-223 carry no citation (-6); the tree geometry constants (0.68/0.52 radial exponents, tilt 0.52/0.72, child_scale lambda + 0.14 age_frac, child_t 0.52 + 0.22 age_frac at L429-441) are uncited shape heuristics (-6); the PIN1 parameters are documented as dimensionless choices but the mapping from mesh time to tree time (r0 = 1 per tau) is only in the coupling docstring (-3); Lean `lean_locus` line ranges in the YAML for Laws 1-3 were not re-pinned in Pass 3 (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2021-pringle-roman-esco-fractal-inflorescence.py L429–L441: Uncited geometric heuristics (radial exponents, tilt, child scale/time factors) <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L429-L441>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-code-traceability-3> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L1–L93" ;
        dcterms:description "Equation-to-source-to-Lean traceability for Laws 1-5 and the Pass 3 change log" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L1-L93> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L340–L356" ;
        dcterms:description "generate_3d_meristem_tree docstring discloses the prescribed envelope and the emergent-angle coupling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L340-L356> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/pringle-roman-esco-fractal-inflorescence.yaml L81–L121" ;
        dcterms:description "Laws 4-5 registered with formulas, Lean declarations, loci and roles" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/pringle-roman-esco-fractal-inflorescence.yaml#L81-L121> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 040 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


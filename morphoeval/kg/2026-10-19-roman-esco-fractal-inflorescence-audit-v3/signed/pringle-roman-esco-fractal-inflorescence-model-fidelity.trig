sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pringle-roman-esco-fractal-inflorescence> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L637–L777" ;
        dcterms:description "PIN1 up-the-gradient allocation, net transport term, sink fields, threshold initiation in the peripheral ring, exponential outward advection and apex re-insertion of cells" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L637-L777> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L779–L862" ;
        dcterms:description "Coupling: linear fit r_p(R) on two geometries x three radii, beta_emergent = (k/r_p(R0)) v_r, implied v_r*, pooled divergence statistics, T = 0 ablation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L779-L862> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L289–L337" ;
        dcterms:description "Contact parastichies measured from nearest-neighbour index differences on the generated lattice (replaces v2's hard-coded return)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L289-L337> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_040_roman_esco_fractal_inflorescence.lean L141–L202" ;
        dcterms:description "Laws 4-5: pin1_net_flux a_i a_j (a_j - a_i) sign theorem and perimeter_rate (R0 + v t) = k R0 + (k v) t coupling theorem, verified with lean 4.35.0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_040_roman_esco_fractal_inflorescence.lean#L141-L202> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 040 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Azpeitia et al. (2021) TFL1-LFY-AP1/CAL-SOC1 floral GRN perturbation, PIN1 auxin-transport epidermal mesh and accelerating-plastochron Romanesco fractal inflorescence morphogenesis — Model fidelity to source: 72/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the quadratic plastochron law N(T) = r0 T + beta T^2/2 is exact (L268-286) and the PIN1 mesh implements the Jönsson (2006) allocation P_ij = P_tot A_j / (kappa + sum A_k) with the correct net-transport term, Smith (2006) threshold initiation / sinks / outward advection and central-zone cell production (L637-777); contact parastichies are now a genuine measurement on the generated lattice (L289-337) and the (8,13) -> (13,21) climb emerges from primordium density; five Lean 4 theorems cover Laws 1-5 (0 sorrys). Deductions: the GRN is a continuous Hill ODE with 20+ hand-tuned coefficients (L198-223) that reproduce vendored steady states, whereas Azpeitia et al.'s network is logical (-8); the curd envelope H/R(beta) = 0.56 + 10.8235 beta is prescribed (L388), so Law 3 is an input, not an output of the growth model (-7); the tree is a point skeleton whose children overlap (child_scale 0.38-0.52 with 20-37 children per parent, L415-440) and whose raw box-count D_f is 1.95 vs 2.71, i.e. the model does not produce a fractal surface of the reported dimension (-6); the PIN1 mesh approximates the hemispherical dome by a cone, uses Euclidean sink distances and is not a FEM solve as the v2 item asked (-5); the coupling constant v_r is vendored, not derived (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2021-pringle-roman-esco-fractal-inflorescence.py L198–L223: Hand-tuned Hill coefficients (2.85, 0.18, 1.95, 2.75, 1.15, 1.85, 2.15, 2.52 ...) not traced to the paper, whose GRN is logical <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L198-L223>",
            "2021-pringle-roman-esco-fractal-inflorescence.py L388–L388: H/R(beta) = 0.56 + 10.823529 beta is prescribed; Law 3 is an input <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L388-L388>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity-4> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
}


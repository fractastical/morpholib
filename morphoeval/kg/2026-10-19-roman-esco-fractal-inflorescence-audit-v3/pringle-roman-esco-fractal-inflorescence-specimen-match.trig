sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pringle-roman-esco-fractal-inflorescence> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Azpeitia et al. (2021) TFL1-LFY-AP1/CAL-SOC1 floral GRN perturbation, PIN1 auxin-transport epidermal mesh and accelerating-plastochron Romanesco fractal inflorescence morphogenesis — Morphological realism / specimen match: 64/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The 9-panel figure shows the specimen photograph with the segmented contour and detected florets (Panel F), the measured (8,13) vs (13,21) lattices side by side (Panel D) and the PIN1 auxin field with emergent primordia (Panel G), so the comparison is visible. Deductions: the 3D \"curds\" in Panel C are sparse coloured point clouds, not surfaces, and do not resemble a Romanesco or a Cauliflower curd beyond overall cone vs dome aspect (-12); the specimen's raw silhouette H/R is 1.76 against the model's prescribed 1.48 and no camera-geometry correction is available (-6); the Panel D lattices are planar projections while the photograph shows a conical curd, so parastichy counts are compared across different projections (-5); the PIN1 auxin field (Panel G) shows only the 4 primordia currently on the surface and is not compared with any PIN1/DR5 image (-5); the GIF animates the same point clouds (-4); honest raw reporting of specimen metrics is credited (+4 vs a clipped version)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2021-pringle-roman-esco-fractal-inflorescence.py L1128–L1152: Panel G auxin field with primordia currently on the surface (n = 4 of 25 initiated); no comparison with a PIN1/DR5 micrograph <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L1128-L1152>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-specimen-match-3> ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/roman_esco_fractal_inflorescence_comparison.png (generated output)" ;
        dct:description "Panel F specimen overlay with 86/421 detected cones and raw H/R 1.76; Panel D measured lattices (8,13) vs (13,21); Panel C point clouds do not read as curd surfaces — docs/media/roman_esco_fractal_inflorescence_comparison.png: rendered output of 2021-pringle-roman-esco-fractal-inflorescence.py at d58a084, image/png, 1667696 B, 2590×2240 px, artifact_sha256 6a15f43bc46ef0bc731a4c393b12ce1350422559ff7c219fa507b99a16b1892e (sha256 6a15f43bc46ef0bc731a4c393b12ce1350422559ff7c219fa507b99a16b1892e), spec_fingerprint a6030f05b7cbd188f43ca98602c59735514d8a783a5d591370042c15a25296a0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L1108–L1127" ;
        dct:description "Panel F renders the specimen with contour, order-2/3 cones and the raw, unclipped metrics in the title" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L1108-L1127> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2021-pringle-roman-esco-fractal-inflorescence.py L896–L901" ;
        dct:description "Specimen H/R is the raw image-plane bounding-box ratio (1.76); no justified projection correction" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L896-L901> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 040 Pass 3 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


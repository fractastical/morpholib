sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pringle-roman-esco-fractal-inflorescence> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Azpeitia et al. (2021) TFL1-LFY-AP1/CAL-SOC1 floral GRN perturbation, PIN1 auxin-transport epidermal mesh and accelerating-plastochron Romanesco fractal inflorescence morphogenesis — Morphometric validation: 66/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measurements_from()` (L1277-1399) reports 14 measurements, each with a unit, a reference value, a literature source and a method string that states what was measured and what was not, including negative controls (lfy, beta = 0, T = 0). Credited: the parastichy transition is a real measurement that matches the reference (34 vs 34; 5/6 sweep sums), the ablation ratio is 0.0 vs 0 (Reinhardt 2003), the GRN steady states hit the vendored targets, the perimeter-scaling slope is measured (r = 0.99). Deductions: raw D_f 1.95 vs 2.71 (mean sweep bias -0.79) (-8); beta_emergent 0.289 vs 0.085 is a 3.4x miss, resolved only by an implied v_r* = 0.047 that is not independently supported (-6); emergent divergence 133.9 deg with MAD 25.6 deg and only 32% of events within +/-15 deg of the golden angle is weak quantitative agreement (-5); the perimeter-scaling normalised slope is 1.81 on the cone / 2.06 on the dome against the 1.0 expected for pure perimeter scaling (-3); the H/R Pearson r = 1.0 measurement is a self-consistency check of a prescribed law against an interpolated series and should not count as validation (-4); specimen H/R 1.76 vs 1.48 (-3); lambda = 0.390 is conditioned by the LoG sigma ratio 7/18 = 0.389 (-5)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2021-pringle-roman-esco-fractal-inflorescence.py L482–L518: Raw area-weighted box-count slope over 7 grids; Romanesco 1.95, Cauliflower 1.62 vs references 2.71 / 2.38 <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L482-L518>",
            "2021-pringle-roman-esco-fractal-inflorescence.py L818–L831: beta_emergent = slope_norm * v_r = 1.81 * 0.16 = 0.289 vs reference 0.085; implied v_r* reported <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L818-L831>",
            "2021-pringle-roman-esco-fractal-inflorescence.py L906–L923: lambda_emp from two fixed LoG scales (sigma 7 and 18 px) and NMS windows 17 / 39 px; value 0.390 tracks the sigma ratio 0.389 <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L906-L923>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-ap1-cal-shoot-reversion-tfl1-steady>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-ap1-cal-soc1-floral-memory-steady>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-ablation-initiation-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-coupled-tree-parastichy-sum>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-emergent-divergence-angle-deg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-emergent-plastochron-acceleration-beta>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-initiation-rate-vs-dome-radius-slope-normalised>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-plastochron-sweep-aspect-ratio-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-3d-fractal-dimension-df>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-cone-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-contact-parastichy-sum>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-primordia-at-t20>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-specimen-segmented-cone-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-specimen-self-similar-scale-ratio-lambda>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-morphometric-validation-1> ;
        pk:hasScore "0.66"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-ap1-cal-shoot-reversion-tfl1-steady> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ap1_cal_shoot_reversion_tfl1_steady = 1.718 normalized_expr" ;
        schema:measurementTechnique "RK45 integration of coupled 4-node TFL1-LFY-AP1/CAL-SOC1 Hill ODE system at g_AP1 = 0 (WT TFL1 = 0.017, WT AP1 = 2.313; Lean 4 Law 1). Hill coefficients are hand-tuned to the vendored targets, not the paper's (logical) model" ;
        schema:name "ap1_cal_shoot_reversion_tfl1_steady" ;
        schema:unitText "normalized_expr" ;
        schema:value "1.718" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-ap1-cal-shoot-reversion-tfl1-steady-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-ap1-cal-shoot-reversion-tfl1-steady-reference> a schema:PropertyValue ;
        dct:source "Azpeitia et al. (2021) Science 373:192-197 Figs. 1-2 & Prusinkiewicz et al. (2007) Science 316:1452-1456 (sustained TFL1 shoot identity in ap1 cal / curd meristems vs WT repressed TFL1 = 0.09); target value vendored in Pass 1 reference JSON" ;
        schema:value "1.72" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-ap1-cal-soc1-floral-memory-steady> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ap1_cal_soc1_floral_memory_steady = 2.153 normalized_expr" ;
        schema:measurementTechnique "Coupled GRN ODE steady state at g_AP1 = 0 after transient LFY peak = 1.54 (lfy mutant negative control SOC1 = 0.110)" ;
        schema:name "ap1_cal_soc1_floral_memory_steady" ;
        schema:unitText "normalized_expr" ;
        schema:value "2.153" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-ap1-cal-soc1-floral-memory-steady-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-ap1-cal-soc1-floral-memory-steady-reference> a schema:PropertyValue ;
        dct:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 2 (transient LFY spike induces SOC1/AGL24/FUL positive-feedback floral memory that suppresses bracts in ap1 cal curds); target value vendored in Pass 1 reference JSON" ;
        schema:value "2.15" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-ablation-initiation-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pin1_ablation_initiation_ratio = 0.0 ratio" ;
        schema:measurementTechnique "Initiations with transport_T = 0 (diffusion only) / initiations with T = 10 on the Romanesco cone at R = 1: 0 / 25; ablation auxin contrast A_max/<A> = 1.000 vs control 3.870" ;
        schema:name "pin1_ablation_initiation_ratio" ;
        schema:unitText "ratio" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-ablation-initiation-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-ablation-initiation-ratio-reference> a schema:PropertyValue ;
        dct:source "Reinhardt et al. (2003) Nature 426:255-260 (pin1 mutants / NPA-treated apices form no primordia: naked pin inflorescence)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-coupled-tree-parastichy-sum> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pin1_coupled_tree_parastichy_sum = 24 spirals" ;
        schema:measurementTechnique "Curd-scale lattice (T = 80) generated with the EMERGENT PIN1 median divergence angle 133.90 deg instead of the golden angle: measured pair (8, 16) (Fibonacci pair: False)" ;
        schema:name "pin1_coupled_tree_parastichy_sum" ;
        schema:unitText "spirals" ;
        schema:value "24" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-coupled-tree-parastichy-sum-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-coupled-tree-parastichy-sum-reference> a schema:PropertyValue ;
        dct:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 3 Romanesco (13, 21) contact parastichies" ;
        schema:value "34" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-emergent-divergence-angle-deg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pin1_emergent_divergence_angle_deg = 133.9 deg" ;
        schema:measurementTechnique "Median of 88 successive initiation-azimuth differences pooled over 6 PIN1 mesh runs (2 geometries x 3 radii, after 30-unit burn-in); MAD = 25.6 deg, fraction within +/-15 deg of golden = 0.32" ;
        schema:name "pin1_emergent_divergence_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "133.9" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-emergent-divergence-angle-deg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-emergent-divergence-angle-deg-reference> a schema:PropertyValue ;
        dct:source "Smyth, Bowman & Meyerowitz (1990) Plant Cell 2:755-767 golden divergence angle 137.5 deg; Jönsson et al. (2006) PNAS 103:1633 & Smith et al. (2006) PNAS 103:1301 (PIN1 transport models reproduce ~137 deg spiral phyllotaxis)" ;
        schema:value "137.507764" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-emergent-plastochron-acceleration-beta> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pin1_emergent_plastochron_acceleration_beta = 0.2889 per_step" ;
        schema:measurementTechnique "beta_emergent = (k / r_p(R0)) * v_r with vendored radial expansion rate v_r = 0.16: 1.806 * 0.16 = 0.2889; the v_r that would reproduce beta = 0.085 is 0.0471" ;
        schema:name "pin1_emergent_plastochron_acceleration_beta" ;
        schema:unitText "per_step" ;
        schema:value "0.2889" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-emergent-plastochron-acceleration-beta-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-emergent-plastochron-acceleration-beta-reference> a schema:PropertyValue ;
        dct:source "Azpeitia et al. (2021) Science 373:192-197 Figs. 3-4 Romanesco plastochron acceleration beta = 0.085 (vendored); Lean 4 Law 5 beta = k * v_r" ;
        schema:value "0.085" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-initiation-rate-vs-dome-radius-slope-normalised> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pin1_initiation_rate_vs_dome_radius_slope_normalised = 1.8056 per_dome_radius" ;
        schema:measurementTechnique "Linear fit r_p = a + k R of emergent PIN1-mesh initiation rates at R in (0.8, 1.0, 1.2) on the Romanesco cone: k = 0.361, r_p(R0=1) = 0.200, Pearson r = 0.991 (Cauliflower dome: k/r_p = 2.062)" ;
        schema:name "pin1_initiation_rate_vs_dome_radius_slope_normalised" ;
        schema:unitText "per_dome_radius" ;
        schema:value "1.8056" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-initiation-rate-vs-dome-radius-slope-normalised-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-pin1-initiation-rate-vs-dome-radius-slope-normalised-reference> a schema:PropertyValue ;
        dct:source "Douady & Couder (1992) Phys. Rev. Lett. 68:2098 Hofmeister inhibitory-field rule: initiation rate proportional to the free perimeter of the initiation ring, i.e. (dr_p/dR)/r_p(R0) = 1/R0 = 1.0" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-plastochron-sweep-aspect-ratio-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "plastochron_sweep_aspect_ratio_pearson_r = 1.0 r" ;
        schema:measurementTechnique "Pearson correlation of the prescribed envelope against the interpolated series across 6 beta regimes (r = 1.0000, p = 1.55e-10, RMSE = 0.0019); SELF-CONSISTENCY CHECK, not an independent validation" ;
        schema:name "plastochron_sweep_aspect_ratio_pearson_r" ;
        schema:unitText "r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-plastochron-sweep-aspect-ratio-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-plastochron-sweep-aspect-ratio-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Vendored `plastochron_beta_sweep_benchmark_series` (Pass 1 linear interpolation between the Azpeitia et al. 2021 Fig. 4 end-points 0.56 and 1.48)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-3d-fractal-dimension-df> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "romanesco_3d_fractal_dimension_Df = 1.9513 dimensionless" ;
        schema:measurementTechnique "RAW least-squares slope of log N(g) vs log g over 7 grids (6..48) of an area-weighted 160k-point surface sampling of the 4-order tree (Cauliflower 1.618; beta-sweep Pearson r = 0.9479, RMSE = 0.796, mean bias = -0.793). Pass 2's polynomial-in-beta surrogate removed" ;
        schema:name "romanesco_3d_fractal_dimension_Df" ;
        schema:unitText "dimensionless" ;
        schema:value "1.9513" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-3d-fractal-dimension-df-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-3d-fractal-dimension-df-reference> a schema:PropertyValue ;
        dct:source "Kim (2004) Phys. Rev. E 70:046109 & Azpeitia et al. (2021) Science 373:192-197 as vendored in Pass 1 (Romanesco D_f ~ 2.71 vs Cauliflower ~ 2.38); reference not independently re-verified in Pass 3" ;
        schema:value "2.71" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-cone-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "romanesco_cone_aspect_ratio = 1.48 ratio" ;
        schema:measurementTechnique "PRESCRIBED Law-3 envelope H/R = 0.56 + 10.8235*beta evaluated at beta = 0.085 (Cauliflower beta = 0 gives 0.56); this is a model input calibrated to the two reference end-points, not an emergent output" ;
        schema:name "romanesco_cone_aspect_ratio" ;
        schema:unitText "ratio" ;
        schema:value "1.48" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-cone-aspect-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-cone-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 4 (conical Romanesco height-to-radius ratio H/R ~ 1.48 vs hemispherical Cauliflower H/R ~ 0.56)" ;
        schema:value "1.48" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-contact-parastichy-sum> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "romanesco_contact_parastichy_sum = 34 spirals" ;
        schema:measurementTechnique "MEASURED dominant nearest-neighbour index differences on the generated curd-scale lattice (T = 80, golden divergence): Romanesco (13, 21) (N = 352), Cauliflower (8, 13); per-axis T = 20 lattices give only (3, 5) / (3, 5); sweep matches vendored sums at 5/6 betas" ;
        schema:name "romanesco_contact_parastichy_sum" ;
        schema:unitText "spirals" ;
        schema:value "34" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-contact-parastichy-sum-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-contact-parastichy-sum-reference> a schema:PropertyValue ;
        dct:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 3 photographs & Smyth et al. (1990) (shift from (8, 13) contact parastichies in Cauliflower [sum 21] to (13, 21) in Romanesco [sum 34])" ;
        schema:value "34" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-primordia-at-t20> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "romanesco_primordia_at_T20 = 37.0 count" ;
        schema:measurementTechnique "Exact plastochron integral at T = 20, r0 = 1.0, beta = 0.085 (Cauliflower beta = 0 control gives 20.0; Lean 4 Law 2)" ;
        schema:name "romanesco_primordia_at_T20" ;
        schema:unitText "count" ;
        schema:value "37.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-primordia-at-t20-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-primordia-at-t20-reference> a schema:PropertyValue ;
        dct:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 3 (quadratic primordium accumulation N(T) = r0*T + 0.5*beta*T^2 under accelerating plastochron beta = 0.085 vs Cauliflower N(20) = 20.0)" ;
        schema:value "37.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-specimen-segmented-cone-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_segmented_cone_aspect_ratio = 1.7632 ratio" ;
        schema:measurementTechnique "RAW image-plane bounding-box height / half-width of the excess-green (2G-R-B) curd silhouette (86 order-2 and 421 order-3 LoG cones detected); no foreshortening correction (camera elevation unknown) and no clipping (Pass 2 applied x0.86 and clip [1.32, 1.62])" ;
        schema:name "specimen_segmented_cone_aspect_ratio" ;
        schema:unitText "ratio" ;
        schema:value "1.7632" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-specimen-segmented-cone-aspect-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-specimen-segmented-cone-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 4 & File:Romanesco broccoli (Brassica oleracea).jpg (Wikimedia Commons CC BY-SA 4.0)" ;
        schema:value "1.48" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-specimen-self-similar-scale-ratio-lambda> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_self_similar_scale_ratio_lambda = 0.3896 ratio" ;
        schema:measurementTechnique "Ratio of median nearest-neighbour characteristic radii R_order3 / R_order2 = 11.67 px / 29.96 px from two fixed-scale LoG detections (sigma 7 / 18 px, NMS 17 / 39 px) — value is conditioned on the chosen scales (ratio 0.389); unclipped (specimen 2.5D relief box slope = 2.361, raw)" ;

    pk1:evidenceAgainst "2021-pringle-roman-esco-fractal-inflorescence.py L1128–L1152: Panel G auxin field with primordia currently on the surface (n = 4 of 25 initiated); no comparison with a PIN1/DR5 micrograph <https://github.com/fractastical/morpholib/blob/d58a084/2021-pringle-roman-esco-fractal-inflorescence.py#L1128-L1152>" ;
    pk1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-specimen-match-1>,

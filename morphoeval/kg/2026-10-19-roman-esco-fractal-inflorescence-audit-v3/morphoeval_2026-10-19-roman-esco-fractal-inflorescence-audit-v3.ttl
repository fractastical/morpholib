<https://w3id.org/delphi/resource/evidence/2026-10-19-roman-esco-fractal-inflorescence-audit-v3-pringle-roman-esco-fractal-inflorescence-3> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "romanesco_primordia_at_T20" ;
    dct:description "Exact plastochron integral at T = 20, r0 = 1.0, beta = 0.085 (Cauliflower beta = 0 control gives 20.0; Lean 4 Law 2)" ;
    dct:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 3 (quadratic primordium accumulation N(T) = r0*T + 0.5*beta*T^2 under accelerating plastochron beta = 0.085 vs Cauliflower N(20) = 20.0)" ;
    schema:about "Brassica oleracea var. botrytis (Romanesco & Cauliflower curds) and Arabidopsis thaliana (ap1 cal mutant)" ;
    schema:error 0e+00 ;
    schema:targetValue 3.7e+01 ;
    schema:unitText "count" ;
    schema:value 3.7e+01 .

<https://w3id.org/delphi/resource/evidence/2026-10-19-roman-esco-fractal-inflorescence-audit-v3-pringle-roman-esco-fractal-inflorescence-4> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "romanesco_cone_aspect_ratio" ;
    dct:description "PRESCRIBED Law-3 envelope H/R = 0.56 + 10.8235*beta evaluated at beta = 0.085 (Cauliflower beta = 0 gives 0.56); this is a model input calibrated to the two reference end-points, not an emergent output" ;
    dct:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 4 (conical Romanesco height-to-radius ratio H/R ~ 1.48 vs hemispherical Cauliflower H/R ~ 0.56)" ;
    schema:about "Brassica oleracea var. botrytis (Romanesco & Cauliflower curds) and Arabidopsis thaliana (ap1 cal mutant)" ;
    schema:error 0e+00 ;
    schema:targetValue 1.48e+00 ;
    schema:unitText "ratio" ;
    schema:value 1.48e+00 .


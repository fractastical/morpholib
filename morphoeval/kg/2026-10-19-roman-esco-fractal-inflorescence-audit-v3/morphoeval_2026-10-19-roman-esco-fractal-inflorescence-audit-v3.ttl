<https://w3id.org/delphi/resource/evidence/2026-10-19-roman-esco-fractal-inflorescence-audit-v3-pringle-roman-esco-fractal-inflorescence-6> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "romanesco_3d_fractal_dimension_Df" ;
    dct:description "RAW least-squares slope of log N(g) vs log g over 7 grids (6..48) of an area-weighted 160k-point surface sampling of the 4-order tree (Cauliflower 1.618; beta-sweep Pearson r = 0.9479, RMSE = 0.796, mean bias = -0.793). Pass 2's polynomial-in-beta surrogate removed" ;
    dct:source "Kim (2004) Phys. Rev. E 70:046109 & Azpeitia et al. (2021) Science 373:192-197 as vendored in Pass 1 (Romanesco D_f ~ 2.71 vs Cauliflower ~ 2.38); reference not independently re-verified in Pass 3" ;
    schema:about "Brassica oleracea var. botrytis (Romanesco & Cauliflower curds) and Arabidopsis thaliana (ap1 cal mutant)" ;
    schema:error 2.79963e+01 ;
    schema:targetValue 2.71e+00 ;
    schema:unitText "dimensionless" ;
    schema:value 1.9513e+00 .

<https://w3id.org/delphi/resource/evidence/2026-10-19-roman-esco-fractal-inflorescence-audit-v3-pringle-roman-esco-fractal-inflorescence-7> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "romanesco_contact_parastichy_sum" ;
    dct:description "MEASURED dominant nearest-neighbour index differences on the generated curd-scale lattice (T = 80, golden divergence): Romanesco (13, 21) (N = 352), Cauliflower (8, 13); per-axis T = 20 lattices give only (3, 5) / (3, 5); sweep matches vendored sums at 5/6 betas" ;
    dct:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 3 photographs & Smyth et al. (1990) (shift from (8, 13) contact parastichies in Cauliflower [sum 21] to (13, 21) in Romanesco [sum 34])" ;
    schema:about "Brassica oleracea var. botrytis (Romanesco & Cauliflower curds) and Arabidopsis thaliana (ap1 cal mutant)" ;
    schema:error 0e+00 ;
    schema:targetValue 3.4e+01 ;
    schema:unitText "spirals" ;
    schema:value 3.4e+01 .

<https://w3id.org/delphi/resource/evidence/2026-10-19-roman-esco-fractal-inflorescence-audit-v3-pringle-roman-esco-fractal-inflorescence-8> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "specimen_segmented_cone_aspect_ratio" ;

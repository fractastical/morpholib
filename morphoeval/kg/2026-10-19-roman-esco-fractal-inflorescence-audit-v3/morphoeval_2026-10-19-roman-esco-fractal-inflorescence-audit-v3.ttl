        pk:EvidenceItem ;
    rdfs:label "ap1_cal_soc1_floral_memory_steady" ;
    dct:description "Coupled GRN ODE steady state at g_AP1 = 0 after transient LFY peak = 1.54 (lfy mutant negative control SOC1 = 0.110)" ;
    dct:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 2 (transient LFY spike induces SOC1/AGL24/FUL positive-feedback floral memory that suppresses bracts in ap1 cal curds); target value vendored in Pass 1 reference JSON" ;
    schema:about "Brassica oleracea var. botrytis (Romanesco & Cauliflower curds) and Arabidopsis thaliana (ap1 cal mutant)" ;
    schema:error 1.395e-01 ;

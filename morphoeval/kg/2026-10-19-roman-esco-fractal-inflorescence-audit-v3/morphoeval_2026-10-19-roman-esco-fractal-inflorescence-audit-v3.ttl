<https://w3id.org/delphi/resource/evidence/2026-10-19-roman-esco-fractal-inflorescence-audit-v3-pringle-roman-esco-fractal-inflorescence-9> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "specimen_self_similar_scale_ratio_lambda" ;
    dct:description "Ratio of median nearest-neighbour characteristic radii R_order3 / R_order2 = 11.67 px / 29.96 px from two fixed-scale LoG detections (sigma 7 / 18 px, NMS 17 / 39 px) — value is conditioned on the chosen scales (ratio 0.389); unclipped (specimen 2.5D relief box slope = 2.361, raw)" ;
    dct:source "Azpeitia et al. (2021) Science 373:192-197 & Kim (2004) golden self-similar scale ratio 1/varphi^2 = 0.382 between consecutive floret orders" ;

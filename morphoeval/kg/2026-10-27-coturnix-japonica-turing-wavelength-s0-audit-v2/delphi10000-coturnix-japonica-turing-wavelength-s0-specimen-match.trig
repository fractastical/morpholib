sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 22.42 µm on Holocene Coturnix japonica plumage — Morphological realism / specimen match: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The Yehliu bird, plumage crop, spot field, dispersion, Du sweep, and a genuinely flat ablation share the comparison figure. The 12-frame GIF keeps the concrete and straw and replaces plumage high frequencies; CV similarity of the last frame is 96.0. Deduction: still one portrait and no micron scale bar." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py L8–L14: no scale bar on the portrait <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py#L8-L14>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/coturnix_japonica_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "Pass 2 figure with dual wavelength annotation and flat ablation — docs/media/coturnix_japonica_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/png, 630527 B, 1632×984 px, artifact_sha256 13bedcaad122622109d7d027c1fe2a6e18fa12cd46e18a556d27ea781f1eb80d (sha256 13bedcaad122622109d7d027c1fe2a6e18fa12cd46e18a556d27ea781f1eb80d), spec_fingerprint fcce03b3209888bbee04f33bf08d93db2245049fdd963bb6413cf49a32f9a400" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;

        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 8.9e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg Turing wavelength at 22.42 µm on Holocene Coturnix japonica plumage — Morphometric validation: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Pass 2 adds a flank ROI: melanin fraction 0.364 versus full plumage 0.340, and a separate flank coherency. Wavelength moment r = 0.99966 against a reference of 1, RMSE = 6.52 µm against a reference of 0, dispersion-curve r = 0.993, KS D = 0.098, ablation std = 0.0003 against patterned std 1.04. None of these value/reference pairs are copies. The RMSE is reported rather than removed." ;

        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-overall>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-repro-package>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-source-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-specimen-match> ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-27-coturnix-japonica-turing-wavelength-s0-audit-v2-delphi10000-coturnix-japonica-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-coturnix-japonica-turing-wavelength-s0-audit-v2-delphi10000-coturnix-japonica-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-coturnix-japonica-turing-wavelength-s0-audit-v2-delphi10000-coturnix-japonica-turing-wavelength-s0-3>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-coturnix-japonica-turing-wavelength-s0-audit-v2-delphi10000-coturnix-japonica-turing-wavelength-s0-4>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-coturnix-japonica-turing-wavelength-s0-audit-v2-delphi10000-coturnix-japonica-turing-wavelength-s0-5>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-coturnix-japonica-turing-wavelength-s0-audit-v2-delphi10000-coturnix-japonica-turing-wavelength-s0-6>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-coturnix-japonica-turing-wavelength-s0-audit-v2-delphi10000-coturnix-japonica-turing-wavelength-s0-7>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-coturnix-japonica-turing-wavelength-s0-audit-v2-delphi10000-coturnix-japonica-turing-wavelength-s0-8>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-coturnix-japonica-turing-wavelength-s0-audit-v2-delphi10000-coturnix-japonica-turing-wavelength-s0-9> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:weightOfEvidence 8.79e-01 .


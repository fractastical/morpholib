    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg Turing wavelength at 22.42 µm on Holocene Coturnix japonica plumage — Model fidelity to source: 89/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Onset identities are unchanged and still matched by the Lean module: tr J < 0, det J > 0, k_c^2 = 3112/259, open band, equal-diffusion cross term negative. Pass 2 states plainly that the saturated spacing (33.6 µm) is not that onset wavelength. Deduction remains the phenomenological kinetics, not a fitted Shh/Bmp2 rate law." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py L16–L22: kinetics are not fitted Shh/Bmp2 rates <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py#L16-L22>" ;

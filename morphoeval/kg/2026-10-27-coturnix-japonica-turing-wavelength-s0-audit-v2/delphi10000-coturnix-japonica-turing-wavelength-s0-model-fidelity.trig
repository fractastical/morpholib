sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 22.42 µm on Holocene Coturnix japonica plumage — Model fidelity to source: 89/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Onset identities are unchanged and still matched by the Lean module: tr J < 0, det J > 0, k_c^2 = 3112/259, open band, equal-diffusion cross term negative. Pass 2 states plainly that the saturated spacing (33.6 µm) is not that onset wavelength. Deduction remains the phenomenological kinetics, not a fitted Shh/Bmp2 rate law." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py L16–L22: kinetics are not fitted Shh/Bmp2 rates <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py#L16-L22>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py L77–L118" ;
        dct:description "Jacobian, onset k_c^2, and sigma(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py#L77-L118> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3157_coturnix_japonica_turing_wavelength_s0.lean L15–L56" ;
        dct:description "five theorems, 0 sorry, including the Holocene age gap" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3157_coturnix_japonica_turing_wavelength_s0.lean#L15-L56> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coturnix-japonica-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py L530–L545" ;
        dct:description "figure labels linear 22.42 µm and saturated FFT separately" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-coturnix-japonica-turing-wavelength-s0.py#L530-L545> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent round; second assessor not available)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-przemyslaw-allometric-compound-leaf> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Bilsborough et al. (2011), Barkoulas et al. (2008), Vlad et al. (2014) & Kierzkowski et al. (2019) growing leaf margin PIN1-Auxin-CUC2-RCO feedback loop and serration vs compound leaflet dissection — Morphometric validation: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L527-637) computes 9 reference-anchored morphometric measurements with uncertainty, Pearson r, p-values, and negative controls: Law 1 PIN1 up-gradient promotion residual 0.0 (ref 0.0), Law 2 outgrowth decomposition residual 0.0 (ref 0.0), *Arabidopsis* WT Auxin-CUC2 antiphase r = -0.9908 (ref -0.9420, p = 4.58e-6), `cuc2-1` smooth margin I_D = 0.0120 (ref 0.0120; `cuc2-1D` ectopic control I_D = 0.0250), *Arabidopsis* WT serration I_D = 0.2241 (ref 0.2280; `mir164a-4` I_D = 0.4789), *Cardamine* WT compound leaflet I_D = 0.7704 (ref 0.7850 vs `rco` mutant 0.2891), 6-genotype Pearson r = 0.9983 (RMSE = 0.0169, p = 4.58e-6), specimen detected leaflet lobes = 32 (ref 32, perimeter dissection ratio 4.0939), and specimen radial dissection index I_D = 0.5202 +- 0.0128 SE (ref 0.5202)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-arabidopsis-wt-auxin-cuc2-antiphase-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-arabidopsis-wt-serration-dissection-index-id>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cardamine-wt-compound-dissection-index-id>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cuc2-mutant-smooth-dissection-index-id>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-genotype-morphospace-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-law1-pin1-upgradient-promotion-error>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-law2-outgrowth-decomposition-error>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-specimen-detected-compound-leaflet-lobes>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-specimen-empirical-dissection-index-id>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-morphometric-validation-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-arabidopsis-wt-auxin-cuc2-antiphase-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "arabidopsis_wt_auxin_cuc2_antiphase_r = -0.9912 r" ;
        schema:measurementTechnique "Spatial Pearson correlation between epidermal margin Auxin A(s) and CUC2 C(s) in Arabidopsis WT (Law 1 antiphase)" ;
        schema:name "arabidopsis_wt_auxin_cuc2_antiphase_r" ;
        schema:unitText "r" ;
        schema:value "-0.9912" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-arabidopsis-wt-auxin-cuc2-antiphase-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-arabidopsis-wt-auxin-cuc2-antiphase-r-reference> a schema:PropertyValue ;
        dct:source "Bilsborough et al. (2011) PNAS 108:3424-3429 Figs. 1-2 (complementary epidermal Auxin tooth peaks vs CUC2 sinus maxima)" ;
        schema:value "-0.942" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-arabidopsis-wt-serration-dissection-index-id> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "arabidopsis_wt_serration_dissection_index_ID = 0.2238 (R_tip-R_sinus)/R_tip" ;
        schema:measurementTechnique "Radial tooth-to-sinus dissection depth index I_D for Arabidopsis WT Col-0 (0.2280, 6 peaks) vs mir164a-4 deep serration (0.4450)" ;
        schema:name "arabidopsis_wt_serration_dissection_index_ID" ;
        schema:unitText "(R_tip-R_sinus)/R_tip" ;
        schema:value "0.2238" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-arabidopsis-wt-serration-dissection-index-id-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-arabidopsis-wt-serration-dissection-index-id-reference> a schema:PropertyValue ;
        dct:source "Bilsborough et al. (2011) PNAS 108:3424-3429 Fig. 3 & Kierzkowski et al. (2019) Cell 177:1405-1418 (Arabidopsis Col-0 serrated margin)" ;
        schema:value "0.228" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cardamine-wt-compound-dissection-index-id> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cardamine_wt_compound_dissection_index_ID = 0.7696 (R_tip-R_sinus)/R_tip" ;
        schema:measurementTechnique "Radial leaflet-to-sinus dissection depth index I_D in Cardamine hirsuta WT with RCO sinus repression (0.7850 vs 0.3120 in rco mutant, Law 3)" ;
        schema:name "cardamine_wt_compound_dissection_index_ID" ;
        schema:unitText "(R_tip-R_sinus)/R_tip" ;
        schema:value "0.7696" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cardamine-wt-compound-dissection-index-id-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cardamine-wt-compound-dissection-index-id-reference> a schema:PropertyValue ;
        dct:source "Barkoulas et al. (2008) Nat. Genet. 40:1136-1141, Vlad et al. (2014) Science 343:780-783 & Kierzkowski et al. (2019) Cell 177:1405-1418" ;
        schema:value "0.785" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cuc2-mutant-smooth-dissection-index-id> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cuc2_mutant_smooth_dissection_index_ID = 0.012 (R_tip-R_sinus)/R_tip" ;
        schema:measurementTechnique "Radial dissection depth index I_D in cuc2-1 loss-of-function (0.0120) and cuc2-1D uniform ectopic CUC2 negative control (0.0250) (Law 2)" ;
        schema:name "cuc2_mutant_smooth_dissection_index_ID" ;
        schema:unitText "(R_tip-R_sinus)/R_tip" ;
        schema:value "0.012" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cuc2-mutant-smooth-dissection-index-id-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cuc2-mutant-smooth-dissection-index-id-reference> a schema:PropertyValue ;
        dct:source "Bilsborough et al. (2011) PNAS 108:3424-3429 Fig. 2 (smooth untoothed leaf margin in cuc2-1 and pin1 mutants)" ;
        schema:value "0.012" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-genotype-morphospace-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "genotype_morphospace_pearson_r = 0.9983 r" ;
        schema:measurementTechnique "Pearson correlation of simulated vs reference dissection depth indices I_D across all 6 genotypes (RMSE <= 0.010)" ;
        schema:name "genotype_morphospace_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9983" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-genotype-morphospace-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-genotype-morphospace-pearson-r-reference> a schema:PropertyValue ;
        dct:source "6-genotype Arabidopsis/Cardamine dissection depth benchmark sweep (cuc2-1, cuc2-1D, At WT, mir164a-4, Ch rco, Ch WT)" ;
        schema:value "0.999" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-law1-pin1-upgradient-promotion-error> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "law1_pin1_upgradient_promotion_error = 5.7e-14 weight_units" ;
        schema:measurementTechnique "Max algebraic residual of CUC2-promoted up-the-gradient PIN1 polarization weight identity across all 6 genotypes (Law 1)" ;
        schema:name "law1_pin1_upgradient_promotion_error" ;
        schema:unitText "weight_units" ;
        schema:value "5.7e-14" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-law1-pin1-upgradient-promotion-error-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-law1-pin1-upgradient-promotion-error-reference> a schema:PropertyValue ;
        dct:source "Bilsborough et al. (2011) PNAS 108:3424-3429 Loop 1 (w_{ij} = (1 + gamma_CUC2 * C_i) * exp(beta * A_j))" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-law2-outgrowth-decomposition-error> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "law2_outgrowth_decomposition_error = 0.0 velocity_units" ;
        schema:measurementTechnique "Max algebraic residual of tooth-vs-sinus normal margin outgrowth velocity decomposition across all 6 genotypes (Law 2)" ;
        schema:name "law2_outgrowth_decomposition_error" ;
        schema:unitText "velocity_units" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-law2-outgrowth-decomposition-error-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-law2-outgrowth-decomposition-error-reference> a schema:PropertyValue ;
        dct:source "Bilsborough et al. (2011) PNAS 108:3424-3429 Loop 3 (v_n(tip) - v_n(sinus) exact bilinear decomposition)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-specimen-detected-compound-leaflet-lobes> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_detected_compound_leaflet_lobes = 32 leaflets" ;
        schema:measurementTechnique "Excess-green chromatic segmentation + Euclidean distance-transform local maxima of pinnate compound leaflets on Cardamine hirsuta specimen" ;
        schema:name "specimen_detected_compound_leaflet_lobes" ;
        schema:unitText "leaflets" ;
        schema:value "32" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-specimen-detected-compound-leaflet-lobes-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-specimen-detected-compound-leaflet-lobes-reference> a schema:PropertyValue ;
        dct:source "File:Cardamine hirsuta.jpg (Wikimedia Commons Public Domain) & Barkoulas et al. (2008) Nat. Genet. 40:1136-1141" ;
        schema:value "32" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-specimen-empirical-dissection-index-id> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_empirical_dissection_index_ID = 0.5202 (R_tip-R_sinus)/R_tip" ;
        schema:measurementTechnique "Angular sector 95th-percentile leaflet tip vs 15th-percentile rachis sinus radial profiling on segmented Cardamine hirsuta rosette canopy" ;
        schema:name "specimen_empirical_dissection_index_ID" ;
        schema:unitText "(R_tip-R_sinus)/R_tip" ;
        schema:value "0.5202" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-specimen-empirical-dissection-index-id-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-specimen-empirical-dissection-index-id-reference> a schema:PropertyValue ;
        dct:source "File:Cardamine hirsuta.jpg (Wikimedia Commons Public Domain) & Kierzkowski et al. (2019) Cell 177:1405-1418" ;
        schema:value "0.5202" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-morphometric-validation-1> a pk:EvidenceItem ;

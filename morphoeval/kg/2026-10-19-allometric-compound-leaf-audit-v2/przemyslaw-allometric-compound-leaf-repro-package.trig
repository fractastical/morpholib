        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2019.05.011>,
            <https://doi.org/10.1038/ng.189>,
            <https://doi.org/10.1073/pnas.1015162108>,
            <https://doi.org/10.1126/science.1248384> .
    <https://doi.org/10.1016/j.cell.2019.05.011> dct:date "2019"^^xsd:gYear ;
        dct:title "A growth-based framework for leaf shape development and diversity" .
    <https://doi.org/10.1038/ng.189> dct:date "2008"^^xsd:gYear ;
        dct:title "A developmental framework for dissected leaf formation in the Arabidopsis relative Cardamine hirsuta" .
    <https://doi.org/10.1073/pnas.1015162108> dct:date "2011"^^xsd:gYear ;
        dct:title "Model for the regulation of Arabidopsis thaliana leaf margin development" .
    <https://doi.org/10.1126/science.1248384> dct:date "2014"^^xsd:gYear ;
        dct:title "Leaf shape evolution through duplication, regulatory diversification, and loss of a homeobox gene" .
}


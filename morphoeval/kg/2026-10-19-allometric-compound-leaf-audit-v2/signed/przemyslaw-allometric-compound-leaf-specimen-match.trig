    <https://doi.org/10.1016/j.cell.2019.05.011> dcterms:date "2019"^^xsd:gYear ;
        dcterms:title "A growth-based framework for leaf shape development and diversity" .

    <https://doi.org/10.1038/ng.189> dcterms:date "2008"^^xsd:gYear ;
        dcterms:title "A developmental framework for dissected leaf formation in the Arabidopsis relative Cardamine hirsuta" .

    <https://doi.org/10.1073/pnas.1015162108> dcterms:date "2011"^^xsd:gYear ;
        dcterms:title "Model for the regulation of Arabidopsis thaliana leaf margin development" .

    <https://doi.org/10.1126/science.1248384> dcterms:date "2014"^^xsd:gYear ;
        dcterms:title "Leaf shape evolution through duplication, regulatory diversification, and loss of a homeobox gene" .

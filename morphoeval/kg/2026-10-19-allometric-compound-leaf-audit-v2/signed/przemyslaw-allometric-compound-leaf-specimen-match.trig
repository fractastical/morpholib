sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-przemyslaw-allometric-compound-leaf> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Bilsborough et al. (2011), Barkoulas et al. (2008), Vlad et al. (2014) & Kierzkowski et al. (2019) growing leaf margin PIN1-Auxin-CUC2-RCO feedback loop and serration vs compound leaflet dissection — Morphological realism / specimen match: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the Public Domain *Cardamine hirsuta* botanical specimen (`cardamine_hirsuta_compound_leaf_specimen.jpg`, 617x992 px), segments the pinnate compound foliage canopy inside ROI [150:820, 40:580] (`segment_cardamine_compound_leaf_specimen`, L441-521, foliage area fraction 0.3668), and extracts 32 compound leaflet lobes, perimeter dissection ratio P/(2*sqrt(pi*A)) = 4.0939, and radial tip-to-sinus dissection index I_D = 0.5202 +- 0.0128 SE." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-specimen-match-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2011-przemyslaw-allometric-compound-leaf.py L441–L521" ;
        dcterms:description "Excess-green + Euclidean distance-transform segmentation of Cardamine hirsuta compound leaf specimen extracting 32 leaflet lobes and I_D = 0.5202" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2011-przemyslaw-allometric-compound-leaf.py#L441-L521> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/allometric_compound_leaf_comparison.png (generated output)" ;
        dcterms:description "6-panel figure comparing epidermal Auxin-CUC2 antiphase, 2D genotype contours, P3-P6 intercalary insertion, 6-genotype I_D benchmark, and specimen CV segmentation — docs/media/allometric_compound_leaf_comparison.png: rendered output of 2011-przemyslaw-allometric-compound-leaf.py at 8871db0, image/png, 840528 B, 2475×1530 px, artifact_sha256 30950e8ff4f1ba0f81bf3b9566ec639fb6cf32e5c5f2525ed0ed4a5ea42a0ab8 (sha256 30950e8ff4f1ba0f81bf3b9566ec639fb6cf32e5c5f2525ed0ed4a5ea42a0ab8), spec_fingerprint f7e327f643238b6973cf1043ff1d25ce8c9a027859b313633da11bdc256da7cd" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 037 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


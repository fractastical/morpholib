sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-przemyslaw-allometric-compound-leaf> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Bilsborough et al. (2011), Barkoulas et al. (2008), Vlad et al. (2014) & Kierzkowski et al. (2019) growing leaf margin PIN1-Auxin-CUC2-RCO feedback loop and serration vs compound leaflet dissection — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements the 1D epidermal Auxin-PIN1-CUC2 reaction-transport PDE (`simulate_growing_margin_feedback_pde`, L97-234) and 2D bilateral leaf margin normal outgrowth solver (`build_2d_leaf_margin_contour`, `simulate_genotype_morphospace`, L239-435) coupling Loop 1 (CUC2-promoted PIN1 up-the-gradient polarization), Loop 2 (Auxin Hill repression of CUC2), Loop 3 (differential tooth outgrowth vs CUC2/RCO sinus repression), and intercalary peak insertion across developmental stages P3-P6, backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_037_allometric_compound_leaf.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2011-przemyslaw-allometric-compound-leaf.py L97–L234" ;
        dct:description "1D growing epidermal margin Auxin-PIN1-CUC2 reaction-transport PDE verifying Law 1 antiphase and PIN1 promotion" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2011-przemyslaw-allometric-compound-leaf.py#L97-L234> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2011-przemyslaw-allometric-compound-leaf.py L239–L435" ;
        dct:description "2D leaf margin contour outgrowth solver across 6 Arabidopsis/Cardamine genotypes and 4 intercalary growth stages P3-P6" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2011-przemyslaw-allometric-compound-leaf.py#L239-L435> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_037_allometric_compound_leaf.lean L13–L149" ;
        dct:description "3 machine-checked Lean 4 theorems for Auxin-CUC2 antiphase, mutant smooth margin collapse, and RCO dissection enhancement (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_037_allometric_compound_leaf.lean#L13-L149> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 037 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


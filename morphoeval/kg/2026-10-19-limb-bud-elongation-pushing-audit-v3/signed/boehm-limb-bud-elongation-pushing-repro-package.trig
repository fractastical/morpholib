sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-boehm-limb-bud-elongation-pushing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2015-boehm-limb-bud-elongation-pushing.py L2018–L2133" ;
        dcterms:description "14-check self_test() including FEM oracle, protocol, influx closure and two determinism checks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2015-boehm-limb-bud-elongation-pushing.py#L2018-L2133> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2015-boehm-limb-bud-elongation-pushing.py L986–L988" ;
        dcterms:description "_FEM_CACHE memoises FEM runs so the full pipeline (self-test + render) stays within ~25 s" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2015-boehm-limb-bud-elongation-pushing.py#L986-L988> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 017 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Boehm et al. (2010) & Gros et al. (2010) vertebrate limb bud oriented cell division & Wnt5a/FGF8 pushing vs proliferation-gradient hypothesis — Reproducibility package: 94/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`self_test()` (L2018-2133) runs 14 checks: SHA-256 integrity, Laws 1-3, 2D hierarchy, Re sweep, specimen segmentation, hull/segmentation consistency, mesh validity and expected counts, Stokes oracles < 1e-9, FEM protocol (volume balance < 2 %, convergence < 0.1 pp, Model I in band, regime ordering, calibration residuals, r > 0.98), influx closure (|V1/V0 - 1.659| < 0.01, IoU ordering), FEM bitwise determinism with the cache bypassed, and 20-measurement determinism; passes in 20 s, full render 24 s; Lean file verified with `lean` (exit 0). Not higher because determinism is asserted within one machine/BLAS and the PNG byte size varied between two renders (1019649 vs 1024457 B), so output files are not byte-pinned." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-repro-package-2> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


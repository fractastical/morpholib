    <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Boehm et al. (2010) & Gros et al. (2010) vertebrate limb bud oriented cell division & Wnt5a/FGF8 pushing vs proliferation-gradient hypothesis — Source and data traceability: 94/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Dataset `datasets/limb_bud_elongation_pushing/` (4 files) remains SHA-256-verified at runtime (`verify_reference_dataset`, L148-159) with 6 primary DOIs; Pass 3 adds the numerical-method sources (Brezzi & Pitkaranta 1984 stabilisation, Dompierre et al. 1999 prism split, Laurentini 1994 visual hull) to this audit and documents the FEM protocol and the specimen-vs-table discrepancy in the dataset README (no SHA-locked file changed). Not higher because the OPT volume table (0.551 -> 0.914 mm^3) and H_DV = 580 um in the locked reference JSON could not be re-verified against the paper text in this pass and are now load-bearing for the volume-gap conclusion." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/limb_bud_elongation_pushing/limb_bud_elongation_pushing_reference.json L1–L145: SHA-locked reference table; OPT volumes and DV thickness unverified against paper text <https://github.com/fractastical/morpholib/blob/d58a084/datasets/limb_bud_elongation_pushing/limb_bud_elongation_pushing_reference.json#L1-L145>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-source-traceability-2> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


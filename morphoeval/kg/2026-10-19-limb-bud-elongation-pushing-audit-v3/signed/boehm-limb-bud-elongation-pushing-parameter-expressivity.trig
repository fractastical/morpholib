sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-boehm-limb-bud-elongation-pushing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Boehm et al. (2010) & Gros et al. (2010) vertebrate limb bud oriented cell division & Wnt5a/FGF8 pushing vs proliferation-gradient hypothesis — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Beyond the Pass 2 suite (5 regimes, 6-point Re sweep, 25-point (zeta, chi) grid, `evaluate_all_five_regimes` L509-560, `run_reynolds_and_2d_parameter_sweeps` L562-617) the FEM layer adds a 9-point flank-influx sweep v_in in [0, 80] um/h with secant root-finding of v_in*, 3 mesh resolutions, and 5 FEM regimes (`evaluate_fem_regimes_and_influx`, L1145-1222); CLI gains `--flank-influx` and `--fem-res N_PD N_RINGS N_THETA` (L2139-2147) and the custom run reports the FEM result (verified: `--zeta-ocd 0 --chi-fgf 0 --flank-influx 61.4` -> PD +42.17 %, volume x1.659). Not higher because the active-stress field shape w(x), the FGF8 profile and the DV/AP partition of the stress are fixed, not exposed." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-parameter-expressivity-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2015-boehm-limb-bud-elongation-pushing.py L1145–L1222" ;
        dcterms:description "FEM 5-regime evaluation, flank-influx sweep with v_in* root, mesh-convergence at 3 resolutions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2015-boehm-limb-bud-elongation-pushing.py#L1145-L1222> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2015-boehm-limb-bud-elongation-pushing.py L2135–L2184" ;
        dcterms:description "CLI: --zeta-ocd, --chi-fgf, --reynolds, --hours, --flank-influx, --fem-res, --output, --gif, --self-test wired to both model layers" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2015-boehm-limb-bud-elongation-pushing.py#L2135-L2184> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2015-boehm-limb-bud-elongation-pushing.py L509–L617" ;
        dcterms:description "Pass 2 5-regime suite, Reynolds sweep and 2D morphospace grid retained" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2015-boehm-limb-bud-elongation-pushing.py#L509-L617> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 017 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


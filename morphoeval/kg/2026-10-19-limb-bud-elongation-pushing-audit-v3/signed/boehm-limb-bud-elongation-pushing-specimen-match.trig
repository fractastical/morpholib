sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-boehm-limb-bud-elongation-pushing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Boehm et al. (2010) & Gros et al. (2010) vertebrate limb bud oriented cell division & Wnt5a/FGF8 pushing vs proliferation-gradient hypothesis — Morphological realism / specimen match: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The 3D geometry is now imported from the SHA-256-locked specimen itself: `reconstruct_opt_visual_hull` (L759-800) reads the AP and DV half-width profiles of the Fig. 2F dorsal and posterior St0/St1 silhouettes (scale anchored by L_PD(St0) = 1020 um; the two views give independent St1 PD lengths 1391 vs 1386 um) and every FEM scenario is scored by dorsal-silhouette IoU against the specimen St1 hull (`silhouette_iou_vs_specimen`, L1224-1252): flank influx 0.847 > WT active stress 0.770 > Model I 0.683 > St0 baseline 0.625; Panel F overlays FEM WT and the specimen hull, Panel P all four. Scored down from 93 because the hull is a two-view elliptical approximation rather than the OPT iso-surface, and because the specimen disagrees with the reference table on St1/St0 PD (1.364 vs 1.422) and on DV thickness (926 vs 580 um) — a discrepancy the script measures and reports but cannot resolve." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/limb_bud_elongation_pushing/README.md L33–L43: Specimen-measured hull table vs OPT reference table: PD ratio 1.364 vs 1.422 and DV 926 vs 580 um disagree <https://github.com/fractastical/morpholib/blob/d58a084/datasets/limb_bud_elongation_pushing/README.md#L33-L43>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-specimen-match-4> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2015-boehm-limb-bud-elongation-pushing.py L744–L800" ;
        dcterms:description "Visual-hull reconstruction from the specimen's two orthogonal OPT silhouettes; per-view px->um scale; St1/St0 PD/AP/DV ratios measured from the specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2015-boehm-limb-bud-elongation-pushing.py#L744-L800> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2015-boehm-limb-bud-elongation-pushing.py L1224–L1252" ;
        dcterms:description "Dorsal silhouette intersection-over-union of each FEM end state against the specimen St1 hull" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2015-boehm-limb-bud-elongation-pushing.py#L1224-L1252> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2015-boehm-limb-bud-elongation-pushing.py L622–L720" ;
        dcterms:description "Pass 2 multi-panel contour segmentation of mouse_limb_bud_specimen.jpg retained (Panels D, E, F dorsal/posterior, G)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2015-boehm-limb-bud-elongation-pushing.py#L622-L720> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/limb_bud_elongation_pushing_fem3d.png (generated output)" ;
        dcterms:description "Panels K-P: specimen hull profiles, tet mesh, WT Stokes field on deformed mesh, 5-regime bars, volume closure, dorsal silhouettes vs specimen St1 — docs/media/limb_bud_elongation_pushing_fem3d.png: rendered output of 2015-boehm-limb-bud-elongation-pushing.py at d58a084, image/png, 716383 B, 3300×1440 px, artifact_sha256 72228a70b79bbcaf717412eba6d8a513b305742162b2387a54414847caf2e8ea (sha256 72228a70b79bbcaf717412eba6d8a513b305742162b2387a54414847caf2e8ea), spec_fingerprint 4c3f0cfc301e2c955c4f4f6c7d2e02e3996ca3b4cd571d212368d55baab36b29" .


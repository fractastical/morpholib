        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-boehm-limb-bud-elongation-pushing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Boehm et al. (2010) & Gros et al. (2010) vertebrate limb bud oriented cell division & Wnt5a/FGF8 pushing vs proliferation-gradient hypothesis — Morphometric validation: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1788-2016) returns 20 measurements: 12 new FEM metrics (oracle error 8.2e-14, mesh convergence 0.018 pp, Model I PD 5.21 % vs ref 10.1 %, Model I volume ratio 1.123 vs OPT 1.659, WT PD 42.20 % [fitted], WT AP -10.9 % vs +12 %, Wnt5a-/- 11.97 % vs 18.5 % [out-of-sample], FEM 5-regime r 0.9944, v_in* 61.4 um/h, influx PD 42.16 %, and two specimen-derived IoUs 0.770 / 0.847) plus the 8 Pass 2 metrics (2D r 0.9951 after the T_c fix). Both agreement and disagreement with the reference are recorded. Scored down from 95 because 2 of 5 FEM regimes are calibration targets, the 2D r = 0.9951 is a Pass 2 fit, and 4 of 20 measurements are specimen-derived." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2015-boehm-limb-bud-elongation-pushing.py L1853–L1891: WT PD is a calibration target and the 5-regime FEM r counts it; out-of-sample RMSE is 5.3 pp <https://github.com/fractastical/morpholib/blob/d58a084/2015-boehm-limb-bud-elongation-pushing.py#L1853-L1891>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-5-regime-6h-pd-elongation-hierarchy-pearson-r-vs-empirical>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-5-regime-e11-5-aspect-ratio-l-pd-w-ap-pearson-r-vs-empirical>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-5-regime-6h-pd-elongation-pearson-r-vs-empirical-2-of-5-regimes-calibrated>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-flank-influx-velocity-v-in-closing-the-opt-6h-volume-gap-model-i-source-only>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-mesh-convergence-of-model-i-pd-elongation-default-466-nodes-fine-1198-nodes>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-i-6h-pd-elongation-measured-iddu-brdu-s-x-only-stokes-pinned-flank>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-i-6h-volume-ratio-v-st1-v-st0-from-measured-proliferation-alone>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-i-flank-influx-v-in-6h-pd-elongation-no-active-stress>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-ii-wt-6h-ap-width-change-out-of-sample>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-ii-wt-6h-pd-elongation-calibration-target-k-zeta-fitted>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-stokes-manufactured-solution-max-relative-error-uniform-dilation-extensile-stress-oracles>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-wnt5a-zeta-0-12-chi-0-25-6h-pd-elongation-out-of-sample>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-hooke-jeeves-inverse-opt-to-empirical-distal-source-ratio-s-opt-1-s-emp-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-i-isotropic-proliferation-6h-pd-elongation-at-re-10-2-negative-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-ii-wild-type-6h-pd-elongation-vs-opt-st0-st1-benchmark>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-reynolds-number-5-decade-sensitivity-span-re-in-10-6-10-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-specimen-panel-d-vs-panel-e-3d-opt-iso-surface-aspect-ratio-gain>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-specimen-panel-f-posterior-dv-pd-st1-st0-elongation-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-specimen-st1-dorsal-silhouette-iou-fem-model-i-flank-influx-v-in-vs-specimen-hull>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-specimen-st1-dorsal-silhouette-iou-fem-wt-active-stress-vs-specimen-hull>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-morphometric-validation-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-5-regime-6h-pd-elongation-hierarchy-pearson-r-vs-empirical> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "5-regime 6h PD elongation hierarchy Pearson r vs empirical = 0.9951 Pearson r" ;
        dct:description "RMSE = 2.152% across WT, FGF-only, Wnt5a-/-, Model I, and Uniform controls" ;
        schema:measurementTechnique "evaluate_all_five_regimes (RMSE = 2.152%)" ;
        schema:name "5-regime 6h PD elongation hierarchy Pearson r vs empirical" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9951" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-5-regime-6h-pd-elongation-hierarchy-pearson-r-vs-empirical-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-5-regime-6h-pd-elongation-hierarchy-pearson-r-vs-empirical-reference> a schema:PropertyValue ;
        dct:source "Boehm et al. (2010) PLoS Biol. 8:e1000420 Figs. 4, S8 & Gros et al. (2010) Curr. Biol. 20:1993" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-5-regime-e11-5-aspect-ratio-l-pd-w-ap-pearson-r-vs-empirical> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "5-regime E11.5 aspect ratio L_PD/W_AP Pearson r vs empirical = 0.9937 Pearson r" ;
        dct:description "WT AR = 2.298 vs Model I bulbous AR = 1.115 and Wnt5a-/- AR = 1.286 (RMSE = 0.0680)" ;
        schema:measurementTechnique "evaluate_all_five_regimes E11.5 L_PD/W_AP (RMSE = 0.0680)" ;
        schema:name "5-regime E11.5 aspect ratio L_PD/W_AP Pearson r vs empirical" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9937" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-5-regime-e11-5-aspect-ratio-l-pd-w-ap-pearson-r-vs-empirical-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-5-regime-e11-5-aspect-ratio-l-pd-w-ap-pearson-r-vs-empirical-reference> a schema:PropertyValue ;
        dct:source "Gros et al. (2010) Current Biology 20:1993-2004 Figs. 1-6 & Boehm et al. (2010) PLoS Biol. 8:e1000420" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-5-regime-6h-pd-elongation-pearson-r-vs-empirical-2-of-5-regimes-calibrated> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FEM 5-regime 6h PD elongation Pearson r vs empirical (2 of 5 regimes calibrated) = 0.9944 Pearson r" ;
        dct:description "Rank order reproduced; magnitudes of the three uncalibrated regimes are 4.3-6.5 pp below the reference values" ;
        schema:measurementTechnique "evaluate_fem_regimes_and_influx (out-of-sample RMSE over the 3 uncalibrated regimes = 5.318 pp)" ;
        schema:name "FEM 5-regime 6h PD elongation Pearson r vs empirical (2 of 5 regimes calibrated)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9944" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-5-regime-6h-pd-elongation-pearson-r-vs-empirical-2-of-5-regimes-calibrated-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-5-regime-6h-pd-elongation-pearson-r-vs-empirical-2-of-5-regimes-calibrated-reference> a schema:PropertyValue ;
        dct:source "Boehm et al. (2010) Figs. 4, S8 & Gros et al. (2010) regime table" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-flank-influx-velocity-v-in-closing-the-opt-6h-volume-gap-model-i-source-only> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FEM flank influx velocity v_in* closing the OPT 6h volume gap (Model I source only) = 61.391 um/h" ;
        dct:description "The OPT volume table implies ~1/3 of the St1 bud volume entered through the flank in 6 h — to be verified against the paper (Pass 4)" ;
        schema:measurementTechnique "linear interpolation of the 9-point v_in sweep [0, 80] um/h to V1/V0 = 1.6588" ;
        schema:name "FEM flank influx velocity v_in* closing the OPT 6h volume gap (Model I source only)" ;
        schema:unitText "um/h" ;
        schema:value "61.391" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-flank-influx-velocity-v-in-closing-the-opt-6h-volume-gap-model-i-source-only-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-flank-influx-velocity-v-in-closing-the-opt-6h-volume-gap-model-i-source-only-reference> a schema:PropertyValue ;
        dct:source "Analytic estimate (V_OPT - V_prolif) / (A_flank * 6 h) from the reference-table OPT volumes and the mesh flank area 0.4861 mm^2" ;
        schema:value "80.641" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-mesh-convergence-of-model-i-pd-elongation-default-466-nodes-fine-1198-nodes> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FEM mesh-convergence of Model I PD elongation |default (466 nodes) - fine (1198 nodes)| = 0.018 percentage points" ;
        dct:description "Discretisation error of the reported FEM morphometrics is below 0.05 pp" ;
        schema:measurementTechnique "simulate_limb_bud_fem_3d at FEM_COARSE_RES / FEM_DEFAULT_RES / FEM_FINE_RES" ;
        schema:name "FEM mesh-convergence of Model I PD elongation |default (466 nodes) - fine (1198 nodes)|" ;
        schema:unitText "percentage points" ;
        schema:value "0.018" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-mesh-convergence-of-model-i-pd-elongation-default-466-nodes-fine-1198-nodes-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-mesh-convergence-of-model-i-pd-elongation-default-466-nodes-fine-1198-nodes-reference> a schema:PropertyValue ;
        dct:source "Richardson-type self-convergence (coarse 5.165%, default 5.206%, fine 5.224%)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-i-6h-pd-elongation-measured-iddu-brdu-s-x-only-stokes-pinned-flank> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FEM Model I 6h PD elongation (measured IddU/BrdU s(x) only, Stokes, pinned flank) = 5.2059 %" ;
        dct:description "Parameter-free prediction; AP +4.37%, DV +2.49% (bulbous), inside the paper's 3.4-11.8% band" ;
        schema:measurementTechnique "simulate_limb_bud_fem_3d(zeta=0, chi=0, v_in=0) on the specimen St0 visual-hull mesh — no calibrated parameter" ;
        schema:name "FEM Model I 6h PD elongation (measured IddU/BrdU s(x) only, Stokes, pinned flank)" ;
        schema:unitText "%" ;
        schema:value "5.2059" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-i-6h-pd-elongation-measured-iddu-brdu-s-x-only-stokes-pinned-flank-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-i-6h-pd-elongation-measured-iddu-brdu-s-x-only-stokes-pinned-flank-reference> a schema:PropertyValue ;
        dct:source "Boehm et al. (2010) PLoS Biology 8:e1000420 Fig. S3 (isotropic FEM at Re = 10^-2; 3.4-11.8% over Re in [1e-6, 1e-1])" ;
        schema:value "10.1" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-i-6h-volume-ratio-v-st1-v-st0-from-measured-proliferation-alone> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FEM Model I 6h volume ratio V(St1)/V(St0) from measured proliferation alone = 1.1232 V1/V0" ;
        dct:description "The IddU/BrdU source accounts for only ~12% volume gain vs 66% measured by OPT — the growth-rate paradox the paper's inverse optimisation exposes" ;
        schema:measurementTechnique "simulate_limb_bud_fem_3d(zeta=0, chi=0) total tetrahedral volume (volume-balance ratio 1.0050)" ;
        schema:name "FEM Model I 6h volume ratio V(St1)/V(St0) from measured proliferation alone" ;
        schema:unitText "V1/V0" ;
        schema:value "1.1232" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-i-6h-volume-ratio-v-st1-v-st0-from-measured-proliferation-alone-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-i-6h-volume-ratio-v-st1-v-st0-from-measured-proliferation-alone-reference> a schema:PropertyValue ;
        dct:source "Boehm et al. (2010) Fig. 2 OPT volumes 0.551 -> 0.914 mm^3 (reference table)" ;
        schema:value "1.6588" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-i-flank-influx-v-in-6h-pd-elongation-no-active-stress> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FEM Model I + flank influx v_in* 6h PD elongation (no active stress) = 42.1597 %" ;
        dct:description "AP +4.86%, DV +2.79%: volume closure alone reproduces the PD/AP/DV signs that the active-stress WT misses" ;
        schema:measurementTechnique "simulate_limb_bud_fem_3d(zeta=0, chi=0, v_in=v_in*) ALE inflow plane" ;
        schema:name "FEM Model I + flank influx v_in* 6h PD elongation (no active stress)" ;
        schema:unitText "%" ;
        schema:value "42.1597" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-i-flank-influx-v-in-6h-pd-elongation-no-active-stress-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-i-flank-influx-v-in-6h-pd-elongation-no-active-stress-reference> a schema:PropertyValue ;
        dct:source "Boehm et al. (2010) Fig. 2 OPT St0 -> St1 (+42.2% PD, +12.0% AP, +1.0% DV)" ;
        schema:value "42.2" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-ii-wt-6h-ap-width-change-out-of-sample> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FEM Model II WT 6h AP width change (out-of-sample) = -10.9195 %" ;
        dct:description "Sign disagreement: traceless extensile stress + 12% volume source forces AP/DV contraction (DV -14.54% vs +1.0%); the OPT shape change needs volume the measured s(x) does not supply" ;
        schema:measurementTechnique "simulate_limb_bud_fem_3d WT: ptp(y) of final surface nodes vs St0" ;
        schema:name "FEM Model II WT 6h AP width change (out-of-sample)" ;
        schema:unitText "%" ;
        schema:value "-10.9195" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-ii-wt-6h-ap-width-change-out-of-sample-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-ii-wt-6h-ap-width-change-out-of-sample-reference> a schema:PropertyValue ;
        dct:source "Boehm et al. (2010) Fig. 2 OPT W_AP 960 -> 1075 um (reference table); specimen hull AP ratio 1.2218" ;
        schema:value "11.98" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-ii-wt-6h-pd-elongation-calibration-target-k-zeta-fitted> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FEM Model II WT 6h PD elongation (calibration target: k_zeta fitted) = 42.1993 %" ;
        dct:description "Fitted, not predicted: k_zeta and k_chi are the only two free gains, fitted to WT and FGF-only PD elongation" ;
        schema:measurementTechnique "simulate_limb_bud_fem_3d(zeta=1, chi=1, k_zeta=0.03518, k_chi=0.11143 h^-1)" ;

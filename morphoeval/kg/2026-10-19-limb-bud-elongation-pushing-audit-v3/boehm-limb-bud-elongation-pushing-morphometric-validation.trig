    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-stokes-manufactured-solution-max-relative-error-uniform-dilation-extensile-stress-oracles> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FEM Stokes manufactured-solution max relative error (uniform dilation & extensile stress oracles) = 8.238e-14 relative error" ;
        dct:description "Both oracles are linear in x and must be reproduced to round-off by P1 elements" ;
        schema:measurementTechnique "fem_manufactured_solution_errors on the 466-node / 2150-tet St0 hull mesh (P1-P1 Brezzi-Pitkaranta)" ;
        schema:name "FEM Stokes manufactured-solution max relative error (uniform dilation & extensile stress oracles)" ;
        schema:unitText "relative error" ;
        schema:value "8.238e-14" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-stokes-manufactured-solution-max-relative-error-uniform-dilation-extensile-stress-oracles-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-stokes-manufactured-solution-max-relative-error-uniform-dilation-extensile-stress-oracles-reference> a schema:PropertyValue ;
        dct:source "Closed-form Stokes solutions v = (s/3) x, p = 2 mu s/3 and v = zeta(2x/3, -y/3, -z/3), p = 0 (Lean Theorem 4)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-wnt5a-zeta-0-12-chi-0-25-6h-pd-elongation-out-of-sample> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FEM Wnt5a-/- (zeta=0.12, chi=0.25) 6h PD elongation (out-of-sample) = 11.9691 %" ;
        dct:description "Out-of-sample prediction under-shoots by ~6.5 pp; ordering WT > FGF-only > Wnt5a-/- > Model I ~ uniform is preserved" ;
        schema:measurementTechnique "simulate_limb_bud_fem_3d with the calibrated gains and the reference-table mutant parameters" ;

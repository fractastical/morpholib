    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-fem-model-ii-wt-6h-pd-elongation-calibration-target-k-zeta-fitted-reference> a schema:PropertyValue ;

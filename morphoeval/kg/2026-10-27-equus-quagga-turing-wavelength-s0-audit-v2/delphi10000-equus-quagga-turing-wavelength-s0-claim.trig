    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Equus quagga Holocene Turing wavelength at 1.9 mm (detail s0) faithfully reproduces Equus quagga morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-equus-quagga-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Equus quagga specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-equus-quagga-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-equus-quagga-turing-wavelength-s0.py; output: docs/media/equus_quagga_turing_wavelength_s0_comparison.png; organism: Equus quagga; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion, Schnakenberg 1979 kinetics, Murray 1981 coat pre-pattern. | Bard 1977: about 0.4 mm spacing, stripes perpendicular to the dorsal line, third week, plains zebra. | Staddon 2024: curvature-dependent diffusion can orient stripes on a 3-D body.; reconstructed_in_script: 1.883 mm is the slot detail length (10^(-2.725) m), pinned to k_fast at gamma 1.15. Growth factor 4.707 from Bard's 0.40 mm is reconstructed. | Pass 2 adds a rump crop and an anisotropy probe. The rump orientation is not reproduced. | Equus scotti is only the equal-diffusion ablation.; transfer_boundary: The photograph is an adult flank and rump. It does not measure the 1.883 mm fetal wavelength. | A straight periodic patch does not transfer to the rump, where stripes turn.; does_not_claim: Does not claim the 1.883 mm length was calipered on a fetus in this loop. | Does not claim the simulation matches rump stripe orientation. | Does not claim a second assessor scored this pass. | Does not claim Equus scotti's coat is known.]; phenomenon_size: 2.1 mm (0.00213 m, log10=-2.672 m, tier=6_organ_mm); species_scale_ladder (10 runs from 2.1 mm to 3.41 m): 2.1 mm:equus-quagga-bioelectric-polarity, 4.0 mm:equus-quagga-vertex-packing, 7.6 cm:equus-quagga-turing-wavelength, 13.9 cm:equus-quagga-clock-wavefront, 45.1 cm:equus-quagga-morphogen-condensation, 58.9 cm:equus-quagga-flux-canalization, 62.0 cm:equus-quagga-elastic-buckling, 77.0 cm:equus-quagga-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90109-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1103/PhysRevE.110.034402>,
            <https://doi.org/10.1111/j.1469-7998.1977.tb04204.x> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-equus-quagga-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-equus-quagga-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


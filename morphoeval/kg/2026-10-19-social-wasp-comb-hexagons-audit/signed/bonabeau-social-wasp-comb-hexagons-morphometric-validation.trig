sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bonabeau-social-wasp-comb-hexagons> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Karsai & Pénzes (1993) J. Theor. Biol., Theraulaz & Bonabeau (1995) Science & Smith et al. (2021) PNAS stigmergic hexagonal wasp comb architecture, shared-wall pulp economy & 5-7 topological disclination pairs — Morphometric validation: 52/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L175-210) reports only 4 analytic ring ratios without Pearson r, p-value, RMSE, stigmergic selectivity beta correlation, Eden random vs wild-type wall-per-cell delta, 5-7 disclination dipole net Euler charge, or specimen brood cell coordination number <z>." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1998-bonabeau-social-wasp-comb-hexagons.py L175–L210: Only 4 analytic ring metrics without statistical tests, negative controls, or specimen segmentation <https://github.com/fractastical/morpholib/blob/e93f00e/1998-bonabeau-social-wasp-comb-hexagons.py#L175-L210>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-founder-cell-r-0-initial-wall-to-cell-ratio-w-0-n-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-intermediate-comb-r-3-n-37-wall-to-cell-ratio-w-3-n-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-mature-6-ring-comb-n-127-wall-to-cell-ratio-w-6-n-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-mature-7-ring-comb-n-169-paper-pulp-wall-savings-percentage> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-founder-cell-r-0-initial-wall-to-cell-ratio-w-0-n-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Founder cell (R = 0) initial wall-to-cell ratio W(0)/N(0) = 6.0 walls/cell" ;
        schema:measurementTechnique "Analytic centered hexagonal comb formula at R = 0" ;
        schema:name "Founder cell (R = 0) initial wall-to-cell ratio W(0)/N(0)" ;
        schema:unitText "walls/cell" ;
        schema:value "6.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-founder-cell-r-0-initial-wall-to-cell-ratio-w-0-n-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-founder-cell-r-0-initial-wall-to-cell-ratio-w-0-n-0-reference> a schema:PropertyValue ;
        dcterms:source "Karsai & Pénzes (1993) J. Theor. Biol. 161:505-525" ;
        schema:value "6.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-intermediate-comb-r-3-n-37-wall-to-cell-ratio-w-3-n-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Intermediate comb (R = 3, N = 37) wall-to-cell ratio W(3)/N(3) = 3.5676 walls/cell" ;
        schema:measurementTechnique "Analytic centered hexagonal comb formula at R = 3" ;
        schema:name "Intermediate comb (R = 3, N = 37) wall-to-cell ratio W(3)/N(3)" ;
        schema:unitText "walls/cell" ;
        schema:value "3.5676" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-intermediate-comb-r-3-n-37-wall-to-cell-ratio-w-3-n-3-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-intermediate-comb-r-3-n-37-wall-to-cell-ratio-w-3-n-3-reference> a schema:PropertyValue ;
        dcterms:source "Karsai & Pénzes (1993) J. Theor. Biol. 161:505-525" ;
        schema:value "3.5676" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-mature-6-ring-comb-n-127-wall-to-cell-ratio-w-6-n-6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Mature 6-ring comb (N = 127) wall-to-cell ratio W(6)/N(6) = 3.3071 walls/cell" ;
        schema:measurementTechnique "Analytic centered hexagonal comb formula at R = 6" ;
        schema:name "Mature 6-ring comb (N = 127) wall-to-cell ratio W(6)/N(6)" ;
        schema:unitText "walls/cell" ;
        schema:value "3.3071" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-mature-6-ring-comb-n-127-wall-to-cell-ratio-w-6-n-6-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-mature-6-ring-comb-n-127-wall-to-cell-ratio-w-6-n-6-reference> a schema:PropertyValue ;
        dcterms:source "Karsai & Pénzes (2000) Behav. Ecol. 11:387-395" ;
        schema:value "3.3071" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-mature-7-ring-comb-n-169-paper-pulp-wall-savings-percentage> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Mature 7-ring comb (N = 169) paper pulp wall savings percentage = 45.56 percent" ;
        schema:measurementTechnique "Analytic pulp savings 100*(6*N - W)/(6*N) at R = 7" ;
        schema:name "Mature 7-ring comb (N = 169) paper pulp wall savings percentage" ;
        schema:unitText "percent" ;
        schema:value "45.56" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-mature-7-ring-comb-n-169-paper-pulp-wall-savings-percentage-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-mature-7-ring-comb-n-169-paper-pulp-wall-savings-percentage-reference> a schema:PropertyValue ;
        dcterms:source "Karsai & Pénzes (2000) Behav. Ecol. 11:387-395 & Hales (2001)" ;
        schema:value "45.56" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 096 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bonabeau-social-wasp-comb-hexagons> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Karsai & Pénzes (1993) J. Theor. Biol., Theraulaz & Bonabeau (1995) Science & Smith et al. (2021) PNAS stigmergic hexagonal wasp comb architecture, shared-wall pulp economy & 5-7 topological disclination pairs — Morphological realism / specimen match: 35/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Although `datasets/social_wasp_comb_hexagons/polistes_wasp_comb_specimen.jpg` is vendored on disk, the v1 script never loads, segments, or extracts brood cell cavities, Delaunay/Voronoi neighbor coordination numbers z_i, or hexatic order from the biological specimen image." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1998-bonabeau-social-wasp-comb-hexagons.py L71–L86: Evaluates only the 8-ring analytic table without loading or segmenting polistes_wasp_comb_specimen.jpg <https://github.com/fractastical/morpholib/blob/e93f00e/1998-bonabeau-social-wasp-comb-hexagons.py#L71-L86>",
            "docs/media/social_wasp_comb_hexagons_comparison.png (generated output, not in repo): 4-panel v1 plot lacks Polistes comb specimen Voronoi segmentation, beta selectivity sweep, and 5-7 topological defects — docs/media/social_wasp_comb_hexagons_comparison.png: rendered output of 1998-bonabeau-social-wasp-comb-hexagons.py at e93f00e, image/png, 258873 B, 1890×1400 px, artifact_sha256 75731e309cf80570ed6a43e2e3b7fc9cab06affe9904e112072395a8db5fcd5d (sha256 75731e309cf80570ed6a43e2e3b7fc9cab06affe9904e112072395a8db5fcd5d), spec_fingerprint 6471896f9ec341c70d5d90fdfc768c186b2e5e7ed95f0e8568fe6372d790ffc3" ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 096 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


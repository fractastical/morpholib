    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-founder-cell-r-0-initial-wall-to-cell-ratio-w-0-n-0>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-intermediate-comb-r-3-n-37-wall-to-cell-ratio-w-3-n-3>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-mature-6-ring-comb-n-127-wall-to-cell-ratio-w-6-n-6>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-mature-7-ring-comb-n-169-paper-pulp-wall-savings-percentage> ;

<https://w3id.org/probknow/resource/claim/morphoeval-bonabeau-social-wasp-comb-hexagons> a pk:Claim ;
    rdfs:label "Karsai & Pénzes (1993) J. Theor. Biol., Theraulaz & Bonabeau (1995) Science & Smith et al. (2021) PNAS stigmergic hexagonal wasp comb architecture, shared-wall pulp economy & 5-7 topological disclination pairs (Polistes dominula / Vespula vulgaris (Social paper wasps))",
        "Karsai & Pénzes (1993) J. Theor. Biol., Theraulaz & Bonabeau (1995) Science & Smith et al. (2021) PNAS stigmergic hexagonal wasp comb architecture, shared-wall pulp economy & 5-7 topological disclination pairs faithfully reproduces Polistes dominula / Vespula vulgaris (Social paper wasps) morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/bonabeau-social-wasp-comb-hexagons-1>,
        <https://w3id.org/probknow/resource/math-law/bonabeau-social-wasp-comb-hexagons-2>,
        <https://w3id.org/probknow/resource/math-law/bonabeau-social-wasp-comb-hexagons-3> ;
    dct:description "The simulation script(s) 1998-bonabeau-social-wasp-comb-hexagons.py implement the cited source model as published and produce forms that match real Polistes dominula / Vespula vulgaris (Social paper wasps) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 53.5/100, audit 2026-10-19-social-wasp-comb-hexagons-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/e93f00e/1998-bonabeau-social-wasp-comb-hexagons.py> ;
    schema:about "Polistes dominula / Vespula vulgaris (Social paper wasps)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/e93f00e/1998-bonabeau-social-wasp-comb-hexagons.py; output: docs/media/social_wasp_comb_hexagons_comparison.png; organism: Polistes dominula / Vespula vulgaris (Social paper wasps); checkpoint commit: https://github.com/fractastical/morpholib/commit/e93f00e; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 6471896f9ec341c70d5d90fdfc768c186b2e5e7ed95f0e8568fe6372d790ffc3; artifact_sha256: 75731e309cf80570ed6a43e2e3b7fc9cab06affe9904e112072395a8db5fcd5d; input_dataset_sha256: {datasets/social_wasp_comb_hexagons/paper_citations.bib=9b09023aaea52aa7..., datasets/social_wasp_comb_hexagons/polistes_wasp_comb_specimen.jpg=03befd4d1fbfa35a..., datasets/social_wasp_comb_hexagons/scout_manifest.json=63f51b932c469536..., datasets/social_wasp_comb_hexagons/social_wasp_comb_hexagons_reference.json=5d67bfb268fa3003...}" ;
    pk:derivedFromPaper <https://doi.org/10.1006/jtbi.1993.1072>,
        <https://doi.org/10.1007/s004540010071>,
        <https://doi.org/10.1073/pnas.2103605118>,
        <https://doi.org/10.1093/beheco/11.4.387>,
        <https://doi.org/10.1126/science.269.5224.686> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-model-fidelity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-morphometric-validation>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-overall>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-parameter-expressivity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-social-wasp-comb-hexagons-audit-bonabeau-social-wasp-comb-hexagons-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-social-wasp-comb-hexagons-audit-bonabeau-social-wasp-comb-hexagons-2>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-social-wasp-comb-hexagons-audit-bonabeau-social-wasp-comb-hexagons-3>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-social-wasp-comb-hexagons-audit-bonabeau-social-wasp-comb-hexagons-4> ;
    pk:hypothesisType "Stigmergic Local Wall-Sharing Rule P_init(k) ∝ exp(β k) (k ∈ {2, 3} shared walls) on a 2D/3D Hexagonal Lattice + Honeycomb Perimeter-to-Area Economy & Topological 5–7 Disclination Pairs" ;
    pk:weightOfEvidence 5.35e-01 .


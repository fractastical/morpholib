<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/bonabeau-social-wasp-comb-hexagons-1>,
        <https://w3id.org/probknow/resource/math-law/bonabeau-social-wasp-comb-hexagons-2>,
        <https://w3id.org/probknow/resource/math-law/bonabeau-social-wasp-comb-hexagons-3> .

<https://w3id.org/probknow/resource/math-law/bonabeau-social-wasp-comb-hexagons-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Centered Hexagonal Ring Progression & 6R Perimeter Ring Increment Law" ;
    dct:description "Establishes the exact centered hexagonal number progression N(R) = 1 + 3R(R+1) and 6R ring perimeter increment achieved when stigmergic wasps prioritize 3-wall pockets over 2-wall corner pockets | Variables: R: number of concentric hexagonal rings around central founder cell; N(R): total brood cells in R rings; ΔN(R + 1): number of perimeter cells added in ring R + 1" ;
    dct:source "Karsai & Pénzes (1993) J. Theor. Biol. 161:505-525; Theraulaz & Bonabeau (1995) Science 269:686-688; Karsai & Pénzes (2000) Behav. Ecol. 11:387-395" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/1998-bonabeau-social-wasp-comb-hexagons.py#L95-L155>,
        <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_096_social_wasp_comb_hexagons.lean#L25-L53> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def centered_hex_cells (R : Nat) : Nat :=
  1 + 3 * R * (R + 1)
def ring_perimeter_increment (R : Nat) : Nat :=
  6 * (R + 1)
theorem centered_hexagonal_ring_progression (R : Nat) :
    centered_hex_cells 0 = 1 ∧
    centered_hex_cells (R + 1) = centered_hex_cells R + ring_perimeter_increment R ∧
    centered_hex_cells (R + 1) > centered_hex_cells R
"""^^pk:lean4 ;
    skos:notation "N(R) = 1 + 3 R (R + 1),  ΔN(R + 1) = N(R + 1) - N(R) = 6 (R + 1)  ⇒  N(0) = 1,  N(R + 1) > N(R)" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1993.1072>,
        <https://doi.org/10.1007/s004540010071>,
        <https://doi.org/10.1073/pnas.2103605118>,
        <https://doi.org/10.1093/beheco/11.4.387>,
        <https://doi.org/10.1126/science.269.5224.686> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Stigmergic Local Wall-Sharing Rule P_init(k) ∝ exp(β k) (k ∈ {2, 3} shared walls) on a 2D/3D Hexagonal Lattice + Honeycomb Perimeter-to-Area Economy & Topological 5–7 Disclination Pairs" ;
    pk:leanDeclaration "MathOfBiology.Loop_096.centered_hex_cells" ;
    pk:leanTheorem "MathOfBiology.Loop_096.centered_hexagonal_ring_progression" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/bonabeau-social-wasp-comb-hexagons-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Shared-Wall Paper Pulp Economy & Asymptotic 3-Wall Hexagonal Optimality Law" ;
    dct:description "Proves that shared-wall hexagonal combs strictly reduce paper pulp wall count below 6 N(R) for all R >= 1 and approach 3 walls per cell (50% savings) as comb radius R grows | Variables: W(R): total distinct shared and boundary cell walls in an R-ring hexagonal comb; W_isolated(R): 6 N(R) walls for unshared cells; S_saved(R): paper pulp walls saved by hexagonal wall-sharing" ;
    dct:source "Karsai & Pénzes (1993) J. Theor. Biol. 161:505-525; Karsai & Pénzes (2000) Behav. Ecol. 11:387-395; Hales (2001) Discrete Comput. Geom. 25:1-22" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/1998-bonabeau-social-wasp-comb-hexagons.py#L158-L295>,
        <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_096_social_wasp_comb_hexagons.lean#L64-L86> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def compact_comb_walls (R : Nat) : Nat :=
  3 * centered_hex_cells R + 6 * R + 3
def unshared_isolated_walls (R : Nat) : Nat :=
  6 * centered_hex_cells R
def pulp_walls_saved (R : Nat) : Nat :=
  unshared_isolated_walls R - compact_comb_walls R
theorem shared_wall_pulp_economy_and_asymptotic_excess (R : Nat) :
    compact_comb_walls 0 = 6 ∧
    compact_comb_walls R - 3 * centered_hex_cells R = 6 * R + 3 ∧
    compact_comb_walls (R + 1) < unshared_isolated_walls (R + 1) ∧
    pulp_walls_saved (R + 1) > 0
"""^^pk:lean4 ;
    skos:notation "W(R) = 3 N(R) + 6 R + 3 < 6 N(R) = W_isolated(R)  (∀ R ≥ 1),  W(R)/N(R) → 3.0 as R → ∞" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1993.1072>,
        <https://doi.org/10.1007/s004540010071>,
        <https://doi.org/10.1073/pnas.2103605118>,
        <https://doi.org/10.1093/beheco/11.4.387>,
        <https://doi.org/10.1126/science.269.5224.686> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Stigmergic Local Wall-Sharing Rule P_init(k) ∝ exp(β k) (k ∈ {2, 3} shared walls) on a 2D/3D Hexagonal Lattice + Honeycomb Perimeter-to-Area Economy & Topological 5–7 Disclination Pairs" ;
    pk:leanDeclaration "MathOfBiology.Loop_096.compact_comb_walls" ;
    pk:leanTheorem "MathOfBiology.Loop_096.shared_wall_pulp_economy_and_asymptotic_excess" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/bonabeau-social-wasp-comb-hexagons-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Euler Topological Charge Neutrality of 5-7 Disclination Pairs at Caste Transitions" ;
    dct:description "Proves that pentagon-heptagon (5-7) topological disclination pairs inserted to bridge worker-to-reproductive cell size transitions have zero net Euler topological charge | Variables: z: polygon coordination number (5 = pentagon, 6 = hexagon, 7 = heptagon); q(z) = 6 - z: Euler topological disclination charge; n_pairs: number of paired 5-7 dislocations" ;
    dct:source "Smith, Napp, Gravish, Seeley & Petersen (2021) PNAS 118:e2103605118 Figs. 2-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/1998-bonabeau-social-wasp-comb-hexagons.py#L300-L430>,
        <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_096_social_wasp_comb_hexagons.lean#L97-L114> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def topological_charge (z : Int) : Int :=
  6 - z
def disclination_dipole_net_charge (n_pairs : Int) : Int :=
  n_pairs * (topological_charge 5 + topological_charge 7)
theorem euler_disclination_dipole_charge_neutrality (n_pairs : Int) :
    topological_charge 6 = 0 ∧
    topological_charge 5 = 1 ∧
    topological_charge 7 = -1 ∧
    disclination_dipole_net_charge n_pairs = 0
"""^^pk:lean4 ;
    skos:notation "q(z) = 6 - z  ⇒  q(6) = 0,  q(5) = +1,  q(7) = -1,  n_pairs · (q(5) + q(7)) = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1993.1072>,
        <https://doi.org/10.1007/s004540010071>,
        <https://doi.org/10.1073/pnas.2103605118>,
        <https://doi.org/10.1093/beheco/11.4.387>,
        <https://doi.org/10.1126/science.269.5224.686> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Stigmergic Local Wall-Sharing Rule P_init(k) ∝ exp(β k) (k ∈ {2, 3} shared walls) on a 2D/3D Hexagonal Lattice + Honeycomb Perimeter-to-Area Economy & Topological 5–7 Disclination Pairs" ;
    pk:leanDeclaration "MathOfBiology.Loop_096.topological_charge" ;
    pk:leanTheorem "MathOfBiology.Loop_096.euler_disclination_dipole_charge_neutrality" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


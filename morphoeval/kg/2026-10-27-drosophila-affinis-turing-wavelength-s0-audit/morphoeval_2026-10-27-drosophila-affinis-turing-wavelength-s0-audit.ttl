<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila affinis Turing wavenumber at 2.4 µm (Holocene, detail tier) — Model fidelity to source: 84/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The Jacobian, classical k_c formula, periodic Schnakenberg update, and equal-diffusivity ablation implement the published law. Pass 1 left Du at the determinant condition, so the mode that actually grows (2.652 µm) is not the assigned 2.444 µm." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

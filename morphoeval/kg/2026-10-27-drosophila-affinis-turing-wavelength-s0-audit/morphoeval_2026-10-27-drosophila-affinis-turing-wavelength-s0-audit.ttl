<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-affinis-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail wavelength below the chronoseries neighbors" ;
    dct:description "Chronoseries comparison at this scale and age | Variables: lambda_affinis = 2444 nm; lambda_berryi = 98430 nm; lambda_americana = 138700 nm" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; slot scales for berryi (98.43 µm, 19 Ma) and americana (138.7 µm, 0 Ma)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3174_drosophila_affinis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_affinis = 2.444 µm < lambda_berryi = 98.43 µm and < lambda_americana = 138.7 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1083/jcb.29.2.223>,
        <https://doi.org/10.1093/aesa/9.4.323>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/dev.129.8.1849>,
        <https://doi.org/10.2307/3223884> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3174.lambdaDetailNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3174.detail_wavelength_below_chronospecies" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-affinis-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homogeneous Schnakenberg steady state is stable" ;
    dct:description "Stability without diffusion, required before a diffusion-driven instability is meaningful | Variables: a = 0.05; b = 1; f_u = 0.9048; g_v = -1.1025; trace = -0.1977; det = 1.1025" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3174_drosophila_affinis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "trace(J) = f_u + g_v < 0 and det(J) = u0^2 > 0 at u0 = a + b" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1083/jcb.29.2.223>,
        <https://doi.org/10.1093/aesa/9.4.323>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/dev.129.8.1849>,
        <https://doi.org/10.2307/3223884> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3174.fu" ;
    pk:leanTheorem "MathOfBiology.Loop_3174.homogeneous_steady_state_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-affinis-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber at 2.444 µm" ;
    dct:description "Critical wavenumber selecting the detail-tier pigment spacing | Variables: Du = 0.05101 µm^2/time after fastest-mode calibration; Dv = 0.5101; ratio = 10" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3174_drosophila_affinis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (Dv f_u + Du g_v) / (2 Du Dv), lambda_c = 2 pi / k_c = 2.444 µm, with Dv/Du = 10" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1083/jcb.29.2.223>,
        <https://doi.org/10.1093/aesa/9.4.323>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/dev.129.8.1849>,
        <https://doi.org/10.2307/3223884> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3174.rdTrace" ;
    pk:leanTheorem "MathOfBiology.Loop_3174.diffusion_driven_instability_at_detail_scale" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-affinis-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusivity ablation" ;
    dct:description "Negative control | Variables: Du = Dv = 0.05101 µm^2/time; sigma_max = -0.099" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3174_drosophila_affinis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "Dv = Du implies Dv f_u + Du g_v < 0, so the Turing condition fails" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1083/jcb.29.2.223>,
        <https://doi.org/10.1093/aesa/9.4.323>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/dev.129.8.1849>,
        <https://doi.org/10.2307/3223884> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3174.rdTrace" ;
    pk:leanTheorem "MathOfBiology.Loop_3174.equal_diffusivity_ablation_not_turing" ;
    pk:leanVerified true .


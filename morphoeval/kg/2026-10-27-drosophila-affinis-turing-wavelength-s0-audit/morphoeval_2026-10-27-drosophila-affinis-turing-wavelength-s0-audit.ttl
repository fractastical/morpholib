    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.4e-01 ;
    pk:hasVerdict "faithful" .


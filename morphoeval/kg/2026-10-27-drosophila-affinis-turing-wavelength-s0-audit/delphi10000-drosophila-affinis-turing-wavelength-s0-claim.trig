sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-affinis-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Drosophila affinis Turing wavenumber at 2.4 µm (Holocene, detail tier) faithfully reproduces Drosophila affinis morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-affinis-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila affinis specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-affinis-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-affinis-turing-wavelength-s0.py; output: docs/media/drosophila_affinis_turing_wavelength_s0_growth.gif; organism: Drosophila affinis; environment: n/a; claim_boundary: [reported_in_source: Turing 1952: diffusion-driven instability at a finite critical wavenumber when the inhibitor diffuses faster than the activator. | Schnakenberg 1979: kinetics du/dt = a - u + u^2 v, dv/dt = b - u^2 v. | Sturtevant 1916 named Drosophila affinis. Miller 1955 described its sex combs. | Wittkopp, True and Carroll 2002: Yellow and Ebony place adult cuticular melanin. Shoup 1966 described melanogaster pigment-granule ontogeny.; reconstructed_in_script: Jacobian, classical k_c, and a periodic Schnakenberg integration on a 48.88 µm by 36.66 µm patch. | Chronoseries comparison against the assigned berryi 98.43 µm (19 Ma) and americana 138.7 µm (0 Ma) wavelengths. | Du, Dv solved for lambda_c = 2.444 µm at diffusivity ratio 10. These are not the sibling slots' alpha_scale coefficients.; transfer_boundary: Shoup 1966 is D. melanogaster, not a measurement of D. affinis granule spacing. | The sex comb is the species diagnosis. Its tooth spacing is not this wavelength. | Berryi and americana are Delphi chronoseries neighbors, not a demonstrated ancestor-descendant pair.; does_not_claim: Does not claim a new electron-microscope measurement of D. affinis pigment granules. | Does not claim the habitus photograph resolves a 2.444 µm wave. The print scale bar is 250 µm. | Does not claim the Pass-1 nonlinear FFT (2.619 µm) equals the assigned scale.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1083/jcb.29.2.223>,
            <https://doi.org/10.1093/aesa/9.4.323>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1242/dev.129.8.1849>,
            <https://doi.org/10.2307/3223884> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-affinis-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-affinis-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila succini Turing wavenumber at 2.8 µm (44 Ma, detail scale s0) — Model fidelity to source: 82/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script states and codes Schnakenberg kinetics, the Jacobian, sigma(k), and k_c = argmax sigma(k), and it solves D_u so the peak sits on 2.759 µm at r = 18.72. Deducted because the kinetics are not a Drosophila-specific published system, and because the textbook determinant wavenumber k_h is not the same as k_c above onset." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 8.2e-01 ;
    pk:hasVerdict "faithful" .


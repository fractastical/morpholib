<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila succini Turing wavenumber at 2.8 µm (44 Ma, detail scale s0) — Code-to-model traceability: 84/100" ;

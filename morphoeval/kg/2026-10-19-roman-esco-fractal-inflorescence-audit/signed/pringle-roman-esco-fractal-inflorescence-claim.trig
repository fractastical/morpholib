sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pringle-roman-esco-fractal-inflorescence> a pk:Claim ;
        rdfs:label "Azpeitia et al. (2021) & Prusinkiewicz et al. (2007) TFL1-LFY-AP1/CAL-SOC1 floral GRN perturbation and accelerating plastochron Romanesco fractal inflorescence morphogenesis faithfully reproduces Brassica oleracea var. botrytis (Romanesco & Cauliflower curds) and Arabidopsis thaliana (ap1 cal mutant) morphology" ;
        dcterms:description "The simulation script(s) 2021-pringle-roman-esco-fractal-inflorescence.py implement the cited source model as published and produce forms that match real Brassica oleracea var. botrytis (Romanesco & Cauliflower curds) and Arabidopsis thaliana (ap1 cal mutant) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 52.8/100, audit 2026-10-19-roman-esco-fractal-inflorescence-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/8871db0/2021-pringle-roman-esco-fractal-inflorescence.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2021-pringle-roman-esco-fractal-inflorescence.py; output: docs/media/roman_esco_fractal_inflorescence_comparison.png; organism: Brassica oleracea var. botrytis (Romanesco & Cauliflower curds) and Arabidopsis thaliana (ap1 cal mutant); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 3b35051e2ba55236a89c013359c0e36df27af50f133cd223b665f430f960cce0; artifact_sha256: f04c92d85381a93b4b5735b75000df6fc22c0142ec68d90b792975a1b86487ec; input_dataset_sha256: {datasets/roman_esco_fractal_inflorescence/paper_citations.bib=4906c890ff71618e..., datasets/roman_esco_fractal_inflorescence/roman_esco_fractal_inflorescence_reference.json=b580780d055808ce..., datasets/roman_esco_fractal_inflorescence/romanesco_brassica_oleracea_specimen.jpg=5fba6c320b478d6c..., datasets/roman_esco_fractal_inflorescence/scout_manifest.json=d684b2df5ef44398...}" ;
        pk:derivedFromPaper <https://doi.org/10.1105/tpc.2.8.755>,
            <https://doi.org/10.1126/science.1140429>,
            <https://doi.org/10.1126/science.7824951>,
            <https://doi.org/10.1126/science.abg5935> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-specimen-match> ;
        pk:weightOfEvidence "0.528"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/8871db0/2021-pringle-roman-esco-fractal-inflorescence.py> a schema:SoftwareSourceCode ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pringle-roman-esco-fractal-inflorescence> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-pringle-roman-esco-fractal-inflorescence-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Azpeitia et al. (2021) & Prusinkiewicz et al. (2007) TFL1-LFY-AP1/CAL-SOC1 floral GRN perturbation and accelerating plastochron Romanesco fractal inflorescence morphogenesis — Morphometric validation: 52/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Reports only 2 analytical numbers in `measure_morphoeval()` without GRN steady-state validation, 3D fractal dimension D_f, Fibonacci parastichy contact numbers, Pearson correlations/p-values across the plastochron sweep, or specimen CV metrics." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2021-pringle-roman-esco-fractal-inflorescence.py L42–L56: Only 2 analytical values without uncertainty, p-values, or empirical specimen comparison <https://github.com/fractastical/morpholib/blob/8871db0/2021-pringle-roman-esco-fractal-inflorescence.py#L42-L56>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-cone-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-primordia-at-t20> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-cone-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "romanesco_cone_aspect_ratio = 1.4797000000000002 ratio" ;
        schema:measurementTechnique "Linear aspect ratio fit in beta" ;
        schema:name "romanesco_cone_aspect_ratio" ;
        schema:unitText "ratio" ;
        schema:value "1.4797000000000002" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-cone-aspect-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-cone-aspect-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 4" ;
        schema:value "1.48" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-primordia-at-t20> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "romanesco_primordia_at_T20 = 37.0 count" ;
        schema:measurementTechnique "1D analytical polynomial r0*T + 0.5*beta*T^2" ;
        schema:name "romanesco_primordia_at_T20" ;
        schema:unitText "count" ;
        schema:value "37.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-primordia-at-t20-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pringle-roman-esco-fractal-inflorescence-measurement-romanesco-primordia-at-t20-reference> a schema:PropertyValue ;
        dcterms:source "Azpeitia et al. (2021) Science 373:192-197 Fig. 3" ;
        schema:value "37.0" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 040 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


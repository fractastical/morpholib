sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-shyer-intestinal-villi-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2011) PRL & Shyer et al. (2013) Science sequential smooth-muscle mucosal buckling into ridges, zigzags, and hexagonal villi — Parameter expressivity: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Spans 6 Chick ontogenetic stages (E6-E16, L423-475), 12 developmental points across 3 vertebrate species (Chick, Quail, Mouse, L478-528), 5 FK506 and surgical smooth-muscle ablation conditions (FK506@E6, Surgical Slit@E10, FK506@E11, FK506@E14, WT@E16, L531-570), and exposes `--epsilon-x`, `--epsilon-y`, `--alpha3`, `--E-ratio-scale`, and `--seed` CLI overrides (L1145-1174)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-parameter-expressivity-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L423–L570" ;
        dct:description "6-stage Chick ontogeny, 12-point 3-species collapse, and 5-condition FK506/surgical ablation sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2013-shyer-intestinal-villi-buckling.py#L423-L570> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L1145–L1174" ;
        dct:description "CLI parameter overrides wired into evaluate_chick_stages and figure rendering" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2013-shyer-intestinal-villi-buckling.py#L1145-L1174> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 063 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


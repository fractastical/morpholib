sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-shyer-intestinal-villi-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2011) PRL & Shyer et al. (2013) Science sequential smooth-muscle mucosal buckling into ridges, zigzags, and hexagonal villi — Morphometric validation: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L976-1081) computes 9 reference-anchored morphometric measurements with uncertainty and statistical tests: 3-species wavelength Pearson r = 0.9996 (p = 1.6e-16, RMSE = 0.68 um), log-log scaling exponent alpha = 0.9571 ± 0.0085 (ref 1.0), Chick E10 ridge wavelength 119.28 um (ref 118.0 um), Chick E14 zigzag chevron angle 38.50 deg (ref 38.5 deg), Chick E16 hexagonal villus spacing 81.34 um (ref 82.0 um), E16 hexagonal order |Psi_6| = 0.7800 (ref 0.78), FK506@E6 ablation amplitude 0.0000 um (ref 0.0 um), specimen Delaunay coordination Z = 5.5517 (ref 6.0), and specimen spacing CV = 0.2441 (ref 0.22)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-3-species-mucosal-buckling-wavelength-scaling-correlation-chick-quail-mouse>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e10-1d-parallel-longitudinal-ridge-wavelength-lambda-sim>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e14-2d-herringbone-zigzag-chevron-half-angle-theta-zz-sim>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-hexagonal-villi-bond-orientational-order-psi-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-hexagonal-villi-spacing-lambda-sim>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-cross-species-log-log-quartic-length-scale-exponent-alpha-lambda-ell-alpha>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-fk506-e6-circular-smooth-muscle-ablation-negative-control-amplitude>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-histology-specimen-delaunay-interior-hexagonal-coordination-number-z-intestinal-villi-crypts-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-histology-specimen-inter-villus-spacing-coefficient-of-variation-cv>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-3-species-mucosal-buckling-wavelength-scaling-correlation-chick-quail-mouse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3-species mucosal buckling wavelength scaling correlation (Chick, Quail, Mouse) = 0.9996 Pearson r" ;
        dct:description "RMSE = 1.13 um, p=1.01e-16" ;
        schema:measurementTechnique "Linear regression of predicted 2*pi*c_lambda*(B_e/K_s)^(1/4) vs observed wavelength across 12 stages in 3 vertebrates (p=1.01e-16, RMSE=1.13 um)" ;
        schema:name "3-species mucosal buckling wavelength scaling correlation (Chick, Quail, Mouse)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9996" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-3-species-mucosal-buckling-wavelength-scaling-correlation-chick-quail-mouse-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-3-species-mucosal-buckling-wavelength-scaling-correlation-chick-quail-mouse-reference> a schema:PropertyValue ;
        dct:source "Hannezo, Prost & Joanny (2011) PRL 107:078104 Eq. (8) & Shyer et al. (2013) Science 342:212-218" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e10-1d-parallel-longitudinal-ridge-wavelength-lambda-sim> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chick E10 1D parallel longitudinal ridge wavelength lambda_sim = 119.28 um" ;
        dct:description "simulated ridge count = 12 vs ref 12" ;
        schema:measurementTechnique "L-BFGS-B Föppl-von Kármán energy minimization under circular smooth-muscle compression at Chick E10 (epsilon_x=0.36)" ;
        schema:name "Chick E10 1D parallel longitudinal ridge wavelength lambda_sim" ;
        schema:unitText "um" ;
        schema:value "119.28" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e10-1d-parallel-longitudinal-ridge-wavelength-lambda-sim-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e10-1d-parallel-longitudinal-ridge-wavelength-lambda-sim-reference> a schema:PropertyValue ;
        dct:source "Shyer et al. (2013) Science 342:212-218 Fig. 1 (Chick E10 parallel ridges, N_ridges=12)" ;
        schema:value "118.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e14-2d-herringbone-zigzag-chevron-half-angle-theta-zz-sim> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chick E14 2D herringbone zigzag chevron half-angle theta_zz_sim = 38.5 deg" ;
        dct:description "FK506@E11 longitudinal block arrests angle at 0.0 deg (ridges)" ;
        schema:measurementTechnique "Biaxial Föppl-von Kármán energy minimization under circular + outer longitudinal smooth muscle at Chick E14 (epsilon_x=0.50, epsilon_y=0.36)" ;
        schema:name "Chick E14 2D herringbone zigzag chevron half-angle theta_zz_sim" ;
        schema:unitText "deg" ;
        schema:value "38.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e14-2d-herringbone-zigzag-chevron-half-angle-theta-zz-sim-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e14-2d-herringbone-zigzag-chevron-half-angle-theta-zz-sim-reference> a schema:PropertyValue ;
        dct:source "Shyer et al. (2013) Science 342:212-218 Fig. 1 & Fig. 3 (Chick E14 herringbone zigzags, 38.5 deg)" ;
        schema:value "38.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-hexagonal-villi-bond-orientational-order-psi-6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chick E16 hexagonal villi bond-orientational order |Psi_6| = 0.78 |Psi_6|" ;
        dct:description "FK506@E14 inner-muscle block reduces |Psi_6| to 0.32 (arrested at zigzags)" ;
        schema:measurementTechnique "6-fold bond-orientational order parameter of L-BFGS-B relaxed E16 villus array vs FK506@E14 zigzag arrest control" ;
        schema:name "Chick E16 hexagonal villi bond-orientational order |Psi_6|" ;
        schema:unitText "|Psi_6|" ;
        schema:value "0.78" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-hexagonal-villi-bond-orientational-order-psi-6-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-hexagonal-villi-bond-orientational-order-psi-6-reference> a schema:PropertyValue ;
        dct:source "Shyer et al. (2013) Science 342:212-218 Fig. 4 (hexagonal villus array)" ;
        schema:value "0.78" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-hexagonal-villi-spacing-lambda-sim> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chick E16 hexagonal villi spacing lambda_sim = 81.34 um" ;
        dct:description "villus tip = +96.0 um, crypt depth = -49.0 um" ;
        schema:measurementTechnique "L-BFGS-B Föppl-von Kármán hexagonal triad energy minimization at Chick E16 (epsilon_x=0.58, epsilon_y=0.54, alpha_3=1.35)" ;
        schema:name "Chick E16 hexagonal villi spacing lambda_sim" ;
        schema:unitText "um" ;
        schema:value "81.34" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-hexagonal-villi-spacing-lambda-sim-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-chick-e16-hexagonal-villi-spacing-lambda-sim-reference> a schema:PropertyValue ;
        dct:source "Shyer et al. (2013) Science 342:212-218 Fig. 1 & Fig. 4 (Chick E16 hexagonal villi, 82.0 um)" ;
        schema:value "82.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-cross-species-log-log-quartic-length-scale-exponent-alpha-lambda-ell-alpha> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cross-species log-log quartic length-scale exponent alpha (lambda ~ ell_*^alpha) = 0.9567 exponent" ;
        dct:description "SE = 0.0074" ;
        schema:measurementTechnique "Log-log OLS slope of log(lambda_obs) vs log((B_e/K_s)^(1/4)) across 12 vertebrate stages (SE ± 0.0074)" ;
        schema:name "Cross-species log-log quartic length-scale exponent alpha (lambda ~ ell_*^alpha)" ;
        schema:unitText "exponent" ;
        schema:value "0.9567" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-cross-species-log-log-quartic-length-scale-exponent-alpha-lambda-ell-alpha-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-cross-species-log-log-quartic-length-scale-exponent-alpha-lambda-ell-alpha-reference> a schema:PropertyValue ;
        dct:source "Hannezo et al. (2011) PRL 107:078104 & Shyer et al. (2013) Science 342:212-218 (lambda ~ ell_*^1.0)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-fk506-e6-circular-smooth-muscle-ablation-negative-control-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FK506 E6 circular smooth-muscle ablation negative control amplitude = 0.0 um" ;
        dct:description "FK506@E6 ridges = 0 vs wild-type E10 amplitude = 62.0 um" ;
        schema:measurementTechnique "L-BFGS-B FvK relaxation under FK506 circular muscle inhibition at E6 (epsilon_x=0.04 < epsilon_c1) vs wild-type E10 ridges" ;
        schema:name "FK506 E6 circular smooth-muscle ablation negative control amplitude" ;
        schema:unitText "um" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-fk506-e6-circular-smooth-muscle-ablation-negative-control-amplitude-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-fk506-e6-circular-smooth-muscle-ablation-negative-control-amplitude-reference> a schema:PropertyValue ;
        dct:source "Shyer et al. (2013) Science 342:212-218 Fig. 2 (blocking circular muscle prevents ridge buckling)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-histology-specimen-delaunay-interior-hexagonal-coordination-number-z-intestinal-villi-crypts-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Histology specimen Delaunay interior hexagonal coordination number Z (intestinal_villi_crypts_specimen.jpg) = 5.5517 neighbors Z" ;
        dct:description "specimen |Psi_6| = 0.5089" ;
        schema:measurementTechnique "Interior Delaunay triangulation coordination number across n=37 segmented intestinal villi in CC0 histology micrograph" ;
        schema:name "Histology specimen Delaunay interior hexagonal coordination number Z (intestinal_villi_crypts_specimen.jpg)" ;
        schema:unitText "neighbors Z" ;
        schema:value "5.5517" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-histology-specimen-delaunay-interior-hexagonal-coordination-number-z-intestinal-villi-crypts-specimen-jpg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-histology-specimen-delaunay-interior-hexagonal-coordination-number-z-intestinal-villi-crypts-specimen-jpg-reference> a schema:PropertyValue ;
        dct:source "Hannezo et al. (2011) PRL 107:078104 & Shyer et al. (2013) Science 342:212-218 (hexagonal packing Z = 6)" ;
        schema:value "6.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-histology-specimen-inter-villus-spacing-coefficient-of-variation-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Histology specimen inter-villus spacing coefficient of variation CV = 0.2441 CV (std/mean)" ;
        dct:description "spacing = 112.16 ± 27.38 px" ;
        schema:measurementTechnique "Delaunay nearest-neighbor inter-villus center spacing dispersion across n=37 villi (mean = 112.16 px)" ;
        schema:name "Histology specimen inter-villus spacing coefficient of variation CV" ;
        schema:unitText "CV (std/mean)" ;
        schema:value "0.2441" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-histology-specimen-inter-villus-spacing-coefficient-of-variation-cv-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-measurement-histology-specimen-inter-villus-spacing-coefficient-of-variation-cv-reference> a schema:PropertyValue ;
        dct:source "Shyer et al. (2013) Science 342:212-218 Fig. 1 & Fig. 4 regular hexagonal villus array (CV < 0.25)" ;
        schema:value "0.22" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L976–L1081" ;
        dct:description "9 quantitative morphometric measurements with p-values, RMSE, SE, Delaunay Z, |Psi_6|, and FK506 negative-control deltas" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2013-shyer-intestinal-villi-buckling.py#L976-L1081> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 063 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-shyer-intestinal-villi-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2011) PRL & Shyer et al. (2013) Science sequential smooth-muscle mucosal buckling into ridges, zigzags, and hexagonal villi — Morphological realism / specimen match: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the CC0 transverse H&E histological micrograph `datasets/epithelial_buckling_crypt_villus/intestinal_villi_crypts_specimen.jpg`, segments n = 37 intestinal villi in cross-section (`segment_intestinal_villi_specimen`, L576-658), constructs the Delaunay neighborhood graph yielding interior hexagonal coordination number Z = 5.5517 (ref 6.0), bond-orientational order |Psi_6| = 0.5090, and inter-villus spacing CV = 0.2441, and matches all 12 empirical points across Chick, Quail, and Mouse (r = 0.9996)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L576–L658" ;
        dcterms:description "DoG centroid detection + Delaunay hexagonal coordination Z and |Psi_6| analysis on intestinal_villi_crypts_specimen.jpg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2013-shyer-intestinal-villi-buckling.py#L576-L658> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/epithelial_buckling_crypt_villus_comparison.png (generated output)" ;
        dcterms:description "6-panel synthesis figure comparing FvK cascade, 3-species collapse, FK506/slit controls, specimen Delaunay graph, and villus/crypt cross-section — docs/media/epithelial_buckling_crypt_villus_comparison.png: rendered output of 2013-shyer-intestinal-villi-buckling.py at e93f00e, image/png, 1085993 B, 2145×1412 px, artifact_sha256 45b455c27e8f12942e6ab7a976cb0b3ecfa1ebb241f2f74af193d1b10155ec23 (sha256 45b455c27e8f12942e6ab7a976cb0b3ecfa1ebb241f2f74af193d1b10155ec23), spec_fingerprint f6a04e7da51440cd41541428ef80cd7b7e9f5332411d929e37970e56635d68c5" .


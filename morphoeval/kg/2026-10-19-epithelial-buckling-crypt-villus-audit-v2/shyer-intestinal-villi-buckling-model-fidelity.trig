    <https://doi.org/10.1073/pnas.1205669109> dct:date "2012"^^xsd:gYear ;
        dct:title "Hedgehog-responsive mesenchymal clusters direct patterned epithelial folding in the developing mouse intestine" .
    <https://doi.org/10.1103/PhysRevLett.107.078104> dct:date "2011"^^xsd:gYear ;
        dct:title "Instabilities of monolayered epithelia: coupled bending and polarity-driven forces" .
    <https://doi.org/10.1103/PhysRevLett.110.024302> dct:date "2013"^^xsd:gYear ;
        dct:title "Surface sulci in squeezed slabs" .
    <https://doi.org/10.1126/science.1238842> dct:date "2013"^^xsd:gYear ;
        dct:title "Villification: how the gut gets its villi" .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-shyer-intestinal-villi-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-shyer-intestinal-villi-buckling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2011) PRL & Shyer et al. (2013) Science sequential smooth-muscle mucosal buckling into ridges, zigzags, and hexagonal villi — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements Hannezo, Prost & Joanny's (2011) PRL and Shyer et al.'s (2013) Science mucosal bending rigidity B_e = E_e*h_e^3/(12*(1-nu^2)), Winkler foundation stiffness K_s = E_s/H_s, quartic characteristic length ell_* = (B_e/K_s)^(1/4) (L147-202), and a 2D pseudo-spectral L-BFGS-B Föppl-von Kármán free-energy minimizer (`relax_fvk_mucosal_surface`, L205-416) with all 5 FK506/surgical smooth-muscle ablation controls (L531-570), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_063_epithelial_buckling_crypt_villus.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L147–L202" ;
        dct:description "Exact mucosal bending rigidity B_e, foundation stiffness K_s, quartic length ell_*, and regime classifier" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2013-shyer-intestinal-villi-buckling.py#L147-L202> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2013-shyer-intestinal-villi-buckling.py L205–L416" ;
        dct:description "2D pseudo-spectral + L-BFGS-B Föppl-von Kármán mucosal energy minimizer across smooth, ridge, zigzag, and hexagonal villus regimes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2013-shyer-intestinal-villi-buckling.py#L205-L416> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-shyer-intestinal-villi-buckling-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_063_epithelial_buckling_crypt_villus.lean L13–L102" ;
        dct:description "3 machine-checked Lean 4 theorems for quartic wavenumber stationarity, sequential FK506 arrest hierarchy, and hexagonal triad closure (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_063_epithelial_buckling_crypt_villus.lean#L13-L102> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 063 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


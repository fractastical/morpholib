sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-baker-fgf-wnt-bistable-wavefront> a pk:Claim ;
        rdfs:label "Goldbeter, Gonze & Pourquié (2007) / Baker, Schnell & Maini (2006) RA–FGF8/Wnt mutual cross-inhibition bistable determination wavefront in vertebrate somitogenesis faithfully reproduces Gallus gallus (chick embryo presomitic mesoderm & paraxial somites) morphology" ;
        dct:description "The simulation script(s) 2012-baker-fgf-wnt-bistable-wavefront.py implement the cited source model as published and produce forms that match real Gallus gallus (chick embryo presomitic mesoderm & paraxial somites) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 59.5/100, audit 2026-10-19-fgf-wnt-bistable-wavefront-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2012-baker-fgf-wnt-bistable-wavefront.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2012-baker-fgf-wnt-bistable-wavefront.py; output: docs/media/fgf_wnt_bistable_wavefront_comparison.png; organism: Gallus gallus (chick embryo presomitic mesoderm & paraxial somites); checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 067326af3885ea73d93878ed07f29a5a29f47fffe07fbd95bba8a7110f414601; artifact_sha256: 499ddc7eed5384bbf4d6f0118814a3c67b19b1d52d6608fcfe526a0864146bde; input_dataset_sha256: {datasets/fgf_wnt_bistable_wavefront/chick_ra_fgf_somites_specimen.jpg=8b80971796cb29e2..., datasets/fgf_wnt_bistable_wavefront/fgf_wnt_bistable_wavefront_reference.json=42c6196ddd32cee9..., datasets/fgf_wnt_bistable_wavefront/scout_manifest.json=783faa9ee6b3db0c...}" ;
        pk:derivedFromPaper <https://doi.org/10.1002/dvdy.21193>,
            <https://doi.org/10.1016/S0896-6273(03)00565-8>,
            <https://doi.org/10.1016/j.devcel.2007.05.015>,
            <https://doi.org/10.1016/j.jtbi.2005.07.019>,
            <https://doi.org/10.1016/j.ydbio.2006.01.018>,
            <https://doi.org/10.1038/nature03488> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-specimen-match> ;
        pk:weightOfEvidence "0.595"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/317bc3c/2012-baker-fgf-wnt-bistable-wavefront.py> a schema:SoftwareSourceCode ;
        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "317bc3c" .
}


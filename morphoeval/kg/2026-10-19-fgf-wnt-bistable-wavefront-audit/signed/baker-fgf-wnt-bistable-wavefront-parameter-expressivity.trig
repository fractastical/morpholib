sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-baker-fgf-wnt-bistable-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Goldbeter, Gonze & Pourquié (2007) / Baker, Schnell & Maini (2006) RA–FGF8/Wnt mutual cross-inhibition bistable determination wavefront in vertebrate somitogenesis — Parameter expressivity: 60/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Covers canonical Goldbeter et al. (2007) chick PSM parameters (v_sc = 0.25 nM/min, k_d1 = 1.0 min^-1, k_d2 = 0.10 min^-1, K_a = K_I = 0.2 nM, n = m = 2), but needs all 5 experimental regimes (wild-type, VAD Raldh2 attenuation, exogenous RA, SU5402 FGFR1 inhibition, and ectopic FGF8 bead) plus CYP26-null monostable and constitutive-FGF negative controls." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2012-baker-fgf-wnt-bistable-wavefront.py L320–L435: 5-regime RA/FGF8 perturbation evaluator and somitogenesis simulator <https://github.com/fractastical/morpholib/blob/317bc3c/2012-baker-fgf-wnt-bistable-wavefront.py#L320-L435>" ;
        pk:hasScore "0.6"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

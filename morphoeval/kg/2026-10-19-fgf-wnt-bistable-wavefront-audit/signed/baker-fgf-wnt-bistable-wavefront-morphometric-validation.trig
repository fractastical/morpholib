sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-baker-fgf-wnt-bistable-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-chick-psm-bistable-determination-front-position-x-front-and-10-90-switch-width> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chick PSM bistable determination front position x_front and 10-90% switch width = 571.46 um" ;
        dcterms:description "wild-type somite length S_0 = 150.0 um; constitutive-FGF control forms 0 somites" ;
        schema:measurementTechnique "1D coupled RA-FGF8/Wnt reaction-diffusion PDE steady state (10-90% jump width Delta_x_front=16.22 um vs exponential decay length lambda_M=360.67 um, 22.2x sharpening)" ;
        schema:name "chick PSM bistable determination front position x_front and 10-90% switch width" ;
        schema:unitText "um" ;
        schema:value "571.46" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-chick-psm-bistable-determination-front-position-x-front-and-10-90-switch-width-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-chick-psm-bistable-determination-front-position-x-front-and-10-90-switch-width-reference> a schema:PropertyValue ;
        dcterms:source "Goldbeter, Gonze & Pourquie (2007) Dev. Cell / Dev. Dyn. 236:1495-1508 Fig. 4 & Baker et al. (2006) J. Theor. Biol. 239:413-429" ;
        schema:value "571.61" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-chick-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chick/vertebrate embryo SEM specimen bilateral somite spacing S_obs = 48.4667 px" ;
        dcterms:description "bilateral symmetry ratio = 0.9606, std = 9.70 px, phase correlation r = 0.5629" ;
        schema:measurementTechnique "bilateral dorsal somite row DoG peak segmentation on chick_ra_fgf_somites_specimen.jpg (upper=8 somites, lower=9 somites, CV=0.2002)" ;
        schema:name "chick/vertebrate embryo SEM specimen bilateral somite spacing S_obs" ;
        schema:unitText "px" ;
        schema:value "48.4667" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-chick-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-chick-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs-reference> a schema:PropertyValue ;
        dcterms:source "Vendored CC BY 4.0 avian/vertebrate embryo SEM specimen (datasets/fgf_wnt_bistable_wavefront/chick_ra_fgf_somites_specimen.jpg)" ;
        schema:value "48.47" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-goldbeter-baker-5-regime-ra-fgf-perturbation-somite-length-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Goldbeter-Baker 5-regime RA/FGF perturbation somite length Pearson correlation r = 1.0 Pearson r" ;
        dcterms:description "p = 4.96e-08, RMSE = 0.806 um across [98, 214] um somite range" ;
        schema:measurementTechnique "correlation across 5 RA/FGF8/Wnt perturbation regimes (WT, VAD, exogenous RA, SU5402 FGFR1 block, ectopic FGF8 bead; RMSE=0.806 um)" ;
        schema:name "Goldbeter-Baker 5-regime RA/FGF perturbation somite length Pearson correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-goldbeter-baker-5-regime-ra-fgf-perturbation-somite-length-pearson-correlation-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-goldbeter-baker-5-regime-ra-fgf-perturbation-somite-length-pearson-correlation-r-reference> a schema:PropertyValue ;
        dcterms:source "Goldbeter et al. (2007) Dev. Dyn. 236:1495-1508; Diez del Corral et al. (2003) Neuron 40:65-79; Dubrulle et al. (2001) Cell 106:219-232" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-ra-fgf8-wnt-saddle-node-bistable-hysteresis-window-width-delta-m-m-2-m-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "RA-FGF8/Wnt saddle-node bistable hysteresis window width Delta_M = M_2 - M_1 = 2.2784 nM" ;
        dcterms:description "ratio M_2/M_1 = 3.222; plateau kinetic residual = 0.000000" ;
        schema:measurementTechnique "analytical inverse hysteresis S-curve M(F) saddle-node extrema (M_1=1.0254 nM at F_1=0.2524 nM, M_2=3.3038 nM at F_2=0.0384 nM; CYP26-null monostable control Delta_M=0.00 nM)" ;
        schema:name "RA-FGF8/Wnt saddle-node bistable hysteresis window width Delta_M = M_2 - M_1" ;
        schema:unitText "nM" ;
        schema:value "2.2784" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-ra-fgf8-wnt-saddle-node-bistable-hysteresis-window-width-delta-m-m-2-m-1-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-ra-fgf8-wnt-saddle-node-bistable-hysteresis-window-width-delta-m-m-2-m-1-reference> a schema:PropertyValue ;
        dcterms:source "Goldbeter, Gonze & Pourquie (2007) Dev. Cell / Dev. Dyn. 236:1495-1508 Figs. 2-3 (bistable hysteresis window between M_1 and M_2)" ;
        schema:value "2.2784" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-vitamin-a-deficiency-vad-anterior-wavefront-shift-compressed-somite-length-s-vad> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Vitamin A Deficiency (VAD) anterior wavefront shift compressed somite length S_VAD = 105.0 um" ;
        dcterms:description "opposing exogenous RA enlarged somite S_RA = 195.00 um (obs 194.0 um); symmetric pair sum S_VAD + S_RA = 300.0 um = 2*S_0" ;
        schema:measurementTechnique "RALDH2/RA attenuation (v_sc = 0.08 nM/min) lowering M_1 to 0.432 nM and shifting x_front anteriorly (+45.0 um/cycle)" ;
        schema:name "Vitamin A Deficiency (VAD) anterior wavefront shift compressed somite length S_VAD" ;
        schema:unitText "um" ;
        schema:value "105.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-vitamin-a-deficiency-vad-anterior-wavefront-shift-compressed-somite-length-s-vad-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-vitamin-a-deficiency-vad-anterior-wavefront-shift-compressed-somite-length-s-vad-reference> a schema:PropertyValue ;
        dcterms:source "Diez del Corral et al. (2003) Neuron 40:65-79; Vermot & Pourquie (2005) Nature 435:215-220; Goldbeter et al. (2007) Fig. 5 (VAD smaller somites)" ;
        schema:value "106.0" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Goldbeter, Gonze & Pourquié (2007) / Baker, Schnell & Maini (2006) RA–FGF8/Wnt mutual cross-inhibition bistable determination wavefront in vertebrate somitogenesis — Morphometric validation: 55/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Extracts saddle-node hysteresis width Delta_M = 2.2784 nM, but Pass 1 requires full 5-regime Pearson correlation r and RMSE against experimental somite lengths plus 10-90% bistable front width Delta_x_front and bilateral specimen spacing CV." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2012-baker-fgf-wnt-bistable-wavefront.py L520–L600: MorphoEval measurement hook measure_morphoeval() <https://github.com/fractastical/morpholib/blob/317bc3c/2012-baker-fgf-wnt-bistable-wavefront.py#L520-L600>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-chick-psm-bistable-determination-front-position-x-front-and-10-90-switch-width>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-chick-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs>,

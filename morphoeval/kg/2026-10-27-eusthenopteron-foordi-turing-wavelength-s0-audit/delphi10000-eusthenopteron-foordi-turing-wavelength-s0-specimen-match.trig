        dct:description "Side-by-side mount, mask, and field — docs/media/eusthenopteron_foordi_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-eusthenopteron-foordi-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/png, 631334 B, 1584×888 px, artifact_sha256 721d8d4672825d003f90b6fdfb105ec4274bfb531a752756f483adad178cf1c5 (sha256 721d8d4672825d003f90b6fdfb105ec4274bfb531a752756f483adad178cf1c5), spec_fingerprint 7d5c5c4a83fa8f6c063e1e197796aa4e97931ea29ced33c300363ee59ac62e99" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;

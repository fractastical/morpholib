sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Turing k_c at 104 µm on Eusthenopteron foordi (Frasnian, 379 Ma) — Morphological realism / specimen match: 76/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The comparison figure places the real Brussels mount beside the segmented body. Pass 1 does not yet credit the ocellus tint as a specimen match, because fossil color is not preserved." ;

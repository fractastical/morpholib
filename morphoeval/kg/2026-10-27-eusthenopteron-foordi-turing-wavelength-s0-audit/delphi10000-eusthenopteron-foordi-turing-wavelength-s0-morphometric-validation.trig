}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Turing k_c at 104 µm on Eusthenopteron foordi (Frasnian, 379 Ma) — Morphometric validation: 80/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "A wavelength is reported (102.0 µm versus formula 104.2 µm). Pass 1 still requires the Pearson/RMSE dispersion table, the KS orientation test, and the mask aspect to be the scored comparison." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-ocellus-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-pattern-versus-ablated-autocatalysis-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-pattern-versus-equal-diffusion-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-contour-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-mask-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-orientation-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-wavelength-sweep-spearman-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-ocellus-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ocellus_wavelength_um = 102.00978980708321 µm" ;
        schema:measurementTechnique "Radial FFT peak of the saturated Schnakenberg field, converted by the 104.2 µm formula-wavelength unit" ;
        schema:name "ocellus_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "102.00978980708321" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-ocellus-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-ocellus-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "Formula λ_c = 2π/k_c. The realized peak sits slightly off onset, so value ≠ reference" ;
        schema:value "104.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-pattern-versus-ablated-autocatalysis-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pattern_versus_ablated_autocatalysis_std_ratio = 483305978204.98065 1" ;
        schema:measurementTechnique "std(u) of the full model divided by std(u) after dropping u²v autocatalysis" ;
        schema:name "pattern_versus_ablated_autocatalysis_std_ratio" ;
        schema:unitText "1" ;
        schema:value "483305978204.98065" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-pattern-versus-ablated-autocatalysis-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-pattern-versus-ablated-autocatalysis-std-ratio-reference> a schema:PropertyValue ;
        dct:source "Ablation removes the Schnakenberg feedback; residual std is relaxation, not spots" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-pattern-versus-equal-diffusion-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pattern_versus_equal_diffusion_std_ratio = 286241.3553406803 1" ;
        schema:measurementTechnique "std(u) of the Turing run divided by std(u) of the equal-diffusion negative control" ;
        schema:name "pattern_versus_equal_diffusion_std_ratio" ;
        schema:unitText "1" ;
        schema:value "286241.3553406803" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-pattern-versus-equal-diffusion-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-pattern-versus-equal-diffusion-std-ratio-reference> a schema:PropertyValue ;
        dct:source "Equal diffusion is the Turing-negative control; ratio near 1 would mean the control still patterned" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-contour-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_aspect_ratio = 3.6198347107438016 1" ;
        schema:measurementTechnique "Bounding-box width/height of the dark fossil body segmented from the Brussels mount" ;
        schema:name "specimen_contour_aspect_ratio" ;
        schema:unitText "1" ;
        schema:value "3.6198347107438016" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-contour-aspect-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-contour-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "Reference is the same measurement on the species-gallery life reconstruction, a different image" ;
        schema:value "3.9055555555555554" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_dispersion_pearson_r = 0.9999997928438427 1" ;
        schema:measurementTechnique "Pearson r between analytical Turing σ(k) and a linearized Fourier step on the real-eigenvalue band" ;
        schema:name "specimen_dispersion_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.9999997928438427" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 dispersion relation; value is the solver residual against that curve, not a copy of the reference" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_dispersion_rmse = 0.0026052316732888803 1/time" ;
        schema:measurementTechnique "RMSE of numerical versus analytical growth rates σ(k)" ;
        schema:name "specimen_dispersion_rmse" ;
        schema:unitText "1/time" ;
        schema:value "0.0026052316732888803" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "Zero would be a perfect match; the solver leaves a small splitting residual" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-mask-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_mask_circularity = 0.18330998977798435 1" ;
        schema:measurementTechnique "4πA/P² of the segmented fossil body" ;
        schema:name "specimen_mask_circularity" ;
        schema:unitText "1" ;
        schema:value "0.18330998977798435" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-mask-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-mask-circularity-reference> a schema:PropertyValue ;
        dct:source "Gallery reconstruction circularity, measured independently" ;
        schema:value "0.2117580600263819" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-orientation-ks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_orientation_ks = 0.02400000000000002 1" ;
        schema:measurementTechnique "Two-sample KS statistic of Sobel orientations, fossil crop versus last GIF frame" ;
        schema:name "specimen_orientation_ks" ;
        schema:unitText "1" ;
        schema:value "0.02400000000000002" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-orientation-ks-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-specimen-orientation-ks-reference> a schema:PropertyValue ;
        dct:source "KS = 0 would mean identical orientation samples; the overlay does not reproduce every bone edge" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-wavelength-sweep-spearman-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength_sweep_spearman_r = 0.8999999999999998 1" ;
        schema:measurementTechnique "Spearman rank correlation of realized λ against Dv/Du over the sweep" ;
        schema:name "wavelength_sweep_spearman_r" ;
        schema:unitText "1" ;
        schema:value "0.8999999999999998" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-wavelength-sweep-spearman-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-measurement-wavelength-sweep-spearman-r-reference> a schema:PropertyValue ;
        dct:source "Zero would be no rank association; the sweep is the expressivity check" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eusthenopteron-foordi-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-eusthenopteron-foordi-turing-wavelength-s0.py L161–L176" ;
        dct:description "dominant_frequency" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-eusthenopteron-foordi-turing-wavelength-s0.py#L161-L176> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1017/S008045680001471X>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1017/S008045680001471X> dct:title "The postcranial skeleton of Eusthenopteron foordi Whiteaves" .
    <https://doi.org/10.1038/376765a0> dct:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
}


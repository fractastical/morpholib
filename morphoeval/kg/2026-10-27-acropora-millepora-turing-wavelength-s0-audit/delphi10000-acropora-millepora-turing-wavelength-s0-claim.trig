sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Acropora millepora Holocene Turing wavenumber at 385.2 µm (pass 1) faithfully reproduces Acropora millepora morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py, docs/media/acropora_millepora_turing_wavelength_s0_growth.gif implement the cited source model as published and produce forms that match real Acropora millepora specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/media/acropora_millepora_turing_wavelength_s0_growth.gif>,
            <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py, https://github.com/fractastical/morpholib/blob/main/docs/media/acropora_millepora_turing_wavelength_s0_growth.gif; output: docs/media/acropora_millepora_turing_wavelength_s0_comparison.png; organism: Acropora millepora; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion relation for a two-species reaction-diffusion system. | Schnakenberg 1979 kinetics du/dt = a - u + u^2 v, dv/dt = b - u^2 v. | Dove et al. 2001: reef-coral colour patterns are GFP-like host proteins. | Lundgren et al. 2013: the CC BY 4.0 Great Barrier Reef colony photograph. | Wallace and Rosen 2006: Eocene Acropora skeletal diversity, out of this chronoseries.; reconstructed_in_script: D_u chosen so argmax σ(k) equals 2π/385.2 µm at diffusivity ratio 15.75. | Eight-wavelength periodic patch, seed 3104, explicit Euler. | Nonlinear FFT wavelength and the eight-point diffusivity sweep.; transfer_boundary: 385.2 µm is the assigned primordium-tier detail scale (log10 = -3.414), not a published caliper spacing of A. millepora pigment stripes. | The colony photograph is the computer-vision target. It does not resolve 385 µm.; does_not_claim: That 385.2 µm was measured on a micrograph of Acropora millepora. | That the spot field is a segmentation of the Lundgren colony. | That an in-series chronospecies predecessor or successor exists. The series length is 1, age 0 Ma. | That the Murray band-center wavelength (319.4 µm) is the selected mode.]; phenomenon_size: 461 µm (0.0004608 m, log10=-3.336 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 461 µm to 75.3 cm): 461 µm:acropora-millepora-bioelectric-polarity, 889 µm:acropora-millepora-vertex-packing, 1.7 cm:acropora-millepora-turing-wavelength, 3.1 cm:acropora-millepora-clock-wavefront, 7.1 cm:acropora-millepora-elastic-buckling, 9.8 cm:acropora-millepora-morphogen-condensation, 12.8 cm:acropora-millepora-flux-canalization, 16.9 cm:acropora-millepora-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1007/pl00006956>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1098/rspb.2005.3307>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1186/1471-2156-14-9> .
    <https://github.com/fractastical/morpholib/blob/main/docs/media/acropora_millepora_turing_wavelength_s0_growth.gif> a schema:SoftwareSourceCode ;
        rdfs:label "docs/media/acropora_millepora_turing_wavelength_s0_growth.gif" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1007/pl00006956>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1098/rspb.2005.3307>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1186/1471-2156-14-9> .
    <https://doi.org/10.1007/pl00006956> dct:title "Major colour patterns of reef-building corals are due to a family of GFP-like proteins" .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:title "A pre-pattern formation mechanism for animal coat markings" .
    <https://doi.org/10.1098/rspb.2005.3307> dct:title "Diverse staghorn corals (Acropora) in high-latitude Eocene assemblages" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1186/1471-2156-14-9> dct:title "Genotype-environment correlations in corals from the Great Barrier Reef" .
}


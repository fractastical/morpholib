<https://w3id.org/delphi/resource/math-law/delphi10000-acropora-millepora-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Selected Turing wavenumber" ;
    dct:description "Fastest-growing pigment wavelength on the Holocene coenenchyme patch | Variables: sigma(k) is the larger eigenvalue of J - k^2 D for Schnakenberg kinetics a=0.12, b=0.78" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/morphoeval/lean/loops/Loop_3104_acropora_millepora_turing_wavelength_s0.lean#L32-L34> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c = argmax_{k>0} sigma(k),  lambda_c = 2*pi/k_c = 385.2 um" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/pl00006956>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rspb.2005.3307>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1186/1471-2156-14-9> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3104.lambdaCDeciUm" ;
    pk:leanTheorem "MathOfBiology.Loop_3104.domain_fits_fundamental_mode" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-acropora-millepora-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Inhibitor range above onset" ;
    dct:description "Long-range inhibition required for stripes, spots and ocelli; equal diffusion is stable | Variables: r_onset is the larger root of (r f_u + g_v)^2 = 4 r det(J)" ;
    dct:source "Gierer and Meinhardt 1972 DOI:10.1007/bf00289234" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/morphoeval/lean/loops/Loop_3104_acropora_millepora_turing_wavelength_s0.lean#L36-L39> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_v/D_u = 15.75 > r_onset ≈ 8.08 > 1 (equal-diffusion ablation)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/pl00006956>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rspb.2005.3307>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1186/1471-2156-14-9> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3104.diffRatioHundredths" ;
    pk:leanTheorem "MathOfBiology.Loop_3104.inhibitor_exceeds_onset_and_ablation_does_not" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-acropora-millepora-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Holocene terminal chronoseries node" ;
    dct:description "Nothing in this chronoseries shifts lambda_c; the wavelength is stationary at 0 Ma | Variables: age is Ma before present; the Eocene Acropora record is out of series" ;
    dct:source "Wallace and Rosen 2006 DOI:10.1098/rspb.2005.3307" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/morphoeval/lean/loops/Loop_3104_acropora_millepora_turing_wavelength_s0.lean#L41-L43> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "series_length = 1 and age_Ma = 0; no in-series predecessor or successor" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/pl00006956>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rspb.2005.3307>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1186/1471-2156-14-9> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3104.seriesLength" ;
    pk:leanTheorem "MathOfBiology.Loop_3104.holocene_is_terminal_singleton" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-acropora-millepora-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Primordium-tier membership" ;
    dct:description "Places the ocellus wavelength in tier 5 of 8, detail variant | Variables: length compared in tenths of a micrometre" ;
    dct:source "Dove, Hoegh-Guldberg and Ranganathan 2001 DOI:10.1007/pl00006956" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/morphoeval/lean/loops/Loop_3104_acropora_millepora_turing_wavelength_s0.lean#L46-L48> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "100 um <= 385.2 um <= 1000 um" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/pl00006956>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rspb.2005.3307>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1186/1471-2156-14-9> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3104.lambdaCDeciUm" ;
    pk:leanTheorem "MathOfBiology.Loop_3104.primordium_tier_contains_wavelength" ;
    pk:leanVerified true .


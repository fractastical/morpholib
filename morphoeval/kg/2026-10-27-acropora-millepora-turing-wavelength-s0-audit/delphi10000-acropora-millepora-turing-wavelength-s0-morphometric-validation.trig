sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Acropora millepora Holocene Turing wavenumber at 385.2 µm (pass 1) — Morphometric validation: 78/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "FFT wavelength 383.6 µm versus 385.2 µm, sweep RMSE 4.06 µm, ablation σ_max negative, and specimen coherency 0.427 versus render coherency 0.72 (values differ). Pass 1 does not yet report the orientation KS distance. Nominal D_u is tuned, so the sweep, not the single target point, is the validation." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-ablation-control-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-ablation-control-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-log10-length-m>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-murray-band-center-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-selected-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-wavelength-sweep-rmse-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-ablation-control-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_control_sigma_max = -0.038342 1/time" ;
        schema:measurementTechnique "equal-diffusion negative control D_v = D_u; max_k σ(k) must be negative" ;
        schema:name "ablation_control_sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.038342" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-ablation-control-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-ablation-control-sigma-max-reference> a schema:PropertyValue ;
        dct:source "marginal stability" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-ablation-control-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_control_std_ratio = 0.0476 1" ;
        schema:measurementTechnique "nonlinear ablation control: final/initial std of u with D_v = D_u, seed 3104" ;
        schema:name "ablation_control_std_ratio" ;
        schema:unitText "1" ;
        schema:value "0.0476" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-ablation-control-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-ablation-control-std-ratio-reference> a schema:PropertyValue ;
        dct:source "no growth and no decay of the activator standard deviation" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-log10-length-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "log10_length_m = -3.414314 log10(m)" ;
        schema:measurementTechnique "log10 of the assigned wavelength 3.852e-4 m" ;
        schema:name "log10_length_m" ;
        schema:unitText "log10(m)" ;
        schema:value "-3.414314" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-log10-length-m-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-log10-length-m-reference> a schema:PropertyValue ;
        dct:source "slot assignment log10(3.852e-4 m)" ;
        schema:value "-3.414" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-murray-band-center-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "murray_band_center_wavelength_um = 319.4142 µm" ;
        schema:measurementTechnique "k_Delta^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); above onset this is shorter than argmax σ" ;
        schema:name "murray_band_center_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "319.4142" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-murray-band-center-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-murray-band-center-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "selected-mode target 385.2 µm" ;
        schema:value "385.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-selected-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "selected_wavelength_um = 383.573 µm" ;
        schema:measurementTechnique "radial FFT peak of the saturated activator on the 8-wavelength periodic patch" ;
        schema:name "selected_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "383.573" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-selected-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-selected-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "slot scale 385.2 µm; linear argmax σ is the prediction" ;
        schema:value "385.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_foreground_fraction = 0.55 1" ;
        schema:measurementTechnique "border-contrast segmentation of the colony photograph, same rule as verify_image_fitness" ;
        schema:name "specimen_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.55" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "foreground fraction of the rendered activator field" ;
        schema:value "0.5536" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_structure_tensor_coherency = 0.4267 1" ;
        schema:measurementTechnique "structure-tensor coherency on the Lundgren et al. 2013 colony photograph" ;
        schema:name "specimen_structure_tensor_coherency" ;
        schema:unitText "1" ;
        schema:value "0.4267" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "coherency of the rendered activator field (not the photograph)" ;
        schema:value "0.7179" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength_sweep_pearson_r = 0.999986 1" ;
        schema:measurementTechnique "Pearson r of predicted vs measured wavelength across 8 diffusivity scales; RMSE reported separately" ;
        schema:name "wavelength_sweep_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.999986" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-reference> a schema:PropertyValue ;
        dct:source "perfect agreement between linear theory and the nonlinear FFT" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-wavelength-sweep-rmse-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength_sweep_rmse_um = 4.0615 µm" ;
        schema:measurementTechnique "RMSE between linear-theory wavelength and nonlinear FFT wavelength" ;
        schema:name "wavelength_sweep_rmse_um" ;
        schema:unitText "µm" ;
        schema:value "4.0615" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-wavelength-sweep-rmse-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-measurement-wavelength-sweep-rmse-um-reference> a schema:PropertyValue ;
        dct:source "zero residual against linear theory" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py L197–L215" ;
        dct:description "dominant_wavelength_um radial FFT" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py#L197-L215> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acropora-millepora-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acropora-millepora-turing-wavelength-s0.py L377–L450" ;

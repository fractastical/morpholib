sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ocko-termite-mound-convective-chimneys> a pk:Claim ;
        rdfs:label "King, Ocko & Mahadevan (2015) PNAS, Ocko et al. (2017) PNAS & Ocko, Heyde & Mahadevan (2019) PNAS solar-powered diurnal thermosiphon ventilation and convective pheromone morphogenesis of cathedral termite mounds faithfully reproduces Macrotermes michaelseni / Odontotermes obesus (Fungus-cultivating mound-building termites) morphology" ;
        dcterms:description "The simulation script(s) 2015-ocko-termite-mound-convective-chimneys.py implement the cited source model as published and produce forms that match real Macrotermes michaelseni / Odontotermes obesus (Fungus-cultivating mound-building termites) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 94.3/100, audit 2026-10-19-termite-mound-convective-chimneys-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py; output: docs/media/termite_mound_convective_chimneys_comparison.png; organism: Macrotermes michaelseni / Odontotermes obesus (Fungus-cultivating mound-building termites); checkpoint commit: https://github.com/fractastical/morpholib/commit/e93f00e; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: d09fb37c4086797405dbf184a42b7af11e3ae9291d9bd6946a94bdc2be0204df; artifact_sha256: d49033b52ede8d1fd93cc88cfd1a7aa67db12aaac9cd0f8adc61a6292ba238e0; input_dataset_sha256: {datasets/termite_mound_convective_chimneys/macrotermes_cathedral_mound_specimen.jpg=71ab909aae615390..., datasets/termite_mound_convective_chimneys/paper_citations.bib=21248770fa6f59e6..., datasets/termite_mound_convective_chimneys/scout_manifest.json=cdefb06d8e025efd..., datasets/termite_mound_convective_chimneys/termite_mound_convective_chimneys_reference.json=36184ab6989fedbf...}; supersedes_audit_id: 2026-10-19-termite-mound-convective-chimneys-audit" ;

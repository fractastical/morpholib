sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ocko-termite-mound-convective-chimneys> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "King, Ocko & Mahadevan (2015) PNAS, Ocko et al. (2017) PNAS & Ocko, Heyde & Mahadevan (2019) PNAS solar-powered diurnal thermosiphon ventilation and convective pheromone morphogenesis of cathedral termite mounds — Parameter expressivity: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Spans the 9-point 24-hour diurnal thermosiphon trajectory (L212-263), the 7-point convective Péclet morphogenesis sweep `Pe in [0.0, 4.2]` (L373-419), the 6-point geographic latitude equatorward spire tilt sweep `|phi_lat| in [0.0, 24.0] deg S` (L422-450), 3 species & ablation controls (*Macrotermes michaelseni*, *Odontotermes obesus*, and shaded isothermal dome `Pe = 0`, L453-497), and exposes `--peclet`, `--delta-t-day`, `--latitude-deg`, and `--seed` CLI overrides (L636-664)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-parameter-expressivity-2> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2015-ocko-termite-mound-convective-chimneys.py L212–L497" ;
        dcterms:description "24h diurnal sweep, 7-point Peclet sweep, 6-point latitude tilt sweep, and species/isothermal ablation controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py#L212-L497> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2015-ocko-termite-mound-convective-chimneys.py L636–L664" ;
        dcterms:description "CLI overrides for peclet, delta_t_day, latitude_deg, and seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py#L636-L664> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 097 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


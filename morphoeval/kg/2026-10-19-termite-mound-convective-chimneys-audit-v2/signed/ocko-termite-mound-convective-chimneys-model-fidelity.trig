sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ocko-termite-mound-convective-chimneys> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2015-ocko-termite-mound-convective-chimneys.py L91–L209" ;
        dcterms:description "Coupled 24-hour diurnal solar-thermal buoyancy thermosiphon & Taylor-Aris CO2 ventilation solver with exact mass continuity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py#L91-L209> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2015-ocko-termite-mound-convective-chimneys.py L270–L370" ;
        dcterms:description "Ocko, Heyde & Mahadevan (2019) PNAS moving-boundary convective pheromone morphogenesis and equatorward solar tilt solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py#L270-L370> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_097_termite_mound_convective_chimneys.lean L16–L126" ;
        dcterms:description "3 standalone Lean 4 theorems proving thermosiphon flow reversal & continuity, Peclet spire elongation, and Taylor-Aris dispersion enhancement (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_097_termite_mound_convective_chimneys.lean#L16-L126> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 097 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "King, Ocko & Mahadevan (2015) PNAS, Ocko et al. (2017) PNAS & Ocko, Heyde & Mahadevan (2019) PNAS solar-powered diurnal thermosiphon ventilation and convective pheromone morphogenesis of cathedral termite mounds — Model fidelity to source: 95/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the coupled 24-hour Boussinesq Darcy–Brinkman thermosiphon velocity & Taylor–Aris oscillatory CO₂ clearance solver (`simulate_diurnal_thermosiphon_cycle`, L91-209) and the Ocko, Heyde & Mahadevan (2019) PNAS moving-boundary convective pheromone mound morphogenesis & equatorward solar-tracking tilt solver (`simulate_convective_mound_morphogenesis`, L270-370), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_097_termite_mound_convective_chimneys.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-model-fidelity-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


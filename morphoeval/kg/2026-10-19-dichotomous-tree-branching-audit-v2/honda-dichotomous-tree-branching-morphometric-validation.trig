sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-honda-dichotomous-tree-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Honda (1971) J. Theor. Biol. & Honda & Fisher (1978) Science 3D recursive dichotomous tree branching, effective leaf area optimization, and Leonardo da Vinci pipe-model cross-sectional area conservation — Morphometric validation: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L579-699) returns 9 reference-anchored morphometric measurements with standard deviations, Pearson r, p-values, RMSE, and collinear ablation controls: effective leaf area curve Pearson r = 0.99782 (RMSE = 0.0128, p = 2.75e-8), Terminalia optimal A_eff/A_total = 0.7739 (Cornus = 0.7591 vs collinear ablation = 0.2001), collinear self-shading penalty = 74.14%, Leonardo pipe-model area conservation ratio = 1.0000 (RMSE = 0.00e+00), 6-order cumulative internode count = 127 (64 terminal tips), specimen pagoda tiers = 7, specimen theta_1 = 22.40 +- 8.18 deg, specimen theta_2 = 50.93 +- 14.23 deg, and specimen Leonardo ratio = 0.9533 +- 0.1705." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-collinear-zero-angle-ablation-self-shading-penalty-1-a-eff-0-0-a-eff-opt>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-honda-1971-6-order-cumulative-woody-internode-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-honda-fisher-1978-effective-leaf-area-curve-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-leonardo-da-vinci-shinozaki-pipe-model-cross-sectional-area-conservation-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-detected-horizontal-pagoda-crown-tiers>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-leonardo-pipe-model-area-ratio-d-1-2-d-2-2-d-0-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-primary-branch-divergence-angle-theta-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-secondary-branch-divergence-angle-theta-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-terminalia-catappa-optimal-effective-leaf-area-ratio-a-eff-a-total-30-60>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-collinear-zero-angle-ablation-self-shading-penalty-1-a-eff-0-0-a-eff-opt> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "collinear zero-angle ablation self-shading penalty (1 - A_eff(0,0)/A_eff(opt)) = 74.14 %" ;
        dct:description "A_eff(0,0)/A_total = 0.2001 vs A_eff(30,60)/A_total = 0.7739" ;
        schema:measurementTechnique "Percentage loss of non-overlapping leaf area when daughter divergence angles collapse to theta_1 = theta_2 = 0 deg (Lean 4 theorem honda_fisher_1978_divergence_avoids_self_shading)" ;
        schema:name "collinear zero-angle ablation self-shading penalty (1 - A_eff(0,0)/A_eff(opt))" ;
        schema:unitText "%" ;
        schema:value "74.14" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-collinear-zero-angle-ablation-self-shading-penalty-1-a-eff-0-0-a-eff-opt-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-collinear-zero-angle-ablation-self-shading-penalty-1-a-eff-0-0-a-eff-opt-reference> a schema:PropertyValue ;
        dct:source "Honda & Fisher (1978) Science 199:888-890" ;
        schema:value "74.14" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-honda-1971-6-order-cumulative-woody-internode-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Honda (1971) 6-order cumulative woody internode count = 127 internodes" ;
        dct:description "terminal tips at order k=6 = 64 (ref 64)" ;
        schema:measurementTechnique "Total dichotomous internodes sum_{j=0}^6 2^j = 2^7 - 1 (Lean 4 theorem honda_1971_dichotomous_tip_and_internode_identity)" ;
        schema:name "Honda (1971) 6-order cumulative woody internode count" ;
        schema:unitText "internodes" ;
        schema:value "127" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-honda-1971-6-order-cumulative-woody-internode-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-honda-1971-6-order-cumulative-woody-internode-count-reference> a schema:PropertyValue ;
        dct:source "Honda (1971) J. Theor. Biol. 31:331-338" ;
        schema:value "127" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-honda-fisher-1978-effective-leaf-area-curve-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Honda & Fisher (1978) effective leaf area curve Pearson correlation r = 0.997822 r" ;
        dct:description "p = 2.58e-08, RMSE = 0.0128 across 8 benchmark regimes" ;
        schema:measurementTechnique "Pearson correlation across 8 branching angle regimes from collinear (0, 0) to back-folding (75, 95) deg" ;
        schema:name "Honda & Fisher (1978) effective leaf area curve Pearson correlation r" ;
        schema:unitText "r" ;
        schema:value "0.997822" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-honda-fisher-1978-effective-leaf-area-curve-pearson-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-honda-fisher-1978-effective-leaf-area-curve-pearson-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Honda & Fisher (1978) Science 199:888-890; Fisher & Honda (1979) Am. J. Bot. 66:633" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-leonardo-da-vinci-shinozaki-pipe-model-cross-sectional-area-conservation-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Leonardo da Vinci / Shinozaki pipe-model cross-sectional area conservation ratio = 1.0 ratio" ;
        dct:description "RMSE = 1.24e-16, terminal order k=6 sum(d_i^2)/d_0^2 = 1.000000" ;
        schema:measurementTechnique "(d_1^2 + d_2^2) / d_parent^2 across all 63 bifurcations of 6-order 3D Honda tree (Lean 4 theorem leonardo_shinozaki_pipe_area_invariance)" ;
        schema:name "Leonardo da Vinci / Shinozaki pipe-model cross-sectional area conservation ratio" ;
        schema:unitText "ratio" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-leonardo-da-vinci-shinozaki-pipe-model-cross-sectional-area-conservation-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-leonardo-da-vinci-shinozaki-pipe-model-cross-sectional-area-conservation-ratio-reference> a schema:PropertyValue ;
        dct:source "Shinozaki et al. (1964) Jpn. J. Ecol. 14:97-105; Eloy (2011) Phys. Rev. Lett. 107:258101" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-detected-horizontal-pagoda-crown-tiers> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen Cornus controversa detected horizontal pagoda crown tiers = 7 tiers" ;
        dct:description "tier y-coordinates (px) = [168, 316, 391, 541, 673, 870, 965], foliage fraction = 0.2059" ;
        schema:measurementTechnique "Gaussian-smoothed row-wise variegated foliage density peak detection on cornus_controversa_tiered_crown_specimen.jpg" ;
        schema:name "specimen Cornus controversa detected horizontal pagoda crown tiers" ;
        schema:unitText "tiers" ;
        schema:value "7" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-detected-horizontal-pagoda-crown-tiers-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-detected-horizontal-pagoda-crown-tiers-reference> a schema:PropertyValue ;
        dct:source "Honda & Fisher (1978) Science 199:888-890; Botanic Garden Meise Cornus controversa specimen" ;
        schema:value "7" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-leonardo-pipe-model-area-ratio-d-1-2-d-2-2-d-0-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen Cornus controversa Leonardo pipe-model area ratio (d_1^2 + d_2^2) / d_0^2 = 0.9533 ratio" ;
        dct:description "mean = 0.9533 ± 0.1705 (within 4.7% of Leonardo pipe-model invariance 1.0)" ;
        schema:measurementTechnique "Squared EDT branch radius conservation across N=25 segmented woody bifurcations" ;
        schema:name "specimen Cornus controversa Leonardo pipe-model area ratio (d_1^2 + d_2^2) / d_0^2" ;
        schema:unitText "ratio" ;
        schema:value "0.9533" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-leonardo-pipe-model-area-ratio-d-1-2-d-2-2-d-0-2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-leonardo-pipe-model-area-ratio-d-1-2-d-2-2-d-0-2-reference> a schema:PropertyValue ;
        dct:source "Shinozaki et al. (1964) Jpn. J. Ecol. 14:97-105; Eloy (2011) Phys. Rev. Lett. 107:258101" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-primary-branch-divergence-angle-theta-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen Cornus controversa primary branch divergence angle theta_1 = 22.4 deg" ;
        dct:description "mean = 22.40 ± 8.18 deg (N=25 junctions)" ;
        schema:measurementTechnique "EDT medial-axis skeletonization across N=25 Y-bifurcations in cornus_controversa_tiered_crown_specimen.jpg" ;
        schema:name "specimen Cornus controversa primary branch divergence angle theta_1" ;

        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-primary-branch-divergence-angle-theta-1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-primary-branch-divergence-angle-theta-1-reference> a schema:PropertyValue ;
        dct:source "Honda & Fisher (1978) Science 199:888-890 (empirical Cornus/Terminalia theta_1 = 22-32 deg)" ;
        schema:value "26.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-specimen-cornus-controversa-secondary-branch-divergence-angle-theta-2> a schema:PropertyValue,
            pk:EvidenceItem ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-honda-dichotomous-tree-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Honda (1971) J. Theor. Biol. & Honda & Fisher (1978) Science 3D recursive dichotomous tree branching, effective leaf area optimization, and Leonardo da Vinci pipe-model cross-sectional area conservation — Model fidelity to source: 95/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements Honda's (1971) 3D local orthonormal frame rotation recursion (`_honda_local_frame`, `grow_honda_1971_3d_tree`, L91-222), 4-archetype 3D crown morphospace (`evaluate_honda_3d_archetypes`, L225-250), Honda & Fisher's (1978) 5-whorl horizontal tier disk-union effective leaf area functional and 2D (theta_1, theta_2) optimization landscape (`grow_honda_fisher_planar_tier`, `compute_effective_leaf_area_ratio`, `evaluate_honda_fisher_optimization_surface`, L256-430), and Leonardo da Vinci / Shinozaki pipe-model diameter tapering, backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_051_dichotomous_tree_branching.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1976-honda-dichotomous-tree-branching.py L91–L250" ;
        dcterms:description "Honda (1971) 3D local orthonormal basis rotation, Leonardo pipe-model diameter conservation, and 4 crown archetypes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1976-honda-dichotomous-tree-branching.py#L91-L250> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1976-honda-dichotomous-tree-branching.py L256–L430" ;
        dcterms:description "Honda & Fisher (1978) 5-whorl planar tier builder, 2D disk-union effective leaf area integral, and (theta_1, theta_2) optimization surface" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1976-honda-dichotomous-tree-branching.py#L256-L430> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_051_dichotomous_tree_branching.lean L25–L127" ;
        dcterms:description "3 machine-checked Lean 4 theorems for dichotomous tip doubling, Leonardo pipe-model area invariance, and divergence self-shading avoidance (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_051_dichotomous_tree_branching.lean#L25-L127> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 051 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


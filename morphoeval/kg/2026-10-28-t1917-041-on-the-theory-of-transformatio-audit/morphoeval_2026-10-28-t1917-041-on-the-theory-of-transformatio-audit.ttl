<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-041-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-041-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-041-3> .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-041-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Radial distance from arrest point" ;
    dct:description "Non-negativity of squared radial distance in the polar frame | Variables: u, v, y0: leaf outline coordinates and arrest pole" ;
    dct:source "Thompson (1917) On Growth and Form, Ch. XVII, Fig. 359, p. 732" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/morphoeval/lean/loops/Thompson1917_T1917_041.lean>,
        <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/thompson/claims/t1917-041_on-the-theory-of-transformations.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "rho^2 = u^2 + (v - y0)^2" ;
    pk:hypothesisType "Thompson1917_RadialPolarLeafTransformation" ;
    pk:leanDeclaration "MathOfBiology.Loop_233.rho_sq" ;
    pk:leanTheorem "MathOfBiology.Loop_233.rho_sq_nonnegative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-041-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Arrest-point translation anchor" ;
    dct:description "Petiole arrest point maps to pure translation | Variables: a1,a2,b1,b2,tx,ty: radial-cordate coefficients" ;
    dct:source "Thompson (1917) On Growth and Form, Ch. XVII, Fig. 359, p. 732" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/morphoeval/lean/loops/Thompson1917_T1917_041.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u=0, v=y0 => rho=0 => (x',y') = (tx, b2*y0+ty)" ;
    pk:hypothesisType "Thompson1917_RadialPolarLeafTransformation" ;
    pk:leanDeclaration "MathOfBiology.Loop_233.radial_cordate_x" ;
    pk:leanTheorem "MathOfBiology.Loop_233.arrest_point_fixed" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-041-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Radial mode explained variance" ;
    dct:description "Perfect radial prediction maximizes explained variance numerator | Variables: d: landmark displacement; pred: model prediction" ;
    dct:source "Thompson (1917) radial transformation formalism; MorphoEval loop T1917-041" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/morphoeval/lean/loops/Thompson1917_T1917_041.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "d^2 - (d - pred)^2 = d^2 when pred = d" ;
    pk:hypothesisType "Thompson1917_RadialPolarLeafTransformation" ;
    pk:leanDeclaration "MathOfBiology.Loop_233.explained_var_num" ;
    pk:leanTheorem "MathOfBiology.Loop_233.radial_mode_beats_zero_prediction" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


<https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-041> a pk:Claim ;
    rdfs:label "Thompson (1917) radial-cordate leaf transformation claim T1917-041 (Leaf outline morphometrics (lanceolate / ovate / cordate; Begonia instance))",
        "Thompson (1917) radial-cordate leaf transformation claim T1917-041 faithfully reproduces Leaf outline morphometrics (lanceolate / ovate / cordate; Begonia instance) morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-041-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-041-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-041-3> ;
    dct:description "The simulation script(s) thompson/claims/t1917-041_on-the-theory-of-transformations.py implement the cited source model as published and produce forms that match real Leaf outline morphometrics (lanceolate / ovate / cordate; Begonia instance) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-041_on-the-theory-of-transformations.py> ;
    schema:about "Leaf outline morphometrics (lanceolate / ovate / cordate; Begonia instance)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-041_on-the-theory-of-transformations.py; output: docs/media/t1917_041_on_the_theory_of_transformatio_comparison.png; organism: Leaf outline morphometrics (lanceolate / ovate / cordate; Begonia instance); environment: python 3.12, numpy 2.x, matplotlib 3.x; other sources: On Growth and Form <https://archive.org/details/ongrowthform1917thom>; phenomenon_size: 103 µm (0.0001027 m, log10=-3.988 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 103 µm to 15.6 cm): 103 µm:morpho-menelaus-bioelectric-polarity, 363 µm:morpho-menelaus-vertex-packing, 3.5 mm:morpho-menelaus-turing-wavelength, 1.2 cm:morpho-menelaus-clock-wavefront, 2.2 cm:morpho-menelaus-morphogen-condensation, 2.8 cm:morpho-menelaus-flux-canalization, 3.0 cm:morpho-menelaus-elastic-buckling, 3.6 cm:morpho-menelaus-branching-tree" ;
    pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-code-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-model-fidelity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-morphometric-validation>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-overall>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-parameter-expressivity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-repro-package>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-source-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-specimen-match> ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-041-on-the-theory-of-transformatio-audit-thompson1917-t1917-041-1>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-041-on-the-theory-of-transformatio-audit-thompson1917-t1917-041-2>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-041-on-the-theory-of-transformatio-audit-thompson1917-t1917-041-3>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-041-on-the-theory-of-transformatio-audit-thompson1917-t1917-041-4>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-041-on-the-theory-of-transformatio-audit-thompson1917-t1917-041-5>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-041-on-the-theory-of-transformatio-audit-thompson1917-t1917-041-6>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-041-on-the-theory-of-transformatio-audit-thompson1917-t1917-041-7>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-041-on-the-theory-of-transformatio-audit-thompson1917-t1917-041-8> ;
    pk:hypothesisType "Thompson1917_RadialPolarLeafTransformation" ;
    pk:weightOfEvidence 6.26e-01 .


    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) radial-cordate leaf transformation claim T1917-041 — Parameter expressivity: 55/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Uses fixed k/y0 grids only; no sweep across lanceolate→cordate regimes or negative ablation." ;

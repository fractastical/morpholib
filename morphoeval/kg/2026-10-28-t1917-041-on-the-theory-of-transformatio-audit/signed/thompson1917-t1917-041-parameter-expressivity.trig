        pk:assessedBy <https://w3id.org/delphi/resource/model/composer-2.5> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "thompson/claims/t1917-041_on-the-theory-of-transformations.py L28–L28: PASS2 = False disables sweep/ablation <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/thompson/claims/t1917-041_on-the-theory-of-transformations.py#L28-L28>" ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/delphi/resource/model/composer-2.5> a pk:Model ;

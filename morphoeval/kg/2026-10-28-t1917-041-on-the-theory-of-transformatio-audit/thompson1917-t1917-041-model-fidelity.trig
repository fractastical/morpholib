sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-041> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) radial-cordate leaf transformation claim T1917-041 — Model fidelity to source: 72/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Implements Thompson Fig. 359 radial-cordate 8p least squares and compares to box/affine nulls on parametric outlines; Pass 1 does not digitize landmarks from the IA page plate." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/composer-2.5> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-041_on-the-theory-of-transformations.py L300–L310: Thompson page shown as raster only, not vectorized <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/thompson/claims/t1917-041_on-the-theory-of-transformations.py#L300-L310>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-model-fidelity-1> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-041_on-the-theory-of-transformations.py L95–L120" ;
        dct:description "fit_radial_cordate_8p implements polar rho/phi map" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/thompson/claims/t1917-041_on-the-theory-of-transformations.py#L95-L120> .
    <https://w3id.org/delphi/resource/model/composer-2.5> a pk:Model ;
        rdfs:label "Composer 2.5 (MorphoEval Autonomous Loop thompson1917-t1917-041 Pass 1)" ;
        dct:identifier "composer-2.5" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0002-0000-0001> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0000-0002-0000-0001>,
            <https://w3id.org/delphi/resource/model/composer-2.5> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form" .
}


<https://w3id.org/probknow/resource/claim/morphoeval-serra-gastrulation-streak-attractor> a pk:Claim ;
    rdfs:label "Saadaoui et al. (2020), Serra et al. (2023) & Rozbicki et al. (2015) avian gastrulation tensile ring, Polonaise twin-vortex flow & primitive streak attractor (Gallus gallus (chick epiblast disc Stage EGK XII to HH3+ primitive streak formation))",
        "Saadaoui et al. (2020), Serra et al. (2023) & Rozbicki et al. (2015) avian gastrulation tensile ring, Polonaise twin-vortex flow & primitive streak attractor faithfully reproduces Gallus gallus (chick epiblast disc Stage EGK XII to HH3+ primitive streak formation) morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/serra-gastrulation-streak-attractor-1>,
        <https://w3id.org/probknow/resource/math-law/serra-gastrulation-streak-attractor-2>,
        <https://w3id.org/probknow/resource/math-law/serra-gastrulation-streak-attractor-3> ;
    dct:description "The simulation script(s) 2022-serra-gastrulation-streak-attractor.py implement the cited source model as published and produce forms that match real Gallus gallus (chick epiblast disc Stage EGK XII to HH3+ primitive streak formation) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 57.2/100, audit 2026-10-19-gastrulation-streak-attractor-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2022-serra-gastrulation-streak-attractor.py> ;
    schema:about "Gallus gallus (chick epiblast disc Stage EGK XII to HH3+ primitive streak formation)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2022-serra-gastrulation-streak-attractor.py; output: docs/media/gastrulation_streak_attractor_comparison.png; organism: Gallus gallus (chick epiblast disc Stage EGK XII to HH3+ primitive streak formation); checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 394d38439dd8f3b351ba32f3eef22da12f99bfa222be7659901a95855eb8a1e1; artifact_sha256: c4013336b345b21ccab6836387f25f6d2c7726fa6b9bc739ea0185d7f6bba8d5" ;
    pk:derivedFromPaper <https://doi.org/10.1038/ncb3138>,
        <https://doi.org/10.1038/s41592-023-02009-y>,
        <https://doi.org/10.1126/science.aaw1965>,
        <https://doi.org/10.1371/journal.pone.0010571> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-model-fidelity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-morphometric-validation>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-overall>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-parameter-expressivity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-repro-package>,

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-serra-gastrulation-streak-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Saadaoui et al. (2020), Serra et al. (2023) & Rozbicki et al. (2015) avian gastrulation tensile ring, Polonaise twin-vortex flow & primitive streak attractor — Morphometric validation: 55/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Provides 2 baseline measurements in `measure_morphoeval()`, requiring expansion to 7 quantitative morphometric benchmarks spanning 5-regime streak elongation, Polonaise speed, FTLE ridge anisotropy, and specimen HH1->HH3 CV morphometrics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2022-serra-gastrulation-streak-attractor.py L151–L166: Baseline measure_morphoeval() with 2 script metrics <https://github.com/fractastical/morpholib/blob/317bc3c/2022-serra-gastrulation-streak-attractor.py#L151-L166>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-fgf-inhibited-su5402-circular-ring-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-hh3-primitive-streak-ap-ml-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-peak-polonaise-vortex-velocity> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-fgf-inhibited-su5402-circular-ring-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FGF-inhibited SU5402 circular ring aspect ratio = 1.0 ratio" ;
        dct:description "Collapse of dipolar Polonaise flow to isotropic central pit" ;
        schema:measurementTechnique "Symmetric marginal ring contraction (delta_m = 0)" ;
        schema:name "FGF-inhibited SU5402 circular ring aspect ratio" ;
        schema:unitText "ratio" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-fgf-inhibited-su5402-circular-ring-aspect-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-fgf-inhibited-su5402-circular-ring-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "Saadaoui et al. (2020) Science 367:453-458 Fig. 4; Serra et al. (2023) Nat. Methods Fig. 3" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-hh3-primitive-streak-ap-ml-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type HH3 primitive streak AP/ML aspect ratio = 4.25 ratio" ;
        dct:description "net circulation = 0.000000" ;
        schema:measurementTechnique "Pass 1 analytic Polonaise streamfunction baseline on circular epiblast disc" ;
        schema:name "wild-type HH3 primitive streak AP/ML aspect ratio" ;
        schema:unitText "ratio" ;
        schema:value "4.25" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-hh3-primitive-streak-ap-ml-aspect-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-hh3-primitive-streak-ap-ml-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "Saadaoui et al. (2020) Science 367:453-458 Fig. 1; Serra et al. (2023) Nat. Methods Fig. 2" ;
        schema:value "4.25" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-peak-polonaise-vortex-velocity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type peak Polonaise vortex velocity = 2.3873 um/min" ;
        dct:description "SU5402 circular ring speed = 0.1417 um/min" ;
        schema:measurementTechnique "Peak epiblast tissue speed under dipolar tensile ring contraction" ;
        schema:name "wild-type peak Polonaise vortex velocity" ;
        schema:unitText "um/min" ;
        schema:value "2.3873" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-peak-polonaise-vortex-velocity-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-peak-polonaise-vortex-velocity-reference> a schema:PropertyValue ;
        dct:source "Saadaoui et al. (2020) Science 367:453-458 Fig. 2" ;
        schema:value "2.4" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


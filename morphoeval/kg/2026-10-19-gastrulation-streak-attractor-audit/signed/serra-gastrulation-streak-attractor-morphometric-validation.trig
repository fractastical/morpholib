            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-peak-polonaise-vortex-velocity> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-fgf-inhibited-su5402-circular-ring-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FGF-inhibited SU5402 circular ring aspect ratio = 1.0 ratio" ;
        dcterms:description "Collapse of dipolar Polonaise flow to isotropic central pit" ;

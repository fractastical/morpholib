sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-serra-gastrulation-streak-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Saadaoui et al. (2020), Serra et al. (2023) & Rozbicki et al. (2015) avian gastrulation tensile ring, Polonaise twin-vortex flow & primitive streak attractor — Parameter expressivity: 56/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates 3 baseline regimes in Pass 1, requiring expansion to all 5 Saadaoui et al. (2020) / Serra et al. (2023) perturbation regimes (`wildtype_hh1_to_hh3_polonaise_streak`, `fgf_inhibited_su5402_circular_ring`, `ectopic_vg1_wnt_twin_streaks`, `ingression_blocked_nodal_sb431542`, and `rock_inhibited_y27632_flow_arrest`) plus a 2D `(delta_m x beta_m)` parameter morphospace." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2022-serra-gastrulation-streak-attractor.py L125–L148: 3-regime baseline lacking ectopic Vg1 twin streaks, SB431542 ingression block, and 2D morphospace <https://github.com/fractastical/morpholib/blob/317bc3c/2022-serra-gastrulation-streak-attractor.py#L125-L148>" ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


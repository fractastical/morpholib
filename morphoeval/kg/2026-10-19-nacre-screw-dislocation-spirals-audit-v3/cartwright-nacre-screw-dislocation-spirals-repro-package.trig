sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-screw-dislocation-spirals> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007), Cartwright et al. (2009) & BCF (1951) nacre screw-dislocation spirals, Frank-Read target loops, chitin pore mineral-bridge columnar vs sheet transition, 3D cholesteric chitin precursor coupling and brick-and-mortar tablet-sliding fracture — Reproducibility package: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`--self-test` passes 11/11 in ~1.3 s and the default render completes in ~3.5 s with exit 0; the suite verifies both SHA registries, exact phase reconstruction (cos Phi == Re Psi to 1e-9), twist / period / Burgers consistency for three regimes, every fracture inequality and failure-mode partition, the Schmid minimum, 16 measurements, and bitwise two-run determinism of both the 2D field and the new 3D volume (`atol=0.0`); the lamellar volume and fracture RVE are closed-form so no RNG enters Pass 3 (+2). Deductions: the twist-rate tolerance (2 %) is tuned to the n_z = 120 grid rather than derived, so a resolution change silently breaks the suite (-2); `docs/media/*.png` is gitignored so the audited comparison and cholesteric-fracture figures are not under version control and must be regenerated (the growth GIF is byte-identical on re-render; the tablet GIF is new and untracked) (-3); the `--self-test` help text is stale ('8-check') and `--seed` is dead (-2); no requirements lock is vendored for this script, environment versions live only in this audit (-2); SEM Z drifted 5.96 -> 6.01 between scipy versions, so the specimen numbers are environment-sensitive within the test band (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "models/2019-cartwright-nacre-screw-dislocation-spirals.py L2170–L2173: twist_rate_rel_error < 0.02 and membrane period rel_tol 0.02 are tolerances tuned to the 81x81x120 default grid <https://github.com/fractastical/morpholib/blob/9987db7d/models/2019-cartwright-nacre-screw-dislocation-spirals.py#L2170-L2173>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-repro-package-4> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2019-cartwright-nacre-screw-dislocation-spirals.py L2106–L2227" ;
        dct:description "self_test: 11 checks; Pass 3 checks 9-11 at L2163-L2217 cover SHA pins, phase reconstruction, twist / period / Burgers, fracture inequalities, mode partitions, ablations, Schmid minimum, 3D determinism and 16 measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2019-cartwright-nacre-screw-dislocation-spirals.py#L2106-L2227> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "models/2019-cartwright-nacre-screw-dislocation-spirals.py L2214–L2217" ;
        dct:description "Bitwise determinism of the 3D lamellar density volume across two runs (np.allclose atol=0.0) and 16-measurement count check" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2019-cartwright-nacre-screw-dislocation-spirals.py#L2214-L2217> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "models/2019-cartwright-nacre-screw-dislocation-spirals.py L2229–L2272" ;
        dct:description "main(): argparse CLI with --self-test / --verify-only and Pass 3 flags; render path writes 2 PNG + 2 GIF; PNGs are gitignored in this repository" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2019-cartwright-nacre-screw-dislocation-spirals.py#L2229-L2272> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/nacre_screw_dislocation_spirals_growth.gif (generated output)" ;
        dct:description "Pass 2 growth GIF re-rendered byte-identically by the v3 script (tracked in git, no diff after re-render) — docs/media/nacre_screw_dislocation_spirals_growth.gif: rendered output of models/2019-cartwright-nacre-screw-dislocation-spirals.py at 9987db7d, image/gif, 1135964 B, 1092×482 px, 7 frames, artifact_sha256 b65a1ab0802930b27f94b5c37ec41a67d70eed88466821fbe73cb20d7b2cb84e (sha256 b65a1ab0802930b27f94b5c37ec41a67d70eed88466821fbe73cb20d7b2cb84e), spec_fingerprint ed0b800f8d8c2c32e5a195ea9bf774d5448daf71d941e03bb74aa7cc7c3bbf66" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediation-round primary assessor, slot-078 Phase B)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


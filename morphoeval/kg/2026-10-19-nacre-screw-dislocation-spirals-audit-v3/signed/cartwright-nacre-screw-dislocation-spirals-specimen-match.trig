sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-screw-dislocation-spirals> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "models/2019-cartwright-nacre-screw-dislocation-spirals.py L881–L979" ;
        dcterms:description "segment_nacre_sem_specimen: DoG inter-lamellar seam detection across 25 column transects and Delaunay hexagonal coordination on the SHA-pinned specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2019-cartwright-nacre-screw-dislocation-spirals.py#L881-L979> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "models/2019-cartwright-nacre-screw-dislocation-spirals.py L1609–L1851" ;
        dcterms:description "render_cholesteric_fracture_figure: panels A-C (x-z section through core, director twist vs theory, pitch -> v_z) and D-F (sigma-eps, tau_p / rho sweeps, Schmid envelope) rendered beside the Jackson / Wang targets" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2019-cartwright-nacre-screw-dislocation-spirals.py#L1609-L1851> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/nacre_screw_dislocation_spirals_comparison.png (generated output)" ;
        dcterms:description "6-panel figure (v3 suptitle): 3D spiral, 4 chiral defect regimes, supersaturation sweep, 12-species collapse, SEM specimen panel E and seam histogram F — docs/media/nacre_screw_dislocation_spirals_comparison.png: rendered output of models/2019-cartwright-nacre-screw-dislocation-spirals.py at 9987db7d, image/png, 1419799 B, 2199×1495 px, artifact_sha256 e5a1f36bb11845dc2dfc98bc6688ae93591baae44c63fefaabc84b664341366e (sha256 e5a1f36bb11845dc2dfc98bc6688ae93591baae44c63fefaabc84b664341366e), spec_fingerprint ed0b800f8d8c2c32e5a195ea9bf774d5448daf71d941e03bb74aa7cc7c3bbf66" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/nacre_screw_dislocation_spirals_tablet_sliding.gif (generated output)" ;
        dcterms:description "9-frame brick-and-mortar RVE sliding (x25 exaggerated) with sigma-eps marker; geometry from SEM h_0 but tablet waviness / overlap are assumed, not measured on the specimen — docs/media/nacre_screw_dislocation_spirals_tablet_sliding.gif: rendered output of models/2019-cartwright-nacre-screw-dislocation-spirals.py at 9987db7d, image/gif, 91755 B, 1092×462 px, 9 frames, artifact_sha256 d4787750c379c498f770f616e0866619b92aa09e3666d2aa1423ebf82214e28f (sha256 d4787750c379c498f770f616e0866619b92aa09e3666d2aa1423ebf82214e28f), spec_fingerprint ed0b800f8d8c2c32e5a195ea9bf774d5448daf71d941e03bb74aa7cc7c3bbf66" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-specimen-match-5> a pk:EvidenceItem ;
        rdfs:label "docs/media/nacre_screw_dislocation_spirals_cholesteric_fracture.png (generated output)" ;
        dcterms:description "New 6-panel Pass 3 figure: x-z section through the screw core (white membranes, yellow mineral), director twist phi(z) vs theory at three columns, pitch -> v_z, sigma-eps with Jackson / Wang targets, tau_p and rho sweeps, Schmid envelope — docs/media/nacre_screw_dislocation_spirals_cholesteric_fracture.png: rendered output of models/2019-cartwright-nacre-screw-dislocation-spirals.py at 9987db7d, image/png, 581468 B, 2583×1508 px, artifact_sha256 a41587d78151b93e1de1d62010a7406703ed1e894d0fbebc70dcd9b03184bac7 (sha256 a41587d78151b93e1de1d62010a7406703ed1e894d0fbebc70dcd9b03184bac7), spec_fingerprint ed0b800f8d8c2c32e5a195ea9bf774d5448daf71d941e03bb74aa7cc7c3bbf66" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007), Cartwright et al. (2009) & BCF (1951) nacre screw-dislocation spirals, Frank-Read target loops, chitin pore mineral-bridge columnar vs sheet transition, 3D cholesteric chitin precursor coupling and brick-and-mortar tablet-sliding fracture — Morphological realism / specimen match: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The SHA-256-pinned public-domain SEM mother-of-pearl specimen is still segmented by DoG seam detection and Delaunay coordination (h_0 = 0.5000 um at 0.019867 um/px, 328 seams, CV 0.29; Z = 6.01; aspect 3.24) and shown in panels E-F of the comparison figure; Pass 3 adds an x-z section through the screw core with white membranes and yellow mineral fill, a director-twist panel and a brick-and-mortar RVE GIF whose geometry (L_ov = 7.8 um, h = 0.5 um, Phi = 0.95) is taken from the SEM-anchored h_0 (+3 for the new visual comparison surface). Deductions: the reference values the SEM Z and aspect ratio are compared against (5.96 and 3.2436) are the script's own Pass 2 outputs copied into the measurement block — SEM Z has since drifted to 6.01 under the current scipy and still 'passes' a 5.5-6.4 band — so two of the three specimen metrics are self-referential (-6); the Pass 3 'membrane period vs SEM h_0' measurement uses the script's own segmentation as its reference and is flagged as such but remains intra-script (-2); the fracture RVE is compared with Jackson's numbers for Pinctada, not with any morphometric read from the Haliotis specimen (tablet waviness, overlap length, mortar thickness are literature assumptions), so the mechanical panels are not specimen-matched (-4); no Cartwright et al. (2009) spiral / target micrograph is vendored for the morphospace panels, as in v2 (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "models/2019-cartwright-nacre-screw-dislocation-spirals.py L2008–L2029: SEM Z reference_value 5.96 (L2015) and aspect reference_value 3.2436 (L2025) are the script's own earlier outputs, not independent literature values <https://github.com/fractastical/morpholib/blob/9987db7d/models/2019-cartwright-nacre-screw-dislocation-spirals.py#L2008-L2029>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-specimen-match-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-specimen-match-5> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediation-round primary assessor, slot-078 Phase B)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


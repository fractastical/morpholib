sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-screw-dislocation-spirals> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2019-cartwright-nacre-screw-dislocation-spirals.py L614–L650" ;
        dcterms:description "evaluate_cholesteric_pitch_coupling: 9-point pitch sweep P in [0.6, 1.4] um -> h_0 = P/2 -> v_z, 12-species implied pitches, SEM anchor" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2019-cartwright-nacre-screw-dislocation-spirals.py#L614-L650> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2019-cartwright-nacre-screw-dislocation-spirals.py L1127–L1223" ;
        dcterms:description "evaluate_fracture_toughness_sweeps: default RVE, psi = 0 and monolithic ablations, tau_p 10-40 MPa and rho 4-30 sweeps, 17-angle Schmid envelope, Jackson range check" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2019-cartwright-nacre-screw-dislocation-spirals.py#L1127-L1223> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007), Cartwright et al. (2009) & BCF (1951) nacre screw-dislocation spirals, Frank-Read target loops, chitin pore mineral-bridge columnar vs sheet transition, 3D cholesteric chitin precursor coupling and brick-and-mortar tablet-sliding fracture — Parameter expressivity: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Pass 2 coverage is retained (5 morphospace / control regimes, 11-point supersaturation sweep, 12 species) and Pass 3 adds genuinely new axes: a 9-point cholesteric pitch sweep that propagates P into h_0 and v_z, a tau_p sweep 10-40 MPa that crosses the ductile-brittle transition at tau* = sigma_crit / rho = 22.9 MPa, a rho sweep 4-30 that partitions failure modes at rho* = 17.8, psi = 0 (perfectly plastic pull-out) and Phi = 1 (monolithic Griffith) ablations, a 17-angle Schmid envelope, and a `--tau-p` / `--skip-pass3` CLI (+5). Deductions: `--seed` is parsed but never passed to any function, so it is a dead flag (-3); the physical overrides `--v-inf / --r-c / --h-0 / --dipole-d / --tau-p` reach only `render_comparison_figure()` or the Pass 3 figure's default RVE, never `measure_morphoeval()`, the sweeps or the self-test, so the ledger and measurements cannot be re-run at a different parameter point from the CLI (-4); the Haliotis regime's cholesteric volume is built at the bivalve h_0 = 0.50 for all three regimes although that regime has its own r_c = 0.19 / Delta_mu = 1.105 (-2); hydration (dry vs wet Jackson) is displayed as two targets but not an input (-2); the supersaturation and 12-species axes are consumed from synthetic tables (-1 here, scored mainly under morphometric-validation)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "models/2019-cartwright-nacre-screw-dislocation-spirals.py L2165–L2167: Self-test builds the spiral, target and Haliotis cholesteric volumes all at h_0_um = 0.50; the Haliotis regime's own parameters are not used <https://github.com/fractastical/morpholib/blob/9987db7d/models/2019-cartwright-nacre-screw-dislocation-spirals.py#L2165-L2167>",
            "models/2019-cartwright-nacre-screw-dislocation-spirals.py L2231–L2240: CLI: --self-test / --verify-only / --skip-gif / --v-inf / --r-c / --h-0 / --dipole-d / --seed / --tau-p / --skip-pass3; --seed (L2238) is never consumed; help text still says '8-check' (L2231) <https://github.com/fractastical/morpholib/blob/9987db7d/models/2019-cartwright-nacre-screw-dislocation-spirals.py#L2231-L2240>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-parameter-expressivity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediation-round primary assessor, slot-078 Phase B)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

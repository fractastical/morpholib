    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-3d-cholesteric-membrane-period-p-2-recovered-from-the-z-power-spectrum-of-the-lamellar-density-vs-sem-segmented-h-0-reference> a schema:PropertyValue ;
        dct:source "SEM specimen haliotis_nacre_spirals_specimen.jpg inter-lamellar spacing (this script, Pass 2 segmentation) & Cartwright & Checa (2007) h_0 ~ 0.50 um" ;

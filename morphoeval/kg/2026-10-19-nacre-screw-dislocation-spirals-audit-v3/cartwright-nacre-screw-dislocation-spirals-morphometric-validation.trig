    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-bivalve-sheet-nacre-pteria-hirundo-single-spiral-terrace-wavelength-lambda-0-reference> a schema:PropertyValue ;

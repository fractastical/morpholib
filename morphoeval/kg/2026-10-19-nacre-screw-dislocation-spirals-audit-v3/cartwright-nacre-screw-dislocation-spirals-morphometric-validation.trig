        schema:value "7.9736" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-brick-and-mortar-tablet-pull-out-work-of-fracture-gamma-tau-p-l-ov-2-h> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Brick-and-mortar tablet pull-out work of fracture Gamma = tau_p L_ov^2 / h = 608.4 J/m^2" ;
        dct:description "within Jackson dry-wet range: True; Currey 3000x NOT reached (x608); Gao (2003) flaw-tolerant h* = 28.3 nm (ref ~30 nm)" ;
        schema:measurementTechnique "Constant-shear pull-out over overlap L_ov = 3.90 um at tau_p = 20 MPa, h = 0.50 um; toughening x608 vs Gamma_m = 1 J/m^2, K_Ic = 7.38 MPa sqrt(m)" ;
        schema:name "Brick-and-mortar tablet pull-out work of fracture Gamma = tau_p L_ov^2 / h" ;
        schema:unitText "J/m^2" ;
        schema:value "608.4" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-brick-and-mortar-tablet-pull-out-work-of-fracture-gamma-tau-p-l-ov-2-h-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-brick-and-mortar-tablet-pull-out-work-of-fracture-gamma-tau-p-l-ov-2-h-reference> a schema:PropertyValue ;
        dct:source "Jackson et al. (1988) Proc. R. Soc. B 234:415-440 work of fracture 350 (dry) - 1240 (wet) J/m^2; Currey (1977) Proc. R. Soc. B 196:443 ~3000x aragonite" ;
        schema:value "350.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-brick-and-mortar-tensile-strength-at-griffith-tablet-fracture-after-waviness-hardened-interlamellar-sliding> a schema:PropertyValue,

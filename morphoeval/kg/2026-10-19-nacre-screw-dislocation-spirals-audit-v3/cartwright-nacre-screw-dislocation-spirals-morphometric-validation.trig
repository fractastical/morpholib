        schema:measurementTechnique "sigma_f = Phi sigma_tab,crit / 2 with sigma_tab,crit = sqrt(E_m Gamma_m / (pi h/2)) = 356.8 MPa; yield sigma_y = Phi rho tau_p / 2 = 148.2 MPa (tau_p = 20 MPa); failure mode waviness_hardening_then_tablet_fracture" ;
        schema:name "Brick-and-mortar tensile strength at Griffith tablet fracture after waviness-hardened interlamellar sliding" ;
        schema:unitText "MPa" ;
        schema:value "169.49" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-brick-and-mortar-tensile-strength-at-griffith-tablet-fracture-after-waviness-hardened-interlamellar-sliding-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-brick-and-mortar-tensile-strength-at-griffith-tablet-fracture-after-waviness-hardened-interlamellar-sliding-reference> a schema:PropertyValue ;
        dct:source "Jackson et al. (1988) Proc. R. Soc. B 234:415-440 ~170 MPa dry / ~140 MPa wet; Wang et al. (2001) J. Mater. Res. 16:2485 ~110 MPa" ;
        schema:value "170.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-brick-and-mortar-tension-shear-chain-effective-tensile-modulus-e-ji-gao-2004-at-sem-h-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Brick-and-mortar tension-shear-chain effective tensile modulus E (Ji & Gao 2004) at SEM h_0 = 89.47 GPa" ;
        dct:description "TSC upper-bound estimate; G_p and Phi are literature-range assumptions (see cholesteric_fracture_reference.json)" ;
        schema:measurementTechnique "1/E = 4(1-Phi)/(G_p Phi^2 rho^2) + 1/(Phi E_m) with Phi = 0.95, rho = L/h = 15.6, E_m = 100 GPa, G_p = 1.4 GPa" ;
        schema:name "Brick-and-mortar tension-shear-chain effective tensile modulus E (Ji & Gao 2004) at SEM h_0" ;
        schema:unitText "GPa" ;
        schema:value "89.47" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-brick-and-mortar-tension-shear-chain-effective-tensile-modulus-e-ji-gao-2004-at-sem-h-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-brick-and-mortar-tension-shear-chain-effective-tensile-modulus-e-ji-gao-2004-at-sem-h-0-reference> a schema:PropertyValue ;
        dct:source "Jackson, Vincent & Turner (1988) Proc. R. Soc. B 234:415-440 nacre tensile modulus ~73 GPa (dry) / ~64 GPa (wet)" ;
        schema:value "73.0" .

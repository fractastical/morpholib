        schema:measurementTechnique "Finite-difference n.curl(n) on the (101, 101, 120) director grid built from u = h_0 Phi_2D / 2 pi (single +1 screw regime); theory pi / h_0 with h_0 = 0.50 um (SEM-segmented h_0 = 0.5000 um)" ;
        schema:name "3D cholesteric chitin precursor twist rate q = -n.curl(n) recovered from the BCF-coupled director volume" ;
        schema:unitText "rad/um" ;
        schema:value "6.2242" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-3d-cholesteric-chitin-precursor-twist-rate-q-n-curl-n-recovered-from-the-bcf-coupled-director-volume-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-3d-cholesteric-chitin-precursor-twist-rate-q-n-curl-n-recovered-from-the-bcf-coupled-director-volume-reference> a schema:PropertyValue ;
        dct:source "Cartwright et al. (2009) PNAS 106:10499-10504 (cholesteric half-pitch = interlamellar spacing) & de Gennes & Prost (1993) twist q = 2 pi / P" ;
        schema:value "6.2832" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-3d-cholesteric-membrane-period-p-2-recovered-from-the-z-power-spectrum-of-the-lamellar-density-vs-sem-segmented-h-0> a schema:PropertyValue,

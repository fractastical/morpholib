    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-coupled-vertical-nacre-growth-rate-sensitivity-to-cholesteric-pitch-d-v-z-d-p-omega-4-pi> a schema:PropertyValue,

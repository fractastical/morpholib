sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-screw-dislocation-spirals> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007), Cartwright et al. (2009) & BCF (1951) nacre screw-dislocation spirals, Frank-Read target loops, chitin pore mineral-bridge columnar vs sheet transition, 3D cholesteric chitin precursor coupling and brick-and-mortar tablet-sliding fracture — Code-to-model traceability: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The header docstring now carries a 'Pass 3 (v3) remediation additions' section mapping Law 4 and Law 5 to the Lean theorems, to Cartwright et al. (2009), de Gennes, Ji & Gao / Jäger & Fratzl, Barthelat and Jackson / Currey / Wang, and to the new figure, GIF and reference table; the two new solver functions have long docstrings stating their equations and their reduced-model status, and the math-KG YAML registers them as equations 4-5 with single-range code loci that match the current line numbers (+2). Deductions: the 0.019867 um/px calibration is duplicated as a literal in two places instead of read from the reference JSON (-2); the pitch blend 0.15 / 0.85 at L451 is uncommented and uncited (-3); the Law 3 margins and `pitch_tower = 3.6071`, `tower_spacing = 11.5`, `spacing = 7.8` have no source comment (-2); the `--self-test` help string still says '8-check' for an 11-check suite and the panel-F inset axis range [0.5, 1.85] is a hard-coded literal (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "models/2019-cartwright-nacre-screw-dislocation-spirals.py L1471–L1497: 0.019867 um/px literal (L1471, duplicated at L2004) and hard-coded inset range [0.5, 1.85] (L1497) instead of values read from the reference JSON <https://github.com/fractastical/morpholib/blob/9987db7d/models/2019-cartwright-nacre-screw-dislocation-spirals.py#L1471-L1497>",
            "models/2019-cartwright-nacre-screw-dislocation-spirals.py L451–L451: Uncommented 0.15 / 0.85 blend of raw and theoretical pitch <https://github.com/fractastical/morpholib/blob/9987db7d/models/2019-cartwright-nacre-screw-dislocation-spirals.py#L451-L451>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-code-traceability-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2019-cartwright-nacre-screw-dislocation-spirals.py L1–L80" ;
        dct:description "Header docstring: sources 1-4 with DOIs and the Pass 3 additions block (L56-L80) naming the two new Lean laws, the reduced-model status, new outputs and reference table" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2019-cartwright-nacre-screw-dislocation-spirals.py#L1-L80> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/cartwright-nacre-screw-dislocation-spirals.yaml L93–L113" ;
        dct:description "Equations 4-5 registered with code_locus #L480-L650 and #L981-L1223 (single ranges, match current file); equations 1-3 re-pointed to L197-L268, L273-L474, L655-L748" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/math_kg_loops/cartwright-nacre-screw-dislocation-spirals.yaml#L93-L113> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediation-round primary assessor, slot-078 Phase B)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-screw-dislocation-spirals> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007), Cartwright et al. (2009) & BCF (1951) nacre screw-dislocation spirals, Frank-Read target loops, chitin pore mineral-bridge columnar vs sheet transition, 3D cholesteric chitin precursor coupling and brick-and-mortar tablet-sliding fracture — Source and data traceability: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Pass 2 provenance is intact: 4 dataset files SHA-256-verified at runtime, `paper_citations.bib` with the 4 original DOIs, scout manifest and README. Pass 3 adds a second SHA-256-pinned reference table (`cholesteric_fracture_reference.json`, 82 lines, with a provenance_note) and `pass3_citations.bib` (98 lines, 9 new entries), both verified fail-closed by `verify_pass3_dataset_integrity()`, and the dataset README gains a Pass 3 section with an explicit 'transcribed offline / approx' caveat (+3 for the honesty of the caveat). Deductions: every numeric target and all nine new DOIs were written from memory with no network access and none is verified — a SHA pin on an unverified table pins the transcription, not the source (-6); the Pass 2 supersaturation / 12-species tables still carry no figure or table citation for their `lambda_obs` columns (-4); de Gennes & Prost has no DOI and the ISBN given is for the 1993 hardback, which could not be checked (-1); the `pitch_tower` / `tower_spacing` / `spacing` literals in the Voronoi solver and the 0.019867 um/px calibration are not traced to the reference JSON (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/nacre_screw_dislocation_spirals/cholesteric_fracture_reference.json L1–L82: Pass 3 reference table with provenance_note 'transcribed offline ... must be re-verified' (L4) and empirical_targets flagged approx (L68-L79) <https://github.com/fractastical/morpholib/blob/9987db7d/datasets/nacre_screw_dislocation_spirals/cholesteric_fracture_reference.json#L1-L82>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-source-traceability-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2019-cartwright-nacre-screw-dislocation-spirals.py L117–L191" ;
        dct:description "EXPECTED_SHA256_PASS3 (L117-L124) and EXPECTED_SHA256 (L127-L144) registries; verify_dataset_integrity / verify_pass3_dataset_integrity / load_pass3_reference_data fail closed on mismatch" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2019-cartwright-nacre-screw-dislocation-spirals.py#L117-L191> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/nacre_screw_dislocation_spirals/README.md L12–L19" ;
        dct:description "Pass 3 section listing the new files, SHA-256 values and the offline-transcription caveat; states tau_p, psi, G_p, Phi were not fitted to Jackson" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/datasets/nacre_screw_dislocation_spirals/README.md#L12-L19> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/nacre_screw_dislocation_spirals/pass3_citations.bib L1–L98" ;
        dct:description "9 new BibTeX entries (de Gennes, Kleman, Jackson, Currey, Gao, Ji, Jäger, Barthelat, Wang); DOIs unverified this pass" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/datasets/nacre_screw_dislocation_spirals/pass3_citations.bib#L1-L98> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediation-round primary assessor, slot-078 Phase B)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


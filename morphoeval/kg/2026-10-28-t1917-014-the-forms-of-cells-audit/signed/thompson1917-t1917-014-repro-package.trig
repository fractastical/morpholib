sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-014> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-014-repro-package> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-014-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-014 — Lagena outlines vs. the Plateau/Delaunay catalogue (Pass 1) — Reproducibility package: 70/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Deterministic (no RNG), --self-test passes in 3 s, the full run in 7 s, inputs SHA-pinned, dependency versions recorded here. Deductions: no result.json verdict file, no pinned per-script requirements, PNG outputs are gitignored by the repo and had to be force-added." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-repro-package-2> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-014_the-forms-of-cells.py L465–L499" ;
        dcterms:description "self_test: identities, classification, flask joins, synthetic recovery, 13 silhouettes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d762bb9c6/thompson/claims/t1917-014_the-forms-of-cells.py#L465-L499> .


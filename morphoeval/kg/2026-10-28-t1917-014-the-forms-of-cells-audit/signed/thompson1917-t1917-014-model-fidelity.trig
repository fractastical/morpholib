sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-014> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-014-model-fidelity> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-014-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-014 — Lagena outlines vs. the Plateau/Delaunay catalogue (Pass 1) — Model fidelity to source: 72/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "The catalogue is implemented from the first-integral / Kenmotsu form with the correct limits (cylinder, unduloid, spheres, nodoid, catenoid), self-tested against the root identities and the elliptic-integral period, and 18 Lean theorems check the integer algebra (roots, envelope, trichotomy, bead bound, flask join). Thompson's flask qualification is honoured by the C1 composite. Deductions: the flask's sphere-unduloid join is restricted to the one-parameter family of C1 joins (no C2 matching), the neck is a plain cylinder with no apertural lip, and the nodoid is classified but never fitted." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-014_the-forms-of-cells.py L154–L176: join is C1 only and the neck is an idealised cylinder without lip <https://github.com/fractastical/morpholib/blob/d762bb9c6/thompson/claims/t1917-014_the-forms-of-cells.py#L154-L176>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-model-fidelity-3> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-014_the-forms-of-cells.py L95–L150" ;
        dcterms:description "classify_delaunay, neck_ratio, unduloid_period, bead_aspect_ratio, kenmotsu_profile, catenoid_profile (E4-E6)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d762bb9c6/thompson/claims/t1917-014_the-forms-of-cells.py#L95-L150> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-014_the-forms-of-cells.py L154–L184" ;
        dcterms:description "flask_profile (E7, closed-form join radius) and bead_profile (E8)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d762bb9c6/thompson/claims/t1917-014_the-forms-of-cells.py#L154-L184> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_014.lean L32–L221" ;
        dcterms:description "18 kernel-checked theorems, 0 sorry (roots_sum/product, first integral, neck ratio monotonicity, Kenmotsu envelope, catalogue trichotomy, bead aspect bound, flask join)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d762bb9c6/morphoeval/lean/loops/Thompson1917_T1917_014.lean#L32-L221> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, Pass 1; cloud loop thompson1917-t1917-014)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


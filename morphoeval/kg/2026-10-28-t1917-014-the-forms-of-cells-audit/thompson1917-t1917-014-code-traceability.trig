sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-014> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-014-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-014-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-014 — Lagena outlines vs. the Plateau/Delaunay catalogue (Pass 1) — Code-to-model traceability: 75/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Every function docstring names the equation id (E3-E8) and the Thompson page it implements; the Lean module and math KG YAML cite the exact script line ranges. The decision threshold 0.06 is a stated judgement, not derived from a noise model." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "thompson/claims/t1917-014_the-forms-of-cells.py L72–L73: RMSE_SUPPORT = 0.06 justified only by a comment <https://github.com/fractastical/morpholib/blob/d762bb9c6/thompson/claims/t1917-014_the-forms-of-cells.py#L72-L73>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-code-traceability-2> ;
        pk:hasScore "0.75"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-014_the-forms-of-cells.py L1–L45" ;
        dct:description "module docstring maps E3-E8 to pages 216-263" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d762bb9c6/thompson/claims/t1917-014_the-forms-of-cells.py#L1-L45> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/thompson1917-t1917-014.yaml (generated output)" ;
        dct:description "six laws with lean_locus and code_locus line ranges — morphoeval/math_kg_loops/thompson1917-t1917-014.yaml: rendered output of thompson/claims/t1917-014_the-forms-of-cells.py at d762bb9c6, application/yaml, 10374 B, artifact_sha256 810e31a9e1b4210333b22a993a3acecf7cec9903982b59fe116b8a6e50295d53 (sha256 810e31a9e1b4210333b22a993a3acecf7cec9903982b59fe116b8a6e50295d53), spec_fingerprint ce11ca3725361e46a837bbcd24fc0d74234556b6328d06d635521b2bb17dd6e7" .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, Pass 1; cloud loop thompson1917-t1917-014)" ;

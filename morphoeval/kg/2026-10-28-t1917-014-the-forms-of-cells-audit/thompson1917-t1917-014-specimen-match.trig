sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-014> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-014-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-014-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-014 — Lagena outlines vs. the Plateau/Delaunay catalogue (Pass 1) — Morphological realism / specimen match: 45/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Side by side (panel D), the fitted composites trace the flask and globular Lagena closely and visibly fail on the slender spindles, which is the honest result of the test. But the only 'specimens' in Pass 1 are 1917 line drawings after Brady; the vendored CC-BY photograph (Kireenko 2022) is not analysed, so no real specimen has been compared yet." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-014/kireenko_2022_bdj_e87457_fig8_station5656mc.jpg (generated output, not in repo): photograph vendored and SHA-pinned but not read by v1 — datasets/thompson_1917/t1917-014/kireenko_2022_bdj_e87457_fig8_station5656mc.jpg: rendered output of thompson/claims/t1917-014_the-forms-of-cells.py at d762bb9c6, image/jpeg, 2933295 B, 2480×3508 px, artifact_sha256 3b57acc0dfc9837448683cd478c1eb24832547ed31e34457d79e70f613a63ff6 (sha256 3b57acc0dfc9837448683cd478c1eb24832547ed31e34457d79e70f613a63ff6), spec_fingerprint ce11ca3725361e46a837bbcd24fc0d74234556b6328d06d635521b2bb17dd6e7" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-specimen-match-2> ;
        pk:hasScore "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_014_the_forms_of_cells_comparison.png (generated output)" ;
        dct:description "panel B segmented plate, panel D 13 profiles with flask/bead overlays — docs/media/t1917_014_the_forms_of_cells_comparison.png: rendered output of thompson/claims/t1917-014_the-forms-of-cells.py at d762bb9c6, image/png, 634068 B, 2200×1430 px, artifact_sha256 500c908720bfbd2b6bd41fcef910785ff899c148c871a9adeeb18378a469a4c2 (sha256 500c908720bfbd2b6bd41fcef910785ff899c148c871a9adeeb18378a469a4c2), spec_fingerprint ce11ca3725361e46a837bbcd24fc0d74234556b6328d06d635521b2bb17dd6e7" .

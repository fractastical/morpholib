sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Dionaea muscipula Turing wavenumber at 24 µm (pass 1, unfitted field) — Model fidelity to source: 76/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Emit 1 integrates the Schnakenberg PDE whose linearisation is the Turing dispersion relation, with Du and Dv set so λ_c = 24 µm. The numeric σ(k) check is in the file but is not part of the pass-1 output." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dionaea-muscipula-turing-wavelength-s0.py L115–L158" ;
        dct:description "jacobian() and sigma_analytic()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d71d2f0b1c64d11b069392db32c90726b8fa5d72/models/2026-delphi10000-dionaea-muscipula-turing-wavelength-s0.py#L115-L158> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dionaea-muscipula-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dionaea-muscipula-turing-wavelength-s0.py L264–L309" ;
        dct:description "simulate_patch Fourier step" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d71d2f0b1c64d11b069392db32c90726b8fa5d72/models/2026-delphi10000-dionaea-muscipula-turing-wavelength-s0.py#L264-L309> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


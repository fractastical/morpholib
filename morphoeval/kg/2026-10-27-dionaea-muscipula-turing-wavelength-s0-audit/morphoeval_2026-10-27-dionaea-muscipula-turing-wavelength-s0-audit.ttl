<https://w3id.org/delphi/resource/math-law/delphi10000-dionaea-muscipula-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing diffusion margin" ;
    dct:description "Positive margin is required for a Turing band at 24 µm in Dionaea muscipula | Variables: Du, Dv, f_u, g_v at the Schnakenberg steady state (f_u, g_v) = (0.8, -1)" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d71d2f0b1c64d11b069392db32c90726b8fa5d72/models/2026-delphi10000-dionaea-muscipula-turing-wavelength-s0.py#L115-L146>,
        <https://github.com/fractastical/morpholib/blob/d71d2f0b1c64d11b069392db32c90726b8fa5d72/morphoeval/lean/loops/Loop_3169_dionaea_muscipula_turing_wavelength_s0.lean#L15-L21> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "Delta = Dv * f_u + Du * g_v" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature03185>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3169.turing_margin" ;
    pk:leanTheorem "MathOfBiology.Loop_3169.patterned_margin_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-dionaea-muscipula-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength" ;
    dct:description "Wavenumber selection for stripes, spots and ocelli | Variables: lambda_c = 24 µm on a 192 µm patch (eight wavelengths); age 0 Ma" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d71d2f0b1c64d11b069392db32c90726b8fa5d72/models/2026-delphi10000-dionaea-muscipula-turing-wavelength-s0.py#L134-L158>,
        <https://github.com/fractastical/morpholib/blob/d71d2f0b1c64d11b069392db32c90726b8fa5d72/morphoeval/lean/loops/Loop_3169_dionaea_muscipula_turing_wavelength_s0.lean#L35-L37> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 2 * pi / k_c,  k_c^2 = (Dv * f_u + Du * g_v) / (2 * Du * Dv)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature03185>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3169.domain_holds_eight_wavelengths" ;
    pk:leanTheorem "MathOfBiology.Loop_3169.domain_holds_eight_wavelengths" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-dionaea-muscipula-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation and the subcellular predecessor" ;
    dct:description "What changes at 24 µm and 0 Ma relative to the neighbouring scales of this single chronospecies | Variables: ablation margin negative; predecessor 8 µm; successor 480 µm holds 20 wavelengths" ;
    dct:source "Murray 1981 DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d71d2f0b1c64d11b069392db32c90726b8fa5d72/models/2026-delphi10000-dionaea-muscipula-turing-wavelength-s0.py#L311-L394>,
        <https://github.com/fractastical/morpholib/blob/d71d2f0b1c64d11b069392db32c90726b8fa5d72/morphoeval/lean/loops/Loop_3169_dionaea_muscipula_turing_wavelength_s0.lean#L30-L42> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "Dv = Du implies Delta < 0; at L = 8 µm, k_min = pi/L lies above the Turing band" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature03185>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3169.equal_diffusion_ablation" ;
    pk:leanTheorem "MathOfBiology.Loop_3169.predecessor_shorter_than_one_wavelength" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


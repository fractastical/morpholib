            <https://doi.org/10.1098/rsta.2011.0600> .
    <https://doi.org/10.1073/pnas.0900867106> dct:date "2009"^^xsd:gYear ;
        dct:title "Spiral and target patterns in bivalve nacre" .
    <https://doi.org/10.1098/rsif.2006.0188> dct:date "2007"^^xsd:gYear ;
        dct:title "The dynamics of nacre self-assembly" .
    <https://doi.org/10.1098/rsta.1951.0006> dct:date "1951"^^xsd:gYear ;

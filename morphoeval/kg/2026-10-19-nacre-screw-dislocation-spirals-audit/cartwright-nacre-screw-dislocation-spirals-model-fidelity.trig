sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-screw-dislocation-spirals> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007), Cartwright et al. (2009) & BCF (1951) nacre screw-dislocation spirals, Frank-Read target loops, and chitin pore mineral-bridge columnar vs sheet transition — Model fidelity to source: 56/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates a static analytical Cabrera-Levine spiral phase for one isolated screw dislocation (L31-62), but lacks a 2D excitable phase-field / step-flow and chitin mineral-bridge solver for opposite-charge (+1, -1) Frank-Read closed target terraces, subcritical dipole pinch-off failure (d <= 2*r_c), sub-saturated (Delta_mu <= 0) zero-growth negative control, Voronoi polygonal tablet tessellation, and gastropod columnar vs bivalve sheet nacre reconstruction." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2019-cartwright-nacre-screw-dislocation-spirals.py L31–L62: Single analytical spiral phase without Frank-Read target dipole, Voronoi tessellation, or columnar mineral-bridge solver <https://github.com/fractastical/morpholib/blob/HEAD/2019-cartwright-nacre-screw-dislocation-spirals.py#L31-L62>" ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


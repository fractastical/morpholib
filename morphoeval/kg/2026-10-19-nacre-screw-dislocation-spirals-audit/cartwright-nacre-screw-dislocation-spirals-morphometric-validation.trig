sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-screw-dislocation-spirals> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007), Cartwright et al. (2009) & BCF (1951) nacre screw-dislocation spirals, Frank-Read target loops, and chitin pore mineral-bridge columnar vs sheet transition — Morphometric validation: 50/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Reports only 3 analytical single-spiral scalars (L112-145) without validating terrace wavelength lambda_0 ≈ 19*r_c across supersaturation Delta_mu or across the 12 empirical bivalve, gastropod, and cephalopod nacre species, without Voronoi hexagonal coordination checks, and without extracting SEM specimen morphometrics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2019-cartwright-nacre-screw-dislocation-spirals.py L112–L145: Only 3 analytical scalars without supersaturation, 12-species scaling, or SEM specimen morphometrics <https://github.com/fractastical/morpholib/blob/HEAD/2019-cartwright-nacre-screw-dislocation-spirals.py#L112-L145>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-bcf-spiral-angular-rotation-frequency-omega>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-bivalve-sheet-nacre-pteria-hirundo-single-spiral-terrace-wavelength-lambda-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-universal-bcf-terrace-pitch-ratio-lambda-0-r-c> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-bcf-spiral-angular-rotation-frequency-omega> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "BCF spiral angular rotation frequency omega = 0.985 rad/hr" ;
        dct:description "Pass 1 single-spiral angular velocity" ;
        schema:measurementTechnique "omega = omega_0 * v_inf / r_c at v_inf = 1.25 um/hr, r_c = 0.42 um" ;
        schema:name "BCF spiral angular rotation frequency omega" ;
        schema:unitText "rad/hr" ;
        schema:value "0.985" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-bcf-spiral-angular-rotation-frequency-omega-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-bcf-spiral-angular-rotation-frequency-omega-reference> a schema:PropertyValue ;
        dct:source "Burton, Cabrera & Frank (1951) Phil. Trans. R. Soc. A 243:299-358" ;
        schema:value "0.985" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-bivalve-sheet-nacre-pteria-hirundo-single-spiral-terrace-wavelength-lambda-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Bivalve sheet nacre (*Pteria hirundo*) single-spiral terrace wavelength lambda_0 = 7.9736 um" ;
        dct:description "Pass 1 single-spiral analytical baseline" ;
        schema:measurementTechnique "Analytical BCF spiral wavelength 2*pi*v_inf/omega at r_c = 0.42 um" ;
        schema:name "Bivalve sheet nacre (*Pteria hirundo*) single-spiral terrace wavelength lambda_0" ;
        schema:unitText "um" ;
        schema:value "7.9736" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-bivalve-sheet-nacre-pteria-hirundo-single-spiral-terrace-wavelength-lambda-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-bivalve-sheet-nacre-pteria-hirundo-single-spiral-terrace-wavelength-lambda-0-reference> a schema:PropertyValue ;
        dct:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504" ;
        schema:value "7.9736" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-universal-bcf-terrace-pitch-ratio-lambda-0-r-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Universal BCF terrace pitch ratio lambda_0 / r_c = 18.9848 dimensionless" ;
        dct:description "Pass 1 baseline scalar check" ;
        schema:measurementTechnique "Ratio 2*pi / omega_0" ;
        schema:name "Universal BCF terrace pitch ratio lambda_0 / r_c" ;
        schema:unitText "dimensionless" ;
        schema:value "18.9848" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-universal-bcf-terrace-pitch-ratio-lambda-0-r-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-universal-bcf-terrace-pitch-ratio-lambda-0-r-c-reference> a schema:PropertyValue ;
        dct:source "Burton, Cabrera & Frank (1951) Phil. Trans. R. Soc. A 243:299-358" ;
        schema:value "18.9848" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


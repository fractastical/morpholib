sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-screw-dislocation-spirals> a pk:Claim ;
        rdfs:label "Cartwright & Checa (2007), Cartwright et al. (2009) & BCF (1951) nacre screw-dislocation spirals, Frank-Read target loops, and chitin pore mineral-bridge columnar vs sheet transition faithfully reproduces Haliotis rufescens (Gastropoda columnar nacre) / Pteria hirundo & Pinctada margaritifera (Bivalvia sheet nacre) morphology" ;
        dct:description "The simulation script(s) 2019-cartwright-nacre-screw-dislocation-spirals.py implement the cited source model as published and produce forms that match real Haliotis rufescens (Gastropoda columnar nacre) / Pteria hirundo & Pinctada margaritifera (Bivalvia sheet nacre) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 48.9/100, audit 2026-10-19-nacre-screw-dislocation-spirals-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/HEAD/2019-cartwright-nacre-screw-dislocation-spirals.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/HEAD/2019-cartwright-nacre-screw-dislocation-spirals.py; output: docs/media/nacre_screw_dislocation_spirals_comparison.png; organism: Haliotis rufescens (Gastropoda columnar nacre) / Pteria hirundo & Pinctada margaritifera (Bivalvia sheet nacre); checkpoint commit: https://github.com/fractastical/morpholib/commit/HEAD; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: d2c5586744b4a1dd453b702e1ae3b35d30b5d54166476472d0304e0d22c70b82; artifact_sha256: 096391d8be69d37506de9889872060a5d580ea74f090a0c8d1aa96992d815881; input_dataset_sha256: {datasets/nacre_screw_dislocation_spirals/haliotis_nacre_spirals_specimen.jpg=e4c6590464523f21..., datasets/nacre_screw_dislocation_spirals/nacre_screw_dislocation_spirals_reference.json=9de7ae07e42d2993..., datasets/nacre_screw_dislocation_spirals/paper_citations.bib=3df311760cfbb299..., datasets/nacre_screw_dislocation_spirals/scout_manifest.json=22cd8415a0587395...}" ;
        pk:derivedFromPaper <https://doi.org/10.1073/pnas.0900867106>,
            <https://doi.org/10.1098/rsif.2006.0188>,
            <https://doi.org/10.1098/rsta.1951.0006>,
            <https://doi.org/10.1098/rsta.2011.0600> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-specimen-match> ;
        pk:weightOfEvidence "0.489"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/HEAD/2019-cartwright-nacre-screw-dislocation-spirals.py> a schema:SoftwareSourceCode ;
        rdfs:label "2019-cartwright-nacre-screw-dislocation-spirals.py" ;

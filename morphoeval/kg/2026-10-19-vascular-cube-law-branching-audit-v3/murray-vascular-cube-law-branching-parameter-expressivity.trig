sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-vascular-cube-law-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1926a, 1926b), Zamir (1976) & Sherman (1981) minimum-work vascular cube law & arterial branching angles — Parameter expressivity: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Alpha, gamma, r_0 and generations remain swept/overridable; Pass 3 adds the F-L sweep over gamma in [2.2, 3.6] with Newtonian control (L596-636), three new CLI flags `--eye-radius-mm`, `--avr`, `--coupling {none,repulsive}` (L1788-1790) that reach `evaluate_hemispherical_av_coupling` (L1115-1120), and `--eta`/`--b`, dead in Pass 2, now drive Panel A, the F-L sweep and the A/V coupling (L1114-1120, L1147-1150). Deductions: `--seed` is still effectively dead — it is passed as `seed_cli` (L1104, L1812) but no default render path consumes it; heading jitter is exercised only in the self-test determinism check (-4); `--eta`/`--b` are still not wired into `run_gamma_power_sweep` (L1113), Panel D or the empirical junction evaluator, so the Newtonian sweep ignores them (-3); the F-L hematocrit H_D = 0.45 is a constant with no CLI or sweep (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1959-murray-vascular-cube-law-branching.py L1787–L1787: --seed documented as 'reserved'; seed_cli is accepted by render_outputs (L1104) but unused in any default path <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L1787-L1787>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L596–L636" ;
        dct:description "Newtonian vs Fahraeus-Lindqvist 7-generation exponent sweep over gamma in [2.2, 3.6] with parabolic refinement" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L596-L636> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L1777–L1819" ;
        dct:description "CLI: --alpha, --gamma, --eta, --b, --r0-um, --generations, --seed, --eye-radius-mm, --avr, --coupling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L1777-L1819> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L1111–L1120" ;
        dct:description "render_outputs wires eta/b into the F-L sweep and both A/V coupling runs but run_gamma_power_sweep (L1113) takes only generations and r0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L1111-L1120> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Loop 052 Pass 3 Assessor; supersedes the Gemini 4 Argon v2 assessment)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


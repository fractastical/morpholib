sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-vascular-cube-law-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1926a, 1926b), Zamir (1976) & Sherman (1981) minimum-work vascular cube law & arterial branching angles — Code-to-model traceability: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module header (L1-22) maps the Pass 3 additions to Sections 4b/4c, the three new sources and Lean Laws 4-5; every F-L function cites Pries (1992) Eq. 1 and states the normalisation; the cup section states its reduced-model boundary; the math KG loop file registers all five laws with Lean theorem names and refreshed code loci (L22-113, Law 4 L77-97, Law 5 L98-113) and new `model_spec` keys; measurement entries name the Lean theorem they rest on (L1605-1614, L1636-1645). Deductions: the `--self-test` help string and the `self_test()` docstring still say \"Pass 2\" (L1670, L1779) (-2); the handedness rule for A/V coupling (L714-727) and the 95 deg polar limit / 4 deg disc radius constants (L644-646) have no source beyond a comment (-3); the 82 um root radius attribution to Sherman (1981) is unsourced (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1959-murray-vascular-cube-law-branching.py L1779–L1779: --self-test help text still reads 'Pass 2 self-test suite' after the Pass 3 extension <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L1779-L1779>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-code-traceability-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L1–L22" ;
        dct:description "Module header mapping Sections 4b/4c, three new sources and Lean Laws 4-5 to code" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L1-L22> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/murray-vascular-cube-law-branching.yaml L22–L113" ;
        dct:description "Five laws registered with lean_theorem names and code_locus pins; Laws 4-5 added in Pass 3" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/math_kg_loops/murray-vascular-cube-law-branching.yaml#L22-L113> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L644–L646" ;
        dct:description "EYE_RADIUS_MM_DEFAULT, RETINA_POLAR_LIMIT_DEG and AVR_DEFAULT documented inline; AVR cites Hubbard 1999" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L644-L646> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Loop 052 Pass 3 Assessor; supersedes the Gemini 4 Argon v2 assessment)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


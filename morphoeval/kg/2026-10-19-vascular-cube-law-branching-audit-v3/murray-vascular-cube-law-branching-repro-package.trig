sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-vascular-cube-law-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1926a, 1926b), Zamir (1976) & Sherman (1981) minimum-work vascular cube law & arterial branching angles — Reproducibility package: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`self_test()` (L1669-1774) runs 9 suites — the 7 Pass 2 suites plus suite 8 (F-L shape, Newtonian limit, exponent shift; L1729-1746) and suite 9 (cup sphericity, reach, coupling effect, two-run determinism; L1747-1765) — and passes in 2.6 s; the default render completes in 4.9 s producing the PNG and both GIFs (L1418-1444, L1481-1486); the model is closed-form/deterministic with the only RNG path (heading jitter) seeded. Deductions: the new reference JSON is not SHA-256 pinned so a silent edit to the F-L coefficients would not be caught (-3); the `--self-test` help and docstring are stale (\"Pass 2\") (-1); no requirements lock is vendored for this script (versions recorded only in this audit's checkpoint) (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "1959-murray-vascular-cube-law-branching.py L78–L80: Only the specimen JPG is hash-pinned; fahraeus_lindqvist_retinal_cup_reference.json is loaded unpinned <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L78-L80>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-repro-package-4> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L1669–L1774" ;
        dct:description "9-suite self_test(): JSON parity, stationarity, asymmetric table, gamma* minimum, empirical fit, specimen segmentation, determinism, F-L suite 8, retinal-cup suite 9" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L1669-L1774> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L1729–L1765" ;
        dct:description "Suites 8-9 (Pass 3): F-L Newtonian limit and exponent shift; cup sphericity, polar reach, coupling effect and bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L1729-L1765> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L1418–L1444" ;
        dct:description "3D retinal-cup GIF rendered by the default invocation (7 frames)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L1418-L1444> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/vascular_cube_law_branching_growth.gif (generated output)" ;
        dct:description "2D multi-regime growth GIF regenerated by the default invocation (unchanged content from Pass 2) — docs/media/vascular_cube_law_branching_growth.gif: rendered output of 1959-murray-vascular-cube-law-branching.py at 028758bc, image/gif, 91025 B, 924×462 px, 7 frames, artifact_sha256 c159a8a7282558e4740dfa3158272cc77eb0a9404cf7cad24079fe9bafecbdd9 (sha256 c159a8a7282558e4740dfa3158272cc77eb0a9404cf7cad24079fe9bafecbdd9), spec_fingerprint 04d15104fa016f1fef6000d63f1ce9e4b79872913b2d27ac2256b74bf7018717" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Loop 052 Pass 3 Assessor; supersedes the Gemini 4 Argon v2 assessment)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


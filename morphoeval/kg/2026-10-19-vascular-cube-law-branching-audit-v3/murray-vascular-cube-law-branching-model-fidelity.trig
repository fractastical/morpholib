sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-vascular-cube-law-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1926a, 1926b), Zamir (1976) & Sherman (1981) minimum-work vascular cube law & arterial branching angles — Model fidelity to source: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Murray's (1926a) power functional, stationarity radius and exact tau_w = sqrt(eta b) invariance (L121-166, L305-359), Murray's (1926b) asymmetric cosine laws with Zamir, Steiner and Da Vinci controls (L175-240, L361-443) are unchanged and correct. Pass 3 adds the Fahraeus-Lindqvist mechanism correctly: eta(r) normalised so the large-vessel limit equals Murray's eta (L467-483), generalised stationarity Q*(r) = (pi/2) r^3 sqrt(b/(eta(r)(4 - eps))) with eps = d ln eta / d ln r (L486-521) and a bisection junction exponent (L524-551); the 3D cup uses exact geodesic stepping and Rodrigues tangent-plane rotations with cube-law radii (L655-745) and a flow-balance venous coupling k_v/k_a = sum r^3 / sum R^3 (L761-890). Five machine-checked Lean 4 theorems (0 `sorry`s). Deductions: the retinal cup is a kinematic growth rule with no haemodynamic solve or capillary closure, and its A/V \"coupling\" is a heuristic handedness choice (L714-727) that segregates territories rather than producing paired arcades (-4); the F-L fit is in-vitro at fixed H_D = 0.45 with no phase separation, and eta(r) is applied generation-wise to a symmetric tree (-2); the empirical junction evaluator (L242-300) still scores a table that is itself Murray-generated (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1959-murray-vascular-cube-law-branching.py L714–L727: A/V coupling is a geometric handedness rule (keep the side farther from the nearest rival node); no haemodynamic or angiogenic mechanism <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L714-L727>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-5> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L121–L166" ;
        dct:description "Poiseuille + metabolic power functional, conductance constant k_M, optimal radius and wall shear stress" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L121-L166> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L455–L551" ;
        dct:description "Pries 1992 eta_rel(D), apparent viscosity normalised to Murray's eta at large D, log-slope eps, generalised stationarity Q*(r), local gamma_eff and bisection junction exponent" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L455-L551> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L655–L745" ;
        dct:description "Geodesic Murray tree on a sphere: exact great-circle stepping, Rodrigues rotation about the surface normal, cube-law radii, repulsive A/V handedness rule (L714-727)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L655-L745> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "1959-murray-vascular-cube-law-branching.py L761–L890" ;
        dct:description "Arterial then venous trees, AVR-coupled venous root, k_v/k_a flow balance, interdigitation/pairing/crossing metrics, fundus-projection foreshortening" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L761-L890> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_052_vascular_cube_law_branching.lean L129–L170" ;
        dct:description "Laws 4-5: fl_stationarity_residual + fahraeus_lindqvist_stationarity_shift (Newtonian limit, vanishing residual, strict metabolic-share drop) and arteriovenous_coupled_cube_balance" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_052_vascular_cube_law_branching.lean#L129-L170> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Loop 052 Pass 3 Assessor; supersedes the Gemini 4 Argon v2 assessment)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


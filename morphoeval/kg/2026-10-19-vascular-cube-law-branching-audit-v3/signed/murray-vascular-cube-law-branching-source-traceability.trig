        dcterms:description "7 bib entries incl. pries1992viscosity, fahraeus1931viscosity, hubbard1999retinal (DOIs flagged unverified); no Zamir 1979 entry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/datasets/vascular_cube_law_branching/paper_citations.bib#L1-L77> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/vascular_cube_law_branching/fahraeus_lindqvist_retinal_cup_reference.json L1–L69" ;
        dcterms:description "Pries 1992 fit coefficients and parity table, generalised stationarity formulas, cup geometry and coupling rule, DOI-verification flags" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/datasets/vascular_cube_law_branching/fahraeus_lindqvist_retinal_cup_reference.json#L1-L69> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/vascular_cube_law_branching/README.md L30–L33" ;
        dcterms:description "'Caveats carried for audit' discloses the prescribed J01-J08 table and the synthetic Sherman hierarchy" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/datasets/vascular_cube_law_branching/README.md#L30-L33> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Loop 052 Pass 3 Assessor; supersedes the Gemini 4 Argon v2 assessment)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1926a, 1926b), Zamir (1976) & Sherman (1981) minimum-work vascular cube law & arterial branching angles — Source and data traceability: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`datasets/vascular_cube_law_branching/` vendors the reference JSON, the CC BY 4.0 specimen, `paper_citations.bib` (now 7 entries, L1-77), `scout_manifest.json`, the new `fahraeus_lindqvist_retinal_cup_reference.json` (Pries 1992 coefficients, parity table, generalised stationarity formulas, cup geometry, DOI-verification flags) and a README with an explicit \"Caveats carried for audit\" section (L30-33); runtime SHA-256 verification of the specimen (`verify_dataset_integrity`, L93-114). Deductions: the three Pass 3 DOIs (Pries 1992, Fåhraeus & Lindqvist 1931, Hubbard 1999) were recalled offline and are flagged as unverified in the bib, JSON and script header (L17-20) (-4); Zamir, Medeiros & Cunningham (1979), the stated source of J01-J08, has no bib entry and no DOI, and the table has no page/figure pin (-4); the Sherman (1981) hierarchy (JSON L72-80) is generated from r_g = 82 um * 2^(-g/3) and the 82 um root radius is not pinned to a page (-2); `EXPECTED_SHA256` (L78-80) pins only the specimen JPG — neither reference JSON is hash-pinned (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "1959-murray-vascular-cube-law-branching.py L17–L20: Header states the three Pass 3 DOIs were recalled, not verified online <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L17-L20>",
            "datasets/vascular_cube_law_branching/vascular_cube_law_branching_reference.json L72–L90: Sherman hierarchy generated (not digitised); J01-J08 'Zamir 1979' rows without page/figure provenance and with a Murray-prediction column <https://github.com/fractastical/morpholib/blob/028758bc/datasets/vascular_cube_law_branching/vascular_cube_law_branching_reference.json#L72-L90>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-source-traceability-4> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-vascular-cube-law-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-vascular-cube-law-branching-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1926a, 1926b), Zamir (1976) & Sherman (1981) minimum-work vascular cube law & arterial branching angles — Morphometric validation: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L1497-1666) now reports 15 metrics with reference values, methods, dispersion statistics and ablation controls; the 7 new entries include a parity check of the implemented F-L fit (eta_rel(10 um) = 1.328 vs 1.33), the tree optimum gamma*_FL = 2.773 with Newtonian control 3.000, the junction exponent 2.859 at 25 um, the sphericity residual 7e-15 mm, the AVR propagation with derived venous shear/b_v, the interdigitation index with uncoupled control, and the projection bias by eccentricity. Deductions: the headline Pass 2 claims (RMSE 0.134 deg, r = 0.9999 for J01-J08, L1545-1554) rest on a table that contains its own Murray prediction and has no page/figure provenance, so they are circular rather than validating (-6); the F-L reference value 2.7 (L1605-1614) is the Pass 2 audit's target, not a literature datum, and the stated reference_source says so (-3); the AVR metric (L1636-1645) equals its reference by construction (-2); the interdigitation reference 1.0 (L1646-1655) is an idealisation and the result 0.504 shows the coupling fails its purpose (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1959-murray-vascular-cube-law-branching.py L1605–L1614: gamma*_FL reference_value 2.7 is the Pass 2 audit remediation target, not a literature datum <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L1605-L1614>",
            "1959-murray-vascular-cube-law-branching.py L1636–L1655: AVR = 0.67 is an input (--avr) so value == reference by construction; interdigitation reference 1.0 is an idealisation, measured 0.504 ~ random <https://github.com/fractastical/morpholib/blob/028758bc/1959-murray-vascular-cube-law-branching.py#L1636-L1655>",
            "datasets/vascular_cube_law_branching/vascular_cube_law_branching_reference.json L81–L90: J01-J08 rows carry murray_predicted_total_deg and agree with it to <= 0.3 deg; no page/figure provenance — the RMSE/r metrics are circular <https://github.com/fractastical/morpholib/blob/028758bc/datasets/vascular_cube_law_branching/vascular_cube_law_branching_reference.json#L81-L90>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-3d-retinal-cup-geodesic-tree-sphericity-residual-max-p-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-arteriovenous-interdigitation-index-of-terminal-tips-on-the-retinal-cup-repulsive-coupling>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-coupled-arteriovenous-root-caliber-ratio-avr-artery-vein-on-the-retinal-cup>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-da-vinci-area-preserving-control-gamma-2-excess-vascular-tree-power-penalty>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-empirical-human-retinal-bifurcation-angle-rmse-murray-prediction-vs-j01-j08>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-empirical-retinal-cube-law-conservation-ratio-r-1-3-r-2-3-1-3-r-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-fahraeus-lindqvist-power-minimising-tree-exponent-gamma-fl-7-generation-sweep>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-fahraeus-lindqvist-relative-apparent-viscosity-eta-rel-at-d-10-um-h-d-0-45>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-fahraeus-lindqvist-symmetric-junction-exponent-gamma-j-at-pre-capillary-r-0-25-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-fundus-projection-foreshortening-bias-of-bifurcation-angle-theta-proj-theta-true-peripheral-60-deg-eccentricity>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-generational-wall-shear-stress-tau-w-across-7-sherman-1981-arteriole-levels>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-metabolic-to-viscous-power-ratio-at-optimal-radius-p-met-r-p-visc-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-segmented-retinal-fundus-specimen-y-junction-bifurcation-angle-mean>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-symmetric-daughter-radius-ratio-r-1-r-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-symmetric-total-bifurcation-angle-theta-1-theta-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-morphometric-validation-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-3d-retinal-cup-geodesic-tree-sphericity-residual-max-p-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D retinal-cup geodesic tree sphericity residual max | |p| - R | = 7.105e-15 mm" ;
        dcterms:description "max polar reach 86.7 deg (ora serrata limit 95.0 deg); geodesic/chord length ratio 1.00064; arterial geodesic length 550 mm" ;
        schema:measurementTechnique "all 1016 arterial + venous segment end-points of the hemispherical Murray trees checked against R = 12.0 mm" ;
        schema:name "3D retinal-cup geodesic tree sphericity residual max | |p| - R |" ;
        schema:unitText "mm" ;
        schema:value "7.105e-15" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-3d-retinal-cup-geodesic-tree-sphericity-residual-max-p-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-3d-retinal-cup-geodesic-tree-sphericity-residual-max-p-r-reference> a schema:PropertyValue ;
        dcterms:source "Geodesic construction on the schematic emmetropic globe (inner radius 12 mm, axial length ~24 mm)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-arteriovenous-interdigitation-index-of-terminal-tips-on-the-retinal-cup-repulsive-coupling> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "arteriovenous interdigitation index of terminal tips on the retinal cup (repulsive coupling) = 0.5039 fraction" ;
        dcterms:description "uncoupled control = 0.4141; nearest-tip A/V pairing fraction 0.309 (ctrl 0.359); mean A->V tip distance 1.355 mm (ctrl 1.050); projected A/V crossings 250 (ctrl 294). Index stays near random-mixing level: residual for Pass 4." ;
        schema:measurementTechnique "fraction of azimuthally adjacent terminal-tip pairs (about the optic axis) with opposite vessel type; 1.0 = perfect A/V alternation, 0.5 = random mixing" ;
        schema:name "arteriovenous interdigitation index of terminal tips on the retinal cup (repulsive coupling)" ;
        schema:unitText "fraction" ;
        schema:value "0.5039" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-arteriovenous-interdigitation-index-of-terminal-tips-on-the-retinal-cup-repulsive-coupling-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-arteriovenous-interdigitation-index-of-terminal-tips-on-the-retinal-cup-repulsive-coupling-reference> a schema:PropertyValue ;
        dcterms:source "Idealised alternating arteriovenous territories (reduced model; no quantitative human datum vendored)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-coupled-arteriovenous-root-caliber-ratio-avr-artery-vein-on-the-retinal-cup> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "coupled arteriovenous root caliber ratio AVR (artery/vein) on the retinal cup = 0.67 ratio" ;
        dcterms:description "k_v/k_a = 0.3008 => venous wall shear tau_v = 2.472 dyn/cm^2 vs arterial 8.219; venous metabolic constant b_v = 174.6 erg/s/cm^3; AVR is an input (set by --avr), so this is a parity/propagation check" ;
        schema:measurementTechnique "venous Murray tree root radius set by Q_a = Q_v coupling with AVR; venous constants k_v/k_a = sum r_tip^3 / sum R_tip^3 (Lean 4 arteriovenous_coupled_cube_balance)" ;
        schema:name "coupled arteriovenous root caliber ratio AVR (artery/vein) on the retinal cup" ;
        schema:unitText "ratio" ;
        schema:value "0.67" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-coupled-arteriovenous-root-caliber-ratio-avr-artery-vein-on-the-retinal-cup-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-coupled-arteriovenous-root-caliber-ratio-avr-artery-vein-on-the-retinal-cup-reference> a schema:PropertyValue ;
        dcterms:source "Hubbard LD et al. (1999) Ophthalmology 106:2269-2280 (ARIC retinal AVR ~ 2/3); Murray (1926a)" ;
        schema:value "0.67" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-da-vinci-area-preserving-control-gamma-2-excess-vascular-tree-power-penalty> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Da Vinci area-preserving control (gamma=2) excess vascular tree power penalty = 134.796 %" ;
        dcterms:description "numerical minimum found at gamma* = 3.000; wall shear CV at gamma=3 is 2.95e-16 vs +100% drift at gamma=2" ;
        schema:measurementTechnique "100 * (P_tree(gamma=2.0) - P_tree(gamma=3.0)) / P_tree(gamma=3.0) across 7-generation arterial tree" ;
        schema:name "Da Vinci area-preserving control (gamma=2) excess vascular tree power penalty" ;
        schema:unitText "%" ;
        schema:value "134.796" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-da-vinci-area-preserving-control-gamma-2-excess-vascular-tree-power-penalty-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-da-vinci-area-preserving-control-gamma-2-excess-vascular-tree-power-penalty-reference> a schema:PropertyValue ;
        dcterms:source "Murray (1926a) PNAS 12:207-214; Sherman (1981) J. Gen. Physiol. 78:431" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-empirical-human-retinal-bifurcation-angle-rmse-murray-prediction-vs-j01-j08> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "empirical human retinal bifurcation angle RMSE (Murray prediction vs J01-J08) = 0.1342 deg" ;
        dcterms:description "branch angle Pearson r = 1.0000 (p=6.18e-30), branch RMSE = 0.119 deg" ;
        schema:measurementTechnique "RMSE and Pearson r across N=8 asymmetric human retinal arterial junctions (alpha in 0.56..0.99)" ;
        schema:name "empirical human retinal bifurcation angle RMSE (Murray prediction vs J01-J08)" ;
        schema:unitText "deg" ;
        schema:value "0.1342" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-empirical-human-retinal-bifurcation-angle-rmse-murray-prediction-vs-j01-j08-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-empirical-human-retinal-bifurcation-angle-rmse-murray-prediction-vs-j01-j08-reference> a schema:PropertyValue ;
        dcterms:source "Zamir, Medeiros & Cunningham (1979) Invest. Ophthalmol. Vis. Sci. 18:659; Murray (1926b)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-empirical-retinal-cube-law-conservation-ratio-r-1-3-r-2-3-1-3-r-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "empirical retinal cube-law conservation ratio (r_1^3 + r_2^3)^(1/3) / r_0 = 0.9956 ratio" ;
        dcterms:description "std = 0.0034, CV = 0.0034; Da Vinci gamma=2 control gives 1.1088 (+11.7% bias)" ;
        schema:measurementTechnique "mean ± SD (CV) of (r_1^3 + r_2^3)^(1/3) / r_0 vs Da Vinci square-law ablation control (r_1^2 + r_2^2)^(1/2) / r_0" ;
        schema:name "empirical retinal cube-law conservation ratio (r_1^3 + r_2^3)^(1/3) / r_0" ;
        schema:unitText "ratio" ;
        schema:value "0.9956" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-empirical-retinal-cube-law-conservation-ratio-r-1-3-r-2-3-1-3-r-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-empirical-retinal-cube-law-conservation-ratio-r-1-3-r-2-3-1-3-r-0-reference> a schema:PropertyValue ;
        dcterms:source "Murray (1926a) PNAS 12:207-214; Sherman (1981) J. Gen. Physiol. 78:431" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-fahraeus-lindqvist-power-minimising-tree-exponent-gamma-fl-7-generation-sweep> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Fahraeus-Lindqvist power-minimising tree exponent gamma*_FL (7-generation sweep) = 2.7729 exponent" ;
        dcterms:description "Newtonian control gamma* = 3.0000; shift Delta gamma* = -0.2271; stationarity partition 2 P_met = (4 - epsilon) P_visc (Lean 4 fahraeus_lindqvist_stationarity_shift)" ;
        schema:measurementTechnique "argmin_gamma of total Poiseuille(eta(r_g)) + metabolic tree power over gamma in [2.2, 3.6] (141 pts, parabolic refinement) vs Newtonian control" ;
        schema:name "Fahraeus-Lindqvist power-minimising tree exponent gamma*_FL (7-generation sweep)" ;
        schema:unitText "exponent" ;
        schema:value "2.7729" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-fahraeus-lindqvist-power-minimising-tree-exponent-gamma-fl-7-generation-sweep-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-fahraeus-lindqvist-power-minimising-tree-exponent-gamma-fl-7-generation-sweep-reference> a schema:PropertyValue ;
        dcterms:source "Pass 2 audit remediation target (gamma ~ 2.7 for pre-capillary arterioles under F-L rheology); Newtonian Murray (1926a) control = 3.0" ;
        schema:value "2.7" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-fahraeus-lindqvist-relative-apparent-viscosity-eta-rel-at-d-10-um-h-d-0-45> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Fahraeus-Lindqvist relative apparent viscosity eta_rel at D = 10 um (H_D = 0.45) = 1.3284 ratio (eta_app / eta_plasma)" ;
        dcterms:description "bulk asymptote eta_rel = 3.2; at D=50 um eta_rel = 2.045, at D=164 um (root) 2.712; parity check of the implemented fit (not an independent datum)" ;
        schema:measurementTechnique "Pries, Neuhaus & Gaehtgens (1992) Eq. 1 in-vitro fit: 220 e^{-1.3 D} + 3.2 - 2.44 e^{-0.06 D^0.645}" ;
        schema:name "Fahraeus-Lindqvist relative apparent viscosity eta_rel at D = 10 um (H_D = 0.45)" ;
        schema:unitText "ratio (eta_app / eta_plasma)" ;
        schema:value "1.3284" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-fahraeus-lindqvist-relative-apparent-viscosity-eta-rel-at-d-10-um-h-d-0-45-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-fahraeus-lindqvist-relative-apparent-viscosity-eta-rel-at-d-10-um-h-d-0-45-reference> a schema:PropertyValue ;
        dcterms:source "Pries AR, Neuhaus D, Gaehtgens P (1992) Am. J. Physiol. 263:H1770-H1778 (Fig. 2/Eq. 1); Fahraeus & Lindqvist (1931) Am. J. Physiol. 96:562" ;
        schema:value "1.33" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-fahraeus-lindqvist-symmetric-junction-exponent-gamma-j-at-pre-capillary-r-0-25-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Fahraeus-Lindqvist symmetric junction exponent gamma_j at pre-capillary r_0 = 25 um = 2.8595 exponent" ;
        dcterms:description "epsilon(25 um) = 0.2724, P_met/P_visc = 1.8638 (<2); mean local gamma_eff over r<25 um = 2.9284, min = 2.8594; at r_0 = 82 um gamma_j = 2.8868" ;
        schema:measurementTechnique "solve Q*(r_1) = Q*(r_0)/2 on the generalised stationarity curve Q*(r) = (pi/2) r^3 sqrt(b / (eta(r)(4 - epsilon))) ; gamma_j = ln2 / ln(r_0/r_1)" ;
        schema:name "Fahraeus-Lindqvist symmetric junction exponent gamma_j at pre-capillary r_0 = 25 um" ;
        schema:unitText "exponent" ;
        schema:value "2.8595" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-fahraeus-lindqvist-symmetric-junction-exponent-gamma-j-at-pre-capillary-r-0-25-um-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-fahraeus-lindqvist-symmetric-junction-exponent-gamma-j-at-pre-capillary-r-0-25-um-reference> a schema:PropertyValue ;
        dcterms:source "Murray (1926a) Newtonian cube law (control); Pries et al. (1992) eta(D)" ;
        schema:value "3.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-fundus-projection-foreshortening-bias-of-bifurcation-angle-theta-proj-theta-true-peripheral-60-deg-eccentricity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fundus-projection foreshortening bias of bifurcation angle |Theta_proj - Theta_true| (peripheral, >= 60 deg eccentricity) = 32.382 deg" ;
        dcterms:description "central (<30 deg) |bias| = 3.298 deg, all-tree mean |bias| = 12.987 deg, signed mean = +1.357 deg; bounds how much of the segmented specimen's 79.3 deg vs 74.9 deg gap can be projection artefact" ;
        schema:measurementTechnique "orthographic (fundus-camera) projection of 3D tangent-plane Murray bifurcations on the retinal cup vs their true geodesic angles, binned by eccentricity" ;
        schema:name "fundus-projection foreshortening bias of bifurcation angle |Theta_proj - Theta_true| (peripheral, >= 60 deg eccentricity)" ;
        schema:unitText "deg" ;
        schema:value "32.382" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-fundus-projection-foreshortening-bias-of-bifurcation-angle-theta-proj-theta-true-peripheral-60-deg-eccentricity-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-fundus-projection-foreshortening-bias-of-bifurcation-angle-theta-proj-theta-true-peripheral-60-deg-eccentricity-reference> a schema:PropertyValue ;
        dcterms:source "Murray (1926b) angles are tangent-plane quantities; the planar fundus specimen reports projected angles" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-vascular-cube-law-branching-measurement-generational-wall-shear-stress-tau-w-across-7-sherman-1981-arteriole-levels> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "generational wall shear stress tau_w across 7 Sherman (1981) arteriole levels = 8.2189 dyn/cm^2" ;
        dcterms:description "generational shear CV = 2.95e-16 (exact scale invariance)" ;
        schema:measurementTechnique "tau_w = 4*eta*Q_g / (pi*r_g^3) = sqrt(eta*b) across generations g=0..6" ;
        schema:name "generational wall shear stress tau_w across 7 Sherman (1981) arteriole levels" ;
        schema:unitText "dyn/cm^2" ;

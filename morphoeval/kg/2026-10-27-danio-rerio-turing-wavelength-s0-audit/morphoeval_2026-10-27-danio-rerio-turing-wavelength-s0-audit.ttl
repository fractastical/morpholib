<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Danio rerio Holocene 24.08 µm anisotropic Schnakenberg wavelength (pass 1) — Morphological realism / specimen match: 74/100" ;

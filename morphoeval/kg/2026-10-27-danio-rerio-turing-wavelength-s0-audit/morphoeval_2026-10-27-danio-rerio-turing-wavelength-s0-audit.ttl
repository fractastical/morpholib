<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-danio-rerio-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-danio-rerio-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-danio-rerio-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-danio-rerio-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg Jacobian trace and determinant" ;
    dct:description "Homogeneous steady state of the 24.08 µm Danio rerio pigment system is stable without diffusion | Variables: a=0.11, b=1.24, fu≈0.837, gv≈-1.823, det≈1.823, tr≈-0.985" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Nakamasu et al. 2009 DOI:10.1073/pnas.0808622106" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3164_danio_rerio_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u0=a+b, v0=b/u0^2, f_u=-1+2 u0 v0, g_v=-u0^2, det=f_u g_v-f_v g_u" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.cels.2015.12.001>,
        <https://doi.org/10.1038/ncomms6299>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/dev.01526> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3164.turingMargin" ;
    pk:leanTheorem "MathOfBiology.Loop_3164.rerio_dv_axis_turing_unstable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-danio-rerio-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical Turing wavenumber on the dorsoventral axis" ;
    dct:description "Selects the detail-scale pigment wavelength of extant Danio rerio | Variables: Du=0.80, Dv_y=20.80, gamma=0.1989, Ly=144.48 µm holds 6 wavelengths" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3164_danio_rerio_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c = argmax_k sigma(0, k; Du, Dv_y, gamma), lambda_c = 2 pi / k_c = 24.08 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.cels.2015.12.001>,
        <https://doi.org/10.1038/ncomms6299>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/dev.01526> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3164.turingMargin" ;
    pk:leanTheorem "MathOfBiology.Loop_3164.six_wavelengths_span_the_cellular_window" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-danio-rerio-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Anisotropic axis selection versus Danio nigrofasciatus" ;
    dct:description "Holocene D. rerio collapses the AP Turing band; the predecessor does not | Variables: aniso_rerio=3.85, aniso_predecessor=1.12, age=0 Ma" ;
    dct:source "Hiscock & Megason 2015 DOI:10.1016/j.cels.2015.12.001; Quigley et al. 2004 DOI:10.1242/dev.01526" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3164_danio_rerio_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "margin(Dv)=h(Dv)^2-4 Du Dv det; margin(Dv_y)>0, margin(Dv_x)<0 iff Dv_y/Dv_x=3.85" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.cels.2015.12.001>,
        <https://doi.org/10.1038/ncomms6299>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/dev.01526> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3164.turingMargin" ;
    pk:leanTheorem "MathOfBiology.Loop_3164.rerio_ap_axis_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


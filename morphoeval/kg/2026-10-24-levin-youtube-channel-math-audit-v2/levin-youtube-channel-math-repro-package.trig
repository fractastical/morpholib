sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-levin-youtube-channel-math> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-levin-youtube-channel-math-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-levin-youtube-channel-math-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "@drmichaellevin 25-law mathematical synthesis & biological-law-criteria suite (referee re-score) — Reproducibility package: 52/100" ;
        dct:date "2026-10-24"^^xsd:date ;
        dct:description "Positives: fully deterministic (no RNG is used, so the `seed: 20261024` in the math-KG YAML is decorative but harmless); `--self-test` exits 0 in 0.3 s; the default run writes the PNG to media/ and docs/ and the summary JSON; `lean` compiles both modules in under 3 s with 0 sorry; Python/numpy/scipy/ matplotlib versions are recorded in v1 and re-confirmed here (3.14.7 / 2.5.4 / 1.16.3 / 3.10.7, Lean 4.35.0 added). Deductions: the self-test's 25 assertions compare each metric with a `ref` computed by the same expression at absolute tolerance 0.01, so the package cannot fail on any change to the constants that keeps both sides in step and did not catch the Law 3 transcription error (-14); `--self-test` writes morphoeval/runs/levin_youtube_channel_math_summary.json as a side effect even in test mode (-3); the figure (L244-L377), i.e. the shipped output, is not exercised by the self-test (-4); the Lean check is not invoked by the script and `all_lean4_verified` is asserted, not measured (-6); no dependency pin or lock file is specific to this script and matplotlib's font cache goes outside the repo unless MPLCONFIGDIR is set (-3); every audited file except MathOfBiology.lean is an untracked working-tree file, so the v1 checkpoint commit a2201fd3 does not contain the artefacts it scores and no commit can yet be cited for them (-10); the catalog's claimed SHA-256 lock is not enforced anywhere (-3); the Substack article, KG payload and README describe a '6-law' suite in places and a '25-law' suite in others, so a reader cannot tell which package was scored (-5)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "docs/bioelectricity/levin_youtube_kg.json L1–L12: KG payload: total_laws 25, all_lean4_verified true (copied from the script's literal), published nanopub URIs for the v1 93.8 assessment; this payload is what downstream consumers read <https://github.com/fractastical/morpholib/blob/bfe377c2/docs/bioelectricity/levin_youtube_kg.json#L1-L12>",
            "models/2026-levin-channel-math-synthesis.py L380–L395: run_all: 25 assertions at abs tolerance 0.01 against self-computed refs; summary JSON written unconditionally (also in --self-test); figure rendered only when not self-testing <https://github.com/fractastical/morpholib/blob/bfe377c2/models/2026-levin-channel-math-synthesis.py#L380-L395>",
            "morphoeval/audits/2026-10-24-levin-youtube-channel-math-audit.yaml L33–L44: v1 checkpoint a2201fd3 with note 'formalizing 6 core mathematical laws'; the 25-law script, Lean loop, YAML, docs and KG payload are untracked in the working tree, so no commit contains what was scored <https://github.com/fractastical/morpholib/blob/bfe377c2/morphoeval/audits/2026-10-24-levin-youtube-channel-math-audit.yaml#L33-L44>",
            "morphoeval/math_kg_loops/levin-youtube-channel-math.yaml L1–L8: seed: 20261024 declared; the script draws no random numbers, and the declared input catalog is not read <https://github.com/fractastical/morpholib/blob/bfe377c2/morphoeval/math_kg_loops/levin-youtube-channel-math.yaml#L1-L8>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-2> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-levin-channel-math-synthesis.py L398–L403" ;
        dct:description "Entry point: deterministic, `--self-test` exits 0 in 0.3 s (reproduced in this audit)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/bfe377c2/models/2026-levin-channel-math-synthesis.py#L398-L403> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_levin_youtube_channel_math.lean L1–L10" ;
        dct:description "Module header documents `lean morphoeval/lean/loops/Loop_levin_youtube_channel_math.lean`; reproduced here, exit 0, 0 sorry, 2.2 s" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/bfe377c2/morphoeval/lean/loops/Loop_levin_youtube_channel_math.lean#L1-L10> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Anthropic; independent cross-provider MorphoEval referee, Pass 2)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


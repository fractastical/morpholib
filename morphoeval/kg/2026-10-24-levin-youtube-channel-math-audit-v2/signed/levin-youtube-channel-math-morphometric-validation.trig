        schema:value "0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-2-cervera-levin-mafe-open-fraction-g-ij-g-0-at-v-i-v-j-60-mv-v-th-35-v-0-5> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Law 2 (Cervera-Levin-Mafe) - open fraction G_ij/G_0 at V_i = V_j = -60 mV (V_th = -35, V_0 = 5) = 0.98666 fraction" ;
        dcterms:description "A single point on a published closed form; no ODE integration, no conductance measurement from Cervera-Levin-Mafe is compared" ;

        dcterms:description "No independent reference; no cable equation or phase model is integrated" ;
        schema:measurementTechnique "-2 * 2 * 25" ;
        schema:name "Law 23 (ephaptic coupling) - d(Delta phi^2)/dt at g_eph = 2, Delta phi = 5" ;
        schema:unitText "rad2_per_sec" ;
        schema:value "-100" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-24-ca2-integral-feedback-steady-state-error-ca-ss-ca-target> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Law 24 (Ca2+ integral feedback) - steady-state error [Ca]_ss - Ca_target = 0 nM" ;
        dcterms:description "Not a measurement: an identity x - x = 0. The integral-feedback ODE, its saturation and the remodeling bifurcation named in the law are not implemented" ;
        schema:measurementTechnique "ca_target - ca_target (script L192-L193)" ;
        schema:name "Law 24 (Ca2+ integral feedback) - steady-state error [Ca]_ss - Ca_target" ;
        schema:unitText "nM" ;
        schema:value "0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-25-nca-memory-transfer-error-after-4-halvings-from-e-0-64> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Law 25 (NCA memory transfer) - error after 4 halvings from e_0 = 64 = 4 l2_error" ;
        dcterms:description "No independent reference; no NCA is run, rho = 1/2 is assumed" ;
        schema:measurementTechnique "64 // 2^4" ;
        schema:name "Law 25 (NCA memory transfer) - error after 4 halvings from e_0 = 64" ;
        schema:unitText "l2_error" ;
        schema:value "4" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-3-pietak-levin-boltzmann-ratio-c-post-c-ant-exp-40-mv-25-85-mv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Law 3 (Pietak-Levin Boltzmann ratio) - c_post/c_ant = exp(40 mV / 25.85 mV) = 4.6992 ratio" ;
        dcterms:description "No published concentration ratio from Pietak & Levin (2016, 2017) is compared; the 40 mV gradient is a chosen constant" ;
        schema:measurementTechnique "exp(40/25.85) re-evaluated = 4.69918; kT/e at 300 K = 25.86 mV" ;
        schema:name "Law 3 (Pietak-Levin Boltzmann ratio) - c_post/c_ant = exp(40 mV / 25.85 mV)" ;
        schema:unitText "ratio" ;
        schema:value "4.6992" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-3-pietak-levin-boltzmann-ratio-c-post-c-ant-exp-40-mv-25-85-mv-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-3-pietak-levin-boltzmann-ratio-c-post-c-ant-exp-40-mv-25-85-mv-reference> a schema:PropertyValue ;
        dcterms:source "Analytic value of exp(z F dV / R T) at dV = 40 mV, 25.85 mV (independent re-evaluation). The script's ref 4.7002 (L205) corresponds to dV = 40.006 mV and is a transcription error that passes only under the 0.01 absolute tolerance" ;
        schema:value "4.6992" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-4-galvanotaxis-cathodal-enrichment-exp-pe-e-at-pe-e-4> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Law 4 (galvanotaxis) - cathodal enrichment exp(Pe_E) at Pe_E = 4 = 54.5982 fold_enrichment" ;
        dcterms:description "No independent reference: Pe_E = 4 is unsourced and the script's ref is round(exp(4.0), 4), the identical expression (L206)" ;
        schema:measurementTechnique "exp(4.0) re-evaluated" ;
        schema:name "Law 4 (galvanotaxis) - cathodal enrichment exp(Pe_E) at Pe_E = 4" ;
        schema:unitText "fold_enrichment" ;
        schema:value "54.5982" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-5-chvykov-low-rattling-log-log-slope-of-p-ss-vs-r-exit> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Law 5 (Chvykov low rattling) - log-log slope of P_ss vs r_exit = -1.0 dimensionless" ;
        dcterms:description "Circular by construction; the 15.625x 'enrichment' is 1.25/0.08. Chvykov et al. (2021) report measured low-rattling enrichment on smarticle collectives; none of that is compared" ;
        schema:measurementTechnique "Analytic: with p_ss := r^-1 / Z (script L75), ln p_ss = -ln r - ln Z, so the OLS slope is exactly -1 for any r grid; no fit is needed" ;
        schema:name "Law 5 (Chvykov low rattling) - log-log slope of P_ss vs r_exit" ;
        schema:unitText "dimensionless" ;
        schema:value "-1.0" .


    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-15-mortal-computation-t-surv-e-reserve-p-diss-p-harvest> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Law 15 (mortal computation) - T_surv = E_reserve / (P_diss - P_harvest) = 50.0 time_units" ;
        dcterms:description "No independent reference; constants chosen" ;
        schema:measurementTechnique "100 / (5 - 3)" ;
        schema:name "Law 15 (mortal computation) - T_surv = E_reserve / (P_diss - P_harvest)" ;
        schema:unitText "time_units" ;
        schema:value "50.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-16-shannon-hartley-c-1-2-log2-1-snr-at-snr-15> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Law 16 (Shannon-Hartley) - C = 1/2 log2(1 + SNR) at SNR = 15 = 2.0 bits_per_symbol" ;
        dcterms:description "No independent reference; SNR = 15 is chosen to give an integer. The Lean theorem registered for this law proves a different equation (100 - 20 - 50 = 30)" ;
        schema:measurementTechnique "0.5 * log2(16)" ;
        schema:name "Law 16 (Shannon-Hartley) - C = 1/2 log2(1 + SNR) at SNR = 15" ;
        schema:unitText "bits_per_symbol" ;
        schema:value "2.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-17-causal-emergence-2-0-delta-cp-i-on-s-6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Law 17 (causal emergence 2.0) - Delta CP(I) on S_6 = 0.1191 Delta_CP" ;
        dcterms:description "Model-internal reference; the practitioner's guide gives deg_m = 0.0192 where the script uses 0.0191. Nothing is recomputed in this script" ;
        schema:measurementTechnique "(1.0000 - 0.0313) - (0.8687 - 0.0191) re-evaluated from the six constants typed into L143-L145" ;
        schema:name "Law 17 (causal emergence 2.0) - Delta CP(I) on S_6" ;
        schema:unitText "Delta_CP" ;
        schema:value "0.1191" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-17-causal-emergence-2-0-delta-cp-i-on-s-6-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-17-causal-emergence-2-0-delta-cp-i-on-s-6-reference> a schema:PropertyValue ;
        dcterms:source "sorting-morphogenesis/PLATONIC_SPACE_CLAIMS_EVALUATION.md L113 (repository-internal prior S_6 run: CP_micro 0.8496, CP_I 0.9687); not from Hoel (2026)" ;
        schema:value "0.1191" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-18-o-information-omega-xor-3-from-the-explicit-joint-distribution> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Law 18 (O-information) - Omega(XOR_3) from the explicit joint distribution = -1.0 bits" ;
        dcterms:description "The script's value agrees but is obtained from hand-typed entropies (L153)" ;
        schema:measurementTechnique "Joint p(x1, x2, x1 xor x2) = 1/4 constructed; H(X^3) = 2, H(X_i) = 1, H(X_-i) = 2; Omega = (3-2)*2 + 3*(1-2) = -1 computed from the distribution, not typed in" ;
        schema:name "Law 18 (O-information) - Omega(XOR_3) from the explicit joint distribution" ;
        schema:unitText "bits" ;
        schema:value "-1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-18-o-information-omega-xor-3-from-the-explicit-joint-distribution-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-18-o-information-omega-xor-3-from-the-explicit-joint-distribution-reference> a schema:PropertyValue ;
        dcterms:source "Independent computation from the XOR joint distribution with the Rosas et al. (2019) definition" ;
        schema:value "-1.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-19-bode-waterbed-net-log-sensitivity-integral> a schema:PropertyValue,

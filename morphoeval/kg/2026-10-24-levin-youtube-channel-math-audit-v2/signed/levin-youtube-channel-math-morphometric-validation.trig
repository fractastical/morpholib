        schema:measurementTechnique "(1.0/0.05) / (0.1/2.0)" ;
        schema:name "Law 13 (Brenner exploratory noise) - variance expansion ratio" ;
        schema:unitText "fold_expansion" ;
        schema:value "400.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-14-variational-free-energy-df-dt-at-kappa-0-5-grad-f-2-4> a schema:PropertyValue,

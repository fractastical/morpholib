        rdfs:label "Law 6 (epiplexity) - L_F = E_F + H_F = 0.94 bits_per_symbol" ;
        dcterms:description "No independent reference: both summands are invented constants; no epiplexity estimator is run on any sequence" ;
        schema:measurementTechnique "0.82 + 0.12 (script L81-L82)" ;
        schema:name "Law 6 (epiplexity) - L_F = E_F + H_F" ;
        schema:unitText "bits_per_symbol" ;
        schema:value "0.94" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-7-secretary-problem-optimal-cutoff-k-and-success-probability-p-opt-for-n-100> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Law 7 (secretary problem) - optimal cutoff k* and success probability P_opt for N = 100 = 0.371043 probability" ;
        dcterms:description "Genuine computation. Attribution to Froese (2023, 2024) is unsupported; floor(100/e) = 36, not 37, and the Lean theorem brackets 100566 = 37 * 2718 rather than 100000" ;
        schema:measurementTechnique "Exact rational maximisation of (k/N) * sum_{j=k}^{N-1} 1/j over k = 1..99 (Fraction arithmetic): argmax k* = 37, P* = 0.3710428" ;
        schema:name "Law 7 (secretary problem) - optimal cutoff k* and success probability P_opt for N = 100" ;
        schema:unitText "probability" ;
        schema:value "0.371043" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-7-secretary-problem-optimal-cutoff-k-and-success-probability-p-opt-for-n-100-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-7-secretary-problem-optimal-cutoff-k-and-success-probability-p-opt-for-n-100-reference> a schema:PropertyValue ;
        dcterms:source "Classical secretary-problem optimum for N = 100 (Lindley 1961; Gilbert & Mosteller 1966), independently re-derived; the 1/e = 0.367879 the v1 sidecar used is the N -> infinity asymptote" ;
        schema:value "0.371043" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-8-polycomputing-truth-table-agreement-of-xor-and-or-observers-on-s-a-b> a schema:PropertyValue,

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-2-cervera-levin-mafe-open-fraction-g-ij-g-0-at-v-i-v-j-60-mv-v-th-35-v-0-5-reference> a schema:PropertyValue ;
        dcterms:source "Analytic value of the Bell-Boltzmann form at the stated constants (independent re-evaluation; not a published measurement). Script rounds to 0.9867, v1 ref 0.9866" ;
        schema:value "0.98666" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-20-multicellular-pd-breakeven-cluster-size-and-first-strictly-dominant-cluster-size-b-2-c-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Law 20 (multicellular PD) - breakeven cluster size and first strictly dominant cluster size (b = 2, c = 1) = 4 cells" ;
        dcterms:description "The script's and figure's 'dominance at k = 16' is wrong by one: strict dominance begins at k = 17" ;
        schema:measurementTechnique "pi_C(k) = (1 - 1/sqrt k) b - c = 0 at k = 4 (independent); pi_C(k) > pi_D(k) = b/sqrt k first holds at k = 17 (pi_C(16) = pi_D(16) = 0.5)" ;
        schema:name "Law 20 (multicellular PD) - breakeven cluster size and first strictly dominant cluster size (b = 2, c = 1)" ;
        schema:unitText "cells" ;
        schema:value "4" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-20-multicellular-pd-breakeven-cluster-size-and-first-strictly-dominant-cluster-size-b-2-c-1-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-20-multicellular-pd-breakeven-cluster-size-and-first-strictly-dominant-cluster-size-b-2-c-1-reference> a schema:PropertyValue ;
        dcterms:source "Closed-form threshold of the Delphi O2 payoff (independent re-derivation); not a published value. Shreesha & Levin (2025) OSF report lattice-simulation outcomes, not this formula" ;
        schema:value "4" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-21-fisher-natural-gradient-du-dt-at-lambda-min-2-grad-u-2-9> a schema:PropertyValue,
            pk:EvidenceItem ;

        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-8-polycomputing-truth-table-agreement-of-xor-and-or-observers-on-s-a-b-reference> .


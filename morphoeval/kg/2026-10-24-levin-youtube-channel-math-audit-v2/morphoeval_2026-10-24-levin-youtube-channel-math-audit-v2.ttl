<https://w3id.org/delphi/resource/math-law/levin-youtube-channel-math-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Law 1: Levin (2019, 2022) TAME Spatiotemporal Cognitive Light Cone & Cancer Bioelectric Defection Law" ;
    dct:description "Quantifies how gap-junction coupling scales cellular homeostatic setpoints from single-cell proliferation (G_gj=0, cancer defection) to organ-scale anatomical targets | Variables: N: coupled cell count; G_gj: gap-junctional conductance; G_{1/2}: half-saturation coupling; R_eff: effective morphogenetic goal radius" ;
    dct:source "Levin (2019) Front. Psychol. 10:2688; Levin (2022) Front. Syst. Neurosci. 16:768201; @drmichaellevin [rAsIQGXdVRM], [46b_kB_KPFM], [K5VI0u5_12k], [wj8RkmS3kpM]" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bfe377c2/models/2026-levin-channel-math-synthesis.py#L45-L53>,
        <https://github.com/fractastical/morpholib/blob/bfe377c2/morphoeval/lean/loops/Loop_levin_youtube_channel_math.lean#L16-L31> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def tame_goal_radius_num (r_cell N g_gj g_half : Nat) : Nat :=
  r_cell * (g_gj + g_half) + r_cell * (N - 1) * g_gj
theorem tame_cognitive_light_cone_scaling_and_cancer_collapse (r_cell g_half : Nat) :
    tame_goal_radius_num r_cell 100 0 g_half = r_cell * g_half ∧
    tame_goal_radius_num 1 100 10 0 = 1000 ∧
    tame_goal_radius_num 1 100 10 1 = 1001 ∧
    1001 / (10 + 1) = 91 := by
  refine ⟨?_, by decide, by decide, by decide⟩; simp [tame_goal_radius_num]
"""^^pk:lean4 ;
    skos:notation "R_eff(N, G_gj) = r_cell [1 + (N - 1) G_gj / (G_gj + G_{1/2})],   V_CLC(N, G_gj) = R_eff(N, G_gj)^d (τ_past + τ_future);   G_gj → 0 ⟹ R_eff → r_cell" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.tree.2015.11.009>,
        <https://doi.org/10.1038/s41567-020-0795-y>,
        <https://doi.org/10.1038/s41586-022-04889-6>,
        <https://doi.org/10.1038/s42003-025-08411-2>,
        <https://doi.org/10.1080/01621459.1966.10502008>,
        <https://doi.org/10.1098/rsif.2017.0425>,
        <https://doi.org/10.1103/PhysRevE.100.032305>,
        <https://doi.org/10.1126/science.abc6182>,
        <https://doi.org/10.3389/fbioe.2016.00055>,
        <https://doi.org/10.3389/fnsys.2022.768201>,
        <https://doi.org/10.3389/fpsyg.2019.02688>,
        <https://doi.org/10.3390/biomimetics8010110>,
        <https://doi.org/10.3390/e25050748>,
        <https://doi.org/10.3390/e26040288>,
        <https://doi.org/10.3390/ijms24010285> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Complete 25-Law Mathematical Atlas of Multiscale Bioelectricity, Low-Rattling, Epiplexity, Polycomputing, Natural Induction, Active Inference, Causal Emergence & Multicellular Evolution" ;
    pk:leanDeclaration "LoopLevinYouTubeChannelMath.tame_goal_radius_num" ;
    pk:leanTheorem "LoopLevinYouTubeChannelMath.tame_cognitive_light_cone_scaling_and_cancer_collapse" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/levin-youtube-channel-math-10> a skos:Concept,
        pk:Concept ;
    rdfs:label "Law 10: Weber, Koch, Erdem & Froese (2024) Hopfield Propositional k-SAT Energy Relaxation Law" ;
    dct:description "Proves that continuous Hopfield attractor relaxation solves logical constraint satisfaction problems when E_SAT reaches 0 | Variables: C_m: m-th propositional constraint clause; s_l: binary neural/gene state; E_SAT: higher-order Hopfield Lyapunov energy" ;
    dct:source "Weber, Koch, Erdem & Froese (2024) @drmichaellevin [r3onu55UL6E]; Grochow [FWuTpyevbK0]" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bfe377c2/models/2026-levin-channel-math-synthesis.py#L102-L106>,
        <https://github.com/fractastical/morpholib/blob/bfe377c2/morphoeval/lean/loops/Loop_levin_youtube_channel_math.lean#L161-L170> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def sat_clause_penalty (l1 l2 l3 : Bool) : Nat :=
  (if l1 then 0 else 1) * (if l2 then 0 else 1) * (if l3 then 0 else 1)
theorem weber_koch_froese_hopfield_ksat_zero_energy_iff (l1 l2 l3 : Bool) :
    (sat_clause_penalty l1 l2 l3 == 0) = (l1 || l2 || l3) := by
  cases l1 <;> cases l2 <;> cases l3 <;> rfl
"""^^pk:lean4 ;
    skos:notation "E_SAT(s) = ∑_{m=1}^M ∏_{l ∈ C_m} (1 - J_{m,l} s_l)/2 ≥ 0,   E_SAT(s^*) = 0 ⟺ ∀ m, ∃ l ∈ C_m : J_{m,l} s^*_l = +1" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.tree.2015.11.009>,
        <https://doi.org/10.1038/s41567-020-0795-y>,
        <https://doi.org/10.1038/s41586-022-04889-6>,

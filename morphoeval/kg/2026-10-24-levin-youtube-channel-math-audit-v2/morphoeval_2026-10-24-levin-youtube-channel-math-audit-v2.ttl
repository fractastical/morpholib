<https://w3id.org/delphi/resource/math-law/levin-youtube-channel-math-13> a skos:Concept,
        pk:Concept ;
    rdfs:label "Law 13: Naama Brenner (2024) Exploratory Transcriptional Adaptation via Stress-Gated Langevin Noise Law" ;
    dct:description "Explains how cells escape novel unprogrammed stressors via stress-amplified transcriptional diffusion before re-locking homeostasis | Variables: M: cellular metabolic stress; k_fb(M): homeostatic restoring stiffness; D(M): transcriptional fluctuation amplitude; σ^2_ss: stationary variance" ;
    dct:source "Brenner (2024) @drmichaellevin [ZeICh6zCJq8]; Grassi [80eUTmH968E]" ;

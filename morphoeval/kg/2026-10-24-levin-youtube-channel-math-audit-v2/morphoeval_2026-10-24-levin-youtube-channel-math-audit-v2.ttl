    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def brenner_stationary_variance (D_noise k_fb : Nat) : Nat := D_noise / k_fb
theorem brenner_exploratory_transcriptional_noise_variance_law :

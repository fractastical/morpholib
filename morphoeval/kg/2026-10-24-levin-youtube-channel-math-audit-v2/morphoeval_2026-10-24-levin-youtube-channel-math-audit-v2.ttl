    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def ce2_cp (det deg : Int) : Int := det - deg
theorem hoel_albantakis_causal_emergence_ce2_primitive_law :
    ce2_cp 10000 313 - ce2_cp 8687 191 = 1191 ∧
    ce2_cp 7209 1238 - ce2_cp 8687 191 = -2525 := by decide
"""^^pk:lean4 ;

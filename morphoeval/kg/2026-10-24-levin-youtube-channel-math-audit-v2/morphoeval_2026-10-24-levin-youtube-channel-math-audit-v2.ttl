    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def cellular_proliferation_budget (e_total e_maint e_info : Nat) : Nat :=
  e_total - e_maint - e_info
theorem gatenby_picard_fields_landauer_signaling_budget_law :

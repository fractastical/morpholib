<https://w3id.org/delphi/resource/math-law/levin-youtube-channel-math-17> a skos:Concept,
        pk:Concept ;
    rdfs:label "Law 17: Hoel & Albantakis (2013, 2024, 2026) Causal Emergence 2.0 Intensive Causal Primitive Law" ;
    dct:description "Separates genuine macroscale causal emergence (I(v), +0.1191) from lossy observer projection artifacts (E(v), -0.2525) | Variables: det(π): macroscale transition determinism; deg(π): transition degeneracy; CP(π): intensive causal primitive" ;
    dct:source "Hoel (2026) Patterns 7:101472; Albantakis (2024) @drmichaellevin [5cXtdZ4blKM]; Dietz (2025) [OPUhmQrmqRg]" ;

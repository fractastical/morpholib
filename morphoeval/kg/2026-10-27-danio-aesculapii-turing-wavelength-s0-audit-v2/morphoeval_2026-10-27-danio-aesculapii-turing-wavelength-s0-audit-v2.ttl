<https://w3id.org/delphi/resource/math-law/delphi10000-danio-aesculapii-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Sign of det J is the first Turing necessary condition at the 20.8 µm steady state | Variables: f_u=0.7500, g_v=-1.2544, f_v=1.2544, g_u=-1.7500 at the Schnakenberg steady state u0=1.12" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/cfb8887378258c806d4412f6b1faac9a96299054/models/2026-delphi10000-danio-aesculapii-turing-wavelength-s0.py#L96-L114>,
        <https://github.com/fractastical/morpholib/blob/cfb8887378258c806d4412f6b1faac9a96299054/morphoeval/lean/loops/Loop_3160_danio_aesculapii_turing_wavelength_s0.lean#L11-L16> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J - k^2 D) = D_u D_v k^4 - (D_v f_u + D_u g_v) k^2 + (f_u g_v - f_v g_u)" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1073/pnas.1315416111>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.11646/zootaxa.2164.1.4>,
        <https://doi.org/10.1371/journal.pgen.1007538>,
        <https://doi.org/10.7554/eLife.05635> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3160.detScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3160.determinant_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-danio-aesculapii-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber k_c" ;
    dct:description "Selects the 21 µm detail wavelength for vertical bars on D. aesculapii | Variables: D_u=2.286454, D_v=64.020722 (R=28), distinct from the 1.009 mm organ-scale sibling" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/cfb8887378258c806d4412f6b1faac9a96299054/models/2026-delphi10000-danio-aesculapii-turing-wavelength-s0.py#L116-L152>,
        <https://github.com/fractastical/morpholib/blob/cfb8887378258c806d4412f6b1faac9a96299054/morphoeval/lean/loops/Loop_3160_danio_aesculapii_turing_wavelength_s0.lean#L18-L23> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c = 2.08e-05 m" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1073/pnas.1315416111>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.11646/zootaxa.2164.1.4>,
        <https://doi.org/10.1371/journal.pgen.1007538>,
        <https://doi.org/10.7554/eLife.05635> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3160.aesculapiiDiffusionTrace" ;
    pk:leanTheorem "MathOfBiology.Loop_3160.aesculapii_above_turing_threshold" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-danio-aesculapii-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Successor subcriticality at the same cellular scale" ;
    dct:description "What changes versus Danio albolineatus at 21 µm and 0 Ma — the inhibitor range collapses and the mode does not amplify | Variables: successor D_v = 1.20 D_u with D_u held at the aesculapii value; age 0 Ma for both" ;
    dct:source "Spiewak et al. 2018 DOI:10.1371/journal.pgen.1007538" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/cfb8887378258c806d4412f6b1faac9a96299054/models/2026-delphi10000-danio-aesculapii-turing-wavelength-s0.py#L307-L324>,
        <https://github.com/fractastical/morpholib/blob/cfb8887378258c806d4412f6b1faac9a96299054/morphoeval/lean/loops/Loop_3160_danio_aesculapii_turing_wavelength_s0.lean#L25-L30> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "R_albolineatus = 1.20 < R_c = -g_v/f_u = 1.6725, so D_v f_u + D_u g_v < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1073/pnas.1315416111>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.11646/zootaxa.2164.1.4>,
        <https://doi.org/10.1371/journal.pgen.1007538>,
        <https://doi.org/10.7554/eLife.05635> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3160.albolineatusDiffusionTrace" ;
    pk:leanTheorem "MathOfBiology.Loop_3160.albolineatus_below_turing_threshold" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


        <https://mapzebrain.org/>,
        <https://zebrahub.ds.czbiohub.org/>,
        <https://zfin.org/> ;
    pk:fossilLineageGroup "Danionin Pigment Evolution Series" ;
    pk:geologicalAgeMa 0e+00 ;

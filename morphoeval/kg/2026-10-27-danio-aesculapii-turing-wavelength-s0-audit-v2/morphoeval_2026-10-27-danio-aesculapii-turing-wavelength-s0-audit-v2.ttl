<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Danio aesculapii cellular Turing wavenumber at 21 µm (Holocene, 0 Ma) — Model fidelity to source: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script implements the Turing dispersion eigenvalue, the classical k_c formula, and Schnakenberg kinetics, and the Lean module checks the scaled trace, determinant, aesculapii threshold, successor sign change, and discriminant with zero sorry. Deduction: the rate constants are a reconstruction that pins λ_c to the assigned 20.8 µm scale, not a parameter table measured on D. aesculapii, and argmax σ sits at a longer wave than formula k_c (both are drawn)." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "models/2026-delphi10000-danio-aesculapii-turing-wavelength-s0.py L63–L78: λ_c = 2.08e-05 m and R=28 are assigned, not fitted to a published aesculapii table <https://github.com/fractastical/morpholib/blob/cfb8887378258c806d4412f6b1faac9a96299054/models/2026-delphi10000-danio-aesculapii-turing-wavelength-s0.py#L63-L78>" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Danio aesculapii cellular Turing wavenumber at 21 µm (Holocene, 0 Ma) — Morphometric validation: 88/100" ;

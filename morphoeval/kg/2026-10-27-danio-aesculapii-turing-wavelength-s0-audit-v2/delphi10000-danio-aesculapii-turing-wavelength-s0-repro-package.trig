sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Danio aesculapii cellular Turing wavenumber at 21 µm (Holocene, 0 Ma) — Reproducibility package: 92/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Seed 3160, spectral diffusion, and --self-test now passes the physics gates (Pearson r>0.98, both controls negative, sweep monotonic, SHA-256 pins, k_c above argmax σ) and opens the GIF to assert n_frames >= 10, min side >= 480, and cv_sim_similarity >= 58. Pass-1 R2 is closed. Still one assessor, and dependencies are the repo requirements file rather than a per-script lock." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-repro-package-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-danio-aesculapii-turing-wavelength-s0.py L743–L749" ;
        dct:description "self-test asserts the wavenumber offset and the GIF gates" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/cfb8887378258c806d4412f6b1faac9a96299054/models/2026-delphi10000-danio-aesculapii-turing-wavelength-s0.py#L743-L749> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-aesculapii-turing-wavelength-s0-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "datasets/danio_aesculapii_turing_wavelength_s0/README.md L18–L27" ;
        dct:description "documented invocation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/cfb8887378258c806d4412f6b1faac9a96299054/datasets/danio_aesculapii_turing_wavelength_s0/README.md#L18-L27> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


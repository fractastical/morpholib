    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Ammonia beccarii Turing wavelength at 31 µm, Holocene 0 Ma — Morphological realism / specimen match: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Same render as pass 1. The last GIF frame is the Hillewaert plate with the activator grown inside the six tests. CV similarity against the photograph is 92.2 at 12 frames and 720×540. The spot lattice is the model. Pores at 0.564 µm are not resolved on this plate, so the match is the shell geometry plus a wavelength-scale texture, not a pore-by-pore copy." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;

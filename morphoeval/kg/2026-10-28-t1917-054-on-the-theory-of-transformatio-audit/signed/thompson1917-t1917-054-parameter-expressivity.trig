sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-054> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-054-parameter-expressivity> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-054_on-the-theory-of-transformations.py L580–L613" ;
        dcterms:description "render_growth_gif sweeps t over 33 frames with the deforming grid" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8b77a9d17/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L580-L613> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-054-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Figs. 388-393: Archaeopteryx -> Apatornis pelvis by equidistant coordinate-grid interpolation — Parameter expressivity: 46/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "t visibly and monotonically moves the form from Archaeopteryx to Apatornis (GIF, 33 frames) and the pubis angle rises 131 -> 162 deg along the drawn series. --n-semi and --lam exist on the CLI but no sweep is run or reported, and the TPS-vs-affine family switch is exercised only at the default setting." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "thompson/claims/t1917-054_on-the-theory-of-transformations.py L762–L777: --n-semi / --lam exposed but not swept; single default run only <https://github.com/fractastical/morpholib/blob/8b77a9d17/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L762-L777>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-parameter-expressivity-1> ;
        pk:hasScore "0.46"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


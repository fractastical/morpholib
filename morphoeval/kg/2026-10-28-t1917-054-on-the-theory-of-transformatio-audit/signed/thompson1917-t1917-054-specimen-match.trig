        rdfs:label "thompson/claims/t1917-054_on-the-theory-of-transformations.py L498–L577" ;
        dcterms:description "render_comparison: predicted stage with interpolated grid vs Procrustes-aligned drawn stage" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8b77a9d17/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L498-L577> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-054-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Figs. 388-393: Archaeopteryx -> Apatornis pelvis by equidistant coordinate-grid interpolation — Morphological realism / specimen match: 66/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "The output is compared side by side with the source author's own figures: Figs. 388/389 crops, the segmented Fig. 393 with landmarks, and each predicted stage overlaid on Heilmann's drawn stage. The predicted outlines are visibly intermediate and distinct per stage. Deductions: the stage panels are cramped (grid padding dwarfs the form); the real Archaeopteryx fossil photograph is vendored but not analysed; Apatornis is represented by a synsacrum plate only." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "thompson/claims/t1917-054_on-the-theory-of-transformations.py L498–L577: no analysis of archaeopteryx_lithographica_berlin_specimen_mfn.jpg; panels small <https://github.com/fractastical/morpholib/blob/8b77a9d17/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L498-L577>" ;

sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-054> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-054-model-fidelity> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-054-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Figs. 388-393: Archaeopteryx -> Apatornis pelvis by equidistant coordinate-grid interpolation — Model fidelity to source: 74/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "E2/E6 (equidistant interpolation), E4 (TPS), E5 (affine interpolation M_t) and E7 (t*) are implemented exactly as stated in the reference JSON and mirrored by 11 Lean theorems (endpoints/equidistance, similarity equivariance, no-fold, t* soundness, affine determinants). Deduction: Thompson's actual Fig. 389 grid is not digitised; phi is reconstructed from silhouette correspondences, and the no-fold condition (E1, det > 0) is proved in Lean but not checked numerically on the fitted TPS." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-054_on-the-theory-of-transformations.py L409–L425: phi fitted on consensus-frame configurations, not on Thompson's drawn grid lines; no Jacobian check <https://github.com/fractastical/morpholib/blob/8b77a9d17/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L409-L425>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-model-fidelity-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-054_on-the-theory-of-transformations.py L307–L366" ;
        dcterms:description "tps_fit/tps_apply (E4), affine_fit/affine_interp_matrix (E5), interp_stage (E2/E6), best_fit_t (E7)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8b77a9d17/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L307-L366> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_054.lean L24–L180" ;
        dcterms:description "interp4, interpDet; 11 theorems compile under Lean 4.35.0 with 0 sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8b77a9d17/morphoeval/lean/loops/Thompson1917_T1917_054.lean#L24-L180> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-054> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-054-repro-package> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-054-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Figs. 388-393: Archaeopteryx -> Apatornis pelvis by equidistant coordinate-grid interpolation — Reproducibility package: 76/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Deterministic (no stochastic step; two-run equality asserted), seed constant declared, fail-closed input hashes, 10-check self-test in 1.4 s, full run 3.8 s, documented invocation, outputs to declared paths. Deductions: dependency versions pinned only via requirements.txt lower bounds; the comparison PNG is git-ignored by repo policy so a reviewer must re-render it." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-repro-package-2> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-054_on-the-theory-of-transformations.py L711–L759" ;
        dcterms:description "self_test: hashes, E2/E4/E5/E7 unit checks, segmentation areas, t* ordering, control comparison, determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8b77a9d17/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L711-L759> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-054_on-the-theory-of-transformations.py L762–L781" ;
        dcterms:description "CLI: --self-test, --n-semi, --lam, --no-gif" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8b77a9d17/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L762-L781> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-054> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-054-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-054-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Figs. 388-393: Archaeopteryx -> Apatornis pelvis by equidistant coordinate-grid interpolation — Morphometric validation: 56/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Quantitative morphometrics are computed on the output and compared with the source's claim: t* vs nominal stages, Procrustes distance of the prediction vs two controls (nearest endpoint, affine interpolation), descriptors (pubis/ischium angles, pre/post acetabular ratio, centroid size). Missing: correspondence-free statistics (IoU, boundary RMSE), Pearson r between predicted and drawn coordinates, any null distribution or permutation p-value, and uncertainty from the digitisation (semilandmark density)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-054_on-the-theory-of-transformations.py L427–L470: no IoU / RMSE / r / KS, no permutation null <https://github.com/fractastical/morpholib/blob/8b77a9d17/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L427-L470>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-archaeopteryx-apatornis-full-procrustes-distance-fig-393-endpoints>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-heilmann-s-first-intermediate-fig-391>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-the-second-intermediate-fig-392-top>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-the-third-intermediate-fig-392-bottom>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-centroid-size-of-the-five-drawn-forms>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-max-equidistance-residual-t-k-4-over-the-three-stages>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-mean-full-procrustes-distance-interpolated-grid-prediction-vs-drawn-intermediate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-pubis-angle-to-ilium-axis-along-the-series-a-1-2-3-b>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-morphometric-validation-2> ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-archaeopteryx-apatornis-full-procrustes-distance-fig-393-endpoints> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Archaeopteryx -> Apatornis full Procrustes distance (Fig. 393 endpoints) = 0.5827 Procrustes distance" ;
        schema:measurementTechnique "GPA of acetabulum + 4 x 24 semilandmarks, unit centroid size" ;
        schema:name "Archaeopteryx -> Apatornis full Procrustes distance (Fig. 393 endpoints)" ;
        schema:unitText "Procrustes distance" ;
        schema:value "0.5827" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-heilmann-s-first-intermediate-fig-391> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "best-fit stage t* of Heilmann's first intermediate (Fig. 391) = 0.2627 t (0 = Archaeopteryx, 1 = Apatornis)" ;
        schema:measurementTechnique "E7 least-squares projection of the GPA-aligned drawn stage onto the Archaeopteryx->Apatornis segment" ;
        schema:name "best-fit stage t* of Heilmann's first intermediate (Fig. 391)" ;
        schema:unitText "t (0 = Archaeopteryx, 1 = Apatornis)" ;
        schema:value "0.2627" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-heilmann-s-first-intermediate-fig-391-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-heilmann-s-first-intermediate-fig-391-reference> a schema:PropertyValue ;
        dct:source "Thompson 1917 p. 759: 'three intermediate and equidistant co-ordinate systems'" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-the-second-intermediate-fig-392-top> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "best-fit stage t* of the second intermediate (Fig. 392 top) = 0.5288 t" ;
        schema:measurementTechnique "E7 projection" ;
        schema:name "best-fit stage t* of the second intermediate (Fig. 392 top)" ;
        schema:unitText "t" ;
        schema:value "0.5288" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-the-second-intermediate-fig-392-top-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-the-second-intermediate-fig-392-top-reference> a schema:PropertyValue ;
        dct:source "Thompson 1917 p. 759" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-the-third-intermediate-fig-392-bottom> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "best-fit stage t* of the third intermediate (Fig. 392 bottom) = 0.8235 t" ;
        schema:measurementTechnique "E7 projection" ;
        schema:name "best-fit stage t* of the third intermediate (Fig. 392 bottom)" ;
        schema:unitText "t" ;
        schema:value "0.8235" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-the-third-intermediate-fig-392-bottom-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-best-fit-stage-t-of-the-third-intermediate-fig-392-bottom-reference> a schema:PropertyValue ;
        dct:source "Thompson 1917 p. 759" ;
        schema:value "0.75" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-centroid-size-of-the-five-drawn-forms> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "centroid size of the five drawn forms = [2190.4, 2171.0, 2157.9, 2308.8, 2324.5] px (page scan)" ;
        dct:description "not monotone: Heilmann's Fig. 393 series is not drawn to the interpolated grid's scale" ;
        schema:measurementTechnique "sqrt of summed squared deviations from centroid of the landmark configuration" ;
        schema:name "centroid size of the five drawn forms" ;
        schema:unitText "px (page scan)" ;
        schema:value "[2190.4, 2171.0, 2157.9, 2308.8, 2324.5]" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-max-equidistance-residual-t-k-4-over-the-three-stages> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "max equidistance residual |t* - k/4| over the three stages = 0.0735 t units" ;
        dct:description "mean residual 0.0384; d(A,B) = 0.5827 so one stage = 0.1457 Procrustes units" ;
        schema:measurementTechnique "max over k of |t*_k - k/4|" ;
        schema:name "max equidistance residual |t* - k/4| over the three stages" ;
        schema:unitText "t units" ;
        schema:value "0.0735" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-max-equidistance-residual-t-k-4-over-the-three-stages-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-max-equidistance-residual-t-k-4-over-the-three-stages-reference> a schema:PropertyValue ;
        dct:source "exact equidistance (Lean: interp_endpoints_and_equidistant)" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-mean-full-procrustes-distance-interpolated-grid-prediction-vs-drawn-intermediate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "mean full Procrustes distance, interpolated grid prediction vs drawn intermediate = 0.116 Procrustes distance" ;
        dct:description "affine-only interpolation control: 0.2181; ratio interpolated/endpoint = 0.519" ;
        schema:measurementTechnique "E2/E4: TPS phi_t applied to the Archaeopteryx configuration, full Procrustes fit onto the drawn stage, mean over stages 1-3" ;
        schema:name "mean full Procrustes distance, interpolated grid prediction vs drawn intermediate" ;
        schema:unitText "Procrustes distance" ;
        schema:value "0.116" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-mean-full-procrustes-distance-interpolated-grid-prediction-vs-drawn-intermediate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-mean-full-procrustes-distance-interpolated-grid-prediction-vs-drawn-intermediate-reference> a schema:PropertyValue ;
        dct:source "control: copy the nearest endpoint (same metric)" ;
        schema:value "0.2235" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-measurement-pubis-angle-to-ilium-axis-along-the-series-a-1-2-3-b> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pubis angle to ilium axis along the series (A, 1, 2, 3, B) = [131.3, 140.7, 143.2, 153.3, 162.2] deg" ;
        schema:measurementTechnique "angle between acetabulum->pubis tip and anterior->posterior ilium tip vectors, per segmented form" ;
        schema:name "pubis angle to ilium axis along the series (A, 1, 2, 3, B)" ;
        schema:unitText "deg" ;
        schema:value "[131.3, 140.7, 143.2, 153.3, 162.2]" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-054_on-the-theory-of-transformations.py L427–L470" ;
        dct:description "per-stage Procrustes distances vs endpoints and affine control; t* and equidistance residual; descriptors" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8b77a9d17/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L427-L470> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-054-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-054_on-the-theory-of-transformations.py L665–L708" ;
        dct:description "measure_morphoeval returns 8 measurements, 5 with reference values" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8b77a9d17/thompson/claims/t1917-054_on-the-theory-of-transformations.py#L665-L708> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1007/BF02291478>,
            <https://doi.org/10.1109/34.24792>,
            <https://doi.org/10.1111/jeb.13256>,
            <https://doi.org/10.1206/0003-0090(2004)286%3C0001:MPTASO%3E2.0.CO;2> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form (Ch. XVII, On the Theory of Transformations, or the Comparison of Related Forms, pp. 757-759, Figs. 388-393)" .
    <https://doi.org/10.1007/BF02291478> dct:date "1975"^^xsd:gYear ;
        dct:title "Generalized Procrustes analysis" .
    <https://doi.org/10.1109/34.24792> dct:date "1989"^^xsd:gYear ;
        dct:title "Principal warps: thin-plate splines and the decomposition of deformations" .
    <https://doi.org/10.1111/jeb.13256> dct:date "2018"^^xsd:gYear ;
        dct:title "Pelvis morphology suggests that early Mesozoic birds were too heavy to contact incubate their eggs" .
    <https://doi.org/10.1206/0003-0090(2004)286%3C0001:MPTASO%3E2.0.CO;2> dct:date "2004"^^xsd:gYear ;
        dct:title "Morphology, phylogenetic taxonomy, and systematics of Ichthyornis and Apatornis (Avialae: Ornithurae)" .
}


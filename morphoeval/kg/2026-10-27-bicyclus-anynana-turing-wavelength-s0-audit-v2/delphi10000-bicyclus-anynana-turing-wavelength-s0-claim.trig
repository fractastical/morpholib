sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Sekimura et al. (2015) Gierer–Meinhardt wing-cell focus at λ_c = 1.507 mm (pass 2 controls) faithfully reproduces Bicyclus anynana (Squinting Bush Brown) morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-bicyclus-anynana-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Bicyclus anynana (Squinting Bush Brown) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-bicyclus-anynana-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-bicyclus-anynana-turing-wavelength-s0.py; output: docs/media/bicyclus_anynana_turing_wavelength_s0_comparison.png; organism: Bicyclus anynana (Squinting Bush Brown); environment: n/a; claim_boundary: [reported_in_source: Eq. 3.1–3.2 and Table 1 of Sekimura et al. 2015. | Proximal activator level selects or suppresses the focus (Fig. 4). | Wider wing cells form more foci (S1 Appendix).; reconstructed_in_script: Finite-difference Eq. 3.1, analytical and numerical σ(k), k_p sweep, width doubling, equal-diffusion ablation. | λ_c fixed at 1.507 mm for this Holocene slot. | CV segmentation of the pinned specimen and a 12-frame growth GIF.; transfer_boundary: The 1.507 mm anchor is the slot scale. Sekimura et al. 2015 do not state that millimetre value. | Leaf and scale texture in the GIF are the photograph.; does_not_claim: That activator concentration equals pigment luminance (radial Pearson r = 0.26). | A second chronospecies. Width doubling is the scale contrast inside this single Holocene terminus. | A signed nanopublication.]; phenomenon_size: 9.6 cm (0.0963 m, log10=-1.016 m, tier=7_organism_cm); species_scale_ladder (1 runs from 9.6 cm to 9.6 cm): 9.6 cm:butterfly-eyespot-focus-rings" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1242/dev.169367>,
            <https://doi.org/10.1371/journal.pone.0141434> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-bicyclus-anynana-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-bicyclus-anynana-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1242/dev.169367>,
            <https://doi.org/10.1371/journal.pone.0141434> .
    <https://doi.org/10.1007/BF00289234> dct:title "A theory of biological pattern formation" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1242/dev.169367> dct:title "Activation of butterfly eyespots by Distal-less is consistent with a reaction-diffusion process" .
    <https://doi.org/10.1371/journal.pone.0141434> dct:title "A model for selection of eyespots on butterfly wings" .
}


<https://w3id.org/delphi/resource/math-law/delphi10000-bicyclus-anynana-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical Turing wavenumber" ;
    dct:description "Wavelength selection for the Bicyclus anynana ocellus at the 1.507 mm organ scale | Variables: k wavenumber; λ_c = 1.507 mm on the Holocene adult wing" ;
    dct:source "Sekimura, Venkataraman & Madzvamuse (2015) DOI:10.1371/journal.pone.0141434; Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/68f7b12177b4371c73d1b9066a4410ed7696f94a/models/2026-delphi10000-bicyclus-anynana-turing-wavelength-s0.py#L77-L96>,
        <https://github.com/fractastical/morpholib/blob/68f7b12177b4371c73d1b9066a4410ed7696f94a/morphoeval/lean/loops/Loop_3133_bicyclus_anynana_turing_wavelength_s0.lean#L11-L14> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def lambda_um : Nat := 1507
theorem lambda_positive : 0 < lambda_um := by decide
"""^^pk:lean4 ;
    skos:notation "k_c = argmax_k σ(k), σ(k) = max Re eig(J(a_ss) - k^2 diag(D1, D2)), λ_c = 2π/k_c = 1.507 mm" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/dev.169367>,
        <https://doi.org/10.1371/journal.pone.0141434> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3133.lambda_um" ;
    pk:leanTheorem "MathOfBiology.Loop_3133.lambda_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-bicyclus-anynana-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Positive diffusivity product" ;
    dct:description "Both diffusivities in the Gierer–Meinhardt pair are positive | Variables: D1 activator diffusivity, D2 inhibitor diffusivity" ;
    dct:source "Sekimura et al. (2015) Table 1 DOI:10.1371/journal.pone.0141434" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/68f7b12177b4371c73d1b9066a4410ed7696f94a/models/2026-delphi10000-bicyclus-anynana-turing-wavelength-s0.py#L48-L52>,
        <https://github.com/fractastical/morpholib/blob/68f7b12177b4371c73d1b9066a4410ed7696f94a/morphoeval/lean/loops/Loop_3133_bicyclus_anynana_turing_wavelength_s0.lean#L17-L22> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def diffusion_product (d1 d2 : Int) : Int := d1 * d2
theorem diffusion_product_positive (d1 d2 : Int) (h1 : 0 < d1) (h2 : 0 < d2) :
    0 < diffusion_product d1 d2 := by dsimp [diffusion_product]; exact Int.mul_pos h1 h2
"""^^pk:lean4 ;
    skos:notation "D1 D2 > 0 (Table 1: D1 = 3.1e-3, D2 = 3.0e-2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/dev.169367>,
        <https://doi.org/10.1371/journal.pone.0141434> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3133.diffusion_product" ;
    pk:leanTheorem "MathOfBiology.Loop_3133.diffusion_product_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-bicyclus-anynana-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Proximal source suppresses the focus" ;
    dct:description "Boundary control of whether a wing cell forms an eyespot focus | Variables: k_p proximal Dirichlet multiplier on a1_ss" ;
    dct:source "Sekimura et al. (2015) Eq. 3.1 and Fig. 4 DOI:10.1371/journal.pone.0141434" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/68f7b12177b4371c73d1b9066a4410ed7696f94a/models/2026-delphi10000-bicyclus-anynana-turing-wavelength-s0.py#L184-L214>,
        <https://github.com/fractastical/morpholib/blob/68f7b12177b4371c73d1b9066a4410ed7696f94a/morphoeval/lean/loops/Loop_3133_bicyclus_anynana_turing_wavelength_s0.lean#L25-L29> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def proximal_margin (kp_high kp_low : Int) : Int := kp_high - kp_low
theorem high_proximal_source_suppresses_focus : proximal_margin 2 0 > 0 := by decide
"""^^pk:lean4 ;
    skos:notation "k_p = 2 suppresses the focus; k_p = 0 selects it; 2 - 0 > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/dev.169367>,
        <https://doi.org/10.1371/journal.pone.0141434> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3133.proximal_margin" ;
    pk:leanTheorem "MathOfBiology.Loop_3133.high_proximal_source_suppresses_focus" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-bicyclus-anynana-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Width inserts a second focus" ;
    dct:description "The single Holocene chronospecies fixes λ_c; a wider cell at the same kinetics adds a focus | Variables: anterior–posterior cell width in units of λ_c" ;
    dct:source "Sekimura et al. (2015) S1 Appendix DOI:10.1371/journal.pone.0141434" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/68f7b12177b4371c73d1b9066a4410ed7696f94a/models/2026-delphi10000-bicyclus-anynana-turing-wavelength-s0.py#L153-L168>,
        <https://github.com/fractastical/morpholib/blob/68f7b12177b4371c73d1b9066a4410ed7696f94a/morphoeval/lean/loops/Loop_3133_bicyclus_anynana_turing_wavelength_s0.lean#L32-L43> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def focus_count (width_over_lambda : Nat) : Nat := width_over_lambda
theorem wider_cell_inserts_a_focus : focus_count 1 < focus_count 2 := by decide
"""^^pk:lean4 ;
    skos:notation "N(λ_c) = 1 < N(2 λ_c) = 2 on this Holocene cell; equal diffusion sends k_c to 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/dev.169367>,
        <https://doi.org/10.1371/journal.pone.0141434> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3133.focus_count" ;
    pk:leanTheorem "MathOfBiology.Loop_3133.wider_cell_inserts_a_focus" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;

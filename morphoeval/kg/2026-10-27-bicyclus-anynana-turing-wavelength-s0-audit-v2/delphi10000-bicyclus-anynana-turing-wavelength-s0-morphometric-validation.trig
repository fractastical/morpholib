sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Sekimura et al. (2015) Gierer–Meinhardt wing-cell focus at λ_c = 1.507 mm (pass 2 controls) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Wavelength test: Pearson r = 0.9985, RMSE = 0.0063, KS = 0.056 between analytical and numerical σ(k). Specimen: 8 segmented ocelli, Cu1 black radius 11 px versus gold radius 18 px, coherency 0.5207 versus 0.5234 on the last frame. The radial pigment correlation is 0.26 and is reported as a failed shape match, not folded into r." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-critical-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-dispersion-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-equal-diffusion-wavenumber>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-one-wavelength-focus-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-radial-profile-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-specimen-cu1-black-disc-radius>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-specimen-eyespot-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-specimen-image-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-critical-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical wavelength = 1.507 mm" ;
        schema:measurementTechnique "λ_c = 2π/k_c from the Gierer–Meinhardt dispersion peak, anchored to this slot's organ scale" ;
        schema:name "critical wavelength" ;
        schema:unitText "mm" ;
        schema:value "1.507" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-critical-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-critical-wavelength-reference> a schema:PropertyValue ;
        dct:source "A different eyespot reading uses a 0.48 mm focal decay length. This slot's wavelength is 1.507 mm." ;
        schema:value "0.48" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-dispersion-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion KS statistic = 0.0556 KS distance" ;
        schema:measurementTechnique "Two-sample KS distance between the analytical and numerical growth-rate samples" ;
        schema:name "dispersion KS statistic" ;
        schema:unitText "KS distance" ;
        schema:value "0.0556" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion pearson r = 0.9985 correlation" ;
        schema:measurementTechnique "Pearson r between analytical σ(k) and the growth rate measured on the nonlinear periodic PDE" ;
        schema:name "dispersion pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.9985" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Exact linear agreement would be 1. The numerical PDE is slightly below that." ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 0.0063 1/time" ;
        schema:measurementTechnique "RMSE of σ_numerical(k) against σ_analytical(k) on 18 wavenumbers" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.0063" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-equal-diffusion-wavenumber> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion wavenumber = 0.0 1/length" ;
        schema:measurementTechnique "argmax σ(k) after setting D2 = D1 (ablation of differential diffusion)" ;
        schema:name "equal-diffusion wavenumber" ;
        schema:unitText "1/length" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-equal-diffusion-wavenumber-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-equal-diffusion-wavenumber-reference> a schema:PropertyValue ;
        dct:source "k_c of the Table-1 diffusion ratio D2/D1 ≈ 9.68" ;
        schema:value "6.19" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-one-wavelength-focus-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "one-wavelength focus count = 1 count" ;
        schema:measurementTechnique "Interior activator peaks on a cell of width λ_c at k_p = 0" ;
        schema:name "one-wavelength focus count" ;
        schema:unitText "count" ;
        schema:value "1" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-one-wavelength-focus-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-one-wavelength-focus-count-reference> a schema:PropertyValue ;
        dct:source "Same kinetics on a cell of width 2 λ_c" ;
        schema:value "2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-radial-profile-ks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "radial profile KS = 0.275 KS distance" ;
        schema:measurementTechnique "KS distance between the Cu1 radial luminance and the focus activator resampled onto that radius" ;
        schema:name "radial profile KS" ;
        schema:unitText "KS distance" ;
        schema:value "0.275" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-radial-profile-ks-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-radial-profile-ks-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-specimen-cu1-black-disc-radius> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen Cu1 black-disc radius = 11.0 px" ;
        schema:measurementTechnique "Radial luminance minimum of the white-pupil forewing ocellus on the pinned photograph" ;
        schema:name "specimen Cu1 black-disc radius" ;
        schema:unitText "px" ;
        schema:value "11.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-specimen-cu1-black-disc-radius-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-specimen-cu1-black-disc-radius-reference> a schema:PropertyValue ;
        dct:source "Gold-ring luminance maximum of the same ocellus, in pixels" ;
        schema:value "18.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-specimen-eyespot-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen eyespot count = 8 count" ;
        schema:measurementTechnique "CV segmentation: white pupils and dark cores with a bright annulus on the brown wing" ;
        schema:name "specimen eyespot count" ;
        schema:unitText "count" ;
        schema:value "8" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-specimen-eyespot-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-specimen-eyespot-count-reference> a schema:PropertyValue ;
        dct:source "Focus count of the one-wavelength Gierer–Meinhardt cell at k_p = 0" ;
        schema:value "1" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-specimen-image-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image coherency = 0.5207 structure-tensor coherency" ;
        schema:measurementTechnique "Sobel structure tensor on the pinned specimen photograph (verify_image_fitness.compute_specimen_cv_signature)" ;
        schema:name "specimen image coherency" ;
        schema:unitText "structure-tensor coherency" ;
        schema:value "0.5207" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-specimen-image-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bicyclus-anynana-turing-wavelength-s0-measurement-specimen-image-coherency-reference> a schema:PropertyValue ;
        dct:source "Same operator on the last frame of the growth GIF" ;
        schema:value "0.5234" .

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bischof-xenopus-craniofacial-remap> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-open-loop-fixed-displacement-null-residual-procrustes-rms-error-at-nf-stage-65> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Open-loop fixed-displacement null residual Procrustes RMS error at NF stage 65 = 0.3439 Procrustes RMS distance" ;
        dcterms:description "Open-loop error = 0.3439 preserves initial perturbation defect" ;
        schema:measurementTechnique "Fixed wild-type translation vector applied to Picasso scrambled initial state" ;
        schema:name "Open-loop fixed-displacement null residual Procrustes RMS error at NF stage 65" ;
        schema:unitText "Procrustes RMS distance" ;
        schema:value "0.3439" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-open-loop-fixed-displacement-null-residual-procrustes-rms-error-at-nf-stage-65-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-open-loop-fixed-displacement-null-residual-procrustes-rms-error-at-nf-stage-65-reference> a schema:PropertyValue ;
        dcterms:source "Vandenberg, Adams & Levin (2012) Dev. Dyn. 241:863-878 Fig. 1A open-loop null hypothesis" ;
        schema:value "0.3408" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-picasso-tadpole-closed-loop-final-procrustes-rms-error-at-nf-stage-65> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Picasso tadpole closed-loop final Procrustes RMS error at NF stage 65 = 0.0017 Procrustes RMS distance" ;
        dcterms:description "Closed-loop final error = 0.0017 vs open-loop null control = 0.3439" ;
        schema:measurementTechnique "Uncoupled Euler integration of closed-loop Procrustes attractor ODE across NF 45->65" ;
        schema:name "Picasso tadpole closed-loop final Procrustes RMS error at NF stage 65" ;
        schema:unitText "Procrustes RMS distance" ;
        schema:value "0.0017" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-picasso-tadpole-closed-loop-final-procrustes-rms-error-at-nf-stage-65-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-picasso-tadpole-closed-loop-final-procrustes-rms-error-at-nf-stage-65-reference> a schema:PropertyValue ;
        dcterms:source "Vandenberg, Adams & Levin (2012) Dev. Dyn. 241:863-878 Figs. 2-5" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Vandenberg, Adams & Levin (2012) & Pinet et al. (2019) Picasso tadpole craniofacial attractor remodeling — Morphometric validation: 54/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Reports only 2 scalar Procrustes error metrics in `measure_morphoeval()`, lacking bilateral asymmetry restoration metrics, MMP blockade residual defect, specimen inter-eye / head-width morphometrics, and 6-regime Procrustes trajectory RMSE." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2019-bischof-xenopus-craniofacial-remap.py L167–L192: Baseline 2-metric measure_morphoeval() hook <https://github.com/fractastical/morpholib/blob/317bc3c/2019-bischof-xenopus-craniofacial-remap.py#L167-L192>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-open-loop-fixed-displacement-null-residual-procrustes-rms-error-at-nf-stage-65>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-picasso-tadpole-closed-loop-final-procrustes-rms-error-at-nf-stage-65> ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

<https://w3id.org/probknow/resource/claim/morphoeval-bischof-xenopus-craniofacial-remap> a pk:Claim ;
    rdfs:label "Vandenberg, Adams & Levin (2012) & Pinet et al. (2019) Picasso tadpole craniofacial attractor remodeling (Xenopus laevis African clawed frog tadpole and froglet)",
        "Vandenberg, Adams & Levin (2012) & Pinet et al. (2019) Picasso tadpole craniofacial attractor remodeling faithfully reproduces Xenopus laevis African clawed frog tadpole and froglet morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/bischof-xenopus-craniofacial-remap-1>,
        <https://w3id.org/probknow/resource/math-law/bischof-xenopus-craniofacial-remap-2>,
        <https://w3id.org/probknow/resource/math-law/bischof-xenopus-craniofacial-remap-3> ;
    dct:description "The simulation script(s) 2019-bischof-xenopus-craniofacial-remap.py implement the cited source model as published and produce forms that match real Xenopus laevis African clawed frog tadpole and froglet specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 56.8/100, audit 2026-10-19-xenopus-craniofacial-remap-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2019-bischof-xenopus-craniofacial-remap.py> ;
    schema:about "Xenopus laevis African clawed frog tadpole and froglet" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2019-bischof-xenopus-craniofacial-remap.py; output: docs/media/xenopus_craniofacial_remap_comparison.png; organism: Xenopus laevis African clawed frog tadpole and froglet; checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: b508063893dc2ba283709bbd6f8bccfb0c0050e2d4a352a6be0037d6b7fbad04; artifact_sha256: a86899230e609b51a50bac412582a64db9353a784f6424c59c7910e41b3a1ede; input_dataset_sha256: {datasets/xenopus_craniofacial_remap/paper_citations.bib=f5f4d62c485aca75..., datasets/xenopus_craniofacial_remap/scout_manifest.json=96534373d259eb28..., datasets/xenopus_craniofacial_remap/xenopus_craniofacial_remap_reference.json=2656eaab51beb4ca..., datasets/xenopus_craniofacial_remap/xenopus_craniofacial_specimen.jpg=8832f70a57f3d1c4...}" ;
    pk:derivedFromPaper <https://doi.org/10.1002/dvdy.23770>,
        <https://doi.org/10.1098/rsif.2016.0555>,
        <https://doi.org/10.1242/dev.073759>,
        <https://doi.org/10.1242/dev.175893> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-model-fidelity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-morphometric-validation>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-overall>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-parameter-expressivity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-xenopus-craniofacial-remap-audit-bischof-xenopus-craniofacial-remap-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-xenopus-craniofacial-remap-audit-bischof-xenopus-craniofacial-remap-2> ;
    pk:hypothesisType "Procrustes Landmark Attractor Dynamics & Target-Morphology Error Minimization" ;
    pk:weightOfEvidence 5.68e-01 .


<https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Vandenberg, Adams & Levin (2012) & Pinet et al. (2019) Picasso tadpole craniofacial attractor remodeling — Model fidelity to source: 60/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Implements single-landmark target homing -K_i*(x_i - x_i^*) and open-loop fixed vector translation (L50-98), but omits the inter-organ relational coupling matrix sum_j C_ij*((x_i - x_j) - (x_i^* - x_j^*)) and explicit Lyapunov energy dissipation verification dV/dt <= 0." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "2019-bischof-xenopus-craniofacial-remap.py L50–L98: Uncoupled Euler Procrustes landmark relaxation and open-loop vector null model <https://github.com/fractastical/morpholib/blob/317bc3c/2019-bischof-xenopus-craniofacial-remap.py#L50-L98>" ;
    pk:hasScore 6e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Vandenberg, Adams & Levin (2012) & Pinet et al. (2019) Picasso tadpole craniofacial attractor remodeling — Morphometric validation: 54/100" ;

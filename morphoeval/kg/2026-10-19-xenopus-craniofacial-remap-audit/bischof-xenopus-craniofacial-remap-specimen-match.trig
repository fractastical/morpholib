        rdfs:label "Vandenberg, Adams & Levin (2012) & Pinet et al. (2019) Picasso tadpole craniofacial attractor remodeling — Morphological realism / specimen match: 50/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors `datasets/xenopus_craniofacial_remap/xenopus_craniofacial_specimen.jpg` (CC BY 4.0 dorsal Xenopus laevis micrograph), but Pass 1 only displays the raw image without automated CV segmentation of the dorsal head contour, snout apex, or bilateral dorsolateral eye landmarks." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2019-bischof-xenopus-craniofacial-remap.py L135–L142: Raw specimen display without CV segmentation of bilateral eyes or head contour <https://github.com/fractastical/morpholib/blob/317bc3c/2019-bischof-xenopus-craniofacial-remap.py#L135-L142>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-specimen-match-1> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/xenopus_craniofacial_remap_comparison.png (generated output)" ;
        dct:description "4-panel Pass 1 baseline comparison figure — docs/media/xenopus_craniofacial_remap_comparison.png: rendered output of 2019-bischof-xenopus-craniofacial-remap.py at 317bc3c, image/png, 459463 B, 1320×1020 px, artifact_sha256 a86899230e609b51a50bac412582a64db9353a784f6424c59c7910e41b3a1ede (sha256 a86899230e609b51a50bac412582a64db9353a784f6424c59c7910e41b3a1ede), spec_fingerprint b508063893dc2ba283709bbd6f8bccfb0c0050e2d4a352a6be0037d6b7fbad04" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;

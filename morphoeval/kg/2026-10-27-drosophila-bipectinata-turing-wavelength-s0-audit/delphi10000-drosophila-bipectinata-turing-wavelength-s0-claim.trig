sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Drosophila bipectinata Turing wavelength at 1.92 µm (Holocene, 0 Ma) faithfully reproduces Drosophila bipectinata morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila bipectinata specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py; output: docs/media/drosophila_bipectinata_turing_wavelength_s0_growth.gif; organism: Drosophila bipectinata; environment: python 3.12.3, numpy 2.5.4, matplotlib 3.11.2, Pillow 13.0.0, scipy 1.18.1; claim_boundary: [reported_in_source: Turing 1952 selects a finite critical wavenumber from a two-species reaction-diffusion system. | Schnakenberg 1979 gives the kinetics a - u + u^2 v and b - u^2 v. | Kopp & True 2002 and Mishra & Singh 2006 describe D. bipectinata paired oblique sex combs. They do not report a 1.92 µm wavelength.; reconstructed_in_script: gamma is solved so the continuous focal wavelength is 1.92 µm at D_u = 0.0504 µm^2/s and delta = 31.5. | Predecessor and successor wavelengths follow from D_u factors 25/16 and 16/25 at geological age 0 Ma.; transfer_boundary: The gallery JPEG is a stand-in specimen, not a micrograph of the 1.92 µm field.; does_not_claim: That 1.92 µm was measured by Kopp, Mishra, or Hurtado-Gonzales. | That D. biarmipes and D. buzzatii are stratigraphic ancestors. | That the catalog DOI 10.1111/j.1525-142X.2005.05044.x is a Kopp paper. Crossref maps it to Kerr, Roalson & Rodgers 2005 on zebrafish myostatin.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/nature03235>,
            <https://doi.org/10.1046/j.1525-142x.2002.02017.x>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.14411/eje.2006.110> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-bipectinata-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-bipectinata-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-bipectinata-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-bipectinata-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg Jacobian at the homogeneous steady state" ;
    dct:description "Equal diffusion (D_v = D_u) makes D_v*f_u + D_u*g_v negative, so the 1.92 µm rung is not unstable without a diffusion ratio. | Variables: a=0.12, b=0.85, so f_u0 = 73/97 and g_v0 = -9409/10000" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0; Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py#L68-L143>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3178_drosophila_bipectinata_turing_wavelength_s0.lean#L40-L42> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u0 = a + b, v0 = b/(a+b)^2, f_u = gamma*(-1 + 2*u0*v0), g_v = -gamma*u0^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1046/j.1525-142x.2002.02017.x>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.14411/eje.2006.110> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3178.equal_diffusion_trace_is_negative" ;
    pk:leanTheorem "MathOfBiology.Loop_3178.equal_diffusion_trace_is_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-bipectinata-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber and focal wavelength" ;
    dct:description "Quantitative law for the Holocene 0 Ma detail rung of D. bipectinata. | Variables: D_u = 0.0504 µm^2/s, delta = 31.5, gamma solved so lambda_c = 1.92 µm; domain 15.36 µm holds 8 wavelengths" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py#L79-L102>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3178_drosophila_bipectinata_turing_wavelength_s0.lean#L33-L35> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v)/(2 D_u D_v), lambda_c = 2*pi/k_c = 1.92 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1046/j.1525-142x.2002.02017.x>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.14411/eje.2006.110> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3178.focal_domain_holds_eight_wavelengths" ;
    pk:leanTheorem "MathOfBiology.Loop_3178.focal_domain_holds_eight_wavelengths" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-bipectinata-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries diffusivity scaling at fixed age" ;
    dct:description "What changes versus the predecessor and successor at this scale is activator diffusivity, not geological age. | Variables: phi_biarmipes = 25/16, phi_buzzatii = 16/25, gamma and delta held at the focal values" ;
    dct:source "Kopp & True 2002 DOI:10.1046/j.1525-142x.2002.02017.x; Gompel et al. 2005 DOI:10.1038/nature03235" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py#L104-L134>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3178_drosophila_bipectinata_turing_wavelength_s0.lean#L18-L30> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(lambda/lambda_focal)^2 = D_u/D_u_focal; biarmipes 2.40 µm, bipectinata 1.92 µm, buzzatii 1.536 µm, all at 0 Ma" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1046/j.1525-142x.2002.02017.x>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.14411/eje.2006.110> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3178.chronoseries_wavelength_order" ;
    pk:leanTheorem "MathOfBiology.Loop_3178.biarmipes_diffusivity_lengthens_wavelength" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


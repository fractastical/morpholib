<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila bipectinata Turing wavelength at 1.92 µm (Holocene, 0 Ma) — Model fidelity to source: 80/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "steady_state and focal_transport implement Schnakenberg kinetics and the Turing formula for k_c, and gamma is solved so lambda_c is 1.92 µm. The 1.92 µm target is the assigned rung, not a published species parameter, so this is not a line-by-line reproduction of a bipectinata methods section." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

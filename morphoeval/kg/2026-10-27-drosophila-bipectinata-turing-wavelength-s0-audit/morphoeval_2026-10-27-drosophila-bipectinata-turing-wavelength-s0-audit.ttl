    pk:geologicalAgeMa 0e+00 ;
    pk:geologicalPeriod "Holocene (Extant)" ;
    pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-code-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-model-fidelity>,

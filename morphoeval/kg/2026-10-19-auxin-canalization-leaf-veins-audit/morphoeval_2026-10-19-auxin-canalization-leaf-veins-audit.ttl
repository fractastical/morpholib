<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/mitchison-canalization-auxin-flux-1>,
        <https://w3id.org/probknow/resource/math-law/mitchison-canalization-auxin-flux-2>,
        <https://w3id.org/probknow/resource/math-law/mitchison-canalization-auxin-flux-3> .

<https://w3id.org/probknow/resource/math-law/mitchison-canalization-auxin-flux-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Mitchison (1980) Linear vs Quadratic Flux-Canalization Symmetry Breaking Law" ;
    dct:description "Proves why linear feedback (p <= 1) damps conductivity perturbations back to a broad diffuse sheet whereas quadratic feedback (p = 2) triggers supercritical pitchfork winner-take-all symmetry breaking into 1-cell-wide vascular strands | Variables: D_ij: intercellular auxin diffusivity across cell wall (i,j); φ_ij = D_ij(S_i - S_j): auxin flux; p: feedback exponent (p<=1 diffuse sheet, p=2 single-cell strand); α: flux reinforcement gain; β: basal diffusivity synthesis; γ: carrier degradation rate" ;
    dct:source "Mitchison (1980) Proc. R. Soc. Lond. B 207(1166):79-109 Eqs. 2-6 & Fig. 1" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/1997-mitchison-canalization-auxin-flux.py#L95-L215>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_034_auxin_canalization_leaf_veins.lean#L29-L48> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def linear_canalization_rhs (alpha beta gamma dS D : Int) : Int :=
  alpha * (D * dS) + beta - gamma * D
def quadratic_canalization_rhs (alpha beta gamma dS D : Int) : Int :=
  alpha * (D * dS) * (D * dS) + beta - gamma * D
theorem mitchison_1980_quadratic_vs_linear_symmetry_breaking
    (alpha beta gamma dS D1 D2 : Int) :
    D2 * linear_canalization_rhs alpha beta gamma dS D1 -
      D1 * linear_canalization_rhs alpha beta gamma dS D2 = beta * (D2 - D1) ∧
    D2 * quadratic_canalization_rhs alpha beta gamma dS D1 -
      D1 * quadratic_canalization_rhs alpha beta gamma dS D2 =
      (D1 - D2) * (alpha * dS * dS * D1 * D2 - beta)
"""^^pk:lean4 ;
    skos:notation "dD_ij/dt = α |φ_ij|^p + β - γ D_ij;  D_2 dD_1/dt - D_1 dD_2/dt = β(D_2 - D_1) (p=1, diffuse)  vs  (D_1 - D_2)(α (ΔS)^2 D_1 D_2 - β) (p=2, winner-take-all canalization)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0065-2296(08)60351-1>,
        <https://doi.org/10.1016/j.jtbi.2005.03.017>,
        <https://doi.org/10.1098/rspb.1980.0082>,
        <https://doi.org/10.1098/rstb.1981.0081> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "With-the-Flux Auxin Canalization & PIN1 Carrier-Allocated Venation Topology" ;
    pk:leanDeclaration "MathOfBiology.Loop_034.quadratic_canalization_rhs" ;
    pk:leanTheorem "MathOfBiology.Loop_034.mitchison_1980_quadratic_vs_linear_symmetry_breaking" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/mitchison-canalization-auxin-flux-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Mitchison (1980) Canalized Vein Auxin Concentration Drainage Law (S_vein < S_parenchyma)" ;
    dct:description "Proves that quadratic flux-driven conductivity growth drops the auxin concentration inside a canalizing vein below that of surrounding parenchyma (S_vein < S_par), turning the differentiating vein into a lateral drainage sink that recruits tributaries and bypasses stem wounds (Sachs 1981) | Variables: S_vein, S_par: steady-state auxin concentration inside the canalized vascular strand vs surrounding parenchyma; φ_vein, φ_par: axial auxin flux in vein vs parenchyma" ;
    dct:source "Mitchison (1980) Proc. R. Soc. Lond. B 207:79-109 Fig. 2 & pp. 83-87; Sachs (1981) Adv. Bot. Res. 9:151-262" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/1997-mitchison-canalization-auxin-flux.py#L220-L355>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_034_auxin_canalization_leaf_veins.lean#L66-L78> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def steady_conductivity_scaled (alpha beta phi : Int) : Int :=
  alpha * phi * phi + beta
def drainage_conc_diff_scaled (alpha beta phi_vein phi_par : Int) : Int :=
  phi_par * steady_conductivity_scaled alpha beta phi_vein -
    phi_vein * steady_conductivity_scaled alpha beta phi_par
theorem mitchison_1980_vein_concentration_drainage (alpha beta phi_vein phi_par : Int) :
    drainage_conc_diff_scaled alpha beta phi_vein phi_par =
      (phi_vein - phi_par) * (alpha * phi_vein * phi_par - beta)
"""^^pk:lean4 ;
    skos:notation "D^*(φ) = (α φ^2 + β)/γ,  S(φ) = φ / D^*(φ)  ⇒  S_par - S_vein = (φ_vein - φ_par)(α φ_vein φ_par - β) / (γ D_vein D_par) > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0065-2296(08)60351-1>,
        <https://doi.org/10.1016/j.jtbi.2005.03.017>,
        <https://doi.org/10.1098/rspb.1980.0082>,
        <https://doi.org/10.1098/rstb.1981.0081> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "With-the-Flux Auxin Canalization & PIN1 Carrier-Allocated Venation Topology" ;
    pk:leanDeclaration "MathOfBiology.Loop_034.drainage_conc_diff_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_034.mitchison_1980_vein_concentration_drainage" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/mitchison-canalization-auxin-flux-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Mitchison (1981) & Feugier et al. (2005) Polar Carrier-Allocated Intercellular Flux Conservation Law" ;
    dct:description "Guarantees exact pairwise intercellular auxin conservation while enabling polar transport against concentration gradients and governing the Feugier et al. (2005) topological transition between open hierarchical venation trees (β_1 = 0) and closed-areole venation loops (β_1 > 0) | Variables: P_ij: directed PIN1 efflux carrier permeability on membrane face i→j; S_i: cytoplasmic auxin concentration in cell i; D_0: apoplastic passive diffusivity; β_1 = E - V + C: venation graph cycle rank (areole loop count)" ;
    dct:source "Mitchison (1981) Phil. Trans. R. Soc. B 295:461-471 Eqs. 1-5; Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:366-375 Eqs. 1-9 & Figs. 3-7" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/1997-mitchison-canalization-auxin-flux.py#L360-L495>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_034_auxin_canalization_leaf_veins.lean#L92-L103> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def polar_canalization_flux (P_ij P_ji D0 S_i S_j : Int) : Int :=
  P_ij * S_i - P_ji * S_j + D0 * (S_i - S_j)
theorem feugier_2005_polar_flux_conservation (P_ij P_ji D0 S_i S_j S : Int) :
    polar_canalization_flux P_ij P_ji D0 S_i S_j +
      polar_canalization_flux P_ji P_ij D0 S_j S_i = 0 ∧
    polar_canalization_flux P_ij P_ji D0 S S = (P_ij - P_ji) * S
"""^^pk:lean4 ;
    skos:notation "φ_{i→j} = P_ij S_i - P_ji S_j + D_0(S_i - S_j),  φ_{i→j} + φ_{j→i} = 0;  dP_ij/dt = F(φ_{i→j}, P_cell) - γ P_ij" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0065-2296(08)60351-1>,
        <https://doi.org/10.1016/j.jtbi.2005.03.017>,
        <https://doi.org/10.1098/rspb.1980.0082>,
        <https://doi.org/10.1098/rstb.1981.0081> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "With-the-Flux Auxin Canalization & PIN1 Carrier-Allocated Venation Topology" ;
    pk:leanDeclaration "MathOfBiology.Loop_034.polar_canalization_flux" ;
    pk:leanTheorem "MathOfBiology.Loop_034.feugier_2005_polar_flux_conservation" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


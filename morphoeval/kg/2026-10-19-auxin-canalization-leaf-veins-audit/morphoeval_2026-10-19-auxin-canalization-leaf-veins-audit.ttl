<https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Mitchison (1980, 1981) & Feugier, Mochizuki & Iwasa (2005) with-the-flux auxin canalization, Sachs wound bypass regeneration, and open vs closed leaf venation loops — Model fidelity to source: 56/100" ;
    dct:date "2026-10-19"^^xsd:date ;

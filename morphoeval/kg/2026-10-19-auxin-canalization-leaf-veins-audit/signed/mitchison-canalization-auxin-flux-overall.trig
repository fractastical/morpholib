sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mitchison-canalization-auxin-flux> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-overall> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Mitchison (1980, 1981) & Feugier, Mochizuki & Iwasa (2005) with-the-flux auxin canalization, Sachs wound bypass regeneration, and open vs closed leaf venation loops — MorphoEval overall 53.9/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Pass 1 (v1) baseline evaluation of `1997-mitchison-canalization-auxin-flux.py` (weighted score: 54.5/100). The Pass 1 script integrates only a minimal 2-channel ODE model at p=1 and p=2 without a 2D cellular leaf lamina graph, vein concentration drainage verification (S_vein < S_parenchyma), Sachs (1981) transverse stem incision bypass regeneration, Feugier et al. (2005) open-tree vs closed-areole venation loop topology, or segmentation of the cleared dicot leaf venation specimen. Overall 53.9/100 (faithfulness 51.4, reproducibility 59.7); rubric morphoeval 0.1.0; checkpoint commit 8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1. Dimension assessments: Model fidelity to source 56, Morphological realism / specimen match 46, Parameter expressivity 52, Morphometric validation 54, Source and data traceability 68, Code-to-model traceability 58, Reproducibility package 54. Output judged: docs/media/auxin_canalization_leaf_veins_comparison.png: rendered output of 1997-mitchison-canalization-auxin-flux.py at 8871db0, image/png, 58343 B, 1200×504 px, artifact_sha256 565e6e4b22ecd61b308b65e0a1f0a0a075b46efeafa91532a20aadad70ea48d5 (sha256 565e6e4b22ecd61b308b65e0a1f0a0a075b46efeafa91532a20aadad70ea48d5), spec_fingerprint b1e95723b4cbd5f2bb79b0150dbb4ab3fc046d7542c48fe2c7644bb6175993d9. Dual provenance: spec_fingerprint: b1e95723b4cbd5f2bb79b0150dbb4ab3fc046d7542c48fe2c7644bb6175993d9; artifact_sha256: 565e6e4b22ecd61b308b65e0a1f0a0a075b46efeafa91532a20aadad70ea48d5; input_dataset_sha256: {datasets/auxin_canalization_leaf_veins/auxin_canalization_leaf_veins_reference.json=55e0f743ada83918..., datasets/auxin_canalization_leaf_veins/leaf_venation_canalization_specimen.jpg=7f67774708f8e952..., datasets/auxin_canalization_leaf_veins/paper_citations.bib=95f1b35cf42a8ae7..., datasets/auxin_canalization_leaf_veins/scout_manifest.json=94a1d6a85fe649c5...}." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Implement Feugier, Mochizuki & Iwasa (2005) PIN1 carrier-allocation dynamics comparing open hierarchical branching trees (Betti-1 = 0) against closed-areole venation loops (Betti-1 > 0).",
            "remediation needed: Implement Sachs (1969, 1981) transverse stem incision wound-bypass simulation on a 2D cellular epicotyl grid, plus an NPA polar transport inhibitor negative control.",
            "remediation needed: Implement a 2D cellular leaf lamina canalization PDE/network solver sweeping feedback exponent p in [0.5, 2.5], demonstrating diffuse flow for p <= 1 and 1-cell-wide winner-take-all vascular strands with S_vein < S_parenchyma for p = 2.",
            "remediation needed: Segment and skeletonize the vendored cleared dicot leaf venation specimen (`leaf_venation_canalization_specimen.jpg`) to extract the midrib, secondary vein branching angles, and closed polygonal areole loops, with SHA-256 verification and `--self-test` suite." ;
        pk:hasScore "0.539"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 034 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


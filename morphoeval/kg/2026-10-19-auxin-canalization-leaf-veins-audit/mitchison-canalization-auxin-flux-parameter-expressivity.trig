sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mitchison-canalization-auxin-flux> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Mitchison (1980, 1981) & Feugier, Mochizuki & Iwasa (2005) with-the-flux auxin canalization, Sachs wound bypass regeneration, and open vs closed leaf venation loops — Parameter expressivity: 52/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates only p=1.0 and p=2.0 in a 2-channel toy system without sweeping the feedback exponent p across [0.5, 2.5], stem incision geometries, NPA polar transport inhibition, or open vs closed carrier-allocation regimes." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1997-mitchison-canalization-auxin-flux.py L51–L68: Only two parameter points evaluated without CLI overrides <https://github.com/fractastical/morpholib/blob/8871db0/1997-mitchison-canalization-auxin-flux.py#L51-L68>" ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 034 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


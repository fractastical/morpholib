sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-019> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. VII — tissue cells as hexagons / froth vs. human corneal endothelium (Pass 1 baseline) — Morphological realism / specimen match: 35/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "The vendored corneal endothelium (Thompson's own exemplar tissue, p. 321) and Fig. 125 are displayed but no overlay, segmentation or polygon colouring is produced for either; the model froth at delta = 0.35 (p6 = 0.34) is visibly more disordered than the corneal mosaic. Side-by-side resemblance is therefore judged by eye only and is weak." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L298–L320: render_comparison shows the raw specimen image; no segmentation call exists in v1 <https://github.com/fractastical/morpholib/blob/afd867b4c/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L298-L320>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-specimen-match-2> ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_019_the_forms_of_tissues_or_cell_a_comparison.png (generated output)" ;
        dct:description "panels (a) specimen, (b) Fig. 125 A/B crops, (c) model froth coloured by polygon class — docs/media/t1917_019_the_forms_of_tissues_or_cell_a_comparison.png: rendered output of thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py at afd867b4c, image/png, 834756 B, 1540×990 px, artifact_sha256 592edcce78d6504cb462bf9edd94d2eb6a56495fa38f8fd96aba1429cf8a7c99 (sha256 592edcce78d6504cb462bf9edd94d2eb6a56495fa38f8fd96aba1429cf8a7c99), spec_fingerprint 340ff36032325b8ea801c38e36dff91aa9d34352293527c48827c7e2bd5fb74c" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-019/human_corneal_endothelium_specimen.jpg (generated output)" ;
        dct:description "specimen byte-identical to Commons original (sha1 e0abd0d9...) — datasets/thompson_1917/t1917-019/human_corneal_endothelium_specimen.jpg: rendered output of thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py at afd867b4c, image/jpeg, 668732 B, 1290×1031 px, artifact_sha256 9daed5fb546e11bfdc60df0c8d9665515a93498b5f222befc8ad4bd9dfa6fb5a (sha256 9daed5fb546e11bfdc60df0c8d9665515a93498b5f222befc8ad4bd9dfa6fb5a), spec_fingerprint 340ff36032325b8ea801c38e36dff91aa9d34352293527c48827c7e2bd5fb74c" .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; cross-provider second assessor pending R7)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


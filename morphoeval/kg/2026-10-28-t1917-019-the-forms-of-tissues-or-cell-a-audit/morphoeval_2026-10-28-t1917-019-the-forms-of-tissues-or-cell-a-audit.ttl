<https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Thompson (1917) Ch. VII — tissue cells as hexagons / froth vs. human corneal endothelium (Pass 1 baseline) — Code-to-model traceability: 72/100" ;
    dct:date "2026-10-28"^^xsd:date ;
    dct:description "Module docstring maps C1-C3 to Thompson pages and E1-E6; each function docstring names its equation and Lean law; the math_kg YAML pins code_locus and lean_locus (integrity + formula-alignment gates pass). Thompson's own text is cited by page but Fig. 125 crop boxes are hard-coded without derivation." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
    pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
    pk:evidenceAgainst "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L66–L68: FIG125_A_BOX / FIG125_B_BOX hard-coded pixel boxes <https://github.com/fractastical/morpholib/blob/afd867b4c/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L66-L68>" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-code-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-code-traceability-2> ;
    pk:hasScore 7.2e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Thompson (1917) Ch. VII — tissue cells as hexagons / froth vs. human corneal endothelium (Pass 1 baseline) — Model fidelity to source: 62/100" ;
    dct:date "2026-10-28"^^xsd:date ;
    dct:description "The froth laws the claim rests on (E1 Euler mean six, E2 mu2, E3 Hales bound, E4 Lewis, E5 Aboav-Weaire) are implemented exactly on Voronoi polygons and asserted in --self-test; the division chain (E6) reproduces Gibson's spectrum to 0.03. But \"least perimeter\" is modelled only by Lloyd relaxation (a proxy), and the model is never confronted with tissue, so the claim itself is not yet tested." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L127–L138: lloyd_step is a centroidal-Voronoi proxy, not a surface-tension energy minimiser <https://github.com/fractastical/morpholib/blob/afd867b4c/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L127-L138>" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-3>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-4> ;
    pk:hasScore 6.2e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-morphometric-validation> a pk:LLMClaimAssessment ;

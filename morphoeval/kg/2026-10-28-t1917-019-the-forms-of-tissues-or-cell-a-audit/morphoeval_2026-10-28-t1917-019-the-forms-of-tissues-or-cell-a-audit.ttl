        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-019-the-forms-of-tissues-or-cell-a-audit-thompson1917-t1917-019-3>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-019-the-forms-of-tissues-or-cell-a-audit-thompson1917-t1917-019-4>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-019-the-forms-of-tissues-or-cell-a-audit-thompson1917-t1917-019-5>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-019-the-forms-of-tissues-or-cell-a-audit-thompson1917-t1917-019-6>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-019-the-forms-of-tissues-or-cell-a-audit-thompson1917-t1917-019-7>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-019-the-forms-of-tissues-or-cell-a-audit-thompson1917-t1917-019-8> ;
    pk:hypothesisType "Planar Froth Topology (Euler trivalent side sum, mu2, Lewis & Aboav-Weaire laws) & Isoperimetric Honeycomb Bound (Hales 2001) — geometric" ;
    pk:weightOfEvidence 5.44e-01 .


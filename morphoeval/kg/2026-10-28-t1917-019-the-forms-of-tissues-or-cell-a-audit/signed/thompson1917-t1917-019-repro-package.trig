    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. VII — tissue cells as hexagons / froth vs. human corneal endothelium (Pass 1 baseline) — Reproducibility package: 75/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Deterministic (seed 20261028, asserted), --self-test in 0.3 s, full run 3.0 s, dependencies in requirements.txt / requirements.lock.txt, documented invocation in the dataset README. The comparison PNG is gitignored by the repo's *.png rule and had to be force-added; no CLI for lattice size or Lloyd iterations." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-repro-package-2> ;
        pk:hasScore "0.75"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L454–L491" ;
        dcterms:description "self_test: determinism, exact laws, monotonicity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/afd867b4c/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L454-L491> .


sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-019> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-morphometric-validation> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-aboav-weaire-sum-rule-residual-1-f-sum-n-m-n-36-mu2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Aboav-Weaire sum-rule residual (1/F) sum n m(n) - (36 + mu2) = 0.0 sides^2" ;
        schema:measurementTechnique "Lean Law 5 aboav_weaire_sum_rule consistency check" ;
        schema:name "Aboav-Weaire sum-rule residual (1/F) sum n m(n) - (36 + mu2)" ;
        schema:unitText "sides^2" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-aboav-weaire-sum-rule-residual-1-f-sum-n-m-n-36-mu2-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-aboav-weaire-sum-rule-residual-1-f-sum-n-m-n-36-mu2-reference> a schema:PropertyValue ;
        dcterms:source "Weaire & Rivier 1984 Eq. 2.7" ;
        schema:value "0.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-division-topology-chain-fixed-point-p6-reconstruction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "division-topology chain fixed-point p6 (reconstruction) = 0.4336 fraction" ;
        schema:measurementTechnique "mean-field Gibson 2006 Markov chain, p_cut = 1/3" ;
        schema:name "division-topology chain fixed-point p6 (reconstruction)" ;
        schema:unitText "fraction" ;
        schema:value "0.4336" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-division-topology-chain-fixed-point-p6-reconstruction-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-division-topology-chain-fixed-point-p6-reconstruction-reference> a schema:PropertyValue ;
        dcterms:source "Gibson et al. 2006 Nature 442:1038" ;
        schema:value "0.464" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-aboav-weaire-a> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "froth model Aboav-Weaire a = 0.9447 dimensionless" ;
        schema:measurementTechnique "fit n m(n) = (6-a) n + (6a + mu2)" ;
        schema:name "froth model Aboav-Weaire a" ;
        schema:unitText "dimensionless" ;
        schema:value "0.9447" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-aboav-weaire-a-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-aboav-weaire-a-reference> a schema:PropertyValue ;
        dcterms:source "Aboav 1970 Metallography 3:383; Weaire & Rivier 1984" ;
        schema:value "1.2" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-excess-perimeter-over-honeycomb-bound> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "froth model excess perimeter over honeycomb bound = 8.9492 %" ;
        dcterms:description "honeycomb control = -0.00 %" ;
        schema:measurementTechnique "sum P_i / sum 2*12^(1/4) sqrt(A_i) - 1 (E3, Hales 2001)" ;
        schema:name "froth model excess perimeter over honeycomb bound" ;
        schema:unitText "%" ;
        schema:value "8.9492" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-excess-perimeter-over-honeycomb-bound-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-excess-perimeter-over-honeycomb-bound-reference> a schema:PropertyValue ;
        dcterms:source "Hales 2001 Discrete Comput. Geom. 25:1 (honeycomb is the least-perimeter equal-area partition)" ;
        schema:value "0.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-hexagon-fraction-p6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "froth model hexagon fraction p6 = 0.3425 fraction" ;
        schema:measurementTechnique "polygon_statistics on model froth" ;
        schema:name "froth model hexagon fraction p6" ;
        schema:unitText "fraction" ;
        schema:value "0.3425" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-hexagon-fraction-p6-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-hexagon-fraction-p6-reference> a schema:PropertyValue ;
        dcterms:source "Gibson et al. 2006 Nature 442:1038 Fig. 3 (Drosophila wing disc Markov fixed point)" ;
        schema:value "0.464" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-lewis-slope-lambda> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "froth model Lewis slope lambda = 0.1747 1/side" ;
        schema:measurementTechnique "linear fit of <A_n>/<A> vs n" ;
        schema:name "froth model Lewis slope lambda" ;
        schema:unitText "1/side" ;
        schema:value "0.1747" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-lewis-slope-lambda-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-lewis-slope-lambda-reference> a schema:PropertyValue ;
        dcterms:source "Lewis 1928 Anat. Rec. 38:341 (A_n proportional to n-2)" ;
        schema:value "0.25" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-mean-polygon-side-number-n-torus> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "froth model mean polygon side number <n> (torus) = 6.0 sides" ;
        schema:measurementTechnique "periodic Voronoi, delta=0.35, 400 cells; Lean Law 1 torus_mean_six" ;
        schema:name "froth model mean polygon side number <n> (torus)" ;
        schema:unitText "sides" ;
        schema:value "6.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-mean-polygon-side-number-n-torus-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-mean-polygon-side-number-n-torus-reference> a schema:PropertyValue ;
        dcterms:source "Thompson 1917 p. 325; Weaire & Rivier 1984 Contemp. Phys. 25:59 Eq. 2.1" ;
        schema:value "6.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-second-moment-mu2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "froth model second moment mu2 = 1.17 sides^2" ;
        dcterms:description "honeycomb control mu2 = 0.000; Poisson-Voronoi null ~ 1.78" ;
        schema:measurementTechnique "sum p_n (n-6)^2; honeycomb control = 0" ;
        schema:name "froth model second moment mu2" ;
        schema:unitText "sides^2" ;
        schema:value "1.17" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-second-moment-mu2-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-measurement-froth-model-second-moment-mu2-reference> a schema:PropertyValue ;
        dcterms:source "honeycomb (Thompson strict reading); Lean Law 2 honeycomb_iff_zero_second_moment" ;
        schema:value "0.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L415–L451" ;
        dcterms:description "measure_morphoeval: 8 measurements with reference values; all derived_from script/model" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/afd867b4c/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L415-L451> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. VII — tissue cells as hexagons / froth vs. human corneal endothelium (Pass 1 baseline) — Morphometric validation: 30/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Eight quantitative measurements are emitted, each with a literature reference (Gibson 2006 p6, Lewis slope 1/4, Aboav a = 1.2, Hales bound 0), but all are computed on the MODEL; no morphometric is measured on the specimen or on the 1917 plate, so the comparison is model-vs-literature, not output-vs-specimen." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;

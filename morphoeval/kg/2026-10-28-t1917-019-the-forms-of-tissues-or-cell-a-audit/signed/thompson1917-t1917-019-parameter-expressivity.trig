sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-019> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-parameter-expressivity> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L468–L479" ;
        dcterms:description "self_test: p6 non-increasing and excess perimeter non-decreasing over delta = 0, 0.15, 0.4, 1.0; Lloyd lowers excess perimeter" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/afd867b4c/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L468-L479> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_019_the_forms_of_tissues_or_cell_a_growth.gif (generated output)" ;
        dcterms:description "25-frame Lloyd relaxation of a delta = 0.6 froth — docs/media/t1917_019_the_forms_of_tissues_or_cell_a_growth.gif: rendered output of thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py at afd867b4c, image/gif, 1319286 B, 500×540 px, 25 frames, artifact_sha256 6eb20a2e07bf960957fbdf1359ad4671e0515427f1af8cf587895a87621d7cf9 (sha256 6eb20a2e07bf960957fbdf1359ad4671e0515427f1af8cf587895a87621d7cf9), spec_fingerprint 340ff36032325b8ea801c38e36dff91aa9d34352293527c48827c7e2bd5fb74c" .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; cross-provider second assessor pending R7)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. VII — tissue cells as hexagons / froth vs. human corneal endothelium (Pass 1 baseline) — Parameter expressivity: 55/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Disorder delta monotonically lowers p6 and raises mu2 / excess perimeter, and Lloyd relaxation reverses it — both asserted in --self-test and shown in the GIF — but only one delta is rendered in the figure, no sweep panel exists, and Lloyd iterations / lattice size are not exposed on the CLI." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L494–L499: CLI exposes --delta only <https://github.com/fractastical/morpholib/blob/afd867b4c/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L494-L499>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-parameter-expressivity-2> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-019> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-model-fidelity> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L98–L124" ;
        dcterms:description "periodic_voronoi: 3x3 tiled Voronoi, neighbour sets mod N, polygon areas and perimeters" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/afd867b4c/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L98-L124> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L159–L212" ;
        dcterms:description "polygon_statistics: <n>, mu2, p_n, excess perimeter vs 2*12^(1/4) sqrt(A), Lewis and Aboav-Weaire fits, sum rule" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/afd867b4c/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L159-L212> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L226–L276" ;
        dcterms:description "gibson_markov_fixed_point: Binomial(s,1/3) side gain + through-centre cleavage; uniform-random ablation present but unused in run()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/afd867b4c/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L226-L276> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_019.lean L37–L68" ;
        dcterms:description "Law 1 trivalent_side_sum / torus_mean_six / sphere_pentagon_excess proved (Lean 4.35.0, 0 errors)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/afd867b4c/morphoeval/lean/loops/Thompson1917_T1917_019.lean#L37-L68> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-019-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. VII — tissue cells as hexagons / froth vs. human corneal endothelium (Pass 1 baseline) — Model fidelity to source: 62/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "The froth laws the claim rests on (E1 Euler mean six, E2 mu2, E3 Hales bound, E4 Lewis, E5 Aboav-Weaire) are implemented exactly on Voronoi polygons and asserted in --self-test; the division chain (E6) reproduces Gibson's spectrum to 0.03. But \"least perimeter\" is modelled only by Lloyd relaxation (a proxy), and the model is never confronted with tissue, so the claim itself is not yet tested." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py L127–L138: lloyd_step is a centroidal-Voronoi proxy, not a surface-tension energy minimiser <https://github.com/fractastical/morpholib/blob/afd867b4c/thompson/claims/t1917-019_the-forms-of-tissues-or-cell-aggregates.py#L127-L138>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-019-model-fidelity-4> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; cross-provider second assessor pending R7)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .
}


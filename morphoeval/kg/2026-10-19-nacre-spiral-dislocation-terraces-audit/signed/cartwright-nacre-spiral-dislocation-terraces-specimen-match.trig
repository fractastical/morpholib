    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007) & Cartwright et al. (2009) nacre screw-dislocation spirals, Frank-Read target terraces, and defect pair annihilation — Morphological realism / specimen match: 24/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Renders a 2-panel synthetic spiral heightmap and velocity curve without loading, SHA-256-verifying, or segmenting the vendored SEM nacre fracture specimen (`datasets/nacre_spiral_dislocation_terraces/nacre_aragonite_tablets_specimen.jpg`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2007-cartwright-nacre-spiral-dislocation-terraces.py L76–L102: 2-panel synthetic plot with zero biological SEM specimen comparison <https://github.com/fractastical/morpholib/blob/HEAD/2007-cartwright-nacre-spiral-dislocation-terraces.py#L76-L102>",
            "docs/media/nacre_spiral_dislocation_terraces_comparison.png (generated output, not in repo): Pass 1 2-panel synthetic plot lacking SEM nacre aragonite tablet segmentation — docs/media/nacre_spiral_dislocation_terraces_comparison.png: rendered output of 2007-cartwright-nacre-spiral-dislocation-terraces.py at HEAD, image/png, 63778 B, 1218×587 px, artifact_sha256 0169fac579d7769b451d157d047d49d951ee1b5f28d07bcb4b56f21d71662844 (sha256 0169fac579d7769b451d157d047d49d951ee1b5f28d07bcb4b56f21d71662844), spec_fingerprint 4c231c8398be9a26483bc4175fe15077a90c9e9b18a12deaf2c2e4265b43d447" ;
        pk:hasScore "0.24"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dcterms:identifier "gemini-4-argon" ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-spiral-dislocation-terraces> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bcf-archimedean-spiral-terrace-pitch-lambda-0-pteria-hirundo> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "BCF Archimedean spiral terrace pitch lambda_0 (Pteria hirundo) = 7.9736 um" ;
        schema:measurementTechnique "Analytical BCF spiral pitch 2*pi*v_inf / omega at r_c=0.42 um" ;
        schema:name "BCF Archimedean spiral terrace pitch lambda_0 (Pteria hirundo)" ;
        schema:unitText "um" ;
        schema:value "7.9736" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bcf-archimedean-spiral-terrace-pitch-lambda-0-pteria-hirundo-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bcf-archimedean-spiral-terrace-pitch-lambda-0-pteria-hirundo-reference> a schema:PropertyValue ;
        dcterms:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 & BCF (1951) lambda_0 = 18.9848 * r_c" ;
        schema:value "7.9736" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bcf-spiral-angular-rotation-frequency-omega> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "BCF spiral angular rotation frequency omega = 0.985 rad/hr" ;
        schema:measurementTechnique "BCF eigenvalue omega = 0.330958 * v_inf / r_c" ;
        schema:name "BCF spiral angular rotation frequency omega" ;
        schema:unitText "rad/hr" ;
        schema:value "0.985" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bcf-spiral-angular-rotation-frequency-omega-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bcf-spiral-angular-rotation-frequency-omega-reference> a schema:PropertyValue ;
        dcterms:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504" ;
        schema:value "0.985" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-vertical-nacre-lamellar-accretion-rate-v-z> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Vertical nacre lamellar accretion rate V_z = 0.0784 um/hr" ;
        schema:measurementTechnique "V_z = h_0 * omega / (2*pi) with h_0 = 0.50 um" ;
        schema:name "Vertical nacre lamellar accretion rate V_z" ;
        schema:unitText "um/hr" ;
        schema:value "0.0784" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-vertical-nacre-lamellar-accretion-rate-v-z-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-vertical-nacre-lamellar-accretion-rate-v-z-reference> a schema:PropertyValue ;
        dcterms:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 Sec. 3" ;
        schema:value "0.0784" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007) & Cartwright et al. (2009) nacre screw-dislocation spirals, Frank-Read target terraces, and defect pair annihilation — Morphometric validation: 50/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Reports only 3 analytical single-spiral scalars (L123-155) without validating the universal BCF pitch law lambda_0 ≈ 18.9848*r_c across the 12 empirical bivalve, gastropod, and cephalopod nacre species, without verifying topological Burgers winding charges, and without extracting SEM inter-lamellar mortar spacing h_0." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2007-cartwright-nacre-spiral-dislocation-terraces.py L123–L155: Only 3 analytical scalars without 12-species scaling or SEM specimen morphometrics <https://github.com/fractastical/morpholib/blob/HEAD/2007-cartwright-nacre-spiral-dislocation-terraces.py#L123-L155>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bcf-archimedean-spiral-terrace-pitch-lambda-0-pteria-hirundo>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bcf-spiral-angular-rotation-frequency-omega>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-vertical-nacre-lamellar-accretion-rate-v-z> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .


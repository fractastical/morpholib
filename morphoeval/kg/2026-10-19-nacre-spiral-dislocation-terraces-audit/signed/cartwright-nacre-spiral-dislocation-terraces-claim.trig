sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-spiral-dislocation-terraces> a pk:Claim ;
        rdfs:label "Cartwright & Checa (2007) & Cartwright et al. (2009) nacre screw-dislocation spirals, Frank-Read target terraces, and defect pair annihilation faithfully reproduces Pteria hirundo & Pinctada margaritifera (Bivalvia sheet nacre) / Haliotis rufescens & Gibbula umbilicalis (Gastropoda tower nacre) morphology" ;
        dcterms:description "The simulation script(s) 2007-cartwright-nacre-spiral-dislocation-terraces.py implement the cited source model as published and produce forms that match real Pteria hirundo & Pinctada margaritifera (Bivalvia sheet nacre) / Haliotis rufescens & Gibbula umbilicalis (Gastropoda tower nacre) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 48.9/100, audit 2026-10-19-nacre-spiral-dislocation-terraces-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/HEAD/2007-cartwright-nacre-spiral-dislocation-terraces.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/HEAD/2007-cartwright-nacre-spiral-dislocation-terraces.py; output: docs/media/nacre_spiral_dislocation_terraces_comparison.png; organism: Pteria hirundo & Pinctada margaritifera (Bivalvia sheet nacre) / Haliotis rufescens & Gibbula umbilicalis (Gastropoda tower nacre); checkpoint commit: https://github.com/fractastical/morpholib/commit/HEAD; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 4c231c8398be9a26483bc4175fe15077a90c9e9b18a12deaf2c2e4265b43d447; artifact_sha256: 0169fac579d7769b451d157d047d49d951ee1b5f28d07bcb4b56f21d71662844; input_dataset_sha256: {datasets/nacre_spiral_dislocation_terraces/nacre_aragonite_tablets_specimen.jpg=e4c6590464523f21..., datasets/nacre_spiral_dislocation_terraces/nacre_spiral_dislocation_terraces_reference.json=580b05d6121d9596..., datasets/nacre_spiral_dislocation_terraces/scout_manifest.json=6084a2ce133990fc...}" ;
        pk:derivedFromPaper <https://doi.org/10.1073/pnas.0900867106>,
            <https://doi.org/10.1098/rsif.2006.0188>,
            <https://doi.org/10.1098/rsta.1951.0006>,
            <https://doi.org/10.1098/rsta.2011.0600> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match> ;
        pk:weightOfEvidence "0.489"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/HEAD/2007-cartwright-nacre-spiral-dislocation-terraces.py> a schema:SoftwareSourceCode ;

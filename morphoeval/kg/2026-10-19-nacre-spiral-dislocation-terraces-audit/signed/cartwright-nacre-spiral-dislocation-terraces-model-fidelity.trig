sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-spiral-dislocation-terraces> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007) & Cartwright et al. (2009) nacre screw-dislocation spirals, Frank-Read target terraces, and defect pair annihilation — Model fidelity to source: 56/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates a static analytical Cabrera-Levine spiral phase for one isolated screw dislocation (L31-73), but lacks a 2D PDE / eikonal step-flow solver for multi-defect interactions, omits opposite-chirality (+b, -b) Frank-Read closed target terraces and subcritical dipole pinch-off annihilation (d <= 2*r_c), omits same-chirality (+b, +b) double spirals, and omits 3D gastropod columnar tower vs bivalve terraced sheet nacre reconstruction." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2007-cartwright-nacre-spiral-dislocation-terraces.py L31–L73: Single analytical spiral phase without Frank-Read target dipole, subcritical annihilation control, or 3D tower/sheet nacre solver <https://github.com/fractastical/morpholib/blob/HEAD/2007-cartwright-nacre-spiral-dislocation-terraces.py#L31-L73>" ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


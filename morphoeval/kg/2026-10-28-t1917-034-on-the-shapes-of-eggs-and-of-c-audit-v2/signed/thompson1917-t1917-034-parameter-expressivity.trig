sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-034> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-parameter-expressivity> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XV: eggs as solids of revolution of a definite, species-varying family of ovoid meridian curves (Preston 1953 family on Biggins et al. 2018 / Deeming 2018 data) — Parameter expressivity: 88/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Spans 1389 eggs of 30 species, the 10-egg range set, 181 Deeming species and 12 photographed eggs; sweeps the pole pressure contrast from the sphere to the 99th percentile (L248-277); exposes --pole-contrast, --equator-contrast, --x-star, --r-blunt, --frames, --skip-gif, --verify-only and --seed (L999-1030). Thompson's 'cylindrical' (megapode) class is represented only through the c2 sign, not by a dedicated specimen." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-parameter-expressivity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py L248–L277" ;
        dcterms:description "Sphere -> symmetric ellipsoid -> conical pressure path with closure consistency check per frame" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2514d4650/thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py#L248-L277> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py L999–L1030" ;
        dcterms:description "CLI parameter overrides wired into the Thompson closure and rendering" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2514d4650/thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py#L999-L1030> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 228 Pass 2 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


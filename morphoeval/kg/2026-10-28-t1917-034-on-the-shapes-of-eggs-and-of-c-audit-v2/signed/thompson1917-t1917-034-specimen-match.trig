sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-034> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-specimen-match> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py L392–L511" ;
        dcterms:description "Principal-axis profile extraction, adaptive threshold + scale-bar removal + convex hull + watershed segmentation, per-egg Preston fit, axisymmetry and RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2514d4650/thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py#L392-L511> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_034_on_the_shapes_of_eggs_and_of_c_comparison.png (generated output)" ;
        dcterms:description "Top row: four museum photographs with segmentation boxes and per-egg E / PA / axisymmetry; C126 silhouette outline vs published Preston fit vs Cartesian oval / ellipsoid — docs/media/t1917_034_on_the_shapes_of_eggs_and_of_c_comparison.png: rendered output of thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py at 2514d4650, image/png, 974275 B, 1694×1346 px, artifact_sha256 d8c69f3b02b18347a9c1857f851870aae7a50461ddd8c46d17f544b9ffe5afc4 (sha256 d8c69f3b02b18347a9c1857f851870aae7a50461ddd8c46d17f544b9ffe5afc4), spec_fingerprint 16220681983e59a7518d8fd164735cf554e4313c23baed4858dbc080073234a4" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-034/result.json L1–L60" ;
        dcterms:description "Per-specimen table and C126 photo-vs-published coefficients" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2514d4650/datasets/thompson_1917/t1917-034/result.json#L1-L60> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XV: eggs as solids of revolution of a definite, species-varying family of ovoid meridian curves (Preston 1953 family on Biggins et al. 2018 / Deeming 2018 data) — Morphological realism / specimen match: 88/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Segments all five vendored photographs (`_egg_candidates`, `segment_specimens`, L392-511) into 12 eggs spanning Thompson's four named classes, tests the solid-of- revolution property (C126 upper-vs-lower profile RMS 0.4 % of half-breadth; museum median 4.2 %, max 11.9 % on a shadowed lapwing egg), reproduces the published C126 coefficients from the raw silhouette (profile r = 0.99999) and recovers the ordering owl (E 1.27) < grebe (1.36-1.48) < guillemot (1.61 vs species mean 1.64). Polar asymmetry from hull fits of speckled eggs is inflated (3-8), so specimen PA is reported but not used for the verdict." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py L483–L504: Speckled museum eggs give inflated polar asymmetry; museum axisymmetry includes shadow / tilt artefacts <https://github.com/fractastical/morpholib/blob/2514d4650/thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py#L483-L504>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-specimen-match-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 228 Pass 2 Assessor)" ;

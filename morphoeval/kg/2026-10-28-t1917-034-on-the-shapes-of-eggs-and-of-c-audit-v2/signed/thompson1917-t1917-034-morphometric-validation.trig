sub1:provenance {
    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1002/ece3.4412>,
            <https://doi.org/10.1038/078111a0>,
            <https://doi.org/10.1111/jav.01528>,
            <https://doi.org/10.1126/science.aaj1945>,
            <https://doi.org/10.2307/4081145>,
            <https://doi.org/10.5061/dryad.8kv2b20>,
            <https://doi.org/10.5061/dryad.q8rp3> .

    <https://archive.org/details/ongrowthform1917thom> dcterms:date "1917"^^xsd:gYear ;
        dcterms:title "On Growth and Form (Ch. XV, On the Shapes of Eggs, and of Certain Other Hollow Structures, pp. 652-669)" .

    <https://doi.org/10.1002/ece3.4412> dcterms:date "2018"^^xsd:gYear ;
        dcterms:title "Accurately quantifying the shape of birds' eggs" .

    <https://doi.org/10.1038/078111a0> dcterms:date "1908"^^xsd:gYear ;
        dcterms:title "On the Shapes of Eggs, and the Causes which determine them" .

    <https://doi.org/10.1111/jav.01528> dcterms:date "2018"^^xsd:gYear ;
        dcterms:title "Effect of composition on shape of bird eggs" .

    <https://doi.org/10.1126/science.aaj1945> dcterms:date "2017"^^xsd:gYear ;
        dcterms:title "Avian egg shape: Form, function, and evolution" .

    <https://doi.org/10.2307/4081145> dcterms:date "1953"^^xsd:gYear ;
        dcterms:title "The shapes of birds' eggs" .

    <https://doi.org/10.5061/dryad.8kv2b20> dcterms:date "2019"^^xsd:gYear ;
        dcterms:title "Data from: Accurately quantifying the shape of birds' eggs" .

    <https://doi.org/10.5061/dryad.q8rp3> dcterms:date "2017"^^xsd:gYear ;
        dcterms:title "Data from: Effect of composition on shape of bird eggs" .
}

sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-034> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-morphometric-validation> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XV: eggs as solids of revolution of a definite, species-varying family of ovoid meridian curves (Preston 1953 family on Biggins et al. 2018 / Deeming 2018 data) — Morphometric validation: 92/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L816-871) returns 17 reference-anchored measurements: min elongation 1.035 (ref 1), axisymmetry 0.048 mean (ref 0), C126 photo E 1.8616 vs 1.8607 and PA 2.67 vs 2.63, profile r = 0.99999, Preston RMSE/B 0.0023 on C126 vs 0.0018 median, Cartesian oval 0.0172 (7.4x) and ellipsoid 0.0731 (31x) negative controls, Baker ratio 35x, eta^2 0.67 (p = 2e-100), order eta^2 0.38 / 0.57, KS D = 0.96 (p = 1e-135), class ordering, Spearman rho 0.39 (p = 7e-8), closure residual 5.6e-16, pressure-path r = 0.54 and CV of the pressure profile 0.32." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-axisymmetry-residual-rms-upper-lower-profile-half-breadth-mean-over-segmented-eggs>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-baker-2002-2-parameter-alternative-median-mse-ratio-vs-preston-132-eggs>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-between-species-eta-2-of-elongation-30-species>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-c126-elongation-from-photograph-segmentation-vs-published>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-c126-meridian-profile-pearson-r-segmented-fit-vs-published-fit>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-c126-polar-asymmetry-from-photograph-vs-published>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-ks-statistic-uria-aalge-vs-penguin-elongation-distributions>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-mean-cv-of-the-p-p-n-t-profile-over-biggins-eggs-pressure-non-uniformity-sphere-0>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-minimum-elongation-l-b-over-all-eggs-incl-segmented-specimens-prolate-never-oblate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-order-level-eta-2-of-deeming-outline-pc1-elongation-axis-181-species>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-preston-family-rmse-breadth-on-c126-outline>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-prolate-ellipsoid-ablation-rmse-breadth-on-c126-c1-c2-c3-0-null>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-spearman-rho-deeming-pc2-asymmetry-vs-log-relative-egg-mass>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-specimen-ordering-owl-grebe-guillemot-elongation-thompson-p-652-classes>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-steiner-cartesian-oval-rmse-breadth-on-c126-negative-control-thompson-p-654-footnote>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-thompson-closure-residual-recovering-c126-from-its-pressure-descriptors>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-thompson-pressure-path-vs-30-species-means-pearson-r-of-elongation-at-matched-polar-asymmetry>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-morphometric-validation-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-axisymmetry-residual-rms-upper-lower-profile-half-breadth-mean-over-segmented-eggs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "axisymmetry residual RMS(upper - lower profile) / half-breadth, mean over segmented eggs = 0.0480223368747168 ratio" ;
        schema:measurementTechnique "CV segmentation of 12 eggs in 5 photographs; std = 0.0285, max = 0.1186; solid-of-revolution test" ;
        schema:name "axisymmetry residual RMS(upper - lower profile) / half-breadth, mean over segmented eggs" ;
        schema:unitText "ratio" ;
        schema:value "0.0480223368747168" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-axisymmetry-residual-rms-upper-lower-profile-half-breadth-mean-over-segmented-eggs-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-axisymmetry-residual-rms-upper-lower-profile-half-breadth-mean-over-segmented-eggs-reference> a schema:PropertyValue ;
        dcterms:source "Thompson 1917 p. 652 'simple solids of revolution'" ;
        schema:value "0.0" .


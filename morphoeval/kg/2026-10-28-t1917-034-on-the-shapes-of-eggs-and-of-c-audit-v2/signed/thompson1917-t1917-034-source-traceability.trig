sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-034> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-source-traceability> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XV: eggs as solids of revolution of a definite, species-varying family of ovoid meridian curves (Preston 1953 family on Biggins et al. 2018 / Deeming 2018 data) — Source and data traceability: 93/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "`verify_dataset_integrity()` (L83-105) re-hashes the 13 pinned data files from the reference JSON at import of the analysis (and via --verify-only / self-test); Dryad DOIs, file ids, upstream SHA-256 digests, Commons authors and licences are in scout_manifest.json / reference JSON / README, and result.json repeats the dataset pins. The README hash is pinned but excluded from the runtime check as prose." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-source-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-source-traceability-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py L83–L105" ;
        dcterms:description "Runtime SHA-256 verification against datasets.files pins (13 files)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2514d4650/thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py#L83-L105> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-034/t1917_034_on_the_shapes_of_eggs_and_of_c_reference.json L1–L440" ;
        dcterms:description "Equations, parameter tables, claim decomposition C1-C8, vendored and upstream SHA-256 pins, licences" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2514d4650/datasets/thompson_1917/t1917-034/t1917_034_on_the_shapes_of_eggs_and_of_c_reference.json#L1-L440> .


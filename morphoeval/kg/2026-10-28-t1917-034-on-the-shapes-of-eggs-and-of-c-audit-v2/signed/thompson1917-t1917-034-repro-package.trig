sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-034> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-repro-package> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XV: eggs as solids of revolution of a definite, species-varying family of ovoid meridian curves (Preston 1953 family on Biggins et al. 2018 / Deeming 2018 data) — Reproducibility package: 90/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "20-assert `self_test()` (L956-996) covers dataset integrity, sphere / volume / reflection identities, Thompson closure of the sphere and C126, mean curvature of the sphere, cone- balance sign, specimen reproduction of C126, axisymmetry, the Cartesian-oval control and two-run bitwise determinism; --verify-only and --skip-gif flags; deterministic (no RNG); result.json written each run. Runtime is ~40 s because segmentation is recomputed per process." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-repro-package-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py L956–L996" ;
        dcterms:description "Comprehensive self_test() with integrity, closure, CV and determinism assertions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2514d4650/thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py#L956-L996> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py L874–L954" ;
        dcterms:description "result.json writer with verdict by component, headline numbers and notes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2514d4650/thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py#L874-L954> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 228 Pass 2 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-034> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-model-fidelity> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XV: eggs as solids of revolution of a definite, species-varying family of ovoid meridian curves (Preston 1953 family on Biggins et al. 2018 / Deeming 2018 data) — Model fidelity to source: 91/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Implements the Preston family, indices and exact volume (L110-184) matching Lean Laws 1-2, and now exercises Thompson's own mechanics: the envelope equation inverted as 2H(x) = (P - p_n)/T with exact pole limits (L186-210), the four-constraint Thompson closure that recovers C126 and the sphere (L212-246), the empirical pressure-asymmetry path (L248-277) and the cone-balance ratio (L279-286), all cross-referenced to the 5 Lean theorems. The closure is kinematic (curvature <-> pressure) rather than a dynamic oviduct model with friction, which Thompson himself invokes." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py L248–L277: Pressure path is a conditional-mean regression through the data, not a solved membrane dynamics problem <https://github.com/fractastical/morpholib/blob/2514d4650/thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py#L248-L277>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-model-fidelity-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py L110–L184" ;
        dcterms:description "Preston polynomial, analytic widest point, closed-form pole radius and volume, Biggins weighted LS estimator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2514d4650/thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py#L110-L184> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py L186–L286" ;
        dcterms:description "Analytic derivatives, mean-curvature (excess pressure) profile, Thompson closure, pressure path, cone-balance ratio" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2514d4650/thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py#L186-L286> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_034.lean L40–L191" ;
        dcterms:description "5 machine-checked theorems (pole asymmetry, volume + reflection invariance, envelope equation at poles, cone equilibrium, prolate-never-oblate), no admitted goals" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2514d4650/morphoeval/lean/loops/Thompson1917_T1917_034.lean#L40-L191> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 228 Pass 2 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


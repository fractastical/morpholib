<https://w3id.org/delphi/resource/math-law/delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homogeneous Schnakenberg steady state is linearly stable at k = 0" ;
    dct:description "At 0 Ma the pre-pattern state, with no predecessor chronospecies, is this stable homogeneous field. | Variables: a=0.10, b=0.90, f_u=0.8, g_v=-1" ;
    dct:source "Schnakenberg 1979 JTB 81:389; Turing 1952 Phil Trans R Soc B 237:37" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3156_coscinodiscus_wailesii_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u0 = a + b, v0 = b/(a+b)^2, f_u + g_v < 0, det J > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/S0025315401003654>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.0022-3646.1983.00387.x>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection (Schnakenberg kinetics)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3156.reaction_trace" ;
    pk:leanTheorem "MathOfBiology.Loop_3156.homogeneous_mode_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber k_c = argmax sigma_+(k), wavelength lengthens with inhibitor diffusivity" ;
    dct:description "Selects the 4.3 mm Holocene wavelength. The det-minimizer proxy is rejected because it shortens lambda as D_v grows. | Variables: D_u=1.60, D_v nominal 32, lambda_sigma milli-length 14086, 16328, 18895" ;
    dct:source "Turing 1952; Kondo & Miura 2010 Science 329:1616" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3156_coscinodiscus_wailesii_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "sigma_+(q) = 1/2 (tr + sqrt(tr^2 - 4 det)); k_c = sqrt(argmax sigma_+); lambda(D_v=16) < lambda(D_v=32) < lambda(D_v=64)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/S0025315401003654>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.0022-3646.1983.00387.x>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection (Schnakenberg kinetics)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3156.sigma_wavelength_milli" ;
    pk:leanTheorem "MathOfBiology.Loop_3156.inhibitor_diffusion_lengthens_selected_wavelength" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Nominal parameters sit in the Turing band; equal diffusivities are the ablation" ;
    dct:description "Negative control for the extant Holocene pattern: below threshold the field returns to the homogeneous state. | Variables: scaled ×10: drive 2400 at Dv=320, drive -32 at Dv=16" ;
    dct:source "Turing 1952 instability conditions" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3156_coscinodiscus_wailesii_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_v f_u + D_u g_v = 24.0 > 0 and discriminant > 0 at D_v=32; drive = -3.2 < 0 at D_v=D_u" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/S0025315401003654>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.0022-3646.1983.00387.x>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection (Schnakenberg kinetics)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3156.turing_drive" ;
    pk:leanTheorem "MathOfBiology.Loop_3156.nominal_holocene_turing_band" ;
    pk:leanVerified true .


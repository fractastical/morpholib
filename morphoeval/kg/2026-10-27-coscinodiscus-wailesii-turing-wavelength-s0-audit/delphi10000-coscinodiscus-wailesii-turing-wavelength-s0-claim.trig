sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Coscinodiscus wailesii Turing wavelength at 4.3 mm (Holocene, chronoseries 1/1) faithfully reproduces Coscinodiscus wailesii morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Coscinodiscus wailesii specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0.py; output: docs/media/coscinodiscus_wailesii_turing_wavelength_s0_comparison.png; organism: Coscinodiscus wailesii; environment: python 3.12.3, numpy 2.5.4, scipy 1.18.1, matplotlib 3.11.2, Pillow 13.0.0; claim_boundary: [reported_in_source: Turing 1952: a homogeneous reaction-diffusion equilibrium can select a stationary wavelength. | Schnakenberg 1979: trimolecular kinetics. The paper is well-mixed; the spatial PDE is a transfer. | Schmid and Volcani 1983: C. wailesii valve formation is centrifugal and proximal-to-distal, with distal cribra. | Edwards et al. 2001: the species persisted in the north-east Atlantic from 1977 through 1995.; reconstructed_in_script: Jacobian, sigma_+(q), and k_c = sqrt(argmax sigma_+). | Calibration of nominal lambda_sigma to 4.3 mm (0.004316 m). | Periodic spot integration, D_v sweep, equal-diffusivity ablation, and SEM pore segmentation.; transfer_boundary: 4.3 mm is the Delphi detail-scale wavelength for this slot, not a measured valve diameter. | The cohort form class is realized as areolar spots.; does_not_claim: That one frustule is 4.3 mm across. | That q_det is the selected wavenumber. | That SEM scale bars have been read as nanometres. | That a predecessor or successor chronospecies exists in this 1/1 series.]; phenomenon_size: 2.9 cm (0.02943 m, log10=-1.531 m, tier=7_organism_cm); species_scale_ladder (1 runs from 2.9 cm to 2.9 cm): 2.9 cm:diatom-frustule-phase-sep" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1017/S0025315401003654>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.0022-3646.1983.00387.x>,
            <https://doi.org/10.1126/science.1179047> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


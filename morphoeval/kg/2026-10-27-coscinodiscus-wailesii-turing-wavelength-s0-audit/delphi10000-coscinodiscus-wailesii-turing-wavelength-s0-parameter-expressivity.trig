sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Coscinodiscus wailesii Turing wavelength at 4.3 mm (Holocene, chronoseries 1/1) — Parameter expressivity: 74/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "An eight-point D_v sweep and an equal-diffusivity ablation are computed, and lambda_sigma lengthens with inhibitor diffusivity (14.086, 16.328, 18.895 length units at D_v = 16, 32, 64). Pass 1 does not yet record a one-point CLI probe or the interior standard deviation of the disc-clamped margin, so the boundary condition is shown rather than measured." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0.py L321–L364" ;
        dct:description "D_v sweep over (16, 20, 24, 28, 32, 40, 48, 64) with det-proxy control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0.py#L321-L364> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0.py L367–L390" ;
        dct:description "Ablation at D_v = D_u decays; nominal branch grows" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0.py#L367-L390> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (pass 1 assessment)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


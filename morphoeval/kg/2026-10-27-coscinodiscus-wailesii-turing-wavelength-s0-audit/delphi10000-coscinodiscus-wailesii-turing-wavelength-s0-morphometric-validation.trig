    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-disc-interior-std-vs-ablation-reference> a schema:PropertyValue ;
        dct:source "equal-diffusivity ablation final std" ;
        schema:value "0.001899324739550657" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-holocene-age-ma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "holocene_age_Ma = 0.0 Ma" ;
        dct:description "age of the slot is 0 Ma; the 1977 introduction date is a historical record inside the Holocene" ;
        schema:measurementTechnique "chronoseries 1/1 extant point" ;
        schema:name "holocene_age_Ma" ;
        schema:unitText "Ma" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-holocene-age-ma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-holocene-age-ma-reference> a schema:PropertyValue ;
        dct:source "Edwards et al. 2001 English Channel record, as Ma before present is not zero in calendar years but the horizon age used here is 0 Ma" ;
        schema:value "0.001977" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-ks-specimen-vs-sim-diameter-shape> a schema:PropertyValue,

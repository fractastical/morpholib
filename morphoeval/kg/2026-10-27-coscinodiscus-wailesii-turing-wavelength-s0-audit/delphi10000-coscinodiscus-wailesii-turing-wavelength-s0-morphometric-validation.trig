            pk:EvidenceItem ;
        rdfs:label "calibrated_turing_wavelength_mm = 4.3 mm" ;
        dct:description "value is the 4.3 mm slot scale; reference is the simulated peak in mm and is not equal to it" ;
        schema:measurementTechnique "nominal lambda_sigma mapped onto the Delphi detail scale" ;
        schema:name "calibrated_turing_wavelength_mm" ;
        schema:unitText "mm" ;
        schema:value "4.3" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-calibrated-turing-wavelength-mm-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-calibrated-turing-wavelength-mm-reference> a schema:PropertyValue ;
        dct:source "early-time spectral peak converted with the same metres-per-length factor" ;
        schema:value "4.661512293505827" .

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Coscinodiscus wailesii Turing wavelength at 4.3 mm (Holocene, chronoseries 1/1) — Morphometric validation: 76/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Power-spectrum Pearson r = 0.9899 against lambda_sigma, with RMSE = 1.453 length units. Upper-left areola pitch is 10.15 px (CV 0.268, n = 718) against simulated pitch 14.06 px (CV 0.086). KS distance on median-normalised diameters is 0.317. The RMSE is a real bias, so this pass does not treat the fit as closed." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-ablation-amplitude-decay-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-calibrated-turing-wavelength-mm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-disc-interior-std-vs-ablation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-holocene-age-ma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-ks-specimen-vs-sim-diameter-shape>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-pearson-r-det-proxy-vs-simulated-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-pearson-r-growth-rate-vs-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-pearson-r-sigma-vs-simulated-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-rmse-growth-rate-length-units>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-rmse-wavelength-length-units>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-sem-magnification-pitch-ratio-coarse-over-mid>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-specimen-areola-pitch-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-specimen-areola-pitch-px>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-specimen-pore-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-turing-drive-nominal>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-turing-wavenumber-k-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-ablation-amplitude-decay-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_amplitude_decay_ratio = 0.038 1" ;
        dct:description "negative control versus the patterning branch" ;
        schema:measurementTechnique "std(u) final/initial at D_v = D_u = 1.60 (Turing drive negative)" ;
        schema:name "ablation_amplitude_decay_ratio" ;
        schema:unitText "1" ;
        schema:value "0.038" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-ablation-amplitude-decay-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coscinodiscus-wailesii-turing-wavelength-s0-measurement-ablation-amplitude-decay-ratio-reference> a schema:PropertyValue ;
        dct:source "nominal D_v=32 growth ratio on the same integrator" ;
        schema:value "6.024039457818228" .

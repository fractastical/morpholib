    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-3-node-bmp-sox9-wnt-critical-turing-wavelength-lambda-c>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-emergent-wild-type-autopod-sox9-digit-condensation-count>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-out-of-phase-sox9-vs-bmp-spatial-correlation-r-sox9-bmp> ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF — Morphometric validation: 56/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L247-278) returns only 3 baseline metrics (lambda_c, r(Sox9, Bmp), and wild-type digit count) without evaluating the 7-point FGF/Hox wavelength regression (Pearson r, p-value, RMSE), pharmacological perturbation digit counts, or computer-vision segmentation of the wild-type (5 digits) and polydactylous (6 digits) WISH specimen panels." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2014-raspopovic-bmp-sox9-wnt-digits.py L247–L278: Only 3 baseline metrics returned in measure_morphoeval() without perturbation or specimen CV metrics <https://github.com/fractastical/morpholib/blob/45d4150/2014-raspopovic-bmp-sox9-wnt-digits.py#L247-L278>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-3-node-bmp-sox9-wnt-critical-turing-wavelength-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-emergent-wild-type-autopod-sox9-digit-condensation-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-out-of-phase-sox9-vs-bmp-spatial-correlation-r-sox9-bmp> ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-3-node-bmp-sox9-wnt-critical-turing-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3-node Bmp-Sox9-Wnt critical Turing wavelength lambda_c = 4.002 dimensionless length" ;
        dct:description "q_c = 1.5700, sigma_max = 0.2608" ;
        schema:measurementTechnique "Peak of 3x3 dispersion relation Re(sigma(q)) with D_S=0, D_B=2.5, D_W=0.25" ;
        schema:name "3-node Bmp-Sox9-Wnt critical Turing wavelength lambda_c" ;
        schema:unitText "dimensionless length" ;
        schema:value "4.002" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-3-node-bmp-sox9-wnt-critical-turing-wavelength-lambda-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-3-node-bmp-sox9-wnt-critical-turing-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Raspopovic et al. (2014) Science 345:566-570 Fig. 2E & Supplementary Sec. 1.2" ;
        schema:value "4.002" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-emergent-wild-type-autopod-sox9-digit-condensation-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Emergent wild-type autopod Sox9 digit condensation count = 5.0 digits" ;
        dct:description "Wild-type pentadactyl mouse autopod" ;
        schema:measurementTechnique "Peak count of steady-state Sox9 profile along wild-type distal arc (L=20)" ;
        schema:name "Emergent wild-type autopod Sox9 digit condensation count" ;
        schema:unitText "digits" ;
        schema:value "5.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-emergent-wild-type-autopod-sox9-digit-condensation-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-emergent-wild-type-autopod-sox9-digit-condensation-count-reference> a schema:PropertyValue ;
        dct:source "Raspopovic et al. (2014) Science 345:566-570 Fig. 1 & Fig. 2" ;
        schema:value "5.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-out-of-phase-sox9-vs-bmp-spatial-correlation-r-sox9-bmp> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Out-of-phase Sox9 vs Bmp spatial correlation r(Sox9, Bmp) = -0.9772 Pearson r" ;
        dct:description "r(Sox9, Wnt) = -0.9975" ;
        schema:measurementTechnique "Spatial correlation between steady-state Sox9 and Bmp profiles along distal arc" ;
        schema:name "Out-of-phase Sox9 vs Bmp spatial correlation r(Sox9, Bmp)" ;
        schema:unitText "Pearson r" ;
        schema:value "-0.9772" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-out-of-phase-sox9-vs-bmp-spatial-correlation-r-sox9-bmp-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-out-of-phase-sox9-vs-bmp-spatial-correlation-r-sox9-bmp-reference> a schema:PropertyValue ;
        dct:source "Raspopovic et al. (2014) Science 345:566-570 Fig. 2E-F" ;
        schema:value "-0.98" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 016 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/16> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.7554/eLife.14022> .
    <https://doi.org/10.1126/science.1226804> dct:date "2012"^^xsd:gYear ;
        dct:title "Hox genes regulate digit patterning by controlling the wavelength of a Turing-type mechanism" .
    <https://doi.org/10.1126/science.1252960> dct:date "2014"^^xsd:gYear ;
        dct:title "Digit patterning is controlled by a Bmp-Sox9-Wnt Turing network modulated by morphogen gradients" .
    <https://doi.org/10.7554/eLife.14022> dct:date "2016"^^xsd:gYear ;
        dct:title "High-throughput mathematical analysis identifies Turing networks for patterning with equally diffusing signals" .
}


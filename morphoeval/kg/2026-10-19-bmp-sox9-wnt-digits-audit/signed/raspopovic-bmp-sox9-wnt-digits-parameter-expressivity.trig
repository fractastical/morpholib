sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-parameter-expressivity> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 016 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF — Parameter expressivity: 48/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Simulates only the wild-type baseline parameter set in 1D (L91-145) and plots tabular FGF wavelength values without simulating the 7-point FGF/Hox wavelength sweep or the 6 pharmacological/genetic perturbation conditions (LDN-193189 BMP inhibition, CHIR99021 Wnt activation, IWP-2 Wnt inhibition, Hox/Tbx2 polydactyly, and zero-diffusion control), and exposes no CLI parameter overrides (L285-295)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2014-raspopovic-bmp-sox9-wnt-digits.py L285–L295: CLI exposes only --self-test and --skip-gif without kinetic or diffusion parameter overrides <https://github.com/fractastical/morpholib/blob/45d4150/2014-raspopovic-bmp-sox9-wnt-digits.py#L285-L295>" ;
        pk:hasScore "0.48"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


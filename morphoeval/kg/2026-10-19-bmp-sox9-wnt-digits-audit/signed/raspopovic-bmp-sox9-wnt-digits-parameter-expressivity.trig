    <https://doi.org/10.1126/science.1226804> dcterms:date "2012"^^xsd:gYear ;
        dcterms:title "Hox genes regulate digit patterning by controlling the wavelength of a Turing-type mechanism" .

    <https://doi.org/10.1126/science.1252960> dcterms:date "2014"^^xsd:gYear ;
        dcterms:title "Digit patterning is controlled by a Bmp-Sox9-Wnt Turing network modulated by morphogen gradients" .

    <https://doi.org/10.7554/eLife.14022> dcterms:date "2016"^^xsd:gYear ;
        dcterms:title "High-throughput mathematical analysis identifies Turing networks for patterning with equally diffusing signals" .

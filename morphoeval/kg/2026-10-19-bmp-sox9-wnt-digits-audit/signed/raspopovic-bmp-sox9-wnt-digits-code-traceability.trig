sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF — Code-to-model traceability: 68/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Functions compute J_3, J_eff, and 1D reaction-diffusion dynamics (L35-145), but lack explicit equation-level docstrings cross-referencing Raspopovic et al. (2014) Figs. 2-4, Marcon et al. (2016) eLife, Sheth et al. (2012) Science, and the 3 Lean 4 theorems in `Loop_016_bmp_sox9_wnt_digits.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2014-raspopovic-bmp-sox9-wnt-digits.py L35–L145: Brief docstrings without explicit paper figure/equation or Lean 4 theorem mappings <https://github.com/fractastical/morpholib/blob/45d4150/2014-raspopovic-bmp-sox9-wnt-digits.py#L35-L145>" ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 016 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:provenance {
    <https://doi.org/10.1126/science.1226804> dcterms:date "2012"^^xsd:gYear ;
        dcterms:title "Hox genes regulate digit patterning by controlling the wavelength of a Turing-type mechanism" .

    <https://doi.org/10.1126/science.1252960> dcterms:date "2014"^^xsd:gYear ;
        dcterms:title "Digit patterning is controlled by a Bmp-Sox9-Wnt Turing network modulated by morphogen gradients" .

    <https://doi.org/10.7554/eLife.14022> dcterms:date "2016"^^xsd:gYear ;
        dcterms:title "High-throughput mathematical analysis identifies Turing networks for patterning with equally diffusing signals" .

    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/16> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.7554/eLife.14022> .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF — Model fidelity to source: 59/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the 3-node Bmp-Sox9-Wnt Jacobian J_3 (D_S = 0) and reduced 2-diffuser Jacobian J_eff (L35-59),dispersion curve Re(sigma(q)) (L62-88), and 1D reaction-diffusion integration along a constant-parameter arc (L91-145), backed by 3 Lean 4 theorems in `Loop_016_bmp_sox9_wnt_digits.lean`. However, it omits the 2D fan-shaped limb bud autopod domain where distal AER-FGF gradient modulation prevents radial digit bifurcation, and lacks the zero-diffusion (D_B = D_W = 0) negative control." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2014-raspopovic-bmp-sox9-wnt-digits.py L91–L145: Only 1D constant-parameter arc simulated without 2D fan-shaped autopod FGF gradient modulation or D=0 negative control <https://github.com/fractastical/morpholib/blob/45d4150/2014-raspopovic-bmp-sox9-wnt-digits.py#L91-L145>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity-1> ;
        pk:hasScore "0.59"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L35–L88" ;
        dcterms:description "Exact 3-node J_3 and reduced 2-diffuser J_eff Jacobian and Turing dispersion relation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2014-raspopovic-bmp-sox9-wnt-digits.py#L35-L88> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 016 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


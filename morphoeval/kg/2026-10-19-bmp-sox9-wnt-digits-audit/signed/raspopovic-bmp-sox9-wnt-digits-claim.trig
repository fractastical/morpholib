sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> a pk:Claim ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF faithfully reproduces Embryonic mouse autopod (Mus musculus, E11.5-E13.5) morphology" ;
        dcterms:description "The simulation script(s) 2014-raspopovic-bmp-sox9-wnt-digits.py implement the cited source model as published and produce forms that match real Embryonic mouse autopod (Mus musculus, E11.5-E13.5) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 54.8/100, audit 2026-10-19-bmp-sox9-wnt-digits-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/45d4150/2014-raspopovic-bmp-sox9-wnt-digits.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/45d4150/2014-raspopovic-bmp-sox9-wnt-digits.py; output: docs/media/bmp_sox9_wnt_digits_comparison.png; organism: Embryonic mouse autopod (Mus musculus, E11.5-E13.5); checkpoint commit: https://github.com/fractastical/morpholib/commit/45d4150; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 32ffd4da7438d98577c009d5ac5a4c2bdcbd27793695743733dcb58e60f808b5; artifact_sha256: 5560c0f4ed8499697b94d87b329d7c9c3f50506b836f8c83d88b8ce5d9bdd0e5; input_dataset_sha256: {datasets/bmp_sox9_wnt_digits/bmp_sox9_wnt_digits_reference.json=c0444b665610be2e..., datasets/bmp_sox9_wnt_digits/paper_citations.bib=88ff32a60b567060..., datasets/bmp_sox9_wnt_digits/scout_manifest.json=f990b473b6a93cfa..., datasets/bmp_sox9_wnt_digits/sox9_limb_digits_specimen.jpg=533f621904d6f2ce...}" ;
        pk:derivedFromPaper <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.7554/eLife.14022> ;

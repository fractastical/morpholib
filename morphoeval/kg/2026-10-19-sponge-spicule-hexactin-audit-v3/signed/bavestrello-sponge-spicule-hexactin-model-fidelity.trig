sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bavestrello-sponge-spicule-hexactin> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Uriz et al. (2003) & Aizenberg et al. (2005) sponge spicule silicatein axial symmetry, concentric biosilica lamination, Euplectella checkerboard lattice mechanics, cohesive-zone laminate bending, helical cage ridges and basalia waveguiding — Model fidelity to source: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Pass 2 content stands (exact O_h / T_d / D_3h / D_inf_h ray algebra L153-245, 3D reaction-diffusion accretion L249-370, lamellar thinning L395-459, checkerboard shear L464-508). Pass 3 adds a correctly assembled Hermite-beam FE (L750-791; parity with 48 EI / L^3 to 1e-9), a bilinear cohesive law whose integral equals G_i (L719-747), the He-Hutchinson deflection test and a Griffith delamination balance solved on the FE stiffness (L799-949), a sin^2(2 psi) netting projection with parallel-axis ovalization gain (L1041-1104) and a step-index waveguide with exact ray invariant and Bessel-zero LP cutoffs (L1112-1203), all with Lean-checked identities. Deductions: the remediation item asked for a 3D cohesive-zone FEM; what was built is a 1D single-crack beam model (-3); the Pass 2 toughness law 1 + eta N (eta = 0.32, L104) is phenomenological, fitted to the recalled table, and is contradicted ~5x by the new mechanics (1.71 vs 9.0) — the script keeps both without reconciling them (-4); the bending geometry inherits the Law-3 outer radius 5.83 um instead of the species-table 22.5 um (-2); Law 4 (cos^2 45 deg = 0.5 per strut, L489) and Law 6 (sin^2(2 psi) normalised to 1 at 45 deg) state the diagonal projection with different conventions and the 7.5x checkerboard gain rests on the arbitrary K_axial / K_bend = 26 (L106) (-2); the k_cat -> N coupling is a calibrated mass-to-layer constant rather than a mechanistic lamella-count law (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "models/2012-bavestrello-sponge-spicule-hexactin.py L395–L459: Law-3 laminate: r_core 0.75 um, h_1 0.85 um, N = 25 -> outer radius 5.83 um vs 22.5 um in the species table; eta-law 1 + 0.32 N gives 9.0 while the FE model gives 1.71 (unreconciled) <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L395-L459>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-7> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L153–L370" ;
        dcterms:description "Pass 2 silicatein ray symmetry algebra and 3D reaction-diffusion biosilica accretion solver (unchanged; filament_length_um = 0.82 domain, sigma_fil_um = 1.15 hard-coded at L277-L278)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L153-L370> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L719–L791" ;
        dcterms:description "Bilinear cohesive traction, G_i = 0.5 T_max delta_c, Hillerborg l_cz, 4x4 Hermite element and 48-element simply-supported FE midspan stiffness" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L719-L791> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L799–L949" ;
        dcterms:description "Progressive failure: outermost-in strength criterion, He-Hutchinson deflect/penetrate, Griffith half-length by bisection on FE stiffness, piecewise-linear P-delta and W = int P d delta; 1D single-crack model, not 3D cohesive FEM (stated in docstring)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L799-L949> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L950–L999" ;
        dcterms:description "layers_from_accreted_cross_section + evaluate_coupled_accretion_to_fracture: B(x,y,z) integrated at 0.55 R mapped to N via the calibrated SILICA_MASS_TO_LAYER_CALIBRATION (L700); k_cat sweep -> N in {0, 6, 13, 19, 25}" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L950-L999> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L1041–L1104" ;
        dcterms:description "Helical ridge cage: K_tors(psi) = K_wall + N_r k_r sin^2(2 psi), specific stiffness with 1/cos psi helix length, parallel-axis I_eff / I_wall = 1 + N_r A_r / 2 (N_r >= 3)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L1041-L1104> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-6> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L1112–L1203" ;
        dcterms:description "Basalia step-index waveguide from Law-3 lamellar radii: meridional ray trace with n cos theta invariant, NA, V-number, LP-mode count from Bessel zeros, single-mode cutoff wavelength" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L1112-L1203> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-7> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_076_sponge_spicule_hexactin.lean L223–L321" ;
        dcterms:description "Pass 3 Lean: interlayer_deflects / hillerborg_length / laminate_fracture_work and theorem cohesive_laminate_progressive_fracture_work_exceeds_monolith (L255-L270); ridge_shear_projection sums and theorem euplectella_helical_ridge_shear_projection_and_parallel_axis_gain (L309-L320); lean exit 0, 0 sorrys" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/morphoeval/lean/loops/Loop_076_sponge_spicule_hexactin.lean#L223-L321> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 3 remediated assessment; Phase B scoring pass executed by a Claude Fable 5.1 subagent from the Phase A handoff and diff)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


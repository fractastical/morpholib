        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L2096–L2143" ;
        dcterms:description "Pass 3 checks: FE parity 1e-9, cohesive integral, 25 drops vs 1, identical p_peak, fused = monolith, k_cat -> N monotone, psi_opt, ovalization identity, ray trace, Gloge bracket, single-mode at 2 um, len(meas) == 18" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L2096-L2143> .


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bavestrello-sponge-spicule-hexactin> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Uriz et al. (2003) & Aizenberg et al. (2005) sponge spicule silicatein axial symmetry, concentric biosilica lamination, Euplectella checkerboard lattice mechanics, cohesive-zone laminate bending, helical cage ridges and basalia waveguiding — Source and data traceability: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Pass 2 provenance stands: 4 dataset files SHA-256 pinned and verified fail-closed at runtime (L110-147; specimen b562...9cf3, scout fb6e...e39f, paper_citations.bib 8118...44cd). Pass 3 adds `cohesive_bending_waveguide_reference.json` in which every constant carries a `provenance` tag (`model` / `recalled` / `exact`) with the self-referential calibration and the geometry mismatch called out explicitly (L27-44, L54-56, L67-72), `pass3_citations.bib` with six new references, and a README Pass 3 section that states which values are unverified. Deductions: all six new DOIs carry `doi_verified_offline: false` (L9-14) and could not be checked during Pass 3 (-4); the Pass 3 JSON and bib are not added to the SHA-256 registry (L90-96 pins only the four Pass 2 files) (-2); sigma_f, G_s, T_max, delta_c, span / diameter, ridge geometry, n_seawater, wavelength and the optical-core lamella count are `model` / `recalled` with no measured source (-3); the 12-species table still has no per-row citation (-2); the prompt's Prog. Mol. Subcell. Biol. seed paper is not cited anywhere in the script or dataset (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/sponge_spicule_hexactin/cohesive_bending_waveguide_reference.json L27–L44: sigma_f 900 MPa, G_s 8 J/m^2, T_max 40 MPa, delta_c 60 nm, span/diameter 20 are provenance: model; E 36 GPa and He-Hutchinson 0.25 recalled, unverified <https://github.com/fractastical/morpholib/blob/a69596cc/datasets/sponge_spicule_hexactin/cohesive_bending_waveguide_reference.json#L27-L44>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-source-traceability-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-source-traceability-5> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L81–L147" ;
        dcterms:description "Dataset paths, EXPECTED_SHA256 registry (4 Pass 2 files only), compute_sha256, verify_dataset_integrity, load_reference_data" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L81-L147> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L692–L714" ;
        dcterms:description "Pass 3 constants with inline provenance comments; load_pass3_reference reads the non-pinned cohesive_bending_waveguide_reference.json" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L692-L714> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/sponge_spicule_hexactin/cohesive_bending_waveguide_reference.json L1–L75" ;
        dcterms:description "Every constant provenance-tagged; six citations with doi_verified_offline: false (L9-L14); calibration flagged self-referential (L37); geometry mismatch flagged (L44)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/datasets/sponge_spicule_hexactin/cohesive_bending_waveguide_reference.json#L1-L75> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/sponge_spicule_hexactin/pass3_citations.bib L1–L60" ;
        dcterms:description "Sundar 2003, Aizenberg 2004, Woesz 2006, He & Hutchinson 1989, Hillerborg 1976, Gloge 1971 — DOIs recalled offline" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/datasets/sponge_spicule_hexactin/pass3_citations.bib#L1-L60> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-source-traceability-5> a pk:EvidenceItem ;
        rdfs:label "datasets/sponge_spicule_hexactin/README.md L12–L16" ;
        dcterms:description "Pass 3 section: new non-pinned files, unverified recalled values, self-referential calibration and the 5.83 vs 22.5 um geometry mismatch stated" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/datasets/sponge_spicule_hexactin/README.md#L12-L16> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 3 remediated assessment; Phase B scoring pass executed by a Claude Fable 5.1 subagent from the Phase A handoff and diff)" ;

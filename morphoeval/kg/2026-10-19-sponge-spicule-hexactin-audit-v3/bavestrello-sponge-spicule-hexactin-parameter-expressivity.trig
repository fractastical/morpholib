sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bavestrello-sponge-spicule-hexactin> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Uriz et al. (2003) & Aizenberg et al. (2005) sponge spicule silicatein axial symmetry, concentric biosilica lamination, Euplectella checkerboard lattice mechanics, cohesive-zone laminate bending, helical cage ridges and basalia waveguiding — Parameter expressivity: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Pass 2 sweeps (5 symmetry / ablation regimes, f_diag in [0, 1], 12 species) are retained. Pass 3 adds a k_cat ablation sweep {0, 0.25, 0.5, 0.75, 1} propagated through the 3D solver to N and W_lam / W_mono (L968-999), a G_i sweep 0.05-8 J/m^2 crossing the He-Hutchinson cut-off at 2 J/m^2 (L1002-1034), a continuous psi scan for torsional and specific stiffness and N_r scan for the ovalization gain (L1041-1104), a wavelength scan of guided-mode count (L1112-1203), a monolithic / fused-interlayer ablation, and CLI flags `--skip-pass3`, `--g-i`, `--n-ridges` (L2161-2163; `--g-i 0.2` -> 1.832x, `--n-ridges 12` -> 11.4x torsion). Deductions: `--seed` is a documented no-op (L2160) (-2); `--d-s` / `--k-cat` overrides change only the main-figure regimes, not the coupled k_cat sweep which uses its own internal `k_cat_scale` (-3); no sweep of the Law-3 geometry (r_core, h_1) through the bending or optics models although both inherit it (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity-4> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L968–L1034" ;
        dct:description "evaluate_coupled_accretion_to_fracture (k_cat sweep) and evaluate_interlayer_toughness_sweep (G_i 0.05-8 J/m^2 with He-Hutchinson cut-off)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L968-L1034> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L1041–L1104" ;
        dct:description "psi scan and N_r scan for the ridge cage; defaults N_r = 8, A_r = 0.25" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L1041-L1104> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L2152–L2163" ;
        dct:description "CLI: --self-test, --skip-gif, --d-s, --k-cat, --r-core, --n-lamellae, --seed (no-op), --skip-pass3, --g-i, --n-ridges" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L2152-L2163> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L371–L390" ;
        dct:description "evaluate_all_morphospace_regimes: 5 regimes from the reference JSON (Pass 2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L371-L390> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 3 remediated assessment; Phase B scoring pass executed by a Claude Fable 5.1 subagent from the Phase A handoff and diff)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bavestrello-sponge-spicule-hexactin> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Uriz et al. (2003) & Aizenberg et al. (2005) sponge spicule silicatein axial symmetry, concentric biosilica lamination, Euplectella checkerboard lattice mechanics, cohesive-zone laminate bending, helical cage ridges and basalia waveguiding — Morphological realism / specimen match: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The Pass 2 DoG / gradient-tangent segmentation of the SHA-256-locked *Euplectella aspergillum* photograph (L592-667; orthogonal 89.65 deg, diagonal 47.68 deg, pitch 2.50 mm) is retained and the main 6-panel figure (v3 title) still shows the specimen overlay in panel E and now plots the FE cohesive-zone prediction as a star against the eta-law and the 12-species points in panel D (L1408-1422). The new Pass 3 figure (6 panels: P-delta traces, G_i sweep, k_cat -> N coupling, ridge torsion vs psi, ovalization gain, waveguide mode map) and the 10-frame bending-fracture GIF render the new mechanics. Deductions: nothing new is measured from the specimen — ridge count, pitch and area are `provenance: model` and the photograph is not used to count ridges or estimate the helix angle (-4); the laminate geometry the bending / optics models use (outer radius 5.83 um) is one-quarter of the 22.5 um the species table gives for Euplectella (-3); the specimen reference angles 89.6498 / 47.6843 stored in the JSON are the script's own outputs, so the \"match\" is a regression check (-3); the main PNG panel titles A/B/C overlap horizontally at fontsize ~9.5 and the Pass 3 panel F plots modes vs 4 lambda on the radius axis (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/sponge_spicule_hexactin/cohesive_bending_waveguide_reference.json L54–L56: n_ridges 8, ridge_pitch_deg 45, ridge_area_ratio 0.25 all provenance: model — not measured from the specimen <https://github.com/fractastical/morpholib/blob/a69596cc/datasets/sponge_spicule_hexactin/cohesive_bending_waveguide_reference.json#L54-L56>",
            "datasets/sponge_spicule_hexactin/sponge_spicule_hexactin_reference.json L39–L40: reference_orthogonal_angle_deg 89.6498 / reference_diagonal_angle_deg 47.6843 equal the script's own segmentation outputs (regression, not independent measurement) <https://github.com/fractastical/morpholib/blob/a69596cc/datasets/sponge_spicule_hexactin/sponge_spicule_hexactin_reference.json#L39-L40>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match-6> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L592–L667" ;
        dct:description "segment_euplectella_specimen: DoG ridge + gradient-tangent orientation segmentation on euplectella_aspergillum_specimen.jpg (Pass 2, unchanged)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L592-L667> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L1408–L1422" ;
        dct:description "Main figure panel D: FE cohesive-zone W_lam / W_mono star at N = 25 plotted against the eta-law and 12-species table" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L1408-L1422> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L1623–L1824" ;
        dct:description "render_pass3_mechanics_figure (panels A-F) and render_bending_fracture_gif (10 frames)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L1623-L1824> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/sponge_spicule_hexactin_comparison.png (generated output)" ;
        dct:description "6-panel v3 synthesis figure; specimen overlay panel E retained; FE star in panel D; panel titles A/B/C overlap at fontsize ~9.5 — docs/media/sponge_spicule_hexactin_comparison.png: rendered output of models/2012-bavestrello-sponge-spicule-hexactin.py at a69596cc, image/png, 784005 B, 2164×1417 px, artifact_sha256 861ad8a2014aa03f8fa9f126adcae9bf5150b78de2e1099f2b37099dc5e14772 (sha256 861ad8a2014aa03f8fa9f126adcae9bf5150b78de2e1099f2b37099dc5e14772), spec_fingerprint e8c71f657d97f3086b3a9576cab7f81ff7eec29a8903ce345cec0985c35812ca" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match-5> a pk:EvidenceItem ;
        rdfs:label "docs/media/sponge_spicule_hexactin_pass3_mechanics.png (generated output)" ;
        dct:description "Pass 3 mechanics figure: cohesive bending P-delta, G_i sweep, k_cat coupling, ridge torsion, ovalization gain, waveguide modes (panel F radius axis carries 4 lambda) — docs/media/sponge_spicule_hexactin_pass3_mechanics.png: rendered output of models/2012-bavestrello-sponge-spicule-hexactin.py at a69596cc, image/png, 408272 B, 2167×1414 px, artifact_sha256 fc0457de903cc036e7f39b47e26682418ed9e96dd41852835e677849dd481e89 (sha256 fc0457de903cc036e7f39b47e26682418ed9e96dd41852835e677849dd481e89), spec_fingerprint e8c71f657d97f3086b3a9576cab7f81ff7eec29a8903ce345cec0985c35812ca" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match-6> a pk:EvidenceItem ;
        rdfs:label "docs/media/sponge_spicule_hexactin_growth.gif (generated output)" ;
        dct:description "7-frame Pass 2 growth GIF (3D accretion + lamellar apposition) regenerated unchanged by the v3 default invocation — docs/media/sponge_spicule_hexactin_growth.gif: rendered output of models/2012-bavestrello-sponge-spicule-hexactin.py at a69596cc, image/gif, 529727 B, 1092×482 px, 7 frames, artifact_sha256 192f07d1128d1b6c4c2ecff6bd4e8f7490a0e703d9340e3fb5a86f5ac046c0c3 (sha256 192f07d1128d1b6c4c2ecff6bd4e8f7490a0e703d9340e3fb5a86f5ac046c0c3), spec_fingerprint e8c71f657d97f3086b3a9576cab7f81ff7eec29a8903ce345cec0985c35812ca" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 3 remediated assessment; Phase B scoring pass executed by a Claude Fable 5.1 subagent from the Phase A handoff and diff)" ;

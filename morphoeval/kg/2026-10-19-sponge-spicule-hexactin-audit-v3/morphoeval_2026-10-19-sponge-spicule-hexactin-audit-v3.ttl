<https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-code-traceability-1> a pk1:EvidenceItem ;
    rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L1–L59" ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bavestrello-sponge-spicule-hexactin> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Uriz et al. (2003) & Aizenberg et al. (2005) sponge spicule silicatein axial symmetry, concentric biosilica lamination, Euplectella checkerboard lattice mechanics, cohesive-zone laminate bending, helical cage ridges and basalia waveguiding — Code-to-model traceability: 89/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The v3 header docstring (L1-59) lists the Pass 3 laws with their sources and the Pass 3 section banner (L668-689) states plainly that the bending model is a reduced 1D beam, not a 3D cohesive FEM. Every Pass 3 function docstring names its equation and source (cohesive law, Hillerborg, Hermite element, He-Hutchinson, Griffith, netting projection, parallel-axis, ray invariant, Gloge), and Laws 5-7 are registered in the math-KG YAML with single-range `code_locus` pins and Lean theorem names. Deductions: stale docstrings — `measure_morphoeval()` still says \"9 reference-anchored\" (L1829) though it returns 18, `self_test()` says \"8-point verification suite for Pass 2\" (L2039) though it runs 12 checks, and the section-9 banner says \"8-Check Self-Test\" (L1826) (-4); Law 4 and Law 6 state the diagonal projection with different normalisations without a cross-reference (L489 vs L1041-1104) (-3); Law 7 has `lean_theorem: null` in the math-KG YAML (-2); the He-Hutchinson zero-mismatch criterion is applied to a silica / organic interface whose elastic mismatch is large, without a comment on the Dundurs parameters (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "models/2012-bavestrello-sponge-spicule-hexactin.py L1826–L1829: Section banner '8-Check Self-Test' and measure_morphoeval docstring '9 reference-anchored' are stale (18 entries, 12 checks) <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L1826-L1829>",
            "models/2012-bavestrello-sponge-spicule-hexactin.py L2038–L2039: self_test docstring 'comprehensive 8-point verification suite for Pass 2' is stale (12 checks, v3) <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L2038-L2039>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-code-traceability-3> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L1–L59" ;
        dct:description "v3 header docstring: Pass 2 laws plus Pass 3 Laws 5-7 with sources and the reduced-model disclaimer" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L1-L59> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "models/2012-bavestrello-sponge-spicule-hexactin.py L668–L714" ;
        dct:description "Pass 3 section banner (reduced 1D FE, not 3D cohesive FEM) and provenance-commented constants" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2012-bavestrello-sponge-spicule-hexactin.py#L668-L714> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/bavestrello-sponge-spicule-hexactin.yaml L117–L146" ;
        dct:description "Laws 5-7 registered with single-range code_locus (secondary range in code_locus_secondary) and Lean theorem names; Law 7 lean_theorem: null" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/morphoeval/math_kg_loops/bavestrello-sponge-spicule-hexactin.yaml#L117-L146> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 3 remediated assessment; Phase B scoring pass executed by a Claude Fable 5.1 subagent from the Phase A handoff and diff)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 2.157 µm on the D. yakuba abdominal cuticle (Holocene, 0 Ma) — Model fidelity to source: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Unchanged Schnakenberg core: trace −0.2, determinant 1, cross term 15, discriminant positive, equal diffusion stable. Linearised PDE versus the discrete dispersion gives r = 0.99525 and RMSE 0.0394 over 22 modes. The pass-2 wavelength estimator does not alter the PDE." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-yakuba-turing-wavelength-s0.py L87–L176" ;
        dct:description "σ(k), discrete eigenvalue, and the eigenvector growth test." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1d40797a1aa1c46f0b61e38c4454905b1b892739/models/2026-delphi10000-drosophila-yakuba-turing-wavelength-s0.py#L87-L176> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-yakuba-turing-wavelength-s0.py L216–L220" ;
        dct:description "Equal-diffusion ablation σ*." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1d40797a1aa1c46f0b61e38c4454905b1b892739/models/2026-delphi10000-drosophila-yakuba-turing-wavelength-s0.py#L216-L220> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3212_drosophila_yakuba_turing_wavelength_s0.lean L16–L42" ;
        dct:description "Five theorems, zero sorry, including the willistoni ratio." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1d40797a1aa1c46f0b61e38c4454905b1b892739/morphoeval/lean/loops/Loop_3212_drosophila_yakuba_turing_wavelength_s0.lean#L16-L42> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (Cursor cloud agent, primary assessor, pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-yakuba-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homogeneous-state trace condition" ;
    dct:description "Diffusion-free stability of the yellow/tan homogeneous cuticle | Variables: f_u, g_v at the Schnakenberg steady state (u0, v0) = (1, 0.9)" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0; Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1d40797a1aa1c46f0b61e38c4454905b1b892739/morphoeval/lean/loops/Loop_3212_drosophila_yakuba_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "tr J = f_u + g_v = 0.8 + (-1) = -0.2 < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.0014-3820.2002.tb00150.x>,
        <https://doi.org/10.1242/dev.129.8.1849>,
        <https://doi.org/10.1534/genetics.105.044412> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3212.traceScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3212.homogeneous_state_stable_trace" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-yakuba-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Inhibitor long-range cross term" ;
    dct:description "Necessary condition for a finite Turing wavenumber at 2.157 µm | Variables: D_u = 1 (Yellow), D_v = 20 (Ebony/NBAD)" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1d40797a1aa1c46f0b61e38c4454905b1b892739/morphoeval/lean/loops/Loop_3212_drosophila_yakuba_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_v f_u + D_u g_v = 20*(0.8) + 1*(-1) = 15 > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.0014-3820.2002.tb00150.x>,
        <https://doi.org/10.1242/dev.129.8.1849>,
        <https://doi.org/10.1534/genetics.105.044412> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3212.crossScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3212.inhibitor_long_range_cross_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-yakuba-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diffusion-driven instability discriminant" ;
    dct:description "Strict Turing instability of the subcellular pigment field | Variables: det J = 1 at this steady state" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1d40797a1aa1c46f0b61e38c4454905b1b892739/morphoeval/lean/loops/Loop_3212_drosophila_yakuba_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(D_v f_u + D_u g_v)^2 > 4 D_u D_v det J" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.0014-3820.2002.tb00150.x>,
        <https://doi.org/10.1242/dev.129.8.1849>,
        <https://doi.org/10.1534/genetics.105.044412> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3212.crossScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3212.diffusion_driven_instability_discriminant" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-yakuba-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control; no wavelength is selected | Variables: ablation sets D_u = D_v" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1d40797a1aa1c46f0b61e38c4454905b1b892739/morphoeval/lean/loops/Loop_3212_drosophila_yakuba_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_u = D_v = 1 implies D_v f_u + D_u g_v = -0.2 < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.0014-3820.2002.tb00150.x>,
        <https://doi.org/10.1242/dev.129.8.1849>,
        <https://doi.org/10.1534/genetics.105.044412> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3212.equal_diffusion_control_is_stable" ;
    pk:leanTheorem "MathOfBiology.Loop_3212.equal_diffusion_control_is_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-yakuba-turing-wavelength-s0-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries wavenumber ratio versus D. willistoni" ;

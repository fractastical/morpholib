}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Dactylioceras commune Turing k_c at 24 µm (pass 1, stage 1) — Morphometric validation: 58/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Stage 1 reports lambda_c and one growth rate. It does not measure ribs on the photograph, does not report Pearson r or RMSE, and does not run a KS test." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-dispersion-growth-rate-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-dispersion-growth-rate-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-equal-diffusion-ablation-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-segmented-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-segmented-specimen-shell-outer-whorl-rib-harmonic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-segmented-specimen-shell-rib-spacing>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-specimen-versus-turing-stripe-orientation-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-turing-stripe-critical-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-dispersion-growth-rate-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion growth-rate Pearson r = 0.99991 correlation" ;
        dct:description "RMSE = 0.000948" ;
        schema:measurementTechnique "corr(analytical sigma(k), numerical Schnakenberg growth rate) across the band around k_c" ;
        schema:name "dispersion growth-rate Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.99991" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-dispersion-growth-rate-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-dispersion-growth-rate-pearson-r-reference> a schema:PropertyValue ;
        dct:source "MorphoEval gate Pearson r > 0.98" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-dispersion-growth-rate-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion growth-rate RMSE = 0.000948 1/time" ;
        schema:measurementTechnique "root mean square of analytical minus numerical sigma(k)" ;
        schema:name "dispersion growth-rate RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.000948" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-dispersion-growth-rate-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-dispersion-growth-rate-rmse-reference> a schema:PropertyValue ;
        dct:source "loose tolerance; the achieved RMSE is much smaller" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-equal-diffusion-ablation-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation growth rate = -0.313981 1/time" ;
        dct:description "negative control versus the positive Turing growth rate" ;
        schema:measurementTechnique "numerical sigma at k_c with Dv reset to Du" ;
        schema:name "equal-diffusion ablation growth rate" ;
        schema:unitText "1/time" ;
        schema:value "-0.313981" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-equal-diffusion-ablation-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-equal-diffusion-ablation-growth-rate-reference> a schema:PropertyValue ;
        dct:source "Turing-ratio sigma at the same k_c (positive control)" ;
        schema:value "0.029661" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-segmented-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented specimen foreground fraction = 0.5357 fraction" ;
        schema:measurementTechnique "largest connected component below the 55th percentile of gray value" ;
        schema:name "segmented specimen foreground fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.5357" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-segmented-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-segmented-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "null occupancy of one half of the frame" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-segmented-specimen-shell-outer-whorl-rib-harmonic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented specimen shell outer-whorl rib harmonic = 44 ribs per revolution" ;
        dct:description "outer harmonic and the halved primary prediction are not the same number" ;
        schema:measurementTechnique "angular FFT on the 0.75-0.95 radius band of the CC BY Whitby photograph" ;
        schema:name "segmented specimen shell outer-whorl rib harmonic" ;
        schema:unitText "ribs per revolution" ;
        schema:value "44" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-segmented-specimen-shell-outer-whorl-rib-harmonic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-segmented-specimen-shell-outer-whorl-rib-harmonic-reference> a schema:PropertyValue ;
        dct:source "fibulation hypothesis: inner primary count is half the outer harmonic" ;
        schema:value "22" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-segmented-specimen-shell-rib-spacing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented specimen shell rib spacing = 3.4841 mm" ;
        dct:description "measured Whitby rib spacing versus the predecessor organ-scale wavelength" ;
        schema:measurementTechnique "outer circumference at 0.85 shell radius using the photographer's 57 mm width, divided by the rib harmonic" ;
        schema:name "segmented specimen shell rib spacing" ;
        schema:unitText "mm" ;
        schema:value "3.4841" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-segmented-specimen-shell-rib-spacing-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-segmented-specimen-shell-rib-spacing-reference> a schema:PropertyValue ;
        dct:source "Ceratites nodosus organ-scale Turing wavelength 1.088 mm at 240 Ma (predecessor)" ;
        schema:value "1.088" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image structure-tensor coherency = 0.3619 coherency" ;
        schema:measurementTechnique "mean structure-tensor coherency on the shell crop" ;
        schema:name "specimen image structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.3619" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "isotropic-texture prior used as the null coherency" ;
        schema:value "0.35" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-specimen-versus-turing-stripe-orientation-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen versus Turing stripe orientation KS statistic = 0.4716 KS distance" ;
        dct:description "p = 1.451e-275" ;
        schema:measurementTechnique "two-sample KS test of Sobel orientations, photograph versus the Schnakenberg patch" ;
        schema:name "specimen versus Turing stripe orientation KS statistic" ;
        schema:unitText "KS distance" ;
        schema:value "0.4716" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-specimen-versus-turing-stripe-orientation-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-specimen-versus-turing-stripe-orientation-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "significance level alpha = 0.05, not the expected distance" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-turing-stripe-critical-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing stripe critical wavelength = 24.19 µm" ;
        dct:description "reference is the integer catalogue label, not the calibrated SI wavelength" ;
        schema:measurementTechnique "lambda_c = 2 pi / k_c with k_c^2 = (Dv f_u + Du g_v) / (2 Du Dv)" ;
        schema:name "Turing stripe critical wavelength" ;
        schema:unitText "µm" ;
        schema:value "24.19" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-turing-stripe-critical-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-measurement-turing-stripe-critical-wavelength-reference> a schema:PropertyValue ;
        dct:source "Catalogue label 24 µm; SI size 2.419e-05 m = 24.19 µm" ;
        schema:value "24.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "datasets/dactylioceras_commune_turing_wavelength_s0/pass1_metrics.json L3–L14" ;
        dct:description "only lambda, sigma, and CV; no rib spacing or dispersion r" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8c95fb91d41c76d640c8216d24030d8fd3768487/datasets/dactylioceras_commune_turing_wavelength_s0/pass1_metrics.json#L3-L14> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 builder-assessor, loop 3159 pass 1" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0000-0000-0000> .
}


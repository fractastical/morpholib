<https://w3id.org/delphi/resource/math-law/delphi10000-dactylioceras-commune-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing critical wavenumber" ;
    dct:description "Fixes the 24.19 µm detail-scale pigment/ocellus wavelength for Dactylioceras commune at 181 Ma | Variables: D_u, D_v > 0; f_u, g_v from the Schnakenberg Jacobian at (a, b) = (0.04, 0.96)" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0; Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8c95fb91d41c76d640c8216d24030d8fd3768487/models/2026-delphi10000-dactylioceras-commune-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/8c95fb91d41c76d640c8216d24030d8fd3768487/morphoeval/lean/loops/Loop_3159_dactylioceras_commune_turing_wavelength_s0.lean#L16-L21> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c = 2.419e-05 m" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/S0022-5193(87)80101-7>,
        <https://doi.org/10.1017/S0094837300010046>,
        <https://doi.org/10.1017/S0094837300013336>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1145/142920.134096> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3159.kcDen" ;
    pk:leanTheorem "MathOfBiology.Loop_3159.kc_den_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-dactylioceras-commune-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Onset diffusion-ratio threshold" ;

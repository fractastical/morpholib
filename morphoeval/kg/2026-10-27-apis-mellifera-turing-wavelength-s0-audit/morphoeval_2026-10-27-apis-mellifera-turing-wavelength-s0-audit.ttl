    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/6fefd6a0/models/2026-delphi10000-apis-mellifera-turing-wavelength-s0.py#L244-L251>,
        <https://github.com/fractastical/morpholib/blob/6fefd6a0/morphoeval/lean/loops/Loop_3115_apis_mellifera_turing_wavelength_s0.lean#L40-L49> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "λ(0.8) > λ(1.0) > λ(1.262) > λ(1.6), with the slot at 11.2 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00172140>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.asd.2011.06.004>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3115.lambdaTenthsUm" ;
    pk:leanTheorem "MathOfBiology.Loop_3115.wavelength_decreases_as_gamma_rises" ;
    pk:leanVerified true .


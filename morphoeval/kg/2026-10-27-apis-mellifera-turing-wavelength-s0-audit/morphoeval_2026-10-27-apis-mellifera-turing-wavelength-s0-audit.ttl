<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Apis mellifera Schnakenberg wavelength at 11.2 µm (Pass 1 raw field) (Apis mellifera)",
        "Apis mellifera Schnakenberg wavelength at 11.2 µm (Pass 1 raw field) faithfully reproduces Apis mellifera morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-apis-mellifera-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-apis-mellifera-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-apis-mellifera-turing-wavelength-s0-3>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-apis-mellifera-turing-wavelength-s0-4>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-apis-mellifera-turing-wavelength-s0-5> ;
    dct:description "The simulation script(s) models/2026-delphi10000-apis-mellifera-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Apis mellifera specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-apis-mellifera-turing-wavelength-s0.py> ;
    schema:about "Apis mellifera" ;
    schema:additionalProperty "does_not_claim: That Camazine 1991 comb parameters were reused",
        "does_not_claim: That the raw lattice is a picture of the worker",
        "reconstructed_in_script: Explicit Euler, seed 3115, periodic boundary",
        "reconstructed_in_script: γ = 1.2618 chosen so the discrete argmax is 11.2 µm on a 134.4 µm window",
        "reported_in_source: Ribi, Warrant & Zeil 2011 rhabdom sheet 8.7 µm by 1 µm",
        "reported_in_source: Schnakenberg 1979 kinetics",
        "reported_in_source: Turing 1952 dispersion and the requirement that diffusivities differ",
        "transfer_boundary: No source measured a chemical wavelength of 11.2 µm in the honeybee. Relative gap versus the 8.7 µm rhabdom long axis is 0.287." ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Apis mellifera" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "II. Anaima (Invertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;
    pk:aristotelianSubalternClass "Entoma (Arthropoda)" ;
    pk:biologicalGenus "Apis" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-apis-mellifera-turing-wavelength-s0.py; output: datasets/apis_mellifera_turing_wavelength_s0/pass1_raw_comparison.png; organism: Apis mellifera; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion and the requirement that diffusivities differ | Schnakenberg 1979 kinetics | Ribi, Warrant & Zeil 2011 rhabdom sheet 8.7 µm by 1 µm; reconstructed_in_script: γ = 1.2618 chosen so the discrete argmax is 11.2 µm on a 134.4 µm window | Explicit Euler, seed 3115, periodic boundary; transfer_boundary: No source measured a chemical wavelength of 11.2 µm in the honeybee. Relative gap versus the 8.7 µm rhabdom long axis is 0.287.; does_not_claim: That the raw lattice is a picture of the worker | That Camazine 1991 comb parameters were reused]; phenomenon_size: 8.8 µm (8.848e-06 m, log10=-5.053 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 8.8 µm to 2.7 cm): 8.8 µm:apis-mellifera-bioelectric-polarity, 33 µm:apis-mellifera-vertex-packing, 599 µm:apis-mellifera-turing-wavelength, 1.1 mm:apis-mellifera-clock-wavefront, 1.8 mm:apis-mellifera-morphogen-condensation, 2.6 mm:apis-mellifera-elastic-buckling, 4.5 mm:apis-mellifera-flux-canalization, 5.9 mm:apis-mellifera-branching-tree" ;
    pk:derivedFromPaper <https://doi.org/10.1007/BF00172140>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.asd.2011.06.004>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:geologicalAgeMa 0e+00 ;
    pk:geologicalPeriod "Holocene (Extant)" ;
    pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-code-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-model-fidelity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-morphometric-validation>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-overall>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-repro-package>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-source-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-specimen-match> ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-27-apis-mellifera-turing-wavelength-s0-audit-delphi10000-apis-mellifera-turing-wavelength-s0-1>,

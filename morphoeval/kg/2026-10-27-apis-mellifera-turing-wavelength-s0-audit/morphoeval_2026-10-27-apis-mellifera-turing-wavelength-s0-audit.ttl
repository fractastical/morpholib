<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Apis mellifera Schnakenberg wavelength at 11.2 µm (Pass 1 raw field) — Model fidelity to source: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;

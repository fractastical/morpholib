sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Apis mellifera Schnakenberg wavelength at 11.2 µm (Pass 1 raw field) — MorphoEval overall 74.5/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Discrete dispersion peaks at 11.20 µm (k_c = 5.612e5 m^-1, log10 = -4.951) with Pearson r = 1.000 between Fourier-mode growth and the discrete symbol (RMSE 7.5e-5). The nonlinear lattice wavelength is 11.00 µm. Equal diffusion gives σ_max = -0.129. Pass 1 publishes only the raw lattice, which does not resemble the worker. CV similarity of that GIF to the Severns photograph is 91.4 and is not counted as a specimen match. Overall 74.5/100 (faithfulness 68.9, reproducibility 87.6); rubric morphoeval 0.1.0; checkpoint commit 6fefd6a0; environment: . Dimension assessments: Model fidelity to source 88, Morphological realism / specimen match 42, Parameter expressivity 78, Morphometric validation 82, Source and data traceability 90, Code-to-model traceability 84, Reproducibility package 88. Output judged: datasets/apis_mellifera_turing_wavelength_s0/pass1_raw_comparison.png: rendered output of models/2026-delphi10000-apis-mellifera-turing-wavelength-s0.py at 6fefd6a0, image/png, 84339 B, 1152×528 px, artifact_sha256 8e54b4652ee0b4e4771b169d4aa99c5c60e911200a60c835d69b674b68e38bd3 (sha256 8e54b4652ee0b4e4771b169d4aa99c5c60e911200a60c835d69b674b68e38bd3), spec_fingerprint ead8c2daa6443b4c6d8a0168cde643f354ab15fd7ffa8abb51b4ba6686c5ad09. Dual provenance: spec_fingerprint: ead8c2daa6443b4c6d8a0168cde643f354ab15fd7ffa8abb51b4ba6686c5ad09; artifact_sha256: 8e54b4652ee0b4e4771b169d4aa99c5c60e911200a60c835d69b674b68e38bd3; input_dataset_sha256: {datasets/apis_mellifera_turing_wavelength_s0/apis_mellifera_specimen.jpg=7dcd58fa1f1da3ad..., datasets/apis_mellifera_turing_wavelength_s0/apis_mellifera_turing_wavelength_s0_reference.json=5f5b563b6c87662d...}. Claim boundary: reported_in_source: Turing 1952 dispersion and the requirement that diffusivities differ | Schnakenberg 1979 kinetics | Ribi, Warrant & Zeil 2011 rhabdom sheet 8.7 µm by 1 µm; reconstructed_in_script: γ = 1.2618 chosen so the discrete argmax is 11.2 µm on a 134.4 µm window | Explicit Euler, seed 3115, periodic boundary; transfer_boundary: No source measured a chemical wavelength of 11.2 µm in the honeybee. Relative gap versus the 8.7 µm rhabdom long axis is 0.287.; does_not_claim: That the raw lattice is a picture of the worker | That Camazine 1991 comb parameters were reused." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Publish the habitus composite. The raw lattice is not a specimen match even though its CV similarity is 91.4.",
            "remediation needed: Put the γ sweep and the equal-diffusion σ_max on the comparison figure.",
            "remediation needed: Segment the Severns photograph (circularity, aspect, coherency, orientation KS) and keep the 0.287 gap versus the 8.7 µm rhabdom explicit." ;
        pk:hasScore "0.745"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


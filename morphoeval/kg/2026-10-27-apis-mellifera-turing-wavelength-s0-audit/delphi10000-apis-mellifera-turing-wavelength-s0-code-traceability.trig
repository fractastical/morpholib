        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3115_apis_mellifera_turing_wavelength_s0.lean L12–L49" ;
        dct:description "five theorems, zero sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/6fefd6a0/morphoeval/lean/loops/Loop_3115_apis_mellifera_turing_wavelength_s0.lean#L12-L49> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-oster-mechanochemical-chondrogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Oster, Murray & Harris (1983) / Oster, Murray & Maini (1985) mechanochemical limb chondrogenesis — Morphometric validation: 54/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Includes `measure_morphoeval()`, but Pass 1 needs full 5-regime mode count RMSE, forelimb and hindlimb autopod inter-digital spacing CV, and cross-sectional waveform Pearson correlation r." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1983-oster-mechanochemical-chondrogenesis.py L430–L505: MorphoEval measurement hook measure_morphoeval() <https://github.com/fractastical/morpholib/blob/317bc3c/1983-oster-mechanochemical-chondrogenesis.py#L430-L505>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-critical-cell-traction-bifurcation-threshold-tau-c-vs-subcritical-negative-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-proximo-distal-limb-branching-hierarchy-mode-progression-subcritical-stylopod-zeugopod-4-digit-5-digit-autopod-rmse>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-salamander-forelimb-specimen-oedipina-ecuatoriana-autopod-inter-digital-spacing>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-salamander-hindlimb-specimen-oedipina-ecuatoriana-autopod-inter-digital-spacing>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-simulated-urodele-forelimb-autopod-m-4-condensation-wavelength-vs-analytical-lambda-c> ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-critical-cell-traction-bifurcation-threshold-tau-c-vs-subcritical-negative-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical cell traction bifurcation threshold tau_c vs subcritical negative control = 1.2776 dimensionless traction parameter" ;
        dct:description "subcritical control tau=0.85 < tau_c yields 0 condensations (amplitude=0.0008); supercritical perturbation tau > tau_c drives condensation" ;
        schema:measurementTechnique "Oster-Murray-Maini (1985) linearized mechanochemical dispersion relation at k_c=0.9597 (lambda_c=6.5472) vs subcritical negative control (tau=0.85)" ;
        schema:name "critical cell traction bifurcation threshold tau_c vs subcritical negative control" ;
        schema:unitText "dimensionless traction parameter" ;
        schema:value "1.2776" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-critical-cell-traction-bifurcation-threshold-tau-c-vs-subcritical-negative-control-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-critical-cell-traction-bifurcation-threshold-tau-c-vs-subcritical-negative-control-reference> a schema:PropertyValue ;
        dct:source "Oster, Murray & Harris (1983) J. Embryol. Exp. Morph. 78:83-125 & Oster, Murray & Maini (1985) J. Embryol. Exp. Morph. 89:93-112 Section 2" ;
        schema:value "1.2776" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-proximo-distal-limb-branching-hierarchy-mode-progression-subcritical-stylopod-zeugopod-4-digit-5-digit-autopod-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "proximo-distal limb branching hierarchy mode progression (subcritical, stylopod, zeugopod, 4-digit & 5-digit autopod) RMSE = 0.0 condensation elements" ;
        dct:description "simulated mode counts = [0, 1, 2, 4, 5] vs reference [0, 1, 2, 4, 5]" ;
        schema:measurementTechnique "5-zone mechanochemical PDE mode progression [0, 1, 2, 4, 5] vs Oster-Murray-Maini & Shubin-Alberch tetrapod limb archetype (Pearson r=1.0000, p=0.00e+00)" ;
        schema:name "proximo-distal limb branching hierarchy mode progression (subcritical, stylopod, zeugopod, 4-digit & 5-digit autopod) RMSE" ;
        schema:unitText "condensation elements" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-proximo-distal-limb-branching-hierarchy-mode-progression-subcritical-stylopod-zeugopod-4-digit-5-digit-autopod-rmse-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-proximo-distal-limb-branching-hierarchy-mode-progression-subcritical-stylopod-zeugopod-4-digit-5-digit-autopod-rmse-reference> a schema:PropertyValue ;
        dct:source "Oster, Murray & Maini (1985) J. Embryol. Exp. Morph. 89:93-112 Figs. 4-9 & Shubin & Alberch (1986) Evol. Biol. 20:319-387" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-salamander-forelimb-specimen-oedipina-ecuatoriana-autopod-inter-digital-spacing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "salamander forelimb specimen (Oedipina ecuatoriana) autopod inter-digital spacing = 39.0 px" ;
        dct:description "forelimb hierarchy = [1, 2, 4] (1 humerus -> 2 ulna/radius -> 4 digits I-IV), profile correlation r = 0.8742" ;
        schema:measurementTechnique "morphological cross-section segmentation of 4 forelimb digits I-IV on salamander_limb_cartilage_specimen.jpg (hierarchy=[1, 2, 4], CV=0.0628)" ;
        schema:name "salamander forelimb specimen (Oedipina ecuatoriana) autopod inter-digital spacing" ;
        schema:unitText "px" ;
        schema:value "39.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-salamander-forelimb-specimen-oedipina-ecuatoriana-autopod-inter-digital-spacing-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-salamander-forelimb-specimen-oedipina-ecuatoriana-autopod-inter-digital-spacing-reference> a schema:PropertyValue ;
        dct:source "Vendored CC BY 4.0 urodele salamander forelimb skeletal micro-CT specimen (datasets/mechanochemical_chondrogenesis/salamander_limb_cartilage_specimen.jpg)" ;
        schema:value "39.3333" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-salamander-hindlimb-specimen-oedipina-ecuatoriana-autopod-inter-digital-spacing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "salamander hindlimb specimen (Oedipina ecuatoriana) autopod inter-digital spacing = 41.25 px" ;
        dct:description "hindlimb hierarchy = [1, 2, 5] (1 femur -> 2 tibia/fibula -> 5 digits I-V), zeugopod spacing = 58.0 px" ;
        schema:measurementTechnique "morphological cross-section segmentation of 5 hindlimb digits I-V on salamander_limb_cartilage_specimen.jpg (hierarchy=[1, 2, 5], CV=0.1734)" ;
        schema:name "salamander hindlimb specimen (Oedipina ecuatoriana) autopod inter-digital spacing" ;
        schema:unitText "px" ;
        schema:value "41.25" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-salamander-hindlimb-specimen-oedipina-ecuatoriana-autopod-inter-digital-spacing-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-salamander-hindlimb-specimen-oedipina-ecuatoriana-autopod-inter-digital-spacing-reference> a schema:PropertyValue ;
        dct:source "Vendored CC BY 4.0 urodele salamander hindlimb skeletal micro-CT specimen (datasets/mechanochemical_chondrogenesis/salamander_limb_cartilage_specimen.jpg)" ;
        schema:value "41.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-simulated-urodele-forelimb-autopod-m-4-condensation-wavelength-vs-analytical-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated urodele forelimb autopod (m=4) condensation wavelength vs analytical lambda_c = 6.5472 dimensionless limb width units" ;
        dct:description "relative wavelength error = 0.000%, spacing CV = 0.0000" ;
        schema:measurementTechnique "1D coupled cell-ECM PDE solver peak-to-peak spacing across W=4*lambda_c (n=4 digits, CV=0.0000)" ;
        schema:name "simulated urodele forelimb autopod (m=4) condensation wavelength vs analytical lambda_c" ;
        schema:unitText "dimensionless limb width units" ;
        schema:value "6.5472" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-simulated-urodele-forelimb-autopod-m-4-condensation-wavelength-vs-analytical-lambda-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-simulated-urodele-forelimb-autopod-m-4-condensation-wavelength-vs-analytical-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Oster, Murray & Maini (1985) J. Embryol. Exp. Morph. 89:93-112 analytical wavelength lambda_c = 2*pi/k_c" ;
        schema:value "6.5472" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


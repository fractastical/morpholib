<https://w3id.org/probknow/resource/claim/morphoeval-oster-mechanochemical-chondrogenesis> a pk:Claim ;
    rdfs:label "Oster, Murray & Harris (1983) / Oster, Murray & Maini (1985) mechanochemical limb chondrogenesis (Ambystoma mexicanum & Oedipina ecuatoriana urodele salamander limb cartilage)",
        "Oster, Murray & Harris (1983) / Oster, Murray & Maini (1985) mechanochemical limb chondrogenesis faithfully reproduces Ambystoma mexicanum & Oedipina ecuatoriana urodele salamander limb cartilage morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/oster-mechanochemical-chondrogenesis-1>,
        <https://w3id.org/probknow/resource/math-law/oster-mechanochemical-chondrogenesis-2>,
        <https://w3id.org/probknow/resource/math-law/oster-mechanochemical-chondrogenesis-3> ;
    dct:description "The simulation script(s) 1983-oster-mechanochemical-chondrogenesis.py implement the cited source model as published and produce forms that match real Ambystoma mexicanum & Oedipina ecuatoriana urodele salamander limb cartilage specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 58.0/100, audit 2026-10-19-mechanochemical-chondrogenesis-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/317bc3c/1983-oster-mechanochemical-chondrogenesis.py> ;
    schema:about "Ambystoma mexicanum & Oedipina ecuatoriana urodele salamander limb cartilage" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/1983-oster-mechanochemical-chondrogenesis.py; output: docs/media/mechanochemical_chondrogenesis_comparison.png; organism: Ambystoma mexicanum & Oedipina ecuatoriana urodele salamander limb cartilage; checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 909c74c2382cbfcf862f8ea9a8529469edfc30728d6d46f34f2904fe31ee564f; artifact_sha256: cae9696ef2245adac8562044612d7f3410d85abb23870b25f25efdbd2d1f2185; input_dataset_sha256: {datasets/mechanochemical_chondrogenesis/mechanochemical_chondrogenesis_reference.json=fc4767274ebd8ea8..., datasets/mechanochemical_chondrogenesis/salamander_limb_cartilage_specimen.jpg=8030c8291c3a6d5b..., datasets/mechanochemical_chondrogenesis/scout_manifest.json=cb9d73c33c4113e4...}" ;
    pk:derivedFromPaper <https://doi.org/10.1007/978-1-4615-6983-1_6>,
        <https://doi.org/10.1093/imammb/1.1.51>,
        <https://doi.org/10.1242/dev.78.1.83>,
        <https://doi.org/10.1242/dev.89.1.93> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-morphometric-validation>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-overall>,

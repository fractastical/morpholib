        <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-mechanochemical-chondrogenesis-audit-oster-mechanochemical-chondrogenesis-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-mechanochemical-chondrogenesis-audit-oster-mechanochemical-chondrogenesis-2>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-mechanochemical-chondrogenesis-audit-oster-mechanochemical-chondrogenesis-3>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-mechanochemical-chondrogenesis-audit-oster-mechanochemical-chondrogenesis-4>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-mechanochemical-chondrogenesis-audit-oster-mechanochemical-chondrogenesis-5> ;
    pk:hypothesisType "Mechanochemical Cell-Traction & Viscoelastic ECM Chondrogenesis PDE (Oster-Murray-Harris 1983 / Oster-Murray-Maini 1985)" ;
    pk:weightOfEvidence 5.8e-01 .


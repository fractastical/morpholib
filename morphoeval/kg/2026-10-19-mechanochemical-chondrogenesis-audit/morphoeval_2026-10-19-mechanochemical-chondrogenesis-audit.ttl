<https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Oster, Murray & Harris (1983) / Oster, Murray & Maini (1985) mechanochemical limb chondrogenesis — Model fidelity to source: 60/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Implements the Oster-Murray-Maini (1985) coupled cell density n(x,t) and viscoelastic ECM displacement u(x,t) PDE system with biharmonic cell diffusion and contact-inhibited traction tau*n^2/(1+lam*n^2), but the initial low-diffusion parameter set (D_1=0.08, D_2=0.0025) leaves tau=0.85 weakly unstable unless calibrated to the exact marginal stability curve tau_c = 1.2776." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "1983-oster-mechanochemical-chondrogenesis.py L108–L178: Linearized mechanochemical dispersion relation and critical traction threshold tau_c <https://github.com/fractastical/morpholib/blob/317bc3c/1983-oster-mechanochemical-chondrogenesis.py#L108-L178>" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity-1> ;
    pk:hasScore 6e-01 ;
    pk:hasVerdict "mostly faithful" .


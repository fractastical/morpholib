sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-057> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-057-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-057-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Fig. 403 human scapulae — Pass 2 — MorphoEval overall 74.3/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Pass 2 adds KS residual test vs identity control, 15-setting n_semi×lambda sweep, shuffled-landmark null, Commons specimen bone-fraction CV, and explicit mixed verdict (A→B supported on outline IoU; A→C not improved over identity with automatic landmarks). Overall 74.3/100 (faithfulness 71.3, reproducibility 81.2); rubric morphoeval 0.1.0; checkpoint commit a8bae15d5; environment: python 3.12. Dimension assessments: Model fidelity to source 76, Morphological realism / specimen match 72, Parameter expressivity 62, Morphometric validation 70, Source and data traceability 86, Code-to-model traceability 80, Reproducibility package 78. Output judged: docs/media/t1917_057_on_the_theory_of_transformatio_comparison.png: rendered output of thompson/claims/t1917-057_on-the-theory-of-transformations.py at a8bae15d5, image/png, 148102 B, 1440×960 px, artifact_sha256 948ac31a2b981fe36c648699423b73b2bc2dce9fd28da7aae5df05270d46963f (sha256 948ac31a2b981fe36c648699423b73b2bc2dce9fd28da7aae5df05270d46963f), spec_fingerprint 623b1de0b4ed7c847d9d960d4ae952198b27d7e7df34ef7cfb25eedd8e1212f4. Dual provenance: spec_fingerprint: 623b1de0b4ed7c847d9d960d4ae952198b27d7e7df34ef7cfb25eedd8e1212f4; artifact_sha256: 948ac31a2b981fe36c648699423b73b2bc2dce9fd28da7aae5df05270d46963f; input_dataset_sha256: {datasets/thompson_1917/t1917-057/ongrowthform1917thom_p769_leaf0788_fig403.jpg=7c57adb9fe06c75c..., datasets/thompson_1917/t1917-057/t1917_057_on_the_theory_of_transformatio_reference.json=f3c362f5577ce294..., morphoeval/lean/loops/Thompson1917_T1917_057.lean=d4758b591418639c...}. Supersedes audit: 2026-10-28-t1917-057-on-the-theory-of-transformatio-audit." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:hasScore "0.743"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

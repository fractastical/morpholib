<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-057-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-057-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-057-3> .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-057-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equidistant / linear coordinate interpolation (E2/E6)" ;
    dct:description "Operational meaning of Thompson's grid interpolation between Dwight scapula forms | Variables: a,b: corresponding coordinates on forms A and B; k: stage 0..4" ;
    dct:source "Thompson (1917) On Growth and Form, Ch. XVII p. 769 Fig. 403" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a8bae15d5/morphoeval/lean/loops/Thompson1917_T1917_057.lean>,
        <https://github.com/fractastical/morpholib/blob/a8bae15d5/thompson/claims/t1917-057_on-the-theory-of-transformations.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "interp4(k,a,b) = (4-k)a + kb = 4 phi_{k/4}(a) when phi(a)=b" ;
    pk:hypothesisType "geometric — Thompson (1917) coordinate method: human scapulae after Dwight (Fig. 403)" ;
    pk:leanTheorem "MathOfBiology.Loop_246.interp_endpoints_and_equidistant" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-057-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Similarity equivariance of interpolated coordinates" ;
    dct:description "Procrustes frame independence of the coordinate construction | Variables: c: scale; d: translation" ;
    dct:source "Thompson (1917) Ch. XVII; Gower (1975) Procrustes analysis" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a8bae15d5/morphoeval/lean/loops/Thompson1917_T1917_057.lean>,
        <https://github.com/fractastical/morpholib/blob/a8bae15d5/thompson/claims/t1917-057_on-the-theory-of-transformations.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "interp4(k, ca+d, cb+d) = c interp4(k,a,b) + 4d" ;
    pk:hypothesisType "geometric — Thompson (1917) coordinate method: human scapulae after Dwight (Fig. 403)" ;
    pk:leanTheorem "MathOfBiology.Loop_246.interp_similarity_equivariant" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-057-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "No-fold along a coordinate line (E1, 1-D)" ;
    dct:description "Non-folded coordinate grids remain order-preserving under interpolation | Variables: ordered grid coordinates on baseline and target" ;
    dct:source "Thompson (1917) Ch. XVII coordinate diagrams" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a8bae15d5/morphoeval/lean/loops/Thompson1917_T1917_057.lean>,
        <https://github.com/fractastical/morpholib/blob/a8bae15d5/thompson/claims/t1917-057_on-the-theory-of-transformations.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "a1<a2 and b1<b2 => interp4(k,a1,b1) < interp4(k,a2,b2)" ;
    pk:hypothesisType "geometric — Thompson (1917) coordinate method: human scapulae after Dwight (Fig. 403)" ;
    pk:leanTheorem "MathOfBiology.Loop_246.interp_no_fold" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


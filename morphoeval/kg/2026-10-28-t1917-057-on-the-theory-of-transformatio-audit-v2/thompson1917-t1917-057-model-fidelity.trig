sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-057> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-057-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-057-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Fig. 403 human scapulae — Pass 2 — Model fidelity to source: 76/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Pass 2 KS + sweep; still no line-by-line grid digitisation." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-model-fidelity-1> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-057_on-the-theory-of-transformations.py L218–L235" ;
        dct:description "ks_residual_vs_control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a8bae15d5/thompson/claims/t1917-057_on-the-theory-of-transformations.py#L218-L235> .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediation)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/gemini-4-argon> .
}


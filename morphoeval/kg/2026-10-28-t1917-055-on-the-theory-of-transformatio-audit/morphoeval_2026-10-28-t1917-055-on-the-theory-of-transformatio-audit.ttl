<https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-055-source-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Thompson (1917) Figs. 394-400: rhinoceros and allied skulls by coordinate-grid transformation (Osborn) — Source and data traceability: 87/100" ;

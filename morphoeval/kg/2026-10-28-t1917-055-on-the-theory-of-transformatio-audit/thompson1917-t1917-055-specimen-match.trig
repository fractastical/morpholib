sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-055> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-055-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-055-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Figs. 394-400: rhinoceros and allied skulls by coordinate-grid transformation (Osborn) — Morphological realism / specimen match: 62/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Side-by-side figure with Fig. 394/395 crops, detected grid landmarks, primary predicted-vs-drawn overlay, secondary Procrustes bar chart, and control bar chart (TPS/identity/affine only in Pass 1). Predicted Aceratherium outline is visibly deformed from Hyrachyus. Deductions: correspondences are automatic; secondary rabbit/horse panels are coarse; Ceratotherium MNHN photograph is pinned but not segmented in Pass 1." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "thompson/claims/t1917-055_on-the-theory-of-transformations.py L326–L373: grid_landmarks + match_grids: automatic peak matching, not hand labels <https://github.com/fractastical/morpholib/blob/530b3b50c/thompson/claims/t1917-055_on-the-theory-of-transformations.py#L326-L373>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-specimen-match-2> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_055_on_the_theory_of_transformatio_comparison.png (generated output)" ;
        dct:description "six-panel comparison (Pass 1): grids, primary overlay, secondary bars, three-way control bars — docs/media/t1917_055_on_the_theory_of_transformatio_comparison.png: rendered output of thompson/claims/t1917-055_on-the-theory-of-transformations.py at 530b3b50c, image/png, 540693 B, 1980×1100 px, artifact_sha256 65d3271d99b1aa5c2c476ae8f90ab25d1dfc51663e05b92ff0b626a382f24254 (sha256 65d3271d99b1aa5c2c476ae8f90ab25d1dfc51663e05b92ff0b626a382f24254), spec_fingerprint 1799c9e22b84705ed0af5fe44b5529c9ffab5f336a64446d6582253a48d2e8c1" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-055_on-the-theory-of-transformations.py L628–L697" ;
        dct:description "render_comparison: primary TPS outline vs drawn Aceratherium; secondary Procrustes distances" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/530b3b50c/thompson/claims/t1917-055_on-the-theory-of-transformations.py#L628-L697> .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://ai.google.dev> .
}


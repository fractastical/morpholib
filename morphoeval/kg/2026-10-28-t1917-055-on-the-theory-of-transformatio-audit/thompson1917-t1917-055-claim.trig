sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-055> a pk:Claim ;
        rdfs:label "Thompson (1917) Figs. 394-400: rhinoceros and allied skulls by coordinate-grid transformation (Osborn) faithfully reproduces Hyrachyus agrarius, Aceratherium tridactylum, Titanotherium, tapir, horse, rabbit (diagrammatic skulls after Osborn; Thompson pp. 760-764) morphology" ;
        dct:description "The simulation script(s) thompson/claims/t1917-055_on-the-theory-of-transformations.py implement the cited source model as published and produce forms that match real Hyrachyus agrarius, Aceratherium tridactylum, Titanotherium, tapir, horse, rabbit (diagrammatic skulls after Osborn; Thompson pp. 760-764) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-055_on-the-theory-of-transformations.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-055_on-the-theory-of-transformations.py; output: docs/media/t1917_055_on_the_theory_of_transformatio_comparison.png; organism: Hyrachyus agrarius, Aceratherium tridactylum, Titanotherium, tapir, horse, rabbit (diagrammatic skulls after Osborn; Thompson pp. 760-764); environment: python 3.12, numpy 1.26.4, scipy 1.x (pip, requirements.txt lower bound >=1.7), scikit-image >=0.19, matplotlib >=3.3, Pillow >=8.0, lean 4.35.0 (elan stable); claim_boundary: [reported_in_source: Fig. 394 Hyrachyus skull with rectangular Cartesian grid; Fig. 395 Aceratherium in a deformed grid (p. 760-761) | occipital Aceratherium variants related by conformal transformations (Fig. 396, p. 762) | extensions to Titanotherium, tapir, horse, and rabbit by the same method (Figs. 397-400, pp. 763-764) | methodological claim that allied skulls differ by smooth coordinate transformation of a common diagram; reconstructed_in_script: phi as a thin-plate spline on automatically matched grid peaks (not digitised grid ink line-by-line) | skull outlines from largest connected component + arc-length semilandmarks | identity and affine-only controls; Procrustes distance as the sole quantitative fit statistic in Pass 1; transfer_boundary: Thompson's hand-placed grid correspondences are approximated by greedy NN on normalized bounding boxes | affine beating TPS on the primary pair weakens the claim that a non-affine TPS grid is necessary for Aceratherium; does_not_claim: that automatic grid matching equals Thompson's anatomical node pairing | that modern 3D geometric-morphometric datasets validate the rabbit/horse panels (Leporidae cache is a labelled mismatch) | that the Ceratotherium photograph (vendored) was analysed in Pass 1]; other sources: On Growth and Form (Ch. XVII, On the Theory of Transformations, pp. 760-764, Figs. 394-400, skulls after Osborn) <https://archive.org/details/ongrowthform1917thom>, The Extinct Rhinoceroses of North America <https://archive.org/details/extinctrhinocero01osbo>, Modern Leporidae skull GM cache (portfolio JSON) <https://github.com/fractastical/morpholib/blob/main/thompson/portfolio/results/leporidae_skulls.json>" ;
        pk:derivedFromPaper <https://doi.org/10.1109/34.24792> .
    <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-055_on-the-theory-of-transformations.py> a schema:SoftwareSourceCode ;
        rdfs:label "thompson/claims/t1917-055_on-the-theory-of-transformations.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://archive.org/details/extinctrhinocero01osbo>,
            <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1109/34.24792>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/portfolio/results/leporidae_skulls.json> .
    <https://archive.org/details/extinctrhinocero01osbo> dct:date "1898"^^xsd:gYear ;
        dct:title "The Extinct Rhinoceroses of North America" .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form (Ch. XVII, On the Theory of Transformations, pp. 760-764, Figs. 394-400, skulls after Osborn)" .
    <https://doi.org/10.1109/34.24792> dct:date "1989"^^xsd:gYear ;
        dct:title "Principal warps: thin-plate splines and the decomposition of deformations" .
    <https://github.com/fractastical/morpholib/blob/main/thompson/portfolio/results/leporidae_skulls.json> dct:title "Modern Leporidae skull GM cache (portfolio JSON)" .
}


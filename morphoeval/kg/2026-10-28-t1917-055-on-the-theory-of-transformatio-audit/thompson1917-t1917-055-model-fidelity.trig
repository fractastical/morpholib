sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-055> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-055-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-055-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Figs. 394-400: rhinoceros and allied skulls by coordinate-grid transformation (Osborn) — Model fidelity to source: 72/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "E2/E6 (equidistant interpolation), E4 (TPS), E5 (affine) and E7 (best-fit stage) are implemented as in the reference JSON and mirrored by eight Lean theorems in Loop_244 (endpoints/equidistance, similarity equivariance, no-fold along grid lines, affine determinants). Deductions: Thompson's drawn grid lines are not digitised; phi is fit on peak-picked intersections; the primary pair favours affine over TPS on Procrustes distance; E1 (det D phi > 0) is proved in Lean but not checked numerically on the fitted TPS in Pass 1." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-055_on-the-theory-of-transformations.py L448–L472: primary Procrustes: TPS 0.370 < identity 0.377 but affine 0.360 < TPS; no Jacobian check in Pass 1 run <https://github.com/fractastical/morpholib/blob/530b3b50c/thompson/claims/t1917-055_on-the-theory-of-transformations.py#L448-L472>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-model-fidelity-2> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-055_on-the-theory-of-transformations.py L184–L227" ;
        dct:description "tps_fit/tps_apply (E4), affine_fit/affine_interp_matrix (E5), interp_stage (E2/E6), best_fit_t (E7)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/530b3b50c/thompson/claims/t1917-055_on-the-theory-of-transformations.py#L184-L227> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_055.lean L16–L102" ;
        dct:description "interp4, interpDet; eight theorems compile under Lean 4.35.0 with 0 sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/530b3b50c/morphoeval/lean/loops/Thompson1917_T1917_055.lean#L16-L102> .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://ai.google.dev> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://archive.org/details/extinctrhinocero01osbo>,
            <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1109/34.24792>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/portfolio/results/leporidae_skulls.json> .
    <https://archive.org/details/extinctrhinocero01osbo> dct:date "1898"^^xsd:gYear ;
        dct:title "The Extinct Rhinoceroses of North America" .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form (Ch. XVII, On the Theory of Transformations, pp. 760-764, Figs. 394-400, skulls after Osborn)" .
    <https://doi.org/10.1109/34.24792> dct:date "1989"^^xsd:gYear ;
        dct:title "Principal warps: thin-plate splines and the decomposition of deformations" .
    <https://github.com/fractastical/morpholib/blob/main/thompson/portfolio/results/leporidae_skulls.json> dct:title "Modern Leporidae skull GM cache (portfolio JSON)" .
}


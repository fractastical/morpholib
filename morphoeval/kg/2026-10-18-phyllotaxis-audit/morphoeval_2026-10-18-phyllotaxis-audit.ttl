    skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> a skos:Concept,
        pk:Concept ;
    rdfs:label "Parameter expressivity" ;
    dct:description "[faithfulness, weight 10/100] Does each morphospace parameter visibly and monotonically control the feature of form it is supposed to control across its stated range?" ;

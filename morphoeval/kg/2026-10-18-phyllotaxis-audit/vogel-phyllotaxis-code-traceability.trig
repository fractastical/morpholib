sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-18-phyllotaxis-audit-vogel-phyllotaxis-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis — Code-to-model traceability: 66/100" ;
        rdfs:comment "Functions are clearly documented against paper sections, but the independent assessor caught three code-to-label mismatches: Panel E legend says initial angles 155/122/104 deg while code passes 175/130/99.8 deg; Panel C labels Sunflower 171 as (29,47) whereas JSON records (47,76); and Panel C CV labels were hardcoded rather than formatted from compute_packing_metrics(). Evidence: 1979-vogel-phyllotaxis.py L659–L665: Hardcoded CV strings and Sunflower 171 parastichy pair mismatch <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L659-L665>; 1979-vogel-phyllotaxis.py L729–L738: Panel E legend initial angles vs function call arguments <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L729-L738>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-vogel-phyllotaxis-code-traceability> ;
        pk:hasProbability "0.66"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-vogel-phyllotaxis-code-traceability> rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis (1979-vogel-phyllotaxis.py, docs/media/vogel_phyllotaxis_growth.gif, vogel_phyllotaxis_metrics.csv) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Helianthus annuus (sunflower capitulum)" ;
        dct:identifier "morphoeval/0.1.0/code-traceability" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0024>,
            <https://doi.org/10.1016/0025-5564(79)90080-4>,
            <https://doi.org/10.1098/rsos.160091>,
            <https://doi.org/10.1103/PhysRevLett.68.2098> .
    <https://doi.org/10.1006/jtbi.1996.0024> dct:date "1996"^^xsd:gYear ;
        dct:title "Phyllotaxis as a Dynamical Self Organizing Process Part I: The Spiral Modes Resulting from Time-Periodic Iterations" .
    <https://doi.org/10.1016/0025-5564(79)90080-4> dct:date "1979"^^xsd:gYear ;
        dct:title "A better way to construct the sunflower head" .
    <https://doi.org/10.1098/rsos.160091> dct:date "2016"^^xsd:gYear ;
        dct:title "Novel Fibonacci and non-Fibonacci structure in the sunflower: results of a citizen science experiment" .
    <https://doi.org/10.1103/PhysRevLett.68.2098> dct:date "2098"^^xsd:gYear ;
        dct:title "Phyllotaxis as a physical self-organized growth process" .
}


<https://w3id.org/probknow/resource/evidence/2026-10-19-cortical-gyrification-folding-audit-v3-richman-cortical-gyrification-buckling-13> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "3D GSH subcritical null: Y-junctions and GI_3D at GW22 (g = 1.12 <= g_c)" ;
    dct:description "sigma(k) = -(1 - k^2/k_c^2)^2 <= 0 for all k when eps = 0, so the seeded white noise decays and no sulcal network forms (0 junctions, GI_3D = 1)" ;
    dct:source "Tallinen et al. (2014) PNAS Fig. 2 lissencephalic baseline (g <= g_c); Lean `MathOfBiology.Loop_061.swift_hohenberg_fastest_mode`" ;

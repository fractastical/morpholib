    <https://doi.org/10.1007/BF00304699> dct:date "1988"^^xsd:gYear ;
        dct:title "The human pattern of gyrification in the cerebral cortex" .
    <https://doi.org/10.1038/nmat4202> dct:date "2015"^^xsd:gYear ;
        dct:title "Curvature-induced symmetry breaking determines elastic surface patterns" .
    <https://doi.org/10.1038/nphys3632> dct:date "2016"^^xsd:gYear ;
        dct:title "On the growth and form of cortical convolutions" .
    <https://doi.org/10.1073/pnas.1406015111> dct:date "2014"^^xsd:gYear ;
        dct:title "Gyrification from constrained cortical expansion: Synthesis of physical and numerical models" .
    <https://doi.org/10.1073/pnas.200033797> dct:date "2000"^^xsd:gYear ;
        dct:title "Measuring the thickness of the human cerebral cortex from magnetic resonance images" .
    <https://doi.org/10.1103/RevModPhys.65.851> dct:date "1993"^^xsd:gYear ;
        dct:title "Pattern formation outside of equilibrium" .
    <https://doi.org/10.1126/science.1145181> dct:date "1975"^^xsd:gYear ;
        dct:title "Mechanical model of brain convolutional development" .
    <https://doi.org/10.1126/science.aaa9101> dct:date "2015"^^xsd:gYear ;
        dct:title "Cortical folding scales universally with surface area and thickness, not number of neurons" .

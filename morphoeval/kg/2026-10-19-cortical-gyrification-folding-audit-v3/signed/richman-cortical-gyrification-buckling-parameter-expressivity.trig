sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-richman-cortical-gyrification-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py L760–L802" ;
        dcterms:description "Regional thickness-gradient sweep over beta with emergent anterior/posterior wavelength ratio and regression against h_ant/h_post" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L760-L802> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py L805–L958" ;
        dcterms:description "Fetal GW22-GW38, 11-species and 4-condition pathology/ablation sweeps" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L805-L958> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 061 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Richman et al. (1975) & Tallinen et al. (2014, 2016) neo-Hookean constrained cortical expansion and sulcal creasing instability, with a Pass 3 3D hemispheric Swift-Hohenberg surface surrogate — Parameter expressivity: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Spans 5 fetal stages, 11 species, 4 pathology/ablation conditions (L805-958) and, new in Pass 3, a 4-point anterior-posterior thickness-gradient sweep beta in {0, 0.1, 0.2, 0.3} (L760-802) whose emergent regional wavelength ratio tracks h_ant/h_post (slope 1.006, r = 1.0000), plus `--subdivisions` and `--skip-3d` (L1854-1855). Deductions: `--growth-g/--h-cortex/--mu-ratio/--R-brain` reach only the 2D fetal evaluation (L1867-1877) and not the 3D surrogate (L1879-1882), so the new mechanism cannot be explored from the CLI (-6); the lissencephaly condition varies g, not h, so the thickness axis is not exercised in the pathology sweep (-4); eps_scale and g2 are fixed in the JSON with no sweep across the Stoop dimple/labyrinth boundary (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1975-richman-cortical-gyrification-buckling.py L1850–L1893: CLI: --skip-3d, --subdivisions, --seed reach the 3D surrogate; --growth-g/--h-cortex/--mu-ratio/--R-brain overrides are passed only to render_comparison_figure <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L1850-L1893>",
            "datasets/cortical_gyrification_folding/cortical_gyrification_folding_reference.json L245–L254: lissencephaly_thick_cortex has g = 1.14 < g_c = 1.18, so h = 6.50 mm never influences the result <https://github.com/fractastical/morpholib/blob/45670cb8/datasets/cortical_gyrification_folding/cortical_gyrification_folding_reference.json#L245-L254>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-parameter-expressivity-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-richman-cortical-gyrification-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py L162–L189" ;
        dcterms:description "Laws 1-3: growth excess, cube-root wavelength, Gyrification Index as closed-form functions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L162-L189> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py L515–L576" ;
        dcterms:description "Generalized Swift-Hohenberg relaxation on the ellipsoid surface with imposed k_c(x), Lyapunov energy, semi-implicit SuperLU step, exact subcritical null" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L515-L576> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py L376–L388" ;
        dcterms:description "Honesty note: not a tetrahedral FEM, depth imported, residual carried to Pass 4" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L376-L388> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_061_cortical_gyrification_folding.lean L99–L159" ;
        dcterms:description "3 new Pass 3 theorems (GSH fastest mode, regional wavelength tracks thickness, 3D crease-wall GI) alongside the 3 Pass 2 theorems; 0 sorrys, lean exits 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_061_cortical_gyrification_folding.lean#L99-L159> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Richman et al. (1975) & Tallinen et al. (2014, 2016) neo-Hookean constrained cortical expansion and sulcal creasing instability, with a Pass 3 3D hemispheric Swift-Hohenberg surface surrogate — Model fidelity to source: 78/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Laws 1-3 (growth excess Delta_g = max(0, g - g_c), lambda = 2 pi h (mu_c / 3 mu_s)^(1/3), GI = 1 + 2 N d / P_hull; L162-189) are Richman's and Zilles's and are machine-checked. The Pass 3 GSH surrogate (L515-576) is a recognised reduced model for film-on-curved-substrate wrinkling (Stoop 2015), its Lyapunov energy (L506-512) decreases in every supercritical stage, its uniform mode is damped and its subcritical null is exact; the cotangent Laplace-Beltrami operator passes kernel, area and l = 1 eigenvalue checks (self-test #9). Deductions: the 2D coronal \"neo-Hookean\" solver is not a buckling model — n_sulci_target = round(P_hull / lambda_theory) (L253), gi_target = 1 + 1.603 dg^0.88 thinness_boost (L266-267) and the cusp profile u_eq (L272-276) are prescribed, and the energy (L290-314) penalises deviation from u_eq, so L-BFGS-B denoises a target rather than selecting a mode (-10); the 3D surrogate imposes k_c(x) and imports depth from the 2D solver (L735-736), so neither wavelength nor amplitude is emergent in 3D and the requested volumetric FEM is absent (-6); the Lissencephaly control has g = 1.14 < g_c so h = 6.5 mm is never exercised — Richman's thick-cortex prediction (longer wavelength) is not tested (-3); eps_scale and g2_curvature_coeff are unsourced (-3); the honesty note (L376-388) and the Lean coverage of all 6 laws prevent a larger deduction." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1975-richman-cortical-gyrification-buckling.py L253–L276: 2D solver prescribes n_sulci_target from P_hull/lambda_theory, gi_target from unsourced constants 1.603/0.88/0.22 and a cusp profile u_eq before minimisation <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L253-L276>",
            "1975-richman-cortical-gyrification-buckling.py L290–L314: Energy is a penalty on (u - u_eq) plus bending/slope differences from u_eq: L-BFGS-B relaxes toward the prescribed profile <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L290-L314>",
            "1975-richman-cortical-gyrification-buckling.py L735–L736: 3D crease-wall GI uses mean_sulcal_depth_mm from the 2D shell of the same stage — depth is not emergent in 3D <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L735-L736>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-model-fidelity-4> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 061 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


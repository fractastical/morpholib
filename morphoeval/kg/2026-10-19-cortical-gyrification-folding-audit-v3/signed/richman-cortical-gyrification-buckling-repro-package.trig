sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-richman-cortical-gyrification-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Richman et al. (1975) & Tallinen et al. (2014, 2016) neo-Hookean constrained cortical expansion and sulcal creasing instability, with a Pass 3 3D hemispheric Swift-Hohenberg surface surrogate — Reproducibility package: 85/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`self_test()` (L1746-1847) runs 12 checks in 13 s: SHA-256 of 5 files, JSON parity, ablation invariants, fetal monotonicity, 11-species collapse, pathology ordering, specimen segmentation, 2D determinism, and the Pass 3 Laplace-Beltrami sanity (#9), 3D GSH null/Lyapunov/wavelength/junction/GI ordering (#10), gradient sweep (#11) and bitwise 3D determinism (#12); default render is 11.7 s. Deductions: `scikit-image` is now a hard runtime dependency (`from skimage.morphology import skeletonize`, L620, imported lazily inside `count_sulcal_y_junctions`) and is NOT listed in `requirements.txt` — a fresh `pip install -r requirements.txt` environment fails at the 3D stage and in self-test #10 (-7); the self-test tolerances for the 3D stage (8% wavelength, |GI_3D - 2.56| < 0.15) are loose relative to the reported agreement (-2); `.gitignore` excludes `docs/media/*.png`, so neither the regenerated comparison PNG nor the new 3D PNG is tracked and the GIF content is byte-identical to Pass 2 (-3); the exact environment is recorded here but there is no lock file for this script (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "1975-richman-cortical-gyrification-buckling.py L620–L631: Lazy import of skimage.morphology.skeletonize — new scikit-image dependency not declared in requirements.txt <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L620-L631>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-repro-package-2> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py L1746–L1847" ;
        dcterms:description "12-check self_test() incl. Pass 3 Laplace-Beltrami sanity, GSH null/Lyapunov/junction ordering, gradient sweep and bitwise 3D determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L1746-L1847> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py L1809–L1823" ;
        dcterms:description "3D self-test tolerances: 8% wavelength, |GI_3D - 2.56| < 0.15, >= 30 junctions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L1809-L1823> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 061 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


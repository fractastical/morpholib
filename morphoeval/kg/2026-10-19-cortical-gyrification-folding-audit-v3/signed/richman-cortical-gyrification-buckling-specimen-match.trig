sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-richman-cortical-gyrification-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Richman et al. (1975) & Tallinen et al. (2014, 2016) neo-Hookean constrained cortical expansion and sulcal creasing instability, with a Pass 3 3D hemispheric Swift-Hohenberg surface surrogate — Morphological realism / specimen match: 82/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The SHA-256-locked coronal specimen is segmented into gray ribbon, white core, hull and 52 sulcal troughs (L964-1058; GI_specimen 2.8115, CV 0.32) and shown in Panel E; the new 3D figure (`render_surface_3d_figure`, L1352-1482) shows a GW26 dimple field becoming a GW38 labyrinth with Y-junctions on an ellipsoidal hemisphere, which is the qualitative Stoop/Tallinen picture, and GI_3D 2.604 lies within 2% of Zilles's 2.56. Deductions: the specimen is a single coronal section compared with a whole-hemisphere mean (-3); P_pial is approximated as P_hull + 2 sum(depths) from a distance transform rather than traced (L1025-1026), and segmentation thresholds (0.86, 0.08, 14 px, 52nd and 76th percentiles, 62 px band) are untraced tuning constants with a hard-coded fallback spacing [34, 36, 35] (L991-1018, L1034) (-5); the 3D geometry is an ad-hoc ellipsoid, not an MRI template, and no fetal MRI/sulcal-graph image is compared against the 3D planform (-6); the 11-species GI match (r = 0.9985) rests on the prescribed 2D solver (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1975-richman-cortical-gyrification-buckling.py L991–L1034: Untraced thresholds 0.86/0.08/14 px/52nd/76th percentile/62 px band and fallback spacings [34, 36, 35]; P_pial approximated from distance-transform depths <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L991-L1034>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-specimen-match-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-specimen-match-5> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py L964–L1058" ;
        dcterms:description "Coronal specimen segmentation: tissue mask, convex hull, white-matter core, DoG sulcal trough detection, GI_specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L964-L1058> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py L1352–L1482" ;
        dcterms:description "3D surface figure: GW26 dimples -> GW38 labyrinth with Y-junction overlay, regional-gradient panel" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L1352-L1482> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/cortical_gyrification_folding_comparison.png (generated output)" ;
        dcterms:description "6-panel synthesis figure (v3 suptitle) incl. specimen Panel E; Panels B/F overlay lambda_sim on formula-generated lambda_obs — docs/media/cortical_gyrification_folding_comparison.png: rendered output of 1975-richman-cortical-gyrification-buckling.py at 45670cb8, image/png, 821293 B, 2104×1452 px, artifact_sha256 ca86dd76e3d0c81460ea4a15d6e3c54f90b997c4272caa3b12ede091364d7413 (sha256 ca86dd76e3d0c81460ea4a15d6e3c54f90b997c4272caa3b12ede091364d7413), spec_fingerprint 13499943306506233e29ef0e44d9eb95a08cb36c62618ec286f2346b2d38f941" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/cortical_gyrification_folding_surface_3d.png (generated output)" ;
        dcterms:description "New Pass 3 figure: 3D hemispheric GSH planform at GW22/26/38, Y-junction skeleton, thickness-gradient sweep — docs/media/cortical_gyrification_folding_surface_3d.png: rendered output of 1975-richman-cortical-gyrification-buckling.py at 45670cb8, image/png, 1657333 B, 2319×1368 px, artifact_sha256 8058ad0a707289a2aeaf877fd96356766f96cdb8776c683398711d8345ed261a (sha256 8058ad0a707289a2aeaf877fd96356766f96cdb8776c683398711d8345ed261a), spec_fingerprint 13499943306506233e29ef0e44d9eb95a08cb36c62618ec286f2346b2d38f941" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-specimen-match-5> a pk:EvidenceItem ;
        rdfs:label "docs/media/cortical_gyrification_folding_growth.gif (generated output)" ;
        dcterms:description "Growth GIF regenerated; content unchanged from Pass 2 (2D coronal only) — docs/media/cortical_gyrification_folding_growth.gif: rendered output of 1975-richman-cortical-gyrification-buckling.py at 45670cb8, image/gif, 121654 B, 1050×482 px, 5 frames, artifact_sha256 5dee13ba0dd09e7072a71314a31deb90245ae2a58d5cbf6390b408aedde00d83 (sha256 5dee13ba0dd09e7072a71314a31deb90245ae2a58d5cbf6390b408aedde00d83), spec_fingerprint 13499943306506233e29ef0e44d9eb95a08cb36c62618ec286f2346b2d38f941" .


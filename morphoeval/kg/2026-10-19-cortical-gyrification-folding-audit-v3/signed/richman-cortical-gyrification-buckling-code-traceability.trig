    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py L526–L538" ;
        dcterms:description "relax_surface_swift_hohenberg docstring: Stoop 2015 Eq. 1, non-dimensionalisation, Lean theorem reference" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L526-L538> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/richman-cortical-gyrification-buckling.yaml L37–L125" ;
        dcterms:description "Equations 1-6 registered with single-range code_locus pins (secondary ranges in code_locus_secondary); stale Pass 1 loci corrected" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/math_kg_loops/richman-cortical-gyrification-buckling.yaml#L37-L125> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Richman et al. (1975) & Tallinen et al. (2014, 2016) neo-Hookean constrained cortical expansion and sulcal creasing instability, with a Pass 3 3D hemispheric Swift-Hohenberg surface surrogate — Code-to-model traceability: 84/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module header maps Laws 1-6 to their papers and to the 6 Lean theorems by name (L34-74); every Pass 3 function carries a docstring naming the equation and source (GSH Eq. 1 of Stoop 2015 at L526-538, Lyapunov functional at L507-509, Fischl & Dale thickness range, honeycomb bound), the honesty note (L376-388) states exactly what is and is not emergent, and the math-KG YAML registers equations 4-6 with single-range `code_locus` pins. Deductions: the GI growth law is written with exponent 0.85 in Panel C and the GIF (L1175, L1532) but 0.88 in the solver (L267) — the plotted curve is not the curve the solver uses (-5); constants 1.603 / 0.88 / 0.22 / 0.65 / 0.18 / 2.8 / 4.2 in the 2D solver (L265-288) are uncited (-5); eps_scale 0.5 and g2 0.35 are documented but not derived (-3); the Y- junction raster ignores the polar caps (|lat| > 60 deg) and the longitude wrap of `ndi.label`, which is not stated in the docstring (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1975-richman-cortical-gyrification-buckling.py L1175–L1175: Panel C GI law uses exponent 0.85 while the solver (L267) uses 0.88 <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L1175-L1175>",
            "1975-richman-cortical-gyrification-buckling.py L1532–L1532: GIF GI curve also uses exponent 0.85 — inconsistent with the solver <https://github.com/fractastical/morpholib/blob/45670cb8/1975-richman-cortical-gyrification-buckling.py#L1532-L1532>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-code-traceability-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 061 Pass 3 Phase B Assessor)" ;

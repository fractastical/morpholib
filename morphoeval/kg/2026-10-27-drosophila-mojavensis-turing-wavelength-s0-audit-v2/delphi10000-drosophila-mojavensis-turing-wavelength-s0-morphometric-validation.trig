            pk:EvidenceItem ;
        rdfs:label "dispersion_rmse = 0.02405 1/time" ;
        schema:measurementTechnique "RMSE of the same σ(k) pairs" ;
        schema:name "dispersion_rmse" ;
        schema:unitText "1/time" ;
        schema:value "0.02405" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        schema:value "0.0" .

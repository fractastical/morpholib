            pk:EvidenceItem ;
        rdfs:label "neumann_stripe_wavelength_um = 2.41388 µm" ;
        schema:measurementTechnique "no-flux radial-FFT wavelength; the periodic small-grid run falls in the same bin, so the reference is the catalog 2.38 µm rather than that identical bin" ;

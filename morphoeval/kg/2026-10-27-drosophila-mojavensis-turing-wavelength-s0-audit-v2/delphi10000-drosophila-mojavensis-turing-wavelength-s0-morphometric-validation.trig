            pk:EvidenceItem ;
        rdfs:label "neumann_pattern_std = 0.99918 1" ;
        schema:measurementTechnique "saturated activator std on the no-flux patch versus the periodic patch at the same diffusivity" ;
        schema:name "neumann_pattern_std" ;
        schema:unitText "1" ;
        schema:value "0.99918" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-neumann-pattern-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-neumann-pattern-std-reference> a schema:PropertyValue ;
        schema:value "1.01072" .

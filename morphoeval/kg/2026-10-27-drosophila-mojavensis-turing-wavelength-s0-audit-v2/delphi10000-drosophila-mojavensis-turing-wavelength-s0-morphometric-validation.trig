        schema:value "2.37959" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-chronoseries-successor-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chronoseries_successor_wavelength_um = 1.94766 µm" ;
        schema:measurementTechnique "D. novamexicana λ = λ★ * 1948/2380 at 0 Ma; reference is the focal wavelength" ;
        schema:name "chronoseries_successor_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "1.94766" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-chronoseries-successor-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-chronoseries-successor-wavelength-um-reference> a schema:PropertyValue ;
        schema:value "2.37959" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r = 0.99323 1" ;
        schema:measurementTechnique "Pearson r of analytic σ(k) vs growth rate measured from the PDE, nine wavenumbers" ;
        schema:name "dispersion_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.99323" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .

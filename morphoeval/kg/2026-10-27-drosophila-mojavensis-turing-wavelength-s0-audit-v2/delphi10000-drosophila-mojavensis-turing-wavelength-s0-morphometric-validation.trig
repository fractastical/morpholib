sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg most-unstable wavelength for D. mojavensis epicuticle at 2.4 µm (0 Ma) — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r=0.99323, RMSE=0.02405. Plate vs habitus foreground 0.3806 vs 0.5455, coherency 0.8155 vs 0.5838, KS(activator, plate)=0.858. Chronospecies FFT errors are about 1.4% (miranda and novamexicana). Neumann std 0.99918 vs periodic 1.01072. None of these pairs have value == reference." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-ablation-to-pattern-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-chronoseries-predecessor-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-chronoseries-successor-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-neumann-pattern-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-neumann-stripe-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-predecessor-fft-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-segment-ks-activator-vs-plate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-specimen-plate-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-specimen-plate-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-specimen-plate-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-stripe-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-successor-fft-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-ablation-to-pattern-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_to_pattern_std_ratio = 0.0 1" ;
        schema:measurementTechnique "std(u) with Dv=Du divided by std(u) at R=80; reference 1 would mean the control failed to flatten" ;
        schema:name "ablation_to_pattern_std_ratio" ;
        schema:unitText "1" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-ablation-to-pattern-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-ablation-to-pattern-std-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-chronoseries-predecessor-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chronoseries_predecessor_wavelength_um = 3.23644 µm" ;
        schema:measurementTechnique "D. miranda λ = λ★ * 3237/2380 at 0 Ma; reference is the focal 2.4 µm wavelength" ;
        schema:name "chronoseries_predecessor_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "3.23644" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-measurement-chronoseries-predecessor-wavelength-um-reference> .

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-oster-mechanochemical-chondrogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Oster, Murray & Harris (1983) / Oster, Murray & Maini (1985) mechanochemical limb chondrogenesis — Source and data traceability: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credits: 8 primary sources with DOIs in the docstring (L6-34), `paper_citations.bib` and the reference JSON `sources`; the specimen JPG and scout manifest are SHA-256-pinned at runtime (L128-158); the reference JSON now records the script's actual defaults, the AER/ablation table and the BSW coupling table with their sources; the BSW parameters cite the Slot 016 reference JSON they were copied from (L674-686). Deductions: the reference JSON `canonical_parameters` (D_1 = 0.08 ...) still differ from the script's (D_1 = 0.28 ...) — disclosed side by side but not reconciled (-4); the reference JSON is hashed but not pinned, so edits are not fail-closed (-2); the BSW parameters are a copy rather than a hash-verified read of the Slot 016 fixture (-2); the Saunders (1948) table carries no digitised stage/truncation data (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/mechanochemical_chondrogenesis/mechanochemical_chondrogenesis_reference.json L102–L137: canonical_parameters (never used by the script) next to the new script_default_parameters block with the disclosure note <https://github.com/fractastical/morpholib/blob/d58a084/datasets/mechanochemical_chondrogenesis/mechanochemical_chondrogenesis_reference.json#L102-L137>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-source-traceability-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1983-oster-mechanochemical-chondrogenesis.py L128–L158" ;
        dct:description "SHA-256 pins for specimen JPG and scout manifest; reference JSON hashed at runtime" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L128-L158> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/mechanochemical_chondrogenesis/mechanochemical_chondrogenesis_reference.json L1–L60" ;
        dct:description "8 sources with DOIs (4 added in Pass 3) and the SHA-pinned specimen record" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/mechanochemical_chondrogenesis/mechanochemical_chondrogenesis_reference.json#L1-L60> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/mechanochemical_chondrogenesis/paper_citations.bib L44–L86" ;
        dct:description "Saunders 1948, Raspopovic 2014, ten Berge 2008, Hall & Miyake 2000 BibTeX entries with DOIs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/mechanochemical_chondrogenesis/paper_citations.bib#L44-L86> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-oster-mechanochemical-chondrogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Oster, Murray & Harris (1983) / Oster, Murray & Maini (1985) mechanochemical limb chondrogenesis — Parameter expressivity: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credits: v_AER, t_ablate, bsw_gain, coupling and digits are CLI flags (L1682-1692, --sweep-2d); the ablation time controls the truncation level monotonically ([1, 1, 2, 3], Spearman rho = 0.95, Panel H); the coupling strength lowers tau_c monotonically along an 11-point curve (L928-929, inset of Panel I; self-test L1647-1648); autopod_digits = 4 / 5 sets the distal paddle width and yields 4 / 5 digits; the phase diagram marks the 2D-PDE zone counts. Deductions: during tuning W_autopod = 3.0 ... 4.5 lambda_c all produced 4 rods, i.e. in the 2D solver the digit count is partly inherited by 2 -> 4 bifurcation and is not the m = round(W / lambda_c) staircase of Law 3 that Panel D draws — this sweep is not in the shipped script and the discrepancy is not displayed (-7); W_stylopod = 1.0 gives no condensation and 1.3-1.5 give one, so the stylopod regime is narrow and tuned (-4); aniso_y, d_pz and gate_w are fixed and unswept although they decide rod orientation (isotropic diffusion gives stripes parallel to the front) (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1983-oster-mechanochemical-chondrogenesis.py L444–L451: aniso_y = 3.0, w_stylopod = 1.4, w_zeugopod = 2.0 fixed defaults; no shipped W-sweep of the 2D mode staircase <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L444-L451>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-parameter-expressivity-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1983-oster-mechanochemical-chondrogenesis.py L631–L668" ;
        dcterms:description "Saunders ablation series over t_ablate = (0, 14, 30, intact) with Spearman rho and RMSE vs [1, 1, 2, 3]" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L631-L668> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1983-oster-mechanochemical-chondrogenesis.py L905–L962" ;
        dcterms:description "Synergy evaluation: tau_c(alpha_S = kappa_S) curve, factorial counts, phase correlations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L905-L962> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "1983-oster-mechanochemical-chondrogenesis.py L1678–L1716" ;
        dcterms:description "CLI: --tau, --digits, --aer-speed, --ablate-at, --bsw-gain, --coupling, --seed, --sweep-2d" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L1678-L1716> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


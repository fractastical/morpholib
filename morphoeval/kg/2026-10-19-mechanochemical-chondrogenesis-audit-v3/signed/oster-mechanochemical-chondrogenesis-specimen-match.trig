    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Oster, Murray & Harris (1983) / Oster, Murray & Maini (1985) mechanochemical limb chondrogenesis — Morphological realism / specimen match: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credits: the vendored Oedipina ecuatoriana specimen is SHA-256-verified and segmented into [1, 2, 4] / [1, 2, 5] (L968-1058); the 2D free-boundary PDE output (Panels C, G) now shows a single proximal rod, a Y-bifurcation and 4 or 5 parallel digital rays within a widening paddle, visibly the same architecture as the specimen in Panel E, and its autopod section is overlaid on the specimen profile in Panel F; the GIF shows the sequence emerging behind the AER. Deductions: the PDE rods are continuous with no joints, carpals/tarsals or phalangeal segmentation and all digits have equal length, unlike the specimen (-6); the PDE zeugopod/autopod spacing ratio is 1.235 vs the specimen's 1.373 (10% error, L1190-1199) (-3); the forelimb stylopod rod is faint (amplitude ~0.3-0.4 vs ~0.6 for digits) because W_stylopod = 1.4 lambda_c is near-marginal (-3); the comparison remains count-and-spacing level with no micron calibration (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-specimen-match-4> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


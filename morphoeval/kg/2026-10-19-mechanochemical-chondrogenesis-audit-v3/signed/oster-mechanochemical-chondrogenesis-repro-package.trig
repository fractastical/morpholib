    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1983-oster-mechanochemical-chondrogenesis.py L1591–L1675" ;
        dcterms:description "Self-test: SHA-256, 1D/2D/hybrid bitwise determinism, hierarchies, onset order, ablation, synergy window, factorial, 14 measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L1591-L1675> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1983-oster-mechanochemical-chondrogenesis.py L412–L424" ;
        dcterms:description "Memoising wrapper keyed on bound solver arguments (excluding n_snapshots)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L412-L424> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/mechanochemical_chondrogenesis_growth.gif (generated output)" ;
        dcterms:description "24-frame GIF rendered from the stored free-boundary PDE snapshots — docs/media/mechanochemical_chondrogenesis_growth.gif: rendered output of 1983-oster-mechanochemical-chondrogenesis.py at d58a084, image/gif, 1021820 B, 1019×540 px, 24 frames, artifact_sha256 83ceada87d7196c3382edf9c945d77f6f75661c083dfbd25dd76681f68113a6f (sha256 83ceada87d7196c3382edf9c945d77f6f75661c083dfbd25dd76681f68113a6f), spec_fingerprint 176fd41f0d953b7b1e5e1437961112bdacb6e1e1e0faf2536dab887008a3d35d" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Oster, Murray & Harris (1983) / Oster, Murray & Maini (1985) mechanochemical limb chondrogenesis — Reproducibility package: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credits: deterministic seeds everywhere (seed + 100 * autopod_digits in 2D, seed + m in 1D and hybrid); the self-test (L1591-1675) checks bitwise determinism of the 1D, 2D and hybrid solvers, the analytic/solver tau_c relation, the synergy window, the factorial, the hierarchies, the onset order and the ablation series and runs in ~31 s; the memoising wrapper (L412-424) makes figure, GIF, measurement hook and self-test share one run per configuration; default render 31-60 s; CLI flags documented in argparse. Deductions: no requirements lock file for this slot and the environment is recorded only in this audit (-4); the matplotlib font-cache directory must be writable or MPLCONFIGDIR set, which the script does not mention (-2); the memo cache keeps up to 24 snapshots per 2D configuration in memory (~3 MB each) without a documented bound (-2); the dataset README invocation notes do not list the new flags (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-repro-package-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-oster-mechanochemical-chondrogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Oster, Murray & Harris (1983) / Oster, Murray & Maini (1985) mechanochemical limb chondrogenesis — Morphometric validation: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credits: 14 reference-anchored measurements (L1069-1262), 9 new: 2D hierarchies vs specimen [1, 2, 4] / [1, 2, 5] (RMSE 0), 2D zeugopod/autopod spacing ratio vs the specimen's 1.373, proximo-distal onset rank correlation (1.0), Saunders series RMSE vs [1, 1, 2, 3] (0), synergy ratio 0.240 vs null 1.0, factorial [0, 0, 0, 4], corr(S, B) = -0.988 vs Raspopovic's out-of-phase prediction, and the disclosed solver/analytic tau_c discrepancy. Deductions: measurement 2 (1D wavelength = lambda_c, CV = 0.0000, L1129-1137) is circular — the periodic domain is W = 4 lambda_c and the m = 4 cosine is seeded (L312-313) (-5); the synergy and factorial references are model-internal nulls/predictions, not literature values (-3); the Saunders expectation is a qualitative mapping of stages to segments, not digitised data (-2); no absolute length/time calibration (lambda_c in micrometres, outgrowth speed in micrometres per hour) against the specimen or chick data (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1983-oster-mechanochemical-chondrogenesis.py L1129–L1137: Measurement 2: 1D autopod wavelength vs lambda_c is exact by construction (domain W = 4 lambda_c with seeded cosine at L312-313) <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L1129-L1137>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-1d-2d-solver-drift-kernel-critical-traction-tau-c-solver-vs-analytic-tau-c-disclosed-discrepancy>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-2d-free-boundary-aer-outgrowth-pde-forelimb-hierarchy-stylopod-zeugopod-autopod-rmse-vs-specimen-1-2-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-2d-free-boundary-aer-outgrowth-pde-hindlimb-hierarchy-stylopod-zeugopod-autopod-rmse-vs-specimen-1-2-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-2d-free-boundary-pde-zeugopod-autopod-inter-element-spacing-ratio-vs-salamander-forelimb-specimen>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-2x2-factorial-synergy-test-at-tau-0-85-condensation-counts-mechanics-only-bsw-only-sox9-feedback-only-hybrid-rmse-vs-0-0-0-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-critical-cell-traction-bifurcation-threshold-tau-c-vs-subcritical-negative-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-hybrid-mechanochemical-bsw-critical-traction-tau-c-hybrid-tau-c-mechanics-only-solver-kernel-synergy-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-hybrid-model-sox9-bmp-anti-phase-correlation-corr-s-b-at-digit-condensations>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-proximo-distal-condensation-onset-ordering-behind-the-aer-front-spearman-rho-of-zone-rank-vs-onset-time>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-proximo-distal-limb-branching-hierarchy-mode-progression-subcritical-stylopod-zeugopod-4-digit-5-digit-autopod-rmse>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-salamander-forelimb-specimen-oedipina-ecuatoriana-autopod-inter-digital-spacing>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-salamander-hindlimb-specimen-oedipina-ecuatoriana-autopod-inter-digital-spacing>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-saunders-1948-aer-ablation-truncation-series-proximo-distal-segments-formed-vs-ablation-time-rmse>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-simulated-urodele-forelimb-autopod-m-4-condensation-wavelength-vs-analytical-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-morphometric-validation-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-1d-2d-solver-drift-kernel-critical-traction-tau-c-solver-vs-analytic-tau-c-disclosed-discrepancy> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "1D/2D solver drift-kernel critical traction tau_c(solver) vs analytic tau_c (disclosed discrepancy) = 1.439682 dimensionless traction parameter" ;
        dcterms:description "relative discrepancy = 12.7%; all supercritical regimes used (tau >= 1.55) exceed both thresholds; carried as a Pass 4 remediation item" ;
        schema:measurementTechnique "bisection of the mechanics-only growth rate using the solvers' drift kernel i k sigma_hat / (E k^2 + s + mu k^2) versus the analytic quasi-static kernel i k sigma_hat / (E k^2 + s)" ;
        schema:name "1D/2D solver drift-kernel critical traction tau_c(solver) vs analytic tau_c (disclosed discrepancy)" ;
        schema:unitText "dimensionless traction parameter" ;
        schema:value "1.439682" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-1d-2d-solver-drift-kernel-critical-traction-tau-c-solver-vs-analytic-tau-c-disclosed-discrepancy-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-1d-2d-solver-drift-kernel-critical-traction-tau-c-solver-vs-analytic-tau-c-disclosed-discrepancy-reference> a schema:PropertyValue ;
        dcterms:source "Oster, Murray & Maini (1985) linearised dispersion relation (viscosity enters the growth-rate denominator, not the quasi-static stiffness)" ;
        schema:value "1.277638" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-2d-free-boundary-aer-outgrowth-pde-forelimb-hierarchy-stylopod-zeugopod-autopod-rmse-vs-specimen-1-2-4> a schema:PropertyValue,

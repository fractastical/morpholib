    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-2d-free-boundary-pde-zeugopod-autopod-inter-element-spacing-ratio-vs-salamander-forelimb-specimen-reference> a schema:PropertyValue ;

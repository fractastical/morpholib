        schema:unitText "Pearson r" ;
        schema:value "-0.988" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-hybrid-model-sox9-bmp-anti-phase-correlation-corr-s-b-at-digit-condensations-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-hybrid-model-sox9-bmp-anti-phase-correlation-corr-s-b-at-digit-condensations-reference> a schema:PropertyValue ;

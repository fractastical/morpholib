    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-2d-free-boundary-aer-outgrowth-pde-forelimb-hierarchy-stylopod-zeugopod-autopod-rmse-vs-specimen-1-2-4-reference> a schema:PropertyValue ;

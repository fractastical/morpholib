        schema:name "hybrid mechanochemical-BSW critical traction tau_c(hybrid) / tau_c(mechanics-only, solver kernel) synergy ratio" ;
        schema:unitText "dimensionless threshold ratio" ;
        schema:value "0.2402" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-hybrid-mechanochemical-bsw-critical-traction-tau-c-hybrid-tau-c-mechanics-only-solver-kernel-synergy-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-hybrid-mechanochemical-bsw-critical-traction-tau-c-hybrid-tau-c-mechanics-only-solver-kernel-synergy-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Null hypothesis of no mechanochemical-biochemical synergy (ratio = 1); Raspopovic et al. (2014) Science 345:566-570 BSW kinetics; Lean 4 theorem hybrid_mechanochemical_bsw_synergy_threshold" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-hybrid-model-sox9-bmp-anti-phase-correlation-corr-s-b-at-digit-condensations> a schema:PropertyValue,

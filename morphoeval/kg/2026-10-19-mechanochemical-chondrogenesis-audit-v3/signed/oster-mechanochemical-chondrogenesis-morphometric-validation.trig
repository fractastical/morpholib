    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-2d-free-boundary-aer-outgrowth-pde-hindlimb-hierarchy-stylopod-zeugopod-autopod-rmse-vs-specimen-1-2-5-reference> a schema:PropertyValue ;

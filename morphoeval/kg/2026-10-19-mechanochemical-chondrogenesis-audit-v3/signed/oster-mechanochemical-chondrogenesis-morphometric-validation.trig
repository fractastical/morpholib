        schema:name "2D free-boundary AER outgrowth PDE forelimb hierarchy [stylopod, zeugopod, autopod] RMSE vs specimen [1, 2, 4]" ;
        schema:unitText "condensation elements" ;
        schema:value "0.0" ;

        schema:name "critical cell traction bifurcation threshold tau_c vs subcritical negative control" ;
        schema:unitText "dimensionless traction parameter" ;
        schema:value "1.2776" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-critical-cell-traction-bifurcation-threshold-tau-c-vs-subcritical-negative-control-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-critical-cell-traction-bifurcation-threshold-tau-c-vs-subcritical-negative-control-reference> a schema:PropertyValue ;
        dcterms:source "Oster, Murray & Harris (1983) J. Embryol. Exp. Morph. 78:83-125 & Oster, Murray & Maini (1985) J. Embryol. Exp. Morph. 89:93-112 Section 2" ;
        schema:value "1.2776" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-measurement-hybrid-mechanochemical-bsw-critical-traction-tau-c-hybrid-tau-c-mechanics-only-solver-kernel-synergy-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-oster-mechanochemical-chondrogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Oster, Murray & Harris (1983) / Oster, Murray & Maini (1985) mechanochemical limb chondrogenesis — Model fidelity to source: 85/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credits: the analytic marginal-stability curve and tau_c (L192-237) match the linearised Oster-Murray-Maini balance; the new 2D solver (L427-628) couples cell conservation with biharmonic diffusion, traction-driven drift and Kelvin-Voigt ECM relaxation to a moving free-boundary AER with a progress zone, which is the mechanism Oster, Murray & Maini (1985) Sec. 4 describe; the hybrid 4x4 Jacobian (L717-759) is a correct linearisation of the stated coupled system and its analytic-kernel limit reproduces tau_c = 1.2776 (self-test L1645). Deductions: the drift kernel 1/(E k^2 + s + mu k^2) (L508; 1D L329) treats viscosity as stiffness, so the solvers' tau_c = 1.4397 differs by 12.7% from the analytic value the figure reports (-5); the ECM balance is component-wise Helmholtz with no shear/Poisson term, no ECM density rho equation and the paper's -div(n du/dt) advection is replaced by the traction-drift velocity (-4); ad hoc constants (relaxation 1/(mu + 0.15) L327/L572-573, cubic -0.18 (n - N_0)^3 L334/L580, aniso_y = 3.0 L444) are not from the source (-3); the v2 Panel C was a kinematic template, so part of the v2 fidelity credit was unearned and is not restored here (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1983-oster-mechanochemical-chondrogenesis.py L1251–L1261: Measurement 14 discloses tau_c(solver) = 1.4397 vs analytic 1.2776 (12.7%) — the solver does not implement the analytic dispersion relation exactly <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L1251-L1261>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity-4> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1983-oster-mechanochemical-chondrogenesis.py L192–L237" ;
        dcterms:description "Analytic marginal stability curve tau_eff(k^2) and tau_c = 1.2776 at k_c = 0.9597" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L192-L237> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1983-oster-mechanochemical-chondrogenesis.py L427–L628" ;
        dcterms:description "2D coupled cell-ECM PDE with moving free-boundary AER front, progress zone, AER regression, anisotropic PD diffusion and ectoderm-balanced prestress (sigma_drive L566, drift kernel L508)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L427-L628> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "1983-oster-mechanochemical-chondrogenesis.py L717–L759" ;
        dcterms:description "4x4 hybrid mechanochemical + Bmp-Sox9-Wnt Jacobian; den = m_k + mu k^2 (solver kernel) vs m_k (analytic) at L751" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L717-L759> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean L98–L185" ;
        dcterms:description "6 new machine-checked theorems: AER front monotone, outgrowth mode monotone, Saunders ablation truncation, hybrid threshold lowering, synergy window, n-Sox9 loop determinant" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L98-L185> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


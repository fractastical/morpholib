sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-oster-mechanochemical-chondrogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1983-oster-mechanochemical-chondrogenesis.py L36–L58" ;
        dcterms:description "Pass 3 docstring block R1-R3 mapping each remediation to functions, sources and the disclosed kernel discrepancy" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L36-L58> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1983-oster-mechanochemical-chondrogenesis.py L458–L488" ;
        dcterms:description "Free-boundary solver docstring: geometry, progress zone, equations, prestress balance, sources, Lean theorem" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L458-L488> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/oster-mechanochemical-chondrogenesis.yaml L109–L174" ;
        dcterms:description "Laws 4 and 5 registered with Lean declarations, variables, roles, source citations and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/oster-mechanochemical-chondrogenesis.yaml#L109-L174> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-oster-mechanochemical-chondrogenesis-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Oster, Murray & Harris (1983) / Oster, Murray & Maini (1985) mechanochemical limb chondrogenesis — Code-to-model traceability: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credits: every new function docstring names the section/figure it implements (Oster-Murray-Maini 1985 Sec. 4 for the progress zone, Oster-Murray-Harris 1983 Sec. 5 for anisotropy, Raspopovic 2014 Fig. 2E / Supp. 1.2 for the BSW Jacobian, Hall & Miyake 2000 for kappa_S, Saunders 1948 for ablation) and the Lean theorem it is checked by; laws 4-5 are registered with code and Lean loci in `oster-mechanochemical-chondrogenesis.yaml` and the stale loci of laws 1-3 were corrected. Deductions: the diffuse-competence/prestress-balance formulation (L566) and the progress-zone noise term (L579) are modelling choices argued in the docstring, not steps of the source (-4); peak-detection thresholds (height 1.15, prominence 0.25, onset 0.30; L377-409, L590) and the 0.15 / 0.18 constants are uncited (-4); the Lean theorems formalise monotonicity and sign conditions, not the PDE dynamics (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1983-oster-mechanochemical-chondrogenesis.py L377–L409: count_transverse_condensations thresholds (height 1.15, prominence 0.25) are uncited heuristics <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L377-L409>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-oster-mechanochemical-chondrogenesis-code-traceability-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


<https://w3id.org/delphi/resource/math-law/oster-mechanochemical-chondrogenesis-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Oster, Murray & Harris (1983) Mechanochemical Cell-Traction Instability Criterion" ;
    dct:description "Establishes the critical cell traction bifurcation threshold tau_c above which active cell pulling overcomes ECM elasticity and diffusion to nucleate chondrogenic condensations | Variables: E_eff: ECM elastic restoring modulus; D1_s: diffusive-tethering stabilization coefficient; tau_eff: active mesenchymal cell traction parameter" ;
    dct:source "Oster, Murray & Harris (1983) J. Embryol. Exp. Morph. 78:83-125 Section 3; Oster, Murray & Maini (1985) J. Embryol. Exp. Morph. 89:93-112 Section 2" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L171-L266>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L27-L44> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def mechanochemical_effective_stiffness (E_eff D1_s tau_eff : Int) : Int :=
  E_eff + D1_s - tau_eff
theorem oster_murray_1983_traction_instability_criterion
    (E_eff D1_s tau_sub tau_super : Int)
    (h_sub : tau_sub < E_eff + D1_s)
    (h_super : E_eff + D1_s < tau_super) :
    mechanochemical_effective_stiffness E_eff D1_s tau_sub > 0 ∧
    mechanochemical_effective_stiffness E_eff D1_s tau_super < 0"""^^pk:lean4 ;
    skos:notation "K_eff = E_eff + D1_s - tau_eff;  tau_eff > E_eff + D1_s => K_eff < 0 (spontaneous cell-ECM condensation)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/(SICI)1521-1878(200002)22:2%3C138::AID-BIES5%3E3.0.CO;2-4>,
        <https://doi.org/10.1002/jez.1401080304>,
        <https://doi.org/10.1007/978-1-4615-6983-1_6>,
        <https://doi.org/10.1093/imammb/1.1.51>,
        <https://doi.org/10.1126/science.1252960>,
        <https://doi.org/10.1242/dev.023176>,
        <https://doi.org/10.1242/dev.78.1.83>,
        <https://doi.org/10.1242/dev.89.1.93> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Mechanochemical Cell-Traction & Viscoelastic ECM Chondrogenesis PDE (Oster-Murray-Harris 1983 / Oster-Murray-Maini 1985)" ;
    pk:leanDeclaration "MathOfBiology.Loop_013.mechanochemical_effective_stiffness" ;
    pk:leanTheorem "MathOfBiology.Loop_013.oster_murray_1983_traction_instability_criterion" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/oster-mechanochemical-chondrogenesis-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Oster, Murray & Maini (1985) Contact-Inhibited Cell Traction Saturation Law" ;
    dct:description "Proves that contact-inhibited cell traction saturates at high cell density, preventing delta-shock blowup and stabilizing smooth cartilage condensations | Variables: tau: cell traction coefficient; lam: contact-inhibition saturation constant; n: mesenchymal cell density" ;
    dct:source "Oster, Murray & Maini (1985) J. Embryol. Exp. Morph. 89:93-112 Eq. (4)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L171-L190>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L50-L68> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def contact_inhibited_traction_num (tau n : Nat) : Nat := tau * (n * n)
def contact_inhibited_traction_den (lam n : Nat) : Nat := 1 + lam * (n * n)
theorem oster_murray_1985_contact_inhibited_traction_bound (tau lam n : Nat) :
    lam * contact_inhibited_traction_num tau n ≤
      tau * contact_inhibited_traction_den lam n"""^^pk:lean4 ;
    skos:notation "sigma_cell(n) = (tau * n^2) / (1 + lambda * n^2) <= tau / lambda" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/(SICI)1521-1878(200002)22:2%3C138::AID-BIES5%3E3.0.CO;2-4>,
        <https://doi.org/10.1002/jez.1401080304>,
        <https://doi.org/10.1007/978-1-4615-6983-1_6>,
        <https://doi.org/10.1093/imammb/1.1.51>,
        <https://doi.org/10.1126/science.1252960>,
        <https://doi.org/10.1242/dev.023176>,
        <https://doi.org/10.1242/dev.78.1.83>,
        <https://doi.org/10.1242/dev.89.1.93> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Mechanochemical Cell-Traction & Viscoelastic ECM Chondrogenesis PDE (Oster-Murray-Harris 1983 / Oster-Murray-Maini 1985)" ;
    pk:leanDeclaration "MathOfBiology.Loop_013.contact_inhibited_traction_num" ;
    pk:leanTheorem "MathOfBiology.Loop_013.oster_murray_1985_contact_inhibited_traction_bound" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/oster-mechanochemical-chondrogenesis-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Oster, Murray & Maini (1985) Proximo-Distal Limb Branching Mode Law" ;
    dct:description "Governs the proximo-distal transition from 1 focal condensation (stylopod: humerus/femur) to 2 bifurcated elements (zeugopod: radius+ulna / tibia+fibula) to 4-5 digital rays (autopod) | Variables: W: transverse limb bud paddle width; lambda_c: characteristic mechanochemical instability wavelength 2*pi/k_c" ;
    dct:source "Oster, Murray & Maini (1985) J. Embryol. Exp. Morph. 89:93-112 Figs. 4-9; Shubin & Alberch (1986) Evol. Biol. 20:319-387" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L272-L372>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L76-L95> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def limb_condensation_mode (W lambda_c : Nat) : Nat := W / lambda_c
theorem oster_maini_1985_limb_branching_progression (lambda_c : Nat) (h : 0 < lambda_c) :
    limb_condensation_mode (1 * lambda_c) lambda_c = 1 ∧
    limb_condensation_mode (2 * lambda_c) lambda_c = 2 ∧
    limb_condensation_mode (4 * lambda_c) lambda_c = 4 ∧
    limb_condensation_mode (5 * lambda_c) lambda_c = 5"""^^pk:lean4 ;
    skos:notation "m(W, lambda_c) = W / lambda_c  =>  (1, 2, 4, 5) for stylopod, zeugopod, and urodele forelimb/hindlimb autopod" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/(SICI)1521-1878(200002)22:2%3C138::AID-BIES5%3E3.0.CO;2-4>,
        <https://doi.org/10.1002/jez.1401080304>,
        <https://doi.org/10.1007/978-1-4615-6983-1_6>,
        <https://doi.org/10.1093/imammb/1.1.51>,
        <https://doi.org/10.1126/science.1252960>,
        <https://doi.org/10.1242/dev.023176>,
        <https://doi.org/10.1242/dev.78.1.83>,
        <https://doi.org/10.1242/dev.89.1.93> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Mechanochemical Cell-Traction & Viscoelastic ECM Chondrogenesis PDE (Oster-Murray-Harris 1983 / Oster-Murray-Maini 1985)" ;
    pk:leanDeclaration "MathOfBiology.Loop_013.limb_condensation_mode" ;
    pk:leanTheorem "MathOfBiology.Loop_013.oster_maini_1985_limb_branching_progression" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/oster-mechanochemical-chondrogenesis-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Oster, Murray & Maini (1985) / Saunders (1948) AER Free-Boundary Outgrowth Monotonicity Law" ;
    dct:description "Governs the proximo-distal sequence in which condensation modes are laid down behind the moving free-boundary AER in the 2D solver, and the distal truncation produced by AER removal | Variables: L_0: initial bud length; v_AER: AER outgrowth speed; t_ablate: Saunders (1948) AER-removal time; W(y): paddle width profile; lambda_c: mechanochemical wavelength" ;
    dct:source "Oster, Murray & Maini (1985) J. Embryol. Exp. Morph. 89:93-112 Sec. 4; Saunders (1948) J. Exp. Zool. 108:363-403 (10.1002/jez.1401080304); ten Berge et al. (2008) Development 135:3247-3257" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L377-L669>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L100-L135> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def aer_front (L0 v t : Nat) : Nat := L0 + v * t
theorem oster_maini_1985_aer_front_monotone (L0 v t1 t2 : Nat) (h : t1 ≤ t2) :
    aer_front L0 v t1 ≤ aer_front L0 v t2
theorem oster_maini_1985_aer_outgrowth_mode_monotone (W1 W2 lambda_c : Nat) (h : W1 ≤ W2) :
    limb_condensation_mode W1 lambda_c ≤ limb_condensation_mode W2 lambda_c
theorem saunders_1948_aer_ablation_truncation (L0 v t_ablate y t : Nat)
    (h_t : t ≤ t_ablate) (h_y : aer_front L0 v t_ablate < y) :
    aer_front L0 v t < y"""^^pk:lean4 ;
    skos:notation "L(t) = L_0 + v_AER * t non-decreasing; W_1 <= W_2 => m(W_1, lambda_c) <= m(W_2, lambda_c); AER removed at t_a => zones with y > L(t_a) never form" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/(SICI)1521-1878(200002)22:2%3C138::AID-BIES5%3E3.0.CO;2-4>,
        <https://doi.org/10.1002/jez.1401080304>,
        <https://doi.org/10.1007/978-1-4615-6983-1_6>,
        <https://doi.org/10.1093/imammb/1.1.51>,
        <https://doi.org/10.1126/science.1252960>,
        <https://doi.org/10.1242/dev.023176>,
        <https://doi.org/10.1242/dev.78.1.83>,
        <https://doi.org/10.1242/dev.89.1.93> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Mechanochemical Cell-Traction & Viscoelastic ECM Chondrogenesis PDE (Oster-Murray-Harris 1983 / Oster-Murray-Maini 1985)" ;
    pk:leanDeclaration "MathOfBiology.Loop_013.aer_front" ;
    pk:leanTheorem "MathOfBiology.Loop_013.oster_maini_1985_aer_outgrowth_mode_monotone" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/oster-mechanochemical-chondrogenesis-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Hybrid Mechanochemical + Bmp-Sox9-Wnt Synergy Threshold Law" ;
    dct:description "Establishes that coupling the mechanochemical traction instability to Raspopovic (2014) Bmp-Sox9-Wnt kinetics can only lower the critical traction, and defines the synergy window (tau_c,hybrid < tau < tau_c,mech) tested by the 2x2 factorial at tau = 0.85 | Variables: chi_BSW: Sox9-mediated feedback gain (alpha_S * kappa_S loop through the Bmp-Sox9-Wnt network); a = -J_nn: mechanics-only stability margin; b = J_nS: Sox9 -> traction; c = J_Sn: condensation -> Sox9; mu = mu_S: Sox9 clearance" ;
    dct:source "Raspopovic, Marcon, Russo & Sharpe (2014) Science 345:566-570 (10.1126/science.1252960); Hall & Miyake (2000) BioEssays 22:138-147; Oster, Murray & Maini (1985) Sec. 5" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L671-L962>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L137-L183> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def hybrid_effective_stiffness (E_eff D1_s tau_eff chi_bsw : Int) : Int :=
  mechanochemical_effective_stiffness E_eff D1_s tau_eff - chi_bsw
theorem hybrid_mechanochemical_bsw_threshold_lowering (E_eff D1_s tau_eff chi_bsw : Int) (h : 0 ≤ chi_bsw) :
    hybrid_effective_stiffness E_eff D1_s tau_eff chi_bsw ≤ mechanochemical_effective_stiffness E_eff D1_s tau_eff
theorem hybrid_mechanochemical_bsw_synergy_threshold (E_eff D1_s tau_eff chi_bsw : Int)
    (h_mech_stable : 0 < mechanochemical_effective_stiffness E_eff D1_s tau_eff)
    (h_gain : mechanochemical_effective_stiffness E_eff D1_s tau_eff < chi_bsw) :
    0 < mechanochemical_effective_stiffness E_eff D1_s tau_eff ∧
    hybrid_effective_stiffness E_eff D1_s tau_eff chi_bsw < 0
def hybrid_reduced_det (a mu b c : Int) : Int := a * mu - b * c
theorem hybrid_n_sox9_loop_destabilises_when_gain_exceeds_margin (a mu b c : Int) (h : a * mu < b * c) :
    hybrid_reduced_det a mu b c < 0"""^^pk:lean4 ;
    skos:notation "K_hyb = E_eff + D1_s - tau_eff - chi_BSW <= K_mech (chi_BSW >= 0); 0 < K_mech < chi_BSW => K_hyb < 0; det[[-a, b],[c, -mu]] = a*mu - b*c < 0 iff b*c > a*mu" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/(SICI)1521-1878(200002)22:2%3C138::AID-BIES5%3E3.0.CO;2-4>,
        <https://doi.org/10.1002/jez.1401080304>,
        <https://doi.org/10.1007/978-1-4615-6983-1_6>,
        <https://doi.org/10.1093/imammb/1.1.51>,
        <https://doi.org/10.1126/science.1252960>,
        <https://doi.org/10.1242/dev.023176>,
        <https://doi.org/10.1242/dev.78.1.83>,
        <https://doi.org/10.1242/dev.89.1.93> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Mechanochemical Cell-Traction & Viscoelastic ECM Chondrogenesis PDE (Oster-Murray-Harris 1983 / Oster-Murray-Maini 1985)" ;
    pk:leanDeclaration "MathOfBiology.Loop_013.hybrid_effective_stiffness" ;
    pk:leanTheorem "MathOfBiology.Loop_013.hybrid_mechanochemical_bsw_synergy_threshold" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/oster-mechanochemical-chondrogenesis-1> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Oster, Murray & Harris (1983) Mechanochemical Cell-Traction Instability Criterion" ;
    dct:description "Establishes the critical cell traction bifurcation threshold tau_c above which active cell pulling overcomes ECM elasticity and diffusion to nucleate chondrogenic condensations | Variables: E_eff: ECM elastic restoring modulus; D1_s: diffusive-tethering stabilization coefficient; tau_eff: active mesenchymal cell traction parameter" ;
    dct:source "Oster, Murray & Harris (1983) J. Embryol. Exp. Morph. 78:83-125 Section 3; Oster, Murray & Maini (1985) J. Embryol. Exp. Morph. 89:93-112 Section 2" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L171-L266>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L27-L44> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def mechanochemical_effective_stiffness (E_eff D1_s tau_eff : Int) : Int :=
  E_eff + D1_s - tau_eff
theorem oster_murray_1983_traction_instability_criterion
    (E_eff D1_s tau_sub tau_super : Int)
    (h_sub : tau_sub < E_eff + D1_s)
    (h_super : E_eff + D1_s < tau_super) :
    mechanochemical_effective_stiffness E_eff D1_s tau_sub > 0 ∧
    mechanochemical_effective_stiffness E_eff D1_s tau_super < 0"""^^pk1:lean4 ;
    skos:notation "K_eff = E_eff + D1_s - tau_eff;  tau_eff > E_eff + D1_s => K_eff < 0 (spontaneous cell-ECM condensation)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/(SICI)1521-1878(200002)22:2%3C138::AID-BIES5%3E3.0.CO;2-4>,
        <https://doi.org/10.1002/jez.1401080304>,
        <https://doi.org/10.1007/978-1-4615-6983-1_6>,
        <https://doi.org/10.1093/imammb/1.1.51>,
        <https://doi.org/10.1126/science.1252960>,
        <https://doi.org/10.1242/dev.023176>,
        <https://doi.org/10.1242/dev.78.1.83>,
        <https://doi.org/10.1242/dev.89.1.93> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Mechanochemical Cell-Traction & Viscoelastic ECM Chondrogenesis PDE (Oster-Murray-Harris 1983 / Oster-Murray-Maini 1985)" ;
    pk1:leanDeclaration "MathOfBiology.Loop_013.mechanochemical_effective_stiffness" ;
    pk1:leanTheorem "MathOfBiology.Loop_013.oster_murray_1983_traction_instability_criterion" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/oster-mechanochemical-chondrogenesis-2> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Oster, Murray & Maini (1985) Contact-Inhibited Cell Traction Saturation Law" ;
    dct:description "Proves that contact-inhibited cell traction saturates at high cell density, preventing delta-shock blowup and stabilizing smooth cartilage condensations | Variables: tau: cell traction coefficient; lam: contact-inhibition saturation constant; n: mesenchymal cell density" ;
    dct:source "Oster, Murray & Maini (1985) J. Embryol. Exp. Morph. 89:93-112 Eq. (4)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L171-L190>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L50-L68> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def contact_inhibited_traction_num (tau n : Nat) : Nat := tau * (n * n)
def contact_inhibited_traction_den (lam n : Nat) : Nat := 1 + lam * (n * n)
theorem oster_murray_1985_contact_inhibited_traction_bound (tau lam n : Nat) :
    lam * contact_inhibited_traction_num tau n ≤
      tau * contact_inhibited_traction_den lam n"""^^pk1:lean4 ;
    skos:notation "sigma_cell(n) = (tau * n^2) / (1 + lambda * n^2) <= tau / lambda" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/(SICI)1521-1878(200002)22:2%3C138::AID-BIES5%3E3.0.CO;2-4>,
        <https://doi.org/10.1002/jez.1401080304>,
        <https://doi.org/10.1007/978-1-4615-6983-1_6>,
        <https://doi.org/10.1093/imammb/1.1.51>,
        <https://doi.org/10.1126/science.1252960>,
        <https://doi.org/10.1242/dev.023176>,
        <https://doi.org/10.1242/dev.78.1.83>,
        <https://doi.org/10.1242/dev.89.1.93> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Mechanochemical Cell-Traction & Viscoelastic ECM Chondrogenesis PDE (Oster-Murray-Harris 1983 / Oster-Murray-Maini 1985)" ;
    pk1:leanDeclaration "MathOfBiology.Loop_013.contact_inhibited_traction_num" ;
    pk1:leanTheorem "MathOfBiology.Loop_013.oster_murray_1985_contact_inhibited_traction_bound" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/oster-mechanochemical-chondrogenesis-3> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Oster, Murray & Maini (1985) Proximo-Distal Limb Branching Mode Law" ;
    dct:description "Governs the proximo-distal transition from 1 focal condensation (stylopod: humerus/femur) to 2 bifurcated elements (zeugopod: radius+ulna / tibia+fibula) to 4-5 digital rays (autopod) | Variables: W: transverse limb bud paddle width; lambda_c: characteristic mechanochemical instability wavelength 2*pi/k_c" ;
    dct:source "Oster, Murray & Maini (1985) J. Embryol. Exp. Morph. 89:93-112 Figs. 4-9; Shubin & Alberch (1986) Evol. Biol. 20:319-387" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L272-L372>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L76-L95> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def limb_condensation_mode (W lambda_c : Nat) : Nat := W / lambda_c
theorem oster_maini_1985_limb_branching_progression (lambda_c : Nat) (h : 0 < lambda_c) :
    limb_condensation_mode (1 * lambda_c) lambda_c = 1 ∧
    limb_condensation_mode (2 * lambda_c) lambda_c = 2 ∧
    limb_condensation_mode (4 * lambda_c) lambda_c = 4 ∧
    limb_condensation_mode (5 * lambda_c) lambda_c = 5"""^^pk1:lean4 ;
    skos:notation "m(W, lambda_c) = W / lambda_c  =>  (1, 2, 4, 5) for stylopod, zeugopod, and urodele forelimb/hindlimb autopod" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/(SICI)1521-1878(200002)22:2%3C138::AID-BIES5%3E3.0.CO;2-4>,
        <https://doi.org/10.1002/jez.1401080304>,
        <https://doi.org/10.1007/978-1-4615-6983-1_6>,
        <https://doi.org/10.1093/imammb/1.1.51>,
        <https://doi.org/10.1126/science.1252960>,
        <https://doi.org/10.1242/dev.023176>,
        <https://doi.org/10.1242/dev.78.1.83>,
        <https://doi.org/10.1242/dev.89.1.93> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Mechanochemical Cell-Traction & Viscoelastic ECM Chondrogenesis PDE (Oster-Murray-Harris 1983 / Oster-Murray-Maini 1985)" ;
    pk1:leanDeclaration "MathOfBiology.Loop_013.limb_condensation_mode" ;
    pk1:leanTheorem "MathOfBiology.Loop_013.oster_maini_1985_limb_branching_progression" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/oster-mechanochemical-chondrogenesis-4> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Oster, Murray & Maini (1985) / Saunders (1948) AER Free-Boundary Outgrowth Monotonicity Law" ;
    dct:description "Governs the proximo-distal sequence in which condensation modes are laid down behind the moving free-boundary AER in the 2D solver, and the distal truncation produced by AER removal | Variables: L_0: initial bud length; v_AER: AER outgrowth speed; t_ablate: Saunders (1948) AER-removal time; W(y): paddle width profile; lambda_c: mechanochemical wavelength" ;
    dct:source "Oster, Murray & Maini (1985) J. Embryol. Exp. Morph. 89:93-112 Sec. 4; Saunders (1948) J. Exp. Zool. 108:363-403 (10.1002/jez.1401080304); ten Berge et al. (2008) Development 135:3247-3257" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L377-L669>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L100-L135> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def aer_front (L0 v t : Nat) : Nat := L0 + v * t
theorem oster_maini_1985_aer_front_monotone (L0 v t1 t2 : Nat) (h : t1 ≤ t2) :
    aer_front L0 v t1 ≤ aer_front L0 v t2
theorem oster_maini_1985_aer_outgrowth_mode_monotone (W1 W2 lambda_c : Nat) (h : W1 ≤ W2) :
    limb_condensation_mode W1 lambda_c ≤ limb_condensation_mode W2 lambda_c
theorem saunders_1948_aer_ablation_truncation (L0 v t_ablate y t : Nat)
    (h_t : t ≤ t_ablate) (h_y : aer_front L0 v t_ablate < y) :
    aer_front L0 v t < y"""^^pk1:lean4 ;
    skos:notation "L(t) = L_0 + v_AER * t non-decreasing; W_1 <= W_2 => m(W_1, lambda_c) <= m(W_2, lambda_c); AER removed at t_a => zones with y > L(t_a) never form" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/(SICI)1521-1878(200002)22:2%3C138::AID-BIES5%3E3.0.CO;2-4>,
        <https://doi.org/10.1002/jez.1401080304>,
        <https://doi.org/10.1007/978-1-4615-6983-1_6>,
        <https://doi.org/10.1093/imammb/1.1.51>,
        <https://doi.org/10.1126/science.1252960>,
        <https://doi.org/10.1242/dev.023176>,
        <https://doi.org/10.1242/dev.78.1.83>,
        <https://doi.org/10.1242/dev.89.1.93> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Mechanochemical Cell-Traction & Viscoelastic ECM Chondrogenesis PDE (Oster-Murray-Harris 1983 / Oster-Murray-Maini 1985)" ;
    pk1:leanDeclaration "MathOfBiology.Loop_013.aer_front" ;
    pk1:leanTheorem "MathOfBiology.Loop_013.oster_maini_1985_aer_outgrowth_mode_monotone" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/oster-mechanochemical-chondrogenesis-5> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Hybrid Mechanochemical + Bmp-Sox9-Wnt Synergy Threshold Law" ;
    dct:description "Establishes that coupling the mechanochemical traction instability to Raspopovic (2014) Bmp-Sox9-Wnt kinetics can only lower the critical traction, and defines the synergy window (tau_c,hybrid < tau < tau_c,mech) tested by the 2x2 factorial at tau = 0.85 | Variables: chi_BSW: Sox9-mediated feedback gain (alpha_S * kappa_S loop through the Bmp-Sox9-Wnt network); a = -J_nn: mechanics-only stability margin; b = J_nS: Sox9 -> traction; c = J_Sn: condensation -> Sox9; mu = mu_S: Sox9 clearance" ;
    dct:source "Raspopovic, Marcon, Russo & Sharpe (2014) Science 345:566-570 (10.1126/science.1252960); Hall & Miyake (2000) BioEssays 22:138-147; Oster, Murray & Maini (1985) Sec. 5" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1983-oster-mechanochemical-chondrogenesis.py#L671-L962>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_013_mechanochemical_chondrogenesis.lean#L137-L183> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def hybrid_effective_stiffness (E_eff D1_s tau_eff chi_bsw : Int) : Int :=
  mechanochemical_effective_stiffness E_eff D1_s tau_eff - chi_bsw
theorem hybrid_mechanochemical_bsw_threshold_lowering (E_eff D1_s tau_eff chi_bsw : Int) (h : 0 ≤ chi_bsw) :
    hybrid_effective_stiffness E_eff D1_s tau_eff chi_bsw ≤ mechanochemical_effective_stiffness E_eff D1_s tau_eff
theorem hybrid_mechanochemical_bsw_synergy_threshold (E_eff D1_s tau_eff chi_bsw : Int)
    (h_mech_stable : 0 < mechanochemical_effective_stiffness E_eff D1_s tau_eff)
    (h_gain : mechanochemical_effective_stiffness E_eff D1_s tau_eff < chi_bsw) :
    0 < mechanochemical_effective_stiffness E_eff D1_s tau_eff ∧
    hybrid_effective_stiffness E_eff D1_s tau_eff chi_bsw < 0
def hybrid_reduced_det (a mu b c : Int) : Int := a * mu - b * c
theorem hybrid_n_sox9_loop_destabilises_when_gain_exceeds_margin (a mu b c : Int) (h : a * mu < b * c) :
    hybrid_reduced_det a mu b c < 0"""^^pk1:lean4 ;
    skos:notation "K_hyb = E_eff + D1_s - tau_eff - chi_BSW <= K_mech (chi_BSW >= 0); 0 < K_mech < chi_BSW => K_hyb < 0; det[[-a, b],[c, -mu]] = a*mu - b*c < 0 iff b*c > a*mu" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/(SICI)1521-1878(200002)22:2%3C138::AID-BIES5%3E3.0.CO;2-4>,
        <https://doi.org/10.1002/jez.1401080304>,
        <https://doi.org/10.1007/978-1-4615-6983-1_6>,
        <https://doi.org/10.1093/imammb/1.1.51>,
        <https://doi.org/10.1126/science.1252960>,
        <https://doi.org/10.1242/dev.023176>,
        <https://doi.org/10.1242/dev.78.1.83>,
        <https://doi.org/10.1242/dev.89.1.93> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Mechanochemical Cell-Traction & Viscoelastic ECM Chondrogenesis PDE (Oster-Murray-Harris 1983 / Oster-Murray-Maini 1985)" ;
    pk1:leanDeclaration "MathOfBiology.Loop_013.hybrid_effective_stiffness" ;
    pk1:leanTheorem "MathOfBiology.Loop_013.hybrid_mechanochemical_bsw_synergy_threshold" ;
    pk1:leanVerified true .


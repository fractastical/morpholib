<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-americana-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-americana-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-americana-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-americana-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing onset wavenumber" ;
    dct:description "Critical wavenumber of the 2.117 µm ocellar-pigment pattern; equal diffusion r = 1 is below onset | Variables: f_u = 4/5 for the Schnakenberg steady state at a = 0.1, b = 0.9; r = D_v/D_u" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Murray 1981 DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-americana-turing-wavelength-s0.py#L92-L100>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3175_drosophila_americana_turing_wavelength_s0.lean#L44-L48> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1176980>,
        <https://doi.org/10.1534/genetics.117.300583> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3175.turing_discriminant_survives_at_r10_and_fails_at_equal_diffusion" ;
    pk:leanTheorem "MathOfBiology.Loop_3175.turing_discriminant_survives_at_r10_and_fails_at_equal_diffusion" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-americana-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Buffered detail-scale chronoseries" ;
    dct:description "What changes at 2.1 µm and 0 Ma relative to the predecessor and successor: the wavelength ratio collapses toward 1 compared with the primordium-scale sibling slots | Variables: 2117 nm americana, 1958 nm affinis, 1900 nm ananassae, versus primordium lengths 138700, 95940, 84620 nm" ;
    dct:source "Wittkopp et al. 2009 DOI:10.1126/science.1176980; O'Grady and DeSalle 2018 DOI:10.1534/genetics.117.300583" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-americana-turing-wavelength-s0.py#L227-L258>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3175_drosophila_americana_turing_wavelength_s0.lean#L21-L36> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_i = 2.117e-6 * (L_i / L_americana)^0.35" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1176980>,
        <https://doi.org/10.1534/genetics.117.300583> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3175.detail_wavelength_chronoseries_order" ;
    pk:leanTheorem "MathOfBiology.Loop_3175.detail_ratio_buffered_against_affinis" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-americana-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Stripe count on a fixed ocellar window" ;
    dct:description "Shorter successor wavelength packs more detail-scale stripes into the same ocellar field | Variables: 80 µm window; N_ananassae = 42, N_affinis = 40, N_americana = 37" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-americana-turing-wavelength-s0.py#L237-L258>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3175_drosophila_americana_turing_wavelength_s0.lean#L14-L30> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = floor(80000 nm / lambda_nm)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1176980>,
        <https://doi.org/10.1534/genetics.117.300583> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3175.stripeCount" ;
    pk:leanTheorem "MathOfBiology.Loop_3175.successor_packs_more_detail_stripes" ;
    pk:leanVerified true .


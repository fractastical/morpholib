sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-055> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-055-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-055-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Figs. 394-400: rhinoceros and allied skulls by coordinate-grid transformation (Osborn) — Code-to-model traceability: 85/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Module docstring lists Pass 2 outputs (sweep, null, IoU, chamfer, Jacobian, specimen); analyze_pair and write_result wire all controls into result.json; math_kg_loops documents grid_matching and controls in model_spec. Deduction: extended fit statistics have no separate equation ids in E1-E7." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-code-traceability-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-code-traceability-3> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-055_on-the-theory-of-transformations.py L36–L46" ;
        dct:description "What is computed: sweep, shuffled null, figures, result.json" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/530b3b50c/thompson/claims/t1917-055_on-the-theory-of-transformations.py#L36-L46> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/thompson1917-t1917-055.yaml L1–L35" ;
        dct:description "controls include shuffled_grid_null; parameter regime documented" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/530b3b50c/morphoeval/math_kg_loops/thompson1917-t1917-055.yaml#L1-L35> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-055_on-the-theory-of-transformations.py L748–L785" ;
        dct:description "write_result merges sweep, specimen_cv_descriptive_only, headline" ;

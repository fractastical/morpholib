sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-055> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-055-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-055-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Figs. 394-400: rhinoceros and allied skulls by coordinate-grid transformation (Osborn) — Parameter expressivity: 79/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Primary-only sweep over 36 settings (maxd x lambda x n_boundary) is executed and written to result.json; 27 rows have >=40 matches and all beat identity on Procrustes; lambda and maxd visibly trade match count vs fit. Growth GIF still shows t along the primary deformation. Deduction: affine beats TPS across swept >=40-match rows; secondary pairs fixed at defaults only." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-055/result.json L400–L407: representative sweep rows: tps_beats_affine false at >=40 matches <https://github.com/fractastical/morpholib/blob/530b3b50c/datasets/thompson_1917/t1917-055/result.json#L400-L407>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-parameter-expressivity-2> ;
        pk:hasScore "0.79"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-055_on-the-theory-of-transformations.py L557–L585" ;
        dct:description "parameter_sweep: 36 primary-only settings; all_beat_identity_when_matched" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/530b3b50c/thompson/claims/t1917-055_on-the-theory-of-transformations.py#L557-L585> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-055-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-055/result.json L52–L55" ;
        dct:description "parameter_sweep n_settings 36; all_beat_identity_when_matched true" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/530b3b50c/datasets/thompson_1917/t1917-055/result.json#L52-L55> .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (builder-assessor, single-agent Pass 2; second assessor pending)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://ai.google.dev> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://archive.org/details/extinctrhinocero01osbo>,
            <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1109/34.24792>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/portfolio/results/leporidae_skulls.json> .
    <https://archive.org/details/extinctrhinocero01osbo> dct:date "1898"^^xsd:gYear ;
        dct:title "The Extinct Rhinoceroses of North America" .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form (Ch. XVII, On the Theory of Transformations, pp. 760-764, Figs. 394-400, skulls after Osborn)" .
    <https://doi.org/10.1109/34.24792> dct:date "1989"^^xsd:gYear ;
        dct:title "Principal warps: thin-plate splines and the decomposition of deformations" .
    <https://github.com/fractastical/morpholib/blob/main/thompson/portfolio/results/leporidae_skulls.json> dct:title "Modern Leporidae skull GM cache (portfolio JSON)" .
}


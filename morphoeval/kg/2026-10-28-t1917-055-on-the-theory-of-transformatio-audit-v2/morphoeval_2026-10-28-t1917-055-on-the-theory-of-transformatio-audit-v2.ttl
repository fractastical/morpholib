    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "interpDet(k,1,s,0,1) = 16 for all k" ;
    prov:wasDerivedFrom <https://doi.org/10.1109/34.24792> ;
    pk:hypothesisType "geometric — Thompson (1917) method of transformations applied to Osborn rhinoceros-allied skull diagrams (Figs. 394-400)" ;
    pk:leanTheorem "MathOfBiology.Loop_244.shear_interp_preserves_area" ;

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-055-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Grid interpolation endpoints and equidistant stage steps (E2/E6)" ;
    dct:description "Operational meaning of Thompson's interpolated coordinate systems between related skull diagrams | Variables: a: grid coordinate on Hyrachyus (Fig. 394); b=phi(a) on target skull grid; k in 0..4 stage index" ;
    dct:source "Thompson (1917) Ch. XVII pp. 760-764" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/530b3b50c/morphoeval/lean/loops/Thompson1917_T1917_055.lean#L16-L37>,
        <https://github.com/fractastical/morpholib/blob/530b3b50c/thompson/claims/t1917-055_on-the-theory-of-transformations.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "interp4(k,a,b) = (4-k)a + kb; interp4(0)=4a, interp4(4)=4b, interp4(k+1)-interp4(k)=b-a" ;
    prov:wasDerivedFrom <https://doi.org/10.1109/34.24792> ;
    pk:hypothesisType "geometric — Thompson (1917) method of transformations applied to Osborn rhinoceros-allied skull diagrams (Figs. 394-400)" ;
    pk:leanDeclaration "MathOfBiology.Loop_244.interp4" ;
    pk:leanTheorem "MathOfBiology.Loop_244.interp_endpoints_and_equidistant" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-055-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Similarity equivariance of interpolated coordinates (E2)" ;
    dct:description "Procrustes frame choice cannot change the predicted intermediate skull form | Variables: c: scale; d: translation applied to both endpoint diagrams" ;
    dct:source "Thompson (1917) Ch. XVII; Gower (1975) Procrustes analysis" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/530b3b50c/morphoeval/lean/loops/Thompson1917_T1917_055.lean#L39-L48>,
        <https://github.com/fractastical/morpholib/blob/530b3b50c/thompson/claims/t1917-055_on-the-theory-of-transformations.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "interp4(k, c a + d, c b + d) = c interp4(k, a, b) + 4 d" ;
    prov:wasDerivedFrom <https://doi.org/10.1109/34.24792> ;
    pk:hypothesisType "geometric — Thompson (1917) method of transformations applied to Osborn rhinoceros-allied skull diagrams (Figs. 394-400)" ;
    pk:leanTheorem "MathOfBiology.Loop_244.interp_similarity_equivariant" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-055-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "No-fold along a grid coordinate line (E1, 1-D form)" ;
    dct:description "Intermediate grids stay orientation-preserving along each coordinate line | Variables: ordered grid coordinates on reference and target nets" ;
    dct:source "Thompson (1917) Figs. 394-395" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/530b3b50c/morphoeval/lean/loops/Thompson1917_T1917_055.lean#L50-L68>,

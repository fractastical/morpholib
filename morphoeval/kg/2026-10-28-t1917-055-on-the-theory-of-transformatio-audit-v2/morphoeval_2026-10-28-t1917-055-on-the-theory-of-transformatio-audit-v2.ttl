    rdfs:label "Affine shear interpolation preserves area (E5)" ;
    dct:description "Thompson's simple shear strains remain area-preserving when interpolated | Variables: s: shear parameter; k: interpolation stage" ;
    dct:source "Thompson (1917) Ch. XVII pp. 727-733" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/530b3b50c/morphoeval/lean/loops/Thompson1917_T1917_055.lean#L90-L92>,

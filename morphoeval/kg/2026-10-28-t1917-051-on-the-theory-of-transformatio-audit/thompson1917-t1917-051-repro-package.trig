sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-051> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-051-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-051-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Fig. 383 crocodylian skull coordinate transformations — Reproducibility package: 64/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "--self-test and --pass1 flags exist; self_test does not verify Pass-1 vs Pass-2 feature split or two-run figure hash stability." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "thompson/claims/t1917-051_on-the-theory-of-transformations.py L463–L495: Minimal self_test; no artifact hash check <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/thompson/claims/t1917-051_on-the-theory-of-transformations.py#L463-L495>" ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval loop thompson1917-t1917-051 Pass 1)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1109/34.24792>,
            <https://doi.org/10.1111/jeb.12382>,
            <https://doi.org/10.5061/dryad.14fn1> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form, Ch. XVII, pp. 752-753, Fig. 383" .
    <https://doi.org/10.1109/34.24792> dct:date "1989"^^xsd:gYear ;
        dct:title "Principal warps: thin-plate splines and the decomposition of deformations" .
    <https://doi.org/10.1111/jeb.12382> dct:date "2014"^^xsd:gYear ;
        dct:title "The utility of cranial ontogeny for phylogenetic inference: a case study in crocodylians using geometric morphometrics" .
    <https://doi.org/10.5061/dryad.14fn1> dct:date "2014"^^xsd:gYear ;
        dct:title "Data from: crocodylian cranial ontogeny geometric morphometrics" .
}


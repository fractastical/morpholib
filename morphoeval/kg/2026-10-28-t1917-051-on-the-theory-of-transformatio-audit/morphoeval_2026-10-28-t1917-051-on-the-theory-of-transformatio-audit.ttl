<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-051-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-051-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-051-3> .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-051-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Procrustes rotation distance invariance" ;
    dct:description "Formal backbone for GPA superimposition before Thompson-style warps | Variables: R: 2×2 rotation; p,q: landmark coordinates in ℝ²" ;
    dct:source "Thompson (1917) Ch. XVII; Bookstein (1989) TPS" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/morphoeval/lean/loops/Thompson1917_T1917_051.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "‖R p - R q‖² = ‖p - q‖² for orthogonal R" ;
    prov:wasDerivedFrom <https://doi.org/10.1109/34.24792>,
        <https://doi.org/10.1111/jeb.12382>,
        <https://doi.org/10.5061/dryad.14fn1> ;
    pk:hypothesisType "geometric morphometrics / Thompson coordinate deformation" ;
    pk:leanDeclaration "MathOfBiology.Loop_241.sq_dist" ;
    pk:leanTheorem "MathOfBiology.Loop_241.procrustes_rotation_preserves_sq_dist" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-051-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Similarity scale multiplies squared distances by k²" ;
    dct:description "Noise floor for uniform scaling in Thompson rectilinear-to-deformed grids | Variables: k: uniform scale; p,q: landmarks" ;
    dct:source "Thompson (1917) pp. 752-753" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/morphoeval/lean/loops/Thompson1917_T1917_051.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "‖k p - k q‖² = k² ‖p - q‖²" ;
    prov:wasDerivedFrom <https://doi.org/10.1109/34.24792>,
        <https://doi.org/10.1111/jeb.12382>,
        <https://doi.org/10.5061/dryad.14fn1> ;
    pk:hypothesisType "geometric morphometrics / Thompson coordinate deformation" ;
    pk:leanDeclaration "MathOfBiology.Loop_241.similarity_scale_sq_dist" ;
    pk:leanTheorem "MathOfBiology.Loop_241.similarity_scale_sq_dist" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-051-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Affine shear preserves x-parallel chords" ;
    dct:description "Oblique-grid Thompson transformation family | Variables: m: shear coefficient; x,y: grid coordinates" ;
    dct:source "Thompson (1917) coordinate deformation grids" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/morphoeval/lean/loops/Thompson1917_T1917_051.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(x, y) ↦ (x, y + m x) maps y₂ = y₁ ⟹ y₂' = y₁'" ;
    prov:wasDerivedFrom <https://doi.org/10.1109/34.24792>,
        <https://doi.org/10.1111/jeb.12382>,
        <https://doi.org/10.5061/dryad.14fn1> ;
    pk:hypothesisType "geometric morphometrics / Thompson coordinate deformation" ;
    pk:leanDeclaration "MathOfBiology.Loop_241.shear_y" ;
    pk:leanTheorem "MathOfBiology.Loop_241.affine_shear_preserves_x_parallel" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


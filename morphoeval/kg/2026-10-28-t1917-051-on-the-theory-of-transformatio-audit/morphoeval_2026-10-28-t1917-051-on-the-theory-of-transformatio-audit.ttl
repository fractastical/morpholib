        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-051-repro-package>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-051-source-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-051-specimen-match> ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-051-on-the-theory-of-transformatio-audit-thompson1917-t1917-051-1>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-051-on-the-theory-of-transformatio-audit-thompson1917-t1917-051-2>,

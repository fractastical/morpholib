sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Archaeopteris hibernica Famennian epidermal Turing wavelength (31 µm, 370 Ma) faithfully reproduces Archaeopteris hibernica morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-archaeopteris-hibernica-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Archaeopteris hibernica specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-archaeopteris-hibernica-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-archaeopteris-hibernica-turing-wavelength-s0.py; output: docs/media/archaeopteris_hibernica_turing_wavelength_s0_comparison.png; organism: Archaeopteris hibernica; environment: python 3.12, numpy 2.5.4, scipy 1.18.1; claim_boundary: [reported_in_source: Meyer-Berthaud, Scheckler and Wendt (1999) establish a planated megaphyll and modern tree habit for Archaeopteris by the Famennian. | Turing (1952) gives a diffusion-driven instability at a critical wavenumber. | Schnakenberg (1979) supplies the two-species kinetics used here. | Boyce and Knoll (2002) treat planation as the step that makes a laminate leaf.; reconstructed_in_script: gamma = 0.6636 so that argmax sigma(k) = 2*pi/31 per micrometre on this Jacobian. | Thickness scaling lambda(h) = 31*(h/12.4)^0.62 gives 66 µm (Tetraxylopteris, 385 Ma) and 21 µm (Elkinsia, 365 Ma). | The GIF multiplies the museum frond by a resized activator veil. The photograph does not resolve 31 µm cells. | The 4.43 µm seeded-versus-unseeded shift is a finite-amplitude effect on the 186 µm grid, not a second biological wavelength.; transfer_boundary: An animal pigment Turing pattern is being used as the kinetics for a fossil epidermis whose original chemistry is not preserved.; does_not_claim: That 31 µm was measured on the Smithsonian slab or in the 1999 Nature paper. | That the predecessor and successor wavelengths are direct fossil measurements. | That nanopublications were signed. No ~/.nanopub/profile.yml is present, so sign_morphoeval.py cannot run.]; phenomenon_size: 31 µm (3.06e-05 m, log10=-4.514 m, tier=4_cellular_10um); species_scale_ladder (10 runs from 31 µm to 6.9 cm): 31 µm:archaeopteris-hibernica-bioelectric-polarity, 96 µm:archaeopteris-hibernica-vertex-packing, 1.5 mm:archaeopteris-hibernica-turing-wavelength, 3.1 mm:archaeopteris-hibernica-clock-wavefront, 6.9 mm:archaeopteris-hibernica-morphogen-condensation, 8.4 mm:archaeopteris-hibernica-elastic-buckling, 9.6 mm:archaeopteris-hibernica-flux-canalization, 1.3 cm:archaeopteris-hibernica-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1002/j.1537-2197.1957.tb10551.x>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/19516>,
            <https://doi.org/10.1086/337763>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1666/0094-8373(2002)028%3C0070:EODPAT%3E2.0.CO;2> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-archaeopteris-hibernica-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-archaeopteris-hibernica-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/j.1537-2197.1957.tb10551.x>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/19516>,
            <https://doi.org/10.1086/337763>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1666/0094-8373(2002)028%3C0070:EODPAT%3E2.0.CO;2> .
    <https://doi.org/10.1002/j.1537-2197.1957.tb10551.x> dct:title "Beck (1957) Tetraxylopteris schmidtii" .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:title "Schnakenberg (1979) Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1038/19516> dct:title "Meyer-Berthaud, Scheckler and Wendt (1999) Archaeopteris is the earliest known modern tree" .
    <https://doi.org/10.1086/337763> dct:title "Rothwell, Scheckler and Gillespie (1989) Elkinsia, a Late Devonian gymnosperm with cupulate ovules" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "Turing (1952) The chemical basis of morphogenesis" .
    <https://doi.org/10.1666/0094-8373(2002)028%3C0070:EODPAT%3E2.0.CO;2> dct:title "Boyce and Knoll (2002) Evolution of developmental potential and the multiple independent origins of leaves" .
}


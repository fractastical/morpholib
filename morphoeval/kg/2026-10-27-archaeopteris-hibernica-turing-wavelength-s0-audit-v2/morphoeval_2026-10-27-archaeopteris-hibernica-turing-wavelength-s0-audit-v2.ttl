<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Archaeopteris hibernica Famennian epidermal Turing wavelength (31 µm, 370 Ma) — Code-to-model traceability: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Each modelling step is its own function, and the Lean module proves 6*31 = 186, 21 < 31 < 66, and Dv/Du = 24 with no sorry. The module states that gamma was solved for argmax sigma, not for the band-center formula." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-code-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-code-traceability-2> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Archaeopteris hibernica Famennian epidermal Turing wavelength (31 µm, 370 Ma) — Model fidelity to source: 90/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Schnakenberg kinetics, pseudospectral diffusion, and k_c = argmax sigma(k) are implemented and distinguished from the textbook band center. The equal-diffusion control is now integrated long enough for the slowest stable mode to fall to an amplitude ratio of 0.246, and it does not satisfy the Turing inequalities." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteris-hibernica-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 9e-01 ;
    pk:hasVerdict "faithful" .


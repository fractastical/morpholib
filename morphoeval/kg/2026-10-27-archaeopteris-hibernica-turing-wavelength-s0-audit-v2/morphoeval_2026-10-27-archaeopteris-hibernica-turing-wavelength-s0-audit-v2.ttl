<https://w3id.org/delphi/resource/math-law/delphi10000-archaeopteris-hibernica-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg Jacobian at the Famennian steady state" ;
    dct:description "Diffusion-driven cross is positive, so the homogeneous epidermis is Turing-unstable | Variables: a=0.118, b=0.764, Du=3.10, Dv=74.40" ;
    dct:source "Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0; Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-archaeopteris-hibernica-turing-wavelength-s0.py#L77-L112>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3119_archaeopteris_hibernica_turing_wavelength_s0.lean#L36-L42> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "f_u = -1 + 2b/(a+b), g_v = -(a+b)^2, trace = f_u + g_v < 0, det = f_u g_v - f_v g_u > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/j.1537-2197.1957.tb10551.x>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/19516>,
        <https://doi.org/10.1086/337763>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1666/0094-8373(2002)028%3C0070:EODPAT%3E2.0.CO;2> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3119.turingCrossProxy" ;
    pk:leanTheorem "MathOfBiology.Loop_3119.diffusionDrivenCrossPositive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-archaeopteris-hibernica-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Fastest-growing epidermal wavelength" ;
    dct:description "Selects the ocellus spacing on the planated Famennian lamina | Variables: domain 186 um holds 6 waves of 31 um" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-archaeopteris-hibernica-turing-wavelength-s0.py#L87-L122>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3119_archaeopteris_hibernica_turing_wavelength_s0.lean#L14-L16> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c = argmax sigma(k), lambda_c = 2*pi/k_c = 31 um" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/j.1537-2197.1957.tb10551.x>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/19516>,
        <https://doi.org/10.1086/337763>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1666/0094-8373(2002)028%3C0070:EODPAT%3E2.0.CO;2> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3119.domainHoldsSixWavelengths" ;
    pk:leanTheorem "MathOfBiology.Loop_3119.domainHoldsSixWavelengths" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-archaeopteris-hibernica-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Planation chronoseries of the wavelength" ;
    dct:description "States what changes at this scale and age relative to the unplanated predecessor and the thinner cupulate successor | Variables: Tetraxylopteris 66 um (385 Ma), Archaeopteris hibernica 31 um (370 Ma), Elkinsia 21 um (365 Ma)" ;
    dct:source "Boyce and Knoll (2002) DOI:10.1666/0094-8373(2002)028%3C0070:EODPAT%3E2.0.CO;2" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-archaeopteris-hibernica-turing-wavelength-s0.py#L125-L128>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3119_archaeopteris_hibernica_turing_wavelength_s0.lean#L24-L28> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda(h) = 31*(h/12.4)^0.62; 21 um < 31 um < 66 um" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/j.1537-2197.1957.tb10551.x>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/19516>,
        <https://doi.org/10.1086/337763>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1666/0094-8373(2002)028%3C0070:EODPAT%3E2.0.CO;2> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3119.planationThenMiniaturization" ;
    pk:leanTheorem "MathOfBiology.Loop_3119.planationThenMiniaturization" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .

<https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
    rdfs:label "Grok 4.7 (builder-assessor, pass 2)" ;
    dct:identifier "grok-4.7" ;
    prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .


    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1016/j.asd.2006.06.003> dct:title "Structure and development of onychophoran eyes" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The Chemical Basis of Morphogenesis" .
    <https://doi.org/10.1242/jeb.175802> dct:title "Low-resolution vision in a velvet worm (Onychophora)" .
    <https://doi.org/10.1371/journal.pcbi.1008808> dct:title "Modelling the visual world of a velvet worm" .
}


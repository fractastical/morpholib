        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-euperipatoides-rowelli-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Schnakenberg k_sigma at 1.12 µm in the E. rowelli ocellus (Holocene, 0 Ma) faithfully reproduces Euperipatoides rowelli morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-euperipatoides-rowelli-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Euperipatoides rowelli specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-euperipatoides-rowelli-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-euperipatoides-rowelli-turing-wavelength-s0.py; output: docs/media/euperipatoides_rowelli_turing_wavelength_s0_comparison.png; organism: Euperipatoides rowelli; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion relation for a two-species reaction-diffusion system. | Schnakenberg 1979 kinetics du/dt = a − u + u²v, dv/dt = b − u²v. | E. rowelli ocelli are about 100 µm across, with screening pigment and a rhabdom of microvilli (Mayer 2006; Kirwan 2018; Ljungholm & Nilsson 2021). | Photoreceptor centres are about 2.5 µm apart. Kirwan 2018 figures microvilli with a 1 µm scale bar.; reconstructed_in_script: γ is solved so argmax σ(k) = 2π × 14. Sub-bin DCT power peaks at 14.072 cycles (1.114 µm). | In-band max Re σ is +8571 (full), −5662 (Du = Dv), and −22114 (Dv < Du). | Orientation-histogram L1 between the Couch photograph and the GIF last frame is 0.0134. | N = 89 detail wavelengths across a 100 µm eye at 0 Ma, versus N = 0 below a 10 µm Cambrian floor.; transfer_boundary: 1.12 µm is the assigned detail scale, not a Turing wavelength measured by those papers. | The 15.68 µm patch is magnified onto the body mask for display. Macroscopic annuli are not assigned period 1.12 µm.; does_not_claim: That the 0.5% residual between 1.114 µm and 1.12 µm is zero. | That the Couch photograph is an electron micrograph at 1.12 µm. | A successor chronospecies, or a second assessor. | Cryptographic nanopub signatures (no local nanopub profile).]; phenomenon_size: 1.1 µm (1.131e-06 m, log10=-5.947 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.1 µm to 2.5 mm): 1.1 µm:euperipatoides-rowelli-bioelectric-polarity, 3.5 µm:euperipatoides-rowelli-vertex-packing, 57 µm:euperipatoides-rowelli-turing-wavelength, 113 µm:euperipatoides-rowelli-clock-wavefront, 254 µm:euperipatoides-rowelli-morphogen-condensation, 311 µm:euperipatoides-rowelli-elastic-buckling, 354 µm:euperipatoides-rowelli-flux-canalization, 495 µm:euperipatoides-rowelli-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/j.asd.2006.06.003>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1242/jeb.175802>,
            <https://doi.org/10.1371/journal.pcbi.1008808> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-euperipatoides-rowelli-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-euperipatoides-rowelli-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


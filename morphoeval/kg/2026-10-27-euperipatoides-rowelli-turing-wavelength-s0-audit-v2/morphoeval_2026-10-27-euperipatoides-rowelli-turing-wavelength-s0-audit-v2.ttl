<https://w3id.org/delphi/resource/evidence/2026-10-27-euperipatoides-rowelli-turing-wavelength-s0-audit-v2-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-1> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "continuum vs explicit-PDE dispersion Pearson r" ;
    dct:description "corrcoef of σ(k) on modes 3..31; eigenvector-seeded explicit periodic linearization" ;
    dct:source "Turing 1952 continuum dispersion (identity fit would be r = 1)" ;
    rdfs:comment "RMSE of growth rate = 1170.7; KS statistic = 0.0690" ;
    prov:wasGeneratedBy "script" ;
    schema:about "Euperipatoides rowelli" ;
    schema:error 8.5e-01 ;
    schema:targetValue 1e+00 ;
    schema:unitText "Pearson r" ;
    schema:value 9.915e-01 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-euperipatoides-rowelli-turing-wavelength-s0-audit-v2-delphi10000-euperipatoides-rowelli-turing-wavelength-s0-2> a schema:QuantitativeValue,

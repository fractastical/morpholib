<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-euperipatoides-rowelli-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-euperipatoides-rowelli-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-euperipatoides-rowelli-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-euperipatoides-rowelli-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing fastest-mode wavenumber" ;
    dct:description "Primary wavelength-selection law at the 1.12 µm detail scale | Variables: lambda = 1120 nm; k_sigma = 2*pi/lambda on the calibrated domain" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-euperipatoides-rowelli-turing-wavelength-s0.py#L71-L99>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3223_euperipatoides_rowelli_turing_wavelength_s0.lean#L14-L32> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_sigma = argmax_k sigma(k), sigma from eig(gamma*J - k^2 diag(Du, Dv))" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.asd.2006.06.003>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/jeb.175802>,
        <https://doi.org/10.1371/journal.pcbi.1008808> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3223.detailWavelengthNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3223.detail_wavelength_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-euperipatoides-rowelli-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail wavelength is finer than the receptor pitch" ;
    dct:description "Separates this detail scale from the coarser hexagonal receptor lattice | Variables: receptor pitch 2.5 µm (Ljungholm & Nilsson 2021); detail wavelength 1.12 µm" ;
    dct:source "Ljungholm & Nilsson 2021 DOI:10.1371/journal.pcbi.1008808" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-euperipatoides-rowelli-turing-wavelength-s0.py#L60-L80>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3223_euperipatoides_rowelli_turing_wavelength_s0.lean#L16-L36> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "1120 nm < 2500 nm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.asd.2006.06.003>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/jeb.175802>,
        <https://doi.org/10.1371/journal.pcbi.1008808> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3223.receptorPitchNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3223.detail_scale_finer_than_receptor_pitch" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-euperipatoides-rowelli-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Holocene mode count versus the Cambrian predecessor" ;
    dct:description "What changes at 0 Ma relative to the unresolved predecessor; no successor (chronoseries 1/1) | Variables: eye diameter 100 µm; Cambrian resolution floor 10 µm" ;
    dct:source "Kirwan et al. 2018 DOI:10.1242/jeb.175802; eye size from DOI:10.1371/journal.pcbi.1008808" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-euperipatoides-rowelli-turing-wavelength-s0.py#L197-L215>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3223_euperipatoides_rowelli_turing_wavelength_s0.lean#L25-L44> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = floor(eye_nm / lambda_nm) = 89 at 0 Ma; N = 0 below a 10 µm fossil floor" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.asd.2006.06.003>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/jeb.175802>,
        <https://doi.org/10.1371/journal.pcbi.1008808> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3223.wavelengthsAcross" ;
    pk:leanTheorem "MathOfBiology.Loop_3223.holocene_eye_spans_eighty_nine_detail_wavelengths" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


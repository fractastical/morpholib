        dct:description "Vendors `datasets/auxin_pin1_phyllotaxis/` with 5 primary BibTeX entries and verified DOIs (`10.1073/pnas.0509839103`, `10.1073/pnas.0510457103`, `10.1038/nature02081`, `10.1016/j.cub.2005.09.052`, `10.1073/pnas.0510430103`), `scout_manifest.json`, `auxin_pin1_phyllotaxis_reference.json`, and `rosette_phyllotaxis_specimen.jpg`, all verified at runtime via SHA-256 checksums (`verify_dataset_integrity`, L73-93)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-source-traceability-2> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L73–L93" ;
        dct:description "Runtime SHA-256 checksum verification of all 4 dataset files" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py#L73-L93> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/auxin_pin1_phyllotaxis/auxin_pin1_phyllotaxis_reference.json L1–L135" ;
        dct:description "SHA-256-locked reference dataset with 4 phyllotactic regimes and NPA/IAA benchmarks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/datasets/auxin_pin1_phyllotaxis/auxin_pin1_phyllotaxis_reference.json#L1-L135> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

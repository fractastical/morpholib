        dct:title "Patterns of auxin transport and gene expression during primordium development revealed by live imaging of the Arabidopsis inflorescence meristem" .
    <https://doi.org/10.1038/nature02081> dct:date "2003"^^xsd:gYear ;
        dct:title "Regulation of phyllotaxis by polar auxin transport" .
    <https://doi.org/10.1073/pnas.0509839103> dct:date "2006"^^xsd:gYear ;

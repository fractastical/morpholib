sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-jonsson-auxin-pin1-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) up-the-gradient PIN1 polarization and polar auxin transport model for shoot apical meristem phyllotaxis — Code-to-model traceability: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Module and function docstrings map every equation to Jönsson et al. (2006) PNAS Eqs. 1-4 & Figs. 2-4, Smith et al. (2006) PNAS Eqs. 1-3 & Figs. 3-5, Reinhardt et al. (2003) Nature Figs. 1-2, and the 3 formal Lean 4 theorems in `morphoeval/lean/loops/Loop_032_auxin_pin1_phyllotaxis.lean` (L1-36, L102-230)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-code-traceability-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L1–L36" ;
        dct:description "Explicit equation-to-paper and Lean 4 theorem traceability in module docstring" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py#L1-L36> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 032 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


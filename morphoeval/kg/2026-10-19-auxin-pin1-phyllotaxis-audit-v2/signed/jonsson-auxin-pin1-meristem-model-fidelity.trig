sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-jonsson-auxin-pin1-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) up-the-gradient PIN1 polarization and polar auxin transport model for shoot apical meristem phyllotaxis — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements Boltzmann up-the-gradient PIN1 membrane allocation and linearized Turing-like dispersion eigenvalues (`evaluate_up_gradient_dispersion_and_allocation`, L102-182), a 180-cell 2D L1 shoot apical meristem coupled Auxin-PIN1 ODE integrator (`simulate_2d_sam_auxin_pin1_phyllotaxis`, L188-348), 4-regime phyllotactic mode transitions across Gamma = R_PZ / lambda_0 (`simulate_four_phyllotactic_modes`, L354-441), and NPA/pin1 block + exogenous IAA microdroplet rescue (`simulate_npa_and_iaa_rescue_experiments`, L447-531), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_032_auxin_pin1_phyllotaxis.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L102–L348" ;
        dcterms:description "Boltzmann PIN1 allocation, Turing-like dispersion relation, and 180-cell 2D SAM L1 Auxin-PIN1 ODE solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py#L102-L348> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L354–L531" ;
        dcterms:description "4 phyllotactic mode transitions (Spiral, Distichous, Decussate, Tricussate) and NPA/IAA perturbation experiments" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py#L354-L531> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_032_auxin_pin1_phyllotaxis.lean L14–L110" ;
        dcterms:description "3 machine-checked Lean 4 theorems for PIN1 allocation, antisymmetric flux conservation, and up-the-gradient instability / NPA collapse (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/morphoeval/lean/loops/Loop_032_auxin_pin1_phyllotaxis.lean#L14-L110> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 032 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


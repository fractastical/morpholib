sub1:provenance {
    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/32> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cub.2005.09.052>,
            <https://doi.org/10.1038/nature02081>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103> .

    <https://doi.org/10.1016/j.cub.2005.09.052> dcterms:date "2005"^^xsd:gYear ;
        dcterms:title "Patterns of auxin transport and gene expression during primordium development revealed by live imaging of the Arabidopsis inflorescence meristem" .

    <https://doi.org/10.1038/nature02081> dcterms:date "2003"^^xsd:gYear ;
        dcterms:title "Regulation of phyllotaxis by polar auxin transport" .

    <https://doi.org/10.1073/pnas.0509839103> dcterms:date "2006"^^xsd:gYear ;
        dcterms:title "An auxin-driven polarized transport model for phyllotaxis" .

    <https://doi.org/10.1073/pnas.0510457103> dcterms:date "2006"^^xsd:gYear ;
        dcterms:title "A plausible model of phyllotaxis" .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-jonsson-auxin-pin1-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) up-the-gradient PIN1 polarization and polar auxin transport model for shoot apical meristem phyllotaxis — Morphometric validation: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L748-825) computes 9 reference-anchored morphometric measurements with uncertainty, p-values, and negative controls, all 9 within 3.2% of reference benchmarks: spiral divergence angle 137.39 ± 1.24 deg (ref 137.51), characteristic spacing wavelength 5.196 cells (ref 5.2), critical PIN1 feedback threshold c_1*a_0 = 1.7500 (ref 1.75), PIN1 convergence polarity index 0.8527 (ref 0.84), 4-mode divergence angle Pearson r = 1.0000 (p = 2.23e-5, RMSE = 0.24 deg), NPA polar transport block contrast 1.0000 (ref 1.0, 0 primordia), exogenous IAA paste rescue peak angle 60.00 deg (ref 60.0 deg, 0.00 deg error), rosette azimuthal sector coverage 1.0000 (ref 1.0), and leaf spacing regularity 1 - CV = 0.7737 (ref 0.75)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-characteristic-primordium-spacing-wavelength>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-critical-pin1-feedback-threshold-c1-a0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-exogenous-iaa-paste-rescue-peak-angle>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-four-mode-divergence-angle-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-npa-polar-transport-block-contrast>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-primordium-convergence-polarity-index>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-specimen-rosette-azimuthal-sector-coverage>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-specimen-rosette-leaf-spacing-regularity-1-minus-cv>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-spiral-phyllotaxis-divergence-angle-mean>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-morphometric-validation-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-characteristic-primordium-spacing-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "characteristic_primordium_spacing_wavelength = 5.196 cells" ;
        schema:measurementTechnique "Linearized dispersion eigenvalue peak k_max*l_0 = 1.2093 rad/cell (sigma_max = 0.2017 h^-1, lambda_c = 36.37 um)" ;
        schema:name "characteristic_primordium_spacing_wavelength" ;
        schema:unitText "cells" ;
        schema:value "5.196" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-characteristic-primordium-spacing-wavelength-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-characteristic-primordium-spacing-wavelength-reference> a schema:PropertyValue ;
        dcterms:source "Jönsson et al. (2006) PNAS 103:1633-1638 pp. 1635-1636 & Fig. 2 linear Turing-like dispersion peak wavelength (~5.2 cells / 36.4 um)" ;
        schema:value "5.2" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-critical-pin1-feedback-threshold-c1-a0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical_pin1_feedback_threshold_c1_a0 = 1.75 dimensionless" ;
        schema:measurementTechnique "Exact linear stability threshold where D_eff_scaled = -2.3400 < 0 (Lean 4 Law 3 verified)" ;
        schema:name "critical_pin1_feedback_threshold_c1_a0" ;
        schema:unitText "dimensionless" ;
        schema:value "1.75" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-critical-pin1-feedback-threshold-c1-a0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-critical-pin1-feedback-threshold-c1-a0-reference> a schema:PropertyValue ;
        dcterms:source "Jönsson et al. (2006) PNAS 103:1633-1638 Eq. 1-4 bifurcation threshold c_1*a_0 = 1 + z*D/(T*P_i) = 1.75 (operating c_1*a_0 = 3.70)" ;
        schema:value "1.75" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-exogenous-iaa-paste-rescue-peak-angle> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "exogenous_iaa_paste_rescue_peak_angle = 60.0 deg" ;
        schema:measurementTechnique "Exogenous IAA source at phi_paste = 60.0 deg on NPA/pin1 ring (angular localization error = 0.00 deg, rescued primordia = 1, contrast = 2.73)" ;
        schema:name "exogenous_iaa_paste_rescue_peak_angle" ;
        schema:unitText "deg" ;
        schema:value "60.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-exogenous-iaa-paste-rescue-peak-angle-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-exogenous-iaa-paste-rescue-peak-angle-reference> a schema:PropertyValue ;
        dcterms:source "Reinhardt et al. (2003) Nature 426:255-260 Fig. 2 & Smith et al. (2006) PNAS Fig. 5 localized IAA microapplication rescues single primordium at paste site (60.0 deg)" ;
        schema:value "60.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-four-mode-divergence-angle-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "four_mode_divergence_angle_pearson_r = 1.0 r" ;
        schema:measurementTechnique "Pearson correlation across all 4 phyllotactic Gamma regimes (r = 1.0000, p = 2.23e-05, RMSE = 0.24 deg)" ;
        schema:name "four_mode_divergence_angle_pearson_r" ;
        schema:unitText "r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-four-mode-divergence-angle-pearson-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-four-mode-divergence-angle-pearson-r-reference> a schema:PropertyValue ;
        dcterms:source "Smith et al. (2006) PNAS 103:1301-1306 Figs. 3-4 transitions across Spiral (137.5 deg), Distichous (180 deg), Decussate (90 deg), and Tricussate (120 deg) modes" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-npa-polar-transport-block-contrast> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "npa_polar_transport_block_contrast = 1.0 ratio" ;
        schema:measurementTechnique "Negative perturbation control T = 0.0 h^-1 (primordia count = 0 vs WT 5, WT contrast = 2.28)" ;
        schema:name "npa_polar_transport_block_contrast" ;
        schema:unitText "ratio" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-npa-polar-transport-block-contrast-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-npa-polar-transport-block-contrast-reference> a schema:PropertyValue ;
        dcterms:source "Reinhardt et al. (2003) Nature 426:255-260 Fig. 1 (10 uM NPA or pin1-1 mutant abolishes auxin maxima -> bare pin-formed apex with contrast 1.0 and 0 primordia)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-primordium-convergence-polarity-index> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pin1_primordium_convergence_polarity_index = 0.8527 index" ;
        schema:measurementTechnique "Mean cosine alignment of cellular PIN1 polarity vectors toward peripheral ring auxin maxima (PIN1 pool conservation err = 4.44e-16, flux err = 1.69e-14)" ;
        schema:name "pin1_primordium_convergence_polarity_index" ;
        schema:unitText "index" ;
        schema:value "0.8527" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-primordium-convergence-polarity-index-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-pin1-primordium-convergence-polarity-index-reference> a schema:PropertyValue ;
        dcterms:source "Heisler et al. (2005) Curr. Biol. 15:1899-1911 & Jönsson et al. (2006) PNAS Fig. 3 PIN1 efflux convergence toward nascent primordia" ;
        schema:value "0.84" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-specimen-rosette-azimuthal-sector-coverage> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_rosette_azimuthal_sector_coverage = 1.0 fraction" ;
        schema:measurementTechnique "ExG + DoG segmentation of N = 410 imbricated rosette leaves around SAM center (651.5, 563.1) px" ;
        schema:name "specimen_rosette_azimuthal_sector_coverage" ;
        schema:unitText "fraction" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-specimen-rosette-azimuthal-sector-coverage-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-specimen-rosette-azimuthal-sector-coverage-reference> a schema:PropertyValue ;
        dcterms:source "File:Aeonium tabuliforme 0.jpg (Wikimedia Commons CC BY-SA 3.0) full 360-deg spiral rosette leaf coverage across 12 azimuthal sectors" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-specimen-rosette-leaf-spacing-regularity-1-minus-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_rosette_leaf_spacing_regularity_1_minus_cv = 0.7737 index" ;
        schema:measurementTechnique "Nearest-neighbor Euclidean distance distribution across 410 segmented rosette leaves (mean = 23.4 px, CV = 0.2263)" ;
        schema:name "specimen_rosette_leaf_spacing_regularity_1_minus_cv" ;
        schema:unitText "index" ;
        schema:value "0.7737" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-specimen-rosette-leaf-spacing-regularity-1-minus-cv-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-specimen-rosette-leaf-spacing-regularity-1-minus-cv-reference> a schema:PropertyValue ;
        dcterms:source "Smith et al. (2006) PNAS & Aeonium tabuliforme spiral rosette nearest-neighbor leaf packing regularity (1 - CV ~ 0.75)" ;
        schema:value "0.75" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-spiral-phyllotaxis-divergence-angle-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "spiral_phyllotaxis_divergence_angle_mean = 137.39 deg" ;
        schema:measurementTechnique "180-cell 2D SAM L1 Auxin-PIN1 ODE integration across P1..P8 (mean = 137.39 ± 1.24 deg SD)" ;
        schema:name "spiral_phyllotaxis_divergence_angle_mean" ;
        schema:unitText "deg" ;
        schema:value "137.39" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-spiral-phyllotaxis-divergence-angle-mean-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-measurement-spiral-phyllotaxis-divergence-angle-mean-reference> a schema:PropertyValue ;
        dcterms:source "Jönsson et al. (2006) PNAS 103:1633-1638 Fig. 4 & Smith et al. (2006) PNAS 103:1301-1306 Fig. 3 golden divergence angle 137.5078 deg" ;
        schema:value "137.51" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L748–L825" ;
        dcterms:description "9 reference-anchored morphometric measurements with Pearson p-value, SD, RMSE, and NPA/IAA controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py#L748-L825> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 032 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


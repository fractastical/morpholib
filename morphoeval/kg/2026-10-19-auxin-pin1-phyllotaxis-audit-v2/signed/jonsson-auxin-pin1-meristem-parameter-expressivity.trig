sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-jonsson-auxin-pin1-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L354–L441" ;
        dcterms:description "4-regime Gamma sweep across Spiral, Distichous, Decussate, and Tricussate phyllotaxis" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py#L354-L441> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py L870–L909" ;
        dcterms:description "CLI parameter overrides wired into dispersion and 2D SAM ODE solvers" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py#L870-L909> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 032 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) up-the-gradient PIN1 polarization and polar auxin transport model for shoot apical meristem phyllotaxis — Parameter expressivity: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates 4 phyllotactic mode regimes spanning Gamma in [0.85, 2.75] and R_PZ in [20.5, 66.5] um (L354-441), 3 pharmacological/genetic perturbation regimes (Wild-Type, 10 uM NPA / pin1-1 block, and NPA + 1 mM IAA paste rescue, L447-531), and exposes `--T-polar`, `--D-diff`, `--c1-gain`, `--rho0`, `--mu`, and `--seed` CLI overrides (L870-909)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-jonsson-auxin-pin1-meristem-parameter-expressivity-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-jonsson-auxin-pin1-meristem> a pk:Claim ;
        rdfs:label "Jönsson et al. (2006) & Smith et al. (2006) up-the-gradient PIN1 polarization and polar auxin transport model for shoot apical meristem phyllotaxis faithfully reproduces Arabidopsis thaliana & Aeonium tabuliforme (shoot apical meristem L1 epidermis & spiral rosette phyllotaxis) morphology" ;
        dct:description "The simulation script(s) 2006-jonsson-auxin-pin1-meristem.py implement the cited source model as published and produce forms that match real Arabidopsis thaliana & Aeonium tabuliforme (shoot apical meristem L1 epidermis & spiral rosette phyllotaxis) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 92.6/100, audit 2026-10-19-auxin-pin1-phyllotaxis-audit-v2) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py; output: docs/media/auxin_pin1_phyllotaxis_comparison.png; organism: Arabidopsis thaliana & Aeonium tabuliforme (shoot apical meristem L1 epidermis & spiral rosette phyllotaxis); checkpoint commit: https://github.com/fractastical/morpholib/commit/0cb0132; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 722bfcfebddd9b7a82c1bd7b9d04a028378c8556fe894a24ae273b6224593820; artifact_sha256: 2483a59dbe5c97908675265d8ad4343d749f55da5ee5843266ac3bd2ee0c8541; input_dataset_sha256: {datasets/auxin_pin1_phyllotaxis/auxin_pin1_phyllotaxis_reference.json=96d4b539eaaf1649..., datasets/auxin_pin1_phyllotaxis/paper_citations.bib=9fe96650b32df64b..., datasets/auxin_pin1_phyllotaxis/rosette_phyllotaxis_specimen.jpg=ec50801b52dabc46..., datasets/auxin_pin1_phyllotaxis/scout_manifest.json=2e474ee5544f04f4...}; supersedes_audit_id: 2026-10-19-auxin-pin1-phyllotaxis-audit; claim_boundary: [reported_in_source: Jönsson et al. (2006) PNAS 103:1633-1638 & Smith et al. (2006) PNAS 103:1301-1306 up-the-gradient Boltzmann PIN1 membrane cycling P_ij = P_i exp(c_1 a_j) / sum_k exp(c_1 a_k) and intercellular active polar + diffusive auxin transport generating periodic convergence maxima separated by characteristic wavelength lambda_c | Transitions across spiral Fibonacci (137.5 deg), distichous alternate (180 deg), decussate opposite (90 deg), and tricussate whorled (120 deg) phyllotactic regimes as a function of meristem peripheral ring-to-spacing ratio Gamma, plus Reinhardt et al. (2003) Nature NPA/pin1 pin-formed block and exogenous IAA paste microapplication rescue; reconstructed_in_script: Linearized Turing-like up-the-gradient dispersion relation sigma(k) verifying critical feedback threshold c_1*a_0 = 1.75 (operating 3.70), characteristic spacing lambda_c = 5.196 cells (36.37 um), and complete mode stabilization under NPA/pin1 block (T = 0) | 180-cell 2D L1 shoot apical meristem dome coupled Auxin-PIN1 ODE integrator verifying cellular PIN1 pool conservation (err < 1e-15), antisymmetric intercellular flux conservation (err < 2e-14), PIN1 convergence polarity index 0.8527 (ref 0.84), and golden divergence angle 137.39 ± 1.24 deg (ref 137.51 deg) | 4-regime phyllotactic mode transitions across Gamma in {0.85, 1.45, 1.92, 2.75} reproducing Spiral (137.5 deg), Distichous (179.5 deg), Decussate (89.9 deg), and Tricussate (120.1 deg) divergence angles (Pearson r = 1.0000, p = 2.23e-5, RMSE = 0.24 deg) | NPA/pin1-1 polar transport block negative control (0 primordia, contrast 1.0000) and localized exogenous IAA paste rescue at phi = 60.0 deg (1 rescued primordium at 60.0 deg, contrast 2.73), plus ExG + DoG segmentation of 410 imbricated rosette leaves in Aeonium tabuliforme (`rosette_phyllotaxis_specimen.jpg`); transfer_boundary: 2D planar L1 epidermal dome lattice and peripheral ring reaction-transport ODEs mapped to top-down spiral rosette phyllotaxis; does_not_claim: Full 3D intracellular vesicle trafficking kinetics of PIN1 endosomal recycling or sub-cellular PIN1 phosphorylation cascades]" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.cub.2005.09.052>,
            <https://doi.org/10.1038/nature02081>,
            <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1073/pnas.0510457103> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-jonsson-auxin-pin1-meristem-specimen-match> ;
        pk:weightOfEvidence "0.926"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/0cb0132/2006-jonsson-auxin-pin1-meristem.py> a schema:SoftwareSourceCode ;
        rdfs:label "2006-jonsson-auxin-pin1-meristem.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "0cb0132" .
}


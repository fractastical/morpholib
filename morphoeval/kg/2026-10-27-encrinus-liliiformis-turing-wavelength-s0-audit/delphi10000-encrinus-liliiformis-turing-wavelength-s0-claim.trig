sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Encrinus liliiformis Schnakenberg wavelength at 12 nm (Muschelkalk, 240 Ma) faithfully reproduces Encrinus liliiformis morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-encrinus-liliiformis-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Encrinus liliiformis specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-encrinus-liliiformis-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-encrinus-liliiformis-turing-wavelength-s0.py; output: docs/media/encrinus_liliiformis_turing_wavelength_s0_growth.gif; organism: Encrinus liliiformis; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion relation and Schnakenberg 1979 kinetics. | Stolarski et al. 2009: crinoid stereom nanograins about 100 nm, gaps of a few nm, on Jurassic isocrinids.; reconstructed_in_script: Diffusivities that put onset lambda_c at 12 nm for this (a, b, delta), plus the 248/240/232 Ma ordering. | Galerkin harmonics of the stereom radial luminance and the sepia growth GIF.; transfer_boundary: The 100 nm nanograin window is transferred from Jurassic isocrinids to a Muschelkalk Encrinus detail scale. It is not a TEM of this fossil.; does_not_claim: Does not claim the Ingelfingen photograph was taken at 12 nm. | Does not claim the gallery stereom rendering (scale bar 100 um) is a micrograph at this scale.]; phenomenon_size: 12 nm (1.224e-08 m, log10=-7.912 m, tier=1_molecular_nm); species_scale_ladder (10 runs from 12 nm to 28 µm): 12 nm:encrinus-liliiformis-bioelectric-polarity, 38 nm:encrinus-liliiformis-vertex-packing, 612 nm:encrinus-liliiformis-turing-wavelength, 1.2 µm:encrinus-liliiformis-clock-wavefront, 2.8 µm:encrinus-liliiformis-morphogen-condensation, 3.4 µm:encrinus-liliiformis-elastic-buckling, 3.8 µm:encrinus-liliiformis-flux-canalization, 5.4 µm:encrinus-liliiformis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.4202/app.2009.0108> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-encrinus-liliiformis-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-encrinus-liliiformis-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.4202/app.2009.0108> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.4202/app.2009.0108> dct:date "2009"^^xsd:gYear ;
        dct:title "Nanostructural and geochemical features of the Jurassic isocrinid columnal ossicles" .
}


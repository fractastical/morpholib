            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-measurement-ablation-sigma-max-equal-diffusion> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_sigma_max_equal_diffusion = -0.25916667 1/s" ;
        dct:description "control vs patterned sigma_max" ;
        schema:measurementTechnique "negative control: D_v set equal to D_u, Turing drive lost" ;
        schema:name "ablation_sigma_max_equal_diffusion" ;
        schema:unitText "1/s" ;
        schema:value "-0.25916667" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-measurement-ablation-sigma-max-equal-diffusion-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-measurement-ablation-sigma-max-equal-diffusion-reference> a schema:PropertyValue ;
        schema:value "0.29622236" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-measurement-analytical-turing-wavelength-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "analytical_turing_wavelength_m = 1.238e-08 m" ;
        dct:description "value is the 12 nm law; reference is the macromolecular sibling, not this run" ;
        schema:measurementTechnique "lambda_c = 2*pi/k_c from Schnakenberg Jacobian at a=0.047, b=1.153, delta=22.4" ;
        schema:name "analytical_turing_wavelength_m" ;
        schema:unitText "m" ;
        schema:value "1.238e-08" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-measurement-analytical-turing-wavelength-m-reference> .

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Encrinus liliiformis Schnakenberg wavelength at 12 nm (Muschelkalk, 240 Ma) — Morphometric validation: 74/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "In-sample Pearson r is 0.9996 and RMSE is 0.0031, but the pixel dark-mask IoU against the stereom target is 0.17. That mask is the wrong segmentation for a captioned image. Fossil coherency is measured and is not equal to the render." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-measurement-ablation-sigma-max-equal-diffusion>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-measurement-analytical-turing-wavelength-m>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-measurement-chronoseries-predecessor-wavelength-m>,

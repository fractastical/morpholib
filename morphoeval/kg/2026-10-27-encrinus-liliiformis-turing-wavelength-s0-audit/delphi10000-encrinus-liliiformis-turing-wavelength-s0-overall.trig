sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-encrinus-liliiformis-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Encrinus liliiformis Schnakenberg wavelength at 12 nm (Muschelkalk, 240 Ma) — MorphoEval overall 78.2/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Onset k_c is placed at 1.238e-8 m with a=0.047, b=1.153, delta=22.4. Self-test Pearson r of the stereom radial profile is 0.9996 and the GIF versus the Ingelfingen slab scores CV 84.6. Pixel dark-mask IoU is only 0.17. Overall 78.2/100 (faithfulness 75.7, reproducibility 84.1); rubric morphoeval 0.1.0; checkpoint commit cd3c0ff20113e2850a5dd72a24dfd8d4e782b322; environment: . Dimension assessments: Model fidelity to source 84, Morphological realism / specimen match 70, Parameter expressivity 76, Morphometric validation 74, Source and data traceability 90, Code-to-model traceability 80, Reproducibility package 82. Output judged: docs/media/encrinus_liliiformis_turing_wavelength_s0_growth.gif: rendered output of models/2026-delphi10000-encrinus-liliiformis-turing-wavelength-s0.py at cd3c0ff20113e2850a5dd72a24dfd8d4e782b322, image/gif, 5571040 B, 800×600 px, 16 frames, artifact_sha256 09eee2d7b66bd8fe3c77aee2224877d1ebce42c9ce3d8caed73c1689de198c99 (sha256 09eee2d7b66bd8fe3c77aee2224877d1ebce42c9ce3d8caed73c1689de198c99), spec_fingerprint a01502a8a9ccbc4b5251448c56820781f74c49be8d38d864003cd60c668e74f1. Dual provenance: spec_fingerprint: a01502a8a9ccbc4b5251448c56820781f74c49be8d38d864003cd60c668e74f1; artifact_sha256: 09eee2d7b66bd8fe3c77aee2224877d1ebce42c9ce3d8caed73c1689de198c99; input_dataset_sha256: {datasets/encrinus_liliiformis_turing_wavelength_s0/encrinus_liliiformis_specimen.jpg=9bb90bc584ae7e85..., datasets/encrinus_liliiformis_turing_wavelength_s0/encrinus_liliiformis_stereom_gyroid_canonical.jpg=d19f3b6e48018c2d..., datasets/encrinus_liliiformis_turing_wavelength_s0/encrinus_liliiformis_turing_wavelength_s0_reference.json=64d02f82520a1b3a..., datasets/encrinus_liliiformis_turing_wavelength_s0/paper_citations.bib=160e70968df139fb...}. Claim boundary: reported_in_source: Turing 1952 dispersion relation and Schnakenberg 1979 kinetics. | Stolarski et al. 2009: crinoid stereom nanograins about 100 nm, gaps of a few nm, on Jurassic isocrinids.; reconstructed_in_script: Diffusivities that put onset lambda_c at 12 nm for this (a, b, delta), plus the 248/240/232 Ma ordering. | Galerkin harmonics of the stereom radial luminance and the sepia growth GIF.; transfer_boundary: The 100 nm nanograin window is transferred from Jurassic isocrinids to a Muschelkalk Encrinus detail scale. It is not a TEM of this fossil.; does_not_claim: Does not claim the Ingelfingen photograph was taken at 12 nm. | Does not claim the gallery stereom rendering (scale bar 100 um) is a micrograph at this scale.." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "open need [specimen_comparison/morphometric-validation, pressure P=1.5]: Pixel IoU 0.17 is not a registered annulus. Use the radial-bin sign agreement already computed on the same profile.",
            "remediation needed: Independent second assessor was not run.",
            "remediation needed: Re-score the delta sweep and the equal-diffusion ablation once that segmentation is the one the audit uses.",
            "remediation needed: Replace the pixel dark-mask IoU (0.17) with the radial-bin sign agreement as the segmentation metric; the caption strip makes the pixel mask the wrong object." ;
        pk:hasScore "0.782"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 builder-assessor (single agent; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


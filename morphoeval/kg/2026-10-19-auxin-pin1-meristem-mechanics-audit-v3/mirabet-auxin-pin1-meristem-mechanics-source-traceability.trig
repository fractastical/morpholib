sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mirabet-auxin-pin1-meristem-mechanics> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Hamant et al. (2008) & Heisler et al. (2010) pressurized SAM shell stress tensor, cortical microtubule alignment, PIN1-auxin phyllotactic mechanics, and (Pass 3) 3D multi-layered L1/L2/L3 Voronoi cell mesh with dynamic division planes — Source and data traceability: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`datasets/auxin_pin1_meristem_mechanics/` now vendors 9 BibTeX entries with verified DOIs (5 Pass 1-2 + louveaux2016, besson2011, reddy2004, kutschera2007), a reference JSON extended with `secondary_papers_pass3` and `multilayer_mesh_parameters_pass3` (sources vs modelling assumptions labelled), the scout manifest and the unchanged CC BY-SA 4.0 specimen, all SHA-256-verified at runtime (`verify_dataset_integrity`, L112-L136; hashes re-pinned after the Pass 3 additions). The division-plane benchmarks are quoted with figure/panel provenance. Several mesh constants (k_L1/k_inner = 5, Lockhart phi, sheet depths beyond the 5 um epidermis) are stated modelling assumptions without a measured source." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-source-traceability-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L112–L136" ;
        dct:description "Runtime SHA-256 checksum verification of all 4 dataset files with the re-pinned Pass 3 hashes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L112-L136> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/auxin_pin1_meristem_mechanics/paper_citations.bib L1–L120" ;
        dct:description "9 BibTeX entries with verified DOIs including the 4 Pass 3 secondary sources" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/auxin_pin1_meristem_mechanics/paper_citations.bib#L1-L120> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/auxin_pin1_meristem_mechanics/auxin_pin1_meristem_mechanics_reference.json L1–L200" ;
        dct:description "Reference JSON with 4-zone stresses, PIN1 parameters, perturbation benchmarks, secondary_papers_pass3 and multilayer_mesh_parameters_pass3 (assumptions labelled)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/auxin_pin1_meristem_mechanics/auxin_pin1_meristem_mechanics_reference.json#L1-L200> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 033 Pass 3 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


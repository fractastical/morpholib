sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mirabet-auxin-pin1-meristem-mechanics> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Hamant et al. (2008) & Heisler et al. (2010) pressurized SAM shell stress tensor, cortical microtubule alignment, PIN1-auxin phyllotactic mechanics, and (Pass 3) 3D multi-layered L1/L2/L3 Voronoi cell mesh with dynamic division planes — Code-to-model traceability: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Module docstring maps all 5 laws to papers and to line-pinned Lean 4 theorems (L35-L79), the math KG yaml registers equations -1..-5 with lean_code and code_locus, and function docstrings cite Louveaux 2016 / Besson-Dumais 2011 / Reddy 2004 for the division rules. However the hard-coded PIN1 noise constants (0.165, 0.155, 0.62-0.92 rad; L1163-L1166), the ablation asymptote 0.918 (L1271) and the compression factor 1.48 (L1281) have no source attribution, which is what made the v2 \"matches\" look emergent." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2008-hamant-meristem-microtubule-stress.py L1163–L1166: Unattributed hard-coded PIN1 angular noise constants that determine the co-alignment statistic <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L1163-L1166>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-code-traceability-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L1–L79" ;
        dct:description "Explicit equation-to-paper and Lean 4 theorem traceability for Laws 1-5 incl. an honest statement of what the mesh is NOT" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L1-L79> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/mirabet-auxin-pin1-meristem-mechanics.yaml L1–L140" ;
        dct:description "Math KG entries -1..-5 with Lean declarations, lean_code, lean_locus and code_locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/mirabet-auxin-pin1-meristem-mechanics.yaml#L1-L140> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 033 Pass 3 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


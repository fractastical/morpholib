sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mirabet-auxin-pin1-meristem-mechanics> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Hamant et al. (2008) & Heisler et al. (2010) pressurized SAM shell stress tensor, cortical microtubule alignment, PIN1-auxin phyllotactic mechanics, and (Pass 3) 3D multi-layered L1/L2/L3 Voronoi cell mesh with dynamic division planes — Model fidelity to source: 86/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Pass 3 adds a genuine 3D multi-layered mechanical model: four-sheet Voronoi polyhedral cells with exact volumes (`_voronoi_faces`, L356-L406; volume identity checked against ConvexHull in self-test 7), wall springs with a 5x stiffer L1 (`simulate_multilayer_sam_mesh`, L513-L937), turgor on exterior faces, elastic ghost supports, Jacobi-preconditioned relaxation (L615, L686), per-cell virial tension tensor (L692-L704), Lockhart creep with background growth (L687-L690), volume-doubling division with Louveaux-2016 / Besson-Dumais-2011 anticlinal planes and 3D Gibbs corpus planes (L418-L511), and the mesh -> L1-ODE coupling (L1041-L1066), backed by 5 machine-checked Lean 4 theorems. It is explicitly NOT a finite-element vertex model (L30-L33, L653: stress-free new contacts) and fails to reproduce the radial growth of the thin-shell anisotropy magnitude (bin-mean r = -0.11, apex artefact 0.059). The Pass 2 L1 ODE still hard-codes the PIN1 angular noise model that produces the co-alignment statistic (L1163-L1166) and the perturbation module uses a fitted asymptote and a 1.48 fudge factor (L1271-L1281), so the physics v2 credited at 94 is partly phenomenological." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2008-hamant-meristem-microtubule-stress.py L1163–L1166: PIN1 polarity angle = CMT angle + N(0, 0.165) jitter, with 15.5 % 'switching cells' offset by U(0.62, 0.92) rad: the 84.9 % co-alignment is a hard-coded noise model, not an ODE outcome <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L1163-L1166>",
            "2008-hamant-meristem-microtubule-stress.py L1271–L1281: Post-ablation circumferential fraction is an exponential relaxation to a hand-tuned asymptote 0.918; lateral-compression S_CMT uses comp_aniso * 1.48 <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L1271-L1281>",
            "2008-hamant-meristem-microtubule-stress.py L653–L653: New Voronoi contacts are inserted stress-free; no vertex degrees of freedom, wall bending or cell-volume constraint anywhere in the mesh (not a FEM / vertex model) <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L653-L653>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-6> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L148–L315" ;
        dct:description "Doubly-curved pressurized shell stress tensor, CMT nematic order, anisotropic Lockhart yielding across 4 SAM zones, and the paraboloid membrane law A_sigma(r) = (1-q)/(3-q)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L148-L315> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L356–L406" ;
        dct:description "Bounded 3D Voronoi polyhedral cells with exact face areas and volumes V_i = sum A_f d_ij / 6 (Qhull)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L356-L406> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L513–L937" ;
        dct:description "3D four-sheet L1/L2/L3a/L3b turgor mechanics, Jacobi relaxation, virial tension tensor, Lockhart creep, volume-doubling division with dynamic planes, per-layer load share" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L513-L937> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L418–L511" ;
        dct:description "Louveaux (2016) tension rule n_div = n_s x e_1 with cell-autonomous turgor term, Besson-Dumais (2011) Gibbs rule beta = 20.6, and 3D Gibbs corpus rule" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L418-L511> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L1041–L1066" ;
        dct:description "Mesh L1 same-sheet virial e_1 / A_sigma replaces the Pass 2 hand-coded 0.3333 (r/45)^2 field in the 168-cell Auxin-PIN1-CMT ODE (analytic field kept as ablation)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L1041-L1066> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity-6> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_033_auxin_pin1_meristem_mechanics.lean L107–L172" ;
        dct:description "Two new Lean 4 theorems: multilayer load sharing N_1/N_total = k_1/sum k with Laplace-Young aggregate (Law 4) and tension-aligned anticlinal division plane orthogonality + Sachs volume bookkeeping (Law 5); 0 sorrys" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_033_auxin_pin1_meristem_mechanics.lean#L107-L172> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 033 Pass 3 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


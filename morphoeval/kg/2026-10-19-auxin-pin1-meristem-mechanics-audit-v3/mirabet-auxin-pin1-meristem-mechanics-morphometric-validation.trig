sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mirabet-auxin-pin1-meristem-mechanics> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hamant et al. (2008) & Heisler et al. (2010) pressurized SAM shell stress tensor, cortical microtubule alignment, PIN1-auxin phyllotactic mechanics, and (Pass 3) 3D multi-layered L1/L2/L3 Voronoi cell mesh with dynamic division planes — Morphometric validation: 84/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1885-L2054) now reports 18 reference-anchored measurements, 9 of them new: flank L1 hoop-alignment fraction 0.8072 (PASS), L1 anisotropy vs membrane-law RMSE 0.0723 and dome-centre anisotropy 0.0589 (both FAILED, reported), L1 tension load share 0.7144 vs Law 4 0.7143 (PASS, model-internal reference), tension-rule shortest-plane fraction 0.3841 vs 0.71 (FAILED, binomial p = 5e-18), symmetric fraction 0.9756 vs 0.81 (FAILED), anticlinal new-wall fraction 1.0 (PASS, by construction), L3 periclinal 0.7059 vs uninformative 0.5 prior, mesh-vs-specimen profile RMS 5.54 um (FAILED). The 9 Pass 2 metrics are retained but three of them are now caveated as tuned/identity (co-alignment 0.8491 via the imposed jitter model, ablation fraction 0.9103 via the fitted asymptote, dome radius 50.0 um identity), which removes the basis for v2's 93." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2008-hamant-meristem-microtubule-stress.py L1931–L1979: Pass 2 metrics l1_pin1_cmt_coaligned_30deg_fraction and specimen_sam_dome_calibrated_radius carry CAVEATs that the values are imposed by the jitter model / calibration identity <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L1931-L1979>",
            "2008-hamant-meristem-microtubule-stress.py L1980–L2011: Mesh validation: flank hoop alignment 0.81, L1 load share 0.7144 vs 0.7143 (Law 4), but anisotropy-vs-membrane-law RMSE 0.072 and apex anisotropy 0.059 are failed comparisons <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L1980-L2011>",
            "2008-hamant-meristem-microtubule-stress.py L2012–L2043: Division-plane statistics: shortest-plane 0.384 vs Louveaux 0.71 (p = 5e-18) and symmetric 0.976 vs 0.81 are failed comparisons; anticlinal 1.0 holds by construction <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L2012-L2043>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-cylindrical-flank-hoop-to-axial-stress-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-four-zone-cmt-nematic-order-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-l2-anticlinal-new-wall-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-l2-symmetric-division-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-l2-tension-rule-shortest-plane-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-pin1-cmt-circular-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-pin1-cmt-coaligned-30deg-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l3-corpus-periclinal-division-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-laser-ablation-rim-circumferential-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-mesh-vs-specimen-l1-profile-rms-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-multilayer-mesh-dome-centre-anisotropy>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-multilayer-mesh-flank-l1-hoop-alignment-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-multilayer-mesh-l1-anisotropy-vs-membrane-law-rmse>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-multilayer-mesh-l1-tension-load-share>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-oryzalin-depolymerization-control-nematic-order>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-phyllotactic-divergence-angle-mean>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-primordium-saddle-crease-stress-anisotropy>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-specimen-sam-dome-calibrated-radius>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-morphometric-validation-1> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-cylindrical-flank-hoop-to-axial-stress-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cylindrical_flank_hoop_to_axial_stress_ratio = 2.0 ratio" ;
        schema:measurementTechnique "Doubly-curved thin-shell Laplace-Young equilibrium (anisotropy A_sigma = 0.3333 vs exact 1/3, SD = 0.0001)" ;
        schema:name "cylindrical_flank_hoop_to_axial_stress_ratio" ;
        schema:unitText "ratio" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-cylindrical-flank-hoop-to-axial-stress-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-cylindrical-flank-hoop-to-axial-stress-ratio-reference> a schema:PropertyValue ;
        dct:source "Hamant et al. (2008) Science 322:1650-1655 Fig. 1 (sigma_theta / sigma_z = 2.0 on cylindrical stem flank)" ;
        schema:value "2.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-four-zone-cmt-nematic-order-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "four_zone_cmt_nematic_order_pearson_r = 0.9921 r" ;
        schema:measurementTechnique "Pearson correlation across 4 SAM curvature zones (r = 0.9921, p = 7.88e-03, RMSE = 0.0523 ± 0.0042)" ;
        schema:name "four_zone_cmt_nematic_order_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9921" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-four-zone-cmt-nematic-order-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-four-zone-cmt-nematic-order-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Hamant et al. (2008) Science 322:1650-1655 Figs. 1-2 regional CMT nematic order S_CMT in {0.18, 0.54, 0.72, 0.86}" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-l2-anticlinal-new-wall-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "l1_l2_anticlinal_new_wall_fraction = 1.0 fraction" ;
        schema:measurementTechnique "Fraction of L1/L2 new walls (Voronoi face between the daughters, measured after one relaxation step) whose normal makes >= 60 deg with the local outward surface normal; the plane normal n_s x e_1 is exactly anticlinal at construction (Lean Law 5), so this tests the post-relaxation geometry only" ;
        schema:name "l1_l2_anticlinal_new_wall_fraction" ;
        schema:unitText "fraction" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-l2-anticlinal-new-wall-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-l2-anticlinal-new-wall-fraction-reference> a schema:PropertyValue ;
        dct:source "Reddy et al. (2004) Development 131:4225-4237 & Louveaux et al. (2016) Fig. S2A: L1 and L2 are single clonal layers maintained by anticlinal divisions (new walls perpendicular to the surface)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-l2-symmetric-division-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "l1_l2_symmetric_division_fraction = 0.9756 fraction" ;
        schema:measurementTechnique "Fraction of L1/L2 divisions whose smaller daughter polyhedron occupies 40-50% of the two daughters' summed Voronoi volume one step after cytokinesis (Sachs/Lean Law 5 bookkeeping; summed daughter volume / mother volume = 1.292, a Voronoi re-tessellation artefact)" ;
        schema:name "l1_l2_symmetric_division_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.9756" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-l2-symmetric-division-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-l2-symmetric-division-fraction-reference> a schema:PropertyValue ;
        dct:source "Louveaux et al. (2016) PNAS 113:E4294 Fig. S2E: 81% of 829 shoot-apex divisions have the smaller daughter at 40-50% of the mother's area" ;
        schema:value "0.81" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-l2-tension-rule-shortest-plane-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "l1_l2_tension_rule_shortest_plane_fraction = 0.3841 fraction" ;
        schema:measurementTechnique "Fraction of the 164 L1/L2 divisions under the tension rule (plane normal n_s x e_1 of tissue virial + cell-autonomous turgor tension) whose anticlinal wall length is within 5% of the shortest of 12 candidate anticlinal planes through the centroid; two-sided binomial p = 5.38e-18 vs 0.71. Gibbs-rule ablation (Besson-Dumais 2011, beta = 20.6): 0.7205 (n = 161). FAILED comparison for the tension rule: the tissue-level hoop tension overrides cell shape in this mesh" ;
        schema:name "l1_l2_tension_rule_shortest_plane_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.3841" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-l2-tension-rule-shortest-plane-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-l2-tension-rule-shortest-plane-fraction-reference> a schema:PropertyValue ;
        dct:source "Louveaux et al. (2016) PNAS 113:E4294-E4303: 65-77% of all observed division planes at the Arabidopsis shoot apex are the shortest (Besson-Dumais class 1) plane (midpoint 0.71)" ;
        schema:value "0.71" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-pin1-cmt-circular-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "l1_pin1_cmt_circular_correlation = 0.8832 r_circ" ;
        schema:measurementTechnique "Mean axial nematic cosine <cos(2*(theta_CMT - theta_PIN1))> across polarized L1 cells (SE = 0.021)" ;
        schema:name "l1_pin1_cmt_circular_correlation" ;
        schema:unitText "r_circ" ;
        schema:value "0.8832" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-pin1-cmt-circular-correlation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-pin1-cmt-circular-correlation-reference> a schema:PropertyValue ;
        dct:source "Heisler et al. (2010) PLoS Biology 8(10):e1000516 Fig. 2 axial circular correlation between PIN1 and CMTs" ;
        schema:value "0.88" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-pin1-cmt-coaligned-30deg-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "l1_pin1_cmt_coaligned_30deg_fraction = 0.8491 fraction" ;
        schema:measurementTechnique "168-cell coupled Auxin-PIN1-CMT ODE on the paraboloidal SAM dome with the base stress field from the 3D L1/L2/L3 mesh (p = 4.46e-41 Binomial test vs uniform null 0.3333; Pass 2 analytic-field ablation gives 0.8491). CAVEAT: the fraction is dominated by the imposed 15.5% PIN1-switching subpopulation and 0.165 rad jitter (not an emergent ODE output)" ;
        schema:name "l1_pin1_cmt_coaligned_30deg_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.8491" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-pin1-cmt-coaligned-30deg-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l1-pin1-cmt-coaligned-30deg-fraction-reference> a schema:PropertyValue ;
        dct:source "Heisler et al. (2010) PLoS Biology 8(10):e1000516 Fig. 1-2 (84.5% of L1 cells aligned within +-30 deg)" ;
        schema:value "0.845" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l3-corpus-periclinal-division-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "l3_corpus_periclinal_division_fraction = 0.7059 fraction" ;
        schema:measurementTechnique "Fraction of the 17 L3 divisions (3D Besson-Dumais Gibbs rule over the polyhedron's principal axes, beta = 20.6 extrapolated to relative areas) whose plane normal is within 45 deg of the surface normal" ;
        schema:name "l3_corpus_periclinal_division_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.7059" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l3-corpus-periclinal-division-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-l3-corpus-periclinal-division-fraction-reference> a schema:PropertyValue ;
        dct:source "Reddy et al. (2004) Development 131:4225 (after Steeves & Sussex 1989): the corpus divides in periclinal AS WELL AS anticlinal planes; no quantitative fraction is reported, so 0.5 is an uninformative prior, not a measured value" ;
        schema:value "0.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-laser-ablation-rim-circumferential-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "laser_ablation_rim_circumferential_fraction = 0.9103 fraction" ;
        schema:measurementTechnique "Kirsch wound-rim hoop-stress doubling (sigma_theta/sigma_inf = 2.0000) driving CMT+PIN1 reorientation at t = 6.0 h (vs pre-ablation control 0.34)" ;
        schema:name "laser_ablation_rim_circumferential_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.9103" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-laser-ablation-rim-circumferential-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-laser-ablation-rim-circumferential-fraction-reference> a schema:PropertyValue ;
        dct:source "Hamant et al. (2008) Science 322:1650-1655 Fig. 3 & Heisler et al. (2010) Fig. 4 (post-ablation circumferential alignment 0.91 vs 0.34 pre-ablation baseline)" ;
        schema:value "0.91" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-mesh-vs-specimen-l1-profile-rms-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "mesh_vs_specimen_l1_profile_rms_um = 5.538 um" ;
        schema:measurementTechnique "RMS vertical deviation (um) between the inflated mesh's outer L1 surface (|y| <= 6 um, apex-registered) and the calibrated specimen L1 contour over x in [-20, 40] um (n = 12 L1 cells). The apex curvature agrees by construction (calibration); the off-apex profile does not" ;
        schema:name "mesh_vs_specimen_l1_profile_rms_um" ;
        schema:unitText "um" ;
        schema:value "5.538" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-mesh-vs-specimen-l1-profile-rms-um-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-mesh-vs-specimen-l1-profile-rms-um-reference> a schema:PropertyValue ;
        dct:source "File:Arabidopsis round SAM.jpg (Wikimedia Commons CC BY-SA 4.0) segmented L1 contour, calibrated by the apex curvature radius (R_px -> 50 um) of Hamant et al. (2008)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-multilayer-mesh-dome-centre-anisotropy> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "multilayer_mesh_dome_centre_anisotropy = 0.0589 dimensionless" ;
        schema:measurementTechnique "Anisotropy of the bin-mean in-plane L1 tension tensor over interior L1 cells with r <= 15 um in the 3D mesh (nonzero value is a lattice-irregularity artefact of the sunflower centre, not a physical prediction)" ;
        schema:name "multilayer_mesh_dome_centre_anisotropy" ;
        schema:unitText "dimensionless" ;
        schema:value "0.0589" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-multilayer-mesh-dome-centre-anisotropy-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-multilayer-mesh-dome-centre-anisotropy-reference> a schema:PropertyValue ;
        dct:source "Hamant et al. (2008) Science 322:1650-1655 Fig. 1: isotropic tension (sigma_theta = sigma_m) on the spherical apical dome" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-multilayer-mesh-flank-l1-hoop-alignment-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "multilayer_mesh_flank_l1_hoop_alignment_fraction = 0.8072 fraction" ;
        schema:measurementTechnique "Fraction of interior L1 cells with r >= 30 um whose in-plane virial tension e_1 (same-sheet wall springs, 526-cell 4-sheet Voronoi mesh at quasi-static equilibrium, relative residual 0.145, mean L1 strain 0.0447) lies within 30 deg of the circumferential direction" ;
        schema:name "multilayer_mesh_flank_l1_hoop_alignment_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.8072" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-multilayer-mesh-flank-l1-hoop-alignment-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-multilayer-mesh-flank-l1-hoop-alignment-fraction-reference> a schema:PropertyValue ;
        dct:source "Hamant et al. (2008) Science 322:1650-1655 Fig. 1 & SOM Text S1: axisymmetric membrane theory puts the maximal principal tension e_1 circumferentially everywhere on the dome flank (CMTs circumferential on the flank)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-multilayer-mesh-l1-anisotropy-vs-membrane-law-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "multilayer_mesh_l1_anisotropy_vs_membrane_law_rmse = 0.0723 dimensionless" ;
        schema:measurementTechnique "RMSE between the radial-bin L1 in-plane tension anisotropy of the 3D mesh (bin-mean tensors, 6 bins 0-46 um: [0.098 0.05 0.029 0.048 0.036 0.086]) and the membrane law ([0.003 0.025 0.06 0.101 0.139 0.172]); Pearson r = -0.107 (p = 0.84). FAILED comparison: the cell-centre mesh reproduces the hoop DIRECTION but not the radial growth of the anisotropy MAGNITUDE (apex bin shows a sunflower-lattice artefact)" ;
        schema:name "multilayer_mesh_l1_anisotropy_vs_membrane_law_rmse" ;
        schema:unitText "dimensionless" ;
        schema:value "0.0723" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-multilayer-mesh-l1-anisotropy-vs-membrane-law-rmse-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-multilayer-mesh-l1-anisotropy-vs-membrane-law-rmse-reference> a schema:PropertyValue ;
        dct:source "Hamant et al. (2008) SOM thin-shell balance on the paraboloid z = -r^2/(2R): A_sigma(r) = (1-q)/(3-q), q = kappa_m/kappa_theta (0 at the apex, 0.20 at r = R)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-multilayer-mesh-l1-tension-load-share> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "multilayer_mesh_l1_tension_load_share = 0.7144 fraction" ;
        schema:measurementTechnique "Sum of tensile in-plane (same-sheet) wall-spring tensions in L1 divided by the sum over L1 + L2 + L3 (shares [0.714 0.127 0.103 0.056]); stiffness-ratio sweep k_L1/k_inner in {1, 2, 5, 10} reported in Panel H" ;
        schema:name "multilayer_mesh_l1_tension_load_share" ;
        schema:unitText "fraction" ;
        schema:value "0.7144" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-multilayer-mesh-l1-tension-load-share-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-multilayer-mesh-l1-tension-load-share-reference> a schema:PropertyValue ;
        dct:source "Lean Law 4 (hamant_2008_multilayer_shell_load_sharing): compatible-strain layer stack predicts N_1/N_total = k_1/(k_1 + k_2 + k_3) = 5/7 for the k_L1/k_inner = 5 assumption (Hamant 2008 SOM thick L1 outer wall; Kutschera & Niklas 2007). MODEL-INTERNAL reference, not a measured specimen value" ;
        schema:value "0.7143" .

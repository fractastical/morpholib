sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mirabet-auxin-pin1-meristem-mechanics> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L2057–L2185" ;
        dcterms:description "13-check deterministic self-test suite including Voronoi volume identity, Law 4/5 numeric mirrors and bitwise mesh determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L2057-L2185> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L2187–L2249" ;
        dcterms:description "CLI entry point regenerating the comparison PNG and growth GIF with both division rules and the stiffness sweep in ~52 s" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L2187-L2249> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 033 Pass 3 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Hamant et al. (2008) & Heisler et al. (2010) pressurized SAM shell stress tensor, cortical microtubule alignment, PIN1-auxin phyllotactic mechanics, and (Pass 3) 3D multi-layered L1/L2/L3 Voronoi cell mesh with dynamic division planes — Reproducibility package: 94/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "13-check `run_self_test()` suite (L2057-L2185, ~30 s) verifying SHA-256 integrity, thin-shell and Kirsch laws, PIN1 flux conservation, perturbation controls, Voronoi volume identity vs ConvexHull, mesh mechanics and Law 4 numerics, division-plane orthogonality and Law 5 numerics plus geometric-rule comparison, mesh-coupled ODE, specimen profile comparison, the 18-measurement contract, and bitwise determinism of both the ODE and the mesh (`X_final` array equality). Default run regenerates the PNG and GIF in ~52 s with pinned seed 2008; mesh results are cached per argument tuple." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-repro-package-2> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


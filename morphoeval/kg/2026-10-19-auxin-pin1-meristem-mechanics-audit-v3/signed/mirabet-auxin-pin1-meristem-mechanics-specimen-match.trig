sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mirabet-auxin-pin1-meristem-mechanics> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L1317–L1433" ;
        dcterms:description "Chromaticity + DoG segmentation of the Arabidopsis SAM L1 dome contour, saddle crease, and 539 nuclei (NN spacing CV 0.26)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L1317-L1433> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L1443–L1467" ;
        dcterms:description "Apex-registered RMS comparison of the inflated mesh outer-L1 surface with the calibrated specimen L1 contour over x in [-20, 40] um (5.54 um RMS, reported as a failed comparison)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L1443-L1467> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/auxin_pin1_meristem_mechanics_comparison.png (generated output)" ;
        dcterms:description "9-panel figure: Panel F specimen segmentation, Panel G mesh section with specimen contour overlay, Panel A/D empirical S_CMT and perturbation benchmarks, Panel I literature division-plane references — docs/media/auxin_pin1_meristem_mechanics_comparison.png: rendered output of 2008-hamant-meristem-microtubule-stress.py at d58a084, image/png, 1472695 B, 2520×2324 px, artifact_sha256 c36d8725eaa507fe05e4763c5e0e521e0b417c0c4ac585a68e02d6ebdf649328 (sha256 c36d8725eaa507fe05e4763c5e0e521e0b417c0c4ac585a68e02d6ebdf649328), spec_fingerprint bc94b13a6b26f42aa1073ace658e06dfd3f2592d5212c5761812f7f46fad2b02" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Hamant et al. (2008) & Heisler et al. (2010) pressurized SAM shell stress tensor, cortical microtubule alignment, PIN1-auxin phyllotactic mechanics, and (Pass 3) 3D multi-layered L1/L2/L3 Voronoi cell mesh with dynamic division planes — Morphological realism / specimen match: 80/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The SHA-256-pinned CC BY-SA 4.0 Toluidine-Blue longitudinal SAM section is segmented (L1 contour, saddle crease, 539 nuclei, `segment_arabidopsis_sam_specimen`, L1317-L1433) and, new in Pass 3, its calibrated L1 contour is overlaid on the 3D mesh section (Panel G) with an apex-registered RMS profile comparison (`compare_mesh_profile_with_specimen`, L1443-L1467; RMS 5.54 um off-apex, FAILED at the 2 um threshold). The 50.0 um dome radius \"match\" is the calibration identity (R_px scaled to 50 um, L1389, caveat at L1976), so the apex curvature agreement is by construction. No division-plane, layer-thickness or anisotropy statistic is derived from the specimen (all Pass 3 benchmarks are literature values), and a single 2D section cannot validate a 3D multilayer mesh; v2's 90 overstated the specimen link." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2008-hamant-meristem-microtubule-stress.py L1389–L1389: calibrated_dome_radius_um = R_dome_px / px_per_um where px_per_um is defined from the 50 um target: the 50.00 um measurement is an identity, not a specimen match <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L1389-L1389>",
            "datasets/auxin_pin1_meristem_mechanics/auxin_pin1_meristem_mechanics_reference.json L1–L60: Division-plane benchmarks (0.71 shortest plane, 0.81 symmetric, L3 periclinal prior 0.5) are literature values from Louveaux 2016 / Reddy 2004, not measured on the vendored specimen; the L3 prior is uninformative <https://github.com/fractastical/morpholib/blob/d58a084/datasets/auxin_pin1_meristem_mechanics/auxin_pin1_meristem_mechanics_reference.json#L1-L60>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-specimen-match-3> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mirabet-auxin-pin1-meristem-mechanics> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Hamant et al. (2008) & Heisler et al. (2010) pressurized SAM shell stress tensor, cortical microtubule alignment, PIN1-auxin phyllotactic mechanics, and (Pass 3) 3D multi-layered L1/L2/L3 Voronoi cell mesh with dynamic division planes — Parameter expressivity: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Evaluates 4 SAM curvature regimes (L253-L302), 5 perturbation states (L1231-L1315), two division rules (`--division-rule mechanical|geometric`, both run by default), a k_L1/k_inner stiffness-ratio sweep over {1, 2, 5, 10} (`sweep_l1_stiffness_ratio`, L939-L957; Panel H inset) and a mesh/analytic stress-field ablation (`--stress-field`), and exposes `--turgor-P`, `--dome-R`, `--wall-t`, `--b-sigma`, `--k-sigma`, `--seed`, `--k-l1-ratio`, `--mesh-growth-steps`, `--no-sweep`, `--skip-gif` CLI overrides (L2189-L2203). Mesh geometry (sheet counts/depths, pressure, Lockhart phi/eps_Y, growth) is exposed as function arguments but not as CLI flags." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-parameter-expressivity-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L253–L302" ;
        dct:description "4-zone curvature and stress anisotropy evaluation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L253-L302> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L939–L957" ;
        dct:description "k_L1/k_inner stiffness-ratio sweep of the 3D mesh (L1 load share vs Law 4 prediction)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L939-L957> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py L2189–L2231" ;
        dct:description "CLI parameter overrides including --stress-field, --division-rule, --k-l1-ratio, --mesh-growth-steps wired into the mesh and ODE solvers; both division rules run by default" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2008-hamant-meristem-microtubule-stress.py#L2189-L2231> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 033 Pass 3 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


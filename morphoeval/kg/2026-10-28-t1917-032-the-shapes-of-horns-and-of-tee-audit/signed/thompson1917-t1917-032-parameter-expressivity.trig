sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-032> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-parameter-expressivity> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 226 Pass 1 primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0000-0002-1825-0097 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-032 — teeth & tusks: differential-accretion log spiral + St Venant torsion — Parameter expressivity: 40/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Only five hand-picked (λ, c, τ) regimes are rendered in panel (f) (L477-L483); no systematic sweep of ψ, λ, taper c or twist τ, no CLI overrides, and the monotone effects proved in Lean (curvature falls with width; helix slope rises with ρ) are not demonstrated numerically across ranges." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py L477–L483: Five fixed regimes; no sweep <https://github.com/fractastical/morpholib/blob/0e7e77bc1/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L477-L483>",
            "thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py L803–L820: CLI exposes only --self-test / --pass1 <https://github.com/fractastical/morpholib/blob/0e7e77bc1/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L803-L820>" ;
        pk:hasScore "0.4"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


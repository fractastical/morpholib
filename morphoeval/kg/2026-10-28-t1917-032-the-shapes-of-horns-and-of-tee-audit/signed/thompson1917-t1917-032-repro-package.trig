sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-032> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-repro-package> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py L758–L800" ;
        dcterms:description "Self-test suite incl. synthetic log-spiral recovery and determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0e7e77bc1/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L758-L800> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-032 — teeth & tusks: differential-accretion log spiral + St Venant torsion — Reproducibility package: 72/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Fixed seed, deterministic `measure_morphoeval` (asserted twice-equal in `run_self_test`, L758-L800), 13 self-test assertions mirroring the Lean laws, documented invocation; but library versions are not pinned in the script, smoothing scale (σ = 50 px) is a hand-set constant, and `--pass1` vs full differ only in the pole grid." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py L304–L328: Hand-set smoothing σ and trim constants, not width-scaled <https://github.com/fractastical/morpholib/blob/0e7e77bc1/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L304-L328>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-repro-package-1> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 226 Pass 1 primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0000-0002-1825-0097 ;

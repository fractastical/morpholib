sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-032> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-specimen-match> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py L247–L328" ;
        dcterms:description "HSV segmentation, skeleton longest path, width via distance transform, curvature profile" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0e7e77bc1/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L247-L328> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-032 — teeth & tusks: differential-accretion log spiral + St Venant torsion — Morphological realism / specimen match: 50/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "HSV segmentation + skeleton longest path recovers the mammoth tusk centreline and width (`segment_mammoth_tusk`, `tusk_centreline_profile`, L247-L328) and the overlay beats the circle null, but the smoothed curvature changes sign 3 times (root bend, straight shaft, reversed tip hook) so the plane log spiral mis-tracks root and tip; the narwhal panel is an analogue; no comparison against Thompson's own tusk description beyond text." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-032/result.json L1–L57: kappa_sign_changes = 3 recorded; T1_single_sign_curvature = false <https://github.com/fractastical/morpholib/blob/0e7e77bc1/datasets/thompson_1917/t1917-032/result.json#L1-L57>",
            "docs/media/t1917_032_the_shapes_of_horns_and_of_tee_comparison.png (generated output, not in repo): Panel (a) overlay: log spiral tracks the shaft but diverges at root and reversed tip hook; panel (c) 3 curvature sign changes — docs/media/t1917_032_the_shapes_of_horns_and_of_tee_comparison.png: rendered output of thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py at 0e7e77bc1, image/png, 901553 B, 2200×1265 px, artifact_sha256 ce504b6b180f886e2d607acf30623c6aa5ed49ff489607778ef4157b67be39f8 (sha256 ce504b6b180f886e2d607acf30623c6aa5ed49ff489607778ef4157b67be39f8), spec_fingerprint d3a3c036d2236fa5e48fed4d773ebe5efc0177f2fb7ef111e8e3fe7dfc6e5241" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-specimen-match-1> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .


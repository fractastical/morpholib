sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-032> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-032 — teeth & tusks: differential-accretion log spiral + St Venant torsion — Model fidelity to source: 62/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "E1-E3 (`log_spiral_r`, `whorl_expansion`, `gnomon_radius`, L112-L131), E4-E6 screw accretion (`grow_tooth`, L146-L181), E8-E9 St Venant warping (`tri_warp`, `ellipse_warp`, `st_venant_triangle_field`, L186-L223) and E7 helix (L228-L242) are implemented as published and mirrored by 17 Lean theorems, but the specimen test uses only the 2-D plane-spiral special case; the twisted (τ > 0) model that Thompson invokes for long tusks is rendered, never fitted." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py L445–L470: run_analysis fits only the plane log spiral + circle; τ > 0 helico-spiral never fitted to the projected centreline <https://github.com/fractastical/morpholib/blob/0e7e77bc1/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L445-L470>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-model-fidelity-3> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py L112–L181" ;
        dct:description "E1-E6 equiangular spiral, gnomon, accretion curvature and screw-accretion growth" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0e7e77bc1/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L112-L181> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py L186–L242" ;
        dct:description "E8-E9 St Venant warping field and E7 helix slope / Kiladze conversions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0e7e77bc1/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L186-L242> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_032.lean L31–L215" ;
        dct:description "4 laws, 17 theorems, 0 sorry, core Lean 4 only" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0e7e77bc1/morphoeval/lean/loops/Thompson1917_T1917_032.lean#L31-L215> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 226 Pass 1 primary assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


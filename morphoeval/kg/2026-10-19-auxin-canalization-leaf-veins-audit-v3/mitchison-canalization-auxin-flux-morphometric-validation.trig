sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mitchison-canalization-auxin-flux> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Mitchison (1980, 1981) & Feugier, Mochizuki & Iwasa (2005) with-the-flux auxin canalization: exponent bifurcation, growing hex-lamina canalization (solved), Sachs wound bypass (solved + prescribed), hand-drawn Feugier venation templates, and cleared-leaf specimen segmentation — Morphometric validation: 66/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1142-1333) now returns 16 reference-anchored measurements. The 7 Pass 3 ones are computed from solved fields and several of them FAIL their comparison and say so: beta_1 = 0 vs specimen 1843 (L1245-1253), vein density 0.121 vs specimen coverage 0.416 (L1264-1272), strand angle 26.8 +- 14.2 vs 52.9 deg (L1274-1282), S_vein/S_par 0.67 vs the prescribed 0.31 (L1293-1301); nesting 0.79 +- 0.03 vs the qualitative \"all nested\" of Scarpella et al. (L1255-1262); sink balance 0.983 (L1284-1291); solved Sachs intake 0.991 vs NPA 0.609 vs intact 0.988 (L1224-1233). Deductions: the 9 Pass 2 measurements compare prescribed values with the script's own JSON (now labelled PRESCRIBED / GRAPH TEMPLATE at L1212, L1221, L1308, L1317) and still carry Pearson p-values on 5 points (-10); the reference values for nesting (1.0), sink balance (1.0) and beta_1 (0) are qualitative or model-internal rather than measured (-8); the vein-density comparison is apples-to-oranges (vein cells per lamina cell vs a dilated pixel mask, acknowledged in the JSON) (-5); the relative-tortuosity metric (L1235-1243) is a hop count that returns 1.00 despite a 6-cell deflection, so it does not measure what it claims (-6); uncertainties are SDs across 2-3 stages or single-seed, no replicate seeds (-5)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1997-mitchison-canalization-auxin-flux.py L1205–L1222: Pass 2 drainage ratio and bypass tortuosity retained, now labelled PRESCRIBED, but still counted as measurements against the same JSON they were tuned to <https://github.com/fractastical/morpholib/blob/d58a084/1997-mitchison-canalization-auxin-flux.py#L1205-L1222>",
            "1997-mitchison-canalization-auxin-flux.py L1235–L1243: sachs_dynamic_bypass_relative_tortuosity: hop-count Dijkstra path returns 1.00 for a 6-cell bypass - the metric is insensitive to lateral deflection <https://github.com/fractastical/morpholib/blob/d58a084/1997-mitchison-canalization-auxin-flux.py#L1235-L1243>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-canalized-vein-to-parenchyma-conc-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-exponent-sweep-winner-share-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-feugier-closed-areole-betti1-loops>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-feugier-open-tree-betti1-loops>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-final-betti1-loops>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-nesting-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-new-strand-angle-deg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-sink-balance-stage3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-vein-density-stage3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-vein-drainage-ratio-stage3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-linear-p1-winner-flux-share>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-quadratic-p2-winner-flux-share>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-sachs-dynamic-bypass-relative-tortuosity>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-sachs-wound-bypass-tortuosity>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-sachs-wound-sink-flux-recovery>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-specimen-secondary-vein-branch-angle-deg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-morphometric-validation-2> ;
        pk:hasScore "0.66"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-canalized-vein-to-parenchyma-conc-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "canalized_vein_to_parenchyma_conc_ratio = 0.3131 S_vein/S_par" ;
        schema:measurementTechnique "PRESCRIBED PROFILE (Pass 2, retained): analytic Gaussian trough with dip ratio 0.6895 in simulate_2d_lamina_canalization, not a solved field; the solved counterpart is growing_lamina_vein_drainage_ratio_stage3 (Law 2)." ;
        schema:name "canalized_vein_to_parenchyma_conc_ratio" ;
        schema:unitText "S_vein/S_par" ;
        schema:value "0.3131" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-canalized-vein-to-parenchyma-conc-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-canalized-vein-to-parenchyma-conc-ratio-reference> a schema:PropertyValue ;
        dct:source "Mitchison (1980) Proc. R. Soc. Lond. B 207:79-109 Fig. 2 (concentration drop inside canalized strand S_vein < S_par)" ;
        schema:value "0.31" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-exponent-sweep-winner-share-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "exponent_sweep_winner_share_pearson_r = 1.0 r" ;
        schema:measurementTechnique "5-point feedback exponent sweep p in [0.5, 2.5] vs Mitchison (1980) reference curve (RMSE = 0.0009 ± 0.0002)" ;
        schema:name "exponent_sweep_winner_share_pearson_r" ;
        schema:unitText "r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-exponent-sweep-winner-share-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-exponent-sweep-winner-share-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Mitchison (1980) Proc. R. Soc. Lond. B 207:79-109 pitchfork bifurcation across p in [0.5, 2.5]" ;
        schema:value "0.999" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-feugier-closed-areole-betti1-loops> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "feugier_closed_areole_betti1_loops = 14 loops" ;
        schema:measurementTechnique "GRAPH TEMPLATE (Pass 2, retained): cycle rank beta_1 = E - V + C of a hand-specified 28-vertex / 41-edge network in simulate_feugier_venation_topologies; the value 14 is a drawing, not a solved Feugier et al. (2005) outcome." ;
        schema:name "feugier_closed_areole_betti1_loops" ;
        schema:unitText "loops" ;
        schema:value "14" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-feugier-closed-areole-betti1-loops-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-feugier-closed-areole-betti1-loops-reference> a schema:PropertyValue ;
        dct:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:366-375 Figs. 5-7 (closed-areole venation loops under saturating carrier allocation)" ;
        schema:value "14" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-feugier-open-tree-betti1-loops> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "feugier_open_tree_betti1_loops = 0 loops" ;
        schema:measurementTechnique "GRAPH TEMPLATE (Pass 2, retained): cycle rank beta_1 = E - V + C of a hand-specified 16-vertex tree in simulate_feugier_venation_topologies; no carrier dynamics are solved. The solved counterpart is growing_lamina_final_betti1_loops." ;
        schema:name "feugier_open_tree_betti1_loops" ;
        schema:unitText "loops" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-feugier-open-tree-betti1-loops-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-feugier-open-tree-betti1-loops-reference> a schema:PropertyValue ;
        dct:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:366-375 Fig. 3 (open branching venation tree under unbounded carrier supply)" ;
        schema:value "0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-final-betti1-loops> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growing_lamina_final_betti1_loops = 0 loops" ;
        schema:measurementTechnique "Enclosed lamina regions (6-connectivity components not touching the margin) of the stage-3 vein network, reversible Mitchison (1980) canalization on the growing 48x44 hex lamina; the irreversible-differentiation variant is reported as an ablation. A FAILED specimen comparison by construction: potential-flow canalization cannot close loops." ;
        schema:name "growing_lamina_final_betti1_loops" ;
        schema:unitText "loops" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-final-betti1-loops-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-final-betti1-loops-reference> a schema:PropertyValue ;
        dct:source "Vendored cleared dicot leaf specimen (1843 segmented closed areoles) vs Feugier & Iwasa (2006) J. Theor. Biol. 243:235-244 (canalization alone forms no loops)" ;
        schema:value "1843" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-nesting-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growing_lamina_nesting_fraction = 0.7928 fraction" ;
        schema:measurementTechnique "Fraction of cells canalized for the first time in growth stage g (g = 2, 3) that are not wall-adjacent to any stage < g vein cell, i.e. lie inside pre-existing intercostal panels; mean +- SD over stages 2-3." ;
        schema:name "growing_lamina_nesting_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.7928" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-nesting-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-nesting-fraction-reference> a schema:PropertyValue ;
        dct:source "Scarpella, Marcos, Friml & Berleth (2006) Genes Dev. 20:1015-1027 & Kang & Dengler (2004) Int. J. Plant Sci. 165:231-242: higher-order veins form inside pre-existing areoles / intercostal panels (qualitative, reference = all new strands nested)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-new-strand-angle-deg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growing_lamina_new_strand_angle_deg = 26.75 deg" ;
        schema:measurementTechnique "PCA orientation of each connected strand canalized in stages 2-3 relative to the leaf axis (hex lattice quantises orientations to ~30/60/90 deg)." ;
        schema:name "growing_lamina_new_strand_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "26.75" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-new-strand-angle-deg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-new-strand-angle-deg-reference> a schema:PropertyValue ;
        dct:source "Vendored specimen secondary-vein divergence angle (structure tensor); Rolland-Lagan & Prusinkiewicz (2005) Plant J. 44:854-865" ;
        schema:value "52.93" .

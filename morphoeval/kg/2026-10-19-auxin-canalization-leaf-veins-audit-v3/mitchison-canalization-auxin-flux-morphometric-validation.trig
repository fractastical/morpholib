    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-sachs-wound-sink-flux-recovery> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "sachs_wound_sink_flux_recovery = 0.9912 fraction" ;
        schema:measurementTechnique "Pass 3 SOLVED: basal-sink intake / apical production after 600 time units of Mitchison (1980) canalization on a 20x16 hex stem with a 9-column transverse incision; alpha = 0 (NPA) control given as negative_control_npa (Pass 2 reported a hard-coded 0.9852 / 0.0804)." ;
        schema:name "sachs_wound_sink_flux_recovery" ;
        schema:unitText "fraction" ;
        schema:value "0.9912" ;

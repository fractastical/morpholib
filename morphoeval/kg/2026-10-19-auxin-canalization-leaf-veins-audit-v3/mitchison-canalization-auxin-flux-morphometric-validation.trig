        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-vein-drainage-ratio-stage3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-vein-drainage-ratio-stage3-reference> a schema:PropertyValue ;
        dct:source "Mitchison (1980) Proc. R. Soc. Lond. B 207:79-109 Fig. 2 (S_vein < S_par inside canalized strands); Pass 2 prescribed value 0.31" ;
        schema:value "0.31" .

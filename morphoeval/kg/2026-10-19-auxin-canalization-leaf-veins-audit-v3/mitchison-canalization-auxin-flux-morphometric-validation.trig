        schema:value "0.9826" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-sink-balance-stage3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-sink-balance-stage3-reference> a schema:PropertyValue ;
        dct:source "Mass balance of Mitchison (1980) Eq. 2 at steady state with mu -> 0 (sink intake = total lamina production)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-vein-density-stage3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growing_lamina_vein_density_stage3 = 0.121 fraction" ;
        schema:measurementTechnique "Vein cells / lamina cells at stages 1-3 (75, 312, 1281 cells); the stage-3 value is compared with the areal vein coverage segmented on the specimen. SD across stages." ;
        schema:name "growing_lamina_vein_density_stage3" ;
        schema:unitText "fraction" ;
        schema:value "0.121" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-vein-density-stage3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-vein-density-stage3-reference> a schema:PropertyValue ;
        dct:source "Vendored cleared dicot leaf specimen vein areal coverage (`segment_leaf_venation_specimen`); cf. Sack & Scoffoni (2013) New Phytol. 198:983-1000 on vein density conservation during blade expansion" ;
        schema:value "0.4165" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-growing-lamina-vein-drainage-ratio-stage3> a schema:PropertyValue,

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mitchison-canalization-auxin-flux> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Mitchison (1980, 1981) & Feugier, Mochizuki & Iwasa (2005) with-the-flux auxin canalization: exponent bifurcation, growing hex-lamina canalization (solved), Sachs wound bypass (solved + prescribed), hand-drawn Feugier venation templates, and cleared-leaf specimen segmentation — Code-to-model traceability: 80/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module docstring (L1-50) maps Laws 1-4 to equations, figures and Lean theorems with line loci; `HexCanalizationLattice` (L736-748) and `simulate_growing_lamina_venation` (L950-972) cite Eq. 2-3, the saturation rationale and the Law 4/4b theorems; the Pass 3 scope statement (L663-679) says explicitly what is and is not implemented; the math-KG YAML registers Laws 4 and 4b with lean_locus and code_locus. Deductions: functions named `simulate_2d_lamina_canalization`, `simulate_sachs_wound_bypass` and `simulate_feugier_venation_topologies` still have docstrings that say \"simulate\" although they construct profiles / draw graphs; only the measurement `method` strings were corrected (-8); the solver parameters alpha = 40, beta = 0.2, phi_s = 1.0, mu = 0.001 (L687-701) are the author's choices with a dimensional argument in comments but no mapping to Mitchison's own parameter values (-5); the stage schedule and vein threshold 3 D_0 are uncited heuristics (-3); Law 3 (polar flux conservation) is cited in the docstring but has no dynamical code path (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1997-mitchison-canalization-auxin-flux.py L243–L254: simulate_2d_lamina_canalization docstring still claims to 'Simulate 2D cellular lamina auxin transport' for an analytic construction <https://github.com/fractastical/morpholib/blob/d58a084/1997-mitchison-canalization-auxin-flux.py#L243-L254>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-code-traceability-3> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1997-mitchison-canalization-auxin-flux.py L1–L50" ;
        dcterms:description "Module docstring: Laws 1-4 with equations, source figures, Lean theorem names and honest limits" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1997-mitchison-canalization-auxin-flux.py#L1-L50> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1997-mitchison-canalization-auxin-flux.py L663–L679" ;
        dcterms:description "Pass 3 scope statement: not FEM, not polar PIN1, why the polar prototype was dropped, why beta_1 = 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1997-mitchison-canalization-auxin-flux.py#L663-L679> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/mitchison-canalization-auxin-flux.yaml L87–L125" ;
        dcterms:description "Law 4 / 4b registered with lean_decl, lean_theorem, lean_locus, code_locus and source citations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/mitchison-canalization-auxin-flux.yaml#L87-L125> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 034 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mitchison-canalization-auxin-flux> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/auxin_canalization_leaf_veins_comparison.png (generated output)" ;
        dcterms:description "Panel D: solved stage-3 hex lamina (beta_1 = 0, density 0.121 vs specimen 0.416 annotated); Panels E/F: specimen midrib, angle rays, areole centroids - specimen comparison visible — docs/media/auxin_canalization_leaf_veins_comparison.png: rendered output of 1997-mitchison-canalization-auxin-flux.py at d58a084, image/png, 1339843 B, 2700×1680 px, artifact_sha256 7e4e81296d44001edb5c233e120b8436c10f86340b35a12fb0d14eb609089381 (sha256 7e4e81296d44001edb5c233e120b8436c10f86340b35a12fb0d14eb609089381), spec_fingerprint c7349d3e4102c9f6306702949c507eeadd9b480c0de0ed099e56fb40eb8cea36" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/auxin_canalization_leaf_veins_growing_lamina.png (generated output)" ;
        dcterms:description "A1-A3 three growth stages with auxin field and vein-order overlay; C vein-order map shows a basal fan of lattice-aligned strands, not a pinnate midrib; B states loop closure NOT reproduced — docs/media/auxin_canalization_leaf_veins_growing_lamina.png: rendered output of 1997-mitchison-canalization-auxin-flux.py at d58a084, image/png, 815111 B, 2700×1560 px, artifact_sha256 b8587ef793fd861f6cc76938f2fa08e2d48bcb0a3ee3f442b848209d94289d17 (sha256 b8587ef793fd861f6cc76938f2fa08e2d48bcb0a3ee3f442b848209d94289d17), spec_fingerprint c7349d3e4102c9f6306702949c507eeadd9b480c0de0ed099e56fb40eb8cea36" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "1997-mitchison-canalization-auxin-flux.py L1600–L1620" ;
        dcterms:description "Comparison Panel D plots the solved vein orders and annotates beta_1 = 0 against the specimen areole count and the Pass 2 template value 14" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1997-mitchison-canalization-auxin-flux.py#L1600-L1620> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Mitchison (1980, 1981) & Feugier, Mochizuki & Iwasa (2005) with-the-flux auxin canalization: exponent bifurcation, growing hex-lamina canalization (solved), Sachs wound bypass (solved + prescribed), hand-drawn Feugier venation templates, and cleared-leaf specimen segmentation — Morphological realism / specimen match: 58/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Judged on the regenerated comparison PNG and the new growing-lamina PNG. Panels E/F still show the pinned cleared leaf with the tracked midrib, secondary-angle rays and 1843 segmented areoles, and the solved growing lamina (Panel D of the comparison PNG; A1-A3 and C of the growing-lamina PNG) is now an actual model output placed beside the specimen numbers. Deductions: the solved network has no closed areoles at all (beta_1 = 0 vs 1843 on the specimen) so the defining feature of the specimen's reticulate venation is absent (-15); it is a basal fan of two lattice-aligned strands with parallel secondaries, not the pinnate midrib + ~53 deg secondaries of the specimen (-10); the GIF now shows the solved lamina but the stage-1 and stage-2 frames are too coarse (75 / 312 cells) to resemble a leaf (-4); the comparison PNG still displays the prescribed Pass 2 lamina profiles and bifurcation curve (Panels A-B) as if they were outputs, with no side-by-side against Mitchison's own Fig. 1-2 (-6); Panel F's areole scatter overlays only the first 120 centroids, concentrated at the top margin, so the 1843 count is not visually verifiable (-3); credit for the honest beta_1 / specimen annotation in Panel D and the removal of the hand-drawn Feugier graph from the figure (+5 relative to deleting it silently)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1997-mitchison-canalization-auxin-flux.py L720–L730: leaf_blade_hex_mask: analytic ovate outline, not the specimen's outline; no registration of the simulated blade to the specimen <https://github.com/fractastical/morpholib/blob/d58a084/1997-mitchison-canalization-auxin-flux.py#L720-L730>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-specimen-match-3> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 034 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


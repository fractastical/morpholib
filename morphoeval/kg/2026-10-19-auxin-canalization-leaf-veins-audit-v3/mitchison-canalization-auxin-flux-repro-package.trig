sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mitchison-canalization-auxin-flux> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Mitchison (1980, 1981) & Feugier, Mochizuki & Iwasa (2005) with-the-flux auxin canalization: exponent bifurcation, growing hex-lamina canalization (solved), Sachs wound bypass (solved + prescribed), hand-drawn Feugier venation templates, and cleared-leaf specimen segmentation — Reproducibility package: 86/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`--self-test` runs 12 deterministic checks in ~40 s (L1729-1856), including bitwise determinism of all 16 measurements across two calls, wall-symmetry and strand-survival checks across a refinement, the Lean-mirrored saturation bound, and the solved Sachs controls; the default render regenerates all three artifacts in ~31 s; every input is SHA-pinned; seeds are explicit (1980 / 1981 and seed+g per stage). Deductions: no requirements lock file and the environment is recorded only in this audit (-5); without MPLCONFIGDIR matplotlib writes a font cache outside the repository (observed during this run) and the script does not set it (-3); the unused CLI flags (L1868-1871) make the documented invocation misleading (-3); the irreversible ablation doubles the measurement runtime for a result that is identical (0 vs 0) and is not cached (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "1997-mitchison-canalization-auxin-flux.py L1868–L1872: --alpha/--beta/--gamma/--exponent-p parsed but unused; only --seed reaches the solver (via --print-growth) <https://github.com/fractastical/morpholib/blob/d58a084/1997-mitchison-canalization-auxin-flux.py#L1868-L1872>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-repro-package-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1997-mitchison-canalization-auxin-flux.py L1729–L1856" ;
        dct:description "12-check self-test: SHA-256 + pinned-parameter cross-check, Laws 1-3, specimen, growing lamina (7), inheritance (8), saturation (9), solved Sachs (10), 16-metric determinism (11), artifacts (12)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1997-mitchison-canalization-auxin-flux.py#L1729-L1856> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1997-mitchison-canalization-auxin-flux.py L1807–L1819" ;
        dct:description "Check 8 verifies inherited wall symmetry, strand survival through cell division and ~4x production growth" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1997-mitchison-canalization-auxin-flux.py#L1807-L1819> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 034 Pass 3 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


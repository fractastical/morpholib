        pk:EvidenceItem ;
    rdfs:label "sachs_wound_sink_flux_recovery" ;
    dct:description "Pass 3 SOLVED: basal-sink intake / apical production after 600 time units of Mitchison (1980) canalization on a 20x16 hex stem with a 9-column transverse incision; alpha = 0 (NPA) control given as negative_control_npa (Pass 2 reported a hard-coded 0.9852 / 0.0804)." ;
    dct:source "Sachs (1981) Adv. Bot. Res. 9:151-262 vascular continuity restoration vs NPA polar transport inhibition (qualitative benchmark)" ;
    schema:about "Pisum sativum & Arabidopsis thaliana (dicot leaf lamina & stem vascular strands)" ;
    schema:error 6.294e-01 ;
    schema:targetValue 9.85e-01 ;
    schema:unitText "fraction" ;
    schema:value 9.912e-01 .

<https://w3id.org/delphi/resource/evidence/2026-10-19-auxin-canalization-leaf-veins-audit-v3-mitchison-canalization-auxin-flux-7> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "sachs_dynamic_bypass_relative_tortuosity" ;
    dct:description "Shortest vein-cell path (Dijkstra over canalized hex cells, unit hop length) from apical source row to basal sink, wounded / intact; lateral deflection = max x of vein cells in the incision band minus the intact strand column." ;
    dct:source "Sachs (1981) Adv. Bot. Res. 9:151-262 C-shaped bypass around a transverse incision (reference JSON benchmark, qualitative)" ;
    schema:about "Pisum sativum & Arabidopsis thaliana (dicot leaf lamina & stem vascular strands)" ;
    schema:error 2.75362e+01 ;
    schema:targetValue 1.38e+00 ;
    schema:unitText "L_wounded/L_intact" ;
    schema:value 1e+00 .

<https://w3id.org/delphi/resource/evidence/2026-10-19-auxin-canalization-leaf-veins-audit-v3-mitchison-canalization-auxin-flux-8> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "growing_lamina_final_betti1_loops" ;
    dct:description "Enclosed lamina regions (6-connectivity components not touching the margin) of the stage-3 vein network, reversible Mitchison (1980) canalization on the growing 48x44 hex lamina; the irreversible-differentiation variant is reported as an ablation. A FAILED specimen comparison by construction: potential-flow canalization cannot close loops." ;
    dct:source "Vendored cleared dicot leaf specimen (1843 segmented closed areoles) vs Feugier & Iwasa (2006) J. Theor. Biol. 243:235-244 (canalization alone forms no loops)" ;
    schema:about "Pisum sativum & Arabidopsis thaliana (dicot leaf lamina & stem vascular strands)" ;
    schema:error 1e+02 ;
    schema:targetValue 1.843e+03 ;
    schema:unitText "loops" ;
    schema:value 0e+00 .

<https://w3id.org/delphi/resource/evidence/2026-10-19-auxin-canalization-leaf-veins-audit-v3-mitchison-canalization-auxin-flux-9> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "growing_lamina_nesting_fraction" ;
    dct:description "Fraction of cells canalized for the first time in growth stage g (g = 2, 3) that are not wall-adjacent to any stage < g vein cell, i.e. lie inside pre-existing intercostal panels; mean +- SD over stages 2-3." ;
    dct:source "Scarpella, Marcos, Friml & Berleth (2006) Genes Dev. 20:1015-1027 & Kang & Dengler (2004) Int. J. Plant Sci. 165:231-242: higher-order veins form inside pre-existing areoles / intercostal panels (qualitative, reference = all new strands nested)" ;
    schema:about "Pisum sativum & Arabidopsis thaliana (dicot leaf lamina & stem vascular strands)" ;
    schema:error 2.072e+01 ;
    schema:targetValue 1e+00 ;
    schema:unitText "fraction" ;
    schema:value 7.928e-01 .

<https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Code-to-model traceability" ;
    dct:description "[reproducibility, weight 8/100, id morphoeval/0.1.0/code-traceability] Can each modelling step in the code be traced to a specific equation, section or figure of the source?" ;
    skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Model fidelity to source" ;
    dct:description "[faithfulness, weight 20/100, id morphoeval/0.1.0/model-fidelity] Does the code implement the equations / algorithm of the cited source model as published (not a loose analogue), with parameters defined the way the source defines them?" ;
    skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Morphometric validation" ;
    dct:description "[faithfulness, weight 15/100, id morphoeval/0.1.0/morphometric-validation] Are quantitative morphometrics computed on the output and compared against values measured on real specimens or reported in the literature?" ;
    skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Parameter expressivity" ;
    dct:description "[faithfulness, weight 10/100, id morphoeval/0.1.0/parameter-expressivity] Does each morphospace parameter visibly and monotonically control the feature of form it is supposed to control across its stated range?" ;
    skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Reproducibility package" ;
    dct:description "[reproducibility, weight 12/100, id morphoeval/0.1.0/repro-package] Pinned dependencies, deterministic seeds, documented invocation, and a known-good environment; environment-induced result corruption counts against this dimension." ;
    skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Source and data traceability" ;
    dct:description "[reproducibility, weight 10/100, id morphoeval/0.1.0/source-traceability] Are the source paper (DOI/PMID), code repository and any input data resolvable identifiers, and is input provenance recorded?" ;
    skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Morphological realism / specimen match" ;
    dct:description "[faithfulness, weight 25/100, id morphoeval/0.1.0/specimen-match] Does the rendered output resemble real specimens of the organism and/or the source authors' own figures, judged side by side? Distinct morphologies must be visually distinct." ;
    skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .


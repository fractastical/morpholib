sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mitchison-canalization-auxin-flux> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Mitchison (1980, 1981) & Feugier, Mochizuki & Iwasa (2005) with-the-flux auxin canalization: exponent bifurcation, growing hex-lamina canalization (solved), Sachs wound bypass (solved + prescribed), hand-drawn Feugier venation templates, and cleared-leaf specimen segmentation — Source and data traceability: 84/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Ten references with DOIs in the audit, README and two BibTeX files; six dataset files SHA-256 pinned and verified fail-closed at runtime (EXPECTED_SHA256 L82-91, `verify_dataset_integrity` L97-110), with the Pass 1-2 files left byte-identical and the growing-lamina parameters cross-checked against the pinned JSON in self-test check 1 (L1733-1740); the specimen keeps its licence, URL and hash. Deductions: the Pass 1-2 reference JSON's numeric benchmarks (winner shares per exponent, Sachs 1.38 / 0.985 / 0.08, Feugier beta_1 = 14) are not digitised from any figure and are now acknowledged as such, yet the file still presents them as \"_ref\" values (-8); the five new DOIs were added from the assessor's knowledge and not resolved online during this run (-4); `tracked_by` issue #34 and the repository URL are unverified (-2); the specimen's species is unknown (\"dicot\") so the Rolland-Lagan 54.5 deg reference is generic (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/auxin_canalization_leaf_veins/auxin_canalization_leaf_veins_reference.json L46–L115: Exponent-regime and Sachs benchmark values carry no figure/table provenance; they are the Pass 1 author's constants <https://github.com/fractastical/morpholib/blob/d58a084/datasets/auxin_canalization_leaf_veins/auxin_canalization_leaf_veins_reference.json#L46-L115>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-source-traceability-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1997-mitchison-canalization-auxin-flux.py L82–L110" ;
        dct:description "EXPECTED_SHA256 for 6 files (2 new Pass 3 pins) and fail-closed verify_dataset_integrity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1997-mitchison-canalization-auxin-flux.py#L82-L110> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/auxin_canalization_leaf_veins/README.md L20–L30" ;
        dct:description "Pass 3 section: two new pinned files with hashes, five new DOI references, limitations stated" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/auxin_canalization_leaf_veins/README.md#L20-L30> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/auxin_canalization_leaf_veins/paper_citations_pass3.bib L1–L57" ;
        dct:description "Feugier & Iwasa 2006, Scarpella 2006, Kang & Dengler 2004, Runions 2005, Sack & Scoffoni 2013 with DOIs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/auxin_canalization_leaf_veins/paper_citations_pass3.bib#L1-L57> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 034 Pass 3 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


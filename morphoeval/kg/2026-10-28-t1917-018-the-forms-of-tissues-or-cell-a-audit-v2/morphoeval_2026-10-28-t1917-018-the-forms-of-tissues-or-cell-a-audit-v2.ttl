    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-parameter-expressivity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-parameter-expressivity-2> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-repro-package> a pk:LLMClaimAssessment ;
    rdfs:label "Thompson (1917) T1917-018 — Plateau tri-junction (120 degree) claim: Lami balance, periodic froth relaxation, junction-angle statistics — Reproducibility package: 88/100" ;

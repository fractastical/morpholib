sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-018> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-morphometric-validation> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-018 — Plateau tri-junction (120 degree) claim: Lami balance, periodic froth relaxation, junction-angle statistics — Morphometric validation: 88/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "`plateau_statistics`, `bootstrap_vertex_ci`, `two_sample_ks` and `histogram_fit` (L180-232) deliver SD, RMS deviation, median |theta - 120| with vertex-resampled 95 % CIs, fraction within the a-priori +/-15 degree tolerance, CV, two-sample KS D/p, histogram Pearson r and RMSE; `goodness_of_fit` (L910-935) fits eps by KS distance and compares each specimen with the Plateau froth, the Poisson-Voronoi null and the Farhadifar comparator; `decide_verdict` (L937-973) applies the pre-registered criteria and records the branch-estimator robustness. The cornea result (KS p = 0.60 vs the froth, D = 0.27 vs Voronoi) is a genuine quantitative match. Deduction: the two estimators disagree on the cornea (7.2 vs 15.9 degrees), so the angle criterion is estimator-sensitive at the tolerance edge; no literature junction-angle distribution is available to pin as an external reference value." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-corneal-endothelium-best-fit-tension-anisotropy-eps>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-corneal-endothelium-branch-estimator-median-theta-120>,

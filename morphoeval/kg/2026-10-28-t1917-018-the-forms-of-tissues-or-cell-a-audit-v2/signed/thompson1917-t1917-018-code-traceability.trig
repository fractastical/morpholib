    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-018 — Plateau tri-junction (120 degree) claim: Lami balance, periodic froth relaxation, junction-angle statistics — Code-to-model traceability: 88/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Section banners and function names map onto the equation labels E1/E2/E3/E5 of the reference package; the six Lean theorems of `Thompson1917_T1917_018.lean` (Fig. 113 cases, Lami iff equal tensions, angle-sum identity, Euler/T1 bookkeeping, hexagon closure, Steiner inequality) compile with Lean 4.35.0 and 0 sorry, and `math_kg_loops/thompson1917-t1917-018.yaml` pins each law to v2 line ranges. The self-test checks the Euler invariant (mean six sides) after T1s. Deduction: the segmentation heuristics (thresholds 0.18, 0.6 x Otsu, 0.3 x median area, 15 px ink distance) are documented in docstrings but not derived from a source." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-code-traceability-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


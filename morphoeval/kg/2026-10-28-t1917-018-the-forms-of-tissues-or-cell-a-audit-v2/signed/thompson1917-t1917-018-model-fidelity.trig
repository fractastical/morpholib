sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-018> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-model-fidelity> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py L140–L177" ;
        dcterms:description "Lami balance, inverse Lami, Fig. 113 cases, Steiner inequality as published" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/18879252d/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L140-L177> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py L284–L311" ;
        dcterms:description "Vertex energy E5 with anisotropic line tension and analytic gradient" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/18879252d/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L284-L311> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py L345–L465" ;
        dcterms:description "Combinatorial T1 exchanges and convergence-checked relaxation; straight edges only (no film curvature)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/18879252d/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L345-L465> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor cloud agent, primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-018 — Plateau tri-junction (120 degree) claim: Lami balance, periodic froth relaxation, junction-angle statistics — Model fidelity to source: 88/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "`lami_angles_from_tensions` / `tensions_from_angles` / `thompson_fig113_cases` (L140-172) implement Thompson's triangle of forces exactly, `steiner_vs_cross_lengths` (L174-177) Lamarle's four-fold instability, and `PeriodicNetwork.energy_gradient` (L284-311) the Farhadifar-type vertex energy with orientation-dependent tension and an analytic gradient verified against finite differences in the self-test (L1267-1319). The equal-tension Plateau limit (Gamma = eps = 0) is now reached with combinatorial T1 exchanges (`t1_shortest_edge`, L345-406) and a gradient-norm convergence criterion (`relax_froth`, L440-465): the relaxed froth is three-valent with mean six sides, SD 9.9 degrees. What keeps it from the top band: edges are straight, so the model cannot reproduce the curved-film 120 degrees of a real froth in a disordered topology (documented in the claim boundary), and the 3D tetrahedral law is not simulated." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-model-fidelity-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


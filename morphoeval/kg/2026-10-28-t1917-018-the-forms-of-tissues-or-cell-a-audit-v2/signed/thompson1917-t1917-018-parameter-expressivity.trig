sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-018> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-parameter-expressivity> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py L864–L908" ;
        dcterms:description "eps sweep, Lami sweep, Plateau vs Farhadifar regimes, brick/square controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/18879252d/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L864-L908> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py L1321–L1339" ;
        dcterms:description "Ten CLI flags; K and T1_LENGTH not exposed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/18879252d/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L1321-L1339> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor cloud agent, primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-018 — Plateau tri-junction (120 degree) claim: Lami balance, periodic froth relaxation, junction-angle statistics — Parameter expressivity: 86/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "`run_model_suite` (L864-908) sweeps the tension anisotropy eps over seven values (SD rises monotonically 9.9 -> 11.8 -> 17.4 -> 25.7 -> 36.1 -> 43.8 -> 51.5 degrees, i.e. eps visibly controls the Fig. 124 distortion), the Lami partition-tension ratio t/T continuously, and contrasts the Plateau limit with the Farhadifar Case I perimeter-contractility comparator; `parse_args` (L1321-1339) exposes --eps-sweep, --lambda-bar, --gamma-bar, --seed, --steps, --n-cells, --bootstrap, --tolerance, --quick and --no-figures. K and the T1 threshold remain module constants." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-parameter-expressivity-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


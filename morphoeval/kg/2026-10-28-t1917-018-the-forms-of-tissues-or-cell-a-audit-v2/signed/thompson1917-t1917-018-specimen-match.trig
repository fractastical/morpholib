        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/18879252d/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L532-L572> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py L681–L778" ;
        dcterms:description "Skeleton-graph vertex extraction for Thompson's drawings with spur pruning, short-edge collapse and bourrelet hole filling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/18879252d/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L681-L778> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_018_the_forms_of_tissues_or_cell_a_comparison.png (generated output)" ;
        dcterms:description "Four specimen panels with segmentation overlays and vertices; onion under-segmented at the periphery — docs/media/t1917_018_the_forms_of_tissues_or_cell_a_comparison.png: rendered output of thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py at 18879252d, image/png, 1042338 B, 2100×1102 px, artifact_sha256 94aa66cc8749d83f45c1bb611f3f62022d1424a4919ef7c30e670d6d28038347 (sha256 94aa66cc8749d83f45c1bb611f3f62022d1424a4919ef7c30e670d6d28038347), spec_fingerprint b6891b9d48370d1a3d2785b75836612aaca82ba408f906fd75dc438b1a976266" .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-018 — Plateau tri-junction (120 degree) claim: Lami balance, periodic froth relaxation, junction-angle statistics — Morphological realism / specimen match: 84/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "All four specimens are loaded, verified (`verify_inputs`, L124-137) and segmented with pipelines matched to their imaging (`segment_specimen`, L532-572: nucleus-seeded watershed on a Sato ridge for the alizarin-red corneal mosaic, Sato wall mask + components for the magenta-walled onion, skeleton graph of the closed ink for Thompson's drawings, `skeleton_graph_analysis` L681-778), and the comparison figure (`render_figures`, L988-1109) shows each specimen with its segmentation and detected vertices beside the model and the nulls. The cornea segmentation is clean (126 cells, one nucleus each). Deductions: the onion pipeline drops small cells (47 of roughly 60 visible), and Fig. 124's four boundary T-junctions on the strip's outer walls are scored together with interior vertices." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-specimen-match-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .


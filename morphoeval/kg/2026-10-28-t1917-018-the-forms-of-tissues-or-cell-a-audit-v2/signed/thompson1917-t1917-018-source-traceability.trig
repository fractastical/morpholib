sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-018> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-source-traceability> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-018 — Plateau tri-junction (120 degree) claim: Lami balance, periodic froth relaxation, junction-angle statistics — Source and data traceability: 90/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "The script loads the reference package and SHA-256-verifies every specimen and both IA leaves at start-up (`verify_inputs`, L124-137; also in `--self-test`); result.json records the dataset names, digests, the IA leaf numbers, the Commons authors/licences and the Dryad DATASET_MISMATCH with its metadata digests. The docstring and reference.json carry page-pinned Thompson quotes and resolvable DOIs/URLs for every source. Minor gap: Plateau (1873) and Lamarle (1864) are cited by archive URL, not DOI." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-source-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-source-traceability-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py L111–L137" ;
        dcterms:description "Runtime SHA-256 verification against reference.json" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/18879252d/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L111-L137> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-018/t1917_018_the_forms_of_tissues_or_cell_a_reference.json L1–L60" ;

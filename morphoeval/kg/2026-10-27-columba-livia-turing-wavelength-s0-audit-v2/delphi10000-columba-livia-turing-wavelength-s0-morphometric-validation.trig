sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-columba-livia-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Columba livia Turing wavelength at 256 um (Holocene, chronoseries 1/1) — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Unchanged numerical results. Pearson r = 0.999889 (reference 1.0) and unscaled RMSE 0.0511 on the dispersion. Ablation ratio 0.0177 versus 0. Specimen foreground fraction 0.5577 versus 0.5, contour circularity 0.0145 versus 1, luminance KS 0.387 versus 0. Saturated stripe mode n = 4 gives 256 um on the 1024 um domain. These references are not copies of the measured values, except the linear wavelength, which the formula hits exactly and which is reported under a name that is not a silhouette metric." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-ablation-to-stripe-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-critical-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-diffusion-length-predecessor-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-dispersion-rmse-unscaled>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-ocellar-peak-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-saturated-stripe-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-specimen-luminance-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-stripe-spacing-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-ablation-to-stripe-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_to_stripe_std_ratio = 0.017726 1" ;
        dct:description "negative control vs the supercritical stripe field" ;
        schema:measurementTechnique "std(u) at Dv = Du divided by std(u) of the stripe regime, same seed and duration" ;
        schema:name "ablation_to_stripe_std_ratio" ;
        schema:unitText "1" ;
        schema:value "0.017726" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-ablation-to-stripe-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-ablation-to-stripe-std-ratio-reference> a schema:PropertyValue ;
        dct:source "equal-diffusion negative control should not pattern" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-critical-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical_wavelength_um = 256.0 um" ;
        dct:description "Linear law, not the saturated Eckhaus shift." ;
        schema:measurementTechnique "analytic k_c at Dv/Du = 10; lambda = 2*pi/k_c * 16 um" ;
        schema:name "critical_wavelength_um" ;
        schema:unitText "um" ;
        schema:value "256.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-critical-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-critical-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "loop scale contract: 256 um detail variant of tier 5_primordium_100um" ;
        schema:value "256.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-diffusion-length-predecessor-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffusion_length_predecessor_um = 24.1043 um" ;
        dct:description "predecessor scale at 0 Ma; not a chronospecies. Ratio to 256 um is about 10.6" ;
        schema:measurementTechnique "sqrt(Du0/gamma0) * 16 um" ;
        schema:name "diffusion_length_predecessor_um" ;
        schema:unitText "um" ;
        schema:value "24.1043" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-diffusion-length-predecessor-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-diffusion-length-predecessor-um-reference> a schema:PropertyValue ;
        dct:source "this slot's critical wavelength, for the scale ratio" ;
        schema:value "256.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r = 0.999889 1" ;
        dct:description "RMSE of scaled sigma = 1.5333; unscaled RMSE = 0.05111" ;
        schema:measurementTechnique "Pearson r of analytic vs IMEX growth rates on real eigenmodes n = 1..15" ;
        schema:name "dispersion_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.999889" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "exact eigenmode identity; residual is IMEX truncation" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-dispersion-rmse-unscaled> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_rmse_unscaled = 0.051109 1/time" ;
        dct:description "control comparison against the closed-form dispersion" ;
        schema:measurementTechnique "RMSE of Re(sigma) after dividing out the time-scale factor S = 30" ;
        schema:name "dispersion_rmse_unscaled" ;
        schema:unitText "1/time" ;
        schema:value "0.051109" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-dispersion-rmse-unscaled-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-dispersion-rmse-unscaled-reference> a schema:PropertyValue ;
        dct:source "zero truncation error" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-ocellar-peak-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ocellar_peak_count = 20 count" ;
        dct:description "spot/ocellus regime at the same k_c; count need not equal the square lattice" ;
        schema:measurementTechnique "strict local maxima of the isotropic field above the 75th percentile" ;
        schema:name "ocellar_peak_count" ;
        schema:unitText "count" ;
        schema:value "20" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-ocellar-peak-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-ocellar-peak-count-reference> a schema:PropertyValue ;
        dct:source "4 by 4 lattice of 256 um cells on the 1024 um domain" ;
        schema:value "16" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-saturated-stripe-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "saturated_stripe_wavelength_um = 256.0 um" ;
        dct:description "selected mode n = 4; spacing CV = 0.0000" ;
        schema:measurementTechnique "dominant kx mode of the anisotropic saturated field; domain 1024 um / n" ;
        schema:name "saturated_stripe_wavelength_um" ;
        schema:unitText "um" ;
        schema:value "256.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-saturated-stripe-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-saturated-stripe-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "linear k_c" ;
        schema:value "256.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_circularity = 0.0145 1" ;
        dct:description "the flying bird is a thin, non-circular contour" ;
        schema:measurementTechnique "4*pi*area/perimeter^2 of the border-contrast silhouette" ;
        schema:name "specimen_contour_circularity" ;
        schema:unitText "1" ;
        schema:value "0.0145" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "filled-circle null" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_foreground_fraction = 0.5577 1" ;
        dct:description "non-circular specimen segmentation metric" ;
        schema:measurementTechnique "border-median contrast mask on columba_livia_specimen.jpg resized to 160x120" ;
        schema:name "specimen_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.5577" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "balanced-frame null; the flight portrait is not half background" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-specimen-luminance-ks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_luminance_ks = 0.387 1" ;
        dct:description "goodness of fit of the pigment histogram against the photograph; not expected to be zero" ;
        schema:measurementTechnique "two-sample KS between specimen luminance and stripe melanin, 4000 pixels each" ;
        schema:name "specimen_luminance_ks" ;
        schema:unitText "1" ;
        schema:value "0.387" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-specimen-luminance-ks-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-specimen-luminance-ks-reference> a schema:PropertyValue ;
        dct:source "identical distributions" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-stripe-spacing-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stripe_spacing_cv = 0.0 1" ;
        dct:description "dispersion of the realized bar spacing" ;
        schema:measurementTechnique "CV of row-wise zero-crossing spacings on the stripe field" ;
        schema:name "stripe_spacing_cv" ;
        schema:unitText "1" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-stripe-spacing-cv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-measurement-stripe-spacing-cv-reference> a schema:PropertyValue ;
        dct:source "perfectly uniform critical mode" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-columba-livia-turing-wavelength-s0.py L471–L591" ;
        dct:description "measure_morphoeval rows: Pearson, RMSE, KS, CV, ablation ratio, specimen silhouette" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-columba-livia-turing-wavelength-s0.py#L471-L591> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;

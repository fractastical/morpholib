sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila ananassae Turing wavenumber at 2.1 µm (Holocene, 0 Ma) — Morphometric validation: 58/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The saturated FFT wavelength is 2.030 µm against the analytic 2.106 µm, so the two numbers are not copies of each other. Plate circularity is 0.136 against a circle null of 1, and aspect ratio is 2.02. Pearson r, RMSE, and KS across a sweep are not computed." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-fft-wavelength-m>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-growth-gif-frame-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-growth-gif-min-resolution-px>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-specimen-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-wavelength-ratio-americana-over-s0>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-fft-wavelength-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fft_wavelength_m = 2.0301e-06 m" ;
        schema:measurementTechnique "dominant non-DC Fourier mode of the saturated activator, times dx" ;
        schema:name "fft_wavelength_m" ;
        schema:unitText "m" ;
        schema:value "2.0301e-06" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-fft-wavelength-m-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-fft-wavelength-m-reference> a schema:PropertyValue ;
        dct:source "slot wavelength 2.106e-06 m; FFT peak is not forced equal to it" ;
        schema:value "2.106e-06" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-growth-gif-frame-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growth_gif_frame_count = 12 frames" ;
        schema:measurementTechnique "PIL n_frames of the rendered GIF" ;
        schema:name "growth_gif_frame_count" ;
        schema:unitText "frames" ;
        schema:value "12" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-growth-gif-frame-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-growth-gif-frame-count-reference> a schema:PropertyValue ;
        dct:source "image-fitness minimum; this render uses 12" ;
        schema:value "6" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-growth-gif-min-resolution-px> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growth_gif_min_resolution_px = 640 px" ;
        schema:measurementTechnique "min(width, height) of the GIF" ;
        schema:name "growth_gif_min_resolution_px" ;
        schema:unitText "px" ;
        schema:value "640" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-growth-gif-min-resolution-px-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-growth-gif-min-resolution-px-reference> a schema:PropertyValue ;
        dct:source "image-fitness resolution floor" ;
        schema:value "340" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-specimen-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_aspect_ratio = 2.018 1" ;
        schema:measurementTechnique "bounding-box width/height of the plate foreground" ;
        schema:name "specimen_aspect_ratio" ;
        schema:unitText "1" ;
        schema:value "2.018" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-specimen-aspect-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-specimen-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "isometric null" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_circularity = 0.136 1" ;
        schema:measurementTechnique "4πA/P² on the border-contrast mask of the Wikimedia plate" ;
        schema:name "specimen_contour_circularity" ;
        schema:unitText "1" ;
        schema:value "0.136" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "circle null; a lateral fly plate is not round" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-wavelength-ratio-americana-over-s0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength_ratio_americana_over_s0 = 65.8594 1" ;
        schema:measurementTechnique "139 µm predecessor / 2.106 µm detail wavelength" ;
        schema:name "wavelength_ratio_americana_over_s0" ;
        schema:unitText "1" ;
        schema:value "65.8594" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-wavelength-ratio-americana-over-s0-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-wavelength-ratio-americana-over-s0-reference> a schema:PropertyValue ;
        dct:source "ratio would be 1 if this slot copied the americana wavelength" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-ananassae-turing-wavelength-s0.py L188–L231" ;

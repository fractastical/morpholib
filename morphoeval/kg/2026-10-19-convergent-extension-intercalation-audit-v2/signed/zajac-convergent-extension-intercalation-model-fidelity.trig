sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-zajac-convergent-extension-intercalation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2003-zajac-convergent-extension-intercalation.py L120–L225" ;
        dcterms:description "Anisotropic adhesion energy, polarized junction tension, T1 quartet remodelling, and RK2 pure-shear ODE verifier" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2003-zajac-convergent-extension-intercalation.py#L120-L225> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2003-zajac-convergent-extension-intercalation.py L230–L445" ;
        dcterms:description "64-cell polarized T1 intercalation lattice solver with exact area conservation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2003-zajac-convergent-extension-intercalation.py#L230-L445> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_093_convergent_extension_intercalation.lean L17–L163" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for T1 energy drop, pure-shear aspect ratio amplification, and 5-regime hierarchy" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_093_convergent_extension_intercalation.lean#L17-L163> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Zajac, Jones & Glazier (2000, 2003) / Bertet, Sulak & Lecuit (2004) anisotropic differential adhesion and polarized T1 junctional intercalation in convergent extension — Model fidelity to source: 95/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements Zajac et al.'s (2003) anisotropic cell-cell adhesion energy J(theta) = J_0 - Delta_J cos(2*theta), Bertet et al.'s (2004) planar-polarized junction tension Lambda(theta) = Lambda_0 - Delta_Lambda cos(2*theta) and irreversible T1 quartet remodelling (Type 1 -> 4-way vertex -> Type 3), and incompressible 2D pure-shear tissue kinematics verified by midpoint RK2 against R_CE(t) = R_0 exp(2*dot_epsilon_T1*t) (L2 error = 1.19e-7), backed by 3 machine-checked Lean 4 theorems (0 sorrys) in `Loop_093_convergent_extension_intercalation.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-model-fidelity-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


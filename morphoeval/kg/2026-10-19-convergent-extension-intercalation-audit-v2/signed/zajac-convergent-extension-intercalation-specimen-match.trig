    <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Zajac, Jones & Glazier (2000, 2003) / Bertet, Sulak & Lecuit (2004) anisotropic differential adhesion and polarized T1 junctional intercalation in convergent extension — Morphological realism / specimen match: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Segments both the isotropic animal cap cell (Panel a, L/W = 0.9623) and the mediolaterally polarized chordamesoderm cell undergoing convergent extension (Panel b, L/W = 4.9453, 5.14x elongation) in `convergent_extension_axis_specimen.jpg`, extracts the rose-diagram nematic order parameter S_2 (0.6130 vs 0.0940), and achieves r = 0.9677 (p = 1.93e-5) angular profile correlation against the Zajac-Bertet mediolateral polarity distribution." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-zajac-convergent-extension-intercalation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Zajac, Jones & Glazier (2000, 2003) / Bertet, Sulak & Lecuit (2004) anisotropic differential adhesion and polarized T1 junctional intercalation in convergent extension — Reproducibility package: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Provides `--self-test` verifying SHA-256 dataset integrity, RK2 pure-shear ODE convergence, exact 2D tissue area conservation, bitwise determinism (seed=2003), strict 5-regime ordering, and specimen rose segmentation, achieving 100/100 quick_gate." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-repro-package-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2003-zajac-convergent-extension-intercalation.py L915–L975" ;
        dct:description "Deterministic --self-test suite and CLI entrypoint" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2003-zajac-convergent-extension-intercalation.py#L915-L975> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/convergent_extension_intercalation_growth.gif (generated output)" ;
        dct:description "24-frame animated 64-cell T1 intercalation & convergent extension GIF — docs/media/convergent_extension_intercalation_growth.gif: rendered output of 2003-zajac-convergent-extension-intercalation.py at 317bc3c, image/gif, 1021905 B, 1386×472 px, 24 frames, artifact_sha256 ff0fbbe95dd1df311cae7702be6a246b529998421e05bd98a03e9d61737c88c6 (sha256 ff0fbbe95dd1df311cae7702be6a246b529998421e05bd98a03e9d61737c88c6), spec_fingerprint 70c0d2a81cec84a4a194e326ee3833640573b76865ed3d8f4c5ff14fdbf4448d" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-source-traceability-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Equus scotti follicular Turing wavelength at 164 µm (Irvingtonian, 0.6 Ma) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 0.993406 against a reference of 1, RMSE = 0.037048 against 0. Nonlinear stripe wavelength 167.9414 µm against the assigned 164.3 µm. Ablation max growth -0.105 against 0. Pliohippus and quagga linear peaks differ from their targets in the fourth significant figure. Horsfall coherency 0.5235 against the simulation coherency 0.8209. Radial KS 0.9575 against 0. None of these values is a copy of its reference. The KS is a real disagreement, not a fitted success, so the dimension does not get a score in the mid-90s." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-equus-quagga-bard-initiation-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-equus-scotti-nonlinear-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-horsfall-specimen-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-imex-vs-analytical-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-mature-pattern-standard-deviation-versus-homogeneous-steady-state>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-pliohippus-pernix-linear-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-specimen-versus-simulation-radial-spectrum-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 0.037048 1/time" ;
        dct:description "rmse=0.0370" ;
        schema:measurementTechnique "root mean square of analytical minus IMEX growth rates" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.037048" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation max growth rate = -0.105329 1/time" ;
        dct:description "negative control; a positive value would mean the ablation failed" ;
        schema:measurementTechnique "max of sigma_+(k) for k>0 when Du is copied onto Dv" ;
        schema:name "equal-diffusion ablation max growth rate" ;
        schema:unitText "1/time" ;
        schema:value "-0.105329" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-growth-rate-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-equus-quagga-bard-initiation-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Equus quagga Bard initiation wavelength = 400.0137 µm" ;
        dct:description "successor chronospecies; longer than the Irvingtonian follicular mode" ;
        schema:measurementTechnique "argmax of sigma_+ after solving Du at Dv/Du = 30 for a 400 µm target" ;
        schema:name "Equus quagga Bard initiation wavelength" ;
        schema:unitText "µm" ;
        schema:value "400.0137" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-equus-quagga-bard-initiation-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-equus-quagga-bard-initiation-wavelength-reference> a schema:PropertyValue ;
        schema:value "400.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-equus-scotti-nonlinear-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Equus scotti nonlinear stripe wavelength = 167.9414 µm" ;
        dct:description "linear peak 164.366 µm; Murray stationary wavelength 130.58 µm" ;
        schema:measurementTechnique "parabolic peak of the radial power spectrum of the matured activator on the dermal patch" ;
        schema:name "Equus scotti nonlinear stripe wavelength" ;
        schema:unitText "µm" ;
        schema:value "167.9414" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-equus-scotti-nonlinear-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-equus-scotti-nonlinear-stripe-wavelength-reference> a schema:PropertyValue ;
        schema:value "164.3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-horsfall-specimen-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Horsfall specimen coherency = 0.5235 structure-tensor coherency" ;
        dct:description "specimen value is not set equal to the simulation coherency" ;
        schema:measurementTechnique "mean structure-tensor coherency of the public-domain Horsfall plate" ;
        schema:name "Horsfall specimen coherency" ;
        schema:unitText "structure-tensor coherency" ;
        schema:value "0.5235" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-horsfall-specimen-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-horsfall-specimen-coherency-reference> a schema:PropertyValue ;
        schema:value "0.8209" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-imex-vs-analytical-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "IMEX vs analytical dispersion Pearson r = 0.993406 correlation" ;
        dct:description "First-order IMEX does not reproduce the eigenvalue to machine precision" ;
        schema:measurementTechnique "Pearson correlation of sigma_+(k) against single-mode IMEX growth at 36 wavenumbers" ;
        schema:name "IMEX vs analytical dispersion Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.993406" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-imex-vs-analytical-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-imex-vs-analytical-dispersion-pearson-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-mature-pattern-standard-deviation-versus-homogeneous-steady-state> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "mature pattern standard deviation versus homogeneous steady state = 0.7305 concentration" ;
        dct:description "a flat field would score 0; the matured ocellus field does not" ;
        schema:measurementTechnique "std of activator u after the spectral IMEX integration" ;
        schema:name "mature pattern standard deviation versus homogeneous steady state" ;
        schema:unitText "concentration" ;
        schema:value "0.7305" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-mature-pattern-standard-deviation-versus-homogeneous-steady-state-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-mature-pattern-standard-deviation-versus-homogeneous-steady-state-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-pliohippus-pernix-linear-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pliohippus pernix linear wavelength = 198.6994 µm" ;
        dct:description "predecessor, 8.5 Ma" ;
        schema:measurementTechnique "argmax of sigma_+ after solving Du at Dv/Du = 12 for the size-scaled target" ;
        schema:name "Pliohippus pernix linear wavelength" ;
        schema:unitText "µm" ;
        schema:value "198.6994" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-pliohippus-pernix-linear-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-pliohippus-pernix-linear-wavelength-reference> a schema:PropertyValue ;
        schema:value "198.6884" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-specimen-versus-simulation-radial-spectrum-ks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen versus simulation radial-spectrum KS = 0.9575 KS distance" ;
        dct:description "luminance KS 0.674; radial Pearson r 0.792; foreground 0.682" ;
        schema:measurementTechnique "Kolmogorov-Smirnov distance between radial log-power spectra of the Horsfall plate and the activator" ;
        schema:name "specimen versus simulation radial-spectrum KS" ;
        schema:unitText "KS distance" ;
        schema:value "0.9575" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-specimen-versus-simulation-radial-spectrum-ks-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-measurement-specimen-versus-simulation-radial-spectrum-ks-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py L130–L159" ;
        dct:description "IMEX versus analytical dispersion on real eigenpairs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3d4615e96e7fbafcf9d3e24355fcc03695e61f40/models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py#L130-L159> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py L322–L343" ;

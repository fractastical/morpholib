sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Equus scotti follicular Turing wavelength at 164 µm (Irvingtonian, 0.6 Ma) — Parameter expressivity: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "At the scotti diffusivity, raising Dv/Du from 8 to 40 lengthens the linear wavelength monotonically from 134.6 µm to 190.1 µm. The three named targets are hit by solving Du: Pliohippus 198.70 µm (target 198.69), Scotti 164.31 µm (target 164.3), Quagga 400.01 µm (target 400). The order is quagga longer than pliohippus longer than scotti." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py L203–L231" ;
        dct:description "Chronoseries targets and the fixed-Du ratio sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3d4615e96e7fbafcf9d3e24355fcc03695e61f40/models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py#L203-L231> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/equus_scotti_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "Sweep panel and the three named wavelengths in its title — docs/media/equus_scotti_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py at 3d4615e96e7fbafcf9d3e24355fcc03695e61f40, image/png, 392198 B, 1584×946 px, artifact_sha256 003c2e77dd423d8d470005fc1556382940fa073d32ddae515bf7997517b03f56 (sha256 003c2e77dd423d8d470005fc1556382940fa073d32ddae515bf7997517b03f56), spec_fingerprint a3ff127a4fbe604c383fca881bbb59ca1298842374b9b9112403cb1ca2e31003" .

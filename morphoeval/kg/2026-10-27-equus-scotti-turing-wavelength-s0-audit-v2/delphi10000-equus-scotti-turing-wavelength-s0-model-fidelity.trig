sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Equus scotti follicular Turing wavelength at 164 µm (Irvingtonian, 0.6 Ma) — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The Jacobian, sigma_+, the diffusivity solve, and the spectral IMEX step implement Schnakenberg kinetics and Turing's dispersion relation. k_c is argmax sigma_+, distinct from Murray's k_m (wavelength 130.6 µm versus 164.37 µm). The equal-diffusion control returns max sigma = -0.105, which is the sign Turing's necessary condition requires. Ten points are withheld because the 164.3 µm target is the slot's assigned scale, not a wavelength estimated from a measured coat, and because the time step is first-order IMEX." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py L60–L128" ;
        dct:description "Jacobian, sigma_+, and the solve that places k_c at 164.3 µm" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3d4615e96e7fbafcf9d3e24355fcc03695e61f40/models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py#L60-L128> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py L161–L189" ;
        dct:description "Spectral IMEX of the nonlinear Schnakenberg system" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3d4615e96e7fbafcf9d3e24355fcc03695e61f40/models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py#L161-L189> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py L233–L245" ;
        dct:description "Du = Dv ablation; max sigma for k>0 is negative" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3d4615e96e7fbafcf9d3e24355fcc03695e61f40/models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py#L233-L245> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (primary pass-2 assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


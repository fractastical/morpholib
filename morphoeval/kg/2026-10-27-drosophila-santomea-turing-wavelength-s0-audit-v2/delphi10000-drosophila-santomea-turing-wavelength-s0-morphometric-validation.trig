}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila santomea Schnakenberg wavelength at 2.326 µm (Holocene, 0 Ma), pass 2 — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion RMSE is 4.9e-5 (r rounded to 1.0 at six decimals, reference ideal 1). Wavelength-sweep RMSE is 0.91 µm and is reported, not hidden. KS(gallery, activator) = 0.249 against a reference of 0. Gallery arm spacing 90.909 µm against reference 2.326 µm. None of these pairs are value-equals-reference." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-pseudoobscura-at-the-2-3-m-tier>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-sechellia-at-the-2-3-m-tier>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-d-santomea-critical-wavelength-at-gamma-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-equal-diffusion-ablation-growth-rate-at-the-wild-type-k-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-gallery-field-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-gallery-spiral-arm-spacing-from-the-drawn-100-m-scale-bar>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-gamma-sweep-pearson-r-of-analytic-versus-numeric-peak-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-schnakenberg-dispersion-pearson-r-of-numeric-versus-analytic-growth-rates>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-two-sample-ks-distance-between-gallery-luminance-and-activator-field>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-pseudoobscura-at-the-2-3-m-tier> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chronoseries wavelength gap santomea minus pseudoobscura at the 2.3 µm tier = 0.486 µm" ;
        schema:measurementTechnique "2326 nm − 1840 nm, with γ_pseudoobscura / γ_santomea = (2326/1840)^2" ;
        schema:name "chronoseries wavelength gap santomea minus pseudoobscura at the 2.3 µm tier" ;
        schema:unitText "µm" ;
        schema:value "0.486" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-pseudoobscura-at-the-2-3-m-tier-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-pseudoobscura-at-the-2-3-m-tier-reference> a schema:PropertyValue ;
        dct:source "Reconstructed detail-tier gap, not a fossil measurement and not the sibling primordium slots" ;
        schema:value "0.4" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-sechellia-at-the-2-3-m-tier> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chronoseries wavelength gap santomea minus sechellia at the 2.3 µm tier = 0.276 µm" ;
        schema:measurementTechnique "2326 nm − 2050 nm, with γ_sechellia / γ_santomea = (2326/2050)^2" ;
        schema:name "chronoseries wavelength gap santomea minus sechellia at the 2.3 µm tier" ;
        schema:unitText "µm" ;
        schema:value "0.276" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-sechellia-at-the-2-3-m-tier-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-sechellia-at-the-2-3-m-tier-reference> a schema:PropertyValue ;
        dct:source "Reconstructed detail-tier gap; sechellia retains abdominal tan relative to santomea" ;
        schema:value "0.3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-d-santomea-critical-wavelength-at-gamma-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "D. santomea critical wavelength at gamma = 1 = 2.326 µm" ;
        dct:description "2.326 ≠ 2.3; the reference is the one-decimal assignment and the value is the locked three-decimal wavelength" ;
        schema:measurementTechnique "λ_c = 2π ξ / k_c with ξ fixed so the continuous formula equals 2.326 µm" ;
        schema:name "D. santomea critical wavelength at gamma = 1" ;
        schema:unitText "µm" ;
        schema:value "2.326" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-d-santomea-critical-wavelength-at-gamma-1-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-d-santomea-critical-wavelength-at-gamma-1-reference> a schema:PropertyValue ;
        dct:source "Slot 3201 assigned detail scale 2.3 µm (stored exactly as 2.326 µm)" ;
        schema:value "2.3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-equal-diffusion-ablation-growth-rate-at-the-wild-type-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation growth rate at the wild-type k_c = -0.451355 1/time" ;
        dct:description "wild-type numeric sigma = 0.285062" ;
        schema:measurementTechnique "Same eigenvector probe with D_u = D_v = 1" ;
        schema:name "equal-diffusion ablation growth rate at the wild-type k_c" ;
        schema:unitText "1/time" ;
        schema:value "-0.451355" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-equal-diffusion-ablation-growth-rate-at-the-wild-type-k-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-equal-diffusion-ablation-growth-rate-at-the-wild-type-k-c-reference> a schema:PropertyValue ;
        dct:source "Turing 1952: equal diffusivities cannot satisfy h > 0 when trace(J) < 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-gallery-field-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "gallery-field structure-tensor coherency = 0.302 coherency" ;
        schema:measurementTechnique "Box-averaged structure tensor on the border-contrast foreground" ;
        schema:name "gallery-field structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.302" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-gallery-field-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-gallery-field-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "Neutral isotropic baseline 0.5; the gallery spiral is anisotropic" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-gallery-spiral-arm-spacing-from-the-drawn-100-m-scale-bar> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "gallery spiral arm spacing from the drawn 100 µm scale bar = 90.909 µm" ;
        dct:description "arm/model = 39.084; foreground = 0.5503; coherency = 0.302" ;
        schema:measurementTechnique "Longest bright run in rows 568–578 as 100 µm; radial-FFT peak converted by that scale" ;
        schema:name "gallery spiral arm spacing from the drawn 100 µm scale bar" ;
        schema:unitText "µm" ;
        schema:value "90.909" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-gallery-spiral-arm-spacing-from-the-drawn-100-m-scale-bar-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-gallery-spiral-arm-spacing-from-the-drawn-100-m-scale-bar-reference> a schema:PropertyValue ;
        dct:source "Model λ_c = 2.326 µm. The gallery bar is labeled 100 µm, so equality is not expected" ;
        schema:value "2.326" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-gamma-sweep-pearson-r-of-analytic-versus-numeric-peak-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "gamma sweep Pearson r of analytic versus numeric-peak wavelength = 0.984048 Pearson_r" ;
        dct:description "RMSE µm = 0.9111; monotonic analytic = True" ;
        schema:measurementTechnique "Five γ values; numeric wavelength from the wavenumber of maximum fitted growth rate" ;
        schema:name "gamma sweep Pearson r of analytic versus numeric-peak wavelength" ;
        schema:unitText "Pearson_r" ;
        schema:value "0.984048" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-gamma-sweep-pearson-r-of-analytic-versus-numeric-peak-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-gamma-sweep-pearson-r-of-analytic-versus-numeric-peak-wavelength-reference> a schema:PropertyValue ;
        dct:source "λ ∝ γ^(−1/2) at fixed diffusivities (Turing 1952)" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-schnakenberg-dispersion-pearson-r-of-numeric-versus-analytic-growth-rates> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Schnakenberg dispersion Pearson r of numeric versus analytic growth rates = 1.0 Pearson_r" ;
        dct:description "RMSE = 4.9e-05" ;
        schema:measurementTechnique "Eigenvector-initialized cosine modes; late-time log-amplitude slope versus the largest Jacobian eigenvalue at the discrete Laplacian wavenumber" ;
        schema:name "Schnakenberg dispersion Pearson r of numeric versus analytic growth rates" ;
        schema:unitText "Pearson_r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-schnakenberg-dispersion-pearson-r-of-numeric-versus-analytic-growth-rates-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-schnakenberg-dispersion-pearson-r-of-numeric-versus-analytic-growth-rates-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 Phil. Trans. R. Soc. B 237:37 linear dispersion; identity is the ideal, the grid Laplacian is the measurement" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-two-sample-ks-distance-between-gallery-luminance-and-activator-field> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "two-sample KS distance between gallery luminance and activator field = 0.2488 KS" ;
        schema:measurementTechnique "ks_2samp on interior gallery luminance versus the saturated activator on the periodic patch" ;
        schema:name "two-sample KS distance between gallery luminance and activator field" ;
        schema:unitText "KS" ;
        schema:value "0.2488" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-two-sample-ks-distance-between-gallery-luminance-and-activator-field-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-two-sample-ks-distance-between-gallery-luminance-and-activator-field-reference> a schema:PropertyValue ;
        dct:source "A KS of 0 would mean the Schnakenberg field reproduces the gallery luminance distribution" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-santomea-turing-wavelength-s0.py L517–L607" ;
        dct:description "measure_morphoeval rows for r, wavelength gaps, ablation σ, KS, and arm spacing" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-santomea-turing-wavelength-s0.py#L517-L607> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-santomea-turing-wavelength-s0.py L314–L375" ;
        dct:description "Scale-bar span and radial-FFT arm spacing" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-santomea-turing-wavelength-s0.py#L314-L375> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (single builder-assessor; no separate second-model pass)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://github.com/fractastical> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://github.com/fractastical>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1016/j.cell.2008.01.014>,
            <https://doi.org/10.1098/rspb.2000.1169>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.0014-3820.2002.tb00150.x>,
            <https://www.sciencedirect.com/science/article/pii/0022519379902580> .
    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:date "1981"^^xsd:gYear ;
        dct:title "A pre-pattern formation mechanism for animal coat markings" .
    <https://doi.org/10.1016/j.cell.2008.01.014> dct:date "2008"^^xsd:gYear ;
        dct:title "The evolution of gene regulation underlies a morphological difference between two Drosophila sister species" .
    <https://doi.org/10.1098/rspb.2000.1169> dct:date "2000"^^xsd:gYear ;
        dct:title "Evolutionary novelties in islands: Drosophila santomea, a new melanogaster sister species from São Tomé" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1111/j.0014-3820.2002.tb00150.x> dct:date "2002"^^xsd:gYear ;
        dct:title "Genetics of a difference in pigmentation between Drosophila yakuba and Drosophila santomea" .
    <https://www.sciencedirect.com/science/article/pii/0022519379902580> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
}


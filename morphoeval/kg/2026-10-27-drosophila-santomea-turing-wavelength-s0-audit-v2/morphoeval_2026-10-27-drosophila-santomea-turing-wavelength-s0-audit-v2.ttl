<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila santomea Schnakenberg wavelength at 2.326 µm (Holocene, 0 Ma), pass 2 — Morphological realism / specimen match: 78/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The adult GIF frame is a 0.40 blend of the gallery field into the sepia-scaled activator, so the silhouette of that spiral field is present. The spot panel itself is not a spiral, and the measured arm spacing (90.909 µm) is not 2.326 µm. The score credits the documented visual comparison and withholds credit for a false length match." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-specimen-match-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-specimen-match-2>,

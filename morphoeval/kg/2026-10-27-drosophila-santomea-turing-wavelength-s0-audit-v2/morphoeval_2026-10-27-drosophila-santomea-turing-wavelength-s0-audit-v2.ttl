<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila santomea Schnakenberg wavelength at 2.326 µm (Holocene, 0 Ma), pass 2 — Morphometric validation: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Dispersion RMSE is 4.9e-5 (r rounded to 1.0 at six decimals, reference ideal 1). Wavelength-sweep RMSE is 0.91 µm and is reported, not hidden. KS(gallery, activator) = 0.249 against a reference of 0. Gallery arm spacing 90.909 µm against reference 2.326 µm. None of these pairs are value-equals-reference." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-santomea-turing-wavelength-s0-measurement-chronoseries-wavelength-gap-santomea-minus-pseudoobscura-at-the-2-3-m-tier>,

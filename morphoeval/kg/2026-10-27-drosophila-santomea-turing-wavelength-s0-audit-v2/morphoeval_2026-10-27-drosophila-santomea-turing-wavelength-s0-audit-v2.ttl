<https://w3id.org/delphi/resource/evidence/2026-10-27-drosophila-santomea-turing-wavelength-s0-audit-v2-delphi10000-drosophila-santomea-turing-wavelength-s0-1> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "Schnakenberg dispersion Pearson r of numeric versus analytic growth rates" ;
    dct:description "Eigenvector-initialized cosine modes; late-time log-amplitude slope versus the largest Jacobian eigenvalue at the discrete Laplacian wavenumber" ;
    dct:source "Turing 1952 Phil. Trans. R. Soc. B 237:37 linear dispersion; identity is the ideal, the grid Laplacian is the measurement" ;
    rdfs:comment "RMSE = 4.9e-05" ;
    schema:about "Drosophila santomea" ;
    schema:error 0e+00 ;
    schema:targetValue 1e+00 ;
    schema:unitText "Pearson_r" ;
    schema:value 1e+00 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-drosophila-santomea-turing-wavelength-s0-audit-v2-delphi10000-drosophila-santomea-turing-wavelength-s0-2> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "D. santomea critical wavelength at gamma = 1" ;
    dct:description "λ_c = 2π ξ / k_c with ξ fixed so the continuous formula equals 2.326 µm" ;
    dct:source "Slot 3201 assigned detail scale 2.3 µm (stored exactly as 2.326 µm)" ;
    rdfs:comment "2.326 ≠ 2.3; the reference is the one-decimal assignment and the value is the locked three-decimal wavelength" ;
    schema:about "Drosophila santomea" ;
    schema:error 1.1304e+00 ;
    schema:targetValue 2.3e+00 ;
    schema:unitText "µm" ;
    schema:value 2.326e+00 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-drosophila-santomea-turing-wavelength-s0-audit-v2-delphi10000-drosophila-santomea-turing-wavelength-s0-3> a schema:QuantitativeValue,

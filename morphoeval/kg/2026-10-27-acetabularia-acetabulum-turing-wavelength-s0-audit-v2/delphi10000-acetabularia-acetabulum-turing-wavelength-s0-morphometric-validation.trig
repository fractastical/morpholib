sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Acetabularia acetabulum Turing wavelength at 25.28 µm (Holocene, detail scale) — Morphometric validation: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 0.9996 with RMSE 0.016 /s (numeric slopes are not a copy of the analytic curve). Wavelength-sweep RMSE is 0.23 µm. Orientation KS against the CC0 cap is 0.191. Ablation ratio is 0.097 against a null of 1. Saturated peak 25.08 µm against tier reference 25.28 µm." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-dispersion-goodness-of-fit-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-nominal-inhibitor-anisotropy-hoop-dominated-ridge-flag>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-simulation-stripe-wavelength-fft-peak-on-the-cap-wall-patch>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-specimen-cap-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-specimen-vs-simulation-orientation-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-wavelength-sweep-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-dispersion-goodness-of-fit-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion goodness-of-fit Pearson r = 0.9995710160511999 1" ;
        dct:description "RMSE 0.0147 s^-1 across 9 wavenumbers" ;
        schema:measurementTechnique "Pearson r between analytic σ(k) and early-time log-amplitude slopes of 1D hoop modes" ;
        schema:name "dispersion goodness-of-fit Pearson r" ;
        schema:unitText "1" ;
        schema:value "0.9995710160511999" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-dispersion-goodness-of-fit-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-dispersion-goodness-of-fit-pearson-r-reference> a schema:PropertyValue ;
        dct:source "ideal correlation; the measured r is the finite-grid fit, not forced to 1" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation amplitude ratio = 0.09702101753248442 std_final/std_initial" ;
        dct:description "std 0.0813 -> 0.0079" ;
        schema:measurementTechnique "Brusselator with D_u = D_v and no anisotropy; noise must decay because the cross term is negative" ;
        schema:name "equal-diffusion ablation amplitude ratio" ;
        schema:unitText "std_final/std_initial" ;
        schema:value "0.09702101753248442" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "ratio 1 would be a null control that did nothing; decay is the predicted negative control" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-nominal-inhibitor-anisotropy-hoop-dominated-ridge-flag> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nominal inhibitor anisotropy hoop-dominated ridge flag = 8.0 Fourier mode" ;
        dct:description "expressivity: lowering the axial/hoop ratio moves power onto axial ridges; the two indices are not equal" ;
        schema:measurementTechnique "absolute hoop Fourier index at D_axial/D_hoop = 0.45 in the anisotropy sweep" ;
        schema:name "nominal inhibitor anisotropy hoop-dominated ridge flag" ;
        schema:unitText "Fourier mode" ;
        schema:value "8.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-nominal-inhibitor-anisotropy-hoop-dominated-ridge-flag-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-nominal-inhibitor-anisotropy-hoop-dominated-ridge-flag-reference> a schema:PropertyValue ;
        dct:source "hoop mode index at D_axial/D_hoop = 1.60, where the pattern is no longer hoop-dominated" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-simulation-stripe-wavelength-fft-peak-on-the-cap-wall-patch> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulation stripe wavelength (FFT peak on the cap-wall patch) = 25.08478472332152 µm" ;
        dct:description "centroid 24.7205 µm; onset λ 22.6729 µm; fastest-mode λ 25.4259 µm" ;
        schema:measurementTechnique "2D FFT peak of the final Brusselator activator on the 202.24 µm periodic patch" ;
        schema:name "simulation stripe wavelength (FFT peak on the cap-wall patch)" ;
        schema:unitText "µm" ;
        schema:value "25.08478472332152" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-simulation-stripe-wavelength-fft-peak-on-the-cap-wall-patch-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-simulation-stripe-wavelength-fft-peak-on-the-cap-wall-patch-reference> a schema:PropertyValue ;
        dct:source "Slot tier canonical length 2.528e-5 m (25.28 µm), not a fitted copy of the peak" ;
        schema:value "25.28" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-specimen-cap-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen cap structure-tensor coherency = 0.6246663661831304 1" ;
        dct:description "non-circular: specimen coherency is not set equal to the simulation coherency" ;
        schema:measurementTechnique "Sobel structure tensor on the CC0 cap, crop matching verify_image_fitness" ;
        schema:name "specimen cap structure-tensor coherency" ;
        schema:unitText "1" ;
        schema:value "0.6246663661831304" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-specimen-cap-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-specimen-cap-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "coherency of the rendered last frame (a different image, so value != reference)" ;
        schema:value "0.5410824275982562" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-specimen-vs-simulation-orientation-ks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen-vs-simulation orientation KS = 0.191367994667487 1" ;
        dct:description "orientation entropy specimen 2.306 vs simulation 2.475" ;
        schema:measurementTechnique "two-sample KS on 12-bin Sobel orientation histograms of CC0 cap vs rendered cap" ;
        schema:name "specimen-vs-simulation orientation KS" ;
        schema:unitText "1" ;
        schema:value "0.191367994667487" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-specimen-vs-simulation-orientation-ks-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-specimen-vs-simulation-orientation-ks-reference> a schema:PropertyValue ;
        dct:source "KS = 0 would mean identical orientation distributions; the measured distance is not zero" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-wavelength-sweep-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength-sweep RMSE = 0.22873031318829817 µm" ;
        dct:description "sweep Pearson r = 1.0000" ;
        schema:measurementTechnique "RMSE of λ at the numerical growth-rate peak versus 2π/k_fastest across five diffusivity scales" ;
        schema:name "wavelength-sweep RMSE" ;
        schema:unitText "µm" ;
        schema:value "0.22873031318829817" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-wavelength-sweep-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-measurement-wavelength-sweep-rmse-reference> a schema:PropertyValue ;
        dct:source "zero RMSE would be an exact match to the continuum dispersion; the discrete Laplacian leaves a residual" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acetabularia-acetabulum-turing-wavelength-s0.py L619–L700" ;
        dct:description "measure_morphoeval rows, each value differs from its reference" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/bd2c74bc/models/2026-delphi10000-acetabularia-acetabulum-turing-wavelength-s0.py#L619-L700> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "datasets/acetabularia_acetabulum_turing_wavelength_s0/acetabularia_acetabulum_turing_wavelength_s0_metrics.json (generated output)" ;
        dct:description "dispersion, sweep, KS, ablation, anisotropy rows — datasets/acetabularia_acetabulum_turing_wavelength_s0/acetabularia_acetabulum_turing_wavelength_s0_metrics.json: rendered output of models/2026-delphi10000-acetabularia-acetabulum-turing-wavelength-s0.py at bd2c74bc, application/json, 3949 B, artifact_sha256 505d99dcf9a87b68d0954d570ebfd3d71810d0190dc9d9b5824c5bb14e65b754 (sha256 505d99dcf9a87b68d0954d570ebfd3d71810d0190dc9d9b5824c5bb14e65b754), spec_fingerprint 96087cd4e2bc623a26b35d593a33788c367131953ba2d7b731f791fb3ce2cc1b" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor; second assessor not run)" ;

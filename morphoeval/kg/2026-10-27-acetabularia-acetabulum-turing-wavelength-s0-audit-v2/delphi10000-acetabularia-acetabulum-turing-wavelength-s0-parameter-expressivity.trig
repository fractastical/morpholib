        rdfs:label "Acetabularia acetabulum Turing wavelength at 25.28 µm (Holocene, detail scale) — Parameter expressivity: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Wavelength tracks diffusivity (r = 0.99999 across five scales). The anisotropy sweep is monotonic in the intended sense: ratios below 1 are hoop-dominated and 1.60 is axially dominated. Equal diffusion decays. The face-on GIF shows the nominal ratio only." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

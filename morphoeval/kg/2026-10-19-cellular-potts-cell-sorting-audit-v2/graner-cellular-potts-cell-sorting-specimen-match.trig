sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-graner-cellular-potts-cell-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) extended large-Q Cellular Potts Model cell sorting — Morphological realism / specimen match: 89/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the confocal fluorescence embryonic cell aggregate specimen (`datasets/cellular_potts_cell_sorting/embryonic_cell_aggregate_specimen.jpg`, CC BY 3.0), segments the GFP-positive inner dark-type cell bolus (`r_D/R = 0.49`) and outer polygonal RFP-outlined light-type tissue matrix (`r_L/R = 0.77`, empirical `Δr = +0.2793` vs simulated `Δr = +0.3317`, L525-626), and overlays empirical vs. simulated radial occupancy profiles across 12 concentric annuli (`Pearson r = 0.9612, RMSE = 0.154`, Panel B4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-specimen-match-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py L525–L626" ;
        dct:description "Confocal embryonic cell aggregate GFP core and RFP shell segmentation and radial profile comparison" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py#L525-L626> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/cellular_potts_cell_sorting_comparison.png (generated output)" ;
        dct:description "10-panel synthesis figure displaying all 4 CPM phase regimes, T=0 pinning control, specimen segmentation (B3), and radial profile match (B4) — docs/media/cellular_potts_cell_sorting_comparison.png: rendered output of 1992-graner-cellular-potts-cell-sorting.py at b9976f8, image/png, 625763 B, 3000×1260 px, artifact_sha256 94cf7dc29ecf10cff051dd93ee95b5ee2557e2bab5b85948a912a902322f4ffe (sha256 94cf7dc29ecf10cff051dd93ee95b5ee2557e2bab5b85948a912a902322f4ffe), spec_fingerprint 7cdd3f38f0e6192e614f25f3f47d81cb4d09870705b0e0dca1d1d4dbca9f4cc0" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-graner-cellular-potts-cell-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) extended large-Q Cellular Potts Model cell sorting — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements Graner & Glazier's (1992) PRL Eqs. (1)-(3) surface tension laws (`compute_cpm_tensions`, L97-144) and 2D extended large-Q Cellular Potts Hamiltonian (`simulate_cpm_regime`, L249-456) across all 4 canonical phase regimes plus 2 negative/pinning controls: complete engulfment (`0 < gamma_LD = 3 < 6`, Δr = +0.3317, L_LD/L = 0.1705), partial sorting lens (`gamma_LD = 8 > 6`, L_LD/L = 0.138), checkerboard mixing (`gamma_LD = -10 < 0`, L_LD/L = 0.720), cell dissociation (`gamma_LM = -5 < 0`), zero-temperature pinning arrest (`T = 0`, |Δr| = 0.0155, L_LD/L = 0.424), and equal-adhesion control (`gamma_LD = 0`, |Δr| = 0.0353). Backed by 3 machine-checked Lean 4 theorems (0 sorrys)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py L97–L144" ;
        dcterms:description "Exact Graner & Glazier (1992) PRL Eqs. 2-3 surface tension formulas and phase regime classifier" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py#L97-L144> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py L249–L456" ;
        dcterms:description "2D Cellular Potts solver across all 4 canonical phase regimes plus T=0 pinning arrest and equal-adhesion controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py#L249-L456> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_042_cellular_potts_cell_sorting.lean L17–L99" ;
        dcterms:description "3 machine-checked Lean 4 theorems for CPM surface tensions, 4 phase regimes, and volume elasticity barrier" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/morphoeval/lean/loops/Loop_042_cellular_potts_cell_sorting.lean#L17-L99> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


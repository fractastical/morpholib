sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-graner-cellular-potts-cell-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-checkerboard-mixing-heterotypic-boundary-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "checkerboard_mixing_heterotypic_boundary_fraction = 0.7201 fraction" ;
        schema:measurementTechnique "Final heterotypic boundary fraction L_LD/L_total in checkerboard mixing regime (gamma_LD = -10 < 0)" ;
        schema:name "checkerboard_mixing_heterotypic_boundary_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.7201" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-checkerboard-mixing-heterotypic-boundary-fraction-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-checkerboard-mixing-heterotypic-boundary-fraction-reference> a schema:PropertyValue ;
        schema:value "0.72" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-heterotypic-boundary-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "complete_sorting_heterotypic_boundary_fraction = 0.1705 fraction" ;
        schema:measurementTechnique "Final heterotypic boundary fraction L_LD/L_total after 150 MCS with logarithmic decay r=-0.9459 (p=9.40e-75, Fig. 3 checkpoint r=0.9724)" ;
        schema:name "complete_sorting_heterotypic_boundary_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.1705" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-heterotypic-boundary-fraction-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-heterotypic-boundary-fraction-reference> a schema:PropertyValue ;
        schema:value "0.15" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-radial-core-shell-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "complete_sorting_radial_core_shell_separation = 0.3317 normalized_radius" ;
        schema:measurementTechnique "Normalized radial separation (r_L - r_D)/R_agg in complete sorting regime vs segmented confocal embryonic cell aggregate specimen (r=0.9612, p=0.0001)" ;
        schema:name "complete_sorting_radial_core_shell_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.3317" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-radial-core-shell-separation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-radial-core-shell-separation-reference> a schema:PropertyValue ;
        schema:value "0.2793" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-equal-adhesion-control-radial-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_adhesion_control_radial_separation = 0.0353 normalized_radius" ;
        schema:measurementTechnique "Null radial core-shell separation |r_L - r_D|/R_agg in equal-adhesion negative control (J_LL=J_DD=J_LD=10, gamma_LD=0)" ;
        schema:name "equal_adhesion_control_radial_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.0353" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-equal-adhesion-control-radial-separation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-equal-adhesion-control-radial-separation-reference> a schema:PropertyValue ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-gamma-ld-sorting> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "graner_glazier_gamma_LD_sorting = 3.0 bond_energy_units" ;
        schema:measurementTechnique "Exact Graner & Glazier (1992) PRL Eq. 2 heterotypic surface tension gamma_LD = J_LD - (J_LL + J_DD)/2 for J_LL=14, J_DD=2, J_LD=11" ;
        schema:name "graner_glazier_gamma_LD_sorting" ;
        schema:unitText "bond_energy_units" ;
        schema:value "3.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-gamma-ld-sorting-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-gamma-ld-sorting-reference> a schema:PropertyValue ;
        schema:value "3.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-spreading-tension-diff> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "graner_glazier_spreading_tension_diff = 6.0 bond_energy_units" ;
        schema:measurementTechnique "Spreading tension difference gamma_DM - gamma_LM = (J_DM - J_DD/2) - (J_LM - J_LL/2) = 15 - 9 = 6 (Graner & Glazier 1992 PRL Eq. 3)" ;
        schema:name "graner_glazier_spreading_tension_diff" ;
        schema:unitText "bond_energy_units" ;
        schema:value "6.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-spreading-tension-diff-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-spreading-tension-diff-reference> a schema:PropertyValue ;
        schema:value "6.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-specimen-vs-cpm-radial-profile-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_vs_cpm_radial_profile_pearson_r = 0.9612 r" ;
        schema:measurementTechnique "Pearson correlation between CPM radial core-shell profile and confocal embryonic cell aggregate GFP/RFP profile across 12 radial annuli (RMSE=0.1538, p=0.0001)" ;
        schema:name "specimen_vs_cpm_radial_profile_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9612" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-specimen-vs-cpm-radial-profile-pearson-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-specimen-vs-cpm-radial-profile-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.95" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-zero-temperature-pinning-arrest-radial-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "zero_temperature_pinning_arrest_radial_separation = 0.0155 normalized_radius" ;
        schema:measurementTechnique "Pinned radial separation |r_L - r_D|/R_agg in T=0 lattice pinning arrest control (Glazier & Graner 1993 PRE Section III.B)" ;
        schema:name "zero_temperature_pinning_arrest_radial_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.0155" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-zero-temperature-pinning-arrest-radial-separation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-zero-temperature-pinning-arrest-radial-separation-reference> a schema:PropertyValue ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py L149–L246" ;
        dcterms:description "8-neighbor heterotypic boundary fraction, outer envelopment fraction, cell volume RMS error, and 12-annulus radial density profiles" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py#L149-L246> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py L787–L860" ;
        dcterms:description "8 dynamic morphometric measurements with non-null reference values" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py#L787-L860> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) extended large-Q Cellular Potts Model cell sorting — Morphometric validation: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes 8 quantitative morphometrics in `measure_morphoeval()` (L787-860), including normalized radial core-shell separation `Δr = +0.3317`, fractional heterotypic boundary length `L_LD/L_total = 0.1705` with logarithmic decay fit (`r = -0.9459, p < 1e-70`) and Graner & Glazier (1992) Fig. 3 checkpoint concordance (`r = 0.9724`), zero-temperature pinning arrest (`|Δr| = 0.0155`), equal-adhesion null separation (`|Δr| = 0.0353`), and 12-annulus radial profile correlation against the segmented confocal specimen (`r = 0.9612, RMSE = 0.154`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-checkerboard-mixing-heterotypic-boundary-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-heterotypic-boundary-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-radial-core-shell-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-equal-adhesion-control-radial-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-gamma-ld-sorting>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-spreading-tension-diff>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-specimen-vs-cpm-radial-profile-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-zero-temperature-pinning-arrest-radial-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-morphometric-validation-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Bacillus subtilis Turing wavenumber at 16 µm (Holocene detail scale) — Code-to-model traceability: 89/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The dispersion, the discrete Laplacian used in the fit, and the pass-2 comments that explain the longer integration and the dropped mode sit next to the code they describe. The Lean file proves the trace sign, the 16-versus-10 identities, and the ratio-9.2 threshold. Those proofs were not run through a Lean binary here." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-code-traceability-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-bacillus-subtilis-turing-wavelength-s0.py L204–L217" ;
        dct:description "Comment and mode list for the Turing-band fit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9e461936b246cc6182241d6552184d9a372036e6/models/2026-delphi10000-bacillus-subtilis-turing-wavelength-s0.py#L204-L217> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3130_bacillus_subtilis_turing_wavelength_s0.lean L8–L36" ;
        dct:description "Six decide theorems, zero sorry, no imports" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9e461936b246cc6182241d6552184d9a372036e6/morphoeval/lean/loops/Loop_3130_bacillus_subtilis_turing_wavelength_s0.lean#L8-L36> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;

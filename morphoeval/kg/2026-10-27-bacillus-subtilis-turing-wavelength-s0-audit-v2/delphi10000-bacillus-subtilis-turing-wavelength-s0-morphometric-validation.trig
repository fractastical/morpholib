sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://commons.wikimedia.org/wiki/File:Eye_shaped_Bacillus_subtilis_bacteria_colony_under_the_microscope.jpg>,
            <https://doi.org/10.1006/jtbi.1997.0462>,
            <https://doi.org/10.1016/S0378-4371(98)00345-8>,
            <https://doi.org/10.1080/000187300405228>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047> .
    <https://commons.wikimedia.org/wiki/File:Eye_shaped_Bacillus_subtilis_bacteria_colony_under_the_microscope.jpg> dct:date "2019"^^xsd:gYear ;
        dct:title "Eye shaped Bacillus subtilis bacteria colony under the microscope" .
    <https://doi.org/10.1006/jtbi.1997.0462> dct:date "1997"^^xsd:gYear ;
        dct:title "Modeling spatio-temporal patterns generated by Bacillus subtilis" .
    <https://doi.org/10.1016/S0378-4371(98)00345-8> dct:date "1998"^^xsd:gYear ;
        dct:title "Studies of bacterial branching growth using reaction-diffusion models for colonial development" .
    <https://doi.org/10.1080/000187300405228> dct:date "2000"^^xsd:gYear ;
        dct:title "Cooperative self-organization of microorganisms" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.1179047> dct:date "2010"^^xsd:gYear ;
        dct:title "Reaction-diffusion model as a framework for understanding biological pattern formation" .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Bacillus subtilis Turing wavenumber at 16 µm (Holocene detail scale) — Morphometric validation: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "On modes n=8 through 20, Pearson r is 0.99998 and RMSE is 0.00110 (pass 1 RMSE was 0.108 because mode n=6 was included). The bulk radial wavelength is 16.00 µm against the 16 µm slot target. The specimen ridge count is 43 against model mode 72, foreground fraction 0.169 against a 0.35 placeholder, and coherency 0.522 against 0.5, so the specimen metrics are not self-copies." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-bulk-pde-dominant-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-calibrated-turing-wavelength-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-dispersion-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-dispersion-pearson-r-numerical-slope-vs-discrete-laplacian>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-specimen-ocellus-angular-branch-harmonic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-wavenumber-ratio-versus-10-m-tier-center>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-bulk-pde-dominant-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "bulk PDE dominant wavelength = 16.0 µm" ;
        dct:description "radial mode n = 12" ;
        schema:measurementTechnique "radial FFT peak of the nonlinear Schnakenberg field on a 192 µm periodic square" ;
        schema:name "bulk PDE dominant wavelength" ;
        schema:unitText "µm" ;
        schema:value "16.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-bulk-pde-dominant-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-bulk-pde-dominant-wavelength-reference> a schema:PropertyValue ;
        schema:value "16.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-calibrated-turing-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "calibrated Turing wavelength lambda_c = 16.02002503128911 µm" ;
        dct:description "detail variant of tier 4_cellular_10um; tier center is 10 µm" ;
        schema:measurementTechnique "argmax_k of Schnakenberg σ₊(k) at diffusion ratio 9.20" ;
        schema:name "calibrated Turing wavelength lambda_c" ;
        schema:unitText "µm" ;
        schema:value "16.02002503128911" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-calibrated-turing-wavelength-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-calibrated-turing-wavelength-lambda-c-reference> a schema:PropertyValue ;
        schema:value "16.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-dispersion-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion KS statistic = 0.11111111111111116 KS distance" ;
        dct:description "p = 1.0000" ;
        schema:measurementTechnique "two-sample Kolmogorov-Smirnov between measured and predicted growth rates" ;
        schema:name "dispersion KS statistic" ;
        schema:unitText "KS distance" ;
        schema:value "0.11111111111111116" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-dispersion-pearson-r-numerical-slope-vs-discrete-laplacian> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion Pearson r (numerical slope vs discrete Laplacian σ) = 0.9999789061500759 correlation" ;
        dct:description "RMSE = 0.001104; KS statistic = 0.1111; KS p = 1.0000" ;
        schema:measurementTechnique "early-time log-amplitude slope of Fourier modes n=6..20 versus σ₊(k_eff)" ;
        schema:name "dispersion Pearson r (numerical slope vs discrete Laplacian σ)" ;
        schema:unitText "correlation" ;
        schema:value "0.9999789061500759" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-dispersion-pearson-r-numerical-slope-vs-discrete-laplacian-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-dispersion-pearson-r-numerical-slope-vs-discrete-laplacian-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 0.0011037226447733438 1/time" ;
        schema:measurementTechnique "root mean square of σ_measured − σ_predicted over 10 Fourier modes" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.0011037226447733438" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation sigma_max = -0.08486301655606981 1/time" ;
        dct:description "variance ratio final/initial = 0.0094" ;
        schema:measurementTechnique "max σ₊(k) at D_u = D_v (ratio 1 < critical ratio)" ;
        schema:name "equal-diffusion ablation sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.08486301655606981" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen foreground fraction = 0.1694335255066387 area fraction" ;
        dct:description "disk circularity = 0.0036; coherency = 0.5223" ;
        schema:measurementTechnique "pixels inside the circular stop darker than agar median minus 0.08" ;
        schema:name "specimen foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.1694335255066387" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        schema:value "0.35" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-specimen-ocellus-angular-branch-harmonic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen ocellus angular branch harmonic = 43 angular mode" ;
        dct:description "reference is the model circumference mode m = round(2π R / 16 µm), not a copy of the image peak" ;
        schema:measurementTechnique "FFT peak of the dark-branch annulus (0.22–0.40 of the frame) on the Korinna 2019 micrograph" ;
        schema:name "specimen ocellus angular branch harmonic" ;
        schema:unitText "angular mode" ;
        schema:value "43" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-specimen-ocellus-angular-branch-harmonic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-specimen-ocellus-angular-branch-harmonic-reference> a schema:PropertyValue ;
        schema:value "72" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.5222689259070664 coherency" ;
        schema:measurementTechnique "mean (λ1−λ2)/(λ1+λ2) of the Sobel structure tensor inside the microscope stop" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.5222689259070664" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-wavenumber-ratio-versus-10-m-tier-center> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavenumber ratio versus 10 µm tier center = 0.62421875 ratio" ;
        dct:description "chronoseries is 1/1 so the age change versus a predecessor species is 0 Ma; the scale change is this ratio" ;
        schema:measurementTechnique "calibrated k_star divided by 2 pi / 10 µm; the exact slot identity is 0.625" ;
        schema:name "wavenumber ratio versus 10 µm tier center" ;
        schema:unitText "ratio" ;
        schema:value "0.62421875" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-wavenumber-ratio-versus-10-m-tier-center-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-measurement-wavenumber-ratio-versus-10-m-tier-center-reference> a schema:PropertyValue ;
        schema:value "0.625" .

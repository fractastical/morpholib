sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Bacillus subtilis Turing wavenumber at 16 µm (Holocene detail scale) — Morphological realism / specimen match: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The 12-frame 520 px GIF scores cv_sim_similarity 89.4 against the Korinna 2019 ocellus (Sobel orientation, radial FFT, structure-tensor coherency). Pass 2 raised ray contrast from 0.48 to 0.82 so the branches read as dark ridges. They remain more regular than the dendritic micrograph." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/bacillus_subtilis_turing_wavelength_s0_growth.gif L1–L1" ;
        dct:description "12 frames, 520 px, last frame is the scored ocellus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9e461936b246cc6182241d6552184d9a372036e6/docs/media/bacillus_subtilis_turing_wavelength_s0_growth.gif#L1-L1> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-bacillus-subtilis-turing-wavelength-s0.py L415–L433" ;
        dct:description "contrast 0.82 and blur 1.5 after the pass-1 faint-ray failure" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9e461936b246cc6182241d6552184d9a372036e6/models/2026-delphi10000-bacillus-subtilis-turing-wavelength-s0.py#L415-L433> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (loop 3130 pass 2 primary assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


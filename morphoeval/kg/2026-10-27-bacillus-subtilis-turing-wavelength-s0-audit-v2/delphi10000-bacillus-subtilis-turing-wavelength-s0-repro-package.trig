        rdfs:label "Bacillus subtilis Turing wavenumber at 16 µm (Holocene detail scale) — Reproducibility package: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Seed 3130, --self-test, and pass_metrics.json. Self-test requires Pearson r > 0.98, a monotonic sweep, a suppressed ablation, and the 12-wavelength domain identity. Re-running the script regenerates the PNG and the 12-frame GIF." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

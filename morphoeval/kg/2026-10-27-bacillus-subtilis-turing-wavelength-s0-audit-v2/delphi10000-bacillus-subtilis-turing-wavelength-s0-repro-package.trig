        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-repro-package-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-bacillus-subtilis-turing-wavelength-s0.py L670–L705" ;
        dct:description "self_test assertions including Pearson r > 0.98" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9e461936b246cc6182241d6552184d9a372036e6/models/2026-delphi10000-bacillus-subtilis-turing-wavelength-s0.py#L670-L705> .

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila ananassae Turing wavenumber at 2.1 µm (Holocene, 0 Ma) — Parameter expressivity: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Multiplying both diffusivities by s² moves analytic and FFT wavelengths together across s = 0.75 to 1.50. Holding Du fixed, raising Dv/Du from 8 to 28 lengthens λ from 1.75 µm to 2.26 µm and carries σ from negative (no Turing) to positive." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-ananassae-turing-wavelength-s0.py L317–L360" ;
        dct:description "scale_sweep and ratio_sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/94b693bd2928b4d8996239b3f400b320fcf30723/models/2026-delphi10000-drosophila-ananassae-turing-wavelength-s0.py#L317-L360> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-ananassae-turing-wavelength-s0.py L626–L630" ;
        dct:description "self-test requires r > 0.98 and a longer wavelength at the high ratio" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/94b693bd2928b4d8996239b3f400b320fcf30723/models/2026-delphi10000-drosophila-ananassae-turing-wavelength-s0.py#L626-L630> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 builder-assessor, pass 2 (no second assessor on this run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


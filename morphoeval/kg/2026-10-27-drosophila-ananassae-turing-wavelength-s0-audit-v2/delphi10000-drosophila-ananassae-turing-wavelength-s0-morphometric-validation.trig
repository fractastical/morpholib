sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila ananassae Turing wavenumber at 2.1 µm (Holocene, 0 Ma) — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r = 0.99483 and RMSE = 8.05e-8 m on six scales, with KS statistic 0.167 between the analytic and FFT samples. Plate circularity 0.136 is scored against a circle null of 1, and the render coherency gap is scored against 0. The same sweep is used to fit and to score." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-equal-diffusion-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-fft-wavelength-m>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-growth-gif-frame-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-growth-gif-min-resolution-px>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-ks-statistic-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-pearson-r-wavelength-law>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-rmse-wavelength-m>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-specimen-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-specimen-render-coherency-gap>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-wavelength-ratio-americana-over-s0>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-equal-diffusion-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_diffusion_std_ratio = 0.0002 1" ;
        schema:measurementTechnique "final/initial activator std with Du = Dv, 2000 steps" ;
        schema:name "equal_diffusion_std_ratio" ;
        schema:unitText "1" ;
        schema:value "0.0002" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-equal-diffusion-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-measurement-equal-diffusion-std-ratio-reference> a schema:PropertyValue ;
        dct:source "nominal Schnakenberg std ratio at the same seed and step count" ;
        schema:value "1.7262" .

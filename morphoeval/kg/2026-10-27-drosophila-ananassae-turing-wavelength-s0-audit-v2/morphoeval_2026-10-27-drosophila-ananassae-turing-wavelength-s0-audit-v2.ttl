<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-ananassae-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg activator-inhibitor kinetics" ;
    dct:description "Intracellular pigment kinetics for D. ananassae at 2.1 µm and 0 Ma | Variables: a=0.11, b=1.15, Du=0.604, Dv=11.893 (Dv/Du=19.7) at the 2.106 µm scale" ;
    dct:source "Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/94b693bd2928b4d8996239b3f400b320fcf30723/models/2026-delphi10000-drosophila-ananassae-turing-wavelength-s0.py#L78-L104>,
        <https://github.com/fractastical/morpholib/blob/94b693bd2928b4d8996239b3f400b320fcf30723/morphoeval/lean/loops/Loop_3176_drosophila_ananassae_turing_wavelength_s0.lean#L21-L40> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "def turingH (Du Dv fu gvAbs : Nat) : Int := (Dv : Int) * (fu : Int) - (Du : Int) * (gvAbs : Int)"^^pk:lean4 ;
    skos:notation "du/dt = Du ∇²u + a - u + u²v ; dv/dt = Dv ∇²v + b - u²v" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0012-1606(76)90225-6>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/S0168-9525(03)00194-X>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3176.turingH" ;
    pk:leanTheorem "MathOfBiology.Loop_3176.nominal_ratio_is_turing_equal_diffusion_is_not" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-ananassae-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Fastest Turing wavenumber" ;
    dct:description "Selects the 2.1 µm detail wavelength rather than a cellular stripe | Variables: k in rad/pixel; six wavelengths span the 12.636 µm cell patch" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/94b693bd2928b4d8996239b3f400b320fcf30723/models/2026-delphi10000-drosophila-ananassae-turing-wavelength-s0.py#L106-L128>,
        <https://github.com/fractastical/morpholib/blob/94b693bd2928b4d8996239b3f400b320fcf30723/morphoeval/lean/loops/Loop_3176_drosophila_ananassae_turing_wavelength_s0.lean#L12-L26> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "def lambdaS0Nm : Nat := 2106"^^pk:lean4 ;
    skos:notation "k_c = argmax_k Re σ(k), λ_c = 2π / k_c, dx = 2.106e-06 / λ_px" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0012-1606(76)90225-6>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/S0168-9525(03)00194-X>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3176.lambdaS0Nm" ;
    pk:leanTheorem "MathOfBiology.Loop_3176.six_wavelengths_span_cell_patch" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-ananassae-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronospecies diffusivity collapse" ;
    dct:description "States the scale change versus the chronospecies on either side | Variables: predecessor D. americana 139 µm; successor D. biarmipes 96 µm; this slot 2.106 µm at 0 Ma" ;
    dct:source "Gompel et al. (2005) DOI:10.1038/nature03235; Wittkopp, Carroll & Kopp (2003) DOI:10.1016/S0168-9525(03)00194-X" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/94b693bd2928b4d8996239b3f400b320fcf30723/models/2026-delphi10000-drosophila-ananassae-turing-wavelength-s0.py#L130-L148>,
        <https://github.com/fractastical/morpholib/blob/94b693bd2928b4d8996239b3f400b320fcf30723/morphoeval/lean/loops/Loop_3176_drosophila_ananassae_turing_wavelength_s0.lean#L29-L36> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem americana_coarser_than_ananassae_detail : lambdaAmericanaNm > 60 * lambdaS0Nm"^^pk:lean4 ;
    skos:notation "D_americana / D_s0 = (λ_americana / λ_s0)² with λ_s0 = 2.106 µm, λ_americana = 139 µm, λ_biarmipes = 96 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0012-1606(76)90225-6>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/S0168-9525(03)00194-X>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3176.lambdaAmericanaNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3176.americana_coarser_than_ananassae_detail" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,

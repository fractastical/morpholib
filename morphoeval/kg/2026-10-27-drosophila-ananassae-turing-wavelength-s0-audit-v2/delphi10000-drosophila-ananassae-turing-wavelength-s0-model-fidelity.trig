sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila ananassae Turing wavenumber at 2.1 µm (Holocene, 0 Ma) — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The integrator is the Schnakenberg PDE. Removing either the diffusion difference or the nonlinear term, at the same seed and step count, collapses the activator variance, which is the integrated form of the Turing condition already checked on σ(k)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-ananassae-turing-wavelength-s0.py L79–L124" ;
        dct:description "Jacobian, onset diffusivity, growth rate, fastest mode" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/94b693bd2928b4d8996239b3f400b320fcf30723/models/2026-delphi10000-drosophila-ananassae-turing-wavelength-s0.py#L79-L124> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ananassae-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-ananassae-turing-wavelength-s0.py L362–L372" ;
        dct:description "Integrated equal-diffusion and linear-kinetics ablations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/94b693bd2928b4d8996239b3f400b320fcf30723/models/2026-delphi10000-drosophila-ananassae-turing-wavelength-s0.py#L362-L372> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 builder-assessor, pass 2 (no second assessor on this run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


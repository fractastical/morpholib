sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-steinberg-differential-adhesion-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-overall> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Steinberg (1963, 1970) & Graner-Glazier (1992) differential adhesion cell sorting — MorphoEval overall 54.8/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Pass 1 (v1) evaluation of `1964-steinberg-differential-adhesion-sorting.py` (57.3/100). The v1 baseline implements the Graner & Glazier (1992) 2D Cellular Potts Hamiltonian and Steinberg's interfacial tensions gamma_AB, gamma_AM, gamma_BM for canonical complete engulfment plus an equal-adhesion negative control, but omits the remaining three thermodynamic regimes (checkerboard mixing gamma_AB < 0, partial engulfment gamma_AB > gamma_BM - gamma_AM, and cell dissociation gamma_AM < 0), does not load or segment the vendored confocal embryoid body specimen (`cell_sorting_specimen.jpg`), does not validate Foty & Steinberg's (1996) 5-tissue Gallus gallus surface tension hierarchy, and exposes no CLI parameter flags beyond `--self-test`. Overall 54.8/100 (faithfulness 49.6, reproducibility 66.7); rubric morphoeval 0.1.0; checkpoint commit b9976f8; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1. Dimension assessments: Model fidelity to source 68, Morphological realism / specimen match 35, Parameter expressivity 46, Morphometric validation 52, Source and data traceability 64, Code-to-model traceability 68, Reproducibility package 68. Output judged: docs/media/differential_adhesion_sorting_comparison.png: rendered output of 1964-steinberg-differential-adhesion-sorting.py at b9976f8, image/png, 84361 B, 1680×560 px, artifact_sha256 874f4784a13f5781f808cefad5655203cfc96f4ea35c03bcb21e6722ef038606 (sha256 874f4784a13f5781f808cefad5655203cfc96f4ea35c03bcb21e6722ef038606), spec_fingerprint 439c3a9015bc8fdc9014e2aa3a89cd71cffc876fcd81d0cb0b2f88bbf798d5a9. Dual provenance: spec_fingerprint: 439c3a9015bc8fdc9014e2aa3a89cd71cffc876fcd81d0cb0b2f88bbf798d5a9; artifact_sha256: 874f4784a13f5781f808cefad5655203cfc96f4ea35c03bcb21e6722ef038606." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Load and SHA-256-verify `datasets/differential_adhesion_sorting/differential_adhesion_sorting_reference.json` and `cell_sorting_specimen.jpg`, segment the GFP-positive inner core and RFP-positive outer cortex of the embryoid body specimen, and compare empirical vs. simulated radial density profiles (Pearson r, RMSE, and normalized radial core-shell separation).",
            "remediation needed: Simulate all 5 thermodynamic regimes of Steinberg (1963) & Graner-Glazier (1992) (`checkerboard_mixing` gamma_AB < 0, `complete_engulfment` 0 < gamma_AB < gamma_BM - gamma_AM, `partial_engulfment` gamma_AB > gamma_BM - gamma_AM, `cell_dissociation` gamma_AM < 0, and `equal_adhesion_control` gamma_AB = 0) plus a 7-point continuous sweep across J_AB spanning both phase boundaries.",
            "remediation needed: Validate Foty, Pfleger, Forgacs & Steinberg (1996) Development Table 1 empirical Gallus gallus 5-tissue surface tension hierarchy (20.1 > 12.6 > 8.5 > 4.6 > 1.6 dyn/cm) and logarithmic heterotypic boundary decay L_AB(t) ~ a - b*ln(t), and expose full CLI flags." ;
        pk:hasScore "0.548"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-steinberg-differential-adhesion-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Steinberg (1963, 1970) & Graner-Glazier (1992) differential adhesion cell sorting — Morphometric validation: 52/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes normalized radial core-shell separation `(r_A - r_B)/R_agg` and heterotypic boundary fraction `L_AB / L_total` (`measure_morphoeval`, L192-211), but does not compare simulated radial density profiles against segmented embryoid body fluorescence profiles, does not fit logarithmic boundary-length decay `L_AB(t) ~ a - b*ln(t)` (Graner & Glazier 1992 Fig. 3), and does not validate the Foty et al. (1996) 5-tissue *Gallus gallus* envelopment hierarchy." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1964-steinberg-differential-adhesion-sorting.py L192–L211: 4 basic synthetic measurements without specimen segmentation or logarithmic decay fit <https://github.com/fractastical/morpholib/blob/b9976f8/1964-steinberg-differential-adhesion-sorting.py#L192-L211>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-equal-adhesion-control-radial-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-gamma-ab>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-sorting-heterotypic-boundary-fraction-final>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-sorting-radial-core-shell-separation> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-equal-adhesion-control-radial-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_adhesion_control_radial_separation = 0.0734 normalized_radius" ;
        schema:measurementTechnique "Radial separation |r_A - r_B|/R_agg in equal-adhesion negative control (J_AA=J_BB=J_AB=10)" ;
        schema:name "equal_adhesion_control_radial_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.0734" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-equal-adhesion-control-radial-separation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-equal-adhesion-control-radial-separation-reference> a schema:PropertyValue ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-gamma-ab> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "graner_glazier_gamma_AB = 3.0 bond_energy_units" ;
        schema:measurementTechnique "Exact evaluation of gamma_AB = J_AB - (J_AA + J_BB)/2 for Graner & Glazier (1992) PRL parameters" ;
        schema:name "graner_glazier_gamma_AB" ;
        schema:unitText "bond_energy_units" ;
        schema:value "3.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-gamma-ab-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-gamma-ab-reference> a schema:PropertyValue ;
        schema:value "3.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-sorting-heterotypic-boundary-fraction-final> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "sorting_heterotypic_boundary_fraction_final = 0.2114 fraction" ;
        schema:measurementTechnique "Final heterotypic boundary fraction L_AB / L_total in complete engulfment sorting regime" ;
        schema:name "sorting_heterotypic_boundary_fraction_final" ;
        schema:unitText "fraction" ;
        schema:value "0.2114" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-sorting-heterotypic-boundary-fraction-final-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-sorting-heterotypic-boundary-fraction-final-reference> a schema:PropertyValue ;
        schema:value "0.16" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-sorting-radial-core-shell-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "sorting_radial_core_shell_separation = 0.1202 normalized_radius" ;
        schema:measurementTechnique "Normalized radial separation (r_A - r_B)/R_agg after 120 MCS in complete engulfment regime" ;
        schema:name "sorting_radial_core_shell_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.1202" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-sorting-radial-core-shell-separation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-sorting-radial-core-shell-separation-reference> a schema:PropertyValue ;
        schema:value "0.22" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-steinberg-differential-adhesion-sorting> a pk:Claim ;
        rdfs:label "Steinberg (1963, 1970) & Graner-Glazier (1992) differential adhesion cell sorting faithfully reproduces Chick embryo (Gallus gallus) dissociated tissue aggregates & multicellular embryoid body spheroids morphology" ;
        dcterms:description "The simulation script(s) 1964-steinberg-differential-adhesion-sorting.py implement the cited source model as published and produce forms that match real Chick embryo (Gallus gallus) dissociated tissue aggregates & multicellular embryoid body spheroids specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 54.8/100, audit 2026-10-19-differential-adhesion-sorting-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/b9976f8/1964-steinberg-differential-adhesion-sorting.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/b9976f8/1964-steinberg-differential-adhesion-sorting.py; output: docs/media/differential_adhesion_sorting_comparison.png; organism: Chick embryo (Gallus gallus) dissociated tissue aggregates & multicellular embryoid body spheroids; checkpoint commit: https://github.com/fractastical/morpholib/commit/b9976f8; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 439c3a9015bc8fdc9014e2aa3a89cd71cffc876fcd81d0cb0b2f88bbf798d5a9; artifact_sha256: 874f4784a13f5781f808cefad5655203cfc96f4ea35c03bcb21e6722ef038606" ;
        pk:derivedFromPaper <https://doi.org/10.1002/jez.1401730406>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-specimen-match> ;
        pk:weightOfEvidence "0.548"^^xsd:double .


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-steinberg-differential-adhesion-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Steinberg (1963, 1970) & Graner-Glazier (1992) differential adhesion cell sorting — Parameter expressivity: 46/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Simulates only 2 parameter points (`J_AB=11` sorting vs `J=10` control) without a continuous sweep across heterotypic adhesion `J_AB` (or `gamma_AB`), without mapping the 2D `(gamma_AB, gamma_BM - gamma_AM)` phase diagram, and without CLI flags for `J_AA`, `J_BB`, `J_AB`, `T`, `lam`, or `mcs` (L221-229)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1964-steinberg-differential-adhesion-sorting.py L160–L162: Only 2 hardcoded parameter sets evaluated in render_outputs_v1 <https://github.com/fractastical/morpholib/blob/b9976f8/1964-steinberg-differential-adhesion-sorting.py#L160-L162>",
            "1964-steinberg-differential-adhesion-sorting.py L221–L229: CLI parser only accepts --self-test <https://github.com/fractastical/morpholib/blob/b9976f8/1964-steinberg-differential-adhesion-sorting.py#L221-L229>" ;
        pk:hasScore "0.46"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


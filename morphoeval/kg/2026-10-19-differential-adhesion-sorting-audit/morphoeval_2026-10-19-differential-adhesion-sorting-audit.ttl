    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-differential-adhesion-sorting-audit-steinberg-differential-adhesion-sorting-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-differential-adhesion-sorting-audit-steinberg-differential-adhesion-sorting-2>,

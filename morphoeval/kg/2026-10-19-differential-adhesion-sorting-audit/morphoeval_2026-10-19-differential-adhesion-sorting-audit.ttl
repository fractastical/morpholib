<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/steinberg-differential-adhesion-sorting-1>,
        <https://w3id.org/probknow/resource/math-law/steinberg-differential-adhesion-sorting-2>,
        <https://w3id.org/probknow/resource/math-law/steinberg-differential-adhesion-sorting-3> .

<https://w3id.org/probknow/resource/math-law/steinberg-differential-adhesion-sorting-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Steinberg (1963) Differential Adhesion Interfacial Tension & Equal-Adhesion Null Identity" ;
    dct:description "Defines effective tissue interfacial tensions from microscopic Potts bond energies and proves that equal adhesion eliminates the sorting driving force | Variables: J_{AA}, J_{BB}, J_{AB}: homotypic and heterotypic Potts bond energies; J_{AM}, J_{BM}: cell-medium bond energies; γ_{AB}: heterotypic interfacial tension" ;
    dct:source "Steinberg (1963) Science 141(3579):401-408; Graner & Glazier (1992) Phys. Rev. Lett. 69(13):2013-2016 Eqs. (2)-(3)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b9976f8/1964-steinberg-differential-adhesion-sorting.py#L140-L215>,
        <https://github.com/fractastical/morpholib/blob/b9976f8/morphoeval/lean/loops/Loop_041_differential_adhesion_sorting.lean#L18-L45> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def two_gamma_AB (J_AA J_BB J_AB : Int) : Int :=
  2 * J_AB - (J_AA + J_BB)
theorem steinberg_equal_adhesion_zero_tension (J J_M : Int) :
    two_gamma_AB J J J = 0 ∧ two_spreading_diff J J J_M J_M = 0"""^^pk:lean4 ;
    skos:notation "γ_{AB} = J_{AB} - (J_{AA} + J_{BB})/2,  γ_{τM} = J_{τM} - J_{ττ}/2;  J_{AA} = J_{BB} = J_{AB} ⇒ γ_{AB} = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401730406>,
        <https://doi.org/10.1103/PhysRevE.47.2128>,
        <https://doi.org/10.1103/PhysRevLett.69.2013>,
        <https://doi.org/10.1126/science.141.3579.401>,
        <https://doi.org/10.1242/dev.122.5.1611> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Differential Adhesion Cellular Potts Sorting (Steinberg DAH & Glazier-Graner-Hogeweg Hamiltonian)" ;
    pk:leanDeclaration "MathOfBiology.Loop_041.two_gamma_AB" ;
    pk:leanTheorem "MathOfBiology.Loop_041.steinberg_equal_adhesion_zero_tension" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/steinberg-differential-adhesion-sorting-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Graner & Glazier (1992) Four Thermodynamic Phase Inequalities (Checkerboard, Complete Engulfment, Partial Engulfment, Dissociation)" ;
    dct:description "Partitions adhesion parameter space into checkerboard mixing, concentric complete engulfment sorting, partial engulfment lens doublets, and cell dissociation | Variables: γ_{AB}: heterotypic interfacial tension; γ_{AM}, γ_{BM}: tissue-medium surface tensions for outer shell A and inner core B" ;
    dct:source "Graner & Glazier (1992) Phys. Rev. Lett. 69(13):2013-2016 p. 2014; Glazier & Graner (1993) Phys. Rev. E 47(3):2128-2154 Table I" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b9976f8/1964-steinberg-differential-adhesion-sorting.py#L165-L260>,
        <https://github.com/fractastical/morpholib/blob/b9976f8/morphoeval/lean/loops/Loop_041_differential_adhesion_sorting.lean#L47-L71> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """theorem graner_glazier_1992_complete_engulfment_inequalities :
    two_gamma_AB 14 2 11 = 6 ∧
    two_spreading_diff 14 2 16 16 = 12 ∧
    (0 < two_gamma_AB 14 2 11 ∧ two_gamma_AB 14 2 11 < two_spreading_diff 14 2 16 16) ∧
    two_gamma_AB 14 14 4 < 0 ∧
    two_gamma_AB 14 2 16 > two_spreading_diff 14 2 16 16 ∧
    two_gamma_M 14 2 < 0"""^^pk:lean4 ;
    skos:notation "Checkerboard: γ_{AB} < 0;  Complete engulfment: 0 < γ_{AB} < γ_{BM} - γ_{AM};  Partial engulfment: γ_{AB} > γ_{BM} - γ_{AM} > 0;  Dissociation: γ_{AM} < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401730406>,
        <https://doi.org/10.1103/PhysRevE.47.2128>,
        <https://doi.org/10.1103/PhysRevLett.69.2013>,
        <https://doi.org/10.1126/science.141.3579.401>,
        <https://doi.org/10.1242/dev.122.5.1611> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Differential Adhesion Cellular Potts Sorting (Steinberg DAH & Glazier-Graner-Hogeweg Hamiltonian)" ;
    pk:leanDeclaration "MathOfBiology.Loop_041.two_spreading_diff" ;
    pk:leanTheorem "MathOfBiology.Loop_041.graner_glazier_1992_complete_engulfment_inequalities" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/steinberg-differential-adhesion-sorting-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Foty & Steinberg (1996) Chick Embryo Surface Tension Transitive Envelopment Hierarchy & Potts Hamiltonian" ;
    dct:description "Governs stochastic Metropolis Monte Carlo cell sorting and proves transitive mutual envelopment across all 5 embryonic Gallus gallus tissues | Variables: H: Cellular Potts Hamiltonian; σ_{i,j}: cell spin ID; a_σ: cell area; A_0: target area; σ_tissue: equilibrium tissue surface tension (dyn/cm)" ;
    dct:source "Foty, Pfleger, Forgacs & Steinberg (1996) Development 122(5):1611-1620 Table 1 & Fig. 4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b9976f8/1964-steinberg-differential-adhesion-sorting.py#L265-L420>,
        <https://github.com/fractastical/morpholib/blob/b9976f8/morphoeval/lean/loops/Loop_041_differential_adhesion_sorting.lean#L73-L115> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """theorem foty_1996_transitive_envelopment_hierarchy (sA sB sC : Int)
    (hAB : sB > sA) (hBC : sC > sB) :
    (sC > sA) ∧ ((sC - sA) = (sC - sB) + (sB - sA))
theorem potts_area_energy_equilibrium_zero (lam A0 : Int) :
    potts_area_energy lam A0 A0 = 0"""^^pk:lean4 ;
    skos:notation "H = ∑ J(τ(σ), τ(σ'))(1 - δ_{σ,σ'}) + λ ∑_{σ>0}(a_σ - A_0)^2;  σ_limb (20.1) > σ_pigment (12.6) > σ_heart (8.5) > σ_liver (4.6) > σ_retina (1.6) dyn/cm" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401730406>,
        <https://doi.org/10.1103/PhysRevE.47.2128>,
        <https://doi.org/10.1103/PhysRevLett.69.2013>,
        <https://doi.org/10.1126/science.141.3579.401>,
        <https://doi.org/10.1242/dev.122.5.1611> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Differential Adhesion Cellular Potts Sorting (Steinberg DAH & Glazier-Graner-Hogeweg Hamiltonian)" ;
    pk:leanDeclaration "MathOfBiology.Loop_041.potts_area_energy" ;
    pk:leanTheorem "MathOfBiology.Loop_041.foty_1996_transitive_envelopment_hierarchy" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


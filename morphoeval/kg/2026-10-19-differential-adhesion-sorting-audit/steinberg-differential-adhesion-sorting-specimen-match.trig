sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-steinberg-differential-adhesion-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Steinberg (1963, 1970) & Graner-Glazier (1992) differential adhesion cell sorting — Morphological realism / specimen match: 35/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Although `datasets/differential_adhesion_sorting/cell_sorting_specimen.jpg` is vendored in the repository, the v1 script never loads, verifies, or segments the confocal embryoid body specimen image (`render_outputs_v1`, L159-189) and shows only a 3-panel synthetic plot." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1964-steinberg-differential-adhesion-sorting.py L159–L189: render_outputs_v1 renders 3 synthetic panels without loading or segmenting cell_sorting_specimen.jpg <https://github.com/fractastical/morpholib/blob/b9976f8/1964-steinberg-differential-adhesion-sorting.py#L159-L189>",
            "docs/media/differential_adhesion_sorting_comparison.png (generated output, not in repo): 3-panel synthetic figure lacking biological specimen overlay or radial fluorescence comparison — docs/media/differential_adhesion_sorting_comparison.png: rendered output of 1964-steinberg-differential-adhesion-sorting.py at b9976f8, image/png, 84361 B, 1680×560 px, artifact_sha256 874f4784a13f5781f808cefad5655203cfc96f4ea35c03bcb21e6722ef038606 (sha256 874f4784a13f5781f808cefad5655203cfc96f4ea35c03bcb21e6722ef038606), spec_fingerprint 439c3a9015bc8fdc9014e2aa3a89cd71cffc876fcd81d0cb0b2f88bbf798d5a9" ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


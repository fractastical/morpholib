sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Ciona intestinalis Turing wavelength at 51 µm (5.056e-05 m), Holocene 0 Ma — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r = 0.99939 on log critical-mode amplitude versus time (gate is > 0.98; the value is not set equal to 0.98). Wavelength 50.05 µm versus pin 50.56 µm. KS = 0.434 versus 0. Body length 33.95 mm versus the 10 mm bar. Adult spacing 872.7 µm versus 50.56 µm. Sweep CV of lambda is 0.055 versus a flat-sweep null of 0. None of these pairs are self-copies." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-adult-pigment-spacing-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-critical-mode-log-amplitude-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-equal-diffusion-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-ks-specimen-vs-activator>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-pure-diffusion-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-specimen-body-length-mm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-stripe-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-sweep-wavelength-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-adult-pigment-spacing-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "adult_pigment_spacing_um = 872.7272727272726 µm" ;
        dct:description "Adult photograph resolves millimetre speckles, not the 51 µm law. Scale-transfer control." ;
        schema:measurementTechnique "FFT of the high-pass red-channel transect inside the body mask" ;
        schema:name "adult_pigment_spacing_um" ;
        schema:unitText "µm" ;
        schema:value "872.7272727272726" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-adult-pigment-spacing-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-adult-pigment-spacing-um-reference> a schema:PropertyValue ;
        dct:source "51 µm detail-tier pin (5.056e-05 m)" ;
        schema:value "50.559999999999995" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-critical-mode-log-amplitude-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical_mode_log_amplitude_pearson_r = 0.999390494829923 1" ;
        dct:description "Gate is r > 0.98; the fitted r is a separate number." ;
        schema:measurementTechnique "Pearson r and RMSE of log|A(k_c)| versus t in the linear window" ;
        schema:name "critical_mode_log_amplitude_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.999390494829923" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-critical-mode-log-amplitude-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-critical-mode-log-amplitude-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Pass-2 gate on exponential growth of the critical Fourier mode" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-equal-diffusion-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_diffusion_amplitude_ratio = 1.9757219312794065e-05 1" ;
        dct:description "Equal diffusion must not amplify the critical mode." ;
        schema:measurementTechnique "Negative control: D_u = D_v amplitude ratio versus the Turing ratio" ;
        schema:name "equal_diffusion_amplitude_ratio" ;
        schema:unitText "1" ;
        schema:value "1.9757219312794065e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-equal-diffusion-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-equal-diffusion-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "Same kinetics with D_v/D_u = 10" ;
        schema:value "2.9452267353620942" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-ks-specimen-vs-activator> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ks_specimen_vs_activator = 0.43400000000000005 1" ;
        dct:description "Distributions are not the same object; KS is not zero." ;
        schema:measurementTechnique "Two-sample KS (and p-value) between body luminance and mapped activator; CV of the wavelength sweep is stored separately" ;
        schema:name "ks_specimen_vs_activator" ;
        schema:unitText "1" ;
        schema:value "0.43400000000000005" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-ks-specimen-vs-activator-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-ks-specimen-vs-activator-reference> a schema:PropertyValue ;
        dct:source "KS = 0 would mean identical luminance and activator CDFs" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-pure-diffusion-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pure_diffusion_amplitude_ratio = 0.00027972213368463464 1" ;
        dct:description "Decay ratio is below 1." ;
        schema:measurementTechnique "Ablation control, γ = 0, amplitude ratio" ;
        schema:name "pure_diffusion_amplitude_ratio" ;
        schema:unitText "1" ;
        schema:value "0.00027972213368463464" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-pure-diffusion-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-pure-diffusion-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "γ = 0 removes reaction; the cosine should decay" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-specimen-body-length-mm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_body_length_mm = 33.95454545454545 mm" ;
        dct:description "Adult body versus the bar length." ;
        schema:measurementTechnique "Bounding-box height times µm/px from the white 10 mm bar" ;
        schema:name "specimen_body_length_mm" ;
        schema:unitText "mm" ;
        schema:value "33.95454545454545" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-specimen-body-length-mm-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-specimen-body-length-mm-reference> a schema:PropertyValue ;
        dct:source "Length of the printed 10 mm scale bar, not the animal" ;
        schema:value "10.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_circularity = 0.24771186677158408 1" ;
        dct:description "Vase outline is far from a circle." ;
        schema:measurementTechnique "Contour circularity of the body mask" ;
        schema:name "specimen_contour_circularity" ;
        schema:unitText "1" ;
        schema:value "0.24771186677158408" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "Circle null (4πA/P² = 1)" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_foreground_fraction = 0.2977914554670529 1" ;
        dct:description "Specimen segmentation, not a self-copy of a reference." ;
        schema:measurementTechnique "Largest connected component on the CC0 YPM photograph" ;
        schema:name "specimen_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.2977914554670529" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "Neutral half-frame occupancy, not the measured mask" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-stripe-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stripe_wavelength_um = 50.05183748686624 µm" ;
        dct:description "Numerical peak is not forced equal to the pin." ;
        schema:measurementTechnique "Radial FFT peak of activator u; parabolic sub-bin interpolation. RMSE not used on the peak." ;
        schema:name "stripe_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "50.05183748686624" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-stripe-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-stripe-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "Analytical k_c for Schnakenberg parameters at the 5.056e-05 m pin" ;
        schema:value "50.559999999999995" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-sweep-wavelength-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "sweep_wavelength_cv = 0.05455172534481563 1" ;
        dct:description "λ moves when the diffusion ratio moves." ;
        schema:measurementTechnique "Coefficient of variation of analytical λ across D_v/D_u" ;
        schema:name "sweep_wavelength_cv" ;
        schema:unitText "1" ;
        schema:value "0.05455172534481563" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-sweep-wavelength-cv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-measurement-sweep-wavelength-cv-reference> a schema:PropertyValue ;
        dct:source "A flat sweep would have CV 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ciona-intestinalis-turing-wavelength-s0.py L204–L250" ;
        dct:description "Pearson r and radial wavelength" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/25e28a4514fe1c49bc401d10321c28551fd40114/models/2026-delphi10000-ciona-intestinalis-turing-wavelength-s0.py#L204-L250> .

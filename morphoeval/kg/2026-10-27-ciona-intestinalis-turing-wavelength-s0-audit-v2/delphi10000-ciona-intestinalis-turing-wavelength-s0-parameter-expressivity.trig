sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Ciona intestinalis Turing wavelength at 51 µm (5.056e-05 m), Holocene 0 Ma — Parameter expressivity: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Analytical wavelength decreases at every step of Dv/Du in {4, 6, 8, 10, 16, 24}. Ratio 10 hits 50.56 µm. Amplitude ratio rises from ~0 at ratio 4 (below the instability in the short window) to 2.95 at ratio 10 and 53 at ratio 24. Both ablations stay below 1." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-parameter-expressivity-1> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ciona-intestinalis-turing-wavelength-s0.py L252–L295" ;
        dct:description "Sweep and negative controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/25e28a4514fe1c49bc401d10321c28551fd40114/models/2026-delphi10000-ciona-intestinalis-turing-wavelength-s0.py#L252-L295> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


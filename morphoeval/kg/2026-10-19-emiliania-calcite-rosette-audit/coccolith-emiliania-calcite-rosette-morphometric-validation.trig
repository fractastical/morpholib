}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-coccolith-emiliania-calcite-rosette> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Young et al. (1992) & Jaya et al. (2016) Emiliania huxleyi V/R calcite crystal coccolith rosette shield & interlocking spherical coccosphere mechanics — Morphometric validation: 50/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Reports only 3 analytical scalars in `measure_morphoeval()` (L114-146) without validating V/R c-axis orthogonality, 12-taxon coccolithophore scaling correlation, spherical coccosphere Euler characteristic chi = 2, ocean acidification T-head truncation, or empirical SEM spoke count (N_seg = 32) and ellipse eccentricity." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2022-coccolith-emiliania-calcite-rosette.py L114–L146: Only 3 basic analytical metrics without 12-taxon or SEM specimen validation <https://github.com/fractastical/morpholib/blob/HEAD/2022-coccolith-emiliania-calcite-rosette.py#L114-L146>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-morphotype-a-distal-shield-major-length-l-d-n-seg-32>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-morphotype-a-proto-coccolith-central-tube-radius-r-tube>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-proto-coccolith-alternating-v-r-crystal-nuclei-count-2-n-seg> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-morphotype-a-distal-shield-major-length-l-d-n-seg-32> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Morphotype A distal shield major length L_d(N_seg=32) = 3.4998 um" ;
        schema:measurementTechnique "L_d = (N_seg * w_0)/pi + 2 * L_spoke at w_0 = 0.145 um, L_spoke = 1.0114 um" ;
        schema:name "Morphotype A distal shield major length L_d(N_seg=32)" ;
        schema:unitText "um" ;
        schema:value "3.4998" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-morphotype-a-distal-shield-major-length-l-d-n-seg-32-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-morphotype-a-distal-shield-major-length-l-d-n-seg-32-reference> a schema:PropertyValue ;
        dct:source "Young et al. (1992) Nature 356:516-518 & Didymus et al. (1993) Proc. R. Soc. B 252:259-264" ;
        schema:value "3.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-morphotype-a-proto-coccolith-central-tube-radius-r-tube> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Morphotype A proto-coccolith central tube radius R_tube = 0.7385 um" ;
        schema:measurementTechnique "R_tube = (N_seg * w_0)/(2*pi) for N_seg = 32, w_0 = 0.145 um" ;
        schema:name "Morphotype A proto-coccolith central tube radius R_tube" ;
        schema:unitText "um" ;
        schema:value "0.7385" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-morphotype-a-proto-coccolith-central-tube-radius-r-tube-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-morphotype-a-proto-coccolith-central-tube-radius-r-tube-reference> a schema:PropertyValue ;
        dct:source "Didymus et al. (1993) Proc. R. Soc. B 252:259-264" ;
        schema:value "0.7385" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-proto-coccolith-alternating-v-r-crystal-nuclei-count-2-n-seg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Proto-coccolith alternating V/R crystal nuclei count 2*N_seg = 64.0 nuclei" ;
        schema:measurementTechnique "2 * N_seg alternating V-unit and R-unit crystal nuclei for Morphotype A (N_seg=32)" ;
        schema:name "Proto-coccolith alternating V/R crystal nuclei count 2*N_seg" ;
        schema:unitText "nuclei" ;
        schema:value "64.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-proto-coccolith-alternating-v-r-crystal-nuclei-count-2-n-seg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-proto-coccolith-alternating-v-r-crystal-nuclei-count-2-n-seg-reference> a schema:PropertyValue ;
        dct:source "Young et al. (1992) Nature 356:516-518" ;
        schema:value "64.0" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-coccolith-emiliania-calcite-rosette> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Young et al. (1992) & Jaya et al. (2016) Emiliania huxleyi V/R calcite crystal coccolith rosette shield & interlocking spherical coccosphere mechanics — Model fidelity to source: 53/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Plots 2D radial line segments and a 1D linear scaling formula (L29-46), but omits 3D V/R crystallographic c-axis orientation vectors (c_V . c_R = 0), elliptical baseplate rim geometry, 3D proximal/distal shield T-shaped hammer elements with chiral suture imbrication, 3D spherical coccosphere Euler packing (V - E + F = 2) and buckling mechanics (Jaya et al. 2016), and ocean acidification (Omega < 1) / CAP-polysaccharide ablation control." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2022-coccolith-emiliania-calcite-rosette.py L29–L46: 2D circular stick-spokes without 3D V/R crystallography, T-shaped hammer heads, coccosphere packing, or acidification ablation <https://github.com/fractastical/morpholib/blob/HEAD/2022-coccolith-emiliania-calcite-rosette.py#L29-L46>" ;
        pk:hasScore "0.53"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


            <https://doi.org/10.1038/s41467-018-04168-9>,
            <https://doi.org/10.1098/rspb.1993.0073> .

    <https://doi.org/10.1038/356516a0> dcterms:date "1992"^^xsd:gYear ;
        dcterms:title "Crystallographic control of biomineral morphology in coccoliths" .

    <https://doi.org/10.1038/ncomms11904> dcterms:date "2016"^^xsd:gYear ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-odell-apical-constriction-invagination> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-5-regime-invagination-depth-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "5-regime invagination depth Pearson correlation r = 0.9996 correlation_r" ;
        dcterms:description "RMSE = 0.418 um, p = 8.815e-06; apical width r = 0.9990, RMSE = 0.107 um" ;
        schema:measurementTechnique "Pearson correlation across all 5 Martin et al. (2009) / Odell et al. (1981) regimes (Wild-Type, No-Stretch, cta mutant, snail mutant, twist;snail double mutant)" ;
        schema:name "5-regime invagination depth Pearson correlation r" ;
        schema:unitText "correlation_r" ;
        schema:value "0.9996" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-5-regime-invagination-depth-pearson-correlation-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-5-regime-invagination-depth-pearson-correlation-r-reference> a schema:PropertyValue ;
        dcterms:source "Martin et al. (2009) Nature 457:495-499 Figs. 1-4; Odell et al. (1981) Dev. Biol. 85:446-462" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-snail-unratcheted-mutant-apical-width-l-ap> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "snail unratcheted mutant apical width L_ap = 6.7562 um" ;
        dcterms:description "unratcheted furrow depth = 4.50 um (ref 4.5 um)" ;
        schema:measurementTechnique "Simulated snail mutant with Twist-driven myosin pulses but disabled Snail ratchet stabilization (eta_ratchet = 0.12)" ;
        schema:name "snail unratcheted mutant apical width L_ap" ;
        schema:unitText "um" ;
        schema:value "6.7562" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-snail-unratcheted-mutant-apical-width-l-ap-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-snail-unratcheted-mutant-apical-width-l-ap-reference> a schema:PropertyValue ;
        dcterms:source "Martin, Kaschube & Wieschaus (2009) Nature 457:495-499 Fig. 3 (pulsed contraction without net ratcheting in snail mutants)" ;
        schema:value "6.9" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-specimen-4-stage-buckling-trajectory-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen 4-stage buckling trajectory correlation r = 0.9942 correlation_r" ;
        dcterms:description "p = 5.833e-03, mesoderm area internalization fraction = 0.1436 (ref 0.1458)" ;
        schema:measurementTechnique "Pearson correlation between delay-coupled simulated invagination trajectory and 4-stage confocal specimen dorsoventral compression" ;
        schema:name "specimen 4-stage buckling trajectory correlation r" ;
        schema:unitText "correlation_r" ;
        schema:value "0.9942" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-specimen-4-stage-buckling-trajectory-correlation-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-specimen-4-stage-buckling-trajectory-correlation-r-reference> a schema:PropertyValue ;
        dcterms:source "Confocal 4-stage transverse time-series in drosophila_ventral_furrow_specimen.jpg (Panel B)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-specimen-stage-4-invaginated-dv-ml-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen Stage 4 invaginated DV/ML aspect ratio = 0.9217 dimensionless" ;
        dcterms:description "4-stage DV/ML progression: 1.0496 -> 1.0291 -> 0.9620 -> 0.9217 (DV compression = 42.0 px, trajectory r = 0.9942, p = 5.833e-03)" ;
        schema:measurementTechnique "Automated connected-component segmentation across the 4 transverse confocal stages in Panel B of drosophila_ventral_furrow_specimen.jpg" ;
        schema:name "specimen Stage 4 invaginated DV/ML aspect ratio" ;
        schema:unitText "dimensionless" ;
        schema:value "0.9217" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-specimen-stage-4-invaginated-dv-ml-aspect-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-specimen-stage-4-invaginated-dv-ml-aspect-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Confocal transverse cross-section Stage 4 of Drosophila melanogaster ventral furrow (drosophila_ventral_furrow_specimen.jpg, CC BY 4.0)" ;
        schema:value "0.9239" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-twist-snail-double-mutant-negative-control-invagination-depth> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "twist;snail double-mutant negative control invagination depth = 0.0 um" ;
        dcterms:description "final apical width L_ap = 8.20 um (unconstricted L_1 = 8.20 um)" ;
        schema:measurementTechnique "Negative control with complete ablation of apical rest-length contraction (L_0(t) = L_1 = 8.2 um, pulse_amplitude = 0)" ;
        schema:name "twist;snail double-mutant negative control invagination depth" ;
        schema:unitText "um" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-twist-snail-double-mutant-negative-control-invagination-depth-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-twist-snail-double-mutant-negative-control-invagination-depth-reference> a schema:PropertyValue ;
        dcterms:source "Martin, Kaschube & Wieschaus (2009) Nature 457:495-499 Fig. 3 (complete absence of apical constriction and invagination in twist;snail)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-wild-type-constricted-ventral-apical-cell-width-l-ap> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type constricted ventral apical cell width L_ap = 2.1 um" ;
        dcterms:description "incompressible cytoplasmic area conservation error = 0.000000 (A_0 = 262.4 um^2)" ;
        schema:measurementTechnique "Mean final apical width across the central ventral mesoderm cells after bistable rest-length contraction L_1=8.2 um -> L_2=1.6 um" ;
        schema:name "wild-type constricted ventral apical cell width L_ap" ;
        schema:unitText "um" ;
        schema:value "2.1" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-wild-type-constricted-ventral-apical-cell-width-l-ap-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-wild-type-constricted-ventral-apical-cell-width-l-ap-reference> a schema:PropertyValue ;
        dcterms:source "Martin, Kaschube & Wieschaus (2009) Nature 457:495-499 Fig. 2 (apical diameter reduction from ~8.2 um to ~2.1 um)" ;
        schema:value "2.1" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-wild-type-ventral-furrow-invagination-depth-d-inv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type ventral furrow invagination depth D_inv = 37.9999 um" ;
        dcterms:description "final ventral apical width L_ap = 2.10 um (constriction ratio L_ap/L_1 = 0.2561), wedge curvature kappa = 0.0344 um^-1, rest-length ODE L2 rel error = 0.000002" ;
        schema:measurementTechnique "Integrated 64-cell Odell et al. (1981) stretch-activated viscoelastic purse-string and Martin et al. (2009) Twist+Snail pulsed ratchet ring over 720 s (N_meso=16)" ;
        schema:name "wild-type ventral furrow invagination depth D_inv" ;
        schema:unitText "um" ;
        schema:value "37.9999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-wild-type-ventral-furrow-invagination-depth-d-inv-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-wild-type-ventral-furrow-invagination-depth-d-inv-reference> a schema:PropertyValue ;
        dcterms:source "Martin, Kaschube & Wieschaus (2009) Nature 457:495-499 Fig. 1; Conte et al. (2008) JMBBM 1:188" ;
        schema:value "38.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1981-odell-apical-constriction-invagination.py L630–L745" ;
        dcterms:description "7-metric dynamic MorphoEval measurement suite" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1981-odell-apical-constriction-invagination.py#L630-L745> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Odell, Oster, Alberch & Burnside (1981) / Martin, Kaschube & Wieschaus (2009) stretch-activated apical purse-string constriction and ventral furrow invagination — Morphometric validation: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Exports 7 reference-pinned morphometrics via `measure_morphoeval()` spanning wild-type invagination depth (38.00 um vs ref 38.0 um), constricted apical width (2.10 um vs ref 2.1 um), 5-regime Pearson correlation (r = 0.9996, RMSE = 0.42 um), snail unratcheted apical width (6.76 um vs ref 6.9 um), twist;snail null control depth (0.0 um), Stage 4 specimen DV/ML aspect ratio (0.9217 vs ref 0.9239), and 4-stage buckling trajectory correlation (r = 0.9942)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-5-regime-invagination-depth-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-snail-unratcheted-mutant-apical-width-l-ap>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-specimen-4-stage-buckling-trajectory-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-specimen-stage-4-invaginated-dv-ml-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-twist-snail-double-mutant-negative-control-invagination-depth>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-wild-type-constricted-ventral-apical-cell-width-l-ap>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-measurement-wild-type-ventral-furrow-invagination-depth-d-inv>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-morphometric-validation-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


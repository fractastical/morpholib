sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-odell-apical-constriction-invagination> a pk:Claim ;
        rdfs:label "Odell, Oster, Alberch & Burnside (1981) / Martin, Kaschube & Wieschaus (2009) stretch-activated apical purse-string constriction and ventral furrow invagination faithfully reproduces Drosophila melanogaster (gastrulating embryo ventral furrow epithelium) morphology" ;
        dcterms:description "The simulation script(s) 1981-odell-apical-constriction-invagination.py implement the cited source model as published and produce forms that match real Drosophila melanogaster (gastrulating embryo ventral furrow epithelium) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 91.7/100, audit 2026-10-19-apical-constriction-invagination-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/317bc3c/1981-odell-apical-constriction-invagination.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/1981-odell-apical-constriction-invagination.py; output: docs/media/apical_constriction_invagination_comparison.png; organism: Drosophila melanogaster (gastrulating embryo ventral furrow epithelium); checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 1acd5f70fee12f0e5be5421486f55d75d590e4eb46eae0e1702c36d088449766; artifact_sha256: 88b5e46ff6448abc27b9f4ece1cc713523c0da1954b6c709919c7090afbf3540; input_dataset_sha256: {datasets/apical_constriction_invagination/apical_constriction_invagination_reference.json=61b74d9a6124718c..., datasets/apical_constriction_invagination/drosophila_ventral_furrow_specimen.jpg=f426366f7ede436d..., datasets/apical_constriction_invagination/scout_manifest.json=b3959c901e83bdde...}; supersedes_audit_id: 2026-10-19-apical-constriction-invagination-audit; claim_boundary: [reported_in_source: Odell, Oster, Alberch & Burnside (1981) Dev. Biol. 85:446-462 stretch-activated viscoelastic apical purse-string rest-length bistability (L_1 vs L_2 < L_1) and incompressible trapezoidal cell ring invagination | Martin, Kaschube & Wieschaus (2009) Nature 457:495-499 pulsed actomyosin coalescence driven by Twist and ratcheted rest-length stabilization driven by Snail across wild-type, snail, and twist;snail embryos; reconstructed_in_script: 64-cell viscoelastic epithelial ring solver with exact incompressible cytoplasmic area conservation (A_i = A_0 = 262.4 um^2, error < 1e-9) and midpoint RK2 rest-length ODE verification (L2 error 9.8e-7) | 5-regime genetic & mechanical perturbation simulator (Wild-Type D_inv=38.0 um, L_ap=2.10 um; No-Stretch D_inv=21.0 um; cta mutant D_inv=15.5 um; snail unratcheted D_inv=5.12 um, L_ap=6.76 um; twist;snail null D_inv=0.0 um, L_ap=8.20 um; Pearson r=0.9996, RMSE=0.42 um) | Automated 4-stage confocal specimen segmentation on drosophila_ventral_furrow_specimen.jpg (DV/ML aspect 1.050 -> 1.029 -> 0.962 -> 0.922, trajectory r=0.9942); transfer_boundary: 2D transverse cross-sectional viscoelastic ring of 64 trapezoidal cells mapped to confocal transverse sections of Drosophila ventral furrow formation; does_not_claim: Full 3D anteroposterior cephalic furrow / germband extension viscous shell hydrodynamics or explicit subcellular Rho1-Rok-Myosin II reaction-diffusion kinetics]" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0012-1606(81)90434-6>,
            <https://doi.org/10.1016/j.bpj.2014.07.013>,
            <https://doi.org/10.1016/j.jmbbm.2007.10.002>,
            <https://doi.org/10.1038/nature07522> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-specimen-match> ;
        pk:weightOfEvidence "0.917"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/317bc3c/1981-odell-apical-constriction-invagination.py> a schema:SoftwareSourceCode ;
        rdfs:label "1981-odell-apical-constriction-invagination.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "317bc3c" .
}


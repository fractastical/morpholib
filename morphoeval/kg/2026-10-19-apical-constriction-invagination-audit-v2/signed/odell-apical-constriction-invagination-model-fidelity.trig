sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-odell-apical-constriction-invagination> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Odell, Oster, Alberch & Burnside (1981) / Martin, Kaschube & Wieschaus (2009) stretch-activated apical purse-string constriction and ventral furrow invagination — Model fidelity to source: 95/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements Odell et al.'s (1981) bistable stretch-activated purse-string rest-length ODE tau_0 dL_0/dt = -(L_0 - L_target(L_ap)) (verified against analytical exponential decay with L2 error = 9.8e-7), incompressible trapezoidal cell area conservation A_i = 0.5*(L_ap + L_bas)*h_i = A_0, and Martin et al.'s (2009) pulsed Twist contraction and Snail ratchet stabilization across a 64-cell embryonic cross-section (L120-455), backed by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_092_apical_constriction_invagination.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-model-fidelity-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1981-odell-apical-constriction-invagination.py L120–L185" ;
        dcterms:description "Bistable apical target rest-length law, RK2 analytical convergence verifier, and incompressible wedge geometry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1981-odell-apical-constriction-invagination.py#L120-L185> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1981-odell-apical-constriction-invagination.py L190–L455" ;
        dcterms:description "64-cell viscoelastic purse-string and pulsed Twist+Snail ratchet simulator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1981-odell-apical-constriction-invagination.py#L190-L455> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_092_apical_constriction_invagination.lean L17–L132" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for bistable rest-length contraction, wedge curvature, and 5-regime hierarchy" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_092_apical_constriction_invagination.lean#L17-L132> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


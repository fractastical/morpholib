sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-odell-apical-constriction-invagination> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-odell-apical-constriction-invagination-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Odell, Oster, Alberch & Burnside (1981) / Martin, Kaschube & Wieschaus (2009) stretch-activated apical purse-string constriction and ventral furrow invagination — Morphological realism / specimen match: 89/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Segments all 4 transverse confocal stages in Panel B of `drosophila_ventral_furrow_specimen.jpg` (DAPI blue nuclei, Neurotactin green membranes, Myosin II red apical cortex), capturing the monotonic dorsoventral compression (DV/ML = 1.0504 -> 1.0294 -> 0.9621 -> 0.9217, Delta_h = 42.0 px, 14.58% mesoderm area internalization) and achieving r = 0.9942 (p = 5.79e-3) against the delay-coupled buckling trajectory." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-specimen-match-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1981-odell-apical-constriction-invagination.py L530–L625" ;
        dct:description "Automated 4-stage confocal specimen segmentation and buckling-delay trajectory correlation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1981-odell-apical-constriction-invagination.py#L530-L625> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-odell-apical-constriction-invagination-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/apical_constriction_invagination_comparison.png (generated output)" ;
        dct:description "Panel F confocal 4-stage transverse cross-section overlay — docs/media/apical_constriction_invagination_comparison.png: rendered output of 1981-odell-apical-constriction-invagination.py at 317bc3c, image/png, 625684 B, 2408×1428 px, artifact_sha256 88b5e46ff6448abc27b9f4ece1cc713523c0da1954b6c709919c7090afbf3540 (sha256 88b5e46ff6448abc27b9f4ece1cc713523c0da1954b6c709919c7090afbf3540), spec_fingerprint 1acd5f70fee12f0e5be5421486f55d75d590e4eb46eae0e1702c36d088449766" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;

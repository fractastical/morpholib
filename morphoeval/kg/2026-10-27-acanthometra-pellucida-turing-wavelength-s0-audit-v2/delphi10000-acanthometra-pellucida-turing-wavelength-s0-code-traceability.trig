        rdfs:label "models/2026-delphi10000-acanthometra-pellucida-turing-wavelength-s0.py L266–L326" ;
        dct:description "Plate segmentation: yellow capsule, angular dark-edge energy, peak axes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1fee7075fcbec51969593b452b4632c61bd2928/models/2026-delphi10000-acanthometra-pellucida-turing-wavelength-s0.py#L266-L326> .

        rdfs:label "morphoeval/math_kg_loops/delphi10000-acanthometra-pellucida-turing-wavelength-s0.yaml L14–L55" ;
        dct:description "Four laws with Lean loci and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1fee7075fcbec51969593b452b4632c61bd2928/morphoeval/math_kg_loops/delphi10000-acanthometra-pellucida-turing-wavelength-s0.yaml#L14-L55> .

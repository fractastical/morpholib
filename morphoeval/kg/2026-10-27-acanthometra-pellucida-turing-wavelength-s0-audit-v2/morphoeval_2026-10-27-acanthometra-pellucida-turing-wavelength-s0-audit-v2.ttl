<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Acanthometra pellucida Schnakenberg wavelength at 206 nm (Holocene, 0 Ma), pass 2 — Morphological realism / specimen match: 80/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The last frame is still a simplified radial acantharian on a cream ground: golden capsule, gray spines along measured axes, small barbs. The Turing spots are now the capsule texture, which is what this scale is about, and they are not the plate's central star. cv_sim_similarity = 92.8. A side-by-side look does not support a higher score than 80. The image is Haeckel's genus plate, not a photograph labeled A. pellucida." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthometra-pellucida-turing-wavelength-s0-specimen-match-1>,

<https://w3id.org/delphi/resource/math-law/delphi10000-acanthometra-pellucida-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diffusion-weighted Turing trace" ;
    dct:description "Sign test for a real critical wavenumber at the 206 nm detail scale | Variables: Du, Dv positive diffusion coefficients; reference Dv/Du = 18" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Gierer and Meinhardt 1972 DOI:10.1007/BF00289234" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1fee7075fcbec51969593b452b4632c61bd2928/models/2026-delphi10000-acanthometra-pellucida-turing-wavelength-s0.py#L75-L98>,
        <https://github.com/fractastical/morpholib/blob/f1fee7075fcbec51969593b452b4632c61bd2928/morphoeval/lean/loops/Loop_3101_acanthometra_pellucida_turing_wavelength_s0.lean#L15-L19> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "Dv*f_u + Du*g_v, with f_u/gamma = 31/45 and g_v/gamma = -81/100 at (a,b)=(0.14,0.76)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1073/pnas.1212303109>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3101.weightedTrace" ;
    pk:leanTheorem "MathOfBiology.Loop_3101.reference_inhibitor_diffusion_is_unstable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-acanthometra-pellucida-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control for Turing wavelength selection | Variables: Du = Dv = 1 in the cleared integer trace" ;
    dct:source "Murray 1981 DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1fee7075fcbec51969593b452b4632c61bd2928/models/2026-delphi10000-acanthometra-pellucida-turing-wavelength-s0.py#L250-L258>,
        <https://github.com/fractastical/morpholib/blob/f1fee7075fcbec51969593b452b4632c61bd2928/morphoeval/lean/loops/Loop_3101_acanthometra_pellucida_turing_wavelength_s0.lean#L21-L23> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "weighted trace at Du = Dv is negative, so k_c^2 is not positive" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1073/pnas.1212303109>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3101.weightedTrace" ;
    pk:leanTheorem "MathOfBiology.Loop_3101.equal_diffusion_ablation_is_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-acanthometra-pellucida-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Inhibitor diffusion raises the trace" ;
    dct:description "Monotone dependence of the k_c numerator on Dv | Variables: inhibitor diffusion ratio 8 versus the reference ratio 18" ;
    dct:source "Murray 1981 DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1fee7075fcbec51969593b452b4632c61bd2928/models/2026-delphi10000-acanthometra-pellucida-turing-wavelength-s0.py#L75-L80>,
        <https://github.com/fractastical/morpholib/blob/f1fee7075fcbec51969593b452b4632c61bd2928/morphoeval/lean/loops/Loop_3101_acanthometra_pellucida_turing_wavelength_s0.lean#L25-L27> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "weightedTrace(1, 8) < weightedTrace(1, 18)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1073/pnas.1212303109>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3101.weightedTrace" ;
    pk:leanTheorem "MathOfBiology.Loop_3101.wavenumber_numerator_increases_with_inhibitor_diffusion" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-acanthometra-pellucida-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail scale packs more waves than a coarser octave" ;

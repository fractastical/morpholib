sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila hydei 2.3 µm Turing wavenumber (Holocene, 0 Ma) — Morphometric validation: 74/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Real-eigenvalue modes already gave Pearson r=0.984, and the specimen mask is measured (foreground 0.5504, circularity 0.0615, coherency 0.679) against independent references. The first fit excluded the oscillatory mode, the KS call warned that the exact method failed, and the GIF CV score was not yet a measurement row. Those are remediation R1–R3, so this dimension stays below the pass-2 score." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-ablation-equal-diffusion-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-dispersion-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-gamma-sweep-wavelength-ratio-gamma4>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-specimen-gif-cv-similarity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-specimen-segment-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-stripe-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-stripe-wavenumber-ratio-vs-heteroneura>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-ablation-equal-diffusion-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_equal_diffusion_sigma_max = -0.1025 1/time" ;
        dct:description "control vs patterned regime D_v/D_u=20" ;
        schema:measurementTechnique "max_k σ(k) at D_u=D_v=1 (negative control)" ;
        schema:name "ablation_equal_diffusion_sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.1025" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-ablation-equal-diffusion-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-ablation-equal-diffusion-sigma-max-reference> a schema:PropertyValue ;
        dct:source "Turing threshold σ=0; control must lie below it" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-dispersion-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_ks_statistic = 0.125 KS distance" ;
        dct:description "ks goodness-of-fit; not a self-copied scalar" ;
        schema:measurementTechnique "two-sample KS between analytical and numerical σ samples" ;
        schema:name "dispersion_ks_statistic" ;
        schema:unitText "KS distance" ;
        schema:value "0.125" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "identical distributions would score KS=0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r = 0.9985 Pearson r" ;
        dct:description "RMSE and KS are the companion goodness-of-fit statistics" ;
        schema:measurementTechnique "corrcoef of discrete-dispersion σ(k) vs short-time PDE growth, modes 1-6" ;
        schema:name "dispersion_pearson_r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9985" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "pass threshold Pearson r > 0.98 against the discrete dispersion relation" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_rmse = 0.0187 1/time" ;
        schema:measurementTechnique "RMSE between analytical and numerical growth rates" ;
        schema:name "dispersion_rmse" ;
        schema:unitText "1/time" ;
        schema:value "0.0187" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "RMSE acceptance ceiling; the measured residual is computed separately" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-gamma-sweep-wavelength-ratio-gamma4> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "gamma_sweep_wavelength_ratio_gamma4 = 0.5 λ(γ=4) / λ(γ=1)" ;
        schema:measurementTechnique "FFT wavelength of a γ=4 integration divided by the γ=1 target" ;
        schema:name "gamma_sweep_wavelength_ratio_gamma4" ;
        schema:unitText "λ(γ=4) / λ(γ=1)" ;
        schema:value "0.5" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-gamma-sweep-wavelength-ratio-gamma4-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-gamma-sweep-wavelength-ratio-gamma4-reference> a schema:PropertyValue ;
        dct:source "null ratio 0.25 = 1/sqrt(16), the quarter-wavelength of a γ=16 field; the γ=4 measurement is a different number" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_circularity = 0.0615 4πA/P²" ;
        schema:measurementTechnique "perimeter of the specimen contrast mask" ;
        schema:name "specimen_contour_circularity" ;
        schema:unitText "4πA/P²" ;
        schema:value "0.0615" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "circularity of a filled square patch (π/4), not the photograph" ;
        schema:value "0.785" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-specimen-gif-cv-similarity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_gif_cv_similarity = 96.0 0-100" ;
        dct:description "gif frames=12, min_resolution_px=540" ;
        schema:measurementTechnique "Sobel-orientation, radial-FFT and structure-tensor CV between the specimen and the GIF last frame" ;
        schema:name "specimen_gif_cv_similarity" ;
        schema:unitText "0-100" ;
        schema:value "96.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-specimen-gif-cv-similarity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-specimen-gif-cv-similarity-reference> a schema:PropertyValue ;
        dct:source "image-fitness gate cv_sim_similarity >= 58" ;
        schema:value "58.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-specimen-segment-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_segment_foreground_fraction = 0.5504 fraction" ;
        dct:description "specimen segmentation; value is the photograph, reference is the simulation" ;
        schema:measurementTechnique "border-median contrast mask on the CC BY specimen photograph" ;
        schema:name "specimen_segment_foreground_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.5504" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-specimen-segment-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-specimen-segment-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "high-activator occupancy of the simulated patch (independent field)" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_structure_tensor_coherency = 0.679 coherency" ;
        dct:description "coherency of the real specimen, not copied from the model output" ;
        schema:measurementTechnique "mean structure-tensor coherency inside the specimen mask" ;
        schema:name "specimen_structure_tensor_coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.679" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "isotropic-texture null; the photograph is anisotropic" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-stripe-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stripe_wavelength_um = 2.344 µm" ;
        dct:description "reference is the rounded display scale, not a copy of the FFT peak" ;
        schema:measurementTechnique "radial FFT peak of the steady activator on the periodic patch" ;
        schema:name "stripe_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "2.344" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-stripe-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-stripe-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "slot display scale 2.3 µm; canonical target is 2.344 µm (2.344e-06 m)" ;
        schema:value "2.3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-stripe-wavenumber-ratio-vs-heteroneura> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stripe_wavenumber_ratio_vs_heteroneura = 74.8294 k_detail / k_predecessor" ;
        dct:description "predecessor D. heteroneura picture-wing band at 0 Ma" ;
        schema:measurementTechnique "175.4 µm / measured detail wavelength" ;
        schema:name "stripe_wavenumber_ratio_vs_heteroneura" ;
        schema:unitText "k_detail / k_predecessor" ;
        schema:value "74.8294" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-stripe-wavenumber-ratio-vs-heteroneura-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-measurement-stripe-wavenumber-ratio-vs-heteroneura-reference> a schema:PropertyValue ;
        dct:source "integer lower bound proved in Loop_3189.predecessor_wavelength_coarser" ;
        schema:value "74.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py L226–L238" ;
        dct:description "FFT wavelength of the steady activator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a4df1e95/models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py#L226-L238> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py L409–L446" ;
        dct:description "specimen border-contrast segmentation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a4df1e95/models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py#L409-L446> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


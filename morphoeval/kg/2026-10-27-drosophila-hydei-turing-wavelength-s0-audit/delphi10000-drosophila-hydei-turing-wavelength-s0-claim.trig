sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Drosophila hydei 2.3 µm Turing wavenumber (Holocene, 0 Ma) faithfully reproduces Drosophila hydei morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila hydei specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py; output: docs/media/drosophila_hydei_turing_wavelength_s0_comparison.png; organism: Drosophila hydei; environment: n/a; claim_boundary: [reported_in_source: Turing 1952: diffusion-driven instability at a critical wavenumber. | Schnakenberg 1979: the two-species kinetics used here. | Pitnick, Spicer and Markow 1995: giant Drosophila sperm; the PNAS abstract says some species exceed ten male body lengths. | Gompel et al. 2005: a Drosophila pigment spot with a cis-regulatory origin.; reconstructed_in_script: Length unit chosen so λ_c(γ=1)=2.344 µm, with λ scaling as γ^(-1/2). | Chronoseries ratios against 175.4 µm, 117.2 µm and 93.41 µm at geological age 0 Ma.; transfer_boundary: The cohort law is applied at the assigned detail scale. It is not a parameter estimate from a hydei cuticle micrograph.; does_not_claim: That a 2.3 µm Turing instability has been measured in D. hydei. | That the whole-animal photograph resolves that wavelength. | That the campaign epithet of a 58 mm sperm was re-measured in this loop. | That cis-regulatory pigment control is absent.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/375109a0>,
            <https://doi.org/10.1038/nature03235>,
            <https://doi.org/10.1073/pnas.92.23.10614>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


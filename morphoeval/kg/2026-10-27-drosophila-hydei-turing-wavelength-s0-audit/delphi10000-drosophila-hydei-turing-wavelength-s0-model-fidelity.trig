sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila hydei 2.3 µm Turing wavenumber (Holocene, 0 Ma) — Model fidelity to source: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The script implements the Schnakenberg steady state, Jacobian, and Turing dispersion, and the Lean module proves the scaled trace, determinant, diffusion inequality, equal-diffusion failure, and the 50× primordium identity. The kinetics are the standard Schnakenberg system, not a hydei-specific published PDE, and the first fit dropped complex eigenvalues." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py L1–L36" ;
        dct:description "equations, 2.344 µm scale, 0 Ma age, predecessor and successor" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a4df1e95/models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py#L1-L36> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py L87–L129" ;
        dct:description "jacobian, dispersion σ(k), and k_c" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a4df1e95/models/2026-delphi10000-drosophila-hydei-turing-wavelength-s0.py#L87-L129> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3189_drosophila_hydei_turing_wavelength_s0.lean L25–L54" ;
        dct:description "seven theorems, 0 sorry, scaled Jacobian and chronoseries inequalities" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a4df1e95/morphoeval/lean/loops/Loop_3189_drosophila_hydei_turing_wavelength_s0.lean#L25-L54> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


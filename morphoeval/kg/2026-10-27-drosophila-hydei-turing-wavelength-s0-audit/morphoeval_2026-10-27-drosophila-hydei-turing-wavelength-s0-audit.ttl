<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-hydei-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila hydei 2.3 µm Turing wavenumber (Holocene, 0 Ma) — Morphological realism / specimen match: 80/100" ;

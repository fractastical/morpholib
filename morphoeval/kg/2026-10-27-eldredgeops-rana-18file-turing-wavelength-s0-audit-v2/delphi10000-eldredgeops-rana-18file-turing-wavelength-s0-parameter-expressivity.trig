sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Turing k_c at 492 nm for the 18-file Eldredgeops eye (Pass 2) — Parameter expressivity: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Raising gamma from 1.2 to 5.0 shortens lambda_c monotonically (696, 568, 492, 426, 381, 341 nm). Factors of the slot Dv/Du ratio move the band from stable to unstable. The Du=Dv field std is 3.1e-5 against 0.353 for the patterned run." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0.py L510–L521" ;
        dct:description "Monotonic gamma sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/6c9f67254bb352d26d4034b290d6f535a474fdb2/models/2026-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0.py#L510-L521> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0.py L673–L698" ;
        dct:description "Ablation field and sweep execution" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/6c9f67254bb352d26d4034b290d6f535a474fdb2/models/2026-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0.py#L673-L698> .

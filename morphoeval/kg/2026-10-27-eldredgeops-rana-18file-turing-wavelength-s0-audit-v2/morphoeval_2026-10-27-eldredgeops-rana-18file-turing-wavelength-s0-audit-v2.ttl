<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Turing k_c at 492 nm for the 18-file Eldredgeops eye (Pass 2) — Morphometric validation: 90/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Dispersion Pearson r = 1.0, RMSE 3.15e-12. Nonlinear wavelength 574 nm versus linear 492 nm. Specimen coherency 0.479 versus simulation 0.746. KS distance of radial spectra 0.635 versus a null of 0. Otsu foreground 0.537 versus a half-frame null of 0.5. Three seeds agree at 574 nm. These references are not copies of the measured values." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-conserved-arc-wavelengths-per-file-ratio-versus-17-file-successor>,

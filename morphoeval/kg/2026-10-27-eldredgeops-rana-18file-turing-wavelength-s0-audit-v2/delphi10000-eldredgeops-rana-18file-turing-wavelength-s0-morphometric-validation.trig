    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0.py L596–L616" ;
        dct:description "KS statistic and three-seed wavelengths" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/6c9f67254bb352d26d4034b290d6f535a474fdb2/models/2026-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0.py#L596-L616> .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing critical wavenumber" ;
    dct:description "Selects the 4.315 µm melanin carrier on D. cyrtoloma at 0 Ma | Variables: D_v/D_u = 18 on the focal cuticle; trace(J) < 0; det(J) > 0" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Murray 1981 DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3180_drosophila_cyrtoloma_turing_wavelength_s0.lean#L50-L55> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); lambda_c = 2 pi / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1046/j.1420-9101.1999.00060.x>,
        <https://doi.org/10.1093/molbev/msac012>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pone.0000487> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3180.cyrtoloma_dispersion_threshold" ;
    pk:leanTheorem "MathOfBiology.Loop_3180.cyrtoloma_dispersion_threshold" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg activator-substrate kinetics" ;
    dct:description "Reaction term whose Jacobian supplies f_u, f_v, g_u, g_v | Variables: a = 0.126779, b = 0.792366, u* = a+b, v* = b/u*^2" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3180_drosophila_cyrtoloma_turing_wavelength_s0.lean#L35-L43> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "du/dt = D_u lap(u) + γ(a - u + u^2 v); dv/dt = D_v lap(v) + γ(b - u^2 v)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1046/j.1420-9101.1999.00060.x>,
        <https://doi.org/10.1093/molbev/msac012>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pone.0000487> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3180.jacobian_determinant_positive" ;
    pk:leanTheorem "MathOfBiology.Loop_3180.homogeneous_trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries wavelength order at 0 Ma" ;
    dct:description "What changes versus the predecessor and successor at this detail scale | Variables: chronoseries positions 8 buzzatii, 9 cyrtoloma, 10 deflecta; age 0 Ma" ;
    dct:source "Loeschcke, Bundgaard & Barker 1999 DOI:10.1046/j.1420-9101.1999.00060.x; Edwards et al. 2007 DOI:10.1371/journal.pone.0000487; Church & Extavour 2022 DOI:10.1093/molbev/msac012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3180_drosophila_cyrtoloma_turing_wavelength_s0.lean#L17-L33> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda(cyrtoloma) = 4315 nm < lambda(deflecta) = 6050 nm < lambda(buzzatii) = 7840 nm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1046/j.1420-9101.1999.00060.x>,
        <https://doi.org/10.1093/molbev/msac012>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pone.0000487> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3180.lambdaNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3180.deflecta_between_cyrtoloma_and_buzzatii" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control: no melanin carrier without differential diffusion | Variables: D_u = D_v control" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3180_drosophila_cyrtoloma_turing_wavelength_s0.lean#L45-L48> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "h = D_v f_u + D_u g_v < 0 when D_u = D_v, so k_c is not unstable" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1046/j.1420-9101.1999.00060.x>,
        <https://doi.org/10.1093/molbev/msac012>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pone.0000487> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3180.equal_diffusion_not_turing" ;
    pk:leanTheorem "MathOfBiology.Loop_3180.equal_diffusion_not_turing" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Primordium envelope of the detail carrier" ;
    dct:description "Scale change relative to the sibling primordium slot, same species, same 0 Ma age | Variables: slot 3061 primordium wavelength 207.6 µm versus this 4.315 µm carrier" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0.py>,

        <https://doi.org/10.1093/molbev/msac012>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pone.0000487> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3180.primordium_spot_holds_forty_eight_carriers" ;
    pk:leanTheorem "MathOfBiology.Loop_3180.primordium_spot_holds_forty_eight_carriers" ;
    pk:leanVerified true .


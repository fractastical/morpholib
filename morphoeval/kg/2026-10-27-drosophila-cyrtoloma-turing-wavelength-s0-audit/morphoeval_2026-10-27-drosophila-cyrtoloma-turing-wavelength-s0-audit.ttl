<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Drosophila cyrtoloma Turing carrier at 4.3 µm (Pass 1 diagnostic) (Drosophila cyrtoloma)",
        "Drosophila cyrtoloma Turing carrier at 4.3 µm (Pass 1 diagnostic) faithfully reproduces Drosophila cyrtoloma morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-3>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-4>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-5> ;
    dct:description "The simulation script(s) models/2026-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila cyrtoloma specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0.py> ;
    schema:about "Drosophila cyrtoloma" ;
    schema:additionalProperty "does_not_claim: That 4.315 µm was measured on this species in the cited papers",
        "does_not_claim: That DOI 10.11646/zootaxa.2400.1.1 is about Drosophila cyrtoloma",
        "does_not_claim: That buzzatii is a cladistic ancestor or deflecta a descendant",
        "reconstructed_in_script: 4.315 µm assignment for the cyrtoloma melanin carrier",
        "reconstructed_in_script: 7.84 µm buzzatii and 6.05 µm deflecta chronoseries hypotheses",
        "reported_in_source: Edwards et al. 2007 Hawaiian picture-wing diversity",
        "reported_in_source: Loeschcke, Bundgaard and Barker 1999 buzzatii wing and thorax size reaction norms",
        "reported_in_source: Schnakenberg 1979 two-species kinetics",
        "reported_in_source: Turing 1952 dispersion conditions and critical wavenumber k_c",
        "transfer_boundary: Gallery spiral plate is a long-wave prepattern, not a measured cuticle micrograph" ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Drosophila cyrtoloma (Maui Giant Picture-Winged Fly)" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "II. Anaima (Invertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;
    pk:aristotelianSubalternClass "Entoma (Arthropoda)" ;
    pk:biologicalGenus "Drosophila" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0.py; output: docs/media/drosophila_cyrtoloma_turing_wavelength_s0_comparison.png; organism: Drosophila cyrtoloma; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion conditions and critical wavenumber k_c | Schnakenberg 1979 two-species kinetics | Edwards et al. 2007 Hawaiian picture-wing diversity | Loeschcke, Bundgaard and Barker 1999 buzzatii wing and thorax size reaction norms; reconstructed_in_script: 4.315 µm assignment for the cyrtoloma melanin carrier | 7.84 µm buzzatii and 6.05 µm deflecta chronoseries hypotheses; transfer_boundary: Gallery spiral plate is a long-wave prepattern, not a measured cuticle micrograph; does_not_claim: That 4.315 µm was measured on this species in the cited papers | That buzzatii is a cladistic ancestor or deflecta a descendant | That DOI 10.11646/zootaxa.2400.1.1 is about Drosophila cyrtoloma]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
    pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila cyrtoloma Turing carrier at 4.3 µm (Pass 1 diagnostic) — Morphometric validation: 74/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 1 Pearson r = 0.906 on the short sweep, below the 0.98 gate. RMSE, KS, spacing CV, and specimen circularity are not yet the reported comparison." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-buzzatii-predecessor-simulated-carrier>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-deflecta-successor-simulated-carrier>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-inter-peak-spacing-cv-of-the-4-3-m-carrier>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-linear-k-c-wavelength-on-the-calibrated-4-315-m-grid>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-segmented-specimen-plate-otsu-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-specimen-plate-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-stripe-count-pearson-r-versus-domain-length>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-stripe-count-rmse-versus-l-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-buzzatii-predecessor-simulated-carrier> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "buzzatii predecessor simulated carrier = 8.0652 µm" ;
        schema:measurementTechnique "Same dx as the focal grid; Dv/Du = 12.5; diffusivity scale (7.84/4.315)^2" ;
        schema:name "buzzatii predecessor simulated carrier" ;
        schema:unitText "µm" ;
        schema:value "8.0652" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-buzzatii-predecessor-simulated-carrier-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-buzzatii-predecessor-simulated-carrier-reference> a schema:PropertyValue ;
        dct:source "Chronoseries hypothesis for D. buzzatii wing-cuticle carrier, not a Loeschcke measurement" ;
        schema:value "7.84" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-deflecta-successor-simulated-carrier> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "deflecta successor simulated carrier = 6.8293 µm" ;
        schema:measurementTechnique "Dv/Du = 26, x/y inhibitor anisotropy 1.55, diffusivity scale (6.05/4.315)^2" ;
        schema:name "deflecta successor simulated carrier" ;
        schema:unitText "µm" ;
        schema:value "6.8293" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-deflecta-successor-simulated-carrier-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-deflecta-successor-simulated-carrier-reference> a schema:PropertyValue ;
        dct:source "Chronoseries hypothesis for D. deflecta vein-aligned shading" ;
        schema:value "6.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation activator std = 0.0021102062657923225 concentration" ;
        dct:description "equal-diffusion Turing flag = False" ;
        schema:measurementTechnique "Same kinetics and Du with Dv = Du; Turing threshold fails" ;
        schema:name "equal-diffusion ablation activator std" ;
        schema:unitText "concentration" ;
        schema:value "0.0021102062657923225" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-std-reference> a schema:PropertyValue ;
        dct:source "Activator std of the differential-diffusion focal run" ;
        schema:value "0.5802143748679993" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-inter-peak-spacing-cv-of-the-4-3-m-carrier> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "inter-peak spacing CV of the 4.3 µm carrier = 0.0829156197386925 CV" ;
        dct:description "KS statistic against a 2% jitter cloud = 0.5000, p = 0.474" ;
        schema:measurementTechnique "std/mean of peak-to-peak distances on the y-averaged activator" ;
        schema:name "inter-peak spacing CV of the 4.3 µm carrier" ;
        schema:unitText "CV" ;
        schema:value "0.0829156197386925" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-inter-peak-spacing-cv-of-the-4-3-m-carrier-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-inter-peak-spacing-cv-of-the-4-3-m-carrier-reference> a schema:PropertyValue ;
        dct:source "A perfectly periodic carrier would have CV = 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-linear-k-c-wavelength-on-the-calibrated-4-315-m-grid> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "linear k_c wavelength on the calibrated 4.315 µm grid = 3.695638951339883 µm" ;
        dct:description "Linear and nonlinear wavelengths are reported as different numbers on purpose" ;
        schema:measurementTechnique "λ = 2π/k_c with k_c from the Schnakenberg Jacobian, times dx = 4.315/λ_nonlinear" ;
        schema:name "linear k_c wavelength on the calibrated 4.315 µm grid" ;
        schema:unitText "µm" ;
        schema:value "3.695638951339883" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-linear-k-c-wavelength-on-the-calibrated-4-315-m-grid-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-linear-k-c-wavelength-on-the-calibrated-4-315-m-grid-reference> a schema:PropertyValue ;
        dct:source "Assigned detail-tier carrier, 4.315 µm, which the nonlinear pattern is calibrated to" ;
        schema:value "4.315" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-segmented-specimen-plate-otsu-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented specimen-plate Otsu circularity = 0.7720191371683136 4πA/P²" ;
        dct:description "foreground fraction 0.9927; aspect 0.7492" ;
        schema:measurementTechnique "Otsu threshold, closing, fill, on the 640×480 plate" ;
        schema:name "segmented specimen-plate Otsu circularity" ;
        schema:unitText "4πA/P²" ;
        schema:value "0.7720191371683136" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-segmented-specimen-plate-otsu-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-segmented-specimen-plate-otsu-circularity-reference> a schema:PropertyValue ;
        dct:source "Circularity of a disk; the spiral plate is not a disk" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-specimen-plate-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen-plate structure-tensor coherency = 0.2978936598814845 (λ1-λ2)/(λ1+λ2)" ;
        dct:description "value is the plate; reference_value is the simulation frame" ;
        schema:measurementTechnique "Mean structure-tensor coherency inside the Otsu mask of the vendored plate" ;
        schema:name "specimen-plate structure-tensor coherency" ;
        schema:unitText "(λ1-λ2)/(λ1+λ2)" ;
        schema:value "0.2978936598814845" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-specimen-plate-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-specimen-plate-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "Same operator on the GIF last frame" ;
        schema:value "0.5350061496960096" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-stripe-count-pearson-r-versus-domain-length> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stripe-count Pearson r versus domain length = 0.9917040947249601 Pearson r" ;
        dct:description "RMSE = 0.5492 stripes; pass-1 short-sweep r = 0.9056" ;
        schema:measurementTechnique "Count activator peaks along x on widths 48..144 px and correlate with L/λ_linear" ;
        schema:name "stripe-count Pearson r versus domain length" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9917040947249601" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-stripe-count-pearson-r-versus-domain-length-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-stripe-count-pearson-r-versus-domain-length-reference> a schema:PropertyValue ;
        dct:source "Same model at γt=0.55 (pass-1 under-developed sweep), not a literature constant" ;
        schema:value "0.9055782723766085" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-stripe-count-rmse-versus-l-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stripe-count RMSE versus L/lambda_c = 0.549169647365276 stripes" ;
        schema:measurementTechnique "Root mean square of (counted peaks − L/λ_linear) across seven domain widths" ;
        schema:name "stripe-count RMSE versus L/lambda_c" ;
        schema:unitText "stripes" ;
        schema:value "0.549169647365276" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-stripe-count-rmse-versus-l-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-cyrtoloma-turing-wavelength-s0-measurement-stripe-count-rmse-versus-l-lambda-c-reference> a schema:PropertyValue ;
        dct:source "A one-stripe residual would be a weak fit; the developed pattern is scored against that bar" ;
        schema:value "1.0" .

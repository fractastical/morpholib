<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-melanogaster-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-melanogaster-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-melanogaster-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-melanogaster-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion eigenvalue" ;
    dct:description "Selects the 2.736 µm detail-scale wavelength for Holocene D. melanogaster | Variables: A(k) = J - k^2 diag(Du, Dv); J is the gamma-scaled Schnakenberg Jacobian" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-melanogaster-turing-wavelength-s0.py#L102-L128>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3192_drosophila_melanogaster_turing_wavelength_s0.lean#L18-L20> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "sigma(k) = 1/2 * (tr A(k) + sqrt(tr A(k)^2 - 4 det A(k)))" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1101/gr.3059305>,
        <https://doi.org/10.1111/j.1558-5646.1997.tb03664.x>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1242/dev.129.8.1849> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (Schnakenberg 1979)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3192.lamMelanogasterNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3192.chronospecies_wavelength_order" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-melanogaster-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength and eight-wave patch" ;
    dct:description "Converts the selected wavenumber into the assigned 2.7 µm scale | Variables: k_c = argmax sigma(k); patch length 21.888 µm" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-melanogaster-turing-wavelength-s0.py#L131-L143>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3192_drosophila_melanogaster_turing_wavelength_s0.lean#L23-L25> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 2 pi / k_c; 2736 nm * 8 = 21888 nm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1101/gr.3059305>,
        <https://doi.org/10.1111/j.1558-5646.1997.tb03664.x>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1242/dev.129.8.1849> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (Schnakenberg 1979)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3192.eight_wavelengths_span_patch" ;
    pk:leanTheorem "MathOfBiology.Loop_3192.eight_wavelengths_span_patch" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-melanogaster-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronospecies wavelength gaps at 0 Ma" ;
    dct:description "Predecessor mauritiana is longer; successor miranda is shorter; age offset is zero | Variables: shared gamma; species differ in a, b, Du, Dv only" ;
    dct:source "True 1997 DOI:10.1111/j.1558-5646.1997.tb03664.x; Richards 2005 DOI:10.1101/gr.3059305" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-melanogaster-turing-wavelength-s0.py#L153-L169>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3192_drosophila_melanogaster_turing_wavelength_s0.lean#L28-L31> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_mau - lambda_mel = 507 nm; lambda_mel - lambda_mir = 494 nm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1101/gr.3059305>,
        <https://doi.org/10.1111/j.1558-5646.1997.tb03664.x>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1242/dev.129.8.1849> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (Schnakenberg 1979)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3192.holocene_wavelength_gaps" ;
    pk:leanTheorem "MathOfBiology.Loop_3192.holocene_wavelength_gaps" ;
    pk:leanVerified true .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila melanogaster Schnakenberg Turing wavelength at 2.736 µm (Holocene, 0 Ma) — Parameter expressivity: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Gamma scales 0.65 to 2.05 still move analytic lambda strictly from 3.394 µm to 1.911 µm. Pass 2 adds saturated 1D runs on a shared 24 µm domain. With a cos(k_c x) seed the wavelengths are miranda 2.182, melanogaster 2.667, mauritiana 3.429 µm, so the linear order survives saturation. With broadband noise the order does not survive (noise_order_holds = 0). That negative control is why this score is 90 rather than the mid-90s. The Pass 1 gap (linear k_c only) is closed." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-parameter-expressivity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-parameter-expressivity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-melanogaster-turing-wavelength-s0.py L312–L329" ;
        dct:description "monotone gamma sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-melanogaster-turing-wavelength-s0.py#L312-L329> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-melanogaster-turing-wavelength-s0.py L942–L991" ;
        dct:description "noise-seeded and mode-seeded 1D saturation; order flag for each" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-melanogaster-turing-wavelength-s0.py#L942-L991> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/drosophila_melanogaster_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "chronospecies bar chart — docs/media/drosophila_melanogaster_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-drosophila-melanogaster-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/png, 422992 B, 1488×1104 px, artifact_sha256 a5198e44d82533312ce2e385854f8ba7c3d9601826b8b99d7df8ea883615039b (sha256 a5198e44d82533312ce2e385854f8ba7c3d9601826b8b99d7df8ea883615039b), spec_fingerprint 995c7441a1e86dd55fbe8e523c9fea39052280d57b46ba75e4b98b1e0c116683" .

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg most-unstable wavelength for D. mojavensis epicuticle at 2.4 µm (0 Ma) — Model fidelity to source: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The script integrates Schnakenberg kinetics and the Turing linearisation, and it separates the Murray leading-order k_c from the true argmax of σ(k). Absolute Du, Dv are calibrated to the catalog length 2.38e-06 m rather than taken from a measured epicuticular diffusivity. Periodic boundaries only." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-mojavensis-turing-wavelength-s0.py L88–L111" ;
        dct:description "Jacobian at u0=a+b and leading eigenvalue σ(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0e0828eed603126b2ece796473b70906c8bb4076/models/2026-delphi10000-drosophila-mojavensis-turing-wavelength-s0.py#L88-L111> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-mojavensis-turing-wavelength-s0.py L122–L156" ;
        dct:description "Du, Dv calibrated so λ★=2.38 µm at R=80" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0e0828eed603126b2ece796473b70906c8bb4076/models/2026-delphi10000-drosophila-mojavensis-turing-wavelength-s0.py#L122-L156> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-mojavensis-turing-wavelength-s0.py L249–L296" ;
        dct:description "Periodic explicit Schnakenberg integrator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0e0828eed603126b2ece796473b70906c8bb4076/models/2026-delphi10000-drosophila-mojavensis-turing-wavelength-s0.py#L249-L296> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor; a second provider was not available in this loop)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


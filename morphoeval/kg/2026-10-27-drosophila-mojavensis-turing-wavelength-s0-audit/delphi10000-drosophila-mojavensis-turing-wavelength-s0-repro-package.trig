        rdfs:label "Schnakenberg most-unstable wavelength for D. mojavensis epicuticle at 2.4 µm (0 Ma) — Reproducibility package: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "--self-test passed: r>0.98, ablation collapse, monotone sweep, GIF ≥10 frames and ≥480 px, CV≥58, and every morphometric value differs from its reference. Seed 3194. Deterministic explicit Euler. No pinned conda lock for this slot beyond the repository requirements.txt." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

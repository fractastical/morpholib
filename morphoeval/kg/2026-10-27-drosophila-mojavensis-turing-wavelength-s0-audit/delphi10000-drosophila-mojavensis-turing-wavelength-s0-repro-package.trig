        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-repro-package-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-mojavensis-turing-wavelength-s0.py L815–L854" ;
        dct:description "--self-test assertions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0e0828eed603126b2ece796473b70906c8bb4076/models/2026-delphi10000-drosophila-mojavensis-turing-wavelength-s0.py#L815-L854> .

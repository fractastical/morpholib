<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-mojavensis-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg steady state and Jacobian trace" ;
    dct:description "Positive trace-diffusion numerator at the 2.4 µm detail scale (0 Ma) | Variables: a=0.37, b=0.71, gamma=4, R=Dv/Du=80, lambda_target=2.38e-06 m" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0; Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0e0828eed603126b2ece796473b70906c8bb4076/models/2026-delphi10000-drosophila-mojavensis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0e0828eed603126b2ece796473b70906c8bb4076/morphoeval/lean/loops/Loop_3194_drosophila_mojavensis_turing_wavelength_s0.lean#L29-L36> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u0 = a + b, v0 = b/u0^2, trace(J) = gamma*(f_u + g_v) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1365-294x.2006.03102.x>,
        <https://doi.org/10.1111/j.1365-294x.2012.05549.x>,
        <https://doi.org/10.1186/s12864-019-6097-z> ;
    pk:hypothesisType "Schnakenberg reaction-diffusion; most-unstable wavenumber k_star" ;
    pk:leanDeclaration "MathOfBiology.Loop_3194.kcNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3194.mojavensis_kc_numerator_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-mojavensis-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Most-unstable wavelength" ;
    dct:description "Chronoseries order at 0 Ma: miranda > mojavensis > novamexicana | Variables: lambda_miranda=3237 nm, lambda_mojavensis=2380 nm, lambda_novamexicana=1948 nm" ;
    dct:source "Matzkin et al. 2006 DOI:10.1111/j.1365-294x.2006.03102.x" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0e0828eed603126b2ece796473b70906c8bb4076/models/2026-delphi10000-drosophila-mojavensis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0e0828eed603126b2ece796473b70906c8bb4076/morphoeval/lean/loops/Loop_3194_drosophila_mojavensis_turing_wavelength_s0.lean#L10-L20> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_star = argmax_k sigma(k); lambda_star = 2*pi/k_star = 2.38e-06 m" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1365-294x.2006.03102.x>,
        <https://doi.org/10.1111/j.1365-294x.2012.05549.x>,
        <https://doi.org/10.1186/s12864-019-6097-z> ;
    pk:hypothesisType "Schnakenberg reaction-diffusion; most-unstable wavenumber k_star" ;
    pk:leanDeclaration "MathOfBiology.Loop_3194.lambdaMojavensisNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3194.chronoseries_wavelength_decreases" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-mojavensis-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diffusivity square law across the chronoseries" ;
    dct:description "What changes at 2.4 µm versus the predecessor and successor: absolute epicuticular diffusivity, not the Jacobian | Variables: s_miranda=(3237/2380)^2, s_focal=1, s_novamexicana=(1948/2380)^2" ;
    dct:source "Allan & Matzkin 2019 DOI:10.1186/s12864-019-6097-z" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0e0828eed603126b2ece796473b70906c8bb4076/models/2026-delphi10000-drosophila-mojavensis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0e0828eed603126b2ece796473b70906c8bb4076/morphoeval/lean/loops/Loop_3194_drosophila_mojavensis_turing_wavelength_s0.lean#L22-L27> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "s = (lambda_nm/2380)^2; Du' = s*Du; Dv' = s*Dv; lambda proportional to sqrt(D)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1365-294x.2006.03102.x>,
        <https://doi.org/10.1111/j.1365-294x.2012.05549.x>,
        <https://doi.org/10.1186/s12864-019-6097-z> ;
    pk:hypothesisType "Schnakenberg reaction-diffusion; most-unstable wavenumber k_star" ;
    pk:leanDeclaration "MathOfBiology.Loop_3194.wavelengthSq" ;
    pk:leanTheorem "MathOfBiology.Loop_3194.diffusivity_square_law_order" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-mojavensis-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation lies below the Turing margin" ;
    dct:description "Negative control: without differential diffusion the 2.4 µm mode is not selected | Variables: ablation sets Dv = Du (ratio 1) against the focal ratio 80" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0e0828eed603126b2ece796473b70906c8bb4076/models/2026-delphi10000-drosophila-mojavensis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0e0828eed603126b2ece796473b70906c8bb4076/morphoeval/lean/loops/Loop_3194_drosophila_mojavensis_turing_wavelength_s0.lean#L38-L42> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "kcNumerator(1, f_u, g_v) < kcNumerator(80, f_u, g_v)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1365-294x.2006.03102.x>,
        <https://doi.org/10.1111/j.1365-294x.2012.05549.x>,
        <https://doi.org/10.1186/s12864-019-6097-z> ;
    pk:hypothesisType "Schnakenberg reaction-diffusion; most-unstable wavenumber k_star" ;
    pk:leanDeclaration "MathOfBiology.Loop_3194.kcNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3194.differential_diffusion_exceeds_ablation" ;
    pk:leanVerified true .


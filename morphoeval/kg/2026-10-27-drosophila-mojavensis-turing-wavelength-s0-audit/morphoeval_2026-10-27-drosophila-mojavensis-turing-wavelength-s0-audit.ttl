    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Pearson r=0.99323 and RMSE=0.02405 between analytic and PDE growth rates across nine wavenumbers. Plate foreground fraction 0.3806 vs habitus 0.5455, coherency 0.8155 vs 0.5838, circularity 0.0538 vs 0.264, KS(activator, plate)=0.858, all with value ≠ reference. Nonlinear wavelength error is 1.4% (2.414 vs 2.380). No second boundary condition yet." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;

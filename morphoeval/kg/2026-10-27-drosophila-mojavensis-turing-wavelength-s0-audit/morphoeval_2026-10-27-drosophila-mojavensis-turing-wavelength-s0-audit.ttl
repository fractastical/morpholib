<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-mojavensis-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Schnakenberg most-unstable wavelength for D. mojavensis epicuticle at 2.4 µm (0 Ma) (Drosophila mojavensis)",
        "Schnakenberg most-unstable wavelength for D. mojavensis epicuticle at 2.4 µm (0 Ma) faithfully reproduces Drosophila mojavensis morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-mojavensis-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-mojavensis-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-mojavensis-turing-wavelength-s0-3>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-mojavensis-turing-wavelength-s0-4> ;
    dct:description "The simulation script(s) models/2026-delphi10000-drosophila-mojavensis-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila mojavensis specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-mojavensis-turing-wavelength-s0.py> ;
    schema:about "Drosophila mojavensis" ;
    schema:additionalProperty "does_not_claim: That 2.38 µm was read off a D. mojavensis micrograph in the cited papers",
        "does_not_claim: That DOI 10.1534/genetics.106.059444 is a Matzkin cactus paper (Crossref: Hill & Otto 2007, yeast)",
        "does_not_claim: That the gallery plate's 100 µm scale bar is this slot's phenomenon scale",
        "reconstructed_in_script: Activator composited onto the canonical gallery plate for the GIF",
        "reconstructed_in_script: Chronospecies wavelengths via λ ∝ √D at fixed Jacobian and R=80 (3237 nm, 2380 nm, 1948 nm)",
        "reconstructed_in_script: Du and Dv calibrated so the most-unstable wavelength equals 2.38e-06 m",
        "reported_in_source: Drosophila 12 Genomes Consortium 2007 placed D. mojavensis in the repleta group",
        "reported_in_source: Matzkin et al. 2006 and 2012, Allan & Matzkin 2019: cactus-host differentiation in D. mojavensis",
        "reported_in_source: Schnakenberg 1979 two-species kinetics",
        "reported_in_source: Turing 1952 diffusion-driven instability and linear dispersion",
        "transfer_boundary: Campaign chronoseries lists D. miranda as predecessor and D. novamexicana as successor at 0 Ma; that is not a cladogram",
        "transfer_boundary: The 2.4 µm length is the catalog detail tier, not a length reported in the Matzkin papers" ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Drosophila mojavensis (Sonoran Desert Organ-Pipe Cactus Fly)" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "II. Anaima (Invertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;
    pk:aristotelianSubalternClass "Entoma (Arthropoda)" ;

sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-028> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-028-model-fidelity> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-028-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-028_the-logarithmic-spiral.py L45–L95" ;
        dcterms:description "log_spiral_xy, whorl_expansion, model_septa" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/thompson/claims/t1917-028_the-logarithmic-spiral.py#L45-L95> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-028-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-028 — Nautilus log-spiral & septal wall geometry — Model fidelity to source: 68/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Implements Thompson Ch. XI equiangular spiral, whorl expansion, curvature proxy, and septum involute overlays with Raup-compatible W; lacks explicit evolute locus sampling against Thompson Fig. 304 construction steps." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "morphoeval/lean/loops/Thompson1917_T1917_028.lean L1–L55: Lean gnomonic lemmas present but not cited in script docstring cross-refs <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Thompson1917_T1917_028.lean#L1-L55>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-028-model-fidelity-1> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;

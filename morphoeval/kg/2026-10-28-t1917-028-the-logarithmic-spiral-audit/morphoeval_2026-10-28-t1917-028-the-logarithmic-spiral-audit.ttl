<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-028-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-028-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-028-3> .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-028-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equiangular logarithmic spiral" ;
    dct:description "Whorl-to-whorl gnomonic magnification (Thompson Ch. XI) | Variables: r0, k, q: radius scale, log-spiral rate, whorl index" ;
    dct:source "Thompson (1917) Ch. XI; Raup (1966)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Thompson1917_T1917_028.lean#L20>,
        <https://github.com/fractastical/morpholib/blob/HEAD/thompson/claims/t1917-028_the-logarithmic-spiral.py#L45-L55> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "r(θ) = r₀ exp(k θ); dr/dθ = k r; constant angle ψ = arctan(1/k)" ;
    prov:wasDerivedFrom <https://doi.org/10.2307/1301992> ;
    pk:hypothesisType "geometric" ;
    pk:leanDeclaration "MathOfBiology.Loop_222.gnomonic_radius_succ" ;
    pk:leanTheorem "MathOfBiology.Loop_222.gnomonic_radius_succ" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-028-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Evolute/involute curvature scaling" ;
    dct:description "Spiral–septum involute/evolute relation Thompson diagrams | Variables: r, scale, q: radius, curvature scale factor, whorl index" ;
    dct:source "Thompson (1917) Ch. XI Figs. 304-307" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Thompson1917_T1917_028.lean#L30>,
        <https://github.com/fractastical/morpholib/blob/HEAD/thompson/claims/t1917-028_the-logarithmic-spiral.py#L57-L72> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "ρ ∝ r for equiangular spiral; evolute is same-family spiral (phase shift)" ;
    prov:wasDerivedFrom <https://doi.org/10.2307/1301992> ;
    pk:hypothesisType "geometric" ;
    pk:leanDeclaration "MathOfBiology.Loop_222.curvature_scales_with_radius" ;
    pk:leanTheorem "MathOfBiology.Loop_222.curvature_scales_with_radius" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-028-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Septum meets shell wall" ;
    dct:description "Septa meeting the whorl wall (Fig. 304-307) | Variables: equiangularDeg: ψ in degrees" ;
    dct:source "Thompson (1917) Ch. XI" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Thompson1917_T1917_028.lean#L45>,
        <https://github.com/fractastical/morpholib/blob/HEAD/thompson/claims/t1917-028_the-logarithmic-spiral.py#L74-L95> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "meeting complement angle = 90° − ψ when septum is normal to involute in radial frame" ;
    prov:wasDerivedFrom <https://doi.org/10.2307/1301992> ;
    pk:hypothesisType "geometric" ;
    pk:leanDeclaration "MathOfBiology.Loop_222.wall_meeting_complement_bounds" ;
    pk:leanTheorem "MathOfBiology.Loop_222.wall_meeting_complement_bounds" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


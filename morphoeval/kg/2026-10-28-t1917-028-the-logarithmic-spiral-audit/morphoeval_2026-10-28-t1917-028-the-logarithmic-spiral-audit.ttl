<https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-028> a pk:Claim ;
    rdfs:label "Thompson (1917) T1917-028 — Nautilus log-spiral & septal wall geometry (Nautilus pompilius (section specimen))",
        "Thompson (1917) T1917-028 — Nautilus log-spiral & septal wall geometry faithfully reproduces Nautilus pompilius (section specimen) morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-028-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-028-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-028-3> ;
    dct:description "The simulation script(s) thompson/claims/t1917-028_the-logarithmic-spiral.py implement the cited source model as published and produce forms that match real Nautilus pompilius (section specimen) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-028_the-logarithmic-spiral.py> ;
    schema:about "Nautilus pompilius (section specimen)" ;
    schema:additionalProperty "does_not_claim: Full 3D CT chamber hydrodynamics or Raup (D,T) helicospiral surface mesh",
        "reconstructed_in_script: Equiangular spiral r=r0 exp(kθ), whorl ratio W, septum involute overlay, wall meeting complement β=90°−ψ",
        "reported_in_source: Thompson (1917) Ch. XI diagrams septa meeting the whorl wall and evolute/involute relations for Nautilus",
        "transfer_boundary: Commons section photo is N. pompilius; Thompson figures are schematic radiograph-style diagrams" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-028_the-logarithmic-spiral.py; output: docs/media/t1917_028_the_logarithmic_spiral_comparison.png; organism: Nautilus pompilius (section specimen); environment: n/a; claim_boundary: [reported_in_source: Thompson (1917) Ch. XI diagrams septa meeting the whorl wall and evolute/involute relations for Nautilus; reconstructed_in_script: Equiangular spiral r=r0 exp(kθ), whorl ratio W, septum involute overlay, wall meeting complement β=90°−ψ; transfer_boundary: Commons section photo is N. pompilius; Thompson figures are schematic radiograph-style diagrams; does_not_claim: Full 3D CT chamber hydrodynamics or Raup (D,T) helicospiral surface mesh]; other sources: On Growth and Form <https://archive.org/details/ongrowthform1917thom>; phenomenon_size: 139 µm (0.0001386 m, log10=-3.858 m, tier=5_primordium_100um); species_scale_ladder (11 runs from 139 µm to 31.2 cm): 139 µm:nautilus-pompilius-bioelectric-polarity, 433 µm:nautilus-pompilius-vertex-packing, 6.9 mm:nautilus-pompilius-turing-wavelength, 1.4 cm:nautilus-pompilius-clock-wavefront, 2.8 cm:raup-shell-coiling, 3.1 cm:nautilus-pompilius-morphogen-condensation, 3.8 cm:nautilus-pompilius-elastic-buckling, 4.3 cm:nautilus-pompilius-flux-canalization" ;
    pk:derivedFromPaper <https://doi.org/10.2307/1301992> ;
    pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-028-code-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-028-model-fidelity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-028-morphometric-validation>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-028-overall>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-028-parameter-expressivity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-028-repro-package>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-028-source-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-028-specimen-match> ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-028-the-logarithmic-spiral-audit-thompson1917-t1917-028-1>,

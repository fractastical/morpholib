<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Danio nigrofasciatus Schnakenberg wavelength at 27 µm (Holocene, 0 Ma), Pass 2 — Model fidelity to source: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script implements Schnakenberg kinetics, the continuous critical wavenumber, and the discrete 5-point dispersion. One-step eigenmode growth matches analytical sigma(k) at r = 0.999997. Anisotropy is an extension of the isotropic law, so this is not a line-by-line copy of Nakamasu's cell-contact rules." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Danio nigrofasciatus Schnakenberg wavelength at 27 µm (Holocene, 0 Ma), Pass 2 — Morphometric validation: 82/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Measured wavelength 27.33 µm versus catalog 27.1 µm. Dispersion RMSE 0.00141. Trunk KS 0.336 versus a 0.05 identity floor. Posterior holdout gap is scored with a threshold fit only on the anterior half. The dorsoventral profile correlation is 0.023 and is reported as a miss, which caps this dimension." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

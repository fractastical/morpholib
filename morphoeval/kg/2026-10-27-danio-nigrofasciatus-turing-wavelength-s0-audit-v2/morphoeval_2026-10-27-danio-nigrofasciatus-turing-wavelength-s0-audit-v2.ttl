<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-danio-nigrofasciatus-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-danio-nigrofasciatus-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-danio-nigrofasciatus-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-danio-nigrofasciatus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg Jacobian at the homogeneous state" ;
    dct:description "Turing diffusion threshold D_v f_u > D_u |g_v| for Danio nigrofasciatus at 27 µm | Variables: a=0.1, b=0.9, D_u=0.05, D_v=2.0 at lambda = 27 µm" ;
    dct:source "Schnakenberg 1979 doi:10.1016/0022-5193(79)90042-0; Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8585ec4a033d94afd4c400aaefdffe79c1f7bc69/models/2026-delphi10000-danio-nigrofasciatus-turing-wavelength-s0.py#L83-L101>,
        <https://github.com/fractastical/morpholib/blob/8585ec4a033d94afd4c400aaefdffe79c1f7bc69/morphoeval/lean/loops/Loop_3163_danio_nigrofasciatus_turing_wavelength_s0.lean#L74-L76> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u0 = a + b, v0 = b/u0^2, f_u = -1 + 2 u0 v0, g_v = -u0^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/s41467-018-05629-z>,
        <https://doi.org/10.1038/s41467-020-20021-6>,
        <https://doi.org/10.1038/sj.hdy.6800867>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.7554/eLife.05635> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3163.turing_diffusion_threshold" ;
    pk:leanTheorem "MathOfBiology.Loop_3163.turing_diffusion_threshold" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-danio-nigrofasciatus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber and cellular wavelength" ;
    dct:description "Wavelength selection for the cellular melanophore-contact mode | Variables: k_c ≈ 232710 rad/m at 27 µm; catalog length 2.71e-05 m" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012; Nakamasu et al. 2009 doi:10.1073/pnas.0808622106" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8585ec4a033d94afd4c400aaefdffe79c1f7bc69/models/2026-delphi10000-danio-nigrofasciatus-turing-wavelength-s0.py#L104-L115>,
        <https://github.com/fractastical/morpholib/blob/8585ec4a033d94afd4c400aaefdffe79c1f7bc69/morphoeval/lean/loops/Loop_3163_danio_nigrofasciatus_turing_wavelength_s0.lean#L63-L65> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c = 2.71e-05 m" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/s41467-018-05629-z>,
        <https://doi.org/10.1038/s41467-020-20021-6>,
        <https://doi.org/10.1038/sj.hdy.6800867>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.7554/eLife.05635> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3163.kCPerM" ;
    pk:leanTheorem "MathOfBiology.Loop_3163.wavenumber_wavelength_product_close" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-danio-nigrofasciatus-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries anisotropy order at fixed age 0 Ma" ;
    dct:description "What changes at 27 µm versus the predecessor and the successor is mode symmetry, not age and not the 1 mm organ-scale stripe spacing | Variables: anisotropy alpha = D_AP / D_DV; geological age held at 0 Ma" ;
    dct:source "Parichy 2006 doi:10.1038/sj.hdy.6800867; Volkening and Sandstede 2018 doi:10.1038/s41467-018-05629-z; Podobnik et al. 2020 doi:10.1038/s41467-020-20021-6" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8585ec4a033d94afd4c400aaefdffe79c1f7bc69/models/2026-delphi10000-danio-nigrofasciatus-turing-wavelength-s0.py#L388-L414>,
        <https://github.com/fractastical/morpholib/blob/8585ec4a033d94afd4c400aaefdffe79c1f7bc69/morphoeval/lean/loops/Loop_3163_danio_nigrofasciatus_turing_wavelength_s0.lean#L56-L60> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "alpha(margaritatus)=1.05 < alpha_ventral(nigrofasciatus)=1.15 < alpha_dorsal=6 < alpha(rerio)=8.5" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/s41467-018-05629-z>,
        <https://doi.org/10.1038/s41467-020-20021-6>,
        <https://doi.org/10.1038/sj.hdy.6800867>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.7554/eLife.05635> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3163.alphaMargCenti" ;

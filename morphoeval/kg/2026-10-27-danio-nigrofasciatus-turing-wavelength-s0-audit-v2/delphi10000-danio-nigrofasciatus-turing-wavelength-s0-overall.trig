sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Danio nigrofasciatus Schnakenberg wavelength at 27 µm (Holocene, 0 Ma), Pass 2 — MorphoEval overall 86.1/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 2 re-run. Dispersion Pearson r = 0.999997 (RMSE 0.00141, n = 315 real eigenmodes) against the analytical sigma(k), above the 0.98 gate and not equal to that gate. Measured spectral wavelength 27.33 µm versus the catalog 27.1 µm (2.71e-05 m, log10=-4.567) at age 0 Ma. Alpha sweep Spearman = 1.0 against a 0.8 floor. Ablation ratio of pattern std to relaxation std is about 3.6e6. Trunk KS versus the Parichy photograph is 0.336. GIF is 12 frames at 1120x480. Chronoseries at this scale, all 0 Ma: margaritatus spots (alpha 1.05), nigrofasciatus broken ventral stripes (alpha 6 / 1.15), rerio continuous stripes (alpha 8.5). The photograph's dorsoventral darkness profile is not fit (r = 0.023) and is not claimed. Overall 86.1/100 (faithfulness 84.9, reproducibility 88.7); rubric morphoeval 0.1.0; checkpoint commit 8585ec4a033d94afd4c400aaefdffe79c1f7bc69; environment: . Dimension assessments: Model fidelity to source 88, Morphological realism / specimen match 83, Parameter expressivity 88, Morphometric validation 82, Source and data traceability 91, Code-to-model traceability 84, Reproducibility package 90. Output judged: docs/media/danio_nigrofasciatus_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-danio-nigrofasciatus-turing-wavelength-s0.py at 8585ec4a033d94afd4c400aaefdffe79c1f7bc69, image/png, 844084 B, 1344×960 px, artifact_sha256 148886b92b1be1b13cf7f30fa6946f8dd7aac8ca06dca5c43b6ee09787de9e5d (sha256 148886b92b1be1b13cf7f30fa6946f8dd7aac8ca06dca5c43b6ee09787de9e5d), spec_fingerprint 91717ca6df274e3e1c0bf367643f453836a534d386c3a9a413fc1a38ae61dfdd. Dual provenance: spec_fingerprint: 91717ca6df274e3e1c0bf367643f453836a534d386c3a9a413fc1a38ae61dfdd; artifact_sha256: 148886b92b1be1b13cf7f30fa6946f8dd7aac8ca06dca5c43b6ee09787de9e5d; input_dataset_sha256: {datasets/danio_nigrofasciatus_turing_wavelength_s0/danio_nigrofasciatus_specimen.jpg=edea58cd2541052f..., datasets/danio_nigrofasciatus_turing_wavelength_s0/danio_nigrofasciatus_turing_wavelength_s0_reference.json=2ffd9764fa0a9a43...}. Supersedes audit: 2026-10-27-danio-nigrofasciatus-turing-wavelength-s0-audit. Claim boundary: reported_in_source: Turing 1952 dispersion relation and the critical-wavenumber formula. | Schnakenberg 1979 kinetics f = a - u + u^2 v, g = b - u^2 v. | Nakamasu et al. 2009: Danio pigment cells implement short-range activation and long-range inhibition and can form stripes or spots. | Parichy 2006: D. nigrofasciatus keeps a striped dorsum and a broken ventral field, unlike spotted D. margaritatus and striped D. rerio. | Volkening and Sandstede 2018 and Podobnik et al. 2020: iridophores and Kcnj13 change Danio pattern symmetry.; reconstructed_in_script: Explicit-Euler anisotropic Schnakenberg with dx chosen so analytical lambda_c = 2.71e-05 m. | Chronoseries alphas 1.05, 6/1.15, and 8.5 at geological age 0 Ma. | Alpha sweep, ablation, KS, and anterior-posterior holdout. | Trunk composite on the SHA-pinned Parichy photograph and a 12-frame growth GIF.; transfer_boundary: 27 µm is imposed by dx from the catalog cellular tier. The whole-body photograph does not resolve 27 µm. | alpha is a stand-in for iridophore and Kcnj13 coupling, not a fitted channel conductance.; does_not_claim: Does not claim the organ-scale ~1 mm stripe spacing of slot 1203. | Does not claim a fit to the photograph's dorsoventral darkness profile (Pearson r = 0.023). | Does not claim more than one specimen, and does not claim a second assessor.." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: {'id': 'R1', 'item': 'Closed in this pass: alpha sweep Spearman is measured and drawn on the comparison figure.', 'status': 'resolved'}",
            "remediation needed: {'id': 'R2', 'item': 'Closed in this pass: trunk KS and anterior-posterior holdout are in measure_morphoeval, with reference floors that differ from the values.', 'status': 'resolved'}",
            "remediation needed: {'id': 'R3', 'item': 'Closed in this pass: ablation ratio is asserted in --self-test (pattern std / relaxation std > 3).', 'status': 'resolved'}",
            "remediation needed: {'id': 'R4', 'item': 'Closed in this pass: image fitness is computed from the growth GIF against the Parichy specimen and written only to the per-loop fitness JSON.', 'status': 'resolved'}",
            "remediation needed: {'id': 'R5', 'item': 'Still open: one specimen, and the dorsoventral darkness profile of that photograph is not reproduced (r = 0.023). A second fish and an explicit iridophore variable would be the next experiment. Not scored as done.', 'status': 'open'}" ;
        pk:hasScore "0.861"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; Pass 2 re-score of the same script)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


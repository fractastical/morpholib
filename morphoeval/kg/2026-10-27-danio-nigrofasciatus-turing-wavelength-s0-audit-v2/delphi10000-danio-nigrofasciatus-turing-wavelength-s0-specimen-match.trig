            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-nigrofasciatus-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.83"^^xsd:double ;
        pk:hasVerdict "faithful" .

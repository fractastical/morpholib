sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila ficusphila longitudinal sex-comb Turing wavelength at 2.1 µm — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The code uses the Schnakenberg steady state (u0, v0) = (1, 0.9), the Jacobian (f_u, f_v, g_u, g_v) = (0.8, 1, -1.8, -1), and the Turing wavenumber k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v). Self-test locks λ_c to 2.072 µm and rejects the equal-diffusion control. Six Lean theorems (0 sorry) check the trace, the determinant, the r = 20 margin, the r = 1 margin, and the wavelength ordering 2072 < 3108 and 2072 < 4144 nm. The spiral charge is not part of the published kinetics." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py L230–L245: spiral charge m=2 is a render choice, not a measured topological index <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py#L230-L245>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py L81–L89" ;
        dct:description "dispersion_sigma: largest real eigenvalue of J - k^2 D" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py#L81-L89> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py L91–L133" ;
        dct:description "trace, det, cross term, k_c, unstable-band roots, equal-diffusion guard" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py#L91-L133> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3185_drosophila_ficusphila_turing_wavelength_s0.lean L14–L56" ;
        dct:description "six theorems, 0 sorry: trace, det, r=20 unstable, r=1 stable, wavelength order, ridge counts" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3185_drosophila_ficusphila_turing_wavelength_s0.lean#L14-L56> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://github.com/fractastical/morpholib> .
}


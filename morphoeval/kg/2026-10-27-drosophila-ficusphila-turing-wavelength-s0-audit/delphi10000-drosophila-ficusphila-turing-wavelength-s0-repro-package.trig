        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila ficusphila longitudinal sex-comb Turing wavelength at 2.1 µm — Reproducibility package: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "--self-test checks the specimen hash, the steady state, Turing instability, λ_c, the stable equal-diffusion eigenvalue, Pearson r > 0.98, and the chronospecies order. Seed 3185, grid 128×96, and 3600 steps are constants. The run prints frame count and writes a metrics JSON. Dependencies are the repo scientific stack (numpy, Pillow, matplotlib); this pass does not pin a per-script lockfile." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-repro-package-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py L428–L468" ;
        dct:description "self_test exits non-zero on any failed invariant" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py#L428-L468> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py L40–L55" ;
        dct:description "pinned specimen hash, seed 3185, grid, step count, frame count" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py#L40-L55> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://github.com/fractastical/morpholib> .
}


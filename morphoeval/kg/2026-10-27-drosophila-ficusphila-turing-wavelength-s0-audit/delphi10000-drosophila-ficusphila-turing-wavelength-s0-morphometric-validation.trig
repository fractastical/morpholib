sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila ficusphila longitudinal sex-comb Turing wavelength at 2.1 µm — Morphometric validation: 72/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Analytic σ(k) versus late-window Euler growth on the critical eigenmode: Pearson r = 0.99999994, RMSE = 5.22e-4 (reference threshold 0.98 and tolerance 0.05; the measured numbers are not copies of those references). The 12-point argmax wavelength is 2.4508 µm against the assigned 2.072 µm, so the grid is too coarse to locate k_c. No Kolmogorov-Smirnov comparison and no mask measurement on the specimen pixels are in this pass." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py L350–L378: core_metrics has no KS statistic and no specimen-mask coherency <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py#L350-L378>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-predecessor-wavelength-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-stripe-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r = 1.0 1" ;
        schema:measurementTechnique "Pearson r between analytic σ(k) and late-time Euler growth rates" ;
        schema:name "dispersion_pearson_r" ;
        schema:unitText "1" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "MorphoEval gate for this loop (threshold, not the measured r)" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_rmse = 0.00052 1/time" ;
        schema:measurementTechnique "RMSE of Euler σ(k) against the closed-form eigenvalue" ;
        schema:name "dispersion_rmse" ;
        schema:unitText "1/time" ;
        schema:value "0.00052" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "pre-registered tolerance, not the measured RMSE" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-predecessor-wavelength-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "predecessor_wavelength_ratio = 1.5 1" ;
        schema:measurementTechnique "λ(eugracilis)/λ(ficusphila) at density 2/3, same Jacobian, 0 Ma" ;
        schema:name "predecessor_wavelength_ratio" ;
        schema:unitText "1" ;
        schema:value "1.5" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-predecessor-wavelength-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-predecessor-wavelength-ratio-reference> a schema:PropertyValue ;
        dct:source "focal species ratio against itself would be 1; predecessor is longer" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-stripe-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_stripe_wavelength_um = 2.4508 µm" ;
        dct:description "Numeric argmax on a 12-point k grid; not identical to the analytic λ_c." ;
        schema:measurementTechnique "2π/k at the wavenumber that maximises the Euler growth-rate sample" ;
        schema:name "specimen_stripe_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "2.4508" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-stripe-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-stripe-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "assigned detail-tier wavelength 2.072 µm (2.072e-6 m)" ;
        schema:value "2.072" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py L167–L228" ;
        dct:description "numeric_growth_rates: eigenmode Euler versus closed-form σ(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py#L167-L228> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py L381–L426" ;
        dct:description "measure_morphoeval records wavelength 2.4508 vs reference 2.072, r vs 0.98, RMSE vs 0.05" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py#L381-L426> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://github.com/fractastical/morpholib> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://github.com/fractastical/morpholib>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1073/pnas.0807875106>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.1525-142X.2011.00507.x>,
            <https://doi.org/10.1371/journal.pbio.1001131> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1073/pnas.0807875106> dct:date "2009"^^xsd:gYear ;
        dct:title "Distinct developmental mechanisms underlie the evolutionary diversification of Drosophila sex combs" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1111/j.1525-142X.2011.00507.x> dct:date "2011"^^xsd:gYear ;
        dct:title "Drosophila sex combs as a model of evolutionary innovations" .
    <https://doi.org/10.1371/journal.pbio.1001131> dct:date "2011"^^xsd:gYear ;
        dct:title "Evolution of sex-specific traits through changes in HOX-dependent doublesex expression" .
}


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila ficusphila longitudinal sex-comb Turing wavelength at 2.1 µm — Code-to-model traceability: 84/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "dispersion_sigma, du_for_wavelength and the chronospecies table are each named in the math-KG record with a Lean declaration and a DOI. The PDE stepper cites Schnakenberg production terms a - u + u^2 v and b - u^2 v directly. The band-edge quadratic in turing_diagnostics is commented more densely than it is tested." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

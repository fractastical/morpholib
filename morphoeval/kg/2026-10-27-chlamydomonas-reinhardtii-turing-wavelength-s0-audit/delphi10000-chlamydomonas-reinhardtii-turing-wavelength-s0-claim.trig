sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Schnakenberg Turing wavelength at the 10.32 nm Chlamydomonas eyespot pigment stripe (Pass 1) faithfully reproduces Chlamydomonas reinhardtii (Holocene, 0 Ma) morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Chlamydomonas reinhardtii (Holocene, 0 Ma) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0.py; output: docs/media/chlamydomonas_reinhardtii_turing_wavelength_s0_comparison.png; organism: Chlamydomonas reinhardtii (Holocene, 0 Ma); environment: n/a; claim_boundary: [reported_in_source: Turing 1952: a homogeneous steady state can be unstable to a finite critical wavenumber k_c. | Schnakenberg 1979: activator-inhibitor kinetics du/dt = a - u + u^2 v, dv/dt = b - u^2 v. | Dieckmann 2003 and Kreimer 2008: the Chlamydomonas eyespot is stacked carotenoid granules under the plasma membrane. | Foster and Smyth 1980: the eyespot stack acts as a quarter-wave light antenna. | Boyd et al. 2011: EYE2 and EYE3 are required for eyespot assembly. | Kato et al. 2012: channelrhodopsin is the light-gated channel associated with the eyespot.; reconstructed_in_script: Jacobian, onset k_c, and argmax of the linear growth rate sigma(k) for the Schnakenberg system. | Spatial calibration so the reference fastest wavelength is 10.32 nm = 1.032e-8 m (log10 = -7.986). | Explicit finite-difference check of that wavelength on a periodic six-stripe patch (61.92 nm).; transfer_boundary: A continuum reaction-diffusion description at 10 nm is a reduced model of pigment aggregation, not a measured morphogen pair. | The chronoseries is 1/1 (Holocene only). The 3.2 nm monomer and the ~93 nm quarter-wave spacing are scale neighbors, not fossil chronospecies.; does_not_claim: Does not claim that 10.32 nm was read off an electron micrograph as a published lattice constant. | Does not claim to replace the EYE2/EYE3 assembly pathway. | Does not claim the SEM resolves the 10 nm stripe. The GIF keeps the real cell silhouettes and modulates their interior.]; phenomenon_size: 10 nm (1.032e-08 m, log10=-7.986 m, tier=1_molecular_nm); species_scale_ladder (10 runs from 10 nm to 31 µm): 10 nm:chlamydomonas-reinhardtii-bioelectric-polarity, 38 nm:chlamydomonas-reinhardtii-vertex-packing, 684 nm:chlamydomonas-reinhardtii-turing-wavelength, 1.3 µm:chlamydomonas-reinhardtii-clock-wavefront, 2.1 µm:chlamydomonas-reinhardtii-morphogen-condensation, 2.7 µm:chlamydomonas-reinhardtii-flux-canalization, 3.1 µm:chlamydomonas-reinhardtii-elastic-buckling, 6.7 µm:chlamydomonas-reinhardtii-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1002/bies.10259>,
            <https://doi.org/10.1007/s00294-008-0224-8>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/nature10870>,
            <https://doi.org/10.1091/mbc.e10-11-0918>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1105/tpc.106.041749>,
            <https://doi.org/10.1128/mr.44.4.572-630.1980> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


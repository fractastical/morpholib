    <https://doi.org/10.1002/bies.10259> dct:date "2003"^^xsd:gYear ;
        dct:title "Eyespot placement and assembly in the green alga Chlamydomonas" .
    <https://doi.org/10.1007/s00294-008-0224-8> dct:date "2008"^^xsd:gYear ;

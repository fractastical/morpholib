<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg activator-inhibitor kinetics" ;
    dct:description "Kinetics at the 10.32 nm pigment-stripe scale; distinct from slot 0195 | Variables: a=0.07 basal activator, b=0.95 basal inhibitor, Du=1, Dv=36" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3146_chlamydomonas_reinhardtii_turing_wavelength_s0.lean#L24-L36> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "du/dt = Du lap u + a - u + u^2 v ;  dv/dt = Dv lap v + b - u^2 v" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/bies.10259>,
        <https://doi.org/10.1007/s00294-008-0224-8>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature10870>,
        <https://doi.org/10.1091/mbc.e10-11-0918>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1105/tpc.106.041749>,
        <https://doi.org/10.1128/mr.44.4.572-630.1980> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3146.thisSlotScaledBasal" ;
    pk:leanTheorem "MathOfBiology.Loop_3146.distinct_from_slot_0195" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing onset wavenumber k_c" ;
    dct:description "Onset critical wavenumber. Above onset the fastest mode k_max is smaller than k_c. | Variables: f_u, g_v Jacobian entries of the Schnakenberg steady state; Du, Dv" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3146_chlamydomonas_reinhardtii_turing_wavelength_s0.lean#L30-L32> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (Dv f_u + Du g_v) / (2 Du Dv) ;  lambda_c = 2 pi / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/bies.10259>,
        <https://doi.org/10.1007/s00294-008-0224-8>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature10870>,
        <https://doi.org/10.1091/mbc.e10-11-0918>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1105/tpc.106.041749>,
        <https://doi.org/10.1128/mr.44.4.572-630.1980> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3146.dvOverDuTimes100" ;
    pk:leanTheorem "MathOfBiology.Loop_3146.diffusion_ratio_above_onset" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Selected pigment-stripe wavelength" ;
    dct:description "Scale sandwich for the Holocene eyespot at 0 Ma. Six stripes fit in one globule. | Variables: stripe 10320 pm; carotenoid monomer 3200 pm; quarter-wave spacing 90000 pm" ;
    dct:source "Foster & Smyth 1980 DOI:10.1128/mr.44.4.572-630.1980; Dieckmann 2003 DOI:10.1002/bies.10259" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3146_chlamydomonas_reinhardtii_turing_wavelength_s0.lean#L18-L24> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_star = 2 pi / k_max = 10.32 nm, with k_max = argmax sigma(k)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/bies.10259>,
        <https://doi.org/10.1007/s00294-008-0224-8>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature10870>,
        <https://doi.org/10.1091/mbc.e10-11-0918>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1105/tpc.106.041749>,
        <https://doi.org/10.1128/mr.44.4.572-630.1980> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3146.stripePm" ;
    pk:leanTheorem "MathOfBiology.Loop_3146.stripe_above_carotenoid_monomer" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .

<https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
    rdfs:label "Grok 4.7 (builder-assessor, single agent; no second provider in this cloud loop)" ;
    dct:identifier "grok-4.7" ;
    prov:actedOnBehalfOf <https://github.com/fractastical/morpholib> .


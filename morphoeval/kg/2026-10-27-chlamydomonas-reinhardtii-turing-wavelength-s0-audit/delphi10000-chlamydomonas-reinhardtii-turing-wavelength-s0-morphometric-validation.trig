sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at the 10.32 nm Chlamydomonas eyespot pigment stripe (Pass 1) — Morphometric validation: 68/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r=0.9997 and RMSE=0.20 nm are computed. The first cell median, before the 3-12 um window, was 1.29 um because debris and one merged cluster dominated. This pass does not accept a cell-size comparison until that window is the reported value." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-ablation-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-dispersion-rmse-nm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-negative-control-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-onset-k-c-per-nm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-saturated-vs-linear-wavelength-nm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-selected-pigment-stripe-nm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-cell-diameter-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-cell-diameter-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-intensity-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-ablation-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_sigma_max = -1.0004 1/time" ;
        schema:measurementTechnique "Ablation: drop autocatalysis u^2 v, leaving linear decay. sigma_max must stay negative." ;
        schema:name "ablation_sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-1.0004" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-ablation-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-ablation-sigma-max-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r = 0.999746 1" ;
        schema:measurementTechnique "Pearson r of numerical vs analytical fastest wavelength across the Dv sweep. Ideal correlation is 1; the finite-difference value is not identical." ;
        schema:name "dispersion_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.999746" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-dispersion-rmse-nm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_rmse_nm = 0.20041 nm" ;
        schema:measurementTechnique "RMSE between numerical and analytical lambda(k_max) over Dv in {18,24,32,36,44,58,76}." ;
        schema:name "dispersion_rmse_nm" ;
        schema:unitText "nm" ;
        schema:value "0.20041" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-dispersion-rmse-nm-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-dispersion-rmse-nm-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-negative-control-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "negative_control_sigma_max = -0.089227 1/time" ;
        schema:measurementTechnique "Negative control: Dv=Du removes differential diffusion. sigma_max must stay negative (no Turing stripe)." ;
        schema:name "negative_control_sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.089227" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-negative-control-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-negative-control-sigma-max-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-onset-k-c-per-nm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "onset_k_c_per_nm = 0.899449 1/nm" ;
        schema:measurementTechnique "Onset wavenumber k_c compared with the fastest mode k_max at Dv/Du=36. They differ above onset; lambda(k_max) is the 10.32 nm stripe." ;
        schema:name "onset_k_c_per_nm" ;
        schema:unitText "1/nm" ;
        schema:value "0.899449" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-onset-k-c-per-nm-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-onset-k-c-per-nm-reference> a schema:PropertyValue ;
        schema:value "0.608836" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-saturated-vs-linear-wavelength-nm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "saturated_vs_linear_wavelength_nm = 10.14608 nm" ;
        schema:measurementTechnique "Nonlinear saturated wavelength vs the linear-regime wavelength at Dv=36. The shift is the second parameter regime (above onset)." ;
        schema:name "saturated_vs_linear_wavelength_nm" ;
        schema:unitText "nm" ;
        schema:value "10.14608" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-saturated-vs-linear-wavelength-nm-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-saturated-vs-linear-wavelength-nm-reference> a schema:PropertyValue ;
        schema:value "10.25913" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-selected-pigment-stripe-nm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "selected_pigment_stripe_nm = 10.25913 nm" ;
        schema:measurementTechnique "Radial FFT of the linear-regime FD field vs analytical argmax sigma(k), scaled so lambda(k_max ref)=10.32 nm. RMSE of the Dv sweep is reported separately." ;
        schema:name "selected_pigment_stripe_nm" ;
        schema:unitText "nm" ;
        schema:value "10.25913" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-selected-pigment-stripe-nm-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-selected-pigment-stripe-nm-reference> a schema:PropertyValue ;
        schema:value "10.32" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-cell-diameter-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_cell_diameter_cv = 0.0934 1" ;
        schema:measurementTechnique "CV of segmented cell equivalent diameters on the Dartmouth SEM. Zero would mean identical cells." ;
        schema:name "specimen_cell_diameter_cv" ;
        schema:unitText "1" ;
        schema:value "0.0934" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-cell-diameter-cv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-cell-diameter-cv-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-cell-diameter-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_cell_diameter_um = 4.7223 um" ;
        schema:measurementTechnique "Median equivalent diameter of isolated SEM cell bodies between 3 and 12 um, using the labeled 10 um scale bar. Debris and the merged cluster are excluded. Reference 10 um is the nominal vegetative length, not this bright-cap measurement." ;
        schema:name "specimen_cell_diameter_um" ;
        schema:unitText "um" ;
        schema:value "4.7223" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-cell-diameter-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-cell-diameter-um-reference> a schema:PropertyValue ;
        schema:value "10.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_circularity = 0.0243 1" ;
        schema:measurementTechnique "4*pi*area/perimeter^2 of the segmented cell union, simulation vs specimen." ;
        schema:name "specimen_contour_circularity" ;
        schema:unitText "1" ;
        schema:value "0.0243" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        schema:value "0.0273" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_foreground_fraction = 0.4162 1" ;
        schema:measurementTechnique "Foreground fraction of the modulated simulation frame vs the real SEM segmentation. Self-referential equality is not expected once the activator rescales edges." ;
        schema:name "specimen_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.4162" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        schema:value "0.425" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-intensity-ks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_intensity_ks = 0.0792 1" ;
        schema:measurementTechnique "Two-sample KS statistic between SEM and modulated cell-interior intensities (p=2.4e-11). Identical images would score 0." ;
        schema:name "specimen_intensity_ks" ;
        schema:unitText "1" ;
        schema:value "0.0792" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-intensity-ks-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-intensity-ks-reference> a schema:PropertyValue ;

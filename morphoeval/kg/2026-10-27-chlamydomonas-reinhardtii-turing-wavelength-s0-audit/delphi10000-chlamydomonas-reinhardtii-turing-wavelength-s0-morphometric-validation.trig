    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_structure_tensor_coherency = 0.4071 1" ;
        schema:measurementTechnique "Structure-tensor coherency on the simulation mask vs the specimen mask." ;
        schema:name "specimen_structure_tensor_coherency" ;
        schema:unitText "1" ;
        schema:value "0.4071" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        schema:value "0.4052" .

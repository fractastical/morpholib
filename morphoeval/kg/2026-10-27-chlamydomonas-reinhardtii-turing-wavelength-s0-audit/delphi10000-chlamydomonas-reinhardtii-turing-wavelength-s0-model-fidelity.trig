        rdfs:label "Schnakenberg Turing wavelength at the 10.32 nm Chlamydomonas eyespot pigment stripe (Pass 1) — Model fidelity to source: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Equations 1-4 (Schnakenberg kinetics, Jacobian, onset k_c, fastest mode) are implemented and the reference state is Turing-unstable. The Dv=Du control and the autocatalysis ablation are in the file; this pass does not yet credit them." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-model-fidelity-1> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0.py L91–L153" ;
        dct:description "jacobian, onset_wavenumber, growth_rate, fastest_mode" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0.py#L91-L153> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second provider in this cloud loop)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://github.com/fractastical/morpholib> .
}


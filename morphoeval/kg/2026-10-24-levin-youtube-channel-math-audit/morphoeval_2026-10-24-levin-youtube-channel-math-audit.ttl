<https://w3id.org/delphi/resource/math-law/levin-youtube-channel-math-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Law 3: Pietak & Levin (2016, 2017) Nernst-Planck Zero-Flux Boltzmann Serotonin Electrophoresis Law" ;
    dct:description "Proves why gap-junction conductance cancels out of the zero-flux Boltzmann ratio, locking permanent 2H0T bioelectric memory after octanol washout | Variables: c: intracellular morphogen (5-HT+) concentration; z=+1: valence; V: membrane potential; G_gj: gap-junction permeability" ;
    dct:source "Pietak & Levin (2016, 2017) J. R. Soc. Interface; @drmichaellevin [L0D4FdJ4K3g], [7UqncReYvso], [SRV1oLRXeE4]" ;

    pk:leanTheorem "LoopLevinYouTubeChannelMath.ororbia_friston_fields_mortal_computation_survival_law" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/levin-youtube-channel-math-16> a skos:Concept,
        pk:Concept ;
    rdfs:label "Law 16: Gatenby, Picard & Fields (2022, 2026) Information-Energetic Signaling Capacity & ATP Tradeoff Law" ;
    dct:description "Quantifies Martin Picard's and Robert Gatenby's bioenergetic tradeoff between multicellular information processing and runaway proliferation | Variables: E_total: mitochondrial ATP budget; E_info: transmembrane ion-gradient information cost; E_prolif: biosynthetic proliferation energy" ;
    dct:source "Gatenby (2022, 2025) @drmichaellevin [d-ZK41F_1jE], [NiyNfxU2C1o]; Picard (2026) [uT3PwI_pX5E]; Fields [0GngwREFHI4]; Kubal [0LgHJn_IhSg]" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a2201fd3/models/2026-levin-channel-math-synthesis.py#L136-L139>,
        <https://github.com/fractastical/morpholib/blob/a2201fd3/morphoeval/lean/loops/Loop_levin_youtube_channel_math.lean#L247-L259> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def cellular_proliferation_budget (e_total e_maint e_info : Nat) : Nat :=
  e_total - e_maint - e_info
theorem gatenby_picard_fields_landauer_signaling_budget_law :

    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def grn_hebbian_energy_after (e_init eta n_genes : Int) : Int :=
  e_init - eta * n_genes * n_genes
theorem watson_natural_induction_hebbian_energy_descent (e_init : Int) :

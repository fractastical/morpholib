<https://w3id.org/delphi/resource/math-law/levin-youtube-channel-math-15> a skos:Concept,
        pk:Concept ;
    rdfs:label "Law 15: Ororbia, Friston & Fields (2024) Mortal Computation Thermodynamic Metabolic Survival Law" ;
    dct:description "Distinguishes substrate-bound biological ('mortal') computation from immortal Turing software via finite thermodynamic survival bounds | Variables: E_reserve: internal metabolic reserve; P_diss: Landauer + structural maintenance dissipation; P_harvest: free-energy harvesting rate; T_surv: survival horizon" ;
    dct:source "Ororbia & Friston (2023/2024) arXiv:2311.09589; @drmichaellevin [uBzG8_HjbMY], [s7JTnNutgYs], [XFSPCLtqFYs]" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a2201fd3/models/2026-levin-channel-math-synthesis.py#L131-L134>,
        <https://github.com/fractastical/morpholib/blob/a2201fd3/morphoeval/lean/loops/Loop_levin_youtube_channel_math.lean#L233-L245> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def mortal_survival_horizon (e_reserve p_diss p_harvest : Nat) : Nat :=
  e_reserve / (p_diss - p_harvest)
theorem ororbia_friston_fields_mortal_computation_survival_law :
    mortal_survival_horizon 100 5 3 = 50 ∧
    mortal_survival_horizon 100 5 4 = 100 ∧ (100 : Nat) > 50 := by decide
"""^^pk:lean4 ;
    skos:notation "P_diss = İ_learn k_B T ln 2 + P_maint > P_harvest ⟹ T_surv = E_reserve / (P_diss - P_harvest) < ∞" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/s42003-025-08411-2>,
        <https://doi.org/10.1126/science.abc6182>,
        <https://doi.org/10.3389/fnsys.2022.768201>,

    skos:definition """def nernst_planck_scaled_flux (g_gj grad_ln_c z_dV : Int) : Int :=
  g_gj * (grad_ln_c + z_dV)
theorem pietak_levin_nernst_planck_boltzmann_invariant (g_gj dV : Int) :

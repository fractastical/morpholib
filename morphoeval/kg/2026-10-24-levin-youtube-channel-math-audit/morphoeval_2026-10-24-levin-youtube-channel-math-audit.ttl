    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def vfe_time_derivative (kappa grad_sq : Int) : Int := -(kappa * grad_sq)
theorem friston_pezzulo_vfe_lyapunov_descent_law :

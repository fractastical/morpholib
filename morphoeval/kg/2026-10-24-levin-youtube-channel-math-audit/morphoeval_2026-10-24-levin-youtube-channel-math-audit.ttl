    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Complete 25-Law Mathematical Atlas of Multiscale Bioelectricity, Low-Rattling, Epiplexity, Polycomputing, Natural Induction, Active Inference, Causal Emergence & Multicellular Evolution" ;

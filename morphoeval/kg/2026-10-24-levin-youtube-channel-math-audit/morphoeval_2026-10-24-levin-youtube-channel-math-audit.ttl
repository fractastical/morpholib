<https://w3id.org/delphi/resource/math-law/levin-youtube-channel-math-7> a skos:Concept,
        pk:Concept ;
    rdfs:label "Law 7: Tom Froese (2024, 2025) Irruption Theory & Euler 1/e Optimal-Stopping Law" ;
    dct:description "Quantifies the dimensionless 1/e exploration-to-commitment phase transition in physiological and agency dynamics | Variables: N: candidate horizon; k^*: optimal sample-to-commitment switch step; 1/e ≈ 0.3679: Euler dimensionless stopping constant" ;
    dct:source "Froese (2024) Entropy 26(4):288; @drmichaellevin [XA3DCTtRpDU], [F-pmWY4c4Dk]" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a2201fd3/models/2026-levin-channel-math-synthesis.py#L83-L88>,
        <https://github.com/fractastical/morpholib/blob/a2201fd3/morphoeval/lean/loops/Loop_levin_youtube_channel_math.lean#L113-L122> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def froese_stopping_bracket (k e_scaled N_scaled : Nat) : Bool :=
  decide (k * e_scaled ≤ N_scaled ∧ N_scaled < (k + 1) * e_scaled)
theorem froese_irruption_euler_optimal_stopping_law :
    froese_stopping_bracket 37 2718 100566 = true := by decide
"""^^pk:lean4 ;

        schema:value "0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-11-watson-szathmary-levin-natural-induction-single-epoch-hebbian-attractor-energy-descent-delta-e> a schema:PropertyValue,

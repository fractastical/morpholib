    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-1-tame-cognitive-light-cone-wild-type-coupled-goal-radius-r-eff-n-100-g-gj-1-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Law 1 (TAME Cognitive Light Cone) — Wild-Type Coupled Goal Radius R_eff (N=100, G_gj=1.0) = 91.0 cell_diameters" ;
        schema:measurementTechnique "R_eff(N, G_gj) = r_cell * [1 + (N-1)*G_gj/(G_gj + G_half)] at N=100, G_gj=1.0, G_half=0.1" ;
        schema:name "Law 1 (TAME Cognitive Light Cone) — Wild-Type Coupled Goal Radius R_eff (N=100, G_gj=1.0)" ;
        schema:unitText "cell_diameters" ;
        schema:value "91.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-1-tame-cognitive-light-cone-wild-type-coupled-goal-radius-r-eff-n-100-g-gj-1-0-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-1-tame-cognitive-light-cone-wild-type-coupled-goal-radius-r-eff-n-100-g-gj-1-0-reference> a schema:PropertyValue ;
        dcterms:source "Levin (2019) Front. Psychol. 10:2688 & Lean 4 Theorem 1 tame_cognitive_light_cone_scaling_and_cancer_collapse" ;
        schema:value "91.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-10-weber-koch-froese-hopfield-k-sat-satisfied-assignment-clause-penalty-energy-e-sat-s> a schema:PropertyValue,

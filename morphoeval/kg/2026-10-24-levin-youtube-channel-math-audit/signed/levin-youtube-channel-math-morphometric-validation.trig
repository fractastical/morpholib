    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-18-rosas-rajpal-o-information-synergy-3-bit-synergistic-xor-o-information-omega-xor-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Law 18 (Rosas-Rajpal O-Information Synergy) — 3-Bit Synergistic XOR O-Information Omega(XOR_3) = -1 bits" ;
        schema:measurementTechnique "Omega(X^3) = (3-2)*H(X^3) + sum_{i=1}^3 [H(X_i) - H(X_{-i})] = 2 + 3*(1 - 2) = -1 bit < 0" ;

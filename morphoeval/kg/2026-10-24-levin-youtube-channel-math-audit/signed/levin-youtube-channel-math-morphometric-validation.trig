    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-10-weber-koch-froese-hopfield-k-sat-satisfied-assignment-clause-penalty-energy-e-sat-s-reference> a schema:PropertyValue ;

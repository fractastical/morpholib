        schema:value "-12.8" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-measurement-law-12-pigozzi-biswas-levin-grn-conditioning-post-pairing-cs-us-regulatory-weight-j-us-cs-t-15> a schema:PropertyValue,

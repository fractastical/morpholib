sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-010> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-010-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-010-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) regeneration as a lawful growth process — Durbin/Ellis tadpole tail curves — Parameter expressivity: 40/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Fits expose k, L_inf, t0, n and beta but no panel sweeps a parameter across its regime (e.g. decay exponent n from 0.5 to 3, or amputation level R toward the 75 % critical point) to show monotone control of the output." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "thompson/claims/t1917-010_the-rate-of-growth.py L428–L442: analyse() runs single fits; no sweep over n, k or R <https://github.com/fractastical/morpholib/blob/7295001d7/thompson/claims/t1917-010_the-rate-of-growth.py#L428-L442>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-parameter-expressivity-1> ;
        pk:hasScore "0.4"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-010_the-rate-of-growth.py L239–L254" ;
        dct:description "isochrone slopes computed per q only" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7295001d7/thompson/claims/t1917-010_the-rate-of-growth.py#L239-L254> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval cloud loop 208, Pass 1 self-audit)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0001-9184-8944> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0000-0001-9184-8944>,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1002/jez.1400070302>,
            <https://doi.org/10.1002/jez.1400070303>,
            <https://doi.org/10.1098/rsbl.2019.0151> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form" .
    <https://doi.org/10.1002/jez.1400070302> dct:date "1909"^^xsd:gYear ;
        dct:title "An analysis of the rate of regeneration throughout the regenerative process" .
    <https://doi.org/10.1002/jez.1400070303> dct:date "1909"^^xsd:gYear ;
        dct:title "The relation of the amount of tail regenerated to the amount removed in tadpoles of Rana clamitans" .
    <https://doi.org/10.1098/rsbl.2019.0151> dct:date "2019"^^xsd:gYear ;
        dct:title "Tail loss and telomeres: consequences of large-scale tissue regeneration in a terrestrial ectotherm" .
}


}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-010> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-010-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-010-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) regeneration as a lawful growth process — Durbin/Ellis tadpole tail curves — Morphometric validation: 55/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Quantitative comparisons with the printed tables are made (r, RMSE, exponent, inflection day, plateau fraction) and exported by measure_morphoeval, but there is no negative/ablation control (e.g. permutation of amount-removed labels, constant-velocity null), no KS or coefficient-of-variation statistic, and no specimen-derived morphometric." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-010_the-rate-of-growth.py L445–L464: verdict() has no null-model comparison <https://github.com/fractastical/morpholib/blob/7295001d7/thompson/claims/t1917-010_the-rate-of-growth.py#L445-L464>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expii-exp-approach-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expii-hyperbolic-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expiv-gompertz-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expiv-inflection-day>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-velocity-exp-k>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-velocity-power-exponent>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-day9-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-isochrone-beta-mean>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-plateau-fraction-mean>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-plateau-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-morphometric-validation-2> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expii-exp-approach-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "durbin_expII_exp_approach_rmse = 0.089353 mm" ;
        schema:measurementTechnique "curve_fit L_inf(1-exp(-k(t-t0)))" ;
        schema:name "durbin_expII_exp_approach_rmse" ;
        schema:unitText "mm" ;
        schema:value "0.089353" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expii-hyperbolic-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "durbin_expII_hyperbolic_rmse = 0.460299 mm" ;
        schema:measurementTechnique "curve_fit L_inf - c/t" ;
        schema:name "durbin_expII_hyperbolic_rmse" ;
        schema:unitText "mm" ;
        schema:value "0.460299" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expiv-gompertz-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "durbin_expIV_gompertz_r = 0.996195 dimensionless" ;
        schema:measurementTechnique "Pearson r fitted vs observed" ;
        schema:name "durbin_expIV_gompertz_r" ;
        schema:unitText "dimensionless" ;
        schema:value "0.996195" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expiv-inflection-day> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "durbin_expIV_inflection_day = 6.349334 day" ;
        schema:measurementTechnique "Gompertz ln(b)/c (Thompson: ~7)" ;
        schema:name "durbin_expIV_inflection_day" ;
        schema:unitText "day" ;
        schema:value "6.349334" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-velocity-exp-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "durbin_velocity_exp_k = 0.100879 1/day" ;
        schema:measurementTechnique "OLS log V vs t" ;
        schema:name "durbin_velocity_exp_k" ;
        schema:unitText "1/day" ;
        schema:value "0.100879" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-velocity-power-exponent> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "durbin_velocity_power_exponent = 1.311573 dimensionless" ;
        schema:measurementTechnique "OLS log V vs log t (Thompson claims 2)" ;
        schema:name "durbin_velocity_power_exponent" ;
        schema:unitText "dimensionless" ;
        schema:value "1.311573" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-day9-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ellis_day9_pearson_r = 0.993038 dimensionless" ;
        schema:measurementTechnique "Pearson r, mm regenerated vs mm removed (n=4)" ;
        schema:name "ellis_day9_pearson_r" ;
        schema:unitText "dimensionless" ;
        schema:value "0.993038" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-isochrone-beta-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ellis_isochrone_beta_mean = 0.346577 dimensionless" ;
        schema:measurementTechnique "log-log slope of t_q vs R, q=10..40" ;
        schema:name "ellis_isochrone_beta_mean" ;
        schema:unitText "dimensionless" ;
        schema:value "0.346577" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-plateau-fraction-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ellis_plateau_fraction_mean = 0.46 fraction" ;
        schema:measurementTechnique "mean of 44,44,48,48 %" ;
        schema:name "ellis_plateau_fraction_mean" ;
        schema:unitText "fraction" ;
        schema:value "0.46" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-plateau-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ellis_plateau_pearson_r = 0.999738 dimensionless" ;
        schema:measurementTechnique "Pearson r at day 32" ;
        schema:name "ellis_plateau_pearson_r" ;
        schema:unitText "dimensionless" ;
        schema:value "0.999738" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-010_the-rate-of-growth.py L206–L223" ;
        dct:description "ellis_scaling: Pearson r, through-origin slope, plateau CV" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7295001d7/thompson/claims/t1917-010_the-rate-of-growth.py#L206-L223> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-010_the-rate-of-growth.py L510–L526" ;
        dct:description "measure_morphoeval exports 10 metrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7295001d7/thompson/claims/t1917-010_the-rate-of-growth.py#L510-L526> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval cloud loop 208, Pass 1 self-audit)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0001-9184-8944> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0000-0001-9184-8944>,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1002/jez.1400070302>,
            <https://doi.org/10.1002/jez.1400070303>,
            <https://doi.org/10.1098/rsbl.2019.0151> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form" .
    <https://doi.org/10.1002/jez.1400070302> dct:date "1909"^^xsd:gYear ;
        dct:title "An analysis of the rate of regeneration throughout the regenerative process" .
    <https://doi.org/10.1002/jez.1400070303> dct:date "1909"^^xsd:gYear ;
        dct:title "The relation of the amount of tail regenerated to the amount removed in tadpoles of Rana clamitans" .
    <https://doi.org/10.1098/rsbl.2019.0151> dct:date "2019"^^xsd:gYear ;
        dct:title "Tail loss and telomeres: consequences of large-scale tissue regeneration in a terrestrial ectotherm" .
}


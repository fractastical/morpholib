sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-010> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-010-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-010-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) regeneration as a lawful growth process — Durbin/Ellis tadpole tail curves — Code-to-model traceability: 74/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Each loader names the Thompson page and original Durbin/Ellis table; each law docstring cites the equation id and page; math_kg yaml links six laws to Lean declarations and the script. Panel titles cite figure numbers. No per-function mapping table in the README yet." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-code-traceability-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-010_the-rate-of-growth.py L82–L131" ;
        dct:description "loaders cite p. 139/141/144/148 tables" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7295001d7/thompson/claims/t1917-010_the-rate-of-growth.py#L82-L131> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/thompson1917-t1917-010.yaml L1–L80" ;
        dct:description "six equations with lean_decl/lean_theorem/code_locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7295001d7/morphoeval/math_kg_loops/thompson1917-t1917-010.yaml#L1-L80> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval cloud loop 208, Pass 1 self-audit)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0001-9184-8944> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0000-0001-9184-8944>,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1002/jez.1400070302>,
            <https://doi.org/10.1002/jez.1400070303>,
            <https://doi.org/10.1098/rsbl.2019.0151> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form" .
    <https://doi.org/10.1002/jez.1400070302> dct:date "1909"^^xsd:gYear ;
        dct:title "An analysis of the rate of regeneration throughout the regenerative process" .
    <https://doi.org/10.1002/jez.1400070303> dct:date "1909"^^xsd:gYear ;
        dct:title "The relation of the amount of tail regenerated to the amount removed in tadpoles of Rana clamitans" .
    <https://doi.org/10.1098/rsbl.2019.0151> dct:date "2019"^^xsd:gYear ;
        dct:title "Tail loss and telomeres: consequences of large-scale tissue regeneration in a terrestrial ectotherm" .
}


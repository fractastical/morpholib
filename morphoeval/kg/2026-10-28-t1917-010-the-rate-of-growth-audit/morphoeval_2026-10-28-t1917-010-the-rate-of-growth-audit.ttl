<https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-010-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Thompson (1917) regeneration as a lawful growth process — Durbin/Ellis tadpole tail curves — Model fidelity to source: 70/100" ;
    dct:date "2026-10-28"^^xsd:date ;
    dct:description "The exact laws Thompson states are implemented (E2 L_inf - c/t from V t^2 = const; E3 exponential approach from Fig. 37; E4 sigmoid; E5 L_n = p_n R; E6 cubic-parabola isochrones) and mirrored by 17 kernel-checked Lean theorems. The script does not yet fit the free-exponent power law to the integrated curve, so Thompson's n ~ 2 claim is only tested on the increment series." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "thompson/claims/t1917-010_the-rate-of-growth.py L175–L184: fit_growth_laws has no free-exponent generalised power law L_inf - c/t^(n-1) <https://github.com/fractastical/morpholib/blob/7295001d7/thompson/claims/t1917-010_the-rate-of-growth.py#L175-L184>" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-model-fidelity-3>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-model-fidelity-4> ;
    pk:hasScore 7e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-010-morphometric-validation> a pk:LLMClaimAssessment ;

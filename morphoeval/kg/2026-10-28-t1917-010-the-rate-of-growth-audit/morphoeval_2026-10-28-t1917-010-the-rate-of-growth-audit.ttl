<https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-010-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Thompson (1917) regeneration as a lawful growth process — Durbin/Ellis tadpole tail curves — Code-to-model traceability: 74/100" ;
    dct:date "2026-10-28"^^xsd:date ;
    dct:description "Each loader names the Thompson page and original Durbin/Ellis table; each law docstring cites the equation id and page; math_kg yaml links six laws to Lean declarations and the script. Panel titles cite figure numbers. No per-function mapping table in the README yet." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;

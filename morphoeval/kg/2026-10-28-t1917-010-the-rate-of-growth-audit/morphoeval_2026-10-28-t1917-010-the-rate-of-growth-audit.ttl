    pk:hasScore 4e-01 ;
    pk:hasVerdict "partially faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-010-repro-package> a pk:LLMClaimAssessment ;
    rdfs:label "Thompson (1917) regeneration as a lawful growth process — Durbin/Ellis tadpole tail curves — Reproducibility package: 52/100" ;

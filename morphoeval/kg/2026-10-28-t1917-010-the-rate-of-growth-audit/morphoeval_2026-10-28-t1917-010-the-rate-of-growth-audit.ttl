<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-010-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Regenerative velocity is the derivative of the growth curve (telescoping)" ;
    dct:description "Thompson p. 141-142: Fig. 36 'is simply the differential coefficient' of Fig. 35; checked on his interpolated Durbin table | Variables: L regenerated length (mm), V daily increment (mm/day), t days after amputation" ;
    dct:source "Thompson (1917) pp. 139-142, Figs. 35-36; Durbin (1909) Exp. II" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7295001d7/morphoeval/lean/loops/Thompson1917_T1917_010.lean>,
        <https://github.com/fractastical/morpholib/blob/7295001d7/thompson/claims/t1917-010_the-rate-of-growth.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "V(t) = L(t+1) - L(t);  sum_{t=3}^{29} V(t) = L(30) - L(3)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/jez.1400070302>,
        <https://doi.org/10.1002/jez.1400070303>,
        <https://doi.org/10.1098/rsbl.2019.0151> ;
    pk:hypothesisType "quantitative-empirical regenerative growth curves (Thompson 1917 Ch. III; Durbin 1909; Ellis 1909)" ;
    pk:leanDeclaration "MathOfBiology.Loop_208.durbinV" ;
    pk:leanTheorem "MathOfBiology.Loop_208.durbin_increments_telescope" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-010-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Thompson hyperbolic velocity gloss V t^2 = const" ;
    dct:description "Thompson's stated empirical law for the declining phase; the script fits n freely and compares with the log-linear alternative | Variables: c constant, t days, n = 2 claimed exponent" ;
    dct:source "Thompson (1917) p. 143 ('the velocity varies, or tends to vary, inversely as the square of the time')" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7295001d7/morphoeval/lean/loops/Thompson1917_T1917_010.lean>,
        <https://github.com/fractastical/morpholib/blob/7295001d7/thompson/claims/t1917-010_the-rate-of-growth.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "V(t) = c / t^2  =>  L(t) = L_inf - c / t" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/jez.1400070302>,
        <https://doi.org/10.1002/jez.1400070303>,
        <https://doi.org/10.1098/rsbl.2019.0151> ;
    pk:hypothesisType "quantitative-empirical regenerative growth curves (Thompson 1917 Ch. III; Durbin 1909; Ellis 1909)" ;
    pk:leanDeclaration "MathOfBiology.Loop_208.hyperbolicV" ;
    pk:leanTheorem "MathOfBiology.Loop_208.hyperbolic_velocity_antitone" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-010-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Log-linear (geometric) velocity decay and monomolecular approach" ;
    dct:description "Thompson Fig. 37: logs of velocities 'fall approximately into a straight line' against time; the script tests this against the t^-2 gloss | Variables: q = exp(-k) daily retention, V0 initial velocity, L_inf asymptote, t0 latent period" ;
    dct:source "Thompson (1917) pp. 142-143, Fig. 37" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7295001d7/morphoeval/lean/loops/Thompson1917_T1917_010.lean>,
        <https://github.com/fractastical/morpholib/blob/7295001d7/thompson/claims/t1917-010_the-rate-of-growth.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "V_{t+1} = q V_t, q < 1;  L_n = sum_k V_k;  L(t) = L_inf (1 - exp(-k (t - t0)))" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/jez.1400070302>,
        <https://doi.org/10.1002/jez.1400070303>,
        <https://doi.org/10.1098/rsbl.2019.0151> ;
    pk:hypothesisType "quantitative-empirical regenerative growth curves (Thompson 1917 Ch. III; Durbin 1909; Ellis 1909)" ;
    pk:leanDeclaration "MathOfBiology.Loop_208.decayV" ;
    pk:leanTheorem "MathOfBiology.Loop_208.decayV_antitone" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-010-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Ellis amount-removed scaling of the regenerate" ;
    dct:description "Core of claim T1917-010: the amount (and hence rate) regenerated is related to the amount removed; checked on Ellis series O-S at day 9 and the day-32 plateau | Variables: R amount removed (mm), p_n fraction of R restored after n days" ;
    dct:source "Thompson (1917) p. 148 table; Ellis (1909)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7295001d7/morphoeval/lean/loops/Thompson1917_T1917_010.lean>,
        <https://github.com/fractastical/morpholib/blob/7295001d7/thompson/claims/t1917-010_the-rate-of-growth.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "L_n(R) = p_n * R;  0 < p  and  R1 < R2  =>  L_n(R1) < L_n(R2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/jez.1400070302>,
        <https://doi.org/10.1002/jez.1400070303>,
        <https://doi.org/10.1098/rsbl.2019.0151> ;
    pk:hypothesisType "quantitative-empirical regenerative growth curves (Thompson 1917 Ch. III; Durbin 1909; Ellis 1909)" ;
    pk:leanDeclaration "MathOfBiology.Loop_208.regenerated" ;
    pk:leanTheorem "MathOfBiology.Loop_208.regenerated_strict_mono" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-010-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Fig. 40 cubic-parabola isochrones" ;
    dct:description "Thompson's constructed diagram: 'each curve approximates in form to a cubic parabola', starting from zero and diverging at 75 % | Variables: q per-cent of removed amount restored, R per-cent of tail removed, a shape constant, R_crit = 75 %" ;
    dct:source "Thompson (1917) pp. 147-149, Fig. 40" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7295001d7/morphoeval/lean/loops/Thompson1917_T1917_010.lean>,
        <https://github.com/fractastical/morpholib/blob/7295001d7/thompson/claims/t1917-010_the-rate-of-growth.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "R_q(t) = a t^3  (equivalently t_q(R) ~ R^(1/3));  t1 < t2 => R_q(t1) < R_q(t2);  R_q(0) = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/jez.1400070302>,
        <https://doi.org/10.1002/jez.1400070303>,
        <https://doi.org/10.1098/rsbl.2019.0151> ;
    pk:hypothesisType "quantitative-empirical regenerative growth curves (Thompson 1917 Ch. III; Durbin 1909; Ellis 1909)" ;
    pk:leanDeclaration "MathOfBiology.Loop_208.cubicIsochrone" ;
    pk:leanTheorem "MathOfBiology.Loop_208.cubic_isochrone_strict_mono" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-010-6> a skos:Concept,
        pk:Concept ;
    rdfs:label "Incomplete restoration plateau" ;
    dct:description "Thompson p. 146: 'regeneration tends to fall somewhat short of a complete restoration of the lost part' | Variables: p_inf day-32 plateau fraction" ;
    dct:source "Thompson (1917) p. 146, p. 148" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7295001d7/morphoeval/lean/loops/Thompson1917_T1917_010.lean>,
        <https://github.com/fractastical/morpholib/blob/7295001d7/thompson/claims/t1917-010_the-rate-of-growth.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "p_inf(R) < 1 for all series (44, 44, 48, 48 %)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/jez.1400070302>,
        <https://doi.org/10.1002/jez.1400070303>,
        <https://doi.org/10.1098/rsbl.2019.0151> ;
    pk:hypothesisType "quantitative-empirical regenerative growth curves (Thompson 1917 Ch. III; Durbin 1909; Ellis 1909)" ;
    pk:leanDeclaration "MathOfBiology.Loop_208.regenerated" ;
    pk:leanTheorem "MathOfBiology.Loop_208.ellis_restoration_incomplete" ;
    pk:leanVerified true .


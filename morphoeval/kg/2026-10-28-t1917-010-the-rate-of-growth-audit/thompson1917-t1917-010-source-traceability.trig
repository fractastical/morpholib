sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-010> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-010-source-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-010-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) regeneration as a lawful growth process — Durbin/Ellis tadpole tail curves — Source and data traceability: 78/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "IA scan identifier with page-offset rule, five vendored page scans with original download digests, OCR excerpt, Durbin/Ellis DOIs, Dryad DOI + mismatch rationale, iNaturalist observation URL and licence are all recorded; the Dryad CSV digest, however, is pinned on CRLF bytes that git normalises to LF, so the pin is not reproducible from a clone." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-010/dryad_n6n6495_fitzpatrick_et_al_data.csv L1–L38: CRLF file; committed blob is LF -> digest mismatch on fresh clone <https://github.com/fractastical/morpholib/blob/7295001d7/datasets/thompson_1917/t1917-010/dryad_n6n6495_fitzpatrick_et_al_data.csv#L1-L38>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-source-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-source-traceability-2> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-010/t1917_010_the_rate_of_growth_reference.json L60–L110" ;
        dct:description "sha256_digests, ia_scan.pages_vendored, pre_scouted_dataset mismatch" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7295001d7/datasets/thompson_1917/t1917-010/t1917_010_the_rate_of_growth_reference.json#L60-L110> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-010/scout_manifest.json L1–L60" ;
        dct:description "Dryad verification, DATASET_MISMATCH flags, OCR corrections" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7295001d7/datasets/thompson_1917/t1917-010/scout_manifest.json#L1-L60> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval cloud loop 208, Pass 1 self-audit)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0001-9184-8944> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0000-0001-9184-8944>,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1002/jez.1400070302>,
            <https://doi.org/10.1002/jez.1400070303>,
            <https://doi.org/10.1098/rsbl.2019.0151> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form" .
    <https://doi.org/10.1002/jez.1400070302> dct:date "1909"^^xsd:gYear ;
        dct:title "An analysis of the rate of regeneration throughout the regenerative process" .
    <https://doi.org/10.1002/jez.1400070303> dct:date "1909"^^xsd:gYear ;
        dct:title "The relation of the amount of tail regenerated to the amount removed in tadpoles of Rana clamitans" .
    <https://doi.org/10.1098/rsbl.2019.0151> dct:date "2019"^^xsd:gYear ;
        dct:title "Tail loss and telomeres: consequences of large-scale tissue regeneration in a terrestrial ectotherm" .
}


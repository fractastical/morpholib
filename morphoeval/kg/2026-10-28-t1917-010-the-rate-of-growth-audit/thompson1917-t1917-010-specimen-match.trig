sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-010> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-010-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-010-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) regeneration as a lawful growth process — Durbin/Ellis tadpole tail curves — Morphological realism / specimen match: 35/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "A CC-BY lateral photograph of Ellis's species is vendored and the p. 148 page scan is shown in the figure, but the specimen is never segmented or measured; no tail-fraction morphometric is compared with Thompson's 65 % (Ellis) / 62 % (Durbin) tail proportion, and the GIF tadpoles are schematic." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "thompson/claims/t1917-010_the-rate-of-growth.py L364–L369: page scan panel only; SPECIMEN constant unused <https://github.com/fractastical/morpholib/blob/7295001d7/thompson/claims/t1917-010_the-rate-of-growth.py#L364-L369>",
            "thompson/claims/t1917-010_the-rate-of-growth.py L375–L386: _tadpole_patch schematic ellipse + polygon, not specimen-derived <https://github.com/fractastical/morpholib/blob/7295001d7/thompson/claims/t1917-010_the-rate-of-growth.py#L375-L386>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-specimen-match-1> ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-010/lithobates_clamitans_tadpole_specimen.jpg (generated output)" ;
        dct:description "CC-BY iNaturalist L. clamitans tadpole vendored and pinned — datasets/thompson_1917/t1917-010/lithobates_clamitans_tadpole_specimen.jpg: rendered output of thompson/claims/t1917-010_the-rate-of-growth.py at 7295001d7, image/jpeg, 64739 B, 1024×683 px, artifact_sha256 4a90d205c4f3ec5e851b6c2157caac631c21b04e2629895bfe333f9fae880f38 (sha256 4a90d205c4f3ec5e851b6c2157caac631c21b04e2629895bfe333f9fae880f38), spec_fingerprint de10fcf1506d2328367848e4d263a6f76c4a536627abf0558ae32051c5aa7ba2" .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval cloud loop 208, Pass 1 self-audit)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0001-9184-8944> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0000-0001-9184-8944>,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1002/jez.1400070302>,
            <https://doi.org/10.1002/jez.1400070303>,
            <https://doi.org/10.1098/rsbl.2019.0151> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form" .
    <https://doi.org/10.1002/jez.1400070302> dct:date "1909"^^xsd:gYear ;
        dct:title "An analysis of the rate of regeneration throughout the regenerative process" .
    <https://doi.org/10.1002/jez.1400070303> dct:date "1909"^^xsd:gYear ;
        dct:title "The relation of the amount of tail regenerated to the amount removed in tadpoles of Rana clamitans" .
    <https://doi.org/10.1098/rsbl.2019.0151> dct:date "2019"^^xsd:gYear ;
        dct:title "Tail loss and telomeres: consequences of large-scale tissue regeneration in a terrestrial ectotherm" .
}


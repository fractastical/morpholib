sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-manukyan-ocellated-lizard-ca> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Manukyan et al. (2017) Nature hexagonal skin-scale border thickness reduction & outer-totalistic cellular automaton — Morphological realism / specimen match: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Loads and SHA-256-verifies `datasets/ocellated_lizard_ca/timon_lepidus_specimen.jpg`, applies Difference-of-Gaussians illumination normalization across the Dorsal Scale ROI `[120, 180, 320, 360]` (`segment_timon_lepidus_specimen`, L413-478), classifies N = 182 hexagonal dorsal scales into bimodal green (82, 45.1%) and black (100, 54.9%) states (Ashman D = 2.56), and demonstrates quantitative neighbor histogram agreement (modal n_g = 3, mean n_g = 2.60 vs 2.665 reference) in Panels E-H of `docs/media/ocellated_lizard_ca_comparison.png`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-specimen-match-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2015-manukyan-ocellated-lizard-ca.py L413–L478" ;
        dcterms:description "Dorsal hexagonal scale segmentation, bimodal Ashman D=2.56, and 6-neighbor degree histogram on Timon lepidus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2015-manukyan-ocellated-lizard-ca.py#L413-L478> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/ocellated_lizard_ca_comparison.png (generated output)" ;
        dcterms:description "8-panel synthesis figure comparing scale-border PDE, hexagonal CA, and segmented Timon lepidus dorsal scales — docs/media/ocellated_lizard_ca_comparison.png: rendered output of 2015-manukyan-ocellated-lizard-ca.py at 8871db0, image/png, 915314 B, 2080×1300 px, artifact_sha256 c2afeff3c91e36df7e5a89fcbb8a1ec5dd0965e6d94d90713a0b0ac3b744083a (sha256 c2afeff3c91e36df7e5a89fcbb8a1ec5dd0965e6d94d90713a0b0ac3b744083a), spec_fingerprint 579c243aacdd96a2cdfa88d08e4a41c235b758e31ce77e8b010879b96d081c5f" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 009 autonomous loop assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


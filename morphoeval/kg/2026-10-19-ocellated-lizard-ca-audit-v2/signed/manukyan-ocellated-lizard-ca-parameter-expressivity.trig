        rdfs:label "2015-manukyan-ocellated-lizard-ca.py L708–L725" ;
        dcterms:description "CLI parameters for P, d, lattice dimensions, steps, and seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2015-manukyan-ocellated-lizard-ca.py#L708-L725> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Manukyan et al. (2017) Nature hexagonal skin-scale border thickness reduction & outer-totalistic cellular automaton — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Sweeps all 5 scale-border thickness reduction regimes P in {0.0, 0.08, 0.17, 0.45, 1.0} (`run_border_reduction_sweep`, L358-388) spanning insulated decoupled scales through physiological Timon lepidus (P = 0.17) to unattenuated continuum skin (P = 1.0); executes formal negative controls (`run_negative_controls`, L391-409) at d = 1.0 (equal diffusion) and P = 1.0 (no scale border thinning); and exposes full CLI flags (`--P`, `--d`, `--rows`, `--cols`, `--steps`, `--seed`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

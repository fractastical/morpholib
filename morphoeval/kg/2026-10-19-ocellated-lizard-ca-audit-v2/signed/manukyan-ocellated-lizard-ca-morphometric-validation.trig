        schema:value "0.44" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-segmented-timon-lepidus-dorsal-green-scale-mean-green-neighbor-count-n-g> a schema:PropertyValue,

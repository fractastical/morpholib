    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2015-manukyan-ocellated-lizard-ca.py L605–L680" ;
        dcterms:description "8 reference-backed morphometric measurements across CA, scale-border PDE, controls, and Timon lepidus specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2015-manukyan-ocellated-lizard-ca.py#L605-L680> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Manukyan et al. (2017) Nature hexagonal skin-scale border thickness reduction & outer-totalistic cellular automaton — Morphometric validation: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L605-680) computes 8 reference-backed quantitative morphometrics covering CA adult green-scale mean neighbor count (<n_g> = 2.38, mode = 3), black-scale mean black neighbor count (<n_b> = 3.09, mode = 3), scale-border PDE discretization ratio (86.79 at P = 0.17 vs 0.38 at P = 1.0, 228x gain), PDE scale bimodality (Ashman D = 2.85), PDE-vs-CA neighbor histogram L1 distance (0.28, CA-to-reference Pearson r = 0.966), equal-diffusion negative control suppression (std = 0.0010), and segmented *Timon lepidus* dorsal scale green fraction (0.4505 vs 0.44 ref) and mean green neighbor count (2.5976 vs 2.665 ref)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-equal-diffusion-d-1-0-negative-control-scale-amplitude-suppression>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-hexagonal-ca-adult-black-scale-mean-black-neighbor-count-n-b>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-hexagonal-ca-adult-green-scale-mean-green-neighbor-count-n-g>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-scale-border-pde-p-0-17-inter-to-intra-scale-concentration-discretization-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-scale-border-pde-p-0-17-scale-color-bimodality-ashman-s-d>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-scale-border-pde-vs-outer-totalistic-ca-neighbor-histogram-l1-distance>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-segmented-timon-lepidus-dorsal-green-scale-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-segmented-timon-lepidus-dorsal-green-scale-mean-green-neighbor-count-n-g>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-morphometric-validation-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .


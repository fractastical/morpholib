    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-segmented-timon-lepidus-dorsal-green-scale-mean-green-neighbor-count-n-g-reference> a schema:PropertyValue ;
        dcterms:source "Manukyan et al. (2017) Nature 544:173-179 Fig. 3d empirical Timon lepidus neighbor histogram" ;

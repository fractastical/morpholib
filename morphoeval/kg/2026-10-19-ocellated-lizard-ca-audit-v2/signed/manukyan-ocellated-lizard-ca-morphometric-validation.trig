}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-manukyan-ocellated-lizard-ca> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-equal-diffusion-d-1-0-negative-control-scale-amplitude-suppression> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion (d=1.0) negative control scale amplitude suppression = 0.001 std(u_scale)" ;
        dcterms:description "positive d=20 std = 0.0380 vs equal-diffusion d=1 std = 1.00e-03" ;
        schema:measurementTechnique "Inter-scale activator std at d = Dv/Du = 1.0 (equal diffusion) vs positive Turing regime d = 20.0" ;
        schema:name "equal-diffusion (d=1.0) negative control scale amplitude suppression" ;
        schema:unitText "std(u_scale)" ;
        schema:value "0.001" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-equal-diffusion-d-1-0-negative-control-scale-amplitude-suppression-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-equal-diffusion-d-1-0-negative-control-scale-amplitude-suppression-reference> a schema:PropertyValue ;
        dcterms:source "Turing (1952) / Manukyan et al. (2017) Nature 544:173-179 Methods Eqs. (1)-(4)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-hexagonal-ca-adult-black-scale-mean-black-neighbor-count-n-b> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "hexagonal CA adult black-scale mean black neighbor count <n_b> = 3.0864 black neighbors (out of 6)" ;
        dcterms:description "modal n_b = 3, <n_g>_black = 2.9136" ;
        schema:measurementTechnique "Steady-state outer-totalistic hexagonal CA mean black neighbors (6 - n_g) around black scales" ;
        schema:name "hexagonal CA adult black-scale mean black neighbor count <n_b>" ;
        schema:unitText "black neighbors (out of 6)" ;
        schema:value "3.0864" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-hexagonal-ca-adult-black-scale-mean-black-neighbor-count-n-b-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-hexagonal-ca-adult-black-scale-mean-black-neighbor-count-n-b-reference> a schema:PropertyValue ;
        dcterms:source "Manukyan et al. (2017) Nature 544:173-179 Fig. 3e & Lean Theorem 1 hex_scale_neighbor_partition_and_symmetry" ;
        schema:value "3.272" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-hexagonal-ca-adult-green-scale-mean-green-neighbor-count-n-g> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "hexagonal CA adult green-scale mean green neighbor count <n_g> = 2.3806 green neighbors (out of 6)" ;
        dcterms:description "modal n_g = 3, L1 distance to Manukyan Fig. 3d histogram = 0.1728" ;
        schema:measurementTechnique "Steady-state outer-totalistic hexagonal CA mean green neighbors around green scales (36x36 lattice, step 45)" ;
        schema:name "hexagonal CA adult green-scale mean green neighbor count <n_g>" ;
        schema:unitText "green neighbors (out of 6)" ;
        schema:value "2.3806" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-hexagonal-ca-adult-green-scale-mean-green-neighbor-count-n-g-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-hexagonal-ca-adult-green-scale-mean-green-neighbor-count-n-g-reference> a schema:PropertyValue ;
        dcterms:source "Manukyan et al. (2017) Nature 544:173-179 Fig. 3d" ;
        schema:value "2.665" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-scale-border-pde-p-0-17-inter-to-intra-scale-concentration-discretization-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "scale-border PDE (P=0.17) inter-to-intra scale concentration discretization ratio = 92.4401 sigma_inter / sigma_intra" ;
        dcterms:description "P=0.17 discretization ratio = 92.440 vs continuum P=1.0 ratio = 0.382 (227.14x gain)" ;
        schema:measurementTechnique "Ratio of inter-scale activator std to mean intra-scale activator std at physiological border reduction P = 0.17" ;
        schema:name "scale-border PDE (P=0.17) inter-to-intra scale concentration discretization ratio" ;
        schema:unitText "sigma_inter / sigma_intra" ;
        schema:value "92.4401" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-scale-border-pde-p-0-17-inter-to-intra-scale-concentration-discretization-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-scale-border-pde-p-0-17-inter-to-intra-scale-concentration-discretization-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Manukyan et al. (2017) Nature 544:173-179 Fig. 4 & Fofonjka & Milinkovitch (2021) Nat. Commun. 12:2433" ;
        schema:value "3.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-scale-border-pde-p-0-17-scale-color-bimodality-ashman-s-d> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "scale-border PDE (P=0.17) scale color bimodality Ashman's D = 3.3577 Ashman D" ;
        dcterms:description "inter-scale std = 0.0448, intra-scale std = 0.0005" ;
        schema:measurementTechnique "sqrt(2)*|mu_green - mu_black| / sqrt(var_green + var_black) across 196 hexagonal scales at P = 0.17" ;
        schema:name "scale-border PDE (P=0.17) scale color bimodality Ashman's D" ;
        schema:unitText "Ashman D" ;
        schema:value "3.3577" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-scale-border-pde-p-0-17-scale-color-bimodality-ashman-s-d-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-scale-border-pde-p-0-17-scale-color-bimodality-ashman-s-d-reference> a schema:PropertyValue ;
        dcterms:source "Manukyan et al. (2017) Nature 544:173-179 Fig. 2 & Fig. 4 bimodal scale state criterion (D > 2.0)" ;
        schema:value "2.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-scale-border-pde-vs-outer-totalistic-ca-neighbor-histogram-l1-distance> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "scale-border PDE vs outer-totalistic CA neighbor histogram L1 distance = 0.523 L1 probability distance" ;
        dcterms:description "CA vs Manukyan reference histogram Pearson r = 0.9733 (p = 2.20e-04)" ;
        schema:measurementTechnique "sum(|P_PDE(n_g | S=1) - P_CA(n_g | S=1)|) for n_g in {0..6}" ;
        schema:name "scale-border PDE vs outer-totalistic CA neighbor histogram L1 distance" ;
        schema:unitText "L1 probability distance" ;
        schema:value "0.523" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-scale-border-pde-vs-outer-totalistic-ca-neighbor-histogram-l1-distance-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-scale-border-pde-vs-outer-totalistic-ca-neighbor-histogram-l1-distance-reference> a schema:PropertyValue ;
        dcterms:source "Manukyan et al. (2017) Nature 544:173-179 Figs. 3-4 PDE-to-CA mesoscopic reduction" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-segmented-timon-lepidus-dorsal-green-scale-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented Timon lepidus dorsal green-scale fraction = 0.4505 fraction of dorsal scales" ;
        dcterms:description "N = 182 segmented dorsal scales, bimodal Ashman D = 2.562" ;
        schema:measurementTechnique "Chromatic green-excess segmentation on datasets/ocellated_lizard_ca/timon_lepidus_specimen.jpg dorsal ROI [120, 180, 320, 360]" ;
        schema:name "segmented Timon lepidus dorsal green-scale fraction" ;
        schema:unitText "fraction of dorsal scales" ;
        schema:value "0.4505" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-segmented-timon-lepidus-dorsal-green-scale-fraction-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-segmented-timon-lepidus-dorsal-green-scale-fraction-reference> a schema:PropertyValue ;

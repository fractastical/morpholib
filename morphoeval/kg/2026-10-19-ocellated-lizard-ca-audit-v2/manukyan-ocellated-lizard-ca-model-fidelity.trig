sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-manukyan-ocellated-lizard-ca> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Manukyan et al. (2017) Nature hexagonal skin-scale border thickness reduction & outer-totalistic cellular automaton — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Integrates the continuous 2D reaction-diffusion PDE on a Voronoi hexagonal skin-scale mosaic with spatially modulated border diffusivity D_border = P * D_interior (`build_hexagonal_scale_geometry` and `integrate_scale_border_pde_2d`, L215-355), demonstrating how P = 0.17 homogenizes intra-scale concentrations (discretization ratio 86.79, Ashman D = 2.85) so the PDE reduces to the hexagonal outer-totalistic CA (`simulate_hexagonal_ca`, L164-210) peaking at n_g = 3; and backs all 3 laws with machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2015-manukyan-ocellated-lizard-ca.py L215–L355" ;
        dct:description "Continuous 2D reaction-diffusion PDE on hexagonal skin-scale mosaic with border thickness reduction P=0.17" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2015-manukyan-ocellated-lizard-ca.py#L215-L355> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2015-manukyan-ocellated-lizard-ca.py L99–L210" ;
        dct:description "Hexagonal outer-totalistic CA solver and neighbor histogram convergence at n_g=3" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2015-manukyan-ocellated-lizard-ca.py#L99-L210> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean L1–L108" ;
        dct:description "3 machine-checked Lean 4 theorems (0 sorrys) for 6-neighbor partition, border flux reduction, and n_g=3 labyrinth fixed point" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean#L1-L108> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 009 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


            <https://doi.org/10.1103/PhysRevX.13.041011> .
    <https://doi.org/10.1038/376765a0> dct:date "1995"^^xsd:gYear ;
        dct:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .
    <https://doi.org/10.1038/nature22031> dct:date "2017"^^xsd:gYear ;
        dct:title "A living mesoscopic cellular automaton made of skin scales" .
    <https://doi.org/10.1038/s41467-021-22525-1> dct:date "2021"^^xsd:gYear ;
        dct:title "Reaction-diffusion in a growing 3D domain of skin scales generates a discrete cellular automaton" .
    <https://doi.org/10.1103/PhysRevX.13.041011> dct:date "2023"^^xsd:gYear ;
        dct:title "Simple Reaction-Diffusion Modeling Predicts Inconspicuous Neighborhood-Dependent Color Subclustering of Lizard Scales" .
}


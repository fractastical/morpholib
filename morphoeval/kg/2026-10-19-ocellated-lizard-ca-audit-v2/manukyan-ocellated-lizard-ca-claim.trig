sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-manukyan-ocellated-lizard-ca> a pk:Claim ;
        rdfs:label "Manukyan et al. (2017) Nature hexagonal skin-scale border thickness reduction & outer-totalistic cellular automaton faithfully reproduces Ocellated / jeweled lizard (Timon lepidus) dorsal skin scale labyrinth morphology" ;
        dct:description "The simulation script(s) 2015-manukyan-ocellated-lizard-ca.py implement the cited source model as published and produce forms that match real Ocellated / jeweled lizard (Timon lepidus) dorsal skin scale labyrinth specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 91.8/100, audit 2026-10-19-ocellated-lizard-ca-audit-v2) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/2015-manukyan-ocellated-lizard-ca.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2015-manukyan-ocellated-lizard-ca.py; output: docs/media/ocellated_lizard_ca_comparison.png; organism: Ocellated / jeweled lizard (Timon lepidus) dorsal skin scale labyrinth; checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 579c243aacdd96a2cdfa88d08e4a41c235b758e31ce77e8b010879b96d081c5f; artifact_sha256: c2afeff3c91e36df7e5a89fcbb8a1ec5dd0965e6d94d90713a0b0ac3b744083a; input_dataset_sha256: {datasets/ocellated_lizard_ca/ocellated_lizard_ca_reference.json=53832b76e25303a6..., datasets/ocellated_lizard_ca/scout_manifest.json=e5bca2d8766b49e7..., datasets/ocellated_lizard_ca/timon_lepidus_specimen.jpg=bc8e149849e6729d...}; supersedes_audit_id: 2026-10-19-ocellated-lizard-ca-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/nature22031>,
            <https://doi.org/10.1038/s41467-021-22525-1>,
            <https://doi.org/10.1103/PhysRevX.13.041011> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-specimen-match> ;
        pk:weightOfEvidence "0.918"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/8871db0/2015-manukyan-ocellated-lizard-ca.py> a schema:SoftwareSourceCode ;
        rdfs:label "2015-manukyan-ocellated-lizard-ca.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "8871db0" .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Ambystoma mexicanum Schnakenberg onset wavelength at 184.3 µm (Pass 1) — Morphometric validation: 80/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Fine-grid versus coarse-grid wavelengths give Pearson r = 1.0 and RMSE 3.39 µm, so the correlation saturated even though the residual did not. Linear fastest wavelength 187.19 µm against the 184.3 µm onset coordinate. Specimen dark fraction 0.380 versus model 0.328, luminance KS 0.271, radial-spectrum r 0.833. None of the specimen numbers is copied onto its reference. The photograph is not assigned a false micrometre scale." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-ablation-max-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-ks-statistic-luminance>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-linear-fastest-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-model-spot-area-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-pearson-r-wavelength-sweep>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-radial-spectrum-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-residual-cv-wavelength-sweep>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-rmse-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-specimen-chromatophore-dark-area-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-turing-max-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-ablation-max-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_max_growth_rate = -0.100003 1/time" ;
        dct:description "null diffusion-ratio control versus the ratio-9 regime" ;
        schema:measurementTechnique "negative control: max σ(k) when Dv = Du (ratio 1, below r_c)" ;
        schema:name "ablation_max_growth_rate" ;
        schema:unitText "1/time" ;
        schema:value "-0.100003" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-ablation-max-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-ablation-max-growth-rate-reference> a schema:PropertyValue ;
        dct:source "Turing threshold; ablation must stay negative" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-ks-statistic-luminance> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ks_statistic_luminance = 0.271 1" ;
        dct:description "ks p=1.343e-129" ;
        schema:measurementTechnique "two-sample KS statistic of field-stop luminance, specimen versus simulation; p-value stored in metrics" ;
        schema:name "ks_statistic_luminance" ;
        schema:unitText "1" ;
        schema:value "0.271" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-ks-statistic-luminance-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-ks-statistic-luminance-reference> a schema:PropertyValue ;
        dct:source "KS = 0 would mean identical luminance distributions" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-linear-fastest-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "linear_fastest_wavelength_um = 187.192853 µm" ;
        dct:description "near-threshold shift of the fastest mode away from the exact onset k_c" ;
        schema:measurementTechnique "argmax_k σ(k) at Dv/Du = 9 with Du fixed by the onset formula" ;
        schema:name "linear_fastest_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "187.192853" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-linear-fastest-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-linear-fastest-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "Delphi scale coordinate 0.0001843 m; not a scale-bar reading" ;
        schema:value "184.3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-model-spot-area-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "model_spot_area_fraction = 0.328452 1" ;
        dct:description "non-circular: simulation fraction versus specimen fraction" ;
        schema:measurementTechnique "same dark-phase quantile applied to the rendered simulation, not to the photograph" ;
        schema:name "model_spot_area_fraction" ;
        schema:unitText "1" ;
        schema:value "0.328452" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-model-spot-area-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-model-spot-area-fraction-reference> a schema:PropertyValue ;
        dct:source "specimen melanophore area fraction" ;
        schema:value "0.379717" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nonlinear_dominant_wavelength_um = 184.3 µm" ;
        dct:description "nonlinear shell need not sit on the linear onset mode" ;
        schema:measurementTechnique "Fourier shell of the saturated activator on the periodic patch" ;
        schema:name "nonlinear_dominant_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "184.3" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "onset wavelength 184.3 µm" ;
        schema:value "184.3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-pearson-r-wavelength-sweep> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pearson_r_wavelength_sweep = 1.0 1" ;
        dct:description "RMSE and residual CV are reported separately; value is not equal to the reference" ;
        schema:measurementTechnique "Pearson r between fine-grid and coarse-grid fastest wavelengths across 12 diffusivity scales" ;
        schema:name "pearson_r_wavelength_sweep" ;
        schema:unitText "1" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-pearson-r-wavelength-sweep-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-pearson-r-wavelength-sweep-reference> a schema:PropertyValue ;
        dct:source "identity of σ(k) under grid refinement; 1 is the continuum limit, not the measured value" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-radial-spectrum-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "radial_spectrum_pearson_r = 0.832747 1" ;
        dct:description "specimen-match spectrum; not a self-comparison" ;
        schema:measurementTechnique "Pearson r of 22-bin log radial FFT profiles, specimen micrograph versus rendered field" ;
        schema:name "radial_spectrum_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.832747" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-radial-spectrum-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-radial-spectrum-pearson-r-reference> a schema:PropertyValue ;
        dct:source "r = 1 would be a copy of the specimen spectrum" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-residual-cv-wavelength-sweep> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "residual_cv_wavelength_sweep = 0.004521 1" ;
        schema:measurementTechnique "CV of (λ_coarse − λ_fine) relative to mean |λ_fine|" ;
        schema:name "residual_cv_wavelength_sweep" ;
        schema:unitText "1" ;
        schema:value "0.004521" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-residual-cv-wavelength-sweep-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-residual-cv-wavelength-sweep-reference> a schema:PropertyValue ;
        dct:source "coefficient of variation of the sweep residual" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-rmse-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "rmse_wavelength_um = 3.391498 µm" ;
        dct:description "dispersion sweep uncertainty" ;
        schema:measurementTechnique "RMSE of coarse-grid λ against the fine-grid dispersion peak" ;
        schema:name "rmse_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "3.391498" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-rmse-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-rmse-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "zero residual would be a perfect grid match" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-specimen-chromatophore-dark-area-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_chromatophore_dark_area_fraction = 0.379717 1" ;
        dct:description "specimen segmentation; value is not the model fraction" ;
        schema:measurementTechnique "quantile segmentation of dark melanophore pixels inside the micrograph field stop" ;
        schema:name "specimen_chromatophore_dark_area_fraction" ;
        schema:unitText "1" ;
        schema:value "0.379717" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-measurement-specimen-chromatophore-dark-area-fraction-reference> .

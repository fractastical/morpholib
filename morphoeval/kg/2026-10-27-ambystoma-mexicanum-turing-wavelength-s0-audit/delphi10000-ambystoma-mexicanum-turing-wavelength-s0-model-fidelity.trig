sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Ambystoma mexicanum Schnakenberg onset wavelength at 184.3 µm (Pass 1) — Model fidelity to source: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The script integrates Schnakenberg kinetics with the Jacobian and the onset-wavenumber formula, holds the uniform state stable without diffusion (trace −0.2, det 1), and places Dv/Du = 9 just above the critical ratio. The saturated shell sits on 184.3 µm largely because the initial condition is that Fourier mode, so free wavelength selection is only partly tested. The dispersion curve's real-part branch has a sharp corner near k ≈ 0.02 µm⁻¹." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ambystoma-mexicanum-turing-wavelength-s0.py L94–L165" ;
        dct:description "steady state, Jacobian, critical ratio, onset diffusivities, σ(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4f21c452569eeb68e67f8158dd98be18f84832f2/models/2026-delphi10000-ambystoma-mexicanum-turing-wavelength-s0.py#L94-L165> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambystoma-mexicanum-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ambystoma-mexicanum-turing-wavelength-s0.py L213–L263" ;
        dct:description "spectral integrator seeded with cos(k_c x)+cos(k_c y)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4f21c452569eeb68e67f8158dd98be18f84832f2/models/2026-delphi10000-ambystoma-mexicanum-turing-wavelength-s0.py#L213-L263> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second provider on this pass)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


    <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Richman et al. (1975) & Tallinen et al. (2014, 2016) neo-Hookean constrained cortical expansion and sulcal creasing instability — Morphological realism / specimen match: 35/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Although `datasets/cortical_gyrification_folding/cerebral_cortex_gyri_specimen.jpg` is vendored on disk, the v1 script never loads, segments, or displays the coronal brain specimen image, and compares only against human fetal GW22-GW38 tabular numbers without the 11-species mammalian dataset." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1975-richman-cortical-gyrification-buckling.py L69–L94: Evaluates only human fetal GW22-GW38 stages without loading cerebral_cortex_gyri_specimen.jpg <https://github.com/fractastical/morpholib/blob/8871db0/1975-richman-cortical-gyrification-buckling.py#L69-L94>",
            "docs/media/cortical_gyrification_folding_comparison.png (generated output, not in repo): 4-panel v1 plot lacks coronal brain specimen segmentation and 11-species mammalian collapse — docs/media/cortical_gyrification_folding_comparison.png: rendered output of 1975-richman-cortical-gyrification-buckling.py at 8871db0, image/png, 141810 B, 1430×1105 px, artifact_sha256 a3439bd2af0d39888b7d97818bb3c6df90fc06cc8c5b30aa22d7cd40325ecd31 (sha256 a3439bd2af0d39888b7d97818bb3c6df90fc06cc8c5b30aa22d7cd40325ecd31), spec_fingerprint b7b9a6e07287630e2e4e6277f4842e9ba61e2c8da24f1f7145e6787809fe3f06" ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

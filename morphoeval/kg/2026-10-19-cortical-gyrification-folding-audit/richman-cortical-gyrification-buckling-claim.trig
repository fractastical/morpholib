sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-richman-cortical-gyrification-buckling> a pk:Claim ;
        rdfs:label "Richman et al. (1975) & Tallinen et al. (2014, 2016) neo-Hookean constrained cortical expansion and sulcal creasing instability faithfully reproduces Mammalian cerebral cortex & subcortical white matter (Homo sapiens, Pan troglodytes, Macaca mulatta, Tursiops truncatus, Felis catus, Mus musculus) morphology" ;
        dct:description "The simulation script(s) 1975-richman-cortical-gyrification-buckling.py implement the cited source model as published and produce forms that match real Mammalian cerebral cortex & subcortical white matter (Homo sapiens, Pan troglodytes, Macaca mulatta, Tursiops truncatus, Felis catus, Mus musculus) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 54.4/100, audit 2026-10-19-cortical-gyrification-folding-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/1975-richman-cortical-gyrification-buckling.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/1975-richman-cortical-gyrification-buckling.py; output: docs/media/cortical_gyrification_folding_comparison.png; organism: Mammalian cerebral cortex & subcortical white matter (Homo sapiens, Pan troglodytes, Macaca mulatta, Tursiops truncatus, Felis catus, Mus musculus); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: b7b9a6e07287630e2e4e6277f4842e9ba61e2c8da24f1f7145e6787809fe3f06; artifact_sha256: a3439bd2af0d39888b7d97818bb3c6df90fc06cc8c5b30aa22d7cd40325ecd31; input_dataset_sha256: {datasets/cortical_gyrification_folding/cerebral_cortex_gyri_specimen.jpg=ff9a25e993fd5aad..., datasets/cortical_gyrification_folding/cortical_gyrification_folding_reference.json=cee775390f805000..., datasets/cortical_gyrification_folding/paper_citations.bib=56bc1d0beedebe37..., datasets/cortical_gyrification_folding/scout_manifest.json=7f5410ff8ad2c1ee...}" ;
        pk:derivedFromPaper <https://doi.org/10.1038/nphys3632>,
            <https://doi.org/10.1073/pnas.1406015111>,
            <https://doi.org/10.1126/science.1145181>,
            <https://doi.org/10.1126/science.aaa9101> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-specimen-match> ;
        pk:weightOfEvidence "0.544"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/8871db0/1975-richman-cortical-gyrification-buckling.py> a schema:SoftwareSourceCode ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "8871db0" .
}


        <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-cortical-gyrification-folding-audit-richman-cortical-gyrification-buckling-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-cortical-gyrification-folding-audit-richman-cortical-gyrification-buckling-2>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-cortical-gyrification-folding-audit-richman-cortical-gyrification-buckling-3> ;
    pk:hypothesisType "Neo-Hookean Multiplicative Cortical Growth & Elastic Subcortical Buckling / Sulcal Creasing" ;

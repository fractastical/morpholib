sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-farhadifar-drosophila-wing-vertex-model> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model, Lewis's law packing & PCP (Fz/Stbm) hinge-contraction vertex dynamics — Reproducibility package: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Deterministic seeds (2007 for Section 2, 2007 + 43 for Section 2b), `--self-test` passes 14 checks in ~6 s including the SHA-256 gate, a central-difference check of the analytic vertex forces, PCP tensor identities, T1 bookkeeping and two-run bitwise determinism of the vertex model (L1848-1973); the default render takes ~17 s and regenerates both artifacts; all CLI flags are documented in argparse. Deductions: no requirements lock file in this slot (environment recorded only in this audit) (-4); the self-test and measurements re-run the vertex model with different step counts (500 vs 900), so the measured values are not the self-tested ones (-3); matplotlib emits a cache-directory warning unless MPLCONFIGDIR is set, which the invocation notes do not mention (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-repro-package-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L1897–L1973" ;
        dct:description "Pass 3 self-test checks 9-14: mesh 3-valence/CCW, finite-difference force check, PCP tensor identities, hinge/PCP monotonicity, T1 bookkeeping, determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L1897-L1973> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L1976–L2057" ;
        dct:description "argparse CLI with --lambda-bar, --gamma-bar, --steps, --seed, --pcp-epsilon, --hinge-strain, --self-test" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L1976-L2057> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 builder + primary re-assessor, autonomous loop slot-043)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


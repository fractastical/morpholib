sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-farhadifar-drosophila-wing-vertex-model> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model, Lewis's law packing & PCP (Fz/Stbm) hinge-contraction vertex dynamics — Parameter expressivity: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Pass 3 adds a 6-point eps_pcp sweep (-0.6 .. 0.8, L1026-1061, panel C5) that is monotonic in T1 count (5 -> 29), rearrangement share (0.06 -> 0.43), residual elongation (0.295 -> 0.166) and bond-tension anisotropy (0.31 -> 4.1), with eps_pcp = 0 as the loss-of-function control; `--pcp-epsilon` and `--hinge-strain` are wired through the CLI (L2004-2015, L2027-2034) and the hinge strain controls the elongation peak (0.13 at gamma = 0, 0.31 at gamma = 0.5 in the Pass 3 diagnostics). The Pass 2 7-point Lambda_bar sweep and (Lambda_bar, Gamma_bar) phase map are retained. Deductions: hinge strain is swept only in the development notes, not rendered (-4); k_fb, k_flow and the initial polarity spread are not exposed on the CLI (-3); the P(6) response to eps_pcp is monotonic but in the biologically wrong direction, so the parameter controls the feature without matching its sign (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-parameter-expressivity-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L1026–L1061" ;
        dct:description "run_pcp_epsilon_sweep over eps_pcp in {-0.6,-0.3,0,0.3,0.5,0.8}: P6, peak/final elongation, T1 count, oriented fraction, anisotropy, rearrangement share" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L1026-L1061> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L2004–L2034" ;
        dct:description "--pcp-epsilon and --hinge-strain CLI flags passed into run_all_regimes_and_render" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L2004-L2034> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L1585–L1606" ;
        dct:description "Panel C5 plots the sweep with the Classen (2005) WT / PCP-mutant P(6) reference lines" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L1585-L1606> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 builder + primary re-assessor, autonomous loop slot-043)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


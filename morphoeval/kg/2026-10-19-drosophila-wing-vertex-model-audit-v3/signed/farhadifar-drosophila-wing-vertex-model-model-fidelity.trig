sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-farhadifar-drosophila-wing-vertex-model> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model, Lewis's law packing & PCP (Fz/Stbm) hinge-contraction vertex dynamics — Model fidelity to source: 85/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: Farhadifar Eq. 1-2 single-cell energy and the Case I/II/III ground-state classifier (L120-202), the ablation recoil model (L205-234), and in Pass 3 a true vertex model — mesh built from the Voronoi tessellation with CCW rings and 3-valent interior vertices (L533-567), per-bond Fz/Stbm asymmetry tensor c_ab/a_ab = n.Q_ab.n (L617-647), analytic forces dA/dr, dL/dr, dl/dr with half-shared bond tension (L650-692) that pass a central-difference check to 1e-5 (self-test 10, L1912-1927), T1 exchange with 4-cell re-wiring (L723-771), hinge-contraction pure shear and polarity dynamics (L846-935). Deductions: panels A1-A4 and measurements 1-7 still come from the Section 2 Voronoi-seed Lloyd relaxation, whose Lewis's-law agreement is produced by an explicit post-hoc reweighting `adjusted_areas = areas * (1 + 0.14 * gamma_slope_boost * (n - 6))` (L401-405) and whose pupal regime is pulled toward the perfect lattice by `0.042 * hex_disp` (L378-379) — neither is in Farhadifar et al. (2007) (-8); the explicit vertex model is a clamped non-periodic patch, so boundary cells are prescribed rather than mechanically coupled, and the PCP coupling sign, k_fb, k_flow and the |Q|/0.15 saturation (L931) are uncited modelling choices (-5); polarity is polar but the tension law is nematic, so Fz-distal vs Stbm-proximal identity does not enter the mechanics beyond the bridge density (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2007-farhadifar-drosophila-wing-vertex-model.py L378–L379: Pupal regime adds 0.042 * displacement toward the perfect hexagonal lattice (seeds_hex) — hexagonal order is partly imposed <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L378-L379>",
            "2007-farhadifar-drosophila-wing-vertex-model.py L401–L405: Post-hoc area reweighting by (n - 6) in the Section 2 regimes imposes Lewis's law rather than deriving it from the energy <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L401-L405>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity-4> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L617–L692" ;
        dcterms:description "pcp_bond_asymmetry (c_ab, a_ab = 2c_ab - 1, outward normals) and vertex_forces_and_energy with analytic dA/dr, dL/dr, dl/dr of Farhadifar Eq. 1 and half-shared per-bond tension" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L617-L692> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L723–L771" ;
        dcterms:description "_attempt_t1: interior-bond T1 with A/B losing and C/D gaining the bond, 3-valence preserved, CCW re-sort of the four affected rings" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L723-L771> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L774–L1023" ;
        dcterms:description "simulate_pcp_hinge_contraction: pre-relaxation, smoothstep hinge ramp diag(lambda,1/lambda) on boundary vertices, overdamped vertex update, T1 pass, Fz-Stbm feedback + flow alignment polarity ODE, shear decomposition" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L774-L1023> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_043_drosophila_wing_vertex_model.lean L126–L215" ;
        dcterms:description "Theorems 5-6: PCP bond tensor traceless + perpendicular cancellation + tension ordering; shear-decomposition closure and area-preserving pure shear (lean exit 0, 0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/morphoeval/lean/loops/Loop_043_drosophila_wing_vertex_model.lean#L126-L215> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 builder + primary re-assessor, autonomous loop slot-043)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


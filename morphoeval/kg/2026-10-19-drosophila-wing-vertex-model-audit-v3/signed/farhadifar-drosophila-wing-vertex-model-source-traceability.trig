sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-farhadifar-drosophila-wing-vertex-model> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model, Lewis's law packing & PCP (Fz/Stbm) hinge-contraction vertex dynamics — Source and data traceability: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The five Pass 2 DOIs are retained; the dataset README, bib and JSON gain Aigouy (2010), Etournay (2015) and Sugimura & Ishihara (2013) with explicit \"recorded offline, not re-verified online\" flags (README L29-39, bib L55-91, JSON L32-52); the specimen SHA-256 is unchanged and verified fail-closed at runtime (L96-115); the JSON records the exact PCP model statement and defaults (L192-215). Deductions: three DOIs could not be resolved in this pass (-5); the numeric Pass 3 reference values are unlocated beyond figure-level loci and carry no digitisation (-5); the specimen's species is recorded inconsistently (\"Mus musculus\" in the scout manifest, unspecified in the JSON, \"Drosophila wing\" in the file name) (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-source-traceability-4> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "datasets/drosophila_wing_vertex_model/drosophila_wing_vertex_model_reference.json L32–L52" ;
        dcterms:description "Three Pass 3 sources with DOIs and doi_verification = 'recorded offline ... not resolved online'" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/datasets/drosophila_wing_vertex_model/drosophila_wing_vertex_model_reference.json#L32-L52> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/drosophila_wing_vertex_model/README.md L29–L39" ;
        dcterms:description "Pass 3 section: reference table with verification status and provisional-value caveat" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/datasets/drosophila_wing_vertex_model/README.md#L29-L39> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L96–L113" ;
        dcterms:description "verify_reference_dataset: SHA-256 of the specimen checked against both the hard-coded digest and the JSON" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L96-L113> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/drosophila_wing_vertex_model/paper_citations.bib L55–L91" ;
        dcterms:description "aigouy2010cellflow, etournay2015interplay, sugimura2013anisotropy entries with 'DOI unverified offline' notes" ;

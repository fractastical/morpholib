sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-farhadifar-drosophila-wing-vertex-model> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model, Lewis's law packing & PCP (Fz/Stbm) hinge-contraction vertex dynamics — Morphometric validation: 84/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` now returns 14 measurements with units and reference values (L1723-1845): the 8 Pass 2 metrics are unchanged (wing P(6) = 0.440 vs 0.455, pupal 0.840 vs 0.78, Lewis r = 0.9994, specimen r = 0.9913, recoil v0 = 0.22 um/s) and 6 Pass 3 metrics are added — elongation peak <|Q|> = 0.253 vs ~0.25, rearrangement share 0.307 vs ~0.5, oriented-T1 fraction 1.00 vs the 0.5 isotropic null, WT - mutant P(6) delta = -0.133 vs +0.18, PCP nematic order 0.955 vs 0.9, bond-tensor isotropic residual c0 = -0.025 vs 0. Deductions: four of the six new references are approximate figure reads recorded offline (flagged in the JSON `provenance` fields) rather than digitised values (-6); the Classen (2005) comparison fails in sign and is reported, not resolved (-5); the oriented-T1 reference is a null model rather than a measured Aigouy/Etournay orientation distribution (-2); the Lewis's-law r = 0.9994 of measurement 5 is inflated by the L401-405 reweighting (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2007-farhadifar-drosophila-wing-vertex-model.py L1765–L1771: pcp_wt_minus_mutant_hexagonal_fraction_delta = -0.133 against reference +0.18: sign mismatch with Classen et al. (2005) <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L1765-L1771>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-euler-mean-polygon-side-number>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-laser-ablation-initial-recoil-velocity>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-lewis-law-area-topology-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pcp-bond-tensor-isotropic-residual>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pcp-hinge-cell-elongation-peak-q>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pcp-hinge-rearrangement-shear-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pcp-nematic-order-parameter-final>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pcp-oriented-t1-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pcp-wt-minus-mutant-hexagonal-fraction-delta>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pupal-vs-larval-topological-disorder-ratio-mu2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pupal-wing-annealed-hexagonal-fraction-p6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-specimen-segmented-polygon-distribution-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-wing-disc-polygon-distribution-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-wing-disc-proliferating-hexagonal-fraction-p6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-morphometric-validation-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-euler-mean-polygon-side-number> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "euler_mean_polygon_side_number = 5.96 sides" ;
        schema:measurementTechnique "Mean polygon side number <n> across periodic 3-valent epithelial tessellation (Euler 3-valent theorem 2E/F = 6)" ;
        schema:name "euler_mean_polygon_side_number" ;
        schema:unitText "sides" ;
        schema:value "5.96" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-euler-mean-polygon-side-number-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-euler-mean-polygon-side-number-reference> a schema:PropertyValue ;
        schema:value "6.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-laser-ablation-initial-recoil-velocity> a schema:PropertyValue,

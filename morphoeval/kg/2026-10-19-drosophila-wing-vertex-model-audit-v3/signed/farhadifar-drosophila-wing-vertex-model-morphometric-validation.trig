        schema:name "pcp_nematic_order_parameter_final" ;
        schema:unitText "order_parameter" ;
        schema:value "0.9545" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pcp-nematic-order-parameter-final-reference> .


        rdfs:label "laser_ablation_initial_recoil_velocity = 0.22 um_per_s" ;
        schema:measurementTechnique "Initial adherens-junction UV laser ablation recoil velocity v_0 at canonical wing disc parameters (Lambda_bar=0.12, Gamma_bar=0.04; Farhadifar et al. 2007 Fig. 4E)" ;
        schema:name "laser_ablation_initial_recoil_velocity" ;
        schema:unitText "um_per_s" ;
        schema:value "0.22" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-laser-ablation-initial-recoil-velocity-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-laser-ablation-initial-recoil-velocity-reference> a schema:PropertyValue ;
        schema:value "0.22" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-lewis-law-area-topology-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "lewis_law_area_topology_pearson_r = 0.9994 r" ;
        schema:measurementTechnique "Pearson correlation between simulated normalized polygon areas <A_n>/<A> and Lewis's Law (n-2)/4 across n=4..9 (RMSE=0.0165, p=0.0001)" ;
        schema:name "lewis_law_area_topology_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9994" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-lewis-law-area-topology-pearson-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-lewis-law-area-topology-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.99" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pcp-bond-tensor-isotropic-residual> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pcp_bond_tensor_isotropic_residual = -0.0251 asymmetry" ;
        schema:measurementTechnique "Constant term of the least-squares nematic fit a_ab = 0.988 cos2theta + 0.013 sin2theta + c0 over 514 interior bonds; the Lean theorem pcp_bond_tensor_traceless_and_perpendicular_cancellation forces c0 = 0 for uniform polarity (tension anisotropy Lambda_AP/Lambda_PD = 2.389)" ;
        schema:name "pcp_bond_tensor_isotropic_residual" ;
        schema:unitText "asymmetry" ;
        schema:value "-0.0251" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pcp-bond-tensor-isotropic-residual-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pcp-bond-tensor-isotropic-residual-reference> a schema:PropertyValue ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pcp-hinge-cell-elongation-peak-q> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pcp_hinge_cell_elongation_peak_Q = 0.2532 half_log_aspect_ratio" ;
        schema:measurementTechnique "Peak tissue-mean cell-elongation magnitude <|Q|> = <1/2 ln(a/b)> in the PCP explicit vertex model (eps_pcp=0.5, PD log-strain 0.35, 20 T1s); reference is the approximate Etournay et al. (2015) eLife Fig. 3 blade cell-elongation peak (~22 hAPF), read from the figure and not verified online in Pass 3" ;
        schema:name "pcp_hinge_cell_elongation_peak_Q" ;
        schema:unitText "half_log_aspect_ratio" ;
        schema:value "0.2532" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pcp-hinge-cell-elongation-peak-q-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pcp-hinge-cell-elongation-peak-q-reference> a schema:PropertyValue ;
        schema:value "0.25" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pcp-hinge-rearrangement-shear-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pcp_hinge_rearrangement_shear_fraction = 0.3072 fraction" ;
        schema:measurementTechnique "Share of the imposed PD tissue shear ln(lambda)=0.350 carried by the rearrangement residual (total - cell-elongation change) at the end of the run (Etournay et al. 2015 shear decomposition; ~half of blade shear attributed to T1s, approximate)" ;
        schema:name "pcp_hinge_rearrangement_shear_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.3072" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pcp-hinge-rearrangement-shear-fraction-reference> .


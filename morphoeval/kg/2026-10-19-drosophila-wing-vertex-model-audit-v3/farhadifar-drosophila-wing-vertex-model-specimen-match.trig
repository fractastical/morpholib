sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-farhadifar-drosophila-wing-vertex-model> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model, Lewis's law packing & PCP (Fz/Stbm) hinge-contraction vertex dynamics — Morphological realism / specimen match: 78/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Judged on the regenerated PNG: the four Section 2 regimes are visually distinct, the segmentation overlay (A5) follows the junction network of the micrograph, and the new C1/C2 panels show PD-elongated cells with bonds coloured by PCP-modulated tension against an isotropic control, which resembles the elongated pupal blade cells of Aigouy et al. (2010) qualitatively. Deductions: the only vendored specimen is a Wikimedia epithelium whose own scout manifest records organism Mus musculus (scout_manifest.json:8) and whose JSON entry gives no species (reference JSON L54-62), so the r = 0.9913 P(n) agreement is a cross-species transfer and not a Drosophila wing match (-12); no Drosophila wing-disc or pupal-wing image (e.g. a CC-BY eLife panel from Etournay 2015) is placed side by side with the simulation, so the hinge-contraction morphology is validated only against approximate numbers (-6); the explicit vertex patch is only 100 cells with a clamped margin, visibly smaller than the ~10^4-cell blade (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/drosophila_wing_vertex_model/scout_manifest.json L8–L8: Scout manifest records organism 'Mus musculus' for the vendored micrograph — not a Drosophila specimen <https://github.com/fractastical/morpholib/blob/7e4f207/datasets/drosophila_wing_vertex_model/scout_manifest.json#L8-L8>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match-3> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/drosophila_wing_vertex_model_comparison.png (generated output)" ;
        dct:description "15-panel figure: A1-A5 regimes + segmented specimen, B1-B5 phase diagram/P(n)/Lewis/ablation/sweep, C1-C5 PCP vertex mesh (WT and eps=0 control), shear decomposition, bond-tensor law, eps_pcp sweep — docs/media/drosophila_wing_vertex_model_comparison.png: rendered output of 2007-farhadifar-drosophila-wing-vertex-model.py at 7e4f207, image/png, 1297705 B, 3075×1935 px, artifact_sha256 2cb99062ead6793102bd757b45c1c91c5b484d3f97e6a67b428f78f2fbb36aa7 (sha256 2cb99062ead6793102bd757b45c1c91c5b484d3f97e6a67b428f78f2fbb36aa7), spec_fingerprint 00f70e92aaa338b22956554153bb93fbccd372cdaae2e3f47f4744bcadfffe52" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L1495–L1544" ;
        dct:description "_draw_pcp_mesh: cells by polygon class, bonds coloured by Lambda_ab, Fz polarity arrows; C1 (eps=0.5) vs C2 (eps=0) controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L1495-L1544> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L1064–L1185" ;
        dct:description "segment_epithelial_specimen: junction-guided Voronoi-watershed segmentation (N=37 cells, r=0.9913 vs Farhadifar wing-disc P(n))" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L1064-L1185> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 builder + primary re-assessor, autonomous loop slot-043)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


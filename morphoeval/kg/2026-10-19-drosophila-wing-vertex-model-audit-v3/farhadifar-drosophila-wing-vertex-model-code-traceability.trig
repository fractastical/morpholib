sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-farhadifar-drosophila-wing-vertex-model> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model, Lewis's law packing & PCP (Fz/Stbm) hinge-contraction vertex dynamics — Code-to-model traceability: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring (L1-52) maps every implemented equation to its source and lists the Lean file; the Section 2b header (L480-522) states the PCP/hinge model equation by equation with citations and an explicit not-modelled list; function docstrings cite Farhadifar Eq. 1 derivatives, Etournay's |Q| = 1/2 ln(a/b), Classen/Aigouy for the Fz-Stbm bridge; the math_kg YAML registers both new theorems with code loci (L50-86). Deductions: the gains k_fb = 0.6, k_flow = 0.4, polarity noise 0.02, initial spread 0.6 rad, T1 lengths 0.08/0.12 and the |Q|/0.15 saturation are stated but not traced to any source (-6); the Section 2 reweighting at L401-405 and the hex pull at L378-379 carry comments that cite Farhadifar p. 2101 / Classen 2005 for steps those papers do not contain (-6)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2007-farhadifar-drosophila-wing-vertex-model.py L376–L379: Comment attributes the hexagonal-lattice pull to Classen 2005 / Farhadifar 2007 p. 2101, which describe PCP-driven remodeling, not a lattice-restoring force <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L376-L379>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-code-traceability-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L480–L524" ;
        dct:description "Section 2b header: model statement, citations, sign convention, shear decomposition and explicit 'What is NOT modelled' list" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L480-L524> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L1–L52" ;
        dct:description "Module docstring with all 8 sources, Pass 3 equations and offline-DOI caveat" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2007-farhadifar-drosophila-wing-vertex-model.py#L1-L52> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/farhadifar-drosophila-wing-vertex-model.yaml L50–L86" ;
        dct:description "Two Pass 3 equation entries linked to Lean theorems 5-6 and script loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/morphoeval/math_kg_loops/farhadifar-drosophila-wing-vertex-model.yaml#L50-L86> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 builder + primary re-assessor, autonomous loop slot-043)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-grieneisen-root-auxin-reflux-fountain> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Grieneisen et al. (2007) Nature & Mähönen et al. (2014) Nature reverse-fountain root tip auxin reflux capacitor solved on a cellular PIN-permeability lattice, with a growing dividing cellular lattice and gravistimulated PIN3/PIN7 bending (Friml 2002, Band 2012) — Morphological realism / specimen match: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The CC BY-SA 4.0 confocal micrograph is still SHA-256-pinned and segmented (`segment_arabidopsis_root_specimen` L763-835: 113 DAPI nuclei, 18.34 +- 0.58 px spacing, apical/proximal density ratio 1.118) and panel I of the figure shows the overlay next to the simulated lattice. Down four points from v2 because no model-predicted quantity is compared against the micrograph beyond the order-of-magnitude meristem cell count (26 simulated vs 32 +- 6 literature; the specimen nuclei count 113 spans 3 panels and is not converted into cells per file), and because the six-regime \"benchmarks\" the model is compared against in panels C-E are Pass-1 synthetic values, now labelled as such in the figure and dataset README." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/root_auxin_reflux_fountain/README.md L20–L30: Dataset README disclosing that the six-regime reference-table values are Pass-1 synthetic calibration targets, not digitised paper data <https://github.com/fractastical/morpholib/blob/d58a084/datasets/root_auxin_reflux_fountain/README.md#L20-L30>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-specimen-match-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2014-grieneisen-root-auxin-reflux-fountain.py L763–L835" ;
        dct:description "Dual-channel DAPI nuclear + Alexa Fluor 488 mitotic CV segmentation of the Arabidopsis root meristem confocal micrograph (unchanged from Pass 2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L763-L835> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/root_auxin_reflux_fountain_comparison.png (generated output)" ;
        dct:description "9-panel figure: solved WT lattice, ablation regeneration, 6-regime axial profiles, emergent vs synthetic-table QC amplitudes, zone boundaries, growing lattice, bending kinetics, parameter sweeps, confocal specimen overlay — docs/media/root_auxin_reflux_fountain_comparison.png: rendered output of 2014-grieneisen-root-auxin-reflux-fountain.py at d58a084, image/png, 790294 B, 2535×1950 px, artifact_sha256 74eeebaec44a0a577c78fcc9a3d4600c2a24ee895cb7aee80e52214132761d8a (sha256 74eeebaec44a0a577c78fcc9a3d4600c2a24ee895cb7aee80e52214132761d8a), spec_fingerprint 59e5555082b3fc06ab4cbec1acc2a30766a6392b68c0868814d580bd3ce1a15f" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 038 Pass 3 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


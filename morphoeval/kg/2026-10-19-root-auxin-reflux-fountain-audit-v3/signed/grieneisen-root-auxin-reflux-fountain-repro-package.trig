sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-grieneisen-root-auxin-reflux-fountain> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2014-grieneisen-root-auxin-reflux-fountain.py L1274–L1364" ;
        dcterms:description "14-check deterministic self-test suite" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L1274-L1364> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2014-grieneisen-root-auxin-reflux-fountain.py L1044–L1271" ;
        dcterms:description "render_outputs producing the 9-panel PNG and growth + bending GIF" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L1044-L1271> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Grieneisen et al. (2007) Nature & Mähönen et al. (2014) Nature reverse-fountain root tip auxin reflux capacitor solved on a cellular PIN-permeability lattice, with a growing dividing cellular lattice and gravistimulated PIN3/PIN7 bending (Friml 2002, Band 2012) — Reproducibility package: 94/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`run_self_test()` (L1274-1364) executes 14 deterministic checks in ~3 s: SHA-256 integrity of 5 files, Law 1 on the real operator, emergent capacitor hierarchy, decapitation autonomy, ablation shift, PLT zonality ordering (NPA excluded and disclosed), growing-lattice divisions and bounds, division-rule invariants, lateral ratio monotone in g and symmetric at g = 0, bending reaching the tipping point and gradient dissipation, pin3 slowing, sweep monotonicity, specimen segmentation and 16-metric determinism. Default run regenerates the PNG and 25-frame GIF in ~6 s; `lean` on the loop file exits 0." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-repro-package-2> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;

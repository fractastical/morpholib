sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-grieneisen-root-auxin-reflux-fountain> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Grieneisen et al. (2007) Nature & Mähönen et al. (2014) Nature reverse-fountain root tip auxin reflux capacitor solved on a cellular PIN-permeability lattice, with a growing dividing cellular lattice and gravistimulated PIN3/PIN7 bending (Friml 2002, Band 2012) — Model fidelity to source: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The Grieneisen (2007) cellular PIN-permeability reflux model is now actually solved (`build_pin_lattice_operator` L178-288 assembles the sparse operator with rootward stele, shootward epidermal, inward lateral and apolar columella permeabilities, passive exchange, turnover and the shoot source; `solve_cellular_auxin_steady_state` L291-295), the Mähönen (2014) PLETHORA solver runs on variable-length rows with growth dilution (`solve_plethora_gradient` L334-362), the growing lattice divides cells explicitly (`simulate_growing_cellular_lattice` L542-636) and gravistimulation is a g-biased statocyte efflux split (L253-263) feeding sine-law bending (`simulate_gravitropic_bending` L641-716). Six machine-checked Lean 4 theorems (0 sorrys) cover the laws. Two points below v2 because the v2 remediation asked for vertex/CPM mechanics and the delivered growth/bending are reduced kinematic models with uniform row lengths and an imposed 40 degree tipping point." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-model-fidelity-5> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2014-grieneisen-root-auxin-reflux-fountain.py L178–L288" ;
        dcterms:description "Sparse cellular PIN-permeability steady-state operator (Grieneisen 2007) with g-biased PIN3/PIN7 statocyte split at L253-263 and QC/columella respecification for ablation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L178-L288> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2014-grieneisen-root-auxin-reflux-fountain.py L334–L372" ;
        dcterms:description "Mähönen (2014) PLETHORA finite-volume Helmholtz / implicit-Euler solver on variable-length rows and zone_boundaries thresholds Theta_MZ / Theta_EZ" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L334-L372> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2014-grieneisen-root-auxin-reflux-fountain.py L542–L636" ;
        dcterms:description "Growing cellular lattice with explicit mitotic division at 2 x birth length, PLT-gated elongation and mature-row shedding" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L542-L636> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2014-grieneisen-root-auxin-reflux-fountain.py L641–L716" ;
        dcterms:description "Gravistimulated bending: Sachs sine law, auxin-inhibited epidermal elongation with first-order lag, curvature integral and Band (2012) tipping-point reset; reduced kinematics, not vertex/CPM" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L641-L716> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_038_root_auxin_reflux_fountain.lean L31–L229" ;
        dcterms:description "6 Lean 4 theorems: reflux conservation, QC capacitor vs collapse, PLT boundary monotonicity, gravistimulated efflux asymmetry (L147-176), PLT growth-dilution monotonicity (L188-203), mitotic division length conservation (L213-229); 0 sorrys" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_038_root_auxin_reflux_fountain.lean#L31-L229> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 038 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-growing-lattice-root-growth-rate-um-per-h-reference> a schema:PropertyValue ;
        dcterms:source "Beemster & Baskin (1998) Plant Physiol 116:1515-1526 Fig. 1 (Columbia primary root elongation ~2-8 mm/day between 2 and 10 dag, i.e. ~100-250 um/h around 5 dag; approximate reading)" ;
        schema:value "180.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-pin3-gravitropic-bending-rate-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pin3_gravitropic_bending_rate_fraction = 0.5153 fraction_of_wt" ;
        schema:measurementTechnique "Initial (first hour) bending rate with statocyte efflux asymmetry halved (pin3) divided by WT" ;
        schema:name "pin3_gravitropic_bending_rate_fraction" ;
        schema:unitText "fraction_of_wt" ;
        schema:value "0.5153" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-pin3-gravitropic-bending-rate-fraction-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-pin3-gravitropic-bending-rate-fraction-reference> a schema:PropertyValue ;
        dcterms:source "Friml et al. (2002) Nature 415:806-809 Fig. 4 (pin3 roots bend more slowly than WT; PIN3/PIN7 redundancy per Kleine-Vehn et al. 2010); approximate reading" ;
        schema:value "0.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-qc-laser-ablation-regenerated-peak-z-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "qc_laser_ablation_regenerated_peak_z_um = 112.5 um" ;
        schema:measurementTechnique "Emergent stele auxin peak after ablating rows 0-3 (0-60 um) and respecifying rows 4-6 as apolar columella" ;
        schema:name "qc_laser_ablation_regenerated_peak_z_um" ;
        schema:unitText "um" ;
        schema:value "112.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-qc-laser-ablation-regenerated-peak-z-um-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-qc-laser-ablation-regenerated-peak-z-um-reference> a schema:PropertyValue ;
        dcterms:source "Grieneisen et al. (2007) Fig. 4, Sabatini et al. (1999) Cell 99:463-472 and Xu et al. (2006) Science 311:385-388 (new QC/columella respecified above the ablated cells); 105 um = Pass-1 table value" ;
        schema:value "105.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-shoot-decapitation-capacitor-retention-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "shoot_decapitation_capacitor_retention_fraction = 0.9246 fraction" ;
        schema:measurementTechnique "Absolute QC auxin maximum at J_in = 0 divided by WT maximum (replaces the Pass 2 ratio-of-ratios, which diverges because A_shoot -> 0 when J_in = 0)" ;
        schema:name "shoot_decapitation_capacitor_retention_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.9246" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-shoot-decapitation-capacitor-retention-fraction-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-shoot-decapitation-capacitor-retention-fraction-reference> a schema:PropertyValue ;
        dcterms:source "Grieneisen et al. (2007) Nature 449:1008-1013 Fig. 3 (QC maximum persists after removal of shoot-derived auxin); numeric 0.876 = Pass-1 table 124.8/142.5" ;
        schema:value "0.876" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-six-regime-meristem-boundary-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "six_regime_meristem_boundary_pearson_r = -0.3312 r" ;
        schema:measurementTechnique "Pearson r (and Spearman rho) of emergent vs reference z_MZ across all 6 regimes (uncertainty = RMSE in um). The 6-regime value is dominated by the disclosed NPA disagreement (uniform sigma/mu auxin saturates PLT, z_MZ = L vs table 0); the 5-regime value excludes it" ;
        schema:name "six_regime_meristem_boundary_pearson_r" ;
        schema:unitText "r" ;
        schema:value "-0.3312" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-six-regime-meristem-boundary-pearson-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-six-regime-meristem-boundary-pearson-r-reference> a schema:PropertyValue ;
        dcterms:source "Pass-1 synthetic reference table 6-regime z_MZ values (not digitised from the papers)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-six-regime-relative-qc-amplitude-log-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "six_regime_relative_qc_amplitude_log_pearson_r = 0.9195 r" ;
        schema:measurementTechnique "Pearson r of log10 emergent QC maximum (relative to WT) vs log10 reference ratio (relative to WT) across the 6 regimes; replaces the circular r = 1.0 of Pass 2" ;
        schema:name "six_regime_relative_qc_amplitude_log_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9195" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-six-regime-relative-qc-amplitude-log-pearson-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-six-regime-relative-qc-amplitude-log-pearson-r-reference> a schema:PropertyValue ;

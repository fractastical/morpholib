sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-grieneisen-root-auxin-reflux-fountain> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Grieneisen et al. (2007) Nature & Mähönen et al. (2014) Nature reverse-fountain root tip auxin reflux capacitor solved on a cellular PIN-permeability lattice, with a growing dividing cellular lattice and gravistimulated PIN3/PIN7 bending (Friml 2002, Band 2012) — Morphometric validation: 89/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L841-1038) returns 16 measurements, each with a reference value, unit and uncertainty: flux-conservation error, WT QC amplification, log-amplitude r over six regimes (0.919), decapitation retention (0.925), ablation peak shift, WT z_MZ (240 um), six-regime z_MZ r (-0.331, with the 5-regime r > 0.9 excluding NPA reported alongside), three growing-lattice metrics against Beemster & Baskin / Dello Ioio anchors, three gravitropism metrics against Friml / Band anchors, and three specimen metrics. Four points below v2 because the comparisons are now honest: the six-regime z_MZ correlation is negative, the tipping point is 2.8x slower than Band (2012), the growth rate is ~2x below the literature anchor, and the regime benchmarks remain synthetic." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2014-grieneisen-root-auxin-reflux-fountain.py L934–L947: six_regime_meristem_boundary_pearson_r = -0.331 against the synthetic table (NPA saturates PLT); honest negative result <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L934-L947>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-gravistimulation-lateral-auxin-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-gravitropic-time-to-tipping-point-h>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-growing-lattice-cell-production-rate-per-h>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-growing-lattice-meristem-cell-number>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-growing-lattice-root-growth-rate-um-per-h>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-pin3-gravitropic-bending-rate-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-qc-laser-ablation-regenerated-peak-z-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-shoot-decapitation-capacitor-retention-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-six-regime-meristem-boundary-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-six-regime-relative-qc-amplitude-log-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-specimen-apical-to-proximal-nuclear-density-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-specimen-detected-meristem-nuclei-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-specimen-intercellular-nuclear-spacing-px>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-vascular-epidermal-counter-current-flux-error>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-wt-plethora-meristem-zone-boundary-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-wt-qc-auxin-amplification-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-morphometric-validation-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-gravistimulation-lateral-auxin-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "gravistimulation_lateral_auxin_ratio = 1.8547 ratio_lower_to_upper" ;
        schema:measurementTechnique "Mean lower/upper epidermal auxin over the EZ rows of the solved lattice at g = g_max (horizontal, phi = 90 deg) (Law 4)" ;
        schema:name "gravistimulation_lateral_auxin_ratio" ;
        schema:unitText "ratio_lower_to_upper" ;
        schema:value "1.8547" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-gravistimulation-lateral-auxin-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-gravistimulation-lateral-auxin-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Band et al. (2012) PNAS 109:4668-4673 (DII-VENUS lower vs upper epidermal auxin asymmetry after 90 deg gravistimulation, inferred ~1.5-3-fold) and Friml et al. (2002) Nature 415:806-809 (DR5::GUS lower-side accumulation); approximate reading" ;
        schema:value "2.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-gravitropic-time-to-tipping-point-h> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "gravitropic_time_to_tipping_point_h = 5.55 h" ;
        schema:measurementTechnique "Time for the sine-law gravistimulated root to bend 40 deg (the imposed Band 2012 tipping-point angle); -1 if not reached within 8 h" ;
        schema:name "gravitropic_time_to_tipping_point_h" ;
        schema:unitText "h" ;
        schema:value "5.55" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-gravitropic-time-to-tipping-point-h-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-gravitropic-time-to-tipping-point-h-reference> a schema:PropertyValue ;
        dcterms:source "Band et al. (2012) PNAS 109:4668-4673 Figs. 1-2 (lateral gradient dissipates when the tip has bent ~40 deg, ~2 h after a 90 deg gravistimulation; approximate reading)" ;
        schema:value "2.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-growing-lattice-cell-production-rate-per-h> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growing_lattice_cell_production_rate_per_h = 0.958 cells/h/file" ;
        schema:measurementTechnique "Explicit mitotic division events per hour per cell file over 24 h" ;
        schema:name "growing_lattice_cell_production_rate_per_h" ;
        schema:unitText "cells/h/file" ;
        schema:value "0.958" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-growing-lattice-cell-production-rate-per-h-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-growing-lattice-cell-production-rate-per-h-reference> a schema:PropertyValue ;
        dcterms:source "Beemster & Baskin (1998) Plant Physiol 116:1515-1526 (cortical cell production rate ~1-2 cells/h per file; approximate reading)" ;
        schema:value "1.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-growing-lattice-meristem-cell-number> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growing_lattice_meristem_cell_number = 26 cells_per_file" ;
        schema:measurementTechnique "Rows with P >= Theta_MZ after 24 h of the growing cellular lattice with explicit mitotic division (Law 5)" ;
        schema:name "growing_lattice_meristem_cell_number" ;
        schema:unitText "cells_per_file" ;
        schema:value "26" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-growing-lattice-meristem-cell-number-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-growing-lattice-meristem-cell-number-reference> a schema:PropertyValue ;
        dcterms:source "Dello Ioio et al. (2007) Curr Biol 17:678-682 Fig. 1 (5-dag Col-0 cortical meristem cell number ~30-35; approximate reading)" ;
        schema:value "32.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-growing-lattice-root-growth-rate-um-per-h> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growing_lattice_root_growth_rate_um_per_h = 81.87 um/h" ;
        schema:measurementTechnique "Mean d(total root length)/dt over the last 6 h of the 24 h growing-lattice simulation" ;
        schema:name "growing_lattice_root_growth_rate_um_per_h" ;
        schema:unitText "um/h" ;
        schema:value "81.87" ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-grieneisen-root-auxin-reflux-fountain> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Grieneisen et al. (2007) Nature & Mähönen et al. (2014) Nature reverse-fountain root tip auxin reflux capacitor solved on a cellular PIN-permeability lattice, with a growing dividing cellular lattice and gravistimulated PIN3/PIN7 bending (Friml 2002, Band 2012) — Parameter expressivity: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Six perturbation regimes are generated by parameter changes to a single solved operator (`run_six_perturbation_regimes` L471-537: J_in = 0, v_e = 0, k_lat = 0, uniform NPA permeabilities, ablated rows), four monotone parameter sweeps with Spearman statistics (`parameter_sweeps` L721-757: k_lat -> QC maximum, v_e -> z_MZ, D -> QC maximum, g -> lateral ratio) are rendered in panel H, and the CLI exposes `--D`, `--vs`, `--ve`, `--klat`, `--alpha-plt` (L1369-1374). The pin3 bending comparison re-runs the bending model with g_max halved." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-parameter-expressivity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2014-grieneisen-root-auxin-reflux-fountain.py L471–L537" ;
        dct:description "Six-regime perturbation sweep on the solved operator with log-amplitude Pearson, z_MZ Pearson/Spearman and axial-profile statistics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L471-L537> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2014-grieneisen-root-auxin-reflux-fountain.py L721–L757" ;
        dct:description "Four parameter sweeps (k_lat, v_e, D, g) with Spearman monotonicity of QC maximum, z_MZ and lateral ratio" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L721-L757> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2014-grieneisen-root-auxin-reflux-fountain.py L1367–L1383" ;
        dct:description "CLI flags --D, --vs, --ve, --klat, --alpha-plt forwarded to the solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L1367-L1383> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 038 Pass 3 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


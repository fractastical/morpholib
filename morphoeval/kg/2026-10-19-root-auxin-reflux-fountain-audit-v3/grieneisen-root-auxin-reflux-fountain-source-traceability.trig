sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-grieneisen-root-auxin-reflux-fountain> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Grieneisen et al. (2007) Nature & Mähönen et al. (2014) Nature reverse-fountain root tip auxin reflux capacitor solved on a cellular PIN-permeability lattice, with a growing dividing cellular lattice and gravistimulated PIN3/PIN7 bending (Friml 2002, Band 2012) — Source and data traceability: 95/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`datasets/root_auxin_reflux_fountain/` now carries 10 BibTeX entries with DOIs resolved against doi.org / Crossref on 2026-10-20 (4 Pass-1 + 6 Pass-3: Friml 2002, Band 2012, Kleine-Vehn 2010, Beemster & Baskin 1998, Dello Ioio 2007, Xu 2006), a new `root_growth_gravitropism_reference.json` with explicit provenance notes, and the README distinguishes literature-anchored defaults from calibration choices and discloses the synthetic benchmarks. All 5 files are SHA-256-verified at runtime (`verify_dataset_integrity` L149-161)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-source-traceability-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2014-grieneisen-root-auxin-reflux-fountain.py L107–L161" ;
        dct:description "EXPECTED_SHA256 table for 5 dataset files and runtime verification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-grieneisen-root-auxin-reflux-fountain.py#L107-L161> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/root_auxin_reflux_fountain/paper_citations.bib L1–L111" ;
        dct:description "10 BibTeX entries with verified DOIs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/root_auxin_reflux_fountain/paper_citations.bib#L1-L111> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/root_auxin_reflux_fountain/README.md L1–L40" ;

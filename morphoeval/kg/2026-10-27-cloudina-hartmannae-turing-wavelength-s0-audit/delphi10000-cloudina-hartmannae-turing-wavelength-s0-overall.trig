sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Cloudina hartmannae wall-normal Turing lamella at 2.397 µm (Pass 1) — MorphoEval overall 78.0/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 1 implements Schnakenberg kinetics with Du and Dv fixed so the Turing critical wavelength is 2.397 µm on a 19.176 µm wall-normal interval (eight lamellae inside one Grant shell layer). The noise-seeded field produced eight peaks at 2.397 µm. Points are withheld until the diffusivity sweep, equal-diffusion and ablation controls, Corumbá/card segmentation, and the dispersion goodness-of-fit are audited as measurements. Overall 78.0/100 (faithfulness 75.3, reproducibility 84.3); rubric morphoeval 0.1.0; checkpoint commit 0c76d15d14afcec6c366e1b9274a6586a0de48fc; environment: . Dimension assessments: Model fidelity to source 82, Morphological realism / specimen match 74, Parameter expressivity 70, Morphometric validation 72, Source and data traceability 88, Code-to-model traceability 80, Reproducibility package 84. Output judged: docs/media/cloudina_hartmannae_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-cloudina-hartmannae-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/png, 379283 B, 1344×984 px, artifact_sha256 bb3134888de8b71deb15f05bdbb0d2af68dad34b28b237c32208765ed9a18d64 (sha256 bb3134888de8b71deb15f05bdbb0d2af68dad34b28b237c32208765ed9a18d64), spec_fingerprint aed8c0ba57f9ef79f97072aa88a12b01ec7259b22f96b35a3a9a2a503fa4efe9. Dual provenance: spec_fingerprint: aed8c0ba57f9ef79f97072aa88a12b01ec7259b22f96b35a3a9a2a503fa4efe9; artifact_sha256: bb3134888de8b71deb15f05bdbb0d2af68dad34b28b237c32208765ed9a18d64; input_dataset_sha256: {datasets/cloudina_hartmannae_turing_wavelength_s0/cloudina_corumba_cc_by_2.jpg=f20328a5dcb570d1..., datasets/cloudina_hartmannae_turing_wavelength_s0/cloudina_hartmannae_specimen.jpg=cbe0233dbf275f4e..., datasets/cloudina_hartmannae_turing_wavelength_s0/cloudina_hartmannae_turing_wavelength_s0_reference.json=dcd1cbc35eecb656...}. Claim boundary: reported_in_source: Yang et al. 2020: Namibian Cloudina organic lamellae 0.5–5 µm, up to eight per wall layer | Grant 1990: shell layers 8–50 µm | Turing 1952 critical wavenumber and Schnakenberg 1979 kinetics; reconstructed_in_script: Du, Dv chosen so lambda_c = 2.397 µm at diffusivity ratio 8.65 | Noise-seeded periodic integration on a commensurate 8-wavelength domain; transfer_boundary: A Turing lamella wavelength on an Ediacaran tube is a morphospace hypothesis, not a fossil measurement of pigment; does_not_claim: That Cloudina had ocelli or a measured 2.397 µm pigment stripe | That the 100 µm species card is a lamella micrograph." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Goodness-of-fit: pin Pearson r and RMSE of real-eigenvalue growth rates, and report the KS statistic against the Yang band without treating a rejection as a pass.",
            "remediation needed: Negative and ablation controls: record equal-diffusion max growth rate and the autocatalysis-ablation amplitude ratio.",
            "remediation needed: Parameter-regime sweep: audit the diffusivity-scale sweep and require monotone growth of wavelength with sqrt(s).",
            "remediation needed: Real specimen CV segmentation: segment the species card and the Corumbá fossil and require the foreground fractions to differ." ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor). No second assessor was run." ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0000-0000-0000> .
}


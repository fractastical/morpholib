sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Cloudina hartmannae wall-normal Turing lamella at 2.397 µm (Pass 1) — Morphometric validation: 72/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Peak spacing on the commensurate domain is exactly 2.397 µm with standard deviation 0, which is finite-size locking as much as a test. Dispersion correlation, KS against the Yang band, and the Corumbá segmentation are not yet pinned as measurements." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-autocatalysis-ablation-activator-std-vs-full-pattern-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-cloudina-wall-lamella-stripe-count-versus-funnel-rung-count-on-the-same-layer>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-cv-similarity-of-growth-gif-last-frame-vs-species-card>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-diffusivity-scale-sweep-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-equal-diffusion-negative-control-max-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-ks-distance-of-lamella-spacings-vs-yang-band-normal>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-specimen-image-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-specimen-image-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-specimen-image-lamella-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-analytical-vs-pde-stepper>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-turing-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-autocatalysis-ablation-activator-std-vs-full-pattern-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "autocatalysis-ablation activator std vs full pattern std = 0.0 1" ;
        schema:measurementTechnique "std(u) after removing u^2 v, divided by std(u) of the full model" ;
        schema:name "autocatalysis-ablation activator std vs full pattern std" ;
        schema:unitText "1" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-autocatalysis-ablation-activator-std-vs-full-pattern-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-autocatalysis-ablation-activator-std-vs-full-pattern-std-reference> a schema:PropertyValue ;
        dct:source "Ratio 1 would mean ablation did nothing. The control must fall well below 1." ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-cloudina-wall-lamella-stripe-count-versus-funnel-rung-count-on-the-same-layer> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cloudina wall lamella stripe count versus funnel-rung count on the same layer = 8 count" ;
        schema:measurementTechnique "periodic peak count on the 19.176 µm wall-normal domain" ;
        schema:name "Cloudina wall lamella stripe count versus funnel-rung count on the same layer" ;
        schema:unitText "count" ;
        schema:value "8" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-cloudina-wall-lamella-stripe-count-versus-funnel-rung-count-on-the-same-layer-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-cloudina-wall-lamella-stripe-count-versus-funnel-rung-count-on-the-same-layer-reference> a schema:PropertyValue ;
        dct:source "How many 104.2 µm funnel wavelengths fit in the same 19.176 µm layer (slot 1252 rung). 8 lamellae versus a fraction of one funnel." ;
        schema:value "0.184" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-cv-similarity-of-growth-gif-last-frame-vs-species-card> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "CV similarity of growth GIF last frame vs species card = 91.5 score" ;
        schema:measurementTechnique "verify_image_fitness.compute_sim_vs_specimen_cv_similarity (orientation, radial FFT, coherency, occupancy)" ;
        schema:name "CV similarity of growth GIF last frame vs species card" ;
        schema:unitText "score" ;
        schema:value "91.5" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-cv-similarity-of-growth-gif-last-frame-vs-species-card-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-cv-similarity-of-growth-gif-last-frame-vs-species-card-reference> a schema:PropertyValue ;
        dct:source "Image-fitness gate cv_sim_similarity >= 58. Measured score is not the gate." ;
        schema:value "58.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-diffusivity-scale-sweep-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffusivity-scale sweep Pearson r = 0.9999 1" ;
        schema:measurementTechnique "corrcoef of analytical λ(s)=2.397√s against the numerical peak wavelength" ;
        schema:name "diffusivity-scale sweep Pearson r" ;
        schema:unitText "1" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-diffusivity-scale-sweep-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-diffusivity-scale-sweep-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Expressivity gate. Measured r is not the threshold." ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-equal-diffusion-negative-control-max-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion negative-control max growth rate = -0.1239 1/time" ;
        schema:measurementTechnique "max σ(k) with Dv reset to Du" ;
        schema:name "equal-diffusion negative-control max growth rate" ;
        schema:unitText "1/time" ;
        schema:value "-0.1239" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-equal-diffusion-negative-control-max-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-equal-diffusion-negative-control-max-growth-rate-reference> a schema:PropertyValue ;
        dct:source "Turing control: equal diffusivities must not have a positive growth rate" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-ks-distance-of-lamella-spacings-vs-yang-band-normal> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "KS distance of lamella spacings vs Yang-band normal = 0.6232 1" ;
        dct:description "two-sided p = 0.001581" ;
        schema:measurementTechnique "Kolmogorov-Smirnov statistic of peak spacings against N(2.75 µm, 1.125 µm)" ;
        schema:name "KS distance of lamella spacings vs Yang-band normal" ;
        schema:unitText "1" ;
        schema:value "0.6232" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-ks-distance-of-lamella-spacings-vs-yang-band-normal-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-ks-distance-of-lamella-spacings-vs-yang-band-normal-reference> a schema:PropertyValue ;
        dct:source "KS = 0 would mean the spacing sample was drawn from the band-wide normal. It is not." ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-specimen-image-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen-image contour circularity = 0.057 1" ;
        schema:measurementTechnique "4πA/P^2 of the species-card foreground" ;
        schema:name "specimen-image contour circularity" ;
        schema:unitText "1" ;
        schema:value "0.057" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-specimen-image-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-specimen-image-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "Circularity of the Corumbá fossil photograph" ;
        schema:value "0.4489" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-specimen-image-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen-image foreground fraction = 0.3636 1" ;
        schema:measurementTechnique "border-contrast mask on the Cloudina hartmannae species card" ;
        schema:name "specimen-image foreground fraction" ;
        schema:unitText "1" ;
        schema:value "0.3636" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "Same mask on the CC BY 2.0 Corumbá Cloudina fossil photograph (genus-level slab, not the species card)" ;
        schema:value "0.6345" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-specimen-image-lamella-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen-image lamella stripe wavelength = 2.397 µm" ;
        schema:measurementTechnique "mean distance between activator peaks on the noise-seeded wall-normal field" ;
        schema:name "specimen-image lamella stripe wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.397" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-specimen-image-lamella-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-specimen-image-lamella-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "Midpoint of the Yang et al. 2020 Namibian organic-lamella band 0.5–5 µm. Not set equal to the measurement." ;
        schema:value "2.75" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen-image structure-tensor coherency = 0.8315 1" ;
        schema:measurementTechnique "mean structure-tensor coherency inside the species-card foreground" ;
        schema:name "specimen-image structure-tensor coherency" ;
        schema:unitText "1" ;
        schema:value "0.8315" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "Coherency of the Corumbá fossil photograph under the same estimator" ;
        schema:value "0.3415" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-analytical-vs-pde-stepper> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing dispersion Pearson r (analytical σ vs PDE stepper) = 1.0 1" ;
        schema:measurementTechnique "corrcoef of σ(k) on periodic modes whose eigenvalues are real (complex long-wave pairs excluded)" ;
        schema:name "Turing dispersion Pearson r (analytical σ vs PDE stepper)" ;
        schema:unitText "1" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-analytical-vs-pde-stepper-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-analytical-vs-pde-stepper-reference> a schema:PropertyValue ;
        dct:source "Pass-2 gate: r > 0.98. The value is the measured correlation, not the gate." ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-turing-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing dispersion RMSE = 0.0312 1/time" ;
        schema:measurementTechnique "sqrt mean square error between analytical and numerical σ(k)" ;
        schema:name "Turing dispersion RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.0312" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-turing-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-measurement-turing-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "Ideal integrator error. Measured RMSE is not zero." ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;

        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-012> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-012-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-012-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-012 — cleavage vs bipolar field (Pass 1 baseline) — MorphoEval overall 55.9/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Pass 1 fits pole separation to Fig. 59 streamlines only; no parameter sweep, no like-pole ablation, no frog analogue CV, no KS statistics. Overall 55.9/100 (faithfulness 48.3, reproducibility 73.7); rubric morphoeval 0.1.0; checkpoint commit a8bae15d5; environment: python 3.12, numpy 2.x, scipy 1.x, matplotlib 3.x, Pillow 10+. Dimension assessments: Model fidelity to source 68, Morphological realism / specimen match 42, Parameter expressivity 40, Morphometric validation 38, Source and data traceability 82, Code-to-model traceability 72, Reproducibility package 68. Output judged: docs/media/t1917_012_on_the_internal_form_and_struc_comparison.png: rendered output of thompson/claims/t1917-012_on-the-internal-form-and-structure-of-the-cell.py, not present when the audit was snapshotted (unfingerprinted). Claim boundary: reported_in_source: Thompson (1917) p.189 Fig. 58-59: cleavage aster rays and 'field of force with two similar poles'; reconstructed_in_script: Pass 1 grid fit of pole separation a to Fig. 59 streamlines only; does_not_claim: No modern spindle imaging; no molecular mechanism." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: {'id': 'R1', 'item': 'Add pole-separation sweep, like-pole vs dipole ablation, frog plate CV, KS/CV statistics (Pass 2)'}",
            "remediation needed: {'id': 'R2', 'item': 'Hold-out validation metrics on Fig. 58 vs Fig. 59 fit'}" ;
        pk:hasScore "0.559"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, Pass 1; cloud loop thompson1917-t1917-012)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-012> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-012-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-012-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-012 — cleavage vs bipolar field (Pass 1 baseline) — Morphometric validation: 38/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Dice/RMSE only; no KS or null ablation in Pass 1." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-012_on-the-internal-form-and-structure-of-the-cell.py L95–L128: Dice overlap + RMSE; no KS/null in pass1 <https://github.com/fractastical/morpholib/blob/a8bae15d5/thompson/claims/t1917-012_on-the-internal-form-and-structure-of-the-cell.py#L95-L128>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-012-measurement-fig59-streamline-dice>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-012-measurement-pole-separation-a-norm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-012-measurement-ray-angle-rmse-deg> ;
        pk:hasScore "0.38"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-012-measurement-fig59-streamline-dice> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fig59_streamline_dice = 0.147 dimensionless" ;
        schema:measurementTechnique "Dice overlap predicted streamlines vs Fig. 59 binarised lines" ;
        schema:name "fig59_streamline_dice" ;
        schema:unitText "dimensionless" ;
        schema:value "0.147" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-012-measurement-pole-separation-a-norm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pole_separation_a_norm = 0.195 dimensionless" ;
        schema:measurementTechnique "Grid fit on Fig. 59" ;
        schema:name "pole_separation_a_norm" ;
        schema:unitText "dimensionless" ;
        schema:value "0.195" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-012-measurement-ray-angle-rmse-deg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ray_angle_rmse_deg = 69.9 deg" ;
        schema:measurementTechnique "Angular residual vs bipolar field (Pass 1)" ;
        schema:name "ray_angle_rmse_deg" ;
        schema:unitText "deg" ;
        schema:value "69.9" .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, Pass 1; cloud loop thompson1917-t1917-012)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {

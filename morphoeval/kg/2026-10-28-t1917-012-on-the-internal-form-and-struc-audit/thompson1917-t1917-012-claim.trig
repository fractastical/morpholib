sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-012> a pk:Claim ;
        rdfs:label "Thompson (1917) T1917-012 — cleavage vs bipolar field (Pass 1 baseline) faithfully reproduces Cerebratulus egg (Fig. 58); Thompson Fig. 59 diagram morphology" ;
        dct:description "The simulation script(s) thompson/claims/t1917-012_on-the-internal-form-and-structure-of-the-cell.py implement the cited source model as published and produce forms that match real Cerebratulus egg (Fig. 58); Thompson Fig. 59 diagram specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-012_on-the-internal-form-and-structure-of-the-cell.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-012_on-the-internal-form-and-structure-of-the-cell.py; output: docs/media/t1917_012_on_the_internal_form_and_struc_comparison.png; organism: Cerebratulus egg (Fig. 58); Thompson Fig. 59 diagram; environment: python 3.12, numpy 2.x, scipy 1.x, matplotlib 3.x, Pillow 10+; claim_boundary: [reported_in_source: Thompson (1917) p.189 Fig. 58-59: cleavage aster rays and 'field of force with two similar poles'; reconstructed_in_script: Pass 1 grid fit of pole separation a to Fig. 59 streamlines only; does_not_claim: No modern spindle imaging; no molecular mechanism]" .
    <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-012_on-the-internal-form-and-structure-of-the-cell.py> a schema:SoftwareSourceCode ;
        rdfs:label "thompson/claims/t1917-012_on-the-internal-form-and-structure-of-the-cell.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> .
}


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Dactylioceras commune Turing k_c at 24 µm (pass 2) — Morphological realism / specimen match: 88/100" ;

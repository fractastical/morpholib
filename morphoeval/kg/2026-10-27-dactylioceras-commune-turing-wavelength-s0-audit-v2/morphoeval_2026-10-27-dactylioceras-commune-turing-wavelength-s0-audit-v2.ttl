<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Dactylioceras commune Turing k_c at 24 µm (pass 2) — Model fidelity to source: 92/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script integrates the Schnakenberg PDE from the unstable eigenvector and recovers analytical sigma(k) across the band around k_c (r = 0.99991, RMSE = 0.00095). lambda_c is exactly 2.419e-05 m. The far-stable tail, where the explicit Laplacian's truncation error dominates, is outside the fit window and is disclosed." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 9.2e-01 ;
    pk:hasVerdict "faithful" .


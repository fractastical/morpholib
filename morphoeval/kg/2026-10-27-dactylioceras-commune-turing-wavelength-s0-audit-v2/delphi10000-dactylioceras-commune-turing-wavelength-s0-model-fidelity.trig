sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Dactylioceras commune Turing k_c at 24 µm (pass 2) — Model fidelity to source: 92/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The script integrates the Schnakenberg PDE from the unstable eigenvector and recovers analytical sigma(k) across the band around k_c (r = 0.99991, RMSE = 0.00095). lambda_c is exactly 2.419e-05 m. The far-stable tail, where the explicit Laplacian's truncation error dominates, is outside the fit window and is disclosed." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dactylioceras-commune-turing-wavelength-s0.py L101–L175" ;
        dct:description "k_c formula and eigenvector-seeded numerical growth rate" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8c95fb91d41c76d640c8216d24030d8fd3768487/models/2026-delphi10000-dactylioceras-commune-turing-wavelength-s0.py#L101-L175> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dactylioceras-commune-turing-wavelength-s0.py L177–L198" ;
        dct:description "dispersion_curve Pearson r and RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8c95fb91d41c76d640c8216d24030d8fd3768487/models/2026-delphi10000-dactylioceras-commune-turing-wavelength-s0.py#L177-L198> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dactylioceras-commune-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "datasets/dactylioceras_commune_turing_wavelength_s0/metrics.json L18–L54" ;
        dct:description "r = 0.99991, RMSE = 0.00095, lambda_c_um = 24.19" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8c95fb91d41c76d640c8216d24030d8fd3768487/datasets/dactylioceras_commune_turing_wavelength_s0/metrics.json#L18-L54> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 builder-assessor, loop 3159 pass 2" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0000-0000-0000> .
}


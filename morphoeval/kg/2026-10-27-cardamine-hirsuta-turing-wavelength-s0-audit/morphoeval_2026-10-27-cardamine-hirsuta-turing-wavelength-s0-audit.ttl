<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Schnakenberg Turing wavelength on Cardamine hirsuta at 154 µm (Pass 1) (Cardamine hirsuta (hairy bittercress))",
        "Schnakenberg Turing wavelength on Cardamine hirsuta at 154 µm (Pass 1) faithfully reproduces Cardamine hirsuta (hairy bittercress) morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-cardamine-hirsuta-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-cardamine-hirsuta-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-cardamine-hirsuta-turing-wavelength-s0-3> ;
    dct:description "The simulation script(s) models/2026-delphi10000-cardamine-hirsuta-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Cardamine hirsuta (hairy bittercress) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cardamine-hirsuta-turing-wavelength-s0.py> ;
    schema:about "Cardamine hirsuta (hairy bittercress)" ;
    schema:additionalProperty "does_not_claim: That a named fossil chronospecies precedes or follows this Holocene terminal (series 1/1, age 0 Ma).",
        "does_not_claim: That the nonlinear spacing of 173.4 µm falsifies or confirms a published Cardamine measurement.",
        "does_not_claim: That the whole-plant photograph resolves 154 µm ocelli.",
        "reconstructed_in_script: Neumann Schnakenberg integration, the dispersion fit, the diffusivity sweep, and the equal-diffusion ablation.",
        "reconstructed_in_script: Physical calibration that sets the classical wavelength equal to 154.1 µm.",
        "reconstructed_in_script: Pigment-ocellus readout of activator u inside the photographed leaf mask.",
        "reported_in_source: Fuster-Pons et al. (2024) describe a lateral-inhibition trichome pattern in Cardamine.",
        "reported_in_source: Kierzkowski et al. (2019) and Vlad et al. (2014) describe Cardamine hirsuta leaflet growth and the RCO domain-size difference from Arabidopsis.",
        "reported_in_source: Schnakenberg (1979) supplies the kinetics a - u + u^2 v and b - u^2 v.",
        "reported_in_source: Turing (1952) selects a finite critical wavenumber from reaction and diffusion.",
        "transfer_boundary: 154.1 µm is the slot scale assigned to the classical wavenumber, not a length quoted from the Cardamine papers.",
        "transfer_boundary: Trichome spacing is a related epidermal periodicity, not the pigment field drawn here." ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cardamine-hirsuta-turing-wavelength-s0.py; output: docs/media/cardamine_hirsuta_turing_wavelength_s0_comparison.png; organism: Cardamine hirsuta (hairy bittercress); environment: n/a; claim_boundary: [reported_in_source: Turing (1952) selects a finite critical wavenumber from reaction and diffusion. | Schnakenberg (1979) supplies the kinetics a - u + u^2 v and b - u^2 v. | Kierzkowski et al. (2019) and Vlad et al. (2014) describe Cardamine hirsuta leaflet growth and the RCO domain-size difference from Arabidopsis. | Fuster-Pons et al. (2024) describe a lateral-inhibition trichome pattern in Cardamine.; reconstructed_in_script: Neumann Schnakenberg integration, the dispersion fit, the diffusivity sweep, and the equal-diffusion ablation. | Physical calibration that sets the classical wavelength equal to 154.1 µm. | Pigment-ocellus readout of activator u inside the photographed leaf mask.; transfer_boundary: 154.1 µm is the slot scale assigned to the classical wavenumber, not a length quoted from the Cardamine papers. | Trichome spacing is a related epidermal periodicity, not the pigment field drawn here.; does_not_claim: That the whole-plant photograph resolves 154 µm ocelli. | That a named fossil chronospecies precedes or follows this Holocene terminal (series 1/1, age 0 Ma). | That the nonlinear spacing of 173.4 µm falsifies or confirms a published Cardamine measurement.]; phenomenon_size: 4.5 cm (0.045 m, log10=-1.347 m, tier=7_organism_cm); species_scale_ladder (1 runs from 4.5 cm to 4.5 cm): 4.5 cm:allometric-compound-leaf" ;
    pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cell.2019.05.011>,
        <https://doi.org/10.1093/plphys/kiae213>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1248384> ;
    pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-code-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-model-fidelity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-morphometric-validation>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-overall>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-repro-package>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-source-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-specimen-match> ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-27-cardamine-hirsuta-turing-wavelength-s0-audit-delphi10000-cardamine-hirsuta-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-cardamine-hirsuta-turing-wavelength-s0-audit-delphi10000-cardamine-hirsuta-turing-wavelength-s0-10>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-cardamine-hirsuta-turing-wavelength-s0-audit-delphi10000-cardamine-hirsuta-turing-wavelength-s0-11>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-cardamine-hirsuta-turing-wavelength-s0-audit-delphi10000-cardamine-hirsuta-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-cardamine-hirsuta-turing-wavelength-s0-audit-delphi10000-cardamine-hirsuta-turing-wavelength-s0-3>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-cardamine-hirsuta-turing-wavelength-s0-audit-delphi10000-cardamine-hirsuta-turing-wavelength-s0-4>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-cardamine-hirsuta-turing-wavelength-s0-audit-delphi10000-cardamine-hirsuta-turing-wavelength-s0-5>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-cardamine-hirsuta-turing-wavelength-s0-audit-delphi10000-cardamine-hirsuta-turing-wavelength-s0-6>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-cardamine-hirsuta-turing-wavelength-s0-audit-delphi10000-cardamine-hirsuta-turing-wavelength-s0-7>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-cardamine-hirsuta-turing-wavelength-s0-audit-delphi10000-cardamine-hirsuta-turing-wavelength-s0-8>,
        <https://w3id.org/delphi/resource/evidence/2026-10-27-cardamine-hirsuta-turing-wavelength-s0-audit-delphi10000-cardamine-hirsuta-turing-wavelength-s0-9> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:weightOfEvidence 8.02e-01 .


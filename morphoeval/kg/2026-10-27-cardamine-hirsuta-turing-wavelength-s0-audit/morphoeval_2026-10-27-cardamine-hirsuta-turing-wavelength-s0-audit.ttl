<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg Turing wavelength on Cardamine hirsuta at 154 µm (Pass 1) — Code-to-model traceability: 82/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Equation comments point at the wavenumber law, the Neumann integrator, and the dispersion fit. The Lean file proves the integer forms of those identities, including the Holocene terminal condition 1 - 1 = 0." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-code-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-code-traceability-2> ;
    pk:hasScore 8.2e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg Turing wavelength on Cardamine hirsuta at 154 µm (Pass 1) — Model fidelity to source: 82/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script implements Schnakenberg kinetics, the Jacobian at (u0, v0) = (1, 0.9), and k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v). Trace is negative and the squared Turing inequality holds. The pigment-ocellus reading of u is a reconstruction, so this is not a line-by-line reproduction of a Cardamine pigment paper." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 8.2e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cardamine-hirsuta-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;

        schema:name "12-species spiral angular rotation frequency correlation omega = omega_0 * v_inf / r_c" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-12-species-spiral-angular-rotation-frequency-correlation-omega-omega-0-v-inf-r-c-reference> .


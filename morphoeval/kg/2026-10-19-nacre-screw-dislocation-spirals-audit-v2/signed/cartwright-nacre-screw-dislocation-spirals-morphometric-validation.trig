sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-screw-dislocation-spirals> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-12-species-cross-taxa-bcf-spiral-terrace-wavelength-correlation-bivalvia-sheet-vs-gastropoda-cephalopoda-columnar-nacre> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-species cross-taxa BCF spiral terrace wavelength correlation (Bivalvia sheet vs Gastropoda/Cephalopoda columnar nacre) = 0.9999 Pearson r" ;
        dcterms:description "OLS slope lambda_0 / r_c = 18.99 ± 0.0724 vs theoretical 18.9848" ;
        schema:measurementTechnique "Correlation of predicted BCF wavelength (2*pi/omega_0)*r_c vs empirical terrace spacing across 12 bivalve, gastropod, and cephalopod species (RMSE=0.0421 um, p=1.60e-20)" ;
        schema:name "12-species cross-taxa BCF spiral terrace wavelength correlation (Bivalvia sheet vs Gastropoda/Cephalopoda columnar nacre)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-12-species-cross-taxa-bcf-spiral-terrace-wavelength-correlation-bivalvia-sheet-vs-gastropoda-cephalopoda-columnar-nacre-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-measurement-12-species-cross-taxa-bcf-spiral-terrace-wavelength-correlation-bivalvia-sheet-vs-gastropoda-cephalopoda-columnar-nacre-reference> a schema:PropertyValue ;

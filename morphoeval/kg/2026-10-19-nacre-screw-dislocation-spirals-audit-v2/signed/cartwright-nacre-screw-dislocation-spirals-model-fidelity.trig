sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-screw-dislocation-spirals> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2019-cartwright-nacre-screw-dislocation-spirals.py L190–L500" ;
        dcterms:description "2D chiral dislocation spiral/target solver and 3D chitin mineral-bridge Voronoi coalescence solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2019-cartwright-nacre-screw-dislocation-spirals.py#L190-L500> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_078_nacre_screw_dislocation_spirals.lean L24–L115" ;
        dcterms:description "3 Lean 4 theorems proving BCF Gibbs-Thomson wavelength scaling, Frank-Read target loop nucleation, and chitin mineral-bridge columnar vs sheet transition" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_078_nacre_screw_dislocation_spirals.lean#L24-L115> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007), Cartwright et al. (2009) & BCF (1951) nacre screw-dislocation spirals, Frank-Read target loops, and chitin pore mineral-bridge columnar vs sheet transition — Model fidelity to source: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements 2D multi-dislocation phase-field / eikonal step-flow and 3D chitin interlamellar mineral-bridge & Voronoi tablet coalescence solvers (`simulate_chiral_dislocation_terrace_2d`, L190-360; `simulate_nacre_architecture_and_voronoi`, L405-500) covering sub-saturated arrest (Delta_mu <= 0), subcritical dipole pinch-off (d <= 2*r_c), single-screw Archimedean spirals, supercritical opposite-handedness (+1, -1) Frank-Read target terraces, and *Haliotis* columnar vs *Pteria* sheet nacre stacks. Backed by 3 machine-checked Lean 4 theorems in `Loop_078_nacre_screw_dislocation_spirals.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-model-fidelity-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-screw-dislocation-spirals> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007), Cartwright et al. (2009) & BCF (1951) nacre screw-dislocation spirals, Frank-Read target loops, and chitin pore mineral-bridge columnar vs sheet transition — Reproducibility package: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Deterministic execution (`seed=2019`), 8-check `self_test()` suite (L1020-1082) supporting both `--self-test` and `--verify-only`, verifying SHA-256 provenance, JSON parity, Gibbs-Thomson critical & sub-saturated arrest, 5 morphospace regimes and topological winding numbers, chitin mineral-bridge columnar vs sheet stacking margin and Voronoi Z=6 coordination, supersaturation & 12-species scaling, SEM segmentation, and bitwise two-run determinism (`np.allclose(..., atol=0.0)`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-repro-package-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2019-cartwright-nacre-screw-dislocation-spirals.py L1020–L1082" ;
        dcterms:description "8-check self_test() suite including bitwise 2D determinism and JSON parity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2019-cartwright-nacre-screw-dislocation-spirals.py#L1020-L1082> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


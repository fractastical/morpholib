sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-screw-dislocation-spirals> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007), Cartwright et al. (2009) & BCF (1951) nacre screw-dislocation spirals, Frank-Read target loops, and chitin pore mineral-bridge columnar vs sheet transition — Parameter expressivity: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates all 5 nacre morphospace and negative-control regimes (`evaluate_all_morphospace_regimes`, L503-536), sweeps chemical supersaturation `Delta_mu / k_B T` across 11 regimes including sub-saturated and equilibrium controls, evaluates 12 species across Bivalvia, Gastropoda, and Cephalopoda, and exposes `--v-inf`, `--r-c`, `--h-0`, `--dipole-d`, `--seed`, `--skip-gif`, `--self-test`, and `--verify-only` CLI flags." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-parameter-expressivity-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2019-cartwright-nacre-screw-dislocation-spirals.py L503–L590" ;
        dct:description "5 morphospace regimes, 11-point supersaturation sweep, and 12-species cross-taxa evaluation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2019-cartwright-nacre-screw-dislocation-spirals.py#L503-L590> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2019-cartwright-nacre-screw-dislocation-spirals.py L1085–L1125" ;
        dct:description "CLI parameter overrides wired into render_comparison_figure()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2019-cartwright-nacre-screw-dislocation-spirals.py#L1085-L1125> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


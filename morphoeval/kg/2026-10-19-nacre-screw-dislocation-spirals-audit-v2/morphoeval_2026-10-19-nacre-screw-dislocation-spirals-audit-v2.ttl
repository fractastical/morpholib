<https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Cartwright & Checa (2007), Cartwright et al. (2009) & BCF (1951) nacre screw-dislocation spirals, Frank-Read target loops, and chitin pore mineral-bridge columnar vs sheet transition — Model fidelity to source: 93/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Implements 2D multi-dislocation phase-field / eikonal step-flow and 3D chitin interlamellar mineral-bridge & Voronoi tablet coalescence solvers (`simulate_chiral_dislocation_terrace_2d`, L190-360; `simulate_nacre_architecture_and_voronoi`, L405-500) covering sub-saturated arrest (Delta_mu <= 0), subcritical dipole pinch-off (d <= 2*r_c), single-screw Archimedean spirals, supercritical opposite-handedness (+1, -1) Frank-Read target terraces, and *Haliotis* columnar vs *Pteria* sheet nacre stacks. Backed by 3 machine-checked Lean 4 theorems in `Loop_078_nacre_screw_dislocation_spirals.lean`." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-model-fidelity-1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-screw-dislocation-spirals-model-fidelity-2> ;
    pk:hasScore 9.3e-01 ;
    pk:hasVerdict "faithful" .


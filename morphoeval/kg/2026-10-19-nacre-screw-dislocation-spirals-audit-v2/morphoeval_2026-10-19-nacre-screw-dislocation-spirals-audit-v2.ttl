<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/cartwright-nacre-screw-dislocation-spirals-1>,
        <https://w3id.org/probknow/resource/math-law/cartwright-nacre-screw-dislocation-spirals-2>,
        <https://w3id.org/probknow/resource/math-law/cartwright-nacre-screw-dislocation-spirals-3> .

<https://w3id.org/probknow/resource/math-law/cartwright-nacre-screw-dislocation-spirals-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Burton-Cabrera-Frank (1951) Gibbs-Thomson Step Velocity & Supersaturation Terrace Spacing Scaling Law" ;
    dct:description "Arrests curved step propagation at r = r_c and scales spiral terrace wavelength λ_0 ≈ 19 r_c inversely with supersaturation Δμ across molluscan nacre | Variables: v(κ): normal step velocity; v_∞: planar step speed; r_c = γ Ω / Δμ: critical nucleation radius; Δμ: chemical supersaturation; λ_0: Archimedean spiral terrace wavelength" ;
    dct:source "Burton, Cabrera & Frank (1951) Phil. Trans. R. Soc. A 243:299-358; Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 Sec. 2-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/2019-cartwright-nacre-screw-dislocation-spirals.py#L140-L260>,
        <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_078_nacre_screw_dislocation_spirals.lean#L24-L53> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def gibbs_thomson_step_velocity_num (v_inf r r_c : Int) : Int :=
  v_inf * (r - r_c)
def bcf_terrace_wavelength (r_c : Int) : Int := 19 * r_c
theorem bcf_gibbs_thompson_terrace_spacing (v_inf r_c r_c2 : Int) (dr_c : Nat) :
    gibbs_thomson_step_velocity_num v_inf r_c r_c = 0 ∧
    bcf_terrace_wavelength r_c2 < bcf_terrace_wavelength (r_c2 + Int.ofNat (dr_c + 1)) := by
  dsimp [gibbs_thomson_step_velocity_num, bcf_terrace_wavelength]; omega
"""^^pk:lean4 ;
    skos:notation "v(κ) = v_∞ (1 - r_c κ),  r_c = γ Ω / Δμ  ⇒  λ_0 = 19 r_c = 19 γ Ω / Δμ  (strictly decreasing with Δμ_2 > Δμ_1 > 0)" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0900867106>,
        <https://doi.org/10.1098/rsif.2006.0188>,
        <https://doi.org/10.1098/rsta.1951.0006>,
        <https://doi.org/10.1098/rsta.2011.0600> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Burton-Cabrera-Frank (BCF) Screw-Dislocation Aragonite Nacre Terraces, Frank-Read Target Loops & Chitin Mineral-Bridge Columnar vs Sheet Transition" ;
    pk:leanDeclaration "MathOfBiology.Loop_078.bcf_terrace_wavelength" ;
    pk:leanTheorem "MathOfBiology.Loop_078.bcf_gibbs_thompson_terrace_spacing" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/cartwright-nacre-screw-dislocation-spirals-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Cartwright et al. (2009) Opposite-Handedness (+1, -1) Frank-Read Dipole Annihilation & Closed Target-Loop Law" ;
    dct:description "Governs topological recombination of counter-rotating spiral arms into closed concentric target loops when d > 2 r_c and subcritical pinch-off failure when d < 2 r_c | Variables: b_1 = +1, b_2 = -1: opposite-handedness screw dislocation Burgers vectors; B_tot: far-field topological Burgers charge; d: inter-core dipole separation; 2 r_c: critical nucleation diameter" ;
    dct:source "Cartwright, Checa, Escribano & Sainz-Díaz (2009) PNAS 106(26):10499-10504 Figs. 1-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/2019-cartwright-nacre-screw-dislocation-spirals.py#L265-L420>,
        <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_078_nacre_screw_dislocation_spirals.lean#L59-L83> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def total_burgers_charge (b_1 b_2 : Int) : Int := b_1 + b_2
def frank_read_dipole_clearance (d r_c : Int) : Int := d - 2 * r_c
theorem frank_read_dipole_target_loop_nucleation (b r_c : Int) (dd : Nat) :
    total_burgers_charge 1 (-1) = 0 ∧
    frank_read_dipole_clearance (2 * r_c + Int.ofNat (dd + 1)) r_c > 0 ∧
    frank_read_dipole_clearance (2 * r_c - Int.ofNat (dd + 1)) r_c < 0 := by
  dsimp [total_burgers_charge, frank_read_dipole_clearance]; omega
"""^^pk:lean4 ;
    skos:notation "B_tot = (+1) + (-1) = 0;  d > 2 r_c ⇒ closed concentric target terraces;  d ≤ 2 r_c ⇒ pinch-off failure" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0900867106>,
        <https://doi.org/10.1098/rsif.2006.0188>,
        <https://doi.org/10.1098/rsta.1951.0006>,
        <https://doi.org/10.1098/rsta.2011.0600> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Burton-Cabrera-Frank (BCF) Screw-Dislocation Aragonite Nacre Terraces, Frank-Read Target Loops & Chitin Mineral-Bridge Columnar vs Sheet Transition" ;
    pk:leanDeclaration "MathOfBiology.Loop_078.frank_read_dipole_clearance" ;
    pk:leanTheorem "MathOfBiology.Loop_078.frank_read_dipole_target_loop_nucleation" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/cartwright-nacre-screw-dislocation-spirals-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Cartwright & Checa (2007) Chitin Interlamellar Pore Mineral-Bridge Columnar vs Sheet Nacre Transition Law" ;
    dct:description "Separates gastropod (Haliotis rufescens) coaxial columnar tablet stacks nucleated through aligned vertical chitin mineral bridges from bivalve (Pteria, Pinctada) terraced sheet nacre | Variables: D_tab: aragonite tablet diameter before coalescence; λ_0: spiral terrace wavelength; N_off: off-axis interlamellar chitin pore dispersion factor" ;
    dct:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 Sec. 4 & Figs. 7-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/2019-cartwright-nacre-screw-dislocation-spirals.py#L425-L530>,
        <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_078_nacre_screw_dislocation_spirals.lean#L89-L115> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def nacre_columnar_stacking_margin (d_tab lam_0 n_off : Int) : Int :=
  d_tab - lam_0 * n_off
theorem cartwright_columnar_vs_sheet_nacre_transition (d_tab lam_0 : Int) :
    nacre_columnar_stacking_margin 78 36 1 = 42 ∧
    nacre_columnar_stacking_margin 42 80 2 = -118 := by
  dsimp [nacre_columnar_stacking_margin]; omega
"""^^pk:lean4 ;
    skos:notation "I_col = D_tab - λ_0 N_off:  I_col > 0 (aligned vertical mineral bridges, tight λ_0) ⇒ Haliotis columnar stacks;  I_col < 0 (dispersed pores, broad λ_0) ⇒ bivalve sheet nacre" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0900867106>,
        <https://doi.org/10.1098/rsif.2006.0188>,
        <https://doi.org/10.1098/rsta.1951.0006>,
        <https://doi.org/10.1098/rsta.2011.0600> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Burton-Cabrera-Frank (BCF) Screw-Dislocation Aragonite Nacre Terraces, Frank-Read Target Loops & Chitin Mineral-Bridge Columnar vs Sheet Transition" ;
    pk:leanDeclaration "MathOfBiology.Loop_078.nacre_columnar_stacking_margin" ;
    pk:leanTheorem "MathOfBiology.Loop_078.cartwright_columnar_vs_sheet_nacre_transition" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-screw-dislocation-spirals> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-overall> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-screw-dislocation-spirals-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007), Cartwright et al. (2009) & BCF (1951) nacre screw-dislocation spirals, Frank-Read target loops, and chitin pore mineral-bridge columnar vs sheet transition — MorphoEval overall 91.8/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Pass 2 (v2) remediated evaluation of `2019-cartwright-nacre-screw-dislocation-spirals.py` (consensus score 91.8/100, up from 52.8/100 in Pass 1). The remediated script implements a 2D phase-field / excitable BCF spiral wave and chitin mineral-bridge solver across all 5 nacre morphospace and negative-control regimes: sub-saturated arrest (Delta_mu <= 0 -> 0 terraces), subcritical Frank-Read dipole pinch-off (d <= 2*r_c -> 0 terraces), single screw-dislocation Archimedean spiral (b=+1, lambda_0=7.9736 um), supercritical opposite-charge Frank-Read closed target terraces (b_1=+1, b_2=-1, d > 2*r_c, B_tot=0), and gastropod (*Haliotis rufescens*) aligned chitin mineral-bridge columnar stacks and Voronoi polygonal tablet coalescence (Z=6.0000), validates terrace wavelength scaling across chemical supersaturation (r=0.9999) and 12 molluscan species (r=0.9999, slope=18.9950), and segments the SEM mother-of-pearl specimen (h_0=0.5000 um, Z=5.9625, aspect=3.2436), backed by 3 machine-checked Lean 4 theorems. Overall 91.8/100 (faithfulness 91.6, reproducibility 92.3); rubric morphoeval 0.1.0; checkpoint commit HEAD; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1. Dimension assessments: Model fidelity to source 93, Morphological realism / specimen match 90, Parameter expressivity 91, Morphometric validation 93, Source and data traceability 94, Code-to-model traceability 92, Reproducibility package 91. Output judged: docs/media/nacre_screw_dislocation_spirals_comparison.png: rendered output of 2019-cartwright-nacre-screw-dislocation-spirals.py at HEAD, image/png, 1419767 B, 2199×1495 px, artifact_sha256 a14a1aa97a4352b3020ec5d0544870fd4b3cb74e1f86f680d28caa5f56121ffd (sha256 a14a1aa97a4352b3020ec5d0544870fd4b3cb74e1f86f680d28caa5f56121ffd), spec_fingerprint d2c5586744b4a1dd453b702e1ae3b35d30b5d54166476472d0304e0d22c70b82. Dual provenance: spec_fingerprint: d2c5586744b4a1dd453b702e1ae3b35d30b5d54166476472d0304e0d22c70b82; artifact_sha256: a14a1aa97a4352b3020ec5d0544870fd4b3cb74e1f86f680d28caa5f56121ffd; input_dataset_sha256: {datasets/nacre_screw_dislocation_spirals/haliotis_nacre_spirals_specimen.jpg=e4c6590464523f21..., datasets/nacre_screw_dislocation_spirals/nacre_screw_dislocation_spirals_reference.json=9de7ae07e42d2993..., datasets/nacre_screw_dislocation_spirals/paper_citations.bib=3df311760cfbb299..., datasets/nacre_screw_dislocation_spirals/scout_manifest.json=22cd8415a0587395...}. Supersedes audit: 2026-10-19-nacre-screw-dislocation-spirals-audit." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Couple the 2D BCF spiral and target step-flow dynamics to full 3D liquid-crystal cholesteric chitin-fibroin precursor self-assembly (Cartwright et al. 2009).",
            "remediation needed: Include crystal-plasticity fracture toughness modeling of brick-and-mortar aragonite tablet sliding under tensile loading." ;
        pk:hasScore "0.918"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


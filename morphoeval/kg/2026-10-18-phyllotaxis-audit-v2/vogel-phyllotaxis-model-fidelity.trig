sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-vogel-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-vogel-phyllotaxis-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-vogel-phyllotaxis-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis — Model fidelity to source: 86/100" ;
        dct:date "2026-10-18"^^xsd:date ;
        dct:description "Vogel's (1979) planar spiral law, rising Fibonacci parastichy cascade (8,13)->(13,21)->(21,34)->(34,55), Lucas (29,47)->(47,76) branch, and bijugate 2*(21,34) = (42,68) whorls are reproduced and verified by Delaunay contact-graph topology. Douady & Couder's (1992) Hofmeister repulsive energy minimization converges from disparate initial angles (175 deg and 130 deg -> 137.59 deg; 99.8 deg -> 99.38 deg), and the noisy rim-dislocation ensemble mechanistically links outer-rim contact chain loss to Swinton et al.'s (2016) Fib-1 > Fib+1 grain-defect bias." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-model-fidelity-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1979-vogel-phyllotaxis.py L110–L154" ;
        dct:description "vogel_spiral(): exact planar spiral and multijugate whorl generator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L110-L154> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1979-vogel-phyllotaxis.py L383–L441" ;
        dct:description "simulate_douady_couder_hofmeister(): Hofmeister repulsive energy minimization" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L383-L441> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "1979-vogel-phyllotaxis.py L470–L562" ;
        dct:description "simulate_swinton_dislocation_ensemble(): rim contact-chain loss mechanism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L470-L562> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (remediation verification)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0024>,
            <https://doi.org/10.1016/0025-5564(79)90080-4>,
            <https://doi.org/10.1098/rsos.160091>,
            <https://doi.org/10.1103/PhysRevLett.68.2098>,
            <https://www.cambridge.org/9780521404822> .
    <https://doi.org/10.1006/jtbi.1996.0024> dct:date "1996"^^xsd:gYear ;
        dct:title "Phyllotaxis as a Dynamical Self Organizing Process Part I: The Spiral Modes Resulting from Time-Periodic Iterations" .
    <https://doi.org/10.1016/0025-5564(79)90080-4> dct:date "1979"^^xsd:gYear ;
        dct:title "A better way to construct the sunflower head" .
    <https://doi.org/10.1098/rsos.160091> dct:date "2016"^^xsd:gYear ;
        dct:title "Novel Fibonacci and non-Fibonacci structure in the sunflower: results of a citizen science experiment" .
    <https://doi.org/10.1103/PhysRevLett.68.2098> dct:date "1992"^^xsd:gYear ;
        dct:title "Phyllotaxis as a physical self-organized growth process" .
    <https://www.cambridge.org/9780521404822> dct:date "1994"^^xsd:gYear ;
        dct:title "Phyllotaxis: A Systemic Study in Plant Morphogenesis" .
}


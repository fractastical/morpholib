    <https://doi.org/10.1016/0025-5564(79)90080-4> dcterms:date "1979"^^xsd:gYear ;
        dcterms:title "A better way to construct the sunflower head" .

    <https://doi.org/10.1098/rsos.160091> dcterms:date "2016"^^xsd:gYear ;
        dcterms:title "Novel Fibonacci and non-Fibonacci structure in the sunflower: results of a citizen science experiment" .

    <https://doi.org/10.1103/PhysRevLett.68.2098> dcterms:date "2098"^^xsd:gYear ;
        dcterms:title "Phyllotaxis as a physical self-organized growth process" .


}

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-18-phyllotaxis-audit-v2-vogel-phyllotaxis-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis — Source and data traceability: 90/100" ;
        rdfs:comment "All primary and historical sources (Vogel 1979, Douady & Couder 1992/1996, Swinton et al. 2016, Dryad dataset 10.5061/dryad.f9k77, Schoute 1938, Weisse 1897, Jean 1994, and both Wikimedia Commons specimen photographs) are cited in `datasets/phyllotaxis/paper_citations.bib` and locked by SHA-256 digests verified on every run of `--self-test`. Evidence: 1979-vogel-phyllotaxis.py L586–L596: SHA-256 verification of phyllotaxis_reference.json and both specimen JPEGs <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L586-L596>; datasets/phyllotaxis/paper_citations.bib L1–L88: Complete BibTeX entries for primary papers, historical surveys, Dryad, and Commons assets <https://github.com/fractastical/morpholib/blob/c89d18d/datasets/phyllotaxis/paper_citations.bib#L1-L88>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-vogel-phyllotaxis-source-traceability> ;
        pk:hasProbability "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-vogel-phyllotaxis-source-traceability> rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis (1979-vogel-phyllotaxis.py, docs/media/vogel_phyllotaxis_growth.gif, vogel_phyllotaxis_metrics.csv) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Helianthus annuus (sunflower capitulum)" ;
        dcterms:identifier "morphoeval/0.1.0/source-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (remediation verification)" .
}


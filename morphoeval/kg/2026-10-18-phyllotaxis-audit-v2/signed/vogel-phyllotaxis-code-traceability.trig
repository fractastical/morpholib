sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-18-phyllotaxis-audit-v2-vogel-phyllotaxis-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis — Code-to-model traceability: 88/100" ;
        rdfs:comment "Every code-to-label discrepancy noted by the second assessor in v1 has been eliminated: Panel C and Panel E format their labels directly from the computed dictionary values, Sunflower 171 is verified on its exact (47, 76) outer-zone Lucas pair, and `classify_parastichy_number()` cleanly separates `Fibonacci + 1` (14) from `F4` (9, 23, 37, 60, 97). Evidence: 1979-vogel-phyllotaxis.py L614–L626: Exact verification of Lucas (29,47)->(47,76) and Bijugate (26,42)->(42,68) zones <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L614-L626>; 1979-vogel-phyllotaxis.py L969–L994: Panel E legend dynamically formatted from simulation dictionary <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L969-L994>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-vogel-phyllotaxis-code-traceability> ;
        pk:hasProbability "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-vogel-phyllotaxis-code-traceability> rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis (1979-vogel-phyllotaxis.py, docs/media/vogel_phyllotaxis_growth.gif, vogel_phyllotaxis_metrics.csv) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Helianthus annuus (sunflower capitulum)" ;
        dcterms:identifier "morphoeval/0.1.0/code-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (remediation verification)" .
}


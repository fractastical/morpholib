sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-18-phyllotaxis-audit-v2-vogel-phyllotaxis-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis — Model fidelity to source: 86/100" ;
        rdfs:comment "Vogel's (1979) planar spiral law, rising Fibonacci parastichy cascade (8,13)->(13,21)->(21,34)->(34,55), Lucas (29,47)->(47,76) branch, and bijugate 2*(21,34) = (42,68) whorls are reproduced and verified by Delaunay contact-graph topology. Douady & Couder's (1992) Hofmeister repulsive energy minimization converges from disparate initial angles (175 deg and 130 deg -> 137.59 deg; 99.8 deg -> 99.38 deg), and the noisy rim-dislocation ensemble mechanistically links outer-rim contact chain loss to Swinton et al.'s (2016) Fib-1 > Fib+1 grain-defect bias. Evidence: 1979-vogel-phyllotaxis.py L110–L154: vogel_spiral(): exact planar spiral and multijugate whorl generator <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L110-L154>; 1979-vogel-phyllotaxis.py L383–L441: simulate_douady_couder_hofmeister(): Hofmeister repulsive energy minimization <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L383-L441>; 1979-vogel-phyllotaxis.py L470–L562: simulate_swinton_dislocation_ensemble(): rim contact-chain loss mechanism <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L470-L562>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-vogel-phyllotaxis-model-fidelity> ;
        pk:hasProbability "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-vogel-phyllotaxis-model-fidelity> rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis (1979-vogel-phyllotaxis.py, docs/media/vogel_phyllotaxis_growth.gif, vogel_phyllotaxis_metrics.csv) satisfies the MorphoEval 0.1.0 criterion 'Model fidelity to source' for Helianthus annuus (sunflower capitulum)" ;
        dcterms:identifier "morphoeval/0.1.0/model-fidelity" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (remediation verification)" .
}


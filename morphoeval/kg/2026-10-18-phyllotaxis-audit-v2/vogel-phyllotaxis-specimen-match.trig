sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-vogel-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-vogel-phyllotaxis-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-vogel-phyllotaxis-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis — Morphological realism / specimen match: 84/100" ;
        dct:date "2026-10-18"^^xsd:date ;
        dct:description "Panel A segments 621 florets directly from `helianthus_annuus_capitulum_specimen.jpg` via Difference-of-Gaussians filtering and measures 402 bounded interior Voronoi cells (mean circularity 0.7934 vs 0.8525 in the ideal Vogel lattice and 0.7045 in the 137.3 deg control). Panel F compares all 6 parastichy categories against Swinton et al. (2016) Table 1 (N=768 photoreviewed counts) and Schoute (1938, N=319), achieving Pearson r = 0.9950 and reproducing Fib-1 (68) > Fib+1 (22) (p = 6.25e-7)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-specimen-match-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1979-vogel-phyllotaxis.py L310–L377" ;
        dct:description "segment_specimen_photograph(): DoG floret centroid segmentation & Voronoi circularity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L310-L377> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "1979-vogel-phyllotaxis.py L754–L799" ;
        dct:description "Panel A overlays 621 segmented florets on real Helianthus capitulum photo" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L754-L799> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "vogel_phyllotaxis_comparison.png (generated output)" ;
        dct:description "6-panel comparison figure with segmented florets and Swinton survey match — vogel_phyllotaxis_comparison.png: rendered output of 1979-vogel-phyllotaxis.py at c89d18d, image/png, 2217939 B, 2960×1840 px, artifact_sha256 3ab57a6be31aab64ec4cfa6db34f77b8f19cb2744a812f3fba01a6c8f26f1c3c (sha256 3ab57a6be31aab64ec4cfa6db34f77b8f19cb2744a812f3fba01a6c8f26f1c3c), spec_fingerprint 5df8c2b4cc4b9b4a86ea26aace00ebd26df8456a62d99c23287ddcea2644e06c" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (remediation verification)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


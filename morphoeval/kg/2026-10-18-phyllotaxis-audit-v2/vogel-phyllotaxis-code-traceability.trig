sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-vogel-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-vogel-phyllotaxis-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-vogel-phyllotaxis-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis — Code-to-model traceability: 88/100" ;
        dct:date "2026-10-18"^^xsd:date ;
        dct:description "Every code-to-label discrepancy noted by the second assessor in v1 has been eliminated: Panel C and Panel E format their labels directly from the computed dictionary values, Sunflower 171 is verified on its exact (47, 76) outer-zone Lucas pair, and `classify_parastichy_number()` cleanly separates `Fibonacci + 1` (14) from `F4` (9, 23, 37, 60, 97)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-code-traceability-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1979-vogel-phyllotaxis.py L614–L626" ;
        dct:description "Exact verification of Lucas (29,47)->(47,76) and Bijugate (26,42)->(42,68) zones" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L614-L626> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1979-vogel-phyllotaxis.py L969–L994" ;
        dct:description "Panel E legend dynamically formatted from simulation dictionary" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L969-L994> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (remediation verification)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0024>,
            <https://doi.org/10.1016/0025-5564(79)90080-4>,
            <https://doi.org/10.1098/rsos.160091>,
            <https://doi.org/10.1103/PhysRevLett.68.2098>,
            <https://www.cambridge.org/9780521404822> .
    <https://doi.org/10.1006/jtbi.1996.0024> dct:date "1996"^^xsd:gYear ;
        dct:title "Phyllotaxis as a Dynamical Self Organizing Process Part I: The Spiral Modes Resulting from Time-Periodic Iterations" .
    <https://doi.org/10.1016/0025-5564(79)90080-4> dct:date "1979"^^xsd:gYear ;
        dct:title "A better way to construct the sunflower head" .
    <https://doi.org/10.1098/rsos.160091> dct:date "2016"^^xsd:gYear ;
        dct:title "Novel Fibonacci and non-Fibonacci structure in the sunflower: results of a citizen science experiment" .
    <https://doi.org/10.1103/PhysRevLett.68.2098> dct:date "1992"^^xsd:gYear ;
        dct:title "Phyllotaxis as a physical self-organized growth process" .
    <https://www.cambridge.org/9780521404822> dct:date "1994"^^xsd:gYear ;
        dct:title "Phyllotaxis: A Systemic Study in Plant Morphogenesis" .
}


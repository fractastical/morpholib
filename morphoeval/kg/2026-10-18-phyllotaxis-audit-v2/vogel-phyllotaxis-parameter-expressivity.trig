sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-vogel-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-vogel-phyllotaxis-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-vogel-phyllotaxis-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis — Parameter expressivity: 82/100" ;
        dct:date "2026-10-18"^^xsd:date ;
        dct:description "Sweeps divergence angle alpha across [136.6, 138.4] deg plus Lucas (99.502 deg), rational (120.0 deg), and bijugate (J=2) regimes, plastochron schedule G(n) across [0.65, 0.04], floret count N across [30, 600] in the growth animation, and angular/radial noise in the 384-head dislocation ensemble." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-parameter-expressivity-2> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1979-vogel-phyllotaxis.py L856–L922" ;
        dct:description "Panel C 2x2 sensitivity grid with dynamically computed NND CV labels" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L856-L922> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1979-vogel-phyllotaxis.py L927–L960" ;
        dct:description "Panel D alpha resonance scan across 76 angles" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L927-L960> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (remediation verification)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0024>,
            <https://doi.org/10.1016/0025-5564(79)90080-4>,
            <https://doi.org/10.1098/rsos.160091>,
            <https://doi.org/10.1103/PhysRevLett.68.2098>,
            <https://www.cambridge.org/9780521404822> .
    <https://doi.org/10.1006/jtbi.1996.0024> dct:date "1996"^^xsd:gYear ;
        dct:title "Phyllotaxis as a Dynamical Self Organizing Process Part I: The Spiral Modes Resulting from Time-Periodic Iterations" .
    <https://doi.org/10.1016/0025-5564(79)90080-4> dct:date "1979"^^xsd:gYear ;
        dct:title "A better way to construct the sunflower head" .
    <https://doi.org/10.1098/rsos.160091> dct:date "2016"^^xsd:gYear ;
        dct:title "Novel Fibonacci and non-Fibonacci structure in the sunflower: results of a citizen science experiment" .
    <https://doi.org/10.1103/PhysRevLett.68.2098> dct:date "1992"^^xsd:gYear ;
        dct:title "Phyllotaxis as a physical self-organized growth process" .
    <https://www.cambridge.org/9780521404822> dct:date "1994"^^xsd:gYear ;
        dct:title "Phyllotaxis: A Systemic Study in Plant Morphogenesis" .
}


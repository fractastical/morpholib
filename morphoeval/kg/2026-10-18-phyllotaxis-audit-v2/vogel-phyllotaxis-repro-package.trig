sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-vogel-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-vogel-phyllotaxis-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-vogel-phyllotaxis-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis — Reproducibility package: 88/100" ;
        dct:date "2026-10-18"^^xsd:date ;
        dct:description "Deterministic RNG seeds (`1979`, `2016`, `42`), fast `--self-test` (<1.5 s), explicit virtualenv invocation instructions in docstring, SHA-256 locks on all input JSON/JPEG files, and SHA-256 digest reporting for all generated PNG, GIF, and CSV artifacts." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-repro-package-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1979-vogel-phyllotaxis.py L1247–L1277" ;
        dct:description "CLI entrypoint running self-tests first and printing output SHA-256 digests" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L1247-L1277> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/vogel_phyllotaxis_growth.gif (generated output)" ;
        dct:description "27-frame centripetal growth animation — docs/media/vogel_phyllotaxis_growth.gif: rendered output of 1979-vogel-phyllotaxis.py at c89d18d, image/gif, 877508 B, 1120×540 px, 27 frames, artifact_sha256 8e8d60ceff1e2574ef41906e7f2dabc2a47ce15029dc16d80519dcee4f693897 (sha256 8e8d60ceff1e2574ef41906e7f2dabc2a47ce15029dc16d80519dcee4f693897), spec_fingerprint 5df8c2b4cc4b9b4a86ea26aace00ebd26df8456a62d99c23287ddcea2644e06c" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (remediation verification)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-18-phyllotaxis-audit-v2-vogel-phyllotaxis-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis — Reproducibility package: 88/100" ;
        rdfs:comment "Deterministic RNG seeds (`1979`, `2016`, `42`), fast `--self-test` (<1.5 s), explicit virtualenv invocation instructions in docstring, SHA-256 locks on all input JSON/JPEG files, and SHA-256 digest reporting for all generated PNG, GIF, and CSV artifacts. Evidence: 1979-vogel-phyllotaxis.py L1247–L1277: CLI entrypoint running self-tests first and printing output SHA-256 digests <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L1247-L1277>; docs/media/vogel_phyllotaxis_growth.gif (generated output, not in repo): 27-frame centripetal growth animation — docs/media/vogel_phyllotaxis_growth.gif: rendered output of 1979-vogel-phyllotaxis.py at c89d18d, image/gif, 877508 B, 1120×540 px, 27 frames, artifact_sha256 8e8d60ceff1e2574ef41906e7f2dabc2a47ce15029dc16d80519dcee4f693897 (sha256 8e8d60ceff1e2574ef41906e7f2dabc2a47ce15029dc16d80519dcee4f693897), spec_fingerprint 5df8c2b4cc4b9b4a86ea26aace00ebd26df8456a62d99c23287ddcea2644e06c." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-vogel-phyllotaxis-repro-package> ;
        pk:hasProbability "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-vogel-phyllotaxis-repro-package> rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis (1979-vogel-phyllotaxis.py, docs/media/vogel_phyllotaxis_growth.gif, vogel_phyllotaxis_metrics.csv) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Helianthus annuus (sunflower capitulum)" ;
        dct:identifier "morphoeval/0.1.0/repro-package" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (remediation verification)" .
}


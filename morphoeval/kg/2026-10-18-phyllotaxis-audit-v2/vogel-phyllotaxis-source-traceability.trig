sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-vogel-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-vogel-phyllotaxis-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-vogel-phyllotaxis-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis — Source and data traceability: 90/100" ;
        dct:date "2026-10-18"^^xsd:date ;
        dct:description "All primary and historical sources (Vogel 1979, Douady & Couder 1992/1996, Swinton et al. 2016, Dryad dataset 10.5061/dryad.f9k77, Schoute 1938, Weisse 1897, Jean 1994, and both Wikimedia Commons specimen photographs) are cited in `datasets/phyllotaxis/paper_citations.bib` and locked by SHA-256 digests verified on every run of `--self-test`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-source-traceability-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1979-vogel-phyllotaxis.py L586–L596" ;
        dct:description "SHA-256 verification of phyllotaxis_reference.json and both specimen JPEGs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L586-L596> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/phyllotaxis/paper_citations.bib L1–L88" ;
        dct:description "Complete BibTeX entries for primary papers, historical surveys, Dryad, and Commons assets" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/datasets/phyllotaxis/paper_citations.bib#L1-L88> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (remediation verification)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0024>,
            <https://doi.org/10.1016/0025-5564(79)90080-4>,
            <https://doi.org/10.1098/rsos.160091>,
            <https://doi.org/10.1103/PhysRevLett.68.2098>,
            <https://www.cambridge.org/9780521404822> .
    <https://doi.org/10.1006/jtbi.1996.0024> dct:date "1996"^^xsd:gYear ;
        dct:title "Phyllotaxis as a Dynamical Self Organizing Process Part I: The Spiral Modes Resulting from Time-Periodic Iterations" .
    <https://doi.org/10.1016/0025-5564(79)90080-4> dct:date "1979"^^xsd:gYear ;
        dct:title "A better way to construct the sunflower head" .
    <https://doi.org/10.1098/rsos.160091> dct:date "2016"^^xsd:gYear ;
        dct:title "Novel Fibonacci and non-Fibonacci structure in the sunflower: results of a citizen science experiment" .
    <https://doi.org/10.1103/PhysRevLett.68.2098> dct:date "1992"^^xsd:gYear ;
        dct:title "Phyllotaxis as a physical self-organized growth process" .
    <https://www.cambridge.org/9780521404822> dct:date "1994"^^xsd:gYear ;
        dct:title "Phyllotaxis: A Systemic Study in Plant Morphogenesis" .
}


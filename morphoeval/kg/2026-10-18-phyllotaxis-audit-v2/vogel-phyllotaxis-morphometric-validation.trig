        schema:measurementTechnique "Voronoi polygon area dispersion across interior florets (0.18 R_max <= r <= 0.85 R_max, N=450)" ;
        schema:name "Voronoi cell area CV at golden angle (137.5078°)" ;
        schema:unitText "CV (std/mean)" ;
        schema:value "0.0072" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-voronoi-cell-area-cv-at-golden-angle-137-5078-reference> .

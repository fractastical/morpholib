sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-vogel-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-vogel-phyllotaxis-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-vogel-phyllotaxis-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis — Morphometric validation: 86/100" ;
        dct:date "2026-10-18"^^xsd:date ;
        dct:description "Bounded Voronoi polygon clipping with 72 outer guard vertices completely resolves the v1 unbounded-cell artifact: `rational_120.0` now scores `voronoi_cv_area = 0.6207` and `mean_circularity = 0.0284`, while the golden angle (`137.5078 deg`) simultaneously minimizes `voronoi_cv_area` (`0.007209`), minimizes `nnd_cv` (`0.011108`), and maximizes Voronoi circularity (`0.852513`). All 7 morphometrics are independently verified in `2026-10-18-phyllotaxis-audit-v2.measurements.yaml`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-douady-couder-1992-hofmeister-lucas-branch-emergent-divergence-angle>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-douady-couder-1992-hofmeister-main-branch-emergent-divergence-angle>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-empirical-specimen-photograph-segmented-floret-voronoi-circularity-4-a-p>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-golden-divergence-angle-360>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-mechanistic-rim-dislocation-ensemble-pearson-r-vs-swinton-2016-table-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-outer-annulus-14-5-22-5-opposed-contact-parastichy-ratio-n-m>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-swinton-et-al-2016-photoreviewed-fibonacci-structure-prevalence>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-voronoi-cell-area-cv-at-golden-angle-137-5078>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-morphometric-validation-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-douady-couder-1992-hofmeister-lucas-branch-emergent-divergence-angle> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Douady & Couder (1992) Hofmeister Lucas-branch emergent divergence angle = 99.38 degrees" ;
        schema:measurementTechnique "mean steady-state divergence angle over final 25 plastochrons on secondary Lucas branch (G: 0.22 -> 0.04)" ;
        schema:name "Douady & Couder (1992) Hofmeister Lucas-branch emergent divergence angle" ;
        schema:unitText "degrees" ;
        schema:value "99.38" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-douady-couder-1992-hofmeister-lucas-branch-emergent-divergence-angle-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-douady-couder-1992-hofmeister-lucas-branch-emergent-divergence-angle-reference> a schema:PropertyValue ;
        dct:source "Douady & Couder 1992 Phys. Rev. Lett. 68:2098 / 1996 J. Theor. Biol. 178:255" ;
        schema:value "99.501553" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-douady-couder-1992-hofmeister-main-branch-emergent-divergence-angle> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Douady & Couder (1992) Hofmeister main-branch emergent divergence angle = 137.586 degrees" ;
        schema:measurementTechnique "mean steady-state divergence angle over final 25 plastochrons on main Fibonacci branch (G: 0.55 -> 0.04)" ;
        schema:name "Douady & Couder (1992) Hofmeister main-branch emergent divergence angle" ;
        schema:unitText "degrees" ;
        schema:value "137.586" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-douady-couder-1992-hofmeister-main-branch-emergent-divergence-angle-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-douady-couder-1992-hofmeister-main-branch-emergent-divergence-angle-reference> a schema:PropertyValue ;
        dct:source "Douady & Couder 1992 Phys. Rev. Lett. 68:2098 Fig. 3" ;
        schema:value "137.507764" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-empirical-specimen-photograph-segmented-floret-voronoi-circularity-4-a-p> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "empirical specimen photograph segmented floret Voronoi circularity ⟨4πA/P²⟩ = 0.7934 ratio (4πA/P²)" ;
        dct:description "specimen Voronoi area CV = 0.2530, hex neighbor fraction = 0.377" ;
        schema:measurementTechnique "Difference-of-Gaussians floret segmentation (N=621 florets, 402 interior Voronoi cells) on helianthus_annuus_capitulum_specimen.jpg" ;
        schema:name "empirical specimen photograph segmented floret Voronoi circularity ⟨4πA/P²⟩" ;
        schema:unitText "ratio (4πA/P²)" ;
        schema:value "0.7934" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-empirical-specimen-photograph-segmented-floret-voronoi-circularity-4-a-p-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-empirical-specimen-photograph-segmented-floret-voronoi-circularity-4-a-p-reference> a schema:PropertyValue ;
        dct:source "helianthus_annuus_capitulum_specimen.jpg (File:Sunflower Spiral.jpg, CC BY-SA 2.0)" ;
        schema:value "0.8525133755444986" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-golden-divergence-angle-360> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "golden divergence angle α₀ = 360°/τ² = 137.5078 degrees" ;
        schema:measurementTechnique "exact golden-section divergence angle 360 * (2 - τ)" ;
        schema:name "golden divergence angle α₀ = 360°/τ²" ;
        schema:unitText "degrees" ;
        schema:value "137.5078" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-golden-divergence-angle-360-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-golden-divergence-angle-360-reference> a schema:PropertyValue ;
        dct:source "Vogel 1979 Mathematical Biosciences 44:179 Eq. (1)-(4)" ;
        schema:value "137.50776405003785" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-mechanistic-rim-dislocation-ensemble-pearson-r-vs-swinton-2016-table-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "mechanistic rim-dislocation ensemble Pearson r vs Swinton (2016) Table 1 = 0.995 Pearson r" ;
        schema:measurementTechnique "correlation across 6 parastichy classes (N=768 simulated vs N=768 photoreviewed; Fib-1=68 > Fib+1=22, p=6.25e-07)" ;
        schema:name "mechanistic rim-dislocation ensemble Pearson r vs Swinton (2016) Table 1" ;
        schema:unitText "Pearson r" ;
        schema:value "0.995" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-mechanistic-rim-dislocation-ensemble-pearson-r-vs-swinton-2016-table-1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-mechanistic-rim-dislocation-ensemble-pearson-r-vs-swinton-2016-table-1-reference> a schema:PropertyValue ;
        dct:source "Swinton, Ochu & MSI Turing's Sunflower Consortium 2016 R. Soc. Open Sci. 3:160091 Table 1" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-outer-annulus-14-5-22-5-opposed-contact-parastichy-ratio-n-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "outer-annulus [14.5, 22.5) opposed contact parastichy ratio (n/m) = 1.6177 ratio (55/34)" ;
        dct:description "full radial cascade: [(8, 13), (13, 21), (21, 34), (34, 55)]" ;
        schema:measurementTechnique "Delaunay contact parastichy pair (34, 55) in outer annulus r in [14.5, 22.5)" ;
        schema:name "outer-annulus [14.5, 22.5) opposed contact parastichy ratio (n/m)" ;
        schema:unitText "ratio (55/34)" ;
        schema:value "1.6177" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-outer-annulus-14-5-22-5-opposed-contact-parastichy-ratio-n-m-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-outer-annulus-14-5-22-5-opposed-contact-parastichy-ratio-n-m-reference> a schema:PropertyValue ;
        dct:source "Vogel 1979 / Swinton et al. 2016 R. Soc. Open Sci. 3:160091 §2.3" ;
        schema:value "1.61765" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-swinton-et-al-2016-photoreviewed-fibonacci-structure-prevalence> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Swinton et al. (2016) photoreviewed Fibonacci-structure prevalence = 82.29 percent" ;
        dct:description "Fib-1 (49) vs Fib+1 (17) one-sided binomial p = 5.07e-05" ;
        schema:measurementTechnique "632 of 768 photoreviewed Helianthus annuus parastichy counts belonging to Fibonacci, Lucas, Double-Fib, or F4 sequences" ;
        schema:name "Swinton et al. (2016) photoreviewed Fibonacci-structure prevalence" ;
        schema:unitText "percent" ;
        schema:value "82.29" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-swinton-et-al-2016-photoreviewed-fibonacci-structure-prevalence-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-swinton-et-al-2016-photoreviewed-fibonacci-structure-prevalence-reference> a schema:PropertyValue ;
        dct:source "Swinton, Ochu & MSI Turing's Sunflower Consortium 2016 R. Soc. Open Sci. 3:160091 Table 1" ;
        schema:value "82.29" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-vogel-phyllotaxis-measurement-voronoi-cell-area-cv-at-golden-angle-137-5078> a schema:PropertyValue,
            pk:EvidenceItem ;

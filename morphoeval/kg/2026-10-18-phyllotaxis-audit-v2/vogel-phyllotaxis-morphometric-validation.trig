sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-18-phyllotaxis-audit-v2-vogel-phyllotaxis-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis — Morphometric validation: 86/100" ;
        rdfs:comment "Bounded Voronoi polygon clipping with 72 outer guard vertices completely resolves the v1 unbounded-cell artifact: `rational_120.0` now scores `voronoi_cv_area = 0.6207` and `mean_circularity = 0.0284`, while the golden angle (`137.5078 deg`) simultaneously minimizes `voronoi_cv_area` (`0.007209`), minimizes `nnd_cv` (`0.011108`), and maximizes Voronoi circularity (`0.852513`). All 7 morphometrics are independently verified in `2026-10-18-phyllotaxis-audit-v2.measurements.yaml`. Evidence: 1979-vogel-phyllotaxis.py L223–L303: compute_packing_metrics(): bounded Voronoi cells with guard ring & disk clipping <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L223-L303>; 1979-vogel-phyllotaxis.py L634–L654: run_self_tests(): asserts golden angle beats 137.3, 137.6, and 120.0 deg on all 3 metrics <https://github.com/fractastical/morpholib/blob/c89d18d/1979-vogel-phyllotaxis.py#L634-L654>; vogel_phyllotaxis_metrics.csv (generated output, not in repo): 6 regimes including empirical_specimen_helianthus_jpg — vogel_phyllotaxis_metrics.csv: rendered output of 1979-vogel-phyllotaxis.py at c89d18d, text/csv, 449 B, artifact_sha256 cb2404142073f9a5eb7b9b03af60891ce8efd46cca9956dc64caed92a6fe3f71 (sha256 cb2404142073f9a5eb7b9b03af60891ce8efd46cca9956dc64caed92a6fe3f71), spec_fingerprint 5df8c2b4cc4b9b4a86ea26aace00ebd26df8456a62d99c23287ddcea2644e06c. Measurements (measure_outputs.py): golden divergence angle α₀ = 360°/τ² = 137.5078 degrees (reference 137.50776405003785, Vogel 1979 Mathematical Biosciences 44:179 Eq. (1)-(4)) [exact golden-section divergence angle 360 * (2 - τ)]; outer-annulus [14.5, 22.5) opposed contact parastichy ratio (n/m) = 1.6177 ratio (55/34) (reference 1.61765, Vogel 1979 / Swinton et al. 2016 R. Soc. Open Sci. 3:160091 §2.3) [Delaunay contact parastichy pair (34, 55) in outer annulus r in [14.5, 22.5)] — full radial cascade: [(8, 13), (13, 21), (21, 34), (34, 55)]; Voronoi cell area CV at golden angle (137.5078°) = 0.0072 CV (std/mean) (reference 0.009777076602327238, Vogel 1979 Fig. 2a negative control (α = 137.30°)) [Voronoi polygon area dispersion across interior florets (0.18 R_max <= r <= 0.85 R_max, N=450)] — strictly lower than α=137.30° (0.0098) and α=137.60° (0.0074); Douady & Couder (1992) Hofmeister main-branch emergent divergence angle = 137.586 degrees (reference 137.507764, Douady & Couder 1992 Phys. Rev. Lett. 68:2098 Fig. 3) [mean steady-state divergence angle over final 25 plastochrons on main Fibonacci branch (G: 0.55 -> 0.04)]; Douady & Couder (1992) Hofmeister Lucas-branch emergent divergence angle = 99.38 degrees (reference 99.501553, Douady & Couder 1992 Phys. Rev. Lett. 68:2098 / 1996 J. Theor. Biol. 178:255) [mean steady-state divergence angle over final 25 plastochrons on secondary Lucas branch (G: 0.22 -> 0.04)]; Swinton et al. (2016) photoreviewed Fibonacci-structure prevalence = 82.29 percent (reference 82.29, Swinton, Ochu & MSI Turing's Sunflower Consortium 2016 R. Soc. Open Sci. 3:160091 Table 1) [632 of 768 photoreviewed Helianthus annuus parastichy counts belonging to Fibonacci, Lucas, Double-Fib, or F4 sequences] — Fib-1 (49) vs Fib+1 (17) one-sided binomial p = 5.07e-05; empirical specimen photograph segmented floret Voronoi circularity ⟨4πA/P²⟩ = 0.7934 ratio (4πA/P²) (reference 0.8525133755444986, helianthus_annuus_capitulum_specimen.jpg (File:Sunflower Spiral.jpg, CC BY-SA 2.0)) [Difference-of-Gaussians floret segmentation (N=621 florets, 402 interior Voronoi cells) on helianthus_annuus_capitulum_specimen.jpg] — specimen Voronoi area CV = 0.2530, hex neighbor fraction = 0.377; mechanistic rim-dislocation ensemble Pearson r vs Swinton (2016) Table 1 = 0.995 Pearson r (reference 1.0, Swinton, Ochu & MSI Turing's Sunflower Consortium 2016 R. Soc. Open Sci. 3:160091 Table 1) [correlation across 6 parastichy classes (N=768 simulated vs N=768 photoreviewed; Fib-1=68 > Fib+1=22, p=6.25e-07)]." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-vogel-phyllotaxis-morphometric-validation> ;
        pk:hasProbability "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-vogel-phyllotaxis-morphometric-validation> rdfs:label "Vogel (1979) & Douady–Couder (1992) Golden-Angle Phyllotaxis (1979-vogel-phyllotaxis.py, docs/media/vogel_phyllotaxis_growth.gif, vogel_phyllotaxis_metrics.csv) satisfies the MorphoEval 0.1.0 criterion 'Morphometric validation' for Helianthus annuus (sunflower capitulum)" ;
        dct:identifier "morphoeval/0.1.0/morphometric-validation" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (remediation verification)" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bailleul-allometric-cranial-sutures> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Miura et al. (2009) & Jaslow (1990) cranial suture fractal interdigitation, Kuramoto-Sivashinsky osteogenic instability, quasi-3D plate layering and reduced-order masticatory strain coupling — Source and data traceability: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: 8 DOIs (4 primary + 4 Pass 3 secondary, each resolved against Crossref before being added) in the bib, dataset README and JSON; the bib SHA-256 was re-pinned after the additions and is verified fail-closed at every run (L107-120); every strain-model constant lives in `calvarial_shell_strain_model` with `not_a_finite_element_model: true`, a `used_for` line per secondary reference and explicit \"assumption\" wording. Deductions: the ecto-vs-endo expectation cites Nicolay & Vaders (2006) qualitatively without a vendored table value (-4); the ellipsoid semi-axes, plate thickness 6 mm, patch centres and sigma values carry no anatomical source (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-source-traceability-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L107–L120" ;
        dcterms:description "Runtime SHA-256 verification of the three pinned dataset files including the re-pinned bib" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L107-L120> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/allometric_cranial_sutures/allometric_cranial_sutures_reference.json L113–L180" ;
        dcterms:description "secondary_papers_pass3 with DOIs and used_for; calvarial_shell_strain_model with ellipsoid, layers, mechanotransduction, tractions, sweep and literature_expectations caveat" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/allometric_cranial_sutures/allometric_cranial_sutures_reference.json#L113-L180> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/allometric_cranial_sutures/paper_citations.bib L45–L87" ;
        dcterms:description "Herring & Teng 2000, Byron 2004, Nicolay & Vaders 2006, Curtis 2013 BibTeX entries" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/allometric_cranial_sutures/paper_citations.bib#L45-L87> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


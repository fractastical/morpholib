sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bailleul-allometric-cranial-sutures> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Miura et al. (2009) & Jaslow (1990) cranial suture fractal interdigitation, Kuramoto-Sivashinsky osteogenic instability, quasi-3D plate layering and reduced-order masticatory strain coupling — Parameter expressivity: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: the morphospace is now 225 real simulations and is monotone (Spearman rho(D_f, alpha) = 1.00, rho(SII, alpha) = 1.00, rho(D_f, beta | unstable) = -1.00, flat half-plane max D_f 1.00; L728-781, self-test 14); the depth ramp alpha_endo_ratio and kappa_z each have an ablation (L814-859); the nuchal : temporalis scale is swept (L861-888); the continuous flat/infant/overhang blend (L498-501) makes intermediate alphas vary smoothly. Deductions: within the sweep the nuchal scale changes the mean-alpha ratio (0.98 -> 1.10) but never flips the SII ordering (0.80-0.88), so the lambdoid-vs-sagittal feature of form is not controllable by the one strain parameter that is exposed (-6); the alpha clip 3.0 and the overhang law 0.68 (alpha/1.2)^0.7 (L284-289) are uncited knobs that shape the response (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2020-bailleul-allometric-cranial-sutures.py L861–L888: Nuchal traction sweep recording alpha and SII ratios; SII ratio stays < 1 for all scales <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L861-L888>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L728–L781" ;
        dct:description "Simulated 15x15 (alpha, beta) morphospace with Spearman monotonicity diagnostics (replaces the v2 closed-form tanh surrogate)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L728-L781> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L814–L859" ;
        dct:description "Layered depth profile with no-gradient and kappa_z = 0 ablations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L814-L859> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


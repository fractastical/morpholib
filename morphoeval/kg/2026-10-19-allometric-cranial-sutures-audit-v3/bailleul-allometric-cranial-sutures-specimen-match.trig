sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bailleul-allometric-cranial-sutures> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Miura et al. (2009) & Jaslow (1990) cranial suture fractal interdigitation, Kuramoto-Sivashinsky osteogenic instability, quasi-3D plate layering and reduced-order masticatory strain coupling — Morphological realism / specimen match: 82/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: the SHA-256-pinned CC BY-SA human calvaria is segmented, its sagittal suture traced and overlaid (C1), compared waveform-to-waveform (C2) and in box-counting space (B1) with the simulated sagittal suture, and the five regimes are visually distinct (A1, GIF); the new row D shows the ellipsoidal vault with the three suture paths, the heterogeneous alpha(s) profiles and the quasi-3D ecto-to-endo cleft stack with a clearly flatter endocranial table, which is the qualitative anatomy. Deductions: the coronal, lambdoid and endocranial outputs have no specimen counterpart — the vendored photograph shows only the sagittal suture fully in frame (L893-897, L913) (-8); the strain-coupled lambdoid is LESS interdigitated than the sagittal (SII 2.433 vs 2.748), opposite to the vendored/literature expectation, so the three-suture rendering does not match adult human morphology in that respect (-6); the vault is an analytic ellipsoid without temporal squama, occipital bun or thickness variation, and the muscle patches are four points (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-specimen-match-4> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/allometric_cranial_sutures_comparison.png (generated output)" ;
        dct:description "12-panel figure: C1 specimen CV trace overlay, C2 specimen-vs-simulated waveforms, B1 box-counting overlay, D1 vault + sutures, D2 alpha(s, zeta), D3 layered cleft stack — docs/media/allometric_cranial_sutures_comparison.png: rendered output of 2020-bailleul-allometric-cranial-sutures.py at d58a084, image/png, 1553683 B, 2227×2349 px, artifact_sha256 7d403d848e058ca7d287c7643ecb7c7794378d0d5755d61934ce8ee7cc788cf8 (sha256 7d403d848e058ca7d287c7643ecb7c7794378d0d5755d61934ce8ee7cc788cf8), spec_fingerprint 74cdd6073c2c17e25ba7d52bc092caa9009007cab52635bb5182e43bad1f6297" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L893–L913" ;
        dct:description "Specimen segmentation limited to the sagittal ROI (x 442-526, y 195-535); docstring states coronal/lambdoid are not extractable" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L893-L913> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L1143–L1158" ;
        dct:description "Panel C3 now includes strain-coupled coronal and lambdoid bars beside the sagittal and specimen bars; lambdoid < sagittal visible" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L1143-L1158> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L1212–L1242" ;
        dct:description "Panel D3: 5-layer ecto->endo sagittal cleft rendered in 3D with per-layer SII/D_f and ablation values" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L1212-L1242> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


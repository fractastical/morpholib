sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bailleul-allometric-cranial-sutures> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Miura et al. (2009) & Jaslow (1990) cranial suture fractal interdigitation, Kuramoto-Sivashinsky osteogenic instability, quasi-3D plate layering and reduced-order masticatory strain coupling — Morphometric validation: 86/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: 11 measurements each with a reference value, source and note (L1295-1427): sagittal D_f 1.3484 vs 1.36, SII 2.9181 vs 2.84, lambdoid D_f 1.3756 vs 1.41, synostosis collapse 1.00, Jaslow amplification 2.687 vs 2.75, specimen CV D_f 1.2847, ecto/endo SII ratio 2.863 vs null 1.0 with ablation values, strain-coupled lambdoid/sagittal SII 0.885 vs vendored 1.22 (a disclosed failure), nuchal crossing scale 0.5, alpha(0) = -0.35 exactly, morphospace rho = 1.00. Deductions: the new references for items 7-9 are a null value (1.0), a vendored expectation (1.22) and a model assumption (1.0) rather than numbers measured on real specimens; no quantified ecto/endo D_f pair from the literature is vendored (-7); the lambdoid/sagittal comparison fails and is only explained qualitatively (-4); Spearman is computed with a ties-unaware argsort (L762, L851) (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2020-bailleul-allometric-cranial-sutures.py L1387–L1396: Strain-coupled lambdoid/sagittal SII 0.885 vs reference 1.22: disclosed mismatch <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L1387-L1396>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-lambdoid-suture-hyper-interdigitated-fractal-dimension-d-f>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-sagittal-suture-box-counting-fractal-dimension-d-f>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-sagittal-suture-interdigitation-index-sii-l-arc-l-chord>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-ectocranial-endocranial-sagittal-sii-ratio-across-the-quasi-3d-plate-thickness-pass-3-item-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-fgfr2-apert-craniosynostosis-mechanical-unloading-sii-collapse-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-human-calvaria-specimen-sagittal-suture-cv-box-counting-fractal-dimension-d-f>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-jaslow-1990-bending-energy-absorption-amplification-factor-lambdoid-vs-fused-synostosis>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-nuchal-temporalis-traction-scale-at-which-mean-ectocranial-lambdoid-alpha-first-exceeds-sagittal-alpha-sensitivity-of-the-assumed-ordering>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-simulated-alpha-beta-morphospace-spearman-rank-correlation-of-d-f-with-alpha>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-strain-coupled-lambdoid-sagittal-sii-ratio-under-heterogeneous-masticatory-strain-pass-3-item-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-strain-mechanotransduction-law-alpha-at-zero-strain-miura-2009-unloading-reproduction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-morphometric-validation-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-lambdoid-suture-hyper-interdigitated-fractal-dimension-d-f> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Adult lambdoid suture hyper-interdigitated fractal dimension D_f = 1.3756 fractal dimension D_f" ;
        dct:description "Lambdoid D_f = 1.3756, SII = 3.3431 > sagittal SII = 2.9181" ;
        schema:measurementTechnique "Dyadic box-counting dimension under high nuchal/masticatory strain (alpha=1.48, beta=0.52)" ;
        schema:name "Adult lambdoid suture hyper-interdigitated fractal dimension D_f" ;
        schema:unitText "fractal dimension D_f" ;
        schema:value "1.3756" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-lambdoid-suture-hyper-interdigitated-fractal-dimension-d-f-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-lambdoid-suture-hyper-interdigitated-fractal-dimension-d-f-reference> a schema:PropertyValue ;
        dct:source "Jaslow (1990) J. Biomech. 23:313-321 & Miura et al. (2009) PNAS 106:11218-11223" ;
        schema:value "1.41" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-sagittal-suture-box-counting-fractal-dimension-d-f> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Adult sagittal suture box-counting fractal dimension D_f = 1.3484 fractal dimension D_f" ;
        dct:description "Simulated sagittal D_f = 1.3484 (log-log r = 0.9936, RMSE vs specimen/ref = 0.0458, 5-regime std = 0.1735) vs unloaded null control D_f = 1.0000" ;
        schema:measurementTechnique "5-scale dyadic box-counting regression log2 N(eps) vs log2(L/eps) on 2D overhanging KS+KPZ sagittal suture" ;
        schema:name "Adult sagittal suture box-counting fractal dimension D_f" ;
        schema:unitText "fractal dimension D_f" ;
        schema:value "1.3484" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-sagittal-suture-box-counting-fractal-dimension-d-f-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-sagittal-suture-box-counting-fractal-dimension-d-f-reference> a schema:PropertyValue ;
        dct:source "Miura et al. (2009) PNAS 106:11218-11223 Figs. 1-4 (mammalian sagittal suture box-counting D_f = 1.32-1.42)" ;
        schema:value "1.36" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-sagittal-suture-interdigitation-index-sii-l-arc-l-chord> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Adult sagittal suture interdigitation index SII (L_arc / L_chord) = 2.9181 L_arc / L_chord" ;
        dct:description "Adult sagittal SII = 2.9181 vs infant neonatal SII = 1.0658 and unloaded null SII = 1.0000" ;
        schema:measurementTechnique "Arc-to-chord length ratio of multi-valued overhanging osteogenic front at t = 32" ;
        schema:name "Adult sagittal suture interdigitation index SII (L_arc / L_chord)" ;
        schema:unitText "L_arc / L_chord" ;
        schema:value "2.9181" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-sagittal-suture-interdigitation-index-sii-l-arc-l-chord-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-adult-sagittal-suture-interdigitation-index-sii-l-arc-l-chord-reference> a schema:PropertyValue ;
        dct:source "Miura et al. (2009) PNAS 106:11218-11223 & Jaslow (1990) J. Biomech. 23:313-321" ;
        schema:value "2.84" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-ectocranial-endocranial-sagittal-sii-ratio-across-the-quasi-3d-plate-thickness-pass-3-item-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Ectocranial / endocranial sagittal SII ratio across the quasi-3D plate thickness (Pass 3 item 1) = 2.8629 SII_ecto / SII_endo" ;
        dct:description "Depth profile SII(z) = [2.863, 2.419, 1.129, 1.000, 1.000], D_f(z) = [1.339, 1.314, 1.069, 1.000, 1.000], Spearman(SII, z) = -0.900; no-gradient ablation SII_endo = 2.814, uncoupled (kappa_z = 0) SII_endo = 1.000" ;
        schema:measurementTechnique "5-layer KS/KPZ stack through T = 6 mm with linear alpha(z) ramp and vertical coupling kappa_z = 0.60; SII per layer trace" ;
        schema:name "Ectocranial / endocranial sagittal SII ratio across the quasi-3D plate thickness (Pass 3 item 1)" ;
        schema:unitText "SII_ecto / SII_endo" ;
        schema:value "2.8629" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-ectocranial-endocranial-sagittal-sii-ratio-across-the-quasi-3d-plate-thickness-pass-3-item-1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-ectocranial-endocranial-sagittal-sii-ratio-across-the-quasi-3d-plate-thickness-pass-3-item-1-reference> a schema:PropertyValue ;
        dct:source "Qualitative expectation that endocranial sutures are simpler / close earlier than ectocranial traces (Nicolay & Vaders 2006 J. Morphol. 267:841-849; Herring & Teng 2000); reference_value = 1.0 is the no-gradient null, exceeded iff ecto is more complex" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-fgfr2-apert-craniosynostosis-mechanical-unloading-sii-collapse-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FGFR2 Apert craniosynostosis & mechanical unloading SII collapse ratio = 1.0 L_arc / L_chord" ;
        dct:description "FGFR2 craniosynostosis SII = 1.0000 (D_f = 1.0000) and unloaded SII = 1.0000 (max omega = -0.0800 < 0)" ;
        schema:measurementTechnique "Damped KS evolution under premature osteoblast differentiation (alpha = -0.60, gamma = 0.25)" ;
        schema:name "FGFR2 Apert craniosynostosis & mechanical unloading SII collapse ratio" ;
        schema:unitText "L_arc / L_chord" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-fgfr2-apert-craniosynostosis-mechanical-unloading-sii-collapse-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-fgfr2-apert-craniosynostosis-mechanical-unloading-sii-collapse-ratio-reference> a schema:PropertyValue ;
        dct:source "Miura et al. (2009) PNAS 106:11218-11223 Fig. 5 & Khonsari et al. (2013) Proc. R. Soc. B 280:20122670 (Lean 4 unloaded_and_craniosynostosis_flat_stability)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-human-calvaria-specimen-sagittal-suture-cv-box-counting-fractal-dimension-d-f> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Human calvaria specimen sagittal suture CV box-counting fractal dimension D_f = 1.2847 fractal dimension D_f" ;
        dct:description "Specimen sagittal CV D_f = 1.2847, SII = 2.6791, log-log scaling correlation with simulated sagittal suture r = 0.9998" ;
        schema:measurementTechnique "Automated CV midline cleft segmentation and 5-scale dyadic box-counting on human_sagittal_suture_specimen.jpg" ;
        schema:name "Human calvaria specimen sagittal suture CV box-counting fractal dimension D_f" ;
        schema:unitText "fractal dimension D_f" ;
        schema:value "1.2847" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-human-calvaria-specimen-sagittal-suture-cv-box-counting-fractal-dimension-d-f-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-human-calvaria-specimen-sagittal-suture-cv-box-counting-fractal-dimension-d-f-reference> a schema:PropertyValue ;
        dct:source "Vendored Homo sapiens calvaria specimen (Wikimedia Commons File:Sagittal suture 2.jpg, CC BY-SA 3.0) & Miura et al. (2009)" ;
        schema:value "1.35" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-jaslow-1990-bending-energy-absorption-amplification-factor-lambdoid-vs-fused-synostosis> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Jaslow (1990) bending energy absorption amplification factor (lambdoid vs fused synostosis) = 2.687 E_bend / E_0 ratio" ;
        dct:description "Bending energy hierarchy: FGFR2 fused (1.000) < infant (1.047) < sagittal (2.381) < lambdoid (2.687)" ;
        schema:measurementTechnique "Jaslow (1990) energy absorption law E_bend(SII)/E_0 = 1 + kappa_J*(SII - 1) across suture regimes" ;
        schema:name "Jaslow (1990) bending energy absorption amplification factor (lambdoid vs fused synostosis)" ;
        schema:unitText "E_bend / E_0 ratio" ;
        schema:value "2.687" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-jaslow-1990-bending-energy-absorption-amplification-factor-lambdoid-vs-fused-synostosis-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-jaslow-1990-bending-energy-absorption-amplification-factor-lambdoid-vs-fused-synostosis-reference> a schema:PropertyValue ;
        dct:source "Jaslow (1990) J. Biomech. 23(4):313-321 Figs. 3-5 (Lean 4 jaslow_suture_interdigitation_energy_absorption)" ;
        schema:value "2.75" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-nuchal-temporalis-traction-scale-at-which-mean-ectocranial-lambdoid-alpha-first-exceeds-sagittal-alpha-sensitivity-of-the-assumed-ordering> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Nuchal : temporalis traction scale at which mean ectocranial lambdoid alpha first exceeds sagittal alpha (sensitivity of the assumed ordering) = 0.5 nuchal force scale (x vendored force_rel)" ;
        dct:description "alpha_lam/alpha_sag across sweep = [0.975, 0.999, 1.021, 1.059, 1.059, 1.041]; SII_lam/SII_sag = [0.883, 0.821, 0.841, 0.908, 0.946, 0.883] (never > 1 within the sweep); coronal SII = [2.476, 2.175, 2.269, 2.203, 2.096, 1.788]" ;
        schema:measurementTechnique "Sweep of the nuchal traction scale over 0.00, 0.25, 0.50, 1.00, 1.50, 2.00; <alpha_ecto>_lambdoid / <alpha_ecto>_sagittal and SII_lambdoid / SII_sagittal recorded per scale" ;
        schema:name "Nuchal : temporalis traction scale at which mean ectocranial lambdoid alpha first exceeds sagittal alpha (sensitivity of the assumed ordering)" ;
        schema:unitText "nuchal force scale (x vendored force_rel)" ;
        schema:value "0.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-nuchal-temporalis-traction-scale-at-which-mean-ectocranial-lambdoid-alpha-first-exceeds-sagittal-alpha-sensitivity-of-the-assumed-ordering-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-nuchal-temporalis-traction-scale-at-which-mean-ectocranial-lambdoid-alpha-first-exceeds-sagittal-alpha-sensitivity-of-the-assumed-ordering-reference> a schema:PropertyValue ;
        dct:source "Model assumption (vendored force_rel = 1.0); Byron et al. (2004) Anat. Rec. 279A:676-684 muscle-mass -> suture complexity direction only, no magnitude" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-simulated-alpha-beta-morphospace-spearman-rank-correlation-of-d-f-with-alpha> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Simulated (alpha, beta) morphospace Spearman rank correlation of D_f with alpha = 1.0 Spearman rho" ;
        dct:description "rho(D_f, alpha) = 1.000, rho(SII, alpha) = 1.000, rho(D_f, beta | alpha > alpha_c) = -0.993; max D_f in stable half-plane = 1.005, in unstable = 1.403" ;
        schema:measurementTechnique "15x15 grid of KS/KPZ simulations (alpha in [-0.6, 1.6], beta in [0.35, 1.05]); rank correlation of beta-averaged D_f with alpha" ;
        schema:name "Simulated (alpha, beta) morphospace Spearman rank correlation of D_f with alpha" ;
        schema:unitText "Spearman rho" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-simulated-alpha-beta-morphospace-spearman-rank-correlation-of-d-f-with-alpha-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-simulated-alpha-beta-morphospace-spearman-rank-correlation-of-d-f-with-alpha-reference> a schema:PropertyValue ;
        dct:source "Monotone instability-complexity expectation of Miura et al. (2009) Fig. 2-4 (omega_max = alpha^2/(4 beta) increases with alpha)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-strain-coupled-lambdoid-sagittal-sii-ratio-under-heterogeneous-masticatory-strain-pass-3-item-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Strain-coupled lambdoid / sagittal SII ratio under heterogeneous masticatory strain (Pass 3 item 2) = 0.8855 SII_lambdoid / SII_sagittal" ;
        dct:description "Strain-coupled SII: coronal 2.161 (D_f 1.247), sagittal 2.748 (D_f 1.331), lambdoid 2.433 (D_f 1.293); mean ectocranial alpha coronal 0.926, sagittal 1.200, lambdoid 1.267. The reduced model reproduces the mean-alpha ordering lambdoid > sagittal > coronal but NOT the SII ordering (heterogeneous lambdoid profile has flat asterion flanks); this mismatch is reported, not tuned away" ;
        schema:measurementTechnique "Reduced-order Kirchhoff-Love vault strain eps_nn(s, zeta) -> alpha(s, zeta) = alpha_unl + (alpha_sag - alpha_unl) eps_hat, heterogeneous-alpha layered KS/KPZ per suture" ;
        schema:name "Strain-coupled lambdoid / sagittal SII ratio under heterogeneous masticatory strain (Pass 3 item 2)" ;
        schema:unitText "SII_lambdoid / SII_sagittal" ;
        schema:value "0.8855" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-strain-coupled-lambdoid-sagittal-sii-ratio-under-heterogeneous-masticatory-strain-pass-3-item-2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-strain-coupled-lambdoid-sagittal-sii-ratio-under-heterogeneous-masticatory-strain-pass-3-item-2-reference> a schema:PropertyValue ;
        dct:source "Vendored lambdoid/sagittal SII expectation 3.35/2.75 = 1.22 (allometric_cranial_sutures_reference.json experimental_regimes) and Jaslow (1990); NOT measured on the vendored specimen (coronal/lambdoid outside frame)" ;
        schema:value "1.22" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-strain-mechanotransduction-law-alpha-at-zero-strain-miura-2009-unloading-reproduction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Strain mechanotransduction law alpha at zero strain (Miura 2009 unloading reproduction) = -0.35 alpha (osteogenic instability coefficient)" ;
        dct:description "alpha(0) = -0.3500, alpha(1) = 1.2000, zero crossing eps_hat_c = 0.2258 (alpha = 0.00e+00)" ;
        schema:measurementTechnique "alpha(eps_hat) = alpha_unl + (alpha_sag - alpha_unl) * eps_hat evaluated at eps_hat = 0 (Lean 4 strain_mechanotransduction_alpha_monotone)" ;
        schema:name "Strain mechanotransduction law alpha at zero strain (Miura 2009 unloading reproduction)" ;
        schema:unitText "alpha (osteogenic instability coefficient)" ;
        schema:value "-0.35" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-strain-mechanotransduction-law-alpha-at-zero-strain-miura-2009-unloading-reproduction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-measurement-strain-mechanotransduction-law-alpha-at-zero-strain-miura-2009-unloading-reproduction-reference> a schema:PropertyValue ;
        dct:source "Vendored alpha_unloaded_null (Miura et al. 2009 dura-removal unloading, Fig. 5)" ;
        schema:value "-0.35" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L1295–L1427" ;

    prov:wasDerivedFrom <https://doi.org/10.1002/1096-8644(200008)112:4%3C575::AID-AJPA10%3E3.0.CO;2-0>,
        <https://doi.org/10.1002/ar.a.20055>,
        <https://doi.org/10.1002/jmor.10445>,
        <https://doi.org/10.1016/0021-9290(90)90059-C>,
        <https://doi.org/10.1073/pnas.0813269106>,
        <https://doi.org/10.1098/rsif.2013.0442>,
        <https://doi.org/10.1098/rspb.2012.2670>,

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bailleul-allometric-cranial-sutures> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Miura et al. (2009) & Jaslow (1990) cranial suture fractal interdigitation, Kuramoto-Sivashinsky osteogenic instability, quasi-3D plate layering and reduced-order masticatory strain coupling — Reproducibility package: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: cross-process determinism (seed + SHA-256 label offsets, L551-553), bitwise two-run and constant-profile equivalence checks, 14-check `--self-test` in ~3 s, default render in ~14 s with `--skip-gif`/`--seed` flags (L1542-1546), SHA-256 fail-closed inputs, and the GIF regenerating byte-identically to v2 (27e6d90f...). Deductions: no per-script requirements lock (environment is recorded only in this audit) (-5); matplotlib needs a writable MPLCONFIGDIR in sandboxed runs and the invocation notes do not say so (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-repro-package-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L1432–L1539" ;
        dct:description "14-check deterministic self-test incl. bitwise constant-profile reduction, Lean-law endpoints, depth monotonicity, strain ordering, morphospace monotonicity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L1432-L1539> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L1542–L1548" ;
        dct:description "CLI: --self-test, --skip-gif, --seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L1542-L1548> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/allometric_cranial_sutures_growth.gif (generated output)" ;
        dct:description "24-frame GIF byte-identical across Pass 2 and Pass 3 (five regimes unchanged) — docs/media/allometric_cranial_sutures_growth.gif: rendered output of 2020-bailleul-allometric-cranial-sutures.py at d58a084, image/gif, 573223 B, 864×368 px, 24 frames, artifact_sha256 27e6d90f28198a517241d4a2c7ee82771b340a1a295531b9aa4f7a45d9bb8fc7 (sha256 27e6d90f28198a517241d4a2c7ee82771b340a1a295531b9aa4f7a45d9bb8fc7), spec_fingerprint 74cdd6073c2c17e25ba7d52bc092caa9009007cab52635bb5182e43bad1f6297" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


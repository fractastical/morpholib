sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bailleul-allometric-cranial-sutures> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Miura et al. (2009) & Jaslow (1990) cranial suture fractal interdigitation, Kuramoto-Sivashinsky osteogenic instability, quasi-3D plate layering and reduced-order masticatory strain coupling — Model fidelity to source: 84/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: the damped KS dispersion and completing-the-square identity (L126-136, L203-262), the pseudo-spectral integrating-factor step with 2/3 dealiasing, the new heterogeneous-alpha treatment (alpha_mean in the exact integrating factor, -alpha_dev(x) h_xx in real space, L616-631), the 5-layer through-plate stack with explicit Neumann kappa_z coupling (L634-637), the Kirchhoff-Love eps(zeta) = eps_mem + zeta kappa law and the affine mechanotransduction law anchored on the two vendored regimes (L267-281, L346-441), all with 5 machine-checked Lean theorems; the constant-profile case reduces bitwise to the Pass 2 solver (self-test 9). Deductions: the 2D overhanging front is not a solved bidirectional interface — `construct_osteogenic_front_curve` normalises the KS field by std(h) and adds three hand-coded cascade harmonics and a lobe drive locked to h, so only the shape (not the amplitude) of the PDE solution reaches D_f/SII (L466-491; -8); the vault strain field is Gaussian deflection patches plus an isotropic ICP term, not a shell-equilibrium or finite-element solution, and the lambdoid asterion flanks need an alpha clip of 3.0 to keep the explicit term stable (L322-344, L368, JSON L151; -5); the integrating factor is clipped to [-4, 0.12] and the growth saturation 1/(1 + 0.55 var h) and cubic -0.18 h^3 are uncited closures (L619, L629-632; -3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2020-bailleul-allometric-cranial-sutures.py L466–L491: Carried defect: trace amplitude normalised by std(h) and cascade harmonics 0.62/0.34/0.16 hand-coded; D_f/SII are set by this construction, not by the PDE amplitude <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L466-L491>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-model-fidelity-5> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L126–L136" ;
        dct:description "Damped KS dispersion omega(k) = alpha k^2 - beta k^4 - gamma" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L126-L136> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L267–L281" ;
        dct:description "Affine strain mechanotransduction law alpha(eps_hat) = alpha_unl + (alpha_sag - alpha_unl) eps_hat anchored on vendored -0.35 and 1.20 (Lean Law 4)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L267-L281> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L346–L441" ;
        dct:description "Reduced-order Kirchhoff-Love vault strain field: Gaussian deflection Hessian, in-plane suture normal projection, eps(zeta) = eps_mem + zeta kappa, sagittal normalisation (Lean Law 5); explicitly NOT FEM" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L346-L441> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L616–L637" ;
        dct:description "Heterogeneous alpha_dev(x) h_xx real-space term, dealiased nonlinear step, explicit Neumann kappa_z d^2h/dz^2 layer coupling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L616-L637> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_020_allometric_cranial_sutures.lean L117–L193" ;
        dct:description "Two new Lean 4 theorems (Laws 4 and 5), file verifies with 0 sorrys" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_020_allometric_cranial_sutures.lean#L117-L193> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bailleul-allometric-cranial-sutures> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bailleul-allometric-cranial-sutures-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Miura et al. (2009) & Jaslow (1990) cranial suture fractal interdigitation, Kuramoto-Sivashinsky osteogenic instability, quasi-3D plate layering and reduced-order masticatory strain coupling — Code-to-model traceability: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: the module docstring maps Laws 1-5 to Lean theorem names and code; `strain_to_alpha`, `calvarial_shell_strain_field`, `construct_osteogenic_front_curve` and `simulate_cranial_suture_regime` docstrings state the equation, the source figure and the honest scope; the math-KG loop file registers all 5 laws with corrected code loci (L1-167). Deductions: the Gaussian-deflection Hessian form, the isotropic ICP membrane term and the overhang law are modelling choices with no cited equation (L284-289, L322-344) (-6); the cascade harmonic coefficients remain uncited (L483-488) (-4); the self-test docstring and panel B1 now say \"5 dyadic scales\" (the v2 \"7-scale\" wording was wrong and is fixed) (+0)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2020-bailleul-allometric-cranial-sutures.py L284–L289: overhang_from_alpha: uncited 0.68 (alpha/1.2)^0.7 closure <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L284-L289>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-code-traceability-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2020-bailleul-allometric-cranial-sutures.py L1–L44" ;
        dct:description "Docstring: Laws 1-5 with Lean theorem names and the honest scope note" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2020-bailleul-allometric-cranial-sutures.py#L1-L44> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bailleul-allometric-cranial-sutures-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/bailleul-allometric-cranial-sutures.yaml L1–L167" ;
        dct:description "5 registered laws with lean_code, loci, variables, roles and sources" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/bailleul-allometric-cranial-sutures.yaml#L1-L167> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


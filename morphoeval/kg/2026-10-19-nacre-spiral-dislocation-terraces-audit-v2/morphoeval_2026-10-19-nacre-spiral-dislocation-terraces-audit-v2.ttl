<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/cartwright-nacre-spiral-dislocation-terraces-1>,
        <https://w3id.org/probknow/resource/math-law/cartwright-nacre-spiral-dislocation-terraces-2>,
        <https://w3id.org/probknow/resource/math-law/cartwright-nacre-spiral-dislocation-terraces-3> .

<https://w3id.org/probknow/resource/math-law/cartwright-nacre-spiral-dislocation-terraces-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Burton-Cabrera-Frank (1951) & Cartwright-Checa (2007) Gibbs-Thomson Curved Terrace Step Velocity Law" ;
    dct:description "Arrests mineral terrace propagation at the critical curvature radius r = r_c and drives outer terrace turns faster than inner turns until a steady rotating spiral forms | Variables: v_n: normal aragonite terrace step velocity; v_∞: planar straight-step velocity; r_c: critical Gibbs-Thomson nucleation radius; r = 1/κ: local terrace curvature radius" ;
    dct:source "Burton, Cabrera & Frank (1951) Phil. Trans. R. Soc. A 243:299-358 Eq. (18); Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 Sec. 2" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/2007-cartwright-nacre-spiral-dislocation-terraces.py#L130-L240>,
        <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_073_nacre_spiral_dislocation_terraces.lean#L24-L48> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def gibbs_thomson_velocity_num (v_inf r r_c : Int) : Int :=
  v_inf * (r - r_c)
theorem bcf_gibbs_thomson_critical_arrest (v_inf r_c : Int) :
    gibbs_thomson_velocity_num v_inf r_c r_c = 0 ∧
    gibbs_thomson_velocity_num 5 6 4 = 10 := by
  simp [gibbs_thomson_velocity_num]
"""^^pk:lean4 ;
    skos:notation "v_n(κ) = v_∞ (1 - r_c κ),   v(r) = v_∞ (1 - r_c / r)   (r ≥ r_c)" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0900867106>,
        <https://doi.org/10.1098/rsif.2006.0188>,
        <https://doi.org/10.1098/rsta.1951.0006>,
        <https://doi.org/10.1098/rsta.2011.0600> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Burton-Cabrera-Frank (BCF) Screw-Dislocation Eikonal Step-Flow & Chiral Defect Pair Dynamics" ;
    pk:leanDeclaration "MathOfBiology.Loop_073.gibbs_thomson_velocity_num" ;
    pk:leanTheorem "MathOfBiology.Loop_073.bcf_gibbs_thomson_critical_arrest" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/cartwright-nacre-spiral-dislocation-terraces-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "BCF Archimedean Spiral Terrace Pitch & Vertical Nacre Accretion Scaling Law" ;
    dct:description "Determines the universal ratio λ_0 / r_c ≈ 19 separating tightly wound gastropod tower nacre (Haliotis, Gibbula) from broad bivalve terraced sheet nacre (Pteria, Pinctada) | Variables: λ_0: asymptotic Archimedean inter-step terrace spacing; ω_0 ≈ 0.3310: BCF dimensionless eigenvalue; h_0 ≈ 0.50 µm: inter-lamellar chitin-protein mortar spacing; V_z: vertical column/sheet growth rate" ;
    dct:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 Sec. 2-3; Burton, Cabrera & Frank (1951) Phil. Trans. R. Soc. A 243:299-358" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/2007-cartwright-nacre-spiral-dislocation-terraces.py#L140-L330>,
        <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_073_nacre_spiral_dislocation_terraces.lean#L54-L78> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def bcf_archimedean_pitch (r_c : Nat) : Nat := 19 * r_c
def nacre_vertical_growth_invariant (h_0 v_inf : Nat) : Nat := h_0 * v_inf
theorem bcf_archimedean_terrace_pitch_scaling (k r_c h_0 v_inf : Nat) :
    bcf_archimedean_pitch (r_c * k) = bcf_archimedean_pitch r_c * k ∧
    nacre_vertical_growth_invariant h_0 v_inf = v_inf * h_0 := by
  simp [bcf_archimedean_pitch, nacre_vertical_growth_invariant, Nat.mul_assoc, Nat.mul_comm]
"""^^pk:lean4 ;
    skos:notation "λ_0 = (2π / ω_0) r_c ≈ 18.9848 r_c ≈ 19 r_c,   ω = ω_0 (v_∞ / r_c),   V_z = h_0 v_∞ / λ_0" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0900867106>,
        <https://doi.org/10.1098/rsif.2006.0188>,
        <https://doi.org/10.1098/rsta.1951.0006>,
        <https://doi.org/10.1098/rsta.2011.0600> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Burton-Cabrera-Frank (BCF) Screw-Dislocation Eikonal Step-Flow & Chiral Defect Pair Dynamics" ;
    pk:leanDeclaration "MathOfBiology.Loop_073.bcf_archimedean_pitch" ;
    pk:leanTheorem "MathOfBiology.Loop_073.bcf_archimedean_terrace_pitch_scaling" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/cartwright-nacre-spiral-dislocation-terraces-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Cartwright et al. (2009) Chiral Dislocation Dipole & Frank-Read Target Terrace Law" ;
    dct:description "Explains how opposite-chirality screw-dislocation dipoles (+b, -b) act as biological Frank-Read sources emitting closed concentric target terraces in bivalve sheet nacre when d > 2 r_c while pinching off below 2 r_c | Variables: b_1, b_2 ∈ {±1}: screw dislocation Burgers chiralities; d: inter-core separation; 2 r_c: critical Frank-Read pinch-off diameter" ;
    dct:source "Cartwright, Checa, Escribano & Sainz-Díaz (2009) PNAS 106(26):10499-10504 Figs. 1-4; Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/2007-cartwright-nacre-spiral-dislocation-terraces.py#L245-L450>,
        <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_073_nacre_spiral_dislocation_terraces.lean#L84-L108> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def net_burgers_charge (b_1 b_2 : Int) : Int := b_1 + b_2
def frank_read_nucleation_excess (d r_c : Int) : Int := d - 2 * r_c
theorem cartwright_frank_read_topological_burgers_algebra (b : Int) :
    net_burgers_charge b (-b) = 0 ∧
    net_burgers_charge b b = 2 * b ∧
    frank_read_nucleation_excess 8 4 = 0 := by
  dsimp [net_burgers_charge, frank_read_nucleation_excess]; omega
"""^^pk:lean4 ;
    skos:notation "b_net = b_1 + b_2: (+b, -b) ⇒ b_net = 0 (closed target rings for d > 2 r_c; annihilation for d ≤ 2 r_c); (+b, +b) ⇒ b_net = 2b (double spiral)" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0900867106>,
        <https://doi.org/10.1098/rsif.2006.0188>,
        <https://doi.org/10.1098/rsta.1951.0006>,
        <https://doi.org/10.1098/rsta.2011.0600> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Burton-Cabrera-Frank (BCF) Screw-Dislocation Eikonal Step-Flow & Chiral Defect Pair Dynamics" ;
    pk:leanDeclaration "MathOfBiology.Loop_073.net_burgers_charge" ;
    pk:leanTheorem "MathOfBiology.Loop_073.cartwright_frank_read_topological_burgers_algebra" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .

<https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-spiral-dislocation-terraces> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007) & Cartwright et al. (2009) nacre screw-dislocation spirals, Frank-Read target terraces, and defect pair annihilation — Morphological realism / specimen match: 90/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors, SHA-256-verifies, and performs vertical Difference-of-Gaussians computer-vision segmentation (`segment_nacre_sem_specimen`, L511-579) on the SEM fractured mother-of-pearl micrograph (`datasets/nacre_spiral_dislocation_terraces/nacre_aragonite_tablets_specimen.jpg`), detecting 312 inter-lamellar chitin-protein mortar seams across 25 column transects with mean lamellar thickness h_0 = 0.5000 um (25.17 px, CV = 0.2933), 14.12 stacked aragonite tablet layers per column, and tablet width-to-thickness aspect ratio 3.2436." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L511–L579" ;
        dct:description "1D DoG inter-lamellar mortar seam and aragonite tablet aspect ratio segmentation on SEM nacre specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2007-cartwright-nacre-spiral-dislocation-terraces.py#L511-L579> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/nacre_spiral_dislocation_terraces_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing 3D spiral terraces, 4 chiral defect regimes, 12-species collapse, and SEM aragonite tablet segmentation — docs/media/nacre_spiral_dislocation_terraces_comparison.png: rendered output of 2007-cartwright-nacre-spiral-dislocation-terraces.py at HEAD, image/png, 1412174 B, 2224×1495 px, artifact_sha256 a86ba495f00ab18584495b2c9e61aa9c452bb1ebebdb24c5ef65f9dc761dc2de (sha256 a86ba495f00ab18584495b2c9e61aa9c452bb1ebebdb24c5ef65f9dc761dc2de), spec_fingerprint 4c231c8398be9a26483bc4175fe15077a90c9e9b18a12deaf2c2e4265b43d447" .

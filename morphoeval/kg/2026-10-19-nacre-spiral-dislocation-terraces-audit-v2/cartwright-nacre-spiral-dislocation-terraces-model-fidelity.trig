sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-spiral-dislocation-terraces> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007) & Cartwright et al. (2009) nacre screw-dislocation spirals, Frank-Read target terraces, and defect pair annihilation — Model fidelity to source: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements the exact Gibbs-Thomson curved step velocity v(r) = v_inf*(1 - r_c/r) and Burton-Cabrera-Frank spiral kinematics (`compute_bcf_spiral_kinematics`, L137-178), simulates 2D chiral dislocation pairs and discrete contour winding integrals (`simulate_chiral_dislocation_terrace_2d`, L183-345) across single spiral, Frank-Read target, co-rotating double spiral, and subcritical pinch-off annihilation regimes, and synthesizes 3D bivalve terraced sheet vs gastropod columnar tower nacre (`simulate_nacre_architecture_3d`, L351-405). Backed by 4 machine-checked Lean 4 theorems in `Loop_073_nacre_spiral_dislocation_terraces.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L137–L345" ;
        dct:description "BCF spiral kinematics, 2D chiral dislocation dipole solver, and outer contour winding integral" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2007-cartwright-nacre-spiral-dislocation-terraces.py#L137-L345> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2007-cartwright-nacre-spiral-dislocation-terraces.py L351–L435" ;
        dct:description "3D bivalve sheet vs gastropod columnar tower nacre synthesis and 4-regime evaluator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2007-cartwright-nacre-spiral-dislocation-terraces.py#L351-L435> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_073_nacre_spiral_dislocation_terraces.lean L18–L109" ;
        dct:description "4 Lean 4 theorems proving Gibbs-Thomson critical arrest, radial velocity increment, BCF pitch scaling, and Frank-Read Burgers algebra" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_073_nacre_spiral_dislocation_terraces.lean#L18-L109> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


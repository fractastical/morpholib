sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cartwright-nacre-spiral-dislocation-terraces> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cartwright-nacre-spiral-dislocation-terraces-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Cartwright & Checa (2007) & Cartwright et al. (2009) nacre screw-dislocation spirals, Frank-Read target terraces, and defect pair annihilation — Morphometric validation: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Extracts 9 reference-anchored morphometrics in `measure_morphoeval()` (L806-898), including 12-species BCF terrace pitch correlation (`r = 0.9999`, `RMSE = 0.0369 um`), 12-species angular rotation frequency correlation (`r = 1.0000`), empirical BCF pitch-to-critical-radius slope (`18.9854` vs theoretical `18.9848`), *Pteria hirundo* terrace pitch (`7.9912 um` vs `7.9736 um`), double-to-single spiral pitch ratio (`0.5000` vs `0.50`), subcritical dipole negative control (`0.0 terraces`), and SEM specimen inter-lamellar thickness (`0.5000 um` vs `0.50 um`), aspect ratio (`3.2436`), and spacing CV (`0.2933`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-12-species-bcf-spiral-terrace-pitch-correlation-cartwright-checa-2007-bcf-1951>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-12-species-spiral-angular-rotation-frequency-correlation-omega-omega-0-v-inf-r-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bivalve-sheet-nacre-pteria-hirundo-single-spiral-terrace-pitch-lambda-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-empirical-bcf-terrace-pitch-to-critical-radius-slope-lambda-0-r-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-same-chirality-b-b-double-spiral-to-single-spiral-terrace-pitch-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-sem-specimen-aragonite-tablet-width-to-thickness-aspect-ratio-d-tab-h-0-nacre-aragonite-tablets-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-sem-specimen-inter-lamellar-spacing-coefficient-of-variation-cv-nacre-aragonite-tablets-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-sem-specimen-segmented-inter-lamellar-aragonite-tablet-thickness-h-0-nacre-aragonite-tablets-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-subcritical-frank-read-dipole-negative-control-active-terraces-d-0-60-um-2-r-c-0-84-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-morphometric-validation-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-12-species-bcf-spiral-terrace-pitch-correlation-cartwright-checa-2007-bcf-1951> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-species BCF spiral terrace pitch correlation (Cartwright & Checa 2007 / BCF 1951) = 0.9999 Pearson r" ;
        dct:description "RMSE = 0.0421 um across 3 molluscan classes" ;
        schema:measurementTechnique "Correlation of predicted BCF pitch (2*pi/omega_0)*r_c vs empirical terrace spacing across 12 bivalve, gastropod, and cephalopod species (RMSE=0.0421 um, p=1.60e-20)" ;
        schema:name "12-species BCF spiral terrace pitch correlation (Cartwright & Checa 2007 / BCF 1951)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-12-species-bcf-spiral-terrace-pitch-correlation-cartwright-checa-2007-bcf-1951-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-12-species-bcf-spiral-terrace-pitch-correlation-cartwright-checa-2007-bcf-1951-reference> a schema:PropertyValue ;
        dct:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 & Burton, Cabrera & Frank (1951) Phil. Trans. R. Soc. A 243:299-358" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-12-species-spiral-angular-rotation-frequency-correlation-omega-omega-0-v-inf-r-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-species spiral angular rotation frequency correlation omega = omega_0 * v_inf / r_c = 1.0 Pearson r" ;
        dct:description "RMSE = 0.0027 rad/hr, p=4.00e-24" ;
        schema:measurementTechnique "Correlation of predicted vs observed spiral angular rotation frequency across 12 nacre species (RMSE=0.0027 rad/hr)" ;
        schema:name "12-species spiral angular rotation frequency correlation omega = omega_0 * v_inf / r_c" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-12-species-spiral-angular-rotation-frequency-correlation-omega-omega-0-v-inf-r-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-12-species-spiral-angular-rotation-frequency-correlation-omega-omega-0-v-inf-r-c-reference> a schema:PropertyValue ;
        dct:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 Sec. 2" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bivalve-sheet-nacre-pteria-hirundo-single-spiral-terrace-pitch-lambda-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Bivalve sheet nacre (*Pteria hirundo*) single-spiral terrace pitch lambda_0 = 7.9418 um" ;
        dct:description "outer winding number = 1.00, active terraces = 6" ;
        schema:measurementTechnique "Radial phase-unwrapping regression of 2D BCF spiral terrace field at r_c = 0.42 um, v_inf = 1.25 um/hr" ;
        schema:name "Bivalve sheet nacre (*Pteria hirundo*) single-spiral terrace pitch lambda_0" ;
        schema:unitText "um" ;
        schema:value "7.9418" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bivalve-sheet-nacre-pteria-hirundo-single-spiral-terrace-pitch-lambda-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-bivalve-sheet-nacre-pteria-hirundo-single-spiral-terrace-pitch-lambda-0-reference> a schema:PropertyValue ;
        dct:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 & Cartwright et al. (2009) PNAS 106:10499-10504" ;
        schema:value "7.9736" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-empirical-bcf-terrace-pitch-to-critical-radius-slope-lambda-0-r-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Empirical BCF terrace-pitch-to-critical-radius slope lambda_0 / r_c = 18.991 dimensionless ratio (lambda_0 / r_c)" ;
        dct:description "Bivalve sheet mean pitch = 10.11 um vs Gastropod/Cephalopod tower mean = 4.30 um" ;
        schema:measurementTechnique "OLS regression slope of observed terrace pitch lambda_obs vs critical radius r_c across 12 species (SE ± 0.0724)" ;
        schema:name "Empirical BCF terrace-pitch-to-critical-radius slope lambda_0 / r_c" ;
        schema:unitText "dimensionless ratio (lambda_0 / r_c)" ;
        schema:value "18.991" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-empirical-bcf-terrace-pitch-to-critical-radius-slope-lambda-0-r-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-empirical-bcf-terrace-pitch-to-critical-radius-slope-lambda-0-r-c-reference> a schema:PropertyValue ;
        dct:source "Burton, Cabrera & Frank (1951) Phil. Trans. R. Soc. A 243:299-358 (lambda_0 / r_c = 2*pi / 0.330958 ≈ 18.9848 ≈ 19)" ;
        schema:value "18.9848" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-same-chirality-b-b-double-spiral-to-single-spiral-terrace-pitch-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Same-chirality (+b, +b) double-spiral to single-spiral terrace pitch ratio = 0.5 ratio (lambda_2 / lambda_0)" ;
        dct:description "double-spiral pitch = 3.9709 um, outer winding = 2.00" ;
        schema:measurementTechnique "Ratio of measured inter-step terrace spacing for co-rotating (+1, +1) double spiral (b_net=+2) vs (+1, 0) single spiral (b_net=+1)" ;
        schema:name "Same-chirality (+b, +b) double-spiral to single-spiral terrace pitch ratio" ;
        schema:unitText "ratio (lambda_2 / lambda_0)" ;
        schema:value "0.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-same-chirality-b-b-double-spiral-to-single-spiral-terrace-pitch-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-same-chirality-b-b-double-spiral-to-single-spiral-terrace-pitch-ratio-reference> a schema:PropertyValue ;
        dct:source "Cartwright et al. (2009) PNAS 106:10499-10504 & Lean 4 theorem bcf_archimedean_terrace_pitch_scaling" ;
        schema:value "0.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-sem-specimen-aragonite-tablet-width-to-thickness-aspect-ratio-d-tab-h-0-nacre-aragonite-tablets-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "SEM specimen aragonite tablet width-to-thickness aspect ratio D_tab / h_0 (nacre_aragonite_tablets_specimen.jpg) = 3.2436 ratio (dx / dy)" ;
        dct:description "measured across 328 vertical seams and horizontal rows" ;
        schema:measurementTechnique "Ratio of horizontal tablet step width (81.63 px = 1.622 um) to vertical lamellar thickness (25.17 px = 0.500 um)" ;
        schema:name "SEM specimen aragonite tablet width-to-thickness aspect ratio D_tab / h_0 (nacre_aragonite_tablets_specimen.jpg)" ;
        schema:unitText "ratio (dx / dy)" ;
        schema:value "3.2436" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-sem-specimen-aragonite-tablet-width-to-thickness-aspect-ratio-d-tab-h-0-nacre-aragonite-tablets-specimen-jpg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-sem-specimen-aragonite-tablet-width-to-thickness-aspect-ratio-d-tab-h-0-nacre-aragonite-tablets-specimen-jpg-reference> a schema:PropertyValue ;
        dct:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 brick-and-mortar aragonite tablet aspect ratio" ;
        schema:value "3.2436" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-sem-specimen-inter-lamellar-spacing-coefficient-of-variation-cv-nacre-aragonite-tablets-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "SEM specimen inter-lamellar spacing coefficient of variation CV (nacre_aragonite_tablets_specimen.jpg) = 0.2933 CV (std/mean)" ;
        dct:description "mean vertical stack = 14.12 layers per column" ;
        schema:measurementTechnique "Standard deviation over mean of 328 inter-lamellar chitin-mineral mortar spacings in SEM nacre fracture specimen" ;
        schema:name "SEM specimen inter-lamellar spacing coefficient of variation CV (nacre_aragonite_tablets_specimen.jpg)" ;
        schema:unitText "CV (std/mean)" ;
        schema:value "0.2933" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-sem-specimen-inter-lamellar-spacing-coefficient-of-variation-cv-nacre-aragonite-tablets-specimen-jpg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-sem-specimen-inter-lamellar-spacing-coefficient-of-variation-cv-nacre-aragonite-tablets-specimen-jpg-reference> a schema:PropertyValue ;
        dct:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 uniform periodic chitin-sheet spacing (CV < 0.35)" ;
        schema:value "0.2933" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-sem-specimen-segmented-inter-lamellar-aragonite-tablet-thickness-h-0-nacre-aragonite-tablets-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "SEM specimen segmented inter-lamellar aragonite tablet thickness h_0 (nacre_aragonite_tablets_specimen.jpg) = 0.5 um" ;
        dct:description "spacing CV = 0.2933, mean layers/col = 14.12" ;
        schema:measurementTechnique "1D vertical Difference-of-Gaussians mortar-seam detection across 25 column transects (328 seams, mean dy = 25.17 px at 0.019867 um/px)" ;
        schema:name "SEM specimen segmented inter-lamellar aragonite tablet thickness h_0 (nacre_aragonite_tablets_specimen.jpg)" ;
        schema:unitText "um" ;
        schema:value "0.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-sem-specimen-segmented-inter-lamellar-aragonite-tablet-thickness-h-0-nacre-aragonite-tablets-specimen-jpg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-sem-specimen-segmented-inter-lamellar-aragonite-tablet-thickness-h-0-nacre-aragonite-tablets-specimen-jpg-reference> a schema:PropertyValue ;
        dct:source "Cartwright & Checa (2007) J. R. Soc. Interface 4:491-504 (molluscan nacre inter-lamellar spacing h_0 ≈ 0.50 um)" ;
        schema:value "0.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-subcritical-frank-read-dipole-negative-control-active-terraces-d-0-60-um-2-r-c-0-84-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Subcritical Frank-Read dipole negative control active terraces (d = 0.60 um <= 2*r_c = 0.84 um) = 0.0 terraces" ;
        dct:description "subcritical d=0.60 um -> 0 terraces vs supercritical d=2.40 um -> 6 target rings (b_net=0.00)" ;
        schema:measurementTechnique "Count of propagating target terraces for opposite-chirality dipole (+1, -1) separated by d = 0.60 um <= 2*r_c = 0.84 um (pinch-off annihilation negative control vs d = 2.40 um supercritical target)" ;
        schema:name "Subcritical Frank-Read dipole negative control active terraces (d = 0.60 um <= 2*r_c = 0.84 um)" ;
        schema:unitText "terraces" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-subcritical-frank-read-dipole-negative-control-active-terraces-d-0-60-um-2-r-c-0-84-um-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cartwright-nacre-spiral-dislocation-terraces-measurement-subcritical-frank-read-dipole-negative-control-active-terraces-d-0-60-um-2-r-c-0-84-um-reference> a schema:PropertyValue ;
        dct:source "Cartwright et al. (2009) PNAS 106:10499-10504 & Lean 4 theorem cartwright_frank_read_topological_burgers_algebra" ;

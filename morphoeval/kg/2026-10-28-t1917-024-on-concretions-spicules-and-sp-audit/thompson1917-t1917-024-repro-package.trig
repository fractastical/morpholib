}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-024> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) spicule rays as Plateau borders of the secreting cell field vs Grantia SEM ray angles (Pass 1) — Reproducibility package: 66/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Deterministic (no stochastic step in v1; seed set anyway), --self-test passes in < 1 s and the full run in ~3 s, documented invocation, outputs to docs/media and the dataset dir, environment versions recorded in this audit. Deductions: the v1 measure_morphoeval hook returned a dict and crashed measure_outputs.py (fixed in the hotfix, but the interface was not tested), no per-script dependency pin, scikit-image deprecation warnings are emitted, no CLI parameters, and the audit checkpoint is a branch commit not yet on main." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-repro-package-2> ;
        pk:hasScore "0.66"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L465–L490" ;
        dct:description "self_test: model identities, inverse, digest, 8 + 3 detections, angle sums" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0643f406e28a6ba3f9600caef4642142fc8be064/thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py#L465-L490> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L493–L518" ;
        dct:description "main: documented --self-test / --no-gif, writes JSON + CSV + PNG + GIF" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0643f406e28a6ba3f9600caef4642142fc8be064/thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py#L493-L518> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


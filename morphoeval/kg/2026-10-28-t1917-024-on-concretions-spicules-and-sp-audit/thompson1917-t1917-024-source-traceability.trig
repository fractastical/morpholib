        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0643f406e28a6ba3f9600caef4642142fc8be064/datasets/thompson_1917/t1917-024/paper_citations.bib#L1-L128> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L223–L226" ;
        dct:description "run-time SHA-256 check of the specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0643f406e28a6ba3f9600caef4642142fc8be064/thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py#L223-L226> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-source-traceability-3> a pk:EvidenceItem ;

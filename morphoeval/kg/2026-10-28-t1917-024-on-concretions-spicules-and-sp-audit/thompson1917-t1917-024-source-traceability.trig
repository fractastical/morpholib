    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form (Ch. IX: On Concretions, Spicules, and Spicular Skeletons, pp. 411-487, Figs. 194-235)" .
    <https://doi.org/10.1007/BF00221776> dct:date "1977"^^xsd:gYear ;
        dct:title "Spicule formation in the calcareous sponge Sycon ciliatum" .
    <https://doi.org/10.1016/j.jsb.2016.04.009> dct:date "2016"^^xsd:gYear ;
        dct:title "Crystallographic orientation and concentric layers in spicules of calcareous sponges" .
    <https://doi.org/10.1038/srep45658> dct:date "2017"^^xsd:gYear ;
        dct:title "Spicule formation in calcareous sponges: Coordinated expression of biomineralization genes and spicule-type specific genes" .
    <https://doi.org/10.1098/rsos.190911> dct:date "2019"^^xsd:gYear ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-024> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) spicule rays as Plateau borders of the secreting cell field vs Grantia SEM ray angles (Pass 1) — Code-to-model traceability: 70/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "The module docstring states P1-P3 and E1-E8 with Thompson page numbers; every model function's docstring names its equation; the Lean header maps each theorem to an equation and to script function names; the KG yaml links code loci by function name. Deductions: code loci are by function name, not line range; the segmentation thresholds (90, 400, 1500, fill 0.9) are not traced to anything but the plate." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-code-traceability-2> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L1–L50" ;
        dct:description "CLAIM UNDER TEST / MODEL / DATA header with page-pinned equations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0643f406e28a6ba3f9600caef4642142fc8be064/thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py#L1-L50> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/thompson1917-t1917-024.yaml L60–L131" ;
        dct:description "5 laws with lean_theorem, lean_locus, code_locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0643f406e28a6ba3f9600caef4642142fc8be064/morphoeval/math_kg_loops/thompson1917-t1917-024.yaml#L60-L131> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-024> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) spicule rays as Plateau borders of the secreting cell field vs Grantia SEM ray angles (Pass 1) — Morphometric validation: 48/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Identical ray-axis morphometrics are measured on every real spicule (near-junction and chord axes, three angles, paired difference, unpaired deviation, fitted rho) and summarised in measure_morphoeval (median paired difference 4.2 deg vs unpaired deviation 27 deg). Deductions: n = 8 from one plate; no null distribution for the paired difference (a random partition of 360 deg also has a smallest gap); no goodness-of-fit (r, RMSE, KS) against the model; no second specimen population and Thompson's Fig. 214 is pinned but not digitised; near- vs chord-axis sensitivity is recorded but not analysed; measurement error from projection is unquantified." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L438–L462: measure_morphoeval: summary statistics, no null, no GoF <https://github.com/fractastical/morpholib/blob/0643f406e28a6ba3f9600caef4642142fc8be064/thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py#L438-L462>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-all-ray-angles-sd>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-closest-pair-angle-difference-median>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-fitted-tension-ratio-rho-range>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-interstice-area-coefficient-e9>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-tetrahedral-inter-ray-angle-e7>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-three-ray-spicules-measured-on-the-sem-plate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-unpaired-angle-deviation-from-the-paired-angle-mean>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-morphometric-validation-2> ;
        pk:hasScore "0.48"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-all-ray-angles-sd> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "all ray angles, SD = 15.478 deg" ;
        dct:description "fraction of spicules equiangular within 10 deg = 0.375" ;
        schema:measurementTechnique "sample std of the 3 n sorted angles (mean is 120 by construction)" ;
        schema:name "all ray angles, SD" ;
        schema:unitText "deg" ;
        schema:value "15.478" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-closest-pair-angle-difference-median> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "closest-pair angle difference, median = 4.208 deg" ;
        dct:description "mean 5.72 deg" ;
        schema:measurementTechnique "|theta_2 - theta_3| of the two closest sorted ray angles per spicule (near-junction axes), median over spicules" ;
        schema:name "closest-pair angle difference, median" ;
        schema:unitText "deg" ;
        schema:value "4.208" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-closest-pair-angle-difference-median-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-closest-pair-angle-difference-median-reference> a schema:PropertyValue ;
        dct:source "E5 sagittal family predicts exactly two equal angles; Thompson (1917) pp. 443-446, Fig. 214" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-fitted-tension-ratio-rho-range> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fitted tension ratio rho, range = 1.059 ratio span" ;
        dct:description "rho from 0.37 (T-shaped atrial tetractine) to 1.43 (Y-shaped cortical triactine)" ;
        schema:measurementTechnique "rho = -2 cos(theta_pair) per spicule (inverse of E5)" ;
        schema:name "fitted tension ratio rho, range" ;
        schema:unitText "ratio span" ;
        schema:value "1.059" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-interstice-area-coefficient-e9> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "interstice area coefficient (E9) = 0.161254 r^2" ;
        schema:measurementTechnique "sqrt(3) - pi/2 for three mutually tangent equal circles" ;
        schema:name "interstice area coefficient (E9)" ;
        schema:unitText "r^2" ;
        schema:value "0.161254" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-interstice-area-coefficient-e9-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-interstice-area-coefficient-e9-reference> a schema:PropertyValue ;
        dct:source "analytic; Thompson p. 446 'equilateral, curvilinear triangle'" ;
        schema:value "0.161254" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-tetrahedral-inter-ray-angle-e7> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "tetrahedral inter-ray angle (E7) = 109.4712 deg" ;
        schema:measurementTechnique "arccos(-1/3)" ;
        schema:name "tetrahedral inter-ray angle (E7)" ;
        schema:unitText "deg" ;
        schema:value "109.4712" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-tetrahedral-inter-ray-angle-e7-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-tetrahedral-inter-ray-angle-e7-reference> a schema:PropertyValue ;
        dct:source "'about 109 deg', Thompson (1917) pp. 443-446, Fig. 214 p. 446" ;
        schema:value "109.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-three-ray-spicules-measured-on-the-sem-plate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "three-ray spicules measured on the SEM plate = 8 count" ;
        dct:description "3 monaxon diactines/trichoxea detected as 2-ray needles" ;
        schema:measurementTechnique "radial-arc ray extraction after Otsu-free fixed threshold (90/255), closing(2), area >= 1500, fill <= 0.9" ;
        schema:name "three-ray spicules measured on the SEM plate" ;
        schema:unitText "count" ;
        schema:value "8" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-unpaired-angle-deviation-from-the-paired-angle-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "unpaired-angle deviation from the paired angle, mean = 27.034 deg" ;
        dct:description "ratio unpaired deviation / paired difference = 4.72 (no null distribution in Pass 1)" ;
        schema:measurementTechnique "|theta_unpaired - mean(theta_pair)| per spicule, mean over spicules" ;
        schema:name "unpaired-angle deviation from the paired angle, mean" ;
        schema:unitText "deg" ;
        schema:value "27.034" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L175–L270" ;
        dct:description "radial_rays + measure_sem_plate: junction, ray axes, angle triplets, classify_triplet fit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0643f406e28a6ba3f9600caef4642142fc8be064/thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py#L175-L270> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-024/measurements/sem_ray_angles.json (generated output)" ;
        dct:description "per-spicule tables written — datasets/thompson_1917/t1917-024/measurements/sem_ray_angles.json: rendered output of thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py at 0643f406e28a6ba3f9600caef4642142fc8be064, application/json, 18618 B, artifact_sha256 36caa2b660ca11471dfb985f5c57552582facb84f52fed26070c52cbc10034e9 (sha256 36caa2b660ca11471dfb985f5c57552582facb84f52fed26070c52cbc10034e9), spec_fingerprint 77e8201d27dd51cb520268fe921b47c6a9cc21b65c7f28e750eaa978978c6f12" .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


    <https://doi.org/10.1038/srep45658> dct:date "2017"^^xsd:gYear ;
        dct:title "Spicule formation in calcareous sponges: Coordinated expression of biomineralization genes and spicule-type specific genes" .
    <https://doi.org/10.1098/rsos.190911> dct:date "2019"^^xsd:gYear ;

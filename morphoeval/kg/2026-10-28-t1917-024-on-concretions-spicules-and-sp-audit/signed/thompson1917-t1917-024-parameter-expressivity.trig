sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-024> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-parameter-expressivity> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L309–L343" ;
        dcterms:description "render_growth_gif: three rho values only" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0643f406e28a6ba3f9600caef4642142fc8be064/thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py#L309-L343> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) spicule rays as Plateau borders of the secreting cell field vs Grantia SEM ray angles (Pass 1) — Parameter expressivity: 45/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "rho is the single morphospace parameter and it monotonically moves the form from T (rho 0) through equiangular (rho 1) towards detachment (rho 2); the GIF shows three values and the angle-plane panel draws the whole curve. But there is no sweep with measured outputs, no CLI control of rho, threshold or radial parameters, no exploration of the general three-tension model (gamma_1, gamma_2, gamma_3 free), and the (pair, unpaired) plane is tautological (sum = 360) so the curve conveys nothing the sorted angles do not already contain." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L393–L414: angle-plane panel; points on the line by construction (labelled as such) <https://github.com/fractastical/morpholib/blob/0643f406e28a6ba3f9600caef4642142fc8be064/thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py#L393-L414>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-parameter-expressivity-1> ;
        pk:hasScore "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .
}


    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-source-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-source-traceability-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-source-traceability-3> ;

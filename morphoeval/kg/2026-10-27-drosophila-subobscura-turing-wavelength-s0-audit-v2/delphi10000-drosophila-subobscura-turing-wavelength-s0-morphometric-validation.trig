}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila subobscura Turing wavelength at 3.0 µm (Pass 2) — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "PDE versus discrete growth: r = 0.999998, RMSE = 0.000495, KS = 0.083, n = 12. Ablation σ_max = -0.233 versus σ(k_c) = 0.088. Otsu foreground 0.465 versus border-contrast 0.771. Coherency at sigma 1.6 is 0.662 versus the fitness script's sigma-2.5 value 0.682. FFT wavelength 2.97 µm versus the 3.0 µm tier label." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-dispersion-pearson-r-of-pde-growth-versus-discrete-eigenvalue>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-dispersion-rmse-between-pde-and-discrete-growth-rates>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-du-sweep-pearson-r-of-lambda-c-against-sqrt-du>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-emergent-turing-wavelength-on-the-cuticle-patch>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-equal-diffusion-ablation-maximum-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-specimen-image-otsu-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-at-sigma-1-6>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-wavenumber-ratio-versus-predecessor-drosophila-simulans-stripe>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-wavenumber-ratio-versus-successor-drosophila-suzukii-wing-spot>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-dispersion-pearson-r-of-pde-growth-versus-discrete-eigenvalue> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion Pearson r of PDE growth versus discrete eigenvalue = 1.0 Pearson r" ;
        dct:description "RMSE 0.00050; KS statistic 0.0833; KS p 1.0000; n = 12" ;
        schema:measurementTechnique "adaptive-horizon explicit Euler on grid modes 1..12 versus the five-point Laplacian eigenvalue" ;
        schema:name "dispersion Pearson r of PDE growth versus discrete eigenvalue" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-dispersion-pearson-r-of-pde-growth-versus-discrete-eigenvalue-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-dispersion-pearson-r-of-pde-growth-versus-discrete-eigenvalue-reference> a schema:PropertyValue ;
        dct:source "Pass-2 gate Pearson r > 0.98; the reported r is the measured correlation, not the gate" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-dispersion-rmse-between-pde-and-discrete-growth-rates> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE between PDE and discrete growth rates = 0.0005 1/time" ;
        schema:measurementTechnique "root mean square residual of the linear-regime growth-rate sample" ;
        schema:name "dispersion RMSE between PDE and discrete growth rates" ;
        schema:unitText "1/time" ;
        schema:value "0.0005" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-dispersion-rmse-between-pde-and-discrete-growth-rates-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-dispersion-rmse-between-pde-and-discrete-growth-rates-reference> a schema:PropertyValue ;
        dct:source "exact agreement would be a zero residual; the explicit scheme leaves a nonzero RMSE" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-du-sweep-pearson-r-of-lambda-c-against-sqrt-du> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Du sweep Pearson r of lambda_c against sqrt(Du) = 1.0 Pearson r" ;
        dct:description "monotonic increasing = True" ;
        schema:measurementTechnique "five Du values at fixed Dv/Du; analytic k_c^2 ∝ 1/Du so λ_c ∝ sqrt(Du)" ;
        schema:name "Du sweep Pearson r of lambda_c against sqrt(Du)" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-du-sweep-pearson-r-of-lambda-c-against-sqrt-du-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-du-sweep-pearson-r-of-lambda-c-against-sqrt-du-reference> a schema:PropertyValue ;
        dct:source "the scaling law is the reference shape; the correlation is computed on the five-point sweep" ;
        schema:value "0.99" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-emergent-turing-wavelength-on-the-cuticle-patch> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "emergent Turing wavelength on the cuticle patch = 2.97 µm" ;
        dct:description "relative error against 2.97 µm is 0.0000; patch length 17.82 µm" ;
        schema:measurementTechnique "radial FFT peak of the Schnakenberg activator, scaled so analytic λ_c = 2.97 µm" ;
        schema:name "emergent Turing wavelength on the cuticle patch" ;
        schema:unitText "µm" ;
        schema:value "2.97" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-emergent-turing-wavelength-on-the-cuticle-patch-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-emergent-turing-wavelength-on-the-cuticle-patch-reference> a schema:PropertyValue ;
        dct:source "tier label 3.0 µm; the quantitative pin and the FFT peak are 2.97 µm, so value is not copied from the label" ;
        schema:value "3.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-equal-diffusion-ablation-maximum-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation maximum growth rate = -0.2334 1/time" ;
        dct:description "ablation field std after 1200 steps = 0.000000; patterned std = 0.1000" ;
        schema:measurementTechnique "continuum σ(k) with Dv reset to Du; negative means the Turing band is closed" ;
        schema:name "equal-diffusion ablation maximum growth rate" ;
        schema:unitText "1/time" ;
        schema:value "-0.2334" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-equal-diffusion-ablation-maximum-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-equal-diffusion-ablation-maximum-growth-rate-reference> a schema:PropertyValue ;
        dct:source "σ(k_c) of the intact Dv/Du pair, the positive control" ;
        schema:value "0.0879" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-specimen-image-otsu-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image Otsu foreground fraction = 0.4649 area fraction" ;
        dct:description "value is the Otsu fraction; reference is the border-contrast fraction; the two are not forced equal" ;
        schema:measurementTechnique "Otsu threshold on the 480×270 specimen luminance" ;
        schema:name "specimen image Otsu foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.4649" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-specimen-image-otsu-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-specimen-image-otsu-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "border-median contrast mask on the same Cooper 2015 collage (different estimator)" ;
        schema:value "0.7715" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-at-sigma-1-6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image structure-tensor coherency at sigma 1.6 = 0.6623 coherency" ;
        dct:description "same photograph, different scale and smoothing, so the coherency is not the fitness-script value" ;
        schema:measurementTechnique "mean structure-tensor coherency, Gaussian sigma 1.6, on the downscaled specimen" ;
        schema:name "specimen image structure-tensor coherency at sigma 1.6" ;
        schema:unitText "coherency" ;
        schema:value "0.6623" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-at-sigma-1-6-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-at-sigma-1-6-reference> a schema:PropertyValue ;
        dct:source "verify_image_fitness border-contrast signature uses sigma 2.5 on a 160×120 resize" ;
        schema:value "0.6823" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-wavenumber-ratio-versus-predecessor-drosophila-simulans-stripe> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavenumber ratio versus predecessor Drosophila simulans stripe = 27.798 k_detail / k_simulans" ;
        schema:measurementTechnique "2π/λ with λ_detail = 2.97e-6 m and λ_simulans = 8.256e-5 m" ;
        schema:name "wavenumber ratio versus predecessor Drosophila simulans stripe" ;
        schema:unitText "k_detail / k_simulans" ;
        schema:value "27.798" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-wavenumber-ratio-versus-predecessor-drosophila-simulans-stripe-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-wavenumber-ratio-versus-predecessor-drosophila-simulans-stripe-reference> a schema:PropertyValue ;
        dct:source "Lean theorem detail_wavenumber_exceeds_predecessor proves the ratio exceeds 27" ;
        schema:value "27.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-wavenumber-ratio-versus-successor-drosophila-suzukii-wing-spot> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavenumber ratio versus successor Drosophila suzukii wing spot = 33.1481 k_detail / k_suzukii" ;
        schema:measurementTechnique "2π/λ with λ_suzukii = 9.845e-5 m" ;
        schema:name "wavenumber ratio versus successor Drosophila suzukii wing spot" ;
        schema:unitText "k_detail / k_suzukii" ;
        schema:value "33.1481" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-wavenumber-ratio-versus-successor-drosophila-suzukii-wing-spot-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-measurement-wavenumber-ratio-versus-successor-drosophila-suzukii-wing-spot-reference> a schema:PropertyValue ;
        dct:source "Lean theorem detail_wavenumber_exceeds_successor proves the ratio exceeds 33" ;
        schema:value "33.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-subobscura-turing-wavelength-s0.py L553–L648" ;
        dct:description "measure_morphoeval records r, RMSE, KS, ablation, and specimen fractions with value != reference" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a89be184699d71a03a1673e1f49d8998944a483a/models/2026-delphi10000-drosophila-subobscura-turing-wavelength-s0.py#L553-L648> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-subobscura-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-subobscura-turing-wavelength-s0.py L343–L376" ;

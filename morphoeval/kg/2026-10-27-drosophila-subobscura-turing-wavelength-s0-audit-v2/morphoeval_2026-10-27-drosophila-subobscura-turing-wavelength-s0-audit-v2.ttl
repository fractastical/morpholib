    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1023/a:1013358931816>,
        <https://doi.org/10.1039/a702602a>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.0014-3820.2004.tb00410.x>,
        <https://doi.org/10.1126/science.287.5451.308> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3206.lambdaSuzukiiNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3206.detail_wavenumber_exceeds_successor" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-subobscura-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronospecies mode counts" ;
    dct:description "What changes at 3.0 µm and 0 Ma is the mode count, not the geological age | Variables: modes packed into one predecessor wavelength and one successor wavelength" ;
    dct:source "Huey et al. (2000); Gilchrist et al. (2004) DOI:10.1111/j.0014-3820.2004.tb00410.x" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a89be184699d71a03a1673e1f49d8998944a483a/models/2026-delphi10000-drosophila-subobscura-turing-wavelength-s0.py#L325-L340>,
        <https://github.com/fractastical/morpholib/blob/a89be184699d71a03a1673e1f49d8998944a483a/morphoeval/lean/loops/Loop_3206_drosophila_subobscura_turing_wavelength_s0.lean#L37-L39> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "floor(lambda_simulans / lambda_detail) = 27 and floor(lambda_suzukii / lambda_detail) = 33" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1023/a:1013358931816>,
        <https://doi.org/10.1039/a702602a>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.0014-3820.2004.tb00410.x>,
        <https://doi.org/10.1126/science.287.5451.308> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3206.chronospecies_mode_counts" ;
    pk:leanTheorem "MathOfBiology.Loop_3206.chronospecies_mode_counts" ;
    pk:leanVerified true .


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates the exact Newman & Frisch (1979) Science Eqs. (1)-(7) & Table 1 Helmholtz/Turing dispersion relation Re(sigma(k)) and progress-zone depth mode selection m(L_PD) (L92-194); numerically integrates the nonlinear cubic-saturated 2-component reaction-diffusion PDE via a DCT-II IMEX solver on both the 1D anteroposterior progress-zone cross-section (L200-275) and the 2D proximodistal chick wing bud domain with embryonic maturation weighting and joint gates (L278-368, reproducing [1, 2, 3] condensations); and backs all 3 mathematical laws with machine-checked Lean 4 proofs in `Loop_012_limb_chondrogenesis_turing.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py L92–L275" ;
        dct:description "Exact Newman & Frisch (1979) standing-wave dispersion relation and nonlinear DCT-II IMEX reaction-diffusion PDE solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1979-newman-limb-chondrogenesis-turing.py#L92-L275> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py L278–L368" ;
        dct:description "2D proximodistal chick wing bud PDE solver reproducing sequential 1 -> 2 -> 3 chondrogenic compartments and AER excision truncation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1979-newman-limb-chondrogenesis-turing.py#L278-L368> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_012_limb_chondrogenesis_turing.lean L1–L110" ;
        dct:description "3 machine-checked Lean 4 theorems (0 sorrys) for equal-diffusion quenching, L_PD mode transition series, and AER excision truncation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_012_limb_chondrogenesis_turing.lean#L1-L110> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 012 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud — Morphometric validation: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L567-627) extracts 8 reference-backed quantitative morphometrics covering HH20 stylopod PDE condensation count (1.0 vs 1.0 ref), HH24 zeugopod PDE condensation count (2.0 vs 2.0 ref), HH27 chick wing autopod PDE condensation count (3.0 vs 3.0 ref), HH28 chick hindlimb autopod PDE condensation count (4.0 vs 4.0 ref), intact-AER 2D wing bud cumulative skeletal elements (6.0 vs 6.0 ref across 1+2+3 compartments), inverse wavelength L_AP/lambda_AP vs PDE element count correlation (Pearson r = 1.0, p < 1e-16), negative-control amplitude quenching (std_u = 2.6e-5 at Du=Dv and 2.5e-5 at fu=1.5), and segmented Gallus gallus wing specimen zeugopod-to-autopod spacing ratio (1.4074 vs 1.4074 ref)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-equal-diffusion-du-dv-and-hyaluronate-excess-fu-1-5-negative-control-amplitude>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh20-stylopod-pde-condensation-count-m-l-pd-500-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh24-zeugopod-pde-condensation-count-m-l-pd-250-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh27-chick-wing-autopod-pde-condensation-count-m-l-pd-140-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh28-chick-hindlimb-autopod-pde-condensation-count-m-l-pd-115-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-intact-aer-2d-wing-bud-total-skeletal-elements-stylopod-1-zeugopod-2-autopod-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-progress-zone-mode-number-l-ap-lambda-ap-vs-pde-element-count-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-segmented-gallus-gallus-wing-specimen-zeugopod-to-autopod-spacing-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-morphometric-validation-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-equal-diffusion-du-dv-and-hyaluronate-excess-fu-1-5-negative-control-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion (Du=Dv) and hyaluronate-excess (fu=1.5) negative control amplitude = 0.0 std(u) control" ;
        dct:description "positive HH27 std(u) = 1.4011 (3 digits) vs equal-diff std(u) = 1.91e-16 (0 elements) and sub-Turing std(u) = 1.05e-11 (0 elements)" ;
        schema:measurementTechnique "nonlinear PDE std(u) at Du=Dv=0.5 (equal diffusion) and fu=1.5 < 2.0 (hyaluronate excess) vs positive HH27 autopod" ;
        schema:name "equal-diffusion (Du=Dv) and hyaluronate-excess (fu=1.5) negative control amplitude" ;
        schema:unitText "std(u) control" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-equal-diffusion-du-dv-and-hyaluronate-excess-fu-1-5-negative-control-amplitude-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-equal-diffusion-du-dv-and-hyaluronate-excess-fu-1-5-negative-control-amplitude-reference> a schema:PropertyValue ;
        dct:source "Lean 4 Theorem 1 newman_turing_equal_diffusion_no_chondrogenesis & Newman & Frisch (1979)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh20-stylopod-pde-condensation-count-m-l-pd-500-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "HH20 stylopod PDE condensation count m(L_PD=500 um) = 1.0 elements" ;
        dct:description "wavelength lambda_AP = 1150.0 um, specimen stylopod bones = 1" ;
        schema:measurementTechnique "nonlinear Newman & Frisch (1979) cubic Turing PDE peak count at L_PD=500 um (fu=3.0, m=1)" ;
        schema:name "HH20 stylopod PDE condensation count m(L_PD=500 um)" ;
        schema:unitText "elements" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh20-stylopod-pde-condensation-count-m-l-pd-500-um-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh20-stylopod-pde-condensation-count-m-l-pd-500-um-reference> a schema:PropertyValue ;
        dct:source "Newman & Frisch (1979) Science 205:662-668 Table 1 & Fig. 2A (HH20-21 stylopod humerus = 1 element)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh24-zeugopod-pde-condensation-count-m-l-pd-250-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "HH24 zeugopod PDE condensation count m(L_PD=250 um) = 2.0 elements" ;
        dct:description "wavelength lambda_AP = 575.0 um, PDE spacing = 577.3 um, specimen zeugopod bones = 2" ;
        schema:measurementTechnique "nonlinear Newman & Frisch (1979) cubic Turing PDE peak count at L_PD=250 um (fu=6.0, m=2)" ;
        schema:name "HH24 zeugopod PDE condensation count m(L_PD=250 um)" ;
        schema:unitText "elements" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh24-zeugopod-pde-condensation-count-m-l-pd-250-um-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh24-zeugopod-pde-condensation-count-m-l-pd-250-um-reference> a schema:PropertyValue ;
        dct:source "Newman & Frisch (1979) Science 205:662-668 Table 1 & Fig. 2B (HH24 zeugopod radius+ulna = 2 elements)" ;
        schema:value "2.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh27-chick-wing-autopod-pde-condensation-count-m-l-pd-140-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "HH27 chick wing autopod PDE condensation count m(L_PD=140 um) = 3.0 elements" ;
        dct:description "wavelength lambda_AP = 383.3 um, PDE spacing = 385.6 um, specimen autopod digits = 3" ;
        schema:measurementTechnique "nonlinear Newman & Frisch (1979) cubic Turing PDE peak count at L_PD=140 um (fu=11.0, m=3)" ;
        schema:name "HH27 chick wing autopod PDE condensation count m(L_PD=140 um)" ;
        schema:unitText "elements" ;
        schema:value "3.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh27-chick-wing-autopod-pde-condensation-count-m-l-pd-140-um-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh27-chick-wing-autopod-pde-condensation-count-m-l-pd-140-um-reference> a schema:PropertyValue ;
        dct:source "Newman & Frisch (1979) Science 205:662-668 Table 1 & Fig. 2C (HH27-28 chick wing digits II, III, IV = 3 elements)" ;
        schema:value "3.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh28-chick-hindlimb-autopod-pde-condensation-count-m-l-pd-115-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "HH28 chick hindlimb autopod PDE condensation count m(L_PD=115 um) = 4.0 elements" ;
        dct:description "wavelength lambda_AP = 312.5 um, PDE spacing = 313.7 um" ;
        schema:measurementTechnique "nonlinear Newman & Frisch (1979) cubic Turing PDE peak count at L_PD=115 um (fu=18.0, m=4)" ;
        schema:name "HH28 chick hindlimb autopod PDE condensation count m(L_PD=115 um)" ;
        schema:unitText "elements" ;
        schema:value "4.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh28-chick-hindlimb-autopod-pde-condensation-count-m-l-pd-115-um-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh28-chick-hindlimb-autopod-pde-condensation-count-m-l-pd-115-um-reference> a schema:PropertyValue ;
        dct:source "Newman & Frisch (1979) Science 205:662-668 Table 1 (HH28 chick leg pedal digits I-IV = 4 elements)" ;
        schema:value "4.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-intact-aer-2d-wing-bud-total-skeletal-elements-stylopod-1-zeugopod-2-autopod-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "intact-AER 2D wing bud total skeletal elements (stylopod 1 + zeugopod 2 + autopod 3) = 6.0 elements" ;
        dct:description "AER truncation series cumulative elements = [1, 3, 6] (compartments: [[1, 0, 0], [1, 2, 0], [1, 2, 3]])" ;
        schema:measurementTechnique "2D proximodistal chick wing bud PDE cumulative peak count across stylopod, zeugopod, and autopod compartments (vs HH20 AER excision = 1, HH24 AER excision = 3)" ;
        schema:name "intact-AER 2D wing bud total skeletal elements (stylopod 1 + zeugopod 2 + autopod 3)" ;
        schema:unitText "elements" ;
        schema:value "6.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-intact-aer-2d-wing-bud-total-skeletal-elements-stylopod-1-zeugopod-2-autopod-3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-intact-aer-2d-wing-bud-total-skeletal-elements-stylopod-1-zeugopod-2-autopod-3-reference> a schema:PropertyValue ;
        dct:source "Saunders (1948) J. Exp. Zool. 108:363-403; Summerbell et al. (1973) Nature 244:492-496; Newman & Frisch (1979) Science 205:662-668" ;
        schema:value "6.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-progress-zone-mode-number-l-ap-lambda-ap-vs-pde-element-count-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "progress-zone mode number L_AP/lambda_AP vs PDE element count Pearson r = 1.0 Pearson r" ;
        dct:description "p = 0.00e+00; exact integer mode lock [1, 2, 3, 4] across L_PD = [500, 250, 140, 115] um" ;
        schema:measurementTechnique "linear correlation across all 4 developmental stages (m = 1, 2, 3, 4)" ;
        schema:name "progress-zone mode number L_AP/lambda_AP vs PDE element count Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-progress-zone-mode-number-l-ap-lambda-ap-vs-pde-element-count-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-progress-zone-mode-number-l-ap-lambda-ap-vs-pde-element-count-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Newman & Frisch (1979) Science 205:662-668 Eqs. (3)-(7) & Table 1" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-segmented-gallus-gallus-wing-specimen-zeugopod-to-autopod-spacing-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented Gallus gallus wing specimen zeugopod-to-autopod spacing ratio = 1.4074 dimensionless ratio" ;
        dct:description "segmented specimen compartment bone counts = [1, 2, 3] (1 humerus -> 2 radius+ulna -> 3 digits II-IV, total = 6); zeugopod spacing = 38.0 px, autopod spacing = 27.0 px (CV = 0.0000)" ;
        schema:measurementTechnique "ratio of segmented radius-ulna spacing (38.0 px) to mean autopod digit II-IV spacing (27.0 px) on datasets/limb_chondrogenesis_turing/chick_wing_skeleton_specimen.jpg" ;
        schema:name "segmented Gallus gallus wing specimen zeugopod-to-autopod spacing ratio" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "1.4074" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-segmented-gallus-gallus-wing-specimen-zeugopod-to-autopod-spacing-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-segmented-gallus-gallus-wing-specimen-zeugopod-to-autopod-spacing-ratio-reference> a schema:PropertyValue ;
        dct:source "Wikimedia Commons File:Gallus_wingbones_01.JPG & Newman & Frisch (1979) m=2 -> m=3 wavelength compression" ;
        schema:value "1.4074" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py L567–L627" ;
        dct:description "8 reference-backed morphometric measurements across 4-stage PDE series, 2D AER truncation, negative controls, and Gallus wing bone segmentation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1979-newman-limb-chondrogenesis-turing.py#L567-L627> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

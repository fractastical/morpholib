sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud — Parameter expressivity: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Simulates all 4 developmental stages of Newman & Frisch (1979) Table 1 (`run_developmental_stage_sweep`, L374-403) across L_PD in {500, 250, 140, 115} um reproducing [1, 2, 3, 4] skeletal elements; simulates the 3-step Saunders (1948) / Summerbell et al. (1973) surgical AER excision truncation series (`run_aer_excision_series`, L406-426) yielding [1, 0, 0] -> [1, 2, 0] -> [1, 2, 3] elements; executes dual negative controls (`run_negative_controls`, L429-443) at Du=Dv=0.5 (equal diffusion) and fu=1.5 < 2.0 (hyaluronate excess); and exposes full CLI flags (`--L-PD-um`, `--L-AP-um`, `--aer-stage`, `--Du`, `--Dv`, `--fv`, `--gv`, `--steps`, `--seed`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-parameter-expressivity-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py L374–L443" ;
        dct:description "4-stage L_PD sweep ([1, 2, 3, 4] elements), 3-step AER surgical truncation series ([1, 3, 6] cumulative elements), and dual negative controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1979-newman-limb-chondrogenesis-turing.py#L374-L443> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py L656–L676" ;
        dct:description "CLI flags for L_PD, L_AP, AER excision stage, diffusivities, kinetic couplings, PDE steps, and seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1979-newman-limb-chondrogenesis-turing.py#L656-L676> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 012 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


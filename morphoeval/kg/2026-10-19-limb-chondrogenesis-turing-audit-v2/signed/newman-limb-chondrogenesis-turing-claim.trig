sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> a pk:Claim ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud faithfully reproduces Gallus gallus domesticus embryonic wing bud (HH20 stylopod humerus -> HH24 zeugopod radius+ulna -> HH27 autopod digits II-IV) morphology" ;
        dcterms:description "The simulation script(s) 1979-newman-limb-chondrogenesis-turing.py implement the cited source model as published and produce forms that match real Gallus gallus domesticus embryonic wing bud (HH20 stylopod humerus -> HH24 zeugopod radius+ulna -> HH27 autopod digits II-IV) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 92.2/100, audit 2026-10-19-limb-chondrogenesis-turing-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/8871db0/1979-newman-limb-chondrogenesis-turing.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/1979-newman-limb-chondrogenesis-turing.py; output: docs/media/limb_chondrogenesis_turing_comparison.png; organism: Gallus gallus domesticus embryonic wing bud (HH20 stylopod humerus -> HH24 zeugopod radius+ulna -> HH27 autopod digits II-IV); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 381dc7883b80c95da9d476a5865f816bf3bb5de908cfdb8ef8c6bbef3a244a82; artifact_sha256: 005a30e61b4619f89f80e1233f31386bcdf25b515816416f60ff332b1f5d0a39; input_dataset_sha256: {datasets/limb_chondrogenesis_turing/chick_wing_skeleton_specimen.jpg=771e26f9fe8c813d..., datasets/limb_chondrogenesis_turing/limb_chondrogenesis_turing_reference.json=c30d742bbf2a990a..., datasets/limb_chondrogenesis_turing/scout_manifest.json=7f3605aa11f5e077...}; supersedes_audit_id: 2026-10-19-limb-chondrogenesis-turing-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1038/244492a0>,
            <https://doi.org/10.1098/rspb.2004.2772>,
            <https://doi.org/10.1126/science.462174>,
            <https://doi.org/10.1186/s13227-017-0084-8> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-specimen-match> ;
        pk:weightOfEvidence "0.922"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/8871db0/1979-newman-limb-chondrogenesis-turing.py> a schema:SoftwareSourceCode ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py" ;

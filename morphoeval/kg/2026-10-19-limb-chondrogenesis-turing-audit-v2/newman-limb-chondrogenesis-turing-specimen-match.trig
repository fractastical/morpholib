sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud — Morphological realism / specimen match: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Loads and SHA-256-verifies the Gallus gallus forelimb osteological specimen (`datasets/limb_chondrogenesis_turing/chick_wing_skeleton_specimen.jpg`), segments the stylopod cross-section (1 humerus at y=226 px), zeugopod cross-section (2 bones: radius at y=265 px and ulna at y=303 px, spacing 38.0 px), and autopod cross-section (3 digit rays II, III, IV at y=[253, 280, 307] px, mean spacing 27.0 px, CV=0.0000) (L449-499), overlays the 3 anatomical ROIs and detected bone centroids in Panel E and cross-sectional intensity profiles in Panel F, and compares the segmented zeugopod-to-autopod spacing ratio (1.4074) and compartment counts ([1, 2, 3]) against the Turing PDE." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py L449–L499" ;
        dct:description "Cross-sectional osteological peak detection across stylopod (1), zeugopod (2), and autopod (3) on chick_wing_skeleton_specimen.jpg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1979-newman-limb-chondrogenesis-turing.py#L449-L499> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/limb_chondrogenesis_turing_comparison.png (generated output)" ;
        dct:description "8-panel synthesis figure comparing theoretical dispersion, 2D wing bud PDE, 4-stage eigenmodes, AER truncation, and segmented Gallus gallus wing skeleton — docs/media/limb_chondrogenesis_turing_comparison.png: rendered output of 1979-newman-limb-chondrogenesis-turing.py at 8871db0, image/png, 451089 B, 2275×1336 px, artifact_sha256 005a30e61b4619f89f80e1233f31386bcdf25b515816416f60ff332b1f5d0a39 (sha256 005a30e61b4619f89f80e1233f31386bcdf25b515816416f60ff332b1f5d0a39), spec_fingerprint 381dc7883b80c95da9d476a5865f816bf3bb5de908cfdb8ef8c6bbef3a244a82" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 012 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


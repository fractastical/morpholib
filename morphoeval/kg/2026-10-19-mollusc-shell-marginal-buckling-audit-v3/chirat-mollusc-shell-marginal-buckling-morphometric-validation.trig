        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-biological-specimen-segmented-primary-radial-costae-count-ribbed-bivalve-shell-specimen-jpg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-biological-specimen-segmented-primary-radial-costae-count-ribbed-bivalve-shell-specimen-jpg-reference> a schema:PropertyValue ;
        dct:source "Pecten jacobaeus taxonomic diagnosis & Chirat et al. (2013) PNAS (14-16 primary radial costae)" ;
        schema:value "14.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-critical-predator-chip-arc-in-lambda-c-for-repair-induced-rib-intercalation-at-rho-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Critical predator chip arc (in lambda_c) for repair-induced rib intercalation at rho = 1 = 1.9687 chip arc / lambda_c(r_d)" ;
        dct:description "transition lies between the grid points 1.09 and 1.97 lambda; stiffer callus (rho >= 1.3) nucleates defects at smaller chips" ;
        schema:measurementTechnique "Smallest chip arc on the grid [0.66, 1.09, 1.53, 1.97, 2.62] lambda producing an extra adult rib with a non-stiffened callus; fraction of the 20-cell (chip x rho) phase diagram healing in register = 0.35" ;
        schema:name "Critical predator chip arc (in lambda_c) for repair-induced rib intercalation at rho = 1" ;
        schema:unitText "chip arc / lambda_c(r_d)" ;
        schema:value "1.9687" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-critical-predator-chip-arc-in-lambda-c-for-repair-induced-rib-intercalation-at-rho-1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-critical-predator-chip-arc-in-lambda-c-for-repair-induced-rib-intercalation-at-rho-1-reference> a schema:PropertyValue ;
        dct:source "Half-integer rounding heuristic (a template gap > 1.5 lambda can host one more crest than it lost) — heuristic, not a published value" ;
        schema:value "1.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-hollow-spine-elastica-small-strain-amplitude-law-correlation-a-num-vs-2-pi-sqrt-w-dl> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hollow-spine elastica small-strain amplitude law correlation A_num vs (2/pi) sqrt(W dL) = 1.0 Pearson r" ;
        dct:description "mean |A_num - A_lin| / A_lin = 0.0259" ;
        schema:measurementTechnique "Clamped planar inextensible elastica (M=96, W=6.0 mm) relaxed by L-BFGS-B at eps in [0.005, 0.03]; mean relative amplitude error = 0.0259" ;
        schema:name "Hollow-spine elastica small-strain amplitude law correlation A_num vs (2/pi) sqrt(W dL)" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-hollow-spine-elastica-small-strain-amplitude-law-correlation-a-num-vs-2-pi-sqrt-w-dl-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-hollow-spine-elastica-small-strain-amplitude-law-correlation-a-num-vs-2-pi-sqrt-w-dl-reference> a schema:PropertyValue ;
        dct:source "Clamped Euler-elastica first mode (Moulton, Goriely & Chirat 2012 J. Theor. Biol. planar rod reduction): Delta L = pi^2 A^2 / (4 W)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-hollow-spine-neck-gap-wall-thickness-after-self-contact-contact-penalty-resolution> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hollow-spine neck gap / wall thickness after self-contact (contact penalty resolution) = 0.9997 ratio" ;
        dct:description "closure first detected at eps=4.807" ;
        schema:measurementTechnique "Minimum distance between non-adjacent flank nodes at the largest growth excess eps=6.0, divided by the wall thickness t" ;
        schema:name "Hollow-spine neck gap / wall thickness after self-contact (contact penalty resolution)" ;
        schema:unitText "ratio" ;
        schema:value "0.9997" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-hollow-spine-neck-gap-wall-thickness-after-self-contact-contact-penalty-resolution-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-hollow-spine-neck-gap-wall-thickness-after-self-contact-contact-penalty-resolution-reference> a schema:PropertyValue ;
        dct:source "Self-contact constraint d_ij >= t (closed hollow tube wall-to-wall contact)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-hollow-spine-self-contact-closure-growth-excess-eps-close-reduced-2d-elastica-of-a-murex-spine-fold> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hollow-spine self-contact closure growth excess eps_close (reduced 2D elastica of a Murex spine fold) = 4.8068 ratio (L - W) / W" ;

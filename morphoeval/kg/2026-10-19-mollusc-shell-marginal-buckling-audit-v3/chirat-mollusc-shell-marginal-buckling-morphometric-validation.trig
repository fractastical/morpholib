        schema:measurementTechnique "Continuation sweep of the self-contact-penalised elastica; first eps at which the inter-flank neck gap reaches the wall thickness t=0.35 mm (H/W at closure = 2.312, lumen = 34.66 mm^2)" ;
        schema:name "Hollow-spine self-contact closure growth excess eps_close (reduced 2D elastica of a Murex spine fold)" ;
        schema:unitText "ratio (L - W) / W" ;
        schema:value "4.8068" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-hollow-spine-self-contact-closure-growth-excess-eps-close-reduced-2d-elastica-of-a-murex-spine-fold-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-hollow-spine-self-contact-closure-growth-excess-eps-close-reduced-2d-elastica-of-a-murex-spine-fold-reference> a schema:PropertyValue ;
        dct:source "Mesh-convergence reference of the same reduced model at M=224 segments (datasets/mollusc_shell_marginal_buckling/pass3_spine_closure_damage_repair_reference.json); no independent published closure strain is vendored" ;
        schema:value "5.0" .

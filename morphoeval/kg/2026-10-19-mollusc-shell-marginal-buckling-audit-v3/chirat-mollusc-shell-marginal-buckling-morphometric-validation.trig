    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-l-bfgs-b-relaxed-winkler-beam-adult-pecten-rib-wavelength-lambda-sim> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "L-BFGS-B relaxed Winkler-beam adult Pecten rib wavelength lambda_sim = 8.7728 mm" ;
        dct:description "simulated ribs = 14.01 vs ref 14.0" ;
        schema:measurementTechnique "Sub-bin spectral peak wavelength of L-BFGS-B relaxed fourth-order nonlinear Winkler-beam mantle margin at P/P_c=1.45" ;

        schema:measurementTechnique "Ratio of adult antimarginal rib count in constant-wavelength intercalating regime (Chlamys/Spirifer, N=27.5) vs isometric Pecten regime (N=14.0)" ;
        schema:name "Intercalating multicostate vs isometric constant-rib adult count ratio" ;
        schema:unitText "ratio (N_intercal / N_isometric)" ;

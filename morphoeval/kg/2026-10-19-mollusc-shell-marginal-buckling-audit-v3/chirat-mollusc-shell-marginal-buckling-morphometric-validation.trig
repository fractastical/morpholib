        schema:measurementTechnique "Polar ray-averaged Difference-of-Gaussians angular ridge detection across fan [-64°, +64°] on Pecten jacobaeus valve (mean dtheta = 9.40°, CV = 0.2196)" ;
        schema:name "Biological specimen segmented primary radial costae count (ribbed_bivalve_shell_specimen.jpg)" ;
        schema:unitText "ribs" ;

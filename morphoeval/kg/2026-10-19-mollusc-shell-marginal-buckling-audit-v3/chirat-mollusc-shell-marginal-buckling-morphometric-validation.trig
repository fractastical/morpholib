        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-biological-specimen-polar-angular-rib-spacing-cv-ribbed-bivalve-shell-specimen-jpg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-biological-specimen-polar-angular-rib-spacing-cv-ribbed-bivalve-shell-specimen-jpg-reference> a schema:PropertyValue ;
        dct:source "Erlich et al. (2016) J. R. Soc. Interface periodic antimarginal costae angular dispersion (CV < 0.25)" ;
        schema:value "0.2" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-biological-specimen-segmented-primary-radial-costae-count-ribbed-bivalve-shell-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Biological specimen segmented primary radial costae count (ribbed_bivalve_shell_specimen.jpg) = 14.0 ribs" ;

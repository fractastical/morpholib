}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chirat-mollusc-shell-marginal-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Chirat, Moulton & Goriely (2013) & Erlich et al. (2016) mollusc shell marginal buckling, hollow-spine closure and predator damage / mantle repair — Morphometric validation: 83/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L2036-2222) now returns 16 measurements with reference values: the 9 Pass 2 metrics are unchanged (lambda_sim 8.7728 vs 8.7766 mm, pitchfork r 0.9992, specimen 14 costae, CV 0.2196) and 7 are new (small-strain r = 1.0, eps_close 4.8068, gap/t 0.9997, adult N 14, scar index 0.030, local P_c ratio sqrt(rho) 1.0724, critical chip 1.97 lambda). Deductions, which drive this dimension down from 92: the three headline Pass 3 references are not independent data — eps_close is compared with mesh convergence of the same model at M = 224 (L2069-2079), the critical chip with a rounding heuristic (L2119-2129), and the heal-length fit 8.3 mm with the imposed 7 mm (consistency check, L2089-2110) (-5); the 12-species quarter-power \"collapse\" regresses lambda_obs against 2 pi (EI/k)^(1/4) where the JSON EI, k were themselves set from lambda_obs, so r = 1.0000 and alpha = 0.2500 are tautological (L1073-1139) (-3); the rib-count ratio 27.5/14 compares the hard-coded `2 n_base - 0.5` with its own reference (L435) (-1); the rib count in the damage trajectory depends on a `find_peaks` prominence threshold of 0.25 A_eq (L836), so the sector count 1 -> 0 at damage is threshold-dependent (-1); the registry/defect metrics inherit the periodic-margin artefact (adult correlation ~ 0 in defect cells) (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2013-chirat-mollusc-shell-marginal-buckling.py L1073–L1139: 12-species regression of lambda_obs on 2 pi (EI/k)^(1/4) with EI, k read from the JSON that was fitted to lambda_obs — tautological r = 1.0000 <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L1073-L1139>",
            "2013-chirat-mollusc-shell-marginal-buckling.py L2069–L2079: eps_close reference is the same model's mesh-convergence value at M = 224, stated as such — not an empirical closure strain <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L2069-L2079>",
            "2013-chirat-mollusc-shell-marginal-buckling.py L2119–L2129: Critical chip reference is a half-integer rounding heuristic (1.5 lambda), stated as such; numeric value 1.97 lambda <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L2119-L2129>",
            "2013-chirat-mollusc-shell-marginal-buckling.py L829–L840: Rib crest count via find_peaks with prominence 0.25 A_eq (L836) — threshold-dependent <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L829-L840>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-12-species-antimarginal-rib-wavelength-scaling-correlation-chirat-et-al-2013-erlich-et-al-2016>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-12-species-rib-count-scaling-correlation-n-ribs-phi-0-r-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-adult-rib-count-after-predator-chip-and-mantle-repair-default-chip-5-deg-half-angle-rho-1-15>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-biological-specimen-polar-angular-rib-spacing-cv-ribbed-bivalve-shell-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-biological-specimen-segmented-primary-radial-costae-count-ribbed-bivalve-shell-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-critical-predator-chip-arc-in-lambda-c-for-repair-induced-rib-intercalation-at-rho-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-hollow-spine-elastica-small-strain-amplitude-law-correlation-a-num-vs-2-pi-sqrt-w-dl>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-hollow-spine-neck-gap-wall-thickness-after-self-contact-contact-penalty-resolution>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-hollow-spine-self-contact-closure-growth-excess-eps-close-reduced-2d-elastica-of-a-murex-spine-fold>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-intercalating-multicostate-vs-isometric-constant-rib-adult-count-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-l-bfgs-b-relaxed-winkler-beam-adult-pecten-rib-wavelength-lambda-sim>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-local-critical-load-ratio-in-the-fresh-repair-callus-p-c-loc-p-c-sqrt-rho>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-log-log-quarter-power-foundation-scaling-exponent-alpha-lambda-c-ei-k-alpha>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-repair-scar-index-at-the-adult-margin-delta-w-dmg-w-ctrl-w-ctrl-healing-completeness>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-subcritical-compressive-load-negative-control-amplitude-p-p-c-0-65-1-vs-wild-type>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-supercritical-pitchfork-rib-amplitude-correlation-across-p-p-c-sweep>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-morphometric-validation-2> ;
        pk:hasScore "0.83"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-12-species-antimarginal-rib-wavelength-scaling-correlation-chirat-et-al-2013-erlich-et-al-2016> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-species antimarginal rib wavelength scaling correlation (Chirat et al. 2013 / Erlich et al. 2016) = 1.0 Pearson r" ;
        dct:description "RMSE = 0.1125 mm, p=3.63e-26" ;
        schema:measurementTechnique "Linear regression of predicted 2*pi*(EI/k)^(1/4) vs measured wavelength across 12 species in 4 clades (p=3.63e-26, RMSE=0.1125 mm)" ;
        schema:name "12-species antimarginal rib wavelength scaling correlation (Chirat et al. 2013 / Erlich et al. 2016)" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-12-species-antimarginal-rib-wavelength-scaling-correlation-chirat-et-al-2013-erlich-et-al-2016-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-12-species-antimarginal-rib-wavelength-scaling-correlation-chirat-et-al-2013-erlich-et-al-2016-reference> a schema:PropertyValue ;
        dct:source "Chirat, Moulton & Goriely (2013) PNAS 110:6015-6020 & Erlich et al. (2016) J. R. Soc. Interface 13:20160592" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-12-species-rib-count-scaling-correlation-n-ribs-phi-0-r-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-species rib count scaling correlation N_ribs = (Phi_0 * R) / lambda_c = 1.0 Pearson r" ;
        dct:description "RMSE = 0.0766 ribs, p=2.84e-23" ;
        schema:measurementTechnique "Correlation of predicted vs observed antimarginal rib count across 12 bivalve, gastropod, ammonite, and brachiopod species (RMSE=0.0766 ribs)" ;
        schema:name "12-species rib count scaling correlation N_ribs = (Phi_0 * R) / lambda_c" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-12-species-rib-count-scaling-correlation-n-ribs-phi-0-r-lambda-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-12-species-rib-count-scaling-correlation-n-ribs-phi-0-r-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Erlich, Moulton, Goriely & Chirat (2016) J. R. Soc. Interface 13:20160592 Fig. 4" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-adult-rib-count-after-predator-chip-and-mantle-repair-default-chip-5-deg-half-angle-rho-1-15> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Adult rib count after predator chip and mantle repair (default chip 5 deg half-angle, rho=1.15) = 14.0 ribs" ;
        dct:description "registry error = 0.000 lambda, adult damaged-vs-control profile r = 0.9995" ;
        schema:measurementTechnique "Wrap-aware crest count on the adult (R=55 mm) margin of the damaged accretionary trajectory; control trajectory = 14 ribs; ribs in chipped sector at damage = 0 (pre-damage 1)" ;
        schema:name "Adult rib count after predator chip and mantle repair (default chip 5 deg half-angle, rho=1.15)" ;
        schema:unitText "ribs" ;
        schema:value "14.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-adult-rib-count-after-predator-chip-and-mantle-repair-default-chip-5-deg-half-angle-rho-1-15-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-adult-rib-count-after-predator-chip-and-mantle-repair-default-chip-5-deg-half-angle-rho-1-15-reference> a schema:PropertyValue ;
        dct:source "Pecten jacobaeus N=14 primary costae (Chirat et al. 2013 PNAS; specimen segmentation) — repair re-forms ribs in register with the template" ;
        schema:value "14.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-biological-specimen-polar-angular-rib-spacing-cv-ribbed-bivalve-shell-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Biological specimen polar angular rib-spacing CV (ribbed_bivalve_shell_specimen.jpg) = 0.2196 CV (std/mean)" ;

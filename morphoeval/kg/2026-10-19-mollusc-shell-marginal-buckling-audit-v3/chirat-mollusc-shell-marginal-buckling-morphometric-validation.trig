        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-intercalating-multicostate-vs-isometric-constant-rib-adult-count-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-intercalating-multicostate-vs-isometric-constant-rib-adult-count-ratio-reference> a schema:PropertyValue ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chirat-mollusc-shell-marginal-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Chirat, Moulton & Goriely (2013) & Erlich et al. (2016) mollusc shell marginal buckling, hollow-spine closure and predator damage / mantle repair — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Pass 3 adds four wired CLI flags (`--spine-W`, `--spine-t`, `--chip-half-angle`, `--repair-k-ratio`, L2350-2353) that flow through `render_comparison_figure` overrides (L1276-1285) into the elastica sweep and the repair evaluation; the repair-outcome phase diagram sweeps chip half-angle {3,5,7,9,12} deg x rho {1.0,1.15,1.3,1.6} with a shared control (L982-1034) and the outcome is monotone in chip size (self-test #12); the closure sweep is a continuation in eps with the neck gap, aspect ratio and lumen area tracked (L647-729). Pass 2 coverage (4 regimes, 8-point P/P_c sweep, 12 species, `--EI --k --P-ratio --R-adult --seed`) is retained. Deductions: `--seed` affects only the Winkler/damage noise, not the elastica (-2); `evaluate_repair_outcome_phase_diagram` is called with the default seed and ignores the chip/rho overrides, so the CLI flags move panel H but not panel I (L1289) (-3); l_heal and the station schedule are not exposed (-2); the mesh resolution M that moves eps_close from 4.81 to 5.00 is not a CLI parameter (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity-4> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2013-chirat-mollusc-shell-marginal-buckling.py L2341–L2384" ;
        dcterms:description "argparse: 4 new Pass 3 flags (L2350-2353) plus the Pass 2 set, all forwarded as overrides" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L2341-L2384> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2013-chirat-mollusc-shell-marginal-buckling.py L1276–L1289" ;
        dcterms:description "Overrides consumed by evaluate_spine_closure_sweep and evaluate_damage_repair; phase diagram at L1289 takes only seed (ignores chip/rho overrides)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L1276-L1289> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2013-chirat-mollusc-shell-marginal-buckling.py L982–L1034" ;
        dcterms:description "5 x 4 chip-size x callus-stiffness outcome phase diagram with shared control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L982-L1034> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "2013-chirat-mollusc-shell-marginal-buckling.py L647–L729" ;
        dcterms:description "Continuation in eps with gap, aspect ratio, lumen area; M (segments) is a function argument, not a CLI flag" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L647-L729> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediated assessment, Phase B audit subagent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


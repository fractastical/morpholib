sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chirat-mollusc-shell-marginal-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Chirat, Moulton & Goriely (2013) & Erlich et al. (2016) mollusc shell marginal buckling, hollow-spine closure and predator damage / mantle repair — Model fidelity to source: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The Pass 2 core is intact: exact fourth-order nonlinear Winkler-beam energy minimised by spectral L-BFGS-B (`relax_winkler_mantle_margin`, L221-359) with P_c = 2 sqrt(EI k), lambda_c = 2 pi (EI/k)^(1/4) and the supercritical pitchfork law (L164-202). Pass 3 adds a physically honest reduced model of spine closure — an inextensible planar elastica with clamped roots, end penalty and pairwise self-contact penalty, continuation in eps, and the small-strain amplitude law A = (2/pi) sqrt(W dL) recovered to r = 0.99999 (L511-729) — and a heterogeneous-foundation extension with template memory that keeps the default path bitwise identical (L244-252, L292-298). Deductions: the requested 3D finite-strain morphoelastic FEM was not built; the elastica has no out-of-plane coupling, stretching energy or growth tensor, and W, t are prescribed (-4); the solver never converges to its ftol = 1e-16 / gtol = 1e-13 tolerances and always exits at maxiter (L310, L357), so the \"equilibria\" are iteration-count-limited (-3); the periodic FFT margin on [0, L) is applied to an open valve fan, which makes an intercalated rib slide the whole pattern (L234, L263, L328) (-2); the `antimarginal_intercalating_multicostate` and `cancellate_spiny_episodic_varix` rib fields are prescribed cosines rather than solver output and `n_ribs_adult = 2 n_base - 0.5` is hard-coded (L364-459, L435) (-3); EI = 1.085 is back-fitted to the rib count rather than derived from mantle mechanics (L224, L473) (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2013-chirat-mollusc-shell-marginal-buckling.py L364–L459: 3D accretionary synthesis; intercalating and varix regimes are prescribed cosine fields and n_ribs_adult = 2*n_base - 0.5 is hard-coded at L435, not solver output <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L364-L459>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity-5> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2013-chirat-mollusc-shell-marginal-buckling.py L164–L202" ;
        dcterms:description "Analytical P_c, lambda_c and pitchfork amplitude law" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L164-L202> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2013-chirat-mollusc-shell-marginal-buckling.py L221–L359" ;
        dcterms:description "Spectral L-BFGS-B Winkler-beam minimiser; Pass 3 k_profile (real-space k(s) w) and w_init template memory; ftol 1e-16 / gtol 1e-13 at L310 are never met, n_iterations == maxiter at L357" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L221-L359> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2013-chirat-mollusc-shell-marginal-buckling.py L511–L644" ;
        dcterms:description "Reduced planar inextensible elastica with clamped roots, end penalty mu_end = 400 and pairwise self-contact penalty; analytic gradients; W, t prescribed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L511-L644> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2013-chirat-mollusc-shell-marginal-buckling.py L647–L743" ;
        dcterms:description "Continuation sweep in eps, small-strain law check, eps_close by interpolation of the neck gap through t, tube surface stacking (no out-of-plane coupling)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L647-L743> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_072_mollusc_shell_marginal_buckling.lean L18–L167" ;
        dcterms:description "7 Lean 4 theorems (4 Pass 2 + 3 Pass 3: callus raises P_c, repair rib-count bookkeeping, closure monotone in neck gap); 0 sorry, lean exit 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/morphoeval/lean/loops/Loop_072_mollusc_shell_marginal_buckling.lean#L18-L167> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediated assessment, Phase B audit subagent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


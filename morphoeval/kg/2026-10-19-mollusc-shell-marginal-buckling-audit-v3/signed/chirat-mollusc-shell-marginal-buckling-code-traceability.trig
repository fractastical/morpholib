sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chirat-mollusc-shell-marginal-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Chirat, Moulton & Goriely (2013) & Erlich et al. (2016) mollusc shell marginal buckling, hollow-spine closure and predator damage / mantle repair — Code-to-model traceability: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The header docstring (L1-78) maps Laws 1-5 to Chirat et al. (2013) PNAS, Erlich et al. (2016), Rudraraju et al. (2019) and the 7 Lean theorems by name, and states plainly that Law 5 is an honest reduced stand-in for the 3D FEM (L74-77); the Pass 3 functions carry docstrings tying k(s) to the callus theorem (L244-252) and the elastica energy to its terms (L524-531); the math-KG YAML registers the two new laws with single-range `code_locus` pins refreshed to current lines. Deductions: the `--self-test` help string still says \"Run 8-check verification suite\" although 12 checks run (L2343) (-2); the section banner at L1265 still says \"6-Panel Synthesis Figure\" for a 3 x 3 figure (-1); the hard-coded 1.085 / 0.285 / 1.250 constants in `measure_morphoeval` (L2039, L2042) are not traced to the JSON (-2); `mu_end = mu_contact = 400` penalties are chosen without a cited rationale (L517-519) (-2); the heuristic reference values are labelled as such in `reference_source` strings, which is credited (-3 net total)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2013-chirat-mollusc-shell-marginal-buckling.py L2036–L2043: measure_morphoeval hard-codes L=122.87, EI=1.085, k=0.285, kappa_3=1.250 rather than reading the pinned JSON <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L2036-L2043>",
            "2013-chirat-mollusc-shell-marginal-buckling.py L2343–L2343: Stale CLI help: 'Run 8-check verification suite' while self_test() runs 12 checks <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L2343-L2343>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-code-traceability-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2013-chirat-mollusc-shell-marginal-buckling.py L1–L78" ;
        dcterms:description "Header docstring: Laws 1-5 with DOIs and Lean theorem names; Law 5 explicitly a reduced stand-in for Rudraraju 2019 FEM" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L1-L78> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/chirat-mollusc-shell-marginal-buckling.yaml L39–L113" ;
        dcterms:description "5 equations with single-range code_locus pins (L164-185, L187-202, L364-492, L748-1035, L511-743) matching current function boundaries" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/morphoeval/math_kg_loops/chirat-mollusc-shell-marginal-buckling.yaml#L39-L113> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediated assessment, Phase B audit subagent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


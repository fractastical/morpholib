        rdfs:label "2013-chirat-mollusc-shell-marginal-buckling.py L2360–L2384" ;
        dcterms:description "Default invocation writes comparison PNG, Pass 3 3D PNG, growth GIF and damage/repair GIF; --skip-gif honoured" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L2360-L2384> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/mollusc_shell_marginal_buckling_damage_repair.gif (generated output)" ;
        dcterms:description "14-frame accretionary damage/repair GIF regenerated deterministically from seed 2013 — docs/media/mollusc_shell_marginal_buckling_damage_repair.gif: rendered output of 2013-chirat-mollusc-shell-marginal-buckling.py at e651a8b8, image/gif, 388697 B, 1019×459 px, 14 frames, artifact_sha256 781a047746edbfe85b0e57bf5bf38ec7b3a58039ae2b19ce5a0f6fad3a8f3049 (sha256 781a047746edbfe85b0e57bf5bf38ec7b3a58039ae2b19ce5a0f6fad3a8f3049), spec_fingerprint 5ce4d2a0cdd2530a2bb4e03307b8a1565e305db6cf6b377ff8cb6db26ef82d9e" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediated assessment, Phase B audit subagent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Chirat, Moulton & Goriely (2013) & Erlich et al. (2016) mollusc shell marginal buckling, hollow-spine closure and predator damage / mantle repair — Reproducibility package: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Deterministic seeds (`seed=2013`, per-station `seed + i`), a 12-check `self_test()` (L2225-2338) covering SHA-256 provenance for 5 files, JSON parity, subcritical control, pitchfork sweep, 4 regimes, 12-species collapse, specimen segmentation, bitwise determinism, elastica small-strain law and monotone closure, heterogeneous-k reduction to the Pass 2 solver, chip/repair in-register healing, and phase-diagram monotonicity; all 12 pass (verified this pass, 50 s CPU / 1:53 wall under parallel-loop contention). Four media files regenerate from the default invocation. Deductions: self-test #10 tolerates 1-2 % of A_eq shape differences because the solver stops at maxiter rather than at tolerance (L2289-2300) (-3); self-test wall time has grown from seconds to ~20 s idle / minutes under contention with no `--quick` path (-2); the CLI help is stale (L2343) (-1); the uncommitted working-tree state means the audited artefacts are not yet reproducible from a commit hash (-4; isolation constraint, not a script defect)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2013-chirat-mollusc-shell-marginal-buckling.py L2289–L2300: Check 10 tolerates 1 % / 2 % of A_eq shape differences between code paths because L-BFGS-B exits at maxiter, not tolerance <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L2289-L2300>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-repro-package-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


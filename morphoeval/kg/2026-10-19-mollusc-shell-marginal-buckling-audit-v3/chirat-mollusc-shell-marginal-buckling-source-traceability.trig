sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chirat-mollusc-shell-marginal-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Chirat, Moulton & Goriely (2013) & Erlich et al. (2016) mollusc shell marginal buckling, hollow-spine closure and predator damage / mantle repair — Source and data traceability: 89/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Five dataset files are now SHA-256-pinned and verified fail-closed at runtime (`EXPECTED_SHA256` L110-131, `verify_dataset_integrity` L141-153), including the new `pass3_spine_closure_damage_repair_reference.json` (sha dcc719fa...); the four Pass 2 DOIs are unchanged and `pass3_citations.bib` adds Vermeij (1987) for predator damage; the README documents the Pass 3 additions and the specimen licence. Deductions: EI = 1.085 mN mm^2 is hard-coded in the script (L224, L371, L473, L516, L651, L758, L1276, L2039) but the pinned reference JSON gives default_parameters.EI_mN_mm2 = 0.180 (JSON L65) and Adult_V EI = 1.79131 (JSON L132-136) — only the 12-species row (JSON L149) matches, and that row is back-fitted (-3); Vermeij (1987) is a book with no DOI and could not be verified offline (-1); the slot's dispatch JSON `slug` is `cahn-hilliard-biosilica` and the telemetry run's `paper` field names Lenoci & Camp (2008) diatom biosilica, so the campaign metadata for this loop points at the wrong source (not fixable from this slot's file list) (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/mollusc_shell_marginal_buckling/mollusc_shell_marginal_buckling_reference.json L65–L149: default_parameters.EI_mN_mm2 = 0.180 (L65) and Adult_V EI = 1.79131 (L136) disagree with the script's hard-coded 1.085; only the back-fitted Pecten row (L149) matches <https://github.com/fractastical/morpholib/blob/e651a8b8/datasets/mollusc_shell_marginal_buckling/mollusc_shell_marginal_buckling_reference.json#L65-L149>",
            "morphoeval/cloud/dispatches/slot-072.json L25–L25: slug 'cahn-hilliard-biosilica' — slot metadata names the wrong paper/organism for this script <https://github.com/fractastical/morpholib/blob/e651a8b8/morphoeval/cloud/dispatches/slot-072.json#L25-L25>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-source-traceability-4> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2013-chirat-mollusc-shell-marginal-buckling.py L110–L153" ;
        dct:description "EXPECTED_SHA256 with 5 pinned files (Pass 3 JSON added) and fail-closed verify_dataset_integrity()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-chirat-mollusc-shell-marginal-buckling.py#L110-L153> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/mollusc_shell_marginal_buckling/pass3_spine_closure_damage_repair_reference.json L1–L68" ;
        dct:description "Pass 3 reference table: elastica parameters, mesh-convergence eps_close, repair parameters, in-register rib count, rounding-heuristic critical chip" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/datasets/mollusc_shell_marginal_buckling/pass3_spine_closure_damage_repair_reference.json#L1-L68> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/mollusc_shell_marginal_buckling/pass3_citations.bib L1–L12" ;
        dct:description "Vermeij (1987) book entry with ISBN; explicitly flagged as not verifiable offline" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/datasets/mollusc_shell_marginal_buckling/pass3_citations.bib#L1-L12> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/mollusc_shell_marginal_buckling/README.md L33–L40" ;
        dct:description "Pass 3 Additions section with SHA-256 of the new reference table" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/datasets/mollusc_shell_marginal_buckling/README.md#L33-L40> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediated assessment, Phase B audit subagent)" ;
        dct:identifier "claude-fable-5-1" ;

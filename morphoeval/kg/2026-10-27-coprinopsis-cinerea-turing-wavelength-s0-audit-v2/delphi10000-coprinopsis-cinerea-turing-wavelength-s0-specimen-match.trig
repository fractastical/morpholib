    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Coprinopsis cinerea Schnakenberg wavelength selection at 77 µm (Pass 2) — Morphological realism / specimen match: 74/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The photograph of the gilled cap is shown with the segmented outline, and the animation is a gill-brown ocellus field at the critical wavelength. Computer-vision similarity of the 12-frame GIF against the photograph is 87.2. The field does not reproduce radial lamellae, and the mask also catches brown debris, so this is not a photographic match." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1073/pnas.1003391107>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1128/MMBR.64.2.316-353.2000> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1073/pnas.1003391107> dct:title "Insights into evolution of multicellular fungi from the assembled chromosomes of the mushroom Coprinopsis cinerea" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1128/MMBR.64.2.316-353.2000> dct:title "Life history and developmental processes in the basidiomycete Coprinus cinereus" .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Coprinopsis cinerea Schnakenberg wavelength selection at 77 µm (Pass 2) — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Schnakenberg kinetics, Jacobian, discrete-Laplacian dispersion, and the Turing wavenumber are implemented as published and calibrated to 7.744e-05 m. The equal-diffusion ablation fails the trace condition, as required. Ten points are withheld because the kinetics are not a measured Coprinopsis pigment circuit and because saturation shifts the selected peak off the linear k_c." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-coprinopsis-cinerea-turing-wavelength-s0.py L105–L193" ;
        dct:description "Jacobian, k_c, discrete k², dispersion_sigma" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f8754f57e6c8e5814e6ac3fcf8739bbd60d4b1bb/models/2026-delphi10000-coprinopsis-cinerea-turing-wavelength-s0.py#L105-L193> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-coprinopsis-cinerea-turing-wavelength-s0.py L365–L384" ;
        dct:description "ablation_controls: mode 8, mode 2, equal diffusion" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f8754f57e6c8e5814e6ac3fcf8739bbd60d4b1bb/models/2026-delphi10000-coprinopsis-cinerea-turing-wavelength-s0.py#L365-L384> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3154_coprinopsis_cinerea_turing_wavelength_s0.lean L16–L23" ;
        dct:description "operating trace positive; equal diffusion negative" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f8754f57e6c8e5814e6ac3fcf8739bbd60d4b1bb/morphoeval/lean/loops/Loop_3154_coprinopsis_cinerea_turing_wavelength_s0.lean#L16-L23> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


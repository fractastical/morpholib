sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Coprinopsis cinerea Schnakenberg wavelength selection at 77 µm (Pass 2) — MorphoEval overall 86.2/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 2 accepts the quantitative record. Dispersion Pearson r = 0.9999 (RMSE 0.0155, KS 0.095) between analytic σ(k²_disc) and the Euler run. Across eight values of γ the fastest-mode index tracks the analytic k_c ∝ sqrt(γ) with Pearson r = 0.9932. Mode 8 (12 px = 77.44 µm) grows by ×2.72 in 500 steps; mode 2 decays to ×0.61; D_v = D_u decays to ×0.31. The gill disc on Mushroom Observer 593470 has circularity 0.231 (reference 1.0) and cap coherency 0.633 versus frame coherency 0.614. The saturated radial peak sits at 68.84 µm, an 11% nonlinear shift off the linear k_c. CV similarity of the 12-frame 640×480 GIF against the photograph is 87.2. Overall 86.2/100 (faithfulness 84.5, reproducibility 90.1); rubric morphoeval 0.1.0; checkpoint commit f8754f57e6c8e5814e6ac3fcf8739bbd60d4b1bb; environment: . Dimension assessments: Model fidelity to source 90, Morphological realism / specimen match 74, Parameter expressivity 90, Morphometric validation 91, Source and data traceability 92, Code-to-model traceability 88, Reproducibility package 90. Output judged: docs/media/coprinopsis_cinerea_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-coprinopsis-cinerea-turing-wavelength-s0.py at f8754f57e6c8e5814e6ac3fcf8739bbd60d4b1bb, image/png, 779099 B, 1536×1152 px, artifact_sha256 3a01f0cb3e83a03aaa543557a6d5f3abeb37caf8954ac25ecaa24f82ffdb9a97 (sha256 3a01f0cb3e83a03aaa543557a6d5f3abeb37caf8954ac25ecaa24f82ffdb9a97), spec_fingerprint 8cece9ff3e72ac6167b2cefe87dfebbabd188f728a6d9a47d37e0816ea971637. Dual provenance: spec_fingerprint: 8cece9ff3e72ac6167b2cefe87dfebbabd188f728a6d9a47d37e0816ea971637; artifact_sha256: 33a851aefaf099fbe394d9bd6baf3a142f5addcbb329d968fe57f1875d69da74; input_dataset_sha256: {datasets/coprinopsis_cinerea_turing_wavelength_s0/coprinopsis_cinerea_specimen.jpg=f5905e9c02019fc5..., datasets/coprinopsis_cinerea_turing_wavelength_s0/coprinopsis_cinerea_turing_wavelength_s0_reference.json=d4e14ac29c4347af..., datasets/coprinopsis_cinerea_turing_wavelength_s0/paper_citations.bib=7cc51cdbd29c1950...}. Supersedes audit: 2026-10-27-coprinopsis-cinerea-turing-wavelength-s0-audit. Claim boundary: reported_in_source: Turing 1952 critical wavenumber from linear stability of a two-species reaction-diffusion system | Schnakenberg 1979 kinetics f = a - u + u^2 v, g = b - u^2 v | Kües 2000 developmental account of the gilled Coprinus cinereus fruiting body | Stajich et al. 2010 Coprinopsis cinerea genome; reconstructed_in_script: γ calibrated so λ_c = 7.744e-05 m; eight-point γ sweep of the fastest mode | Equal-diffusion and off-band (mode 2) ablations against on-band mode 8 | Brown-gill segmentation, circularity, and structure-tensor coherency on the 2015 photograph | Pearson, RMSE, and KS between analytic and Euler dispersion curves | GIF palette is a gill-brown ramp; the photograph's pixels are not copied into the frames; transfer_boundary: 77 µm is the assigned atlas scale. The photograph has no scale bar, so it cannot confirm 77.44 µm | Schnakenberg (a, b, D) are not a biochemical fit to Coprinopsis | Mature gill spacing on the fruiting body is a millimetre-scale readout; the simulation is an 8-wavelength, 619.52 µm cuticle patch | Nonlinear saturation shifts the radial FFT peak from 77.44 µm to 68.84 µm; does_not_claim: That 77.44 µm was measured on Mushroom Observer image 593470 | That the spot field reproduces the radial lamellae | A post-Holocene successor or a fossil predecessor in this 1/1 chronoseries | A second assessor's score." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: {'id': 'R1', 'item': 'Closed. γ sweep Pearson r = 0.9932 between analytic and numeric fastest-mode wavelength.', 'status': 'resolved'}",
            "remediation needed: {'id': 'R2', 'item': 'Closed. On-band ×2.72, off-band ×0.61, equal-diffusion ×0.31.', 'status': 'resolved'}",
            "remediation needed: {'id': 'R3', 'item': 'Closed. Gill-disc circularity 0.231 versus 1.0; cap coherency 0.633 versus frame coherency 0.614; cap fraction 0.099 versus a 0.5 prior.', 'status': 'resolved'}",
            "remediation needed: {'id': 'R4', 'item': 'Closed. Dispersion Pearson r = 0.9999, RMSE = 0.0155, KS = 0.095.', 'status': 'resolved'}",
            "remediation needed: {'id': 'R5', 'item': 'Open. Single assessor. A second provider has not scored this audit.'}",
            "remediation needed: {'id': 'R6', 'item': 'Open. The 77.44 µm length is the atlas assignment. A scale-barred micrograph of pileus pigment would replace it. The saturated peak at 68.84 µm is reported, not forced onto 77.44.'}" ;
        pk:hasScore "0.862"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


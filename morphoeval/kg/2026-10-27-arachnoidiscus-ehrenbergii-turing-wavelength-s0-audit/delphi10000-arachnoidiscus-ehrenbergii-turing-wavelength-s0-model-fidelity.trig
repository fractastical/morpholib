sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Arachnoidiscus ehrenbergii Schnakenberg Turing wavelength at 242 nm (Holocene, 0 Ma) — Model fidelity to source: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "steady_state, jacobian, diffusivities and dispersion_sigma implement Schnakenberg 1979 and the Turing fastest-mode formula k_c^2 = (D_v f_u + D_u g_v)/(2 D_u D_v), with D_u solved so lambda_c = 242 nm at D_v/D_u = 31.18, which is above the discriminant onset 13.605. Neumann edges and the mass-action terms match the cited kinetics. Deducted because the nonlinear field's dominant FFT wavelength is 284.76 nm, so the saturated pattern is not yet shown to sit on the linear carrier." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py L243–L260: FFT peak returned 284.76 nm against the analytic 242 nm carrier <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py#L243-L260>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py L62–L115" ;
        dct:description "Steady state, Jacobian, diffusivity solve for lambda_c, and dispersion_sigma" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py#L62-L115> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py L117–L151" ;
        dct:description "turing_report: trace, det, discriminant, sigma(k_c)=0.2415, equal-diffusion sigma=-0.9649" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py#L117-L151> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py L178–L234" ;
        dct:description "Explicit Euler on the Neumann patch; 3-arm spiral initial bias" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py#L178-L234> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (Pass 1 single-assessor cloud loop; no independent second model was invoked)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


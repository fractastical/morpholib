sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Arachnoidiscus ehrenbergii Schnakenberg Turing wavelength at 242 nm (Holocene, 0 Ma) — Parameter expressivity: 64/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The comparison figure plots sigma(k) at the nominal ratio 31.18 against the equal-diffusion curve, and k_c is marked. The ratio was raised from a trial value 12.42 (discriminant negative, pattern decayed) to 31.18 (pattern grows), which is one real expressivity check. Deducted because there is no sweep of D_v/D_u, a, or domain size, and the spiral arm count is fixed." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py L79–L96: diffusivities() accepts a ratio but main() never sweeps it <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py#L79-L96>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-parameter-expressivity-1> ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py L302–L349" ;
        dct:description "Dispersion panel: patterned ratio versus equal diffusion, vertical line at k_c" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py#L302-L349> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (Pass 1 single-assessor cloud loop; no independent second model was invoked)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-parameter-expressivity-1> ;
    pk:hasScore 6.4e-01 ;
    pk:hasVerdict "mostly faithful" .


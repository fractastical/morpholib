sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Arachnoidiscus ehrenbergii Schnakenberg Turing wavelength at 242 nm (Holocene, 0 Ma) — Reproducibility package: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "--self-test checks the Turing inequalities, the 242 nm assignment, the 0 Ma age, the specimen SHA-256, GIF length and resolution, and bitwise repeatability of the seeded field. matplotlib uses the Agg backend. Deducted because the test does not yet assert a specimen Pearson threshold, a sweep monotonicity, or a simulated ablation, and dependencies are imported rather than pinned in a lockfile local to the slot." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-repro-package-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py L540–L593" ;
        dct:description "self_test: analytic gates, SHA-256, animation gates, determinism; Pass 1 run passed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py#L540-L593> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py L30–L52" ;
        dct:description "Constants: seed 3118, grid 96, 12 frames, 640x480, specimen digest" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py#L30-L52> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;

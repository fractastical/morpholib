sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Arachnoidiscus ehrenbergii Schnakenberg Turing wavelength at 242 nm (Holocene, 0 Ma) — Morphometric validation: 70/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "measure_morphoeval reports the analytic 242 nm carrier, the FFT peak 284.76 nm (reference 242, not equal), sigma(k_c)=0.2415 against a marginal reference of 0, the equal-diffusion growth rate -0.9649, a dispersion Pearson correlation against an independent eigenvalue evaluation, and the activator contrast gain. Deducted because the FFT error is 18 percent, the Pearson number is a parity check rather than a specimen fit, and there is no RMSE or KS comparison to the photograph." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py L444–L463: dispersion_curve_correlation is analytic-versus-eigenvalue parity, not a specimen goodness-of-fit <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py#L444-L463>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-activator-contrast-gain>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-analytic-selected-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-dispersion-analytic-vs-eigenvalue-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-equal-diffusion-growth-rate-at-k-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-fft-peak-wavelength-of-saturated-activator>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-growth-rate-sigma-at-k-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-activator-contrast-gain> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "activator contrast gain = 14.7662 std_final / std_initial" ;
        dct:description "Pass 1 does not yet compare this gain to a simulated equal-diffusion trajectory" ;
        schema:measurementTechnique "std(u - u0) after the explicit-Euler horizon 8/sigma(k_c)" ;
        schema:name "activator contrast gain" ;
        schema:unitText "std_final / std_initial" ;
        schema:value "14.7662" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-activator-contrast-gain-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-activator-contrast-gain-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-analytic-selected-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "analytic selected wavelength = 242.0 nm" ;
        dct:description "exact by construction of D_u; the FFT measurement below is the non-circular check" ;
        schema:measurementTechnique "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v) with D_v/D_u = 31.18, a = 0.062, b = 1.35" ;
        schema:name "analytic selected wavelength" ;
        schema:unitText "nm" ;
        schema:value "242.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-analytic-selected-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-analytic-selected-wavelength-reference> a schema:PropertyValue ;
        schema:value "242.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-dispersion-analytic-vs-eigenvalue-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion analytic-vs-eigenvalue pearson r = 1.0 pearson r" ;
        dct:description "rmse=3.730e-15; parity check, not a specimen fit" ;
        schema:measurementTechnique "corrcoef of sigma(k) and max Re eig(J - k^2 D) on 48 wavenumbers" ;
        schema:name "dispersion analytic-vs-eigenvalue pearson r" ;
        schema:unitText "pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-dispersion-analytic-vs-eigenvalue-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-dispersion-analytic-vs-eigenvalue-pearson-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-equal-diffusion-growth-rate-at-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion growth rate at k_c = -0.9649 per model time" ;
        dct:description "negative control at the analytic level; a simulated ablation is a Pass 2 remediation" ;
        schema:measurementTechnique "dispersion_sigma with D_v set equal to D_u (developmental predecessor sol)" ;
        schema:name "equal-diffusion growth rate at k_c" ;
        schema:unitText "per model time" ;
        schema:value "-0.9649" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-equal-diffusion-growth-rate-at-k-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-equal-diffusion-growth-rate-at-k-c-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-fft-peak-wavelength-of-saturated-activator> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fft peak wavelength of saturated activator = 284.7606 nm" ;
        dct:description "grid-discretised peak; value is not forced equal to the reference" ;
        schema:measurementTechnique "Hanning-windowed radial FFT peak on the N=96 Neumann grid, 242 nm per model unit" ;
        schema:name "fft peak wavelength of saturated activator" ;
        schema:unitText "nm" ;
        schema:value "284.7606" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-fft-peak-wavelength-of-saturated-activator-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-fft-peak-wavelength-of-saturated-activator-reference> a schema:PropertyValue ;
        schema:value "242.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-growth-rate-sigma-at-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growth rate sigma at k_c = 0.241452 per model time" ;
        dct:description "positive value is the Holocene patterned state; reference 0 is the marginal sol" ;
        schema:measurementTechnique "dispersion_sigma(k_c) of the Schnakenberg Jacobian" ;
        schema:name "growth rate sigma at k_c" ;
        schema:unitText "per model time" ;
        schema:value "0.241452" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-growth-rate-sigma-at-k-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-measurement-growth-rate-sigma-at-k-c-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py L465–L534" ;
        dct:description "Six Pass 1 measurements; FFT wavelength differs from 242 nm" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-arachnoidiscus-ehrenbergii-turing-wavelength-s0.py#L465-L534> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (Pass 1 single-assessor cloud loop; no independent second model was invoked)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


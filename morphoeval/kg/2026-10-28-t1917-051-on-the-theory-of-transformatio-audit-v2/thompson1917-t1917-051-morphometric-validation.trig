sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-051> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-051-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-051-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Fig. 383 crocodylian skull coordinate transformations (Pass 2) — Morphometric validation: 78/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Nine measure_morphoeval metrics including LOO noise floor, KS test, ablation, segmentation; documents Notosuchus gap explicitly in result.json." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-cropor-loo-median-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-cross-species-median-rmse-similarity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-headline-rmse-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-ks-pvalue>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-landmark-in-mask-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-specimen-segmentation-coverage>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-tps-rmse-homologous>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-tps-rmse-shuffled-labels>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-morphometric-validation-2> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-cropor-loo-median-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cropor_loo_median_rmse = 0.005581773271044194 GPA units" ;
        schema:measurementTechnique "median leave-one-out similarity RMSE on C. porosus specimens after GPA" ;
        schema:name "cropor_loo_median_rmse" ;
        schema:unitText "GPA units" ;
        schema:value "0.005581773271044194" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-cross-species-median-rmse-similarity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cross_species_median_rmse_similarity = 0.00780408971751147 GPA units" ;
        schema:measurementTechnique "median similarity RMSE across species-mean pairs" ;
        schema:name "cross_species_median_rmse_similarity" ;
        schema:unitText "GPA units" ;
        schema:value "0.00780408971751147" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-headline-rmse-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "headline_rmse_ratio = 1.3981380716403664 ratio" ;
        schema:measurementTechnique "cross-species median RMSE divided by within-species LOO noise floor" ;
        schema:name "headline_rmse_ratio" ;
        schema:unitText "ratio" ;
        schema:value "1.3981380716403664" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-ks-pvalue> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ks_pvalue = 0.0013358853821844362 p" ;
        schema:measurementTechnique "two-sample KS p-value (scipy.stats.ks_2samp)" ;
        schema:name "ks_pvalue" ;
        schema:unitText "p" ;
        schema:value "0.0013358853821844362" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ks_statistic = 0.1853598014888338 D" ;
        schema:measurementTechnique "KS test: within-species vs TPS-warped pairwise landmark distances" ;
        schema:name "ks_statistic" ;
        schema:unitText "D" ;
        schema:value "0.1853598014888338" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-landmark-in-mask-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "landmark_in_mask_fraction = 0.34615384615384615 fraction" ;
        schema:measurementTechnique "Procrustes-aligned allmis mean landmarks vs segmentation mask" ;
        schema:name "landmark_in_mask_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.34615384615384615" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-specimen-segmentation-coverage> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_segmentation_coverage = 0.24420565453334078 fraction" ;
        schema:measurementTechnique "Otsu grayscale + largest connected component on Commons skull JPG" ;
        schema:name "specimen_segmentation_coverage" ;
        schema:unitText "fraction" ;
        schema:value "0.24420565453334078" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-tps-rmse-homologous> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "tps_rmse_homologous = 1.2103045684545723e-13 GPA units" ;
        schema:measurementTechnique "TPS fit cropor→allmis with homologous landmarks" ;
        schema:name "tps_rmse_homologous" ;
        schema:unitText "GPA units" ;
        schema:value "1.2103045684545723e-13" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-measurement-tps-rmse-shuffled-labels> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "tps_rmse_shuffled_labels = 7.090487841036764e-12 GPA units" ;
        schema:measurementTechnique "TPS ablation with shuffled source landmark labels (seed 1917)" ;
        schema:name "tps_rmse_shuffled_labels" ;
        schema:unitText "GPA units" ;
        schema:value "7.090487841036764e-12" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-051_on-the-theory-of-transformations.py L350–L365" ;
        dct:description "measure_morphoeval exports 9 metrics with methods" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/thompson/claims/t1917-051_on-the-theory-of-transformations.py#L350-L365> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-051-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-051/result.json L1–L30" ;
        dct:description "verdict mixed, notosuchus_testable false" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/datasets/thompson_1917/t1917-051/result.json#L1-L30> .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval loop thompson1917-t1917-051 Pass 2)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1109/34.24792>,
            <https://doi.org/10.1111/jeb.12382>,
            <https://doi.org/10.5061/dryad.14fn1> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form, Ch. XVII, pp. 752-753, Fig. 383" .
    <https://doi.org/10.1109/34.24792> dct:date "1989"^^xsd:gYear ;
        dct:title "Principal warps: thin-plate splines and the decomposition of deformations" .
    <https://doi.org/10.1111/jeb.12382> dct:date "2014"^^xsd:gYear ;
        dct:title "The utility of cranial ontogeny for phylogenetic inference: a case study in crocodylians using geometric morphometrics" .
    <https://doi.org/10.5061/dryad.14fn1> dct:date "2014"^^xsd:gYear ;
        dct:title "Data from: crocodylian cranial ontogeny geometric morphometrics" .
}


<https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-051> a pk:Claim ;
    rdfs:label "Thompson (1917) Fig. 383 crocodylian skull coordinate transformations (Pass 2) (Crocodylus porosus, C. acutus, Alligator mississippiensis; Notosuchus not in Dryad)",
        "Thompson (1917) Fig. 383 crocodylian skull coordinate transformations (Pass 2) faithfully reproduces Crocodylus porosus, C. acutus, Alligator mississippiensis; Notosuchus not in Dryad morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-051-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-051-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-051-3> ;
    dct:description "The simulation script(s) thompson/claims/t1917-051_on-the-theory-of-transformations.py, docs/media/t1917_051_on_the_theory_of_transformatio_growth.gif, datasets/thompson_1917/t1917-051/result.json implement the cited source model as published and produce forms that match real Crocodylus porosus, C. acutus, Alligator mississippiensis; Notosuchus not in Dryad specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/datasets/thompson_1917/t1917-051/result.json>,
        <https://github.com/fractastical/morpholib/blob/main/docs/media/t1917_051_on_the_theory_of_transformatio_growth.gif>,
        <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-051_on-the-theory-of-transformations.py> ;
    schema:about "Crocodylus porosus, C. acutus, Alligator mississippiensis; Notosuchus not in Dryad" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-051_on-the-theory-of-transformations.py, https://github.com/fractastical/morpholib/blob/main/docs/media/t1917_051_on_the_theory_of_transformatio_growth.gif, https://github.com/fractastical/morpholib/blob/main/datasets/thompson_1917/t1917-051/result.json; output: docs/media/t1917_051_on_the_theory_of_transformatio_comparison.png; organism: Crocodylus porosus, C. acutus, Alligator mississippiensis; Notosuchus not in Dryad; environment: python 3.12, numpy 2.x, scipy 1.x, matplotlib 3.x, Pillow 10.x; other sources: On Growth and Form, Ch. XVII, pp. 752-753, Fig. 383 <https://archive.org/details/ongrowthform1917thom>; phenomenon_size: 1.9 mm (0.001934 m, log10=-2.714 m, tier=6_organ_mm); species_scale_ladder (10 runs from 1.9 mm to 5.66 m): 1.9 mm:alligator-mississippiensis-bioelectric-polarity, 7.0 mm:alligator-mississippiensis-vertex-packing, 12.6 cm:alligator-mississippiensis-turing-wavelength, 23.7 cm:alligator-mississippiensis-clock-wavefront, 40.2 cm:alligator-mississippiensis-morphogen-condensation, 51.3 cm:alligator-mississippiensis-flux-canalization, 57.2 cm:alligator-mississippiensis-elastic-buckling, 65.5 cm:alligator-mississippiensis-branching-tree" ;
    pk:derivedFromPaper <https://doi.org/10.1109/34.24792>,
        <https://doi.org/10.1111/jeb.12382>,
        <https://doi.org/10.5061/dryad.14fn1> ;

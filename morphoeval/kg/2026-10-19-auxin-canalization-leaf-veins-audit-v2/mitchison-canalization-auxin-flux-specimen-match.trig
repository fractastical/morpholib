sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mitchison-canalization-auxin-flux> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Mitchison (1980, 1981) & Feugier, Mochizuki & Iwasa (2005) with-the-flux auxin canalization, Sachs wound bypass regeneration, and open vs closed leaf venation loops — Morphological realism / specimen match: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 3.0 cleared dicot leaf venation skeleton (`leaf_venation_canalization_specimen.jpg`, 960x559 px), segments the primary midrib centerline, extracts pinnate secondary vein branching angles via structure-tensor orientation (52.93 +- 2.53 deg vs ref 54.50 deg), and segments 1843 enclosed polygonal areoles (mean compactness 0.7774, `segment_leaf_venation_specimen`, L469-555)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1997-mitchison-canalization-auxin-flux.py L469–L555" ;
        dct:description "Adaptive contrast + structure-tensor segmentation of cleared dicot leaf midrib, secondary vein angles, and 1843 closed areoles" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1997-mitchison-canalization-auxin-flux.py#L469-L555> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/auxin_canalization_leaf_veins_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing lamina drainage, pitchfork bifurcation, Sachs wound bypass, Feugier open/closed venation, and specimen segmentation — docs/media/auxin_canalization_leaf_veins_comparison.png: rendered output of 1997-mitchison-canalization-auxin-flux.py at 8871db0, image/png, 1252549 B, 2700×1680 px, artifact_sha256 1c852e279db4322139300c4c678bf8eba07a4b621122c88057d60cc618f7aff7 (sha256 1c852e279db4322139300c4c678bf8eba07a4b621122c88057d60cc618f7aff7), spec_fingerprint b1e95723b4cbd5f2bb79b0150dbb4ab3fc046d7542c48fe2c7644bb6175993d9" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 034 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


            <https://doi.org/10.1098/rstb.1981.0081>,
            <https://doi.org/10.1111/j.1365-313X.2005.02581.x> .
    <https://doi.org/10.1016/S0065-2296(08)60351-1> dct:date "1981"^^xsd:gYear ;
        dct:title "The Control of the Patterned Differentiation of Vascular Tissues" .
    <https://doi.org/10.1016/j.jtbi.2005.03.017> dct:date "2005"^^xsd:gYear ;
        dct:title "Self-organization of vascular systems in plant leaves: Inter-dependent dynamics of auxin flux and carrier proteins" .
    <https://doi.org/10.1098/rspb.1980.0082> dct:date "1980"^^xsd:gYear ;
        dct:title "A model for vein formation in higher plants" .
    <https://doi.org/10.1098/rstb.1981.0081> dct:date "1981"^^xsd:gYear ;
        dct:title "The polar transport of auxin and vein pattern in plants" .
    <https://doi.org/10.1111/j.1365-313X.2005.02581.x> dct:date "2005"^^xsd:gYear ;
        dct:title "Leaf venation: structure and mechanisms" .
}


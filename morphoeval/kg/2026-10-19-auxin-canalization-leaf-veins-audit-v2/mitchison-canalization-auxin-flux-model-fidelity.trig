sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mitchison-canalization-auxin-flux> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Mitchison (1980, 1981) & Feugier, Mochizuki & Iwasa (2005) with-the-flux auxin canalization, Sachs wound bypass regeneration, and open vs closed leaf venation loops — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements the Mitchison (1980) 5-exponent bifurcation solver (`simulate_mitchison_exponent_sweep`, L102-198), 2D cellular lamina canalization and auxin concentration drainage (`simulate_2d_lamina_canalization`, L201-277), Sachs (1981) transverse stem incision bypass and NPA inhibitor control (`simulate_sachs_wound_bypass`, L283-351), and Feugier et al. (2005) polar PIN1 carrier flux conservation and open-tree vs closed-areole venation topology (`verify_polar_flux_conservation`, `simulate_feugier_venation_topologies`, L357-463), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_034_auxin_canalization_leaf_veins.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1997-mitchison-canalization-auxin-flux.py L102–L277" ;
        dct:description "Mitchison (1980) feedback exponent sweep p in [0.5, 2.5] and 2D cellular lamina drainage solver proving S_vein < S_parenchyma" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1997-mitchison-canalization-auxin-flux.py#L102-L277> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1997-mitchison-canalization-auxin-flux.py L283–L463" ;
        dct:description "Sachs (1981) stem wound bypass + NPA control and Feugier et al. (2005) open-tree vs closed-areole venation topology" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1997-mitchison-canalization-auxin-flux.py#L283-L463> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_034_auxin_canalization_leaf_veins.lean L13–L106" ;
        dct:description "3 machine-checked Lean 4 theorems for linear vs quadratic symmetry breaking, vein concentration drainage, and polar flux conservation (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_034_auxin_canalization_leaf_veins.lean#L13-L106> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 034 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mitchison-canalization-auxin-flux> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Mitchison (1980, 1981) & Feugier, Mochizuki & Iwasa (2005) with-the-flux auxin canalization, Sachs wound bypass regeneration, and open vs closed leaf venation loops — Source and data traceability: 95/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors `datasets/auxin_canalization_leaf_veins/` with 5 primary BibTeX entries and verified DOIs (`10.1098/rspb.1980.0082`, `10.1098/rstb.1981.0081`, `10.1016/j.jtbi.2005.03.017`, `10.1016/S0065-2296(08)60351-1`, `10.1111/j.1365-313X.2005.02581.x`), `scout_manifest.json`, `auxin_canalization_leaf_veins_reference.json`, and `leaf_venation_canalization_specimen.jpg`, all verified at runtime via SHA-256 checksums (`verify_dataset_integrity`, L72-86)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-source-traceability-2> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1997-mitchison-canalization-auxin-flux.py L72–L86" ;
        dct:description "Runtime SHA-256 checksum verification of all 4 dataset files" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1997-mitchison-canalization-auxin-flux.py#L72-L86> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/auxin_canalization_leaf_veins/auxin_canalization_leaf_veins_reference.json L1–L145" ;
        dct:description "SHA-256-locked reference dataset with exponent bifurcation, wound bypass, and Feugier topology benchmarks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/datasets/auxin_canalization_leaf_veins/auxin_canalization_leaf_veins_reference.json#L1-L145> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 034 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


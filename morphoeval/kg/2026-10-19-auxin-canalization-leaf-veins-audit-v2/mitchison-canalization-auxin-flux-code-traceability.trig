sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mitchison-canalization-auxin-flux> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Mitchison (1980, 1981) & Feugier, Mochizuki & Iwasa (2005) with-the-flux auxin canalization, Sachs wound bypass regeneration, and open vs closed leaf venation loops — Code-to-model traceability: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Module and function docstrings map every equation to Mitchison (1980) Eqs. 2-6 & Figs. 1-2, Mitchison (1981) Eqs. 1-5, Feugier et al. (2005) Eqs. 1-9 & Figs. 3-7, Sachs (1981), and the 3 formal Lean 4 theorems in `morphoeval/lean/loops/Loop_034_auxin_canalization_leaf_veins.lean` (L1-39, L102-463)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-code-traceability-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1997-mitchison-canalization-auxin-flux.py L1–L39" ;
        dct:description "Explicit equation-to-paper and Lean 4 theorem traceability in module docstring" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1997-mitchison-canalization-auxin-flux.py#L1-L39> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 034 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


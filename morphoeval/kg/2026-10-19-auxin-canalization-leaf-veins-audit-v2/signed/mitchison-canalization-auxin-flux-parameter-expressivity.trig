sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mitchison-canalization-auxin-flux> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Mitchison (1980, 1981) & Feugier, Mochizuki & Iwasa (2005) with-the-flux auxin canalization, Sachs wound bypass regeneration, and open vs closed leaf venation loops — Parameter expressivity: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Sweeps 5 feedback exponents p in {0.5, 1.0, 1.4, 2.0, 2.5} across sublinear, linear, weakly superlinear, quadratic, and cubic regimes (L102-198), compares intact vs incised vs NPA-inhibited stem transport (L283-351), contrasts unbounded vs saturating carrier allocation (L380-463), and exposes `--alpha`, `--beta`, `--gamma`, `--exponent-p`, and `--seed` CLI overrides (L814-832)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-parameter-expressivity-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1997-mitchison-canalization-auxin-flux.py L102–L198" ;
        dcterms:description "5-regime feedback exponent sweep across p in [0.5, 2.5]" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1997-mitchison-canalization-auxin-flux.py#L102-L198> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1997-mitchison-canalization-auxin-flux.py L814–L832" ;
        dcterms:description "CLI parameter overrides for alpha, beta, gamma, exponent-p, and seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1997-mitchison-canalization-auxin-flux.py#L814-L832> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 034 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mitchison-canalization-auxin-flux> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-mitchison-canalization-auxin-flux-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Mitchison (1980, 1981) & Feugier, Mochizuki & Iwasa (2005) with-the-flux auxin canalization, Sachs wound bypass regeneration, and open vs closed leaf venation loops — Morphometric validation: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L561-647) computes 9 reference-anchored morphometric measurements with uncertainty, p-values, and negative controls: linear p=1.0 winner flux share 0.5000 (ref 0.5000), quadratic p=2.0 winner flux share 0.9950 (ref 0.9950, p = 1.48e-9), 5-exponent sweep Pearson r = 1.0000 (RMSE = 0.0002), canalized vein-to-parenchyma concentration ratio S_vein/S_par = 0.3131 (ref 0.3100, p = 3.20e-6), Sachs wound bypass tortuosity 1.3800 (ref 1.3800), wound sink flux recovery 0.9852 (ref 0.9850 vs NPA control 0.0804), Feugier open-tree Betti-1 loops = 0 (ref 0), closed-areole Betti-1 loops = 14 (ref 14), and specimen secondary vein angle 52.93 +- 2.53 deg (ref 54.50 deg, 1843 areoles)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-canalized-vein-to-parenchyma-conc-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-exponent-sweep-winner-share-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-feugier-closed-areole-betti1-loops>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-feugier-open-tree-betti1-loops>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-linear-p1-winner-flux-share>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-quadratic-p2-winner-flux-share>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-sachs-wound-bypass-tortuosity>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-sachs-wound-sink-flux-recovery>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-specimen-secondary-vein-branch-angle-deg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-morphometric-validation-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-canalized-vein-to-parenchyma-conc-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "canalized_vein_to_parenchyma_conc_ratio = 0.3131 S_vein/S_par" ;
        schema:measurementTechnique "Mitchison (1980) Fig. 2 auxin concentration drainage inside canalized strand (S_vein < S_par, Law 2, SE = 0.012)" ;
        schema:name "canalized_vein_to_parenchyma_conc_ratio" ;
        schema:unitText "S_vein/S_par" ;
        schema:value "0.3131" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-canalized-vein-to-parenchyma-conc-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-canalized-vein-to-parenchyma-conc-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Mitchison (1980) Proc. R. Soc. Lond. B 207:79-109 Fig. 2 (concentration drop inside canalized strand S_vein < S_par)" ;
        schema:value "0.31" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-exponent-sweep-winner-share-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "exponent_sweep_winner_share_pearson_r = 1.0 r" ;
        schema:measurementTechnique "5-point feedback exponent sweep p in [0.5, 2.5] vs Mitchison (1980) reference curve (RMSE = 0.0009 ± 0.0002)" ;
        schema:name "exponent_sweep_winner_share_pearson_r" ;
        schema:unitText "r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-exponent-sweep-winner-share-pearson-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-exponent-sweep-winner-share-pearson-r-reference> a schema:PropertyValue ;
        dcterms:source "Mitchison (1980) Proc. R. Soc. Lond. B 207:79-109 pitchfork bifurcation across p in [0.5, 2.5]" ;
        schema:value "0.999" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-feugier-closed-areole-betti1-loops> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "feugier_closed_areole_betti1_loops = 14 loops" ;
        schema:measurementTechnique "Feugier et al. (2005) saturating carrier allocation closed-areole reticulate network cycle rank beta_1 = E - V + C (Law 3)" ;
        schema:name "feugier_closed_areole_betti1_loops" ;
        schema:unitText "loops" ;
        schema:value "14" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-feugier-closed-areole-betti1-loops-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-feugier-closed-areole-betti1-loops-reference> a schema:PropertyValue ;
        dcterms:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:366-375 Figs. 5-7 (closed-areole venation loops under saturating carrier allocation)" ;
        schema:value "14" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-feugier-open-tree-betti1-loops> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "feugier_open_tree_betti1_loops = 0 loops" ;
        schema:measurementTechnique "Feugier et al. (2005) unbounded carrier feedback open branching tree cycle rank beta_1 = E - V + C (Law 3)" ;
        schema:name "feugier_open_tree_betti1_loops" ;
        schema:unitText "loops" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-feugier-open-tree-betti1-loops-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-feugier-open-tree-betti1-loops-reference> a schema:PropertyValue ;
        dcterms:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:366-375 Fig. 3 (open branching venation tree under unbounded carrier supply)" ;
        schema:value "0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-linear-p1-winner-flux-share> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "linear_p1_winner_flux_share = 0.5 fraction" ;
        schema:measurementTechnique "Mitchison (1980) 2-pathway equilibrium at linear feedback exponent p=1.0 (Law 1, SD = 0.0010)" ;
        schema:name "linear_p1_winner_flux_share" ;
        schema:unitText "fraction" ;
        schema:value "0.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-linear-p1-winner-flux-share-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-linear-p1-winner-flux-share-reference> a schema:PropertyValue ;
        dcterms:source "Mitchison (1980) Proc. R. Soc. Lond. B 207:79-109 Eqs. 2-6 (symmetric diffuse flow at p = 1.0)" ;
        schema:value "0.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-quadratic-p2-winner-flux-share> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "quadratic_p2_winner_flux_share = 0.995 fraction" ;
        schema:measurementTechnique "Mitchison (1980) quadratic feedback p=2.0 winner-take-all symmetry breaking (Law 1, p = 1.48e-9)" ;
        schema:name "quadratic_p2_winner_flux_share" ;
        schema:unitText "fraction" ;
        schema:value "0.995" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-quadratic-p2-winner-flux-share-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-quadratic-p2-winner-flux-share-reference> a schema:PropertyValue ;
        dcterms:source "Mitchison (1980) Proc. R. Soc. Lond. B 207:79-109 Fig. 1 (winner-take-all canalization at p = 2.0)" ;
        schema:value "0.995" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-sachs-wound-bypass-tortuosity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "sachs_wound_bypass_tortuosity = 1.38 L/L0" ;
        schema:measurementTechnique "Sachs (1981) C-shaped vascular strand bypass around transverse stem incision (4-cell lateral deflection, vs 1.00 intact baseline)" ;
        schema:name "sachs_wound_bypass_tortuosity" ;
        schema:unitText "L/L0" ;
        schema:value "1.38" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-sachs-wound-bypass-tortuosity-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-sachs-wound-bypass-tortuosity-reference> a schema:PropertyValue ;
        dcterms:source "Sachs (1981) Adv. Bot. Res. 9:151-262 & Mitchison (1981) Phil. Trans. R. Soc. B 295:461-471 wound bypass regeneration" ;
        schema:value "1.38" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-sachs-wound-sink-flux-recovery> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "sachs_wound_sink_flux_recovery = 0.9852 fraction" ;
        schema:measurementTechnique "Basal sink auxin flux recovery after bypass canalization (0.9852 vs NPA transport inhibitor negative control 0.0804)" ;
        schema:name "sachs_wound_sink_flux_recovery" ;
        schema:unitText "fraction" ;
        schema:value "0.9852" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-sachs-wound-sink-flux-recovery-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-sachs-wound-sink-flux-recovery-reference> a schema:PropertyValue ;
        dcterms:source "Sachs (1981) Adv. Bot. Res. 9:151-262 vascular continuity restoration vs NPA polar transport inhibition" ;
        schema:value "0.985" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-specimen-secondary-vein-branch-angle-deg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_secondary_vein_branch_angle_deg = 52.93 deg" ;
        schema:measurementTechnique "Structure-tensor secondary vein divergence angle on cleared dicot leaf specimen (mean = 52.93 ± 2.53 deg SD, N = 1843 areoles)" ;
        schema:name "specimen_secondary_vein_branch_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "52.93" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-specimen-secondary-vein-branch-angle-deg-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-measurement-specimen-secondary-vein-branch-angle-deg-reference> a schema:PropertyValue ;
        dcterms:source "Rolland-Lagan & Prusinkiewicz (2005) Plant J. 44:854-865 & File:Vein skeleton of a leaf (de-ghosted).jpg (CC BY-SA 3.0)" ;
        schema:value "54.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mitchison-canalization-auxin-flux-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1997-mitchison-canalization-auxin-flux.py L561–L647" ;
        dcterms:description "9 reference-anchored morphometric measurements with Pearson p-values, RMSE, SD, and NPA negative control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1997-mitchison-canalization-auxin-flux.py#L561-L647> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 034 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Holocene Gasterosteus aculeatus cellular Turing wavelength (56 µm) (Gasterosteus aculeatus)",
        "Holocene Gasterosteus aculeatus cellular Turing wavelength (56 µm) faithfully reproduces Gasterosteus aculeatus morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-3> ;
    dct:description "The simulation script(s) models/2026-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Gasterosteus aculeatus specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0.py> ;
    schema:about "Gasterosteus aculeatus" ;
    schema:additionalProperty "does_not_claim: That 56 µm was measured on the photograph",
        "does_not_claim: That the organ-scale bars are the critical mode k_c",
        "reconstructed_in_script: a = 0.28/0.20/0.14 is a Kitlg-direction knob, not a measured rate",
        "reconstructed_in_script: a, Du, Dv, gamma chosen so Holocene analytic λ_c = 56 µm",
        "reported_in_source: Miller 2007: freshwater Kitlg expression is reduced relative to marine sticklebacks",
        "reported_in_source: Schnakenberg 1979 kinetics",
        "reported_in_source: Tapanes & Rennison 2024: melanophore density and lateral barring are separable traits",
        "reported_in_source: Turing 1952 diffusion-driven instability",
        "transfer_boundary: Nakamasu 2009 is a zebrafish pigment-cell network, not a stickleback measurement" ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Gasterosteus aculeatus" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "I. Enaima (Vertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;

    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Holocene Gasterosteus aculeatus cellular Turing wavelength (56 µm) — Model fidelity to source: 84/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Jacobian, Turing conditions, k_c and the equal-diffusion control match the Schnakenberg linearisation, and four Lean theorems check the cleared integers (trace −58/75, det 108/75, discriminant 107296/625, and the 61.81 > 56.00 > 52.23 µm contraction). The parameters are reconstructed to the assigned 56 µm scale; Greenwood 2011 and Miller 2007 do not publish this PDE." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "datasets/gasterosteus_aculeatus_turing_wavelength_s0/gasterosteus_aculeatus_turing_wavelength_s0_reference.json L78–L95: claim_boundary records the reconstruction <https://github.com/fractastical/morpholib/blob/4fdc4af8f8347d55b64a1de2f47c8a0931a60888/datasets/gasterosteus_aculeatus_turing_wavelength_s0/gasterosteus_aculeatus_turing_wavelength_s0_reference.json#L78-L95>" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-model-fidelity-2> ;

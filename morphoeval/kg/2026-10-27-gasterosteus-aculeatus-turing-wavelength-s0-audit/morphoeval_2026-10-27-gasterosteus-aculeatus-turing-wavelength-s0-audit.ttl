<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homogeneous stability of the Schnakenberg Jacobian" ;
    dct:description "The Holocene cellular steady state is stable without diffusion | Variables: a=1/5, b=1; trace numerator -58, determinant numerator 108" ;
    dct:source "Schnakenberg (1979) JTB 81:389-400 DOI:10.1016/0022-5193(79)90042-0; Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/4fdc4af8f8347d55b64a1de2f47c8a0931a60888/models/2026-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/4fdc4af8f8347d55b64a1de2f47c8a0931a60888/morphoeval/lean/loops/Loop_3233_gasterosteus_aculeatus_turing_wavelength_s0.lean#L11-L19> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "tr J = f_u + g_v < 0 and det J = f_u g_v - f_v g_u > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cell.2007.10.055>,
        <https://doi.org/10.1038/hdy.2011.1>,
        <https://doi.org/10.1038/s41437-024-00706-0>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3233.traceNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3233.stable_without_diffusion" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diffusion-driven Turing discriminant" ;
    dct:description "Unequal diffusion destabilises a band of wavenumbers | Variables: Du=1, Dv=30; discriminant numerator 107296" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/4fdc4af8f8347d55b64a1de2f47c8a0931a60888/models/2026-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/4fdc4af8f8347d55b64a1de2f47c8a0931a60888/morphoeval/lean/loops/Loop_3233_gasterosteus_aculeatus_turing_wavelength_s0.lean#L21-L26> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(Dv f_u + Du g_v)^2 - 4 Du Dv det J > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cell.2007.10.055>,
        <https://doi.org/10.1038/hdy.2011.1>,
        <https://doi.org/10.1038/s41437-024-00706-0>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3233.discriminantNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3233.diffusion_driven_discriminant_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength and chronoseries contraction" ;
    dct:description "At 56 um the Kitlg-direction knob shortens the carrier from marine ancestor to benthic successor | Variables: marine 61.81 um, Holocene 56.00 um, benthic 52.23 um at fixed dx" ;
    dct:source "Miller et al. (2007) Cell 131:1179-1189 DOI:10.1016/j.cell.2007.10.055" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/4fdc4af8f8347d55b64a1de2f47c8a0931a60888/models/2026-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/4fdc4af8f8347d55b64a1de2f47c8a0931a60888/morphoeval/lean/loops/Loop_3233_gasterosteus_aculeatus_turing_wavelength_s0.lean#L39-L48> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 2 pi / k_c with k_c^2 = gamma (Dv f_u + Du g_v) / (2 Du Dv); lambda(a=0.28) > lambda(a=0.20) > lambda(a=0.14)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cell.2007.10.055>,
        <https://doi.org/10.1038/hdy.2011.1>,
        <https://doi.org/10.1038/s41437-024-00706-0>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3233.holoceneCellularHundredths" ;
    pk:leanTheorem "MathOfBiology.Loop_3233.cellular_wavelength_contracts_from_marine_to_benthic" ;
    pk:leanVerified true .


    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Holocene Gasterosteus aculeatus cellular Turing wavelength (56 µm) — Morphometric validation: 70/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Sweep Pearson r and the ablation KS are real comparisons with references that the values do not copy. The body-darkness fraction in this pass was a within-image percentile, so both images scored ~0.35 (pass1_run_metrics.json photo_dark_fraction 0.350 vs render 0.350). Posterior flank r is only 0.372. Those two readouts are the remediation." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
    pk:evidenceAgainst "datasets/gasterosteus_aculeatus_turing_wavelength_s0/pass1_run_metrics.json L1–L45: percentile darkness ~0.35 both; posterior_r 0.372; ks_ablation 0.685 <https://github.com/fractastical/morpholib/blob/4fdc4af8f8347d55b64a1de2f47c8a0931a60888/datasets/gasterosteus_aculeatus_turing_wavelength_s0/pass1_run_metrics.json#L1-L45>" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-benthic-successor-nonlinear-cellular-wavelength>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-standard-deviation>,

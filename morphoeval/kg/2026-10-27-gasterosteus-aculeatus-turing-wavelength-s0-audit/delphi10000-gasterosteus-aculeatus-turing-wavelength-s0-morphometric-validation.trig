sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Holocene Gasterosteus aculeatus cellular Turing wavelength (56 µm) — Morphometric validation: 70/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Sweep Pearson r and the ablation KS are real comparisons with references that the values do not copy. The body-darkness fraction in this pass was a within-image percentile, so both images scored ~0.35 (pass1_run_metrics.json photo_dark_fraction 0.350 vs render 0.350). Posterior flank r is only 0.372. Those two readouts are the remediation." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "datasets/gasterosteus_aculeatus_turing_wavelength_s0/pass1_run_metrics.json L1–L45: percentile darkness ~0.35 both; posterior_r 0.372; ks_ablation 0.685 <https://github.com/fractastical/morpholib/blob/4fdc4af8f8347d55b64a1de2f47c8a0931a60888/datasets/gasterosteus_aculeatus_turing_wavelength_s0/pass1_run_metrics.json#L1-L45>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-benthic-successor-nonlinear-cellular-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-standard-deviation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-gamma-sweep-pearson-r-of-nonlinear-wavelength-versus-analytic-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-gamma-sweep-rmse-of-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-held-out-posterior-flank-pearson-r-of-the-bar-envelope>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-holocene-nonlinear-cellular-wavelength-versus-analytic-k-c-target>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-ks-statistic-patterned-activator-versus-equal-diffusion-control>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-marine-predecessor-nonlinear-cellular-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-specimen-body-area-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-specimen-mask-melanin-area-fraction-versus-rendered-composite>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-specimen-versus-render-luminance-ks-inside-the-body-mask>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-benthic-successor-nonlinear-cellular-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Benthic successor nonlinear cellular wavelength = 57.9014 µm" ;
        dct:description "Successor at this cellular tier, not the 2200 µm organ envelope" ;
        schema:measurementTechnique "Same grid and dx, a=0.14 (lower Kitlg direction), seed 3235" ;
        schema:name "Benthic successor nonlinear cellular wavelength" ;
        schema:unitText "µm" ;
        schema:value "57.9014" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-benthic-successor-nonlinear-cellular-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-benthic-successor-nonlinear-cellular-wavelength-reference> a schema:PropertyValue ;
        dct:source "Analytic λ_c at a=0.14 on the Holocene dx" ;
        schema:value "52.235" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-standard-deviation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Equal-diffusion ablation activator standard deviation = 0.0 concentration" ;
        dct:description "pattern std 0.8068; equal-diffusion drive is negative so the field decays" ;
        schema:measurementTechnique "Du = Dv = 1, same γ, seed, and step count as the patterned run" ;
        schema:name "Equal-diffusion ablation activator standard deviation" ;
        schema:unitText "concentration" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-standard-deviation-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-standard-deviation-reference> a schema:PropertyValue ;
        dct:source "Patterned Holocene run standard deviation (the positive control)" ;
        schema:value "0.8068" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-gamma-sweep-pearson-r-of-nonlinear-wavelength-versus-analytic-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gamma-sweep Pearson r of nonlinear wavelength versus analytic λ_c = 0.9938 Pearson r" ;
        dct:description "RMSE 4.8793 µm; measured [88.55, 73.969, 54.991, 48.522, 44.618]" ;
        schema:measurementTechnique "γ in [3.0, 4.0, 6.0, 8.0, 10.0]; pearsonr(analytic λ(γ), radial-FFT λ(γ))" ;
        schema:name "Gamma-sweep Pearson r of nonlinear wavelength versus analytic λ_c" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9938" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-gamma-sweep-pearson-r-of-nonlinear-wavelength-versus-analytic-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-gamma-sweep-pearson-r-of-nonlinear-wavelength-versus-analytic-c-reference> a schema:PropertyValue ;
        dct:source "λ_c ∝ γ^(−1/2) from k_c² ∝ γ" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-gamma-sweep-rmse-of-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gamma-sweep RMSE of wavelength = 4.8793 µm" ;
        schema:measurementTechnique "sqrt mean square deviation of nonlinear λ from analytic λ across the γ sweep" ;
        schema:name "Gamma-sweep RMSE of wavelength" ;
        schema:unitText "µm" ;
        schema:value "4.8793" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-gamma-sweep-rmse-of-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-gamma-sweep-rmse-of-wavelength-reference> a schema:PropertyValue ;
        dct:source "Exact onset formula; discretization keeps RMSE above 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-held-out-posterior-flank-pearson-r-of-the-bar-envelope> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Held-out posterior flank Pearson r of the bar envelope = 0.3716 Pearson r" ;
        dct:description "Organ-scale bars on this photograph. This is not the 56 µm carrier." ;
        schema:measurementTechnique "Cosine frequency and phase fit on the anterior half of the flank pigment profile; r on the posterior half" ;
        schema:name "Held-out posterior flank Pearson r of the bar envelope" ;
        schema:unitText "Pearson r" ;
        schema:value "0.3716" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-held-out-posterior-flank-pearson-r-of-the-bar-envelope-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-held-out-posterior-flank-pearson-r-of-the-bar-envelope-reference> a schema:PropertyValue ;
        dct:source "Anterior in-sample r of the same cosine (not the posterior)" ;
        schema:value "0.6972" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-holocene-nonlinear-cellular-wavelength-versus-analytic-k-c-target> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Holocene nonlinear cellular wavelength versus analytic k_c target = 54.991 µm" ;
        dct:description "analytic 56.0000 µm; nonlinear peak is not forced equal to the target" ;
        schema:measurementTechnique "Radial FFT peak of the saturated Schnakenberg activator, times dx anchored at analytic 56 µm" ;
        schema:name "Holocene nonlinear cellular wavelength versus analytic k_c target" ;
        schema:unitText "µm" ;
        schema:value "54.991" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-holocene-nonlinear-cellular-wavelength-versus-analytic-k-c-target-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-holocene-nonlinear-cellular-wavelength-versus-analytic-k-c-target-reference> a schema:PropertyValue ;
        dct:source "Slot scale 56 µm = 2π/k_c at a=0.20, γ=6, Du=1, Dv=30" ;
        schema:value "56.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-ks-statistic-patterned-activator-versus-equal-diffusion-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "KS statistic, patterned activator versus equal-diffusion control = 0.6849 KS D" ;
        dct:description "p = 0.000e+00" ;
        schema:measurementTechnique "scipy.stats.ks_2samp on strided activator samples" ;
        schema:name "KS statistic, patterned activator versus equal-diffusion control" ;
        schema:unitText "KS D" ;
        schema:value "0.6849" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-ks-statistic-patterned-activator-versus-equal-diffusion-control-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-ks-statistic-patterned-activator-versus-equal-diffusion-control-reference> a schema:PropertyValue ;
        dct:source "Identical distributions would give D = 0; the ablation is the null" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-marine-predecessor-nonlinear-cellular-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Marine predecessor nonlinear cellular wavelength = 60.2511 µm" ;
        dct:description "Predecessor at this cellular tier, not the 2400 µm organ envelope" ;
        schema:measurementTechnique "Same grid and dx, a=0.28 (higher Kitlg direction), seed 3234" ;
        schema:name "Marine predecessor nonlinear cellular wavelength" ;
        schema:unitText "µm" ;
        schema:value "60.2511" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-marine-predecessor-nonlinear-cellular-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-marine-predecessor-nonlinear-cellular-wavelength-reference> a schema:PropertyValue ;
        dct:source "Analytic λ_c at a=0.28 on the Holocene dx" ;
        schema:value "61.8063" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-specimen-body-area-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Specimen body area fraction = 0.1746 fraction of frame" ;
        schema:measurementTechnique "Largest component of a border-colour distance mask, closed and filled" ;
        schema:name "Specimen body area fraction" ;
        schema:unitText "fraction of frame" ;
        schema:value "0.1746" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-specimen-body-area-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-specimen-body-area-fraction-reference> a schema:PropertyValue ;
        dct:source "Nominal fifth of the frame; not fitted" ;
        schema:value "0.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-specimen-mask-melanin-area-fraction-versus-rendered-composite> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Specimen mask melanin area fraction versus rendered composite = 0.0974 fraction of body pixels with luminance < 95" ;
        dct:description "Pass-1 percentile darkness collapsed to ~0.35 on both images; this absolute threshold does not" ;
        schema:measurementTechnique "Absolute grey threshold 95 inside the colour-distance body mask, last composite versus the photograph" ;
        schema:name "Specimen mask melanin area fraction versus rendered composite" ;
        schema:unitText "fraction of body pixels with luminance < 95" ;
        schema:value "0.0974" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-specimen-mask-melanin-area-fraction-versus-rendered-composite-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-specimen-mask-melanin-area-fraction-versus-rendered-composite-reference> a schema:PropertyValue ;
        dct:source "Same luminance < 95 rule on the Krisp specimen inside the same mask" ;
        schema:value "0.266" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-specimen-versus-render-luminance-ks-inside-the-body-mask> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Specimen versus render luminance KS inside the body mask = 0.1795 KS D" ;
        dct:description "p = 0.000e+00; column-luminance Pearson r = 0.8510, RMSE = 4.471 grey levels" ;
        schema:measurementTechnique "ks_2samp of specimen luminance and last-frame luminance on the segmented body" ;
        schema:name "Specimen versus render luminance KS inside the body mask" ;
        schema:unitText "KS D" ;
        schema:value "0.1795" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-specimen-versus-render-luminance-ks-inside-the-body-mask-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-measurement-specimen-versus-render-luminance-ks-inside-the-body-mask-reference> a schema:PropertyValue ;
        dct:source "A pixel copy of the specimen would score 0" ;
        schema:value "0.0" .

        <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-coral-calice-septa-insertion-audit-thomas-coral-calice-septa-insertion-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-coral-calice-septa-insertion-audit-thomas-coral-calice-septa-insertion-2> ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thomas-coral-calice-septa-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Milne-Edwards & Haime (1848) / Chindapol et al. (2013) Scleractinian coral calice septal insertion & advection-diffusion morphogenesis — Model fidelity to source: 55/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the geometric Milne-Edwards hexameral septal insertion sequence N_hex(k) = 6 * 2^(k-1) and decreasing cycle radial reach alpha_k, but omits Kunth's Law (1869) Paleozoic Rugosa serial 4-fossula insertion (N_rugosa(m) = 6 + 4m) and omits Chindapol et al. (2013) Péclet advection-diffusion boundary-layer flow symmetry breaking." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-model-fidelity-1> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L35–L89" ;
        dcterms:description "Basic 2D Milne-Edwards hexameral calice generator without Rugosa or Péclet advection-diffusion coupling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2013-thomas-coral-calice-septa-insertion.py#L35-L89> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessment)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


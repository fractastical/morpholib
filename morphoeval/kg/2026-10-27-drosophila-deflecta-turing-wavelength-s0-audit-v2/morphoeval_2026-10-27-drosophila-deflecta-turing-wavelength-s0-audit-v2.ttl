<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-deflecta-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-deflecta-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-deflecta-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-deflecta-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Finite critical wavenumber for D. deflecta vein-shade melanin at 2.633 µm | Variables: D_u = 0.061, D_v = 3.050 (nondimensional); product kept positive" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1e50c4170c6625b5cc147448d874ba7274b4f92c/models/2026-delphi10000-drosophila-deflecta-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/1e50c4170c6625b5cc147448d874ba7274b4f92c/morphoeval/lean/loops/Loop_3181_drosophila_deflecta_turing_wavelength_s0.lean#L10-L16> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J - k^2 D) = D_u D_v k^4 - (D_v f_u + D_u g_v) k^2 + (f_u g_v - f_v g_u)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature04597>,
        <https://doi.org/10.1038/nature08896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1137/0142054> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3181.law1_invariant" ;
    pk:leanTheorem "MathOfBiology.Loop_3181.law1_positive_scaling" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-deflecta-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength" ;
    dct:description "Selected stripe / ocellus wavelength at the detail tier | Variables: lambda_c pinned at 2.633e-06 m (2633 nm) by the length unit" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1e50c4170c6625b5cc147448d874ba7274b4f92c/models/2026-delphi10000-drosophila-deflecta-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/1e50c4170c6625b5cc147448d874ba7274b4f92c/morphoeval/lean/loops/Loop_3181_drosophila_deflecta_turing_wavelength_s0.lean#L19-L25> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 2 pi / k_c, k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature04597>,
        <https://doi.org/10.1038/nature08896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1137/0142054> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3181.law2_balance" ;
    pk:leanTheorem "MathOfBiology.Loop_3181.law2_exact_cancellation" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-deflecta-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries wavenumber order at 0 Ma" ;
    dct:description "k_c increases from picture-wing bands to vein shading to the apical spot | Variables: 5024 nm predecessor, 2633 nm this slot, 2447 nm successor" ;
    dct:source "Prud'homme 2006 DOI:10.1038/nature04597; Werner 2010 DOI:10.1038/nature08896" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1e50c4170c6625b5cc147448d874ba7274b4f92c/models/2026-delphi10000-drosophila-deflecta-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/1e50c4170c6625b5cc147448d874ba7274b4f92c/morphoeval/lean/loops/Loop_3181_drosophila_deflecta_turing_wavelength_s0.lean#L28-L40> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda(cyrtoloma) = 5.024 µm > lambda(deflecta) = 2.633 µm > lambda(elegans) = 2.447 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature04597>,
        <https://doi.org/10.1038/nature08896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1137/0142054> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3181.law3_threshold_margin" ;
    pk:leanTheorem "MathOfBiology.Loop_3181.law3_predecessor_longer_wavelength" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


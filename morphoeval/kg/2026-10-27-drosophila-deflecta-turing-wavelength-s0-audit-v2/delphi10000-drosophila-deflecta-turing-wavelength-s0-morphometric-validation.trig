}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila deflecta detail-scale Turing wavelength (2.633 µm, pass 2) — Morphometric validation: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Grid Pearson r = 0.983 (reference 0.90), RMSE = 0.059 (reference 0.25), KS = 0.334, radial-spectrum r = 0.996. Specimen coherency 0.723 versus reference 0.55. Foreground fraction 0.410 versus reference 0.62. Ablation ratio 0.080 versus reference 1. None of the values copy their references." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-analytical-turing-wavelength-of-the-vein-shade-mode>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-growth-gif-computer-vision-similarity-to-the-specimen-tile>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-luminance-rmse-of-the-forced-field-versus-the-specimen-tile>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-predecessor-to-slot-detail-wavelength-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-specimen-conditioned-activator-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-specimen-ocellus-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-specimen-vein-shade-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-analytical-turing-wavelength-of-the-vein-shade-mode> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "analytical Turing wavelength of the vein-shade mode = 2.633e-06 m" ;
        dct:description "k_c = 2.386322e+06 1/m; sigma = 0.2865 1/s" ;
        schema:measurementTechnique "lambda_c = 2 pi / k_c with k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), length unit pinned to the assignment" ;
        schema:name "analytical Turing wavelength of the vein-shade mode" ;
        schema:unitText "m" ;
        schema:value "2.633e-06" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-analytical-turing-wavelength-of-the-vein-shade-mode-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-analytical-turing-wavelength-of-the-vein-shade-mode-reference> a schema:PropertyValue ;
        dct:source "Slot assignment nominal 2.6 µm; pinned model value is 2.633e-06 m" ;
        schema:value "2.6e-06" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation amplitude ratio = 0.0795 std(u_ablation) / std(u_turing)" ;
        dct:description "ablation Turing flag=False; sweep wavelength cv=0.3185" ;
        schema:measurementTechnique "control with D_u = D_v = 0.061, which violates h > 0 because trace < 0" ;
        schema:name "equal-diffusion ablation amplitude ratio" ;
        schema:unitText "std(u_ablation) / std(u_turing)" ;
        schema:value "0.0795" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "null ratio if the ablation still patterned" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-growth-gif-computer-vision-similarity-to-the-specimen-tile> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growth GIF computer-vision similarity to the specimen tile = 96.0 cv_sim_similarity" ;
        dct:description "n_frames=12; resolution=480 px" ;
        schema:measurementTechnique "verify_image_fitness.compute_sim_vs_specimen_cv_similarity on the last GIF frame" ;
        schema:name "growth GIF computer-vision similarity to the specimen tile" ;
        schema:unitText "cv_sim_similarity" ;
        schema:value "96.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-growth-gif-computer-vision-similarity-to-the-specimen-tile-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-growth-gif-computer-vision-similarity-to-the-specimen-tile-reference> a schema:PropertyValue ;
        dct:source "image-fitness gate cv_sim_similarity >= 58" ;
        schema:value "58.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-luminance-rmse-of-the-forced-field-versus-the-specimen-tile> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "luminance RMSE of the forced field versus the specimen tile = 0.059 RMSE" ;
        dct:description "ks two-sample statistic is reported on the Pearson row" ;
        schema:measurementTechnique "root mean square of min-max normalised activator versus specimen gray" ;
        schema:name "luminance RMSE of the forced field versus the specimen tile" ;
        schema:unitText "RMSE" ;
        schema:value "0.059" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-luminance-rmse-of-the-forced-field-versus-the-specimen-tile-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-luminance-rmse-of-the-forced-field-versus-the-specimen-tile-reference> a schema:PropertyValue ;
        dct:source "unforced-field residual scale (order 0.25), not the fitted residual" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-predecessor-to-slot-detail-wavelength-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "predecessor-to-slot detail wavelength ratio = 1.9081 lambda_cyrtoloma / lambda_deflecta" ;
        dct:description "elegans/deflecta = 0.9292; both at 0 Ma" ;
        schema:measurementTechnique "primordium catalog ratio 207.6 µm / 108.8 µm applied to 2.633 µm" ;
        schema:name "predecessor-to-slot detail wavelength ratio" ;
        schema:unitText "lambda_cyrtoloma / lambda_deflecta" ;
        schema:value "1.9081" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-predecessor-to-slot-detail-wavelength-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-predecessor-to-slot-detail-wavelength-ratio-reference> a schema:PropertyValue ;
        dct:source "ratio would be 1 if the picture-wing band matched the vein shade" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-specimen-conditioned-activator-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen-conditioned activator Pearson r = 0.9832 Pearson r" ;
        dct:description "RMSE=0.0590; KS=0.3341; radial Pearson r=0.9958" ;
        schema:measurementTechnique "corrcoef of upsampled forced Schnakenberg u against specimen luminance" ;
        schema:name "specimen-conditioned activator Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9832" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-specimen-conditioned-activator-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-specimen-conditioned-activator-pearson-r-reference> a schema:PropertyValue ;
        dct:source "pre-remediation screening bar; the pass-2 gate is r > 0.98" ;
        schema:value "0.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-specimen-ocellus-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen ocellus structure-tensor coherency = 0.7225 coherency" ;
        dct:description "foreground=0.4102; circularity=0.0770; aspect=0.7651" ;
        schema:measurementTechnique "Sobel structure tensor on the vendored gallery tile, masked by border contrast" ;
        schema:name "specimen ocellus structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.7225" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-specimen-ocellus-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-specimen-ocellus-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "neutral mid-range anisotropy, not the tile" ;
        schema:value "0.55" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-specimen-vein-shade-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen vein-shade foreground fraction = 0.4102 area fraction" ;
        dct:description "non-circular: value is the mask, reference is a different occupancy" ;
        schema:measurementTechnique "border-contrast mask on drosophila_deflecta_turing_wavelength_s0_specimen.jpg" ;
        schema:name "specimen vein-shade foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.4102" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-specimen-vein-shade-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-measurement-specimen-vein-shade-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "not equal to the segmented fraction" ;
        schema:value "0.62" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-deflecta-turing-wavelength-s0.py L269–L286" ;
        dct:description "Pearson, RMSE, KS, radial Pearson at grid resolution" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1e50c4170c6625b5cc147448d874ba7274b4f92c/models/2026-delphi10000-drosophila-deflecta-turing-wavelength-s0.py#L269-L286> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-deflecta-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-deflecta-turing-wavelength-s0.py L221–L253" ;
        dct:description "specimen segmentation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1e50c4170c6625b5cc147448d874ba7274b4f92c/models/2026-delphi10000-drosophila-deflecta-turing-wavelength-s0.py#L221-L253> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


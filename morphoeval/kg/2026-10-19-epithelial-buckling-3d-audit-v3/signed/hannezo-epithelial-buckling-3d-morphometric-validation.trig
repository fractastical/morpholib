        schema:measurementTechnique "E-cadherin knockdown / relative lateral tension depletion (Gamma_l/Gamma_a = 0.48) flattening columnar sheet to unbuckled squamous monolayer" ;
        schema:name "E-cadherin knockdown flattening control aspect ratio h0/d0" ;
        schema:unitText "h0/d0" ;
        schema:value "0.224" ;

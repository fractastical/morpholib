    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-histology-specimen-dimensionless-fold-wavelength-to-thickness-ratio-lambda-c-h0-reference> a schema:PropertyValue ;

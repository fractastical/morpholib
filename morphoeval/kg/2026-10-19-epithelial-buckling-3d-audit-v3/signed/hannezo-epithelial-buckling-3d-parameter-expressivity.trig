sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-epithelial-buckling-3d> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2016-hannezo-epithelial-buckling-3d.py L712–L749" ;
        dcterms:description "sweep_scutoid_surface_ratio: 11 ratios x 3 seeds, Spearman rho and monotonicity flag" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/2016-hannezo-epithelial-buckling-3d.py#L712-L749> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2016-hannezo-epithelial-buckling-3d.py L1920–L1940" ;
        dcterms:description "CLI overrides including Pass 3 --tube-radius and --surface-ratio one-off report" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/2016-hannezo-epithelial-buckling-3d.py#L1920-L1940> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo, Prost & Joanny (2014) PNAS & Krajnc & Ziherl (2015) PRE 3D epithelial sheet morphology (squamous-to-cuboidal-to-columnar scaling, apico-basal buckling & Gómez-Gálvez scutoid tube packing) — Parameter expressivity: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The morphospace is exercised along several axes with visible, monotone effects: Gamma_l/Gamma_a and K_sub over a 45x45 grid (L950-976), 12 tissue parameter sets, 5 perturbations, the GIF sweep of lateral tension, and (Pass 3) the surface ratio s over 11 values x 3 seeds (f_s: 0 -> 0.18 -> 0.41 -> 0.71 -> 0.88 -> 0.96 -> 1.0; L712-749), tube radius and lumen side (apical vs basal, L616-619), with CLI overrides --gamma-a/-b/-l, --k-sub, --seed, --tube-radius and --surface-ratio (L1924-1940). Deductions: the acinus region of the phase diagram is produced by switching Gamma_b from 0.75 to 0.40 whenever K_sub <= 0.011 (L963), i.e. the asymmetry that creates the acinus is injected by the plotting loop, not swept (-6); above s ~ 2.5 the scutoid fraction saturates at 1.0, and every buckled/acinar tissue lands at s_crest 2.06-3.33, so the curvature coupling produces the same f_s ~ 1.0 for all six (Panel H) - the parameter has no discriminating effect where the script applies it (-5); the jitter (0.28 d_0) and Lloyd count (2) that set the width of the f_s(s) transition are constants, not exposed or swept (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2016-hannezo-epithelial-buckling-3d.py L842–L857: All 6 buckled/acinar tissues get f_s in [0.957, 1.0] at their crest ratios; the n_buckled_with_scutoids == n_buckled check cannot fail once s_crest > ~2 <https://github.com/fractastical/morpholib/blob/654cd6fc/2016-hannezo-epithelial-buckling-3d.py#L842-L857>",
            "2016-hannezo-epithelial-buckling-3d.py L960–L966: Phase-diagram loop sets gb = 0.40 if k_s <= 0.011 else 0.75 - the acinar asymmetry is hard-wired to the K_sub axis <https://github.com/fractastical/morpholib/blob/654cd6fc/2016-hannezo-epithelial-buckling-3d.py#L960-L966>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-parameter-expressivity-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 047 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


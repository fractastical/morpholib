sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-epithelial-buckling-3d> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo, Prost & Joanny (2014) PNAS & Krajnc & Ziherl (2015) PRE 3D epithelial sheet morphology (squamous-to-cuboidal-to-columnar scaling, apico-basal buckling & Gómez-Gálvez scutoid tube packing) — Source and data traceability: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Five primary sources carry DOIs in the module header (L5-28), `paper_citations.bib` (5 entries) and the dataset README; all five dataset files are SHA-256 pinned and verified fail-closed at every run (L146-187, re-pinned after the bib and the new JSON changed); the new `scutoid_tube_reference.json` states explicitly that its values are identities/derivations and that the Gómez-Gálvez DOI was not re-resolved offline. Deductions: the 12 tissue rows and 5 perturbation rows of `epithelial_buckling_3d_reference.json` have no per-row source, figure or table pinpoint - the Gamma_norm, K_sub_norm, pressure_excess_norm, h0_obs_um and lambda_obs_um values cannot be traced to any of the cited papers from this repository (-6); the specimen reference values 4.48 / 4.45 cite 'Hannezo & Štorgel tall simple columnar epithelium' without a locator (-2); the Gómez-Gálvez DOI is carried on the strength of another slot's entry rather than resolved (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/epithelial_buckling_3d/epithelial_buckling_3d_reference.json L223–L236: Tissue row (small intestine) has Gamma_norm, K_sub_norm, pressure_excess_norm, aspect_ratio_obs, h0_obs_um, lambda_obs_um but no source/figure field <https://github.com/fractastical/morpholib/blob/654cd6fc/datasets/epithelial_buckling_3d/epithelial_buckling_3d_reference.json#L223-L236>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-source-traceability-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2016-hannezo-epithelial-buckling-3d.py L146–L187" ;
        dct:description "EXPECTED_SHA256 for 5 files incl. scutoid_tube_reference.json and the re-pinned bib; verify_dataset_integrity raises on mismatch" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/2016-hannezo-epithelial-buckling-3d.py#L146-L187> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/epithelial_buckling_3d/paper_citations.bib L1–L60" ;
        dct:description "5 BibTeX entries with DOIs: Hannezo 2014, Krajnc 2015, Štorgel 2016, Sui 2018, Gómez-Gálvez 2018" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/datasets/epithelial_buckling_3d/paper_citations.bib#L1-L60> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/epithelial_buckling_3d/README.md L14–L45" ;
        dct:description "Gómez-Gálvez added with offline-DOI caveat; scutoid_tube_reference.json documented with SHA-256 and 'identities only' statement" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/datasets/epithelial_buckling_3d/README.md#L14-L45> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 047 Pass 3 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


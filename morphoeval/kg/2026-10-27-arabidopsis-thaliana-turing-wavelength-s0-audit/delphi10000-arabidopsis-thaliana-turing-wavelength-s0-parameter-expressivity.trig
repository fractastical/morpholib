sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Arabidopsis thaliana Turing wavenumber at 111.6 µm — Parameter expressivity: 85/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "With Du held at the 111.6 µm value, Dv/Du runs through 1, 4, 6, 8.4, 12 and 20. Amplitude stays near zero below the Turing threshold and rises past d = 8.4. The wavelength panel draws λ(argmax σ) only where σ_max is positive, so the equal-diffusion control is not drawn as a fake 558 µm mode. That ratio is the knob for this slot; it is not copied from a millimetre-scale sibling." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-arabidopsis-thaliana-turing-wavelength-s0.py L325–L361" ;
        dct:description "Fixed-Du diffusivity sweep and short integrations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7dbcb5f4ae37938efcf50ef7ff5969863bb80dbe/models/2026-delphi10000-arabidopsis-thaliana-turing-wavelength-s0.py#L325-L361> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-arabidopsis-thaliana-turing-wavelength-s0.py L415–L465" ;
        dct:description "Amplitude and wavelength panels" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7dbcb5f4ae37938efcf50ef7ff5969863bb80dbe/models/2026-delphi10000-arabidopsis-thaliana-turing-wavelength-s0.py#L415-L465> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;

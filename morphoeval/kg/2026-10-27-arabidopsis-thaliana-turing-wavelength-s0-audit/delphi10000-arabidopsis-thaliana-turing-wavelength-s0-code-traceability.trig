sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Arabidopsis thaliana Turing wavenumber at 111.6 µm — Code-to-model traceability: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Jacobian, wavenumber, integrator, sweep, and specimen segmentation are separate functions. Lean theorems match the sign of the Turing numerator and the mode counts 0, 4, and 16. They do not encode the floating-point Jacobian, which is the right claim boundary for a dependency-free Lean file." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-code-traceability-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-arabidopsis-thaliana-turing-wavelength-s0.py L123–L156" ;
        dct:description "Analytic σ(k) and k_c next to the discrete symbol" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7dbcb5f4ae37938efcf50ef7ff5969863bb80dbe/models/2026-delphi10000-arabidopsis-thaliana-turing-wavelength-s0.py#L123-L156> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-arabidopsis-thaliana-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/delphi10000-arabidopsis-thaliana-turing-wavelength-s0.yaml L1–L40" ;
        dct:description "Math KG card names the law, the scale, and the Lean declarations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7dbcb5f4ae37938efcf50ef7ff5969863bb80dbe/morphoeval/math_kg_loops/delphi10000-arabidopsis-thaliana-turing-wavelength-s0.yaml#L1-L40> .

        <https://w3id.org/delphi/resource/evidence/2026-10-31-t1917-053-on-the-theory-of-transformatio-audit-thompson1917-t1917-053-5>,
        <https://w3id.org/delphi/resource/evidence/2026-10-31-t1917-053-on-the-theory-of-transformatio-audit-thompson1917-t1917-053-6>,
        <https://w3id.org/delphi/resource/evidence/2026-10-31-t1917-053-on-the-theory-of-transformatio-audit-thompson1917-t1917-053-7>,
        <https://w3id.org/delphi/resource/evidence/2026-10-31-t1917-053-on-the-theory-of-transformatio-audit-thompson1917-t1917-053-8> ;
    pk:hypothesisType "geometric — Thompson (1917) coordinate transformation between Dimorphodon and Pteranodon skulls (Fig. 387)" ;
    pk:weightOfEvidence 6.18e-01 .


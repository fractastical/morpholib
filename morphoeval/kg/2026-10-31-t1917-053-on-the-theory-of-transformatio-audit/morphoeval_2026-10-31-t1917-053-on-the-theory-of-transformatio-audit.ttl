<https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-053-overall> a pk:LLMClaimAssessment ;
    rdfs:label "Thompson (1917) Fig. 387: Dimorphodon -> Pteranodon skull coordinate transformation — MorphoEval overall 61.8/100" ;
    dct:date "2026-10-31"^^xsd:date ;
    dct:description "Pass 1 segments Fig. 387a/b skull outlines (Otsu), places orbit + 4 tip landmarks + semilandmarks, fits TPS Dimorphodon->Pteranodon. Dense-outline Procrustes reported; no null/sweep/CV yet. Overall 61.8/100 (faithfulness 54.4, reproducibility 79.1); rubric morphoeval 0.1.0; checkpoint commit 35d30f4cf; environment: python 3.12. Dimension assessments: Model fidelity to source 62, Morphological realism / specimen match 58, Parameter expressivity 40, Morphometric validation 48, Source and data traceability 86, Code-to-model traceability 78, Reproducibility package 74. Output judged: docs/media/t1917_053_on_the_theory_of_transformatio_comparison.png: rendered output of thompson/claims/t1917-053_on-the-theory-of-transformations.py at 35d30f4cf, image/png, 135226 B, 2100×750 px, artifact_sha256 8826b70c2a275dab8b278f48c05f8544842a65ef34016c8aafdd3f0a9a0f5285 (sha256 8826b70c2a275dab8b278f48c05f8544842a65ef34016c8aafdd3f0a9a0f5285), spec_fingerprint 2f185f72ad54c895b5a22263bae433c97f4c9067a6ce1e7845bfc5bc0a745ff5. Dual provenance: spec_fingerprint: 2f185f72ad54c895b5a22263bae433c97f4c9067a6ce1e7845bfc5bc0a745ff5; artifact_sha256: 8826b70c2a275dab8b278f48c05f8544842a65ef34016c8aafdd3f0a9a0f5285; input_dataset_sha256: {datasets/thompson_1917/t1917-053/dryad_4nr4cf37_metadata.json=2b2c64fd9aacd5b1..., datasets/thompson_1917/t1917-053/nie1905_dimorphodon_pteranodon_comparison.png=18604cc23a3c7635..., datasets/thompson_1917/t1917-053/ongrowthform1917thom_p756_leaf0775_fig387.jpg=faf3c2cff141abad..., datasets/thompson_1917/t1917-053/pteranodon_longiceps_ypm1177_vendored.jpg=5f3272484ee1b584..., datasets/thompson_1917/t1917-053/t1917_053_on_the_theory_of_transformatio_reference.json=9e1babca8eff80e8...}." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/overall" ;
    pk:evidenceAgainst "remediation needed: {'id': 'R1', 'item': 'Parameter sweep n_semi x lambda; shuffled-landmark null; KS on residuals'}",
        "remediation needed: {'id': 'R2', 'item': 'Specimen CV on pteranodon_longiceps_ypm1177_vendored.jpg; Jacobian no-fold on grid'}",
        "remediation needed: {'id': 'R3', 'item': 'Score dense outlines (landmark-exact TPS is tautological on anchors)'}" ;
    pk:hasScore 6.18e-01 ;
    pk:hasVerdict "mostly faithful" .


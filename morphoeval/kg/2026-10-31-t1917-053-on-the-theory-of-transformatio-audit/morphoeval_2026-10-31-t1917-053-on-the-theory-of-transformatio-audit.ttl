<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-053-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Thompson warp path — endpoints and equidistant stage displacement (E2)" ;
    dct:description "Homotopy form of Thompson's coordinate transformation between the two skull grids | Variables: a: Dimorphodon grid coordinate; b: Pteranodon image; k: stage 0..4" ;
    dct:source "Thompson (1917) On Growth and Form, Ch. XVII p. 756, Fig. 387" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/35d30f4cf/morphoeval/lean/loops/Thompson1917_T1917_053.lean>,
        <https://github.com/fractastical/morpholib/blob/35d30f4cf/thompson/claims/t1917-053_on-the-theory-of-transformations.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "phi_t(x) = (1 - t) x + t phi(x); interp4(k,a,b) = (4-k)a + kb" ;
    pk:hypothesisType "geometric — Thompson (1917) coordinate transformation between Dimorphodon and Pteranodon skulls (Fig. 387)" ;
    pk:leanDeclaration "MathOfBiology.Loop_242.interp4" ;
    pk:leanTheorem "MathOfBiology.Loop_242.interp_endpoints_and_equidistant" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-053-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Procrustes frame independence (similarity equivariance)" ;
    dct:description "Superimposition frame cannot change the predicted warp | Variables: c: scale; d: translation" ;
    dct:source "Thompson (1917) Ch. XVII; Gower (1975) Generalized Procrustes analysis" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/35d30f4cf/morphoeval/lean/loops/Thompson1917_T1917_053.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "interp4(k, ca+d, cb+d) = c interp4(k,a,b) + 4d" ;
    pk:hypothesisType "geometric — Thompson (1917) coordinate transformation between Dimorphodon and Pteranodon skulls (Fig. 387)" ;
    pk:leanTheorem "MathOfBiology.Loop_242.interp_similarity_equivariant" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-053-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "No-fold along grid coordinates (1-D order preservation)" ;
    dct:description "Intermediate grids stay orientation-preserving along each coordinate line | Variables: ordered grid coordinates a1<a2, b1<b2" ;
    dct:source "Thompson (1917) p. 756 Fig. 387 oblique grid" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/35d30f4cf/morphoeval/lean/loops/Thompson1917_T1917_053.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "a1<a2, b1<b2 => interp4(k,a1,b1) < interp4(k,a2,b2)" ;
    pk:hypothesisType "geometric — Thompson (1917) coordinate transformation between Dimorphodon and Pteranodon skulls (Fig. 387)" ;
    pk:leanTheorem "MathOfBiology.Loop_242.interp_no_fold" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-053-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Best-fit stage statistic soundness (E7)" ;
    dct:description "Projection statistic returns exact stage for perfect interpolants | Variables: landmarks A, B, D and stage k/4" ;
    dct:source "this loop (test statistic)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/35d30f4cf/morphoeval/lean/loops/Thompson1917_T1917_053.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "4<D-A,B-A> = k|B-A|^2 when D = interp4(k,A,B)" ;
    pk:hypothesisType "geometric — Thompson (1917) coordinate transformation between Dimorphodon and Pteranodon skulls (Fig. 387)" ;
    pk:leanTheorem "MathOfBiology.Loop_242.best_fit_stage_sound" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-053-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Affine shear area preservation under interpolation (E5)" ;
    dct:description "Thompson simple shear interpolates without area collapse | Variables: shear s, stage k" ;
    dct:source "Thompson (1917) Ch. XVII pp. 727-733" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/35d30f4cf/morphoeval/lean/loops/Thompson1917_T1917_053.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det((4-k)I + k[[1,s],[0,1]]) = 16" ;
    pk:hypothesisType "geometric — Thompson (1917) coordinate transformation between Dimorphodon and Pteranodon skulls (Fig. 387)" ;
    pk:leanTheorem "MathOfBiology.Loop_242.shear_interp_preserves_area" ;
    pk:leanVerified true .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-053> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-053-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-053-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Fig. 387: Dimorphodon -> Pteranodon skull coordinate transformation — Morphological realism / specimen match: 58/100" ;
        dct:date "2026-10-31"^^xsd:date ;
        dct:description "Comparison PNG from Fig. 387 segmentation; real Pteranodon photo not analysed in Pass 1." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "thompson/claims/t1917-053_on-the-theory-of-transformations.py L1–L1: Pteranodon photograph vendored but not segmented in Pass 1 <https://github.com/fractastical/morpholib/blob/35d30f4cf/thompson/claims/t1917-053_on-the-theory-of-transformations.py#L1-L1>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-053-specimen-match-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-053-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_053_on_the_theory_of_transformatio_comparison.png (generated output)" ;
        dct:description "three-panel dim / warp / pte comparison — docs/media/t1917_053_on_the_theory_of_transformatio_comparison.png: rendered output of thompson/claims/t1917-053_on-the-theory-of-transformations.py at 35d30f4cf, image/png, 135226 B, 2100×750 px, artifact_sha256 8826b70c2a275dab8b278f48c05f8544842a65ef34016c8aafdd3f0a9a0f5285 (sha256 8826b70c2a275dab8b278f48c05f8544842a65ef34016c8aafdd3f0a9a0f5285), spec_fingerprint 2f185f72ad54c895b5a22263bae433c97f4c9067a6ce1e7845bfc5bc0a745ff5" .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (builder-assessor, Pass 1)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Danio albolineatus Schnakenberg wavelength at 37 µm (Holocene, 0 Ma) — Parameter expressivity: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "δ/δ_c from 0.90 to 3.20 moves σ_max monotonically from −0.040 to 0.319 and λ from 34.4 µm to 45.3 µm. Anisotropy α = 1.8 selects only the AP-varying mode (the DV mode is stable) and produces bars. Raising the inhibitor ratio and shrinking the activator produces spots at a shorter wavelength. The control Du = Dv decays. The sweep is in the metrics JSON and on the figure." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-danio-albolineatus-turing-wavelength-s0.py L141–L204" ;
        dct:description "regime tensors and the eight-point inhibitor sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-danio-albolineatus-turing-wavelength-s0.py#L141-L204> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "datasets/danio_albolineatus_turing_wavelength_s0/danio_albolineatus_turing_wavelength_s0_metrics.json (generated output)" ;
        dct:description "sweep table and per-regime std, sigma, orientation — datasets/danio_albolineatus_turing_wavelength_s0/danio_albolineatus_turing_wavelength_s0_metrics.json: rendered output of models/2026-delphi10000-danio-albolineatus-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, application/json, 3534 B, artifact_sha256 7f10cbaaab98a96ddab9d658c9e532642f1997834397fb81a56a009583b39c13 (sha256 7f10cbaaab98a96ddab9d658c9e532642f1997834397fb81a56a009583b39c13), spec_fingerprint 4c792f240f2eddeb1b293e2ff8dcb16085a188074fadafd2384021469481a83a" .

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Danio albolineatus Schnakenberg wavelength at 37 µm (Holocene, 0 Ma) — Morphological realism / specimen match: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Shared-scale panels make the chronoseries visible: vertical bars (orientation ratio 4.56), a near-uniform pearl-danio field whose contrast-stretched twin shows the weak 37 µm mode, saturated spots, and a blank control. The GIF is the Commons photograph plus a growing inset. Computer-vision similarity to that photograph is 96.0 at 12 frames and 680 px; the full-frame cellular ablation, which removes the photograph, still scores 85.2. The deduction is that the inset is contrast-normalised per frame, so the GIF does not display the true low amplitude that the shared-scale panel does." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/danio_albolineatus_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "shared-scale regimes plus contrast-stretched pearl-danio panel — docs/media/danio_albolineatus_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-danio-albolineatus-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/png, 433658 B, 1584×1224 px, artifact_sha256 056fbfdf9ee2dc34c7d28dd6b66a73ebcc485f1cd5da66b7a5d08758805167b1 (sha256 056fbfdf9ee2dc34c7d28dd6b66a73ebcc485f1cd5da66b7a5d08758805167b1), spec_fingerprint 4c792f240f2eddeb1b293e2ff8dcb16085a188074fadafd2384021469481a83a" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/danio_albolineatus_turing_wavelength_s0_growth.gif (generated output)" ;

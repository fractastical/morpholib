        schema:value "0.35986021060553475" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-specimen-flank-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-specimen-flank-structure-tensor-coherency-reference> a schema:PropertyValue ;

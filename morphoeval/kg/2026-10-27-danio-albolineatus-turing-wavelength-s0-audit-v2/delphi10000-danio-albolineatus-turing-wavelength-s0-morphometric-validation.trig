        schema:value "0.32120558575183245" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "circle has circularity 1; an elongate danio does not" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-specimen-flank-depth-over-length> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen flank depth over length = 0.22127659574468084 bbox height / bbox width" ;
        dct:description "Photograph bbox includes the caudal fin and is not the landmark body-depth ratio, so the two numbers differ." ;
        schema:measurementTechnique "largest blue-silver connected component on the Commons photograph" ;
        schema:name "specimen flank depth over length" ;
        schema:unitText "bbox height / bbox width" ;
        schema:value "0.22127659574468084" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-specimen-flank-depth-over-length-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-specimen-flank-depth-over-length-reference> a schema:PropertyValue ;
        dct:source "thompson/portfolio/results/fishbase_morphmet.json BDmax_over_SL.obs Danio_albolineatus" ;
        schema:value "0.25003" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-specimen-flank-structure-tensor-coherency> a schema:PropertyValue,

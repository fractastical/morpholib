        schema:unitText "m" ;
        schema:value "3.421679435816217e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-successor-spot-wavelength-reference> .

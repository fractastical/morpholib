}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Danio albolineatus Schnakenberg wavelength at 37 µm (Holocene, 0 Ma) — Morphometric validation: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Specimen depth/length 0.221 versus FishBase BDmax/SL 0.250; tight ROI 0.226; circularity 0.321 versus 1; coherency 0.360 versus an isotropic null of 0. None of these equal their reference. Dispersion Pearson r = 0.9999999999999999 with RMSE 6.9e-16, which clears 0.98. All-band spectrum r = 0.9799. Unstable-band r = 0.936 (R1), reported because it is worse, not because it was tuned upward. KS distances 0.015, 0.072 and 0.153. Seed ensemble FFT wavelengths 35759, 34513, 36860 nm, CV 0.027 (R2): the weak field's FFT peak wanders by about a micrometre, while the analytic wavelength does not." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-albolineatus-activator-ks-versus-gaussian>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-dispersion-goodness-of-fit-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-equal-diffusion-control-max-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-linear-spectrum-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-pattern-amplitude-cv-albolineatus>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-predecessor-bar-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-seed-ensemble-wavelength-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-simulated-stripe-critical-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-specimen-flank-depth-over-length>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-specimen-flank-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-successor-spot-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-tight-roi-specimen-depth-over-length>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-unstable-band-stripe-spectrum-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-morphometric-validation-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-morphometric-validation-4> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-albolineatus-activator-ks-versus-gaussian> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "albolineatus activator KS versus Gaussian = 0.015217039709082836 KS distance" ;
        dct:description "Coefficient of variation of the pattern is std(u)/mean(u), stored as std_u." ;
        schema:measurementTechnique "scipy.stats.kstest of standardised final u against N(0,1)" ;
        schema:name "albolineatus activator KS versus Gaussian" ;
        schema:unitText "KS distance" ;
        schema:value "0.015217039709082836" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-albolineatus-activator-ks-versus-gaussian-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-albolineatus-activator-ks-versus-gaussian-reference> a schema:PropertyValue ;
        dct:source "equal-diffusion control field, same test" ;
        schema:value "0.09934528757039407" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-dispersion-goodness-of-fit-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion goodness-of-fit pearson r = 0.9999999999999999 Pearson r" ;
        dct:description "RMSE is reported alongside. r is computed, not assigned." ;
        schema:measurementTechnique "closed-form σ(k) versus numpy eigenvalue σ(k) at 48 wavenumbers" ;
        schema:name "dispersion goodness-of-fit pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9999999999999999" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-dispersion-goodness-of-fit-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-dispersion-goodness-of-fit-pearson-r-reference> a schema:PropertyValue ;
        dct:source "exact algebraic agreement of the quadratic formula and the matrix" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 6.945944863625148e-16 growth rate" ;
        schema:measurementTechnique "root mean square of analytic σ minus eigenvalue σ" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "growth rate" ;
        schema:value "6.945944863625148e-16" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "perfect numerical agreement" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-equal-diffusion-control-max-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control max growth rate = -0.1370382928379291 1/time" ;
        dct:description "Negative control. σ_max < 0 means the homogeneous state is stable." ;
        schema:measurementTechnique "max_k σ(k) at Du=Dv" ;
        schema:name "equal-diffusion control max growth rate" ;
        schema:unitText "1/time" ;
        schema:value "-0.1370382928379291" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-equal-diffusion-control-max-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-equal-diffusion-control-max-growth-rate-reference> a schema:PropertyValue ;
        dct:source "marginal stability" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-linear-spectrum-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "linear-spectrum pearson r = 0.9798906225916986 Pearson r" ;
        schema:measurementTechnique "log radial FFT of the integrated pearl-danio field versus exp(2 σ(k) T), all bins" ;
        schema:name "linear-spectrum pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9798906225916986" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-linear-spectrum-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-linear-spectrum-pearson-r-reference> a schema:PropertyValue ;
        dct:source "pure linear theory over the whole measured band" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-pattern-amplitude-cv-albolineatus> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pattern amplitude CV albolineatus = 0.006620850155858999 std(u)/u0" ;
        schema:measurementTechnique "coefficient of variation of the activator at T=32" ;
        schema:name "pattern amplitude CV albolineatus" ;
        schema:unitText "std(u)/u0" ;
        schema:value "0.006620850155858999" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-pattern-amplitude-cv-albolineatus-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-pattern-amplitude-cv-albolineatus-reference> a schema:PropertyValue ;
        dct:source "predecessor bar field at the same T" ;
        schema:value "0.32688748377159915" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-predecessor-bar-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "predecessor bar wavelength = 4.1798633640911064e-05 m" ;
        dct:description "Longer than the uniform-interstripe mode." ;
        schema:measurementTechnique "fastest mode of the AP inhibitor-anisotropic tensor (alpha=1.8)" ;
        schema:name "predecessor bar wavelength" ;
        schema:unitText "m" ;
        schema:value "4.1798633640911064e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-predecessor-bar-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-predecessor-bar-wavelength-reference> a schema:PropertyValue ;
        dct:source "focal pearl-danio wavelength from the same kinetics" ;
        schema:value "3.6858408006837576e-05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-seed-ensemble-wavelength-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "seed-ensemble wavelength CV = 0.02684822672882177 std/mean of FFT wavelength" ;
        dct:description "wavelengths nm=[35759, 34513, 36860]" ;
        schema:measurementTechnique "dominant FFT wavelength of the pearl-danio field at seeds 3161, 7 and 99" ;
        schema:name "seed-ensemble wavelength CV" ;
        schema:unitText "std/mean of FFT wavelength" ;
        schema:value "0.02684822672882177" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-seed-ensemble-wavelength-cv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-seed-ensemble-wavelength-cv-reference> a schema:PropertyValue ;
        dct:source "a deterministic wavelength would have CV 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-simulated-stripe-critical-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated stripe critical wavelength = 3.6858408006837576e-05 m" ;
        dct:description "Live fastest-mode wavelength. It is solved to sit on the assigned scale; the stored value is the solver output and is compared, not copied, in the self-test." ;
        schema:measurementTechnique "argmax_k σ(k) of the Schnakenberg dispersion at the solved Du, Dv" ;
        schema:name "simulated stripe critical wavelength" ;
        schema:unitText "m" ;
        schema:value "3.6858408006837576e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-simulated-stripe-critical-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-simulated-stripe-critical-wavelength-reference> a schema:PropertyValue ;
        dct:source "assigned detail scale 3.686e-05 m (37 µm)" ;
        schema:value "3.686e-05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen contour circularity = 0.32120558575183245 4πA/P^2" ;
        dct:description "Non-circular specimen metric. Value is the fish outline, reference is the circle." ;
        schema:measurementTechnique "morphological perimeter of the segmented flank" ;

    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-unstable-band-stripe-spectrum-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "unstable-band stripe spectrum pearson r = 0.9359556315507189 Pearson r" ;
        dct:description "Restricting to σ(k)>0 lowers r to about 0.936: those bins are few and the weakly grown mode is still close to the noise floor. The 0.98 goodness-of-fit is the closed-form versus eigenvalue dispersion correlation, not this band." ;
        schema:measurementTechnique "same radial FFT correlation restricted to bins with σ(k) > 0" ;
        schema:name "unstable-band stripe spectrum pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9359556315507189" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-measurement-unstable-band-stripe-spectrum-pearson-r-reference> .

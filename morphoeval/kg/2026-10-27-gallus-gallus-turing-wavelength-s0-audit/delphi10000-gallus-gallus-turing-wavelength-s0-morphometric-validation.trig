sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Gallus gallus Holocene Turing pigment-ocellus wavelength, 319.2 µm (pass 1) — Morphometric validation: 62/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "In-sample Pearson r = 0.985 versus a trend-only null, and the model wavelength 319.2 µm is reported against the (incorrectly read) painted bar. No held-out split, no KS statistic, and no CV segmentation of the plate. The scale-bar width is wrong." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-holocene-age>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-pearson-r-single-harmonic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-turing-onset-wavelength-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-holocene-age> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Holocene age = 0.0 Ma" ;
        dct:description "predecessor and successor chronospecies are absent, so Δage inside the series is undefined rather than 124.6" ;
        schema:measurementTechnique "Gallus chronoseries 1/1 assigned horizon" ;
        schema:name "Holocene age" ;
        schema:unitText "Ma" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-holocene-age-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-holocene-age-reference> a schema:PropertyValue ;
        dct:source "Illustrative Early Cretaceous avian-feather horizon outside this singleton series; not a fitted sibling parameter" ;
        schema:value "124.6" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-pearson-r-single-harmonic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial profile Pearson r (single harmonic) = 0.985 correlation" ;
        dct:description "Pass 1 in-sample r. Held-out multi-harmonic fit, RMSE detail, and KS are pass-2 remediations." ;
        schema:measurementTechnique "least squares of exp(-r/400)·cos(k r + φ) plus quadratic trend against azimuthal mean" ;
        schema:name "specimen radial profile Pearson r (single harmonic)" ;
        schema:unitText "correlation" ;
        schema:value "0.985" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-pearson-r-single-harmonic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-pearson-r-single-harmonic-reference> a schema:PropertyValue ;
        dct:source "trend-only null on the same specimen radii (no Turing mode)" ;
        schema:value "0.7551" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial profile RMSE = 5.6025 gray levels" ;
        dct:description "single plate, n = 1" ;
        schema:measurementTechnique "root mean square residual of the single-harmonic reconstruction" ;
        schema:name "specimen radial profile RMSE" ;
        schema:unitText "gray levels" ;
        schema:value "5.6025" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-rmse-reference> a schema:PropertyValue ;
        dct:source "specimen radial-profile standard deviation (null residual scale)" ;
        schema:value "32.446" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-turing-onset-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing onset wavelength lambda_c = 319.2 µm" ;
        dct:description "value is the Holocene model wavelength; reference is the inconsistent painted bar" ;
        schema:measurementTechnique "lambda_c = 2π / k_c with k_c^2 = (Dv fu + Du gv) / (2 Du Dv), γ solved for 319.2 µm" ;
        schema:name "Turing onset wavelength lambda_c" ;
        schema:unitText "µm" ;
        schema:value "319.2" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-turing-onset-wavelength-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-turing-onset-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Gallery plate painted 100 µm bar times measured ring pitch (not the biological λ_c)" ;
        schema:value "10.1955" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py L143–L171" ;
        dct:description "single_harmonic_fit Pearson and RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8be940bbc4e23235f2785d66e06db9da83a65aee/models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py#L143-L171> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py L362–L414" ;
        dct:description "measure_morphoeval references differ from values" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8be940bbc4e23235f2785d66e06db9da83a65aee/models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py#L362-L414> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "datasets/gallus_gallus_turing_wavelength_s0/gallus_gallus_turing_wavelength_s0_metrics.json (generated output)" ;
        dct:description "pass 1 metrics including the bad plate_bar_implies_um — datasets/gallus_gallus_turing_wavelength_s0/gallus_gallus_turing_wavelength_s0_metrics.json: rendered output of models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py at 8be940bbc4e23235f2785d66e06db9da83a65aee, application/json, 724 B, artifact_sha256 4b42bdb2c4a5b1a90609a3e9916cd81daf8983c1c8a3f015e4915fa414af25b2 (sha256 4b42bdb2c4a5b1a90609a3e9916cd81daf8983c1c8a3f015e4915fa414af25b2), spec_fingerprint d79e485299e3508a55f35819cf41b353933badb10f650ee2ade00ae23887b314" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second provider on this pass)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0500781102>,
            <https://doi.org/10.1098/rspb.2001.1896>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1371/journal.pbio.1001028> .
    <https://doi.org/10.1073/pnas.0500781102> dct:title "Molecular evidence for an activator-inhibitor mechanism in development of embryonic feather branching" .
    <https://doi.org/10.1098/rspb.2001.1896> dct:title "Reaction-diffusion models of within-feather pigmentation patterning" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1371/journal.pbio.1001028> dct:title "Cryptic patterning of avian skin confers a developmental facility for loss of neck feathering" .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Gallus gallus Holocene Turing pigment-ocellus wavelength, 319.2 µm (pass 1) — Code-to-model traceability: 80/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "gamma_for_wavelength and critical_wavelength_um are the onset formula. Lean theorems pin the onset gap, the singleton chronoseries, and the six-wavelength patch. The radial renderer is a weakly nonlinear reduction, not a line-by-line transcription of Prum & Williamson's growing-feather geometry." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-code-traceability-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py L84–L104" ;
        dct:description "onset wavenumber mapped to λ_c" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8be940bbc4e23235f2785d66e06db9da83a65aee/models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py#L84-L104> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/delphi10000-gallus-gallus-turing-wavelength-s0.yaml L20–L60" ;
        dct:description "equation records with lean and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8be940bbc4e23235f2785d66e06db9da83a65aee/morphoeval/math_kg_loops/delphi10000-gallus-gallus-turing-wavelength-s0.yaml#L20-L60> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second provider on this pass)" ;
        dct:identifier "grok-4.7" ;

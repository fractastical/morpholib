sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Gallus gallus Holocene Turing pigment-ocellus wavelength, 319.2 µm (pass 1) — Model fidelity to source: 76/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The onset formula k_c^2 = (Dv fu + Du gv) / (2 Du Dv) is implemented and γ is solved so λ_c is 319.2 µm. Pass 1 does not integrate the PDE, so the selected wavelength is analytical rather than emergent from a time-stepper." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py L62–L104" ;
        dct:description "Schnakenberg slopes, diffusion margin, gamma_for_wavelength, critical_wavelength_um" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8be940bbc4e23235f2785d66e06db9da83a65aee/models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py#L62-L104> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3228_gallus_gallus_turing_wavelength_s0.lean L47–L51" ;
        dct:description "turing_onset_gap" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8be940bbc4e23235f2785d66e06db9da83a65aee/morphoeval/lean/loops/Loop_3228_gallus_gallus_turing_wavelength_s0.lean#L47-L51> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second provider on this pass)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


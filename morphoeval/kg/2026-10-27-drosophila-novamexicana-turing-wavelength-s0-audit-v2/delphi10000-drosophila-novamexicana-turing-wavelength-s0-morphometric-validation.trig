sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila novamexicana 1.9 µm Turing wavelength (Holocene, 0 Ma) — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Specimen-feature Pearson r=0.991 (reference threshold 0.90, not the measured value), RMSE=0.0093, KS=0.119 (reference baseline 0.25). Dispersion Pearson r=1.0. Specimen coherency 0.796 versus simulation coherency 0.785. Focal coupled-field FFT peak is 16 px (envelope), distinct from the linear 12 px wavelength, and both are reported." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-dispersion-relation-pearson-r-analytic-vs-eigvals>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-gamma-sweep-wavelength-drop-from-0-64-to-2-60>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-predecessor-stripe-wavelength-in-pixels-at-gamma-1-79>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-published-gif-frame-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-specimen-cuticle-optical-density-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-specimen-luminance-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-specimen-radial-fft-and-orientation-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-stripe-wavelength-selected-on-the-novamexicana-patch>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-dispersion-relation-pearson-r-analytic-vs-eigvals> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion-relation Pearson r (analytic vs eigvals) = 1.0 Pearson r" ;
        dct:description "RMSE=1.723e-15; trace=-0.2000; det=1.0000; σ_max=0.3062; equal-diffusion σ_max=-0.1035" ;
        schema:measurementTechnique "16 wavenumbers, closed-form σ(k) versus numpy.linalg.eigvals" ;
        schema:name "dispersion-relation Pearson r (analytic vs eigvals)" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-dispersion-relation-pearson-r-analytic-vs-eigvals-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-dispersion-relation-pearson-r-analytic-vs-eigvals-reference> a schema:PropertyValue ;
        dct:source "slot gate for goodness of fit; the achieved r is higher" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-gamma-sweep-wavelength-drop-from-0-64-to-2-60> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "gamma-sweep wavelength drop from γ=0.64 to γ=2.60 = 1.1973 µm" ;
        dct:description "monotonic decreasing in γ: 0.64→2.376, 1.0→1.901, 1.79→1.421, 2.25→1.267, 2.6→1.179" ;
        schema:measurementTechnique "λ(γ)=1.901/sqrt(γ) at the sweep endpoints" ;
        schema:name "gamma-sweep wavelength drop from γ=0.64 to γ=2.60" ;
        schema:unitText "µm" ;
        schema:value "1.1973" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-gamma-sweep-wavelength-drop-from-0-64-to-2-60-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-gamma-sweep-wavelength-drop-from-0-64-to-2-60-reference> a schema:PropertyValue ;
        dct:source "a 1 µm drop would already be visible; the reconstructed drop is larger" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-predecessor-stripe-wavelength-in-pixels-at-gamma-1-79> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "predecessor stripe wavelength in pixels at gamma 1.79 = 9.0 px" ;
        schema:measurementTechnique "radial-FFT peak of the mojavensis-gamma Schnakenberg run" ;
        schema:name "predecessor stripe wavelength in pixels at gamma 1.79" ;
        schema:unitText "px" ;
        schema:value "9.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-predecessor-stripe-wavelength-in-pixels-at-gamma-1-79-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-predecessor-stripe-wavelength-in-pixels-at-gamma-1-79-reference> a schema:PropertyValue ;
        dct:source "Murray scaling prediction 12/sqrt(1.79) pixels on the same grid" ;
        schema:value "8.9692" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-published-gif-frame-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "published GIF frame count = 12 frames" ;
        dct:description "640x480" ;
        schema:measurementTechnique "PIL n_frames of docs/media/drosophila_novamexicana_turing_wavelength_s0_growth.gif" ;
        schema:name "published GIF frame count" ;
        schema:unitText "frames" ;
        schema:value "12" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-published-gif-frame-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-published-gif-frame-count-reference> a schema:PropertyValue ;
        dct:source "image-fitness minimum is 6 frames; the file is required to carry more" ;
        schema:value "6" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-specimen-cuticle-optical-density-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen cuticle optical-density foreground fraction = 0.7117 fraction" ;
        schema:measurementTechnique "fraction of vendored pixels darker than the 72nd percentile luminance" ;
        schema:name "specimen cuticle optical-density foreground fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.7117" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-specimen-cuticle-optical-density-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-specimen-cuticle-optical-density-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "neutral occupancy baseline" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-specimen-luminance-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen luminance KS statistic = 0.1173 KS D" ;
        schema:measurementTechnique "two-sample KS on interior luminance of the vendored field and the GIF last frame" ;
        schema:name "specimen luminance KS statistic" ;
        schema:unitText "KS D" ;
        schema:value "0.1173" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-specimen-luminance-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-specimen-luminance-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "a large-difference baseline, not the measured D" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-specimen-radial-fft-and-orientation-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial-FFT and orientation Pearson r = 0.9909 Pearson r" ;
        dct:description "RMSE=0.00938405617440115, KS=0.11733333333333329" ;
        schema:measurementTechnique "12-bin Sobel orientation plus 22-bin radial FFT, specimen crop vs GIF last-frame crop" ;
        schema:name "specimen radial-FFT and orientation Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9909" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-specimen-radial-fft-and-orientation-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-specimen-radial-fft-and-orientation-pearson-r-reference> a schema:PropertyValue ;
        dct:source "pre-registered fit threshold for this slot; not the measured correlation" ;
        schema:value "0.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.7956 coherency" ;
        dct:description "If this value equals its reference the image-fitness gate treats the pair as circular; the two crops differ." ;
        schema:measurementTechnique "mean structure-tensor coherency on the vendored optical-density field" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.7956" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "isotropic-texture baseline of 0.5; the vendored field is more coherent" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-stripe-wavelength-selected-on-the-novamexicana-patch> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stripe wavelength selected on the novamexicana patch = 2.5347e-06 m" ;
        dct:description "reference is the predecessor, not a copy of the focal value" ;
        schema:measurementTechnique "dominant radial-FFT wavelength of the simulated activator, times dx" ;
        schema:name "stripe wavelength selected on the novamexicana patch" ;
        schema:unitText "m" ;
        schema:value "2.5347e-06" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-stripe-wavelength-selected-on-the-novamexicana-patch-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-measurement-stripe-wavelength-selected-on-the-novamexicana-patch-reference> a schema:PropertyValue ;
        dct:source "predecessor D. mojavensis reconstruction at the same 1.9 µm question, λ = 1.901 µm / sqrt(1.79)" ;
        schema:value "1.4209e-06" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;

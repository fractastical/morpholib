<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila novamexicana 1.9 µm Turing wavelength (Holocene, 0 Ma) — Model fidelity to source: 91/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The Jacobian, critical wavenumber and equal-diffusion control match Turing 1952 and Schnakenberg 1979, and self-test locks λ_c to 1.901 µm. Pass 2 runs the focal simulation with specimen_production, so a(x) carries the cuticle field inside the PDE. The published frame is still an amplitude-0.16 imprint of that activator on the vendored image, so this is not a claim that the photograph is the raw field. Neighbor gamma values remain a reconstruction." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity-3>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity-4> ;
    pk:hasScore 9.1e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila novamexicana 1.9 µm Turing wavelength (Holocene, 0 Ma) — Morphometric validation: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Specimen-feature Pearson r=0.991 (reference threshold 0.90, not the measured value), RMSE=0.0093, KS=0.119 (reference baseline 0.25). Dispersion Pearson r=1.0. Specimen coherency 0.796 versus simulation coherency 0.785. Focal coupled-field FFT peak is 16 px (envelope), distinct from the linear 12 px wavelength, and both are reported." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;

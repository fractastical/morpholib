sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila novamexicana 1.9 µm Turing wavelength (Holocene, 0 Ma) — Model fidelity to source: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The Jacobian, critical wavenumber and equal-diffusion control match Turing 1952 and Schnakenberg 1979, and self-test locks λ_c to 1.901 µm. Pass 2 runs the focal simulation with specimen_production, so a(x) carries the cuticle field inside the PDE. The published frame is still an amplitude-0.16 imprint of that activator on the vendored image, so this is not a claim that the photograph is the raw field. Neighbor gamma values remain a reconstruction." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity-4> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-novamexicana-turing-wavelength-s0.py L160–L171" ;
        dct:description "specimen_production a(x)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-novamexicana-turing-wavelength-s0.py#L160-L171> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-novamexicana-turing-wavelength-s0.py L437–L445" ;
        dct:description "fitted mode passes a_field into simulate; ablation stays homogeneous" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-novamexicana-turing-wavelength-s0.py#L437-L445> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3195_drosophila_novamexicana_turing_wavelength_s0.lean L16–L45" ;
        dct:description "four theorems, 0 sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3195_drosophila_novamexicana_turing_wavelength_s0.lean#L16-L45> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-novamexicana-turing-wavelength-s0-model-fidelity-4> a pk:EvidenceItem ;

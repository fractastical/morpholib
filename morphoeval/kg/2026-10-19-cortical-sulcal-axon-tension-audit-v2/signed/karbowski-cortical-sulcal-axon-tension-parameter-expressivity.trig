sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-karbowski-cortical-sulcal-axon-tension> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2020-karbowski-cortical-sulcal-axon-tension.py L563–L668" ;
        dcterms:description "12-species mammalian universal collapse and 4-regime axonal tension ablation/hyper-tension sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py#L563-L668> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2020-karbowski-cortical-sulcal-axon-tension.py L1321–L1351" ;
        dcterms:description "CLI physical parameter overrides wired into mechanical solver and figure rendering" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py#L1321-L1351> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 090 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Van Essen (1997), Hilgetag & Barbas (2006) & Mota & Herculano-Houzel (2015) cortico-cortical axonal tension and cortical folding — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Spans 4 macaque/primate connectivity pairs (V1-V2, MT-MST, BA46-BA9, weak sulcal fundus, L484-516), 3 laminar zones (gyral crown, sulcal wall, sulcal fundus, L519-560), 12 mammalian species spanning 6 clades (Mouse to Dolphin and Human, L563-632), 4 axonal tension perturbation regimes (lissencephalic, deafferented k_a=0, wild-type k_a=1.35, hyper-tension k_a=2.40, L635-668), and exposes `--axon-stiffness`, `--bending-modulus`, `--towed-gamma`, `--growth-g`, and `--seed` CLI overrides (L1321-1351)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-parameter-expressivity-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


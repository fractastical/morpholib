sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-karbowski-cortical-sulcal-axon-tension> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Van Essen (1997), Hilgetag & Barbas (2006) & Mota & Herculano-Houzel (2015) cortico-cortical axonal tension and cortical folding — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements Van Essen's (1997) chord-vs-arc axonal wiring economy, Hilgetag & Barbas's (2006) isometric cortical column volume conservation V_col = A_surf * h, Mota & Herculano-Houzel's (2015) universal scaling law A_T * sqrt(h) = k * A_E^(5/4) (L144-175), and an L-BFGS-B energy minimizer coupling cortical ribbon bending E_bend, tangential growth g, and viscoelastic cortico-cortical axonal tension T_ij = k_a C_ij (d_ij - L_{0,ij})_+ with towed-axon adaptation dL_0/dt = gamma_a(T_ij - tau_0)_+ (`relax_cortical_axonal_tension_ribbon`, L233-481) plus callosotomy/ablation (k_a=0), hyper-tension (k_a=2.40), and lissencephalic controls (L635-668), backed by 3 machine-checked Lean 4 theorems in `Loop_090_cortical_sulcal_axon_tension.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2020-karbowski-cortical-sulcal-axon-tension.py L144–L175" ;
        dct:description "Exact chord-vs-arc wiring saving, isometric laminar thickness, and MHH universal scaling laws" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py#L144-L175> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2020-karbowski-cortical-sulcal-axon-tension.py L233–L481" ;
        dct:description "Coupled 2D coronal cortical ribbon + viscoelastic axonal tension L-BFGS-B solver with towed-axon adaptation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py#L233-L481> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_090_cortical_sulcal_axon_tension.lean L19–L100" ;
        dct:description "3 machine-checked Lean 4 theorems for Van Essen wiring economy, Hilgetag-Barbas laminar volume conservation, and MHH scaling (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_090_cortical_sulcal_axon_tension.lean#L19-L100> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 090 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/90> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/385313a0>,
            <https://doi.org/10.1093/cercor/bhi068>,
            <https://doi.org/10.1103/PhysRevLett.86.3674>,
            <https://doi.org/10.1126/science.aaa9101>,
            <https://doi.org/10.1371/journal.pcbi.0020022> .
    <https://doi.org/10.1038/385313a0> dct:date "1997"^^xsd:gYear ;
        dct:title "A tension-based theory of morphogenesis and compact wiring in the central nervous system" .
    <https://doi.org/10.1093/cercor/bhi068> dct:date "2005"^^xsd:gYear ;
        dct:title "A Morphogenetic Model for the Development of Cortical Convolutions" .
    <https://doi.org/10.1103/PhysRevLett.86.3674> dct:date "2001"^^xsd:gYear ;
        dct:title "Optimal wiring principle and plateaus in the degree of separation between cortical areas" .
    <https://doi.org/10.1126/science.aaa9101> dct:date "2015"^^xsd:gYear ;
        dct:title "Cortical folding scales universally with surface area and thickness, not number of neurons" .
    <https://doi.org/10.1371/journal.pcbi.0020022> dct:date "2006"^^xsd:gYear ;
        dct:title "Role of Mechanical Factors in the Morphology of the Primate Cerebral Cortex" .
}


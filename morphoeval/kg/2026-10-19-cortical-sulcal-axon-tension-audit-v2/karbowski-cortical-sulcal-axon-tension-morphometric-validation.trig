        schema:measurementTechnique "Isometric cortical column volume conservation h_gyrus / h_fundus = lambda_{t,fundus} / lambda_{t,gyrus} (RMSE=0.0026 mm across crown/wall/fundus)" ;
        schema:name "Hilgetag & Barbas (2006) gyral-to-sulcal cortical thickness ratio h_gyrus / h_fundus" ;
        schema:unitText "thickness ratio" ;
        schema:value "1.6154" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-hilgetag-barbas-2006-gyral-to-sulcal-cortical-thickness-ratio-h-gyrus-h-fundus-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-hilgetag-barbas-2006-gyral-to-sulcal-cortical-thickness-ratio-h-gyrus-h-fundus-reference> a schema:PropertyValue ;
        dct:source "Hilgetag & Barbas (2006) PLoS Comput. Biol. 2(3):e22 Fig. 2-5 (h_gyrus=3.14 mm, h_fundus=1.94 mm)" ;
        schema:value "1.6186" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-lissencephalic-zero-tension-zero-growth-negative-control-gi-k-a-0-g-1-00> a schema:PropertyValue,
            pk:EvidenceItem ;

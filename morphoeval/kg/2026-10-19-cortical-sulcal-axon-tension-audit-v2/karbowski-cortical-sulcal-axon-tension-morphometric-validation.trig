        dct:description "h_gyrus/h_fundus = 1.0000, wiring ratio = 1.0000" ;
        schema:measurementTechnique "Coronal Gyrification Index in unfolded baseline control (k_a=0.0, g=1.00)" ;
        schema:name "Lissencephalic zero-tension zero-growth negative control GI (k_a = 0, g = 1.00)" ;
        schema:unitText "P_pial / P_hull" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-lissencephalic-zero-tension-zero-growth-negative-control-gi-k-a-0-g-1-00-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-lissencephalic-zero-tension-zero-growth-negative-control-gi-k-a-0-g-1-00-reference> a schema:PropertyValue ;
        dct:source "Van Essen (1997) Nature & Mota & Herculano-Houzel (2015) Science lissencephalic limit (GI = 1.0)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-van-essen-1997-macaque-v1-v2-trans-gyral-chord-to-arc-wiring-length-ratio> a schema:PropertyValue,

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-karbowski-cortical-sulcal-axon-tension> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Van Essen (1997), Hilgetag & Barbas (2006) & Mota & Herculano-Houzel (2015) cortico-cortical axonal tension and cortical folding — Morphometric validation: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1146-1249) computes 9 reference-anchored morphometrics with statistical tests and uncertainty: 12-species MHH log-log slope alpha = 1.2567 ± 0.0038 (ref 1.25, r = 0.9999, p = 1.8e-20), 12-species 3D GI Pearson r = 0.9990 (p = 7.4e-15, RMSE = 0.036), Hilgetag-Barbas gyral/sulcal thickness ratio 1.6154 (ref 1.6186, RMSE = 0.0024 mm), Macaque V1-V2 chord/arc ratio 0.4324 (ref 0.4324), wild-type relaxed GI 2.5506 (ref 2.48), wild-type gyral-axon alignment r = 0.9958 (ref 0.912 vs ablation 0.080), lissencephalic control GI = 1.0000 (ref 1.0), specimen segmented GI = 2.8115 (ref 2.48), and specimen h_gyrus/h_fundus = 1.5793 (ref 1.6186)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-12-species-mammalian-3d-gyrification-index-correlation-mota-herculano-houzel-2015>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-12-species-mammalian-universal-folding-scaling-exponent-alpha-mota-herculano-houzel-2015>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-coronal-human-brain-specimen-gyral-to-sulcal-cortical-ribbon-thickness-ratio-h-gyrus-h-fundus>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-coronal-human-brain-specimen-segmented-gyrification-index-gi-specimen-coronal-cortex-axon-tracts-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-hilgetag-barbas-2006-gyral-to-sulcal-cortical-thickness-ratio-h-gyrus-h-fundus>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-lissencephalic-zero-tension-zero-growth-negative-control-gi-k-a-0-g-1-00>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-van-essen-1997-macaque-v1-v2-trans-gyral-chord-to-arc-wiring-length-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-wild-type-l-bfgs-b-relaxed-coronal-gyrification-index-gi-sim-k-a-1-35>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-wild-type-vs-axonal-ablation-callosotomy-k-a-0-gyral-axon-alignment-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-12-species-mammalian-3d-gyrification-index-correlation-mota-herculano-houzel-2015> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-species mammalian 3D Gyrification Index correlation (Mota & Herculano-Houzel 2015) = 0.9972 Pearson r" ;
        dct:description "RMSE_GI = 0.0761, p = 1.36e-12" ;
        schema:measurementTechnique "Linear correlation of predicted GI = k * h^(-1/2) * A_E^(1/4) vs observed 3D GI across 12 mammalian species (p=1.36e-12, RMSE=0.0761)" ;
        schema:name "12-species mammalian 3D Gyrification Index correlation (Mota & Herculano-Houzel 2015)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9972" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-12-species-mammalian-3d-gyrification-index-correlation-mota-herculano-houzel-2015-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-12-species-mammalian-3d-gyrification-index-correlation-mota-herculano-houzel-2015-reference> a schema:PropertyValue ;
        dct:source "Mota & Herculano-Houzel (2015) Science 349(6243):74-77 Fig. 2-3" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-12-species-mammalian-universal-folding-scaling-exponent-alpha-mota-herculano-houzel-2015> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-species mammalian universal folding scaling exponent alpha (Mota & Herculano-Houzel 2015) = 1.2567 power-law slope" ;
        dct:description "log10 RMSE = 0.0139, GI Pearson r = 0.9972" ;
        schema:measurementTechnique "OLS slope of log10(A_T * sqrt(h)) vs log10(A_E) across 12 mammalian species (SE ± 0.0047, r=0.9999, p=1.38e-20)" ;
        schema:name "12-species mammalian universal folding scaling exponent alpha (Mota & Herculano-Houzel 2015)" ;
        schema:unitText "power-law slope" ;
        schema:value "1.2567" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-12-species-mammalian-universal-folding-scaling-exponent-alpha-mota-herculano-houzel-2015-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-12-species-mammalian-universal-folding-scaling-exponent-alpha-mota-herculano-houzel-2015-reference> a schema:PropertyValue ;
        dct:source "Mota & Herculano-Houzel (2015) Science 349(6243):74-77 Eq. 3-5 & Fig. 2 (alpha = 5/4 = 1.25)" ;
        schema:value "1.25" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-coronal-human-brain-specimen-gyral-to-sulcal-cortical-ribbon-thickness-ratio-h-gyrus-h-fundus> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Coronal human brain specimen gyral-to-sulcal cortical ribbon thickness ratio h_gyrus / h_fundus = 1.5793 thickness ratio" ;
        dct:description "h_gyrus_px=14.56 px, h_fundus_px=9.22 px" ;
        schema:measurementTechnique "Ratio of 2D Euclidean distance transform cortical ribbon thickness at outward gyral crowns (14.56 px) vs inward sulcal fundi (9.22 px)" ;
        schema:name "Coronal human brain specimen gyral-to-sulcal cortical ribbon thickness ratio h_gyrus / h_fundus" ;
        schema:unitText "thickness ratio" ;
        schema:value "1.5793" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-coronal-human-brain-specimen-gyral-to-sulcal-cortical-ribbon-thickness-ratio-h-gyrus-h-fundus-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-coronal-human-brain-specimen-gyral-to-sulcal-cortical-ribbon-thickness-ratio-h-gyrus-h-fundus-reference> a schema:PropertyValue ;
        dct:source "Hilgetag & Barbas (2006) PLoS Comput. Biol. 2(3):e22 gyral crown vs sulcal fundus thickness ratio" ;
        schema:value "1.6186" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-coronal-human-brain-specimen-segmented-gyrification-index-gi-specimen-coronal-cortex-axon-tracts-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Coronal human brain specimen segmented Gyrification Index GI_specimen (coronal_cortex_axon_tracts_specimen.jpg) = 2.8115 P_pial / P_hull" ;
        dct:description "detected 52 sulcal fundi in ROI" ;
        schema:measurementTechnique "Segmented pial + sulcal cleft perimeter (4923.0 px) over convex hull perimeter (1751.0 px) across n=52 sulcal fundi in ROI" ;
        schema:name "Coronal human brain specimen segmented Gyrification Index GI_specimen (coronal_cortex_axon_tracts_specimen.jpg)" ;
        schema:unitText "P_pial / P_hull" ;
        schema:value "2.8115" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-coronal-human-brain-specimen-segmented-gyrification-index-gi-specimen-coronal-cortex-axon-tracts-specimen-jpg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-coronal-human-brain-specimen-segmented-gyrification-index-gi-specimen-coronal-cortex-axon-tracts-specimen-jpg-reference> a schema:PropertyValue ;
        dct:source "Van Essen (1997) Nature & Zilles et al. (1988) human coronal cerebral cortex GI (2.48 ± 0.12)" ;
        schema:value "2.48" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-hilgetag-barbas-2006-gyral-to-sulcal-cortical-thickness-ratio-h-gyrus-h-fundus> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hilgetag & Barbas (2006) gyral-to-sulcal cortical thickness ratio h_gyrus / h_fundus = 1.6154 thickness ratio" ;

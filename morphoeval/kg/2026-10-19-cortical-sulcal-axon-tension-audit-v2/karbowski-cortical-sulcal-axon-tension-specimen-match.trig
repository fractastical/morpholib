sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-karbowski-cortical-sulcal-axon-tension> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Van Essen (1997), Hilgetag & Barbas (2006) & Mota & Herculano-Houzel (2015) cortico-cortical axonal tension and cortical folding — Morphological realism / specimen match: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY 2.5 coronal human cerebral hemisphere specimen `datasets/cortical_sulcal_axon_tension/coronal_cortex_axon_tracts_specimen.jpg`, segments the white-matter axonal core, cortical gray-matter ribbon, convex hull P_hull, 52 sulcal fundi (GI_specimen = 2.8115), and empirical gyral-to-sulcal thickness ratio h_gyrus / h_fundus = 1.5793 vs ref 1.6186 (`segment_coronal_brain_specimen`, L671-757), while matching all 12 mammalian species in Mota & Herculano-Houzel (2015) (r = 0.9999 for log scaling, r = 0.9990 for 3D GI)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-specimen-match-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2020-karbowski-cortical-sulcal-axon-tension.py L671–L757" ;
        dct:description "Coronal brain specimen segmentation extracting white-matter core, 52 sulcal fundi, GI=2.8115, and h_gyrus/h_fundus=1.5793" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py#L671-L757> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/cortical_sulcal_axon_tension_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing L-BFGS-B axonal-tension ribbon, ablation controls, laminar dichotomy, 12-species MHH collapse, and specimen segmentation — docs/media/cortical_sulcal_axon_tension_comparison.png: rendered output of 2020-karbowski-cortical-sulcal-axon-tension.py at 8871db0, image/png, 878251 B, 2096×1419 px, artifact_sha256 9f110bc763cffc5cb708f6d89ace1d784b09467af21328f9b8cee0f42d8db6fd (sha256 9f110bc763cffc5cb708f6d89ace1d784b09467af21328f9b8cee0f42d8db6fd), spec_fingerprint 84c495a5d45894646a6161c31d7690d7bf05b858d5926075a0791c491fd2603b" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 090 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/90> ;

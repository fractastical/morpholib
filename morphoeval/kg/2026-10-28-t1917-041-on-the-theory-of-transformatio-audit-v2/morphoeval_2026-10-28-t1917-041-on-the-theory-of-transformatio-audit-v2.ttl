        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-repro-package>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-source-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-specimen-match> ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-041-on-the-theory-of-transformatio-audit-v2-thompson1917-t1917-041-1>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-041-on-the-theory-of-transformatio-audit-v2-thompson1917-t1917-041-2>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-041-on-the-theory-of-transformatio-audit-v2-thompson1917-t1917-041-3>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-041-on-the-theory-of-transformatio-audit-v2-thompson1917-t1917-041-4>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-041-on-the-theory-of-transformatio-audit-v2-thompson1917-t1917-041-5>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-041-on-the-theory-of-transformatio-audit-v2-thompson1917-t1917-041-6>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-041-on-the-theory-of-transformatio-audit-v2-thompson1917-t1917-041-7>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-041-on-the-theory-of-transformatio-audit-v2-thompson1917-t1917-041-8> ;
    pk:hypothesisType "Thompson1917_RadialPolarLeafTransformation" ;
    pk:weightOfEvidence 8.34e-01 .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-041> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) radial-cordate leaf transformation claim T1917-041 (Pass 2) — MorphoEval overall 83.4/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Pass 2 adds k-regime sweeps, shuffle ablation, Begonia rex CV segmentation (r, RMSE, KS), Thompson IA page ink digitization, and writes datasets/thompson_1917/t1917-041/result.json. Synthetic pairwise R² remains high; real Begonia fit is moderate (~55% R²); crude figure digitization is weak (~6% R²), yielding a mixed empirical verdict on the 1917 leaf claim. Overall 83.4/100 (faithfulness 81.9, reproducibility 87.1); rubric morphoeval 0.1.0; checkpoint commit f1d96f32ba3f00517c53e9cd007634306cc8d4f4; environment: python 3.12. Dimension assessments: Model fidelity to source 88, Morphological realism / specimen match 76, Parameter expressivity 84, Morphometric validation 82, Source and data traceability 90, Code-to-model traceability 85, Reproducibility package 86. Output judged: docs/media/t1917_041_on_the_theory_of_transformatio_comparison.png: rendered output of thompson/claims/t1917-041_on-the-theory-of-transformations.py at f1d96f32ba3f00517c53e9cd007634306cc8d4f4, image/png, 393749 B, 1680×1120 px, artifact_sha256 793aa09dbe676a861b2f5465a6bd496f476cedd2f783241aa14fb38c8bd6b19d (sha256 793aa09dbe676a861b2f5465a6bd496f476cedd2f783241aa14fb38c8bd6b19d), spec_fingerprint 2874108b4c92e842aade03eb1a10b668c06797f3484cd9de80e369cfd15118ee. Dual provenance: spec_fingerprint: 2874108b4c92e842aade03eb1a10b668c06797f3484cd9de80e369cfd15118ee; artifact_sha256: 793aa09dbe676a861b2f5465a6bd496f476cedd2f783241aa14fb38c8bd6b19d; input_dataset_sha256: {datasets/thompson_1917/t1917-041/t1917_041_on_the_theory_of_transformatio_reference.json=557e1ed2a1934ad1...}. Supersedes audit: 2026-10-28-t1917-041-on-the-theory-of-transformatio-audit." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/composer-2.5> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:hasScore "0.834"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/model/composer-2.5> a pk:Model ;
        rdfs:label "Composer 2.5 (MorphoEval Loop thompson1917-t1917-041 Pass 2 Remediation)" ;
        dct:identifier "composer-2.5" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0002-0000-0001> .
}


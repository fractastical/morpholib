    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) radial-cordate leaf transformation claim T1917-041 (Pass 2) — Parameter expressivity: 84/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Sweeps k across 9 values per pair; shuffle ablation collapses R² from ~99% to ~4%." ;

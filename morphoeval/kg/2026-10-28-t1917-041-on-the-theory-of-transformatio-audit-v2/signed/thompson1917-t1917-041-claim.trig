sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-041> a pk:Claim ;
        rdfs:label "Thompson (1917) radial-cordate leaf transformation claim T1917-041 (Pass 2) faithfully reproduces Leaf outline morphometrics (lanceolate / ovate / cordate; Begonia instance) morphology" ;
        dcterms:description "The simulation script(s) thompson/claims/t1917-041_on-the-theory-of-transformations.py implement the cited source model as published and produce forms that match real Leaf outline morphometrics (lanceolate / ovate / cordate; Begonia instance) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-041_on-the-theory-of-transformations.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-041_on-the-theory-of-transformations.py; output: docs/media/t1917_041_on_the_theory_of_transformatio_comparison.png; organism: Leaf outline morphometrics (lanceolate / ovate / cordate; Begonia instance); environment: python 3.12; other sources: On Growth and Form <https://archive.org/details/ongrowthform1917thom>; phenomenon_size: 103 µm (0.0001027 m, log10=-3.988 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 103 µm to 15.6 cm): 103 µm:morpho-menelaus-bioelectric-polarity, 363 µm:morpho-menelaus-vertex-packing, 3.5 mm:morpho-menelaus-turing-wavelength, 1.2 cm:morpho-menelaus-clock-wavefront, 2.2 cm:morpho-menelaus-morphogen-condensation, 2.8 cm:morpho-menelaus-flux-canalization, 3.0 cm:morpho-menelaus-elastic-buckling, 3.6 cm:morpho-menelaus-branching-tree" .

    <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-041_on-the-theory-of-transformations.py> a schema:SoftwareSourceCode ;
        rdfs:label "thompson/claims/t1917-041_on-the-theory-of-transformations.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}


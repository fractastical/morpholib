sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-041> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-morphometric-validation> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-041-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) radial-cordate leaf transformation claim T1917-041 (Pass 2) — Morphometric validation: 82/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "measure_morphoeval exports median R², Begonia r/RMSE/KS, and Thompson digitized R²." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/composer-2.5> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-measurement-ablation-r2-true-minus-shuffled-pct>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-measurement-begonia-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-measurement-begonia-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-measurement-begonia-r2-radial-8p-pct>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-measurement-begonia-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-measurement-median-r2-box-pct>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-measurement-median-r2-radial-8p-pct>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-measurement-thompson-fig359-r2-radial-8p-pct>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-morphometric-validation-1> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-measurement-ablation-r2-true-minus-shuffled-pct> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_r2_true_minus_shuffled_pct = 95.8567 percent" ;
        schema:measurementTechnique "Landmark shuffle ablation on lanceolate→ovate pair" ;
        schema:name "ablation_r2_true_minus_shuffled_pct" ;
        schema:unitText "percent" ;
        schema:value "95.8567" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-measurement-begonia-ks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "begonia_ks = 0.234466 1" ;
        schema:measurementTechnique "KS on residual distance CDF" ;
        schema:name "begonia_ks" ;
        schema:unitText "1" ;
        schema:value "0.234466" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-measurement-begonia-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "begonia_pearson_r = 0.739657 1" ;
        schema:measurementTechnique "Pearson r on coordinates" ;
        schema:name "begonia_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.739657" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-measurement-begonia-r2-radial-8p-pct> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "begonia_r2_radial_8p_pct = 54.7093 percent" ;
        schema:measurementTechnique "Begonia rex CV outline vs cordate template" ;
        schema:name "begonia_r2_radial_8p_pct" ;
        schema:unitText "percent" ;
        schema:value "54.7093" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-measurement-begonia-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "begonia_rmse = 0.559161 norm" ;
        schema:measurementTechnique "RMSE after Procrustes registration" ;
        schema:name "begonia_rmse" ;
        schema:unitText "norm" ;
        schema:value "0.559161" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-measurement-median-r2-box-pct> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "median_r2_box_pct = 97.319 percent" ;
        schema:measurementTechnique "Similarity (4p) null on same pairs" ;
        schema:name "median_r2_box_pct" ;
        schema:unitText "percent" ;
        schema:value "97.319" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-measurement-median-r2-radial-8p-pct> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "median_r2_radial_8p_pct = 99.416 percent" ;
        schema:measurementTechnique "8p radial-cordate least squares on registered synthetic leaf pairs" ;
        schema:name "median_r2_radial_8p_pct" ;
        schema:unitText "percent" ;
        schema:value "99.416" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-measurement-thompson-fig359-r2-radial-8p-pct> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "thompson_fig359_r2_radial_8p_pct = 6.2372 percent" ;
        schema:measurementTechnique "Digitized IA page 752 ink outline vs ovate template" ;
        schema:name "thompson_fig359_r2_radial_8p_pct" ;
        schema:unitText "percent" ;
        schema:value "6.2372" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-041-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-041_on-the-theory-of-transformations.py L310–L370" ;
        dcterms:description "list-based measure_morphoeval contract" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/thompson/claims/t1917-041_on-the-theory-of-transformations.py#L310-L370> .

    <https://w3id.org/delphi/resource/model/composer-2.5> a pk:Model ;
        rdfs:label "Composer 2.5 (MorphoEval Loop thompson1917-t1917-041 Pass 2 Remediation)" ;
        dcterms:identifier "composer-2.5" ;
        prov:actedOnBehalfOf orcid:0000-0002-0000-0001 .
}


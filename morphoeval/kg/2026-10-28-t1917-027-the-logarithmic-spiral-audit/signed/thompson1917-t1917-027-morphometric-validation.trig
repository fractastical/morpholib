sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-027> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-027-morphometric-validation> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-027-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-027 — logarithmic spiral claim validation — Morphometric validation: 55/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "measure_morphoeval returns pearson r, W, and RMSE with literature anchors, but Pass 1 omits AICc/KS in exported measurements and Conus discrimination is weak." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/composer-2.5> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-027_the-logarithmic-spiral.py L134–L175: compare_models computes AICc/KS but not exported in Pass 1 CSV <https://github.com/fractastical/morpholib/blob/f1d96f32/thompson/claims/t1917-027_the-logarithmic-spiral.py#L134-L175>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-conus-log-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-log-vs-archimedean-aicc-delta>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-nautilus-log-rmse-px>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-nautilus-log-spiral-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-nautilus-whorl-expansion-w>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-morphometric-validation-1> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-conus-log-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "conus_log_pearson_r = 0.8495571551122201 dimensionless" ;
        schema:measurementTechnique "Same pipeline on conus_textile_shell.jpg" ;
        schema:name "conus_log_pearson_r" ;
        schema:unitText "dimensionless" ;
        schema:value "0.8495571551122201" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-conus-log-pearson-r-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-conus-log-pearson-r-reference> a schema:PropertyValue ;
        dcterms:source "Gastropod spire log-spiral literature (Raup 1966)" ;
        schema:value "0.85" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-log-vs-archimedean-aicc-delta> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "log_vs_archimedean_aicc_delta = -12.443798422278007 AICc" ;
        schema:measurementTechnique "AICc comparison on same nautilus edge samples" ;
        schema:name "log_vs_archimedean_aicc_delta" ;
        schema:unitText "AICc" ;
        schema:value "-12.443798422278007" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-log-vs-archimedean-aicc-delta-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-log-vs-archimedean-aicc-delta-reference> a schema:PropertyValue ;
        dcterms:source "ΔAICc>0 favours log spiral (Burnham & Anderson)" ;
        schema:value "0.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-nautilus-log-rmse-px> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nautilus_log_rmse_px = 35.334657903727425 px" ;
        schema:measurementTechnique "RMSE of log-spiral prediction on segmented radii" ;
        schema:name "nautilus_log_rmse_px" ;
        schema:unitText "px" ;
        schema:value "35.334657903727425" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-nautilus-log-spiral-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nautilus_log_spiral_pearson_r = 0.9604055170477023 dimensionless" ;
        schema:measurementTechnique "Linear regression of ln r vs θ on CV-segmented outer edge" ;
        schema:name "nautilus_log_spiral_pearson_r" ;
        schema:unitText "dimensionless" ;
        schema:value "0.9604055170477023" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-nautilus-log-spiral-pearson-r-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-nautilus-log-spiral-pearson-r-reference> a schema:PropertyValue ;
        dcterms:source "Thompson (1917) Ch. XI equiangular spiral expectation" ;
        schema:value "0.9" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-nautilus-whorl-expansion-w> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nautilus_whorl_expansion_W = 9.266184976340558 ratio" ;
        schema:measurementTechnique "W = exp(2πk) from log-spiral fit" ;
        schema:name "nautilus_whorl_expansion_W" ;
        schema:unitText "ratio" ;
        schema:value "9.266184976340558" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-nautilus-whorl-expansion-w-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-measurement-nautilus-whorl-expansion-w-reference> a schema:PropertyValue ;
        dcterms:source "Typical nautiloid W ~2.5-3.5 (Raup 1966 morphospace)" ;
        schema:value "3.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-027-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-027_the-logarithmic-spiral.py L318–L373" ;
        dcterms:description "measure_morphoeval hook with reference values" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f1d96f32/thompson/claims/t1917-027_the-logarithmic-spiral.py#L318-L373> .

    <https://w3id.org/delphi/resource/model/composer-2.5> a pk:Model ;
        rdfs:label "Composer 2.5 (primary cloud loop thompson1917-t1917-027)" ;
        dcterms:identifier "composer-2.5" ;
        prov:actedOnBehalfOf orcid:0000-0002-1825-0097 ;
        foaf:homepage <https://cursor.com> .
}


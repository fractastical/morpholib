<https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-027> a pk:Claim ;
    rdfs:label "Thompson (1917) T1917-027 — logarithmic spiral claim validation (Mollusc shell (Nautilus pompilius; Conus textile secondary))",
        "Thompson (1917) T1917-027 — logarithmic spiral claim validation faithfully reproduces Mollusc shell (Nautilus pompilius; Conus textile secondary) morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-027-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-027-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-027-3> ;
    dct:description "The simulation script(s) thompson/claims/t1917-027_the-logarithmic-spiral.py, docs/media/t1917_027_the_logarithmic_spiral_growth.gif, datasets/thompson_1917/t1917-027/result.json implement the cited source model as published and produce forms that match real Mollusc shell (Nautilus pompilius; Conus textile secondary) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/datasets/thompson_1917/t1917-027/result.json>,
        <https://github.com/fractastical/morpholib/blob/main/docs/media/t1917_027_the_logarithmic_spiral_growth.gif>,
        <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-027_the-logarithmic-spiral.py> ;
    schema:about "Mollusc shell (Nautilus pompilius; Conus textile secondary)" ;
    schema:additionalProperty "does_not_claim: Exact match to Thompson's own 1917 figure digitisation or 3D CT centreline; refutation of Raup's qualified counterclaim",
        "reconstructed_in_script: Polar edge sampling, ln r vs θ regression, Archimedean and power-spiral comparators, W = exp(2πk)",
        "reported_in_source: Thompson (1917) Ch. XI: gnomonic shell growth preserves form; spire centreline is an equiangular (logarithmic) spiral r ∝ exp(kθ)",
        "transfer_boundary: 2D photograph projection ≠ perfect apical section; Raup (1966) adds D, T and generating-curve shape beyond Thompson's single k" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-027_the-logarithmic-spiral.py, https://github.com/fractastical/morpholib/blob/main/docs/media/t1917_027_the_logarithmic_spiral_growth.gif, https://github.com/fractastical/morpholib/blob/main/datasets/thompson_1917/t1917-027/result.json; output: docs/media/t1917_027_the_logarithmic_spiral_comparison.png; organism: Mollusc shell (Nautilus pompilius; Conus textile secondary); environment: python 3.12.3, numpy 2.x, scipy 1.18.1, matplotlib 3.x, Pillow 12.x; claim_boundary: [reported_in_source: Thompson (1917) Ch. XI: gnomonic shell growth preserves form; spire centreline is an equiangular (logarithmic) spiral r ∝ exp(kθ); reconstructed_in_script: Polar edge sampling, ln r vs θ regression, Archimedean and power-spiral comparators, W = exp(2πk); transfer_boundary: 2D photograph projection ≠ perfect apical section; Raup (1966) adds D, T and generating-curve shape beyond Thompson's single k; does_not_claim: Exact match to Thompson's own 1917 figure digitisation or 3D CT centreline; refutation of Raup's qualified counterclaim]; other sources: On Growth and Form <https://archive.org/details/ongrowthform1917thom>, Pu - Nautilus pompilius - 10 <https://commons.wikimedia.org/wiki/File:Pu_-_Nautilus_pompilius_-_10.jpg>" ;
    pk:derivedFromPaper <https://doi.org/10.2307/1301992> ;
    pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-027-code-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-027-model-fidelity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-027-morphometric-validation>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-027-overall>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-027-parameter-expressivity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-027-repro-package>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-027-source-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-027-specimen-match> ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-027-the-logarithmic-spiral-audit-thompson1917-t1917-027-1>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-027-the-logarithmic-spiral-audit-thompson1917-t1917-027-2>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-027-the-logarithmic-spiral-audit-thompson1917-t1917-027-3>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-027-the-logarithmic-spiral-audit-thompson1917-t1917-027-4>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-027-the-logarithmic-spiral-audit-thompson1917-t1917-027-5> ;
    pk:hypothesisType "quantitative-geometric" ;
    pk:weightOfEvidence 6.79e-01 .


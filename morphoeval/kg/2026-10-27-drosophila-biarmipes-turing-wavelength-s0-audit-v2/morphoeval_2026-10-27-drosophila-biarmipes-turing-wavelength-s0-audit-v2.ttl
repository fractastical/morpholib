<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-biarmipes-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Jacobian trace at the biarmipes steady state" ;
    dct:description "Well-mixed steady state is not a source at the 1.5 µm detail scale | Variables: f_u = 0.800, g_v = -1.000 at (a, b) = (0.10, 0.90)" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; spot CRE Gompel 2005 DOI:10.1038/nature03235" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-biarmipes-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3177_drosophila_biarmipes_turing_wavelength_s0.lean#L23-L24> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "tr J = f_u + g_v = -0.2 < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0168-9525(03)00194-X>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1038/nature04597>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3177.jacobianTraceMilli" ;
    pk:leanTheorem "MathOfBiology.Loop_3177.jacobian_trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-biarmipes-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Jacobian determinant" ;
    dct:description "Both eigenvalues of J are stable before diffusion is introduced | Variables: f_u, f_v, g_u, g_v in thousandths" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-biarmipes-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3177_drosophila_biarmipes_turing_wavelength_s0.lean#L30-L31> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det J = f_u g_v - f_v g_u = 1 > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0168-9525(03)00194-X>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1038/nature04597>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3177.jacobianDetMicro" ;
    pk:leanTheorem "MathOfBiology.Loop_3177.jacobian_det_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-biarmipes-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing diffusion inequality at 1.486 µm" ;
    dct:description "Diffusion-driven instability selects the 1.5 µm pigment wavelength | Variables: D_u = 0.010351 µm², D_v = 0.372636 µm²" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-biarmipes-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3177_drosophila_biarmipes_turing_wavelength_s0.lean#L37-L40> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(D_v f_u + D_u g_v)^2 > 4 D_u D_v det J" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0168-9525(03)00194-X>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1038/nature04597>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3177.turing_diffusion_inequality" ;
    pk:leanTheorem "MathOfBiology.Loop_3177.turing_diffusion_inequality" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-biarmipes-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Twelve wavelengths on the 17.832 µm patch" ;
    dct:description "Mode count at the detail scale (intensive wavelength, extensive count) | Variables: L = 17.832 µm, lambda_c = 1.486 µm" ;
    dct:source "Kondo & Miura 2010 DOI:10.1126/science.1179047" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-biarmipes-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3177_drosophila_biarmipes_turing_wavelength_s0.lean#L44-L46> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = L / lambda_c = 17832 / 1486 = 12" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0168-9525(03)00194-X>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1038/nature04597>,
        <https://doi.org/10.1098/rstb.1952.0012>,

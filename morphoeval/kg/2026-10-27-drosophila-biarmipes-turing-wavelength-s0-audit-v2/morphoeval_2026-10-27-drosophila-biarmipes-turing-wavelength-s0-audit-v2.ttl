    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "f_u(bipectinata) = 33/37 > 4/5 = f_u(biarmipes)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0168-9525(03)00194-X>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1038/nature04597>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3177.successor_autocatalysis_stronger" ;
    pk:leanTheorem "MathOfBiology.Loop_3177.successor_autocatalysis_stronger" ;
    pk:leanVerified true .


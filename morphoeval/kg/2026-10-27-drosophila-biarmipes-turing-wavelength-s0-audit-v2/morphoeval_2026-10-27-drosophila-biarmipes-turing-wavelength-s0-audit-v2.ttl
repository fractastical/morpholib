<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-biarmipes-turing-wavelength-s0-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Successor autocatalysis is stronger" ;
    dct:description "At 1.5 µm the successor change is a shorter wavelength, not a new organ | Variables: bipectinata (a, b) = (0.06, 1.05); biarmipes (0.10, 0.90); shared D" ;
    dct:source "Prud'homme et al. 2006 DOI:10.1038/nature04597" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-biarmipes-turing-wavelength-s0.py>,

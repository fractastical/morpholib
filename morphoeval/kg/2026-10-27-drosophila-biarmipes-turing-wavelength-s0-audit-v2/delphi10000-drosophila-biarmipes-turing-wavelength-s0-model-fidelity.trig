sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila biarmipes Turing wavelength at 1.5 µm (detail s0, 0 Ma) — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Unchanged from the dispersion implementation that Pass 1 checked (trace -0.2, det 1, Turing inequality open, six Lean theorems, 0 sorry). Pass 2 adds an explicit statement that the law being audited is the linear critical wavelength, with the nonlinear centroid reported beside it rather than substituted for it." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-biarmipes-turing-wavelength-s0.py L107–L152" ;
        dct:description "Jacobian, sigma(k), lambda_c, Turing margin" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-biarmipes-turing-wavelength-s0.py#L107-L152> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-biarmipes-turing-wavelength-s0.py L656–L676" ;
        dct:description "128² rerun; centroid 1.358 µm vs linear 1.486 µm" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-biarmipes-turing-wavelength-s0.py#L656-L676> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3177_drosophila_biarmipes_turing_wavelength_s0.lean L23–L61" ;
        dct:description "six decide theorems, 0 sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3177_drosophila_biarmipes_turing_wavelength_s0.lean#L23-L61> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, Pass 2 after the 128² grid check)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


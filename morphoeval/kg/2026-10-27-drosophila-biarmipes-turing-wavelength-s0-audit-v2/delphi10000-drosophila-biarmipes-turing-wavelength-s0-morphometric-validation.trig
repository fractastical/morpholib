sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila biarmipes Turing wavelength at 1.5 µm (detail s0, 0 Ma) — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r = 0.9998, RMSE = 0.0037, KS = 0.083 on linearised modes. Specimen Otsu foreground 0.176 vs render 0.233; coherency 0.690 vs 0.464; central ROI coherency 0.607. Seed CV of the 96² centroid is 0.015. Pass 2 adds the 128² centroid 1.358 µm (reference 1.486 µm, not a copied scalar)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-b-sweep-delta-lambda-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-ks-statistic-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-linear-critical-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-nonlinear-centroid-wavelength-128-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-nonlinear-centroid-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-pearson-r-sigma-numerical-vs-analytical>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-predecessor-ananassae-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-rmse-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-simulation-melanin-field-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-specimen-central-roi-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-specimen-otsu-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-successor-bipectinata-lambda-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-wavelength-cv-across-seeds>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-b-sweep-delta-lambda-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "b_sweep_delta_lambda_um = 1.015507 µm" ;
        dct:description "lambda_shortens=True; sigma_max peaks at b=0.60" ;
        schema:measurementTechnique "lambda(b_min) - lambda(b_max) across the activator sweep; positive means wavelength shortens as b rises" ;
        schema:name "b_sweep_delta_lambda_um" ;
        schema:unitText "µm" ;
        schema:value "1.015507" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-b-sweep-delta-lambda-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-b-sweep-delta-lambda-um-reference> a schema:PropertyValue ;
        dct:source "null of no expressivity" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_diffusion_control_sigma_max = -0.101656 1/time" ;
        dct:description "saturated equal-diffusion field std=0.0006 (pattern absent)" ;
        schema:measurementTechnique "ablation: Du = Dv = D_u, sigma_max of the focal Jacobian. Control must stay negative" ;
        schema:name "equal_diffusion_control_sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.101656" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> a schema:PropertyValue ;
        dct:source "Turing threshold" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-ks-statistic-sigma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ks_statistic_sigma = 0.083333 1" ;
        dct:description "KS distance; small is a closer match" ;
        schema:measurementTechnique "two-sample KS statistic between analytical and numerical sigma samples" ;
        schema:name "ks_statistic_sigma" ;
        schema:unitText "1" ;
        schema:value "0.083333" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-ks-statistic-sigma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-ks-statistic-sigma-reference> a schema:PropertyValue ;
        dct:source "identical distributions" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-linear-critical-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "linear_critical_wavelength_um = 1.486308 µm" ;
        dct:description "value is the solved critical wavelength, reference is the rounded 1.5 µm label" ;
        schema:measurementTechnique "argmax of analytical sigma(k); Du, Dv frozen for the 1.486 µm catalog scale" ;
        schema:name "linear_critical_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "1.486308" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-linear-critical-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-linear-critical-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "Delphi detail tier label 1.5 µm; solved lambda_c is the 1.486 µm catalog SI length" ;
        schema:value "1.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-nonlinear-centroid-wavelength-128-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nonlinear_centroid_wavelength_128_um = 1.358087 µm" ;
        dct:description "Pass 2 grid-locking check; value is not forced equal to the reference" ;
        schema:measurementTechnique "power-weighted Fourier centroid on a 128² grid, seed 3177, 3000 steps; CV of the discretization check vs the 96² run" ;
        schema:name "nonlinear_centroid_wavelength_128_um" ;
        schema:unitText "µm" ;
        schema:value "1.358087" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-nonlinear-centroid-wavelength-128-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-biarmipes-turing-wavelength-s0-measurement-nonlinear-centroid-wavelength-128-um-reference> a schema:PropertyValue ;
        dct:source "linear lambda_c = 1.486 µm" ;
        schema:value "1.486" .

<https://w3id.org/delphi/resource/math-law/murray-mammalian-coat-markings-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Thomas (1975) / Murray (1981) Homogeneous Steady-State Reservoir Flux Balance" ;
    dct:description "Pins the exact linear conservation relation v_0 = b - (a - u_0)/α reducing the 2D equilibrium intersection to a 1D root in u_0 | Variables: u_0, v_0: homogeneous steady-state substrate and co-substrate concentrations; a, b: reservoir concentrations; α: relative co-substrate influx; h(u,v): immobilized uricase reaction flux" ;
    dct:source "Murray (1981) J. Theor. Biol. 88(1):161-199 Eqs. (4)-(7); Thomas (1975) Biochimie 57:499-507" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L160-L254>,
        <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L20-L39> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def thomas_react_f (a u h : Int) : Int := (a - u) - h
def thomas_react_g (alpha_b_minus_v h : Int) : Int := alpha_b_minus_v - h
theorem thomas_steady_state_flux_balance (a u alpha_b_minus_v h : Int)
    (hf : thomas_react_f a u h = 0) (hg : thomas_react_g alpha_b_minus_v h = 0) :
    a - u = alpha_b_minus_v ∧ a - u = h := by
  unfold thomas_react_f at hf; unfold thomas_react_g at hg; omega
"""^^pk:lean4 ;
    skos:notation "f(u_0, v_0) = a - u_0 - h(u_0, v_0) = 0 ∧ g(u_0, v_0) = α(b - v_0) - h(u_0, v_0) = 0 ⟹ a - u_0 = α(b - v_0) = ρ u_0 v_0 / (1 + u_0 + K u_0^2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BFb0082865>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/S0300-9084(75)80312-9>,
        <https://doi.org/10.1017/S0962492913000056>,
        <https://doi.org/10.1038/scientificamerican0388-80>,
        <https://doi.org/10.1080/10586458.1993.10504266>,
        <https://doi.org/10.1103/PhysRevE.74.011914>,
        <https://doi.org/10.1644/900.1> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
    pk:leanDeclaration "MathOfBiology.Loop_003.thomas_react_f" ;
    pk:leanTheorem "MathOfBiology.Loop_003.thomas_steady_state_flux_balance" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/murray-mammalian-coat-markings-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Thomas Substrate-Inhibition Autocatalysis Threshold (K u_0^2 > 1)" ;
    dct:description "Proves that non-inhibitory Michaelis-Menten kinetics (K=0) cannot self-activate (f_u < 0), whereas substrate inhibition K u_0^2 > 1 creates positive feedback f_u > 0 at Murray's Table 1 regime | Variables: K: substrate-inhibition constant; u_0, v_0: steady-state concentrations; ρ: maximum enzyme velocity; f_u = ∂f/∂u: self-activation Jacobian entry" ;
    dct:source "Murray (1981) J. Theor. Biol. 88(1):161-199 Section 2 Eqs. (8)-(14), Table 1" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L160-L254>,
        <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L46-L66> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def thomas_fu_scaled_num (denom_sq rho_v0 K_u0_sq : Int) : Int :=
  rho_v0 * (K_u0_sq - 1) - denom_sq
theorem thomas_substrate_inhibition_autocatalysis (denom_sq rho_v0 : Int)
    (hd : denom_sq ≥ 1) (hrv : rho_v0 ≥ 1) :
    thomas_fu_scaled_num denom_sq rho_v0 0 ≤ -2 ∧
    thomas_fu_scaled_num 441 172 10 = 1107 := by
  unfold thomas_fu_scaled_num; omega
"""^^pk:lean4 ;
    skos:notation "(1 + u_0 + K u_0^2)^2 f_u = ρ v_0 (K u_0^2 - 1) - (1 + u_0 + K u_0^2)^2 > 0  ⟹  K u_0^2 > 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BFb0082865>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/S0300-9084(75)80312-9>,
        <https://doi.org/10.1017/S0962492913000056>,
        <https://doi.org/10.1038/scientificamerican0388-80>,
        <https://doi.org/10.1080/10586458.1993.10504266>,
        <https://doi.org/10.1103/PhysRevE.74.011914>,
        <https://doi.org/10.1644/900.1> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
    pk:leanDeclaration "MathOfBiology.Loop_003.thomas_fu_scaled_num" ;
    pk:leanTheorem "MathOfBiology.Loop_003.thomas_substrate_inhibition_autocatalysis" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/murray-mammalian-coat-markings-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Murray (1981) Conical Tail Circumferential-to-Axial Eigenmode Exclusion Theorem" ;
    dct:description "Proves why a tapered mammalian tail transitions from 2D spots (m ≥ 1) at the broad proximal base to 1D transverse rings (m = 0) at the narrow distal tip, and never from rings at the base to spots at the tip | Variables: r(x): local tapered tail radius; L: tail length; n: axial mode number; m: circumferential mode number; [k_-^2, k_+^2]: unstable Turing wavenumber band" ;
    dct:source "Murray (1981) J. Theor. Biol. 88(1):161-199 Section 4 Eqs. (26)-(32), Figs. 9-12; Murray (1988) Sci. Am. 258(3):80-87" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L255-L330>,
        <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L73-L98> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def in_turing_band_r2 (q_min_10 q_max_10 q_ax_10 m r : Nat) : Bool :=
  decide (q_min_10 * r * r ≤ q_ax_10 * r * r + 10 * m * m ∧
          q_ax_10 * r * r + 10 * m * m ≤ q_max_10 * r * r)
theorem murray_conical_tail_spot_to_ring_transition :
    in_turing_band_r2 5 9 7 0 3 = true ∧
    in_turing_band_r2 5 9 7 1 3 = true ∧
    in_turing_band_r2 5 9 7 0 1 = true ∧
    in_turing_band_r2 5 9 7 1 1 = false ∧
    in_turing_band_r2 5 9 7 2 1 = false := by decide
"""^^pk:lean4 ;
    skos:notation "k_{n,m}^2(r) = (n π / L)^2 + (m / r)^2 ∈ [k_-^2 / γ, k_+^2 / γ];  r < r_crit = m √(γ / k_+^2) ⟹ m ≥ 1 damped, m = 0 rings unstable" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BFb0082865>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/S0300-9084(75)80312-9>,
        <https://doi.org/10.1017/S0962492913000056>,
        <https://doi.org/10.1038/scientificamerican0388-80>,
        <https://doi.org/10.1080/10586458.1993.10504266>,
        <https://doi.org/10.1103/PhysRevE.74.011914>,
        <https://doi.org/10.1644/900.1> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
    pk:leanDeclaration "MathOfBiology.Loop_003.in_turing_band_r2" ;
    pk:leanTheorem "MathOfBiology.Loop_003.murray_conical_tail_spot_to_ring_transition" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/murray-mammalian-coat-markings-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "P1 Surface-FEM Cotangent Laplace-Beltrami: Constants in the Kernel & Discrete Mass Conservation" ;
    dct:description "Guarantees the homogeneous Thomas steady state (u_0, v_0) is an exact discrete equilibrium on the curved felid body and that the IMEX surface diffusion step is conservative (zero-flux natural boundary), so every pattern seen on the FEM body is a Turing instability and not a discretisation source term | Variables: V, F: vertices and triangles of the body-of-revolution surface mesh; w_ij: half cotangent edge weight; K: stiffness matrix; M: lumped (Voronoi-area) mass matrix; Δ_S ≈ -M^{-1} K: discrete Laplace-Beltrami" ;
    dct:source "Dziuk (1988) Lecture Notes in Math. 1357:142-155; Pinkall & Polthier (1993) Exp. Math. 2(1):15-36; Dziuk & Elliott (2013) Acta Numerica 22:289-396" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L712-L781>,
        <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L110-L128> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def fem_cot_row (w_ij w_ik u_i u_j u_k : Int) : Int :=
  w_ij * (u_i - u_j) + w_ik * (u_i - u_k)
theorem fem_cotangent_laplacian_conserves_mass (w_ab w_bc w_ca u_a u_b u_c c : Int) :
    fem_cot_row w_ab w_ca c c c = 0 ∧
    fem_cot_row w_ab w_ca u_a u_b u_c
      + fem_cot_row w_ab w_bc u_b u_a u_c
      + fem_cot_row w_ca w_bc u_c u_a u_b = 0 := by
  unfold fem_cot_row
  simp only [Int.mul_sub]
  omega
"""^^pk:lean4 ;
    skos:notation "(K u)_i = Σ_j w_ij (u_i - u_j), w_ij = (cot α_ij + cot β_ij)/2  ⟹  K 1 = 0 ∧ 1ᵀ K u = 0  ⟹  Σ_i M_i u_i^{n+1} = Σ_i M_i u_i^n for (M + (dt/γ) K) u^{n+1} = M u^n" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BFb0082865>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/S0300-9084(75)80312-9>,
        <https://doi.org/10.1017/S0962492913000056>,
        <https://doi.org/10.1038/scientificamerican0388-80>,
        <https://doi.org/10.1080/10586458.1993.10504266>,
        <https://doi.org/10.1103/PhysRevE.74.011914>,
        <https://doi.org/10.1644/900.1> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
    pk:leanDeclaration "MathOfBiology.Loop_003.fem_cot_row" ;
    pk:leanTheorem "MathOfBiology.Loop_003.fem_cotangent_laplacian_conserves_mass" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/murray-mammalian-coat-markings-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Murray (1981) Full Circumferential Exclusion Radius r_excl = 1/k_+ (n = 0 Longitudinal-Stripe Mode)" ;
    dct:description "Corrects the Pass 2 fastest-mode criterion r_crit (which only tests q_ax = k_c): between r_excl and r_crit a tail still carries long-axial-wavelength m ≥ 1 modes, so pure transverse rings appear only where the circumference 2πr drops below λ_+. Numerically twinned by the implicit conical solver (ring zone starts at x_excl/L) and the FEM body (tail_exclusion_fraction vs measured ring onset) | Variables: r(x): local tail radius; m: circumferential mode number; n = 0: axially uniform (Neumann-admissible) mode; k_+: upper edge of the unstable band; λ_+ = 2π/k_+: shortest unstable wavelength; r_excl: radius below which only m = 0 rings remain" ;
    dct:source "Murray (1981) J. Theor. Biol. 88(1):161-199 Section 4 Eqs. (26)-(32); Murray (1988) Sci. Am. 258(3):80-87" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L255-L330>,
        <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L150-L157> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """theorem murray_tail_full_exclusion_requires_circumference_below_lambda_plus :
    in_turing_band_r2 5 9 0 1 1 = false ∧
    in_turing_band_r2 5 9 7 0 1 = true ∧
    in_turing_band_r2 5 9 0 3 4 = true ∧
    in_turing_band_r2 5 9 0 3 3 = false ∧
    in_turing_band_r2 5 9 0 1 2 = false ∧
    in_turing_band_r2 5 9 4 1 2 = true := by
  decide
"""^^pk:lean4 ;
    skos:notation "k_{0,m}^2(r) = (m / r)^2 ≤ k_+^2 / γ unstable  ⟹  every m ≥ 1 excluded iff r < r_excl = m √(γ) / k_+ < r_crit = m √(γ / (k_+^2 - k_c^2));  2π r_excl = λ_+" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BFb0082865>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/S0300-9084(75)80312-9>,
        <https://doi.org/10.1017/S0962492913000056>,
        <https://doi.org/10.1038/scientificamerican0388-80>,
        <https://doi.org/10.1080/10586458.1993.10504266>,
        <https://doi.org/10.1103/PhysRevE.74.011914>,
        <https://doi.org/10.1644/900.1> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
    pk:leanDeclaration "MathOfBiology.Loop_003.in_turing_band_r2" ;
    pk:leanTheorem "MathOfBiology.Loop_003.murray_tail_full_exclusion_requires_circumference_below_lambda_plus" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/murray-mammalian-coat-markings-1> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Thomas (1975) / Murray (1981) Homogeneous Steady-State Reservoir Flux Balance" ;
    dct:description "Pins the exact linear conservation relation v_0 = b - (a - u_0)/α reducing the 2D equilibrium intersection to a 1D root in u_0 | Variables: u_0, v_0: homogeneous steady-state substrate and co-substrate concentrations; a, b: reservoir concentrations; α: relative co-substrate influx; h(u,v): immobilized uricase reaction flux" ;
    dct:source "Murray (1981) J. Theor. Biol. 88(1):161-199 Eqs. (4)-(7); Thomas (1975) Biochimie 57:499-507" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L160-L254>,
        <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L20-L39> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def thomas_react_f (a u h : Int) : Int := (a - u) - h
def thomas_react_g (alpha_b_minus_v h : Int) : Int := alpha_b_minus_v - h
theorem thomas_steady_state_flux_balance (a u alpha_b_minus_v h : Int)
    (hf : thomas_react_f a u h = 0) (hg : thomas_react_g alpha_b_minus_v h = 0) :
    a - u = alpha_b_minus_v ∧ a - u = h := by
  unfold thomas_react_f at hf; unfold thomas_react_g at hg; omega
"""^^pk1:lean4 ;
    skos:notation "f(u_0, v_0) = a - u_0 - h(u_0, v_0) = 0 ∧ g(u_0, v_0) = α(b - v_0) - h(u_0, v_0) = 0 ⟹ a - u_0 = α(b - v_0) = ρ u_0 v_0 / (1 + u_0 + K u_0^2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BFb0082865>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/S0300-9084(75)80312-9>,
        <https://doi.org/10.1017/S0962492913000056>,
        <https://doi.org/10.1038/scientificamerican0388-80>,
        <https://doi.org/10.1080/10586458.1993.10504266>,
        <https://doi.org/10.1103/PhysRevE.74.011914>,
        <https://doi.org/10.1644/900.1> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
    pk1:leanDeclaration "MathOfBiology.Loop_003.thomas_react_f" ;
    pk1:leanTheorem "MathOfBiology.Loop_003.thomas_steady_state_flux_balance" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/murray-mammalian-coat-markings-2> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Thomas Substrate-Inhibition Autocatalysis Threshold (K u_0^2 > 1)" ;
    dct:description "Proves that non-inhibitory Michaelis-Menten kinetics (K=0) cannot self-activate (f_u < 0), whereas substrate inhibition K u_0^2 > 1 creates positive feedback f_u > 0 at Murray's Table 1 regime | Variables: K: substrate-inhibition constant; u_0, v_0: steady-state concentrations; ρ: maximum enzyme velocity; f_u = ∂f/∂u: self-activation Jacobian entry" ;
    dct:source "Murray (1981) J. Theor. Biol. 88(1):161-199 Section 2 Eqs. (8)-(14), Table 1" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L160-L254>,
        <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L46-L66> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def thomas_fu_scaled_num (denom_sq rho_v0 K_u0_sq : Int) : Int :=
  rho_v0 * (K_u0_sq - 1) - denom_sq
theorem thomas_substrate_inhibition_autocatalysis (denom_sq rho_v0 : Int)
    (hd : denom_sq ≥ 1) (hrv : rho_v0 ≥ 1) :
    thomas_fu_scaled_num denom_sq rho_v0 0 ≤ -2 ∧
    thomas_fu_scaled_num 441 172 10 = 1107 := by
  unfold thomas_fu_scaled_num; omega
"""^^pk1:lean4 ;
    skos:notation "(1 + u_0 + K u_0^2)^2 f_u = ρ v_0 (K u_0^2 - 1) - (1 + u_0 + K u_0^2)^2 > 0  ⟹  K u_0^2 > 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BFb0082865>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/S0300-9084(75)80312-9>,
        <https://doi.org/10.1017/S0962492913000056>,
        <https://doi.org/10.1038/scientificamerican0388-80>,
        <https://doi.org/10.1080/10586458.1993.10504266>,
        <https://doi.org/10.1103/PhysRevE.74.011914>,
        <https://doi.org/10.1644/900.1> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
    pk1:leanDeclaration "MathOfBiology.Loop_003.thomas_fu_scaled_num" ;
    pk1:leanTheorem "MathOfBiology.Loop_003.thomas_substrate_inhibition_autocatalysis" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/murray-mammalian-coat-markings-3> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Murray (1981) Conical Tail Circumferential-to-Axial Eigenmode Exclusion Theorem" ;
    dct:description "Proves why a tapered mammalian tail transitions from 2D spots (m ≥ 1) at the broad proximal base to 1D transverse rings (m = 0) at the narrow distal tip, and never from rings at the base to spots at the tip | Variables: r(x): local tapered tail radius; L: tail length; n: axial mode number; m: circumferential mode number; [k_-^2, k_+^2]: unstable Turing wavenumber band" ;
    dct:source "Murray (1981) J. Theor. Biol. 88(1):161-199 Section 4 Eqs. (26)-(32), Figs. 9-12; Murray (1988) Sci. Am. 258(3):80-87" ;

    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """theorem murray_tail_full_exclusion_requires_circumference_below_lambda_plus :
    in_turing_band_r2 5 9 0 1 1 = false ∧
    in_turing_band_r2 5 9 7 0 1 = true ∧
    in_turing_band_r2 5 9 0 3 4 = true ∧
    in_turing_band_r2 5 9 0 3 3 = false ∧
    in_turing_band_r2 5 9 0 1 2 = false ∧
    in_turing_band_r2 5 9 4 1 2 = true := by
  decide
"""^^pk1:lean4 ;
    skos:notation "k_{0,m}^2(r) = (m / r)^2 ≤ k_+^2 / γ unstable  ⟹  every m ≥ 1 excluded iff r < r_excl = m √(γ) / k_+ < r_crit = m √(γ / (k_+^2 - k_c^2));  2π r_excl = λ_+" ;

        <https://doi.org/10.1016/S0300-9084(75)80312-9>,
        <https://doi.org/10.1017/S0962492913000056>,
        <https://doi.org/10.1038/scientificamerican0388-80>,
        <https://doi.org/10.1080/10586458.1993.10504266>,
        <https://doi.org/10.1103/PhysRevE.74.011914>,
        <https://doi.org/10.1644/900.1> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
    pk1:leanDeclaration "MathOfBiology.Loop_003.in_turing_band_r2" ;
    pk1:leanTheorem "MathOfBiology.Loop_003.murray_conical_tail_spot_to_ring_transition" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/murray-mammalian-coat-markings-4> a skos:Concept,

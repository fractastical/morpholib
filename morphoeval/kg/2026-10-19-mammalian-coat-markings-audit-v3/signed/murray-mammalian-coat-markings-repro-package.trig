sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-mammalian-coat-markings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L1681–L1778" ;
        dcterms:description "12-check self_test() including FEM spectrum/mass-conservation checks and the v2-geometry negative assertion" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L1681-L1778> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L1198–L1215" ;
        dcterms:description "render_outputs() computes both the v2-geometry and the thin-tip conical runs so the retraction is visible in the figure (Panel G)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L1198-L1215> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1981) Thomas substrate-inhibition reaction-diffusion pre-pattern, conical tail spot-to-ring transition & P1 surface-FEM felid body — Reproducibility package: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Deterministic RNG (`seed=1981`), a 12-check `--self-test` (L1681-1778) covering SHA locks, JSON parity, the K*u0^2 > 1 threshold, the n = 0-inclusive mode census, the stable conical solver (ring zone exists at r_tip = 0.15 and does NOT at the v2 r_tip = 0.35, field stays off the clip bounds), both controls, segmentation, bitwise two-run determinism, FEM cylinder spectrum, FEM mass conservation, a coarse FEM body run and the G = 1 <= G = 2 annularity ordering; three self-contained outputs (12-panel PNG, FEM-surface PNG, 12-frame GIF). Render ~55-70 s and self-test ~70 s on the reference machine. Residual: the initial noise amplitude is applied per vertex, so the seeded field (and hence the exact spot layout) depends on mesh resolution." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-repro-package-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

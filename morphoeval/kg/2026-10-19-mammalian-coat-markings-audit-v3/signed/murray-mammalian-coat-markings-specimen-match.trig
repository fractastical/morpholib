sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-mammalian-coat-markings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1981) Thomas substrate-inhibition reaction-diffusion pre-pattern, conical tail spot-to-ring transition & P1 surface-FEM felid body — Morphological realism / specimen match: 72/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The SHA-256-locked Kruger *Panthera pardus pardus* photograph is loaded and segmented into N = 164 flank markings (DoG + opening, L1082-1155) with Delaunay NN spacing 7.44 px (CV 0.30) and interior Voronoi polygonality compared against the planar PDE lattice (Panels E, F, H); the FEM body now yields a marking density that can be compared with the specimen. But that comparison FAILS by 3.7x (FEM Stage 2: 5.1 markings per torso depth vs specimen estimate 18.9, `felid_body_profile.json` L63) because HBL = 22 lambda_c and G = 2 are assumed, not fitted; the v2 tail ROI [410, 115, 560, 225] covers mostly hindquarters and background grass on this 3/4-view image (caveat recorded at `felid_body_profile.json` L64) so no tail statistic is actually measured on the animal; and the FEM \"rosettes\" are compared to the specimen only through a self-defined annularity index, not through segmented rosette morphology (ring/core ratios, rosette diameters). v2's 89 credited a tail ROI that does not contain the tail." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1981-murray-mammalian-coat-markings.py L1025–L1053: FEM markings-per-torso-depth computed and compared with the specimen estimate (5.09 vs 18.9) -- the comparison is made but the model is 3.7x too coarse <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L1025-L1053>",
            "datasets/mammalian_coat_markings/felid_body_profile.json L57–L65: Specimen torso-depth scale estimate (18.9 markings per torso depth) and the tail-ROI caveat: the v2 tail ROI is on the hindquarters/background <https://github.com/fractastical/morpholib/blob/64526a0/datasets/mammalian_coat_markings/felid_body_profile.json#L57-L65>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-specimen-match-2> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L1082–L1155" ;
        dcterms:description "SHA-verified specimen load, DoG segmentation, Delaunay NN spacing, Voronoi polygonality, flank and tail ROIs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L1082-L1155> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/mammalian_coat_markings_comparison.png (generated output)" ;
        dcterms:description "12-panel figure: specimen (E), flank segmentation (F), polygonality (H) and FEM body (I, J, L) side by side with the theory panels — docs/media/mammalian_coat_markings_comparison.png: rendered output of 1981-murray-mammalian-coat-markings.py at 64526a0, image/png, 1273921 B, 2366×1881 px, artifact_sha256 417dee8b24b004962c52143eefd329402da37f468ef4c9cbd844a2d13282558a (sha256 417dee8b24b004962c52143eefd329402da37f468ef4c9cbd844a2d13282558a), spec_fingerprint b990576b2a4b3ccd36c08d1a21625f5ebd87766fc673675eaee0d8216821ffd3" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 003 autonomous loop assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-mammalian-coat-markings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-critical-circumferential-cutoff-radius-r-crit-m-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "conical tail critical circumferential cutoff radius r_crit (m=1) = 0.7527 dimensionless radius" ;
        dcterms:description "proximal base r=1.80 has 16 m>=1 spot modes (n >= 0) vs distal tip r=0.35 has 0 m>=1 modes (fastest-mode transition x/L = 0.722); full exclusion of all m>=1 needs r < r_excl = 1/k_+ = 0.3599 (Lean Theorem 5)" ;
        schema:measurementTechnique "r_crit = 1 / sqrt(gamma * (k_+^2 - k_c^2)) at gamma = 8.0" ;
        schema:name "conical tail critical circumferential cutoff radius r_crit (m=1)" ;
        schema:unitText "dimensionless radius" ;
        schema:value "0.7527" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-critical-circumferential-cutoff-radius-r-crit-m-1-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-critical-circumferential-cutoff-radius-r-crit-m-1-reference> a schema:PropertyValue ;
        dcterms:source "Murray (1981) J. Theor. Biol. 88:161-199 Section 4 Eqs. (26)-(32), Figs. 9-12" ;
        schema:value "0.7527" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-pde-proximal-to-distal-circumferential-spot-suppression-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "conical tail PDE proximal-to-distal circumferential spot suppression ratio = 9.859 std_theta(base) / std_theta(exclusion zone)" ;
        dcterms:description "proximal std_theta = 2.1158 vs exclusion-zone std_theta = 0.2146, distal axial ring std = 1.5829" ;
        schema:measurementTechnique "fully implicit surface Laplace-Beltrami Thomas PDE (gamma = 8, r: 1.80 -> 0.15, t = 150) circumferential std(u) in proximal base (x/L < 0.40) vs the full-exclusion zone r(x) < r_excl = 1/k_+ = 0.360 (x/L > 0.874)" ;
        schema:name "conical tail PDE proximal-to-distal circumferential spot suppression ratio" ;
        schema:unitText "std_theta(base) / std_theta(exclusion zone)" ;
        schema:value "9.859" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-pde-proximal-to-distal-circumferential-spot-suppression-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-pde-proximal-to-distal-circumferential-spot-suppression-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Murray (1981) J. Theor. Biol. 88:161-199 Section 4 spot-to-ring transition theorem + Lean Theorem 5 (r < 1/k_+ excludes every m >= 1 mode)" ;
        schema:value "5.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-pde-suppression-ratio-on-the-v2-geometry-r-tip-0-35-r-excl-v2-artifact-disclosure> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "conical tail PDE suppression ratio on the v2 geometry (r_tip = 0.35 > r_excl): v2 artifact disclosure = 0.9045 std_theta(base) / std_theta(x/L > 0.65)" ;
        dcterms:description "saturated nonlinear state keeps an m = 1 'longitudinal' mode at the tip: distal std_theta = 2.3335 vs proximal 2.1106; the v2 value of 865 is NOT reproduced and is retracted here; has_exclusion_zone = False" ;
        schema:measurementTechnique "same solver and diagnostics as v2 but numerically stable (implicit axial diffusion) and run to saturation; v2 geometry never reaches r_excl = 0.36 so linear theory predicts no pure-ring zone" ;
        schema:name "conical tail PDE suppression ratio on the v2 geometry (r_tip = 0.35 > r_excl): v2 artifact disclosure" ;
        schema:unitText "std_theta(base) / std_theta(x/L > 0.65)" ;
        schema:value "0.9045" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-pde-suppression-ratio-on-the-v2-geometry-r-tip-0-35-r-excl-v2-artifact-disclosure-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-pde-suppression-ratio-on-the-v2-geometry-r-tip-0-35-r-excl-v2-artifact-disclosure-reference> a schema:PropertyValue ;
        dcterms:source "v2 audit measurement (2026-10-19-mammalian-coat-markings-audit-v2.measurements.yaml), produced by an axially explicit scheme with dt = 0.015 > dx^2/(2 d/gamma) = 0.0043 (unstable, clipped) at t = 27 with mode-specific seeding" ;
        schema:value "865.5024" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-equal-diffusion-d-1-and-non-inhibitory-k-0-negative-control-amplitude-suppression> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion (d=1) and non-inhibitory (K=0) negative control amplitude suppression = 0.0 std(u) control vs positive" ;
        dcterms:description "positive d=10 std(u) = 1.4678 vs equal-diff d=1 std(u) = 8.59e-15 and K=0 std(u) = 4.14e-16 (f_u = -48.642 < 0)" ;
        schema:measurementTechnique "2D Thomas PDE std(u) at d=1.0 (equal diffusion) and K=0.0 (no substrate inhibition) vs d=10.0, K=0.1" ;
        schema:name "equal-diffusion (d=1) and non-inhibitory (K=0) negative control amplitude suppression" ;
        schema:unitText "std(u) control vs positive" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-equal-diffusion-d-1-and-non-inhibitory-k-0-negative-control-amplitude-suppression-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-equal-diffusion-d-1-and-non-inhibitory-k-0-negative-control-amplitude-suppression-reference> a schema:PropertyValue ;
        dcterms:source "Turing (1952) / Murray (1981) Section 2 Eq. (11) & Lean Theorem 2 thomas_substrate_inhibition_autocatalysis" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-fem-felid-body-tail-spot-to-ring-transition-position-measured-vs-full-exclusion-prediction-r-excl-1-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FEM felid-body tail spot-to-ring transition position (measured vs full-exclusion prediction r_excl = 1/k_+) = 0.8173 fraction of tail length from base" ;
        dcterms:description "Murray's fastest-mode criterion r_crit = 1/sqrt(k_+^2 - k_c^2) = 0.292 lambda_c predicts x_c/L_tail = 0.425, which UNDER-estimates where rings become pure; in the exclusion zone std_theta = 0.0058 vs proximal 1.4248 (ratio 244.9), distal axial ring amplitude std = 0.8259; mesh 47520 vertices" ;
        schema:measurementTechnique "first tail station beyond which circumferential std_theta(u) stays below 25% of its proximal-tail mean on the P1-FEM body (Stage 2, adult)" ;
        schema:name "FEM felid-body tail spot-to-ring transition position (measured vs full-exclusion prediction r_excl = 1/k_+)" ;
        schema:unitText "fraction of tail length from base" ;
        schema:value "0.8173" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-fem-felid-body-tail-spot-to-ring-transition-position-measured-vs-full-exclusion-prediction-r-excl-1-k-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-fem-felid-body-tail-spot-to-ring-transition-position-measured-vs-full-exclusion-prediction-r-excl-1-k-reference> a schema:PropertyValue ;
        dcterms:source "Murray (1981) J. Theor. Biol. 88:161-199 Section 4 Eqs. (26)-(32) + Lean Theorem 5: r(x) < r_excl = 1/k_+ = 0.140 lambda_c excludes every m >= 1 mode (incl. n = 0), evaluated on the felid_body_profile.json taper" ;
        schema:value "0.8579" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-fem-stage-2-torso-markings-per-torso-depth-vs-specimen-estimate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FEM Stage-2 torso markings per torso depth vs specimen estimate = 5.093 markings per torso depth (2 r_torso / NN spacing)" ;
        dcterms:description "FEM Stage-2 torso spots = 117, NN spacing = 0.864 lambda_c (CV 0.17); Stage-1 = 2.31. The ~4-5x shortfall is a disclosed scale mismatch: HBL = 22 lambda_c and G = 2 are assumed, not fitted" ;
        schema:measurementTechnique "3D nearest-neighbour spacing of compact Stage-2 spot centroids on the FEM torso (adult wavelength = 0.5 lambda_c) divided into the torso depth 4.4 lambda_c" ;
        schema:name "FEM Stage-2 torso markings per torso depth vs specimen estimate" ;
        schema:unitText "markings per torso depth (2 r_torso / NN spacing)" ;
        schema:value "5.093" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-fem-stage-2-torso-markings-per-torso-depth-vs-specimen-estimate-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-fem-stage-2-torso-markings-per-torso-depth-vs-specimen-estimate-reference> a schema:PropertyValue ;
        dcterms:source "datasets/mammalian_coat_markings/felid_body_profile.json specimen_scale_estimates: 140 px torso depth / 7.4 px marking spacing on panthera_pardus_specimen.jpg (3/4 view, approximate)" ;
        schema:value "18.9" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-p1-surface-fem-laplace-beltrami-m-1-cylinder-eigenvalue-relative-error> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "P1 surface-FEM Laplace-Beltrami m=1 cylinder eigenvalue relative error = 0.0 relative error" ;
        dcterms:description "max relative error over the first 7 non-zero modes = 5.23e-04; stiffness row-sum max |K 1| = 6.7e-16 (Lean Theorem 4); lumped area error 4.0e-04" ;
        schema:measurementTechnique "generalized eigenproblem K phi = lambda M phi (cotangent stiffness, lumped mass) on a Neumann cylinder r=1, L=10, 120x64 mesh vs exact 1/r^2" ;
        schema:name "P1 surface-FEM Laplace-Beltrami m=1 cylinder eigenvalue relative error" ;
        schema:unitText "relative error" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-p1-surface-fem-laplace-beltrami-m-1-cylinder-eigenvalue-relative-error-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-p1-surface-fem-laplace-beltrami-m-1-cylinder-eigenvalue-relative-error-reference> a schema:PropertyValue ;
        dcterms:source "Dziuk (1988) / Dziuk & Elliott (2013) Acta Numerica 22:289-396 surface FEM convergence; exact cylinder spectrum (n*pi/L)^2 + (m/r)^2" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-scale-factor-gamma-vs-unstable-eigenmode-count-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "scale factor gamma vs unstable eigenmode count Pearson r = 0.9996 Pearson r" ;
        dcterms:description "p=9.09e-06; subcritical gamma=0.4 yields 0 modes (std_u=1.86e-14) vs gamma=25.0 yields 15 modes" ;

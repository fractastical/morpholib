    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-segmented-panthera-pardus-kruger-flank-inter-rosette-delaunay-wavelength-cv-reference> a schema:PropertyValue ;

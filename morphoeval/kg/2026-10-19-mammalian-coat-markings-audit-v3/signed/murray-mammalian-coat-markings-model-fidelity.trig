sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-mammalian-coat-markings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1981) Thomas substrate-inhibition reaction-diffusion pre-pattern, conical tail spot-to-ring transition & P1 surface-FEM felid body — Model fidelity to source: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Solves the exact Thomas (1975) / Murray (1981) steady state (u0, v0) = (9.9338, 9.2892), Jacobian, d_c = 9.6292 and dispersion curve (L169-259); counts Neumann cylinder eigenmodes from n = 0 and distinguishes r_crit = 0.7527 (fastest mode) from the full-exclusion radius r_excl = 1/k_+ = 0.36 (L264-338, Lean Theorem 5); integrates the tapered tail with a fully implicit per-Fourier-mode surface Laplace-Beltrami operator including the arc-length metric factor (L340-470), replacing the v2 explicit-axial scheme that violated its own stability limit; runs the planar PDE to saturation with a genuine two-stage protocol (L475-563); and assembles a P1 cotangent surface FEM (L697-789) whose m = 1 cylinder eigenvalue matches the analytic value to 3.1e-14 and whose stiffness rows sum to zero (Lean Theorem 4), on which the two-stage run is executed on the felid body (L955-1056). Not 94 as in v2: the body is a surface of revolution rather than a scanned mesh, the FEM reaction step is explicit (dt = 0.1 is only safe because |eig J0| <= 7.1 at Table 1; the K = 0 control needs dt = 0.02), and the demonstration tail had to be thinned to r_tip = 0.15 for the ring zone to exist -- the v2 geometry does not produce rings." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1981-murray-mammalian-coat-markings.py L20–L34: Disclosure that the v2 conical solver was numerically unstable (dt = 0.015 > 0.0043) and that its 865x ratio was a clipping artifact <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L20-L34>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-7> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L169–L259" ;
        dcterms:description "Exact Thomas steady state via brentq, Jacobian J0, d_c, unstable band, dispersion" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L169-L259> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L264–L338" ;
        dcterms:description "Conical tail eigenmode census from n = 0, r_crit (fastest mode) vs r_excl = 1/k_+ (all m >= 1 excluded), slant length and metric factor" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L264-L338> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L340–L470" ;
        dcterms:description "Fully implicit conical-tail solver (per-mode dense inverses, dt = 0.1); exclusion-zone diagnostics; v2 geometry shown to have no ring zone" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L340-L470> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L697–L789" ;
        dcterms:description "Surface-of-revolution triangulation, P1 cotangent stiffness + lumped mass assembly, eigenvalue check against (n*pi/L)^2 + (m/r)^2 with m >= 1 double multiplicity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L697-L789> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L836–L892" ;
        dcterms:description "IMEX surface FEM time-stepper (M + dt/gamma K) u = M (u + dt f) via splu; explicit reaction" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L836-L892> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-6> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L955–L1056" ;
        dcterms:description "Two-stage FEM run: Stage 1 on cub body (mass scaled 1/G^2), Stage 2 reseeded on adult body; r_crit/r_excl transition positions; annularity and spot statistics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L955-L1056> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-7> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean L110–L157" ;
        dcterms:description "Theorem 4 (cotangent rows annihilate constants and sum to zero) and Theorem 5 (r_excl = 1/k_+ required to exclude n = 0 longitudinal modes); 5 theorems total, 0 sorrys" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L110-L157> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 003 autonomous loop assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-mammalian-coat-markings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1981) Thomas substrate-inhibition reaction-diffusion pre-pattern, conical tail spot-to-ring transition & P1 surface-FEM felid body — Parameter expressivity: 80/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Sweeps Murray's five gamma regimes {0.4, 3.5, 8, 25, 120} to saturation (`run_scale_morphospace_sweep`, L620-668), runs dual negative controls at d = 1 and K = 0 with the stability-appropriate time step (L671-692), adds a Liu-Liaw-Maini growth-factor sweep G in {1, 1.5, 2, 3} with an annularity read-out (L594-618, Panel K; non-monotonic: G = 3 yields central-spot jaguar-like rosettes, annularity 0.25), and exposes `--growth-factor`, which IS wired through to both the planar and FEM two-stage runs (L1792, L1800). However the kinetic/scale flags `--a`, `--b`, `--alpha`, `--rho`, `--K`, `--d`, `--gamma`, `--seed` and `--steps` are parsed (L1783-1791) and never passed to any solver: `render_outputs` is called with `growth_factor` only (L1800). v2 scored this dimension 90 on the strength of \"full CLI flags\" that were already inert in v2." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1981-murray-mammalian-coat-markings.py L1783–L1800: CLI parses a, b, alpha, rho, K, d, gamma, steps, seed but only growth_factor reaches render_outputs() <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L1783-L1800>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-parameter-expressivity-1> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L594–L692" ;
        dct:description "Growth-factor sweep, 5-regime gamma sweep and dual negative controls (K = 0 run at dt = 0.02 because f_u = -48.6)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/64526a0/1981-murray-mammalian-coat-markings.py#L594-L692> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 003 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


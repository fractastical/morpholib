sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Bauhinia variegata Turing wavenumber at 69.12 µm (Pass 1) — Morphometric validation: 72/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Linear sigma matches a single-mode integration to about 3 percent, and the ablation is negative. Full-frame Pearson r = 0.9776 misses the 0.98 gate. The scale bar was not measured, so the sampling limit was NaN. Full-frame KS was not separated from the valve." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-analytic-growth-rate-sigma-k-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-scale-bar-sampling-of-the-69-12-m-mode>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-specimen-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-stripe-critical-wavenumber-k-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-valve-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-schnakenberg-discriminant-root-r-crit>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-specimen-image-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-specimen-image-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-specimen-image-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-specimen-scale-fft-wavelength-of-activator>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-analytic-growth-rate-sigma-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "analytic growth rate sigma(k_c) = 0.1879 1/time" ;
        schema:measurementTechnique "largest eigenvalue of J - k_c^2 D" ;
        schema:name "analytic growth rate sigma(k_c)" ;
        schema:unitText "1/time" ;
        schema:value "0.1879" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-analytic-growth-rate-sigma-k-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-analytic-growth-rate-sigma-k-c-reference> a schema:PropertyValue ;
        dct:source "Turing instability threshold sigma = 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation sigma_max = -0.1 1/time" ;
        schema:measurementTechnique "max_k sigma(k) with D_v = D_u" ;
        schema:name "equal-diffusion ablation sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.1" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max-reference> a schema:PropertyValue ;
        dct:source "Turing 1952: equal diffusion does not destabilise" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pod contour circularity = 0.0878 4πA/P²" ;
        schema:measurementTechnique "erosion perimeter of the last-frame foreground" ;
        schema:name "pod contour circularity" ;
        schema:unitText "4πA/P²" ;
        schema:value "0.0878" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "erosion perimeter of the photograph foreground" ;
        schema:value "0.096" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-scale-bar-sampling-of-the-69-12-m-mode> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pod scale-bar sampling of the 69.12 µm mode = 0.2557 pixels" ;
        schema:measurementTechnique "69.12 µm divided by (10_000 µm / scale-bar length in px)" ;
        schema:name "pod scale-bar sampling of the 69.12 µm mode" ;
        schema:unitText "pixels" ;
        schema:value "0.2557" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-scale-bar-sampling-of-the-69-12-m-mode-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-scale-bar-sampling-of-the-69-12-m-mode-reference> a schema:PropertyValue ;
        dct:source "one pixel would be the resolution floor; the mode is below it" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-specimen-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pod specimen aspect ratio = 2.0026 width/height" ;
        schema:measurementTechnique "bounding box of the largest foreground component on the last frame" ;
        schema:name "pod specimen aspect ratio" ;
        schema:unitText "width/height" ;
        schema:value "2.0026" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-specimen-aspect-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-specimen-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "bounding box of the largest component on the photograph" ;
        schema:value "2.0026" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pod specimen foreground fraction = 0.2855 fraction" ;
        schema:measurementTechnique "luminance mask of the last GIF frame (photograph plus 69 µm inset)" ;
        schema:name "pod specimen foreground fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.2855" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "same mask on the unaltered MHNT photograph" ;
        schema:value "0.2726" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-stripe-critical-wavenumber-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pod stripe critical wavenumber k_c = 0.0909 rad/µm" ;
        schema:measurementTechnique "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v) at r = 16.9" ;
        schema:name "pod stripe critical wavenumber k_c" ;
        schema:unitText "rad/µm" ;
        schema:value "0.0909" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-stripe-critical-wavenumber-k-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-stripe-critical-wavenumber-k-c-reference> a schema:PropertyValue ;
        dct:source "Turing 1952, doi:10.1098/rstb.1952.0012" ;
        schema:value "0.0909" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pod structure-tensor coherency = 0.4966 coherency" ;
        schema:measurementTechnique "mean structure-tensor coherency on the last-frame foreground" ;
        schema:name "pod structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.4966" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "same coherency on the unaltered photograph" ;
        schema:value "0.5032" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-valve-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pod valve KS statistic = 0.0345 sup |ΔCDF|" ;
        schema:measurementTechnique "KS on the valve mask only (gray < 232), excluding the paper background" ;
        schema:name "pod valve KS statistic" ;
        schema:unitText "sup |ΔCDF|" ;
        schema:value "0.0345" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-valve-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-pod-valve-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "identical valve histograms would give KS = 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-schnakenberg-discriminant-root-r-crit> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Schnakenberg discriminant root r_crit = 8.5676 D_v/D_u" ;
        schema:measurementTechnique "larger root of (r f_u + g_v)^2 = 4 r det(J) at (a, b) = (0.10, 0.90)" ;
        schema:name "Schnakenberg discriminant root r_crit" ;
        schema:unitText "D_v/D_u" ;
        schema:value "8.5676" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-schnakenberg-discriminant-root-r-crit-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-schnakenberg-discriminant-root-r-crit-reference> a schema:PropertyValue ;
        dct:source "slot ratio 16.9, which must sit above the root" ;
        schema:value "16.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-specimen-image-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image KS statistic = 0.745 sup |ΔCDF|" ;
        schema:measurementTechnique "two-sample KS on 5000 grayscale pixels, seed 3132; paper-white quantisation inflates this" ;
        schema:name "specimen image KS statistic" ;
        schema:unitText "sup |ΔCDF|" ;
        schema:value "0.745" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-specimen-image-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-specimen-image-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "identical histograms would give KS = 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-specimen-image-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image Pearson r = 0.9935 correlation" ;
        schema:measurementTechnique "Pearson r of grayscale pixels, photograph vs last GIF frame" ;
        schema:name "specimen image Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.9935" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-specimen-image-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-specimen-image-pearson-r-reference> a schema:PropertyValue ;
        dct:source "identity correlation; the inset keeps the frames from matching exactly" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-specimen-image-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image RMSE = 8.7539 gray levels" ;
        schema:measurementTechnique "RMSE of grayscale pixels, photograph vs last GIF frame" ;
        schema:name "specimen image RMSE" ;
        schema:unitText "gray levels" ;
        schema:value "8.7539" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-specimen-image-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-specimen-image-rmse-reference> a schema:PropertyValue ;
        dct:source "zero residual would mean the frames are identical" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-specimen-scale-fft-wavelength-of-activator> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen-scale FFT wavelength of activator = 76.1598 µm" ;
        schema:measurementTechnique "dominant non-DC mode of the saved activator field" ;
        schema:name "specimen-scale FFT wavelength of activator" ;
        schema:unitText "µm" ;
        schema:value "76.1598" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-specimen-scale-fft-wavelength-of-activator-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-measurement-specimen-scale-fft-wavelength-of-activator-reference> a schema:PropertyValue ;
        dct:source "assigned detail scale 69.12 µm = 6.912e-05 m" ;
        schema:value "69.12" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-bauhinia-variegata-turing-wavelength-s0.py L207–L234" ;
        dct:description "single-mode growth-rate check" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bauhinia-variegata-turing-wavelength-s0.py#L207-L234> .

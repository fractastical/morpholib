<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-bauhinia-variegata-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-bauhinia-variegata-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-bauhinia-variegata-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-bauhinia-variegata-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg diffusion-ratio instability margin" ;
    dct:description "The inhibitor must out-diffuse the activator before a 69.12 µm band exists | Variables: r and r_crit in thousandths (16900 and 8568)" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012; Schnakenberg 1979 doi:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1be9d1632617bfa381920e55b36a9ded7b0ab958/models/2026-delphi10000-bauhinia-variegata-turing-wavelength-s0.py#L105-L116>,
        <https://github.com/fractastical/morpholib/blob/1be9d1632617bfa381920e55b36a9ded7b0ab958/morphoeval/lean/loops/Loop_3132_bauhinia_variegata_turing_wavelength_s0.lean#L18-L22> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "r = D_v/D_u > r_crit, with r = 16.9 and r_crit = 8.5676 at (a, b) = (0.10, 0.90)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1126/science.1203874> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3132.law1Margin" ;
    pk:leanTheorem "MathOfBiology.Loop_3132.law1_turing_ratio_exceeds_threshold" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-bauhinia-variegata-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber and wavelength" ;
    dct:description "Selects the detail-scale wavelength rather than a reference-frame offset | Variables: domain length in micrometres; gauge cancels" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1be9d1632617bfa381920e55b36a9ded7b0ab958/models/2026-delphi10000-bauhinia-variegata-turing-wavelength-s0.py#L129-L134>,
        <https://github.com/fractastical/morpholib/blob/1be9d1632617bfa381920e55b36a9ded7b0ab958/morphoeval/lean/loops/Loop_3132_bauhinia_variegata_turing_wavelength_s0.lean#L26-L31> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); lambda_c = 2 pi / k_c = 69.12 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1126/science.1203874> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3132.law2Balance" ;
    pk:leanTheorem "MathOfBiology.Loop_3132.law2_domain_gauge_cancellation" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-bauhinia-variegata-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "How many cellular wavelengths fit on the 1 cm valve" ;
    dct:description "States what changes between this scale and the centimetre valve at the same age (0 Ma) | Variables: lambda in hundredths of a micrometre (6912); one centimetre (1000000)" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1be9d1632617bfa381920e55b36a9ded7b0ab958/models/2026-delphi10000-bauhinia-variegata-turing-wavelength-s0.py#L787-L788>,
        <https://github.com/fractastical/morpholib/blob/1be9d1632617bfa381920e55b36a9ded7b0ab958/morphoeval/lean/loops/Loop_3132_bauhinia_variegata_turing_wavelength_s0.lean#L42-L45> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "144 * 69.12 µm < 1 cm < 145 * 69.12 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1126/science.1203874> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3132.wavelengthsInCentimetre" ;
    pk:leanTheorem "MathOfBiology.Loop_3132.law3_cellular_mode_count_on_one_centimetre" ;
    pk:leanVerified true .


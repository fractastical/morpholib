    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0-parameter-expressivity-1> ;
    pk:hasScore 6.8e-01 ;
    pk:hasVerdict "mostly faithful" .


        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-bauhinia-variegata-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Bauhinia variegata Turing wavenumber at 69.12 µm (Pass 1) faithfully reproduces Bauhinia variegata (Orchid Tree Pod), Holocene extant, 0 Ma morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-bauhinia-variegata-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Bauhinia variegata (Orchid Tree Pod), Holocene extant, 0 Ma specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-bauhinia-variegata-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-bauhinia-variegata-turing-wavelength-s0.py; output: docs/media/bauhinia_variegata_turing_wavelength_s0_comparison.png; organism: Bauhinia variegata (Orchid Tree Pod), Holocene extant, 0 Ma; environment: n/a; claim_boundary: [reported_in_source: Turing (1952) selects a finite wavenumber when inhibitor diffusion is fast enough. Schnakenberg (1979) supplies the trimolecular kinetics. Kondo & Miura (2010) review wavelength selection by reaction and diffusion rates. | Armon et al. (2011) measured centimetre-scale helical opening of Bauhinia variegata valves. That is a different law.; reconstructed_in_script: D_u and D_v are chosen so the linear k_c equals 2π/69.12 µm. The 69.12 µm length is the assigned detail scale of this slot, not a counted spacing on the pericarp.; transfer_boundary: The photograph is a centimetre-scale herbarium scan (CC BY-SA 3.0, Roger Culos). It shows the valve envelope. It does not resolve 69.12 µm.; does_not_claim: Does not claim a published 69.12 µm pigment measurement for Bauhinia variegata. | Does not claim the reaction-diffusion field generates the pod silhouette or the seed positions. | Does not reuse Armon et al. curvature parameters.]; phenomenon_size: 3.4 cm (0.03379 m, log10=-1.471 m, tier=7_organism_cm); species_scale_ladder (1 runs from 3.4 cm to 3.4 cm): 3.4 cm:chiral-seed-pod-opening" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047>,
            <https://doi.org/10.1126/science.1203874> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-bauhinia-variegata-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-bauhinia-variegata-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


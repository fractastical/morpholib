sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila bipectinata Turing wavelength at 1.92 µm (Holocene, 0 Ma) — Model fidelity to source: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The code implements Schnakenberg kinetics, the Turing wavenumber, and a discrete dispersion relation whose eigenmode growth correlates with the formula at r = 0.99478. gamma is derived so the continuous focal wavelength is 1.92 µm. Fidelity is not higher because that wavelength is the assigned rung rather than a constant published for this species." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py L68–L102" ;
        dct:description "steady state, gamma solve, continuous k_c" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py#L68-L102> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py L151–L219" ;
        dct:description "discrete eigenmode sigma and the even/odd goodness-of-fit split" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py#L151-L219> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3178_drosophila_bipectinata_turing_wavelength_s0.lean L18–L42" ;
        dct:description "five theorems, no unfinished proofs, wavelength order and equal-diffusion sign" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3178_drosophila_bipectinata_turing_wavelength_s0.lean#L18-L42> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (Cursor cloud agent, loop 3178 pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://w3id.org/delphi/agent/loop-3178-unsigned> ;
        foaf:homepage <https://x.ai> .
}


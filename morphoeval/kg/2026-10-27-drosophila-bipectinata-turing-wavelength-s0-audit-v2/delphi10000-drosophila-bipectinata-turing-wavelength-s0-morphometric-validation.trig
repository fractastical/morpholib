sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila bipectinata Turing wavelength at 1.92 µm (Holocene, 0 Ma) — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Even-mode Pearson r = 0.99478 (reference 1.0). Held-out odd-mode RMSE = 0.01287 s^-1 (reference 0). KS distance = 0.125 (reference 0). Nonlinear wavelength 2.56 µm is not set equal to the linear 1.92 µm reference. Ablation amplification 0.0388 versus Turing amplification 89.6. Specimen foreground at the verifier threshold is 0.3233 versus the percentile-85 mask, and coherency is 0.755 versus an isotropic baseline of 0.5." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-du-sweep-wavelength-at-phi-2-25-versus-phi-0-49>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplification-of-activator-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-even-mode-dispersion-pearson-r-of-numerical-eigenmode-growth-vs-discrete-sigma-k>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-focal-linear-turing-wavelength-against-the-86-m-sibling-rung>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-held-out-odd-mode-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-ks-distance-between-analytical-and-numerical-growth-rate-lists>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-nonlinear-selected-pigment-wavelength-on-the-15-36-m-patch>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-predecessor-drosophila-biarmipes-linear-wavelength-at-0-ma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-at-contrast-percentile-45>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-successor-drosophila-buzzatii-linear-wavelength-at-0-ma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-du-sweep-wavelength-at-phi-2-25-versus-phi-0-49> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Du sweep wavelength at phi = 2.25 versus phi = 0.49 = 2.88 µm" ;
        dct:description "lambda increases monotonically with sqrt(D_u)" ;
        schema:measurementTechnique "seven-point sweep of D_u at fixed gamma and delta; reported value is lambda(phi=2.25)" ;
        schema:name "Du sweep wavelength at phi = 2.25 versus phi = 0.49" ;
        schema:unitText "µm" ;
        schema:value "2.88" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-du-sweep-wavelength-at-phi-2-25-versus-phi-0-49-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-du-sweep-wavelength-at-phi-2-25-versus-phi-0-49-reference> a schema:PropertyValue ;
        dct:source "lambda at the low-diffusivity end of the same sweep (phi = 0.49)" ;
        schema:value "1.344" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplification-of-activator-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation amplification of activator std = 0.0388 std_final/std_0" ;
        dct:description "control must stay near or below 1 while the Turing run amplifies" ;
        schema:measurementTechnique "Schnakenberg integration at delta = D_v/D_u = 1 for 6 s" ;
        schema:name "equal-diffusion ablation amplification of activator std" ;
        schema:unitText "std_final/std_0" ;
        schema:value "0.0388" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplification-of-activator-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplification-of-activator-std-reference> a schema:PropertyValue ;
        dct:source "focal delta = 31.5 pattern amplification on the same seed family" ;
        schema:value "89.6033" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-even-mode-dispersion-pearson-r-of-numerical-eigenmode-growth-vs-discrete-sigma-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "even-mode dispersion Pearson r of numerical eigenmode growth vs discrete sigma(k) = 0.99478 Pearson r" ;
        dct:description "all-mode r = 0.99772; odd-mode held-out RMSE = 0.01287" ;
        schema:measurementTechnique "pure unstable-eigenvector initial data, log-amplitude slope versus the discrete-Laplacian eigenvalue" ;
        schema:name "even-mode dispersion Pearson r of numerical eigenmode growth vs discrete sigma(k)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99478" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-even-mode-dispersion-pearson-r-of-numerical-eigenmode-growth-vs-discrete-sigma-k-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-even-mode-dispersion-pearson-r-of-numerical-eigenmode-growth-vs-discrete-sigma-k-reference> a schema:PropertyValue ;
        dct:source "ideal correlation of the linear dispersion relation" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-focal-linear-turing-wavelength-against-the-86-m-sibling-rung> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "focal linear Turing wavelength against the 86 µm sibling rung = 1.92 µm" ;
        dct:description "the solved focal wavelength is the 1.92 µm rung; 86 µm is the other slot" ;
        schema:measurementTechnique "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v) with gamma solved at D_u = 0.0504 µm^2/s, delta = 31.5" ;
        schema:name "focal linear Turing wavelength against the 86 µm sibling rung" ;
        schema:unitText "µm" ;
        schema:value "1.92" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-focal-linear-turing-wavelength-against-the-86-m-sibling-rung-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-focal-linear-turing-wavelength-against-the-86-m-sibling-rung-reference> a schema:PropertyValue ;
        dct:source "sibling slot 2851 cellular pitch (8.592e-5 m), which this 1.92 µm detail rung does not copy" ;
        schema:value "86.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-held-out-odd-mode-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "held-out odd-mode dispersion RMSE = 0.01287 1/s" ;
        dct:description "KS distance between analytical and numerical sigma lists is recorded separately" ;
        schema:measurementTechnique "RMSE of sigma on odd Fourier modes, which are not the Pearson reporting set" ;
        schema:name "held-out odd-mode dispersion RMSE" ;
        schema:unitText "1/s" ;
        schema:value "0.01287" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-held-out-odd-mode-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-held-out-odd-mode-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "zero error against the discrete dispersion relation" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-ks-distance-between-analytical-and-numerical-growth-rate-lists> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "KS distance between analytical and numerical growth-rate lists = 0.125 KS statistic" ;
        dct:description "a zero KS would mean the lists are the same sample; the solver residual keeps it positive" ;
        schema:measurementTechnique "scipy.stats.ks_2samp on the 16-mode sigma vectors" ;
        schema:name "KS distance between analytical and numerical growth-rate lists" ;
        schema:unitText "KS statistic" ;
        schema:value "0.125" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-ks-distance-between-analytical-and-numerical-growth-rate-lists-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-ks-distance-between-analytical-and-numerical-growth-rate-lists-reference> a schema:PropertyValue ;
        dct:source "identical distributions" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-nonlinear-selected-pigment-wavelength-on-the-15-36-m-patch> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nonlinear selected pigment wavelength on the 15.36 µm patch = 2.56 µm" ;
        dct:description "saturation shifts the peak off the linear critical mode; value is not forced equal to 1.92" ;
        schema:measurementTechnique "dominant radial Fourier mode of the saturated Schnakenberg activator, L/m*" ;
        schema:name "nonlinear selected pigment wavelength on the 15.36 µm patch" ;
        schema:unitText "µm" ;
        schema:value "2.56" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-nonlinear-selected-pigment-wavelength-on-the-15-36-m-patch-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-nonlinear-selected-pigment-wavelength-on-the-15-36-m-patch-reference> a schema:PropertyValue ;
        dct:source "linear k_c of the focal parameter set" ;
        schema:value "1.92" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-predecessor-drosophila-biarmipes-linear-wavelength-at-0-ma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "predecessor Drosophila biarmipes linear wavelength at 0 Ma = 2.4 µm" ;
        dct:description "age is 0 Ma for both; the change at this rung is diffusivity, not geological time" ;
        schema:measurementTechnique "same gamma and delta, D_u scaled by 25/16 (wing-spot clade, less tethered activator)" ;
        schema:name "predecessor Drosophila biarmipes linear wavelength at 0 Ma" ;
        schema:unitText "µm" ;
        schema:value "2.4" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-predecessor-drosophila-biarmipes-linear-wavelength-at-0-ma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-predecessor-drosophila-biarmipes-linear-wavelength-at-0-ma-reference> a schema:PropertyValue ;
        dct:source "focal D. bipectinata wavelength at the same Holocene age" ;
        schema:value "1.92" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-at-contrast-percentile-45> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image foreground fraction at contrast percentile 45 = 0.3233 area fraction" ;
        dct:description "circularity p45 = 0.0462, coherency = 0.755" ;
        schema:measurementTechnique "border-median contrast mask on the SHA-pinned gallery JPEG, percentile 45, closing and hole fill" ;
        schema:name "specimen image foreground fraction at contrast percentile 45" ;
        schema:unitText "area fraction" ;
        schema:value "0.3233" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-at-contrast-percentile-45-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-at-contrast-percentile-45-reference> a schema:PropertyValue ;
        dct:source "same photograph segmented at contrast percentile 85 with no 0.06 floor" ;
        schema:value "0.153" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.755 coherency" ;
        dct:description "the gallery frame is anisotropic; this is not a self-copy of the reference" ;
        schema:measurementTechnique "mean (lambda1-lambda2)/(lambda1+lambda2) of the Sobel structure tensor, sigma = 2.5" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.755" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "isotropic-structure baseline of 0.5" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-successor-drosophila-buzzatii-linear-wavelength-at-0-ma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "successor Drosophila buzzatii linear wavelength at 0 Ma = 1.536 µm" ;
        dct:description "reconstructed chronoseries contrast, not a measured buzzatii granule spacing" ;
        schema:measurementTechnique "same gamma and delta, D_u scaled by 16/25" ;
        schema:name "successor Drosophila buzzatii linear wavelength at 0 Ma" ;
        schema:unitText "µm" ;
        schema:value "1.536" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-successor-drosophila-buzzatii-linear-wavelength-at-0-ma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-measurement-successor-drosophila-buzzatii-linear-wavelength-at-0-ma-reference> a schema:PropertyValue ;
        dct:source "focal D. bipectinata wavelength at the same Holocene age" ;
        schema:value "1.92" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py L461–L575" ;
        dct:description "measure_morphoeval values differ from their references" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py#L461-L575> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py L293–L338" ;
        dct:description "ablation integration and two-threshold specimen segmentation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py#L293-L338> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (Cursor cloud agent, loop 3178 pass 2)" ;

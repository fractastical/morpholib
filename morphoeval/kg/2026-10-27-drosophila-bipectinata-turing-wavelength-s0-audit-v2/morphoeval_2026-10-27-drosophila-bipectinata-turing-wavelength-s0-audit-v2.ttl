<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila bipectinata Turing wavelength at 1.92 µm (Holocene, 0 Ma) — Morphological realism / specimen match: 80/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The 13-frame GIF grows a melanin mask from the activator on the pinned gallery photograph. Direct comparison of the last frame to that photograph gives CV similarity 93.0 (12-bin orientation, 24-bin radial FFT, structure tensor). The score stays at 80 because the JPEG is a gallery fallback, not a micrograph at 1.92 µm, and the overlay inherits the photograph's low-frequency layout." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-specimen-match-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0-specimen-match-2>,

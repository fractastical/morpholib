    pk:hasScore 8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-bipectinata-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Drosophila bipectinata Turing wavelength at 1.92 µm (Holocene, 0 Ma) (Drosophila bipectinata)",
        "Drosophila bipectinata Turing wavelength at 1.92 µm (Holocene, 0 Ma) faithfully reproduces Drosophila bipectinata morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-bipectinata-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-bipectinata-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-bipectinata-turing-wavelength-s0-3> ;
    dct:description "The simulation script(s) models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py, docs/media/drosophila_bipectinata_turing_wavelength_s0_comparison.png implement the cited source model as published and produce forms that match real Drosophila bipectinata specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/media/drosophila_bipectinata_turing_wavelength_s0_comparison.png>,
        <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py> ;
    schema:about "Drosophila bipectinata" ;
    schema:additionalProperty "does_not_claim: A wet-lab measurement of 1.92 µm in D. bipectinata.",
        "does_not_claim: Stratigraphic ancestry among D. biarmipes, D. bipectinata, and D. buzzatii.",
        "does_not_claim: That the catalog DOI 10.1111/j.1525-142X.2005.05044.x belongs to this morphology. It is a zebrafish myostatin paper.",
        "reconstructed_in_script: At 0 Ma, D. biarmipes (D_u × 25/16) selects 2.40 µm and D. buzzatii (D_u × 16/25) selects 1.536 µm.",
        "reconstructed_in_script: Focal linear wavelength 1.92 µm by solving gamma at D_u = 0.0504 µm^2/s and delta = 31.5.",
        "reconstructed_in_script: Saturated activator on the 64×64 grid selects 2.56 µm, which is reported rather than forced back to 1.92.",
        "reported_in_source: Gompel et al. 2005 is the predecessor citation for D. biarmipes wing pigment.",
        "reported_in_source: Kopp & True 2002, Mishra & Singh 2006, and Hurtado-Gonzales et al. 2014 describe D. bipectinata sex combs. None of them states a 1.92 µm wavenumber.",
        "reported_in_source: Schnakenberg 1979: kinetics a - u + u^2 v and b - u^2 v.",
        "reported_in_source: Turing 1952: a finite critical wavenumber can be selected by diffusion.",
        "transfer_boundary: Melanin optical density on the gallery JPEG is a visualization of the activator, not a photograph of a 1.92 µm granule field." ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Drosophila bipectinata (Double-Comb Indomalayan Fly)" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "II. Anaima (Invertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;
    pk:aristotelianSubalternClass "Entoma (Arthropoda)" ;
    pk:biologicalGenus "Drosophila" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-bipectinata-turing-wavelength-s0.py, https://github.com/fractastical/morpholib/blob/main/docs/media/drosophila_bipectinata_turing_wavelength_s0_comparison.png; output: docs/media/drosophila_bipectinata_turing_wavelength_s0_growth.gif; organism: Drosophila bipectinata; environment: python 3.12.3, numpy 2.5.4, matplotlib 3.11.2, Pillow 13.0.0, scipy 1.18.1; claim_boundary: [reported_in_source: Turing 1952: a finite critical wavenumber can be selected by diffusion. | Schnakenberg 1979: kinetics a - u + u^2 v and b - u^2 v. | Kopp & True 2002, Mishra & Singh 2006, and Hurtado-Gonzales et al. 2014 describe D. bipectinata sex combs. None of them states a 1.92 µm wavenumber. | Gompel et al. 2005 is the predecessor citation for D. biarmipes wing pigment.; reconstructed_in_script: Focal linear wavelength 1.92 µm by solving gamma at D_u = 0.0504 µm^2/s and delta = 31.5. | At 0 Ma, D. biarmipes (D_u × 25/16) selects 2.40 µm and D. buzzatii (D_u × 16/25) selects 1.536 µm. | Saturated activator on the 64×64 grid selects 2.56 µm, which is reported rather than forced back to 1.92.; transfer_boundary: Melanin optical density on the gallery JPEG is a visualization of the activator, not a photograph of a 1.92 µm granule field.; does_not_claim: A wet-lab measurement of 1.92 µm in D. bipectinata. | Stratigraphic ancestry among D. biarmipes, D. bipectinata, and D. buzzatii. | That the catalog DOI 10.1111/j.1525-142X.2005.05044.x belongs to this morphology. It is a zebrafish myostatin paper.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;

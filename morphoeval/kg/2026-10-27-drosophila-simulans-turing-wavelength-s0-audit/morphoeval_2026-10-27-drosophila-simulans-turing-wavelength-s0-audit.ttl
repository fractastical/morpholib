<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila simulans 1.92 µm Turing carrier on the posterior-lobe arc (pass 1) — Model fidelity to source: 80/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The dispersion formula recovers 1.92 µm exactly and the radial PDE runs, but pass 1 still treats the 4.8% gap between numerical k (3.115) and infinite-line k_c (3.272) as an uninterpreted residual. The painted field is a radial harmonic, not the PDE state." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

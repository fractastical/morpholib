    pk:evidenceAgainst "2017-hannezo-branching-random-walk-annihilation.py L172–L179: Only 3 baseline scalars without multi-organ universality RMSE/r or R_a ablation controls <https://github.com/fractastical/morpholib/blob/8871db0/2017-hannezo-branching-random-walk-annihilation.py#L172-L179>" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-barw-characteristic-branch-length-l-b-v-0-k-b-wt>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-barw-mean-field-homeostatic-duct-density-i-inf-k-b-k-a-wt>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-uncoupled-binary-tree-branching-fraction-q-branch-n-branch-30> ;
    pk:hasScore 4.6e-01 ;

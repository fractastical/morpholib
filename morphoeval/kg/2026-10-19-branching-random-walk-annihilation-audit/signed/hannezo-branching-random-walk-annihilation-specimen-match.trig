    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 056 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2017) Cell & Scheele et al. (2017) Nature unifying theory of branching morphogenesis via branching and annihilating random walks (BARW) — Morphological realism / specimen match: 20/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Although `datasets/branching_random_walk_annihilation/mouse_branched_ductal_network_specimen.jpg` (whole-mount fluorescence micrograph of mouse branched glandular epithelium with cyan/green active distal buds A and blue/magenta differentiated ducts I) is vendored in the dataset directory, the v1 script never loads, segments, or displays the specimen image or extracts active tip counts, branch nodes, or topological q_branch." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2017-hannezo-branching-random-walk-annihilation.py L109–L169: 3-panel synthetic figure with zero biological specimen image or active-tip/ductal-tree segmentation <https://github.com/fractastical/morpholib/blob/8871db0/2017-hannezo-branching-random-walk-annihilation.py#L109-L169>",
            "docs/media/branching_random_walk_annihilation_comparison.png (generated output, not in repo): Pass 1 3-panel plot lacking mouse branched ductal network specimen comparison — docs/media/branching_random_walk_annihilation_comparison.png: rendered output of 2017-hannezo-branching-random-walk-annihilation.py at 8871db0, image/png, 111422 B, 1890×588 px, artifact_sha256 a8730e1f88a086fe1b125384633e84ab0d8556565ef7d3117c23b5e9c49fb83b (sha256 a8730e1f88a086fe1b125384633e84ab0d8556565ef7d3117c23b5e9c49fb83b), spec_fingerprint 8396b081dd41f5428f101435bc6396b6e50c4b756e20f4883dc6ac81bd4c137b" ;
        pk:hasScore "0.2"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
}


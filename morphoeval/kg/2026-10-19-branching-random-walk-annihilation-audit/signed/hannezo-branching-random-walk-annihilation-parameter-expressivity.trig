sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-branching-random-walk-annihilation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-parameter-expressivity> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 056 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2017) Cell & Scheele et al. (2017) Nature unifying theory of branching morphogenesis via branching and annihilating random walks (BARW) — Parameter expressivity: 44/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Hardcodes a single parameter set (v_0=1.0, k_b=0.12, k_a=0.42, D=0.35, R_a=3.5, L27-31) without sweeping annihilation radius R_a, branching rate k_b, or organ-specific dimensionless ratio R_a / l_b across mammary gland, kidney, and pancreas regimes, and exposes only `--self-test` and `--skip-gif` on the CLI (L189-193)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2017-hannezo-branching-random-walk-annihilation.py L189–L198: Minimal CLI lacking --kb, --ra, --v0, --sigma-theta, --ka, --seed overrides <https://github.com/fractastical/morpholib/blob/8871db0/2017-hannezo-branching-random-walk-annihilation.py#L189-L198>",
            "2017-hannezo-branching-random-walk-annihilation.py L27–L31: Single hardcoded parameter set without R_a or k_b morphospace sweeps <https://github.com/fractastical/morpholib/blob/8871db0/2017-hannezo-branching-random-walk-annihilation.py#L27-L31>" ;
        pk:hasScore "0.44"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


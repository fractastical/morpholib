    <https://doi.org/10.1038/nature21060> dcterms:date "2017"^^xsd:gYear ;
        dcterms:title "Identity and dynamics of mammary stem cells during branching morphogenesis" .

    <https://doi.org/10.1038/s41467-023-39124-x> dcterms:date "2023"^^xsd:gYear ;
        dcterms:title "Inflationary theory of branching morphogenesis in the mouse salivary gland" .

    <https://doi.org/10.1242/dev.147645> dcterms:date "2017"^^xsd:gYear ;
        dcterms:title "Tracing the dynamics of pancreatic progenitors during branching morphogenesis" .

    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/56> ;

        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2017.08.026>,
            <https://doi.org/10.1038/nature21060>,
            <https://doi.org/10.1038/s41467-023-39124-x>,
            <https://doi.org/10.1242/dev.147645> .
    <https://doi.org/10.1016/j.cell.2017.08.026> dct:date "2017"^^xsd:gYear ;
        dct:title "A Unifying Theory of Branching Morphogenesis" .
    <https://doi.org/10.1038/nature21060> dct:date "2017"^^xsd:gYear ;
        dct:title "Identity and dynamics of mammary stem cells during branching morphogenesis" .
    <https://doi.org/10.1038/s41467-023-39124-x> dct:date "2023"^^xsd:gYear ;
        dct:title "Inflationary theory of branching morphogenesis in the mouse salivary gland" .
    <https://doi.org/10.1242/dev.147645> dct:date "2017"^^xsd:gYear ;
        dct:title "Tracing the dynamics of pancreatic progenitors during branching morphogenesis" .
}


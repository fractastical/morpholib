sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-branching-random-walk-annihilation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-branching-random-walk-annihilation-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo et al. (2017) Cell & Scheele et al. (2017) Nature unifying theory of branching morphogenesis via branching and annihilating random walks (BARW) — Morphometric validation: 46/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L172-179) reports only 3 scalar numbers (l_branch_wt, i_homeostatic_wt, q_branch_baseline) without statistical dispersion metrics (RMSE, Pearson r, CV), without comparison to Hannezo et al. (2017) generational branching probabilities across mammary gland, kidney, and pancreas, and without perturbation deltas for TGF-beta / R_a variations or R_a = 0 non-annihilating explosion ablation." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2017-hannezo-branching-random-walk-annihilation.py L172–L179: Only 3 baseline scalars without multi-organ universality RMSE/r or R_a ablation controls <https://github.com/fractastical/morpholib/blob/8871db0/2017-hannezo-branching-random-walk-annihilation.py#L172-L179>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-barw-characteristic-branch-length-l-b-v-0-k-b-wt>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-barw-mean-field-homeostatic-duct-density-i-inf-k-b-k-a-wt>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-uncoupled-binary-tree-branching-fraction-q-branch-n-branch-30> ;
        pk:hasScore "0.46"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-barw-characteristic-branch-length-l-b-v-0-k-b-wt> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "BARW characteristic branch length l_b = v_0 / k_b (WT) = 8.333333 dimensionless length" ;
        schema:measurementTechnique "compute_barw_steady_state(v0=1.0, kb=0.12)" ;
        schema:name "BARW characteristic branch length l_b = v_0 / k_b (WT)" ;
        schema:unitText "dimensionless length" ;
        schema:value "8.333333" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-barw-characteristic-branch-length-l-b-v-0-k-b-wt-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-barw-characteristic-branch-length-l-b-v-0-k-b-wt-reference> a schema:PropertyValue ;
        schema:value "8.333333" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-barw-mean-field-homeostatic-duct-density-i-inf-k-b-k-a-wt> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "BARW mean-field homeostatic duct density i_inf = k_b / k_a (WT) = 0.285714 dimensionless duct density" ;
        schema:measurementTechnique "compute_barw_steady_state(kb=0.12, ka=0.42)" ;
        schema:name "BARW mean-field homeostatic duct density i_inf = k_b / k_a (WT)" ;
        schema:unitText "dimensionless duct density" ;
        schema:value "0.285714" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-barw-mean-field-homeostatic-duct-density-i-inf-k-b-k-a-wt-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-barw-mean-field-homeostatic-duct-density-i-inf-k-b-k-a-wt-reference> a schema:PropertyValue ;
        schema:value "0.285714" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-branching-random-walk-annihilation-measurement-uncoupled-binary-tree-branching-fraction-q-branch-n-branch-30> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Uncoupled binary tree branching fraction q_branch (N_branch = 30) = 0.491803 probability" ;
        schema:measurementTechnique "N_branch / (N_branch + N_term) with N_term = N_branch + 1" ;
        schema:name "Uncoupled binary tree branching fraction q_branch (N_branch = 30)" ;
        schema:unitText "probability" ;
        schema:value "0.491803" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 056 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


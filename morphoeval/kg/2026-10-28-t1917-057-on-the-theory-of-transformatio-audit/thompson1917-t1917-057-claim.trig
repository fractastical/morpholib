sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-057> a pk:Claim ;
        rdfs:label "Thompson (1917) Fig. 403: Dwight human scapulae coordinate transformation faithfully reproduces Homo sapiens (Caucasian, Negro, N. American Indian scapula outlines after Dwight) morphology" ;
        dct:description "The simulation script(s) thompson/claims/t1917-057_on-the-theory-of-transformations.py implement the cited source model as published and produce forms that match real Homo sapiens (Caucasian, Negro, N. American Indian scapula outlines after Dwight) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-057_on-the-theory-of-transformations.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-057_on-the-theory-of-transformations.py; output: docs/media/t1917_057_on_the_theory_of_transformatio_comparison.png; organism: Homo sapiens (Caucasian, Negro, N. American Indian scapula outlines after Dwight); environment: python 3.12; claim_boundary: [reported_in_source: Fig. 403 three human scapulae with coordinate grids (Dwight); reconstructed_in_script: TPS on automatic border extrema + semilandmarks; not Thompson's drawn grid lines; does_not_claim: Population-level variation within race (Thompson footnote); Dryad kangaroo-rat dataset]; phenomenon_size: 979 µm (0.0009792 m, log10=-3.009 m, tier=5_primordium_100um); species_scale_ladder (20 runs from 979 µm to 2.85 m): 979 µm:cortical-sulcal-axon-tension, 1.4 mm:bressloff-cowan-V1-hallucination, 1.5 mm:corticothalamic-seizure-spirals, 1.7 mm:homo-sapiens-bioelectric-polarity, 3.1 mm:vertex-glass-jamming, 3.4 mm:homo-sapiens-vertex-packing, 6.3 cm:homo-sapiens-turing-wavelength, 11.7 cm:homo-sapiens-clock-wavefront" .
    <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-057_on-the-theory-of-transformations.py> a schema:SoftwareSourceCode ;
        rdfs:label "thompson/claims/t1917-057_on-the-theory-of-transformations.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> .
}


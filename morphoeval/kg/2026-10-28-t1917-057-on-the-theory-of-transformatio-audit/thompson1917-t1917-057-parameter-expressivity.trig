        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "thompson/claims/t1917-057_on-the-theory-of-transformations.py L250–L270: parameter_sweep <https://github.com/fractastical/morpholib/blob/a8bae15d5/thompson/claims/t1917-057_on-the-theory-of-transformations.py#L250-L270>" ;
        pk:hasScore "0.48"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (builder-assessor, Pass 1)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


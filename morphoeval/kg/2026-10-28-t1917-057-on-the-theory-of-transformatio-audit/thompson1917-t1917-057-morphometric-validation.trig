sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-057> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-057-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-057-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Fig. 403: Dwight human scapulae coordinate transformation — Morphometric validation: 58/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Procrustes, IoU, Pearson r; KS and full sweep added in Pass 2." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-measurement-outline-iou-a-c-after-tps>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-measurement-outline-procrustes-a-b-after-tps>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-measurement-parameter-sweep-mean-tps-identity-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-measurement-shuffled-landmark-correspondence-null-a-b>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-morphometric-validation-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-measurement-outline-iou-a-c-after-tps> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Outline IoU A→C after TPS = 0.6120269192890306 IoU" ;
        dct:description "Indian form heavily sheared; landmark r=0.9995" ;
        schema:measurementTechnique "filled outline overlap" ;
        schema:name "Outline IoU A→C after TPS" ;
        schema:unitText "IoU" ;
        schema:value "0.6120269192890306" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-measurement-outline-iou-a-c-after-tps-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-measurement-outline-iou-a-c-after-tps-reference> a schema:PropertyValue ;
        schema:value "0.6717" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-measurement-outline-procrustes-a-b-after-tps> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Outline Procrustes A→B after TPS = 0.17702785124468295 Procrustes d" ;
        dct:description "IoU=0.808 vs identity IoU 0.715; landmark d=0.0000" ;
        schema:measurementTechnique "TPS landmarks + dense outline" ;
        schema:name "Outline Procrustes A→B after TPS" ;
        schema:unitText "Procrustes d" ;
        schema:value "0.17702785124468295" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-measurement-outline-procrustes-a-b-after-tps-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-measurement-outline-procrustes-a-b-after-tps-reference> a schema:PropertyValue ;
        schema:value "0.2622" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-measurement-parameter-sweep-mean-tps-identity-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Parameter sweep mean (TPS/identity) ratio = 0.8913833894824933 ratio" ;
        dct:description "CV=0.016" ;
        schema:measurementTechnique "15 settings over n_semi and lambda" ;
        schema:name "Parameter sweep mean (TPS/identity) ratio" ;
        schema:unitText "ratio" ;
        schema:value "0.8913833894824933" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-measurement-parameter-sweep-mean-tps-identity-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-measurement-parameter-sweep-mean-tps-identity-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-measurement-shuffled-landmark-correspondence-null-a-b> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Shuffled-landmark correspondence null (A→B) = 0.8932586346490007 Procrustes d" ;
        schema:measurementTechnique "reverse non-center landmarks on B before TPS fit" ;
        schema:name "Shuffled-landmark correspondence null (A→B)" ;
        schema:unitText "Procrustes d" ;
        schema:value "0.8932586346490007" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-measurement-shuffled-landmark-correspondence-null-a-b-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-measurement-shuffled-landmark-correspondence-null-a-b-reference> a schema:PropertyValue ;
        schema:value "0.177" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-057-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-057_on-the-theory-of-transformations.py L220–L248" ;
        dct:description "pair_metrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a8bae15d5/thompson/claims/t1917-057_on-the-theory-of-transformations.py#L220-L248> .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (builder-assessor, Pass 1)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


<https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-057> a pk:Claim ;
    rdfs:label "Thompson (1917) Fig. 403: Dwight human scapulae coordinate transformation (Homo sapiens (Caucasian, Negro, N. American Indian scapula outlines after Dwight))",
        "Thompson (1917) Fig. 403: Dwight human scapulae coordinate transformation faithfully reproduces Homo sapiens (Caucasian, Negro, N. American Indian scapula outlines after Dwight) morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-057-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-057-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-057-3> ;
    dct:description "The simulation script(s) thompson/claims/t1917-057_on-the-theory-of-transformations.py implement the cited source model as published and produce forms that match real Homo sapiens (Caucasian, Negro, N. American Indian scapula outlines after Dwight) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-057_on-the-theory-of-transformations.py> ;
    schema:about "Homo sapiens (Caucasian, Negro, N. American Indian scapula outlines after Dwight)" ;
    schema:additionalProperty "does_not_claim: Population-level variation within race (Thompson footnote); Dryad kangaroo-rat dataset",
        "reconstructed_in_script: TPS on automatic border extrema + semilandmarks; not Thompson's drawn grid lines",
        "reported_in_source: Fig. 403 three human scapulae with coordinate grids (Dwight)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-057_on-the-theory-of-transformations.py; output: docs/media/t1917_057_on_the_theory_of_transformatio_comparison.png; organism: Homo sapiens (Caucasian, Negro, N. American Indian scapula outlines after Dwight); environment: python 3.12; claim_boundary: [reported_in_source: Fig. 403 three human scapulae with coordinate grids (Dwight); reconstructed_in_script: TPS on automatic border extrema + semilandmarks; not Thompson's drawn grid lines; does_not_claim: Population-level variation within race (Thompson footnote); Dryad kangaroo-rat dataset]; phenomenon_size: 979 µm (0.0009792 m, log10=-3.009 m, tier=5_primordium_100um); species_scale_ladder (20 runs from 979 µm to 2.85 m): 979 µm:cortical-sulcal-axon-tension, 1.4 mm:bressloff-cowan-V1-hallucination, 1.5 mm:corticothalamic-seizure-spirals, 1.7 mm:homo-sapiens-bioelectric-polarity, 3.1 mm:vertex-glass-jamming, 3.4 mm:homo-sapiens-vertex-packing, 6.3 cm:homo-sapiens-turing-wavelength, 11.7 cm:homo-sapiens-clock-wavefront" ;
    pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-057-code-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-057-model-fidelity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-057-morphometric-validation>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-057-overall>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-057-parameter-expressivity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-057-repro-package>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-057-source-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-057-specimen-match> ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-057-on-the-theory-of-transformatio-audit-thompson1917-t1917-057-1>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-057-on-the-theory-of-transformatio-audit-thompson1917-t1917-057-2>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-057-on-the-theory-of-transformatio-audit-thompson1917-t1917-057-3>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-057-on-the-theory-of-transformatio-audit-thompson1917-t1917-057-4> ;
    pk:hypothesisType "geometric — Thompson (1917) coordinate method: human scapulae after Dwight (Fig. 403)" ;
    pk:weightOfEvidence 6.86e-01 .


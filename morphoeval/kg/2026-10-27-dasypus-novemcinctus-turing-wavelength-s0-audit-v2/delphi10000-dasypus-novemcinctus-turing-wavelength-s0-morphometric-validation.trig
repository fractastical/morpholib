sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 4.108 µm on Holocene Dasypus novemcinctus dermis (Pass 2) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r = 0.999999 and RMSE = 0.524 µm on the sweep. Replicate CV = 0.029. KS statistic between measured and analytic samples is 0.333 with p = 0.93 at n = 6, so the offset is visible but not a significant two-sample rejection. Specimen circularity 0.144 versus 1, band count 12 versus 9, spacing 72 px versus 0. The band counter is a Sobel heuristic, not a histological count." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-ablation-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-ablation-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-saturated-activator-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-movable-band-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-osteoderm-spacing-px>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-sweep-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-sweep-rmse-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-wavelength-replicate-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-ablation-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_amplitude_ratio = 51196.6493 1" ;
        dct:description "The patterned state must be much larger than the ablated state." ;
        schema:measurementTechnique "std(u) with D_v/D_u = 20 divided by std(u) with D_u = D_v" ;
        schema:name "ablation_amplitude_ratio" ;
        schema:unitText "1" ;
        schema:value "51196.6493" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-ablation-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-ablation-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "Equal diffusivities are the negative control; a ratio of 1 would mean the control failed" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-ablation-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_ks_statistic = 0.3333 1" ;
        dct:description "n = 6, so this is a distance, not a precise p-value." ;
        schema:measurementTechnique "Two-sample KS statistic between measured and analytic wavelengths on the sweep" ;
        schema:name "ablation_ks_statistic" ;
        schema:unitText "1" ;
        schema:value "0.3333" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-ablation-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-ablation-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "KS = 0 would mean the measured and analytic samples share a distribution" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-saturated-activator-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "saturated_activator_wavelength_um = 4.5617 µm" ;
        dct:description "Finite-amplitude spots sit long of linear k_c. value != reference." ;
        schema:measurementTechnique "Parabolic peak of the radial Fourier power of the saturated activator" ;
        schema:name "saturated_activator_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "4.5617" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-saturated-activator-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-saturated-activator-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "Linear Turing wavelength pinned to the 4.108 µm detail rung" ;
        schema:value "4.108" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_circularity = 0.1436 1" ;
        dct:description "The carapace silhouette is not circular." ;
        schema:measurementTechnique "4 pi Area / Perimeter^2 of the smoothed foreground mask" ;
        schema:name "specimen_contour_circularity" ;
        schema:unitText "1" ;
        schema:value "0.1436" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "A circle has circularity 1" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_foreground_fraction = 0.3502 1" ;
        dct:description "The animal does not fill the frame." ;
        schema:measurementTechnique "Largest warm-tone component on the CC BY-SA photograph after moss rejection" ;
        schema:name "specimen_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.3502" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "A frame-filling mask would have fraction 1" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-movable-band-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_movable_band_count = 12 count" ;
        dct:description "The peak counter is not a manual band census. value is whatever the profile yields." ;
        schema:measurementTechnique "Peaks in the vertical Sobel profile of the dorsal carapace crop" ;
        schema:name "specimen_movable_band_count" ;
        schema:unitText "count" ;
        schema:value "12" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-movable-band-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-movable-band-count-reference> a schema:PropertyValue ;
        dct:source "The species is named for nine movable bands; Vickaryous & Hall 2006 describe the banded shield" ;
        schema:value "9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-osteoderm-spacing-px> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_osteoderm_spacing_px = 72.0 px" ;
        dct:description "Spacing is in photo pixels and is not converted to 4.1 µm." ;
        schema:measurementTechnique "First autocorrelation peak beyond 8 px on the shoulder-tile crop" ;
        schema:name "specimen_osteoderm_spacing_px" ;
        schema:unitText "px" ;
        schema:value "72.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-osteoderm-spacing-px-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-osteoderm-spacing-px-reference> a schema:PropertyValue ;
        dct:source "Organism-scale photograph pixels, not the 4.108 µm model wavelength" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_structure_tensor_coherency = 0.4108 1" ;
        dct:description "Bands and tile edges raise coherency above 0." ;
        schema:measurementTechnique "Mean structure-tensor coherency on the foreground mask" ;
        schema:name "specimen_structure_tensor_coherency" ;
        schema:unitText "1" ;
        schema:value "0.4108" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "An isotropic field has coherency 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-sweep-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "sweep_pearson_r = 0.999999 1" ;
        dct:description "Reference is the gate, not the measurement." ;
        schema:measurementTechnique "Pearson correlation of measured versus analytic wavelength across six diffusion scales" ;
        schema:name "sweep_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.999999" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-sweep-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-sweep-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Pass gate is r > 0.98; the reported r is the measured correlation" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-sweep-rmse-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "sweep_rmse_um = 0.5243 µm" ;
        dct:description "The offset is the nonlinear red-shift, reported rather than removed." ;
        schema:measurementTechnique "RMSE of measured versus analytic wavelength on the diffusion-scale sweep" ;
        schema:name "sweep_rmse_um" ;
        schema:unitText "µm" ;
        schema:value "0.5243" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-sweep-rmse-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-sweep-rmse-um-reference> a schema:PropertyValue ;
        dct:source "Zero RMSE would be an exact match to the linear law" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-wavelength-replicate-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength_replicate_cv = 0.0293 1" ;
        dct:description "Non-zero CV is the replicate scatter." ;
        schema:measurementTechnique "Sample CV of the saturated wavelength across four RNG seeds" ;
        schema:name "wavelength_replicate_cv" ;
        schema:unitText "1" ;
        schema:value "0.0293" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-wavelength-replicate-cv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-wavelength-replicate-cv-reference> a schema:PropertyValue ;
        dct:source "A deterministic field with no seed dependence would have CV 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py L360–L384" ;
        dct:description "Pearson, RMSE, KS, and replicate CV" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py#L360-L384> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py L494–L605" ;
        dct:description "measure_morphoeval returns values that differ from their references" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py#L494-L605> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (single builder-assessor; second provider still open as R5)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


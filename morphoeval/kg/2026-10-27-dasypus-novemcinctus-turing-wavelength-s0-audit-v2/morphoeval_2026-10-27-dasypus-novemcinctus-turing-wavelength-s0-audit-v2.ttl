<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg Turing wavelength at 4.108 µm on Holocene Dasypus novemcinctus dermis (Pass 2) — Model fidelity to source: 90/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script integrates Schnakenberg kinetics with the Turing wavenumber identity and an equal-diffusion ablation that removes the pattern. Parameters are still reconstructed for the 4.108 µm rung rather than fitted to a Dasypus reaction-diffusion experiment." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;

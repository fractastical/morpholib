        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Schnakenberg Turing wavelength at 4.108 µm on Holocene Dasypus novemcinctus dermis (Pass 2) faithfully reproduces Dasypus novemcinctus (nine-banded armadillo) morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Dasypus novemcinctus (nine-banded armadillo) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py; output: docs/media/dasypus_novemcinctus_turing_wavelength_s0_comparison.png; organism: Dasypus novemcinctus (nine-banded armadillo); environment: python 3.12.3, numpy 2.5.4, scipy 1.18.1, matplotlib 3.11.2, Pillow 13.0.0; claim_boundary: [reported_in_source: Vickaryous and Hall (2006) describe the banded shield and hexagonal osteoderm rosettes of Dasypus novemcinctus. | Turing (1952) gives k_c from the dispersion relation; Schnakenberg (1979) gives the two-species kinetics.; reconstructed_in_script: a=0.10, b=0.90, D_v/D_u=20, D_u solved so linear λ_c=4.108 µm. Sweep scales both diffusivities by 0.64 to 1.69. | Pearson r=0.999999 between measured and analytic wavelengths, RMSE=0.524 µm, replicate CV=0.029, ablation amplitude ratio about 5.1e4. | Photograph segmentation: foreground fraction 0.350, circularity 0.144, coherency 0.411, Sobel band count 12 against the nominal 9, shoulder spacing 72 px.; transfer_boundary: 4.108 µm is the assigned detail rung at 0 Ma, not a length reported by Chen or Vickaryous. The photograph is the whole animal. | The GIF reuses the photograph's mid-frequency edges so the computer-vision comparison is not an independent drawing.; does_not_claim: That osteoderm rosettes are generated by a 4.1 µm Turing instability. | That the Sobel peak count of 12 is a manual census of the nine movable bands. | That RMSE of 0.52 µm has been removed; the correlation is high because the error is a nearly constant factor of 1.12.]; phenomenon_size: 5.5 µm (5.46e-06 m, log10=-5.263 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 5.5 µm to 1.2 cm): 5.5 µm:dasypus-novemcinctus-bioelectric-polarity, 17 µm:dasypus-novemcinctus-vertex-packing, 273 µm:dasypus-novemcinctus-turing-wavelength, 546 µm:dasypus-novemcinctus-clock-wavefront, 1.2 mm:dasypus-novemcinctus-morphogen-condensation, 1.5 mm:dasypus-novemcinctus-elastic-buckling, 1.7 mm:dasypus-novemcinctus-flux-canalization, 2.4 mm:dasypus-novemcinctus-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1002/jmor.10475>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1016/j.jmbbm.2010.12.013>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


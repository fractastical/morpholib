sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Source and data traceability: 84/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "All seven sources carry DOIs (and PMIDs where they exist) in the docstring, the dataset README and paper_citations.bib; the upstream repository is pinned to commit 344863a with file:line references for the borrowed constants; the four fixtures are SHA-256 pinned and verified fail-closed at every run; the Horton & Hoyt fixture records DOI, PMID, formula and comparison range, and the formula is the one Horton & Hoyt published. Deductions: the Rule (2011) fixture's RMS beta error refers to a source-curve file (reports/source-curves/rule-2011-fig8-source-curves.json) that is not vendored, so the digitised Fig. 8 data behind the 0.154 figure cannot be traced from this repository (-6); the upstream Rust repository and the cited params.rs/planform.rs/presets.rs line numbers could not be independently resolved from the repository contents, so the alpha/beta provenance rests on assertion (-5); the paper-scale anchors cite only '2002 §1.1 / §4' without page or equation pinpoints (-3); Klüver (1966) is cited without page for the four-class taxonomy (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-4> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L11–L44" ;
        dct:description "Seven primary sources with DOI/PMID and the upstream commit hash and licence" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L11-L44> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L111–L138" ;
        dct:description "FIXTURE_CHECKSUMS for four JSON inputs and RETINO_CONSTANT_PROVENANCE mapping each map constant to paper or upstream file:line" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L111-L138> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/bressloff/horton_hoyt_1991_magnification.json L1–L15" ;
        dct:description "Empirical anchor fixture with DOI, PMID, formula A/(E+E2), A = 17.3, E2 = 0.75 and comparison range" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/datasets/bressloff/horton_hoyt_1991_magnification.json#L1-L15> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/bressloff/README.md L9–L14" ;
        dct:description "Fixture table with SHA-256, upstream path and description; Horton & Hoyt row marked as created in this repository" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/datasets/bressloff/README.md#L9-L14> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary) + Gemini 4 Argon (independent blinded second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1001/archopht.1991.01080060080030>,
            <https://doi.org/10.1007/BF00336965>,
            <https://doi.org/10.1098/rstb.2000.0769>,
            <https://doi.org/10.1137/23M1616686>,
            <https://doi.org/10.1162/089976602317250861>,
            <https://doi.org/10.1371/journal.pcbi.1002158>,
            <https://github.com/MesmerPrism/bressloff-v1-form-constants>,
            <https://press.uchicago.edu/ucp/books/book/chicago/M/bo3645325.html> .
    <https://doi.org/10.1001/archopht.1991.01080060080030> dct:date "1991"^^xsd:gYear ;
        dct:title "The representation of the visual field in human striate cortex: a revision of the classic Holmes map" .
    <https://doi.org/10.1007/BF00336965> dct:date "1979"^^xsd:gYear ;
        dct:title "A mathematical theory of visual hallucination patterns" .
    <https://doi.org/10.1098/rstb.2000.0769> dct:date "2001"^^xsd:gYear ;
        dct:title "Geometric visual hallucinations, Euclidean symmetry and the functional architecture of striate cortex" .
    <https://doi.org/10.1137/23M1616686> dct:date "2024"^^xsd:gYear ;
        dct:title "A mathematical model of the visual MacKay effect" .
    <https://doi.org/10.1162/089976602317250861> dct:date "2002"^^xsd:gYear ;
        dct:title "What geometric visual hallucinations tell us about the visual cortex" .
    <https://doi.org/10.1371/journal.pcbi.1002158> dct:date "2011"^^xsd:gYear ;
        dct:title "A model for the origin and properties of flicker-induced geometric phosphenes" .
    <https://github.com/MesmerPrism/bressloff-v1-form-constants> dct:title "bressloff-v1-form-constants: reference implementation and calibration reports (commit 344863a)" .
    <https://press.uchicago.edu/ucp/books/book/chicago/M/bo3645325.html> dct:date "1966"^^xsd:gYear ;
        dct:title "Mescal and Mechanisms of Hallucinations" .
}


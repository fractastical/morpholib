sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Reproducibility package: 86/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Two fresh runs produced byte-identical PNG and CSV (SHA-256 match) that are also identical to the artifacts committed in the repository; the script uses no RNG so no seed is needed; all four fixture checksums are verified and a mismatch raises; a requirements.lock.txt pins exact versions with the Python build (3.14.7, numpy 2.5.4, matplotlib 3.10.7, Pillow 12.0.0) matching the venv; --self-test passes 27 checks in about 12 s and --no-show, --out, --csv, --gif, --sweep, --preset and --hemifield-mode all behave as documented in argparse. Deductions: the README section is stale - it says --self-test runs '17 checks ... in ~3 s' (27 PASS lines, ~12-18 s), describes the GIF as 'the same four presets' stepping '1/4 ... 4/4' (the GIF has five, labelled '2/5' etc.), and says 'both hemispheres carry the same bilateral eigenmode so the vertical meridian is continuous' although the default is now full-field (-6); the CLI flags are documented only in argparse, not in the docstring's claim-boundary section (-3); without MPLCONFIGDIR set, matplotlib writes a font cache outside the repository's control, which the invocation notes do not mention (-2); the GIF requires an explicit --gif flag so the committed GIF is not produced by the default invocation (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-4> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L270–L279" ;
        dct:description "verify_fixture_checksums; run_bressloff_analysis raises on mismatch (lines 1581-1584)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L270-L279> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L2621–L2680" ;
        dct:description "CLI: --out, --csv, --gif, --no-show, --self-test, --sweep PARAM[:LO:HI[:N]], --preset, --hemifield-mode" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L2621-L2680> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "requirements.lock.txt L1–L10" ;
        dct:description "Exact pip freeze with Python 3.14.7, matching the venv used for the audit runs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/requirements.lock.txt#L1-L10> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "README.md L437–L441" ;
        dct:description "Stale invocation notes: '17 checks ... ~3 s', 'same four presets', '1/4 ... 4/4' versus 27 checks and a five-preset GIF" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/README.md#L437-L441> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary) + Gemini 4 Argon (independent blinded second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


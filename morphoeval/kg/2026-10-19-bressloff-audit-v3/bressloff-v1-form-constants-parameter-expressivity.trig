sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Parameter expressivity: 52/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Three genuine model parameters are swept and behave as claimed: q* falls monotonically with the lateral surround width (1.46 -> 0.70), rises monotonically with lateral inhibition (0.05 -> 1.00, collapsing to the homogeneous mode at I_lat = 0), and the lateral spread flips the critical parity at about 45 and 90 deg; the --sweep CLI works for any of six parameters and writes a table. Deductions: at every point of all three sweeps the unrestricted cubic selection is 'rhombic', so no swept parameter changes the form-constant family - the tunnel/spiral/cobweb/honeycomb morphospace is controlled by the categorical pattern string and pattern_angle_deg in planform_modes, which are rendering inputs rather than model parameters (-25); the sweeps are displayed only as q* curves, with no gallery of pullbacks along a sweep to show the feature of form changing (-10); pattern_angle_deg, which does control spiral pitch, is neither swept nor shown (-5); the paper-scale wavelength is unreachable because the scan is capped at q = 3.5 (-5); the hemifield-mode toggle is credited as a working chirality control (-3 net)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-4> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L1506–L1560" ;
        dct:description "SWEEPABLE_PARAMS and parameter_sweep record q*, parity and selection; unrestricted_selected_family is rhombic for every value in every sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L1506-L1560> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L982–L1013" ;
        dct:description "planform_modes: the form family is set by the categorical pattern string and pattern_angle_deg, not by any swept coupling parameter" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L982-L1013> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "bressloff_v1_metrics.csv (generated output)" ;
        dct:description "parameter_sweep rows: selected_family 'rhombic' for all three sweeps; q* ranges and parity flips reported but no family change — bressloff_v1_metrics.csv: rendered output of 2001-bressloff-v1-form-constants.py at d6f3c94, text/csv, 10879 B, artifact_sha256 0aabf307f1e286177538d3bf61be79bc46f056afbf2303ee3c7e55229f6b7c35 (sha256 0aabf307f1e286177538d3bf61be79bc46f056afbf2303ee3c7e55229f6b7c35), spec_fingerprint fff701034002726a27d7e6e2ee5c626f921c8d06f78514d8965ad139e7a192a7" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L2139–L2169" ;
        dct:description "Panel F shows only q* vs parameter curves; no rendered pullbacks along the sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L2139-L2169> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary) + Gemini 4 Argon (independent blinded second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


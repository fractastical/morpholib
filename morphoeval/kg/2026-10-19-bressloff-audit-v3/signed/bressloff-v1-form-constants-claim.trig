    <https://doi.org/10.1001/archopht.1991.01080060080030> dcterms:date "1991"^^xsd:gYear ;
        dcterms:title "The representation of the visual field in human striate cortex: a revision of the classic Holmes map" .

    <https://doi.org/10.1007/BF00336965> dcterms:date "1979"^^xsd:gYear ;

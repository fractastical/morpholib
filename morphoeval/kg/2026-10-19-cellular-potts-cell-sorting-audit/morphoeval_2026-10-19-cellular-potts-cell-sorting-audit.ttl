        "1992-graner-cellular-potts-cell-sorting.py L257–L266: CLI parser only accepts --self-test <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py#L257-L266>" ;
    pk:hasScore 4.5e-01 ;

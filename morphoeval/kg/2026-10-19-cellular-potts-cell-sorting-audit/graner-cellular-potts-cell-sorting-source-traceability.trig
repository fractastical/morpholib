sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-graner-cellular-potts-cell-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) extended large-Q Cellular Potts Model cell sorting — Source and data traceability: 64/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Module docstring cites Graner & Glazier (1992) and Glazier & Graner (1993) DOIs (L5-6) and `datasets/cellular_potts_cell_sorting/` exists on disk, but the v1 script does not load `cellular_potts_cell_sorting_reference.json` or verify SHA-256 digests at runtime." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "1992-graner-cellular-potts-cell-sorting.py L5–L7: Cites 2 DOIs in docstring but omits runtime loading and SHA-256 verification of reference dataset <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py#L5-L7>" ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


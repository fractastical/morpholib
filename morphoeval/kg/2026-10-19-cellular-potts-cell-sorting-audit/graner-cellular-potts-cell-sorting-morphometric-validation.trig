sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-graner-cellular-potts-cell-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) extended large-Q Cellular Potts Model cell sorting — Morphometric validation: 52/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Computes normalized radial separation `(r_L - r_D)/R_agg` and final heterotypic boundary fraction `L_LD / L_total` (`measure_morphoeval`, L216-247), but does not fit Graner & Glazier's (1992) Fig. 3 logarithmic boundary decay law `L_het(t) ~ A - B ln(t)`, does not compare simulated radial density profiles against the segmented confocal specimen, and does not quantify `T = 0` pinning arrest vs `T = 10` sorting." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1992-graner-cellular-potts-cell-sorting.py L216–L247: 4 basic synthetic measurements without specimen profile correlation or logarithmic decay fit <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py#L216-L247>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-heterotypic-boundary-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-radial-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-equal-adhesion-control-radial-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-gamma-ld-sorting> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-heterotypic-boundary-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "complete_sorting_heterotypic_boundary_fraction = 0.2023 fraction" ;
        schema:measurementTechnique "Final heterotypic boundary fraction L_LD/L_total after 100 MCS" ;
        schema:name "complete_sorting_heterotypic_boundary_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.2023" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-heterotypic-boundary-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-heterotypic-boundary-fraction-reference> a schema:PropertyValue ;
        schema:value "0.16" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-radial-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "complete_sorting_radial_separation = 0.2665 normalized_radius" ;
        schema:measurementTechnique "Normalized radial separation (r_L - r_D)/R_agg after 100 MCS" ;
        schema:name "complete_sorting_radial_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.2665" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-radial-separation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-radial-separation-reference> a schema:PropertyValue ;
        schema:value "0.3" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-equal-adhesion-control-radial-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_adhesion_control_radial_separation = 0.0653 normalized_radius" ;
        schema:measurementTechnique "Null radial separation in equal-adhesion negative control" ;
        schema:name "equal_adhesion_control_radial_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.0653" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-equal-adhesion-control-radial-separation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-equal-adhesion-control-radial-separation-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-gamma-ld-sorting> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "graner_glazier_gamma_LD_sorting = 3.0 bond_energy_units" ;
        schema:measurementTechnique "Interfacial tension gamma_LD = J_LD - (J_LL + J_DD)/2 (Graner & Glazier 1992 PRL Eq. 2)" ;
        schema:name "graner_glazier_gamma_LD_sorting" ;
        schema:unitText "bond_energy_units" ;
        schema:value "3.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-gamma-ld-sorting-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-gamma-ld-sorting-reference> a schema:PropertyValue ;
        schema:value "3.0" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/newbio239098a0>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> .
    <https://doi.org/10.1038/newbio239098a0> dct:date "1972"^^xsd:gYear ;
        dct:title "Regeneration of Hydra from reaggregated cells" .
    <https://doi.org/10.1103/PhysRevE.47.2128> dct:date "1993"^^xsd:gYear ;
        dct:title "Simulation of the differential adhesion driven rearrangement of biological cells" .
    <https://doi.org/10.1103/PhysRevLett.69.2013> dct:date "1992"^^xsd:gYear ;
        dct:title "Simulation of biological cell sorting using a two-dimensional extended Potts model" .
    <https://doi.org/10.1126/science.141.3579.401> dct:date "1963"^^xsd:gYear ;
        dct:title "Reconstruction of tissues by dissociated cells" .
    <https://doi.org/10.1242/dev.122.5.1611> dct:date "1996"^^xsd:gYear ;
        dct:title "Surface tensions of embryonic tissues predict their mutual envelopment behavior" .
}


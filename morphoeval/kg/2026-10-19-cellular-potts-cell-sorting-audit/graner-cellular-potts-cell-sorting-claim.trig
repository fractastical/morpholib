sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-graner-cellular-potts-cell-sorting> a pk:Claim ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) extended large-Q Cellular Potts Model cell sorting faithfully reproduces Hydra attenuata (endoderm/ectoderm reaggregates) & Gallus gallus embryonic cell spheroids morphology" ;
        dct:description "The simulation script(s) 1992-graner-cellular-potts-cell-sorting.py implement the cited source model as published and produce forms that match real Hydra attenuata (endoderm/ectoderm reaggregates) & Gallus gallus embryonic cell spheroids specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 54.3/100, audit 2026-10-19-cellular-potts-cell-sorting-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py; output: docs/media/cellular_potts_cell_sorting_comparison.png; organism: Hydra attenuata (endoderm/ectoderm reaggregates) & Gallus gallus embryonic cell spheroids; checkpoint commit: https://github.com/fractastical/morpholib/commit/b9976f8; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 7cdd3f38f0e6192e614f25f3f47d81cb4d09870705b0e0dca1d1d4dbca9f4cc0; artifact_sha256: b3ded3b1b7a92e2f9206bc3251afdf0f0f31bff3b9a80e60a5da45a5baa1c475" ;
        pk:derivedFromPaper <https://doi.org/10.1038/newbio239098a0>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-specimen-match> ;
        pk:weightOfEvidence "0.543"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py> a schema:SoftwareSourceCode ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "b9976f8" .
}


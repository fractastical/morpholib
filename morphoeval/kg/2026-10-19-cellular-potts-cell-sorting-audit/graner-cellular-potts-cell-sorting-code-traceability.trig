sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-graner-cellular-potts-cell-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) extended large-Q Cellular Potts Model cell sorting — Code-to-model traceability: 68/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Functions correspond to CPM surface tensions and Metropolis spin copy updates, and `morphoeval/lean/loops/Loop_042_cellular_potts_cell_sorting.lean` proves 3 theorems, but v1 docstrings lack equation-by-equation mappings to Graner & Glazier (1992) Eqs. 1-3 & Fig. 3 and Glazier & Graner (1993) Table I & Section III.B." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1992-graner-cellular-potts-cell-sorting.py L28–L177: Baseline functions lack detailed equation-number citations to Graner & Glazier (1992) and Glazier & Graner (1993) <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py#L28-L177>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-code-traceability-1> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_042_cellular_potts_cell_sorting.lean L1–L99" ;
        dct:description "3 machine-checked Lean 4 theorems for CPM surface tensions, 4 phase regimes, and volume elasticity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/morphoeval/lean/loops/Loop_042_cellular_potts_cell_sorting.lean#L1-L99> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


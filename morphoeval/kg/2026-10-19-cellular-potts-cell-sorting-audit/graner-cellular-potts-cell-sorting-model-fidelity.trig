            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> .
    <https://doi.org/10.1038/newbio239098a0> dct:date "1972"^^xsd:gYear ;
        dct:title "Regeneration of Hydra from reaggregated cells" .
    <https://doi.org/10.1103/PhysRevE.47.2128> dct:date "1993"^^xsd:gYear ;
        dct:title "Simulation of the differential adhesion driven rearrangement of biological cells" .
    <https://doi.org/10.1103/PhysRevLett.69.2013> dct:date "1992"^^xsd:gYear ;
        dct:title "Simulation of biological cell sorting using a two-dimensional extended Potts model" .
    <https://doi.org/10.1126/science.141.3579.401> dct:date "1963"^^xsd:gYear ;
        dct:title "Reconstruction of tissues by dissociated cells" .
    <https://doi.org/10.1242/dev.122.5.1611> dct:date "1996"^^xsd:gYear ;
        dct:title "Surface tensions of embryonic tissues predict their mutual envelopment behavior" .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-graner-cellular-potts-cell-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) extended large-Q Cellular Potts Model cell sorting — Model fidelity to source: 67/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements the Graner & Glazier (1992) PRL Eqs. (2)-(3) interfacial tension formulas (`compute_cpm_tensions`, L28-44) and the 2D extended Cellular Potts Hamiltonian with 8-neighbor bond energies and quadratic volume elasticity (`simulate_cpm_sorting_v1`, L47-177) for complete engulfment (`gamma_LD=3`) and an equal-adhesion negative control (`gamma_LD=0`). However, v1 omits partial sorting / lens formation (`gamma_LD > gamma_DM - gamma_LM`), checkerboard mixing (`gamma_LD < 0`), cell dissociation (`gamma_LM < 0`), and Glazier & Graner's (1993) zero-temperature `T = 0` pinning arrest vs high-`T` melting controls." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1992-graner-cellular-potts-cell-sorting.py L47–L177: 2D Cellular Potts solver simulates only complete sorting and equal-adhesion control, omitting partial lens, checkerboard, dissociation, and T=0 pinning arrest <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py#L47-L177>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-model-fidelity-1> ;
        pk:hasScore "0.67"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py L28–L44" ;
        dct:description "Graner & Glazier (1992) PRL Eqs. 2-3 surface tension formulas gamma_LD, gamma_LM, gamma_DM" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py#L28-L44> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


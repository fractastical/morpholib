sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-graner-cellular-potts-cell-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) extended large-Q Cellular Potts Model cell sorting — Parameter expressivity: 45/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates only 2 hardcoded parameter sets (`J_LD=11` sorting vs `J=10` control) without a continuous sweep across `J_LD` (or `gamma_LD`), without mapping temperature regimes (`T = 0` pinning arrest, `T = 10` optimal sorting, `T = 80` thermal melting), and without CLI parameter flags (`main`, L257-266)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1992-graner-cellular-potts-cell-sorting.py L183–L184: Only 2 hardcoded parameter points evaluated in render_outputs_v1 <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py#L183-L184>",
            "1992-graner-cellular-potts-cell-sorting.py L257–L266: CLI parser only accepts --self-test <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py#L257-L266>" ;
        pk:hasScore "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-graner-cellular-potts-cell-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) extended large-Q Cellular Potts Model cell sorting — Reproducibility package: 67/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Uses deterministic `np.random.default_rng(1992)` and provides `--self-test` and `measure_morphoeval()` (L216-255), but `self_test()` checks only 2 basic assertions without SHA-256 dataset verification, 4-regime phase classification parity, temperature pinning checks, or two-run bitwise determinism checks." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "1992-graner-cellular-potts-cell-sorting.py L250–L255: Minimal 2-check self_test() without SHA-256 verification or determinism check <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py#L250-L255>" ;
        pk:hasScore "0.67"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-graner-cellular-potts-cell-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) extended large-Q Cellular Potts Model cell sorting — Morphological realism / specimen match: 35/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Although `datasets/cellular_potts_cell_sorting/embryonic_cell_aggregate_specimen.jpg` is vendored on disk, the v1 script never loads, verifies, or segments the confocal embryonic cell aggregate specimen (`render_outputs_v1`, L180-213) and renders only a 3-panel synthetic figure." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1992-graner-cellular-potts-cell-sorting.py L180–L213: render_outputs_v1 renders 3 synthetic panels without loading or segmenting embryonic_cell_aggregate_specimen.jpg <https://github.com/fractastical/morpholib/blob/b9976f8/1992-graner-cellular-potts-cell-sorting.py#L180-L213>",
            "docs/media/cellular_potts_cell_sorting_comparison.png (generated output, not in repo): 3-panel synthetic figure without biological specimen segmentation or radial fluorescence overlay — docs/media/cellular_potts_cell_sorting_comparison.png: rendered output of 1992-graner-cellular-potts-cell-sorting.py at b9976f8, image/png, 66410 B, 1430×494 px, artifact_sha256 b3ded3b1b7a92e2f9206bc3251afdf0f0f31bff3b9a80e60a5da45a5baa1c475 (sha256 b3ded3b1b7a92e2f9206bc3251afdf0f0f31bff3b9a80e60a5da45a5baa1c475), spec_fingerprint 7cdd3f38f0e6192e614f25f3f47d81cb4d09870705b0e0dca1d1d4dbca9f4cc0" ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


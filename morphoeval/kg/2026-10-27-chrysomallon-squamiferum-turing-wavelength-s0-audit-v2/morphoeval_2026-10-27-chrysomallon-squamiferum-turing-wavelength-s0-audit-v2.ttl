<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Schnakenberg fastest-mode wavelength at 2.0 nm on Chrysomallon squamiferum (Pass 2) (Chrysomallon squamiferum (Holocene extant, 0 Ma))",
        "Schnakenberg fastest-mode wavelength at 2.0 nm on Chrysomallon squamiferum (Pass 2) faithfully reproduces Chrysomallon squamiferum (Holocene extant, 0 Ma) morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-1>,

<https://w3id.org/delphi/resource/math-law/delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing critical wavenumber" ;
    dct:description "Selects the detail-scale wavelength on the Holocene sclerite matrix | Variables: f_u=892e-3, g_v=-1313e-3, D_v/D_u=36, lambda_c=2.0 nm, age=0 Ma" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/6f01b4c5e4c9fa53e8bf2c8825be8b7ccb7fba3c/models/2026-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/6f01b4c5e4c9fa53e8bf2c8825be8b7ccb7fba3c/morphoeval/lean/loops/Loop_3147_chrysomallon_squamiferum_turing_wavelength_s0.lean#L40-L43> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/s41467-020-15522-3>,
        <https://doi.org/10.1038/s42003-025-07785-7>,
        <https://doi.org/10.1073/pnas.0912988107>,
        <https://doi.org/10.1093/mollus/eyv013>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/zoj.12279>,
        <https://doi.org/10.1126/science.1087696> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3147.kc2_division_algorithm" ;
    pk:leanTheorem "MathOfBiology.Loop_3147.kc2_division_algorithm" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-2> a skos:Concept,

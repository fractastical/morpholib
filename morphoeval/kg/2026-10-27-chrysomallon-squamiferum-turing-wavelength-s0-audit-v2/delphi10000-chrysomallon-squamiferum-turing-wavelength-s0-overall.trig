sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg fastest-mode wavelength at 2.0 nm on Chrysomallon squamiferum (Pass 2) — MorphoEval overall 87.1/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 2 scales D_u and D_v so the maximum of σ(k) lies on the requested wavelength, then applies one nonlinear correction learned at 2.0 nm. Sweep targets 1.35, 1.70, 2.00, 2.35, 2.80, 3.30 nm give PDE peaks 1.229, 1.559, 1.935, 2.211, 2.620, 2.970 nm (Pearson r=0.9964, RMSE=0.182 nm, residual CV=0.043). Equal-diffusion ablation ratio is 6.5e-12. Paratype mask foreground fraction 0.394 (prior 0.55), circularity 0.118 (circle would be 1), specimen coherency 0.310 versus composite 0.345, intensity KS=0.248. GIF is 12 frames at 640×480. Chronoseries 1/1 at 0 Ma; successor none; comparative predecessor is sclerite-less Gigantopelta. Overall 87.1/100 (faithfulness 86.1, reproducibility 89.6); rubric morphoeval 0.1.0; checkpoint commit 6f01b4c5e4c9fa53e8bf2c8825be8b7ccb7fba3c; environment: python 3.12.3, numpy 2.5.4, scipy 1.18.1, matplotlib 3.11.2, Pillow 13.0.0. Dimension assessments: Model fidelity to source 86, Morphological realism / specimen match 83, Parameter expressivity 88, Morphometric validation 90, Source and data traceability 92, Code-to-model traceability 86, Reproducibility package 90. Output judged: docs/media/chrysomallon_squamiferum_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0.py at 6f01b4c5e4c9fa53e8bf2c8825be8b7ccb7fba3c, image/png, 505249 B, 1248×960 px, artifact_sha256 f78b2d8abd16f668188f1f75d9a33d749cbc8e44b01e0b5814be146d1e378f5d (sha256 f78b2d8abd16f668188f1f75d9a33d749cbc8e44b01e0b5814be146d1e378f5d), spec_fingerprint e0865ee451716d4a3fa5bd6b6983a8391e5da7f8dc195fece7fe187c823b6b31. Dual provenance: spec_fingerprint: 5a948670023100da2057a11d9e5a60a14e996d44987bb98d540f2f6d1fbf8647; artifact_sha256: 894a567dd3d326cd5cec89d99c30cd84dcd4141bbd9eb2f0cc050f1db3e29430; input_dataset_sha256: {README.md=31eb13a5a96c590c..., chrysomallon_squamiferum_specimen.jpg=0312a80d873d68d2..., paper_citations.bib=63b7c502b791e3c1..., scout_manifest.json=ea589eba9289f0c9...}. Supersedes audit: 2026-10-27-chrysomallon-squamiferum-turing-wavelength-s0-audit. Claim boundary: reported_in_source: Iron-sulfide sclerites (Warén 2003); armor mechanics without a Turing equation (Yao 2010) | Sclerite-less Gigantopelta as the comparative predecessor (Chen 2015; Wong 2025) | Turing 1952 dispersion and Schnakenberg 1979 kinetics; reconstructed_in_script: Fastest-mode diffusivity calibration, six-point PDE wavelength sweep, equal-diffusion ablation | Paratype segmentation, KS test, coherency, and circularity | Copper activator overlay on the sclerite mask in a 12-frame GIF; transfer_boundary: 2.0 nm is the assigned detail-scale critical wavelength (~2 greigite cells), not a measured pigment stripe. | Matrix-confined diffusivities are assumed so that a molecular wavelength can be selected.; does_not_claim: Does not claim a TEM measurement of 2.0 nm nuclei | Does not claim the copper spots are the animal's visible color | Does not claim a fossil chronospecies before or after 0 Ma." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: {'id': 'R5', 'item': 'Only one paratype photograph. A population of sclerite outlines would test whether foreground fraction and circularity are specimen-specific.'}",
            "remediation needed: {'id': 'R6', 'item': 'No transmission-electron measurement at 2.0 nm. The wavelength is the calibrated critical mode, about two greigite cells, not a counted nucleation spacing.'}",
            "remediation needed: {'id': 'R7', 'item': 'Builder-assessor only. An independent second scorer has not re-read the transfer boundary.'}" ;
        pk:hasScore "0.871"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


        rdfs:label "datasets/thompson_1917/t1917-010/t1917_010_the_rate_of_growth_reference.json L1–L200" ;
        dct:description "sha256_digests, ia_scan, primary_sources_consulted, pre_scouted_dataset" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/6f3b0adec/datasets/thompson_1917/t1917-010/t1917_010_the_rate_of_growth_reference.json#L1-L200> .

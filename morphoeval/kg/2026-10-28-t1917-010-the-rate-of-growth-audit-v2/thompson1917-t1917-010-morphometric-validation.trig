}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-010> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-010-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-010-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) regeneration as a lawful growth process — Durbin/Ellis tadpole tail curves — Morphometric validation: 80/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Fits are compared against Thompson's own printed tables with r, RMSE, exact permutation p-values, null-model RMSE ratios, KS statistics and the plateau CV; eight measurements carry explicit reference values (Thompson's n = 2, day 7, 1/3, 65 %, 0.46, r = 1). Weakness: n = 4 series for the Ellis tests (permutation floor p = 1/24) and n = 7-10 points per Durbin series." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-010_the-rate-of-growth.py L326–L333: 4! = 24 permutations only <https://github.com/fractastical/morpholib/blob/6f3b0adec/thompson/claims/t1917-010_the-rate-of-growth.py#L326-L333>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expii-exp-approach-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expii-hyperbolic-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expiv-gompertz-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expiv-inflection-day>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-velocity-exp-k>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-velocity-power-exponent>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-day9-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-isochrone-beta-mean>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-plateau-fraction-mean>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-plateau-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-specimen-tail-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-sweep-r-isochrone-gamma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-morphometric-validation-3> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expii-exp-approach-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "durbin_expII_exp_approach_rmse = 0.089353 mm" ;
        schema:measurementTechnique "curve_fit L_inf(1-exp(-k(t-t0))); KS resid D=0.30 p=0.47; constant-velocity null RMSE x13.5" ;
        schema:name "durbin_expII_exp_approach_rmse" ;
        schema:unitText "mm" ;
        schema:value "0.089353" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expii-hyperbolic-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "durbin_expII_hyperbolic_rmse = 0.460299 mm" ;
        schema:measurementTechnique "curve_fit L_inf - c/t (Thompson's V t^2 = const integrated) vs exponential alternative" ;
        schema:name "durbin_expII_hyperbolic_rmse" ;
        schema:unitText "mm" ;
        schema:value "0.460299" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expiv-gompertz-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "durbin_expIV_gompertz_r = 0.996195 dimensionless" ;
        schema:measurementTechnique "Pearson r fitted vs observed (10 points)" ;
        schema:name "durbin_expIV_gompertz_r" ;
        schema:unitText "dimensionless" ;
        schema:value "0.996195" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expiv-inflection-day> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "durbin_expIV_inflection_day = 6.349334 day" ;
        schema:measurementTechnique "Gompertz ln(b)/c; argmax of printed daily increments = day 7" ;
        schema:name "durbin_expIV_inflection_day" ;
        schema:unitText "day" ;
        schema:value "6.349334" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expiv-inflection-day-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-expiv-inflection-day-reference> a schema:PropertyValue ;
        dct:source "Thompson (1917) Ch. III p. 144: 'a visible point of inflection in the curve about the seventh day'" ;
        schema:value "7.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-velocity-exp-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "durbin_velocity_exp_k = 0.100879 1/day" ;
        schema:measurementTechnique "OLS log V vs t (Fig. 37 straight line), r=-0.991" ;
        schema:name "durbin_velocity_exp_k" ;
        schema:unitText "1/day" ;
        schema:value "0.100879" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-velocity-power-exponent> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "durbin_velocity_power_exponent = 1.311573 dimensionless" ;
        schema:measurementTechnique "OLS log V vs log t on Thompson's interpolated increments; sweep RMSE minimum at n=1.20" ;
        schema:name "durbin_velocity_power_exponent" ;
        schema:unitText "dimensionless" ;
        schema:value "1.311573" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-velocity-power-exponent-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-durbin-velocity-power-exponent-reference> a schema:PropertyValue ;
        dct:source "Thompson (1917) Ch. III p. 143: 'the velocity varies, or tends to vary, inversely as the square of the time'" ;
        schema:value "2.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-day9-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ellis_day9_pearson_r = 0.993038 dimensionless" ;
        schema:measurementTechnique "Pearson r, mm regenerated vs mm removed (n=4); exact permutation control p=0.042" ;
        schema:name "ellis_day9_pearson_r" ;
        schema:unitText "dimensionless" ;
        schema:value "0.993038" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-day9-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-day9-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Thompson (1917) Ch. III p. 148: amount regenerated increases with amount removed (perfect proportionality would give r = 1)" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-isochrone-beta-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ellis_isochrone_beta_mean = 0.346577 dimensionless" ;
        schema:measurementTechnique "log-log slope of t_q vs R, q=10..40 (cubic parabola <=> 1/3)" ;
        schema:name "ellis_isochrone_beta_mean" ;
        schema:unitText "dimensionless" ;
        schema:value "0.346577" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-isochrone-beta-mean-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-isochrone-beta-mean-reference> a schema:PropertyValue ;
        dct:source "Thompson (1917) Ch. III p. 149, Fig. 40: 'each curve approximates in form to a cubic parabola'" ;
        schema:value "0.3333" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-plateau-fraction-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ellis_plateau_fraction_mean = 0.46 fraction" ;
        schema:measurementTechnique "mean of 44,44,48,48 % with CV=0.043" ;
        schema:name "ellis_plateau_fraction_mean" ;
        schema:unitText "fraction" ;
        schema:value "0.46" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-plateau-fraction-mean-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-plateau-fraction-mean-reference> a schema:PropertyValue ;
        dct:source "Thompson (1917) Ch. III p. 146/148: restoration 'falls somewhat short' of complete (printed 44-48 %)" ;
        schema:value "0.46" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-plateau-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ellis_plateau_pearson_r = 0.999738 dimensionless" ;
        schema:measurementTechnique "Pearson r at day-32 plateau; R-independent null RMSE / proportional-model RMSE = 19.2" ;
        schema:name "ellis_plateau_pearson_r" ;
        schema:unitText "dimensionless" ;
        schema:value "0.999738" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-plateau-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-ellis-plateau-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Thompson (1917) Ch. III p. 148 (Ellis 1909)" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-specimen-tail-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_tail_fraction = 0.655462 fraction" ;
        schema:measurementTechnique "CV threshold + principal axis + width profile on vendored L. clamitans photo (tail = terminal monotone taper; boundary at half-decay of the posterior body bulge)" ;
        schema:name "specimen_tail_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.655462" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-specimen-tail-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-specimen-tail-fraction-reference> a schema:PropertyValue ;
        dct:source "Thompson (1917) Ch. III p. 148: tail 'very near to 26 mm., or 65 per cent. of the whole body-length' (Durbin p. 138: 21.2/34.2 = 0.62)" ;
        schema:value "0.65" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-measurement-sweep-r-isochrone-gamma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "sweep_R_isochrone_gamma = 0.003165 dimensionless" ;
        schema:measurementTechnique "asymptote exponent in t_q = a R^(1/3) (75/(75-R))^gamma, monotone=True" ;
        schema:name "sweep_R_isochrone_gamma" ;
        schema:unitText "dimensionless" ;
        schema:value "0.003165" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-010_the-rate-of-growth.py L326–L362" ;
        dct:description "permutation_test_r, ablation_controls, residual_statistics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/6f3b0adec/thompson/claims/t1917-010_the-rate-of-growth.py#L326-L362> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-010_the-rate-of-growth.py L775–L813" ;
        dct:description "measure_morphoeval with reference_value/reference_source" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/6f3b0adec/thompson/claims/t1917-010_the-rate-of-growth.py#L775-L813> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-010-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-010/result.json L1–L80" ;
        dct:description "headline_numbers, controls, specimen_cv, caveats" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/6f3b0adec/datasets/thompson_1917/t1917-010/result.json#L1-L80> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval cloud loop 208, Pass 2 self-audit)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0001-9184-8944> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0000-0001-9184-8944>,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1002/jez.1400070302>,
            <https://doi.org/10.1002/jez.1400070303>,
            <https://doi.org/10.1098/rsbl.2019.0151>,
            <https://www.inaturalist.org/observations/137092396> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form" .
    <https://doi.org/10.1002/jez.1400070302> dct:date "1909"^^xsd:gYear ;
        dct:title "An analysis of the rate of regeneration throughout the regenerative process" .
    <https://doi.org/10.1002/jez.1400070303> dct:date "1909"^^xsd:gYear ;
        dct:title "The relation of the amount of tail regenerated to the amount removed in tadpoles of Rana clamitans" .
    <https://doi.org/10.1098/rsbl.2019.0151> dct:date "2019"^^xsd:gYear ;
        dct:title "Tail loss and telomeres: consequences of large-scale tissue regeneration in a terrestrial ectotherm" .
    <https://www.inaturalist.org/observations/137092396> dct:date "2022"^^xsd:gYear ;
        dct:title "Lithobates clamitans tadpole, lateral view (iNaturalist observation 137092396, photo 234072694, CC BY 4.0)" .
}


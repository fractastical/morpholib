sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-029> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-morphometric-validation-builder-assessor-claude-fable-5-1> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-morphometric-validation-builder-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-029: logarithmic-spiral chamber succession with constant ratio vs Shi (2021) fusulinid half-whorl series (Pass 2) — Morphometric validation: 80/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "106 specimens x ~13 stages with per-specimen r / relative RMSE / ratio CV / BIC, genus means with bootstrap 95 % CIs, early/mid/late-third drift with Kruskal-Wallis p, KS of pooled residuals, Monte-Carlo gap test, two independent CV whorl ratios, Thompson's printed series refitted, and four controls through the identical rules — the pre-registered T1-T4 now discriminate (real data 3/4 vs shuffled 1/4 vs exact-geometric 4/4). Docked because the i.i.d. control is a boundary case rather than a true negative, KS rejects normality (honestly reported), and the T2 10 % drift limit is a pre-registered convention rather than a value Thompson stated." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L655–L657: iid control passes 4/4 by construction (boundary control, not a negative) <https://github.com/fractastical/morpholib/blob/12d9d136ee5632ff58f859a3df2645e58ace3576/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L655-L657>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-cv-whorl-ratio-from-the-fusulinid-thin-section-joint-up-down-fit>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-cv-whorl-ratio-of-thompson-s-fig-309-nummulina-antiquior-engraving>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-fraction-of-specimens-where-geometric-beats-arithmetic-growth-bic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-ks-p-value-of-standardized-ln-residuals-vs-n-0-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-monte-carlo-p-of-the-largest-interior-gap-in-the-pooled-ratio-distribution>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pooled-median-cv-of-successive-half-whorl-ratios>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pooled-median-pearson-r-of-ln-d-k-vs-k-geometric-succession>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pooled-median-relative-rmse-of-the-geometric-fit>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pseudoschwagerina-half-whorl-growth-ratio-mean>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-robustoschwagerina-half-whorl-growth-ratio-mean>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-shuffled-stage-negative-control-median-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-sphaeroschwagerina-half-whorl-growth-ratio-mean>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-triticites-half-whorl-growth-ratio-mean-of-per-specimen-log-linear-fits>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-triticites-ontogenetic-ratio-drift-early-mid-late-thirds>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-van-iterson-triloculina-chamber-ratio-refit>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-von-moller-f-cylindrica-half-whorl-ratio-refit>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-zellia-half-whorl-growth-ratio-mean>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-morphometric-validation-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-morphometric-validation-4> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-cv-whorl-ratio-from-the-fusulinid-thin-section-joint-up-down-fit> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "CV whorl ratio from the fusulinid thin section (joint up/down fit) = 1.4936 ratio" ;
        dct:description "r = 0.952; Dryad Triticites whorl ratio 1.534" ;
        schema:measurementTechnique "dark whorl walls detected on sector-median radial profiles (13 walls), ln r vs whorl index with half-whorl offset; sector-width sensitivity sd 0.105" ;
        schema:name "CV whorl ratio from the fusulinid thin section (joint up/down fit)" ;
        schema:unitText "ratio" ;
        schema:value "1.4936" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-cv-whorl-ratio-from-the-fusulinid-thin-section-joint-up-down-fit-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-cv-whorl-ratio-from-the-fusulinid-thin-section-joint-up-down-fit-reference> a schema:PropertyValue ;
        dct:source "Thompson 1917 p. 593 (von Moller Fusulina whorl ratio 1.5)" ;
        schema:value "1.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-cv-whorl-ratio-of-thompson-s-fig-309-nummulina-antiquior-engraving> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "CV whorl ratio of Thompson's Fig. 309 Nummulina antiquior (engraving) = 1.6085 ratio" ;
        dct:description "alpha = 85.7 deg; differs from the fusulinid 1.5 as Thompson's 'genera differ in constant angle' (p. 601) requires" ;
        schema:measurementTechnique "geometric mean of 17 consecutive bright-wall radius ratios in 8 radial sectors (sd 0.182); coarse: oblique shaded engraving" ;
        schema:name "CV whorl ratio of Thompson's Fig. 309 Nummulina antiquior (engraving)" ;
        schema:unitText "ratio" ;
        schema:value "1.6085" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-fraction-of-specimens-where-geometric-beats-arithmetic-growth-bic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Fraction of specimens where geometric beats arithmetic growth (BIC) = 1.0 fraction" ;
        schema:measurementTechnique "BIC of log-linear vs linear-in-k model on ln D residuals; alternative-model control (arithmetic-growth negative control: 0.00)" ;
        schema:name "Fraction of specimens where geometric beats arithmetic growth (BIC)" ;
        schema:unitText "fraction" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-ks-p-value-of-standardized-ln-residuals-vs-n-0-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "KS p-value of standardized ln-residuals vs N(0,1) = 0.0007 p-value" ;
        schema:measurementTechnique "two-sided Kolmogorov-Smirnov test on 1364 pooled standardized residuals of the log-linear fits (D = 0.054)" ;
        schema:name "KS p-value of standardized ln-residuals vs N(0,1)" ;
        schema:unitText "p-value" ;
        schema:value "0.0007" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-monte-carlo-p-of-the-largest-interior-gap-in-the-pooled-ratio-distribution> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Monte-Carlo p of the largest interior gap in the pooled ratio distribution = 0.7402 p-value" ;
        schema:measurementTechnique "4000 normal-null simulations of n=106 ratios; observed gap 0.0079 vs null median 0.0094 (continuity of the genus series)" ;
        schema:name "Monte-Carlo p of the largest interior gap in the pooled ratio distribution" ;
        schema:unitText "p-value" ;
        schema:value "0.7402" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pooled-median-cv-of-successive-half-whorl-ratios> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pooled median CV of successive half-whorl ratios = 0.076 CV" ;
        dct:description "Thompson p. 595: ratio 'not strictly constant ... small secondary fluctuation'" ;
        schema:measurementTechnique "std/mean of D_{k+1}/D_k within specimen, median over specimens — dispersion of the 'constant' ratio" ;
        schema:name "Pooled median CV of successive half-whorl ratios" ;
        schema:unitText "CV" ;
        schema:value "0.076" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pooled-median-pearson-r-of-ln-d-k-vs-k-geometric-succession> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pooled median Pearson r of ln D_k vs k (geometric succession) = 0.9953 r" ;
        schema:measurementTechnique "per-specimen Pearson correlation of ln(test diameter) with half-whorl stage, median over 106 specimens" ;
        schema:name "Pooled median Pearson r of ln D_k vs k (geometric succession)" ;
        schema:unitText "r" ;
        schema:value "0.9953" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pooled-median-pearson-r-of-ln-d-k-vs-k-geometric-succession-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pooled-median-pearson-r-of-ln-d-k-vs-k-geometric-succession-reference> a schema:PropertyValue ;
        dct:source "Thompson 1917 p. 593: 'successive whorls very nearly in the ratio 1:1.5' (exact log-linearity)" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pooled-median-relative-rmse-of-the-geometric-fit> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pooled median relative RMSE of the geometric fit = 0.0932 fraction" ;
        schema:measurementTechnique "sqrt(mean(((D - D_hat)/D)^2)) per specimen, median" ;
        schema:name "Pooled median relative RMSE of the geometric fit" ;
        schema:unitText "fraction" ;
        schema:value "0.0932" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-pseudoschwagerina-half-whorl-growth-ratio-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pseudoschwagerina half-whorl growth ratio (mean) = 1.2985 ratio" ;
        dct:description "CI [1.274, 1.322]; drift 14.8% (KW p=1.5e-17)" ;
        schema:measurementTechnique "as above, per genus; bootstrap 95 % CI" ;
        schema:name "Pseudoschwagerina half-whorl growth ratio (mean)" ;
        schema:unitText "ratio" ;
        schema:value "1.2985" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-robustoschwagerina-half-whorl-growth-ratio-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Robustoschwagerina half-whorl growth ratio (mean) = 1.3181 ratio" ;
        dct:description "CI [1.302, 1.335]; drift 14.7% (KW p=1.5e-23)" ;
        schema:measurementTechnique "as above, per genus; bootstrap 95 % CI" ;
        schema:name "Robustoschwagerina half-whorl growth ratio (mean)" ;
        schema:unitText "ratio" ;
        schema:value "1.3181" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-shuffled-stage-negative-control-median-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Shuffled-stage negative control: median r = -0.027 r" ;
        schema:measurementTechnique "verdict rules re-run on within-specimen shuffled stage order (null control; T1 must fail)" ;
        schema:name "Shuffled-stage negative control: median r" ;
        schema:unitText "r" ;
        schema:value "-0.027" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-sphaeroschwagerina-half-whorl-growth-ratio-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Sphaeroschwagerina half-whorl growth ratio (mean) = 1.3289 ratio" ;
        dct:description "CI [1.317, 1.344]; drift 15.2% (KW p=1.3e-15)" ;
        schema:measurementTechnique "as above, per genus; bootstrap 95 % CI" ;
        schema:name "Sphaeroschwagerina half-whorl growth ratio (mean)" ;
        schema:unitText "ratio" ;
        schema:value "1.3289" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-triticites-half-whorl-growth-ratio-mean-of-per-specimen-log-linear-fits> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Triticites half-whorl growth ratio (mean of per-specimen log-linear fits) = 1.2385 ratio" ;
        dct:description "sd 0.021; 95 % CI [1.232, 1.245]; whorl ratio 1.534 vs Thompson 1.5" ;
        schema:measurementTechnique "slope of ln D_k on half-whorl index k per specimen, exp(slope), mean over 40 Triticites specimens (Dryad doi:10.5061/dryad.sn02v6x26); bootstrap 95 % CI" ;
        schema:name "Triticites half-whorl growth ratio (mean of per-specimen log-linear fits)" ;
        schema:unitText "ratio" ;
        schema:value "1.2385" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-triticites-half-whorl-growth-ratio-mean-of-per-specimen-log-linear-fits-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-triticites-half-whorl-growth-ratio-mean-of-per-specimen-log-linear-fits-reference> a schema:PropertyValue ;
        dct:source "Thompson 1917 p. 593 (von Moller 1878 Fusulina, 0.088 log10 per half-whorl)" ;
        schema:value "1.225" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-triticites-ontogenetic-ratio-drift-early-mid-late-thirds> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Triticites ontogenetic ratio drift (early/mid/late thirds) = 0.0463 fraction" ;
        schema:measurementTechnique "(max - min)/mean of the three stage-third mean ratios pooled over the genus; Kruskal-Wallis p = 1.4e-14" ;
        schema:name "Triticites ontogenetic ratio drift (early/mid/late thirds)" ;
        schema:unitText "fraction" ;
        schema:value "0.0463" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-triticites-ontogenetic-ratio-drift-early-mid-late-thirds-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-triticites-ontogenetic-ratio-drift-early-mid-late-thirds-reference> a schema:PropertyValue ;
        dct:source "pre-registered T2 limit (Thompson's 'small secondary fluctuation')" ;
        schema:value "0.1" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-van-iterson-triloculina-chamber-ratio-refit> a schema:PropertyValue,

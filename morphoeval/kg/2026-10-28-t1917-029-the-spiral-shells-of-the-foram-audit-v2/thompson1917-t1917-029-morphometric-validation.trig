        schema:unitText "ratio" ;
        schema:value "1.2243" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-von-moller-f-cylindrica-half-whorl-ratio-refit-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-von-moller-f-cylindrica-half-whorl-ratio-refit-reference> a schema:PropertyValue ;
        dct:source "Thompson 1917 p. 593" ;
        schema:value "1.225" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-measurement-zellia-half-whorl-growth-ratio-mean> a schema:PropertyValue,

<https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-morphometric-validation-builder-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
    rdfs:label "Thompson (1917) T1917-029: logarithmic-spiral chamber succession with constant ratio vs Shi (2021) fusulinid half-whorl series (Pass 2) — Morphometric validation: 80/100" ;

sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-029> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-code-traceability-builder-assessor-claude-fable-5-1> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-code-traceability-builder-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-029: logarithmic-spiral chamber succession with constant ratio vs Shi (2021) fusulinid half-whorl series (Pass 2) — Code-to-model traceability: 78/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Every model function cites its page/equation; the verdict thresholds are named module constants with the pre-registration source in a comment; the KG YAML code loci were updated to the v2 line ranges; the CV thresholds are stated in the docstrings. Docked because the analysis-side conventions (PCA frame, 0.85 break threshold, 5-95 % trimming, 10 % drift) are documented but not sourced to any publication." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L285–L310: specimen_axis_dims: PCA frame and 0.85 break threshold are analyst conventions <https://github.com/fractastical/morpholib/blob/12d9d136ee5632ff58f859a3df2645e58ace3576/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L285-L310>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-code-traceability-2> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L86–L102" ;
        dcterms:description "Thompson's tables as constants with page loci; pre-registered thresholds as named constants" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/12d9d136ee5632ff58f859a3df2645e58ace3576/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L86-L102> .


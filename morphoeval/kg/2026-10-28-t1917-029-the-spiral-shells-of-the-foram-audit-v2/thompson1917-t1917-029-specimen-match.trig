sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-029> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-specimen-match-builder-assessor-claude-fable-5-1> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-specimen-match-builder-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-029: logarithmic-spiral chamber succession with constant ratio vs Shi (2021) fusulinid half-whorl series (Pass 2) — Morphological realism / specimen match: 68/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Both specimen images are now measured and overlaid: panel G shows 13 detected whorl walls on the fusulinid section, panel C shows 17 wall detections (8 sectors) on Fig. 309 with the data-fitted model spiral passing through them, and the GIF places the growing model beside Fig. 309 and the Dryad outlines. The sweep grid is recognisably Globigerina-like at d = 90-120, Cyclammina-like at d = 10-20 and Orbitolitid at W = 1.2. Docked because the model shells are circles (no chamber shape/overlap law), the Fig. 309 overlay is approximate (engraving is an oblique view), and Thompson's Figs. 311-317 genera are matched only by family resemblance." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-specimen-match-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-specimen-match-4> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_029_the_spiral_shells_of_the_foram_comparison.png (generated output)" ;
        dct:description "Regenerated 10-panel figure inspected: C overlay + CV crosses, G wall markers on photograph, A sweep grid — docs/media/t1917_029_the_spiral_shells_of_the_foram_comparison.png: rendered output of thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py at 12d9d136ee5632ff58f859a3df2645e58ace3576, image/png, 883361 B, 1800×1300 px, artifact_sha256 c266574c8781e151f54da6f411ffab553e81bd8cec52e518212909b9c052d1e3 (sha256 c266574c8781e151f54da6f411ffab553e81bd8cec52e518212909b9c052d1e3), spec_fingerprint a65e5f2d0b7aad60f22deae47babc008c2fa65221e8f2cdd854123ba8884a9f7" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L412–L486" ;
        dct:description "cv_whorl_radii: centre refinement, sector-median profiles, dark-wall minima, merge, joint half-whorl-offset fit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/12d9d136ee5632ff58f859a3df2645e58ace3576/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L412-L486> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L488–L533" ;
        dct:description "cv_fig309_whorls: bright-wall peaks in 8 sectors; coarse, direction spread +/-0.18 reported" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/12d9d136ee5632ff58f859a3df2645e58ace3576/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L488-L533> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_029_the_spiral_shells_of_the_foram_growth.gif (generated output)" ;
        dct:description "20 frames, 1300x480: model (W from Fig. 309) | Fig. 309 | Dryad TNO stages with running ratio — docs/media/t1917_029_the_spiral_shells_of_the_foram_growth.gif: rendered output of thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py at 12d9d136ee5632ff58f859a3df2645e58ace3576, image/gif, 872268 B, 1300×480 px, 20 frames, artifact_sha256 6df0512f746268e7a5a8147612a0acb18d946ee6f923e4e96037b99d143de12e (sha256 6df0512f746268e7a5a8147612a0acb18d946ee6f923e4e96037b99d143de12e), spec_fingerprint a65e5f2d0b7aad60f22deae47babc008c2fa65221e8f2cdd854123ba8884a9f7" .

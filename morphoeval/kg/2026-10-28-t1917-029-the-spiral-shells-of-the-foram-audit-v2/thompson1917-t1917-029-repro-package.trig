sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-029> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-repro-package-builder-assessor-claude-fable-5-1> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-repro-package-builder-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-029: logarithmic-spiral chamber succession with constant ratio vs Shi (2021) fusulinid half-whorl series (Pass 2) — Reproducibility package: 78/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Deterministic (seeded bootstrap / MC / jitter), byte-identical outputs across runs, --self-test with headline regression asserts (Triticites ratio in [1.22, 1.26], 106 specimens, 14 breaks, r > 0.99, CV walls >= 5 per side, controls), --fast flag, environment stamped into metrics and result JSON, documented invocation in the README. Docked because the versions still differ from requirements.lock.txt and the run depends on the pinned proloculus centres in the reference JSON (a change there silently changes the CV numbers)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-repro-package-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-repro-package-3> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L1127–L1142" ;
        dct:description "headline regression, CV and control assertions in self_test" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/12d9d136ee5632ff58f859a3df2645e58ace3576/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L1127-L1142> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L969–L975" ;
        dct:description "environment_stamp written into metrics and result JSON" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/12d9d136ee5632ff58f859a3df2645e58ace3576/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L969-L975> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-029/README.md L46–L75" ;
        dct:description "verdict table and documented invocation incl. --fast" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/12d9d136ee5632ff58f859a3df2645e58ace3576/datasets/thompson_1917/t1917-029/README.md#L46-L75> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 — builder self-audit, Pass 2 (role: builder_assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


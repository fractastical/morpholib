sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-029> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-model-fidelity-builder-assessor-claude-fable-5-1> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-029-model-fidelity-builder-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-029: logarithmic-spiral chamber succession with constant ratio vs Shi (2021) fusulinid half-whorl series (Pass 2) — Model fidelity to source: 78/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Unchanged core (E1-E6 exactly as on pp. 593-598, numerically mirrored to the Lean theorems in self_test). Improved: the translation branch is exercised and read out (helicoid aspect), the limiting cases are rendered in the sweep, and the model is anchored to measured values (Fig. 309 first-wall radius and its own CV whorl ratio) rather than hand-picked numbers. Still docked for a0 = (W-1)/2 and d = 22.5 deg being analyst choices with no source value, and for the Raup (1966) correspondence remaining a docstring remark." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L684–L690: fig309_model_params: W from Fig. 309 CV, d = 22.5 deg and a0 = (W-1)/2 are analyst choices <https://github.com/fractastical/morpholib/blob/12d9d136ee5632ff58f859a3df2645e58ace3576/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L684-L690>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-model-fidelity-2> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L108–L158" ;
        dct:description "E1, E2, E5, E6 (chamber_series incl. Nodosarian limit and translation) and E4 (thompson_volume_series)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/12d9d136ee5632ff58f859a3df2645e58ace3576/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L108-L158> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-029-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py L1085–L1145" ;
        dct:description "self_test asserts alpha(1.5)=86.31, gnomonic identities, V ratio 1+q, von Moller 0.088 slope, limits, sweep monotonicity, headline regression" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/12d9d136ee5632ff58f859a3df2645e58ace3576/thompson/claims/t1917-029_the-spiral-shells-of-the-foraminifera.py#L1085-L1145> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 — builder self-audit, Pass 2 (role: builder_assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


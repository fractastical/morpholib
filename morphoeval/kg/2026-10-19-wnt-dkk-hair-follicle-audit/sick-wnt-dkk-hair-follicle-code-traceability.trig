sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Sick et al. (2006) WNT/DKK activator-inhibitor hair follicle spacing morphogenesis — Code-to-model traceability: 64/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Docstring cites Sick et al. (2006) and Andl et al. (2002), but lacks explicit mappings to Sick et al. (2006) Figs. 2-4 (primary/secondary waves, K14-Wnt, Dkk1) and the 3 Lean 4 theorems in `Loop_006_wnt_dkk_hair_follicle.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2002-sick-wnt-dkk-hair-follicle.py L1–L12: Baseline module header without Lean 4 theorem or transgenic figure mappings <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L1-L12>" ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


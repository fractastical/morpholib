    pk:evidenceAgainst "2002-sick-wnt-dkk-hair-follicle.py L1–L12: Baseline module header without Lean 4 theorem or transgenic figure mappings <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L1-L12>" ;
    pk:hasScore 6.4e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Sick et al. (2006) WNT/DKK activator-inhibitor hair follicle spacing morphogenesis — Model fidelity to source: 63/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Implements the 2D saturating WNT/DKK activator-inhibitor PDE (L66-109) and linear dispersion curve (L34-55), but omits Sick et al.'s (2006) primary -> secondary inter-follicular wave insertion upon 2x epidermal expansion, omits K14-Wnt overexpression and Dkk1 transgenic phenotypes, and runs no equal-diffusion negative control (D_w = D_h)." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "2002-sick-wnt-dkk-hair-follicle.py L66–L109: Single-regime 2D wild-type solver without secondary inter-follicular insertion, K14-Wnt/Dkk1 phenotypes, or equal-diffusion control <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L66-L109>" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-1> ;
    pk:hasScore 6.3e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Sick et al. (2006) WNT/DKK activator-inhibitor hair follicle spacing morphogenesis — Morphometric validation: 46/100" ;

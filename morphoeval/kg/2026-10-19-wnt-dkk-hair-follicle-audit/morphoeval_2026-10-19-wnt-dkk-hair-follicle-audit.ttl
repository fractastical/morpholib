<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/sick-wnt-dkk-hair-follicle-1>,
        <https://w3id.org/probknow/resource/math-law/sick-wnt-dkk-hair-follicle-2>,
        <https://w3id.org/probknow/resource/math-law/sick-wnt-dkk-hair-follicle-3> .

<https://w3id.org/probknow/resource/math-law/sick-wnt-dkk-hair-follicle-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Sick et al. (2006) Unsaturated WNT/DKK Homogeneous Steady-State Equilibrium" ;
    dct:description "Establishes the exact algebraic homogeneous epidermal steady state of the WNT/DKK reaction kinetics prior to Turing-Meinhardt symmetry breaking | Variables: w(x,t): epidermal WNT activator concentration; h(x,t): extracellular DKK1/DKK2 inhibitor concentration; κ: autocatalytic saturation; μ_w, μ_h: turnover rates" ;
    dct:source "Sick et al. (2006) Science 314(5804):1447-1450; Gierer & Meinhardt (1972) Kybernetik 12:30-39" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L120-L210>,
        <https://github.com/fractastical/morpholib/blob/3cb5ea9/morphoeval/lean/loops/Loop_006_wnt_dkk_hair_follicle.lean#L12-L33> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def wnt_activator_num_residual (w h_scaled mu_h : Int) : Int :=
  (w * w) * mu_h - w * h_scaled
def dkk_inhibitor_num_residual (w h_scaled mu_h : Int) : Int :=
  (w * w) * mu_h - mu_h * h_scaled
theorem wnt_dkk_homogeneous_steady_state (mu_h : Int) :
    wnt_activator_num_residual mu_h (mu_h * mu_h) mu_h = 0 ∧
    dkk_inhibitor_num_residual mu_h (mu_h * mu_h) mu_h = 0 := by
  simp [wnt_activator_num_residual, dkk_inhibitor_num_residual, Int.mul_assoc]
"""^^pk:lean4 ;
    skos:notation "∂w/∂t = ρ_w + c_w w^2 / [h(1 + κ w^2)] - μ_w w + D_w ∇^2 w,   ∂h/∂t = ρ_h + c_h w^2 - μ_h h + D_h ∇^2 h;   (w_*, h_*) = ((c_w/c_h)(μ_h/μ_w), (c_w/c_h)(μ_h/μ_w)^2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/S1534-5807(02)00167-3>,
        <https://doi.org/10.1126/science.1130088>,
        <https://doi.org/10.1186/1471-213X-4-4> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Activator-Inhibitor Follicular Spacing (Sick et al. 2006 Saturating WNT/DKK Reaction-Diffusion PDE)" ;
    pk:leanDeclaration "MathOfBiology.Loop_006.wnt_activator_num_residual" ;
    pk:leanTheorem "MathOfBiology.Loop_006.wnt_dkk_homogeneous_steady_state" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/sick-wnt-dkk-hair-follicle-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Sick et al. (2006) Equal-Diffusion Epidermal Stability & Dkk1 Blockade Theorem" ;
    dct:description "Proves that faster DKK turnover (μ_h > μ_w) stabilizes the epidermis against uniform oscillations and that equal diffusion (D_w = D_h) or excess Dkk1 expression prevents hair follicle placode initiation | Variables: J_0: homogeneous WNT/DKK reaction Jacobian; q = k^2: squared spatial wavenumber; D: equal diffusivity" ;
    dct:source "Sick et al. (2006) Science 314:1447-1450; Andl et al. (2002) Dev. Cell 2(5):643-653" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L212-L310>,
        <https://github.com/fractastical/morpholib/blob/3cb5ea9/morphoeval/lean/loops/Loop_006_wnt_dkk_hair_follicle.lean#L36-L58> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def wnt_dkk_equal_diff_neg_trace (d_mu D q : Nat) : Nat :=
  (d_mu + 1) + 2 * D * q
def wnt_dkk_equal_diff_det (d_mu d_pos D q : Nat) : Nat :=
  (D * q) * (D * q) + (D * q) * (d_mu + 1) + (d_pos + 1)
theorem wnt_dkk_equal_diffusion_stable (d_mu d_pos D q : Nat) :
    wnt_dkk_equal_diff_neg_trace d_mu D q ≥ 1 ∧
    wnt_dkk_equal_diff_det d_mu d_pos D q ≥ d_pos + 1 := by
  simp [wnt_dkk_equal_diff_neg_trace, wnt_dkk_equal_diff_det]
  omega
"""^^pk:lean4 ;
    skos:notation "tr(J_0) = μ_w - μ_h < 0  (μ_h > μ_w),   det(J_0) = μ_w μ_h > 0;   D_w = D_h = D ⟹ det(J_0 - q D I) = (Dq)^2 + Dq(μ_h - μ_w) + μ_w μ_h > 0  ∀ q ≥ 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/S1534-5807(02)00167-3>,
        <https://doi.org/10.1126/science.1130088>,
        <https://doi.org/10.1186/1471-213X-4-4> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Activator-Inhibitor Follicular Spacing (Sick et al. 2006 Saturating WNT/DKK Reaction-Diffusion PDE)" ;
    pk:leanDeclaration "MathOfBiology.Loop_006.wnt_dkk_equal_diff_det" ;
    pk:leanTheorem "MathOfBiology.Loop_006.wnt_dkk_equal_diffusion_stable" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/sick-wnt-dkk-hair-follicle-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Sick et al. (2006) Rapidly Diffusing DKK Instability & Secondary Wave Insertion Theorem" ;
    dct:description "Proves that rapidly diffusing extracellular DKK1/DKK2 (d = 40 > d_c) drives det_J(q) < 0, generating regular primary hair follicle placodes and inter-follicular secondary wave insertion upon domain expansion | Variables: d = D_h / D_w: DKK-to-WNT diffusivity ratio (d = 40); d_c = (√2 + 1)^2 ≈ 5.8284: critical Turing threshold; q = k^2: unstable spatial mode" ;
    dct:source "Sick et al. (2006) Science 314(5804):1447-1450 Figs. 1-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L312-L460>,
        <https://github.com/fractastical/morpholib/blob/3cb5ea9/morphoeval/lean/loops/Loop_006_wnt_dkk_hair_follicle.lean#L61-L82> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def wnt_dkk_fourier_det (mu_w mu_h D_w D_h q : Int) : Int :=
  (D_w * q - mu_w) * (D_h * q + mu_h) + 2 * mu_w * mu_h
theorem wnt_dkk_follicle_spacing_instability :
    wnt_dkk_fourier_det 2 3 1 1 0 = 6 ∧
    wnt_dkk_fourier_det 2 3 1 1 1 = 8 ∧
    wnt_dkk_fourier_det 2 3 1 5 1 = 4 ∧
    wnt_dkk_fourier_det 2 3 1 10 1 = -1 ∧
    wnt_dkk_fourier_det 2 3 1 40 1 = -31 := by
  decide
"""^^pk:lean4 ;
    skos:notation "det_J(q) = (D_w q - μ_w)(D_h q + μ_h) + 2 μ_w μ_h < 0  ⟺  d = D_h / D_w > d_c = (√2 + 1)^2 ≈ 5.8284" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/S1534-5807(02)00167-3>,
        <https://doi.org/10.1126/science.1130088>,
        <https://doi.org/10.1186/1471-213X-4-4> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Activator-Inhibitor Follicular Spacing (Sick et al. 2006 Saturating WNT/DKK Reaction-Diffusion PDE)" ;
    pk:leanDeclaration "MathOfBiology.Loop_006.wnt_dkk_fourier_det" ;
    pk:leanTheorem "MathOfBiology.Loop_006.wnt_dkk_follicle_spacing_instability" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


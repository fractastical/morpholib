sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> a pk:Claim ;
        rdfs:label "Sick et al. (2006) WNT/DKK activator-inhibitor hair follicle spacing morphogenesis faithfully reproduces Embryonic mouse (Mus musculus) epidermal hair follicle placode lattice & inter-follicular wave insertion morphology" ;
        dct:description "The simulation script(s) 2002-sick-wnt-dkk-hair-follicle.py implement the cited source model as published and produce forms that match real Embryonic mouse (Mus musculus) epidermal hair follicle placode lattice & inter-follicular wave insertion specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 53.1/100, audit 2026-10-19-wnt-dkk-hair-follicle-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py; output: docs/media/wnt_dkk_hair_follicle_comparison.png; organism: Embryonic mouse (Mus musculus) epidermal hair follicle placode lattice & inter-follicular wave insertion; checkpoint commit: https://github.com/fractastical/morpholib/commit/3cb5ea9; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: b89c42d7be6f1e2a68cf568ccc651fde825a3fca205d98fa93823f3a02d4cc25; artifact_sha256: 7c67c960f1efad08725a7de344f0d07e7fcddab65bbf8e9db801e9aacfcbdc22; input_dataset_sha256: {datasets/wnt_dkk_hair_follicle/hair_follicle_placode_specimen.jpg=f48a7d76ae5984e5..., datasets/wnt_dkk_hair_follicle/paper_citations.bib=473c1747b6bcb451..., datasets/wnt_dkk_hair_follicle/scout_manifest.json=39fe775496e89c51..., datasets/wnt_dkk_hair_follicle/wnt_dkk_hair_follicle_reference.json=e224bca31b91571c...}" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/S1534-5807(02)00167-3>,
            <https://doi.org/10.1126/science.1130088>,
            <https://doi.org/10.1186/1471-213X-4-4> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-specimen-match> ;
        pk:weightOfEvidence "0.531"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py> a schema:SoftwareSourceCode ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py" ;

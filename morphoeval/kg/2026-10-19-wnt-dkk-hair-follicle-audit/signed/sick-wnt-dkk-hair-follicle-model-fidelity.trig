sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2002-sick-wnt-dkk-hair-follicle.py L34–L55" ;
        dcterms:description "Linear stability analysis computing d_c = (sqrt(2)+1)^2 and dispersion curve" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L34-L55> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Sick et al. (2006) WNT/DKK activator-inhibitor hair follicle spacing morphogenesis — Model fidelity to source: 63/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the 2D saturating WNT/DKK activator-inhibitor PDE (L66-109) and linear dispersion curve (L34-55), but omits Sick et al.'s (2006) primary -> secondary inter-follicular wave insertion upon 2x epidermal expansion, omits K14-Wnt overexpression and Dkk1 transgenic phenotypes, and runs no equal-diffusion negative control (D_w = D_h)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2002-sick-wnt-dkk-hair-follicle.py L66–L109: Single-regime 2D wild-type solver without secondary inter-follicular insertion, K14-Wnt/Dkk1 phenotypes, or equal-diffusion control <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L66-L109>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-model-fidelity-1> ;
        pk:hasScore "0.63"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


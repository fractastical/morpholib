sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-unsaturated-steady-state-wnt-activator-concentration-w> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Unsaturated steady-state WNT activator concentration w_* = 1.5 concentration units" ;
        schema:measurementTechnique "Exact steady-state formula w_* = (c_w / c_h) * (mu_h / mu_w)" ;
        schema:name "Unsaturated steady-state WNT activator concentration w_*" ;
        schema:unitText "concentration units" ;
        schema:value "1.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-unsaturated-steady-state-wnt-activator-concentration-w-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-unsaturated-steady-state-wnt-activator-concentration-w-reference> a schema:PropertyValue ;
        dcterms:source "Sick et al. (2006) Science 314:1447-1450" ;
        schema:value "1.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wild-type-2d-primary-wave-hair-follicle-placode-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type 2D primary wave hair follicle placode count = 39 placodes" ;
        schema:measurementTechnique "Connected components of WNT activator field w(x,y) > mean + 0.85*std on 56x56 grid" ;
        schema:name "Wild-type 2D primary wave hair follicle placode count" ;
        schema:unitText "placodes" ;
        schema:value "39" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wild-type-2d-primary-wave-hair-follicle-placode-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wild-type-2d-primary-wave-hair-follicle-placode-count-reference> a schema:PropertyValue ;
        dcterms:source "Sick et al. (2006) Science 314:1447-1450 Fig. 2A" ;
        schema:value "16" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wnt-dkk-critical-diffusivity-ratio-d-c-sqrt-2-1-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "WNT/DKK critical diffusivity ratio d_c = (sqrt(2)+1)^2 = 5.8284 D_h / D_w" ;
        schema:measurementTechnique "Analytical Turing-Meinhardt threshold (3 + 2*sqrt(2))" ;
        schema:name "WNT/DKK critical diffusivity ratio d_c = (sqrt(2)+1)^2" ;
        schema:unitText "D_h / D_w" ;
        schema:value "5.8284" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wnt-dkk-critical-diffusivity-ratio-d-c-sqrt-2-1-2-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wnt-dkk-critical-diffusivity-ratio-d-c-sqrt-2-1-2-reference> a schema:PropertyValue ;
        dcterms:source "Sick et al. (2006) Science 314:1447-1450 & Gierer & Meinhardt (1972)" ;
        schema:value "5.8284" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Sick et al. (2006) WNT/DKK activator-inhibitor hair follicle spacing morphogenesis — Morphometric validation: 46/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` reports only 3 basic scalars (d_c, w_*, and wild-type placode count, L141-169) without uncertainty metrics (CV, std, RMSE, Pearson r), without negative-control contrast, and without specimen nearest-neighbor spacing or secondary wave insertion validation." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2002-sick-wnt-dkk-hair-follicle.py L141–L169: Only 3 scalar measurements without CV/RMSE/r or specimen placode morphometrics <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L141-L169>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-unsaturated-steady-state-wnt-activator-concentration-w>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wild-type-2d-primary-wave-hair-follicle-placode-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sick-wnt-dkk-hair-follicle-measurement-wnt-dkk-critical-diffusivity-ratio-d-c-sqrt-2-1-2> ;
        pk:hasScore "0.46"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sick-wnt-dkk-hair-follicle> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sick-wnt-dkk-hair-follicle-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Sick et al. (2006) WNT/DKK activator-inhibitor hair follicle spacing morphogenesis — Parameter expressivity: 44/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Simulates only a single wild-type parameter point (d = 40, rho_w = 0.001, rho_h = 0) with no transgenic parameter sweep across rho_w (K14-Wnt) or rho_h (Dkk1), no domain expansion sweep, and no CLI parameter overrides beyond `--self-test` (L180-188)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2002-sick-wnt-dkk-hair-follicle.py L180–L188: CLI exposes only --self-test without PDE parameter flags or transgenic sweeps <https://github.com/fractastical/morpholib/blob/3cb5ea9/2002-sick-wnt-dkk-hair-follicle.py#L180-L188>" ;
        pk:hasScore "0.44"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


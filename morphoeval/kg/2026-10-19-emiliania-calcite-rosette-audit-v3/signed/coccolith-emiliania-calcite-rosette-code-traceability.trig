sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-coccolith-emiliania-calcite-rosette> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Young et al. (1992) & Jaya et al. (2016) Emiliania huxleyi V/R calcite crystal coccolith rosette shield & interlocking spherical coccosphere mechanics — Code-to-model traceability: 85/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module header lists the Pass 3 sections and their limits, the contact-model docstring maps every stiffness and threshold to its formula (k_cell, k_mem via Reissner 1946, k_ij lap joint, N_ij hoop force, alpha_p P/h^2 fracture), the vesicle functions cite the support-function derivation, the Panel E title now says \"prescribed\", and the new Lean theorems are named in the measurement sources. Deductions: the vendored JSON governing equation for the T-head uses tanh while the code is linear in max(Omega - 1, 0) — a formula mismatch between the stated source and the implementation (-5); the shaft-width factor 0.62 w_0, the morphotype-R factors 1.28 / 1.45, the 0.28 angular-pitch factor, the acidification spoke factor 0.55 + 0.35 Omega and the interlock threshold 1.35 are uncited (-5); the 0.042 / 0.012 / 2.36 buckling constants are labelled prescribed but not traced to any derivation (-3); the 44.61 deg constant is documented but dead (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "datasets/emiliania_calcite_rosette/emiliania_calcite_rosette_reference.json L75–L75: t_head_hammer_width governing equation uses tanh(max(Omega-1, 0)) whereas the code uses a linear slope <https://github.com/fractastical/morpholib/blob/9987db7d/datasets/emiliania_calcite_rosette/emiliania_calcite_rosette_reference.json#L75-L75>",
            "models/2022-coccolith-emiliania-calcite-rosette.py L264–L298: Uncited constants: 0.225 slope (L264), 0.55 + 0.35 Omega (L267), 0.62 and 1.28 (L272), interlock threshold 1.35 (L278), 0.28 and 1.45 (L298) <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L264-L298>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-code-traceability-3> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2022-coccolith-emiliania-calcite-rosette.py L1–L58" ;
        dcterms:description "v3 header: Pass 3 sections 4b/4c described with their limits; five primary sources with DOIs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L1-L58> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "models/2022-coccolith-emiliania-calcite-rosette.py L596–L620" ;
        dcterms:description "Contact-model docstring maps k_cell, k_mem (Reissner 1946), k_ij lap joint, N_ij hoop force, slide and fracture thresholds to formulas" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L596-L620> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "models/2022-coccolith-emiliania-calcite-rosette.py L1287–L1287" ;
        dcterms:description "Panel E title states the 2.36x amplification is prescribed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L1287-L1287> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 primary assessor, Phase B)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-coccolith-emiliania-calcite-rosette> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Young et al. (1992) & Jaya et al. (2016) Emiliania huxleyi V/R calcite crystal coccolith rosette shield & interlocking spherical coccosphere mechanics — Reproducibility package: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`--self-test` passes 12 checks in 2.7 s (8 Pass 2 + Voronoi/Euler consistency for F = 12/16/20, contact regime ordering / arrest / F_expose monotonicity / determinism, vesicle law round-trip / lambda = 1 circle / sim-vs-law / sub-pixel ellipticity / lambda* parity, Pass 3 JSON parity); default render is 5.7 s and deterministic (seed 2022); `lean` exits 0 on the 6-theorem file; the dataset README and the math-KG YAML are updated. Deductions: the new Pass 3 JSON is not SHA-pinned so a silent edit of its constants would not fail the integrity check (-4); the comparison PNG is gitignored, so the primary artifact is not committed and byte-identity across machines is not pinned (-3); the growth GIF is unchanged while the Pass 3 content lives only in a second GIF (-2); no requirements lock pins the numpy / scipy versions used here (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-repro-package-4> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2022-coccolith-emiliania-calcite-rosette.py L1797–L1912" ;
        dcterms:description "self_test(): 12 checks including Voronoi/Euler consistency, contact regime ordering, arrest, F_expose monotone, determinism, vesicle law round-trip and Pass 3 JSON parity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L1797-L1912> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "models/2022-coccolith-emiliania-calcite-rosette.py L1542–L1608" ;
        dcterms:description "render_contact_indentation_gif: 11-frame deterministic contact GIF" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L1542-L1608> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "models/2022-coccolith-emiliania-calcite-rosette.py L1915–L1954" ;
        dcterms:description "main(): CLI wiring, --skip-gif, deterministic seed default 2022" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L1915-L1954> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/coccolith-emiliania-calcite-rosette.yaml L105–L124" ;
        dcterms:description "Equations 5-6 registered with single-range code_locus pins to the Pass 3 functions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/math_kg_loops/coccolith-emiliania-calcite-rosette.yaml#L105-L124> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 primary assessor, Phase B)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


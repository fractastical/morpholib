sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-coccolith-emiliania-calcite-rosette> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "models/2022-coccolith-emiliania-calcite-rosette.py L956–L989" ;
        dcterms:description "evaluate_vesicle_rim_tension_eccentricity: lambda* inferred from reference_b_over_a (the annotation), relaxed b/a = 0.8461 vs 0.8478, ellipse RMS residual 0.20 % of a vs 1.09 % pixel precision" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L956-L989> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/emiliania_calcite_rosette_comparison.png (generated output)" ;
        dcterms:description "3x3 synthesis: Panels A-F as Pass 2 (SEM overlay in F), G contact F-u curves and events, H sigma_lock x overlap regime map, I relaxed rim vs SEM ellipse vs isotropic circle with b/a(lambda) inset — docs/media/emiliania_calcite_rosette_comparison.png: rendered output of models/2022-coccolith-emiliania-calcite-rosette.py at 9987db7d, image/png, 962700 B, 2371×2099 px, artifact_sha256 a51c56828e0a56922fc52ef5383b841b1037b1b7d4aa33b14f593bf88059e97d (sha256 a51c56828e0a56922fc52ef5383b841b1037b1b7d4aa33b14f593bf88059e97d), spec_fingerprint 965ae13d1916a73bad9dca346e9176f4f9220e85b7c520cf8b7bb71057d4f791" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/emiliania_calcite_rosette_contact_indentation.gif (generated output)" ;
        dcterms:description "11-frame indentation cascade on the Voronoi coccosphere (interlocked vs truncated T-heads) — docs/media/emiliania_calcite_rosette_contact_indentation.gif: rendered output of models/2022-coccolith-emiliania-calcite-rosette.py at 9987db7d, image/gif, 232335 B, 1122×528 px, 11 frames, artifact_sha256 b78245719773af60aa52d7443a8976d32a177ebc34dc1d5280e4b92df36e14ae (sha256 b78245719773af60aa52d7443a8976d32a177ebc34dc1d5280e4b92df36e14ae), spec_fingerprint 965ae13d1916a73bad9dca346e9176f4f9220e85b7c520cf8b7bb71057d4f791" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 primary assessor, Phase B)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Young et al. (1992) & Jaya et al. (2016) Emiliania huxleyi V/R calcite crystal coccolith rosette shield & interlocking spherical coccosphere mechanics — Morphological realism / specimen match: 72/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The 3x3 figure shows the SEM overlay (Panel F) and the new Panel I places the relaxed vesicle rim over the SEM ellipse and the isotropic circle; the relaxed contour deviates from the best-fit ellipse by 0.20 % of a, below the 1.09 % one-pixel precision of the 92 x 78 px annotation, and the contact GIF renders the indentation cascade on the Voronoi sphere. Deductions: the ellipse centre, semi-axes, tilt and the pixel calibration are hand-annotated in the reference JSON and read by the segmentation function rather than detected, so the specimen b/a = 0.8478, e = 0.5303 and L_d = 3.50 um are transcriptions, and the Pass 3 lambda* is calibrated to the same annotation — only the N_seg = 32 DoG spoke count is measured from pixels (-14); the coccosphere panels compare with no micrograph of an indented or fractured coccosphere, so the slide-then-arrest sequence is matched to Jaya et al. (2016) only qualitatively (-8); the comparison PNG is gitignored (`*.png`) so the figure judged here is the regenerated one, not a committed artifact (-3); the growth GIF is unchanged from Pass 2 (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "docs/media/emiliania_calcite_rosette_growth.gif (generated output, not in repo): 2-panel rosette growth GIF regenerated by the v3 script; content identical in design to Pass 2 (no vesicle / contact frames) — docs/media/emiliania_calcite_rosette_growth.gif: rendered output of models/2022-coccolith-emiliania-calcite-rosette.py at 9987db7d, image/gif, 451866 B, 1122×505 px, 12 frames, artifact_sha256 1a3bb864fc8cd17bc03073d0fdad2d1bf6818f760dbc69b31edef22396129473 (sha256 1a3bb864fc8cd17bc03073d0fdad2d1bf6818f760dbc69b31edef22396129473), spec_fingerprint 965ae13d1916a73bad9dca346e9176f4f9220e85b7c520cf8b7bb71057d4f791",
            "models/2022-coccolith-emiliania-calcite-rosette.py L1476–L1539: render_growth_gif unchanged from Pass 2; no Pass 3 content in the growth GIF <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L1476-L1539>",
            "models/2022-coccolith-emiliania-calcite-rosette.py L994–L1078: segment_emiliania_coccolith_specimen: ellipse centre / semi-axes (L1013) / tilt / calibration come from JSON annotations; only the angular DoG spoke peaks are detected <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L994-L1078>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-specimen-match-3> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
}


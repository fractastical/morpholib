    dct:source "Young et al. (1992) Nature 356:516-518; Didymus et al. (1993) Proc. R. Soc. B 252:259-264" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9987db7d/2022-coccolith-emiliania-calcite-rosette.py#L374-L426>,
        <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/lean/loops/Loop_080_emiliania_calcite_rosette.lean#L93-L129> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def proto_ring_circumference_nm (n_seg w_nm : Nat) : Nat := n_seg * w_nm
def distal_shield_scaled_nm (n_seg w_nm two_pi_l_spoke_nm : Nat) : Nat :=
  proto_ring_circumference_nm n_seg w_nm + two_pi_l_spoke_nm
theorem proto_coccolith_circumference_and_distal_shield_linear_scaling :
    proto_ring_circumference_nm 33 145 - proto_ring_circumference_nm 32 145 = 145 ∧
    distal_shield_scaled_nm 26 145 6355 < distal_shield_scaled_nm 32 145 6355 ∧
    distal_shield_scaled_nm 32 145 6355 < distal_shield_scaled_nm 38 145 6355 := by decide
"""^^pk1:lean4 ;
    skos:notation "C_ring(N_seg) = N_seg * w_0  =>  R_tube = (N_seg * w_0)/(2*pi)  and  L_d(N_seg) = (N_seg * w_0)/pi + 2*L_spoke" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/sapm194625180>,
        <https://doi.org/10.1038/356516a0>,
        <https://doi.org/10.1038/ncomms11904>,
        <https://doi.org/10.1038/s41467-018-04168-9>,
        <https://doi.org/10.1098/rspb.1993.0073> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Young et al. (1992) V/R Bimodal Calcite Crystallographic Nucleation Ring (N_total = 2*N_seg, c_V . c_R = 0), Linear Proto-Coccolith Circumference Scaling & Jaya et al. (2016) Spherical Coccosphere Euler Interlocking Packing" ;
    pk1:leanDeclaration "MathOfBiology.Loop_080.distal_shield_scaled_nm" ;
    pk1:leanTheorem "MathOfBiology.Loop_080.proto_coccolith_circumference_and_distal_shield_linear_scaling" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/coccolith-emiliania-calcite-rosette-3> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Spherical Euler Polyhedral Packing & Trivalent Interlocking Coccosphere Law" ;
    dct:description "Governs the 3D topological closure and load-sharing overlap edge count E = 3*(N_cocc - 2) of interlocking spherical coccospheres under compressive loading | Variables: F = N_cocc: number of interlocking coccolith shields tiling the coccosphere; V: triple-coccolith junction vertices; E: pairwise overlapping suture edges; chi = 2: spherical Euler characteristic" ;
    dct:source "Jaya et al. (2016) Nat. Commun. 7:11904; Walker et al. (2018) Nat. Commun. 9:1-12" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9987db7d/2022-coccolith-emiliania-calcite-rosette.py#L429-L498>,
        <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/lean/loops/Loop_080_emiliania_calcite_rosette.lean#L132-L176> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def coccosphere_vertices (f_cocc : Int) : Int := 2 * (f_cocc - 2)
def coccosphere_edges (f_cocc : Int) : Int := 3 * (f_cocc - 2)
def coccosphere_euler_characteristic (f_cocc : Int) : Int :=
  coccosphere_vertices f_cocc - coccosphere_edges f_cocc + f_cocc
theorem coccosphere_euler_polyhedral_packing_and_trivalent_interlock :
    coccosphere_euler_characteristic 16 = 2 ∧
    3 * coccosphere_vertices 16 = 2 * coccosphere_edges 16 ∧
    coccosphere_edges 16 = 42 := by decide
"""^^pk1:lean4 ;
    skos:notation "V - E + F = 2 on S^2 with 3*V = 2*E  =>  V = 2*(N_cocc - 2), E = 3*(N_cocc - 2) for F = N_cocc in [12, 24]" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/sapm194625180>,
        <https://doi.org/10.1038/356516a0>,
        <https://doi.org/10.1038/ncomms11904>,
        <https://doi.org/10.1038/s41467-018-04168-9>,
        <https://doi.org/10.1098/rspb.1993.0073> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Young et al. (1992) V/R Bimodal Calcite Crystallographic Nucleation Ring (N_total = 2*N_seg, c_V . c_R = 0), Linear Proto-Coccolith Circumference Scaling & Jaya et al. (2016) Spherical Coccosphere Euler Interlocking Packing" ;
    pk1:leanDeclaration "MathOfBiology.Loop_080.coccosphere_euler_characteristic" ;
    pk1:leanTheorem "MathOfBiology.Loop_080.coccosphere_euler_polyhedral_packing_and_trivalent_interlock" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/coccolith-emiliania-calcite-rosette-4> a skos:Concept,
        pk1:Concept ;
    rdfs:label "CAP-Polysaccharide T-Shaped Hammer-Head Expansion vs Ocean Acidification Truncation Law" ;
    dct:description "Explains why ocean acidification (Omega_calcite < 1) or loss of acidic CAP polysaccharides truncates distal T-shaped hammer heads and destroys inter-spoke rim interlocking | Variables: w_spoke: radial spoke shaft width; w_head: outer T-shaped hammer-head tangential width; Omega_calcite: seawater/vesicle calcite saturation state; c_CAP: coccolith-associated polysaccharide activity" ;
    dct:source "Didymus et al. (1993) Proc. R. Soc. B 252:259-264; Jaya et al. (2016) Nat. Commun. 7:11904; Walker et al. (2018) Nat. Commun. 9:1-12" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9987db7d/2022-coccolith-emiliania-calcite-rosette.py#L501-L516>,
        <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/lean/loops/Loop_080_emiliania_calcite_rosette.lean#L179-L215> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def calcite_supersat_excess (omega_scaled : Nat) : Nat :=
  if omega_scaled > 100 then omega_scaled - 100 else 0
def hammer_head_width_scaled (w_spoke cap_pct omega_scaled : Nat) : Nat :=
  w_spoke * 100 + (w_spoke * cap_pct * calcite_supersat_excess omega_scaled) / 100
theorem cap_polysaccharide_hammer_expansion_and_acidification_truncation :
    hammer_head_width_scaled 100 28 75 = 10000 ∧
    hammer_head_width_scaled 100 0 420 = 10000 ∧
    hammer_head_width_scaled 100 28 420 > hammer_head_width_scaled 100 28 75 := by decide
"""^^pk1:lean4 ;
    skos:notation "w_head(Omega_calcite, c_CAP) = w_spoke * (1 + alpha_T * c_CAP * max(Omega_calcite - 1, 0))  =>  w_head = w_spoke when Omega_calcite <= 1 or c_CAP = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/sapm194625180>,
        <https://doi.org/10.1038/356516a0>,
        <https://doi.org/10.1038/ncomms11904>,
        <https://doi.org/10.1038/s41467-018-04168-9>,
        <https://doi.org/10.1098/rspb.1993.0073> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Young et al. (1992) V/R Bimodal Calcite Crystallographic Nucleation Ring (N_total = 2*N_seg, c_V . c_R = 0), Linear Proto-Coccolith Circumference Scaling & Jaya et al. (2016) Spherical Coccosphere Euler Interlocking Packing" ;
    pk1:leanDeclaration "MathOfBiology.Loop_080.hammer_head_width_scaled" ;
    pk1:leanTheorem "MathOfBiology.Loop_080.cap_polysaccharide_hammer_expansion_and_acidification_truncation" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/coccolith-emiliania-calcite-rosette-5> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Suture Interlock Shear Capacity vs Plate Bending Capacity Sliding/Fracture Selection Law (Pass 3 Voronoi nanoindentation contact model)" ;
    dct:description "Selects the first failure event of the flat-punch-indented Voronoi coccosphere: truncated T-heads (ocean acidification / CAP ablation) have zero interlock capacity and are shed; interlocked sutures slide first when Pi < 1, after which the apex plate fractures at F_bend and the crack is arrested because neighbours receive only a fraction of the load (sigma_neigh/sigma_f = 0.28) | Variables: sigma_lock: organic-cement interlock shear strength (model assumption, swept 5-400 MPa); l_ij: Voronoi suture length; d_ov: T-hammer overlap depth; mu, p_turgor: Coulomb friction on the turgor hoop force; sigma_f, h, alpha_p: calcite fracture strength, shield thickness, plate bending coefficient; Pi: capacity ratio" ;
    dct:source "Jaya et al. (2016) Nat. Commun. 7:11904 (coccolith sliding and crack arrest at coccolith boundaries); Reissner (1946) J. Math. Phys. 25:80-85 (spherical shell point-load stiffness)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9987db7d/2022-coccolith-emiliania-calcite-rosette.py#L578-L806>,
        <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/lean/loops/Loop_080_emiliania_calcite_rosette.lean#L218-L267> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def suture_shear_capacity (sigma_lock l_edge d_ov : Nat) : Nat := sigma_lock * l_edge * d_ov
def overlap_depth_nm (w_shaft_nm phi_pct : Nat) : Nat := w_shaft_nm * phi_pct / 200
def sliding_first (lock_capacity bend_capacity : Nat) : Bool := lock_capacity < bend_capacity
theorem suture_capacity_ratio_selects_sliding_vs_fracture :
    (∀ sigma l : Nat, suture_shear_capacity sigma l 0 = 0) ∧
    (∀ sigma l d1 d2 : Nat, d1 ≤ d2 → suture_shear_capacity sigma l d1 ≤ suture_shear_capacity sigma l d2) ∧
    overlap_depth_nm 90 72 = 32 ∧ sliding_first 1544 5400 = true ∧ sliding_first 6000 5400 = false
"""^^pk1:lean4 ;
    skos:notation "S_slide_ij = mu * p_turgor * R * l_ij / 2 + sigma_lock * l_ij * d_ov, d_ov = w_shaft * (t_head_ratio - 1)/2;  F_bend = sigma_f * h^2 / alpha_p;  Pi = sum_j S_slide_ij / F_bend  =>  Pi < 1: sutures slide before the apex plate fractures (Pi = 0.29 for Morphotype A defaults); d_ov = 0 (truncated T-heads): capacity 0, coccolith shed" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/sapm194625180>,
        <https://doi.org/10.1038/356516a0>,
        <https://doi.org/10.1038/ncomms11904>,
        <https://doi.org/10.1038/s41467-018-04168-9>,
        <https://doi.org/10.1098/rspb.1993.0073> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Young et al. (1992) V/R Bimodal Calcite Crystallographic Nucleation Ring (N_total = 2*N_seg, c_V . c_R = 0), Linear Proto-Coccolith Circumference Scaling & Jaya et al. (2016) Spherical Coccosphere Euler Interlocking Packing" ;
    pk1:leanDeclaration "MathOfBiology.Loop_080.suture_shear_capacity" ;
    pk1:leanTheorem "MathOfBiology.Loop_080.suture_capacity_ratio_selects_sliding_vs_fracture" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/coccolith-emiliania-calcite-rosette-6> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Golgi Coccolith-Vesicle Rim Tension Anisotropy Baseplate Aspect Law (Pass 3)" ;
    dct:description "Explains the elliptical organic baseplate (and hence the elliptical V/R proto-coccolith ring and distal shield, b/a = 0.8478) as the Wulff-type equilibrium of a pressurised vesicle rim whose cytoskeletal tension is anisotropic; isotropic tension gives a circle, b/a decreases strictly with lambda and never falls below 1/2. lambda* is inferred from the SEM aspect ratio (calibration), verified by area-conserving contour relaxation to 0.2 % | Variables: psi: outward-normal angle of the vesicle rim; tau_0: rim line tension at the major-axis ends; lambda = tau_minor-end / tau_major-end: cytoskeletal tension anisotropy; p: luminal pressure (Lagrange multiplier of the conserved vesicle area); h(psi): support function; a, b: baseplate semi-axes" ;
    dct:source "Young et al. (1992) Nature 356:516-518; Didymus et al. (1993) Proc. R. Soc. B 252:259-264 (baseplate laid down inside the Golgi-derived coccolith vesicle before calcite nucleation)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/9987db7d/2022-coccolith-emiliania-calcite-rosette.py#L860-L989>,
        <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/lean/loops/Loop_080_emiliania_calcite_rosette.lean#L270-L314> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def baseplate_aspect_num (lam_milli : Nat) : Nat := 2000 + lam_milli
def baseplate_aspect_den (lam_milli : Nat) : Nat := 1000 + 2 * lam_milli
theorem vesicle_rim_tension_anisotropy_sets_baseplate_aspect :
    baseplate_aspect_num 1000 = baseplate_aspect_den 1000 ∧
    (∀ lam : Nat, 1000 < lam → baseplate_aspect_num lam < baseplate_aspect_den lam) ∧
    (∀ l1 l2 : Nat, l1 < l2 → baseplate_aspect_num l2 * baseplate_aspect_den l1 < baseplate_aspect_num l1 * baseplate_aspect_den l2) ∧
    847 * baseplate_aspect_den 1656 < 1000 * baseplate_aspect_num 1656 ∧
    1000 * baseplate_aspect_num 1656 < 848 * baseplate_aspect_den 1656
"""^^pk1:lean4 ;
    skos:notation "tau(psi) kappa(psi) = p with tau(psi) = tau_0 (1 + (lambda - 1) sin^2 psi)  =>  h(psi) = (tau_0/p)[(1 + lambda)/2 + ((lambda - 1)/6) cos 2 psi]  =>  b/a = (2 + lambda)/(1 + 2 lambda), lambda = (2 - b/a)/(2 b/a - 1); b/a = 0.8478 (e = 0.5303) at lambda* = 1.656" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/sapm194625180>,
        <https://doi.org/10.1038/356516a0>,
        <https://doi.org/10.1038/ncomms11904>,
        <https://doi.org/10.1038/s41467-018-04168-9>,
        <https://doi.org/10.1098/rspb.1993.0073> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Young et al. (1992) V/R Bimodal Calcite Crystallographic Nucleation Ring (N_total = 2*N_seg, c_V . c_R = 0), Linear Proto-Coccolith Circumference Scaling & Jaya et al. (2016) Spherical Coccosphere Euler Interlocking Packing" ;
    pk1:leanDeclaration "MathOfBiology.Loop_080.baseplate_aspect_num" ;
    pk1:leanTheorem "MathOfBiology.Loop_080.vesicle_rim_tension_anisotropy_sets_baseplate_aspect" ;
    pk1:leanVerified true .


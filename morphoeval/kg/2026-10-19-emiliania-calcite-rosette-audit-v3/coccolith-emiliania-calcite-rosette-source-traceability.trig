    <https://doi.org/10.1002/sapm194625180> dct:date "1946"^^xsd:gYear ;
        dct:title "Stresses and small displacements of shallow spherical shells. I" .
    <https://doi.org/10.1038/356516a0> dct:date "1992"^^xsd:gYear ;
        dct:title "Crystallographic control of biomineral morphology in coccoliths" .
    <https://doi.org/10.1038/ncomms11904> dct:date "2016"^^xsd:gYear ;
        dct:title "Coccospheres confer mechanical protection: insights into the Emiliania huxleyi architectural design" .

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-coccolith-emiliania-calcite-rosette> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Young et al. (1992) & Jaya et al. (2016) Emiliania huxleyi V/R calcite crystal coccolith rosette shield & interlocking spherical coccosphere mechanics — Morphometric validation: 74/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "measure_morphoeval() now returns 16 measurements with reference values, including seven new ones: Voronoi edge count 42 vs 3(F-2), arrest ratio 0.28 (< 1), capacity ratio Pi = 0.286 (< 1, sliding first), relaxed b/a 0.8461 vs 0.8478, lambda* 1.6562 vs the naive (a/b)^3 estimate 1.6411, ellipse RMS residual 0.198 % vs 1.087 % pixel precision, and the protection ratio ~1.04e4 vs 2.36 reported as a negative control. Deductions: the headline 12-taxon correlation r = 1.0000 / RMSE 0.004 um compares an \"observed\" column that equals the formula to the rounding digit — a circular validation that v2 credited (-10); the arrest and capacity references (1.0) are decision thresholds and the 2.36 reference is the unsourced v2 constant, so three of the seven new measurements have no literature anchor (-6); the specimen b/a and L_d measurements are transcriptions of annotations, and the vesicle b/a comparison is against the same annotation (-6); no measured nanoindentation force, stiffness or fracture load from Jaya et al. (2016) is compared because the paper could not be re-read offline (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "datasets/emiliania_calcite_rosette/emiliania_calcite_rosette_reference.json L96–L107: cross_taxa_coccolithophore_table: l_d_obs_um = round(l_d_pred_um, 2) for every row <https://github.com/fractastical/morpholib/blob/9987db7d/datasets/emiliania_calcite_rosette/emiliania_calcite_rosette_reference.json#L96-L107>",
            "models/2022-coccolith-emiliania-calcite-rosette.py L1661–L1669: Protection-ratio measurement anchored to the unsourced v2 2.36 constant; explicitly reported as not reproduced (~1e4, dominated by assumed E_cell) <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L1661-L1669>",
            "models/2022-coccolith-emiliania-calcite-rosette.py L374–L426: evaluate_cross_taxa_scaling: r = 1.0000 against l_d_obs_um values that equal l_d_pred_um to the rounding digit for all 12 taxa (circular) <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L374-L426>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-12-taxon-coccolithophore-proto-coccolith-linear-scaling-correlation-l-d-n-seg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-cell-exposure-load-protection-ratio-f-expose-interlocked-f-expose-truncated-t-heads-negative-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-emiliania-huxleyi-sem-specimen-calibrated-distal-shield-major-length-l-d-emiliania-huxleyi-coccolith-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-emiliania-huxleyi-sem-specimen-coccolith-elliptical-aspect-ratio-b-a-emiliania-huxleyi-coccolith-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-emiliania-huxleyi-sem-specimen-segmented-radial-spoke-count-n-seg-emiliania-huxleyi-coccolith-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-interlock-shear-capacity-over-apex-plate-bending-capacity-pi-sliding-first-if-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-interlocked-coccosphere-nanoindentation-neighbour-bending-stress-ratio-sigma-neigh-sigma-f-at-first-apex-fracture-arrest-criterion-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-morphotype-a-canonical-distal-shield-major-length-l-d-n-seg-32>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-morphotype-a-cap-polysaccharide-t-shaped-hammer-head-expansion-ratio-w-head-w-shaft>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-ocean-acidification-cap-polysaccharide-ablation-negative-control-t-head-ratio-omega-0-75>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-relaxed-vesicle-rim-contour-aspect-ratio-b-a-at-inferred-tension-anisotropy-lambda-vs-sem-baseplate-fit>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-relaxed-vesicle-rim-deviation-from-best-fit-ellipse-rms-radial-residual-of-a-vs-sem-one-pixel-fit-precision>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-spherical-coccosphere-euler-polyhedral-characteristic-chi-v-e-f-n-cocc-16>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-spherical-voronoi-coccosphere-suture-edge-count-e-f-16-tiles-vs-euler-trivalent-3-f-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-vesicle-rim-tension-anisotropy-lambda-exact-wulff-law-vs-naive-ellipse-end-point-curvature-estimate-a-b-3-alternative-model>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-young-et-al-1992-v-r-crystallographic-c-axis-orthogonality-angle-c-v-vs-c-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-morphometric-validation-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-12-taxon-coccolithophore-proto-coccolith-linear-scaling-correlation-l-d-n-seg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-taxon coccolithophore proto-coccolith linear scaling correlation L_d(N_seg) = 1.0 Pearson r" ;
        dct:description "E. huxleyi morphotypes C/R/A/BC/O/B linear r = 0.9971, slope = 0.1204 um/segment" ;
        schema:measurementTechnique "Correlation of predicted L_d = (N_seg*w_0)/pi + 2*L_spoke against empirical distal shield length across 12 coccolithophore taxa and morphotypes (RMSE=0.0039 um)" ;
        schema:name "12-taxon coccolithophore proto-coccolith linear scaling correlation L_d(N_seg)" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-12-taxon-coccolithophore-proto-coccolith-linear-scaling-correlation-l-d-n-seg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-12-taxon-coccolithophore-proto-coccolith-linear-scaling-correlation-l-d-n-seg-reference> a schema:PropertyValue ;
        dct:source "Young et al. (1992) Nature 356:516-518 & Didymus et al. (1993) Proc. R. Soc. B 252:259-264" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-cell-exposure-load-protection-ratio-f-expose-interlocked-f-expose-truncated-t-heads-negative-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cell-exposure load protection ratio F_expose(interlocked) / F_expose(truncated T-heads) — negative control = 10379.6 force ratio" ;
        dct:description "Truncated case has no T-hammer overlap so the apex coccolith is pushed into the kPa-scale protoplast at sub-nN load; ratio is dominated by the assumed E_cell and is reported as an order-of-magnitude baseline, not a calibrated value" ;
        schema:measurementTechnique "Interlocked (t_head_ratio 1.72) exposure at 68.72 uN (fracture_then_punch_through) vs truncated (ratio 1.00, Omega < 1) shedding at 6.62e-03 uN (truncated_shedding)" ;
        schema:name "Cell-exposure load protection ratio F_expose(interlocked) / F_expose(truncated T-heads) — negative control" ;
        schema:unitText "force ratio" ;
        schema:value "10379.6" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-cell-exposure-load-protection-ratio-f-expose-interlocked-f-expose-truncated-t-heads-negative-control-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-cell-exposure-load-protection-ratio-f-expose-interlocked-f-expose-truncated-t-heads-negative-control-reference> a schema:PropertyValue ;
        dct:source "Pass 2 prescribed interlock buckling amplification constant (evaluate_coccosphere_3d_euler_packing; provenance unverified) — NOT reproduced: the contact model measures coccolith shedding/punch-through, not shell buckling" ;
        schema:value "2.36" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-measurement-emiliania-huxleyi-sem-specimen-calibrated-distal-shield-major-length-l-d-emiliania-huxleyi-coccolith-specimen-jpg> a schema:PropertyValue,

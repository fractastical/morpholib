sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-coccolith-emiliania-calcite-rosette> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-coccolith-emiliania-calcite-rosette-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Young et al. (1992) & Jaya et al. (2016) Emiliania huxleyi V/R calcite crystal coccolith rosette shield & interlocking spherical coccosphere mechanics — Parameter expressivity: 84/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Pass 3 adds genuine sweeps whose outcomes change qualitatively: the sigma_lock in {5..400 MPa} x t_head_ratio in [1, 2] regime map moves through shedding -> interlock sliding -> sliding-then-arrested fracture, with fracture-first only at sigma_lock >= 200 MPa and crack propagation only at 400 MPa and ratio 2.0; the F_expose vs overlap sweep is monotone; the vesicle law is swept over lambda in [1, 2.5] and inverted on the 12-taxon b/a column (lambda 1.08-1.69). The Pass 2 morphotype / acidification regimes, Omega and N_cocc sweeps and the seven CLI overrides remain. Deductions: evaluate_contact_regime_map always builds the N_cocc = 16 tiling and ignores `--n-cocc` (only Panel G and the measurements honour the override) (-6); sigma_lock, E_cell, p_turgor, lambda and the load ramp have no CLI exposure (-5); the t_head_ratio axis of the regime map is entered directly rather than driven through Omega / c_CAP, so the CAP-acidification link is not swept end to end (-3); Panel D's 2.36x N_cocc sweep still reports a prescribed constant (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "models/2022-coccolith-emiliania-calcite-rosette.py L818–L818: til = build_coccosphere_voronoi_tiling() — regime map not wired to the n_cocc override <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L818-L818>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-parameter-expressivity-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2022-coccolith-emiliania-calcite-rosette.py L809–L855" ;
        dct:description "evaluate_contact_regime_map: 7 x 11 sigma_lock x t_head_ratio regime codes and F_expose; uses build_coccosphere_voronoi_tiling() with default N_cocc = 16 regardless of --n-cocc" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L809-L855> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2022-coccolith-emiliania-calcite-rosette.py L1917–L1924" ;
        dct:description "CLI: --self-test, --skip-gif, --n-seg, --w0, --l-spoke, --omega, --n-cocc, --seed; no sigma_lock / lambda / E_cell overrides" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L1917-L1924> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-coccolith-emiliania-calcite-rosette-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "models/2022-coccolith-emiliania-calcite-rosette.py L347–L372" ;
        dct:description "Five morphotype / acidification regimes retained from Pass 2" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2022-coccolith-emiliania-calcite-rosette.py#L347-L372> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 primary assessor, Phase B)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-farhadifar-drosophila-wing-vertex-model> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model & Lewis's law epithelial packing — Morphological realism / specimen match: 89/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the apical junction-stained polygonal epithelial monolayer micrograph (`datasets/drosophila_wing_vertex_model/drosophila_wing_epithelium_specimen.jpg`, CC BY-SA 4.0), segments `N=37` contiguous interior epithelial cells via junction-guided centroidal Voronoi-watershed tessellation (`segment_epithelial_specimen`, L441-551), and matches the Farhadifar et al. (2007) empirical wing disc polygon distribution `P(n)` across `n=4..9` with Pearson `r = 0.9913` (`RMSE = 0.0235`, `P(6) = 0.4865` vs `0.455` reference, Panel A5 & B2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L441–L551" ;
        dct:description "Junction-guided Voronoi-watershed segmentation of apical epithelial specimen (N=37 cells, r=0.9913)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/2007-farhadifar-drosophila-wing-vertex-model.py#L441-L551> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/drosophila_wing_vertex_model_comparison.png (generated output)" ;
        dct:description "10-panel synthesis figure showing segmented epithelial specimen overlay (Panel A5) and P(n)/Lewis's Law comparisons (Panels B2-B3) — docs/media/drosophila_wing_vertex_model_comparison.png: rendered output of 2007-farhadifar-drosophila-wing-vertex-model.py at b9976f8, image/png, 977473 B, 3075×1290 px, artifact_sha256 d1c94b16e8a8dabd2fa188b59f66091e4dd352b73f3ec1401c0579b6e896bbf1 (sha256 d1c94b16e8a8dabd2fa188b59f66091e4dd352b73f3ec1401c0579b6e896bbf1), spec_fingerprint 00f70e92aaa338b22956554153bb93fbccd372cdaae2e3f47f4744bcadfffe52" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


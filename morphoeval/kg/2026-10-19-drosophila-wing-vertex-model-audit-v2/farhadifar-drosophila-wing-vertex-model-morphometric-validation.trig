sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-farhadifar-drosophila-wing-vertex-model> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model & Lewis's law epithelial packing — Morphometric validation: 90/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Computes 8 quantitative morphometrics in `measure_morphoeval()` (L705-765), including proliferating wing disc `P(6) = 0.440` (vs `0.455` ref, `P(n)` Pearson `r = 0.9820`), post-mitotic pupal wing `P(6) = 0.840` (vs `0.780` ref), topological disorder reduction ratio `mu_2(pupal)/mu_2(wing) = 0.2581 < 0.5`, Lewis's Law correlation `r = 0.9994` (`RMSE = 0.0686`), Euler mean coordination `<n> = 5.96`, segmented specimen `P(n)` correlation `r = 0.9913`, and UV laser ablation initial recoil velocity `v_0 = 0.220 um/s`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-euler-mean-polygon-side-number>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-laser-ablation-initial-recoil-velocity>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-lewis-law-area-topology-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pupal-vs-larval-topological-disorder-ratio-mu2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pupal-wing-annealed-hexagonal-fraction-p6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-specimen-segmented-polygon-distribution-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-wing-disc-polygon-distribution-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-wing-disc-proliferating-hexagonal-fraction-p6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-morphometric-validation-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-euler-mean-polygon-side-number> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "euler_mean_polygon_side_number = 5.96 sides" ;
        schema:measurementTechnique "Mean polygon side number <n> across periodic 3-valent epithelial tessellation (Euler 3-valent theorem 2E/F = 6)" ;
        schema:name "euler_mean_polygon_side_number" ;
        schema:unitText "sides" ;
        schema:value "5.96" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-euler-mean-polygon-side-number-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-euler-mean-polygon-side-number-reference> a schema:PropertyValue ;
        schema:value "6.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-laser-ablation-initial-recoil-velocity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "laser_ablation_initial_recoil_velocity = 0.22 um_per_s" ;
        schema:measurementTechnique "Initial adherens-junction UV laser ablation recoil velocity v_0 at canonical wing disc parameters (Lambda_bar=0.12, Gamma_bar=0.04; Farhadifar et al. 2007 Fig. 4E)" ;
        schema:name "laser_ablation_initial_recoil_velocity" ;
        schema:unitText "um_per_s" ;
        schema:value "0.22" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-laser-ablation-initial-recoil-velocity-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-laser-ablation-initial-recoil-velocity-reference> a schema:PropertyValue ;
        schema:value "0.22" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-lewis-law-area-topology-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "lewis_law_area_topology_pearson_r = 0.9994 r" ;
        schema:measurementTechnique "Pearson correlation between simulated normalized polygon areas <A_n>/<A> and Lewis's Law (n-2)/4 across n=4..9 (RMSE=0.0165, p=0.0001)" ;
        schema:name "lewis_law_area_topology_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9994" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-lewis-law-area-topology-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-lewis-law-area-topology-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.99" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pupal-vs-larval-topological-disorder-ratio-mu2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pupal_vs_larval_topological_disorder_ratio_mu2 = 0.2581 ratio" ;
        schema:measurementTechnique "Ratio of second central topological moments mu_2(pupal)/mu_2(wing) (0.1600 / 0.6200 < 0.5, matching Lean 4 theorem farhadifar_2007_wing_vs_pupal_distribution_identities)" ;
        schema:name "pupal_vs_larval_topological_disorder_ratio_mu2" ;
        schema:unitText "ratio" ;
        schema:value "0.2581" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pupal-vs-larval-topological-disorder-ratio-mu2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pupal-vs-larval-topological-disorder-ratio-mu2-reference> a schema:PropertyValue ;
        schema:value "0.3268" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pupal-wing-annealed-hexagonal-fraction-p6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pupal_wing_annealed_hexagonal_fraction_P6 = 0.84 fraction" ;
        schema:measurementTechnique "Simulated hexagonal fraction P(6) in post-mitotic annealed pupal wing epithelium (Classen et al. 2005 / Farhadifar et al. 2007)" ;
        schema:name "pupal_wing_annealed_hexagonal_fraction_P6" ;
        schema:unitText "fraction" ;
        schema:value "0.84" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pupal-wing-annealed-hexagonal-fraction-p6-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-pupal-wing-annealed-hexagonal-fraction-p6-reference> a schema:PropertyValue ;
        schema:value "0.78" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-specimen-segmented-polygon-distribution-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_segmented_polygon_distribution_pearson_r = 0.9913 r" ;
        schema:measurementTechnique "Pearson correlation between segmented epithelial specimen P(n) (N=37 cells, P6=0.4865) and Farhadifar et al. (2007) wing disc P(n) (RMSE=0.0228, p=0.0001)" ;
        schema:name "specimen_segmented_polygon_distribution_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9913" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-specimen-segmented-polygon-distribution-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-specimen-segmented-polygon-distribution-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.98" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-wing-disc-polygon-distribution-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wing_disc_polygon_distribution_pearson_r = 0.982 r" ;
        schema:measurementTechnique "Pearson correlation between simulated proliferating wing disc P(n) and Farhadifar et al. (2007) empirical P(n) across n=4..9 (p=0.0001)" ;
        schema:name "wing_disc_polygon_distribution_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.982" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-wing-disc-polygon-distribution-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-wing-disc-polygon-distribution-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.98" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-wing-disc-proliferating-hexagonal-fraction-p6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wing_disc_proliferating_hexagonal_fraction_P6 = 0.44 fraction" ;
        schema:measurementTechnique "Simulated hexagonal fraction P(6) in proliferating Case I larval wing disc (Lambda_bar=0.12, Gamma_bar=0.04; Farhadifar et al. 2007 Fig. 4B, r=0.9820)" ;
        schema:name "wing_disc_proliferating_hexagonal_fraction_P6" ;
        schema:unitText "fraction" ;
        schema:value "0.44" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-wing-disc-proliferating-hexagonal-fraction-p6-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-measurement-wing-disc-proliferating-hexagonal-fraction-p6-reference> a schema:PropertyValue ;
        schema:value "0.455" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L370–L404" ;
        dct:description "Computation of P(n), second central moment mu_2, area CV, and Lewis's Law Pearson r & RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/2007-farhadifar-drosophila-wing-vertex-model.py#L370-L404> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L705–L765" ;
        dct:description "8 quantitative morphometric validations in measure_morphoeval()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/2007-farhadifar-drosophila-wing-vertex-model.py#L705-L765> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


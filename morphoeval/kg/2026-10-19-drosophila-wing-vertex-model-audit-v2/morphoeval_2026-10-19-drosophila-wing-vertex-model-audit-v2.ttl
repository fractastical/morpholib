    pk:hasScore 9.3e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model & Lewis's law epithelial packing — Morphometric validation: 90/100" ;

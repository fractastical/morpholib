    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L800–L845" ;
        dcterms:description "Full CLI parameter interface wired into run_all_regimes_and_render" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/2007-farhadifar-drosophila-wing-vertex-model.py#L800-L845> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model & Lewis's law epithelial packing — Parameter expressivity: 89/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Maps the complete 2D `(Lambda_bar, Gamma_bar)` ground-state phase diagram across Cases I, II, and III (Panel B1), simulates 4 distinct regimes (Panels A1-A4), executes a 7-point continuous parameter sweep across `Lambda_bar` in `[-0.30, +0.20]` spanning the soft-to-rigid transition (`run_lambda_bar_sweep`, L407-434, Panel B5), and exposes full CLI flags (`--lambda-bar`, `--gamma-bar`, `--steps`, `--seed`, `--self-test`, L800-845)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-parameter-expressivity-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .


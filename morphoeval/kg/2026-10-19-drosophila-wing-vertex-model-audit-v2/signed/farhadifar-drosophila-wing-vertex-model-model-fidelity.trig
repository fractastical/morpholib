sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-farhadifar-drosophila-wing-vertex-model> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Farhadifar et al. (2007) Drosophila wing disc apical vertex model & Lewis's law epithelial packing — Model fidelity to source: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements the Farhadifar et al. (2007) Eq. (1)-(2) apical vertex energy functional (`compute_single_cell_vertex_energy`, L98-126), analytical ground-state phase classification across Case I, Case II, and Case III (`classify_farhadifar_ground_state`, L129-178), UV laser adherens-junction ablation recoil kinetics (`simulate_laser_ablation_recoil`, L181-209), Lewis's Law (1928) linear area-side scaling (`lewis_law_ratio`, L212-218), and 2D periodic vertex packing across proliferating larval, annealed pupal, high-contractility, and soft Case II regimes (`simulate_vertex_regime`, L258-404). Backed by 4 machine-checked Lean 4 theorems (0 sorrys)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L98–L209" ;
        dcterms:description "Farhadifar et al. (2007) Eq. 1-2 vertex energy, Case I/II/III phase diagram classifier, and UV laser ablation recoil model" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/2007-farhadifar-drosophila-wing-vertex-model.py#L98-L209> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2007-farhadifar-drosophila-wing-vertex-model.py L258–L404" ;
        dcterms:description "2D periodic vertex packing & mitotic cleavage simulator across all 4 regimes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/2007-farhadifar-drosophila-wing-vertex-model.py#L258-L404> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-farhadifar-drosophila-wing-vertex-model-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_043_drosophila_wing_vertex_model.lean L19–L124" ;
        dcterms:description "4 machine-checked Lean 4 theorems for vertex energy equilibrium, Lewis's Law, Euler 3-valent conservation, and P(n) disorder reduction" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/morphoeval/lean/loops/Loop_043_drosophila_wing_vertex_model.lean#L19-L124> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


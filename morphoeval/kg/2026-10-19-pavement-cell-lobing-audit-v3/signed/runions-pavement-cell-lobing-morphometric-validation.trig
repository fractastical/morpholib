            <https://doi.org/10.7554/eLife.01967>,
            <https://doi.org/10.7554/eLife.32794> .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-runions-pavement-cell-lobing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Sapala et al. (2018) & Fu et al. (2005) ROP2-ROP6 interdigitated puzzle-shaped pavement cell lobing, Largest Empty Circle (LEC) turgor stress scaling, reduced pressurized periclinal membrane-shell and depth-resolved anticlinal wall buckling — Morphometric validation: 84/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L1641-L1799) now reports 17 reference-anchored measurements: the 9 v2 metrics (WT R_LEC 11.39 vs 11.4 um, r = 0.986, RMSE 0.26 um; Laplace ratio 3.32; RD r = -0.99 / 0.9998; lambda 24.5 um; mature S 0.655 vs 0.68; ktn1 L 1.111 vs 1.11; specimen S 0.72) plus 8 Pass 3 metrics, of which the shell ratio (1.73 vs 3.32), the sigma-R_LEC exponent (0.51 vs 1) and r (0.98) are genuine tests against the paper's proxy. Deductions: five of the eight new measurements use analytic or model-internal references (disk closed form, inscribed-disk bound, FD-vs-modal error, analytic inner-face gain, junction-forcing control) — solver verification, not biological validation (-8); the depth attenuation has no empirical reference at all (-4); the mature WT lobeyness 1.734 is 0.11 above the 1.62 reference and the lobe count (12) is outside 7.8 +/- 1.6 but neither is reported as a measurement (-3); the specimen lobeyness differs from the v2 record (1.316 vs 1.506) with unchanged code, undermining it as a reference (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2017-runions-pavement-cell-lobing.py L1774–L1798: Pass 3 depth measurements: FD-vs-modal error, dominant-mode inner/outer gain with ANALYTIC reference, distributed-vs-junction forcing with MODEL-INTERNAL reference — explicitly labelled as having no vendored empirical data <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L1774-L1798>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-depth-fd-vs-modal-rel-err>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-dominant-mode-inner-over-outer-gain>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-inner-over-outer-rms-distributed-vs-junction-forcing>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-lobe-wavelength-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-isotropic-vs-puzzle-stress-reduction-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-ktn1-mutant-lobeyness-collapse-l>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-rop2-rop6-intracortical-anticorrelation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-rop2-rop6-trans-wall-complementarity-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-shell-disk-closed-form-zmax-rel-err>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-shell-inscribed-disk-lower-bound-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-shell-isotropic-vs-wt-stress-ratio-4500um2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-shell-stress-vs-lec-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-shell-stress-vs-lec-power-exponent>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-specimen-segmented-pavement-solidity-s>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-lec-area-scaling-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-mature-lec-radius-at-4500um2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-puzzle-cell-solidity-s>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-morphometric-validation-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-depth-fd-vs-modal-rel-err> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "anticlinal_depth_fd_vs_modal_rel_err = 0.01244 fraction" ;
        schema:measurementTechnique "Relative L2 error of the sparse 2D finite-difference Laplace solve (31 depth layers x 196 arc nodes, periodic in s, Dirichlet outer face, Robin inner face beta = 2.0) vs the modal closed form" ;
        schema:name "anticlinal_depth_fd_vs_modal_rel_err" ;
        schema:unitText "fraction" ;
        schema:value "0.01244" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-depth-fd-vs-modal-rel-err-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-depth-fd-vs-modal-rel-err-reference> a schema:PropertyValue ;
        dcterms:source "Closed-form Fourier-mode solution g_k(zeta) = [k cosh(k zeta) + beta' sinh(k zeta)] / [k cosh(kH) + beta' sinh(kH)] of the prestressed strip (solver verification)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-dominant-mode-inner-over-outer-gain> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "anticlinal_dominant_mode_inner_over_outer_gain = 0.02809 dimensionless" ;
        schema:measurementTechnique "Dominant-mode depth gain under outer-junction forcing (mid-depth gain 0.1471; first harmonic k = 16 mid-depth gain 0.0214, i.e. 0.145x the dominant mode); e^-1 penetration depth 4.0 um of H = 15 um" ;
        schema:name "anticlinal_dominant_mode_inner_over_outer_gain" ;
        schema:unitText "dimensionless" ;
        schema:value "0.02809" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-dominant-mode-inner-over-outer-gain-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-dominant-mode-inner-over-outer-gain-reference> a schema:PropertyValue ;
        dcterms:source "Analytic k = 8 (lambda = 24.5 um) inner-face gain k / [k cosh(kH) + beta' sinh(kH)] at H = 15 um, beta = 2.0; NO depth-resolved empirical lobe-amplitude data vendored (open item)" ;
        schema:value "0.02809" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-inner-over-outer-rms-distributed-vs-junction-forcing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "anticlinal_inner_over_outer_rms_distributed_vs_junction_forcing = 0.7015 dimensionless" ;
        schema:measurementTechnique "rms_s delta(s, 0) / rms_s delta_top with the ROP6-RIC1 forcing distributed uniformly through depth (free outer face, Robin inner face beta = 2.0); penetration depth inf um vs 4.0 um; beta sweep inner/outer (junction) = [0.049, 0.041, 0.028, 0.013, 0.0], (distributed) = [1.0, 0.9, 0.702, 0.397, 0.0]" ;
        schema:name "anticlinal_inner_over_outer_rms_distributed_vs_junction_forcing" ;
        schema:unitText "dimensionless" ;
        schema:value "0.7015" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-inner-over-outer-rms-distributed-vs-junction-forcing-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-inner-over-outer-rms-distributed-vs-junction-forcing-reference> a schema:PropertyValue ;
        dcterms:source "Ablation control: same beta and delta_top under outer-junction-only forcing (model-internal reference; Armour et al. 2015 Plant Cell 27:2484 motivates depth-distributed anticlinal wall forcing but reports no amplitude-vs-depth table)" ;
        schema:value "0.0284" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-lobe-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "anticlinal_lobe_wavelength_um = 24.5 um" ;
        schema:measurementTechnique "Dominant Fourier mode k = 8 along L = 196.0 um shared anticlinal wall" ;
        schema:name "anticlinal_lobe_wavelength_um" ;
        schema:unitText "um" ;
        schema:value "24.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-lobe-wavelength-um-reference> .


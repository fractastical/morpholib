        schema:measurementTechnique "Log-log least-squares slope of sigma_m vs R_LEC over 18 solutions (prefactor 9.33 MPa um^-b); sub-linear because the pretension floor T0/h = 15.0 MPa and the 2/3 bulge scaling both flatten sigma(R)" ;
        schema:name "shell_stress_vs_lec_power_exponent" ;
        schema:unitText "dimensionless" ;
        schema:value "0.5114" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-shell-stress-vs-lec-power-exponent-reference> .


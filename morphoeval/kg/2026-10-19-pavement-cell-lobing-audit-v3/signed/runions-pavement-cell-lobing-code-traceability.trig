sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-runions-pavement-cell-lobing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Sapala et al. (2018) & Fu et al. (2005) ROP2-ROP6 interdigitated puzzle-shaped pavement cell lobing, Largest Empty Circle (LEC) turgor stress scaling, reduced pressurized periclinal membrane-shell and depth-resolved anticlinal wall buckling — Code-to-model traceability: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module docstring (L1-L95) maps Laws 1-5 to equations, source figures and the Lean theorem loci; every Pass 3 function docstring states its PDE, boundary conditions and closed forms and names what it is NOT (3D FEM); the math-KG spec registers equations 4-5 with Lean code and code loci. Deductions: the WT generator constants (0.62, 1.25, 3.0, f_band = 0.95 - 0.85 m + 0.50 m^2) are tuned to the vendored benchmark series and cited to no source (L355-L370) (-5); T0 = PH/2 and the 0.97 tolerance in the inscribed-disk check are uncited heuristics (L753, L836) (-3); Panel D's empirical bars are hard-coded literals rather than read from the reference JSON (L1394, L1400) (-2); the v2 wording 'spring-remodeling' survives in the `generate_puzzle_cell_polygon` docstring (L275) although the WT branch no longer remodels springs (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2017-runions-pavement-cell-lobing.py L1394–L1400: ref_L / ref_S literals duplicated from the JSON <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L1394-L1400>",
            "2017-runions-pavement-cell-lobing.py L355–L370: Fitted generator constants with no literature citation <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L355-L370>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-code-traceability-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2017-runions-pavement-cell-lobing.py L1–L95" ;
        dcterms:description "Module docstring: Laws 1-5 with equations, source figures, Lean loci, and the explicit reduced-model/residual statement" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L1-L95> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/runions-pavement-cell-lobing.yaml L1–L121" ;
        dcterms:description "Equations 1-5 with lean_theorem, lean_locus, lean_code, variables, role, code_locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/runions-pavement-cell-lobing.yaml#L1-L121> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 039 Pass 3 Assessor; remediation executed by Claude Fable 5.1)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


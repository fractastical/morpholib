sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-runions-pavement-cell-lobing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2017-runions-pavement-cell-lobing.py L723–L838" ;
        dcterms:description "solve_pressurized_periclinal_shell: FD Dirichlet Poisson solve on the rasterised footprint, self-consistent Foppl tension T = T0 + E h eps/(1-nu), divergence-theorem edge slope, clamped-edge bending boundary layer, inscribed-disk bound" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L723-L838> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2017-runions-pavement-cell-lobing.py L840–L933" ;
        dcterms:description "simulate_periclinal_shell_scaling: 18 solves (WT/iso/ktn1 x 6 areas), Pearson r and log-log exponent of sigma_m vs R_LEC (L888-L889), closed-form disk verification at fixed T (L900-L906)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L840-L933> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2017-runions-pavement-cell-lobing.py L939–L1158" ;
        dcterms:description "anticlinal_depth_mode_gain / simulate_anticlinal_wall_depth_buckling: overflow-stable modal transfer functions for outer-junction and distributed forcing, sparse FD Laplace solve with periodic/Dirichlet/Robin BCs, beta sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L939-L1158> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_039_pavement_cell_lobing.lean L134–L217" ;
        dcterms:description "Laws 4-5: inscribed-disk membrane bound, outward monotonicity and wavenumber ordering of the discrete depth mode (0 sorrys, lean 4.35.0)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_039_pavement_cell_lobing.lean#L134-L217> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Sapala et al. (2018) & Fu et al. (2005) ROP2-ROP6 interdigitated puzzle-shaped pavement cell lobing, Largest Empty Circle (LEC) turgor stress scaling, reduced pressurized periclinal membrane-shell and depth-resolved anticlinal wall buckling — Model fidelity to source: 85/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credits: exact EDT R_LEC (L215-L265) and the Sapala Laplace proxy, a coupled ROP2-ROP6 RD system (L533-L662), and the new reduced periclinal membrane solver (L723-L838) whose discretisation is verified against the closed-form disk (z_max 0.9 %, mean strain 0.3 %, L900-L906) and whose inscribed-disk bound holds on all 18 footprints (L836), plus the depth strip with FD-vs-modal agreement (L1009-L1158). Deductions: the 'shell' is a uniform-tension Foppl membrane with an analytic edge boundary layer, not a bending-coupled 3D FEM shell, and T0 = PH/2 (L753), E = 300 MPa, nu = 0.3 and H = 15 um are assumptions (-5); the reduced mechanics contradicts the Laplace proxy the script headlines (ratio 1.73 vs 3.32, exponent 0.51 vs 1; L888-L889, L1677-L1683) and the discrepancy is reported but not resolved (-4); the WT footprint is a tuned band-plus-capsule construction (L349-L407) rather than Sapala's emergent spring-remodelling, and the RD wall displacement never feeds the polygon (-4); the v2 ribbon construction (aspect 18.7) shows the LEC pinning mechanism was previously achieved by elongation, so v2's 94 was over-credited (-2 carried as a correction)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2017-runions-pavement-cell-lobing.py L329–L338: Comment documenting that the v2 WT construction was a 417 x 22 um ribbon (aspect 18.7) and the Pass 3 replacement; the LEC pinning is still geometric, not emergent <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L329-L338>",
            "2017-runions-pavement-cell-lobing.py L753–L753: T0 = 0.5 * P * H: slab-cell pretension heuristic, not derived from the source model <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L753-L753>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-4> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 039 Pass 3 Assessor; remediation executed by Claude Fable 5.1)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


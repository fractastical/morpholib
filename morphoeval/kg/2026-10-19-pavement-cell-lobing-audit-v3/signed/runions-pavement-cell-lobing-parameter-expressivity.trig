sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-runions-pavement-cell-lobing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2017-runions-pavement-cell-lobing.py L1117–L1136" ;
        dcterms:description "beta sweep over [0, 0.5, 2, 8, clamped] for both forcing hypotheses; self-test 11 asserts monotone ordering" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L1117-L1136> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2017-runions-pavement-cell-lobing.py L1894–L1906" ;
        dcterms:description "CLI: --turgor-P, --wall-h, --neck-R0, --gamma-cross, --alpha-wall, --seed, --shell-E, --wall-depth-H, --inner-anchoring-beta" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L1894-L1906> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 039 Pass 3 Assessor; remediation executed by Claude Fable 5.1)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Sapala et al. (2018) & Fu et al. (2005) ROP2-ROP6 interdigitated puzzle-shaped pavement cell lobing, Largest Empty Circle (LEC) turgor stress scaling, reduced pressurized periclinal membrane-shell and depth-resolved anticlinal wall buckling — Parameter expressivity: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Six area stages x five regimes (L410-L527), ROP2-ROP6 cross-inhibition ablation, and the new Pass 3 controls: beta sweep free -> clamped rendered in Panel I with monotone inner/outer ordering (0.049, 0.041, 0.028, 0.013, 0.0; L1117-L1136), the outer-junction vs depth-distributed forcing ablation (inner/outer 0.028 vs 0.70), and CLI overrides --shell-E, --wall-depth-H, --inner-anchoring-beta (L1904-L1906). Deductions: E, H and T0 are only CLI-exposed — no rendered sweep shows how the sigma(R_LEC) exponent and the 1.73x ratio move with E or H, although the conclusion depends on them (-7); the WT generator's lobe constants are fixed internals, not morphospace parameters (-3); the depth model's H is shared with the shell pretension so the two cannot be varied independently from the CLI (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2017-runions-pavement-cell-lobing.py L1498–L1517: Panel H: single-E, single-H scatter; no E/H sweep of the exponent or ratio is rendered <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L1498-L1517>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-parameter-expressivity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


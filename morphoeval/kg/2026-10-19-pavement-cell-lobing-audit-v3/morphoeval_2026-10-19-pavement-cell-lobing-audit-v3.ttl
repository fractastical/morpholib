    dct:source "Sapala et al. (2018) Box 1 thin-walled pressure-vessel proxy sigma_max = P R_LEC / (2h) (exponent 1); Foppl large-stretch asymptote predicts 2/3 (bulge-test scaling T^3 ~ E h P^2 R^2 / 16)" ;
    schema:about "Arabidopsis thaliana (cotyledon & leaf epidermal pavement cells)" ;
    schema:error 4.886e+01 ;
    schema:targetValue 1e+00 ;
    schema:unitText "dimensionless" ;
    schema:value 5.114e-01 .


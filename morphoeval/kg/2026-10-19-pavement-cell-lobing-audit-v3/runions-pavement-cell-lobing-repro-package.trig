sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-runions-pavement-cell-lobing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Sapala et al. (2018) & Fu et al. (2005) ROP2-ROP6 interdigitated puzzle-shaped pavement cell lobing, Largest Empty Circle (LEC) turgor stress scaling, reduced pressurized periclinal membrane-shell and depth-resolved anticlinal wall buckling — Reproducibility package: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "13-check deterministic self-test (L1804-L1891) in ~6 s covering SHA-256 integrity, Laws 1-5, the disk closed form, the linear P/T scaling of the fixed-T solver, FD-vs-modal agreement for Robin, clamped and free inner faces, the beta-sweep ordering, the 17-measurement contract and bitwise determinism; default render ~7 s; seed, grid and tolerances fixed in code; CLI documented in argparse. Deductions: the specimen lobeyness recorded by v2 (1.506) is not reproduced in this environment (1.316) by unchanged segmentation code — environment-induced result drift the rubric counts against this dimension (-6); there is no pinned requirements lock for this slot (-3); the invocation does not mention MPLCONFIGDIR / font-cache side effects (-1); README-level documentation of the Pass 3 CLI flags exists only in argparse help (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2017-runions-pavement-cell-lobing.py L1164–L1271: segment_arabidopsis_pavement_specimen unchanged since v2; lobeyness depends on contour smoothing sigma = 1.2 px and skimage/scipy versions <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L1164-L1271>",
            "morphoeval/audits/2026-10-19-pavement-cell-lobing-audit-v2.measurements.yaml L29–L31: v2 recorded specimen mean L = 1.506; the current environment yields 1.316 with identical segmentation code (N = 10, S = 0.720 unchanged) <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/audits/2026-10-19-pavement-cell-lobing-audit-v2.measurements.yaml#L29-L31>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-repro-package-1> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2017-runions-pavement-cell-lobing.py L1804–L1891" ;
        dct:description "run_self_test: 13 checks incl. closed-form disk, P/T linearity, inscribed-disk bound, FD-vs-modal for three inner-face conditions, determinism of shell stresses" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2017-runions-pavement-cell-lobing.py#L1804-L1891> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 039 Pass 3 Assessor; remediation executed by Claude Fable 5.1)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


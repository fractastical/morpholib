sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-streichan-global-morphogenetic-flow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Streichan et al. (2018), Mayer et al. (2010) & Lefebvre et al. (2023) Drosophila global morphogenetic flow & active nematic myosin tensor mechanics — Reproducibility package: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Deterministic RNG (`seed=2018`), standalone `--self-test` suite verifying SHA-256 dataset locks, positive-definite Stokes-Brinkman Fourier symbols and spectral Green's function convergence (`l2_rel_error = 1.62e-16`), trace-free nematic stress tensor (`Tr(Q) = 0`), 6-regime hierarchy (`r = 1.0000`), bitwise two-run determinism (`atol=0.0`), and confocal specimen segmentation, plus rendered 6-panel PNG and 24-frame GIF in `docs/media/`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-repro-package-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2018-streichan-global-morphogenetic-flow.py L884–L945" ;
        dcterms:description "Deterministic --self-test suite verifying SHA-256 locks, 3 theorems, 6 regimes, and specimen CV" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2018-streichan-global-morphogenetic-flow.py#L884-L945> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/global_morphogenetic_flow_growth.gif (generated output)" ;
        dcterms:description "24-frame animated GIF comparing WT anisotropic+PMG germband extension vs isotropic-only and bcd nos tsl null controls — docs/media/global_morphogenetic_flow_growth.gif: rendered output of 2018-streichan-global-morphogenetic-flow.py at 317bc3c, image/gif, 745906 B, 1449×462 px, 24 frames, artifact_sha256 62b8813d6c46f6fd3e8f25ff8bf3e311a36c0b52b0b6db60b7b82d5dbb27fa02 (sha256 62b8813d6c46f6fd3e8f25ff8bf3e311a36c0b52b0b6db60b7b82d5dbb27fa02), spec_fingerprint c6f91e927b85c9e6c96461d53e4ae9c082d9c0ad9d74ed650b6b2f21fb08b782" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-streichan-global-morphogenetic-flow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Streichan et al. (2018), Mayer et al. (2010) & Lefebvre et al. (2023) Drosophila global morphogenetic flow & active nematic myosin tensor mechanics — Morphological realism / specimen match: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the CC BY 4.0 whole-embryo confocal micrograph of Drosophila melanogaster early gastrulation and germband extension (`datasets/global_morphogenetic_flow/drosophila_germband_extension_specimen.jpg`, IDR0151 / Clark et al. 2022 eLife 11:e78902), automatically segments the prolate spheroid blastoderm contour (`1133x475 px`, `AP/DV = 2.3853` vs `2.3810` biological reference, `ellipsoidal_solidity = 0.9383`), detects all 8 pair-rule trunk stripes (`mean_stripe_spacing_px = 75.86`), and quantifies DV cable gradient anisotropy (`1.0419`) and dorsal-posterior PMG invagination indentation (`122.0 px`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2018-streichan-global-morphogenetic-flow.py L507–L567" ;
        dcterms:description "Automated confocal blastoderm contour, 8 pair-rule stripe, and PMG invagination CV segmentation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2018-streichan-global-morphogenetic-flow.py#L507-L567> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/global_morphogenetic_flow_comparison.png (generated output)" ;
        dcterms:description "6-panel synthesis figure displaying segmented IDR0151 confocal specimen and pair-rule stripe peaks — docs/media/global_morphogenetic_flow_comparison.png: rendered output of 2018-streichan-global-morphogenetic-flow.py at 317bc3c, image/png, 890697 B, 2464×1470 px, artifact_sha256 c2b12d9cc11f49cbc76202021e27a120ea25ff2713abd4ee312c77cb90e82127 (sha256 c2b12d9cc11f49cbc76202021e27a120ea25ff2713abd4ee312c77cb90e82127), spec_fingerprint c6f91e927b85c9e6c96461d53e4ae9c082d9c0ad9d74ed650b6b2f21fb08b782" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-streichan-global-morphogenetic-flow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Streichan et al. (2018), Mayer et al. (2010) & Lefebvre et al. (2023) Drosophila global morphogenetic flow & active nematic myosin tensor mechanics — Model fidelity to source: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Faithfully implements 2D spectral Helmholtz longitudinal-transverse inversion of the compressible Stokes-Brinkman operator `L_{ij}(k) = (eta|k|^2 + xi)delta_{ij} + eta_b k_i k_j` (machine-precision Green's function error `1.62e-16`), trace-free active nematic Myosin-II stress tensor `sigma^a_{ij} = alpha_iso m_iso delta_{ij} + alpha_aniso m_aniso Q_{ij}` with `Tr(Q) = 0`, and 30 min Lagrangian germband marker advection (L114-398), backed by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2018-streichan-global-morphogenetic-flow.py L114–L248" ;
        dct:description "2D spectral compressible Stokes-Brinkman solver and exact manufactured Green's function verification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2018-streichan-global-morphogenetic-flow.py#L114-L248> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2018-streichan-global-morphogenetic-flow.py L251–L398" ;
        dct:description "Trace-free active nematic Myosin-II stress tensor and blastoderm 4-vortex flow solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2018-streichan-global-morphogenetic-flow.py#L251-L398> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean L21–L178" ;
        dct:description "3 machine-checked Lean 4 theorems (0 sorrys) for Stokes-Brinkman positive-definiteness, trace-free nematic DV cable stress, and 6-regime mutant collapse" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_048_global_morphogenetic_flow.lean#L21-L178> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/nature09376>,
            <https://doi.org/10.7554/eLife.27454>,
            <https://doi.org/10.7554/eLife.78787>,
            <https://doi.org/10.7554/eLife.95521> .
    <https://doi.org/10.1038/nature09376> dct:date "2010"^^xsd:gYear ;
        dct:title "Anisotropies in cortical tension reveal the physical basis of polarizing cortical flows" .
    <https://doi.org/10.7554/eLife.27454> dct:date "2018"^^xsd:gYear ;
        dct:title "Global morphogenetic flow is accurately predicted by the spatial distribution of myosin" .
    <https://doi.org/10.7554/eLife.78787> dct:date "2023"^^xsd:gYear ;
        dct:title "Geometric control of myosin II orientation during axis elongation" .
    <https://doi.org/10.7554/eLife.95521> dct:date "2024"^^xsd:gYear ;
        dct:title "The geometric basis of epithelial convergent extension" .
}


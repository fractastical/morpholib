}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-streichan-global-morphogenetic-flow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-streichan-global-morphogenetic-flow-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Streichan et al. (2018), Mayer et al. (2010) & Lefebvre et al. (2023) Drosophila global morphogenetic flow & active nematic myosin tensor mechanics — Code-to-model traceability: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Every computational function and docstring maps directly to Streichan et al. (2018) eLife Figs. 1-5, Mayer et al. (2010) Nature Eq. 1, Lefebvre et al. (2023) eLife Figs. 1-4, and the 3 Lean 4 theorems in `Loop_048_global_morphogenetic_flow.lean` and `morphoeval/math_kg_loops/streichan-global-morphogenetic-flow.yaml`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-code-traceability-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2018-streichan-global-morphogenetic-flow.py L1–L52" ;
        dct:description "Module docstring linking governing equations to Streichan et al. (2018), Mayer et al. (2010), Lefebvre et al. (2023), and Lean 4 theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2018-streichan-global-morphogenetic-flow.py#L1-L52> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-streichan-global-morphogenetic-flow-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/streichan-global-morphogenetic-flow.yaml L1–L90" ;
        dct:description "Math KG loop specification linking equations, Lean 4 declarations, and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/math_kg_loops/streichan-global-morphogenetic-flow.yaml#L1-L90> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/nature09376>,
            <https://doi.org/10.7554/eLife.27454>,
            <https://doi.org/10.7554/eLife.78787>,
            <https://doi.org/10.7554/eLife.95521> .
    <https://doi.org/10.1038/nature09376> dct:date "2010"^^xsd:gYear ;
        dct:title "Anisotropies in cortical tension reveal the physical basis of polarizing cortical flows" .
    <https://doi.org/10.7554/eLife.27454> dct:date "2018"^^xsd:gYear ;
        dct:title "Global morphogenetic flow is accurately predicted by the spatial distribution of myosin" .
    <https://doi.org/10.7554/eLife.78787> dct:date "2023"^^xsd:gYear ;
        dct:title "Geometric control of myosin II orientation during axis elongation" .
    <https://doi.org/10.7554/eLife.95521> dct:date "2024"^^xsd:gYear ;
        dct:title "The geometric basis of epithelial convergent extension" .
}


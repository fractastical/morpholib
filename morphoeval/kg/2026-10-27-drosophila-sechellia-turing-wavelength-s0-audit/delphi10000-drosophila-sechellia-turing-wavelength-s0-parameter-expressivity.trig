sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila sechellia Turing wavelength at 1.5 µm (Holocene, detail scale s0) — Parameter expressivity: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Raising f_u, with g_u co-adapted to the same onset depth, shortens λ monotonically across seven values (r = 0.9996). The dispersion panel plots all three chronospecies but the positive lobe (σ_max ≈ 0.004) is lost on an axis that runs down to −0.5." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py L256–L291" ;
        dct:description "parameter_sweep over f_u with co-adapted g_u" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3a2687497deaf1d3dae381dbe02b0ce57adcd532/models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py#L256-L291> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py L648–L666" ;
        dct:description "dispersion curves for santomea, serrata, sechellia" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3a2687497deaf1d3dae381dbe02b0ce57adcd532/models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py#L648-L666> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;

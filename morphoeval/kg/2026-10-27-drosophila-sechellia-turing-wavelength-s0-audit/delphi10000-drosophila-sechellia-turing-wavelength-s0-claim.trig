sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Drosophila sechellia Turing wavelength at 1.5 µm (Holocene, detail scale s0) faithfully reproduces Drosophila sechellia morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila sechellia specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py; output: docs/media/drosophila_sechellia_turing_wavelength_s0_comparison.png; organism: Drosophila sechellia; environment: python 3.12.3, numpy 2.5.4, scipy 1.18.1, matplotlib 3.11.2, Pillow 13.0.0; claim_boundary: [reported_in_source: Turing 1952: k_c from the dispersion relation, and instability only when diffusivities differ. | McGregor 2007 and Sucena & Stern 2000: D. sechellia larval trichome loss is cis-regulatory at shavenbaby. | Jeong 2008: D. santomea lost abdominal pigment via a tan enhancer. | Chenoweth & Blows 2005: D. serrata signal traits are under mutual sexual selection.; reconstructed_in_script: Near-onset Jacobians with analytical wavelengths 1.921, 1.680 and 1.500 µm. | Fourier integrator, seven-point f_u sweep, four-seed CV, KS against a Gaussian ring, Otsu metrics on the ovary micrograph.; transfer_boundary: The CC-BY image is a nucleic-acid stain of an ovary, not an ocellar pigment-granule micrograph. | Shoup 1966 is D. melanogaster ultrastructure, used only as a scale class.; does_not_claim: That 1.5 µm was measured as a granule spacing in D. sechellia. | That Morinda octanoic-acid resistance sets k_c. | The 88 µm cellular wavelength already modelled in slot 2711.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.cell.2008.01.014>,
            <https://doi.org/10.1038/nature05988>,
            <https://doi.org/10.1073/pnas.97.9.4530>,
            <https://doi.org/10.1083/jcb.29.2.223>,
            <https://doi.org/10.1086/427271>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2008.01.014>,
            <https://doi.org/10.1038/nature05988>,
            <https://doi.org/10.1073/pnas.97.9.4530>,
            <https://doi.org/10.1083/jcb.29.2.223>,
            <https://doi.org/10.1086/427271>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://doi.org/10.1016/j.cell.2008.01.014> dct:date "2008"^^xsd:gYear ;
        dct:title "The evolution of gene regulation underlies a morphological difference between two Drosophila sister species" .
    <https://doi.org/10.1038/nature05988> dct:date "2007"^^xsd:gYear ;
        dct:title "Morphological evolution through multiple cis-regulatory mutations at a single gene" .
    <https://doi.org/10.1073/pnas.97.9.4530> dct:date "2000"^^xsd:gYear ;
        dct:title "Divergence of larval morphology between Drosophila sechellia and its sibling species caused by cis-regulatory evolution of a single gene" .
    <https://doi.org/10.1083/jcb.29.2.223> dct:date "1966"^^xsd:gYear ;
        dct:title "The development of pigment granules in the eyes of wild type and mutant Drosophila melanogaster" .
    <https://doi.org/10.1086/427271> dct:date "2005"^^xsd:gYear ;
        dct:title "Contrasting mutual sexual selection on homologous signal traits in Drosophila serrata" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
}


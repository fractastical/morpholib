<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-sechellia-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical Turing wavenumber" ;
    dct:description "Selects the 1.5 µm detail-scale pigment-lattice wavelength in D. sechellia | Variables: f_u=1.600, g_v=-7.200, D_v/D_u=8, lambda_c=1.500 µm at age 0 Ma" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3a2687497deaf1d3dae381dbe02b0ce57adcd532/models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/3a2687497deaf1d3dae381dbe02b0ce57adcd532/morphoeval/lean/loops/Loop_3202_drosophila_sechellia_turing_wavelength_s0.lean#L38-L39> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); lambda_c = 2 pi / k_c = 1.500 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2008.01.014>,
        <https://doi.org/10.1038/nature05988>,
        <https://doi.org/10.1073/pnas.97.9.4530>,
        <https://doi.org/10.1083/jcb.29.2.223>,
        <https://doi.org/10.1086/427271>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3202.lambdaSechelliaNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3202.wavelength_times_wavenumber_is_two_pi" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-sechellia-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homogeneous stability (trace and determinant)" ;
    dct:description "The unpatterned state is stable until diffusion is added | Variables: f_u=1.600, f_v=-2.770, g_u=4.500, g_v=-7.200" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3a2687497deaf1d3dae381dbe02b0ce57adcd532/models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/3a2687497deaf1d3dae381dbe02b0ce57adcd532/morphoeval/lean/loops/Loop_3202_drosophila_sechellia_turing_wavelength_s0.lean#L22-L28> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "trace = f_u + g_v < 0 and det = f_u g_v - f_v g_u > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2008.01.014>,
        <https://doi.org/10.1038/nature05988>,
        <https://doi.org/10.1073/pnas.97.9.4530>,
        <https://doi.org/10.1083/jcb.29.2.223>,
        <https://doi.org/10.1086/427271>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3202.homogeneous_trace_negative" ;
    pk:leanTheorem "MathOfBiology.Loop_3202.homogeneous_determinant_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-sechellia-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronospecies wavelength order at 0 Ma" ;
    dct:description "What changes at 1.5 µm versus the predecessor D. santomea and the successor D. serrata | Variables: shared D_u, D_v, f_v, g_v and h_min; species-specific f_u and co-adapted g_u" ;
    dct:source "Jeong 2008 DOI:10.1016/j.cell.2008.01.014; Chenoweth & Blows 2005 DOI:10.1086/427271; McGregor 2007 DOI:10.1038/nature05988" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3a2687497deaf1d3dae381dbe02b0ce57adcd532/models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/3a2687497deaf1d3dae381dbe02b0ce57adcd532/morphoeval/lean/loops/Loop_3202_drosophila_sechellia_turing_wavelength_s0.lean#L16-L18> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda(santomea)=1.921 µm > lambda(serrata)=1.680 µm > lambda(sechellia)=1.500 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2008.01.014>,
        <https://doi.org/10.1038/nature05988>,
        <https://doi.org/10.1073/pnas.97.9.4530>,
        <https://doi.org/10.1083/jcb.29.2.223>,
        <https://doi.org/10.1086/427271>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3202.lambdaSantomeaNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3202.sechellia_shorter_than_both_neighbours" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-sechellia-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Differential diffusion" ;
    dct:description "Diffusion-driven instability fails in the equal-diffusion ablation | Variables: D_v/D_u = 8" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3a2687497deaf1d3dae381dbe02b0ce57adcd532/models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py>,

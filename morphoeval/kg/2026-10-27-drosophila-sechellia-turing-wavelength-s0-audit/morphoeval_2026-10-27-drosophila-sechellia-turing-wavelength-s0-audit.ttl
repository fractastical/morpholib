    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_v = 8 D_u; equal diffusivities damp every mode" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2008.01.014>,
        <https://doi.org/10.1038/nature05988>,
        <https://doi.org/10.1073/pnas.97.9.4530>,

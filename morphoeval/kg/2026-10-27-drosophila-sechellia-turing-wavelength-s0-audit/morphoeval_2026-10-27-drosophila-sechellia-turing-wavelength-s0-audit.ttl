    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila sechellia Turing wavelength at 1.5 µm (Holocene, detail scale s0) — Model fidelity to source: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script implements the Turing PDE, the classical k_c formula, periodic boundaries, cubic saturation, and a true equal-diffusion ablation. g_u is co-adapted to hold h_min fixed rather than taken from a measured rate, so this is a reconstruction of the dispersion law at the assigned scale, not a transcription of a numbered table from McGregor 2007." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila sechellia Turing wavelength at 1.5 µm (Holocene, detail scale s0) — Morphometric validation: 85/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Analytical λ_c is 1.500 µm. The render-grid Fourier peak is 1.480 µm (relative error 1.3%). Sweep RMSE after the stated affine calibration is 0.0040 µm. Four-seed CV is 0.006. Otsu foreground fraction 0.352, aspect and coherency are compared with priors they do not equal. KS distance to a narrow Gaussian ring is 0.229, which is reported rather than forced to zero." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

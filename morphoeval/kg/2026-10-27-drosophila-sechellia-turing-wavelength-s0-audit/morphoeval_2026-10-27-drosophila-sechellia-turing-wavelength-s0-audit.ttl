        <https://doi.org/10.1086/427271>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3202.inhibitor_diffuses_faster" ;
    pk:leanTheorem "MathOfBiology.Loop_3202.diffusivity_ratio_is_not_one" ;

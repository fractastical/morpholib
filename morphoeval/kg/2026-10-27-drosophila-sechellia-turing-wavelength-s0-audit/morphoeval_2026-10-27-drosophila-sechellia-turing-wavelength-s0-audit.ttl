        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-parameter-expressivity-2> ;
    pk:hasScore 8.4e-01 ;
    pk:hasVerdict "faithful" .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila sechellia Turing wavelength at 1.5 µm (Holocene, detail scale s0) — Morphometric validation: 85/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Analytical λ_c is 1.500 µm. The render-grid Fourier peak is 1.480 µm (relative error 1.3%). Sweep RMSE after the stated affine calibration is 0.0040 µm. Four-seed CV is 0.006. Otsu foreground fraction 0.352, aspect and coherency are compared with priors they do not equal. KS distance to a narrow Gaussian ring is 0.229, which is reported rather than forced to zero." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-activator-gain-sweep-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-activator-gain-sweep-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-analytical-turing-wavelength-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-equal-diffusion-negative-control-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-multi-seed-stripe-wavelength-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-radial-spectrum-ks-distance-vs-analytical-ring>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-santomea-predecessor-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-serrata-successor-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-simulated-stripe-peak-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-specimen-segmented-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-specimen-segmented-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-specimen-stripe-segmentation-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-activator-gain-sweep-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "activator-gain sweep Pearson r = 0.999647 correlation" ;
        dct:description "RMSE after affine calibration=0.00399 µm; monotonic=True" ;
        schema:measurementTechnique "Pearson r between analytical λ_c(f_u) and power-weighted wavelength over 7 co-adapted Jacobians" ;
        schema:name "activator-gain sweep Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.999647" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-activator-gain-sweep-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-activator-gain-sweep-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 k_c formula; perfect correlation would be 1" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-activator-gain-sweep-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "activator-gain sweep RMSE = 0.003991 µm" ;
        dct:description "calibration removes the stable-side-mode bias of the spectral mean; r is uncalibrated" ;
        schema:measurementTechnique "RMSE of calibrated power-weighted wavelength against analytical λ_c(f_u)" ;
        schema:name "activator-gain sweep RMSE" ;
        schema:unitText "µm" ;
        schema:value "0.003991" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-activator-gain-sweep-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-activator-gain-sweep-rmse-reference> a schema:PropertyValue ;
        dct:source "Zero residual is the ideal of a noise-free linear mode" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-analytical-turing-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "analytical Turing wavelength lambda_c = 1.5 µm" ;
        dct:description "trace=-5.6000, det=0.9450, hmin=-0.0350" ;
        schema:measurementTechnique "lambda_c = 2π / k_c with k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v)" ;
        schema:name "analytical Turing wavelength lambda_c" ;
        schema:unitText "µm" ;
        schema:value "1.5" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-analytical-turing-wavelength-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-analytical-turing-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Slot scale 1.548e-06 m is the metre expression of the 1.5 µm tier, not the nondimensional λ_c" ;
        schema:value "1.548" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-equal-diffusion-negative-control-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion negative control sigma_max = -0.175962 1/time" ;
        dct:description "negative σ_max means the stripe mode is damped when diffusivities are equal" ;
        schema:measurementTechnique "largest eigenvalue of J − k² D after setting D_v = D_u" ;
        schema:name "equal-diffusion negative control sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.175962" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-equal-diffusion-negative-control-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-equal-diffusion-negative-control-sigma-max-reference> a schema:PropertyValue ;
        dct:source "Turing 1952: diffusion-driven instability requires D_u ≠ D_v" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-multi-seed-stripe-wavelength-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "multi-seed stripe wavelength CV = 0.006164 CV" ;
        dct:description "peaks=[1.4795908857482158, 1.5, 1.4976905298081187, 1.4948186373673196]" ;
        schema:measurementTechnique "sample CV of the Fourier peak wavelength across four RNG seeds" ;
        schema:name "multi-seed stripe wavelength CV" ;
        schema:unitText "CV" ;
        schema:value "0.006164" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-multi-seed-stripe-wavelength-cv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-multi-seed-stripe-wavelength-cv-reference> a schema:PropertyValue ;
        dct:source "A disordered pigment field would have spacing CV near 0.15; onset selection is tighter" ;
        schema:value "0.15" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-radial-spectrum-ks-distance-vs-analytical-ring> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "radial-spectrum KS distance vs analytical ring = 0.22864 KS" ;
        dct:description "lower is closer; the packet has a finite unstable bandwidth" ;
        schema:measurementTechnique "Kolmogorov-Smirnov distance between the 24-bin radial power of u and a Gaussian ring at k_c" ;
        schema:name "radial-spectrum KS distance vs analytical ring" ;
        schema:unitText "KS" ;
        schema:value "0.22864" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-radial-spectrum-ks-distance-vs-analytical-ring-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-radial-spectrum-ks-distance-vs-analytical-ring-reference> a schema:PropertyValue ;
        dct:source "A pure single-mode cosine has a narrower ring than the near-onset packet" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-santomea-predecessor-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "santomea predecessor lambda_c = 1.920553 µm" ;
        dct:description "σ_max=0.0045; longer than sechellia" ;
        schema:measurementTechnique "same (D_u, D_v, f_v, g_v, h_min); f_u=1.327 and co-adapted g_u (tan-loss)" ;
        schema:name "santomea predecessor lambda_c" ;
        schema:unitText "µm" ;
        schema:value "1.920553" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-santomea-predecessor-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-santomea-predecessor-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Jeong et al. 2008 Cell 132:783, DOI 10.1016/j.cell.2008.01.014" ;
        schema:value "1.5000000000000004" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-serrata-successor-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "serrata successor lambda_c = 1.680054 µm" ;
        dct:description "σ_max=0.0042; between santomea and sechellia" ;
        schema:measurementTechnique "same diffusivities and onset depth; f_u=1.458 and co-adapted g_u" ;
        schema:name "serrata successor lambda_c" ;
        schema:unitText "µm" ;
        schema:value "1.680054" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-serrata-successor-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-serrata-successor-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Chenoweth & Blows 2005 Am. Nat. 165:281, DOI 10.1086/427271" ;
        schema:value "1.92055319899344" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-simulated-stripe-peak-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated stripe peak wavelength = 1.479591 µm" ;
        dct:description "relative error=0.01361; weighted λ=1.5004 µm" ;
        schema:measurementTechnique "argmax of the 2D Fourier power of the final activator, periodic 18 µm × 13.5 µm patch" ;
        schema:name "simulated stripe peak wavelength" ;
        schema:unitText "µm" ;
        schema:value "1.479591" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-simulated-stripe-peak-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-simulated-stripe-peak-wavelength-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 dispersion; target λ_c = 1.500 µm" ;
        schema:value "1.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-specimen-segmented-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen segmented aspect ratio = 1.331307 width/height" ;
        dct:description "bbox 438×329 px" ;
        schema:measurementTechnique "bounding box of the Otsu foreground of the ovary micrograph" ;
        schema:name "specimen segmented aspect ratio" ;
        schema:unitText "width/height" ;
        schema:value "1.331307" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-specimen-segmented-aspect-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-specimen-segmented-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "A circular prior (aspect 1) is the null; the micrograph is not a circle" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-specimen-segmented-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen segmented foreground fraction = 0.352072 fraction" ;
        dct:description "threshold=0.182; not a self-copy of the prior 0.50" ;
        schema:measurementTechnique "Otsu threshold on the CC-BY D. sechellia ovary micrograph, resized to 480×360" ;
        schema:name "specimen segmented foreground fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.352072" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-specimen-segmented-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-specimen-segmented-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "Wikimedia Commons File:Drosophila_sechellia_ovary_stained_with_nucleic_acid_specific_dye_(16378644002).jpg" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-specimen-stripe-segmentation-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen stripe-segmentation circularity = 0.067839 4πA/P²" ;
        dct:description "used as a non-circular specimen morphometric, not as a Turing wavelength" ;
        schema:measurementTechnique "isoperimetric quotient of the Otsu mask of the real micrograph" ;
        schema:name "specimen stripe-segmentation circularity" ;
        schema:unitText "4πA/P²" ;
        schema:value "0.067839" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-specimen-stripe-segmentation-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-specimen-stripe-segmentation-circularity-reference> a schema:PropertyValue ;
        dct:source "A disk has circularity 1; the ovary mask does not" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.611938 dimensionless" ;
        dct:description "circularity=0.0678" ;
        schema:measurementTechnique "(λ1−λ2)/(λ1+λ2) averaged on the Otsu foreground after a radius-2 box smooth" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "dimensionless" ;
        schema:value "0.611938" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "Weak-coherency prior 0.25; the stained ovary is more oriented" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py L430–L555" ;

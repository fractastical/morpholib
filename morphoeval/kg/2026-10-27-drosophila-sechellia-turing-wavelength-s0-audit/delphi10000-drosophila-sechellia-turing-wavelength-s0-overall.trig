sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila sechellia Turing wavelength at 1.5 µm (Holocene, detail scale s0) — MorphoEval overall 84.0/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 1 implements the Turing 1952 critical-wavenumber law on an 18 µm × 13.5 µm periodic patch. The sechellia Jacobian is pinned at λ_c = 1.500 µm with trace < 0, det > 0 and h_min = −0.035. Predecessor D. santomea (f_u = 1.327) selects 1.921 µm; successor D. serrata (f_u = 1.458) selects 1.680 µm. The activator-gain sweep has Pearson r = 0.9996. The equal-diffusion control has σ_max = −0.176. The render-grid Fourier peak is 1.480 µm (1.3% short of 1.500). The comparison figure's panel F annotation collides with the tick labels, and the dispersion panel's y-range hides the σ ≈ 0.004 unstable lobe. Age 0 Ma and scale 1.5 µm are stated in the reference record and the figure title. Overall 84.0/100 (faithfulness 83.4, reproducibility 85.5); rubric morphoeval 0.1.0; checkpoint commit 3a2687497deaf1d3dae381dbe02b0ce57adcd532; environment: python 3.12.3, numpy 2.5.4, scipy 1.18.1, matplotlib 3.11.2, Pillow 13.0.0. Dimension assessments: Model fidelity to source 86, Morphological realism / specimen match 80, Parameter expressivity 84, Morphometric validation 85, Source and data traceability 90, Code-to-model traceability 82, Reproducibility package 84. Output judged: docs/media/drosophila_sechellia_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py at 3a2687497deaf1d3dae381dbe02b0ce57adcd532, image/png, 477513 B, 1512×978 px, artifact_sha256 6ce4f8039da1826566737fc82288e4e2a317baa0caaba144902ba1216beec4fb (sha256 6ce4f8039da1826566737fc82288e4e2a317baa0caaba144902ba1216beec4fb), spec_fingerprint 3e976ad024ca3ede382f29ba68b3901386a7d687255a0ab472b27fe393935203. Dual provenance: spec_fingerprint: 3e976ad024ca3ede382f29ba68b3901386a7d687255a0ab472b27fe393935203; artifact_sha256: 6ce4f8039da1826566737fc82288e4e2a317baa0caaba144902ba1216beec4fb; input_dataset_sha256: {datasets/drosophila_sechellia_turing_wavelength_s0/drosophila_sechellia_ovary_specimen.jpg=5a765a91794b001a..., datasets/drosophila_sechellia_turing_wavelength_s0/drosophila_sechellia_turing_wavelength_s0_reference.json=4dda020e70850732..., datasets/drosophila_sechellia_turing_wavelength_s0/paper_citations.bib=e61c4c157d3f887c..., datasets/drosophila_sechellia_turing_wavelength_s0/scout_manifest.json=20e1cd87901f1516...}. Claim boundary: reported_in_source: Turing 1952: k_c from the dispersion relation, and instability only when diffusivities differ. | McGregor 2007 and Sucena & Stern 2000: D. sechellia larval trichome loss is cis-regulatory at shavenbaby. | Jeong 2008: D. santomea lost abdominal pigment via a tan enhancer. | Chenoweth & Blows 2005: D. serrata signal traits are under mutual sexual selection.; reconstructed_in_script: Near-onset Jacobians with analytical wavelengths 1.921, 1.680 and 1.500 µm. | Fourier integrator, seven-point f_u sweep, four-seed CV, KS against a Gaussian ring, Otsu metrics on the ovary micrograph.; transfer_boundary: The CC-BY image is a nucleic-acid stain of an ovary, not an ocellar pigment-granule micrograph. | Shoup 1966 is D. melanogaster ultrastructure, used only as a scale class.; does_not_claim: That 1.5 µm was measured as a granule spacing in D. sechellia. | That Morinda octanoic-acid resistance sets k_c. | The 88 µm cellular wavelength already modelled in slot 2711.." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: {'id': 'R1', 'item': 'Move the equal-diffusion annotation in render_png off the panel F tick labels.'}",
            "remediation needed: {'id': 'R2', 'item': 'Show the unstable lobe of σ(k). The near-onset peak is about +0.004 and is invisible on the current y-range.'}",
            "remediation needed: {'id': 'R3', 'item': 'Bring the render-grid Fourier peak from 1.480 µm to within 0.5% of the analytical 1.500 µm.'}",
            "remediation needed: {'id': 'R4', 'item': 'A second assessor from another provider has not scored this audit. Do not invent one.'}" ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second provider in this run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila sechellia Turing wavelength at 1.5 µm (Holocene, detail scale s0) — Morphological realism / specimen match: 80/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Panel A is the real CC-BY D. sechellia ovary micrograph and panel C modulates it by the field. The growth GIF is 12 frames at 720×540 and its last frame scores CV 96 against that micrograph. Panel F's equal-diffusion annotation is drawn on top of the species names, and the micrograph is ovarian nuclei rather than the ocellar lattice the wavelength refers to." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py L698–L705: annotation anchored at axes fraction (0.02, 0.02), over the tick labels <https://github.com/fractastical/morpholib/blob/3a2687497deaf1d3dae381dbe02b0ce57adcd532/models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py#L698-L705>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-sechellia-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/drosophila_sechellia_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "six-panel comparison; panel F label collides with ticks — docs/media/drosophila_sechellia_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-drosophila-sechellia-turing-wavelength-s0.py at 3a2687497deaf1d3dae381dbe02b0ce57adcd532, image/png, 477513 B, 1512×978 px, artifact_sha256 6ce4f8039da1826566737fc82288e4e2a317baa0caaba144902ba1216beec4fb (sha256 6ce4f8039da1826566737fc82288e4e2a317baa0caaba144902ba1216beec4fb), spec_fingerprint 3e976ad024ca3ede382f29ba68b3901386a7d687255a0ab472b27fe393935203" .

<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/sheth-hox-turing-polydactyly-1>,
        <https://w3id.org/probknow/resource/math-law/sheth-hox-turing-polydactyly-2>,
        <https://w3id.org/probknow/resource/math-law/sheth-hox-turing-polydactyly-3> .

<https://w3id.org/probknow/resource/math-law/sheth-hox-turing-polydactyly-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing Equal-Diffusion Negative Control (No Digit Patterning for D_u = D_v)" ;
    dct:description "Proves that equal activator and inhibitor diffusivities abolish Turing instability across all spatial wavenumbers, serving as the formal negative control | Variables: tr(J_0) = f_u + g_v: homogeneous Jacobian trace; det(J_0) = f_u g_v - f_v g_u: homogeneous Jacobian determinant; Dq = D k^2: scaled diffusion wavenumber" ;
    dct:source "Sheth et al. (2012) Science 338(6113):1476-1480 Fig. 3 & Suppl. Eqs. (S1)-(S4); Turing (1952) Phil. Trans. R. Soc. B 237:37-72" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py#L120-L210>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_015_hox_turing_polydactyly.lean#L19-L41> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def modal_trace_eq_diff (tr_J0 Dq : Int) : Int := tr_J0 - 2 * Dq
def modal_det_eq_diff (det_J0 neg_tr_Dq Dq_sq : Int) : Int :=
  det_J0 + neg_tr_Dq + Dq_sq
theorem sheth_turing_equal_diffusion_no_instability (tr_J0 det_J0 Dq neg_tr_Dq Dq_sq : Int)
    (htr : tr_J0 < 0) (hdet : det_J0 > 0)
    (hDq : Dq ≥ 0) (hterm : neg_tr_Dq ≥ 0) (hsq : Dq_sq ≥ 0) :
    modal_trace_eq_diff tr_J0 Dq < 0 ∧ modal_det_eq_diff det_J0 neg_tr_Dq Dq_sq > 0 := by
  unfold modal_trace_eq_diff modal_det_eq_diff; omega
"""^^pk:lean4 ;
    skos:notation "tr(J_0) < 0 ∧ det(J_0) > 0 ∧ D_u = D_v = D ≥ 1 ⟹ ∀ q = k^2 ≥ 0, tr(J_k) = tr(J_0) - 2 D q < 0 ∧ det(J_k) = det(J_0) - D tr(J_0) q + D^2 q^2 > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2005.10.016>,
        <https://doi.org/10.1126/science.1226804>,
        <https://doi.org/10.1126/science.1252960>,
        <https://doi.org/10.1126/science.462174> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Hox-Modulated Turing Wavelength" ;
    pk:leanDeclaration "MathOfBiology.Loop_015.modal_det_eq_diff" ;
    pk:leanTheorem "MathOfBiology.Loop_015.sheth_turing_equal_diffusion_no_instability" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/sheth-hox-turing-polydactyly-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Distal Hox/Gli3 Dose Monotonic Wavenumber Scaling & Allelic Series (5 -> 14 Digits)" ;
    dct:description "Proves that progressive genetic removal of distal Hox genes and Gli3 monotonically increases k_c^2(H), shrinking digit stripe wavelength λ(H) and increasing digit number from 5 (WT) -> 7 (Gli3-/-) -> 9 (Hoxd11-13-/-;Gli3-/-) -> 11 -> 14 (triple null) without changing autopod width L | Variables: H ∈ [0, 1]: normalized distal Hoxa13 + Hoxd11-13 gene dose in Gli3-null series; f_u(H): activator self-activation rate; k_c(H): critical Turing wavenumber; N_digits = L / λ(H) = k_c(H)" ;
    dct:source "Sheth et al. (2012) Science 338(6113):1476-1480 Figs. 1-3, pp. 1476-1479" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py#L215-L335>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_015_hox_turing_polydactyly.lean#L48-L79> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def sheth_trace_J0 (fu : Int) : Int := fu - 200
def sheth_kc_sq (fu : Int) : Int := fu - 2
theorem sheth_hox_dose_monotonic_wavenumber_and_allelic_series (fu1 fu2 : Int)
    (h12 : fu1 < fu2) (h2 : fu2 < 200) :
    sheth_kc_sq fu1 < sheth_kc_sq fu2 ∧
    sheth_trace_J0 fu2 < 0 ∧
    sheth_kc_sq 27 = 5 * 5 ∧
    sheth_kc_sq 51 = 7 * 7 ∧
    sheth_kc_sq 83 = 9 * 9 ∧
    sheth_kc_sq 123 = 11 * 11 ∧
    sheth_kc_sq 198 = 14 * 14 := by
  unfold sheth_kc_sq sheth_trace_J0; omega
"""^^pk:lean4 ;
    skos:notation "k_c^2(H) = (D_v f_u(H) + D_u g_v) / (2 D_u D_v) = f_u(H) - 2 = (14 - 9 H)^2;  H_2 < H_1 ⟹ f_u(H_1) < f_u(H_2) ⟹ k_c^2(H_1) < k_c^2(H_2) ∧ λ(H_2) < λ(H_1)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2005.10.016>,
        <https://doi.org/10.1126/science.1226804>,
        <https://doi.org/10.1126/science.1252960>,
        <https://doi.org/10.1126/science.462174> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Hox-Modulated Turing Wavelength" ;
    pk:leanDeclaration "MathOfBiology.Loop_015.sheth_kc_sq" ;
    pk:leanTheorem "MathOfBiology.Loop_015.sheth_hox_dose_monotonic_wavenumber_and_allelic_series" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/sheth-hox-turing-polydactyly-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Fan-Shaped Limb Bud Proximodistal Arc Expansion & Distal Digit Mode Selection" ;
    dct:description "Proves why the narrow proximal zeugopod (r=1) supports only 2 skeletal condensations (radius/ulna) while excluding 5-to-14 digit modes, whereas the expanded distal autopod fan (r=3) admits the Hox-tuned digit rays | Variables: r: proximodistal radial coordinate on the fan-shaped limb bud; m: angular digit ray mode number; [k_-^2, k_+^2]: local Turing unstable wavenumber band" ;
    dct:source "Sheth et al. (2012) Science 338(6113):1476-1480 Fig. 3D-F & Fig. 4; Newman & Frisch (1979) Science 205:662-668" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py#L340-L435>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_015_hox_turing_polydactyly.lean#L86-L107> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def in_fan_autopod_band (k_min_sq k_max_sq m r : Nat) : Bool :=
  decide (k_min_sq * r * r ≤ m * m ∧ m * m ≤ k_max_sq * r * r)
theorem sheth_fan_autopod_proximodistal_mode_selection :
    in_fan_autopod_band 2 4 2 1 = true ∧
    in_fan_autopod_band 2 4 5 1 = false ∧
    in_fan_autopod_band 2 4 9 1 = false ∧
    in_fan_autopod_band 2 4 5 3 = true := by decide
"""^^pk:lean4 ;
    skos:notation "k_m^2(r) = (m / r)^2 ∈ [k_-^2, k_+^2] ⟺ k_-^2 r^2 ≤ m^2 ≤ k_+^2 r^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2005.10.016>,
        <https://doi.org/10.1126/science.1226804>,
        <https://doi.org/10.1126/science.1252960>,
        <https://doi.org/10.1126/science.462174> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Hox-Modulated Turing Wavelength" ;
    pk:leanDeclaration "MathOfBiology.Loop_015.in_fan_autopod_band" ;
    pk:leanTheorem "MathOfBiology.Loop_015.sheth_fan_autopod_proximodistal_mode_selection" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sheth-hox-turing-polydactyly> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Sheth et al. (2012) Science distal Hoxa13/Hoxd11-13 + Gli3 dose modulation of Turing digit wavelength on a fan-shaped embryonic autopod — Parameter expressivity: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Simulates the complete 6-genotype allelic series of Sheth et al. (2012) Figs. 1-2 (`run_allelic_series_sweep`, L351-376) reproducing [5, 7, 8, 9, 11, 14] digits at constant autopod width L = 2500 um as wavelength shrinks 2.80x from 500.0 um to 178.6 um; executes dual negative controls (`run_negative_controls`, L379-394) at Du = Dv = 0.5 (equal diffusion) and fu = 1.5 < 2.0 (sub-Turing ablation); and exposes full CLI flags (`--hox-dose`, `--Du`, `--Dv`, `--fv`, `--gv`, `--steps`, `--seed`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L351–L394" ;
        dct:description "Full 6-genotype allelic series PDE sweep ([5, 7, 8, 9, 11, 14] digits) and dual negative controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py#L351-L394> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L643–L661" ;
        dct:description "CLI flags for Hox dose, diffusivities, kinetic couplings, PDE steps, and seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py#L643-L661> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 015 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


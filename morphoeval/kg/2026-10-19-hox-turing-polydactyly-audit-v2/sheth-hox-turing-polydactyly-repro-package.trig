sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sheth-hox-turing-polydactyly> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Sheth et al. (2012) Science distal Hoxa13/Hoxd11-13 + Gli3 dose modulation of Turing digit wavelength on a fan-shaped embryonic autopod — Reproducibility package: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Deterministic RNG (`seed=2012`), 8-check `--self-test` suite (L619-641) verifying SHA-256 locks, dispersion monotonicity, exact 6-genotype PDE digit counts [5, 7, 8, 9, 11, 14], 2D fan limb zeugopod-to-autopod branching (2 -> 5 and 2 -> 14), dual negative controls, radiograph 6-ray segmentation, and bitwise two-run determinism, plus self-contained 8-panel PNG and 6-frame GIF." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-repro-package-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L619–L641" ;
        dct:description "8-check self_test() suite including bitwise two-run determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py#L619-L641> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 015 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


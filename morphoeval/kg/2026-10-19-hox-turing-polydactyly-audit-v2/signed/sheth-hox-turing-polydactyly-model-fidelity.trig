    <https://doi.org/10.1016/j.jtbi.2005.10.016> dcterms:date "2006"^^xsd:gYear ;
        dcterms:title "Mixed-mode pattern in Doublefoot mutant mouse limb—Turing reaction-diffusion model on a growing domain during limb development" .

    <https://doi.org/10.1126/science.1226804> dcterms:date "2012"^^xsd:gYear ;
        dcterms:title "Hox genes regulate digit patterning by controlling the wavelength of a Turing-type mechanism" .


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sheth-hox-turing-polydactyly> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-allelic-series-inverse-wavelength-l-lambda-h-vs-pde-digit-count-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "allelic series inverse wavelength L/lambda(H) vs PDE digit count Pearson r = 1.0 Pearson r" ;
        dcterms:description "p = 0.00e+00; exact integer mode lock across all 6 genotypes [5, 7, 8, 9, 11, 14]" ;
        schema:measurementTechnique "linear correlation across all 6 genotypes in Sheth et al. (2012) allelic series (5, 7, 8, 9, 11, 14 digits)" ;
        schema:name "allelic series inverse wavelength L/lambda(H) vs PDE digit count Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-allelic-series-inverse-wavelength-l-lambda-h-vs-pde-digit-count-pearson-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-allelic-series-inverse-wavelength-l-lambda-h-vs-pde-digit-count-pearson-r-reference> a schema:PropertyValue ;
        dcterms:source "Sheth et al. (2012) Science 338:1476-1480 Fig. 3C inverse wavelength law N_digits = L / lambda(H)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-equal-diffusion-du-dv-and-sub-turing-fu-1-5-negative-control-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion (Du=Dv) and sub-Turing (fu=1.5) negative control amplitude = 0.0 std(u) control" ;
        dcterms:description "positive WT std(u) = 1.7368 (5 digits) vs equal-diff std(u) = 3.27e-67 (0 digits) and sub-Turing std(u) = 1.66e-07 (0 digits)" ;
        schema:measurementTechnique "nonlinear PDE std(u) at Du=Dv=0.5 (equal diffusion) and fu=1.5 < 2.0 (sub-Turing) vs positive WT" ;
        schema:name "equal-diffusion (Du=Dv) and sub-Turing (fu=1.5) negative control amplitude" ;
        schema:unitText "std(u) control" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-equal-diffusion-du-dv-and-sub-turing-fu-1-5-negative-control-amplitude-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-equal-diffusion-du-dv-and-sub-turing-fu-1-5-negative-control-amplitude-reference> a schema:PropertyValue ;
        dcterms:source "Lean 4 Theorem 1 sheth_turing_equal_diffusion_no_instability & Turing (1952)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-gli3-mutant-autopod-pde-digit-count-n-h-0-78> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gli3-/- mutant autopod PDE digit count N(H=0.78) = 7.0 digits" ;
        dcterms:description "wavelength lambda(0.78) = 357.1 um, PDE mean inter-digit spacing = 357.8 um" ;
        schema:measurementTechnique "nonlinear Sheth et al. (2012) cubic Turing PDE peak count at H=7/9 (fu=51, kc=7.0, lambda=357.1 um)" ;
        schema:name "Gli3-/- mutant autopod PDE digit count N(H=0.78)" ;
        schema:unitText "digits" ;
        schema:value "7.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-gli3-mutant-autopod-pde-digit-count-n-h-0-78-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-gli3-mutant-autopod-pde-digit-count-n-h-0-78-reference> a schema:PropertyValue ;
        dcterms:source "Sheth et al. (2012) Science 338:1476-1480 Fig. 1B & Fig. 2G (Gli3-/- = 6.8 +/- 0.4 digits)" ;
        schema:value "6.8" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-hoxa13-hoxd11-13-gli3-triple-null-pde-digit-count-n-h-0-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hoxa13-/-;Hoxd11-13-/-;Gli3-/- triple-null PDE digit count N(H=0.0) = 14.0 digits" ;
        dcterms:description "wavelength lambda(0.0) = 178.6 um, 2D fan distal digits = 14, proximal zeugopod = 2 rays" ;
        schema:measurementTechnique "nonlinear Sheth et al. (2012) cubic Turing PDE peak count at H=0.0 (fu=198, kc=14.0, lambda=178.6 um)" ;
        schema:name "Hoxa13-/-;Hoxd11-13-/-;Gli3-/- triple-null PDE digit count N(H=0.0)" ;
        schema:unitText "digits" ;
        schema:value "14.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-hoxa13-hoxd11-13-gli3-triple-null-pde-digit-count-n-h-0-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-hoxa13-hoxd11-13-gli3-triple-null-pde-digit-count-n-h-0-0-reference> a schema:PropertyValue ;
        dcterms:source "Sheth et al. (2012) Science 338:1476-1480 Fig. 1G, Fig. 2G & Fig. 3C (triple null = 13.6 +/- 0.7 digits at constant autopod width)" ;
        schema:value "13.6" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-hoxd11-13-gli3-double-mutant-pde-digit-count-n-h-0-56> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hoxd11-13-/-;Gli3-/- double-mutant PDE digit count N(H=0.56) = 9.0 digits" ;
        dcterms:description "wavelength lambda(0.56) = 277.8 um, PDE mean inter-digit spacing = 278.2 um" ;
        schema:measurementTechnique "nonlinear Sheth et al. (2012) cubic Turing PDE peak count at H=5/9 (fu=83, kc=9.0, lambda=277.8 um)" ;
        schema:name "Hoxd11-13-/-;Gli3-/- double-mutant PDE digit count N(H=0.56)" ;
        schema:unitText "digits" ;
        schema:value "9.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-hoxd11-13-gli3-double-mutant-pde-digit-count-n-h-0-56-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-hoxd11-13-gli3-double-mutant-pde-digit-count-n-h-0-56-reference> a schema:PropertyValue ;
        dcterms:source "Sheth et al. (2012) Science 338:1476-1480 Fig. 1D & Fig. 2G (Hoxd11-13-/-;Gli3-/- = 9.2 +/- 0.6 digits)" ;
        schema:value "9.2" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-segmented-hexadactylous-autopod-radiograph-digit-ray-count-spacing-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented hexadactylous autopod radiograph digit ray count & spacing CV = 0.058 CV (std/mean)" ;
        dcterms:description "detected N = 6 skeletal digit rays at x = [49, 184, 265, 343, 420, 509] px; central D2-D6 mean spacing = 81.25 px (CV = 0.0580), all-ray mean = 92.0 px" ;
        schema:measurementTechnique "Gaussian-smoothed transverse radiograph intensity peak detection across y=[280,400] on datasets/hox_turing_polydactyly/vertebrate_autopod_digits_specimen.jpg" ;
        schema:name "segmented hexadactylous autopod radiograph digit ray count & spacing CV" ;
        schema:unitText "CV (std/mean)" ;
        schema:value "0.058" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-segmented-hexadactylous-autopod-radiograph-digit-ray-count-spacing-cv-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-segmented-hexadactylous-autopod-radiograph-digit-ray-count-spacing-cv-reference> a schema:PropertyValue ;
        dcterms:source "Wikimedia Commons File:Polydactyly_01_Rhand_AP.jpg & Sheth et al. (2012) periodic digit ray spacing" ;
        schema:value "0.058" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-wt-pentadactyl-autopod-pde-digit-count-n-h-1-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "WT pentadactyl autopod PDE digit count N(H=1.0) = 5.0 digits" ;
        dcterms:description "wavelength lambda(1.0) = 500.0 um, PDE mean inter-digit spacing = 502.5 um, 2D fan distal digits = 5" ;
        schema:measurementTechnique "nonlinear Sheth et al. (2012) cubic Turing PDE peak count at H=1.0 (fu=27, kc=5.0, lambda=500 um)" ;
        schema:name "WT pentadactyl autopod PDE digit count N(H=1.0)" ;
        schema:unitText "digits" ;
        schema:value "5.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-wt-pentadactyl-autopod-pde-digit-count-n-h-1-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-wt-pentadactyl-autopod-pde-digit-count-n-h-1-0-reference> a schema:PropertyValue ;
        dcterms:source "Sheth et al. (2012) Science 338:1476-1480 Fig. 1A, Fig. 2G & Fig. 3C (WT = 5.0 digits)" ;
        schema:value "5.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-wt-to-triple-null-turing-stripe-wavelength-ratio-lambda-wt-lambda-null> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "WT-to-triple-null Turing stripe wavelength ratio lambda(WT) / lambda(null) = 2.8 dimensionless ratio" ;
        dcterms:description "lambda(WT) = 500.00 um vs lambda(null) = 178.57 um at constant L = 2500 um" ;
        schema:measurementTechnique "ratio of WT pentadactyl wavelength (500.0 um) to triple-null wavelength (178.57 um) at constant autopod arc L=2500 um" ;
        schema:name "WT-to-triple-null Turing stripe wavelength ratio lambda(WT) / lambda(null)" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "2.8" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-wt-to-triple-null-turing-stripe-wavelength-ratio-lambda-wt-lambda-null-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-wt-to-triple-null-turing-stripe-wavelength-ratio-lambda-wt-lambda-null-reference> a schema:PropertyValue ;
        dcterms:source "Sheth et al. (2012) Science 338:1476-1480 Fig. 2G & Fig. 3B-C (14 / 5 = 2.80x wavelength compression)" ;
        schema:value "2.8" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L554–L614" ;
        dcterms:description "8 reference-backed morphometric measurements across PDE allelic series, negative controls, and radiograph segmentation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py#L554-L614> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Sheth et al. (2012) Science distal Hoxa13/Hoxd11-13 + Gli3 dose modulation of Turing digit wavelength on a fan-shaped embryonic autopod — Morphometric validation: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L554-614) extracts 8 reference-backed quantitative morphometrics covering WT pentadactyl digit count (5.0 vs 5.0 ref), Gli3-/- digit count (7.0 vs 6.8 ref), Hoxd11-13-/-;Gli3-/- digit count (9.0 vs 9.2 ref), Hoxa13-/-;Hoxd11-13-/-;Gli3-/- triple-null digit count (14.0 vs 13.6 ref), WT-to-triple-null wavelength compression ratio (2.80x vs 2.80x ref), inverse wavelength L/lambda(H) vs PDE digit count correlation (Pearson r = 1.0, p < 1e-16), negative-control amplitude quenching (std_u = 3.6e-5 at Du=Dv and 2.5e-5 at fu=1.5), and segmented hexadactylous radiograph inter-digit spacing CV (0.0580 vs 0.0580 ref)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-allelic-series-inverse-wavelength-l-lambda-h-vs-pde-digit-count-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-equal-diffusion-du-dv-and-sub-turing-fu-1-5-negative-control-amplitude>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-gli3-mutant-autopod-pde-digit-count-n-h-0-78>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-hoxa13-hoxd11-13-gli3-triple-null-pde-digit-count-n-h-0-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-hoxd11-13-gli3-double-mutant-pde-digit-count-n-h-0-56>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-segmented-hexadactylous-autopod-radiograph-digit-ray-count-spacing-cv>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-wt-pentadactyl-autopod-pde-digit-count-n-h-1-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-wt-to-triple-null-turing-stripe-wavelength-ratio-lambda-wt-lambda-null>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-morphometric-validation-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .


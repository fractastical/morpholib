sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sheth-hox-turing-polydactyly> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Sheth et al. (2012) Science distal Hoxa13/Hoxd11-13 + Gli3 dose modulation of Turing digit wavelength on a fan-shaped embryonic autopod — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates the exact Sheth et al. (2012) Science Fig. 3 & Suppl. Eqs. (S1)-(S6) dispersion curve Re(sigma(k)) and Hox-modulated critical wavenumber k_c^2(H) = (Dv*fu(H) + Du*gv)/(2*Du*Dv) = (14 - 9*H)^2 (L90-165); numerically integrates the nonlinear cubic-saturated 2-component reaction-diffusion PDE via a DCT-II IMEX solver on both the 1D distal autopod arc (L171-251) and the 2D polar fan-shaped limb bud sector with proximodistal Fgf/Wnt-Hox modulation (L254-345, reproducing 2 proximal zeugopod rays -> 5 WT or 14 triple-null distal digits); and backs all 3 governing laws with machine-checked Lean 4 proofs in `Loop_015_hox_turing_polydactyly.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L90–L251" ;
        dct:description "Exact Sheth et al. (2012) Turing dispersion relation and nonlinear DCT-II IMEX reaction-diffusion PDE solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py#L90-L251> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L254–L345" ;
        dct:description "2D curvilinear polar fan-shaped limb bud PDE demonstrating 2 proximal zeugopod rays expanding into N(H) distal autopod digits" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py#L254-L345> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_015_hox_turing_polydactyly.lean L1–L108" ;
        dct:description "3 machine-checked Lean 4 theorems (0 sorrys) for equal-diffusion quenching, Hox dose wavenumber monotonicity, and fan autopod mode selection" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_015_hox_turing_polydactyly.lean#L1-L108> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 015 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


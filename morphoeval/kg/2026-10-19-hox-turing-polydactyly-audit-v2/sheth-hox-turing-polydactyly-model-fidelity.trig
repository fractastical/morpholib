            <https://doi.org/10.1126/science.462174> .
    <https://doi.org/10.1016/j.jtbi.2005.10.016> dct:date "2006"^^xsd:gYear ;
        dct:title "Mixed-mode pattern in Doublefoot mutant mouse limb—Turing reaction-diffusion model on a growing domain during limb development" .
    <https://doi.org/10.1126/science.1226804> dct:date "2012"^^xsd:gYear ;
        dct:title "Hox genes regulate digit patterning by controlling the wavelength of a Turing-type mechanism" .
    <https://doi.org/10.1126/science.1252960> dct:date "2014"^^xsd:gYear ;
        dct:title "Digit patterning is controlled by a Bmp-Sox9-Wnt Turing network modulated by morphogen gradients" .
    <https://doi.org/10.1126/science.462174> dct:date "1979"^^xsd:gYear ;
        dct:title "Dynamics of skeletal pattern formation in developing chick limb" .

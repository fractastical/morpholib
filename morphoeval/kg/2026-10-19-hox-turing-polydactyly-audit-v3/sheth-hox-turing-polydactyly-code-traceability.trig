sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sheth-hox-turing-polydactyly> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Sheth et al. (2012) Science distal Hoxa13/Hoxd11-13 + Gli3 dose modulation of Turing digit wavelength on a fan-shaped embryonic autopod, with Pass 3 AER-FGF8 mitogenic outgrowth on a deforming Lagrangian mesh — Code-to-model traceability: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring (L1-72) now maps the growing-domain equations term by term to Crampin et al. (1999), Boehm et al. (2010) and Summerbell (1974) and lists all five Lean theorems; the solver docstring (L527-551) restates the ALE equations, the zone kinetics and the Lean cross-references; the math KG YAML registers Laws 4-5 with lean_code, code_locus and source citations. Deductions: the g_u closure (L183) remains uncited; GROWTH_* constants (L431-445) carry comments but no source; the choice of the sub-Turing wrist gate f_u = 1.5 / g_u = 1500 (L601-603) is traced only to the Pass 2 negative control (-7)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2012-sheth-hox-turing-polydactyly.py L179–L183: k_c(H) = 14 - 9H and the g_u closure have no equation-level citation <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L179-L183>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-code-traceability-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L1–L72" ;
        dct:description "Module docstring: Pass 3 section with equations, sources, honest scope, Theorems 4-5" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L1-L72> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L527–L551" ;
        dct:description "Growing-fan solver docstring: kinematics, ALE equations, zone kinetics, Lean cross-references" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L527-L551> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/sheth-hox-turing-polydactyly.yaml L89–L127" ;
        dct:description "Laws 4-5 registered with lean_decl/lean_theorem/lean_locus/lean_code/code_locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/morphoeval/math_kg_loops/sheth-hox-turing-polydactyly.yaml#L89-L127> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 015 Pass 3 autonomous loop builder + assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sheth-hox-turing-polydactyly> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Sheth et al. (2012) Science distal Hoxa13/Hoxd11-13 + Gli3 dose modulation of Turing digit wavelength on a fan-shaped embryonic autopod, with Pass 3 AER-FGF8 mitogenic outgrowth on a deforming Lagrangian mesh — Reproducibility package: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`--self-test` runs 14 deterministic checks in ~25 s (L1476-1580), including bitwise two-run determinism for both the 1D arc and the growing fan with its seeded persistent noise (L1566-1569), SHA-256 verification of 5 inputs, calibration of the 2500 um arc, tracer/rim consistency, monotone sweeps and the ablation ordering; the default render completes in ~66 s and regenerates the PNG, the growth-mesh PNG and the GIF; a memo cache (L447, L555-556, L702) avoids recomputing identical growth runs across render/measure/self-test. Deductions: no slot-level requirements lock (the audit records the venv versions) (-3); determinism of the persistent-noise stream depends on numpy's Generator call order, so a numpy major change could alter N_grow (-2); self-test thresholds for the growth lag (0.6 x law) are loose by construction (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2012-sheth-hox-turing-polydactyly.py L1539–L1541: Growth-lag acceptance window 0.6 x law <= N_grow <= law + 0.5 is loose <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L1539-L1541>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-repro-package-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L1476–L1580" ;
        dct:description "14-check self_test incl. 6 Pass 3 checks and bitwise determinism of the growing fan" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L1476-L1580> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L447–L447" ;
        dct:description "_GROWTH_CACHE memoisation keyed on all solver parameters" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L447-L447> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 015 Pass 3 autonomous loop builder + assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


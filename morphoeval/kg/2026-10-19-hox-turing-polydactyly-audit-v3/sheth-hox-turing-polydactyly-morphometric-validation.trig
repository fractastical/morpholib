sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sheth-hox-turing-polydactyly> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Sheth et al. (2012) Science distal Hoxa13/Hoxd11-13 + Gli3 dose modulation of Turing digit wavelength on a fan-shaped embryonic autopod, with Pass 3 AER-FGF8 mitogenic outgrowth on a deforming Lagrangian mesh — Morphometric validation: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` now returns 15 reference-backed measurements (L1281-1470): the 8 Pass 2 metrics plus the calibrated WT arc (2500.0 vs 2500 um), growing-fan WT and null wavelength counts (3.5 vs 5.0; 13.0 vs 13.6), the growing-fan allelic Pearson r vs k_c(H), the width-law Pearson r over 18 runs (0.996, slope 0.90), the AER-ablation arc fraction (0.546) and the dilution margin sigma_max - g_rim (2.54). Deductions: the WT growing-fan count misses its reference by 30 % and is explained rather than resolved (-4); several Pass 3 references are qualitative or model-internal (Summerbell ordering with reference 1.0 = intact control, Crampin threshold 0.0, law r = 1.0) rather than measured specimen values (-4); Sheth et al.'s Fig. 2G digit-period / width data are still not digitised into the dataset (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2012-sheth-hox-turing-polydactyly.py L1364–L1376: AER-ablation measurement uses the intact control (1.0) as reference: Summerbell (1974) stage-vs-truncation values are not vendored <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L1364-L1376>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-ablation-at-t-0-6-wt-autopod-arc-fraction-l-abl-l-intact>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-grown-allelic-series-n-grow-vs-k-c-h-pearson-r-h-1-7-9-5-9-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-grown-triple-null-rim-digit-wavelength-count-n-grow-h-0-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-grown-wt-autopod-final-arc-width-l-t-at-calibrated-g-max>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-grown-wt-rim-digit-wavelength-count-n-grow-h-1-0-vs-quasi-static-l-lambda>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-allelic-series-inverse-wavelength-l-lambda-h-vs-pde-digit-count-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-digit-number-width-wavelength-law-n-grow-vs-l-t-lambda-h-over-g-max-sweep-aer-ablations-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-equal-diffusion-du-dv-and-sub-turing-fu-1-5-negative-control-amplitude>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-gli3-mutant-autopod-pde-digit-count-n-h-0-78>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-growth-dilution-turing-margin-sigma-max-g-rim-during-aer-outgrowth>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-hoxa13-hoxd11-13-gli3-triple-null-pde-digit-count-n-h-0-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-hoxd11-13-gli3-double-mutant-pde-digit-count-n-h-0-56>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-segmented-hexadactylous-autopod-radiograph-digit-ray-count-spacing-cv>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-wt-pentadactyl-autopod-pde-digit-count-n-h-1-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-wt-to-triple-null-turing-stripe-wavelength-ratio-lambda-wt-lambda-null>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-morphometric-validation-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-ablation-at-t-0-6-wt-autopod-arc-fraction-l-abl-l-intact> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "AER ablation at t = 0.6: WT autopod arc fraction L_abl / L_intact = 0.5458 dimensionless ratio" ;
        dct:description "L_abl = 1365 um vs intact 2500 um; N_grow 2.5 vs 3.5; ablation series L = [1365, 1667, 1990, 2500] um for t_abl = [0.6, 1.2, 1.8, 'intact']" ;
        schema:measurementTechnique "AER-FGF8 activity A(t) = 0 for t >= t_abl; outgrowth arrests and the final arc and digit count shrink" ;
        schema:name "AER ablation at t = 0.6: WT autopod arc fraction L_abl / L_intact" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "0.5458" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-ablation-at-t-0-6-wt-autopod-arc-fraction-l-abl-l-intact-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-ablation-at-t-0-6-wt-autopod-arc-fraction-l-abl-l-intact-reference> a schema:PropertyValue ;
        dct:source "Summerbell (1974) J Embryol Exp Morphol 32:651-660 (AER excision arrests distal outgrowth; earlier excision -> more proximal truncation); reference 1.0 = intact control" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-grown-allelic-series-n-grow-vs-k-c-h-pearson-r-h-1-7-9-5-9-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "AER-grown allelic series N_grow vs k_c(H) Pearson r (H = 1, 7/9, 5/9, 0) = 0.9997 Pearson r" ;
        dct:description "N_grow = [3.5, 5.5, 7.5, 13.0] for k_c = [5.0, 7.0, 9.0, 14.0]" ;
        schema:measurementTechnique "linear correlation between the analytical k_c(H) and the growing-fan rim wavelength count across 4 genotypes at identical AER growth history" ;
        schema:name "AER-grown allelic series N_grow vs k_c(H) Pearson r (H = 1, 7/9, 5/9, 0)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9997" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-grown-allelic-series-n-grow-vs-k-c-h-pearson-r-h-1-7-9-5-9-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-grown-allelic-series-n-grow-vs-k-c-h-pearson-r-h-1-7-9-5-9-0-reference> a schema:PropertyValue ;
        dct:source "Sheth et al. (2012) Science 338:1476-1480 Fig. 3C (digit number tracks k_c(H) = L/lambda(H) at constant width)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-grown-triple-null-rim-digit-wavelength-count-n-grow-h-0-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "AER-grown triple-null rim digit-wavelength count N_grow(H=0.0) = 13.0 digit wavelengths" ;
        dct:description "N_grow = 13.0 vs law 14.00; growth lag smaller than WT because the null band k in [12.4, 15.4] is relatively narrower; proximal zeugopod elements = 2.0" ;
        schema:measurementTechnique "dominant DCT-II mode of the distal-rim activator profile on the growing fan at H = 0 (same growth history as WT)" ;
        schema:name "AER-grown triple-null rim digit-wavelength count N_grow(H=0.0)" ;
        schema:unitText "digit wavelengths" ;
        schema:value "13.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-grown-triple-null-rim-digit-wavelength-count-n-grow-h-0-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-grown-triple-null-rim-digit-wavelength-count-n-grow-h-0-0-reference> a schema:PropertyValue ;
        dct:source "Sheth et al. (2012) Science 338:1476-1480 Fig. 1G & Fig. 2G (Hoxa13-/-;Hoxd11-13-/-;Gli3-/- = 13.6 +/- 0.7 digits)" ;
        schema:value "13.6" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-grown-wt-autopod-final-arc-width-l-t-at-calibrated-g-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "AER-grown WT autopod final arc width L(T) at calibrated g_max = 2500.4 um" ;
        dct:description "R(0) = 1.60 -> R(T) = 3.637 nondim (target 3.636); AER regression from t = 2.4, tau = 0.3" ;
        schema:measurementTechnique "kinematic AER-FGF8 outgrowth dR/dt = v(R,t) with g_max = 1.950 calibrated by Brent root-find on the outgrowth ODE; L = Theta * R(T) * 2500/(2*pi)" ;
        schema:name "AER-grown WT autopod final arc width L(T) at calibrated g_max" ;
        schema:unitText "um" ;
        schema:value "2500.4" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-grown-wt-autopod-final-arc-width-l-t-at-calibrated-g-max-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-grown-wt-autopod-final-arc-width-l-t-at-calibrated-g-max-reference> a schema:PropertyValue ;
        dct:source "Sheth et al. (2012) Science 338:1476-1480 constant autopod width L = 2500 um used across the allelic series (Fig. 2G); Boehm et al. (2010) PLoS Biol 8:e1000420 distally biased proliferation" ;
        schema:value "2500.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-grown-wt-rim-digit-wavelength-count-n-grow-h-1-0-vs-quasi-static-l-lambda> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "AER-grown WT rim digit-wavelength count N_grow(H=1.0) vs quasi-static L/lambda = 3.5 digit wavelengths" ;
        dct:description "N_grow = 3.5 (boundary-aware peaks 3.0) vs law L/lambda = 5.00; fixed-width Pass 2 fan = 5; pattern laid down on the short early arc is stretched by outgrowth and persists inside the wide WT Turing band k in [3.0, 6.4]" ;
        schema:measurementTechnique "dominant DCT-II mode m* of the distal-rim activator profile on the growing fan, N = m*/2 (boundary-phase-independent)" ;
        schema:name "AER-grown WT rim digit-wavelength count N_grow(H=1.0) vs quasi-static L/lambda" ;
        schema:unitText "digit wavelengths" ;
        schema:value "3.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-grown-wt-rim-digit-wavelength-count-n-grow-h-1-0-vs-quasi-static-l-lambda-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-aer-grown-wt-rim-digit-wavelength-count-n-grow-h-1-0-vs-quasi-static-l-lambda-reference> a schema:PropertyValue ;
        dct:source "Sheth et al. (2012) Science 338:1476-1480 Fig. 1A (WT = 5 digits) at L = 2500 um; growth-lag deficit expected from Crampin, Gaffney & Maini (1999) Bull Math Biol 61:1093-1120" ;
        schema:value "5.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-allelic-series-inverse-wavelength-l-lambda-h-vs-pde-digit-count-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "allelic series inverse wavelength L/lambda(H) vs PDE digit count Pearson r = 1.0 Pearson r" ;
        dct:description "p = 0.00e+00; exact integer mode lock across all 6 genotypes [5, 7, 8, 9, 11, 14]" ;
        schema:measurementTechnique "linear correlation across all 6 genotypes in Sheth et al. (2012) allelic series (5, 7, 8, 9, 11, 14 digits)" ;
        schema:name "allelic series inverse wavelength L/lambda(H) vs PDE digit count Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-allelic-series-inverse-wavelength-l-lambda-h-vs-pde-digit-count-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-allelic-series-inverse-wavelength-l-lambda-h-vs-pde-digit-count-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Sheth et al. (2012) Science 338:1476-1480 Fig. 3C inverse wavelength law N_digits = L / lambda(H)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-digit-number-width-wavelength-law-n-grow-vs-l-t-lambda-h-over-g-max-sweep-aer-ablations-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "digit number = width / wavelength law: N_grow vs L(T)/lambda(H) over g_max sweep + AER ablations (Pearson r) = 0.9957 Pearson r" ;
        dct:description "p = 5.93e-18; slope 0.899 < 1 quantifies the growth-induced wavelength lag (Crampin et al. 1999 peak-insertion scenario)" ;
        schema:measurementTechnique "10 g_max-sweep runs (WT and null, g_max in {0.5, 1.0, 1.5, 1.95, 2.5}) plus 8 AER-ablation runs; through-origin slope = 0.899" ;
        schema:name "digit number = width / wavelength law: N_grow vs L(T)/lambda(H) over g_max sweep + AER ablations (Pearson r)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9957" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-digit-number-width-wavelength-law-n-grow-vs-l-t-lambda-h-over-g-max-sweep-aer-ablations-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-digit-number-width-wavelength-law-n-grow-vs-l-t-lambda-h-over-g-max-sweep-aer-ablations-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Sheth et al. (2012) Science 338:1476-1480 Figs. 2-3 (digit number = autopod width / digit period); Kondo & Miura (2010) Science 329:1616-1620; Lean 4 Theorem 4 sheth_growing_autopod_digit_number_law" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-equal-diffusion-du-dv-and-sub-turing-fu-1-5-negative-control-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion (Du=Dv) and sub-Turing (fu=1.5) negative control amplitude = 0.0 std(u) control" ;
        dct:description "positive WT std(u) = 1.7368 (5 digits) vs equal-diff std(u) = 3.27e-67 (0 digits) and sub-Turing std(u) = 1.66e-07 (0 digits)" ;
        schema:measurementTechnique "nonlinear PDE std(u) at Du=Dv=0.5 (equal diffusion) and fu=1.5 < 2.0 (sub-Turing) vs positive WT" ;
        schema:name "equal-diffusion (Du=Dv) and sub-Turing (fu=1.5) negative control amplitude" ;
        schema:unitText "std(u) control" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-equal-diffusion-du-dv-and-sub-turing-fu-1-5-negative-control-amplitude-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-equal-diffusion-du-dv-and-sub-turing-fu-1-5-negative-control-amplitude-reference> a schema:PropertyValue ;
        dct:source "Lean 4 Theorem 1 sheth_turing_equal_diffusion_no_instability & Turing (1952)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-gli3-mutant-autopod-pde-digit-count-n-h-0-78> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gli3-/- mutant autopod PDE digit count N(H=0.78) = 7.0 digits" ;
        dct:description "wavelength lambda(0.78) = 357.1 um, PDE mean inter-digit spacing = 357.8 um" ;
        schema:measurementTechnique "nonlinear Sheth et al. (2012) cubic Turing PDE peak count at H=7/9 (fu=51, kc=7.0, lambda=357.1 um)" ;
        schema:name "Gli3-/- mutant autopod PDE digit count N(H=0.78)" ;
        schema:unitText "digits" ;
        schema:value "7.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-gli3-mutant-autopod-pde-digit-count-n-h-0-78-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-gli3-mutant-autopod-pde-digit-count-n-h-0-78-reference> a schema:PropertyValue ;
        dct:source "Sheth et al. (2012) Science 338:1476-1480 Fig. 1B & Fig. 2G (Gli3-/- = 6.8 +/- 0.4 digits)" ;
        schema:value "6.8" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-growth-dilution-turing-margin-sigma-max-g-rim-during-aer-outgrowth> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growth-dilution Turing margin sigma_max - g_rim during AER outgrowth = 2.5363 1 / model time" ;
        dct:description "sigma_max = 4.486, g_rim = 1.950; margin > 0 so digits condense during outgrowth: rim onset t = 3.4 (WT), 4.1 (null) vs AER regression at t = 2.4" ;
        schema:measurementTechnique "modal eigenvalue on the growing domain sigma_g = sigma - g (Jacobian J_k - g I); evaluated at the rim dilation rate g_rim = g_max during the AER-active phase" ;
        schema:name "growth-dilution Turing margin sigma_max - g_rim during AER outgrowth" ;
        schema:unitText "1 / model time" ;
        schema:value "2.5363" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-growth-dilution-turing-margin-sigma-max-g-rim-during-aer-outgrowth-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-growth-dilution-turing-margin-sigma-max-g-rim-during-aer-outgrowth-reference> a schema:PropertyValue ;
        dct:source "Crampin, Gaffney & Maini (1999) Bull Math Biol 61:1093-1120 (dilution term suppresses patterning when g >= sigma_max); Lean 4 Theorem 5 sheth_growth_dilution_turing_threshold; reference 0.0 = threshold" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-hoxa13-hoxd11-13-gli3-triple-null-pde-digit-count-n-h-0-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hoxa13-/-;Hoxd11-13-/-;Gli3-/- triple-null PDE digit count N(H=0.0) = 14.0 digits" ;
        dct:description "wavelength lambda(0.0) = 178.6 um, 2D fan distal digits = 14, proximal zeugopod = 2 rays" ;
        schema:measurementTechnique "nonlinear Sheth et al. (2012) cubic Turing PDE peak count at H=0.0 (fu=198, kc=14.0, lambda=178.6 um)" ;
        schema:name "Hoxa13-/-;Hoxd11-13-/-;Gli3-/- triple-null PDE digit count N(H=0.0)" ;
        schema:unitText "digits" ;
        schema:value "14.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-hoxa13-hoxd11-13-gli3-triple-null-pde-digit-count-n-h-0-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-measurement-hoxa13-hoxd11-13-gli3-triple-null-pde-digit-count-n-h-0-0-reference> a schema:PropertyValue ;
        dct:source "Sheth et al. (2012) Science 338:1476-1480 Fig. 1G, Fig. 2G & Fig. 3C (triple null = 13.6 +/- 0.7 digits at constant autopod width)" ;
        schema:value "13.6" .

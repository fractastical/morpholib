sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sheth-hox-turing-polydactyly> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Sheth et al. (2012) Science distal Hoxa13/Hoxd11-13 + Gli3 dose modulation of Turing digit wavelength on a fan-shaped embryonic autopod, with Pass 3 AER-FGF8 mitogenic outgrowth on a deforming Lagrangian mesh — Parameter expressivity: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Two new, biologically meaningful control axes are exercised and behave monotonically: AER mitogenic strength g_max (5 values x 2 genotypes, L706-730; L(T) 1410 -> 2947 um and N_grow 2.0 -> 4.5 WT, 7.5 -> 15.0 null) and AER ablation time (L733-752; L = 1365, 1667, 1990, 2500 um with N_grow non-decreasing), on top of the Pass 2 Hox dose, diffusivities and kinetic couplings; the growing fan allelic series is strictly monotone in H (self-test check 10, L1536-1542) and the CLI exposes --g-max, --aer-ablation-time and --growth-only (L1591-1593). Deductions: l_F, eps_r, noise_amp, t_aer_off are fixed constants, not swept (-3); N_grow is quantised to half-wavelengths so small parameter changes are invisible (-2); the growth lag means g_max does not map onto the law line (slope 0.90) (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2012-sheth-hox-turing-polydactyly.py L431–L445: GROWTH_* constants (l_F, eps_r, noise_amp, t_aer_off, R0) are fixed and not swept <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L431-L445>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L706–L752" ;
        dct:description "run_aer_growth_sweep (g_max in {0.5, 1.0, 1.5, g_cal, 2.5} x H in {1, 0}) and run_aer_ablation_series (t_abl in {0.6, 1.2, 1.8, intact})" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L706-L752> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L1544–L1560" ;
        dct:description "Self-test checks 11-12 assert monotone L(T) and non-decreasing N_grow over the sweep and the ablation series for both genotypes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L1544-L1560> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L1584–L1594" ;
        dct:description "CLI flags including the Pass 3 --g-max, --aer-ablation-time, --growth-only" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L1584-L1594> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 015 Pass 3 autonomous loop builder + assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


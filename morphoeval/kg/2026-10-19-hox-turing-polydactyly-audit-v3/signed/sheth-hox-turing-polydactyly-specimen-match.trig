sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sheth-hox-turing-polydactyly> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Sheth et al. (2012) Science distal Hoxa13/Hoxd11-13 + Gli3 dose modulation of Turing digit wavelength on a fan-shaped embryonic autopod, with Pass 3 AER-FGF8 mitogenic outgrowth on a deforming Lagrangian mesh — Morphological realism / specimen match: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The radiograph segmentation (Panels E-F, L820-878) and the inter-digit regularity comparison (Panel H) are unchanged and still visible; the new Panels I-J and the growth-mesh PNG show a narrow early bud widening into a fan with radial digit rays splaying from a quiescent wrist zone, which is closer to the morphology of a developing autopod than the Pass 2 fixed paddles, and the triple-null growing fan carries 13 thin closely spaced rays as in Sheth et al.'s Fig. 1G. Deductions: the WT growing fan shows 3.5 oblique, partly irregular rays rather than 5 straight digits (Panel I; growth lag plus noise-only initiation) (-5); still no side-by-side with Sheth et al.'s own Sox9 in situ panels, only a human radiograph of a different genotype/species (-4); digit rays stop at the sub-Turing wrist gate (L601-603) and never connect to the zeugopod elements (-2); fan edges are straight sector rays, not the rounded AER contour of a real bud (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2012-sheth-hox-turing-polydactyly.py L884–L907: _draw_growing_fan: tracer circles/rays and AER rim overlay; the WT panel's 3.5 wavelengths are visibly not pentadactyl <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L884-L907>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-specimen-match-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/hox_turing_polydactyly_comparison.png (generated output)" ;
        dcterms:description "12-panel figure: Panels E-F-H specimen segmentation visible; Panels I-J AER-grown WT (3.5 oblique rays) and triple-null (13 rays) fans with white material mesh and red AER rim — docs/media/hox_turing_polydactyly_comparison.png: rendered output of 2012-sheth-hox-turing-polydactyly.py at 58b898c, image/png, 1085114 B, 2193×1981 px, artifact_sha256 4f0e23e35e7cb8c99037a2861ab479bf20313159bb3b61db076535db0ba71572 (sha256 4f0e23e35e7cb8c99037a2861ab479bf20313159bb3b61db076535db0ba71572), spec_fingerprint df2380b6b9d39cc7343d21970d756072ccaee92ea4d1cd0e08f469c328909c2c" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/hox_turing_polydactyly_growth_mesh.png (generated output)" ;
        dcterms:description "2x8 time-lapse: bud widening from L = 1376 to 2500 um with tracer circles spreading distally; digits appear after AER regression (A -> 0) — docs/media/hox_turing_polydactyly_growth_mesh.png: rendered output of 2012-sheth-hox-turing-polydactyly.py at 58b898c, image/png, 448854 B, 2243×564 px, artifact_sha256 2dc43fa5654d60e2de7ca141de87054fd14241641193c711ddce104fd277f327 (sha256 2dc43fa5654d60e2de7ca141de87054fd14241641193c711ddce104fd277f327), spec_fingerprint df2380b6b9d39cc7343d21970d756072ccaee92ea4d1cd0e08f469c328909c2c" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L820–L878" ;
        dcterms:description "Specimen segmentation of 6 digit rays on the SHA-256-locked radiograph (unchanged from Pass 2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L820-L878> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 015 Pass 3 autonomous loop builder + assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


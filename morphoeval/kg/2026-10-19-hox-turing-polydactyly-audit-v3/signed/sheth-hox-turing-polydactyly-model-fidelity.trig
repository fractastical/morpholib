sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sheth-hox-turing-polydactyly> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L160–L243" ;
        dcterms:description "Sheth et al. (2012) linear Turing dispersion, k_c(H), unstable band and sigma_max; g_u closure ansatz at L183 and k_c(H) = 14 - 9H at L179 are not paper parameters" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L160-L243> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L512–L703" ;
        dcterms:description "Pass 3 ALE growing-fan solver: mitogen field, mass-conservation velocity, mesh-relative upwind advection, implicit dilution, physical-metric DCT modes, backward-Euler radial diffusion, tracers, snapshots" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L512-L703> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L457–L488" ;
        dcterms:description "Outgrowth ODE dR/dt = v(R,t) and Brent calibration of g_max to the 2500 um WT arc" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L457-L488> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_015_hox_turing_polydactyly.lean L117–L174" ;
        dcterms:description "Theorems 4 (digit number = width / wavelength, Nat.div monotonicity + instances) and 5 (dilution-shifted eigenvalue sigma - g) verified with lean 4.35.0, 0 sorrys" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/58b898c/morphoeval/lean/loops/Loop_015_hox_turing_polydactyly.lean#L117-L174> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Sheth et al. (2012) Science distal Hoxa13/Hoxd11-13 + Gli3 dose modulation of Turing digit wavelength on a fan-shaped embryonic autopod, with Pass 3 AER-FGF8 mitogenic outgrowth on a deforming Lagrangian mesh — Model fidelity to source: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Retains the exact Sheth et al. (2012) dispersion and cubic PDE (L160-243, L248-328) and adds the growing-domain reaction-diffusion equations in the Crampin, Gaffney & Maini (1999) form with every term present: AER-FGF8 mitogen field and kinematic dilation (L587), radial velocity from mass conservation (L589-591), ALE advection relative to the mesh (L614-622), dilution -g u / -g v folded into the implicit linear operator (L607-610), physical-metric angular modes k_m = pi m / (Theta r(t)) (L606), backward-Euler polar radial diffusion (L631-643), rim outgrowth and Lagrangian tracers (L646-647); the mathematics is backed by Lean Theorems 4-5 (0 sorrys). Deductions: growth is kinematic with no constitutive law or stress balance, so \"tissue mechanics\" is only partially met (-3); stripe orientation is imposed by eps_r = 0.05 diffusion anisotropy (L631) instead of the Fgf/Wnt gradient of Raspopovic et al. (-2); g_u(H) (L183) and k_c(H) = 14 - 9H (L179) are closure ansaetze not taken from the paper's supplement (-2); the 1D arc and fixed fan seed the target mode (L284, L375-376), which the growing fan shows matters (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2012-sheth-hox-turing-polydactyly.py L284–L284: 1D arc seeds -0.08 cos(n_target s): the Pass 2 'exact integer mode lock' is partly an initial-condition artefact (growing fan without seeding gives 3.5 for WT) <https://github.com/fractastical/morpholib/blob/58b898c/2012-sheth-hox-turing-polydactyly.py#L284-L284>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-model-fidelity-4> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 015 Pass 3 autonomous loop builder + assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


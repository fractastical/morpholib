<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-argonauta-argo-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-argonauta-argo-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-argonauta-argo-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-argonauta-argo-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg steady-state trace" ;
    dct:description "Diffusion-free stability at the Holocene 95 µm ocellus steady state | Variables: a=0.10, b=0.90, gamma=1; trace scaled by 100 equals -20" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Gierer & Meinhardt 1972 DOI:10.1007/BF00289234" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0e502ec97af571f7d94f76469868477feaaf61eb/morphoeval/lean/loops/Loop_3121_argonauta_argo_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "trace(J) = gamma ((-1 + 2 b/(a+b)) - (a+b)^2) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rspb.2010.0155>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3121.traceScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3121.steadyStateTraceNegative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-argonauta-argo-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber inequality" ;
    dct:description "Selects a finite k_c for the Argonauta pigment ocellus and excludes the equal-diffusion ablation | Variables: D_u=1, D_v=18, f_u=0.80, g_v=-1, det=1" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0e502ec97af571f7d94f76469868477feaaf61eb/morphoeval/lean/loops/Loop_3121_argonauta_argo_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(D_v f_u + D_u g_v)^2 > 4 D_u D_v det(J)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rspb.2010.0155>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3121.turingLhs" ;
    pk:leanTheorem "MathOfBiology.Loop_3121.turingWavenumberUnstable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-argonauta-argo-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength and Holocene tier scale" ;
    dct:description "Pins this node to 95 µm and age 0 Ma, with no predecessor delta | Variables: tier scale 948 tenths of a micrometre; holoceneAgeMa = 0; chronoseries length 1" ;
    dct:source "Finn & Norman 2010 DOI:10.1098/rspb.2010.0155 (organism); Turing 1952 (wavelength law)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0e502ec97af571f7d94f76469868477feaaf61eb/morphoeval/lean/loops/Loop_3121_argonauta_argo_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 2 pi / k_c, with k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); tier size 9.48e-05 m at 0 Ma" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rspb.2010.0155>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3121.tierScaleTenthUm" ;
    pk:leanTheorem "MathOfBiology.Loop_3121.holoceneDetailScaleExtant" ;
    pk:leanVerified true .


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Argonauta argo Schnakenberg critical mode at the 95 µm Holocene tier faithfully reproduces Argonauta argo morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-argonauta-argo-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Argonauta argo specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-argonauta-argo-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-argonauta-argo-turing-wavelength-s0.py; output: docs/media/argonauta_argo_turing_wavelength_s0_growth.gif; organism: Argonauta argo; environment: n/a; claim_boundary: [reported_in_source: Turing (1952) selects a finite critical wavenumber when the inhibitor out-diffuses the activator and the reaction Jacobian is stable without diffusion. | Gierer & Meinhardt (1972) and Murray (1981) place spots and ocelli in that class. | Finn & Norman (2010) describe the female Argonauta argo brood shell as a buoyancy organ.; reconstructed_in_script: Critical radial mode fitted to the 100 µm plate, length unit set so analytical λ_c equals the measured 170.03 µm period. | Procedural Gaussian grain (seed 3121), amplitude chosen by a sweep of CV similarity. Phases are not copied from the plate. | Equal-diffusion ablation and a γ sweep.; transfer_boundary: The CC0 whole-shell photograph is a scale control (rib autocorrelation fraction 0.088 versus ocellus period fraction 0.234), not a 95 µm measurement. It has no scale bar.; does_not_claim: Finn & Norman did not measure a 95 µm wavelength. | The gallery plate is a prepared species-gallery image, not a Finn figure and not a population sample. | D_u and D_v are not measured diffusivities. | No predecessor chronospecies is claimed. The series is Holocene 1/1 at 0 Ma.]; phenomenon_size: 154 µm (0.0001536 m, log10=-3.814 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 154 µm to 25.1 cm): 154 µm:argonauta-argo-bioelectric-polarity, 296 µm:argonauta-argo-vertex-packing, 5.6 mm:argonauta-argo-turing-wavelength, 1.0 cm:argonauta-argo-clock-wavefront, 2.4 cm:argonauta-argo-elastic-buckling, 3.3 cm:argonauta-argo-morphogen-condensation, 4.3 cm:argonauta-argo-flux-canalization, 5.6 cm:argonauta-argo-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1098/rspb.2010.0155>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-argonauta-argo-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-argonauta-argo-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1098/rspb.2010.0155>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://doi.org/10.1007/BF00289234> dct:date "1972"^^xsd:gYear ;
        dct:title "A theory of biological pattern formation" .
    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:date "1981"^^xsd:gYear ;
        dct:title "A pre-pattern formation mechanism for animal coat markings" .
    <https://doi.org/10.1098/rspb.2010.0155> dct:date "2010"^^xsd:gYear ;
        dct:title "The argonaut shell: gas-mediated buoyancy control in a pelagic octopus" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
}


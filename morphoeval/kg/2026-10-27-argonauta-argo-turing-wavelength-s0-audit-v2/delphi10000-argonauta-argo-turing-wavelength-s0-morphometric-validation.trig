sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Argonauta argo Schnakenberg critical mode at the 95 µm Holocene tier — Morphometric validation: 87/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Plate versus mode: Pearson r 0.99934 (gate 0.98), RMSE 0.00550, residual CV 0.0118, KS D 0.063. Halo 85.87 µm versus tier reference 95 µm (not set equal); the 150 px window gives 85.29 µm. Plate coherency 0.203 versus grained-model coherency 0.290 (smooth-model coherency 0.998 is retained only as the pass-1 gap). Shell rib fraction 0.088 versus ocellus period fraction 0.234. Deduction: n=1 plate, and the shell photo cannot be converted to micrometres because it has no scale bar." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-gamma-sweep-wavelength-at-gamma-2-4>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-growth-gif-frame-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-shell-rib-autocorrelation-period-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-ocellus-inhibitory-halo-radius>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-radial-profile-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-radial-profile-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-radial-residual-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-vs-critical-mode-radial-profile-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation sigma_max = -0.1 1/time" ;
        schema:measurementTechnique "max_k σ(k) with D_u = D_v = 1" ;
        schema:name "equal-diffusion ablation sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.1" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max-reference> a schema:PropertyValue ;
        dct:source "Marginal stability. The ablation lies strictly below it." ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-gamma-sweep-wavelength-at-gamma-2-4> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "gamma-sweep wavelength at gamma 2.4 = 109.7535 µm" ;
        dct:description "The endpoint ratio matches λ ∝ γ^(-1/2); the two endpoints themselves are different wavelengths." ;
        schema:measurementTechnique "λ_c(γ=2.4) with the length unit fixed by the plate period at γ=1" ;
        schema:name "gamma-sweep wavelength at gamma 2.4" ;
        schema:unitText "µm" ;
        schema:value "109.7535" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-gamma-sweep-wavelength-at-gamma-2-4-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-gamma-sweep-wavelength-at-gamma-2-4-reference> a schema:PropertyValue ;
        dct:source "λ_c at the other sweep endpoint γ=0.55 (229 µm class), not the γ=2.4 result" ;
        schema:value "229.2677" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-growth-gif-frame-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growth gif frame count = 12 frames" ;
        dct:description "800x600" ;
        schema:measurementTechnique "PIL n_frames of docs/media/argonauta_argo_turing_wavelength_s0_growth.gif" ;
        schema:name "growth gif frame count" ;
        schema:unitText "frames" ;
        schema:value "12" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-growth-gif-frame-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-growth-gif-frame-count-reference> a schema:PropertyValue ;
        dct:source "Minimum animated length requested for this loop" ;
        schema:value "10" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-shell-rib-autocorrelation-period-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "shell rib autocorrelation period fraction = 0.0884 fraction of shell-photo width" ;
        dct:description "Negative scale control: whole-shell ribbing is not the 95 µm ocellus. No µm conversion is claimed for the shell photo (it has no scale bar)." ;
        schema:measurementTechnique "first autocorrelation peak of a mid-whorl transect on the CC0 shell photograph" ;
        schema:name "shell rib autocorrelation period fraction" ;
        schema:unitText "fraction of shell-photo width" ;
        schema:value "0.0884" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-shell-rib-autocorrelation-period-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-shell-rib-autocorrelation-period-fraction-reference> a schema:PropertyValue ;
        dct:source "Ocellus peak-to-peak period as a fraction of the 800 px plate width" ;
        schema:value "0.2338" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-ocellus-inhibitory-halo-radius> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen ocellus inhibitory halo radius = 85.8704 µm" ;
        dct:description "value is the plate measurement; reference is the tier scale. They differ on purpose." ;
        schema:measurementTechnique "argmin of the fitted critical radial mode on the 100 µm plate, excluding the caption band" ;
        schema:name "specimen ocellus inhibitory halo radius" ;
        schema:unitText "µm" ;
        schema:value "85.8704" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-ocellus-inhibitory-halo-radius-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-ocellus-inhibitory-halo-radius-reference> a schema:PropertyValue ;
        dct:source "Campaign tier label for slot 3121 (95 µm, 9.48e-05 m). Not a fitted copy of the measurement." ;
        schema:value "95.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-radial-profile-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial-profile KS statistic = 0.06329 KS D" ;
        dct:description "p=0.9977" ;
        schema:measurementTechnique "two-sample KS between plate and critical-mode radial-bin means" ;
        schema:name "specimen radial-profile KS statistic" ;
        schema:unitText "KS D" ;
        schema:value "0.06329" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-radial-profile-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-radial-profile-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "A clearly mismatched pair of curves would sit near this D" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-radial-profile-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial-profile RMSE = 0.0055 gray fraction" ;
        schema:measurementTechnique "RMSE of azimuthal means on 80 radial bins inside 220 px" ;
        schema:name "specimen radial-profile RMSE" ;
        schema:unitText "gray fraction" ;
        schema:value "0.0055" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-radial-profile-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-radial-profile-rmse-reference> a schema:PropertyValue ;
        dct:source "Loose mismatch threshold; the fit is reported against this bar" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-radial-residual-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial residual CV = 0.0118 std/mean" ;
        schema:measurementTechnique "std(profile - mode) / mean(profile)" ;
        schema:name "specimen radial residual CV" ;
        schema:unitText "std/mean" ;
        schema:value "0.0118" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-radial-residual-cv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-radial-residual-cv-reference> a schema:PropertyValue ;
        dct:source "Comparison level for residual scatter, not the observed CV" ;
        schema:value "0.1" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.2026 coherency" ;
        dct:description "Smooth field coherency is 0.9981; grain brings the model toward the plate." ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) of the Sobel structure tensor on the plate interior" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.2026" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "Same operator on the critical mode plus procedural grain at amplitude 0.4" ;
        schema:value "0.2903" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-vs-critical-mode-radial-profile-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen vs critical-mode radial profile Pearson r = 0.99934 correlation" ;
        schema:measurementTechnique "Pearson correlation of azimuthal mean gray and the Schnakenberg critical-mode profile" ;
        schema:name "specimen vs critical-mode radial profile Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.99934" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-vs-critical-mode-radial-profile-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-measurement-specimen-vs-critical-mode-radial-profile-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Pre-registered goodness-of-fit gate, not the observed correlation" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-argonauta-argo-turing-wavelength-s0.py L560–L640" ;
        dct:description "measure_morphoeval halo, Pearson, RMSE, KS, grained coherency, shell fraction" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0e502ec97af571f7d94f76469868477feaaf61eb/models/2026-delphi10000-argonauta-argo-turing-wavelength-s0.py#L560-L640> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "datasets/argonauta_argo_turing_wavelength_s0/argonauta_argo_turing_wavelength_s0_metrics.json (generated output)" ;
        dct:description "numeric values cited in the rationale — datasets/argonauta_argo_turing_wavelength_s0/argonauta_argo_turing_wavelength_s0_metrics.json: rendered output of models/2026-delphi10000-argonauta-argo-turing-wavelength-s0.py at 0e502ec97af571f7d94f76469868477feaaf61eb, application/json, 1616 B, artifact_sha256 9b00c2c18ee9c31cbf1ed60d39af282c69df2b24ee8714bb057b0be7823ad489 (sha256 9b00c2c18ee9c31cbf1ed60d39af282c69df2b24ee8714bb057b0be7823ad489), spec_fingerprint 54b806e24537aefcedcf7233858405c3246c56ac09b2d0e212f862aff5e91fe3" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent round; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Eldredgeops rana_17file Turing wavelength at 342 nm (Tioughniogan, 384 Ma) — Morphometric validation: 70/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion RMSE is 0.003 and the plate's 100 µm bar is measured at 111 px (0.901 µm/px). File count 17 is compared with predecessor 18. The specimen radial test is only the raw activator correlation 0.618, with no RMSE or KS of a luminance readout." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-activator-radial-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-critical-wavelength-nm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-dispersion-growth-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-dispersion-growth-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-dorsoventral-file-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-ocellus-halfmax-radius-nm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-specimen-bright-core-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-specimen-scale-bar-um-per-px>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-activator-radial-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "activator_radial_pearson_r = 0.6179383206528805 1" ;
        schema:measurementTechnique "Pearson r of the raw activator radial mean against specimen luminance, before the optical readout." ;
        schema:name "activator_radial_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.6179383206528805" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-activator-radial-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-activator-radial-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-critical-wavelength-nm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical_wavelength_nm = 342.0 nm" ;
        schema:measurementTechnique "k_c from Schnakenberg Jacobian; length unit fixed at the reference D_v. Reference is the rejected self-similar predecessor wavelength 323 nm." ;
        schema:name "critical_wavelength_nm" ;
        schema:unitText "nm" ;
        schema:value "342.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-critical-wavelength-nm-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-critical-wavelength-nm-reference> a schema:PropertyValue ;
        schema:value "323.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-dispersion-growth-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_growth_pearson_r = 0.999969719034388 1" ;
        schema:measurementTechnique "Pearson r of eigenvector-aligned early growth versus analytic σ(k) on 14 wavenumbers." ;
        schema:name "dispersion_growth_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.999969719034388" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-dispersion-growth-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-dispersion-growth-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-dispersion-growth-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_growth_rmse = 0.003045049913630016 1/time" ;
        schema:measurementTechnique "RMSE of measured versus analytic growth rates." ;
        schema:name "dispersion_growth_rmse" ;
        schema:unitText "1/time" ;
        schema:value "0.003045049913630016" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-dispersion-growth-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-dispersion-growth-rmse-reference> a schema:PropertyValue ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-dorsoventral-file-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dorsoventral_file_count = 17 files" ;
        schema:measurementTechnique "Tioughniogan count versus the 18-file predecessor (Eldredge 1972)." ;
        schema:name "dorsoventral_file_count" ;
        schema:unitText "files" ;
        schema:value "17" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-dorsoventral-file-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-dorsoventral-file-count-reference> a schema:PropertyValue ;
        schema:value "18" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-ocellus-halfmax-radius-nm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ocellus_halfmax_radius_nm = 98.32499999999999 nm" ;
        schema:measurementTechnique "Half-maximum radius of the activator spot inside the 1.15 λ cell." ;
        schema:name "ocellus_halfmax_radius_nm" ;
        schema:unitText "nm" ;
        schema:value "98.32499999999999" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-ocellus-halfmax-radius-nm-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-ocellus-halfmax-radius-nm-reference> a schema:PropertyValue ;
        schema:value "342.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-specimen-bright-core-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_bright_core_fraction = 0.28465169270833335 1" ;

        schema:value "0.28465169270833335" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-specimen-bright-core-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-measurement-specimen-bright-core-fraction-reference> a schema:PropertyValue ;

<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg activator-inhibitor kinetics" ;
    dct:description "Spot-forming kinetics whose linearization selects one ocellus per 1.15-wavelength cell | Variables: rho_a=0.082, rho_b=0.918, D_u=0.060, D_v=1.200, seed=3216" ;
    dct:source "Schnakenberg 1979 doi:10.1016/0022-5193(79)90042-0; Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3216_eldredgeops_rana_17file_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "du/dt = rho_a - u + u^2 v + D_u Laplacian u; dv/dt = rho_b - u^2 v + D_v Laplacian v" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/s41586-019-1473-z>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.5531/sd.paleo.7> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3216.turing_discriminant_positive" ;
    pk:leanTheorem "MathOfBiology.Loop_3216.turing_discriminant_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical Turing wavenumber" ;
    dct:description "Wavelength selection at the 342 nm pigment / ocellus scale | Variables: f_u, g_v from the Schnakenberg Jacobian at (u*, v*) = (rho_a+rho_b, rho_b/(rho_a+rho_b)^2)" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3216_eldredgeops_rana_17file_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); lambda_c = 2 pi / k_c = 342 nm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/s41586-019-1473-z>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.5531/sd.paleo.7> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3216.wavelengthNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3216.wavelength_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Tioughniogan file-count punctuation at fixed wavelength" ;
    dct:description "What changes at 384 Ma versus Eldredgeops rana_18file is the file count, not k_c | Variables: N_files predecessor 18, successor 17, age 384 Ma" ;
    dct:source "Eldredge 1972 https://digitallibrary.amnh.org/handle/2246/1096" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3216_eldredgeops_rana_17file_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N_17 = 17 = N_18 - 1; lambda_17 = 342 nm; lambda_self_similar_18 = 342 * 17/18 = 323 nm (contrast only)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/s41586-019-1473-z>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.5531/sd.paleo.7> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3216.fileCount" ;
    pk:leanTheorem "MathOfBiology.Loop_3216.tioughniogan_drops_one_file" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


        <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-yap-excitable-segmentation-audit-hubaud-yap-excitable-segmentation-1> ;
    pk:hypothesisType "Excitable FitzHugh-Nagumo Somite Clock Gated by YAP Mechanotransduction" ;
    pk:weightOfEvidence 5.97e-01 .


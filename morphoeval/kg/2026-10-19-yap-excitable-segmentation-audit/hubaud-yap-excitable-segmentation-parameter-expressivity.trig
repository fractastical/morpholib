    <https://doi.org/10.1016/S0006-3495(61)86902-6> dct:date "1961"^^xsd:gYear ;
        dct:title "Impulses and physiological states in theoretical models of nerve membrane" .
    <https://doi.org/10.1016/j.cell.2017.08.043> dct:date "2017"^^xsd:gYear ;
        dct:title "Excitable dynamics and Yap-dependent mechanical cues drive the segmentation clock" .
    <https://doi.org/10.1038/nature10137> dct:date "2011"^^xsd:gYear ;
        dct:title "Role of YAP/TAZ in mechanotransduction" .
    <https://doi.org/10.1038/nature11804> dct:date "2013"^^xsd:gYear ;
        dct:title "Scaling of embryonic patterning based on phase-gradient encoding" .

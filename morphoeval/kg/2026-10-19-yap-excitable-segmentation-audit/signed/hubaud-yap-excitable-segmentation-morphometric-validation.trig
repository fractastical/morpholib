sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hubaud-yap-excitable-segmentation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hubaud, Regev, Mahadevan & Pourquié (2017) excitable FitzHugh-Nagumo segmentation clock gated by YAP mechanotransduction — Morphometric validation: 56/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Reports only the Hopf bifurcation coordinate |u_H| = 0.9675 in Pass 1; requires 5 reference-anchored morphometric measurements including critical nuclear YAP threshold Y_crit, Latrunculin A oscillation period T_osc, 6-regime oscillating fraction Pearson r, and bilateral specimen somite spacing." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2016-hubaud-yap-excitable-segmentation.py L86–L106: Single baseline measurement in measure_morphoeval() <https://github.com/fractastical/morpholib/blob/317bc3c/2016-hubaud-yap-excitable-segmentation.py#L86-L106>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-fitzhugh-nagumo-supercritical-hopf-bifurcation-coordinate-u-h> ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-fitzhugh-nagumo-supercritical-hopf-bifurcation-coordinate-u-h> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FitzHugh-Nagumo supercritical Hopf bifurcation coordinate |u_H| = 0.9675 dimensionless activator units" ;
        dcterms:description "quiescent Y_nuc=0.85 amplitude=0.0000; Latrunculin A Y_nuc=0.22 amplitude=3.8602" ;
        schema:measurementTechnique "analytical FHN Jacobian trace zero |u_H| = sqrt(1 - epsilon * b) for epsilon = 0.08, b = 0.8" ;
        schema:name "FitzHugh-Nagumo supercritical Hopf bifurcation coordinate |u_H|" ;
        schema:unitText "dimensionless activator units" ;
        schema:value "0.9675" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-fitzhugh-nagumo-supercritical-hopf-bifurcation-coordinate-u-h-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hubaud-yap-excitable-segmentation-measurement-fitzhugh-nagumo-supercritical-hopf-bifurcation-coordinate-u-h-reference> a schema:PropertyValue ;
        dcterms:source "Hubaud, Regev, Mahadevan & Pourquie (2017) Cell 171:668-682 Fig. 3 & STAR Methods" ;
        schema:value "0.9675" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


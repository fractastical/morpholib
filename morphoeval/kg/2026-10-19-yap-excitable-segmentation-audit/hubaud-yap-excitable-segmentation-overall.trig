sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hubaud-yap-excitable-segmentation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-overall> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hubaud-yap-excitable-segmentation-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Hubaud, Regev, Mahadevan & Pourquié (2017) excitable FitzHugh-Nagumo segmentation clock gated by YAP mechanotransduction — MorphoEval overall 59.7/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Pass 1 baseline assessment of `2016-hubaud-yap-excitable-segmentation.py` (60.6/100). The initial baseline integrates the single-cell FitzHugh-Nagumo oscillator across quiescent (Y_nuc = 0.85) and Latrunculin A-rescued (Y_nuc = 0.22) states, but requires full phase-plane cubic nullcline and supercritical Hopf bifurcation continuation across Y_nuc, evaluation of all 6 experimental perturbation regimes from Hubaud et al. (2017) (including Dll1 coating, Y-27632 Rockout, intact high-density mPSM, and constitutively active Yap5SA block), 2D reaction-diffusion excitable target-wave PDE simulation, and automated bilateral somite segmentation on `mouse_psm_somites_specimen.jpg`. Overall 59.7/100 (faithfulness 57.9, reproducibility 64.1); rubric morphoeval 0.1.0; checkpoint commit 317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1. Dimension assessments: Model fidelity to source 64, Morphological realism / specimen match 54, Parameter expressivity 58, Morphometric validation 56, Source and data traceability 66, Code-to-model traceability 62, Reproducibility package 64. Output judged: docs/media/yap_excitable_segmentation_comparison.png: rendered output of 2016-hubaud-yap-excitable-segmentation.py at 317bc3c, image/png, 518047 B, 1440×600 px, artifact_sha256 6b9dd961ed3e3f482347efcc7c61faa7a228c710bfa98b6ac45f327676603c28 (sha256 6b9dd961ed3e3f482347efcc7c61faa7a228c710bfa98b6ac45f327676603c28), spec_fingerprint 7c095d87829d9eb530cca2dc7426f599cd35033e84eed2d0aa2832215c1d822c. Dual provenance: spec_fingerprint: 7c095d87829d9eb530cca2dc7426f599cd35033e84eed2d0aa2832215c1d822c; artifact_sha256: 6b9dd961ed3e3f482347efcc7c61faa7a228c710bfa98b6ac45f327676603c28; input_dataset_sha256: {datasets/yap_excitable_segmentation/mouse_psm_somites_specimen.jpg=8b80971796cb29e2..., datasets/yap_excitable_segmentation/scout_manifest.json=852a6ed7852f291d..., datasets/yap_excitable_segmentation/yap_excitable_segmentation_reference.json=4ae2d924d08acaf7...}." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Add automated bilateral paraxial somite DoG peak segmentation and periodic waveform correlation on `datasets/yap_excitable_segmentation/mouse_psm_somites_specimen.jpg`.",
            "remediation needed: Implement analytical cubic nullcline intersection continuation and Jacobian trace/Hopf bifurcation locus across nuclear YAP Y_nuc in [0, 1] and Notch coupling J_Dll1.",
            "remediation needed: Simulate all 6 Hubaud et al. (2017) experimental regimes (isolated fibronectin, Dll1-coated, Latrunculin A, Y-27632 Rockout, intact mPSM, and Yap5SA constitutive block), suprathreshold single-pulse excitability, and 2D mPSM excitable target-wave PDE propagation." ;
        pk:hasScore "0.597"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


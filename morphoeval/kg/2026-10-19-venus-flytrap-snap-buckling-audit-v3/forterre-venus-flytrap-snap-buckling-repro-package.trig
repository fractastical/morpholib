sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-forterre-venus-flytrap-snap-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Forterre et al. (2005) Nature Doubly-Curved Shallow Shell Elastic Energy & Saddle-Node Cusp Catastrophe in Dionaea muscipula, coupled to a P1-FEM trigger-hair action potential and Ca2+ counting gate — Reproducibility package: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`self_test()` (L1881-1987) runs 12 suites in ~18 s: the 8 Pass 2 checks plus FEM accuracy/convergence/sqrt(D) scaling/K*1 = 0 & mass = area, lobe AP full activation and literature-range checks, two-touch counting incl. analytic bracket and lapsed memory, and bitwise determinism (two runs, atol = 0) plus A = 0 => kappa_x0 == k_init. All five dataset files are SHA-verified; the default run regenerates the PNG, both GIFs and re-runs the self-test (L2019-2023); the growth GIF regenerates bitwise identically to Pass 2. Deductions: dead `--L`/`--h`/`--seed` flags mislead users about what is reproducible under override (-4); default render takes ~45-49 s and the environment is not pinned by a lock file in this slot (-4); the self-test asserts model-internal consistency (sweep vs analytic window) where a literature check is implied (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2005-forterre-venus-flytrap-snap-buckling.py L1999–L2001: --L, --h, --seed parsed but unused <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L1999-L2001>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-repro-package-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L1881–L1987" ;
        dct:description "12-suite self_test() incl. FEM accuracy, lobe AP, two-touch counting, bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L1881-L1987> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L1988–L2026" ;
        dct:description "CLI and default pipeline: figure, growth GIF, AP-wave GIF, self-test" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L1988-L2026> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 066 Pass 3 Assessor, Phase B subagent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


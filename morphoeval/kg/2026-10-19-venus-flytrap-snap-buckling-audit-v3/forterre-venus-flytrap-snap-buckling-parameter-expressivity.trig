sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-forterre-venus-flytrap-snap-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Forterre et al. (2005) Nature Doubly-Curved Shallow Shell Elastic Energy & Saddle-Node Cusp Catastrophe in Dionaea muscipula, coupled to a P1-FEM trigger-hair action potential and Ca2+ counting gate — Parameter expressivity: 78/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Pass 2 sweeps remain (10 alpha values L452-540, 12-point kinematics L541-604, 5 developmental/ablation specimens L605-682). Pass 3 adds a diffusivity ablation sweep (`evaluate_diffusivity_scaling_sweep` L908-924, v ~ D^0.496), an h-refinement study (L925-931), a force bisection for the FEM initiation threshold (L969-992), an 8-interval two-touch memory sweep (L1074-1100) and three functional CLI flags `--hair-force`, `--touch-interval`, `--ap-diffusivity` (L1993-1995, dispatched at L2008-2017). Deductions: `--L`, `--h`, `--seed` (L1999-2001) are parsed but never used — there is no RNG and L/h are not passed to any solver (-10); `--hair-force` only affects the panels and GIF while `measure_morphoeval()` always uses 6.0 µN (L934, L1222) (-5); the mesh convergence study holds `FEM_DT_S` fixed so the error plateaus at ~2.4 % (-4); no sweep of hair position or footprint radius, although the footprint must exceed the 2D critical nucleus or nothing fires (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2005-forterre-venus-flytrap-snap-buckling.py L1993–L2001: --hair-force / --touch-interval / --ap-diffusivity functional; --L, --h, --seed parsed but unused <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L1993-L2001>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-parameter-expressivity-4> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L452–L682" ;
        dct:description "Alpha bifurcation sweep, three-stage kinematics and developmental/ablation specimen sweep (Pass 2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L452-L682> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L908–L931" ;
        dct:description "Diffusivity scaling sweep and h-refinement study; dt is not refined with h" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L908-L931> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L969–L992" ;
        dct:description "Bisection of trigger-hair force for all-or-none FEM initiation (F_min = 3.00 µN vs 0-D 1.93 µN)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L969-L992> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L1074–L1100" ;
        dct:description "Single-touch, 8-interval two-touch sweep and (0, 60, 70) s three-touch protocols" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L1074-L1100> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 066 Pass 3 Assessor, Phase B subagent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-forterre-venus-flytrap-snap-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Forterre et al. (2005) Nature Doubly-Curved Shallow Shell Elastic Energy & Saddle-Node Cusp Catastrophe in Dionaea muscipula, coupled to a P1-FEM trigger-hair action potential and Ca2+ counting gate — Source and data traceability: 80/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Five dataset files are SHA-256-pinned and verified fail-closed at runtime (`EXPECTED_SHA256` L124-143, `verify_dataset_integrity` L155-167), including the new `trigger_hair_ap_reference.json`; `paper_citations.bib` carries 12 entries with DOIs and the module header lists all 12 sources (L1-76). The new JSON honestly tags every value with provenance and `doi_verified_offline: false`. Deductions: the 8 new DOIs and every new numeric literature value were recalled offline and are NOT verified (bib `note = {DOI unverified offline (Pass 3)}`) (-8); the Volkov 2008 (m/s, ms) vs Hodick & Sievers 1988 (cm/s, s) discrepancy on AP speed/duration is noted but unresolved (-4); the bib digest changed (f6ac2d52... -> b7c452b0...) so the v2 measurements' recorded digest is stale (-2); the `*_obs` reference columns in the Pass 2 JSON have no documented literature provenance (-6)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/venus_flytrap_snap_buckling/paper_citations.bib L48–L141: 8 Pass 3 entries each with note = {DOI unverified offline (Pass 3)} <https://github.com/fractastical/morpholib/blob/de27b685/datasets/venus_flytrap_snap_buckling/paper_citations.bib#L48-L141>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-source-traceability-4> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L124–L167" ;
        dct:description "SHA-256 registry for 5 dataset files (bib digest updated for +8 entries) and fail-closed runtime verification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L124-L167> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L1–L76" ;
        dct:description "Module header lists 12 sources with DOIs and states that DOIs 5-12 were recalled offline and not verified" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L1-L76> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/venus_flytrap_snap_buckling/trigger_hair_ap_reference.json L1–L63" ;
        dct:description "Per-value provenance tags; doi_verified_offline: false; Volkov vs Hodick & Sievers discrepancy noted, unresolved" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/datasets/venus_flytrap_snap_buckling/trigger_hair_ap_reference.json#L1-L63> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/venus_flytrap_snap_buckling/README.md L16–L36" ;
        dct:description "Pass 3 section and file list including SHA-pinned new JSON and unverified-DOI disclosure" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/datasets/venus_flytrap_snap_buckling/README.md#L16-L36> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 066 Pass 3 Assessor, Phase B subagent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .

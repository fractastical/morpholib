    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-trigger-hair-all-or-none-ap-initiation-threshold-force-in-fem-lobe-rushton-liminal-length-effect> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Trigger hair all-or-none AP initiation threshold force in FEM lobe (Rushton liminal-length effect) = 3.0044 uN" ;
        dcterms:description "largely parameter-driven (F_half is set near the literature value); the emergent content is the FEM-load elevation above the 0-D threshold" ;
        schema:measurementTechnique "9-step bisection on hair bending force with Boltzmann FLYC1 open probability (F_half=2.9 uN); 0-D point threshold 1.934 uN, liminal ratio 1.553" ;
        schema:name "Trigger hair all-or-none AP initiation threshold force in FEM lobe (Rushton liminal-length effect)" ;
        schema:unitText "uN" ;
        schema:value "3.0044" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-trigger-hair-all-or-none-ap-initiation-threshold-force-in-fem-lobe-rushton-liminal-length-effect-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-trigger-hair-all-or-none-ap-initiation-threshold-force-in-fem-lobe-rushton-liminal-length-effect-reference> a schema:PropertyValue ;
        dcterms:source "Scherzer et al. (2019) Nat. Plants 5:670-675 micronewton trigger-hair threshold; Procko et al. (2021) eLife FLYC1 — approx., DOI unverified offline" ;
        schema:value "2.9" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-two-touch-counting-short-term-memory-window-longest-inter-touch-interval-that-still-snaps> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Two-touch counting short-term memory window (longest inter-touch interval that still snaps) = 24.7616 s" ;
        dcterms:description "window is set by two model constants (c, tau_Ca); the self-test checks sweep/analytic consistency, not the literature value" ;
        schema:measurementTechnique "Analytic tau_Ca ln(c/(1-c)) with c=0.65, tau_Ca=40.0 s; FEM-coupled protocol sweep brackets it in (20, 25) s over intervals [5.0, 10.0, 15.0, 20.0, 25.0, 30.0, 40.0, 60.0]; 3 touches at (0, 60, 70) s snapped = True" ;
        schema:name "Two-touch counting short-term memory window (longest inter-touch interval that still snaps)" ;
        schema:unitText "s" ;
        schema:value "24.7616" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-two-touch-counting-short-term-memory-window-longest-inter-touch-interval-that-still-snaps-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-two-touch-counting-short-term-memory-window-longest-inter-touch-interval-that-still-snaps-reference> a schema:PropertyValue ;
        dcterms:source "Volkov et al. (2008) Plant Physiol electrical memory ~30 s; Suda et al. (2020) Ca2+ decay — approx., DOI unverified offline" ;
        schema:value "30.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-two-touch-delta-10-s-snap-latency-from-second-trigger-hair-touch-to-peak-snap-speed> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Two-touch (Delta = 10 s) snap latency from second trigger-hair touch to peak snap speed = 0.354 s" ;
        dcterms:description "emergent from FEM propagation + Ca2+ gating + Pass 2 shell dynamics; tau_a inherited from Pass 2" ;
        schema:measurementTechnique "Coupled protocol: AP arrival onset 2 ms, full-lobe Ca2+ activation 142 ms, then tau_a = 0.18 s turgor relaxation to the saddle-node fold; final kappa_x/k_init = -1.109" ;
        schema:name "Two-touch (Delta = 10 s) snap latency from second trigger-hair touch to peak snap speed" ;
        schema:unitText "s" ;
        schema:value "0.354" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-two-touch-delta-10-s-snap-latency-from-second-trigger-hair-touch-to-peak-snap-speed-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-two-touch-delta-10-s-snap-latency-from-second-trigger-hair-touch-to-peak-snap-speed-reference> a schema:PropertyValue ;

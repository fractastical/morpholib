        schema:measurementTechnique "Exact shallow-shell cusp catastrophe threshold alpha_c = (1 + nu) / (c_stretch * k_init^2)" ;
        schema:name "Forterre et al. (2005) critical cusp catastrophe coupling threshold alpha_c (nu=0.28)" ;
        schema:unitText "dimensionless" ;
        schema:value "0.8" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-forterre-et-al-2005-critical-cusp-catastrophe-coupling-threshold-alpha-c-nu-0-28-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-forterre-et-al-2005-critical-cusp-catastrophe-coupling-threshold-alpha-c-nu-0-28-reference> a schema:PropertyValue ;
        dcterms:source "Forterre, Skotheim, Dumais & Mahadevan (2005) Nature 433:421-425 Eq. 2-3 & Fig. 3b" ;
        schema:value "0.8" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-p1-fem-planar-action-potential-conduction-velocity-vs-exact-nagumo-front-speed-strip-benchmark> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "P1-FEM planar action potential conduction velocity vs exact Nagumo front speed (strip benchmark) = 9.5496 cm/s" ;
        dcterms:description "numerical-accuracy validation of the FEM solver (not a biological fit); residual ~2.5% is IMEX time-splitting error (does not vanish with h alone)" ;
        schema:measurementTechnique "Activation-time regression on a 1010-node P1 strip mesh (h=0.03 cm, IMEX dt=0.0005 s); analytic c = sqrt(2D/tau_v)(1/2-a); relative error 0.0253, h-refinement error 0.0326 -> 0.0246" ;
        schema:name "P1-FEM planar action potential conduction velocity vs exact Nagumo front speed (strip benchmark)" ;
        schema:unitText "cm/s" ;
        schema:value "9.5496" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-p1-fem-planar-action-potential-conduction-velocity-vs-exact-nagumo-front-speed-strip-benchmark-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-p1-fem-planar-action-potential-conduction-velocity-vs-exact-nagumo-front-speed-strip-benchmark-reference> a schema:PropertyValue ;
        dcterms:source "McKean (1970) Adv. Math. 4:209-223 exact bistable (Nagumo) cable front speed; trigger_hair_ap_reference.json (theory-exact)" ;
        schema:value "9.798" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-single-touch-one-action-potential-final-shell-curvature-kappa-x-kappa-init-no-closure-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Single-touch (one action potential) final shell curvature kappa_x/kappa_init — no closure control = 0.9733 dimensionless" ;
        dcterms:description "negative control; small deviation from 1.0 is the convex equilibrium offset of the Pass 2 shell energy at kx0 = k_init" ;
        schema:measurementTechnique "Coupled FEM-AP -> Ca2+ counter -> shell protocol with one touch; peak Ca2+ = 0.65 threshold units < 1 so A(t) = 0 and kappa_x0 stays at k_init" ;
        schema:name "Single-touch (one action potential) final shell curvature kappa_x/kappa_init — no closure control" ;
        schema:unitText "dimensionless" ;
        schema:value "0.9733" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-single-touch-one-action-potential-final-shell-curvature-kappa-x-kappa-init-no-closure-control-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-single-touch-one-action-potential-final-shell-curvature-kappa-x-kappa-init-no-closure-control-reference> a schema:PropertyValue ;
        dcterms:source "Böhm et al. (2016) Curr Biol 26:286-295; Suda et al. (2020) Nat Plants 6:1219-1224 — two APs required for closure" ;
        schema:value "1.0" .


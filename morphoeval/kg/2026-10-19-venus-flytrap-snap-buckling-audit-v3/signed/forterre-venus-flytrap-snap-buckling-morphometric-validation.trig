    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-fem-lobe-action-potential-conduction-velocity-from-trigger-hair-across-dionaea-lobe-planform-reference> a schema:PropertyValue ;
        dcterms:source "Hodick & Sievers (1988) Planta 174:8-18 (6-20 cm/s range); Hedrich & Neher (2018) Trends Plant Sci — approx., DOI unverified offline" ;

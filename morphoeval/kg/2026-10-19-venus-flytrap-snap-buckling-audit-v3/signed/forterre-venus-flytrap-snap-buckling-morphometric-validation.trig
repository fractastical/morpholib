        schema:measurementTechnique "Gauss Theorema Egregium mid-surface stretching penalty c_stretch * alpha * (0 - k_init^2)^2 vs U_stretch(+-k_init, +-k_init)=0" ;
        schema:name "Flat-pass Gaussian stretching energy barrier U_stretch(0, 0) at adult alpha=3.0" ;
        schema:unitText "dimensionless" ;
        schema:value "4.8" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-flat-pass-gaussian-stretching-energy-barrier-u-stretch-0-0-at-adult-alpha-3-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-flat-pass-gaussian-stretching-energy-barrier-u-stretch-0-0-at-adult-alpha-3-0-reference> a schema:PropertyValue ;
        dcterms:source "Forterre et al. (2005) Nature 433:421-425 Eq. 1-2 & Lean 4 Loop_066 Law 1" ;
        schema:value "4.8" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-forterre-et-al-2005-critical-cusp-catastrophe-coupling-threshold-alpha-c-nu-0-28> a schema:PropertyValue,

            pk:EvidenceItem ;
        rdfs:label "FEM action potential half-amplitude duration at lobe probe nodes = 1.5462 s" ;
        dcterms:description "recovery constants tau_w=0.5 s, gamma=0.5, beta_w=0.1 are model choices; Volkov et al. (2008) report a much shorter AP (discrepancy noted in dataset JSON)" ;
        schema:measurementTechnique "Time between first and last crossing of V = 0.5 (normalised) at hair-footprint and far-edge probes, averaged over 3 hairs" ;
        schema:name "FEM action potential half-amplitude duration at lobe probe nodes" ;
        schema:unitText "s" ;
        schema:value "1.5462" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-fem-action-potential-half-amplitude-duration-at-lobe-probe-nodes-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-measurement-fem-action-potential-half-amplitude-duration-at-lobe-probe-nodes-reference> a schema:PropertyValue ;
        dcterms:source "Hedrich & Neher (2018) Trends Plant Sci 23:220-234 (~1-2 s Dionaea AP) — approx., DOI unverified offline" ;

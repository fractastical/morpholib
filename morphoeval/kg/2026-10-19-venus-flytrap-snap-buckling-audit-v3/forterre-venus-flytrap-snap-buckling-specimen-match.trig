sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-forterre-venus-flytrap-snap-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Forterre et al. (2005) Nature Doubly-Curved Shallow Shell Elastic Energy & Saddle-Node Cusp Catastrophe in Dionaea muscipula, coupled to a P1-FEM trigger-hair action potential and Ca2+ counting gate — Morphological realism / specimen match: 80/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The SHA-256-pinned CC BY-SA 2.5 Dionaea specimen is segmented into anthocyanin inner lobes, midrib hinge (x = 453 px) and 15 marginal cilia teeth (`segment_dionaea_trap_specimen` L1104-1185) and shown in Panel F; the new Panel G renders the FEM arrival-time map on the same ellipse planform as the bilobed mesh with the three hair positions, and the lobe conduction velocity 8.35 cm/s falls inside the recalled 6-20 cm/s range. Deductions: the 3D trap geometry of Panel A (`build_bilobed_trap_mesh` L1187-1214) is an illustrative parametrisation (0.42*kx+0.12, 0.22, 0.28, 0.18) not derived from the shell energy (-6); the specimen symmetry 0.9745 and cilia CV 0.3905 are compared with the script's own recorded outputs (L1776, L1786), so the specimen \"match\" is tautological (-6); hair positions `LOBE_TRIGGER_HAIRS_REL` (L700) and the 0.15 cm footprint (L687) are model placements, not measured from the specimen (-4); the planform mesh is flat and does not follow the segmented lobe contour (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2005-forterre-venus-flytrap-snap-buckling.py L1187–L1214: build_bilobed_trap_mesh uses illustrative shape factors (0.42*kx+0.12, 0.22, 0.28, 0.18) not derived from the energy <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L1187-L1214>",
            "2005-forterre-venus-flytrap-snap-buckling.py L1772–L1790: Specimen measurements 8-9 use reference_value 0.9745 / 0.3905 = the script's own earlier outputs <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L1772-L1790>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match-4> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L1104–L1185" ;
        dct:description "Anthocyanin lobe contour, midrib hinge and marginal cilia tooth segmentation on the SHA-pinned Dionaea specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L1104-L1185> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L1425–L1455" ;
        dct:description "Panel G: FEM arrival-time map + mesh + hair footprints on the lobe planform" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L1425-L1455> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/venus_flytrap_snap_buckling_comparison.png (generated output)" ;
        dct:description "9-panel figure: shell meshes, pitchfork, 3-stage kinematics, cusp diagram, scaling/ablation, specimen segmentation, FEM arrival map, one- vs two-touch traces, memory sweep — docs/media/venus_flytrap_snap_buckling_comparison.png: rendered output of 2005-forterre-venus-flytrap-snap-buckling.py at de27b685, image/png, 1861421 B, 2682×2407 px, artifact_sha256 435ac24cf8de9544178ac2abf5bf4f73f1d294d040244b2c5553a08c90ccd973 (sha256 435ac24cf8de9544178ac2abf5bf4f73f1d294d040244b2c5553a08c90ccd973), spec_fingerprint 58961469a41c2bee9701d676c847ef1e7a9835ee5baa9146d199bf480fec0179" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/venus_flytrap_snap_buckling_ap_wave.gif (generated output)" ;
        dct:description "23-frame AP front crossing the lobe followed by the Ca2+-gated snap — docs/media/venus_flytrap_snap_buckling_ap_wave.gif: rendered output of 2005-forterre-venus-flytrap-snap-buckling.py at de27b685, image/gif, 658801 B, 1050×462 px, 23 frames, artifact_sha256 01f3efe2eb0f167e02e2396680cf04e68783dc09c3c476a759cbfc4520f16dc3 (sha256 01f3efe2eb0f167e02e2396680cf04e68783dc09c3c476a759cbfc4520f16dc3), spec_fingerprint 58961469a41c2bee9701d676c847ef1e7a9835ee5baa9146d199bf480fec0179" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 066 Pass 3 Assessor, Phase B subagent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


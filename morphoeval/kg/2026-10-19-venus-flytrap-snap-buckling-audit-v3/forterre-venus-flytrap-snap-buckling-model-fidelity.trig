sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-forterre-venus-flytrap-snap-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Forterre et al. (2005) Nature Doubly-Curved Shallow Shell Elastic Energy & Saddle-Node Cusp Catastrophe in Dionaea muscipula, coupled to a P1-FEM trigger-hair action potential and Ca2+ counting gate — Model fidelity to source: 82/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The Pass 2 shell model is intact: shallow-shell energy with Gauss stretching penalty (`gauss_stretching_energy` L231-244, `doubly_curved_shell_energy` L246-263), cusp fold metrics (L334-370) and RK45 coupled snap dynamics (`simulate_coupled_snap_dynamics` L373-451). Pass 3 adds a genuine, verified reduced electrophysiology layer: P1 FEM assembly (grad-grad stiffness + lumped mass, L778-796), IMEX FitzHugh-Nagumo solver with implicit diffusion via `splu` (L798-873), planar front speed within 2.5 % of the exact Nagumo formula (L725-731) and the two-touch Ca2+ gate on the rest curvature (L993-1067), backed by 5 Lean 4 theorems (0 sorrys). Deductions: `relax_shell_equilibrium_2d` minimises `((kx+ky)/2)^2 - k_init^2)^2` (L300, L307) while the energy/gradient/dynamics use the Gauss product `(kx*ky - k_init^2)^2` — two different functionals, and its `barrier_energy` (L330) is the closed-form cusp expression, not derived from the minimisation (-6); the electrics are solved on a flat planform with no curvature feedback and FitzHugh-Nagumo stands in for the multi-channel Ca2+/Cl-/K+ AP (-5); the motor response is a scalar gate A(t) on a two-mode shell, not a turgor/curvature field (-4); the 0-D hair mechanics has no lever/podium geometry (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2005-forterre-venus-flytrap-snap-buckling.py L282–L333: relax_shell_equilibrium_2d minimises a mean-curvature functional ((kx+ky)/2)^2 at L300/L307 — inconsistent with the dynamics; barrier_energy at L330 is closed-form <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L282-L333>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-6> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L231–L281" ;
        dct:description "Gauss stretching penalty, shell energy and analytic gradient use (kx*ky - k_init^2)^2" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L231-L281> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L373–L451" ;
        dct:description "Coupled 2D (kappa_x(t), kappa_y(t)) poroelastic + inertial RK45 snap solver (Pass 2, unchanged)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L373-L451> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L703–L731" ;
        dct:description "Boltzmann trigger-hair open probability, receptor potential, 0-D point threshold and exact Nagumo front speed sqrt(2D/tau_v)(1/2 - a)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L703-L731> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L737–L873" ;
        dct:description "Delaunay lobe/strip meshes, P1 stiffness + lumped mass assembly, IMEX FitzHugh-Nagumo FEM action potential with receptor-potential clamp on hair-footprint nodes; flat planform, no kappa(t) feedback" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L737-L873> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "2005-forterre-venus-flytrap-snap-buckling.py L993–L1067" ;
        dct:description "Per-node Ca2+ counter and lumped activated-area fraction A(t) gating kappa_x0 in the Pass 2 shell solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/2005-forterre-venus-flytrap-snap-buckling.py#L993-L1067> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-forterre-venus-flytrap-snap-buckling-model-fidelity-6> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_066_venus_flytrap_snap_buckling.lean L130–L184" ;
        dct:description "Laws 4-5: forterre_two_touch_calcium_counting (L133-150) and forterre_calcium_gated_rest_curvature (L169-184); file verifies with 0 sorrys" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/de27b685/morphoeval/lean/loops/Loop_066_venus_flytrap_snap_buckling.lean#L130-L184> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 066 Pass 3 Assessor, Phase B subagent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


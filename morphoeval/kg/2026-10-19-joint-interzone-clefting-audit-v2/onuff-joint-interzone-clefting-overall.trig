sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-onuff-joint-interzone-clefting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-overall> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Kavanagh et al. (2013) phalangeal Inhibitory Cascade & Hiscock et al. (2017) BMP-GDF5-Noggin synovial joint interzone segmentation — MorphoEval overall 96.4/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Pass 2 (v2) remediated evaluation of `2016-onuff-joint-interzone-clefting.py` (overall weighted score: 96.6/100, +40.2 over Pass 1). Integrates both the 1D growing-domain and 2D cylindrical chondrogenic digit-ray reaction-diffusion PDEs for GDF5/Wnt9a (D_G = 0.12) and Noggin (D_N = 1.80) modulated by a distal Phalanx-Forming Region (PFR) FGF8 gradient, reproduces the Kavanagh et al. (2013) PNAS cross-clade tetrapod Inhibitory Cascade morphospace (r = 0.9969, RMSE = 0.0101, P2/(P1+P2+P3) = 0.3333) and all 6 genetic/signaling perturbations (WT=3 joints, Nog-/-=0 joints fused rod, Gdf5 bp/bp=2 joints, Wnt9a ectopic=4 joints, sustained FGF8 equal phalanges, and D=0 ablation control=0 joints), and segments the vendored vertebrate autopod radiograph across Digits II-IV (3 synovial clefts per digit, mean P2/(P1+P2+P3) = 0.3301 vs theoretical 1/3). Overall 96.4/100 (faithfulness 96.1, reproducibility 97.0); rubric morphoeval 0.1.0; checkpoint commit 45d4150; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1. Dimension assessments: Model fidelity to source 97, Morphological realism / specimen match 95, Parameter expressivity 96, Morphometric validation 97, Source and data traceability 97, Code-to-model traceability 97, Reproducibility package 97. Output judged: docs/media/joint_interzone_clefting_comparison.png: rendered output of 2016-onuff-joint-interzone-clefting.py at 45d4150, image/png, 953358 B, 2610×1566 px, artifact_sha256 507f03513072a1ec7e36bc3b722791dd5d7c9e01bf585b7345d3f8e52a7cd4d6 (sha256 507f03513072a1ec7e36bc3b722791dd5d7c9e01bf585b7345d3f8e52a7cd4d6), spec_fingerprint 56e3e114fc02325ea6b391f130fabc0038842bfdf81e75272cec62c77030adae. Dual provenance: spec_fingerprint: 56e3e114fc02325ea6b391f130fabc0038842bfdf81e75272cec62c77030adae; artifact_sha256: 507f03513072a1ec7e36bc3b722791dd5d7c9e01bf585b7345d3f8e52a7cd4d6; input_dataset_sha256: {datasets/joint_interzone_clefting/joint_interzone_clefting_reference.json=9acd7913813a1a7b..., datasets/joint_interzone_clefting/paper_citations.bib=4d966fca533780af..., datasets/joint_interzone_clefting/scout_manifest.json=1ae24e293d2062b2..., datasets/joint_interzone_clefting/tetrapod_digit_interzone_specimen.jpg=995e43a2a0cf7815...}. Supersedes audit: 2026-10-19-joint-interzone-clefting-audit." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Couple the 2D chondrogenic digit-ray GDF5-Noggin reaction-diffusion PDE to a fluid-poroelastic synovial cavitation and articular morphogenesis solver." ;
        pk:hasScore "0.964"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 018 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


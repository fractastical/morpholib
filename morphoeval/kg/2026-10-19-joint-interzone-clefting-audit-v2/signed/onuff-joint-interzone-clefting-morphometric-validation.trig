        schema:measurementTechnique "Segmented middle phalanx length divided by total triphalangeal length in 1D growing-domain PDE" ;
        schema:name "Growing-domain PDE wild-type middle phalanx proportion P2 / (P1 + P2 + P3)" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "0.3371" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-growing-domain-pde-wild-type-middle-phalanx-proportion-p2-p1-p2-p3-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-growing-domain-pde-wild-type-middle-phalanx-proportion-p2-p1-p2-p3-reference> a schema:PropertyValue ;

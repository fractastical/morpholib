            pk:EvidenceItem ;
        rdfs:label "GDF5-Noggin critical Turing wavelength lambda_c = 3.5904 dimensionless length" ;
        dcterms:description "tr(J)=-0.50, det(J)=1.20, no-diffusion max Re(sigma)=-0.25" ;
        schema:measurementTechnique "Peak of 2x2 GDF5-Noggin Turing dispersion relation Re(sigma(q)) with D_G=0.12, D_N=1.80 (q_c=1.7500, sigma_max=0.6828)" ;
        schema:name "GDF5-Noggin critical Turing wavelength lambda_c" ;
        schema:unitText "dimensionless length" ;
        schema:value "3.5904" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-gdf5-noggin-critical-turing-wavelength-lambda-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-gdf5-noggin-critical-turing-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dcterms:source "Hiscock et al. (2017) Dev. Cell 41:459-465 (BMP-GDF5-Noggin Turing joint interzone wavelength)" ;
        schema:value "3.5904" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-growing-domain-pde-wild-type-middle-phalanx-proportion-p2-p1-p2-p3> a schema:PropertyValue,

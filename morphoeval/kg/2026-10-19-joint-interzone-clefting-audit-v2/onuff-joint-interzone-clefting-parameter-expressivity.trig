sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-onuff-joint-interzone-clefting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Kavanagh et al. (2013) phalangeal Inhibitory Cascade & Hiscock et al. (2017) BMP-GDF5-Noggin synovial joint interzone segmentation — Parameter expressivity: 96/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates the 12-taxon cross-clade tetrapod Inhibitory Cascade morphospace (L177-212: cursorial, chick, generalist, and arboreal/grasping clades, r = 0.9969) and simulates all 6 genetic and developmental perturbation conditions (L419-443: Wild-Type=3 joints, Nog-/-=0 joints fused rod, Gdf5 bp/bp=2 joints, Wnt9a ectopic=4 joints, sustained PFR-FGF8 equal phalanges, and D=0 control=0 joints), plus exposes CLI overrides (`--noggin-dose`, `--gdf5-dose`, `--alpha-taper`, `--D-ratio`, `--seed`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity-2> ;
        pk:hasScore "0.96"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L177–L212" ;
        dct:description "12-taxon cross-clade tetrapod Inhibitory Cascade regression (r=0.9969, RMSE=0.0101)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2016-onuff-joint-interzone-clefting.py#L177-L212> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L419–L443" ;
        dct:description "6 genetic and developmental perturbation PDE simulations matching published joint counts" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2016-onuff-joint-interzone-clefting.py#L419-L443> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 018 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


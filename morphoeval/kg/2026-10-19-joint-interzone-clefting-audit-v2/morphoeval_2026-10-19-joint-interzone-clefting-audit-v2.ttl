<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/onuff-joint-interzone-clefting-1>,
        <https://w3id.org/probknow/resource/math-law/onuff-joint-interzone-clefting-2>,
        <https://w3id.org/probknow/resource/math-law/onuff-joint-interzone-clefting-3> .

<https://w3id.org/probknow/resource/math-law/onuff-joint-interzone-clefting-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Kavanagh et al. (2013) Arithmetic Inhibitory Cascade Midpoint & One-Third Invariant Law" ;
    dct:description "Proves that sequential inhibitory cascade segmentation constrains triphalangeal tetrapod digits to the exact affine line P_2 = (P_1 + P_3)/2 with middle phalanx occupying exactly 1/3 of total phalangeal length | Variables: P_1, P_2, P_3: proximal, middle, and distal phalanx lengths; A: distal mesenchymal activation; I: proximal condensation lateral inhibition; Δ = P_1(A - I)/I: cascade increment" ;
    dct:source "Kavanagh et al. (2013) PNAS 110(45):18190-18195 Figs. 1-2 & Eqs. 1-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45d4150/2016-onuff-joint-interzone-clefting.py#L130-L245>,
        <https://github.com/fractastical/morpholib/blob/45d4150/morphoeval/lean/loops/Loop_018_joint_interzone_clefting.lean#L28-L44> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def phalanx_len (p1 delta n : Int) : Int :=
  p1 + (n - 1) * delta
def digit_total_3 (p1 delta : Int) : Int :=
  phalanx_len p1 delta 1 + phalanx_len p1 delta 2 + phalanx_len p1 delta 3
theorem kavanagh_inhibitory_cascade_midpoint_and_third (p1 delta : Int) :
    2 * phalanx_len p1 delta 2 = phalanx_len p1 delta 1 + phalanx_len p1 delta 3 ∧
    3 * phalanx_len p1 delta 2 = digit_total_3 p1 delta ∧
    phalanx_len 150 (-53) 2 = 97 ∧
    digit_total_3 150 (-53) = 291
"""^^pk:lean4 ;
    skos:notation "P_n = P_1 [1 + (n-1)(A-I)/I] = P_1 + (n-1)Δ  ⇒  2 P_2 = P_1 + P_3,  P_2 / P_1 = 1/2 + (1/2)(P_3 / P_1),  3 P_2 = P_1 + P_2 + P_3" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00222-7>,
        <https://doi.org/10.1016/j.devcel.2017.04.021>,
        <https://doi.org/10.1038/368639a0>,
        <https://doi.org/10.1073/pnas.1315213110>,
        <https://doi.org/10.1126/science.280.5368.1455> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled BMP-GDF5-Noggin Reaction-Diffusion Turing-Wavefront Synovial Joint Interzone Segmentation & Kavanagh (2013) Phalangeal Inhibitory Cascade" ;
    pk:leanDeclaration "MathOfBiology.Loop_018.phalanx_len" ;
    pk:leanTheorem "MathOfBiology.Loop_018.kavanagh_inhibitory_cascade_midpoint_and_third" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/onuff-joint-interzone-clefting-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Hiscock et al. (2017) Distal PFR-FGF Tapering & BMP-GDF5-Noggin Turing Dispersion Sign Inversion Law" ;
    dct:description "Establishes diffusion-driven Turing nucleation of periodic Gdf5+/Wnt9a+ synovial joint interzones and strict proximal-to-distal phalanx tapering P_1 > P_2 > P_3 under a decaying distal PFR-FGF gradient | Variables: G: GDF5/Wnt9a synovial interzone activator; N: diffusible Noggin BMP antagonist; D_G, D_N: diffusion coefficients; q: spatial wavenumber; Δ < 0: distal PFR-FGF decay increment" ;
    dct:source "Hiscock, Tschopp & Tabin (2017) Dev. Cell 41:459-465; Hartmann & Tabin (2001) Cell 104:341-351" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45d4150/2016-onuff-joint-interzone-clefting.py#L165-L340>,
        <https://github.com/fractastical/morpholib/blob/45d4150/morphoeval/lean/loops/Loop_018_joint_interzone_clefting.lean#L57-L71> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def gdf5_noggin_disp_det (f_G f_N g_G g_N D_G D_N q2 : Int) : Int :=
  (D_G * q2 - f_G) * (D_N * q2 - g_N) - f_N * g_G
theorem pfr_tapering_and_gdf5_noggin_turing_inversion (p1 delta : Int) (hd : delta ≤ -1) :
    phalanx_len p1 delta 1 > phalanx_len p1 delta 2 ∧
    phalanx_len p1 delta 2 > phalanx_len p1 delta 3 ∧
    (160 + (-210) : Int) = -50 ∧
    gdf5_noggin_disp_det 160 (-240) 190 (-210) 12 180 0 = 12000 ∧
    gdf5_noggin_disp_det 160 (-240) 190 (-210) 12 180 1 = -12120
"""^^pk:lean4 ;
    skos:notation "Δ = P_1(A - I)/I < 0  ⇒  P_1 > P_2 > P_3;  Δ_disp(q^2) = (D_G q^2 - f_G)(D_N q^2 - g_N) - f_N g_G,  Δ_disp(0) > 0,  Δ_disp(q_c^2) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00222-7>,
        <https://doi.org/10.1016/j.devcel.2017.04.021>,
        <https://doi.org/10.1038/368639a0>,
        <https://doi.org/10.1073/pnas.1315213110>,
        <https://doi.org/10.1126/science.280.5368.1455> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled BMP-GDF5-Noggin Reaction-Diffusion Turing-Wavefront Synovial Joint Interzone Segmentation & Kavanagh (2013) Phalangeal Inhibitory Cascade" ;
    pk:leanDeclaration "MathOfBiology.Loop_018.gdf5_noggin_disp_det" ;
    pk:leanTheorem "MathOfBiology.Loop_018.pfr_tapering_and_gdf5_noggin_turing_inversion" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/onuff-joint-interzone-clefting-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Brunet et al. (1998) & Storm et al. (1994) Noggin/Gdf5 Loss-of-Function Joint Cleft Ablation Law" ;
    dct:description "Proves why Noggin null (Nog-/-) embryos fail to repress BMP chondrogenesis in prospective interzones, abolishing all synovial joint clefts (N_joints = 0) into a single continuous cartilaginous rod, whereas Gdf5 brachypodism (bp/bp) selectively fuses proximal interphalangeal joints | Variables: nog_dose: Noggin BMP-antagonist dosage; gdf5_dose: GDF5 interzone signaling dosage; tau_cleft: chondrogenic repression threshold for synovial cavitation" ;
    dct:source "Brunet et al. (1998) Science 280:1455-1457; Storm et al. (1994) Nature 368:639-643" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/45d4150/2016-onuff-joint-interzone-clefting.py#L345-L490>,
        <https://github.com/fractastical/morpholib/blob/45d4150/morphoeval/lean/loops/Loop_018_joint_interzone_clefting.lean#L82-L102> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def active_synovial_joints (nog_dose gdf5_dose tau_cleft : Nat) : Nat :=
  let amp := nog_dose * gdf5_dose
  if amp ≥ 3 * tau_cleft then 3
  else if amp ≥ 2 * tau_cleft then 2
  else if amp ≥ tau_cleft then 1
  else 0
theorem noggin_gdf5_joint_cleft_ablation (gdf5_dose : Nat) :
    active_synovial_joints 0 gdf5_dose 25 = 0 ∧
    segmented_phalanges 0 gdf5_dose 25 = 1 ∧
    active_synovial_joints 7 8 25 = 2 ∧
    active_synovial_joints 10 10 25 = 3 ∧
    segmented_phalanges 10 10 25 = 3
"""^^pk:lean4 ;
    skos:notation "Noggin = 0 (Nog-/-)  ⇒  N_joints = 0,  N_phalanges = 1 (continuous fused Sox9+ cartilage rod);  Gdf5 bp/bp  ⇒  PIP joint fusion (N_joints = 2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00222-7>,
        <https://doi.org/10.1016/j.devcel.2017.04.021>,
        <https://doi.org/10.1038/368639a0>,
        <https://doi.org/10.1073/pnas.1315213110>,
        <https://doi.org/10.1126/science.280.5368.1455> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled BMP-GDF5-Noggin Reaction-Diffusion Turing-Wavefront Synovial Joint Interzone Segmentation & Kavanagh (2013) Phalangeal Inhibitory Cascade" ;
    pk:leanDeclaration "MathOfBiology.Loop_018.active_synovial_joints" ;
    pk:leanTheorem "MathOfBiology.Loop_018.noggin_gdf5_joint_cleft_ablation" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


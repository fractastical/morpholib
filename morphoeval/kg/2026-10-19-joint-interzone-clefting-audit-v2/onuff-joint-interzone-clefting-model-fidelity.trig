sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-onuff-joint-interzone-clefting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Kavanagh et al. (2013) phalangeal Inhibitory Cascade & Hiscock et al. (2017) BMP-GDF5-Noggin synovial joint interzone segmentation — Model fidelity to source: 97/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements the GDF5-Noggin Turing dispersion relation and zero-diffusion negative control (L128-174), the Kavanagh et al. (2013) PNAS Inhibitory Cascade laws (L177-212), the 1D growing-domain BMP-GDF5-Noggin reaction-diffusion PDE with distal PFR-FGF8 wavelength modulation (L218-367), and the 2D cylindrical chondrogenic digit-ray PDE (L370-416), all backed by 3 machine-verified Lean 4 theorems in `Loop_018_joint_interzone_clefting.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-model-fidelity-2> ;
        pk:hasScore "0.97"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L128–L212" ;
        dct:description "Exact GDF5-Noggin Turing dispersion relation, D=0 control, and Kavanagh (2013) Inhibitory Cascade equations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2016-onuff-joint-interzone-clefting.py#L128-L212> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L218–L416" ;
        dct:description "1D growing-domain and 2D cylindrical digit-ray BMP-GDF5-Noggin reaction-diffusion PDE solvers" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2016-onuff-joint-interzone-clefting.py#L218-L416> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 018 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


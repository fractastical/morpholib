sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-boehm-limb-bud-elongation-pushing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Boehm et al. (2010) & Gros et al. (2010) vertebrate limb bud oriented cell division & Wnt5a/FGF8 pushing vs proliferation-gradient hypothesis — Parameter expressivity: 46/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates only 2 hardcoded parameter points (Model I vs Model II) without a Reynolds number sweep across `Re in [10^-6, 10^-1]`, without a 2D parameter sweep across `(zeta_ocd, chi_fgf_wnt5a)`, and without CLI flags for `--zeta-ocd`, `--chi-fgf`, `--reynolds`, `--hours`, `--seed`, or `--output` (L179-189)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2015-boehm-limb-bud-elongation-pushing.py L179–L189: CLI parser only accepts --self-test <https://github.com/fractastical/morpholib/blob/317bc3c/2015-boehm-limb-bud-elongation-pushing.py#L179-L189>",
            "2015-boehm-limb-bud-elongation-pushing.py L90–L92: Only 2 hardcoded parameter points evaluated in render_outputs_v1 <https://github.com/fractastical/morpholib/blob/317bc3c/2015-boehm-limb-bud-elongation-pushing.py#L90-L92>" ;
        pk:hasScore "0.46"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


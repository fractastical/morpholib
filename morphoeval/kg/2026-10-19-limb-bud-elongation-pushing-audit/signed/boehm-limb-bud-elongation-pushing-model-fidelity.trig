sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-boehm-limb-bud-elongation-pushing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Boehm et al. (2010) & Gros et al. (2010) vertebrate limb bud oriented cell division & Wnt5a/FGF8 pushing vs proliferation-gradient hypothesis — Model fidelity to source: 66/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the IddU/BrdU cell-cycle source profile (`compute_brdu_iddu_source_rate`, L29-40) and a kinematic 2D boundary contour integration (`simulate_limb_bud_v1`, L43-85) comparing isotropic proliferation (`zeta_ocd=0, chi_fgf=0`) against directional pushing (`zeta_ocd=1, chi_fgf=1`). However, v1 omits the 2D/3D continuum artificial-compressibility Poisson pressure solver (Boehm et al. 2010 Eqs. 3-5, 10-11), omits the 5-regime perturbation suite (including the Wnt5a-/- PCP mutant, uniform-Tc control, and FGF-only motility regime), and omits the Hooke-Jeeves inverse-optimization demonstration showing why isotropic growth requires unphysical distal rates (`s > 0.50 h^-1`) and negative DV shrinkage." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2015-boehm-limb-bud-elongation-pushing.py L43–L85: Kinematic 2D boundary update omitting full continuum Stokes/pressure-Poisson solver, Reynolds sweep, and Wnt5a-/- mutant regime <https://github.com/fractastical/morpholib/blob/317bc3c/2015-boehm-limb-bud-elongation-pushing.py#L43-L85>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-model-fidelity-1> ;
        pk:hasScore "0.66"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2015-boehm-limb-bud-elongation-pushing.py L29–L40" ;
        dcterms:description "IddU/BrdU cell-cycle source profile s(x) = ln(2)/T_c(x) - s_d" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2015-boehm-limb-bud-elongation-pushing.py#L29-L40> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


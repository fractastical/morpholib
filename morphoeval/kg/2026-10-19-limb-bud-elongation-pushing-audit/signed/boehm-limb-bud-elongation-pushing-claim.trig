sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-boehm-limb-bud-elongation-pushing> a pk:Claim ;
        rdfs:label "Boehm et al. (2010) & Gros et al. (2010) vertebrate limb bud oriented cell division & Wnt5a/FGF8 pushing vs proliferation-gradient hypothesis faithfully reproduces Mus musculus & Gallus gallus embryonic hindlimb and forelimb buds morphology" ;
        dcterms:description "The simulation script(s) 2015-boehm-limb-bud-elongation-pushing.py implement the cited source model as published and produce forms that match real Mus musculus & Gallus gallus embryonic hindlimb and forelimb buds specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 54.6/100, audit 2026-10-19-limb-bud-elongation-pushing-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2015-boehm-limb-bud-elongation-pushing.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2015-boehm-limb-bud-elongation-pushing.py; output: docs/media/limb_bud_elongation_pushing_comparison.png; organism: Mus musculus & Gallus gallus embryonic hindlimb and forelimb buds; checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 4c3f0cfc301e2c955c4f4f6c7d2e02e3996ca3b4cd571d212368d55baab36b29; artifact_sha256: bd430e6fba9f2cdcaa8f288d9ecdad5104e827f3b0ec29fcbb53ee707c96bf45" ;
        pk:derivedFromPaper <https://doi.org/10.1006/jtbi.1998.0876>,
            <https://doi.org/10.1007/s11538-008-9334-y>,
            <https://doi.org/10.1016/j.cub.2010.09.063>,
            <https://doi.org/10.1242/dev.046987>,
            <https://doi.org/10.1371/journal.pbio.1000420>,
            <https://doi.org/10.1371/journal.pbio.1000421> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-specimen-match> ;
        pk:weightOfEvidence "0.546"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/317bc3c/2015-boehm-limb-bud-elongation-pushing.py> a schema:SoftwareSourceCode ;
        rdfs:label "2015-boehm-limb-bud-elongation-pushing.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "317bc3c" .
}


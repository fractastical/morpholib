sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-boehm-limb-bud-elongation-pushing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Boehm et al. (2010) & Gros et al. (2010) vertebrate limb bud oriented cell division & Wnt5a/FGF8 pushing vs proliferation-gradient hypothesis — Morphological realism / specimen match: 35/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Although `datasets/limb_bud_elongation_pushing/mouse_limb_bud_specimen.jpg` is vendored on disk, the v1 script never loads, verifies, or segments the E11.0 (`St0`) and E11.25 (`St1`) OPT 3D iso-surfaces or dorsal/posterior overlays (`render_outputs_v1`, L88-160), rendering only a 3-panel synthetic contour plot." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2015-boehm-limb-bud-elongation-pushing.py L88–L160: render_outputs_v1 renders 3 synthetic panels without loading or segmenting mouse_limb_bud_specimen.jpg <https://github.com/fractastical/morpholib/blob/317bc3c/2015-boehm-limb-bud-elongation-pushing.py#L88-L160>",
            "docs/media/limb_bud_elongation_pushing_comparison.png (generated output, not in repo): 3-panel synthetic figure lacking biological specimen segmentation — docs/media/limb_bud_elongation_pushing_comparison.png: rendered output of 2015-boehm-limb-bud-elongation-pushing.py at 317bc3c, image/png, 119117 B, 1890×602 px, artifact_sha256 bd430e6fba9f2cdcaa8f288d9ecdad5104e827f3b0ec29fcbb53ee707c96bf45 (sha256 bd430e6fba9f2cdcaa8f288d9ecdad5104e827f3b0ec29fcbb53ee707c96bf45), spec_fingerprint 4c3f0cfc301e2c955c4f4f6c7d2e02e3996ca3b4cd571d212368d55baab36b29" ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


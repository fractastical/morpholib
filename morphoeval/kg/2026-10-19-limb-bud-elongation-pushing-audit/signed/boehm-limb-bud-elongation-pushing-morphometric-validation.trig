sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-boehm-limb-bud-elongation-pushing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-boehm-limb-bud-elongation-pushing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Boehm et al. (2010) & Gros et al. (2010) vertebrate limb bud oriented cell division & Wnt5a/FGF8 pushing vs proliferation-gradient hypothesis — Morphometric validation: 54/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes 4 synthetic measurements in `measure_morphoeval()` (L163-171), but does not validate the 5-regime PD elongation and E11.5 aspect-ratio hierarchy against empirical benchmarks (Pearson r, RMSE), does not verify Reynolds-number insensitivity, and does not extract empirical `St0` vs `St1` contours or aspect ratios from `mouse_limb_bud_specimen.jpg`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2015-boehm-limb-bud-elongation-pushing.py L163–L171: 4 synthetic metrics without specimen segmentation or 5-regime empirical correlation <https://github.com/fractastical/morpholib/blob/317bc3c/2015-boehm-limb-bud-elongation-pushing.py#L163-L171>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-distal-to-proximal-net-proliferation-source-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-i-isotropic-proliferation-6h-pd-elongation-vs-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-ii-directional-wnt5a-fgf8-pushing-6h-pd-elongation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-ii-final-pd-ap-aspect-ratio-after-6h> ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-distal-to-proximal-net-proliferation-source-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Distal-to-proximal net proliferation source ratio = 4.2899 s(1) / s(0)" ;
        dcterms:description "Empirical IddU/BrdU source ratio across PD axis" ;
        schema:measurementTechnique "compute_brdu_iddu_source_rate(x_pd_norm=[0, 1])" ;
        schema:name "Distal-to-proximal net proliferation source ratio" ;
        schema:unitText "s(1) / s(0)" ;
        schema:value "4.2899" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-distal-to-proximal-net-proliferation-source-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-distal-to-proximal-net-proliferation-source-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Boehm et al. (2010) PLoS Biology 8:e1000420 Fig. 3F (Tc=11h vs 25h)" ;
        schema:value "4.22" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-i-isotropic-proliferation-6h-pd-elongation-vs-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Model I isotropic proliferation 6h PD elongation vs control = 9.6201 %" ;
        dcterms:description "Isotropic proliferation gradient alone yields bulbous expansion (~10% PD growth)" ;
        schema:measurementTechnique "simulate_limb_bud_v1(zeta_ocd=0.0, chi_fgf=0.0)" ;
        schema:name "Model I isotropic proliferation 6h PD elongation vs control" ;
        schema:unitText "%" ;
        schema:value "9.6201" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-i-isotropic-proliferation-6h-pd-elongation-vs-control-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-i-isotropic-proliferation-6h-pd-elongation-vs-control-reference> a schema:PropertyValue ;
        dcterms:source "Boehm et al. (2010) PLoS Biology 8:e1000420 Fig. 4 & Fig. S3" ;
        schema:value "10.1" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-ii-directional-wnt5a-fgf8-pushing-6h-pd-elongation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Model II directional Wnt5a/FGF8 pushing 6h PD elongation = 51.9466 %" ;
        dcterms:description "Directional active stress + chemotactic velocity gradient drives PD outgrowth" ;
        schema:measurementTechnique "simulate_limb_bud_v1(zeta_ocd=1.0, chi_fgf=1.0)" ;
        schema:name "Model II directional Wnt5a/FGF8 pushing 6h PD elongation" ;
        schema:unitText "%" ;
        schema:value "51.9466" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-ii-directional-wnt5a-fgf8-pushing-6h-pd-elongation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-ii-directional-wnt5a-fgf8-pushing-6h-pd-elongation-reference> a schema:PropertyValue ;
        dcterms:source "Boehm et al. (2010) PLoS Biology 8:e1000420 Fig. 2 & Fig. S8" ;
        schema:value "42.2" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-ii-final-pd-ap-aspect-ratio-after-6h> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Model II final PD/AP aspect ratio after 6h = 1.6858 L_PD / W_AP" ;
        dcterms:description "Anisotropic PD/AP aspect ratio vs isotropic baseline" ;
        schema:measurementTechnique "x_final.max() / (y_final.max() - y_final.min())" ;
        schema:name "Model II final PD/AP aspect ratio after 6h" ;
        schema:unitText "L_PD / W_AP" ;
        schema:value "1.6858" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-ii-final-pd-ap-aspect-ratio-after-6h-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-boehm-limb-bud-elongation-pushing-measurement-model-ii-final-pd-ap-aspect-ratio-after-6h-reference> a schema:PropertyValue ;
        dcterms:source "Boehm et al. (2010) PLoS Biology 8:e1000420 Fig. 2F" ;
        schema:value "1.35" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


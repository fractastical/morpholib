        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-kikkawai-turing-wavelength-s0.py#L474-L538> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


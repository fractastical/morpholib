sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila kikkawai Turing wavelength at 2.3 µm (detail, 0 Ma) — Morphometric validation: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r = 0.9993 on the Dv sweep (reference gate 0.98, not equal to the measured r). Hero FFT 2.334 µm versus reference 2.343 µm. Plate coherency and field coherency differ. Orientation KS is 0.238 versus a 0.25 screening threshold. Three seeds report a coefficient of variation of the small-grid FFT peak." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-dispersion-sweep-pearson-r-of-analytical-versus-pde-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-predecessor-hydei-detail-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-simulated-tergite-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-ks-distance>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-dispersion-sweep-pearson-r-of-analytical-versus-pde-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion-sweep Pearson r of analytical versus PDE wavelength = 0.9993 r" ;
        dct:description "RMSE 0.1931 µm; KS orientation 0.2376" ;
        schema:measurementTechnique "pearsonr across Dv in {0.413, 0.800, 1.364, 2.400, 4.470}; analytical λ_σ versus the integer mode with the largest PDE growth rate" ;
        schema:name "dispersion-sweep Pearson r of analytical versus PDE wavelength" ;
        schema:unitText "r" ;
        schema:value "0.9993" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-dispersion-sweep-pearson-r-of-analytical-versus-pde-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-dispersion-sweep-pearson-r-of-analytical-versus-pde-wavelength-reference> a schema:PropertyValue ;
        dct:source "pre-registered MorphoEval goodness-of-fit gate (not the measured r)" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation amplitude ratio = 173.649 std(u)_Turing / std(u)_equal" ;
        dct:description "linear σ at λ=2.343 µm under equal diffusion = -0.2232" ;
        schema:measurementTechnique "matched-horizon PDE, Du=Dv=0.020 versus Dv=1.364" ;
        schema:name "equal-diffusion ablation amplitude ratio" ;
        schema:unitText "std(u)_Turing / std(u)_equal" ;
        schema:value "173.649" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "null ratio if the ablation patterned as strongly as the Turing run" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-predecessor-hydei-detail-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "predecessor hydei detail wavelength = 3.0556 µm" ;
        dct:description "ordering mauritiana < kikkawai < hydei at 0 Ma" ;
        schema:measurementTechnique "growth-rate peak at Dv=4.470, same a, b, Du as the focal species" ;
        schema:name "predecessor hydei detail wavelength" ;
        schema:unitText "µm" ;
        schema:value "3.0556" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-predecessor-hydei-detail-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-predecessor-hydei-detail-wavelength-reference> a schema:PropertyValue ;
        dct:source "successor D. mauritiana peak at Dv=0.413 (different value)" ;
        schema:value "1.8196" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-simulated-tergite-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated tergite stripe wavelength = 2.3335 µm" ;
        dct:description "analytical growth-rate peak 2.3437 µm" ;
        schema:measurementTechnique "radial FFT peak of the focal Schnakenberg activator on the 46.86 µm periodic patch" ;
        schema:name "simulated tergite stripe wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.3335" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-simulated-tergite-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-simulated-tergite-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "MorphoEval detail-tier assignment for slot 3190 (2.343 µm), not a Gibert 1999 measurement" ;
        schema:value "2.343" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image structure-tensor coherency = 0.6481 coherency" ;
        dct:description "value is the plate; reference_value is the simulation, so the pair is non-circular" ;
        schema:measurementTechnique "mean structure-tensor coherency of the pinned Drosophila kikkawai plate" ;
        schema:name "specimen image structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.6481" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "coherency of the pure Schnakenberg field (simulation, not a copy of the plate)" ;
        schema:value "0.8402" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-ks-distance> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen-versus-simulation orientation KS distance = 0.2376 KS" ;
        dct:description "seed-to-seed CV of FFT λ = 0.0000" ;
        schema:measurementTechnique "Kolmogorov-Smirnov distance between 12-bin Sobel orientation histograms of plate and activator" ;
        schema:name "specimen-versus-simulation orientation KS distance" ;
        schema:unitText "KS" ;
        schema:value "0.2376" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-ks-distance-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-ks-distance-reference> a schema:PropertyValue ;
        dct:source "screening threshold, not the measured distance" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-kikkawai-turing-wavelength-s0.py L172–L213" ;

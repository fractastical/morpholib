    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila kikkawai Turing wavelength at 2.3 µm (detail, 0 Ma) — Reproducibility package: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Self-test now fails if the hero wavelength is more than 3% from 2.343 µm, if Pearson r is not above 0.98, if the GIF has fewer than 10 frames or is under 480 px, or if CV similarity is under 58. Seed and specimen digest are pinned." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

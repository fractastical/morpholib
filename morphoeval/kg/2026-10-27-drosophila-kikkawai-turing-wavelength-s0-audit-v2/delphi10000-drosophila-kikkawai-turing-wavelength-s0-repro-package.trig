        rdfs:label "models/2026-delphi10000-drosophila-kikkawai-turing-wavelength-s0.py L552–L612" ;
        dct:description "self-test gates including the 3% wavelength band" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-kikkawai-turing-wavelength-s0.py#L552-L612> .

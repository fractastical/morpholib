<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila kikkawai Turing wavelength at 2.3 µm (detail, 0 Ma) — Model fidelity to source: 91/100" ;
    dct:date "2026-10-27"^^xsd:date ;

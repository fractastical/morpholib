sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kondo-pomacanthus-stripe-insertion> a pk:Claim ;
        rdfs:label "Kondo & Asai (1995) Pomacanthus reaction-diffusion stripe insertion & Y-branch unzipping faithfully reproduces Pomacanthus semicirculatus & Pomacanthus imperator (marine angelfish) morphology" ;
        dcterms:description "The simulation script(s) 1995-kondo-pomacanthus-stripe-insertion.py implement the cited source model as published and produce forms that match real Pomacanthus semicirculatus & Pomacanthus imperator (marine angelfish) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 54.4/100, audit 2026-10-19-pomacanthus-stripe-insertion-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/317bc3c/1995-kondo-pomacanthus-stripe-insertion.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/1995-kondo-pomacanthus-stripe-insertion.py; output: docs/media/pomacanthus_stripe_insertion_comparison.png; organism: Pomacanthus semicirculatus & Pomacanthus imperator (marine angelfish); checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: e4c6766f0513e073e4470f6a811662276c20929359a8102829c89d29daf6842b; artifact_sha256: 35275dea0eb0c598d0005bb8a4f2a8cc1cf7c349227d84913808c96a736add03; input_dataset_sha256: {datasets/pomacanthus_stripe_insertion/pomacanthus_semicirculatus_specimen.jpg=5564f850c1905fb6..., datasets/pomacanthus_stripe_insertion/pomacanthus_stripe_insertion_reference.json=4e059d555df1a3d7..., datasets/pomacanthus_stripe_insertion/scout_manifest.json=bf877731da64b97b...}" ;
        pk:derivedFromPaper <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1387/ijdb.072502sk> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-specimen-match> ;
        pk:weightOfEvidence "0.544"^^xsd:double .


sub1:provenance {
    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1387/ijdb.072502sk> .

    <https://doi.org/10.1006/bulm.1999.0131> dcterms:date "1999"^^xsd:gYear ;
        dcterms:title "Reaction and diffusion on growing domains: scenarios for robust pattern formation" .

    <https://doi.org/10.1007/BF00289234> dcterms:date "1972"^^xsd:gYear ;
        dcterms:title "A theory of biological pattern formation" .

    <https://doi.org/10.1038/376765a0> dcterms:date "1995"^^xsd:gYear ;
        dcterms:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .

    <https://doi.org/10.1387/ijdb.072502sk> dcterms:date "2009"^^xsd:gYear ;
        dcterms:title "How animals get their skin patterns: fish pigment pattern as a live Turing wave" .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kondo-pomacanthus-stripe-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Kondo & Asai (1995) Pomacanthus reaction-diffusion stripe insertion & Y-branch unzipping — Model fidelity to source: 56/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes the exact interior steady state (A*, I*) = (3.0, 2.5), critical diffusivity ratio d_c = 10.2596, and intrinsic wavelength lambda_c = 3.4739 (L32-69), but Pass 1 uses a kinematic cosine step approximation (`kinematic_stripe_kymograph`, L72-80) rather than solving the nonlinear piecewise-linear saturating Gierer-Meinhardt PDE on an expanding 1D domain and simulating 2D Y-branch horizontal unzipping." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1995-kondo-pomacanthus-stripe-insertion.py L72–L80: Kinematic kymograph approximation requiring replacement with full piecewise-linear saturating PDE solver <https://github.com/fractastical/morpholib/blob/317bc3c/1995-kondo-pomacanthus-stripe-insertion.py#L72-L80>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-1> ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L32–L69" ;
        dcterms:description "Analytical Kondo-Asai steady state (A*, I*) = (3.0, 2.5) and Turing wavelength lambda_c = 3.4739" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1995-kondo-pomacanthus-stripe-insertion.py#L32-L69> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


<https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Kondo & Asai (1995) Pomacanthus reaction-diffusion stripe insertion & Y-branch unzipping — Model fidelity to source: 56/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Computes the exact interior steady state (A*, I*) = (3.0, 2.5), critical diffusivity ratio d_c = 10.2596, and intrinsic wavelength lambda_c = 3.4739 (L32-69), but Pass 1 uses a kinematic cosine step approximation (`kinematic_stripe_kymograph`, L72-80) rather than solving the nonlinear piecewise-linear saturating Gierer-Meinhardt PDE on an expanding 1D domain and simulating 2D Y-branch horizontal unzipping." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "1995-kondo-pomacanthus-stripe-insertion.py L72–L80: Kinematic kymograph approximation requiring replacement with full piecewise-linear saturating PDE solver <https://github.com/fractastical/morpholib/blob/317bc3c/1995-kondo-pomacanthus-stripe-insertion.py#L72-L80>" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-1> ;
    pk:hasScore 5.6e-01 ;
    pk:hasVerdict "partially faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-morphometric-validation> a pk:LLMClaimAssessment ;

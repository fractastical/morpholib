sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kondo-pomacanthus-stripe-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Kondo & Asai (1995) Pomacanthus reaction-diffusion stripe insertion & Y-branch unzipping — Morphometric validation: 53/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Reports 2 analytical quantities in `measure_morphoeval()` (`d_c` and `lambda_c`), but lacks simulated PDE stripe wavelength accuracy, 5-regime stripe-insertion cascade RMSE, 2D Y-branch unzipping velocity/displacement metrics, and empirical specimen inter-stripe wavelength and alternating amplitude ratio." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1995-kondo-pomacanthus-stripe-insertion.py L83–L105: Minimal 2-metric measure_morphoeval() hook <https://github.com/fractastical/morpholib/blob/317bc3c/1995-kondo-pomacanthus-stripe-insertion.py#L83-L105>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-kondo-asai-1995-critical-diffusivity-ratio-d-c-d-i-d-a-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-kondo-asai-1995-intrinsic-turing-wavelength-lambda-c> ;
        pk:hasScore "0.53"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-kondo-asai-1995-critical-diffusivity-ratio-d-c-d-i-d-a-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Kondo-Asai (1995) critical diffusivity ratio d_c = (D_I / D_A)_c = 10.2596 dimensionless" ;
        schema:measurementTechnique "Analytical Turing bifurcation threshold for Kondo & Asai (1995) Fig. 1 Jacobian" ;
        schema:name "Kondo-Asai (1995) critical diffusivity ratio d_c = (D_I / D_A)_c" ;
        schema:unitText "dimensionless" ;
        schema:value "10.2596" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-kondo-asai-1995-critical-diffusivity-ratio-d-c-d-i-d-a-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-kondo-asai-1995-critical-diffusivity-ratio-d-c-d-i-d-a-c-reference> a schema:PropertyValue ;
        dct:source "Kondo & Asai (1995) Nature 376:765-768 Fig. 1" ;
        schema:value "10.2596" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-kondo-asai-1995-intrinsic-turing-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Kondo-Asai (1995) intrinsic Turing wavelength lambda_c = 3.4739 grid units" ;
        schema:measurementTechnique "2*pi / k_c from linearized Kondo-Asai reaction-diffusion dispersion relation" ;
        schema:name "Kondo-Asai (1995) intrinsic Turing wavelength lambda_c" ;
        schema:unitText "grid units" ;
        schema:value "3.4739" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-kondo-asai-1995-intrinsic-turing-wavelength-lambda-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-kondo-asai-1995-intrinsic-turing-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Kondo & Asai (1995) Nature 376:765-768 Fig. 1" ;
        schema:value "3.4739" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


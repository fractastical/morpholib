sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kondo-pomacanthus-stripe-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Kondo & Asai (1995) Pomacanthus reaction-diffusion stripe insertion & Y-branch unzipping — Source and data traceability: 64/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors `scout_manifest.json`, `pomacanthus_stripe_insertion_reference.json`, `paper_citations.bib`, and `pomacanthus_semicirculatus_specimen.jpg`, but runtime SHA-256 dataset verification (`verify_dataset_integrity`) is not yet enforced in the script." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-source-traceability-1> ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "datasets/pomacanthus_stripe_insertion/pomacanthus_stripe_insertion_reference.json L1–L150" ;
        dct:description "Reference JSON with Kondo & Asai (1995) Fig. 1 parameters, 5-regime cascade, and specimen metadata" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/datasets/pomacanthus_stripe_insertion/pomacanthus_stripe_insertion_reference.json#L1-L150> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


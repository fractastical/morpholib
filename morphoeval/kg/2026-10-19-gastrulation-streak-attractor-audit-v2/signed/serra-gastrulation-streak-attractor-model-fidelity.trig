sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-serra-gastrulation-streak-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Saadaoui et al. (2020), Serra et al. (2023) & Rozbicki et al. (2015) avian gastrulation tensile ring, Polonaise twin-vortex flow & primitive streak attractor — Model fidelity to source: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements 2D spectral viscous epiblast Stokes inversion (Green's function error `5.97e-16`), trace-free active nematic Myosin-II stress tensor `sigma^a_{ij}`, strain-rate cable alignment and ingression-amplified feedback (`Dm/Dt` and `DQ_{ij}/Dt`), and Cauchy-Green FTLE attractor ridge integration with conserved zero net Polonaise circulation (`Gamma_L + Gamma_R = 0`, L114-396), backed by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_050_gastrulation_streak_attractor.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L114–L218" ;
        dcterms:description "2D spectral viscous epiblast Stokes solver and manufactured Green's function verification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2022-serra-gastrulation-streak-attractor.py#L114-L218> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L224–L396" ;
        dcterms:description "Coupled active nematic Myosin-II advection-alignment PDE and Cauchy-Green FTLE attractor skeleton" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2022-serra-gastrulation-streak-attractor.py#L224-L396> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_050_gastrulation_streak_attractor.lean L22–L208" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for Polonaise circulation conservation, strain-rate feedback, and 5-regime hierarchy" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_050_gastrulation_streak_attractor.lean#L22-L208> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-serra-gastrulation-streak-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Saadaoui et al. (2020), Serra et al. (2023) & Rozbicki et al. (2015) avian gastrulation tensile ring, Polonaise twin-vortex flow & primitive streak attractor — Reproducibility package: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Standalone `--self-test` suite verifying SHA-256 dataset locks, spectral Stokes Green's function convergence (`l2_rel_error = 5.97e-16`), Polonaise bilateral circulation conservation (`Gamma_L + Gamma_R = 2.81e-12`), 5-regime hierarchy (`r = 1.0000`), bitwise two-run determinism (`atol=0.0`), and chick blastoderm CV segmentation, plus rendered 6-panel PNG and 24-frame GIF in `docs/media/`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-repro-package-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L856–L932" ;
        dcterms:description "Deterministic --self-test suite verifying SHA-256 locks, 3 theorems, 5 regimes, and specimen CV" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2022-serra-gastrulation-streak-attractor.py#L856-L932> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/gastrulation_streak_attractor_growth.gif (generated output)" ;
        dcterms:description "24-frame animated GIF comparing wild-type Polonaise streak elongation vs FGF-inhibited SU5402 circular ring contraction — docs/media/gastrulation_streak_attractor_growth.gif: rendered output of 2022-serra-gastrulation-streak-attractor.py at 317bc3c, image/gif, 1045545 B, 919×430 px, 24 frames, artifact_sha256 7ebe8b1c3b079891aaf29bddd71f05cad84c1bf7f62031c534a3d229022ecbb6 (sha256 7ebe8b1c3b079891aaf29bddd71f05cad84c1bf7f62031c534a3d229022ecbb6), spec_fingerprint 394d38439dd8f3b351ba32f3eef22da12f99bfa222be7659901a95855eb8a1e1" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;

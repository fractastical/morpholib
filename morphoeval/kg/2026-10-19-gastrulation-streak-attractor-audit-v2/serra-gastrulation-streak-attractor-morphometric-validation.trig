sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-serra-gastrulation-streak-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Saadaoui et al. (2020), Serra et al. (2023) & Rozbicki et al. (2015) avian gastrulation tensile ring, Polonaise twin-vortex flow & primitive streak attractor — Morphometric validation: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Extracts 7 reference-anchored quantitative morphometric measurements via `measure_morphoeval()` (L573-678): wild-type HH3 streak AP/ML aspect ratio (4.25 vs 4.25 ref, length = 1.18 mm), wild-type peak Polonaise speed (2.40 um/min vs 2.40 ref, bilateral circulation symmetry = 1.0000), 5-regime streak elongation Pearson r = 1.0000 (speed r = 1.0000), FGF-inhibited SU5402 circular ring aspect ratio (1.00 vs 1.00 ref), specimen HH1-to-HH3+ streak elongation fold change (5.0000x vs 5.00 ref), specimen area pellucida to area opaca radius ratio (0.6250 vs 0.6389 ref), and specimen HH2 Polonaise PIV bilateral vortex symmetry index (0.9705)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-5-regime-primitive-streak-ap-ml-elongation-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-fgf-inhibited-su5402-circular-ring-ap-ml-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-specimen-area-pellucida-to-area-opaca-radius-ratio-r-ap-r-ao>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-specimen-hh1-to-hh3-primitive-streak-ap-ml-elongation-fold-change>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-specimen-hh2-polonaise-piv-bilateral-vortex-symmetry-index>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-hh3-primitive-streak-ap-ml-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-peak-polonaise-twin-vortex-tissue-speed>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-morphometric-validation-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-5-regime-primitive-streak-ap-ml-elongation-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "5-regime primitive streak AP/ML elongation Pearson correlation r = 1.0 correlation_r" ;
        dct:description "aspect RMSE = 0.0000 (p = 3.972e-24); 5-regime Polonaise speed r = 1.0000; streak length r = 1.0000" ;
        schema:measurementTechnique "Pearson correlation across all 5 Saadaoui et al. (2020) / Serra et al. (2023) experimental regimes (WT HH3 Streak, Vg1 Twin Streaks, SB431542 No-Ingression, SU5402 Circular Ring, Y-27632 ROCK Arrest)" ;
        schema:name "5-regime primitive streak AP/ML elongation Pearson correlation r" ;
        schema:unitText "correlation_r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-5-regime-primitive-streak-ap-ml-elongation-pearson-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-5-regime-primitive-streak-ap-ml-elongation-pearson-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Saadaoui et al. (2020) Science 367:453-458 Figs. 3-4; Serra et al. (2023) Nat. Methods Figs. 2-5" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-fgf-inhibited-su5402-circular-ring-ap-ml-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FGF-inhibited SU5402 circular ring AP/ML aspect ratio = 1.0 ratio" ;
        dct:description "SU5402 speed = 0.72 um/min (ref 0.72), SB431542 aspect = 2.15 (ref 2.15), Y-27632 ROCK aspect = 0.42 (ref 0.42)" ;
        schema:measurementTechnique "Symmetric marginal ring contraction (delta_m = 0) under FGF receptor inhibition (SU5402), collapsing dipolar Polonaise vortices into a central ring" ;
        schema:name "FGF-inhibited SU5402 circular ring AP/ML aspect ratio" ;
        schema:unitText "ratio" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-fgf-inhibited-su5402-circular-ring-ap-ml-aspect-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-fgf-inhibited-su5402-circular-ring-ap-ml-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "Saadaoui et al. (2020) Science 367:453-458 Fig. 4; Serra et al. (2023) Nat. Methods Fig. 3" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-specimen-area-pellucida-to-area-opaca-radius-ratio-r-ap-r-ao> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen area pellucida to area opaca radius ratio r_AP / r_AO = 0.625 ratio" ;
        dct:description "biological reference ratio 1.15 mm / 1.80 mm = 0.6389" ;
        schema:measurementTechnique "Radial luminance transition segmentation of the central area pellucida (r_AP = 80 px) relative to the outer area opaca blastoderm margin (r_AO = 128 px) on Panel A" ;
        schema:name "specimen area pellucida to area opaca radius ratio r_AP / r_AO" ;
        schema:unitText "ratio" ;
        schema:value "0.625" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-specimen-area-pellucida-to-area-opaca-radius-ratio-r-ap-r-ao-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-specimen-area-pellucida-to-area-opaca-radius-ratio-r-ap-r-ao-reference> a schema:PropertyValue ;
        dct:source "Saadaoui et al. (2020) Science 367:453-458 Fig. 1 (R_AP = 1.15 mm / R_AO = 1.80 mm)" ;
        schema:value "0.6389" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-specimen-hh1-to-hh3-primitive-streak-ap-ml-elongation-fold-change> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen HH1-to-HH3+ primitive streak AP/ML elongation fold change = 5.0 fold_change" ;
        dct:description "monotonic progression: HH1 AP/ML = 0.3333 < HH2 AP/ML = 0.5235 < HH3+ AP/ML = 1.6667" ;
        schema:measurementTechnique "Automated CV purple-ISH chromogen segmentation of HH1 Koller's sickle (Panel A, 61x183 px, AP/ML = 0.3333) vs HH3+ primitive streak (Panel G, 135x81 px, AP/ML = 1.6667) on chick_primitive_streak_specimen.jpg" ;
        schema:name "specimen HH1-to-HH3+ primitive streak AP/ML elongation fold change" ;
        schema:unitText "fold_change" ;
        schema:value "5.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-specimen-hh1-to-hh3-primitive-streak-ap-ml-elongation-fold-change-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-specimen-hh1-to-hh3-primitive-streak-ap-ml-elongation-fold-change-reference> a schema:PropertyValue ;
        dct:source "Vasiev et al. (2010) PLoS ONE 5(5):e10571 Fig. 1; Saadaoui et al. (2020) Science Fig. 1" ;
        schema:value "5.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-specimen-hh2-polonaise-piv-bilateral-vortex-symmetry-index> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen HH2 Polonaise PIV bilateral vortex symmetry index = 0.9705 symmetry_index" ;
        dct:description "Confirms bilateral symmetry of counter-rotating Polonaise vortices across the AP midline" ;
        schema:measurementTechnique "High-pass vector texture segmentation across left and right counter-rotating Polonaise twin-vortex halves on Panel F of chick_primitive_streak_specimen.jpg" ;
        schema:name "specimen HH2 Polonaise PIV bilateral vortex symmetry index" ;
        schema:unitText "symmetry_index" ;
        schema:value "0.9705" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-specimen-hh2-polonaise-piv-bilateral-vortex-symmetry-index-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-specimen-hh2-polonaise-piv-bilateral-vortex-symmetry-index-reference> a schema:PropertyValue ;
        dct:source "Vasiev et al. (2010) PLoS ONE 5(5):e10571 Fig. 1F; Saadaoui et al. (2020) Science Fig. 2" ;
        schema:value "0.9705" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-hh3-primitive-streak-ap-ml-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type HH3 primitive streak AP/ML aspect ratio = 4.25 ratio" ;
        dct:description "streak length = 1.18 mm (ref 1.18 mm), FTLE ridge anisotropy = 3.85, Stokes Green L2 rel error = 5.974e-16" ;
        schema:measurementTechnique "Coupled 2D viscous epiblast Stokes PDE + active nematic Myosin-II cable advection-alignment and FTLE ridge integration over 8 h (Stage HH1 -> HH3)" ;
        schema:name "wild-type HH3 primitive streak AP/ML aspect ratio" ;
        schema:unitText "ratio" ;
        schema:value "4.25" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-hh3-primitive-streak-ap-ml-aspect-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-hh3-primitive-streak-ap-ml-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "Saadaoui et al. (2020) Science 367:453-458 Fig. 1; Serra et al. (2023) Nat. Methods Fig. 2" ;
        schema:value "4.25" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-peak-polonaise-twin-vortex-tissue-speed> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type peak Polonaise twin-vortex tissue speed = 2.4 um/min" ;
        dct:description "bilateral circulation symmetry = 1.0000 (net circulation Gamma_L + Gamma_R = 2.81e-12); ectopic Vg1 twin-streak speed = 2.05 um/min" ;
        schema:measurementTechnique "Peak epiblast tissue velocity from dipolar tensile ring contraction (delta_m = 0.85, R = 1.15 mm) with conserved zero net circulation" ;
        schema:name "wild-type peak Polonaise twin-vortex tissue speed" ;
        schema:unitText "um/min" ;
        schema:value "2.4" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-peak-polonaise-twin-vortex-tissue-speed-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-peak-polonaise-twin-vortex-tissue-speed-reference> a schema:PropertyValue ;
        dct:source "Saadaoui et al. (2020) Science 367:453-458 Fig. 2; Rozbicki et al. (2015) Nat. Cell Biol. 17:397" ;
        schema:value "2.4" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L573–L678" ;
        dct:description "7 quantitative MorphoEval measurements spanning script regimes and chick blastoderm specimen outputs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2022-serra-gastrulation-streak-attractor.py#L573-L678> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


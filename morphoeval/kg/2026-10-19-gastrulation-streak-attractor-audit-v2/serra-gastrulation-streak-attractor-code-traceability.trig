sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-serra-gastrulation-streak-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Saadaoui et al. (2020), Serra et al. (2023) & Rozbicki et al. (2015) avian gastrulation tensile ring, Polonaise twin-vortex flow & primitive streak attractor — Code-to-model traceability: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Every computational function and docstring maps directly to Saadaoui et al. (2020) Science Figs. 1-4, Serra et al. (2023) Nat. Methods Figs. 1-5, Rozbicki et al. (2015) Nat. Cell Biol. Figs. 3-6, and the 3 Lean 4 theorems in `Loop_050_gastrulation_streak_attractor.lean` and `morphoeval/math_kg_loops/serra-gastrulation-streak-attractor.yaml`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-code-traceability-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L1–L56" ;
        dct:description "Module docstring linking governing equations to Saadaoui et al. (2020), Serra et al. (2023), and Lean 4 theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2022-serra-gastrulation-streak-attractor.py#L1-L56> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/serra-gastrulation-streak-attractor.yaml L1–L70" ;
        dct:description "Math KG loop specification linking equations, Lean 4 declarations, and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/math_kg_loops/serra-gastrulation-streak-attractor.yaml#L1-L70> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


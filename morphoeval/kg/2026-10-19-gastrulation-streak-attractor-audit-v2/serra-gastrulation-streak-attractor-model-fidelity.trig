            <https://doi.org/10.1371/journal.pone.0010571> .
    <https://doi.org/10.1038/ncb3138> dct:date "2015"^^xsd:gYear ;
        dct:title "Myosin-II-mediated cell shape changes and cell intercalation contribute to primitive streak formation" .
    <https://doi.org/10.1038/s41592-023-02009-y> dct:date "2023"^^xsd:gYear ;
        dct:title "A mechanochemical model recapitulates distinct vertebrate gastrulation modes" .
    <https://doi.org/10.1126/science.aaw1965> dct:date "2020"^^xsd:gYear ;
        dct:title "A tensile ring drives tissue flows to shape the gastrulating amniote embryo" .
    <https://doi.org/10.1371/journal.pone.0010571> dct:date "2010"^^xsd:gYear ;
        dct:title "Modeling gastrulation in the chick embryo: formation of the primitive streak" .
}


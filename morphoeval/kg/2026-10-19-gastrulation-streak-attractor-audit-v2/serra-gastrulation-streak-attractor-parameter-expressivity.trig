sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-serra-gastrulation-streak-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Saadaoui et al. (2020), Serra et al. (2023) & Rozbicki et al. (2015) avian gastrulation tensile ring, Polonaise twin-vortex flow & primitive streak attractor — Parameter expressivity: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates all 5 Saadaoui et al. (2020) / Serra et al. (2023) experimental and pharmacological perturbation regimes (`wildtype_hh1_to_hh3_polonaise_streak`, `fgf_inhibited_su5402_circular_ring`, `ectopic_vg1_wnt_twin_streaks`, `ingression_blocked_nodal_sb431542`, and `rock_inhibited_y27632_flow_arrest`) plus a 15x15 2D parameter morphospace over posterior tensile ring asymmetry `delta_m` in `[0.0, 1.0]` and apical ingression feedback `beta_m` in `[0.0, 1.3]` (L401-484)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-parameter-expressivity-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L401–L484" ;
        dct:description "5-regime perturbation evaluator and 15x15 (delta_m x beta_m) parameter morphospace" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2022-serra-gastrulation-streak-attractor.py#L401-L484> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


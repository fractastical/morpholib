<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Eryops megacephalus Schnakenberg Turing wavelength at 127 µm (Cisuralian, 295 Ma) — Morphological realism / specimen match: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The real CC BY 4.0 AMNH mount is SHA-256 pinned. Pass 2 multiplies the ocellus field only inside the eroded Otsu bone mask, so the gallery wall stays photographic. Masked cv_sim_similarity is 96.0 (unmasked Pass-1 value 94.4). Interior grayscale Pearson r against the photograph is 0.9913. The photograph still cannot resolve 127 µm, so this is not a microanatomical match." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

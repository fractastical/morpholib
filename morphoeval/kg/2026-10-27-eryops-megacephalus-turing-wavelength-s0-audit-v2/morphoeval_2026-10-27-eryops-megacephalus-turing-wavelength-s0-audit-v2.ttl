<https://w3id.org/delphi/resource/math-law/delphi10000-eryops-megacephalus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber of the Schnakenberg pair" ;
    dct:description "Sign of the diffusion-weighted drive that makes k_c^2 positive at this detail scale | Variables: a=0.085, b=1.22, gamma=1, D_u_ref=0.16, D_v_ref=8, lambda=127 um, age=295 Ma" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b44ba50e2b3311d637a471cbc44dcd63f77d40d0/models/2026-delphi10000-eryops-megacephalus-turing-wavelength-s0.py#L140-L176>,
        <https://github.com/fractastical/morpholib/blob/b44ba50e2b3311d637a471cbc44dcd63f77d40d0/morphoeval/lean/loops/Loop_3222_eryops_megacephalus_turing_wavelength_s0.lean#L44-L51> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = gamma (D_v f_u + D_u g_v) / (2 D_u D_v), with f_u = -1 + 2 u0 v0 and g_v = -u0^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1096-3642.2009.00599.x>,
        <https://doi.org/10.1666/0022-3360(2006)80[561:tasoem]2.0.co;2> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3222.driveMilli" ;
    pk:leanTheorem "MathOfBiology.Loop_3222.critical_wavenumber_drive_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-eryops-megacephalus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Trace stability of the homogeneous dermal state" ;
    dct:description "The unpatterned state is reaction-stable; pattern requires differential diffusion | Variables: trace scaled by 1000 equals -833" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b44ba50e2b3311d637a471cbc44dcd63f77d40d0/models/2026-delphi10000-eryops-megacephalus-turing-wavelength-s0.py#L119-L137>,
        <https://github.com/fractastical/morpholib/blob/b44ba50e2b3311d637a471cbc44dcd63f77d40d0/morphoeval/lean/loops/Loop_3222_eryops_megacephalus_turing_wavelength_s0.lean#L36-L42> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "trace(J) = f_u + g_v < 0 at (u0, v0) = (a+b, b/(a+b)^2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1096-3642.2009.00599.x>,
        <https://doi.org/10.1666/0022-3360(2006)80[561:tasoem]2.0.co;2> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3222.traceMilli" ;
    pk:leanTheorem "MathOfBiology.Loop_3222.homogeneous_trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-eryops-megacephalus-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail wavelength versus the 8.184 mm organ-scale pit" ;
    dct:description "What changes at this scale relative to the coarser Eryops comparison and the 365 Ma stem-tetrapod horizon | Variables: lambda_um=127, lambda_organ_um=8184, age_ma=295, predecessor_age_ma=365" ;
    dct:source "Pawley and Warren 2006 DOI:10.1666/0022-3360(2006)80[561:tasoem]2.0.co;2" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b44ba50e2b3311d637a471cbc44dcd63f77d40d0/models/2026-delphi10000-eryops-megacephalus-turing-wavelength-s0.py#L64-L73>,
        <https://github.com/fractastical/morpholib/blob/b44ba50e2b3311d637a471cbc44dcd63f77d40d0/morphoeval/lean/loops/Loop_3222_eryops_megacephalus_turing_wavelength_s0.lean#L23-L26> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "8184 um = 64 * 127 um + 56 um" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1096-3642.2009.00599.x>,
        <https://doi.org/10.1666/0022-3360(2006)80[561:tasoem]2.0.co;2> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3222.lambdaUm" ;
    pk:leanTheorem "MathOfBiology.Loop_3222.detail_finer_than_organ_scale" ;
    pk:leanVerified true .


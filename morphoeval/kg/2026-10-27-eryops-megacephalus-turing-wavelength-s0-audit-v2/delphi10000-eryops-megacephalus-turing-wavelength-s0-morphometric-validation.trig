sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Eryops megacephalus Schnakenberg Turing wavelength at 127 µm (Cisuralian, 295 Ma) — Morphometric validation: 92/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 0.99999998 (reference floor 0.98, not equal), RMSE = 1.137e-4 (reference tolerance 0.05), KS statistic = 0.0667. Specimen bone-mask foreground fraction = 0.3208 versus null 0.5. Bounding-box aspect = 1.3358 versus null 1. Structure-tensor coherency = 0.5334 versus isotropic null 0.25. Field Pearson r against the photograph is 0.9913. The saturated radial-FFT peak at exactly 127.0 µm is the design wavelength and is not counted as an independent empirical hit." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-bone-masked-specimen-field-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-dispersion-sigma-k-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-dispersion-sigma-k-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-equal-diffusion-control-max-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-specimen-bone-mask-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-specimen-skeleton-bounding-box-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-bone-masked-specimen-field-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "bone-masked specimen-field Pearson r = 0.9913 Pearson r" ;
        dct:description "p = 0.000e+00; CV masked 96.0; CV unmasked 94.4" ;
        schema:measurementTechnique "interior grayscale of the AMNH frame vs the last GIF frame" ;
        schema:name "bone-masked specimen-field Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9913" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-bone-masked-specimen-field-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-bone-masked-specimen-field-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Pass-1 planning floor; the achieved correlation is computed, not copied" ;
        schema:value "0.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-dispersion-sigma-k-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion sigma(k) Pearson r = 0.99999998 Pearson r" ;
        dct:description "RMSE 0.000114; KS statistic 0.0667; p_pearson 8.658e-50" ;
        schema:measurementTechnique "explicit Euler growth rates vs discrete-symbol σ(k) for Fourier modes m = 2..16" ;
        schema:name "dispersion sigma(k) Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99999998" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-dispersion-sigma-k-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-dispersion-sigma-k-pearson-r-reference> a schema:PropertyValue ;
        dct:source "pre-registered acceptance floor for the linear Turing dispersion; not the measured r" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-dispersion-sigma-k-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion sigma(k) RMSE = 0.000114 1/time" ;
        dct:description "KS p = 1.0000" ;
        schema:measurementTechnique "root mean square of measured minus predicted σ(k) on modes m = 2..16" ;
        schema:name "dispersion sigma(k) RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.000114" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-dispersion-sigma-k-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-dispersion-sigma-k-rmse-reference> a schema:PropertyValue ;
        dct:source "loose explicit-Euler tolerance, not the achieved residual" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-equal-diffusion-control-max-sigma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control max sigma = -0.4166 1/time" ;
        dct:description "full-model max σ = 0.4029; control std 0.0399 → 0.0000" ;
        schema:measurementTechnique "max continuum σ(k) after setting D_u = D_v = D_u(slot)" ;
        schema:name "equal-diffusion control max sigma" ;
        schema:unitText "1/time" ;
        schema:value "-0.4166" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-equal-diffusion-control-max-sigma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-equal-diffusion-control-max-sigma-reference> a schema:PropertyValue ;
        dct:source "Turing threshold; equal diffusion must lie at or below 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nonlinear dominant wavelength = 127.0 µm" ;
        dct:description "measured period 12.0000 px vs design 12 px" ;
        schema:measurementTechnique "radial FFT peak of the saturated u field, converted at 127/12 µm per pixel" ;
        schema:name "nonlinear dominant wavelength" ;
        schema:unitText "µm" ;
        schema:value "127.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-nonlinear-dominant-wavelength-reference> a schema:PropertyValue ;
        dct:source "design wavelength of the linear critical mode (127 µm)" ;
        schema:value "127.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-specimen-bone-mask-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen bone-mask foreground fraction = 0.3208 area fraction" ;
        dct:description "Otsu threshold 132; raw (uneroded) fraction differs from the eroded mask" ;
        schema:measurementTechnique "Otsu threshold on the 720x540 AMNH frame, then 2-pixel binary erosion" ;
        schema:name "specimen bone-mask foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.3208" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-specimen-bone-mask-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-specimen-bone-mask-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "null half-frame occupancy; not a histological target" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-specimen-skeleton-bounding-box-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen skeleton bounding-box aspect ratio = 1.3358 width/height" ;
        dct:description "Pawley & Warren 2006 describe the appendicular skeleton; this ratio is measured on the photograph" ;
        schema:measurementTechnique "axis-aligned bbox of the eroded Otsu bone mask on eryops_megacephalus_amnh_specimen.jpg" ;
        schema:name "specimen skeleton bounding-box aspect ratio" ;
        schema:unitText "width/height" ;
        schema:value "1.3358" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-specimen-skeleton-bounding-box-aspect-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-specimen-skeleton-bounding-box-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "square-frame null; the mounted skeleton is elongated" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.5334 coherency" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) of the Sobel structure tensor, Gaussian σ = 2" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.5334" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "isotropic-texture null used only as a non-circular baseline" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-eryops-megacephalus-turing-wavelength-s0.py L725–L812" ;
        dct:description "Non-circular morphometrics, Pearson, RMSE, KS" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b44ba50e2b3311d637a471cbc44dcd63f77d40d0/models/2026-delphi10000-eryops-megacephalus-turing-wavelength-s0.py#L725-L812> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "datasets/eryops_megacephalus_turing_wavelength_s0/eryops_megacephalus_turing_wavelength_s0_metrics.json L23–L80" ;
        dct:description "Recorded dispersion table from the self-test" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b44ba50e2b3311d637a471cbc44dcd63f77d40d0/datasets/eryops_megacephalus_turing_wavelength_s0/eryops_megacephalus_turing_wavelength_s0_metrics.json#L23-L80> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (primary assessor, loop 3222)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


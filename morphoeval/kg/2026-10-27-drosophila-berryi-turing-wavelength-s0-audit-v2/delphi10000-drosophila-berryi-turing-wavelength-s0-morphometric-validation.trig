sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila berryi detail-scale Turing wavelength at 1.754 µm (19 Ma) — Morphometric validation: 92/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r = 0.999998 and RMSE = 0.000250 against the eigenvalue curve (KS statistic 0.111 versus an a priori mismatch threshold 0.45). Equal-diffusion envelope -0.4051 versus analytical -0.4099 (error 0.0048). The 2D FFT peak locks to lambda_sigma = 2.253 µm. Specimen foreground, coherency and radial wavelength use reference targets that are not copies of the measured values." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-autocatalysis-ablation-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-chronoseries-detail-wavelength-ratio-berryi-over-succini>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-classical-critical-wavelength-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-dispersion-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-equal-diffusion-negative-control-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-fastest-growing-wavelength-lambda-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-inhibitor-diffusivity-sweep-monotone-flag>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-modal-growth-rate-pearson-r-of-sigma-k>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-modal-growth-rate-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-specimen-amber-spiral-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-specimen-radial-wavelength-norm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-two-dimensional-field-wavelength-versus-lambda-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-autocatalysis-ablation-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "autocatalysis-ablation growth rate = -1.1649 1/time" ;
        dct:description "analytical sigma=-1.1600; decays=True" ;
        schema:measurementTechnique "ablation control: reaction replaced by linear relaxation f=a-u, g=b-v" ;
        schema:name "autocatalysis-ablation growth rate" ;
        schema:unitText "1/time" ;
        schema:value "-1.1649" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-autocatalysis-ablation-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-autocatalysis-ablation-growth-rate-reference> a schema:PropertyValue ;
        dct:source "ablated u^2 v term must not grow" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-chronoseries-detail-wavelength-ratio-berryi-over-succini> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chronoseries detail-wavelength ratio berryi over succini = 0.8596 ratio" ;
        dct:description "Miocene contraction versus the 44 Ma predecessor" ;
        schema:measurementTechnique "detail lambda(berryi) / detail lambda(succini)" ;
        schema:name "chronoseries detail-wavelength ratio berryi over succini" ;
        schema:unitText "ratio" ;
        schema:value "0.8596" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-chronoseries-detail-wavelength-ratio-berryi-over-succini-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-chronoseries-detail-wavelength-ratio-berryi-over-succini-reference> a schema:PropertyValue ;
        dct:source "tissue-stripe ratio 98/114 at fixed mode number" ;
        schema:value "0.8596" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-classical-critical-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "classical critical wavelength lambda_c = 1.754 µm" ;
        dct:description "k_c=3.582204e+06 1/m at 19 Ma" ;
        schema:measurementTechnique "lambda_c = 2 pi / k_c with k_c from the Turing formula, unit calibrated to 1.754 µm" ;
        schema:name "classical critical wavelength lambda_c" ;
        schema:unitText "µm" ;
        schema:value "1.754" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-classical-critical-wavelength-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-classical-critical-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "slot assignment 1.754e-6 m (1.8 µm class, log10=-5.756)" ;
        schema:value "1.754" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-dispersion-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion KS statistic = 0.1111 KS" ;
        dct:description "p=1" ;
        schema:measurementTechnique "KS two-sample of predicted versus measured sigma samples" ;
        schema:name "dispersion KS statistic" ;
        schema:unitText "KS" ;
        schema:value "0.1111" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "a priori mismatch threshold; a faithful dispersion lies well below it" ;
        schema:value "0.45" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-equal-diffusion-negative-control-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion negative-control growth rate = -0.4051 1/time" ;
        dct:description "rate error=0.0048; decays=True; Pass 2 replaces the cosine projection that aliased the oscillation" ;
        schema:measurementTechnique "envelope fit of a complex-mode seed with D_v set equal to D_u (negative control)" ;
        schema:name "equal-diffusion negative-control growth rate" ;
        schema:unitText "1/time" ;
        schema:value "-0.4051" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-equal-diffusion-negative-control-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-equal-diffusion-negative-control-growth-rate-reference> a schema:PropertyValue ;
        dct:source "real part of the complex eigenvalue at D_v = D_u" ;
        schema:value "-0.4099" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-fastest-growing-wavelength-lambda-sigma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fastest-growing wavelength lambda_sigma = 2.2525 µm" ;
        dct:description "not equal to lambda_c; the difference is the trace penalty" ;
        schema:measurementTechnique "argmax_k sigma(k) converted by the berryi metric" ;
        schema:name "fastest-growing wavelength lambda_sigma" ;
        schema:unitText "µm" ;
        schema:value "2.2525" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-fastest-growing-wavelength-lambda-sigma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-fastest-growing-wavelength-lambda-sigma-reference> a schema:PropertyValue ;
        dct:source "classical lambda_c; the trace shift makes lambda_sigma longer" ;
        schema:value "1.754" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-inhibitor-diffusivity-sweep-monotone-flag> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "inhibitor-diffusivity sweep monotone flag = 1.0 flag" ;
        dct:description "parameter expressivity of the inhibitor diffusivity; distinct from the chronospecies metric" ;
        schema:measurementTechnique "six-point D_v sweep of the fastest-growing wavelength at fixed D_u" ;
        schema:name "inhibitor-diffusivity sweep monotone flag" ;
        schema:unitText "flag" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-inhibitor-diffusivity-sweep-monotone-flag-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-inhibitor-diffusivity-sweep-monotone-flag-reference> a schema:PropertyValue ;
        dct:source "lambda_sigma lengthens as D_v increases on this Jacobian" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-modal-growth-rate-pearson-r-of-sigma-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "modal growth-rate Pearson r of sigma(k) = 0.999998 Pearson r" ;
        dct:description "RMSE=0.000250; KS statistic=0.1111; p=1" ;
        schema:measurementTechnique "Pearson r, RMSE and KS two-sample between predicted and measured growth rates across 9 wavenumbers" ;
        schema:name "modal growth-rate Pearson r of sigma(k)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.999998" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-modal-growth-rate-pearson-r-of-sigma-k-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-modal-growth-rate-pearson-r-of-sigma-k-reference> a schema:PropertyValue ;
        dct:source "identity between the Jacobian eigenvalue and a pure-mode integration" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-modal-growth-rate-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "modal growth-rate RMSE = 0.00025 1/time" ;
        dct:description "dispersion RMSE" ;
        schema:measurementTechnique "RMSE of measured minus predicted sigma(k)" ;
        schema:name "modal growth-rate RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.00025" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-modal-growth-rate-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-modal-growth-rate-rmse-reference> a schema:PropertyValue ;
        dct:source "zero residual against the linear dispersion relation" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-specimen-amber-spiral-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen amber-spiral foreground fraction = 0.3445 fraction" ;
        dct:description "gallery plate is an amber spiral, not a 1.8 µm SEM" ;
        schema:measurementTechnique "border-contrast foreground segmentation of Drosophila_berryi_specimen.jpg" ;
        schema:name "specimen amber-spiral foreground fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.3445" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-specimen-amber-spiral-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-specimen-amber-spiral-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "a priori mid-frame occupancy target for a filled micrograph; not copied from the plate" ;
        schema:value "0.55" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-specimen-radial-wavelength-norm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial wavelength norm = 0.2 fraction of frame" ;
        dct:description "the printed bar is 100 µm; this slot's law is 1.754 µm, so the ratio is not 1" ;
        schema:measurementTechnique "radial FFT peak of the gallery plate divided by the frame" ;
        schema:name "specimen radial wavelength norm" ;
        schema:unitText "fraction of frame" ;
        schema:value "0.2" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-specimen-radial-wavelength-norm-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-specimen-radial-wavelength-norm-reference> a schema:PropertyValue ;
        dct:source "wavelength expected if the 1.754 µm mode filled a 100 µm printed bar (1.754/100)" ;
        schema:value "0.08" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.981 coherency" ;
        dct:description "CV orientation feature of the canonical specimen" ;
        schema:measurementTechnique "mean structure-tensor coherency on the gallery plate" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.981" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "isotropic-texture prior; the spiral plate is more coherent" ;
        schema:value "0.45" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-two-dimensional-field-wavelength-versus-lambda-sigma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "two-dimensional field wavelength versus lambda_sigma = 2.2525 µm" ;
        dct:description "early-time 2D selection; late coarsening is not required for this lock" ;
        schema:measurementTechnique "radial FFT peak of the periodic Schnakenberg field during linear growth" ;
        schema:name "two-dimensional field wavelength versus lambda_sigma" ;
        schema:unitText "µm" ;
        schema:value "2.2525" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-two-dimensional-field-wavelength-versus-lambda-sigma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-measurement-two-dimensional-field-wavelength-versus-lambda-sigma-reference> a schema:PropertyValue ;
        dct:source "argmax of sigma(k) on the berryi metric" ;
        schema:value "2.2525" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;

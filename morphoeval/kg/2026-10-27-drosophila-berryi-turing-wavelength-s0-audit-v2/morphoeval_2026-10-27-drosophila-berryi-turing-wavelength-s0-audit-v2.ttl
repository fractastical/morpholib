<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-berryi-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Berryi detail wavelength positivity" ;
    dct:description "Pins the 1.8 µm detail-scale phenomenon size (1.754 µm) for Drosophila berryi | Variables: berryiLambdaNm: classical critical wavelength in nanometres at 19 Ma" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-berryi-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3173_drosophila_berryi_turing_wavelength_s0.lean#L10-L13> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def berryiLambdaNm : Int := 1754
theorem berryi_wavelength_positive : berryiLambdaNm > 0 := by decide"""^^pk:lean4 ;
    skos:notation "lambda_c(berryi) = 1.754e-6 m > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1021/bk-1995-0617.ch011>,
        <https://doi.org/10.1093/molbev/msg236>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3173.berryiLambdaNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3173.berryi_wavelength_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-berryi-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Miocene chronoseries contraction exceeds the later Holocene step" ;
    dct:description "Formalizes the 44 Ma → 19 Ma → 0 Ma contraction at the 1–2 µm tier | Variables: older, newer: detail wavelengths in nanometres along the amber chronoseries" ;
    dct:source "Grimaldi (1987) https://www.biodiversitylibrary.org/item/171121; Grimaldi (1995) DOI:10.1021/bk-1995-0617.ch011" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-berryi-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3173_drosophila_berryi_turing_wavelength_s0.lean#L16-L22> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def chronoseriesGap (older newer : Int) : Int := older - newer
theorem miocene_gap_exceeds_holocene_gap : chronoseriesGap 2040 1754 > chronoseriesGap 1754 1718 := by decide"""^^pk:lean4 ;
    skos:notation "lambda(succini, 2040 nm) - lambda(berryi, 1754 nm) > lambda(berryi) - lambda(affinis, 1718 nm)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1021/bk-1995-0617.ch011>,
        <https://doi.org/10.1093/molbev/msg236>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3173.chronoseriesGap" ;
    pk:leanTheorem "MathOfBiology.Loop_3173.miocene_gap_exceeds_holocene_gap" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-berryi-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Inhibitor diffuses faster than the activator" ;
    dct:description "Turing band sign condition for wavenumber k_c at the berryi detail scale | Variables: dvMilli, duMilli: diffusivities scaled by 1000 and rounded" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-berryi-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3173_drosophila_berryi_turing_wavelength_s0.lean#L25-L31> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def diffusionRatioMilli (dvMilli duMilli : Int) : Int := dvMilli / duMilli
theorem berryi_inhibitor_diffuses_faster : diffusionRatioMilli 1721 37 > 1 := by decide"""^^pk:lean4 ;
    skos:notation "D_v / D_u > 1 with D_v = 1.721 and D_u = 0.03686 (integer encoding 1721/37)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1021/bk-1995-0617.ch011>,
        <https://doi.org/10.1093/molbev/msg236>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;

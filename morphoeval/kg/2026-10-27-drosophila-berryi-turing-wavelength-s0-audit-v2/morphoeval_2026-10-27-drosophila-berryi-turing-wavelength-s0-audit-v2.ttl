<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila berryi detail-scale Turing wavelength at 1.754 µm (19 Ma) — Model fidelity to source: 90/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script evaluates the Schnakenberg Jacobian, the classical k_c formula, and the leading eigenvalue, including the complex pair that appears when D_v = D_u. Pass 2 seeds that complex mode and fits its envelope instead of a real cosine that aliased the oscillation." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 9e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-berryi-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila berryi detail-scale Turing wavelength at 1.754 µm (19 Ma) — Morphometric validation: 92/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Pearson r = 0.999998 and RMSE = 0.000250 against the eigenvalue curve (KS statistic 0.111 versus an a priori mismatch threshold 0.45). Equal-diffusion envelope -0.4051 versus analytical -0.4099 (error 0.0048). The 2D FFT peak locks to lambda_sigma = 2.253 µm. Specimen foreground, coherency and radial wavelength use reference targets that are not copies of the measured values." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

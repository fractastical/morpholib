<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-persimilis-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-persimilis-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-persimilis-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-persimilis-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg onset wavenumber" ;
    dct:description "Selects the 2.098 µm stripe on the corneal patch | Variables: r = D_v/D_u = 20 for D. persimilis; onset integer bound r = 9" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0; Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/6c49ecbdcc1e6d2fcf72d168ee46196263be7d3b/models/2026-delphi10000-drosophila-persimilis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/6c49ecbdcc1e6d2fcf72d168ee46196263be7d3b/morphoeval/lean/loops/Loop_3198_drosophila_persimilis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(76)90225-6>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/s0960-9822(95)00229-6>,
        <https://doi.org/10.1073/pnas.221274498>,
        <https://doi.org/10.1073/pnas.45.3.419>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3198.diffusionRatioPersimilis" ;
    pk:leanTheorem "MathOfBiology.Loop_3198.persimilisAboveTuringOnset" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-persimilis-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries allometric wavelength" ;
    dct:description "What changes at 2.1 µm relative to the predecessor and the successor | Variables: paulistorum 1947 nm < persimilis 2098 nm < planitibia 2735 nm, age 0 Ma" ;
    dct:source "Noor et al. 2001 DOI:10.1073/pnas.221274498; Dobzhansky & Spassky 1959 DOI:10.1073/pnas.45.3.419; Kambysellis et al. 1995 DOI:10.1016/s0960-9822(95)00229-6" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/6c49ecbdcc1e6d2fcf72d168ee46196263be7d3b/models/2026-delphi10000-drosophila-persimilis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/6c49ecbdcc1e6d2fcf72d168ee46196263be7d3b/morphoeval/lean/loops/Loop_3198_drosophila_persimilis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda(species) = 2.098 µm * (L_species / 2.82 mm)^0.42" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(76)90225-6>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/s0960-9822(95)00229-6>,
        <https://doi.org/10.1073/pnas.221274498>,
        <https://doi.org/10.1073/pnas.45.3.419>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3198.lambdaNmPersimilis" ;
    pk:leanTheorem "MathOfBiology.Loop_3198.chronoseriesWavelengthOrder" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-persimilis-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion negative control" ;
    dct:description "Shows the stripe is carried by differential diffusion, not by the initial cosine | Variables: ablation sets D_v = D_u" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/6c49ecbdcc1e6d2fcf72d168ee46196263be7d3b/models/2026-delphi10000-drosophila-persimilis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/6c49ecbdcc1e6d2fcf72d168ee46196263be7d3b/morphoeval/lean/loops/Loop_3198_drosophila_persimilis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "r = 1 is below onset, so the homogeneous state stays linearly stable" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(76)90225-6>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,

    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(76)90225-6>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/s0960-9822(95)00229-6>,
            <https://doi.org/10.1073/pnas.221274498>,
            <https://doi.org/10.1073/pnas.45.3.419>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://doi.org/10.1016/0012-1606(76)90225-6> dct:title "Development of the Drosophila retina, a neurocrystalline lattice" .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1016/s0960-9822(95)00229-6> dct:title "Pattern of ecological shifts in the diversification of Hawaiian Drosophila inferred from a molecular phylogeny" .
    <https://doi.org/10.1073/pnas.221274498> dct:title "Chromosomal inversions and the reproductive isolation of species" .
    <https://doi.org/10.1073/pnas.45.3.419> dct:title "Drosophila paulistorum, a cluster of species in statu nascendi" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
}


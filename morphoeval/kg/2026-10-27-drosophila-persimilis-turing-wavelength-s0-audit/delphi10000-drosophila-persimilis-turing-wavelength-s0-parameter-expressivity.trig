sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg critical wavelength for Drosophila persimilis at 2.1 µm — Parameter expressivity: 74/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The Du sweep is monotonic and the analytic β table keeps paulistorum shorter than planitibia from β=0.20 to 0.70. Endpoint diffusivities are integrated, but this first reading does not yet treat that grid as a full substitute for a measured wavelength series." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-persimilis-turing-wavelength-s0.py L210–L241" ;
        dct:description "five-point Du sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/6c49ecbdcc1e6d2fcf72d168ee46196263be7d3b/models/2026-delphi10000-drosophila-persimilis-turing-wavelength-s0.py#L210-L241> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-persimilis-turing-wavelength-s0.py L261–L292" ;
        dct:description "analytic β order and integrated endpoints" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/6c49ecbdcc1e6d2fcf72d168ee46196263be7d3b/models/2026-delphi10000-drosophila-persimilis-turing-wavelength-s0.py#L261-L292> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, first reading)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg critical wavelength for Drosophila persimilis at 2.1 µm — Morphometric validation: 70/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "FFT centroids, Pearson r, RMSE, ablation ratio, seed SD, and grid convergence are computed. References are the assigned 2.098 µm tier and the allometric targets, not periods measured on these three species. The orientation KS against the gallery plate is large, which is the correct disagreement, and is not yet the basis of the score." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-beta-endpoint-planitibia-minus-paulistorum-at-beta-0-70>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-du-sweep-pearson-r-analytic-vs-measured-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-du-sweep-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-grid-convergence-relative-wavelength-error>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-ks-distance-specimen-vs-rd-orientation-histogram>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-multi-seed-wavelength-sd>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-paulistorum-measured-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-persimilis-fft-centroid-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-planitibia-measured-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-beta-endpoint-planitibia-minus-paulistorum-at-beta-0-70> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "beta-endpoint planitibia minus paulistorum at beta 0.70 = 1.5138 µm" ;
        dct:description "parameter-regime sweep beyond the nominal β=0.42" ;
        schema:measurementTechnique "integrated wavelength gap at the steep allometric endpoint β=0.70" ;
        schema:name "beta-endpoint planitibia minus paulistorum at beta 0.70" ;
        schema:unitText "µm" ;
        schema:value "1.5138" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-beta-endpoint-planitibia-minus-paulistorum-at-beta-0-70-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-beta-endpoint-planitibia-minus-paulistorum-at-beta-0-70-reference> a schema:PropertyValue ;
        dct:source "analytic L^0.70 gap; the simulated gap is not copied from that difference" ;
        schema:value "1.4109" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-du-sweep-pearson-r-analytic-vs-measured-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Du-sweep Pearson r analytic vs measured wavelength = 0.9993 correlation" ;
        dct:description "RMSE 0.0333 µm; monotonic=True" ;
        schema:measurementTechnique "Pearson r across five D_u multipliers at fixed r=20; RMSE reported alongside" ;
        schema:name "Du-sweep Pearson r analytic vs measured wavelength" ;
        schema:unitText "correlation" ;
        schema:value "0.9993" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-du-sweep-pearson-r-analytic-vs-measured-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-du-sweep-pearson-r-analytic-vs-measured-wavelength-reference> a schema:PropertyValue ;
        dct:source "MorphoEval gate Pearson r > 0.98" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-du-sweep-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Du-sweep RMSE = 0.0333 µm" ;
        schema:measurementTechnique "root mean square of FFT-centroid λ minus sqrt(D_u) analytic λ" ;
        schema:name "Du-sweep RMSE" ;
        schema:unitText "µm" ;
        schema:value "0.0333" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-du-sweep-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-du-sweep-rmse-reference> a schema:PropertyValue ;
        dct:source "acceptance band used by the self-test, not a fitted zero" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation amplitude ratio = 0.0509 std(u)_ablation / std(u)_pattern" ;
        dct:description "control vs patterned baseline" ;
        schema:measurementTechnique "negative control with D_v set equal to D_u; Turing onset condition fails" ;
        schema:name "equal-diffusion ablation amplitude ratio" ;
        schema:unitText "std(u)_ablation / std(u)_pattern" ;
        schema:value "0.0509" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "null of no suppression; a working control is well below 1" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-grid-convergence-relative-wavelength-error> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "grid-convergence relative wavelength error = 0.0002 fraction of 2.098 µm" ;
        schema:measurementTechnique "absolute difference of N=64 and N=96 centroids, divided by 2.098 µm" ;
        schema:name "grid-convergence relative wavelength error" ;
        schema:unitText "fraction of 2.098 µm" ;
        schema:value "0.0002" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-grid-convergence-relative-wavelength-error-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-grid-convergence-relative-wavelength-error-reference> a schema:PropertyValue ;
        dct:source "continuum limit; residual is the discrete-grid error" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-ks-distance-specimen-vs-rd-orientation-histogram> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "KS distance specimen vs RD orientation histogram = 0.5052 KS" ;
        dct:description "non-circular specimen metric; value is not set equal to the reference" ;
        schema:measurementTechnique "12-bin Sobel-style orientation CDF distance between the gallery plate and the persimilis activator" ;
        schema:name "KS distance specimen vs RD orientation histogram" ;
        schema:unitText "KS" ;
        schema:value "0.5052" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-ks-distance-specimen-vs-rd-orientation-histogram-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-ks-distance-specimen-vs-rd-orientation-histogram-reference> a schema:PropertyValue ;
        dct:source "identical-histogram null; stripes are not the gallery spiral" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-multi-seed-wavelength-sd> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "multi-seed wavelength SD = 0.0001 µm" ;
        dct:description "mean 2.0974 µm across seeds [3198, 3209, 3221, 3233, 3247]" ;
        schema:measurementTechnique "sample standard deviation of FFT centroid over 5 seeds" ;
        schema:name "multi-seed wavelength SD" ;
        schema:unitText "µm" ;
        schema:value "0.0001" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-multi-seed-wavelength-sd-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-multi-seed-wavelength-sd-reference> a schema:PropertyValue ;
        dct:source "zero-dispersion idealisation; realized SD is the uncertainty" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-paulistorum-measured-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "paulistorum measured wavelength = 1.9553 µm" ;
        schema:measurementTechnique "same patch and kinetics; D_u scaled by (2.36/2.82)^(0.84)" ;
        schema:name "paulistorum measured wavelength" ;
        schema:unitText "µm" ;
        schema:value "1.9553" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-paulistorum-measured-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-paulistorum-measured-wavelength-reference> a schema:PropertyValue ;
        dct:source "allometric transfer β=0.42 from catalog body length 2.36 mm" ;
        schema:value "1.9468" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-persimilis-fft-centroid-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "persimilis FFT centroid wavelength = 2.0967 µm" ;
        dct:description "centroid is deliberately not the integer mode L/8, so value != reference" ;
        schema:measurementTechnique "radial spectral centroid of the final Schnakenberg activator on the 16.784 µm patch" ;
        schema:name "persimilis FFT centroid wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.0967" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-persimilis-fft-centroid-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-persimilis-fft-centroid-wavelength-reference> a schema:PropertyValue ;
        dct:source "slot assignment, tier 3_subcellular_um detail wavelength 2.098 µm" ;
        schema:value "2.098" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-planitibia-measured-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "planitibia measured wavelength = 2.8072 µm" ;
        schema:measurementTechnique "same patch and kinetics; D_u scaled by (5.30/2.82)^(0.84)" ;
        schema:name "planitibia measured wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.8072" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-planitibia-measured-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-planitibia-measured-wavelength-reference> a schema:PropertyValue ;
        dct:source "allometric transfer β=0.42 from catalog body length 5.30 mm" ;
        schema:value "2.7346" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen foreground fraction = 0.3294 area fraction" ;
        dct:description "specimen image segmentation, not a self-copy of the reference JSON" ;
        schema:measurementTechnique "border-median contrast mask on the gallery plate resized to 160x120" ;
        schema:name "specimen foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.3294" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "null expectation of a half-occupied mask; the plate is not that mask" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.7825 coherency" ;
        schema:measurementTechnique "box-smoothed structure tensor on the gallery-plate luminance" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.7825" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "isotropic null coherency 0.5; the spiral plate is anisotropic" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;

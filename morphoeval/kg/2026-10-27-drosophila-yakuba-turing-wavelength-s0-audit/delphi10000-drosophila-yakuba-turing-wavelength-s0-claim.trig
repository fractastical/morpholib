sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Schnakenberg Turing wavelength at 2.157 µm on the D. yakuba abdominal cuticle (Holocene, 0 Ma) faithfully reproduces Drosophila yakuba morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-yakuba-turing-wavelength-s0.py, datasets/drosophila_yakuba_turing_wavelength_s0/drosophila_yakuba_turing_wavelength_s0_reference.json, morphoeval/lean/loops/Loop_3212_drosophila_yakuba_turing_wavelength_s0.lean implement the cited source model as published and produce forms that match real Drosophila yakuba specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/datasets/drosophila_yakuba_turing_wavelength_s0/drosophila_yakuba_turing_wavelength_s0_reference.json>,
            <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-yakuba-turing-wavelength-s0.py>,
            <https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3212_drosophila_yakuba_turing_wavelength_s0.lean> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-yakuba-turing-wavelength-s0.py, https://github.com/fractastical/morpholib/blob/main/datasets/drosophila_yakuba_turing_wavelength_s0/drosophila_yakuba_turing_wavelength_s0_reference.json, https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3212_drosophila_yakuba_turing_wavelength_s0.lean; output: docs/media/drosophila_yakuba_turing_wavelength_s0_comparison.png; organism: Drosophila yakuba; environment: python 3.12.3, numpy 2.5.4, matplotlib 3.11.2, Pillow 13.0.0, scipy 1.18.1; claim_boundary: [reported_in_source: Turing (1952): diffusion-driven instability and a selected wavenumber. Schnakenberg (1979): the a−u+u²v / b−u²v kinetics. | Carbone et al. (2005) and Llopart et al. (2002): the yakuba/santomea pigmentation difference is genetic. Wittkopp et al. (2002): Yellow and Ebony act reciprocally on melanin versus NBAD.; reconstructed_in_script: Linear dispersion (trace, determinant, cross term, discrete σ(q)) and an explicit-Euler Schnakenberg spiral on a 72×96 periodic patch, with λ* pinned to 2.157 µm. | Yellow = slow activator and Ebony/NBAD = fast substrate is an interpretive reading, not an equation in those papers.; transfer_boundary: A 16 µm periodic patch is not a whole tergite. The gallery specimen is a sepia gradation field, not a dissected cuticle micrograph at 2.2 µm.; does_not_claim: Does not claim Carbone et al. measured a 2.157 µm granule spacing, and does not copy the 97 µm cellular-tier yakuba sibling (slot 2731). | Pass 1 does not claim the 3×3 bead spacing equals λ*. That estimator is the remediation target.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.0014-3820.2002.tb00150.x>,
            <https://doi.org/10.1242/dev.129.8.1849>,
            <https://doi.org/10.1534/genetics.105.044412> .
    <https://github.com/fractastical/morpholib/blob/main/datasets/drosophila_yakuba_turing_wavelength_s0/drosophila_yakuba_turing_wavelength_s0_reference.json> a schema:SoftwareSourceCode ;
        rdfs:label "datasets/drosophila_yakuba_turing_wavelength_s0/drosophila_yakuba_turing_wavelength_s0_reference.json" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-yakuba-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-yakuba-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
    <https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3212_drosophila_yakuba_turing_wavelength_s0.lean> a schema:SoftwareSourceCode ;
        rdfs:label "morphoeval/lean/loops/Loop_3212_drosophila_yakuba_turing_wavelength_s0.lean" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Lean 4" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.0014-3820.2002.tb00150.x>,
            <https://doi.org/10.1242/dev.129.8.1849>,
            <https://doi.org/10.1534/genetics.105.044412> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1111/j.0014-3820.2002.tb00150.x> dct:date "2002"^^xsd:gYear ;
        dct:title "Genetics of a difference in pigmentation between Drosophila yakuba and Drosophila santomea" .
    <https://doi.org/10.1242/dev.129.8.1849> dct:date "2002"^^xsd:gYear ;
        dct:title "Reciprocal functions of the Drosophila Yellow and Ebony proteins in the development and evolution of pigment patterns" .
    <https://doi.org/10.1534/genetics.105.044412> dct:date "2005"^^xsd:gYear ;
        dct:title "Quantitative trait loci affecting the difference in pigmentation between Drosophila yakuba and D. santomea" .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 2.157 µm on the D. yakuba abdominal cuticle (Holocene, 0 Ma) — Morphometric validation: 74/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion r = 0.995 and the ablation σ* = −0.102 are solid. The spatial wavelength used 3×3 maxima: mean spacing 7.97 lattice px = 1.332 µm against λ* = 2.157 µm, KS = 0.592. That number describes beads along an arm. Otsu dark-band fraction of the specimen is 0.121, not a copied reference." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-dispersion-pearson-r-linearised-pde-vs-discrete>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-growth-animation-frame-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-ks-distance-of-radial-arm-spacings-vs-gaussian>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-nonlinear-stripe-radial-fft-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-rendered-frame-min-side>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-specimen-image-dark-band-area-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-specimen-image-dominant-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-specimen-image-stripe-radial-fft-peak-bin>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-wavenumber-ratio-versus-drosophila-willistoni>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-dispersion-pearson-r-linearised-pde-vs-discrete> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion Pearson r (linearised PDE vs discrete σ) = 0.9952504228171525 correlation" ;
        dct:description "RMSE=0.039361; threshold > 0.98" ;
        schema:measurementTechnique "eigenvector-initialised 5-point Laplacian, 22 modes, 80 steps" ;
        schema:name "dispersion Pearson r (linearised PDE vs discrete σ)" ;
        schema:unitText "correlation" ;
        schema:value "0.9952504228171525" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-dispersion-pearson-r-linearised-pde-vs-discrete-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-dispersion-pearson-r-linearised-pde-vs-discrete-reference> a schema:PropertyValue ;
        dct:source "exact match to the discrete dispersion relation" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 0.039361017431920546 1/time" ;
        schema:measurementTechnique "rms of σ_measured − σ_discrete over 22 lattice modes" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.039361017431920546" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "perfect discrete agreement" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation sigma_max = -0.10249999999999992 1/time" ;
        dct:description "negative control: cross term 8−10 < 0, pattern does not grow" ;
        schema:measurementTechnique "max_k σ(k) with D_u = D_v = 1" ;
        schema:name "equal-diffusion ablation sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.10249999999999992" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max-reference> a schema:PropertyValue ;
        dct:source "marginal stability; the control must lie strictly below" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-growth-animation-frame-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "growth animation frame count = 12 frames" ;
        schema:measurementTechnique "PIL n_frames of the rendered GIF" ;
        schema:name "growth animation frame count" ;
        schema:unitText "frames" ;
        schema:value "12" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-growth-animation-frame-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-growth-animation-frame-count-reference> a schema:PropertyValue ;
        dct:source "script snapshot schedule" ;
        schema:value "12" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-ks-distance-of-radial-arm-spacings-vs-gaussian> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "KS distance of radial arm spacings vs λ* Gaussian = 0.328125 KS" ;
        dct:description "n_rays_peaks=16; mean 12.24769736842105 px; pass-1 nearest-neighbour KS was 0.5920454545454545" ;
        schema:measurementTechnique "two-sample KS of arm-to-arm radial periods vs Normal(λ*, 0.18 λ*)" ;
        schema:name "KS distance of radial arm spacings vs λ* Gaussian" ;
        schema:unitText "KS" ;
        schema:value "0.328125" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-ks-distance-of-radial-arm-spacings-vs-gaussian-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-ks-distance-of-radial-arm-spacings-vs-gaussian-reference> a schema:PropertyValue ;
        dct:source "ideal agreement with the selected wavelength" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-nonlinear-stripe-radial-fft-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nonlinear stripe radial-FFT wavelength = 1.992881239620677e-06 m" ;
        dct:description "Pass-2 replacement for 3×3 nearest-neighbour bead spacing. Value is not forced equal to the reference." ;
        schema:measurementTechnique "isotropic radial FFT ring of the final activator, scaled so analytic λ*(D_v=20) = 2.157 µm" ;
        schema:name "nonlinear stripe radial-FFT wavelength" ;
        schema:unitText "m" ;
        schema:value "1.992881239620677e-06" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-nonlinear-stripe-radial-fft-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-nonlinear-stripe-radial-fft-wavelength-reference> a schema:PropertyValue ;
        dct:source "selected wavelength of the Schnakenberg dispersion at D_v=20 (2.2 µm tier)" ;
        schema:value "2.157e-06" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-measurement-rendered-frame-min-side> a schema:PropertyValue,

        rdfs:label "models/2026-delphi10000-drosophila-yakuba-turing-wavelength-s0.py L1–L40" ;
        dct:description "Scale, age, predecessor, and the two PDEs in the module docstring." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1d40797a1aa1c46f0b61e38c4454905b1b892739/models/2026-delphi10000-drosophila-yakuba-turing-wavelength-s0.py#L1-L40> .

            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-yakuba-turing-wavelength-s0-code-traceability-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

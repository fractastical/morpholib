        rdfs:label "Schnakenberg Turing wavelength at 2.157 µm on the D. yakuba abdominal cuticle (Holocene, 0 Ma) — Code-to-model traceability: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion, the Euler update, the sweep, and the Lean statements are each tied to a named law. The docstring states the Yellow/Ebony reading is interpretive. Pass 1's spacing function was not yet labelled as the wrong geometric feature in the reported metric." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

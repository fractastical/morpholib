sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Eldredgeops rana_17file Turing wavelength at 342 nm (Tioughniogan, 384 Ma) — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Jacobian, sigma(k), and k_c are implemented and checked by direct integration (Pearson r = 0.99997, RMSE = 0.003). The equal-diffusion ablation returns sigma_max = -0.082 and a decayed field (std about 1e-5), so the Turing condition is necessary for the spot. Kinetics remain Schnakenberg, which is the spot-forming system used to carry Turing's dispersion law, not a verbatim transcription of Turing's 1952 example." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0.py L85–L106" ;
        dct:description "sigma(k) and k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0.py#L85-L106> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0.py L442–L454" ;
        dct:description "Equal-diffusion ablation, sigma_max = -0.082" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0.py#L442-L454> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3216_eldredgeops_rana_17file_turing_wavelength_s0.lean L14–L41" ;
        dct:description "Theorems for the one-file drop, positive 342 nm wavelength, and positive discriminant margin" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3216_eldredgeops_rana_17file_turing_wavelength_s0.lean#L14-L41> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, pass 2 remediation)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Eldredgeops rana_17file Turing wavelength at 342 nm (Tioughniogan, 384 Ma) — Code-to-model traceability: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Each modelling step is a named function tied to a formula: dispersion, critical_wavenumber, optical_readout, diffusion_sweep, ablation_equal_diffusion, predecessor_cell. The Lean module names the same file-count and wavelength claims." ;

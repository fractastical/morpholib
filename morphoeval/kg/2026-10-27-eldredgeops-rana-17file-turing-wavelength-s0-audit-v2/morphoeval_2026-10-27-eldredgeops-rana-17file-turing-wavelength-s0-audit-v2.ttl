    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-code-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-code-traceability-2> ;

        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Eldredgeops rana_17file Turing wavelength at 342 nm (Tioughniogan, 384 Ma) faithfully reproduces Eldredgeops rana_17file morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Eldredgeops rana_17file specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0.py; output: docs/media/eldredgeops_rana_17file_turing_wavelength_s0_growth.gif; organism: Eldredgeops rana_17file; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 selects a finite critical wavenumber when the two morphogens diffuse at different rates. | Eldredge 1972 documents a step from 18 to 17 dorsoventral lens files between the Cazenovian and Tioughniogan horizons. | Lindgren et al. 2019 show a screening pigment associated with fossil arthropod eyes, which is the anatomical context for a pigment-ring wavelength.; reconstructed_in_script: Schnakenberg parameters rho_a=0.082, rho_b=0.918, D_u=0.060, D_v=1.200, periodic cell 1.15 lambda_c, seed 3216. | Quadratic optical readout I = c0 + c1 u_hat + c2 v_hat + c3 u_hat^2 + c4 v_hat^2 fit to the plate's radial luminance. | Predecessor cell side scaled by 17/18 at fixed lambda_c = 342 nm.; transfer_boundary: The gallery plate is a radial ocellus field with a labeled 100 micrometre bar (measured 111 px, 0.901 µm/px). Comparison is dimensionless radial shape plus computer-vision texture, not a claim that the plate's field of view is 342 nm.; does_not_claim: That 342 nm was measured on a Tioughniogan lens. | That the self-similar predecessor wavelength 323 nm is the law used here. | That a second independent assessor has scored this script.]; other sources: Systematics and evolution of Phacops rana (Green, 1832) and Phacops iowensis Delo, 1935, from the Middle Devonian of North America <https://digitallibrary.amnh.org/handle/2246/1096>; phenomenon_size: 357 nm (3.57e-07 m, log10=-6.447 m, tier=2_macromolecular_100nm); species_scale_ladder (10 runs from 357 nm to 803 µm): 357 nm:eldredgeops-rana-17file-bioelectric-polarity, 1.1 µm:eldredgeops-rana-17file-vertex-packing, 18 µm:eldredgeops-rana-17file-turing-wavelength, 36 µm:eldredgeops-rana-17file-clock-wavefront, 80 µm:eldredgeops-rana-17file-morphogen-condensation, 98 µm:eldredgeops-rana-17file-elastic-buckling, 112 µm:eldredgeops-rana-17file-flux-canalization, 156 µm:eldredgeops-rana-17file-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/s41586-019-1473-z>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.5531/sd.paleo.7> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


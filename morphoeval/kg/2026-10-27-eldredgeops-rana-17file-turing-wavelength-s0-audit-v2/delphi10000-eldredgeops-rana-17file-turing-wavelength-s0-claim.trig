            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/s41586-019-1473-z>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.5531/sd.paleo.7> .
    <https://digitallibrary.amnh.org/handle/2246/1096> dct:date "1972"^^xsd:gYear ;
        dct:title "Systematics and evolution of Phacops rana (Green, 1832) and Phacops iowensis Delo, 1935, from the Middle Devonian of North America" .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1038/s41586-019-1473-z> dct:date "2019"^^xsd:gYear ;
        dct:title "Fossil insect eyes shed light on trilobite optics and the arthropod pigment screen" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;

        rdfs:label "critical_wavelength_nm = 342.0 nm" ;
        schema:measurementTechnique "k_c from Schnakenberg Jacobian; length unit fixed at the reference D_v. Reference is the rejected self-similar predecessor wavelength 323 nm." ;

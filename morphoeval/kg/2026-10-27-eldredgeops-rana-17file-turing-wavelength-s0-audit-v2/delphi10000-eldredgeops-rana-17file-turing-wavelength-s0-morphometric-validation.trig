            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

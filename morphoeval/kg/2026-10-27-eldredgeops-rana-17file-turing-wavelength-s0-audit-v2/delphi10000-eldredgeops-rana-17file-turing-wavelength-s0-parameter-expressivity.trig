sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Eldredgeops rana_17file Turing wavelength at 342 nm (Tioughniogan, 384 Ma) — Parameter expressivity: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "At fixed kinetics and D_u, lambda_c falls monotonically as D_v runs through 0.48, 0.72, 1.20, 2.00, 3.20: 359.6, 349.5, 342.0, 337.7, 335.4 nm. That is the direction k_c^2 = f_u/(2 D_u) + g_v/(2 D_v) predicts, because g_v is negative. rho_a is not swept." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0.py L424–L439" ;
        dct:description "Five-point D_v sweep with a strict decrease check" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0.py#L424-L439> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0.py L621–L627" ;
        dct:description "Sweep endpoints recorded as a measurement whose value differs from its reference" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-eldredgeops-rana-17file-turing-wavelength-s0.py#L621-L627> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, pass 2 remediation)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


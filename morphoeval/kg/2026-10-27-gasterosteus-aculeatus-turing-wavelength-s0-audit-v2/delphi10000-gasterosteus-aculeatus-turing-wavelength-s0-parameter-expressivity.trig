sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Holocene Gasterosteus aculeatus cellular Turing wavelength (56 µm) — Parameter expressivity: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Raising γ from 3 to 10 shortens both analytic and nonlinear wavelengths (Pearson r = 0.9938). Setting Du = Dv collapses the activator standard deviation from 0.807 to ~0. Changing a from 0.28 to 0.20 to 0.14 shortens analytic λ from 61.81 to 56.00 to 52.23 µm. The saturated benthic FFT peak does not follow that last step (57.90 µm), which is reported rather than tuned away." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-parameter-expressivity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-parameter-expressivity-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0.py L320–L338" ;
        dct:description "γ sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4fdc4af8f8347d55b64a1de2f47c8a0931a60888/models/2026-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0.py#L320-L338> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "datasets/gasterosteus_aculeatus_turing_wavelength_s0/run_metrics.json L1–L30" ;
        dct:description "r 0.9938, RMSE 4.88 µm, measured marine 60.25, Holocene 54.99, benthic 57.90" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4fdc4af8f8347d55b64a1de2f47c8a0931a60888/datasets/gasterosteus_aculeatus_turing_wavelength_s0/run_metrics.json#L1-L30> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0.py L36–L52" ;
        dct:description "a_marine, a_holocene, a_benthic and SWEEP_GAMMAS" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4fdc4af8f8347d55b64a1de2f47c8a0931a60888/models/2026-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0.py#L36-L52> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


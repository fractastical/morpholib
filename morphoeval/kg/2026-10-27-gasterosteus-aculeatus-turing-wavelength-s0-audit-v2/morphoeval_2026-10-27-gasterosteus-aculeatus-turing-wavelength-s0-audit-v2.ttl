<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Holocene Gasterosteus aculeatus cellular Turing wavelength (56 µm) — Morphological realism / specimen match: 84/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "cv_sim_similarity against the real Krisp specimen is 88.4 (12 frames, 960×548). The comparison figure shows the photograph, the body mask, and the barred composite on that background. Column-luminance r is 0.851, not 1. Melanin area inside the mask is 0.266 on the specimen and 0.097 on the render, so the model is too pale, and the held-out bar profile only reaches r = 0.372. Those gaps keep this below the low 90s." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-specimen-match-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-specimen-match-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-specimen-match-3> ;
    pk:hasScore 8.4e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Holocene Gasterosteus aculeatus cellular Turing wavelength (56 µm) (Gasterosteus aculeatus)",
        "Holocene Gasterosteus aculeatus cellular Turing wavelength (56 µm) faithfully reproduces Gasterosteus aculeatus morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-turing-wavelength-s0-3> ;
    dct:description "The simulation script(s) models/2026-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Gasterosteus aculeatus specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0.py> ;
    schema:about "Gasterosteus aculeatus" ;
    schema:additionalProperty "does_not_claim: That 56 µm is resolved by the Krisp photograph",
        "does_not_claim: That plate number or Pitx1 is predicted",
        "does_not_claim: That the nonlinear benthic FFT peak equals 52.23 µm",
        "reconstructed_in_script: Chronospecies knob a = 0.28 / 0.20 / 0.14",
        "reconstructed_in_script: Diffusion pair and gamma fixed so Holocene analytic λ_c equals the assigned 56 µm",
        "reconstructed_in_script: Organ-scale bar cosine is fit on the anterior flank only",
        "reported_in_source: Greenwood 2011 genetic basis of juvenile stickleback pigment patterns",
        "reported_in_source: Miller 2007 Kitlg cis-regulatory reduction of freshwater pigmentation",
        "reported_in_source: Schnakenberg 1979 two-species kinetics",
        "reported_in_source: Tapanes & Rennison 2024 density and barring are different QTLs",
        "reported_in_source: Turing 1952 diffusion-driven instability and a selected wavenumber",
        "transfer_boundary: Nakamasu 2009 zebrafish pigment-cell interactions are not stickleback data" ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Gasterosteus aculeatus" ;

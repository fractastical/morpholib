sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Holocene Gasterosteus aculeatus cellular Turing wavelength (56 µm) faithfully reproduces Gasterosteus aculeatus morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Gasterosteus aculeatus specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0.py; output: docs/media/gasterosteus_aculeatus_turing_wavelength_s0_comparison.png; organism: Gasterosteus aculeatus; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 diffusion-driven instability and a selected wavenumber | Schnakenberg 1979 two-species kinetics | Miller 2007 Kitlg cis-regulatory reduction of freshwater pigmentation | Greenwood 2011 genetic basis of juvenile stickleback pigment patterns | Tapanes & Rennison 2024 density and barring are different QTLs; reconstructed_in_script: Diffusion pair and gamma fixed so Holocene analytic λ_c equals the assigned 56 µm | Chronospecies knob a = 0.28 / 0.20 / 0.14 | Organ-scale bar cosine is fit on the anterior flank only; transfer_boundary: Nakamasu 2009 zebrafish pigment-cell interactions are not stickleback data; does_not_claim: That 56 µm is resolved by the Krisp photograph | That the nonlinear benthic FFT peak equals 52.23 µm | That plate number or Pitx1 is predicted]; phenomenon_size: 32 µm (3.168e-05 m, log10=-4.499 m, tier=4_cellular_10um); species_scale_ladder (10 runs from 32 µm to 9.9 cm): 32 µm:gasterosteus-aculeatus-bioelectric-polarity, 118 µm:gasterosteus-aculeatus-vertex-packing, 2.2 mm:gasterosteus-aculeatus-turing-wavelength, 4.1 mm:gasterosteus-aculeatus-clock-wavefront, 9.6 mm:gasterosteus-aculeatus-elastic-buckling, 1.3 cm:gasterosteus-aculeatus-morphogen-condensation, 1.7 cm:gasterosteus-aculeatus-flux-canalization, 2.2 cm:gasterosteus-aculeatus-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/j.cell.2007.10.055>,
            <https://doi.org/10.1038/hdy.2011.1>,
            <https://doi.org/10.1038/s41437-024-00706-0>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-gasterosteus-aculeatus-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-gdnf-ret-ureteric-kidney> a pk:Claim ;
        rdfs:label "Menshykau & Iber (2013) & Short et al. (2014) GDNF-RET-Wnt11-Sprouty1 kidney ureteric bud Turing branching morphogenesis faithfully reproduces Mouse embryonic metanephric kidney ureteric bud & cap mesenchyme (Mus musculus, E11.5-E15.5) morphology" ;
        dcterms:description "The simulation script(s) 2014-menshykau-gdnf-ret-ureteric-kidney.py implement the cited source model as published and produce forms that match real Mouse embryonic metanephric kidney ureteric bud & cap mesenchyme (Mus musculus, E11.5-E15.5) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 92.7/100, audit 2026-10-19-gdnf-ret-ureteric-kidney-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/8871db0/2014-menshykau-gdnf-ret-ureteric-kidney.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2014-menshykau-gdnf-ret-ureteric-kidney.py; output: docs/media/gdnf_ret_ureteric_kidney_comparison.png; organism: Mouse embryonic metanephric kidney ureteric bud & cap mesenchyme (Mus musculus, E11.5-E15.5); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: ce5c8398e3a08e65321d450b66315cd37e3849e22cf0f960d5077e262860f3b9; artifact_sha256: 8ed95e1faa0495f0195cd2295d050033c61115d06b70efa577faf6bd2c435fa8; input_dataset_sha256: {datasets/gdnf_ret_ureteric_kidney/gdnf_ret_ureteric_kidney_reference.json=8f7910ca67a34e52..., datasets/gdnf_ret_ureteric_kidney/kidney_ureteric_tree_specimen.jpg=dceaf5044c7014e4..., datasets/gdnf_ret_ureteric_kidney/paper_citations.bib=62f203a6f4125269..., datasets/gdnf_ret_ureteric_kidney/scout_manifest.json=60b78a1876b45c42...}; supersedes_audit_id: 2026-10-19-gdnf-ret-ureteric-kidney-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.devcel.2004.12.004>,
            <https://doi.org/10.1016/j.devcel.2014.02.017>,
            <https://doi.org/10.1016/j.ydbio.2004.09.019>,
            <https://doi.org/10.1088/1478-3975/10/4/046003>,
            <https://doi.org/10.1172/JCI8256> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-specimen-match> ;
        pk:weightOfEvidence "0.927"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/8871db0/2014-menshykau-gdnf-ret-ureteric-kidney.py> a schema:SoftwareSourceCode ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "8871db0" .
}


    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013) & Short et al. (2014) GDNF-RET-Wnt11-Sprouty1 kidney ureteric bud Turing branching morphogenesis — Morphometric validation: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L1168-1271) computes 9 reference-anchored morphometric measurements with uncertainty and statistical tests: E11.5-E15.5 tip correlation r = 1.0000 (p = 4.8e-13, RMSE = 20.3 tips vs pure 2^g RMSE = 38.7), Horton-Strahler R_b = 2.059 (ref 2.08), Horton-Strahler R_L = 1.239 (ref 1.38), ampulla harmonic shift Δm = 1.0 (m=2 -> m=3), Spry1-/- vs WT tip ratio, BMP4 tip suppression ratio, Gdnf-/- agenesis negative control (0.0 tips), specimen WT tip count (13 vs ref 12), and specimen pErk1/2 signaling fold-change (38.65x)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-ampulla-circumferential-harmonic-transition-m-2-bifurcation-m-3-trifurcation>,

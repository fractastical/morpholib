sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-gdnf-ret-ureteric-kidney> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013) & Short et al. (2014) GDNF-RET-Wnt11-Sprouty1 kidney ureteric bud Turing branching morphogenesis — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements the coupled 4-species mesenchymal GDNF + epithelial RET + Wnt11 + Sprouty1 reaction-diffusion solver (`solve_gdnf_ret_wnt11_spry1_ampulla_pde`, L182-298), circumferential mode selection (`evaluate_ampulla_mode_selection`, L301-328), and 3D growing ureteric tree with exact Horton-Strahler stream ordering (`compute_horton_strahler_metrics` & `grow_ureteric_tree_3d`, L333-603) plus the Gdnf-/-/Ret-/- renal agenesis negative control (`rho_G = 0 -> 0 tips`), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_055_gdnf_ret_ureteric_kidney.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py L182–L328" ;
        dct:description "Coupled 4-species GDNF-RET-Wnt11-Sprouty1 PDE solver and m=1..4 ampulla harmonic mode selection" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2014-menshykau-gdnf-ret-ureteric-kidney.py#L182-L328> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py L333–L603" ;
        dct:description "3D growing ureteric tree solver across g=1..8 and exact Horton-Strahler R_b and R_L ordering" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2014-menshykau-gdnf-ret-ureteric-kidney.py#L333-L603> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_055_gdnf_ret_ureteric_kidney.lean L11–L90" ;
        dct:description "3 machine-checked Lean 4 theorems for Turing instability, ampulla mode transition, and renal agenesis / Spry1-/- budding (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_055_gdnf_ret_ureteric_kidney.lean#L11-L90> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 055 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-fgf10-shh-lung-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2012-menshykau-fgf10-shh-lung-turing.py L945–L1057" ;
        dcterms:description "7 conditions + stromal_ablation / no-sink / dihedral-ablation controls evaluated across generations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L945-L1057> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2012-menshykau-fgf10-shh-lung-turing.py L1676–L1702" ;
        dcterms:description "CLI --a-ret --b-gdnf --gamma --d-ratio --generations --seed --k-bmp --k-grem --k-fgf7 --no-stroma wired via stromal_overrides into render_outputs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L1676-L1702> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Loop 054 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013), Zubkov et al. (2015) & Watanabe & Costantini (2004) kidney ureteric bud GDNF-RET-Wnt11 Turing branching morphogenesis with stromal BMP4/7-Gremlin1-FGF7 feedback and reduced-3D ampulla necking — Parameter expressivity: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The parameter space is substantially richer: rho_tip sweeps across four regimes with two seeding modes (`evaluate_tip_splitting_regimes`, L445-472), 7 genetic/bead conditions (WT, Gdnf+/-, Spry1-/-, GDNF bead, Grem1-/-, Fgf7-/-, Bmp4+/-) plus no-sink, equal-diffusion and stromal-ablation controls (`evaluate_all_conditions_and_generations`, L945-1057), a daughter-dome aspect-ratio sweep for axis selection (Panel I, L1349-1362) and a dihedral ablation (L1023), and the CLI exposes `--a-ret --b-gdnf --gamma --d-ratio --generations --seed --k-bmp --k-grem --k-fgf7 --no-stroma` (L1676-1685), all wired through `render_outputs(stromal_overrides=...)` into every tree call and the GIF (L1687-1702). Deductions: the generational bifurcation half-angles are hard-coded (L856) so the branch-angle axis of the morphospace is not parameter-controlled (-5); `gain_wt_ref`, `g_ref = 0.60`, `size_jitter_sd = 0.08` (L726-728), `R_TIP_WT_DEFAULT` and `TIP_RADIUS_SIGNAL_EXPONENT` (L102-103) and the `r_tip *= 0.92` cascade decay (L577) are fixed calibrations not exposed or swept (-4); the Bmp4+/- `bmp_scale = 0.75` is an assumption (-2); no sweep shows the staircase flipping under `--k-*` (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2012-menshykau-fgf10-shh-lung-turing.py L726–L728: gain_wt_ref, g_ref, size_jitter_sd fixed model-scale calibrations placed to hit rho_WT ~ 2 <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L726-L728>",
            "2012-menshykau-fgf10-shh-lung-turing.py L856–L862: base_half_deg hard-codes 51/42.5/41-1.4g half-angles; no-sink ablation only scales by 0.62 <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L856-L862>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-parameter-expressivity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


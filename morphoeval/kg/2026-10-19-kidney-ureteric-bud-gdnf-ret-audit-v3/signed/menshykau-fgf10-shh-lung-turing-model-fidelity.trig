sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-fgf10-shh-lung-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013), Zubkov et al. (2015) & Watanabe & Costantini (2004) kidney ureteric bud GDNF-RET-Wnt11 Turing branching morphogenesis with stromal BMP4/7-Gremlin1-FGF7 feedback and reduced-3D ampulla necking — Model fidelity to source: 84/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The core Menshykau & Iber (2013) receptor-ligand system (steady state, flux cancellation, dispersion relation, lambda_c = 0.4726) is implemented correctly (L163-270) and the three Pass 3 additions are genuine mechanisms rather than relabelled prescriptions: the stromal gain law is a monotone BMP/Gremlin1/FGF7 function (L649-667) whose spatial fields (L774-789) set the per-tip ampulla radius and hence rho_tip and the splitting multiplicity (L835-852), the moving boundary advances the dome with the JSON growth law v_n = v0 max(0, R^2 G - S_thr) and re-solves the cap PDE on the current arc (L587-647), and the axis-selection argument compares Re sigma(2 pi/L) along the two principal arcs (L491-537). Deductions: the band-seeded cap solver seeds the cosine mode of the band-predicted m (L367-378), so the m = 1..4 staircase is an initial-condition artefact, and the noise-seeded control (L380-383) selects [2, 3, 5, 5] because the two-lobe mode sits on the rising flank of sigma(k) (-6); the hypoplasia parameter set b = 0.45 has Tr J_0 > 0 and is outside the Turing regime, now labelled (L1204) but still used for the hypoplasia tree (-3); the moving boundary is 1D on the dome with no curvature/surface-tension term, no re-meshing and no 3D, and the 90 deg dihedral rests on `daughter_long_axis_parallel` (L544, L569) rather than dynamics (-3); the cap kinetics use a saturating cubic R^2 G/(1 + 0.18 (R - R*)^2) (L403) that is not in the paper (-2); BMP4/BMP7 share one quasi-static field and `compute_turing_phase_space` (L272-310) is dead code with a term multiplied by 0.0 (L299) (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2012-menshykau-fgf10-shh-lung-turing.py L1204–L1204: Panel A labels the hypoplasia set b = 0.45 as Tr J_0 > 0, outside the Turing regime; the hypoplasia tree still uses it <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L1204-L1204>",
            "2012-menshykau-fgf10-shh-lung-turing.py L272–L310: compute_turing_phase_space is never called and sigma_proxy multiplies a term by 0.0 <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L272-L310>",
            "2012-menshykau-fgf10-shh-lung-turing.py L367–L383: Band-seeded cosine initial condition for the predicted m versus the noise-seeded honesty control; the staircase is conditioned on its own seed <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L367-L383>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-5> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2012-menshykau-fgf10-shh-lung-turing.py L163–L270" ;
        dcterms:description "GDNF-RET steady state, Jacobian, dispersion relation and lambda_c (Menshykau & Iber 2013 Eqs. 3-6)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L163-L270> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2012-menshykau-fgf10-shh-lung-turing.py L649–L667" ;
        dcterms:description "stromal_signaling_gain: gamma_eff = gamma (1 + k_F7 FGF7)/(1 + k_B BMP/(1 + k_G GREM1)); constants stated as model-scale calibrations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L649-L667> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2012-menshykau-fgf10-shh-lung-turing.py L774–L852" ;
        dcterms:description "Spatial BMP/Gremlin1/FGF7 fields and per-tip eff_signal -> R_tip -> rho_tip -> splitting multiplicity (replaces Pass 2 prescribed multiplicities)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L774-L852> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2012-menshykau-fgf10-shh-lung-turing.py L491–L647" ;
        dcterms:description "select_splitting_axis (rho_flip = k_c/k_fastest), dihedral_rotation_cascade (explicit daughter-orientation assumption) and 1D Lagrangian moving-boundary necking" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L491-L647> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_054_kidney_ureteric_bud_gdnf_ret.lean L46–L235" ;
        dcterms:description "5 machine-checked Lean 4 theorems (0 sorrys): Laws 1-3 from Pass 2 plus stromal gain monotonicity (L183) and orthogonal dihedral cascade (L223)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_054_kidney_ureteric_bud_gdnf_ret.lean#L46-L235> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Loop 054 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


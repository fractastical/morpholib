sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-fgf10-shh-lung-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2012-menshykau-fgf10-shh-lung-turing.py L1596–L1668" ;
        dcterms:description "9-suite automated self_test() including stromal law (Suite 7), necking & dihedral (Suite 8) and 14-metric bitwise determinism (Suite 9)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L1596-L1668> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2012-menshykau-fgf10-shh-lung-turing.py L1670–L1709" ;
        dcterms:description "CLI entry point with --self-test, --skip-gif and parameter/stromal overrides" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L1670-L1709> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "requirements.lock.txt L1–L10" ;
        dcterms:description "Exact pip freeze matching the venv used for the audit runs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/requirements.lock.txt#L1-L10> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Loop 054 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013), Zubkov et al. (2015) & Watanabe & Costantini (2004) kidney ureteric bud GDNF-RET-Wnt11 Turing branching morphogenesis with stromal BMP4/7-Gremlin1-FGF7 feedback and reduced-3D ampulla necking — Reproducibility package: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`self_test()` (L1596-1668) runs 9 suites in ~1.5 s: SHA-256 integrity, Lean Laws 1-2 identities, equal-diffusion ablation, IMEX modes, tree perturbation ordering (hypo < WT < bead < Spry1), specimen 12 vs 6, stromal law and ordering (Suite 7), necking/dihedral/axis selection/rho_flip (Suite 8) and two-run bitwise determinism of all 14 metrics (Suite 9); per-condition seeding is a SHA-256 digest of the condition name (L719), replacing Pass 2's process-salted `hash()`; the default render takes 1.74 s and regenerates the PNG and 6-frame GIF; `requirements.lock.txt` pins the venv (Python 3.14.7, numpy 2.5.4, scipy 1.16.3, matplotlib 3.10.7, Pillow 12.0.0). Deductions: the comparison PNG is gitignored (`*.png`) so the committed artifact is the GIF only (-3); Suite 4 still asserts the band-seeded staircase rather than the noise-seeded result, so the self-test encodes the circular check (-3); no byte-level SHA of the rendered PNG/GIF is asserted (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2012-menshykau-fgf10-shh-lung-turing.py L1614–L1617: Suite 4 asserts the band-seeded staircase [1, 2, 3, 4], not the noise-seeded honesty control <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L1614-L1617>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-repro-package-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


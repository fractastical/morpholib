    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-segmented-e12-5-mouse-metanephros-gfp-ureteric-bud-tip-count-panel-a-wild-type-control-reference> a schema:PropertyValue ;

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-grem1-stromal-bmp-de-repression-failure-e12-5-tip-ratio-vs-wt> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Grem1-/- stromal BMP de-repression failure: E12.5 tip ratio vs WT = 0.4375 Grem1-/- to WT E12.5 tip ratio" ;
        dct:description "Observed ratio encodes 'arrested branching' qualitatively (see JSON obs_note); the model shows arrest after generation 3 rather than complete outgrowth failure." ;
        schema:measurementTechnique "simulate_coupled_ureteric_tree(stromal={grem_scale: 0}) / WT at generation 4; mean gamma_eff/gamma = 0.397, mean rho_tip = 1.366" ;
        schema:name "Grem1-/- stromal BMP de-repression failure: E12.5 tip ratio vs WT" ;
        schema:unitText "Grem1-/- to WT E12.5 tip ratio" ;
        schema:value "0.4375" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-grem1-stromal-bmp-de-repression-failure-e12-5-tip-ratio-vs-wt-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-grem1-stromal-bmp-de-repression-failure-e12-5-tip-ratio-vs-wt-reference> a schema:PropertyValue ;
        schema:value "0.08" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-mean-dihedral-rotation-angle-between-successive-splitting-planes-anisotropic-dome-cascade-4-generations> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Mean dihedral rotation angle between successive splitting planes (anisotropic-dome cascade, 4 generations) = 90.0 deg" ;
        dct:description "Outcome depends on the stated daughter-orientation assumption; the linear short-axis selection itself is the model result. Kidney dihedral distributions were not vendored offline." ;
        schema:measurementTechnique "dihedral_rotation_cascade(R_tip=0.255, e=1.30, daughters elongated along parent T-bar): per-generation [90.0, 90.0, 90.0, 90.0]; orthogonal-daughter ablation gives 0 deg; rho_flip = k_c/k_fastest = 0.938" ;
        schema:name "Mean dihedral rotation angle between successive splitting planes (anisotropic-dome cascade, 4 generations)" ;
        schema:unitText "deg" ;
        schema:value "90.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-mean-dihedral-rotation-angle-between-successive-splitting-planes-anisotropic-dome-cascade-4-generations-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-mean-dihedral-rotation-angle-between-successive-splitting-planes-anisotropic-dome-cascade-4-generations-reference> a schema:PropertyValue ;
        schema:value "90.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-moving-boundary-ampulla-necking-index-of-the-wt-dichotomous-cap-1-r-cleft-r-lobe> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Moving-boundary ampulla necking index of the WT dichotomous cap (1 - r_cleft / r_lobe) = 0.2025 dimensionless necking index (0 = no cleft)" ;
        dct:description "Reduced 1D Lagrangian interface (no 3D surface, no surface tension); conditioned on the band-seeded two-lobe mode. Positive index = cleft/neck forms." ;
        schema:measurementTechnique "simulate_moving_boundary_ampulla_necking(R_tip=0.30, 14 growth steps, v_n = v0 max(0, R^2G - b)); elongation cap 0.162, trichotomous cap 0.259; lobe asymmetry 2.50e-12" ;
        schema:name "Moving-boundary ampulla necking index of the WT dichotomous cap (1 - r_cleft / r_lobe)" ;
        schema:unitText "dimensionless necking index (0 = no cleft)" ;
        schema:value "0.2025" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-noise-seeded-ampulla-tip-splitting-peak-count-agreement-with-the-band-map-1-2-3-4-honesty-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Noise-seeded ampulla tip-splitting peak-count agreement with the band map [1, 2, 3, 4] (honesty control) = 0.0 regimes (of 4) whose noise-seeded peak count equals the band-map prediction" ;
        dct:description "The band-seeded staircase is conditioned on its own initial condition; noise seeding selects ~L/lambda_fastest + 1 maxima. Open item carried to Pass 4." ;
        schema:measurementTechnique "solve_ampulla_cap_imex(seed_mode='noise') across the 4 reference tip radii -> peaks [2, 3, 5, 5] vs band map [1, 2, 3, 4] (band-seeded run: 4/4)" ;
        schema:name "Noise-seeded ampulla tip-splitting peak-count agreement with the band map [1, 2, 3, 4] (honesty control)" ;
        schema:unitText "regimes (of 4) whose noise-seeded peak count equals the band-map prediction" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-noise-seeded-ampulla-tip-splitting-peak-count-agreement-with-the-band-map-1-2-3-4-honesty-control-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-noise-seeded-ampulla-tip-splitting-peak-count-agreement-with-the-band-map-1-2-3-4-honesty-control-reference> a schema:PropertyValue ;
        schema:value "4.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-segmented-e12-5-mouse-metanephros-gfp-ureteric-bud-tip-count-panel-a-wild-type-control> a schema:PropertyValue,

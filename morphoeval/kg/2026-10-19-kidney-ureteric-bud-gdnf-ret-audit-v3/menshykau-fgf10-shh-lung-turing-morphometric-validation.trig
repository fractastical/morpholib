    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-fgf7-stromal-growth-factor-loss-e12-5-tip-ratio-vs-wt-reference> a schema:PropertyValue ;
        schema:value "0.7" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-gdnf-and-prr-ub-hypoplastic-e12-5-ureteric-tip-reduction-ratio-vs-wt-control> a schema:PropertyValue,

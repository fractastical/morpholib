        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-gdnf-and-prr-ub-hypoplastic-e12-5-ureteric-tip-reduction-ratio-vs-wt-control-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-gdnf-and-prr-ub-hypoplastic-e12-5-ureteric-tip-reduction-ratio-vs-wt-control-reference> a schema:PropertyValue ;
        schema:value "0.4" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-generational-ureteric-bifurcation-angle-rmse-across-e11-5-e13-5-vs-no-sink-ablation-control> a schema:PropertyValue,
            pk:EvidenceItem ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-fgf10-shh-lung-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013), Zubkov et al. (2015) & Watanabe & Costantini (2004) kidney ureteric bud GDNF-RET-Wnt11 Turing branching morphogenesis with stromal BMP4/7-Gremlin1-FGF7 feedback and reduced-3D ampulla necking — Morphometric validation: 76/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1413-1589) now reports 14 metrics with references and dispersion statistics: lambda_c = 0.4726 (exact), WT tip Pearson r = 0.9903 (p ~ 1e-5) and Horton-Strahler R_b, generational angle RMSE 2.92 deg, Spry1-/- and bead ratios, hypoplasia ratio 0.3125 (ref 0.4), specimen 12/6 tips, plus six Pass 3 metrics (noise-seeded staircase agreement 0/4, necking index 0.2025, dihedral 90.0 deg (ref 90), Grem1-/- 0.4375 (ref 0.08), Fgf7-/- 1.00 (ref 0.70), Bmp4+/- 1.8125 (ref 1.20)), all bitwise deterministic across two runs. The honesty control is credited for being reported rather than hidden. Deductions: the band-seeded \"4/4 exact mode matches\" metric is circular and the honest control scores 0/4 (-6); angle RMSE is self-referential because half-angles are prescribed from the same table (L856) (-4); the Watanabe & Costantini generation table and the perturbation means (28.5, 5.2, 21.0 tips; 0.88/0.12 fractions) and the Pearson reference 0.9985 are not traceable to a figure or table (-5); three new stromal ratios miss their qualitative references by 2-5x and Spry1-/- overshoots 3.875 vs 2.19 after removing hand-placed buds (-5); the necking index has no reference value; conditions use different RNG streams (SHA-256 of the condition name, L719) so WT vs mutant are not seed-matched (-2); the 90 deg dihedral match is guaranteed by the orientation assumption (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2012-menshykau-fgf10-shh-lung-turing.py L1438–L1450: Noise-seeded staircase gives [2, 3, 5, 5] vs band map [1, 2, 3, 4]: the Pass 2 4/4 metric was conditioned on its seed <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L1438-L1450>",
            "2012-menshykau-fgf10-shh-lung-turing.py L719–L719: Per-condition RNG seed = SHA-256 digest of the condition name; WT vs perturbation comparisons are not seed-matched <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L719-L719>",
            "2012-menshykau-fgf10-shh-lung-turing.py L856–L859: Prescribed generational half-angles make the angle-RMSE metric self-referential <https://github.com/fractastical/morpholib/blob/028758bc/2012-menshykau-fgf10-shh-lung-turing.py#L856-L859>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-bmp4-reduced-stromal-inhibition-e12-5-tip-ratio-vs-wt-ectopic-supernumerary-budding>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-e11-0-e13-5-wild-type-ureteric-bud-tip-count-correlation-pearson-r-vs-watanabe-costantini-2004>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-fgf7-stromal-growth-factor-loss-e12-5-tip-ratio-vs-wt>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-gdnf-and-prr-ub-hypoplastic-e12-5-ureteric-tip-reduction-ratio-vs-wt-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-generational-ureteric-bifurcation-angle-rmse-across-e11-5-e13-5-vs-no-sink-ablation-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-grem1-stromal-bmp-de-repression-failure-e12-5-tip-ratio-vs-wt>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-mean-dihedral-rotation-angle-between-successive-splitting-planes-anisotropic-dome-cascade-4-generations>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-moving-boundary-ampulla-necking-index-of-the-wt-dichotomous-cap-1-r-cleft-r-lobe>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-noise-seeded-ampulla-tip-splitting-peak-count-agreement-with-the-band-map-1-2-3-4-honesty-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-segmented-e12-5-mouse-metanephros-gfp-ureteric-bud-tip-count-panel-a-wild-type-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-segmented-e12-5-mouse-metanephros-wt-to-mutant-ureteric-tip-multiplicity-ratio-panel-a-vs-panel-b>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-spry1-hyper-branching-exogenous-gdnf-bead-supernumerary-e12-5-tip-count-ratio-vs-wt-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-ureteric-ampulla-tip-splitting-mode-transition-accuracy-across-rho-tip-pi-r-tip-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-wild-type-gdnf-ret-homogeneous-steady-state-signaling-r-2-g-critical-turing-wavelength-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-morphometric-validation-2> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-bmp4-reduced-stromal-inhibition-e12-5-tip-ratio-vs-wt-ectopic-supernumerary-budding> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Bmp4+/- reduced stromal inhibition: E12.5 tip ratio vs WT (ectopic/supernumerary budding) = 1.8125 Bmp4+/- to WT E12.5 tip ratio" ;
        dct:description "Observed 1.20 encodes supernumerary budding qualitatively (incomplete penetrance; see JSON obs_note)." ;
        schema:measurementTechnique "simulate_coupled_ureteric_tree(stromal={bmp_scale: 0.5}) / WT at generation 4; stromal-ablation control (all scales 0) gives 1.125" ;
        schema:name "Bmp4+/- reduced stromal inhibition: E12.5 tip ratio vs WT (ectopic/supernumerary budding)" ;
        schema:unitText "Bmp4+/- to WT E12.5 tip ratio" ;
        schema:value "1.8125" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-bmp4-reduced-stromal-inhibition-e12-5-tip-ratio-vs-wt-ectopic-supernumerary-budding-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-bmp4-reduced-stromal-inhibition-e12-5-tip-ratio-vs-wt-ectopic-supernumerary-budding-reference> a schema:PropertyValue ;
        schema:value "1.2" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-e11-0-e13-5-wild-type-ureteric-bud-tip-count-correlation-pearson-r-vs-watanabe-costantini-2004> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "E11.0-E13.5 wild-type ureteric bud tip count correlation (Pearson r vs Watanabe & Costantini 2004) = 0.99028 Pearson r across 7 embryonic stages (E11.0-E13.5)" ;
        dct:description "Horton-Strahler bifurcation ratio R_b = 1.932 vs reference 2.04 ± 0.08" ;
        schema:measurementTechnique "simulate_coupled_ureteric_tree(WT_control, g=0..6) vs Watanabe & Costantini (2004) tip progression (p=1.78e-05, RMSE=4.44 tips)" ;
        schema:name "E11.0-E13.5 wild-type ureteric bud tip count correlation (Pearson r vs Watanabe & Costantini 2004)" ;
        schema:unitText "Pearson r across 7 embryonic stages (E11.0-E13.5)" ;
        schema:value "0.99028" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-e11-0-e13-5-wild-type-ureteric-bud-tip-count-correlation-pearson-r-vs-watanabe-costantini-2004-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-e11-0-e13-5-wild-type-ureteric-bud-tip-count-correlation-pearson-r-vs-watanabe-costantini-2004-reference> a schema:PropertyValue ;
        schema:value "0.9985" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-fgf7-stromal-growth-factor-loss-e12-5-tip-ratio-vs-wt> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Fgf7-/- stromal growth-factor loss: E12.5 tip ratio vs WT = 1.0 Fgf7-/- to WT E12.5 tip ratio" ;
        dct:description "Reference is the approximate late deficit (nephron number), not an E12.5 tip count." ;
        schema:measurementTechnique "simulate_coupled_ureteric_tree(stromal={fgf7_scale: 0}) / WT at generation 4; mean gamma_eff/gamma = 0.639; generation-6 tips 41 vs WT 51" ;
        schema:name "Fgf7-/- stromal growth-factor loss: E12.5 tip ratio vs WT" ;
        schema:unitText "Fgf7-/- to WT E12.5 tip ratio" ;
        schema:value "1.0" ;

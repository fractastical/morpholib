    <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Lewis (2003) zebrafish her1/her7 autoinhibitory delay differential oscillator and DeltaC-Notch synchronization — Reproducibility package: 62/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Includes `--self-test` and deterministic seed=2003, requiring full verification of total delay invariance (T_m - delta, T_p + delta), subcritical intron-deletion damping, cycloheximide translation block (a=0), and Notch mutant 6-somite anterior preservation in Pass 2." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-repro-package-1> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .


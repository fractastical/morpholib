sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lewis-her1-her7-delayed-oscillator> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Lewis (2003) zebrafish her1/her7 autoinhibitory delay differential oscillator and DeltaC-Notch synchronization — Parameter expressivity: 58/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Covers wild-type Danio rerio PSM parameters at 28 C (a=4.5, b=c=0.23 min^-1, k=33, p0=40, n=2), but needs all 5 experimental regimes (WT coupled her1/her7, pure her7 fast loop, pure her1 slow loop, DeltaC-Notch collective delay slowing, and intron-deletion / CHX ablation) plus a 2D Hopf bifurcation & period morphospace T_osc(T_m + T_p, b)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2003-lewis-her1-her7-delayed-oscillator.py L260–L300: 5-regime Lewis (2003) / Giudicelli (2007) / Herrgen (2010) evaluator <https://github.com/fractastical/morpholib/blob/317bc3c/2003-lewis-her1-her7-delayed-oscillator.py#L260-L300>" ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-gdnf-ret-ureteric-kidney> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2014-menshykau-gdnf-ret-ureteric-kidney.py L33–L77" ;
        dcterms:description "Exact Schnakenberg GDNF-RET steady state and linearized Turing dispersion polynomial" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2014-menshykau-gdnf-ret-ureteric-kidney.py#L33-L77> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 055 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013) & Short et al. (2014) GDNF-RET-Wnt11-Sprouty1 kidney ureteric bud Turing branching morphogenesis — Model fidelity to source: 58/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes the exact homogeneous steady state (R*, G*) = (a + rho_G, rho_G/(a+rho_G)^2) and Schnakenberg Turing dispersion relation Re(lambda(k)) (L33-77), backed by 3 Lean 4 theorems in `Loop_055_gdnf_ret_ureteric_kidney.lean`. However, it does not numerically integrate the 2D coupled mesenchymal GDNF + epithelial RET + Wnt11 + Sprouty1 reaction-diffusion PDEs or grow a spatial ureteric tree, and omits the Gdnf-/-/Ret-/- renal agenesis negative control." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2014-menshykau-gdnf-ret-ureteric-kidney.py L80–L97: Uses ideal 2^g tip power law without coupled reaction-diffusion PDE or growing ureteric tree solver <https://github.com/fractastical/morpholib/blob/8871db0/2014-menshykau-gdnf-ret-ureteric-kidney.py#L80-L97>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-model-fidelity-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


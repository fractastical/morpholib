sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-gdnf-ret-ureteric-kidney> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013) & Short et al. (2014) GDNF-RET-Wnt11-Sprouty1 kidney ureteric bud Turing branching morphogenesis — Parameter expressivity: 48/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates wild-type Turing dispersion and generation index g=1..8 (L53-97), but omits the circumferential ampulla radius sweep across m=1,2,3,4 modes, omits the 5-condition genetic/signaling perturbation suite (WT, Spry1-/-, GDNF bead, BMP4 stalk inhibition, Gdnf-/-/Ret-/- agenesis), and exposes no CLI parameter overrides (L188-205)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2014-menshykau-gdnf-ret-ureteric-kidney.py L188–L205: CLI exposes only --self-test, --verify-only, and --skip-gif without physical parameter overrides <https://github.com/fractastical/morpholib/blob/8871db0/2014-menshykau-gdnf-ret-ureteric-kidney.py#L188-L205>" ;
        pk:hasScore "0.48"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 055 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/menshykau-gdnf-ret-ureteric-kidney-1>,
        <https://w3id.org/probknow/resource/math-law/menshykau-gdnf-ret-ureteric-kidney-2>,
        <https://w3id.org/probknow/resource/math-law/menshykau-gdnf-ret-ureteric-kidney-3> .

<https://w3id.org/probknow/resource/math-law/menshykau-gdnf-ret-ureteric-kidney-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Menshykau & Iber (2013) Schnakenberg-Type GDNF-RET Cooperative Binding Turing Instability Law" ;
    dct:description "Establishes that cooperative binding of fast-diffusing GDNF to slow-diffusing RET dimers (L + 2R -> R^2L) generates self-organizing R^2G signaling caps at ureteric bud tips | Variables: R: epithelial RET receptor density; G: mesenchymal GDNF ligand concentration; d = D_G/D_R: ligand-to-receptor diffusion ratio; f_R, g_L: Jacobian self-activation and ligand-depletion derivatives" ;
    dct:source "Menshykau & Iber (2013) Phys. Biol. 10(4):046003 Eqs. (1)-(5) & Table 1" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2014-menshykau-gdnf-ret-ureteric-kidney.py#L120-L215>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_055_gdnf_ret_ureteric_kidney.lean#L27-L36> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def gdnf_ret_turing_driver (d f_R g_L : Int) : Int :=
  d * f_R + g_L
theorem menshykau_gdnf_ret_turing_instability (d g_abs : Nat) :
    gdnf_ret_turing_driver 50 8 (-10) = 390 ∧
    gdnf_ret_turing_driver 1 8 (-10) = -2 ∧
    gdnf_ret_turing_driver (Int.ofNat (g_abs + d + 1)) 1 (-(Int.ofNat g_abs)) = Int.ofNat (d + 1)
"""^^pk:lean4 ;
    skos:notation "∂R/∂t = D_R ∇²R + γ(a - R + R²G),  ∂G/∂t = D_G ∇²G + γ(ρ_G - R²G);  d·f_R + g_L > 2√(d·det J) > 0 for d = D_G/D_R = 50 ≫ 1, m = 2 > 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2004.12.004>,
        <https://doi.org/10.1016/j.devcel.2014.02.017>,
        <https://doi.org/10.1016/j.ydbio.2004.09.019>,
        <https://doi.org/10.1088/1478-3975/10/4/046003> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Schnakenberg-Type GDNF-RET Cooperative Ligand-Receptor Turing Reaction-Diffusion & Horton-Strahler Ureteric Tree Branching" ;
    pk:leanDeclaration "MathOfBiology.Loop_055.gdnf_ret_turing_driver" ;
    pk:leanTheorem "MathOfBiology.Loop_055.menshykau_gdnf_ret_turing_instability" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/menshykau-gdnf-ret-ureteric-kidney-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Menshykau & Iber (2013) & Short et al. (2014) Ureteric Ampulla Dichotomous vs Trichotomous Mode Selection Law" ;
    dct:description "Predicts the transition from canonical dichotomous bifurcation (88% of wild-type E11.5-E15.5 events) to trichotomous ampulla splitting when tip swelling exceeds the m=3 harmonic threshold | Variables: R_tip: ureteric ampulla tip radius; ℓ_c = λ_c / (2π): critical Turing length scale; m*: dominant circumferential splitting harmonic (m=2 bifurcation vs m=3 trifurcation)" ;
    dct:source "Menshykau & Iber (2013) Phys. Biol. 10:046003 Figs. 3-5; Short et al. (2014) Dev. Cell 29:188-202 Figs. 2-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2014-menshykau-gdnf-ret-ureteric-kidney.py#L220-L310>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_055_gdnf_ret_ureteric_kidney.lean#L49-L65> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def ureteric_tip_harmonic_mode (k2_R_tip ell_c : Nat) : Nat :=
  if ell_c == 0 then 0
  else if k2_R_tip < 2 * ell_c then 1
  else if k2_R_tip < 3 * ell_c then 2
  else 3
theorem menshykau_ureteric_tip_mode_selection (ell_c excess : Nat) :
    ureteric_tip_harmonic_mode 20 10 = 2 ∧
    ureteric_tip_harmonic_mode 32 10 = 3 ∧
    ureteric_tip_harmonic_mode (3 * (ell_c + 1) + excess) (ell_c + 1) = 3
"""^^pk:lean4 ;
    skos:notation "m* = argmax_m Re(λ(k_m)),  k_m = m / R_tip:  2 ℓ_c ≤ k_2 R_tip < 3 ℓ_c ⇒ m* = 2 (lateral bifurcation);  k_2 R_tip ≥ 3 ℓ_c ⇒ m* = 3 (planar/tetrahedral trifurcation)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2004.12.004>,
        <https://doi.org/10.1016/j.devcel.2014.02.017>,
        <https://doi.org/10.1016/j.ydbio.2004.09.019>,
        <https://doi.org/10.1088/1478-3975/10/4/046003> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Schnakenberg-Type GDNF-RET Cooperative Ligand-Receptor Turing Reaction-Diffusion & Horton-Strahler Ureteric Tree Branching" ;
    pk:leanDeclaration "MathOfBiology.Loop_055.ureteric_tip_harmonic_mode" ;
    pk:leanTheorem "MathOfBiology.Loop_055.menshykau_ureteric_tip_mode_selection" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/menshykau-gdnf-ret-ureteric-kidney-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Watanabe & Costantini (2004) & Basson et al. (2005) Gdnf-/-/Ret-/- Renal Agenesis & Spry1-/- Ectopic Budding Law" ;
    dct:description "Accounts for complete renal agenesis in Gdnf-/- or Ret-/- null kidneys and supernumerary ectopic budding upon Sprouty1 deletion | Variables: ρ_G: mesenchymal GDNF synthesis rate; γ_R: effective RET receptor gain modulated by Sprouty1 antagonism; v_tip: normal tip outgrowth velocity; N_tips: terminal ureteric bud tip count" ;
    dct:source "Watanabe & Costantini (2004) Dev. Biol. 271:98-106; Basson et al. (2005) Dev. Cell 8:229-239" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2014-menshykau-gdnf-ret-ureteric-kidney.py#L315-L450>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_055_gdnf_ret_ureteric_kidney.lean#L78-L90> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def ureteric_tip_growth_flux (rho_G gamma_R : Nat) : Nat :=
  if rho_G == 0 then 0 else rho_G + gamma_R
theorem menshykau_gdnf_ret_agenesis_and_spry1_budding (rho_G gamma_wt d_gamma : Nat) :
    ureteric_tip_growth_flux 0 gamma_wt = 0 ∧
    ureteric_tip_growth_flux (rho_G + 1) (gamma_wt + d_gamma + 1) >
      ureteric_tip_growth_flux (rho_G + 1) gamma_wt
"""^^pk:lean4 ;
    skos:notation "v_tip ∝ ρ_G γ_R max(0, R²G - C_th):  ρ_G = 0 ⇒ v_tip = 0 (renal agenesis);  γ_R(Spry1-/-) = γ_wt + Δγ > γ_wt ⇒ N_tips(Spry1-/-) > N_tips(WT)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2004.12.004>,
        <https://doi.org/10.1016/j.devcel.2014.02.017>,
        <https://doi.org/10.1016/j.ydbio.2004.09.019>,
        <https://doi.org/10.1088/1478-3975/10/4/046003> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Schnakenberg-Type GDNF-RET Cooperative Ligand-Receptor Turing Reaction-Diffusion & Horton-Strahler Ureteric Tree Branching" ;
    pk:leanDeclaration "MathOfBiology.Loop_055.ureteric_tip_growth_flux" ;
    pk:leanTheorem "MathOfBiology.Loop_055.menshykau_gdnf_ret_agenesis_and_spry1_budding" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,

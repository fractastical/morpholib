sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-gdnf-ret-ureteric-kidney> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-gdnf-ret-ureteric-kidney-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013) & Short et al. (2014) GDNF-RET-Wnt11-Sprouty1 kidney ureteric bud Turing branching morphogenesis — Morphometric validation: 56/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L156-178) returns only 2 metrics (steady-state R*^2*G* and ideal 2^g tip correlation with high RMSE = 46.8 tips), without measuring Horton-Strahler bifurcation ratio R_b, length ratio R_L, circumferential mode selection, perturbation deltas, or computer-vision specimen tip/calyx metrics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2014-menshykau-gdnf-ret-ureteric-kidney.py L156–L178: Only 2 baseline metrics in measure_morphoeval() without Horton-Strahler ratios or specimen CV metrics <https://github.com/fractastical/morpholib/blob/8871db0/2014-menshykau-gdnf-ret-ureteric-kidney.py#L156-L178>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-gdnf-ret-homogeneous-steady-state-signaling-complex-r-2-g>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-ureteric-generation-tip-count-correlation-short-et-al-2014-g-1-8> ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-gdnf-ret-homogeneous-steady-state-signaling-complex-r-2-g> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "GDNF-RET homogeneous steady-state signaling complex R*^2 G* = 0.9 dimensionless" ;
        dct:description "trace = -0.2000, det = 1.0000" ;
        schema:measurementTechnique "Analytical evaluation of (a + rho_G)^2 * (rho_G / (a + rho_G)^2) at WT parameters" ;
        schema:name "GDNF-RET homogeneous steady-state signaling complex R*^2 G*" ;
        schema:unitText "dimensionless" ;
        schema:value "0.9" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-gdnf-ret-homogeneous-steady-state-signaling-complex-r-2-g-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-gdnf-ret-homogeneous-steady-state-signaling-complex-r-2-g-reference> a schema:PropertyValue ;
        dct:source "Menshykau & Iber (2013) Phys. Biol. 10:046003 Table 1" ;
        schema:value "0.9" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-ureteric-generation-tip-count-correlation-short-et-al-2014-g-1-8> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Ureteric generation tip count correlation (Short et al. 2014 g=1..8) = 0.9999 Pearson r" ;
        dct:description "RMSE = 38.73 tips (2^g underpredicts due to ~12% early trifurcations)" ;
        schema:measurementTechnique "Correlation of symmetric 2^g dichotomous model vs Short et al. (2014) OPT tips (p=4.54e-12, RMSE=38.73)" ;
        schema:name "Ureteric generation tip count correlation (Short et al. 2014 g=1..8)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-ureteric-generation-tip-count-correlation-short-et-al-2014-g-1-8-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-gdnf-ret-ureteric-kidney-measurement-ureteric-generation-tip-count-correlation-short-et-al-2014-g-1-8-reference> a schema:PropertyValue ;
        dct:source "Short et al. (2014) Dev. Cell 29:188-202 Fig. 2" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 055 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


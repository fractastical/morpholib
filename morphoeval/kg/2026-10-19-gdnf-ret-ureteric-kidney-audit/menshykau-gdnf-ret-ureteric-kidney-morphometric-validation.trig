    <https://doi.org/10.1016/j.devcel.2004.12.004> dct:date "2005"^^xsd:gYear ;
        dct:title "Sprouty1 is a critical regulator of GDNF/RET-mediated kidney induction" .
    <https://doi.org/10.1016/j.devcel.2014.02.017> dct:date "2014"^^xsd:gYear ;
        dct:title "Global spatiotemporal control of branching morphogenesis in the developing mouse kidney" .
    <https://doi.org/10.1016/j.ydbio.2004.09.019> dct:date "2004"^^xsd:gYear ;

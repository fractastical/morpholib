<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Argonauta argo Schnakenberg critical mode at the 95 µm Holocene tier — Model fidelity to source: 84/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The Jacobian, quadratic dispersion, critical wavenumber, and equal-diffusion ablation match the Schnakenberg linearisation, and the matrix-eigenvalue cross-check has Pearson r = 1. Five Lean theorems encode this slot's scaled integers (trace -20, det 10000, Turing margin 1340² > 720000). Deduction: D_u and D_v are chosen so k_c sits on the measured period; they are not published Argonauta diffusivities, and the radial profile is a fitted critical-mode shape rather than a long free 2D integration." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 8.4e-01 ;
    pk:hasVerdict "faithful" .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Argonauta argo Schnakenberg critical mode at the 95 µm Holocene tier — Parameter expressivity: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Raising γ from 0.55 to 2.4 shortens λ_c from 229.3 µm to 109.8 µm, monotone and consistent with λ ∝ γ^(-1/2). Equal diffusion (D_u = D_v) drops σ_max from +0.200 to -0.100. The grain-amplitude sweep is computed in the same run but is not what this pass judges." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-argonauta-argo-turing-wavelength-s0.py L261–L296" ;
        dct:description "gamma sweep and equal-diffusion sigma" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0e502ec97af571f7d94f76469868477feaaf61eb/models/2026-delphi10000-argonauta-argo-turing-wavelength-s0.py#L261-L296> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "datasets/argonauta_argo_turing_wavelength_s0/argonauta_argo_turing_wavelength_s0_metrics.json (generated output)" ;
        dct:description "lambda_um sweep 229.27 to 109.75 — datasets/argonauta_argo_turing_wavelength_s0/argonauta_argo_turing_wavelength_s0_metrics.json: rendered output of models/2026-delphi10000-argonauta-argo-turing-wavelength-s0.py at 0e502ec97af571f7d94f76469868477feaaf61eb, application/json, 1616 B, artifact_sha256 9b00c2c18ee9c31cbf1ed60d39af282c69df2b24ee8714bb057b0be7823ad489 (sha256 9b00c2c18ee9c31cbf1ed60d39af282c69df2b24ee8714bb057b0be7823ad489), spec_fingerprint 54b806e24537aefcedcf7233858405c3246c56ac09b2d0e212f862aff5e91fe3" .

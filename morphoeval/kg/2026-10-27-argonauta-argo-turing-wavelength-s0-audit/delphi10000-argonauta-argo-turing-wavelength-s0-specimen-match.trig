        rdfs:label "datasets/argonauta_argo_turing_wavelength_s0/argonauta_argo_turing_wavelength_s0_smooth_control.gif (generated output)" ;
        dct:description "12-frame smooth amplitude rise, 800x600, CV 80.2 — datasets/argonauta_argo_turing_wavelength_s0/argonauta_argo_turing_wavelength_s0_smooth_control.gif: rendered output of models/2026-delphi10000-argonauta-argo-turing-wavelength-s0.py at 0e502ec97af571f7d94f76469868477feaaf61eb, image/gif, 658416 B, 800×600 px, 12 frames, artifact_sha256 23ce19963dbc42f1b0b7e9b93a3c6f7bd90edf6deb9742f57a8a4a5d2c94b940 (sha256 23ce19963dbc42f1b0b7e9b93a3c6f7bd90edf6deb9742f57a8a4a5d2c94b940), spec_fingerprint 54b806e24537aefcedcf7233858405c3246c56ac09b2d0e212f862aff5e91fe3" .

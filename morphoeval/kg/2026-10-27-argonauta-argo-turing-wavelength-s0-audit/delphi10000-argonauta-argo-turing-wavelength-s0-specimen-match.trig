sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Argonauta argo Schnakenberg critical mode at the 95 µm Holocene tier — Morphological realism / specimen match: 74/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The smooth control is recognisably one brown ocellus, and the radial means overlie the plate (r=0.99934). Computer-vision similarity of that GIF to the plate is 80.2. The field is perfectly axisymmetric and has none of the plate's grain or caption, so it is not a close pixel-level match. This score is for the smooth GIF only." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-argonauta-argo-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

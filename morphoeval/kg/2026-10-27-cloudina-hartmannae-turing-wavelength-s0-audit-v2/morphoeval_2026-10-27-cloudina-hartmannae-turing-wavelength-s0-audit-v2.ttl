        pk:Concept ;
    rdfs:label "Critical wavenumber balance" ;
    dct:description "Integer form of the Turing wavenumber used to lock lambda_c at 2.397 µm | Variables: Du, Dv, fu, gv, kc2" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cloudina-hartmannae-turing-wavelength-s0.py>,

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-source-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Cloudina hartmannae wall-normal Turing lamella at 2.397 µm (Pass 2) — Source and data traceability: 92/100" ;

<https://w3id.org/delphi/resource/math-law/delphi10000-cloudina-hartmannae-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diffusion rescaling preserves the Turing discriminant" ;
    dct:description "Why crossing from the funnel rung to this lamella rung rescales D without leaving the Turing regime | Variables: s > 0; at fixed rates the 2.397 µm diffusivities are (2.397/104.2)^2 times a 104.2 µm pair" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cloudina-hartmannae-turing-wavelength-s0.py>,

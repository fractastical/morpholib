        <https://doi.org/10.2475/ajs.272.8.752> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3149.discScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3149.diffusion_rescaling_preserves_turing_discriminant" ;
    pk:leanVerified true .


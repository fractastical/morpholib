sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Cloudina hartmannae wall-normal Turing lamella at 2.397 µm (Pass 2) — Parameter expressivity: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Multiplying both diffusivities by s in {0.64, 0.81, 1, 1.21, 1.44, 1.69, 1.96} moves the numerical peak wavelength with the analytical curve λ=2.397√s. Sweep Pearson r=0.9999 and the sequence is monotone. That is the expressivity check Pass 1 asked for. Equal diffusion, a separate axis, shuts the instability off." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cloudina-hartmannae-turing-wavelength-s0.py L284–L318" ;
        dct:description "Parabolic peak and scale sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cloudina-hartmannae-turing-wavelength-s0.py#L284-L318> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "datasets/cloudina_hartmannae_turing_wavelength_s0/cloudina_hartmannae_turing_wavelength_s0_metrics.json (generated output)" ;
        dct:description "sweep_pearson_r=0.9999, sweep_monotone=true — datasets/cloudina_hartmannae_turing_wavelength_s0/cloudina_hartmannae_turing_wavelength_s0_metrics.json: rendered output of models/2026-delphi10000-cloudina-hartmannae-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, application/json, 1175 B, artifact_sha256 34a24c4d8ec751730e888705add6762ac8dcbdf3d6b1f284a9682020d74273dc (sha256 34a24c4d8ec751730e888705add6762ac8dcbdf3d6b1f284a9682020d74273dc), spec_fingerprint aed8c0ba57f9ef79f97072aa88a12b01ec7259b22f96b35a3a9a2a503fa4efe9" .

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Cloudina hartmannae wall-normal Turing lamella at 2.397 µm (Pass 2) — Code-to-model traceability: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion, sweep, controls, segmentation, and rendering are separate functions, and the Lean module proves the band membership, the eight-lamella stack, the 43–44× funnel contrast, diffusion-rescaling of the discriminant, and the integer wavenumber balance. lean is not installed in this environment, so the proofs were not executed." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-code-traceability-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3149_cloudina_hartmannae_turing_wavelength_s0.lean L30–L67" ;
        dct:description "Theorems for the band, the Grant stack, the funnel ratio, rescaling, and k_c" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3149_cloudina_hartmannae_turing_wavelength_s0.lean#L30-L67> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cloudina-hartmannae-turing-wavelength-s0.py L1–L40" ;
        dct:description "Module docstring states the 2.397 µm versus 104.2 µm contrast" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cloudina-hartmannae-turing-wavelength-s0.py#L1-L40> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor). No second assessor was run." ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0000-0000-0000> .
}


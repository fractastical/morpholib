            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-source-traceability-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "datasets/cloudina_hartmannae_turing_wavelength_s0/scout_manifest.json L1–L40" ;
        dct:description "OpenAlex follow-up and the note that slot 1252 was excluded" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/datasets/cloudina_hartmannae_turing_wavelength_s0/scout_manifest.json#L1-L40> .

        rdfs:label "datasets/cloudina_hartmannae_turing_wavelength_s0/README.md L1–L40" ;
        dct:description "Scale 2.4 µm and age 549 Ma, with the 104.2 µm contrast" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/datasets/cloudina_hartmannae_turing_wavelength_s0/README.md#L1-L40> .

        rdfs:label "Cloudina hartmannae wall-normal Turing lamella at 2.397 µm (Pass 2) — Reproducibility package: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Self-test passed on this run: r>0.98, monotone sweep, equal-D σmax<0, ablation ratio <0.05, spacing within 8% of 2.397 µm, 12 frames, min side 480 px, CV>=58, stack inside 8–50 µm, age 549 Ma. Seed and image hashes are pinned. Nanopub signing was not available (~/.nanopub/profile.yml absent) and was not faked." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cloudina-hartmannae-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Cloudina hartmannae wall-normal Turing lamella at 2.397 µm (Pass 2) faithfully reproduces Cloudina hartmannae morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-cloudina-hartmannae-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Cloudina hartmannae specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cloudina-hartmannae-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cloudina-hartmannae-turing-wavelength-s0.py; output: docs/media/cloudina_hartmannae_turing_wavelength_s0_comparison.png; organism: Cloudina hartmannae; environment: n/a; claim_boundary: [reported_in_source: Yang et al. 2020: Namibian Cloudina organic lamellae 0.5–5 µm, up to eight per wall layer | Grant 1990: shell layers 8–50 µm | Turing 1952 critical wavenumber and Schnakenberg 1979 kinetics | Penny et al. 2014: Omkyk ash 547.32 ± 0.31 Ma; slot age remains 549 Ma; reconstructed_in_script: Jacobian and diffusivities with lambda_c fixed at 2.397 µm and a small positive discriminant | Noise-seeded nonlinear stack, equal-diffusion control, autocatalysis ablation, diffusivity sweep | Segmentation of the species card and the CC BY 2.0 Corumbá photograph; transfer_boundary: Applying a reaction-diffusion lamella wavelength to Cloudina is a morphospace hypothesis | Grant's cnidarian-grade reading and Yang's annelid-grade reading are both left open; does_not_claim: That Cloudina had ocelli or a measured pigment stripe at 2.397 µm | That the species card or the Corumbá slab is a Nama Group lamella SEM | That the Wikimedia life restoration is a fossil photograph | That slot 1252 parameters were copied]; other sources: Shell structure and distribution of Cloudina, a potential index fossil for the terminal Proterozoic <https://pubmed.ncbi.nlm.nih.gov/11538690/>; phenomenon_size: 2.1 µm (2.083e-06 m, log10=-5.681 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 2.1 µm to 4.7 mm): 2.1 µm:cloudina-hartmannae-bioelectric-polarity, 6.5 µm:cloudina-hartmannae-vertex-packing, 104 µm:cloudina-hartmannae-turing-wavelength, 208 µm:cloudina-hartmannae-clock-wavefront, 469 µm:cloudina-hartmannae-morphogen-condensation, 573 µm:cloudina-hartmannae-elastic-buckling, 651 µm:cloudina-hartmannae-flux-canalization, 911 µm:cloudina-hartmannae-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/s41598-019-56317-x>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047>,
            <https://doi.org/10.1126/science.1253393>,
            <https://doi.org/10.2475/ajs.272.8.752> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cloudina-hartmannae-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-cloudina-hartmannae-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


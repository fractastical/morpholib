    <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Diaz-Cuadros et al. (2020, 2023) & Matsuda et al. (2020) human pluripotent stem-cell segmentation clock and metabolic tempo scaling model — Reproducibility package: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Deterministic RNG (`seed=2019`), standalone `--self-test` suite verifying SHA-256 dataset integrity, exact tempo rescaling collapse (<1e-11 nM), bitwise two-run kymograph determinism (`atol=0.0`), intronless Hes7 ablation collapse (0 min period), metabolic NAD+/NADH ordering, and specimen segmentation (`run_self_test`, L850-905), plus rendered PNG and GIF outputs in `docs/media/`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-repro-package-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

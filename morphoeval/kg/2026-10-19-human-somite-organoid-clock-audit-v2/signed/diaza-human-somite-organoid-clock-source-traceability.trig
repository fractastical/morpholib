        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L88–L115" ;
        dcterms:description "Runtime SHA-256 verification of datasets/human_somite_organoid_clock/ artifacts" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2019-diaza-human-somite-organoid-clock.py#L88-L115> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/human_somite_organoid_clock/human_somite_organoid_clock_reference.json L1–L210" ;
        dcterms:description "Vendored HES7 DDE equations, 6-regime perturbation series, and 6-species allometry table" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/datasets/human_somite_organoid_clock/human_somite_organoid_clock_reference.json#L1-L210> .


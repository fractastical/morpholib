    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/s41586-019-1885-9>,
            <https://doi.org/10.1038/s41586-022-05574-4>,
            <https://doi.org/10.1038/s41586-022-05649-2>,
            <https://doi.org/10.1126/science.aba7668> .
    <https://doi.org/10.1038/s41586-019-1885-9> dct:date "2020"^^xsd:gYear ;
        dct:title "In vitro characterization of the human segmentation clock" .
    <https://doi.org/10.1038/s41586-022-05574-4> dct:date "2023"^^xsd:gYear ;
        dct:title "Metabolic regulation of species-specific developmental rates" .
    <https://doi.org/10.1038/s41586-022-05649-2> dct:date "2023"^^xsd:gYear ;
        dct:title "Reconstituting human somitogenesis in vitro" .
    <https://doi.org/10.1126/science.aba7668> dct:date "2020"^^xsd:gYear ;
        dct:title "Species-specific oscillation periods of human and mouse segmentation clocks are due to cell autonomous properties of HES7" .
}


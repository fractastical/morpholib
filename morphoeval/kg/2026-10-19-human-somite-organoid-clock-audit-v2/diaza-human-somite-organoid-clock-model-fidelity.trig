sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-diaza-human-somite-organoid-clock> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Diaz-Cuadros et al. (2020, 2023) & Matsuda et al. (2020) human pluripotent stem-cell segmentation clock and metabolic tempo scaling model — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Faithfully implements the delayed autoinhibitory HES7 TTFL DDE system with separate intron splicing delay tau_tx and export/translation delay tau_tl, half-life degradation rates delta_{m,p} = ln(2)/t_{1/2}, exact tempo rescaling invariance (collapse std = 2.32e-13 nM), intronless Hes7 subcritical Hopf collapse, and mitochondrial NAD+/NADH turnover scaling (L118-378), verified by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_028_human_somite_organoid_clock.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L118–L285" ;
        dct:description "RK2 midpoint HES7 DDE solver and exact tempo rescaling collapse verifier" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2019-diaza-human-somite-organoid-clock.py#L118-L285> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L288–L378" ;
        dct:description "6-regime genetic & metabolic NAD+/NADH perturbation series evaluator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2019-diaza-human-somite-organoid-clock.py#L288-L378> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_028_human_somite_organoid_clock.lean L25–L119" ;
        dct:description "3 machine-checked Lean 4 theorems (0 sorrys) on tempo rescaling invariance, intron deletion subcritical collapse, and metabolic NAD+/NADH period scaling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_028_human_somite_organoid_clock.lean#L25-L119> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


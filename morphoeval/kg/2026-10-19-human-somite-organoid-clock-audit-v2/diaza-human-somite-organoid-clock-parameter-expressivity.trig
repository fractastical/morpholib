sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-diaza-human-somite-organoid-clock> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Diaz-Cuadros et al. (2020, 2023) & Matsuda et al. (2020) human pluripotent stem-cell segmentation clock and metabolic tempo scaling model — Parameter expressivity: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates all 6 experimental regimes from Matsuda et al. (2020) and Diaz-Cuadros et al. (2020, 2023) (Mouse WT, Mouse + hHES7 swap, Human WT, Human + LbNOX NAD+ rescue, Human + Azide/Rotenone ETC inhibition, and Intronless Hes7 ablation collapse), plus 6 vertebrate species across a 10x clock period span (30 min to 300 min) and 6 tempo rescaling factors lambda in [1.0, 3.0]." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-parameter-expressivity-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L288–L445" ;
        dct:description "6-regime perturbation series and 6-species vertebrate clock allometry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2019-diaza-human-somite-organoid-clock.py#L288-L445> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


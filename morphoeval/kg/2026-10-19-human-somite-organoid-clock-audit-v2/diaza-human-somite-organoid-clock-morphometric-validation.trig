sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-diaza-human-somite-organoid-clock> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Diaz-Cuadros et al. (2020, 2023) & Matsuda et al. (2020) human pluripotent stem-cell segmentation clock and metabolic tempo scaling model — Morphometric validation: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Extracts 5 reference-anchored quantitative morphometric measurements via `measure_morphoeval()` (L570-635): human/mouse period ratio 2.4591 vs 2.459 empirical, human WT clock period 300.01 min vs 300.0 +/- 18.0 min, 6-regime perturbation Pearson r = 0.9999 (RMSE = 2.18 min), 6-species vertebrate allometry Pearson r = 0.9970 (allometric linearity r = 0.9974), and bilateral SEM specimen somite spacing 47.14 +/- 9.48 px (CV = 0.2010)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-6-regime-hes7-genetic-metabolic-perturbation-series-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-6-species-vertebrate-segmentation-clock-delay-turnover-allometry-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-human-pluripotent-stem-cell-psm-hes7-achilles-oscillation-period-t-human>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-human-vs-mouse-hes7-segmentation-clock-period-ratio-t-human-t-mouse>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-vertebrate-somite-psm-specimen-bilateral-somite-spacing-s-obs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-morphometric-validation-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-6-regime-hes7-genetic-metabolic-perturbation-series-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "6-regime HES7 genetic & metabolic perturbation series Pearson correlation r = 0.9999 Pearson r" ;
        dct:description "p = 5.90e-09; mouse hHES7 knock-in swap period = 135.1 min vs 134.0 min observed" ;
        schema:measurementTechnique "correlation between DDE-predicted and empirical oscillation periods across 6 Matsuda (2020) & Diaz-Cuadros (2020, 2023) regimes (RMSE = 2.18 min)" ;
        schema:name "6-regime HES7 genetic & metabolic perturbation series Pearson correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-6-regime-hes7-genetic-metabolic-perturbation-series-pearson-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-6-regime-hes7-genetic-metabolic-perturbation-series-pearson-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Matsuda et al. (2020) Science 369:1450-1455 Figs. 1-4; Diaz-Cuadros et al. (2023) Nature 613:550-557 Figs. 2-4" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-6-species-vertebrate-segmentation-clock-delay-turnover-allometry-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "6-species vertebrate segmentation clock delay-turnover allometry Pearson r = 0.997 Pearson r" ;
        dct:description "linear allometric slope vs (tau + t_1/2,p) = 3.334 (r = 0.9955, p = 3.08e-05)" ;
        schema:measurementTechnique "correlation between HES7 DDE predicted and empirical clock periods across 6 vertebrate species (zebrafish 30 min to human 300 min, RMSE = 14.24 min)" ;
        schema:name "6-species vertebrate segmentation clock delay-turnover allometry Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.997" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-6-species-vertebrate-segmentation-clock-delay-turnover-allometry-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-6-species-vertebrate-segmentation-clock-delay-turnover-allometry-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Diaz-Cuadros et al. (2020) Nature 580:113-118; Matsuda et al. (2020) Science 369:1450-1455; Lazaro et al. (2023) Nat. Ecol. Evol. 7:1107-1118" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-human-pluripotent-stem-cell-psm-hes7-achilles-oscillation-period-t-human> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "human pluripotent stem-cell PSM HES7-Achilles oscillation period T_human = 300.01 min" ;
        dct:description "LbNOX NAD+ elevation accelerates human period to 227.8 min; sodium azide ETC inhibition slows period to 396.8 min" ;
        schema:measurementTechnique "parabolic peak-refined limit-cycle period of human WT HES7 DDE (tau_total = 51 min, t_{1/2,p} = 40 min, t_{1/2,m} = 42 min)" ;
        schema:name "human pluripotent stem-cell PSM HES7-Achilles oscillation period T_human" ;
        schema:unitText "min" ;
        schema:value "300.01" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-human-pluripotent-stem-cell-psm-hes7-achilles-oscillation-period-t-human-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-human-pluripotent-stem-cell-psm-hes7-achilles-oscillation-period-t-human-reference> a schema:PropertyValue ;
        dct:source "Diaz-Cuadros et al. (2020) Nature 580:113-118 Fig. 2d (human segmentation clock period 300 +/- 18 min = 5.0 h)" ;
        schema:value "300.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-human-vs-mouse-hes7-segmentation-clock-period-ratio-t-human-t-mouse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "human vs mouse HES7 segmentation clock period ratio T_human / T_mouse = 2.4591 dimensionless ratio" ;
        dct:description "intronless Hes7 Delta-intron1-3 ablation collapses to T = 0.0 min (sustained=False)" ;
        schema:measurementTechnique "ratio of human WT iPSC-PSM period (300.01 min) to mouse WT PSM period (122.00 min) in the delayed HES7 TTFL DDE solver (exact rescaling collapse std = 2.32e-13 nM)" ;
        schema:name "human vs mouse HES7 segmentation clock period ratio T_human / T_mouse" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "2.4591" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-human-vs-mouse-hes7-segmentation-clock-period-ratio-t-human-t-mouse-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-human-vs-mouse-hes7-segmentation-clock-period-ratio-t-human-t-mouse-reference> a schema:PropertyValue ;
        dct:source "Diaz-Cuadros et al. (2020) Nature 580:113-118 Fig. 2; Matsuda et al. (2020) Science 369:1450-1455 Fig. 1 (300 min / 122 min = 2.459)" ;
        schema:value "2.459" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-vertebrate-somite-psm-specimen-bilateral-somite-spacing-s-obs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vertebrate somite/PSM specimen bilateral somite spacing S_obs = 47.1429 px" ;
        dct:description "bilateral symmetry ratio = 1.0061, std = 9.48 px, phase correlation r = 0.4795" ;
        schema:measurementTechnique "bilateral dorsal somite row DoG peak segmentation on human_somite_organoid_specimen.jpg (upper=8 somites, lower=8 somites, CV=0.2010)" ;
        schema:name "vertebrate somite/PSM specimen bilateral somite spacing S_obs" ;
        schema:unitText "px" ;
        schema:value "47.1429" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-vertebrate-somite-psm-specimen-bilateral-somite-spacing-s-obs-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-vertebrate-somite-psm-specimen-bilateral-somite-spacing-s-obs-reference> a schema:PropertyValue ;
        dct:source "Vendored CC BY 4.0 vertebrate embryo SEM specimen (datasets/human_somite_organoid_clock/human_somite_organoid_specimen.jpg)" ;
        schema:value "47.14" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L570–L635" ;
        dct:description "5 quantitative MorphoEval measurements with analytical and empirical references, CV, Pearson r, and RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2019-diaza-human-somite-organoid-clock.py#L570-L635> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


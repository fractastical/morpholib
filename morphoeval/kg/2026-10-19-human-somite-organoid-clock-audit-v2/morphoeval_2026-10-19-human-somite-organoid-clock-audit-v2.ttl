<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/diaza-human-somite-organoid-clock-1>,
        <https://w3id.org/probknow/resource/math-law/diaza-human-somite-organoid-clock-2>,
        <https://w3id.org/probknow/resource/math-law/diaza-human-somite-organoid-clock-3> .

<https://w3id.org/probknow/resource/math-law/diaza-human-somite-organoid-clock-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diaz-Cuadros et al. (2020) & Matsuda et al. (2020) HES7 Delay-Degradation Tempo Rescaling Invariance Law" ;
    dct:description "Proves that concerted scaling of HES7 feedback delay tau and protein/mRNA half-lives dilates the segmentation clock period by exact factor lambda (~2.5x from mouse 120 min to human 300 min) | Variables: T_osc: HES7 segmentation clock oscillation period (min); lambda: biochemical delay and half-life dilation factor (dimensionless, ~2.5 between human and mouse); tau: total transcriptional-splicing + translational feedback delay (min); delta: mRNA/protein degradation rate (min^-1)" ;
    dct:source "Diaz-Cuadros et al. (2020) Nature 580:113-118 Fig. 2; Matsuda et al. (2020) Science 369:1450-1455 Figs. 1-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2019-diaza-human-somite-organoid-clock.py#L120-L245>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_028_human_somite_organoid_clock.lean#L25-L53> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def scaled_clock_period (lambda T0 : Nat) : Nat :=
  lambda * T0
theorem diazcuadros_matsuda_2020_tempo_rescaling_invariance
    (lambda lambda1 lambda2 T0 T1 T2 : Nat) :
    scaled_clock_period lambda1 (scaled_clock_period lambda2 T0) =
      scaled_clock_period (lambda1 * lambda2) T0 ∧
    scaled_clock_period lambda (T1 + T2) =
      scaled_clock_period lambda T1 + scaled_clock_period lambda T2 ∧
    scaled_clock_period 5 60 = 300"""^^pk:lean4 ;
    skos:notation "T_osc(lambda * tau, delta / lambda) = lambda * T_osc(tau, delta),  with lambda_human_mouse = 300 / 120 = 2.5" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/s41586-019-1885-9>,
        <https://doi.org/10.1038/s41586-022-05574-4>,
        <https://doi.org/10.1038/s41586-022-05649-2>,
        <https://doi.org/10.1126/science.aba7668> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Delayed Autoinhibitory HES7 Oscillator with Intron Splicing Delay & NAD+/NADH Metabolic Tempo Scaling" ;
    pk:leanDeclaration "MathOfBiology.Loop_028.scaled_clock_period" ;
    pk:leanTheorem "MathOfBiology.Loop_028.diazcuadros_matsuda_2020_tempo_rescaling_invariance" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/diaza-human-somite-organoid-clock-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Matsuda et al. (2020) Intron-Splicing Delay Decomposition & Subcritical Hopf Oscillation Collapse Law" ;
    dct:description "Establishes that HES7 intron splicing delay is required to maintain total feedback delay above the Hopf bifurcation threshold tau_crit, explaining why intronless Hes7 abolishes segmentation clock oscillations | Variables: tau_intron: HES7 pre-mRNA intron splicing delay (15 min in mouse, 37 min in human); tau_tl: basal export and translation delay (min); tau_crit: minimum feedback delay required for sustained Hopf limit-cycle oscillations (min)" ;
    dct:source "Matsuda et al. (2020) Science 369:1450-1455 Fig. 4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2019-diaza-human-somite-organoid-clock.py#L248-L335>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_028_human_somite_organoid_clock.lean#L55-L84> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def wt_total_delay (tau_intron tau_tl : Nat) : Nat :=
  tau_intron + tau_tl
def intronless_delay (tau_tl : Nat) : Nat :=
  tau_tl
theorem matsuda_2020_intron_deletion_delay_shortening
    (tau_intron tau_tl tau_crit : Nat)
    (h_intron : 0 < tau_intron)
    (h_sub : tau_tl < tau_crit)
    (h_super : tau_crit ≤ tau_intron + tau_tl) :
    intronless_delay tau_tl < wt_total_delay tau_intron tau_tl ∧
    intronless_delay tau_tl < tau_crit ∧
    tau_crit ≤ wt_total_delay tau_intron tau_tl"""^^pk:lean4 ;
    skos:notation "tau_WT = tau_intron + tau_tl > tau_crit > tau_tl = tau_Delta_intron  =>  damped steady-state collapse" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/s41586-019-1885-9>,
        <https://doi.org/10.1038/s41586-022-05574-4>,
        <https://doi.org/10.1038/s41586-022-05649-2>,
        <https://doi.org/10.1126/science.aba7668> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Delayed Autoinhibitory HES7 Oscillator with Intron Splicing Delay & NAD+/NADH Metabolic Tempo Scaling" ;
    pk:leanDeclaration "MathOfBiology.Loop_028.wt_total_delay" ;
    pk:leanTheorem "MathOfBiology.Loop_028.matsuda_2020_intron_deletion_delay_shortening" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/diaza-human-somite-organoid-clock-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diaz-Cuadros et al. (2023) Mitochondrial NAD+/NADH Metabolic Rate Scaling Law" ;
    dct:description "Proves that mitochondrial electron transport chain inhibition (k_ETC < k_WT) slows the human segmentation clock whereas LbNOX-mediated NAD+/NADH elevation (k_LbNOX > k_WT) accelerates clock frequency and shortens period | Variables: k_met: NAD+/NADH-dependent translation and protein turnover rate factor; T_osc: HES7 oscillation period (min); omega_osc: clock angular frequency (rad/min)" ;
    dct:source "Diaz-Cuadros et al. (2023) Nature 613:550-557 Figs. 1-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2019-diaza-human-somite-organoid-clock.py#L338-L445>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_028_human_somite_organoid_clock.lean#L86-L119> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def metabolic_phase_cycle_residual (k_met T_osc C_cycle : Int) : Int :=
  k_met * T_osc - C_cycle
def metabolic_clock_frequency (k_met omega_base : Int) : Int :=
  k_met * omega_base
theorem diazcuadros_2023_metabolic_nad_period_scaling
    (k_met q k_etc k_wt k_lbnox omega_base : Int)
    (h_etc_wt : k_etc < k_wt)
    (h_wt_lbnox : k_wt < k_lbnox)
    (h_omega : 0 < omega_base) :
    metabolic_phase_cycle_residual k_met q (k_met * q) = 0 ∧
    metabolic_clock_frequency k_etc omega_base < metabolic_clock_frequency k_wt omega_base ∧
    metabolic_clock_frequency k_wt omega_base < metabolic_clock_frequency k_lbnox omega_base"""^^pk:lean4 ;
    skos:notation "k_met * T_osc = C_cycle,  omega_osc(k_ETC) < omega_osc(k_WT) < omega_osc(k_LbNOX)" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/s41586-019-1885-9>,
        <https://doi.org/10.1038/s41586-022-05574-4>,
        <https://doi.org/10.1038/s41586-022-05649-2>,
        <https://doi.org/10.1126/science.aba7668> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Delayed Autoinhibitory HES7 Oscillator with Intron Splicing Delay & NAD+/NADH Metabolic Tempo Scaling" ;
    pk:leanDeclaration "MathOfBiology.Loop_028.metabolic_phase_cycle_residual" ;
    pk:leanTheorem "MathOfBiology.Loop_028.diazcuadros_2023_metabolic_nad_period_scaling" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nelson-airway-mucosal-creasing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Wiggs et al. (1997), Li et al. (2011) & Eskandari et al. (2015) cylindrical bilayer mucosal folding, period-doubling & Poiseuille airway resistance, coupled to a Weibel (1963) bronchial-tree impedance network with Venegas (2005) flow-stretch feedback — Code-to-model traceability: 85/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module header (L1-90) maps each law to its paper and to the five Lean theorems, every new tree function carries a docstring naming its source (Weibel 1963 model A, Poiseuille, Venegas 2005 feedback, Macklem & Mead 1967 for the small-airway check), the math-KG registration (`morphoeval/math_kg_loops/nelson-airway-mucosal-creasing.yaml`) lists 5 equations with single-range `code_locus` / `lean_locus` pins that match the current file, and the 14 self-test checks are numbered and commented against the laws. Deductions: the blending weights 0.88/0.12, 0.85/0.15 and 0.75/0.25 (L420, L430, L437, L627-632) are not explained anywhere as reference prescription, so a reader of the \"L-BFGS-B relaxation\" docstring is misled about what is computed (-7); the spectral-operator and energy coefficients (L366-371 and the surrounding weights) and the constants 0.0085, 0.7110, 0.25 (L130, L217, L221) have no derivation or citation (-4); the Li 2011 title inconsistency between header and Lean docstring (-2); the seed-paper author list in the v2 audit header (\"Auguste,imba\") is a pre-existing documentation defect carried in the campaign prompt (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2018-nelson-airway-mucosal-creasing.py L366–L371: Spectral operator weights 0.25/0.75 and surrounding energy coefficients have no citation <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L366-L371>",
            "2018-nelson-airway-mucosal-creasing.py L436–L438: Reference blending is uncommented as such; docstring presents the function as an energy relaxation <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L436-L438>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-code-traceability-2> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L1–L90" ;
        dct:description "Header maps laws 1-5 to Wiggs 1997, Li 2011, Jin 2011, Eskandari 2015, Weibel 1963, Venegas 2005 and the Lean theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L1-L90> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/nelson-airway-mucosal-creasing.yaml L1–L115" ;
        dct:description "5 equations with code_locus (single file#La-Lb ranges) and lean_locus pins matching the current script and Lean file" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/math_kg_loops/nelson-airway-mucosal-creasing.yaml#L1-L115> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 068 Pass 3 Phase B Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


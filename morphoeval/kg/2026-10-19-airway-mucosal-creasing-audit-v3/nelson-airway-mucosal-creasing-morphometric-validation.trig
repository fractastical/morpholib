        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nelson-airway-mucosal-creasing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Wiggs et al. (1997), Li et al. (2011) & Eskandari et al. (2015) cylindrical bilayer mucosal folding, period-doubling & Poiseuille airway resistance, coupled to a Weibel (1963) bronchial-tree impedance network with Venegas (2005) flow-stretch feedback — Morphometric validation: 80/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1606-1776) returns 15 reference-anchored measurements, 6 new: homogeneous tree / single-airway identity 1.000000 (ref 1.0), Weibel pure-Poiseuille small-airway share 0.4291 (analytic ref 0.43; Macklem-Mead 0.10-0.20 stated), Severe Asthma heterogeneous VDef 0.3503 (Venegas ~0.30, range 0.20-0.40), Healthy VDef 0.0449 at identical sigma/kappa (ref 0.0), asthma/healthy whole-tree amplification 2.80 (ref 3.66) and defect run-length clustering 1.25 (null 1.0); the Pass 2 collapse statistics (r = 0.9986, p = 8.9e-14, alpha = -1.04 ± 0.02), the three m* values and the specimen metrics remain. Deductions: the phenotype A/A_0, R_flow/R_0 (15.65 vs 16.52) and period-doubling measurements are 85-88 % the reference value by construction (L430, L436-438), so their agreement is not a validation (-8); the 2.80 vs 3.66 amplification measurement mixes two single-airway sources (the reference table's 16.52/4.51 vs the closed-form law's 11.77/4.72 = 2.49 that the tree actually uses), so the stated \"above the lower bound\" claim holds only relative to 2.49 and the printed reference is weak (L1756-1765) (-4); the 12-point collapse r is partly circular because the table's m_obs values are largely model-derived and the law's constants were fitted to the same table (-4); the specimen fold count and circularity are compared to themselves (-2); the Venegas comparison is to a single scalar (defect volume fraction) with no PET-image morphometric and sigma is assumed (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2018-nelson-airway-mucosal-creasing.py L1756–L1765: Asthma/healthy tree amplification 2.80 compared to 3.66 = 16.52/4.51 from a different single-airway source than the tree's own law (2.49) <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L1756-L1765>",
            "2018-nelson-airway-mucosal-creasing.py L612–L635: sim_*_A_norm / sim_*_R_flow = 0.85*reference + 0.15*simulated feeding Panel C and the constriction-curve comparison <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L612-L635>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-12-point-3-species-bronchial-fold-wavenumber-scaling-correlation-human-bovine-ovine>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-chronic-bronchitis-remodeled-circumferential-fold-mode-number-m>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-healthy-bronchiole-heterogeneous-bronchospasm-ventilation-defect-fraction-at-identical-sigma-kappa-epsilon-mean-0-28>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-healthy-thin-walled-bronchiole-circumferential-fold-mode-number-m>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-histology-specimen-segmented-inward-mucosal-fold-count-m-obs-bronchiole-mucosal-rosette-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-histology-specimen-segmented-rosette-lumen-circularity-4-pi-a-p-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-homogeneous-bronchospasm-whole-tree-single-airway-poiseuille-resistance-ratio-identity-severe-asthma-epsilon-0-28>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-log-log-inverse-mucosal-thickness-scaling-exponent-alpha-m-h-m-r-0-alpha>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-relaxed-asm-negative-control-epsilon-theta-0-open-lumen-area-fraction-a-lumen-a-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-hagen-poiseuille-airflow-resistance-amplification-r-flow-r-0-at-epsilon-theta-0-28>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-healthy-whole-tree-resistance-amplification-under-heterogeneous-bronchospasm-epsilon-mean-0-28>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-heterogeneous-bronchospasm-ventilation-defect-fraction-epsilon-mean-0-28-sigma-0-10-kappa-0-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-ventilation-defect-spatial-clustering-mean-contiguous-defect-run-length-random-bernoulli-expectation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthmatic-airway-remodeling-circumferential-fold-mode-number-m>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-weibel-model-a-pure-poiseuille-small-airway-g8-g16-d-2-mm-share-of-conducting-airway-resistance>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-morphometric-validation-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-12-point-3-species-bronchial-fold-wavenumber-scaling-correlation-human-bovine-ovine> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-point 3-species bronchial fold wavenumber scaling correlation (Human, Bovine, Ovine) = 0.9986 Pearson r" ;
        dct:description "RMSE = 0.82 folds, p = 4.82e-14" ;
        schema:measurementTechnique "Linear regression of predicted m* = c_cyl*(R_0/h_m)*(3*mu_s/mu_m)^(1/3) vs observed fold count across 12 airway states in 3 species (p=4.82e-14, RMSE=0.82 folds)" ;
        schema:name "12-point 3-species bronchial fold wavenumber scaling correlation (Human, Bovine, Ovine)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9986" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-12-point-3-species-bronchial-fold-wavenumber-scaling-correlation-human-bovine-ovine-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-12-point-3-species-bronchial-fold-wavenumber-scaling-correlation-human-bovine-ovine-reference> a schema:PropertyValue ;
        dct:source "Li et al. (2011) JMPS 59:758-774 Eq. (18) & Eskandari et al. (2015) JTB 403:209-218 Eq. (14)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-chronic-bronchitis-remodeled-circumferential-fold-mode-number-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chronic bronchitis remodeled circumferential fold mode number m* = 8.4 folds" ;

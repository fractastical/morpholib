        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-weibel-model-a-pure-poiseuille-small-airway-g8-g16-d-2-mm-share-of-conducting-airway-resistance-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-weibel-model-a-pure-poiseuille-small-airway-g8-g16-d-2-mm-share-of-conducting-airway-resistance-reference> a schema:PropertyValue ;
        dct:source "Analytic Poiseuille value of Weibel (1963) model A (dataset bronchial_tree_impedance_reference.json); measured counterpart Macklem PT & Mead J (1967) J Appl Physiol 22:395-401 (10.1152/jappl.1967.22.3.395) reports 0.10-0.20" ;
        schema:value "0.43" .

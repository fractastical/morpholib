    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-healthy-whole-tree-resistance-amplification-under-heterogeneous-bronchospasm-epsilon-mean-0-28> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Severe Asthma / Healthy whole-tree resistance amplification under heterogeneous bronchospasm (epsilon_mean=0.28) = 2.801 ratio" ;
        dct:description "heterogeneity + feedback raise the asthma/healthy amplification above the homogeneous lower bound" ;
        schema:measurementTechnique "(R_tree/R_tree,0)_asthma / (R_tree/R_tree,0)_healthy at fixed tidal volume on the G0-G12 tree: 13.51 / 4.82" ;
        schema:name "Severe Asthma / Healthy whole-tree resistance amplification under heterogeneous bronchospasm (epsilon_mean=0.28)" ;
        schema:unitText "ratio" ;

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-healthy-whole-tree-resistance-amplification-under-heterogeneous-bronchospasm-epsilon-mean-0-28-reference> a schema:PropertyValue ;
        dct:source "Lower bound = homogeneous single-airway ratio 16.52/4.51 (airway_mucosal_creasing_reference.json); Wiggs BR et al. (1992) Am Rev Respir Dis 145:1251-1258 (10.1164/ajrccm/145.6.1251) report order-of-magnitude amplification by wall thickening on a Weibel/Horsfield tree" ;
        schema:value "3.66" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-heterogeneous-bronchospasm-ventilation-defect-fraction-epsilon-mean-0-28-sigma-0-10-kappa-0-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Severe Asthma heterogeneous bronchospasm ventilation-defect fraction (epsilon_mean=0.28, sigma=0.10, kappa=0.2) = 0.3501 fraction of terminal units" ;
        dct:description "kappa calibrated on the healthy control only (healthy VDef < 0.05); ventilation CV = 0.704; without feedback (kappa=0) VDef = 0.140" ;
        schema:measurementTechnique "Fraction of 4096 G12 terminal units with Q_term < 0.5 * mean(Q_term) after 24 iterations of saturating Venegas flow-stretch feedback on log-normal (sigma=0.10) ASM strain, m*=4.17" ;
        schema:name "Severe Asthma heterogeneous bronchospasm ventilation-defect fraction (epsilon_mean=0.28, sigma=0.10, kappa=0.2)" ;
        schema:unitText "fraction of terminal units" ;
        schema:value "0.3501" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-heterogeneous-bronchospasm-ventilation-defect-fraction-epsilon-mean-0-28-sigma-0-10-kappa-0-2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-heterogeneous-bronchospasm-ventilation-defect-fraction-epsilon-mean-0-28-sigma-0-10-kappa-0-2-reference> a schema:PropertyValue ;
        dct:source "Venegas JG et al. (2005) Nature 434:777-782 (10.1038/nature03490): ~20-40% of imaged lung in bronchoconstricted asthmatics is ventilation defect (PET 13NN)" ;
        schema:value "0.3" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-ventilation-defect-spatial-clustering-mean-contiguous-defect-run-length-random-bernoulli-expectation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Severe Asthma ventilation-defect spatial clustering: mean contiguous defect run length / random (Bernoulli) expectation = 1.248 enrichment ratio" ;
        dct:description "sibling concordance = 0.661; enrichment > 1 supports Venegas-type clustering, modest here because feedback acts per branch" ;
        schema:measurementTechnique "Mean run length of consecutive defective terminals in heap order (1.92) divided by 1/(1-p) = 1.54 for independent defects at p = 0.350; largest cluster = 13 terminals" ;
        schema:name "Severe Asthma ventilation-defect spatial clustering: mean contiguous defect run length / random (Bernoulli) expectation" ;
        schema:unitText "enrichment ratio" ;
        schema:value "1.248" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-ventilation-defect-spatial-clustering-mean-contiguous-defect-run-length-random-bernoulli-expectation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-ventilation-defect-spatial-clustering-mean-contiguous-defect-run-length-random-bernoulli-expectation-reference> a schema:PropertyValue ;
        dct:source "Null hypothesis of spatially independent defects (= 1.0); Venegas JG et al. (2005) Nature 434:777-782 report defects are large and contiguous (> 1.0)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthmatic-airway-remodeling-circumferential-fold-mode-number-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Severe asthmatic airway remodeling circumferential fold mode number m* = 4.17 folds" ;
        dct:description "period-doubling ratio = 0.63" ;
        schema:measurementTechnique "Cylindrical bilayer dispersion + L-BFGS-B FvK energy minimization for fibrotic asthmatic mucosa (h_m=31.8 um, R_0=600 um)" ;
        schema:name "Severe asthmatic airway remodeling circumferential fold mode number m*" ;
        schema:unitText "folds" ;
        schema:value "4.17" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthmatic-airway-remodeling-circumferential-fold-mode-number-m-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthmatic-airway-remodeling-circumferential-fold-mode-number-m-reference> a schema:PropertyValue ;
        dct:source "Wiggs et al. (1997) J. Appl. Physiol. 83:1814-1821 & Eskandari et al. (2015) JTB 403:209-218 (asthma m* = 5)" ;
        schema:value "4.98" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-weibel-model-a-pure-poiseuille-small-airway-g8-g16-d-2-mm-share-of-conducting-airway-resistance> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Weibel model A pure-Poiseuille small-airway (G8-G16, d < 2 mm) share of conducting-airway resistance = 0.4291 fraction" ;
        dct:description "Known limitation: pure Poiseuille over-predicts the peripheral share relative to Macklem & Mead (1967) because entrance/turbulent losses (Pedley et al. 1970) in central airways are neglected" ;
        schema:measurementTechnique "Generation-wise R_gen = 8*eta*L/(pi*r^4)/2^g over Weibel (1963) model A rows G0-G16 (eta = 1.81e-5 Pa s); total = 0.168 cmH2O s/L; fraction of sum over G >= 8" ;
        schema:name "Weibel model A pure-Poiseuille small-airway (G8-G16, d < 2 mm) share of conducting-airway resistance" ;
        schema:unitText "fraction" ;

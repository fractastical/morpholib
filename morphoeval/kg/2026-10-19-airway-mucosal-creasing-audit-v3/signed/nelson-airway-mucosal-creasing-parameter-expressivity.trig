sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nelson-airway-mucosal-creasing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Wiggs et al. (1997), Li et al. (2011) & Eskandari et al. (2015) cylindrical bilayer mucosal folding, period-doubling & Poiseuille airway resistance, coupled to a Weibel (1963) bronchial-tree impedance network with Venegas (2005) flow-stretch feedback — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Spans 4 clinical phenotypes (L491-546), the 12-airway three-species table (L548-609), 6 ASM constriction levels (L612-635), and now a tree depth parameter (G0-G16), the log-normal dispersion sigma, the feedback gain kappa (10-value sweep x 3 phenotypes x 3 seeds, L1012-1052) and a fixed-tidal-volume vs pressure-controlled normalisation. CLI exposes --epsilon-theta, --hm-scale, --mu-ratio-scale, --seed, --tree-generations, --sigma, --kappa, --pressure-controlled, --skip-gif, --skip-tree-gif (L1876-1886) and all are wired (verified by the Phase A off-repo render with non-default values). Deductions: --hm-scale and --mu-ratio-scale act only on the ring phenotypes while the tree reads its thickness from the dataset phenotype, and --epsilon-theta is applied to the tree only as eps_mean (L1131), so the ring and tree morphospaces are not driven by one parameter set (-5); kappa_critical (first kappa with VDef > 5 %) is 0.0 for all phenotypes because sigma alone already produces 14 % asthma defects, so that sweep summary is uninformative (-3); when any CLI override is given the reference blending is switched off (L516-517), so default and override runs are not on the same model (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2018-nelson-airway-mucosal-creasing.py L1128–L1133: Tree receives only eps_mean from the overrides; --hm-scale/--mu-ratio-scale do not reach the tree <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L1128-L1133>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-parameter-expressivity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L491–L635" ;
        dcterms:description "4 phenotypes, 12-point 3-species collapse and 6-point ASM constriction curves" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L491-L635> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L1012–L1052" ;
        dcterms:description "evaluate_tree_ventilation_sweep: kappa grid x phenotypes x seeds with kappa_critical" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L1012-L1052> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L1874–L1917" ;
        dcterms:description "CLI: --epsilon-theta, --hm-scale, --mu-ratio-scale, --seed, --tree-generations, --sigma, --kappa, --pressure-controlled, --skip-gif, --skip-tree-gif" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L1874-L1917> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 068 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


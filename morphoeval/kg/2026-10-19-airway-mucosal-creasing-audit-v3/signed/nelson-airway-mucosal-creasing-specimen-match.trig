sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nelson-airway-mucosal-creasing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L641–L721" ;
        dcterms:description "Polar star-contour segmentation of the pinned micrograph: m_obs = 13, circularity 0.3981" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L641-L721> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/airway_mucosal_creasing_comparison.png (generated output)" ;
        dcterms:description "9-panel figure: rosettes A-D, specimen overlay E, collapse/constriction F, 3D tree ventilation G, kappa sweep H, ventilation histograms I — docs/media/airway_mucosal_creasing_comparison.png: rendered output of 2018-nelson-airway-mucosal-creasing.py at 8a7928d7, image/png, 1320348 B, 2588×2099 px, artifact_sha256 3315968b82d9c2f6bc09c306aa6191caee6e54bdf97a1073c2a35e80d95f4f00 (sha256 3315968b82d9c2f6bc09c306aa6191caee6e54bdf97a1073c2a35e80d95f4f00), spec_fingerprint b6099e6eb43c410229d8bb8eb684966c04bd0b7fa64bc5000b8d74de4532f720" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/airway_mucosal_creasing_tree_ventilation.gif (generated output)" ;
        dcterms:description "6-frame tree ventilation animation over eps_mean; defects appear in contiguous subtrees but asthma VDef dips at eps = 0.34 (area-floor saturation) — docs/media/airway_mucosal_creasing_tree_ventilation.gif: rendered output of 2018-nelson-airway-mucosal-creasing.py at 8a7928d7, image/gif, 394877 B, 1060×480 px, 6 frames, artifact_sha256 4f602ed935b342b860229e7f6cac1e93aab557076116c740010f660697da802b (sha256 4f602ed935b342b860229e7f6cac1e93aab557076116c740010f660697da802b), spec_fingerprint b6099e6eb43c410229d8bb8eb684966c04bd0b7fa64bc5000b8d74de4532f720" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 068 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Wiggs et al. (1997), Li et al. (2011) & Eskandari et al. (2015) cylindrical bilayer mucosal folding, period-doubling & Poiseuille airway resistance, coupled to a Weibel (1963) bronchial-tree impedance network with Venegas (2005) flow-stretch feedback — Morphological realism / specimen match: 82/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The 3x3 synthesis figure is regenerated and inspected: Panel E overlays the segmented 13-fold luminal star on the SHA-256-pinned H&E bronchiole micrograph; the four rosettes (relaxed circle, 13-fold healthy, 8-fold period-doubled bronchitis, 4-5-fold creased asthma) read as the clinical sequence described by Wiggs/Eskandari; new Panel G renders the 3D Weibel tree coloured by per-branch ventilation with the asthmatic defects visibly concentrated in subtrees, Panel H the kappa sweep and Panel I the ventilation histograms; the tree-ventilation GIF (6 frames) shows defects growing with eps_mean. Deductions: the specimen comparison is self-referential — the \"reference\" 13 folds and 0.40 circularity are the specimen's own values re-entered in the reference table, and there is no scale bar or um calibration, so the specimen constrains only the fold count by inspection (-8); the rosette outlines that are compared to the specimen are 75 % analytic template with reference-blended area (L420, L436-438), so their resemblance is partly built in (-5); the tree defect clustering is only 1.25x the Bernoulli expectation, weaker than the large contiguous Venegas defects, and no PET-like projection is attempted (-3); the specimen is a single healthy muscular bronchiole, so bronchitis and asthma rosettes have no specimen counterpart (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/airway_mucosal_creasing/airway_mucosal_creasing_reference.json L1–L213: Specimen reference fold count 13 and circularity 0.40 are the same specimen's values (self-referential comparison) <https://github.com/fractastical/morpholib/blob/8a7928d7/datasets/airway_mucosal_creasing/airway_mucosal_creasing_reference.json#L1-L213>",
            "docs/media/airway_mucosal_creasing_growth.gif (generated output, not in repo): Healthy vs asthma rosette growth animation over ASM strain; its A/A_0 trajectory is 0.85 reference + 0.15 simulated (L1452-1457) — docs/media/airway_mucosal_creasing_growth.gif: rendered output of 2018-nelson-airway-mucosal-creasing.py at 8a7928d7, image/gif, 177188 B, 1071×482 px, 6 frames, artifact_sha256 5a50a0483913bcdf7a2e36c00e972d154f1908778f97ad5a9e2bb44d4323eee2 (sha256 5a50a0483913bcdf7a2e36c00e972d154f1908778f97ad5a9e2bb44d4323eee2), spec_fingerprint b6099e6eb43c410229d8bb8eb684966c04bd0b7fa64bc5000b8d74de4532f720" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-specimen-match-3> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


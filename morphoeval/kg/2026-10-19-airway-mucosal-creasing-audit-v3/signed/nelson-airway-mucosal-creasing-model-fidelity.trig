sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nelson-airway-mucosal-creasing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L204–L276" ;
        dcterms:description "Wavenumber law, inextensible-perimeter occlusion, Hagen-Poiseuille amplification, closed-form period-doubling ratio and the vectorised area law shared by ring and tree" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L204-L276> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L734–L850" ;
        dcterms:description "Weibel G0-G12 tree, branch Poiseuille resistance, exact series-parallel impedance + flow split, analytic small-airway share" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L734-L850> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L852–L1052" ;
        dcterms:description "Heterogeneous bronchospasm with log-normal ASM strain, per-branch m*, saturating Venegas feedback fixed point, defect/clustering metrics and kappa sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L852-L1052> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_068_airway_mucosal_creasing.lean L124–L175" ;
        dcterms:description "New Law 4 bifurcation_resistance_homogeneous_scaling and Law 5 venegas_feedback_strain_monotone (lean exits 0, 0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_068_airway_mucosal_creasing.lean#L124-L175> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Wiggs et al. (1997), Li et al. (2011) & Eskandari et al. (2015) cylindrical bilayer mucosal folding, period-doubling & Poiseuille airway resistance, coupled to a Weibel (1963) bronchial-tree impedance network with Venegas (2005) flow-stretch feedback — Model fidelity to source: 80/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the cylindrical bilayer wavenumber law m* = c_cyl (R_0/h_m)(3 mu_s/mu_m)^(1/3) (L204-223), the inextensible-perimeter lumen-area occlusion and Hagen-Poiseuille (A_0/A)^2 law (L225-243) and its vectorised twin shared with the tree (L245-276), and the new tree: Weibel model-A geometry (L734-785), R = 8 eta L / (pi r^4) (L787-791), exact bottom-up series-parallel impedance with top-down flow split (L794-823, conservation error <= 3e-16, homogeneous identity to 1e-9), per-branch m* and area fraction, saturating Venegas feedback with under-relaxed fixed-point iteration (L852-1009) and the analytic small-airway share (L826-850). Five Lean 4 theorems formalise the scaling, occlusion, Poiseuille, bifurcation-scaling and feedback-monotonicity laws. Deductions: the ring minimiser's headline outputs are prescribed — a_norm = 0.88 target + 0.12 computed (L436-438) and pd_sim = 0.85 pd_obs + 0.15 FFT (L430) whenever reference values are passed, which is the default (L516-517) — so the phenotype A/A_0 = 0.253 and R_flow/R_0 = 15.65 are not solutions of the stated energy (-8); the plotted profile is 75 % analytic template + 25 % minimiser (L420) and the spectral operator / energy weights (L366-371 and the 1.60, 0.35, 2.20, 0.68, 1.35, 0.32 coefficients) are unsourced tuning (-4); wall_coupling = (1+0.0085 h_m)^-0.5, C_CYL_CURVATURE = 0.7110 and epsilon_c = 0.25 (3 mu_s/mu_m)^(2/3) (L130, L217, L221) are fitted to the 12-point table rather than derived (-3); the tree is Poiseuille-only with generation-independent h_m/R_0 and m*, no Pedley correction, compliance or cartilage limit, and the 0.12 area floor inherited by `lumen_area_fraction_vectorized` saturates closed branches at 69x so the asthma defect fraction non-monotonically drops from 0.35 to 0.30 between eps = 0.28 and 0.34 in the tree GIF (-5)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2018-nelson-airway-mucosal-creasing.py L215–L222: wall_coupling 0.0085 and epsilon_c prefactor 0.25 are unsourced fitted constants <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L215-L222>",
            "2018-nelson-airway-mucosal-creasing.py L416–L421: u_combined = 0.75*(analytic base_wave + sulcus_cusp) + 0.25*u_rel: plotted rosette is mostly template <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L416-L421>",
            "2018-nelson-airway-mucosal-creasing.py L426–L440: pd_sim = 0.85*pd_ratio(observed) + 0.15*FFT and a_norm = 0.88*target_a_norm + 0.12*a_calc: phenotype outputs are prescribed, not relaxed <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L426-L440>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-model-fidelity-4> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 068 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;

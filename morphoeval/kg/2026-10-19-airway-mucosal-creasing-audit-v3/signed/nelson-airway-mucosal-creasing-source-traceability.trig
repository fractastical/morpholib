sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nelson-airway-mucosal-creasing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-source-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L133–L187" ;
        dcterms:description "EXPECTED_SHA256 for 6 assets (2 new) and runtime verify_dataset_integrity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L133-L187> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/airway_mucosal_creasing/bronchial_tree_impedance_reference.json L1–L100" ;
        dcterms:description "Weibel geometry, small-airway share, amplification reference with derivation note, sigma/kappa defaults with calibration notes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/datasets/airway_mucosal_creasing/bronchial_tree_impedance_reference.json#L1-L100> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/airway_mucosal_creasing/pass3_citations.bib L1–L60" ;
        dcterms:description "Five Pass 3 references with DOIs (recorded offline, unverified)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/datasets/airway_mucosal_creasing/pass3_citations.bib#L1-L60> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/airway_mucosal_creasing/README.md L49–L69" ;
        dcterms:description "Pass 3 literature (marked not re-verified), vendored files and media sections" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/datasets/airway_mucosal_creasing/README.md#L49-L69> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Wiggs et al. (1997), Li et al. (2011) & Eskandari et al. (2015) cylindrical bilayer mucosal folding, period-doubling & Poiseuille airway resistance, coupled to a Weibel (1963) bronchial-tree impedance network with Venegas (2005) flow-stretch feedback — Source and data traceability: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Six dataset assets are SHA-256 pinned (`EXPECTED_SHA256` L133-154) and verified fail-closed at every run (`verify_dataset_integrity` L174-187), including the new `bronchial_tree_impedance_reference.json` (Weibel model-A generations, Macklem-Mead and Venegas anchors, sigma/kappa notes with their calibration rationale) and `pass3_citations.bib` (Weibel 1963, Venegas 2005, Wiggs 1992, Macklem & Mead 1967, Pedley 1970); the dataset README documents the Pass 3 literature, laws 4-5, files and media and states that the new DOIs were recorded offline. Deductions: the five Pass 3 DOIs were written from memory and could not be verified in the isolated run (-4); the Li et al. (2011) title differs between the script header (\"Surface wrinkling of mucosa on a compliant substrate...\") and the Lean docstring / paper_citations.bib (\"Mechanics of morphological instabilities and surface wrinkling in elastomeric and mucosal airways\"), and the .bib entry carries a typo (\"elastomericectors\"), so at least one citation is wrong (-4); the 3.66 amplification reference is a derived number, not a literature value, yet is labelled with Wiggs 1992 (-2); sigma = 0.10 has no source (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/airway_mucosal_creasing/paper_citations.bib L13–L16: Li et al. (2011) title disagrees with the script header for the same DOI and contains a typo <https://github.com/fractastical/morpholib/blob/8a7928d7/datasets/airway_mucosal_creasing/paper_citations.bib#L13-L16>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-source-traceability-4> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 068 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nelson-airway-mucosal-creasing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Wiggs et al. (1997), Li et al. (2011) & Eskandari et al. (2015) cylindrical bilayer mucosal folding, period-doubling & Poiseuille airway resistance, coupled to a Weibel (1963) bronchial-tree impedance network with Venegas (2005) flow-stretch feedback — Reproducibility package: 93/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`--self-test` passes 14 checks in ~6 s (8 Pass 2 + 6 tree checks: Weibel/JSON parity and small-airway share, homogeneous identity to 1e-9 with flow conservation, relaxed-tree unit amplification, asthma > bronchitis > healthy defect hierarchy with healthy < 5 % and feedback increasing defects, convergence < 1e-2, VDef monotone in kappa, and bitwise determinism of the tree) (L1779-1871); the full render takes ~11 s and writes the PNG and both GIFs; all 6 inputs are SHA-256 verified; the RNG is seeded (default 2018) and seeds are offset per phenotype/branch; CLI flags are documented in argparse. Deductions: the determinism check is within-process (two calls), not across processes/platforms, and the PNG/GIF hashes are not pinned (-3); there is no requirements lock file for this script and the environment is recorded only in this audit (-2); the GIFs are produced by the default invocation but take most of the wall time and there is no `--quick` path for the 9-panel figure alone (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-repro-package-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L1779–L1871" ;
        dcterms:description "14-check self_test() including 6 new tree checks (identity, conservation, hierarchy, monotonicity, convergence, determinism)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L1779-L1871> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L1874–L1921" ;
        dcterms:description "argparse CLI with seed, skip-gif flags and tree parameters; main renders PNG + 2 GIFs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L1874-L1921> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L166–L187" ;
        dcterms:description "sha256_file / verify_dataset_integrity fail-closed on all 6 assets" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2018-nelson-airway-mucosal-creasing.py#L166-L187> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 068 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


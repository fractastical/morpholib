<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/manukyan-ocellated-lizard-ca-1>,
        <https://w3id.org/probknow/resource/math-law/manukyan-ocellated-lizard-ca-2>,
        <https://w3id.org/probknow/resource/math-law/manukyan-ocellated-lizard-ca-3> .

<https://w3id.org/probknow/resource/math-law/manukyan-ocellated-lizard-ca-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Hexagonal Skin-Scale First-Nearest-Neighbor Partition & Labyrinthine Symmetry" ;
    dct:description "Establishes the exact 6-neighbor conservation law on hexagonal lizard skin scales and proves n_g = n_b = 3 is the unique symmetric labyrinthine chain degree | Variables: n_g: number of green first-nearest-neighbor scales; n_b: number of black first-nearest-neighbor scales on the 6-regular hexagonal skin lattice" ;
    dct:source "Manukyan et al. (2017) Nature 544(7649):173-179 Fig. 3d-f" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2015-manukyan-ocellated-lizard-ca.py#L115-L210>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean#L19-L36> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def hex_black_neighbors (n_g : Nat) : Nat := 6 - n_g
theorem hex_scale_neighbor_partition_and_symmetry (n_g : Nat) (h : n_g ≤ 6) :
    n_g + hex_black_neighbors n_g = 6 ∧
    (n_g = hex_black_neighbors n_g ↔ n_g = 3) := by
  unfold hex_black_neighbors; omega
"""^^pk:lean4 ;
    skos:notation "n_g + n_b = 6  (n_g, n_b ∈ {0..6});   n_g = n_b ⟺ n_g = 3" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1038/nature22031>,
        <https://doi.org/10.1038/s41467-021-22525-1>,
        <https://doi.org/10.1103/PhysRevX.13.041011> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Scale-Level Cellular Automaton vs PDE" ;
    pk:leanDeclaration "MathOfBiology.Loop_009.hex_black_neighbors" ;
    pk:leanTheorem "MathOfBiology.Loop_009.hex_scale_neighbor_partition_and_symmetry" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/manukyan-ocellated-lizard-ca-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Scale-Border Thickness Reduction Inter-Scale Flux Attenuation (D_border = P D_interior ≪ D_interior)" ;
    dct:description "Proves that thinning skin at scale borders attenuates inter-scale diffusive flux relative to intra-scale homogenization, discretizing continuous Turing PDEs into monochromatic scale states | Variables: P = h_border / h_interior: scale-border thickness reduction factor (P ≈ 0.17 in Timon lepidus); D_interior: intra-scale morphogen diffusivity; ∇u: inter-scale morphogen difference" ;
    dct:source "Manukyan et al. (2017) Nature 544(7649):173-179 Fig. 4 & Methods Eqs. (1)-(8); Fofonjka & Milinkovitch (2021) Nat. Commun. 12:2433" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2015-manukyan-ocellated-lizard-ca.py#L220-L355>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean#L43-L66> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def interscale_border_flux (P_pct flux_unit : Int) : Int :=
  P_pct * flux_unit
theorem border_diffusivity_reduction_quenches_interscale_flux
    (P_pct flux_unit : Int)
    (hP_lo : P_pct ≥ 1) (hP_hi : P_pct ≤ 99) (hF : flux_unit ≥ 1) :
    interscale_border_flux 0 flux_unit = 0 ∧
    interscale_border_flux 17 flux_unit > 0 ∧
    interscale_border_flux 17 flux_unit < interscale_border_flux 100 flux_unit ∧
    P_pct < 100 := by
  unfold interscale_border_flux; omega
"""^^pk:lean4 ;
    skos:notation "J_border = P · D_interior · ∇u;   0 < P < 1 ⟹ 0 < J_border < J_continuum,   P = 0 ⟹ J_border = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1038/nature22031>,
        <https://doi.org/10.1038/s41467-021-22525-1>,
        <https://doi.org/10.1103/PhysRevX.13.041011> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Scale-Level Cellular Automaton vs PDE" ;
    pk:leanDeclaration "MathOfBiology.Loop_009.interscale_border_flux" ;
    pk:leanTheorem "MathOfBiology.Loop_009.border_diffusivity_reduction_quenches_interscale_flux" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/manukyan-ocellated-lizard-ca-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Manukyan Hexagonal Outer-Totalistic Cellular Automaton Labyrinthine Attractor Rule" ;
    dct:description "Proves that n_g = 3 is a simultaneous fixed point for both green and black scales while overcrowded green clusters (n_g ≥ 4) flip to black and isolated black pockets (n_g ≤ 1) flip to green | Variables: s ∈ {0, 1}: scale color state (0 = black, 1 = green); n_g ∈ {0..6}: number of green first-nearest neighbors" ;
    dct:source "Manukyan et al. (2017) Nature 544(7649):173-179 Figs. 2-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2015-manukyan-ocellated-lizard-ca.py#L120-L215>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean#L83-L115> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def manukyan_ca_step (s n_g : Nat) : Nat :=
  if s = 1 then (if 2 ≤ n_g ∧ n_g ≤ 3 then 1 else 0)
  else (if n_g ≤ 1 then 1 else 0)
theorem manukyan_outer_totalistic_ca_labyrinth_fixed_point :
    manukyan_ca_step 1 3 = 1 ∧ manukyan_ca_step 0 3 = 0 ∧
    manukyan_ca_step 1 5 = 0 ∧ manukyan_ca_step 0 1 = 1 := by decide
"""^^pk:lean4 ;
    skos:notation "S_i(t+1) = Φ(S_i(t), n_g(i));   Φ(1, 3) = 1 ∧ Φ(0, 3) = 0 ∧ Φ(1, 5) = 0 ∧ Φ(0, 1) = 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1038/nature22031>,
        <https://doi.org/10.1038/s41467-021-22525-1>,
        <https://doi.org/10.1103/PhysRevX.13.041011> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Scale-Level Cellular Automaton vs PDE" ;
    pk:leanDeclaration "MathOfBiology.Loop_009.manukyan_ca_step" ;
    pk:leanTheorem "MathOfBiology.Loop_009.manukyan_outer_totalistic_ca_labyrinth_fixed_point" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


<https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Manukyan et al. (2017) Nature hexagonal skin-scale border thickness reduction & outer-totalistic cellular automaton — Model fidelity to source: 50/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Implements the 6-neighbor hexagonal outer-totalistic cellular automaton (`count_hex_green_neighbors` and `simulate_hex_ca`, L27-74), but completely omits the continuous reaction-diffusion PDE with periodic scale-border thickness reduction D_border = P * D_interior (Manukyan et al. 2017 Fig. 4 & Methods Eqs. 1-8) that explains why continuous morphogen diffusion discretizes into monochromatic hexagonal skin scales." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "2015-manukyan-ocellated-lizard-ca.py L27–L74: Hexagonal outer-totalistic CA implemented without continuous scale-border reaction-diffusion PDE <https://github.com/fractastical/morpholib/blob/8871db0/2015-manukyan-ocellated-lizard-ca.py#L27-L74>" ;
    pk:hasScore 5e-01 ;
    pk:hasVerdict "partially faithful" .


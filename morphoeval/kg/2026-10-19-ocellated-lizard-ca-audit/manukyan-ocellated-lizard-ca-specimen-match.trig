sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-manukyan-ocellated-lizard-ca> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Manukyan et al. (2017) Nature hexagonal skin-scale border thickness reduction & outer-totalistic cellular automaton — Morphological realism / specimen match: 28/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Although `datasets/ocellated_lizard_ca/timon_lepidus_specimen.jpg` is vendored on disk, the v1 script never loads, segments, or displays the biological *Timon lepidus* specimen photograph (`docs/media/ocellated_lizard_ca_comparison.png` shows only a 2-panel synthetic CA grid and histogram) and performs no quantitative comparison against empirical dorsal green/black scale lattices." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2015-manukyan-ocellated-lizard-ca.py L77–L108: 2-panel synthetic CA figure without Timon lepidus specimen segmentation <https://github.com/fractastical/morpholib/blob/8871db0/2015-manukyan-ocellated-lizard-ca.py#L77-L108>",
            "docs/media/ocellated_lizard_ca_comparison.png (generated output, not in repo): Synthetic 2-panel plot lacking biological specimen comparison — docs/media/ocellated_lizard_ca_comparison.png: rendered output of 2015-manukyan-ocellated-lizard-ca.py at 8871db0, image/png, 32694 B, 1213×559 px, artifact_sha256 9450c57e57e5c19b0a6a3800debe9607df9072800a48b8d674f32efd06048a5b (sha256 9450c57e57e5c19b0a6a3800debe9607df9072800a48b8d674f32efd06048a5b), spec_fingerprint 242b9a7c86c1f9293dfbf14c7b4f7718e95fac3e748d9d6c90e4cc1c23174b29" ;
        pk:hasScore "0.28"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 009 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


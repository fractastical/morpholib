sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-manukyan-ocellated-lizard-ca> a pk:Claim ;
        rdfs:label "Manukyan et al. (2017) Nature hexagonal skin-scale border thickness reduction & outer-totalistic cellular automaton faithfully reproduces Ocellated / jeweled lizard (Timon lepidus) dorsal skin scale labyrinth morphology" ;
        dcterms:description "The simulation script(s) 2015-manukyan-ocellated-lizard-ca.py implement the cited source model as published and produce forms that match real Ocellated / jeweled lizard (Timon lepidus) dorsal skin scale labyrinth specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 46.7/100, audit 2026-10-19-ocellated-lizard-ca-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/8871db0/2015-manukyan-ocellated-lizard-ca.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2015-manukyan-ocellated-lizard-ca.py; output: docs/media/ocellated_lizard_ca_comparison.png; organism: Ocellated / jeweled lizard (Timon lepidus) dorsal skin scale labyrinth; checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 242b9a7c86c1f9293dfbf14c7b4f7718e95fac3e748d9d6c90e4cc1c23174b29; artifact_sha256: 9450c57e57e5c19b0a6a3800debe9607df9072800a48b8d674f32efd06048a5b; input_dataset_sha256: {datasets/ocellated_lizard_ca/ocellated_lizard_ca_reference.json=ed1472207d9c79bb..., datasets/ocellated_lizard_ca/scout_manifest.json=e5bca2d8766b49e7..., datasets/ocellated_lizard_ca/timon_lepidus_specimen.jpg=bc8e149849e6729d...}" ;
        pk:derivedFromPaper <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/nature22031>,
            <https://doi.org/10.1038/s41467-021-22525-1>,
            <https://doi.org/10.1103/PhysRevX.13.041011> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-specimen-match> ;
        pk:weightOfEvidence "0.467"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/8871db0/2015-manukyan-ocellated-lizard-ca.py> a schema:SoftwareSourceCode ;

    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/j.cub.2016.07.016>,
            <https://doi.org/10.1016/j.ympev.2020.107061>,
            <https://doi.org/10.1023/a:1003704315194>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1016/j.cub.2016.07.016> dct:date "2016"^^xsd:gYear ;
        dct:title "The pdm3 locus is a hotspot for recurrent evolution of female-limited color dimorphism in Drosophila" .
    <https://doi.org/10.1016/j.ympev.2020.107061> dct:date "2021"^^xsd:gYear ;
        dct:title "A phylogeny for the Drosophila montium species group" .
    <https://doi.org/10.1023/a:1003704315194> dct:date "1999"^^xsd:gYear ;
        dct:title "Phenotypic plasticity of abdominal pigmentation in Drosophila kikkawai" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
}


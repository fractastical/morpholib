<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-kikkawai-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail-scale wavelength order across the chronoseries" ;
    dct:description "What changes at 2.3 µm and 0 Ma relative to the predecessor and successor | Variables: lambda in nanometres; Dv_maur=0.413, Dv_kikk=1.364, Dv_hydei=4.470; Du=0.020, a=0.070, b=0.940" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-kikkawai-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3190_drosophila_kikkawai_turing_wavelength_s0.lean#L14-L17> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda(D. mauritiana) < lambda(D. kikkawai) < lambda(D. hydei) at 0 Ma" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cub.2016.07.016>,
        <https://doi.org/10.1016/j.ympev.2020.107061>,
        <https://doi.org/10.1023/a:1003704315194>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3190.lamKikkawaiNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3190.wavelength_chronoseries_order" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-kikkawai-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Mode count on a 48 µm patch" ;
    dct:description "Shorter detail-scale wavelength packs more pigment repeats into the same patch | Variables: lamNm, modeCount" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-kikkawai-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3190_drosophila_kikkawai_turing_wavelength_s0.lean#L20-L25> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = floor(48000 nm / lambda_nm); N_hydei < N_kikkawai = 20 < N_mauritiana" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cub.2016.07.016>,
        <https://doi.org/10.1016/j.ympev.2020.107061>,
        <https://doi.org/10.1023/a:1003704315194>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3190.modeCount" ;
    pk:leanTheorem "MathOfBiology.Loop_3190.mode_count_increases_as_wavelength_falls" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-kikkawai-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Focal differential diffusion versus equal-diffusion ablation" ;
    dct:description "Negative control for Turing wavenumber selection | Variables: Dv, Du in thousandths" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-kikkawai-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3190_drosophila_kikkawai_turing_wavelength_s0.lean#L39-L46> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "Dv - Du > 0 at the focal ratio; Dv - Du = 0 extinguishes the Turing gap" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cub.2016.07.016>,
        <https://doi.org/10.1016/j.ympev.2020.107061>,
        <https://doi.org/10.1023/a:1003704315194>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3190.diffusionGap" ;
    pk:leanTheorem "MathOfBiology.Loop_3190.focal_inhibitor_outruns_activator" ;
    pk:leanVerified true .


    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila kikkawai Turing wavelength at 2.3 µm (detail, 0 Ma) — Model fidelity to source: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script integrates the Schnakenberg PDE and the Turing growth-rate peak, with parameters derived so the linear peak sits on 2.344 µm. The field that is actually rendered saturates at an FFT wavelength of 2.182 µm, so the drawn pattern is not yet the critical mode." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "models/2026-delphi10000-drosophila-kikkawai-turing-wavelength-s0.py L212–L233: hero FFT returns 2.182 µm, off the 2.343 µm target <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-kikkawai-turing-wavelength-s0.py#L212-L233>" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila kikkawai Turing wavelength at 2.3 µm (detail, 0 Ma) — Morphometric validation: 80/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Pearson r = 0.9993 between the analytic peak and the integer mode the PDE amplifies, with RMSE 0.193 µm. Orientation KS against the plate is 0.110 and the two coherencies are not equal. The hero field's own FFT (2.182 µm versus 2.343 µm) is the measurement that still fails a 3% band." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

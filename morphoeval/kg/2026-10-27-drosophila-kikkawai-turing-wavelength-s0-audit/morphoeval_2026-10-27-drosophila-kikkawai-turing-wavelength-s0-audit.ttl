    pk:evidenceAgainst "models/2026-delphi10000-drosophila-kikkawai-turing-wavelength-s0.py L288–L292: hero FFT wavelength not yet inside 3% of 2.343 µm <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-kikkawai-turing-wavelength-s0.py#L288-L292>" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-dispersion-sweep-pearson-r-of-analytical-versus-pde-wavelength>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-predecessor-hydei-detail-wavelength>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-simulated-tergite-stripe-wavelength>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-ks-distance>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-kikkawai-turing-wavelength-s0-morphometric-validation-1>,

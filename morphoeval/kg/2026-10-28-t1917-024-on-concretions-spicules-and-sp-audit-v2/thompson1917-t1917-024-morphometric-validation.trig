sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-024> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) spicule rays as Plateau borders of the secreting cell field vs Grantia ray angles (Pass 2: null control, sweep closure, ablations, three samples) — Morphometric validation: 76/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "The tautological Pass-1 angle plane is replaced by a real test: closest-pair difference vs a stated null (Dirichlet partition), per spicule and as a set (MC p with resolution floor, KS), with the method's own noise floor measured on known renders; alternatives scored on the same data (RMSE/AIC); P1 tested on an independent population sample with its own null; Thompson's own figure digitised and tested; near- vs chord-axis sensitivity, angle CV and within-type rho CV reported. Deductions: n = 8 + 25 + 4 from three heterogeneous sources; the population method accepts only 28 of 273 junction candidates (selection effects unquantified); the AIC treats the lattice snap as 0 free parameters (generous to the alternative, but a discrete-choice penalty is debatable); projection error of trihedral spicules is bounded only indirectly (near vs chord RMSE 5.3 deg)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-024/measurements/population_ray_angles.json (generated output, not in repo): 28 detections from 273 junction candidates: strong selection, unquantified — datasets/thompson_1917/t1917-024/measurements/population_ray_angles.json: rendered output of thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py at 94f2bb26b6ace7b3ff6e099ae0c8472784d36c7c, application/json, 18394 B, artifact_sha256 d3c866f029dc228b4f6302bd194be595d49cb02f741e34f10cd652b498a69bb5 (sha256 d3c866f029dc228b4f6302bd194be595d49cb02f741e34f10cd652b498a69bb5), spec_fingerprint 77e8201d27dd51cb520268fe921b47c6a9cc21b65c7f28e750eaa978978c6f12" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-alternative-model-rmse-crystal-120-0-params>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-closest-pair-angle-difference-d-median-sem>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-fitted-rho-cv-within-tubar-triactines-panel-d-n-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-near-axis-vs-chord-axis-angle-sensitivity-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-population-micrograph-mean-theta-120-over-physical-triradiates>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-rho-sweep-measurement-closure-pearson-r-true-vs-re-measured-theta-pair>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-tetrahedral-inter-ray-angle-e7>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-thompson-fig-214-digitised-closest-pair-difference-d-median>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-three-ray-spicules-measured-on-the-sem-plate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-unpaired-angle-deviation-from-the-paired-angle-mean-sem>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-morphometric-validation-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-morphometric-validation-4> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-alternative-model-rmse-crystal-120-0-params> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "alternative-model RMSE: crystal-120 (0 params) = 15.328 deg" ;
        dct:description "lattice-30 RMSE 8.53; AIC crystal 131.0, lattice 102.9, E5 55.0" ;
        schema:measurementTechnique "all triradiate angles = 120 (Haeckel crystallographic reading) vs measured SEM triplets" ;
        schema:name "alternative-model RMSE: crystal-120 (0 params)" ;
        schema:unitText "deg" ;
        schema:value "15.328" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-alternative-model-rmse-crystal-120-0-params-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-alternative-model-rmse-crystal-120-0-params-reference> a schema:PropertyValue ;
        dct:source "E5 one-rho-per-spicule RMSE" ;
        schema:value "2.254" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-closest-pair-angle-difference-d-median-sem> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "closest-pair angle difference d, median (SEM) = 4.408 deg" ;
        dct:description "set-mean MC p < 5e-05; KS p = 8.12e-06; 3/8 spicules below the null 5th percentile (2.93 deg)" ;
        schema:measurementTechnique "|theta_2 - theta_3| of the two closest sorted ray angles per spicule (near-junction axes); vs Dirichlet(1,1,1) null control" ;
        schema:name "closest-pair angle difference d, median (SEM)" ;
        schema:unitText "deg" ;
        schema:value "4.408" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-closest-pair-angle-difference-d-median-sem-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-closest-pair-angle-difference-d-median-sem-reference> a schema:PropertyValue ;
        dct:source "null: random partition of 360 deg (MC n=20000)" ;
        schema:value "34.803" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-fitted-rho-cv-within-tubar-triactines-panel-d-n-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fitted rho CV within tubar triactines (panel d, n=3) = 0.0043 CV" ;
        dct:description "by panel: c: n=1, d: 0.004, e: 0.195, f: 0.862" ;
        schema:measurementTechnique "std/mean of rho = -2 cos(theta_pair) across same-type spicules (E5 predicts a tissue-level rho)" ;
        schema:name "fitted rho CV within tubar triactines (panel d, n=3)" ;
        schema:unitText "CV" ;
        schema:value "0.0043" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-near-axis-vs-chord-axis-angle-sensitivity-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "near-axis vs chord-axis angle sensitivity: Pearson r = 0.978 r" ;
        dct:description "RMSE 5.35 deg; angle CV 0.130" ;
        schema:measurementTechnique "same 24 SEM angles measured from the first 35 % of each ray vs the chord to the ray tip" ;
        schema:name "near-axis vs chord-axis angle sensitivity: Pearson r" ;
        schema:unitText "r" ;
        schema:value "0.978" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-population-micrograph-mean-theta-120-over-physical-triradiates> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "population micrograph: mean |theta - 120| over physical triradiates = 17.284 deg" ;
        dct:description "all-within-15-deg fraction 0.520 (null 0.011); SD 26.46 deg; median d 12.07 deg" ;
        schema:measurementTechnique "junction-based radial-arc extraction on the CC BY-SA spread; 25 physical of 28 detections (273 junction candidates)" ;
        schema:name "population micrograph: mean |theta - 120| over physical triradiates" ;
        schema:unitText "deg" ;
        schema:value "17.284" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-population-micrograph-mean-theta-120-over-physical-triradiates-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-population-micrograph-mean-theta-120-over-physical-triradiates-reference> a schema:PropertyValue ;
        dct:source "Dirichlet(1,1,1) null" ;
        schema:value "71.197" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-rho-sweep-measurement-closure-pearson-r-true-vs-re-measured-theta-pair> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "rho sweep measurement closure: Pearson r (true vs re-measured theta_pair) = 0.99989 r" ;
        dct:description "RMSE pair 0.35 deg, RMSE rho 0.010; method noise floor for d: max 2.30 deg; unpaired angle monotone in rho: True" ;
        schema:measurementTechnique "20 E5 spicules rendered at known rho in random orientation and re-measured by radial_rays" ;
        schema:name "rho sweep measurement closure: Pearson r (true vs re-measured theta_pair)" ;
        schema:unitText "r" ;
        schema:value "0.99989" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-rho-sweep-measurement-closure-pearson-r-true-vs-re-measured-theta-pair-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-rho-sweep-measurement-closure-pearson-r-true-vs-re-measured-theta-pair-reference> a schema:PropertyValue ;
        dct:source "perfect recovery" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-tetrahedral-inter-ray-angle-e7> a schema:PropertyValue,

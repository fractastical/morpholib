        schema:value "109.4712" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-tetrahedral-inter-ray-angle-e7-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-tetrahedral-inter-ray-angle-e7-reference> a schema:PropertyValue ;
        dct:source "'about 109 deg', Thompson (1917) pp. 443-446, Fig. 214 p. 446" ;
        schema:value "109.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-thompson-fig-214-digitised-closest-pair-difference-d-median> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Thompson Fig. 214 digitised: closest-pair difference d, median = 3.469 deg" ;

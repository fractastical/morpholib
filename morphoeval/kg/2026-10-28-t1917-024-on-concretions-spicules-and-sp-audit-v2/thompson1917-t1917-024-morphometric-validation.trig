        schema:measurementTechnique "radial-arc extraction on the IA leaf-465 crop after hole filling; panels resolved: ABCD; unresolved: EF; set-mean MC p vs Dirichlet null" ;
        schema:name "Thompson Fig. 214 digitised: closest-pair difference d, median" ;
        schema:unitText "deg" ;
        schema:value "3.469" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-thompson-fig-214-digitised-closest-pair-difference-d-median-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-measurement-thompson-fig-214-digitised-closest-pair-difference-d-median-reference> a schema:PropertyValue ;

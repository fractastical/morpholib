    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) spicule rays as Plateau borders of the secreting cell field vs Grantia ray angles (Pass 2: null control, sweep closure, ablations, three samples) — Reproducibility package: 74/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Deterministic (seeded RNG for null, sweep orientations and saturation sample), --self-test covers model identities, inverse, null, saturation, sweep closure, alternatives, digests, detections and Fig. 214 (< 1 s); full run 4 s; CLI documented; measure_morphoeval returns the list format measure_outputs.py expects (Pass-1 crash fixed and now exercised); scikit-image FutureWarnings silenced. Deductions: no per-script dependency pin; checkpoint is a branch commit; the population and drawing extractors are tuned to two specific images." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;

sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-024> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-model-fidelity> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) spicule rays as Plateau borders of the secreting cell field vs Grantia ray angles (Pass 2: null control, sweep closure, ablations, three samples) — Model fidelity to source: 78/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Everything Thompson states algebraically is implemented exactly and Lean-checked, and v2 adds the law-of-sines inverse, the saturation demonstration (F1) and the explicit falsifiable-content statement, which is the honest reading of a tension-triangle model. Still no foam / cell-doublet simulation of the deposition field itself (the GIF's three-cell field remains illustrative), and ray curvature is treated as a measurement nuisance rather than modelled (Thompson's own 'bourrelet' remark)." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L557–L564: three_cell_field: cells on sector bisectors, not a tension-derived foam <https://github.com/fractastical/morpholib/blob/94f2bb26b6ace7b3ff6e099ae0c8472784d36c7c/thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py#L557-L564>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-model-fidelity-3> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L102–L140" ;
        dcterms:description "neumann_angles (E3), tensions_from_angles (E2 inverse), sagittal_angles (E5), tension_ratio_from_angles, polyhedral_ray_angles (E7/E8), interstice_area (E9)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/94f2bb26b6ace7b3ff6e099ae0c8472784d36c7c/thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py#L102-L140> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L165–L182" ;
        dcterms:description "general_model_saturation: fraction realised 1.0 — general model not testable" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/94f2bb26b6ace7b3ff6e099ae0c8472784d36c7c/thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py#L165-L182> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_024.lean L59–L229" ;
        dcterms:description "6 theorems, lean exit 0, 0 sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/94f2bb26b6ace7b3ff6e099ae0c8472784d36c7c/morphoeval/lean/loops/Thompson1917_T1917_024.lean#L59-L229> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 2; second assessor pending R1)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .
}


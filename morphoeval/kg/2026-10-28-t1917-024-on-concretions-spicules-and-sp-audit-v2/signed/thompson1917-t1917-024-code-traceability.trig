sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-024> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-code-traceability> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) spicule rays as Plateau borders of the secreting cell field vs Grantia ray angles (Pass 2: null control, sweep closure, ablations, three samples) — Code-to-model traceability: 78/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Header now states P1-P3, E1-E9, F1-F4 and the ablations with page numbers; each analysis function names its prediction (F1 saturation, F2 null, F4 ordering); the Lean header and KG yaml map theorems to equations and functions. Deductions: KG code loci are by function name; segmentation constants (90/400/1500/0.9; population 0.06/5-26 px; drawing 0.10) are tuned to these images and traced only to the plate." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-code-traceability-2> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L1–L66" ;
        dcterms:description "CLAIM UNDER TEST / MODEL / FALSIFIABLE CONTENT / DATA header" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/94f2bb26b6ace7b3ff6e099ae0c8472784d36c7c/thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py#L1-L66> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/thompson1917-t1917-024.yaml L60–L131" ;
        dcterms:description "5 laws with lean_theorem, lean_locus, code_locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/94f2bb26b6ace7b3ff6e099ae0c8472784d36c7c/morphoeval/math_kg_loops/thompson1917-t1917-024.yaml#L60-L131> .


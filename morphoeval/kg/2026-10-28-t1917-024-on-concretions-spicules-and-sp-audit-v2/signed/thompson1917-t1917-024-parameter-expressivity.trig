sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-024> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-parameter-expressivity> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) spicule rays as Plateau borders of the secreting cell field vs Grantia ray angles (Pass 2: null control, sweep closure, ablations, three samples) — Parameter expressivity: 78/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "rho is swept over 20 values across its whole range with measured outputs: the re-measured unpaired angle is strictly monotone in rho and both angles track E5 with r = 0.9999; rho, threshold, null size and sample selection are exposed on the CLI. Deductions: the sweep is over rendered spicules (model-to-measurement closure), not over an independent generative parameter of a deposition field; the general three- tension model is only sampled for saturation, not swept with outputs." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-parameter-expressivity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-parameter-expressivity-3> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L522–L554" ;
        dcterms:description "rho_sweep: render at known rho, re-measure, r / RMSE / monotonicity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/94f2bb26b6ace7b3ff6e099ae0c8472784d36c7c/thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py#L522-L554> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-024/measurements/rho_sweep.json (generated output)" ;
        dcterms:description "20/20 recovered, r 0.9999, RMSE pair 0.35 deg, rho RMSE 0.011 — datasets/thompson_1917/t1917-024/measurements/rho_sweep.json: rendered output of thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py at 94f2bb26b6ace7b3ff6e099ae0c8472784d36c7c, application/json, 6856 B, artifact_sha256 a999bc30d800b8bfea6dc3e964ba9e3cb54cfa9955bf7ee23607710f79f89833 (sha256 a999bc30d800b8bfea6dc3e964ba9e3cb54cfa9955bf7ee23607710f79f89833), spec_fingerprint 77e8201d27dd51cb520268fe921b47c6a9cc21b65c7f28e750eaa978978c6f12" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L939–L948" ;

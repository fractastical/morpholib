sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-024> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-specimen-match> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) spicule rays as Plateau borders of the secreting cell field vs Grantia ray angles (Pass 2: null control, sweep closure, ablations, three samples) — Morphological realism / specimen match: 70/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Six-panel comparison: SEM overlay with per-spicule axes and angles; measured vs E5 renders at fitted rho with corrected orientation (the Pass-1 mis-orientation is fixed); Thompson's own Fig. 214 with digitised axes; population spread histogram. The Y (c), sagittal (d), near-equiangular (e) and T (f) forms are all visibly reproduced by the one-parameter family. Deductions: rays rendered straight (real c, e laterals curve), tetractine apical rays not rendered (stated), drawings E/F unresolved, and still a single SEM individual." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-024/measurements/fig214_digitised.json (generated output, not in repo): panels E, F unresolved: hairline outlines detach — datasets/thompson_1917/t1917-024/measurements/fig214_digitised.json: rendered output of thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py at 94f2bb26b6ace7b3ff6e099ae0c8472784d36c7c, application/json, 6719 B, artifact_sha256 8bd1754bf301c678d7ed47271f8943e5840e96284fdd1089e08a592e279e2557 (sha256 8bd1754bf301c678d7ed47271f8943e5840e96284fdd1089e08a592e279e2557), spec_fingerprint 77e8201d27dd51cb520268fe921b47c6a9cc21b65c7f28e750eaa978978c6f12" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-specimen-match-2> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_024_on_concretions_spicules_and_sp_comparison.png (generated output)" ;
        dcterms:description "panels (a) SEM axes, (b) measured vs E5, (f) Fig. 214 digitised — docs/media/t1917_024_on_concretions_spicules_and_sp_comparison.png: rendered output of thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py at 94f2bb26b6ace7b3ff6e099ae0c8472784d36c7c, image/png, 587937 B, 1900×1250 px, artifact_sha256 e4526bfdf295d88731e41f15187b4f2dee07e46d148a0f2b39d42425edfa6985 (sha256 e4526bfdf295d88731e41f15187b4f2dee07e46d148a0f2b39d42425edfa6985), spec_fingerprint 77e8201d27dd51cb520268fe921b47c6a9cc21b65c7f28e750eaa978978c6f12" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L599–L605" ;
        dcterms:description "basal_direction: ray not bounding the unpaired gap (orientation fix R6)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/94f2bb26b6ace7b3ff6e099ae0c8472784d36c7c/thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py#L599-L605> .


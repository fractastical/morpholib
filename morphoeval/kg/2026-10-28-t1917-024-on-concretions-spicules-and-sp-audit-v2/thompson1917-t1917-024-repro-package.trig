sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-024> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-024-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) spicule rays as Plateau borders of the secreting cell field vs Grantia ray angles (Pass 2: null control, sweep closure, ablations, three samples) — Reproducibility package: 74/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Deterministic (seeded RNG for null, sweep orientations and saturation sample), --self-test covers model identities, inverse, null, saturation, sweep closure, alternatives, digests, detections and Fig. 214 (< 1 s); full run 4 s; CLI documented; measure_morphoeval returns the list format measure_outputs.py expects (Pass-1 crash fixed and now exercised); scikit-image FutureWarnings silenced. Deductions: no per-script dependency pin; checkpoint is a branch commit; the population and drawing extractors are tuned to two specific images." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-repro-package-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L903–L936" ;
        dct:description "self_test: 20 assertions incl. sweep closure thresholds" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/94f2bb26b6ace7b3ff6e099ae0c8472784d36c7c/thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py#L903-L936> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-024-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py L848–L900" ;
        dct:description "measure_morphoeval: 10 measurement records with reference values and null notes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/94f2bb26b6ace7b3ff6e099ae0c8472784d36c7c/thompson/claims/t1917-024_on-concretions-spicules-and-spicular-skeletons.py#L848-L900> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 2; second assessor pending R1)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


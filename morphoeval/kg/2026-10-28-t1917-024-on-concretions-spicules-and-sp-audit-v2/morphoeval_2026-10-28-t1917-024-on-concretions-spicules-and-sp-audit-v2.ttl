    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-024-on-concretions-spicules-and-sp-audit-v2-thompson1917-t1917-024-1>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-024-on-concretions-spicules-and-sp-audit-v2-thompson1917-t1917-024-10>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-024-on-concretions-spicules-and-sp-audit-v2-thompson1917-t1917-024-2>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-024-on-concretions-spicules-and-sp-audit-v2-thompson1917-t1917-024-3>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-024-on-concretions-spicules-and-sp-audit-v2-thompson1917-t1917-024-4>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-024-on-concretions-spicules-and-sp-audit-v2-thompson1917-t1917-024-5>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-024-on-concretions-spicules-and-sp-audit-v2-thompson1917-t1917-024-6>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-024-on-concretions-spicules-and-sp-audit-v2-thompson1917-t1917-024-7>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-024-on-concretions-spicules-and-sp-audit-v2-thompson1917-t1917-024-8>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-024-on-concretions-spicules-and-sp-audit-v2-thompson1917-t1917-024-9> ;
    pk:hypothesisType "Surface-Tension Force Balance at a Plateau Border (Neumann Tension Triangle) & Polyhedral Ray Geometry" ;
    pk:weightOfEvidence 7.59e-01 .


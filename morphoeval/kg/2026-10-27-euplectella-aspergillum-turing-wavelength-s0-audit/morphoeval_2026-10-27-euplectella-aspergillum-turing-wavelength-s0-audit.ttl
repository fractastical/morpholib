    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Euplectella aspergillum Turing wavenumber at 34.3 µm (Holocene, detail s0) — Morphological realism / specimen match: 74/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Side by side, the GIF is a fan of pale tubes with a square-and-diagonal pore lattice and open rims, which is the right body plan for the Okeanos photograph of Euplectella aspergillum. verify_image_fitness CV similarity on the 12-frame 960×720 GIF is 81.8. The rims collapse into horizontal bands, the mesh is perfectly periodic, and the photograph's irregular weave, shrimp, and sediment are absent. Scored as a recognisable lattice animal, not as a photograph." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:evidenceAgainst "models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py L386–L404: arc = theta * local radius, which aliases at the narrow rim <https://github.com/fractastical/morpholib/blob/b9fc897b/models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py#L386-L404>" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-specimen-match-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-specimen-match-2> ;
    pk:hasScore 7.4e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Euplectella aspergillum Turing wavenumber at 34.3 µm (Holocene, detail s0) (Euplectella aspergillum)",
        "Euplectella aspergillum Turing wavenumber at 34.3 µm (Holocene, detail s0) faithfully reproduces Euplectella aspergillum morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-euplectella-aspergillum-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-euplectella-aspergillum-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-euplectella-aspergillum-turing-wavelength-s0-3>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-euplectella-aspergillum-turing-wavelength-s0-4> ;
    dct:description "The simulation script(s) models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Euplectella aspergillum specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py> ;
    schema:about "Euplectella aspergillum" ;
    schema:additionalProperty "does_not_claim: A chronospecies split. The series is Holocene only (0 Ma).",
        "does_not_claim: That Monn et al. 2015 lamella thicknesses were fitted.",
        "does_not_claim: That the 51 µm sibling parameters were copied.",
        "does_not_claim: That this sponge has ocelli or pigment stripes.",
        "reconstructed_in_script: Equal-diffusion ablation and a γ sweep of wavelength.",
        "reconstructed_in_script: Four-mode amplitude equations on |k|=k_c, drawn on a tube fan.",
        "reconstructed_in_script: Schnakenberg linearisation and σ(k), calibrated to λ_c=3.43e-05 m.",
        "reported_in_source: Aizenberg et al. 2005: seven hierarchical levels and a cylindrical square lattice reinforced by diagonal ridges.",
        "reported_in_source: Turing 1952: dispersion relation and critical wavenumber.",
        "reported_in_source: Weaver et al. 2007: assembly of the siliceous lattice of E. aspergillum.",
        "transfer_boundary: The cohort phrase 'pigment stripe / ocellus' is transferred onto a skeletal lattice. The portrait magnifies λ_c; it is not a camera-scale micrograph." ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Euplectella aspergillum (Holocene (Extant))" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "II. Anaima (Invertebrata)" ;

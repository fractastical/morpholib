sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Euplectella aspergillum Turing wavenumber at 34.3 µm (Holocene, detail s0) — Code-to-model traceability: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The module docstring states the PDEs, the steady state, h, and λ_c. jacobian, sigma_of_k, integrate_amplitudes, and lattice_phi each implement one of those lines. The Lean file cites the same integers (343, 183183, 23²>120, equal-diffusion h<0, 1.48<λ ratio<1.49). Deduction: there is no equation number taken from Aizenberg et al. 2005, because that paper is anatomical rather than a dispersion-relation paper." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-code-traceability-2> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py L1–L45" ;
        dct:description "docstring equations and claim about the 51 µm comparison" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9fc897b/models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py#L1-L45> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/delphi10000-euplectella-aspergillum-turing-wavelength-s0.yaml L12–L54" ;
        dct:description "four laws with Lean and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9fc897b/morphoeval/math_kg_loops/delphi10000-euplectella-aspergillum-turing-wavelength-s0.yaml#L12-L54> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent Pass 1; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


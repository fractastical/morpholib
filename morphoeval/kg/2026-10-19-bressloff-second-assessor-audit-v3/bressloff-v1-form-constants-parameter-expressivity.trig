sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-parameter-expressivity-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-parameter-expressivity-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Parameter expressivity: 76/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "The script provides parameter_sweep and a --sweep CLI flag covering six biophysical coupling parameters (lateral_wide_sigma, lateral_inhibition, lateral_spread_deg, lateral_sigma, eigen_beta, local_sigma_deg) and plots three sweeps in Panels F and G. Increasing lateral_wide_sigma from 1.5 to 6.0 monotonically lowers q* from 1.46 to 0.70, increasing lateral_inhibition from 0 to 1 monotonically raises q* from the 0.05 floor to 1.00, and sweeping lateral_spread_deg from 0 to 90 degrees induces two parity flips between odd and even branches at 45 and 90 degrees. However, all five gallery columns share the exact same biophysical coupling parameters (lateral_sigma=1.0, lateral_wide_sigma=1.5, lateral_inhibition=1.0, lateral_spread_deg=60.0, eigen_beta=0.35, giving identical q* = 1.447468 and 11 cycles) and differ solely via manual preset overrides of pattern and pattern_angle_deg (-12 pts). Moreover, across all six sweepable parameters, the unrestricted cubic branch selection remains locked to rhombic (roll_ever_stable=False and square_ever_stable=False everywhere), so sweeping the model's coupling parameters never drives transitions across Klüver's form- constant families (-8 pts). Finally, the lateral_spread_deg sweep in Panel G evaluates q* on a 128-point grid (step 0.0272) over which q* takes only three discrete values between 0.9465 and 1.0280, yielding a quantized step curve (-4 pts)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-4> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L380–L460" ;
        dct:description "Gallery presets in PAPER_PRESETS share identical coupling parameters and vary only pattern, pattern_angle_deg, and sharpness" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L380-L460> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L1506–L1560" ;
        dct:description "SWEEPABLE_PARAMS and parameter_sweep implementation over 6 coupling parameters" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L1506-L1560> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L1687–L1707" ;
        dct:description "Sweep summaries confirming unrestricted_selected_family is solely rhombic and roll_ever_stable / square_ever_stable are always False" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L1687-L1707> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "bressloff_v1_metrics.csv L31–L43" ;
        dct:description "CSV kluver_form_constant and parameter_sweep rows showing identical critical_q=1.447468 across all 5 gallery presets and 3-bin quantization in lateral_spread_deg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/bressloff_v1_metrics.csv#L31-L43> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


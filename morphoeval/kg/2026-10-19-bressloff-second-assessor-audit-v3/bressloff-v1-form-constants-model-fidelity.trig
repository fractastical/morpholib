sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-model-fidelity-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-model-fidelity-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Model fidelity to source: 76/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "The script accurately implements the intra-hypercolumn Fourier harmonics (Eq. 3.12), anisotropic Fourier- Bessel lateral coupling weights (Eq. 4.9), second-order Rayleigh-Schrödinger dispersion curves lambda_even/odd(q), and the exact two-regime log-polar retino-cortical map with analytic inverse and tangent orientation map phi_R = phi + theta_R, matching all 5 stability_reports and all 24 preset runs in paper- calibration.json to 2.22e-16. However, amplitude_gamma2 and amplitude_gamma3 compute only unweighted local orientation overlap integrals without the spatial lateral-kernel weighting, quadratic-mode feedback, or quintic terms of Bressloff et al. (2001 §5, Eqs. 5.12-5.15), which prevents rolls and squares from ever stabilizing, leaves odd-branch H0/Hpi degenerate (eta_hex = 0), and causes 12 of 133 paper-expectation checks to fail (-10 pts). In stability_scan and branch_selection_for, presets with fixed parity != critical_branch (such as fig29_* and fig30_*) evaluate the even eigenfunction at the odd branch's critical_q and growth rate, and roll_stable checks 2*gamma_3(theta) > gamma_0 only at the preset's rendering angle pattern_angle_deg rather than across all theta (falsely reporting roll_stable=True in CSV rows 9, 10, and 12) (-5 pts). Furthermore, _eval_xy maximizes |a(r, phi)| rather than signed activity a(r, phi), introducing sign-flip jumps across nodal lines that double the contoured hexagonal spatial frequency (k* = 21 vs 11 cycles), and orientation_eigen_details truncates at m=4 with an ad-hoc +-1.5 clamp vs m=10 in branch_coupling_sum (-5 pts). Finally, the wavenumber scaling k = q*/d_hyp with upstream alpha, beta, and xi_hat_lat = 1.5 yields a cortical wavelength lambda_c = 8.68 mm (11 cycles) that is 3.1x longer than the paper's 2.4-3.2 mm (30-36 stripes), and the Rule et al. (2011) panel has no dynamical or Floquet solver (-4 pts)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-4> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L519–L599" ;
        dct:description "Fourier harmonics W_n, Fourier-Bessel lateral coupling W_n^lat(q), and O(beta^2) perturbative dispersion relation branch_growth" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L519-L599> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L672–L859" ;
        dct:description "Unweighted orientation-overlap integrals amplitude_gamma2/amplitude_gamma3 and branch_selection_for where roll_stable only tests pattern_angle_deg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L672-L859> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L946–L960" ;
        dct:description "stability_scan evaluates branch_selection_for at critical_q of critical_branch even when eff_params.parity is fixed to the opposite branch, and sets wave_number = critical_q / hypercolumn_mm" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L946-L960> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L1069–L1093" ;
        dct:description "_eval_xy selects argmax_phi |a(x, phi)| via np.abs(val) > np.abs(best), flipping signs across nodal boundaries" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L1069-L1093> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


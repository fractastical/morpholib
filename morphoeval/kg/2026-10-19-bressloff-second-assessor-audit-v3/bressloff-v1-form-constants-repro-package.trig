sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-repro-package-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-repro-package-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Reproducibility package: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "The script is completely deterministic (no stochastic state), verifies SHA-256 checksums for all four dataset files before executing, switches cleanly to the headless Agg backend when --no-show or --self-test is passed, and passes all 22 assertions in --self-test in ~18 seconds. Dependencies are specified in requirements.txt and locked with exact versions in requirements.lock.txt (Python 3.14.7, numpy==2.5.4, matplotlib==3.10.7, pillow==12.0.0, scipy==1.16.3). A 4-point deduction applies because README.md documents an outdated check count, runtime, and figure grid (17 checks in ~3 s, 4x4 grid, 4 GIF presets) while omitting --sweep, --preset, and --hemifield-mode, and requirements.lock.txt drops opencv-python and tifffile from requirements.txt due to a numpy>=2.3 dependency conflict (-4 pts). A further 3 points are deducted because passing --sweep PARAM --csv /path/out.csv writes to <stem>_sweep_<PARAM>.csv instead of the requested --csv path and silently exits before generating --csv or --out unless --out is also passed explicitly on the command line (-3 pts)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-4> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L100–L116" ;
        dct:description "Headless Agg backend selection and FIXTURE_CHECKSUMS SHA-256 dictionary" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L100-L116> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L2427–L2618" ;
        dct:description "Deterministic self_test() suite executing 22 checks across fixtures, parity, pullback, FFT, sweeps, and anchors" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L2427-L2618> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L2621–L2680" ;
        dct:description "CLI argument handling where --sweep rewrites the --csv filename and skips run_bressloff_analysis unless --out is explicitly supplied" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L2621-L2680> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "requirements.lock.txt L1–L50" ;
        dct:description "Pinned virtualenv lockfile noting omission of opencv-python and tifffile due to numpy==2.5.4 incompatibility" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/requirements.lock.txt#L1-L50> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


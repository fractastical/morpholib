        dct:description "fig7_lattice_tunnel: imposed-unstable; fig33_rhombic_even_roll: imposed-unstable; fig31_square_even: imposed-unstable; fig35_hex_zero_even: stable-coexisting; fig33_rhombic_even: selected" ;
        schema:measurementTechnique "rendered family == unrestricted_selected_family, out of 5 gallery panels; 1 further panels are linearly stable branches that lose the Lyapunov tie-break, 3 are imposed (unstable at cubic order)" ;
        schema:name "Gallery panels whose rendered lattice is the branch the cubic amplitude equations select (rhombic angle free)" ;
        schema:unitText "count" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-gallery-panels-whose-rendered-lattice-is-the-branch-the-cubic-amplitude-equations-select-rhombic-angle-free-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-measurement-gallery-panels-whose-rendered-lattice-is-the-branch-the-cubic-amplitude-equations-select-rhombic-angle-free-reference> a schema:PropertyValue ;
        dct:source "Bressloff et al. 2001 §5 cubic amplitude equations (Eqs. 5.9-5.15), evaluated by branch_selection_for()" ;
        schema:value "5.0" .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-bressloff-second-assessor-audit-v3-bressloff-v1-form-constants-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Source and data traceability: 93/100" ;
        rdfs:comment "All seven primary literature sources (Bressloff et al. 2001, 2002; Ermentrout & Cowan 1979; Rule et al. 2011; Horton & Hoyt 1991; Tamekue et al. 2024; Klüver 1966) carry resolvable DOIs and PMIDs in the script header, datasets/bressloff/README.md, and datasets/bressloff/paper_citations.bib. All four JSON fixtures in datasets/bressloff/ are pinned by SHA-256 in FIXTURE_CHECKSUMS and attributed to commit 344863a1bd9e8a8e8c9cb20aced2897f3ffb2c4c of MesmerPrism/bressloff-v1-form-constants under the MIT License, and RETINO_CONSTANT_PROVENANCE explicitly separates paper-derived constants (w0, eps from Drasdo 1977) from upstream Rust constants (alpha, beta). A deduction of 4 points applies because the numerical values RETINO_ALPHA = 3/pi and RETINO_BETA = 1.589/2 have no derivation beyond citing upstream params.rs, and driven-neural-fields-registry.json references two additional sources (nicks-et-al-2021 and bolelli- prandi-2025) that are omitted from paper_citations.bib (-4 pts). An additional 3 points are deducted because the top-level README.md section for this script has drifted out of sync with the code's provenance disclosures, still claiming '10/11 pass, and the one failure' (omitting the 122 runs[].checks with 11 failures) and stating that both hemispheres carry the same bilateral eigenmode by default (-3 pts). Evidence: 2001-bressloff-v1-form-constants.py L11–L45: Primary sources with DOIs/PMIDs and upstream commit 344863a1bd9e8a8e8c9cb20aced2897f3ffb2c4c <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L11-L45>; 2001-bressloff-v1-form-constants.py L111–L152: FIXTURE_CHECKSUMS SHA-256 pins, RETINO_CONSTANT_PROVENANCE, and PAPER_SCALE_ANCHORS <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L111-L152>; datasets/bressloff/paper_citations.bib L1–L92: BibTeX entries for the 7 primary references, omitting Nicks et al. (2021) and Bolelli & Prandi (2025) from driven-neural-fields-registry.json <https://github.com/fractastical/morpholib/blob/d6f3c94/datasets/bressloff/paper_citations.bib#L1-L92>; README.md L428–L443: Outdated script walkthrough claiming 10/11 fixture checks, bilateral-mirror default, sqrt(3)k hex ring, and 4x4 / 4-preset layout <https://github.com/fractastical/morpholib/blob/d6f3c94/README.md#L428-L443>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-bressloff-v1-form-constants-source-traceability> ;
        pk:hasProbability "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-bressloff-v1-form-constants-source-traceability> rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants (2001-bressloff-v1-form-constants.py, docs/media/bressloff_v1_form_constants.gif, bressloff_v1_metrics.csv, datasets/bressloff/horton_hoyt_1991_magnification.json) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Homo sapiens primary visual cortex (V1) — geometric visual hallucinations (Klüver form constants) and flicker phosphenes" ;
        dct:identifier "morphoeval/0.1.0/source-traceability" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1001/archopht.1991.01080060080030>,
            <https://doi.org/10.1007/BF00336965>,
            <https://doi.org/10.1098/rstb.2000.0769>,
            <https://doi.org/10.1137/23M1616686>,
            <https://doi.org/10.1162/089976602317250861>,
            <https://doi.org/10.1371/journal.pcbi.1002158> .
    <https://doi.org/10.1001/archopht.1991.01080060080030> dct:date "1991"^^xsd:gYear ;
        dct:title "The representation of the visual field in human striate cortex: a revision of the classic Holmes map" .
    <https://doi.org/10.1007/BF00336965> dct:date "1979"^^xsd:gYear ;
        dct:title "A mathematical theory of visual hallucination patterns" .
    <https://doi.org/10.1098/rstb.2000.0769> dct:date "2001"^^xsd:gYear ;
        dct:title "Geometric visual hallucinations, Euclidean symmetry and the functional architecture of striate cortex" .
    <https://doi.org/10.1137/23M1616686> dct:date "2024"^^xsd:gYear ;
        dct:title "A mathematical model of the visual MacKay effect" .
    <https://doi.org/10.1162/089976602317250861> dct:date "2002"^^xsd:gYear ;
        dct:title "What geometric visual hallucinations tell us about the visual cortex" .
    <https://doi.org/10.1371/journal.pcbi.1002158> dct:date "2011"^^xsd:gYear ;
        dct:title "A model for the origin and properties of flicker-induced geometric phosphenes" .
}


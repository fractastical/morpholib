sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-source-traceability-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-source-traceability-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Source and data traceability: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "All seven primary literature sources (Bressloff et al. 2001, 2002; Ermentrout & Cowan 1979; Rule et al. 2011; Horton & Hoyt 1991; Tamekue et al. 2024; Klüver 1966) carry resolvable DOIs and PMIDs in the script header, datasets/bressloff/README.md, and datasets/bressloff/paper_citations.bib. All four JSON fixtures in datasets/bressloff/ are pinned by SHA-256 in FIXTURE_CHECKSUMS and attributed to commit 344863a1bd9e8a8e8c9cb20aced2897f3ffb2c4c of MesmerPrism/bressloff-v1-form-constants under the MIT License, and RETINO_CONSTANT_PROVENANCE explicitly separates paper-derived constants (w0, eps from Drasdo 1977) from upstream Rust constants (alpha, beta). A deduction of 4 points applies because the numerical values RETINO_ALPHA = 3/pi and RETINO_BETA = 1.589/2 have no derivation beyond citing upstream params.rs, and driven-neural-fields-registry.json references two additional sources (nicks-et-al-2021 and bolelli- prandi-2025) that are omitted from paper_citations.bib (-4 pts). An additional 3 points are deducted because the top-level README.md section for this script has drifted out of sync with the code's provenance disclosures, still claiming '10/11 pass, and the one failure' (omitting the 122 runs[].checks with 11 failures) and stating that both hemispheres carry the same bilateral eigenmode by default (-3 pts)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-4> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L11–L45" ;
        dct:description "Primary sources with DOIs/PMIDs and upstream commit 344863a1bd9e8a8e8c9cb20aced2897f3ffb2c4c" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L11-L45> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L111–L152" ;
        dct:description "FIXTURE_CHECKSUMS SHA-256 pins, RETINO_CONSTANT_PROVENANCE, and PAPER_SCALE_ANCHORS" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L111-L152> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/bressloff/paper_citations.bib L1–L92" ;
        dct:description "BibTeX entries for the 7 primary references, omitting Nicks et al. (2021) and Bolelli & Prandi (2025) from driven-neural-fields-registry.json" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/datasets/bressloff/paper_citations.bib#L1-L92> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "README.md L428–L443" ;
        dct:description "Outdated script walkthrough claiming 10/11 fixture checks, bilateral-mirror default, sqrt(3)k hex ring, and 4x4 / 4-preset layout" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/README.md#L428-L443> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


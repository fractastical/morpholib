sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-bressloff-second-assessor-audit-v3-bressloff-v1-form-constants-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Reproducibility package: 93/100" ;
        rdfs:comment "The script is completely deterministic (no stochastic state), verifies SHA-256 checksums for all four dataset files before executing, switches cleanly to the headless Agg backend when --no-show or --self-test is passed, and passes all 22 assertions in --self-test in ~18 seconds. Dependencies are specified in requirements.txt and locked with exact versions in requirements.lock.txt (Python 3.14.7, numpy==2.5.4, matplotlib==3.10.7, pillow==12.0.0, scipy==1.16.3). A 4-point deduction applies because README.md documents an outdated check count, runtime, and figure grid (17 checks in ~3 s, 4x4 grid, 4 GIF presets) while omitting --sweep, --preset, and --hemifield-mode, and requirements.lock.txt drops opencv-python and tifffile from requirements.txt due to a numpy>=2.3 dependency conflict (-4 pts). A further 3 points are deducted because passing --sweep PARAM --csv /path/out.csv writes to <stem>_sweep_<PARAM>.csv instead of the requested --csv path and silently exits before generating --csv or --out unless --out is also passed explicitly on the command line (-3 pts). Evidence: 2001-bressloff-v1-form-constants.py L100–L116: Headless Agg backend selection and FIXTURE_CHECKSUMS SHA-256 dictionary <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L100-L116>; 2001-bressloff-v1-form-constants.py L2427–L2618: Deterministic self_test() suite executing 22 checks across fixtures, parity, pullback, FFT, sweeps, and anchors <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L2427-L2618>; 2001-bressloff-v1-form-constants.py L2621–L2680: CLI argument handling where --sweep rewrites the --csv filename and skips run_bressloff_analysis unless --out is explicitly supplied <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L2621-L2680>; requirements.lock.txt L1–L50: Pinned virtualenv lockfile noting omission of opencv-python and tifffile due to numpy==2.5.4 incompatibility <https://github.com/fractastical/morpholib/blob/d6f3c94/requirements.lock.txt#L1-L50>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-bressloff-v1-form-constants-repro-package> ;
        pk:hasProbability "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-bressloff-v1-form-constants-repro-package> rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants (2001-bressloff-v1-form-constants.py, docs/media/bressloff_v1_form_constants.gif, bressloff_v1_metrics.csv, datasets/bressloff/horton_hoyt_1991_magnification.json) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Homo sapiens primary visual cortex (V1) — geometric visual hallucinations (Klüver form constants) and flicker phosphenes" ;
        dcterms:identifier "morphoeval/0.1.0/repro-package" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


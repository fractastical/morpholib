sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-code-traceability-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-code-traceability-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Code-to-model traceability: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Modelling functions in 2001-bressloff-v1-form-constants.py consistently cite specific sections, equations, and figures of Bressloff et al. (2001/2002) alongside exact file and line numbers in upstream rust-v1-sim (planform.rs, params.rs, presets.rs). All 24 presets in PAPER_PRESETS map directly to numbered figures in Bressloff et al. (2001/2002), and Section 14 of morphoeval/lean/MathOfBiology.lean machine-checks the retino-cortical pullback classification, the 2*gamma_3(theta) > gamma_0 roll-stability criterion, and the +-1 Floquet multiplier return maps. However, the per-mode phase multipliers in planform_modes (0.35 for cobweb, -0.25 for rhombic, -1.0 and 0.5 for hex_pi) and preset sharpness values (1.8, 2.1, 2.3) are unmotivated upstream rendering heuristics with no citation or derivation from Bressloff et al. (-5 pts). Additionally, the README.md section for 2001-bressloff-v1-form-constants.py misdescribes the code's contoured hexagonal FFT peak as moving to the sqrt(3)k ring (whereas the code and self-test show the dominant peak is at 2k) and omits the --sweep, --preset, and --hemifield-mode CLI flags (-4 pts)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-4> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L313–L499" ;
        dct:description "PAPER_PRESETS mapping all 24 preset IDs to Bressloff (2001/2002) figures" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L313-L499> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L615–L696" ;
        dct:description "Traceability comments linking orientation_eigen_details and amplitude_gamma2/3 to Bressloff 2001 §4.2-§5 and upstream planform.rs:745-770" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L615-L696> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L982–L1014" ;
        dct:description "planform_modes with undocumented per-mode phase multipliers (0.35, -0.25, -1.0, 0.5)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/2001-bressloff-v1-form-constants.py#L982-L1014> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/MathOfBiology.lean L510–L596" ;
        dct:description "Lean 4 Section 14 theorems for retino-cortical pullback, cubic roll stability, and Floquet period doubling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d6f3c94/morphoeval/lean/MathOfBiology.lean#L510-L596> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


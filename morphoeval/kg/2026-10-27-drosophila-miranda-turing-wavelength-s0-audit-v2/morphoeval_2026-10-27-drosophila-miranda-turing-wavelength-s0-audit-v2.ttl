<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Drosophila miranda detail-scale Turing wavelength (1.9 µm, 0 Ma) (Drosophila miranda)",
        "Drosophila miranda detail-scale Turing wavelength (1.9 µm, 0 Ma) faithfully reproduces Drosophila miranda morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-miranda-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-miranda-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-miranda-turing-wavelength-s0-3>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-miranda-turing-wavelength-s0-4>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-miranda-turing-wavelength-s0-5> ;
    dct:description "The simulation script(s) models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py, morphoeval/lean/loops/Loop_3193_drosophila_miranda_turing_wavelength_s0.lean implement the cited source model as published and produce forms that match real Drosophila miranda specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3193_drosophila_miranda_turing_wavelength_s0.lean> ;
    schema:about "Drosophila miranda" ;
    schema:additionalProperty "does_not_claim: Does not claim a second independent assessor scored this audit.",
        "does_not_claim: Does not claim geological time separates these three extant species; age is 0 Ma for all three.",
        "does_not_claim: Does not claim the gallery plate is a micrograph of D. miranda pigment granules.",
        "reconstructed_in_script: At 0 Ma, λ increases melanogaster 1.412 µm → miranda 1.864 µm → mojavensis 2.286 µm.",
        "reconstructed_in_script: D_u = 0.028630 and D_v = 0.274882 µm²/time so λ_max = 1.864 µm.",
        "reconstructed_in_script: Equal-diffusion run collapses (std ratio about 4.9e-5).",
        "reconstructed_in_script: Overlay depth 0.36 selected because the CV sweep stayed above 86 at every tested depth.",
        "reported_in_source: Bachtrog (2008, 2013) neo-Y degeneration in D. miranda, with no 1.9 µm measurement.",
        "reported_in_source: Schnakenberg (1979) kinetics.",
        "reported_in_source: Shoup (1966) subcellular pigment granules in D. melanogaster.",
        "reported_in_source: Turing (1952) dispersion relation.",
        "transfer_boundary: Image fitness compares the GIF last frame to the species-gallery plate, not to an EM of granules." ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Drosophila miranda (Neo-X/Neo-Y Sex-Chromosome Evolution Fly)" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "II. Anaima (Invertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;
    pk:aristotelianSubalternClass "Entoma (Arthropoda)" ;
    pk:biologicalGenus "Drosophila" ;

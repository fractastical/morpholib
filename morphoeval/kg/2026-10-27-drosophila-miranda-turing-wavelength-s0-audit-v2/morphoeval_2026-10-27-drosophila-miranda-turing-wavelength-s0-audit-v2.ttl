<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-miranda-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg trace-determinant stability" ;
    dct:description "Diffusion-free stability at 1.9 µm and 0 Ma | Variables: f_u = 0.84, g_v = -1 at the miranda detail-scale steady state" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3193_drosophila_miranda_turing_wavelength_s0.lean#L11-L14> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "tr J = f_u + g_v = -0.16 < 0 and det J = f_u g_v - f_v g_u = 1 > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nrg3366>,
        <https://doi.org/10.1083/jcb.29.2.223>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1186/gb-2008-9-2-r30> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (Turing Wavenumber k_c)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3193.trace_hundredths" ;
    pk:leanTheorem "MathOfBiology.Loop_3193.trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-miranda-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing margin at the locked diffusivities" ;
    dct:description "Finite-wavenumber instability selecting 1.864 µm | Variables: D_u = 0.028630 µm²/time, D_v = 0.274882 µm²/time" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3193_drosophila_miranda_turing_wavelength_s0.lean#L27-L31> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(D_v f_u + D_u g_v)^2 > 4 D_u D_v det J, with D_v/D_u = 9.601" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nrg3366>,
        <https://doi.org/10.1083/jcb.29.2.223>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1186/gb-2008-9-2-r30> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (Turing Wavenumber k_c)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3193.inhibitor_faster_and_turing_margin" ;
    pk:leanTheorem "MathOfBiology.Loop_3193.inhibitor_faster_and_turing_margin" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-miranda-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control for the 1.9 µm pattern | Variables: D_u = D_v = 0.028630 µm²/time" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3193_drosophila_miranda_turing_wavelength_s0.lean#L20-L23> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_u = D_v implies D_u (f_u + g_v) < 0, so no Turing band" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nrg3366>,
        <https://doi.org/10.1083/jcb.29.2.223>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1186/gb-2008-9-2-r30> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (Turing Wavenumber k_c)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3193.equal_diffusion_weighted_trace_negative" ;
    pk:leanTheorem "MathOfBiology.Loop_3193.equal_diffusion_weighted_trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-miranda-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries wavelength order at 0 Ma" ;
    dct:description "What changes at this scale is wavenumber, not geological age | Variables: predecessor melanogaster, focal miranda, successor mojavensis, all 0 Ma" ;
    dct:source "Shoup (1966) DOI:10.1083/jcb.29.2.223; Bachtrog (2013) DOI:10.1038/nrg3366" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3193_drosophila_miranda_turing_wavelength_s0.lean#L36-L38> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "λ_melanogaster = 1.412 µm < λ_miranda = 1.864 µm < λ_mojavensis = 2.286 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nrg3366>,
        <https://doi.org/10.1083/jcb.29.2.223>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1186/gb-2008-9-2-r30> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (Turing Wavenumber k_c)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3193.chronoseries_wavelength_order" ;
    pk:leanTheorem "MathOfBiology.Loop_3193.chronoseries_wavelength_order" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-miranda-turing-wavelength-s0-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries wavenumber and mode count" ;
    dct:description "Same ordering read in wavenumber and in stripe count | Variables: integer milliradians per µm and rounded mode counts" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3193_drosophila_miranda_turing_wavelength_s0.lean#L43-L45> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_mel > k_mir > k_moj (4450 > 3371 > 2749 mrad/µm) and N = 16 > 12 > 10 on a 22.368 µm field" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nrg3366>,
        <https://doi.org/10.1083/jcb.29.2.223>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1186/gb-2008-9-2-r30> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (Turing Wavenumber k_c)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3193.chronoseries_wavenumber_and_mode_count" ;
    pk:leanTheorem "MathOfBiology.Loop_3193.chronoseries_wavenumber_and_mode_count" ;
    pk:leanVerified true .


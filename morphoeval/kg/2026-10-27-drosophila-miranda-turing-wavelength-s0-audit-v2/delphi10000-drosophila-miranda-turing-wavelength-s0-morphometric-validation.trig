sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila miranda detail-scale Turing wavelength (1.9 µm, 0 Ma) — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 0.999999996 and RMSE = 1.65e-5 per time. Equal-diffusion std ratio is 4.9e-5 against a null of 1. Plate foreground 0.370, coherency 0.806, and circularity 0.054 differ from their priors. Orientation KS between plate and pure field is 0.333. Chronoseries model wavelengths sit on 1.412 and 2.286 µm, not on the priors 1.55 and 2.05." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-continuum-versus-explicit-euler-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-du-sweep-wavelength-versus-sqrt-du-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-melanogaster-predecessor-detail-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-miranda-detail-scale-selected-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-mojavensis-successor-detail-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-specimen-plate-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-specimen-plate-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-specimen-plate-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-histogram-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-turing-trace-at-the-schnakenberg-steady-state>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-continuum-versus-explicit-euler-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "continuum versus explicit-Euler dispersion Pearson r = 0.999999996 Pearson r" ;
        dct:description "r=1.000000 RMSE=1.654707e-05 1/time" ;
        schema:measurementTechnique "Pearson correlation of σ(k) and log(ρ)/Δt of one explicit-Euler step on 24 wavenumbers" ;
        schema:name "continuum versus explicit-Euler dispersion Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.999999996" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-continuum-versus-explicit-euler-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-continuum-versus-explicit-euler-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Pass-2 goodness-of-fit gate (Pearson r > 0.98)" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 1.655e-05 1/time" ;
        dct:description "RMSE of the growth-rate curve, not a self-copy of a single scalar" ;
        schema:measurementTechnique "RMSE between continuum σ(k) and the explicit-Euler Fourier symbol" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/time" ;
        schema:value "1.655e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "Same 24-wavenumber sample as the Pearson series" ;
        schema:value "0.01" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-du-sweep-wavelength-versus-sqrt-du-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Du sweep wavelength versus sqrt(Du) Pearson r = 0.9999995172 Pearson r" ;
        dct:description "scales 0.64, 0.81, 1, 1.21, 1.44" ;
        schema:measurementTechnique "Pearson r of λ_max(D_u)/λ_miranda against √(D_u/D_u,miranda) for five scales" ;
        schema:name "Du sweep wavelength versus sqrt(Du) Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9999995172" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-du-sweep-wavelength-versus-sqrt-du-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-du-sweep-wavelength-versus-sqrt-du-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Turing scaling λ ∝ √D_u at fixed diffusivity ratio" ;
        schema:value "0.995" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation activator std ratio = 0.0 dimensionless" ;
        dct:description "ablation std=0.0000; diffusion weight=-0.0046 < 0" ;
        schema:measurementTechnique "std(u) with D_u = D_v = D_u,miranda divided by std(u) of the Turing run, same seed amplitude" ;
        schema:name "equal-diffusion ablation activator std ratio" ;
        schema:unitText "dimensionless" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-equal-diffusion-ablation-activator-std-ratio-reference> a schema:PropertyValue ;
        dct:source "Null of no effect would leave the ratio near 1; Turing requires the ratio << 1" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-melanogaster-predecessor-detail-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "melanogaster predecessor detail wavelength = 1.4114 µm" ;
        dct:description "D. melanogaster at 0 Ma; finer pigment-granule lattice than miranda" ;
        schema:measurementTechnique "k_max after scaling D_u by (1.412/1.864)² at fixed γ, age 0 Ma" ;
        schema:name "melanogaster predecessor detail wavelength" ;
        schema:unitText "µm" ;
        schema:value "1.4114" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-melanogaster-predecessor-detail-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-melanogaster-predecessor-detail-wavelength-reference> a schema:PropertyValue ;
        dct:source "Reconstructed predecessor target 1.412 µm, not a copied sibling parameter" ;
        schema:value "1.55" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-miranda-detail-scale-selected-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "miranda detail-scale selected wavelength = 1.864 µm" ;
        dct:description "FFT wavelength 1.8640 µm versus the 1.9 µm label (target 1.864 µm)" ;
        schema:measurementTechnique "radial FFT peak of the saturated Schnakenberg activator on a 22.368 µm periodic field" ;
        schema:name "miranda detail-scale selected wavelength" ;
        schema:unitText "µm" ;
        schema:value "1.864" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-miranda-detail-scale-selected-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-miranda-detail-scale-selected-wavelength-reference> a schema:PropertyValue ;
        dct:source "Slot label 1.9 µm; model target 1.864 µm (1.864e-6 m)" ;
        schema:value "1.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-mojavensis-successor-detail-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "mojavensis successor detail wavelength = 2.2841 µm" ;
        dct:description "D. mojavensis at 0 Ma; coarser lattice than miranda" ;
        schema:measurementTechnique "k_max after scaling D_u by (2.286/1.864)² at fixed γ, age 0 Ma" ;
        schema:name "mojavensis successor detail wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.2841" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-mojavensis-successor-detail-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-mojavensis-successor-detail-wavelength-reference> a schema:PropertyValue ;
        dct:source "Reconstructed successor target 2.286 µm" ;
        schema:value "2.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-specimen-plate-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen plate contour circularity = 0.0543 4πA/P²" ;
        dct:description "non-circular specimen metric; circularity is far from the ocellus prior" ;
        schema:measurementTechnique "circularity of the contrast mask of the gallery plate" ;
        schema:name "specimen plate contour circularity" ;
        schema:unitText "4πA/P²" ;
        schema:value "0.0543" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-specimen-plate-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-specimen-plate-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "A circular ocellus prior; the plate outline is not an ocellus disc" ;
        schema:value "0.62" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-specimen-plate-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen plate foreground fraction = 0.3703 area fraction" ;
        dct:description "non-circular specimen metric (measured ≠ 0.50)" ;
        schema:measurementTechnique "border-median contrast mask on Drosophila_miranda_specimen.jpg" ;
        schema:name "specimen plate foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.3703" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-specimen-plate-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-specimen-plate-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "Neutral occupancy prior; the gallery plate is not a half-filled silhouette" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-specimen-plate-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen plate structure-tensor coherency = 0.806 dimensionless" ;
        dct:description "non-circular specimen metric" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) of the structure tensor inside the foreground mask" ;
        schema:name "specimen plate structure-tensor coherency" ;
        schema:unitText "dimensionless" ;
        schema:value "0.806" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-specimen-plate-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-specimen-plate-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "Mid-range coherency prior for an isotropic granular field" ;
        schema:value "0.42" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-histogram-ks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen versus simulation orientation-histogram KS = 0.3333 KS distance" ;
        dct:description "intensity KS after unit-interval rescaling = 0.5325" ;
        schema:measurementTechnique "two-sample KS between 12-bin Sobel orientation histograms of the plate and the pure activator field" ;
        schema:name "specimen versus simulation orientation-histogram KS" ;
        schema:unitText "KS distance" ;
        schema:value "0.3333" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-histogram-ks-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-histogram-ks-reference> a schema:PropertyValue ;
        dct:source "A matched texture would sit near 0; the pure spot field is not a copy of the plate" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-turing-trace-at-the-schnakenberg-steady-state> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing trace at the Schnakenberg steady state = -0.16 1/time" ;
        dct:description "trace is negative, so the uniform state is stable without diffusion" ;
        schema:measurementTechnique "tr J = f_u + g_v at (u0, v0) = (1, 0.92)" ;
        schema:name "Turing trace at the Schnakenberg steady state" ;
        schema:unitText "1/time" ;
        schema:value "-0.16" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-turing-trace-at-the-schnakenberg-steady-state-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-turing-trace-at-the-schnakenberg-steady-state-reference> a schema:PropertyValue ;
        dct:source "Turing (1952) diffusion-free stability requires tr J < 0; this parameter set is -0.16" ;
        schema:value "-0.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py L129–L142" ;
        dct:description "Pearson r and RMSE of sigma(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py#L129-L142> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py L212–L222" ;
        dct:description "Equal-diffusion ablation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py#L212-L222> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py L509–L600" ;
        dct:description "Pass-2 metric list with non-equal reference values" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py#L509-L600> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent pass 2; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


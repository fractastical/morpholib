sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Asterias rubens Turing wavelength at 115.2 µm (Holocene, Pass 1 square patch) — Morphometric validation: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 0.999817, RMSE = 0.003533, KS = 0.0833 against the analytical curve. The 2D FFT wavelength is 116.4904 µm against 115.2 µm. Specimen circularity 0.164 is compared with a disk (1), and the fixed-threshold foreground 0.212 is compared with Otsu 0.198. The 0.02 arm-radius spacing reference is a transferred length, not a measurement on this plate." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-dispersion-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-equal-diffusion-control-max-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-silhouette-domain-control-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-simulated-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-specimen-image-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-specimen-tubercle-spacing-over-arm-radius>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-wavelength-ratio-s-4-over-s-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-dispersion-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion KS statistic = 0.083333 1" ;
        dct:description "reference is a 0.05 screening tolerance, not the measured statistic" ;
        schema:measurementTechnique "scipy.stats.ks_2samp on analytical vs numerical σ(k)" ;
        schema:name "dispersion KS statistic" ;
        schema:unitText "1" ;
        schema:value "0.083333" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> a schema:PropertyValue ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion pearson r = 0.999817 1" ;
        dct:description "reference is exact agreement; the value is the numerical correlation and is not identical to 1" ;
        schema:measurementTechnique "Pearson r of analytical Turing σ(k) vs 1D FTCS growth at 12 wavenumbers around k_c" ;
        schema:name "dispersion pearson r" ;
        schema:unitText "1" ;
        schema:value "0.999817" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 0.003533 1/τ" ;
        dct:description "KS statistic=0.0833 (two-sample KS of the σ curves)" ;
        schema:measurementTechnique "RMSE between analytical and FTCS σ(k); KS statistic reported alongside" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/τ" ;
        schema:value "0.003533" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-equal-diffusion-control-max-sigma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control max sigma = -0.103318 1/τ" ;
        dct:description "Turing drive is negative when r=1 because trace(J)<0; pattern must not grow" ;
        schema:measurementTechnique "negative control: D_u = D_v, max numerical growth rate over the same k grid" ;
        schema:name "equal-diffusion control max sigma" ;
        schema:unitText "1/τ" ;
        schema:value "-0.103318" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-equal-diffusion-control-max-sigma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-equal-diffusion-control-max-sigma-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-silhouette-domain-control-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "silhouette-domain control std ratio = 0.020947 1" ;
        dct:description "silhouette std=0.00143514, square std=0.0685123, quenched FFT wavelength=129.70 µm. A ratio near 0 means the organism outline is narrower than λ_c at this scale and must not be the reaction domain." ;
        schema:measurementTechnique "negative control: std(u) with the pentaradial photograph mask scaled onto the 576 µm patch (t=48), divided by std(u) on the square production domain" ;
        schema:name "silhouette-domain control std ratio" ;
        schema:unitText "1" ;
        schema:value "0.020947" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-silhouette-domain-control-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-silhouette-domain-control-std-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-simulated-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated stripe wavelength = 116.4904 µm" ;
        dct:description "catalog λ_c = 115.2 µm; sub-bin interpolation keeps the measured peak off the exact bin centre" ;
        schema:measurementTechnique "sub-bin radial FFT peak of the 2D Schnakenberg activator on the 576 µm patch" ;
        schema:name "simulated stripe wavelength" ;
        schema:unitText "µm" ;
        schema:value "116.4904" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-simulated-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-simulated-stripe-wavelength-reference> a schema:PropertyValue ;
        schema:value "115.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen contour circularity = 0.1637 1" ;
        dct:description "reference is a circular disk; the five-armed outline is the measured value" ;
        schema:measurementTechnique "4πA/P² on the segmented Hillewaert Asterias rubens studio photograph" ;
        schema:name "specimen contour circularity" ;
        schema:unitText "1" ;
        schema:value "0.1637" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-specimen-image-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image foreground fraction = 0.2122 1" ;
        dct:description "reference is the Otsu foreground on the same plate, a different segmenter" ;
        schema:measurementTechnique "fixed-threshold segmentation (gray>22) of the CC BY-SA specimen photograph" ;
        schema:name "specimen image foreground fraction" ;
        schema:unitText "1" ;
        schema:value "0.2122" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> a schema:PropertyValue ;
        schema:value "0.1981" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.3851 1" ;
        dct:description "reference is an isotropic null field; the photographed body is coherent along the arms" ;
        schema:measurementTechnique "mean (λ1−λ2)/(λ1+λ2) of the structure tensor inside the body mask" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "1" ;
        schema:value "0.3851" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-specimen-tubercle-spacing-over-arm-radius> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen tubercle spacing over arm radius = 0.0168 arm-radius" ;
        dct:description "CV of nearest-neighbour distances = 0.7146; n_peaks=327. Reference is the within-plate 10th percentile of the same distances, not a transferred millimetre arm length. The studio plate has no scale bar." ;
        schema:measurementTechnique "median nearest-neighbour spacing of pale-tubercle peaks, divided by the 98th-percentile body radius" ;
        schema:name "specimen tubercle spacing over arm radius" ;
        schema:unitText "arm-radius" ;
        schema:value "0.0168" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-specimen-tubercle-spacing-over-arm-radius-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-specimen-tubercle-spacing-over-arm-radius-reference> a schema:PropertyValue ;
        schema:value "0.01" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-wavelength-ratio-s-4-over-s-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength ratio s=4 over s=1 = 2.0 1" ;
        dct:description "sweep Pearson r of λ vs λ_c√s = 1.0000" ;
        schema:measurementTechnique "numerical σ-peak wavelength at diffusivity scale 4 divided by scale 1; law predicts 2" ;
        schema:name "wavelength ratio s=4 over s=1" ;
        schema:unitText "1" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-wavelength-ratio-s-4-over-s-1-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-measurement-wavelength-ratio-s-4-over-s-1-reference> a schema:PropertyValue ;
        schema:value "2.0" .

    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Asterias rubens Turing wavelength at 115.2 µm (Holocene, Pass 1 square patch) — Model fidelity to source: 90/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script integrates Schnakenberg kinetics and the Turing/Murray critical-wavenumber formula, and it places the ratio just above onset so the catalog mode is the unstable one. Rate constants are fitted to the catalog scale, not taken from an Asterias dose-response." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 9e-01 ;
    pk:hasVerdict "faithful" .


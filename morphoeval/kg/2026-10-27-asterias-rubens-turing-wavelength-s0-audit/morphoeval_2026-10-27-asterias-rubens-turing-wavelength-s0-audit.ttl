    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-repro-package-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-repro-package-2> ;
    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .


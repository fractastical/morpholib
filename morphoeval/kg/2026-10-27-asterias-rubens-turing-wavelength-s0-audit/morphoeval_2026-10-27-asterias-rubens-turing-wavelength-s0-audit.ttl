<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-asterias-rubens-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Asterias rubens Turing wavelength at 115.2 µm (Holocene, Pass 1 square patch) — Morphological realism / specimen match: 74/100" ;

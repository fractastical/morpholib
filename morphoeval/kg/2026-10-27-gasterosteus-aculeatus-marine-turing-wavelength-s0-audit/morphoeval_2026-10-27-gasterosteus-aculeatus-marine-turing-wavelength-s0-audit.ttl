<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Schnakenberg wavelength at 52 µm for the Late Pleistocene marine stickleback (Pass 1 bare field) (Gasterosteus aculeatus_marine)",
        "Schnakenberg wavelength at 52 µm for the Late Pleistocene marine stickleback (Pass 1 bare field) faithfully reproduces Gasterosteus aculeatus_marine morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0-3>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0-4> ;
    dct:description "The simulation script(s) models/2026-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Gasterosteus aculeatus_marine specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0.py> ;
    schema:about "Gasterosteus aculeatus_marine" ;
    schema:additionalProperty "does_not_claim: That 52 µm was measured on a fossil melanophore",
        "does_not_claim: That the bare activator image is a pixel match to the photograph",
        "reconstructed_in_script: Schnakenberg (a, b, D_u, D_v) placed so the marine wavelength is 52 µm",
        "reconstructed_in_script: λ(N) = 52 µm * sqrt(32/N) giving 104 µm (doryssus_late) and 78 µm (living aculeatus)",
        "reported_in_source: Bell, Baumgartner and Olson (1985) temporal change in G. doryssus armor characters",
        "reported_in_source: Colosimo et al. (2004, 2005) Eda complete-plate versus low-plate morphs",
        "reported_in_source: Turing (1952) critical wavenumber from the dispersion determinant",
        "transfer_boundary: N_eff = 8 for the predecessor is the Colosimo low-morph analogy, not a Truckee plate count",
        "transfer_boundary: The 2020 German photograph is an extant anatomical plate, not a 15 ka fossil" ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Gasterosteus aculeatus_marine (Late Pleistocene Marine Ancestor (15 ka))" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "I. Enaima (Vertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;
    pk:aristotelianSubalternClass "Pisces (Ichthyes)" ;
    pk:biologicalGenus "Gasterosteus" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gasterosteus-aculeatus-marine-turing-wavelength-s0.py; output: docs/media/gasterosteus_aculeatus_marine_turing_wavelength_s0_comparison.png; organism: Gasterosteus aculeatus_marine; environment: n/a; claim_boundary: [reported_in_source: Turing (1952) critical wavenumber from the dispersion determinant | Colosimo et al. (2004, 2005) Eda complete-plate versus low-plate morphs | Bell, Baumgartner and Olson (1985) temporal change in G. doryssus armor characters; reconstructed_in_script: Schnakenberg (a, b, D_u, D_v) placed so the marine wavelength is 52 µm | λ(N) = 52 µm * sqrt(32/N) giving 104 µm (doryssus_late) and 78 µm (living aculeatus); transfer_boundary: N_eff = 8 for the predecessor is the Colosimo low-morph analogy, not a Truckee plate count | The 2020 German photograph is an extant anatomical plate, not a 15 ka fossil; does_not_claim: That 52 µm was measured on a fossil melanophore | That the bare activator image is a pixel match to the photograph]; phenomenon_size: 32 µm (3.168e-05 m, log10=-4.499 m, tier=4_cellular_10um); species_scale_ladder (10 runs from 32 µm to 9.9 cm): 32 µm:gasterosteus-aculeatus-bioelectric-polarity, 118 µm:gasterosteus-aculeatus-vertex-packing, 2.2 mm:gasterosteus-aculeatus-turing-wavelength, 4.1 mm:gasterosteus-aculeatus-clock-wavefront, 9.6 mm:gasterosteus-aculeatus-elastic-buckling, 1.3 cm:gasterosteus-aculeatus-morphogen-condensation, 1.7 cm:gasterosteus-aculeatus-flux-canalization, 2.2 cm:gasterosteus-aculeatus-branching-tree" ;
    pk:derivedFromPaper <https://doi.org/10.1017/S0094837300011581>,
        <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1107239>,
        <https://doi.org/10.1371/journal.pbio.0020109> ;
    pk:externalAtlasDataset <https://paleobiodb.org/classic/checkTaxonInfo?taxon_name=Gasterosteus>,
        <https://www.morphosource.org/Search/index?search=Gasterosteus> ;

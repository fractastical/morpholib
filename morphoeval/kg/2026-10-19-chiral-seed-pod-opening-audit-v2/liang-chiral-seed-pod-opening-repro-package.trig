sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-liang-chiral-seed-pod-opening> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Armon et al. (2011) Science / Efrati et al. (2009) JMPS Incompatible Shell Elasticity & Chiral Seed Pod Opening — Reproducibility package: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "8-point `self_test()` suite (`L1157-1221`) verifying SHA-256 dataset integrity, Gauss saddle incompatibility det(b_0) = -kappa_0^2 < 0 across cutting angles, narrow helicoid (H=0, R=0) and achiral ring (theta=0 deg, 90 deg -> P=0) plus flat (kappa_0=0) negative controls, pitchfork bifurcation correlation, cutting-angle chirality sweep, 4-system scaling, specimen CV segmentation, and two-run bitwise determinism (`np.allclose(..., atol=0.0)`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-repro-package-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L1157–L1221" ;
        dct:description "Comprehensive 8-check self_test() including bitwise determinism and negative controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2007-liang-chiral-seed-pod-opening.py#L1157-L1221> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 065 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-liang-chiral-seed-pod-opening> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Armon et al. (2011) Science / Efrati et al. (2009) JMPS Incompatible Shell Elasticity & Chiral Seed Pod Opening — Morphological realism / specimen match: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 3.0 *Bauhinia variegata* dehisced chiral seed pod specimen `datasets/chiral_seed_pod_opening/bauhinia_chiral_seed_pod_specimen.jpg` (Muséum de Toulouse MHNT.BOT.2011.3.22), segments the upper and lower twisted valves and 8 helical lobe apices (mean half-pitch 169.83 px, CV = 0.2405) via inner-tan vs outer-brown sclerenchyma reflectance (`segment_bauhinia_pod_specimen`, L687-770), and matches radius and pitch across 4 benchmark systems (r_R = 1.0000, r_P = 0.9994)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L687–L770" ;
        dct:description "Contour and bilayer reflectance segmentation of Bauhinia variegata dehisced helical valves" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2007-liang-chiral-seed-pod-opening.py#L687-L770> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/chiral_seed_pod_opening_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing 3D helicoid/ribbon meshes, pitchfork diagram, R/P transition, cutting-angle sweep, specimen segmentation, and 4-system validation — docs/media/chiral_seed_pod_opening_comparison.png: rendered output of 2007-liang-chiral-seed-pod-opening.py at 8871db0, image/png, 1024373 B, 2775×1680 px, artifact_sha256 1ecbc4345db11d57bc9065ca3dd64a4879b90e1d271e93ba5fb6592f35825c3e (sha256 1ecbc4345db11d57bc9065ca3dd64a4879b90e1d271e93ba5fb6592f35825c3e), spec_fingerprint 48029999be49f27cab48fdb5ee4f4512dc98d25ab053a5439aec7a9ce898cd3a" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 065 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


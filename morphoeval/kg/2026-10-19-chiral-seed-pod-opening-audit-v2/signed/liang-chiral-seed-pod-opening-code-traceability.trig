        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2007-liang-chiral-seed-pod-opening.py#L1-L64> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 065 Pass 2 Assessor)" ;

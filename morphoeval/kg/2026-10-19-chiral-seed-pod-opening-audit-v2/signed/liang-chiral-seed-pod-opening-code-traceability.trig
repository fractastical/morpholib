sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-liang-chiral-seed-pod-opening> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Armon et al. (2011) Science / Efrati et al. (2009) JMPS Incompatible Shell Elasticity & Chiral Seed Pod Opening — Code-to-model traceability: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Module and function docstrings map every equation to Armon et al. (2011) Science Eqs. 1-4 & Figs. 1-4, Efrati et al. (2009) JMPS, Armon et al. (2014) Soft Matter, and the 3 formal Lean 4 theorems in `morphoeval/lean/loops/Loop_065_chiral_seed_pod_opening.lean` (L1-64, L138-285)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-code-traceability-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L1–L64" ;

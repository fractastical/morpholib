sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-liang-chiral-seed-pod-opening> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L138–L250" ;
        dcterms:description "Sclerenchyma bilayer intrinsic curvature kappa_0, rotated b_0(theta) tensor, and pitchfork equations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2007-liang-chiral-seed-pod-opening.py#L138-L250> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2007-liang-chiral-seed-pod-opening.py L253–L469" ;
        dcterms:description "L-BFGS-B non-Euclidean incompatible plate energy minimizer and 3D ribbon mesh reconstruction" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2007-liang-chiral-seed-pod-opening.py#L253-L469> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_065_chiral_seed_pod_opening.lean L14–L102" ;
        dcterms:description "3 machine-checked Lean 4 theorems for Gauss saddle incompatibility, narrow helicoid chirality, and wide cylindrical ribbon asymptote (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_065_chiral_seed_pod_opening.lean#L14-L102> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 065 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Armon et al. (2011) Science / Efrati et al. (2009) JMPS Incompatible Shell Elasticity & Chiral Seed Pod Opening — Model fidelity to source: 95/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements orthogonal +-45 deg sclerenchyma bilayer hygroscopic shrinkage Delta_eps_hygro -> kappa_0 (`compute_sclerenchyma_bilayer_kappa0`, L138-150), rotated saddle target curvature tensor b_0(theta) with Gauss incompatibility det(b_0) = -kappa_0^2 < 0 (`compute_target_curvature_tensor`, L152-186), exact Föppl-von Kármán critical width w_tilde_c = (16*(1+nu)/sqrt(1-nu^2))^(1/4) (`critical_fvk_width`, L188-194), and an L-BFGS-B non-Euclidean plate energy minimizer (`relax_incompatible_ribbon_equilibrium`, L253-389) with negative controls at kappa_0 = 0 and theta = 0 deg, 90 deg, backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_065_chiral_seed_pod_opening.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-model-fidelity-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


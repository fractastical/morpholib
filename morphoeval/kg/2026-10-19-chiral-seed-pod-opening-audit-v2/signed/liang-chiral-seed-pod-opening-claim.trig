sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-liang-chiral-seed-pod-opening> a pk:Claim ;
        rdfs:label "Armon et al. (2011) Science / Efrati et al. (2009) JMPS Incompatible Shell Elasticity & Chiral Seed Pod Opening faithfully reproduces Bauhinia variegata (Orchid tree chiral seed pod valves) & Erythrina corallodendron morphology" ;
        dcterms:description "The simulation script(s) 2007-liang-chiral-seed-pod-opening.py implement the cited source model as published and produce forms that match real Bauhinia variegata (Orchid tree chiral seed pod valves) & Erythrina corallodendron specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 93.4/100, audit 2026-10-19-chiral-seed-pod-opening-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/8871db0/2007-liang-chiral-seed-pod-opening.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2007-liang-chiral-seed-pod-opening.py; output: docs/media/chiral_seed_pod_opening_comparison.png; organism: Bauhinia variegata (Orchid tree chiral seed pod valves) & Erythrina corallodendron; checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 48029999be49f27cab48fdb5ee4f4512dc98d25ab053a5439aec7a9ce898cd3a; artifact_sha256: 1ecbc4345db11d57bc9065ca3dd64a4879b90e1d271e93ba5fb6592f35825c3e; input_dataset_sha256: {datasets/chiral_seed_pod_opening/bauhinia_chiral_seed_pod_specimen.jpg=047f357961bc58c5..., datasets/chiral_seed_pod_opening/chiral_seed_pod_opening_reference.json=4b1fa5df06327c65..., datasets/chiral_seed_pod_opening/paper_citations.bib=b3a693ac6a538b04..., datasets/chiral_seed_pod_opening/scout_manifest.json=05711e5e7df6cb17...}; supersedes_audit_id: 2026-10-19-chiral-seed-pod-opening-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.jmps.2008.12.004>,
            <https://doi.org/10.1038/nature03185>,
            <https://doi.org/10.1039/c3sm52313f>,
            <https://doi.org/10.1126/science.1203874> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-specimen-match> ;
        pk:weightOfEvidence "0.934"^^xsd:double .


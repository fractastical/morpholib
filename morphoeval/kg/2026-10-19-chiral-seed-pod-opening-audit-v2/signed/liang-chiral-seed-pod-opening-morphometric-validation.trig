sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-liang-chiral-seed-pod-opening> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-4-system-legume-biomimetic-latex-helical-pitch-p-correlation-bauhinia-erythrina-latex> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "4-system legume & biomimetic latex helical pitch P correlation (Bauhinia, Erythrina, Latex) = 0.9994 Pearson r" ;
        dcterms:description "4-system helix radius Pearson r = 1.0000, RMSE = 0.0054 cm" ;
        schema:measurementTechnique "Predicted vs empirical helical pitch P across 4 experimental systems (p=6.24e-04, RMSE=0.1771 cm)" ;
        schema:name "4-system legume & biomimetic latex helical pitch P correlation (Bauhinia, Erythrina, Latex)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9994" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-4-system-legume-biomimetic-latex-helical-pitch-p-correlation-bauhinia-erythrina-latex-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-4-system-legume-biomimetic-latex-helical-pitch-p-correlation-bauhinia-erythrina-latex-reference> a schema:PropertyValue ;
        dcterms:source "Armon et al. (2011) Science 333:1726-1730 Figs. 1-4" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-achiral-ring-negative-control-helical-pitch-p-at-cutting-angle-theta-0-deg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Achiral ring negative control helical pitch P at cutting angle theta = 0 deg = 0.0 cm" ;
        dcterms:description "theta=90 deg pitch = 0.000000 cm, ring radius R(0 deg) = 3.4770 cm" ;
        schema:measurementTechnique "Helical pitch P(theta=0 deg) when principal intrinsic curvature aligns with strip axis (tau = D*sin(0) = 0)" ;
        schema:name "Achiral ring negative control helical pitch P at cutting angle theta = 0 deg" ;
        schema:unitText "cm" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-achiral-ring-negative-control-helical-pitch-p-at-cutting-angle-theta-0-deg-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-achiral-ring-negative-control-helical-pitch-p-at-cutting-angle-theta-0-deg-reference> a schema:PropertyValue ;
        dcterms:source "Armon et al. (2011) Science 333:1726-1730 Fig. 2A (theta=0 deg achiral circular ring)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-armon-et-al-2011-critical-f-ppl-von-k-rm-n-pitchfork-width-w-tilde-c-nu-0-30> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Armon et al. (2011) critical Föppl-von Kármán pitchfork width w_tilde_c (nu=0.30) = 2.1609 dimensionless" ;
        dcterms:description "narrow helicoid w_tilde=1.0 gives H/kappa_0 = 0.0000" ;
        schema:measurementTechnique "Exact non-Euclidean shell pitchfork threshold w_tilde_c = (16*(1+nu)/sqrt(1-nu^2))^(1/4)" ;
        schema:name "Armon et al. (2011) critical Föppl-von Kármán pitchfork width w_tilde_c (nu=0.30)" ;
        schema:unitText "dimensionless" ;
        schema:value "2.1609" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-armon-et-al-2011-critical-f-ppl-von-k-rm-n-pitchfork-width-w-tilde-c-nu-0-30-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-armon-et-al-2011-critical-f-ppl-von-k-rm-n-pitchfork-width-w-tilde-c-nu-0-30-reference> a schema:PropertyValue ;
        dcterms:source "Armon, Efrati, Kupferman & Sharon (2011) Science 333:1726-1730 Eq. 3 & SOM" ;
        schema:value "2.1609" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-bauhinia-variegata-specimen-segmented-helical-lobe-half-pitch-cv-bauhinia-chiral-seed-pod-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Bauhinia variegata specimen segmented helical lobe half-pitch CV (bauhinia_chiral_seed_pod_specimen.jpg) = 0.2405 CV (std/mean)" ;
        dcterms:description "mean half-pitch = 169.83 ± 40.85 px" ;
        schema:measurementTechnique "Inter-lobe half-pitch spacing dispersion across n=8 segmented helical twist lobes on both dehisced valves" ;
        schema:name "Bauhinia variegata specimen segmented helical lobe half-pitch CV (bauhinia_chiral_seed_pod_specimen.jpg)" ;
        schema:unitText "CV (std/mean)" ;
        schema:value "0.2405" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-bauhinia-variegata-specimen-segmented-helical-lobe-half-pitch-cv-bauhinia-chiral-seed-pod-specimen-jpg-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-bauhinia-variegata-specimen-segmented-helical-lobe-half-pitch-cv-bauhinia-chiral-seed-pod-specimen-jpg-reference> a schema:PropertyValue ;
        dcterms:source "Armon et al. (2011) Science Fig. 1A & Muséum de Toulouse MHNT.BOT.2011.3.22" ;
        schema:value "0.24" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-cutting-angle-chirality-torsion-tau-theta-kappa-0-correlation-across-theta-in-0-deg-90-deg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cutting-angle chirality torsion tau(theta)/kappa_0 correlation across theta in [0 deg, 90 deg] = 1.0 Pearson r" ;
        dcterms:description "maximal twist at theta=45 deg: tau/kappa_0 = 0.3500" ;
        schema:measurementTechnique "Geodesic torsion tau(theta)/kappa_0 = (D/kappa_0)*sin(2*theta) across 7 cutting angles (p=3.41e-24, RMSE=0.0000)" ;
        schema:name "Cutting-angle chirality torsion tau(theta)/kappa_0 correlation across theta in [0 deg, 90 deg]" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-cutting-angle-chirality-torsion-tau-theta-kappa-0-correlation-across-theta-in-0-deg-90-deg-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-cutting-angle-chirality-torsion-tau-theta-kappa-0-correlation-across-theta-in-0-deg-90-deg-reference> a schema:PropertyValue ;
        dcterms:source "Armon et al. (2011) Science 333:1726-1730 Fig. 2 & SOM" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-dimensionless-helical-pitch-p-w-tilde-kappa-0-2-pi-transition-correlation-across-w-tilde> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Dimensionless helical pitch P(w_tilde)*kappa_0/(2*pi) transition correlation across w_tilde = 1.0 Pearson r" ;
        dcterms:description "RMSE_P = 0.0027" ;
        schema:measurementTechnique "L-BFGS-B helical pitch P(w_tilde)*kappa_0/(2*pi) across 11 dimensionless widths (p=5.76e-22, RMSE=0.0027)" ;
        schema:name "Dimensionless helical pitch P(w_tilde)*kappa_0/(2*pi) transition correlation across w_tilde" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-dimensionless-helical-pitch-p-w-tilde-kappa-0-2-pi-transition-correlation-across-w-tilde-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-dimensionless-helical-pitch-p-w-tilde-kappa-0-2-pi-transition-correlation-across-w-tilde-reference> a schema:PropertyValue ;
        dcterms:source "Armon et al. (2011) Science 333:1726-1730 Fig. 3D" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-dimensionless-helix-radius-r-w-tilde-kappa-0-transition-correlation-across-w-tilde-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Dimensionless helix radius R(w_tilde)*kappa_0 transition correlation across w_tilde_c = 1.0 Pearson r" ;
        dcterms:description "narrow helicoid (w_tilde <= w_tilde_c) R*kappa_0 = 0.0000" ;
        schema:measurementTechnique "L-BFGS-B helix radius R(w_tilde)*kappa_0 across helicoid-to-ribbon transition (p=1.53e-27, RMSE=0.0009)" ;
        schema:name "Dimensionless helix radius R(w_tilde)*kappa_0 transition correlation across w_tilde_c" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-dimensionless-helix-radius-r-w-tilde-kappa-0-transition-correlation-across-w-tilde-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-dimensionless-helix-radius-r-w-tilde-kappa-0-transition-correlation-across-w-tilde-c-reference> a schema:PropertyValue ;
        dcterms:source "Armon et al. (2011) Science 333:1726-1730 Fig. 3D & Fig. 4" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-incompatible-saddle-gaussian-target-curvature-det-b-0-kappa-0-2-kappa-0-0-42-cm-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Incompatible saddle Gaussian target curvature det(b_0) = -kappa_0^2 (kappa_0=0.42 cm^-1) = -0.1764 cm^-2" ;
        dcterms:description "Tr(b_0) = 0.0000 cm^-1, bilayer kappa_0 = 0.4200 cm^-1" ;
        schema:measurementTechnique "Determinant of rotated +-45 deg sclerenchyma target curvature tensor b_0(theta) vs flat reference metric K(a_0)=0" ;
        schema:name "Incompatible saddle Gaussian target curvature det(b_0) = -kappa_0^2 (kappa_0=0.42 cm^-1)" ;
        schema:unitText "cm^-2" ;
        schema:value "-0.1764" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-incompatible-saddle-gaussian-target-curvature-det-b-0-kappa-0-2-kappa-0-0-42-cm-1-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-incompatible-saddle-gaussian-target-curvature-det-b-0-kappa-0-2-kappa-0-0-42-cm-1-reference> a schema:PropertyValue ;
        dcterms:source "Efrati, Sharon & Kupferman (2009) JMPS 57:762-775 & Armon et al. (2011) Science" ;
        schema:value "-0.1764" .


        schema:measurementTechnique "L-BFGS-B non-Euclidean plate relaxation vs benchmark across 11 widths (p=1.59e-23, RMSE=0.0006)" ;
        schema:name "Supercritical pitchfork mean curvature H*(w_tilde)/kappa_0 correlation across w_tilde in [0.5, 10]" ;

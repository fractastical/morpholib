    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Cavia porcellus Holocene (0 Ma) Turing wavelength at 126.7 µm (tier-5 detail s0) faithfully reproduces Cavia porcellus (Guinea pig), I. Enaima (Vertebrata) -> Mammalia (Zootoka) -> Cavia morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Cavia porcellus (Guinea pig), I. Enaima (Vertebrata) -> Mammalia (Zootoka) -> Cavia specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py; output: docs/media/cavia_porcellus_turing_wavelength_s0_comparison.png; organism: Cavia porcellus (Guinea pig), I. Enaima (Vertebrata) -> Mammalia (Zootoka) -> Cavia; environment: python 3.12, numpy 2.5.4, scipy 1.18.1, matplotlib 3.11.2, Pillow 13.0.0; claim_boundary: [reported_in_source: Turing (1952) dispersion: a homogeneous steady state stable to k = 0 can be unstable at a finite critical wavenumber when the inhibitor diffuses farther than the activator. | Murray (1981) identified that selected wavelength with mammalian coat stripes and spots. Schnakenberg (1979) supplied the activator-substrate kinetics used here. | Swift & Hohenberg (1977) and Cross & Hohenberg (1993) give the real amplitude equation whose linear spectrum peaks at a prescribed k_c. | Sick et al. (2006) showed a WNT/DKK reaction-diffusion interaction sets mammalian hair-follicle spacing, the anatomical neighbour of a ~100 µm pigment wavelength.; reconstructed_in_script: Schnakenberg Jacobian at a = 0.08, b = 1.15, gamma = 1, with D_v/D_u = 40 scaled so lambda_c = 126.7 µm exactly (D_u = 169.175 µm^2, D_v = 6767.013 µm^2). | Swift-Hohenberg spiral of charge 2 on a periodic 1.0136 mm window (eight critical wavelengths), plus an epsilon sweep, a below-onset decay, and a plain-diffusion ablation.; transfer_boundary: 126.7 µm is the slot-assigned tier-5 detail length (0.0001267 m, log10 = -3.897) for extant Cavia porcellus at 0 Ma, not a measurement quoted from a guinea-pig histology paper. | The Cavia chronoseries has one node. The 1267 µm and 12.67 µm neighbours are adjacent size tiers at the same age, not other chronospecies.; does_not_claim: That the gallery pigment field is a published micrograph, or that its measured dominant wavelength (78.18 µm on the printed 100 µm bar) equals 126.7 µm. | A full nonlinear two-species Schnakenberg integration. The rendered field is the Swift-Hohenberg amplitude equation. | Machine execution of the Lean file: this image has no lean binary.]; phenomenon_size: 188 µm (0.0001883 m, log10=-3.725 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 188 µm to 28.5 cm): 188 µm:cavia-porcellus-bioelectric-polarity, 666 µm:cavia-porcellus-vertex-packing, 6.3 mm:cavia-porcellus-turing-wavelength, 2.3 cm:cavia-porcellus-clock-wavefront, 4.0 cm:cavia-porcellus-morphogen-condensation, 5.1 cm:cavia-porcellus-flux-canalization, 5.5 cm:cavia-porcellus-elastic-buckling, 6.6 cm:cavia-porcellus-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1103/PhysRevA.15.319>,
            <https://doi.org/10.1103/RevModPhys.65.851>,
            <https://doi.org/10.1126/science.1130088> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


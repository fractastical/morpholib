        rdfs:label "models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py L1–L48" ;
        dct:description "Docstring states the 126.7 µm law, the age, and the tier neighbours" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/cc4b7fb74d981b19349d4808476e5b8b2b12f75a/models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py#L1-L48> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/delphi10000-cavia-porcellus-turing-wavelength-s0.yaml L1–L40" ;

        rdfs:label "Cavia porcellus Holocene (0 Ma) Turing wavelength at 126.7 µm (tier-5 detail s0) — Code-to-model traceability: 80/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The module docstring, the math-KG loop YAML, and Loop_3141 name the same k_c formula and the 10x tier relation (1267 µm = 10 x 126.7 µm, 126.7 µm = 10 x 12.67 µm). The Lean theorems encode those integer relations and the sign of the cross term. They were not machine-checked in this image." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-code-traceability-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .

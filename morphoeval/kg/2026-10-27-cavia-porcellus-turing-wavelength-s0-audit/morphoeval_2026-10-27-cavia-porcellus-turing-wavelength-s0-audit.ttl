    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Cavia porcellus Holocene (0 Ma) Turing wavelength at 126.7 µm (tier-5 detail s0) — Morphological realism / specimen match: 80/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The GIF is a 12-frame 640x480 lavender spiral whose last frame scores cv_sim_similarity 88.2 against the gallery pigment field. The same field, calibrated by its 110 px / 100 µm bar, has a dominant wavelength of 78.18 µm, not 126.7 µm. Pass 1 therefore does not treat the visual match as a wavelength validation. The gallery image is not a DOI histology plate." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;

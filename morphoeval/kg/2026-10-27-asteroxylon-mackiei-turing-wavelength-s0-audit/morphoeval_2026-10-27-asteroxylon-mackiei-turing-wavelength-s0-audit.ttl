<https://w3id.org/delphi/resource/math-law/delphi10000-asteroxylon-mackiei-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg diffusion-ratio threshold" ;
    dct:description "Primary Turing condition for wavenumber selection at the detail scale | Variables: delta=160, f_u=84/100 at the 5.2 µm steady state (u,v)=(1, 0.92)" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8f0e4833ae7c01aa84482096856ead2148c3f912/models/2026-delphi10000-asteroxylon-mackiei-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/8f0e4833ae7c01aa84482096856ead2148c3f912/morphoeval/lean/loops/Loop_3124_asteroxylon_mackiei_turing_wavelength_s0.lean#L15-L20> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def law1_threshold (delta fu_num fu_den : Int) : Int := delta * fu_num - fu_den
theorem law1_diffusion_ratio_exceeds_unity : law1_threshold 160 84 100 > 0 := by decide"""^^pk:lean4 ;
    skos:notation "delta * f_u > 1, delta = D_v / D_u = 160, f_u = 0.84" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/s0080456800004506>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1098/rstb.2016.0489>,
        <https://doi.org/10.7554/eLife.69447> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3124.law1_threshold" ;
    pk:leanTheorem "MathOfBiology.Loop_3124.law1_diffusion_ratio_exceeds_unity" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-asteroxylon-mackiei-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Thirty critical wavelengths in the tracheid-file window" ;
    dct:description "Domain mode count that separates this slot from the single-wavelength 283 µm sibling | Variables: domain 156000 nm, lambda 5200 nm" ;
    dct:source "Kidston & Lang 1920 DOI:10.1017/s0080456800004506; Kenrick & Crane 1991 DOI:10.1086/337897" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8f0e4833ae7c01aa84482096856ead2148c3f912/models/2026-delphi10000-asteroxylon-mackiei-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/8f0e4833ae7c01aa84482096856ead2148c3f912/morphoeval/lean/loops/Loop_3124_asteroxylon_mackiei_turing_wavelength_s0.lean#L25-L30> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def law2_mode_count (domain_nm lambda_nm : Int) : Int := domain_nm / lambda_nm
theorem law2_thirty_critical_modes : law2_mode_count 156000 5200 = 30 := by decide"""^^pk:lean4 ;
    skos:notation "N = L / lambda_c = 156 µm / 5.2 µm = 30" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/s0080456800004506>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1098/rstb.2016.0489>,
        <https://doi.org/10.7554/eLife.69447> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3124.law2_mode_count" ;
    pk:leanTheorem "MathOfBiology.Loop_3124.law2_thirty_critical_modes" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-asteroxylon-mackiei-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Subcellular wavenumber versus the 283.4 µm enation sibling" ;
    dct:description "Scale separation inside Asteroxylon chronoseries 1/1 at 407 Ma | Variables: sibling wavelength 283.4 µm, detail wavelength 5.2 µm" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8f0e4833ae7c01aa84482096856ead2148c3f912/models/2026-delphi10000-asteroxylon-mackiei-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/8f0e4833ae7c01aa84482096856ead2148c3f912/morphoeval/lean/loops/Loop_3124_asteroxylon_mackiei_turing_wavelength_s0.lean#L36-L41> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def law3_scale_ratio (sibling_nm detail_nm : Int) : Int := sibling_nm / detail_nm
theorem law3_subcellular_wavenumber_dominates_enation : law3_scale_ratio 283400 5200 > 50 := by decide"""^^pk:lean4 ;
    skos:notation "lambda_enation / lambda_detail = 283400 nm / 5200 nm = 54 > 50" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/s0080456800004506>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1098/rstb.2016.0489>,
        <https://doi.org/10.7554/eLife.69447> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3124.law3_scale_ratio" ;

<https://w3id.org/delphi/resource/math-law/delphi10000-asteroxylon-mackiei-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homogeneous steady state is not an oscillator" ;
    dct:description "Patterning requires differential diffusion; the well-mixed state is stable | Variables: f_u hundredths 84, g_v hundredths -100" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8f0e4833ae7c01aa84482096856ead2148c3f912/models/2026-delphi10000-asteroxylon-mackiei-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/8f0e4833ae7c01aa84482096856ead2148c3f912/morphoeval/lean/loops/Loop_3124_asteroxylon_mackiei_turing_wavelength_s0.lean#L46-L51> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def law4_trace (fu_hundredths gv_hundredths : Int) : Int := fu_hundredths + gv_hundredths
theorem law4_homogeneous_trace_negative : law4_trace 84 (-100) < 0 := by decide"""^^pk:lean4 ;
    skos:notation "tr J = f_u + g_v = 0.84 - 1.00 < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/s0080456800004506>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1098/rstb.2016.0489>,
        <https://doi.org/10.7554/eLife.69447> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3124.law4_trace" ;
    pk:leanTheorem "MathOfBiology.Loop_3124.law4_homogeneous_trace_negative" ;
    pk:leanVerified true .


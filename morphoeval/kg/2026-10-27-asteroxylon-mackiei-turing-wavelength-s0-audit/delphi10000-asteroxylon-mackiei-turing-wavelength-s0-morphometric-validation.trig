sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Asteroxylon mackiei Schnakenberg critical wavelength at 5.2 µm (Pass 1) — Morphometric validation: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 1 reports full-frame Pearson r = 0.98950, RMSE = 7.425 gray levels, activator spectral centroid 7.646 µm against the 5.2 µm law, plate foreground / circularity / coherency, and σ_max of the equal-diffusion control. It does not yet report a hold-out r, a KS distance, or the plate envelope in micrometres. Those three are remediation, so this dimension does not receive Pass 2 credit." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-axis-envelope-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-gray-level-ks-distance>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-basic-look-pigment-pearson-r-versus-the-asteroxylon-plate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-basic-look-pigment-rmse-versus-the-asteroxylon-plate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-enation-to-detail-wavelength-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-equal-diffusion-control-maximum-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-hold-out-pigment-pearson-r-on-the-bottom-quarter-of-the-asteroxylon-plate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-turing-pigment-stripe-spectral-centroid-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-axis-envelope-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Asteroxylon specimen image axis-envelope wavelength = 117.0 µm" ;
        dct:description "transfer metric: the compression fossil does not resolve the 5.2 µm stripe" ;
        schema:measurementTechnique "dominant Fourier period of the leafy-axis occupancy, converted with the 117 µm model scale bar" ;
        schema:name "Asteroxylon specimen image axis-envelope wavelength" ;
        schema:unitText "µm" ;
        schema:value "117.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-axis-envelope-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-axis-envelope-wavelength-reference> a schema:PropertyValue ;
        dct:source "detail-tier critical wavelength; the plate envelope is a different and much longer scale" ;
        schema:value "5.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Asteroxylon specimen image contour circularity = 0.2378 4πA/P²" ;
        dct:description "elongated axis, not an ocellus disk" ;
        schema:measurementTechnique "morphological perimeter of the border-contrast mask" ;
        schema:name "Asteroxylon specimen image contour circularity" ;
        schema:unitText "4πA/P²" ;
        schema:value "0.2378" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "circularity of a disk; the leafy axis is an elongated compression" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Asteroxylon specimen image foreground fraction = 0.8896 area fraction" ;
        dct:description "measured foreground 0.8896; plant-dark fraction 0.3149" ;
        schema:measurementTechnique "border-contrast mask on the vendored CC BY-SA plate, resized to 160×120" ;
        schema:name "Asteroxylon specimen image foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.8896" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "neutral half-frame prior; the plate is matrix-filled, not a half mask" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-gray-level-ks-distance> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Asteroxylon specimen image gray-level KS distance = 0.1607 KS statistic" ;
        dct:description "Pass 2 remediation of the Pass 1 histogram gap" ;
        schema:measurementTechnique "two-sample KS between specimen and last-frame grayscale histograms (512-bin CDF grid)" ;
        schema:name "Asteroxylon specimen image gray-level KS distance" ;
        schema:unitText "KS statistic" ;
        schema:value "0.1607" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-gray-level-ks-distance-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-gray-level-ks-distance-reference> a schema:PropertyValue ;
        dct:source "identical histograms; activator modulation must move the dark-axis tail" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Asteroxylon specimen image structure-tensor coherency = 0.3676 dimensionless" ;
        dct:description "rock grain plus a vertical axis" ;
        schema:measurementTechnique "mean structure-tensor coherency inside the specimen mask (σ=2.5)" ;
        schema:name "Asteroxylon specimen image structure-tensor coherency" ;
        schema:unitText "dimensionless" ;
        schema:value "0.3676" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-asteroxylon-specimen-image-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "mid-scale anisotropy prior, not fitted to this plate" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-basic-look-pigment-pearson-r-versus-the-asteroxylon-plate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "basic-look pigment Pearson r versus the Asteroxylon plate = 0.987831 Pearson r" ;
        dct:description "RMSE 8.096 gray levels on 0–255" ;
        schema:measurementTechnique "Pearson correlation of grayscale pixels, specimen vs last composite frame" ;
        schema:name "basic-look pigment Pearson r versus the Asteroxylon plate" ;
        schema:unitText "Pearson r" ;
        schema:value "0.987831" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-basic-look-pigment-pearson-r-versus-the-asteroxylon-plate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-basic-look-pigment-pearson-r-versus-the-asteroxylon-plate-reference> a schema:PropertyValue ;
        dct:source "identity fit; the composite is a modulated plate, not a pixel copy" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-basic-look-pigment-rmse-versus-the-asteroxylon-plate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "basic-look pigment RMSE versus the Asteroxylon plate = 8.0961 gray levels" ;
        dct:description "nonzero because the Schnakenberg field darkens the axis" ;
        schema:measurementTechnique "RMSE of grayscale pixels, specimen vs last composite frame" ;
        schema:name "basic-look pigment RMSE versus the Asteroxylon plate" ;
        schema:unitText "gray levels" ;
        schema:value "8.0961" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-basic-look-pigment-rmse-versus-the-asteroxylon-plate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-basic-look-pigment-rmse-versus-the-asteroxylon-plate-reference> a schema:PropertyValue ;
        dct:source "perfect pixel identity, which the activator modulation breaks" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-enation-to-detail-wavelength-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "enation-to-detail wavelength ratio = 54.5 λ_283µm / λ_5.2µm" ;
        dct:description "scale separation inside Asteroxylon at 407 Ma; parameters are not the sibling's" ;
        schema:measurementTechnique "283.4 µm sibling enation wavelength divided by this slot's 5.2 µm" ;
        schema:name "enation-to-detail wavelength ratio" ;
        schema:unitText "λ_283µm / λ_5.2µm" ;
        schema:value "54.5" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-enation-to-detail-wavelength-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-enation-to-detail-wavelength-ratio-reference> a schema:PropertyValue ;
        dct:source "Lean law3 threshold (ratio > 50); the realized ratio is 54.5" ;
        schema:value "50.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-equal-diffusion-control-maximum-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control maximum growth rate = -0.08 per reaction time" ;
        dct:description "patterning control σ(k_c) at δ=160 is 0.3961" ;
        schema:measurementTechnique "max_k σ(k) with D_u = D_v (differential diffusion removed)" ;
        schema:name "equal-diffusion control maximum growth rate" ;
        schema:unitText "per reaction time" ;
        schema:value "-0.08" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-equal-diffusion-control-maximum-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-equal-diffusion-control-maximum-growth-rate-reference> a schema:PropertyValue ;
        dct:source "marginal stability; the control must lie strictly below it" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-hold-out-pigment-pearson-r-on-the-bottom-quarter-of-the-asteroxylon-plate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "hold-out pigment Pearson r on the bottom quarter of the Asteroxylon plate = 0.986385 Pearson r" ;
        dct:description "alpha=0.35, train r=0.9874, KS=0.1607" ;
        schema:measurementTechnique "alpha is the largest contrast with train r>=0.985 on the top 75% of rows; r is then scored only on the bottom 25%" ;
        schema:name "hold-out pigment Pearson r on the bottom quarter of the Asteroxylon plate" ;
        schema:unitText "Pearson r" ;
        schema:value "0.986385" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-hold-out-pigment-pearson-r-on-the-bottom-quarter-of-the-asteroxylon-plate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-hold-out-pigment-pearson-r-on-the-bottom-quarter-of-the-asteroxylon-plate-reference> a schema:PropertyValue ;
        dct:source "identity on held-out rows; alpha was not fit to those rows" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-turing-pigment-stripe-spectral-centroid-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing pigment stripe spectral-centroid wavelength = 7.6462 µm" ;
        dct:description "centroid includes the side-band and is not forced equal to 5.2" ;
        schema:measurementTechnique "2π / power-weighted mean wavenumber of the final activator field" ;
        schema:name "Turing pigment stripe spectral-centroid wavelength" ;
        schema:unitText "µm" ;
        schema:value "7.6462" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-turing-pigment-stripe-spectral-centroid-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-measurement-turing-pigment-stripe-spectral-centroid-wavelength-reference> a schema:PropertyValue ;
        dct:source "slot detail scale λ_c = 5.2 µm (analytical k_c, not the spectral centroid)" ;
        schema:value "5.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-asteroxylon-mackiei-turing-wavelength-s0.py L201–L282" ;
        dct:description "plate segmentation, centroid, and full-frame Pearson/RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8f0e4833ae7c01aa84482096856ead2148c3f912/models/2026-delphi10000-asteroxylon-mackiei-turing-wavelength-s0.py#L201-L282> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent Pass 1; no second provider)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,

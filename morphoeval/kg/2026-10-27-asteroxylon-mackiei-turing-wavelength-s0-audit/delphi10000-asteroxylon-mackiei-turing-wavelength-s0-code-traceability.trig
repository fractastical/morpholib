            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-code-traceability-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3124_asteroxylon_mackiei_turing_wavelength_s0.lean L15–L51" ;
        dct:description "four theorems, zero sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8f0e4833ae7c01aa84482096856ead2148c3f912/morphoeval/lean/loops/Loop_3124_asteroxylon_mackiei_turing_wavelength_s0.lean#L15-L51> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/delphi10000-asteroxylon-mackiei-turing-wavelength-s0.yaml L1–L40" ;
        dct:description "laws pinned to the Lean declarations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8f0e4833ae7c01aa84482096856ead2148c3f912/morphoeval/math_kg_loops/delphi10000-asteroxylon-mackiei-turing-wavelength-s0.yaml#L1-L40> .

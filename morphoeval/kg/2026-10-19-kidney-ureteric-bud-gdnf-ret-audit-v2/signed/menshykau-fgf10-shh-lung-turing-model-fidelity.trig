sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-fgf10-shh-lung-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2012-menshykau-fgf10-shh-lung-turing.py L111–L367" ;
        dcterms:description "GDNF-RET steady state, dispersion relation, and IMEX ampulla cap tip-splitting mode solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2012-menshykau-fgf10-shh-lung-turing.py#L111-L367> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2012-menshykau-fgf10-shh-lung-turing.py L374–L575" ;
        dcterms:description "2D mesenchymal GDNF sink field + self-avoiding ureteric tree simulator across 4 genotypes/perturbations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2012-menshykau-fgf10-shh-lung-turing.py#L374-L575> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_054_kidney_ureteric_bud_gdnf_ret.lean L36–L152" ;
        dcterms:description "3 machine-checked Lean 4 theorems for flux cancellation, Jacobian positivity, and tip-splitting mode scaling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_054_kidney_ureteric_bud_gdnf_ret.lean#L36-L152> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 054 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013), Zubkov et al. (2015) & Watanabe & Costantini (2004) kidney ureteric bud GDNF-RET-Wnt11 Turing branching morphogenesis — Model fidelity to source: 95/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the full Menshykau & Iber (2013) GDNF-RET-Wnt11 Schnakenberg receptor-ligand reaction-diffusion equations, steady-state flux cancellation, linearized Turing dispersion curve, and 2D (a, b) Turing instability phase space (L111-249); solves the curved ureteric ampulla cap PDE via an unconditionally stable spectral cosine IMEX solver across rho_tip = pi*R_tip/lambda_c demonstrating exact m = 1, 2, 3, 4 hotspot transitions (L256-367); and couples 2D self-avoiding ureteric tree arborization to a 2D mesenchymal GDNF consumption sink field across WT, Gdnf+/- / PRR^(UB-/-) hypoplasia, Spry1-/- hyper-branching, and exogenous GDNF bead perturbations plus equal-diffusion and no-sink negative controls (L374-575). Backed by 3 machine-checked Lean 4 theorems (0 `sorry`s) in `Loop_054_kidney_ureteric_bud_gdnf_ret.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


        dcterms:title "Real-time analysis of ureteric bud branching morphogenesis in vitro" .

    <https://doi.org/10.1088/1478-3975/10/4/046003> dcterms:date "2013"^^xsd:gYear ;
        dcterms:title "Kidney branching morphogenesis under the control of a ligand-receptor-based Turing mechanism" .


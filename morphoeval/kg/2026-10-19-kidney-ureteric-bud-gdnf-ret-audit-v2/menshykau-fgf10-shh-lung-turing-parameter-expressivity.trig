            <https://doi.org/10.1088/1478-3975/10/4/046003> .
    <https://doi.org/10.1007/s11538-015-0073-9> dct:date "2015"^^xsd:gYear ;
        dct:title "A spatially-averaged mathematical model of kidney branching morphogenesis" .
    <https://doi.org/10.1016/j.devcel.2004.12.004> dct:date "2005"^^xsd:gYear ;

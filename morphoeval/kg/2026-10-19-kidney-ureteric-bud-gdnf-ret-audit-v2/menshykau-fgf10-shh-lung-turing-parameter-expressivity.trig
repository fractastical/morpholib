sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-fgf10-shh-lung-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013), Zubkov et al. (2015) & Watanabe & Costantini (2004) kidney ureteric bud GDNF-RET-Wnt11 Turing branching morphogenesis — Parameter expressivity: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Sweeps normalized tip radius rho_tip across 4 branching regimes (elongation, dichotomous, trichotomous, ectopic polydomain), sweeps wavenumber k across [0.2, 28.0], evaluates 4 genetic/bead perturbation regimes plus 2 negative ablation controls (equal diffusion D_G=D_R and no-sink self-avoidance ablation), and exposes CLI parameter flags `--a-ret`, `--b-gdnf`, `--gamma`, `--d-ratio`, `--generations`, and `--seed` (L892-921)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-parameter-expressivity-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2012-menshykau-fgf10-shh-lung-turing.py L348–L575" ;
        dct:description "Multi-regime ampulla tip-radius sweep and 4-genotype + 2-ablation ureteric tree evaluations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2012-menshykau-fgf10-shh-lung-turing.py#L348-L575> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2012-menshykau-fgf10-shh-lung-turing.py L892–L921" ;
        dct:description "CLI parameter overrides wired directly into render_outputs()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2012-menshykau-fgf10-shh-lung-turing.py#L892-L921> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 054 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


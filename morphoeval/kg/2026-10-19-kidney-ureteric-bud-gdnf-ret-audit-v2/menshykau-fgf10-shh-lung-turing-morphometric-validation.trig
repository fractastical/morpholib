sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-fgf10-shh-lung-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013), Zubkov et al. (2015) & Watanabe & Costantini (2004) kidney ureteric bud GDNF-RET-Wnt11 Turing branching morphogenesis — Morphometric validation: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L772-855) reports 8 quantitative morphometrics with reference values, dispersion statistics (RMSE, Pearson r, p-value, SD, CV), and negative-control ablation deltas: critical Turing wavelength lambda_c = 0.472569, 4/4 exact ampulla tip-splitting mode transitions ([1, 2, 3, 4] peaks), E11.0-E13.5 WT tip progression Pearson r = 0.9993 (p = 1.9e-8, Horton-Strahler R_b = 2.00 vs 2.04 reference), generational bifurcation angle RMSE = 3.86 deg (vs collapsed angles in no-sink ablation), Spry1-/- hyper-branch ratio = 1.875x, Gdnf+/- hypoplasia reduction ratio = 0.375x (-62.5%), and exact specimen tip counts (12 WT vs 6 mutant, ratio = 2.00x)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-e11-0-e13-5-wild-type-ureteric-bud-tip-count-correlation-pearson-r-vs-watanabe-costantini-2004>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-gdnf-and-prr-ub-hypoplastic-e12-5-ureteric-tip-reduction-ratio-vs-wt-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-generational-ureteric-bifurcation-angle-rmse-across-e11-5-e13-5-vs-no-sink-ablation-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-segmented-e12-5-mouse-metanephros-gfp-ureteric-bud-tip-count-panel-a-wild-type-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-segmented-e12-5-mouse-metanephros-wt-to-mutant-ureteric-tip-multiplicity-ratio-panel-a-vs-panel-b>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-spry1-hyper-branching-exogenous-gdnf-bead-supernumerary-e12-5-tip-count-ratio-vs-wt-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-ureteric-ampulla-tip-splitting-mode-transition-accuracy-across-rho-tip-pi-r-tip-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-wild-type-gdnf-ret-homogeneous-steady-state-signaling-r-2-g-critical-turing-wavelength-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-morphometric-validation-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-e11-0-e13-5-wild-type-ureteric-bud-tip-count-correlation-pearson-r-vs-watanabe-costantini-2004> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "E11.0-E13.5 wild-type ureteric bud tip count correlation (Pearson r vs Watanabe & Costantini 2004) = 0.99931 Pearson r across 7 embryonic stages (E11.0-E13.5)" ;
        dct:description "Horton-Strahler bifurcation ratio R_b = 2.000 vs reference 2.04 ± 0.08" ;
        schema:measurementTechnique "simulate_coupled_ureteric_tree(WT_control, g=0..6) vs Watanabe & Costantini (2004) tip progression (p=2.38e-08, RMSE=1.09 tips)" ;
        schema:name "E11.0-E13.5 wild-type ureteric bud tip count correlation (Pearson r vs Watanabe & Costantini 2004)" ;
        schema:unitText "Pearson r across 7 embryonic stages (E11.0-E13.5)" ;
        schema:value "0.99931" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-e11-0-e13-5-wild-type-ureteric-bud-tip-count-correlation-pearson-r-vs-watanabe-costantini-2004-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-e11-0-e13-5-wild-type-ureteric-bud-tip-count-correlation-pearson-r-vs-watanabe-costantini-2004-reference> a schema:PropertyValue ;
        schema:value "0.9985" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-gdnf-and-prr-ub-hypoplastic-e12-5-ureteric-tip-reduction-ratio-vs-wt-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gdnf+/- and PRR^(UB-/-) hypoplastic E12.5 ureteric tip reduction ratio vs WT control = 0.375 Hypoplastic mutant to WT E12.5 tip ratio" ;
        dct:description "Hypoplastic tree produces 6 E12.5 tips vs 16 WT tips (-62.5% reduction)" ;
        schema:measurementTechnique "simulate_coupled_ureteric_tree(Gdnf_het_or_PRR_ko, b=0.45, gamma=11.25) / WT_control at E12.5" ;
        schema:name "Gdnf+/- and PRR^(UB-/-) hypoplastic E12.5 ureteric tip reduction ratio vs WT control" ;
        schema:unitText "Hypoplastic mutant to WT E12.5 tip ratio" ;
        schema:value "0.375" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-gdnf-and-prr-ub-hypoplastic-e12-5-ureteric-tip-reduction-ratio-vs-wt-control-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-gdnf-and-prr-ub-hypoplastic-e12-5-ureteric-tip-reduction-ratio-vs-wt-control-reference> a schema:PropertyValue ;
        schema:value "0.4" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-generational-ureteric-bifurcation-angle-rmse-across-e11-5-e13-5-vs-no-sink-ablation-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Generational ureteric bifurcation angle RMSE across E11.5-E13.5 vs no-sink ablation control = 4.0629 deg (RMSE across generations 1..6)" ;
        dct:description "Self-avoiding RMSE = 4.06 deg (mean inter-tip spacing 0.084) vs no-sink ablation angle collapse" ;
        schema:measurementTechnique "Self-avoiding GDNF sink tree angle progression vs Watanabe & Costantini (2004) (Pearson r=0.9828, p=4.39e-04)" ;
        schema:name "Generational ureteric bifurcation angle RMSE across E11.5-E13.5 vs no-sink ablation control" ;
        schema:unitText "deg (RMSE across generations 1..6)" ;
        schema:value "4.0629" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-generational-ureteric-bifurcation-angle-rmse-across-e11-5-e13-5-vs-no-sink-ablation-control-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-generational-ureteric-bifurcation-angle-rmse-across-e11-5-e13-5-vs-no-sink-ablation-control-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-segmented-e12-5-mouse-metanephros-gfp-ureteric-bud-tip-count-panel-a-wild-type-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Segmented E12.5 mouse metanephros GFP ureteric bud tip count (Panel A wild-type control) = 12.0 ureteric bud tips (GFP local maxima)" ;
        dct:description "Detected 12 WT tips vs published count 12 (cohort mean 13.0 ± 1.4)" ;
        schema:measurementTechnique "segment_specimen_ureteric_bud on Panel A (mean branch caliber = 7.75 ± 4.92 px, CV = 0.634)" ;
        schema:name "Segmented E12.5 mouse metanephros GFP ureteric bud tip count (Panel A wild-type control)" ;
        schema:unitText "ureteric bud tips (GFP local maxima)" ;
        schema:value "12.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-segmented-e12-5-mouse-metanephros-gfp-ureteric-bud-tip-count-panel-a-wild-type-control-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-segmented-e12-5-mouse-metanephros-gfp-ureteric-bud-tip-count-panel-a-wild-type-control-reference> a schema:PropertyValue ;
        schema:value "12.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-segmented-e12-5-mouse-metanephros-wt-to-mutant-ureteric-tip-multiplicity-ratio-panel-a-vs-panel-b> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Segmented E12.5 mouse metanephros WT-to-mutant ureteric tip multiplicity ratio (Panel A vs Panel B) = 2.0 WT / PRR^(UB-/-) tip count ratio" ;
        dct:description "Panel B mutant tips = 6 (ref 6; swollen mean caliber = 10.75 ± 8.14 px)" ;
        schema:measurementTechnique "segment_specimen_ureteric_bud Panel A (12 tips) / Panel B (6 tips)" ;
        schema:name "Segmented E12.5 mouse metanephros WT-to-mutant ureteric tip multiplicity ratio (Panel A vs Panel B)" ;
        schema:unitText "WT / PRR^(UB-/-) tip count ratio" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-segmented-e12-5-mouse-metanephros-wt-to-mutant-ureteric-tip-multiplicity-ratio-panel-a-vs-panel-b-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-segmented-e12-5-mouse-metanephros-wt-to-mutant-ureteric-tip-multiplicity-ratio-panel-a-vs-panel-b-reference> a schema:PropertyValue ;
        schema:value "2.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-spry1-hyper-branching-exogenous-gdnf-bead-supernumerary-e12-5-tip-count-ratio-vs-wt-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Spry1-/- hyper-branching & exogenous GDNF bead supernumerary E12.5 tip count ratio vs WT control = 3.0625 Spry1-/- to WT E12.5 tip ratio" ;
        dct:description "Spry1-/- E12.5 tips = 49, GDNF bead tips = 37, WT tips = 16, Gdnf+/- hypoplasia tips = 6" ;
        schema:measurementTechnique "simulate_coupled_ureteric_tree(Spry1_ko_hyperbranch, gamma=46.25) / WT_control at generation 4 (E12.5)" ;
        schema:name "Spry1-/- hyper-branching & exogenous GDNF bead supernumerary E12.5 tip count ratio vs WT control" ;
        schema:unitText "Spry1-/- to WT E12.5 tip ratio" ;
        schema:value "3.0625" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-spry1-hyper-branching-exogenous-gdnf-bead-supernumerary-e12-5-tip-count-ratio-vs-wt-control-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-spry1-hyper-branching-exogenous-gdnf-bead-supernumerary-e12-5-tip-count-ratio-vs-wt-control-reference> a schema:PropertyValue ;
        schema:value "2.1923" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-ureteric-ampulla-tip-splitting-mode-transition-accuracy-across-rho-tip-pi-r-tip-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Ureteric ampulla tip-splitting mode transition accuracy across rho_tip = pi*R_tip/lambda_c = 2.0 R^2*G signaling peaks on WT ampulla (m = 2 dichotomous)" ;
        dct:description "Mode peaks detected: [1, 2, 3, 4] vs reference [1, 2, 3, 4] (RMSE = 0.0 peaks)" ;
        schema:measurementTechnique "solve_ampulla_cap_imex across 4 tip radii (4/4 exact mode matches: m=1, 2, 3, 4; apical cleft contrast=0.378)" ;
        schema:name "Ureteric ampulla tip-splitting mode transition accuracy across rho_tip = pi*R_tip/lambda_c" ;
        schema:unitText "R^2*G signaling peaks on WT ampulla (m = 2 dichotomous)" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-ureteric-ampulla-tip-splitting-mode-transition-accuracy-across-rho-tip-pi-r-tip-lambda-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-ureteric-ampulla-tip-splitting-mode-transition-accuracy-across-rho-tip-pi-r-tip-lambda-c-reference> a schema:PropertyValue ;
        schema:value "2.0" .

            pk:EvidenceItem ;
        rdfs:label "Wild-type GDNF-RET homogeneous steady-state signaling R^2*G* & critical Turing wavelength lambda_c = 0.472571 dimensionless wavelength (lambda_c = 2*pi/k_c)" ;
        dct:description "R*=1.00, G*=0.90, det(J_0)=1.00, Tr(J_0)=-0.20 vs equal-diffusion control Re(sigma)<0" ;
        schema:measurementTechnique "gdnf_ret_steady_state(a=0.10, b=0.90, D_R=0.02, D_G=1.0, gamma=25.0) -> lambda_c = 0.472569, R*=1.0, G*=0.9, flux_residual=0.0" ;
        schema:name "Wild-type GDNF-RET homogeneous steady-state signaling R^2*G* & critical Turing wavelength lambda_c" ;

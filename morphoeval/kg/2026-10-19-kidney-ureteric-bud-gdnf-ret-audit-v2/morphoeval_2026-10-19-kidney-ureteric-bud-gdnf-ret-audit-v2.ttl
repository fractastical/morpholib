<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/menshykau-fgf10-shh-lung-turing-1>,
        <https://w3id.org/probknow/resource/math-law/menshykau-fgf10-shh-lung-turing-2>,
        <https://w3id.org/probknow/resource/math-law/menshykau-fgf10-shh-lung-turing-3> .

<https://w3id.org/probknow/resource/math-law/menshykau-fgf10-shh-lung-turing-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Menshykau & Iber (2013) GDNF-RET Receptor-Ligand Flux Cancellation & Homogeneous Steady-State Law" ;
    dct:description "Establishes exact cancellation of the cubic cooperative R^2 G signaling term in total receptor-ligand mass balance and pins the unique homogeneous steady state (R*, G*) = (a + b, b/(a+b)^2) | Variables: R(x,t): epithelial RET receptor concentration on the ureteric bud; G(x,t): mesenchymal GDNF ligand concentration; a: basal RET expression rate; b: mesenchymal GDNF production rate; R^2 G: cooperative receptor-ligand signaling & endocytosis complex" ;
    dct:source "Menshykau & Iber (2013) Phys. Biol. 10(4):046003 Eqs. (1)-(4)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2012-menshykau-fgf10-shh-lung-turing.py#L105-L210>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_054_kidney_ureteric_bud_gdnf_ret.lean#L36-L59> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def ret_reaction (a R r2G : Int) : Int := a - R + r2G
def gdnf_reaction (b r2G : Int) : Int := b - r2G
theorem menshykau_gdnf_ret_flux_cancellation_and_steady_state (a b R r2G : Int) :
    ret_reaction a R r2G + gdnf_reaction b r2G = a + b - R ∧
    ret_reaction a (a + b) b = 0 ∧
    gdnf_reaction b b = 0 := by
  simp [ret_reaction, gdnf_reaction]; omega
"""^^pk:lean4 ;
    skos:notation "∂_t R = D_R ∇^2 R + γ(a - R + R^2 G),  ∂_t G = D_G ∇^2 G + γ(b - R^2 G);  f + g = a + b - R;  (R^*, G^*) = (a + b, b / (a + b)^2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s11538-015-0073-9>,
        <https://doi.org/10.1016/j.devcel.2004.12.004>,
        <https://doi.org/10.1016/j.ydbio.2004.03.025>,
        <https://doi.org/10.1088/1478-3975/10/4/046003> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Schnakenberg GDNF-RET-Wnt11 Receptor-Ligand Turing Instability & Self-Avoiding Ureteric Tree Branching" ;
    pk:leanDeclaration "MathOfBiology.Loop_054.ret_reaction" ;
    pk:leanTheorem "MathOfBiology.Loop_054.menshykau_gdnf_ret_flux_cancellation_and_steady_state" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/menshykau-fgf10-shh-lung-turing-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Menshykau & Iber (2013) Steady-State Reaction Jacobian Positivity & Turing Wavelength Law" ;
    dct:description "Proves stability of the homogeneous state to k = 0 perturbations (Tr(J_0) < 0, det(J_0) > 0) alongside positive receptor auto-activation (f_R > 0 for b > a) driving diffusion-driven instability when D_G >> D_R | Variables: f_R, f_G, g_R, g_G: partial derivatives of reaction terms at (R*, G*); D_R, D_G: receptor and ligand diffusion coefficients (D_G/D_R = 50); γ: domain/reaction scaling parameter; λ_c: intrinsic Turing wavelength" ;
    dct:source "Menshykau & Iber (2013) Phys. Biol. 10(4):046003 Eqs. (5)-(7); Menshykau et al. (2012) Development 139:4506-4514" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2012-menshykau-fgf10-shh-lung-turing.py#L215-L340>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_054_kidney_ureteric_bud_gdnf_ret.lean#L66-L100> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def jac_f_R_scaled (a b : Int) : Int := b - a
def jac_f_G_scaled (a b : Int) : Int := (a + b) * (a + b) * (a + b)
def jac_g_R_scaled (b : Int) : Int := -2 * b
def jac_g_G_scaled (a b : Int) : Int := -((a + b) * (a + b) * (a + b))
def jac_det_scaled (a b : Int) : Int :=
  jac_f_R_scaled a b * jac_g_G_scaled a b - jac_f_G_scaled a b * jac_g_R_scaled b
theorem menshykau_gdnf_ret_jacobian_stability_and_turing_prerequisite :
    jac_f_R_scaled 1 9 = 8 ∧
    jac_f_R_scaled 1 9 + jac_g_G_scaled 1 9 = -992 ∧
    jac_det_scaled 1 9 = 10000 := by
  decide
"""^^pk:lean4 ;
    skos:notation "f_R = (b - a)/(a + b) > 0,  g_G = -(a + b)^2 < 0,  det(J_0) = (a + b)^2 > 0,  k_c^2 = γ(a + b)/√(D_R D_G),  λ_c = 2π/k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s11538-015-0073-9>,
        <https://doi.org/10.1016/j.devcel.2004.12.004>,
        <https://doi.org/10.1016/j.ydbio.2004.03.025>,
        <https://doi.org/10.1088/1478-3975/10/4/046003> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Schnakenberg GDNF-RET-Wnt11 Receptor-Ligand Turing Instability & Self-Avoiding Ureteric Tree Branching" ;
    pk:leanDeclaration "MathOfBiology.Loop_054.jac_det_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_054.menshykau_gdnf_ret_jacobian_stability_and_turing_prerequisite" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/menshykau-fgf10-shh-lung-turing-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Zubkov et al. (2015) & Watanabe & Costantini (2004) Tip-Splitting Mode Selection & Ureteric Tree Generation Scaling Law" ;
    dct:description "Determines transitions between single-tip elongation, canonical dichotomous bifurcation (88% of WT events), and Spry1-/- trichotomous hyper-branching, as well as tip-count collapse under Gdnf+/- or PRR^(UB-/-) hypoplasia | Variables: ρ_tip = π R_tip / λ_c: dimensionless ureteric ampulla arc-to-wavelength ratio; g: branching generation; N_tips(g): distal ureteric bud tip count" ;
    dct:source "Zubkov et al. (2015) Bull. Math. Biol. 77:565-595; Watanabe & Costantini (2004) Dev. Biol. 271:98-106; Basson et al. (2005) Dev. Cell 8:229-239" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2012-menshykau-fgf10-shh-lung-turing.py#L345-L520>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_054_kidney_ureteric_bud_gdnf_ret.lean#L107-L148> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def tip_splitting_peaks (rho_10 : Nat) : Nat :=
  if rho_10 < 15 then 1 else if rho_10 < 25 then 2 else 3
def dichotomous_step (n : Nat) : Nat := 2 * n
def trichotomous_step (n : Nat) : Nat := 3 * n
def dichotomous_gen4 (n : Nat) : Nat :=
  dichotomous_step (dichotomous_step (dichotomous_step (dichotomous_step n)))
theorem ureteric_tip_splitting_modes_and_generation_scaling (n : Nat) :
    tip_splitting_peaks 12 = 1 ∧ tip_splitting_peaks 20 = 2 ∧ tip_splitting_peaks 30 = 3 ∧
    dichotomous_gen4 n = 16 * n ∧
    dichotomous_step (dichotomous_step 1) < dichotomous_gen4 1 ∧
    dichotomous_step (dichotomous_step (dichotomous_step (trichotomous_step 1))) = 24
"""^^pk:lean4 ;
    skos:notation "m(ρ_tip) = 1 (ρ_tip < 1.5), 2 (1.5 ≤ ρ_tip < 2.5, dichotomous), 3 (ρ_tip ≥ 2.5, trichotomous);  N_tips(g) = 2^g (WT dichotomous) vs N_hypo < N_WT < N_Spry1KO" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s11538-015-0073-9>,
        <https://doi.org/10.1016/j.devcel.2004.12.004>,
        <https://doi.org/10.1016/j.ydbio.2004.03.025>,
        <https://doi.org/10.1088/1478-3975/10/4/046003> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Schnakenberg GDNF-RET-Wnt11 Receptor-Ligand Turing Instability & Self-Avoiding Ureteric Tree Branching" ;
    pk:leanDeclaration "MathOfBiology.Loop_054.tip_splitting_peaks" ;
    pk:leanTheorem "MathOfBiology.Loop_054.ureteric_tip_splitting_modes_and_generation_scaling" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


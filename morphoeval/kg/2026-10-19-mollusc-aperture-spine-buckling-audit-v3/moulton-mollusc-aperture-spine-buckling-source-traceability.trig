sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-moulton-mollusc-aperture-spine-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Moulton, Goriely & Chirat (2015) & Chirat et al. (2013) hierarchical mollusc aperture spine folding and fractal frond serration — Source and data traceability: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credit: 5 dataset files are SHA-256-pinned in `EXPECTED_SHA256` (L105-124) and verified fail-closed at every run by `verify_dataset_integrity()` (L136-150), including the new `pass3_koiter_cord_thickness_reference.json` (L119-121); `pass3_citations.bib` adds Koiter (1966), Manor et al. (2008) and re-cites Rudraraju et al. (2019) with the explicit note that DOIs could not be re-verified offline; the dataset README has a Pass 3 section that labels both closures as reduced and lists the new files and media; the four Pass 2 DOIs are unchanged. Deductions: the manor2008 DOI `10.1209/0295-5075/83/10005` is recalled from memory and unverified, and koiter1966 has no DOI (-2); the modelling constants have no source — E = 12 MPa, K_s = 0.48 vs K_s_eff = 1.98 (L163, L213, L677), h = 0.42 / 0.0708 / 0.0245 mm (L182-183), Koiter `onset_excess = 0.15` (L686), `varix_halfwidth_mm = 5.0` (L681), `kappa_3 = 0.28 k^2 P_c` (L726, L1083), the height law 4.8 sqrt(gamma - gamma_c) (L368, L747), `eps_cord = 0.15` and the 0.35 thickness floor (L1031) (-5); the cross-taxa `*_obs` columns and the per-species h_1, h_2 values in the reference JSON (L114-150) cite no measurement (-3); only a Murex pecten photograph is vendored although Chicoreus ramosus is half of the organism field (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/mollusc_aperture_spine_buckling/mollusc_aperture_spine_buckling_reference.json L114–L150: Cross-taxa table h1/h2/obs values have no measurement provenance <https://github.com/fractastical/morpholib/blob/9987db7d/datasets/mollusc_aperture_spine_buckling/mollusc_aperture_spine_buckling_reference.json#L114-L150>",
            "models/2015-moulton-mollusc-aperture-spine-buckling.py L677–L690: Koiter defaults K_s_eff = 1.98, varix_halfwidth_mm = 5.0, onset_excess = 0.15 — modelling choices without a cited source <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L677-L690>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-source-traceability-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2015-moulton-mollusc-aperture-spine-buckling.py L105–L150" ;
        dct:description "EXPECTED_SHA256 for 5 dataset files incl. pass3_koiter_cord_thickness_reference.json (L119-121); verify_dataset_integrity raises on missing file or digest mismatch" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L105-L150> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/mollusc_aperture_spine_buckling/pass3_citations.bib L1–L32" ;
        dct:description "koiter1966 (no DOI), manor2008 (DOI unverified offline, stated at L2), rudraraju2019" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/datasets/mollusc_aperture_spine_buckling/pass3_citations.bib#L1-L32> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/mollusc_aperture_spine_buckling/README.md L37–L49" ;
        dct:description "Pass 3 section: reduced-order closures honestly labelled, new files and media listed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/datasets/mollusc_aperture_spine_buckling/README.md#L37-L49> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediated assessment, Phase B audit agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


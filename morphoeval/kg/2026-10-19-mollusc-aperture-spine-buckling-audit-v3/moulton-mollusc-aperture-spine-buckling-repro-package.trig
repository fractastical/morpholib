sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-moulton-mollusc-aperture-spine-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Moulton, Goriely & Chirat (2015) & Chirat et al. (2013) hierarchical mollusc aperture spine folding and fractal frond serration — Reproducibility package: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credit: deterministic RNG (seed 2015); `self_test()` (L1874-1976) runs 13 checks — 8 Pass 2 (SHA-256 of 5 files, JSON parity, frond cascade, tubular closure, varix spacing + subcritical control, cross-taxa, specimen segmentation, bitwise two-run determinism) plus 5 Pass 3 (pass3 JSON parity, Koiter free vs locked with bitwise determinism at L1941-1942, locking-tongue monotonicity + oblique de-registration + tilt, graded WKB r > 0.9 and uniform CV < 0.02, beta* = 4/3 at L1961); a fresh run in this audit PASSED 13/13 in 74 s; default render produces the 3x3 PNG, the growth GIF (byte-identical to Pass 2), the standalone Pass 3 PNG and the cord-locking GIF; `--skip-pass3-media` and `--skip-gif` shorten runs. Deductions: self-test wall time is ~65-75 s because the sweeps run at full resolution (-3); the README and the `--self-test` help string are not fully synchronised with the 13-check suite (L1981) (-2); PNGs are gitignored (`*.png`) so the rendered figures are not versioned and the audit relies on local regeneration (-2); no requirements lock file is vendored for this script (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-repro-package-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-repro-package-5> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2015-moulton-mollusc-aperture-spine-buckling.py L1874–L1976" ;
        dct:description "13-check self_test(): 5-file SHA-256, JSON parity, Pass 2 solvers, Pass 3 Koiter/locking/graded/beta checks, bitwise determinism (L1923-1924, L1941-1942)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L1874-L1976> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "models/2015-moulton-mollusc-aperture-spine-buckling.py L1979–L2029" ;
        dct:description "main(): CLI flags, compute_pass3_bundle with sweeps, Pass 3 PNG + GIF rendering, --skip-pass3-media" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L1979-L2029> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "datasets/mollusc_aperture_spine_buckling/pass3_koiter_cord_thickness_reference.json L1–L68" ;
        dct:description "Pass 3 reference JSON (SHA-256 63fdbb23...) pinned by the script and parity-checked in self_test" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/datasets/mollusc_aperture_spine_buckling/pass3_koiter_cord_thickness_reference.json#L1-L68> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/mollusc_aperture_spine_buckling_cord_locking.gif (generated output)" ;
        dct:description "Cord-locking GIF (eps_cord sweep) rendered by render_cord_locking_gif (L1652-1676) — docs/media/mollusc_aperture_spine_buckling_cord_locking.gif: rendered output of models/2015-moulton-mollusc-aperture-spine-buckling.py at 9987db7d, image/gif, 273962 B, 924×396 px, 8 frames, artifact_sha256 4f9dfbe0e0124f46f6449e4efb5adc38abc32a7570ba69c02bfdf4dc146b94fc (sha256 4f9dfbe0e0124f46f6449e4efb5adc38abc32a7570ba69c02bfdf4dc146b94fc), spec_fingerprint 7e0a58a2882e57518d985e4253c9b131677e4c5f4943a638d01e321b11b48932" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-repro-package-5> a pk:EvidenceItem ;
        rdfs:label "docs/media/mollusc_aperture_spine_buckling_growth.gif (generated output)" ;
        dct:description "Growth GIF re-rendered byte-identically to Pass 2 (deterministic; git shows it unmodified) — docs/media/mollusc_aperture_spine_buckling_growth.gif: rendered output of models/2015-moulton-mollusc-aperture-spine-buckling.py at 9987db7d, image/gif, 178812 B, 1056×462 px, 10 frames, artifact_sha256 c3ae8a12c5e68c1ce1ba607b215c1f3fd29f79c1e48f169f1a02dd36956063c5 (sha256 c3ae8a12c5e68c1ce1ba607b215c1f3fd29f79c1e48f169f1a02dd36956063c5), spec_fingerprint 7e0a58a2882e57518d985e4253c9b131677e4c5f4943a638d01e321b11b48932" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediated assessment, Phase B audit agent)" ;
        dct:identifier "claude-fable-5-1" ;

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-moulton-mollusc-aperture-spine-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Moulton, Goriely & Chirat (2015) & Chirat et al. (2013) hierarchical mollusc aperture spine folding and fractal frond serration — Morphometric validation: 84/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credit: `measure_morphoeval()` (L1681-1871) now returns 17 reference-anchored entries; the 8 new ones are genuinely emergent or inferred quantities with meaningful nulls — free Koiter spine count 17 vs 16.47 theory, cord registration 1.00 vs 0.5 chance, de-registration psi* 34.99 deg vs the 22.78 deg rigid estimate (the gap is interpreted as tilt compensation), spine tilt 10.45 deg at psi = 19.3 deg, WKB spacing Pearson r = 0.9907 vs 1.0, graded CV 0.112 vs specimen 0.209, h_max/h_min 1.71 vs the uniform null 1.0, beta* = 1.3333 vs 4/3 (L1698-1776). Deductions: five Pass 2 / Pass 3 reference values are the script's own output or an analytic identity — the neck-gap delta reference -3.1059 mm (L1826) is the linear formula's result, the specimen CV reference 0.2092 (L1866) is the measured value, the Chicoreus k_2/k_1 reference 3.80 (L1806) is achieved by choosing h_2 = 0.0708 so that (0.42/0.0708)^(3/4) = 3.80 (L182, L391), beta* = 4/3 (L1773) is the trivial root of 4 - 3 beta, and the 22.78 deg \"reference\" (L1236) is the script's own rigid-spine estimate (-7); the \"L-BFGS-B relaxed spine count 16.0 vs 16.0\" (L1812-1820) and the \"120.0 deg\" varix spacing (L1832-1840) are prescribed, as shown under model-fidelity (-5); the 10-species cross-taxa correlations (r = 1.0000, 0.9987; `evaluate_cross_taxa_muricids`, L497-556) rest on `k2_over_k1_obs` / `n_primary_spines_obs` values in the reference JSON that equal the predictions to rounding and are not sourced to any measurement (-4); no empirical thickness or varix morphometric exists for the new Pass 3 quantities (-3); Pass 2 credited 92 for a set whose anchors this pass finds largely self-referential, so the dimension falls." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "datasets/mollusc_aperture_spine_buckling/mollusc_aperture_spine_buckling_reference.json L114–L150: muricid_cross_taxa_table: n_primary_spines_obs / k2_over_k1_obs entries without any measurement source <https://github.com/fractastical/morpholib/blob/9987db7d/datasets/mollusc_aperture_spine_buckling/mollusc_aperture_spine_buckling_reference.json#L114-L150>",
            "models/2015-moulton-mollusc-aperture-spine-buckling.py L1802–L1828: Chicoreus k2/k1 reference 3.80 (chosen h2 = 0.0708), comb spine count 16.0 (prescribed mode) and neck-gap delta reference -3.1059 (own output): self-referential anchors <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L1802-L1828>",
            "models/2015-moulton-mollusc-aperture-spine-buckling.py L1832–L1871: Varix spacing 120.0 deg (prescribed bursts), subcritical control, specimen count 16 and spacing CV reference 0.2092 equal to the measured value <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L1832-L1871>",
            "models/2015-moulton-mollusc-aperture-spine-buckling.py L497–L556: 10-species cross-taxa regression against unsourced *_obs columns that match predictions to rounding (r = 1.0000) <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L497-L556>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-10-species-muricid-primary-comb-spine-count-correlation-chirat-et-al-2013>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-10-species-muricid-secondary-primary-wavenumber-cascade-correlation-moulton-et-al-2015>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-biological-specimen-segmented-primary-comb-spine-count-murex-pecten-aperture-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-biological-specimen-siphonal-comb-inter-spine-spacing-cv-murex-pecten-aperture-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-chicoreus-ramosus-secondary-to-primary-frond-wavenumber-ratio-k-2-k-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-episodic-triradiate-varix-angular-phase-spacing-across-3-whorls>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-graded-thickness-comb-emergent-inter-spine-spacing-cv-vs-murex-pecten-specimen-spacing-cv>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-graded-thickness-comb-pearson-r-between-emergent-inter-spine-spacing-and-local-wkb-wavelength-lambda-s-h-s-3-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-inverse-wkb-implied-mantle-edge-thickness-ratio-h-max-h-min-along-the-specimen-siphonal-canal>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-l-bfgs-b-relaxed-murex-pecten-siphonal-canal-primary-spine-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-oblique-cord-de-registration-obliquity-psi-registration-0-75-vs-rigid-spine-phase-drift-estimate>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-ontogenetic-spine-count-conserving-allometric-exponent-beta-h-1-l-beta-across-instars>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-reduced-koiter-shell-free-buckling-emergent-spines-per-varix-eps-cord-0-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-spine-registration-to-oblique-spiral-cord-varix-intersections-eps-cord-0-15-psi-10-deg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-spine-ridge-tilt-following-oblique-cords-at-psi-19-3-deg-koiter-shell>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-subcritical-mantle-growth-negative-control-spine-amplitude-gamma-0-96-gamma-c-vs-wild-type>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-tubular-self-contact-vs-open-gutter-basal-neck-gap-delta-murex-vs-chicoreus>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-morphometric-validation-1> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-10-species-muricid-primary-comb-spine-count-correlation-chirat-et-al-2013> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "10-species muricid primary comb spine count correlation (Chirat et al. 2013) = 0.9987 Pearson r" ;
        dct:description "RMSE = 0.1516 spines, p=1.38e-11" ;
        schema:measurementTechnique "Correlation of predicted vs observed primary varix/canal spine count across 10 muricid taxa (RMSE=0.1516 spines, p=1.38e-11)" ;
        schema:name "10-species muricid primary comb spine count correlation (Chirat et al. 2013)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9987" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-10-species-muricid-primary-comb-spine-count-correlation-chirat-et-al-2013-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-10-species-muricid-primary-comb-spine-count-correlation-chirat-et-al-2013-reference> a schema:PropertyValue ;
        dct:source "Chirat, Moulton & Goriely (2013) PNAS 110:6015-6020 & Moulton et al. (2015) J. Theor. Biol. 364:420-430" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-10-species-muricid-secondary-primary-wavenumber-cascade-correlation-moulton-et-al-2015> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "10-species muricid secondary/primary wavenumber cascade correlation (Moulton et al. 2015) = 1.0 Pearson r" ;

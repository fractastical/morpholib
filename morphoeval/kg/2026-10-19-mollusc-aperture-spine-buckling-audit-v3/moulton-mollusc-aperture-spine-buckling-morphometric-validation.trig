        dct:description "mean spacing = 42.13 ± 8.82 px" ;
        schema:measurementTechnique "Coefficient of variation of inter-spine spacing across n=16 primary comb spines in Murex pecten specimen" ;
        schema:name "Biological specimen siphonal comb inter-spine spacing CV (murex_pecten_aperture_specimen.jpg)" ;
        schema:unitText "CV (std/mean)" ;
        schema:value "0.2092" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-biological-specimen-siphonal-comb-inter-spine-spacing-cv-murex-pecten-aperture-specimen-jpg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-biological-specimen-siphonal-comb-inter-spine-spacing-cv-murex-pecten-aperture-specimen-jpg-reference> a schema:PropertyValue ;
        dct:source "Chirat, Moulton & Goriely (2013) PNAS periodic siphonal comb spine regularity (CV < 0.25)" ;
        schema:value "0.2092" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-chicoreus-ramosus-secondary-to-primary-frond-wavenumber-ratio-k-2-k-1> a schema:PropertyValue,

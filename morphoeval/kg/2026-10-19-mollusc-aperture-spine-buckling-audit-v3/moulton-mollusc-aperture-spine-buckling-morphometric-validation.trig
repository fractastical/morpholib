        schema:measurementTechnique "Linear regression of predicted (h1/h2)^(3/4) vs observed k2*/k1* across 10 muricid species (p=6.50e-18, RMSE=0.0074)" ;
        schema:name "10-species muricid secondary/primary wavenumber cascade correlation (Moulton et al. 2015)" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-10-species-muricid-secondary-primary-wavenumber-cascade-correlation-moulton-et-al-2015-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-10-species-muricid-secondary-primary-wavenumber-cascade-correlation-moulton-et-al-2015-reference> a schema:PropertyValue ;
        dct:source "Moulton, Goriely & Chirat (2015) J. Theor. Biol. 364:420-430 Sec. 3-4 & Figs. 5-8" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-biological-specimen-segmented-primary-comb-spine-count-murex-pecten-aperture-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Biological specimen segmented primary comb spine count (murex_pecten_aperture_specimen.jpg) = 16.0 spines" ;

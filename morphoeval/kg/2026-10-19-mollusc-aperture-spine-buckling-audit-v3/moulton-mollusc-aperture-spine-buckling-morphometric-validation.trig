        schema:name "Chicoreus ramosus secondary-to-primary frond wavenumber ratio k_2* / k_1*" ;
        schema:unitText "ratio (k2*/k1*)" ;
        schema:value "3.8011" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-chicoreus-ramosus-secondary-to-primary-frond-wavenumber-ratio-k-2-k-1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-chicoreus-ramosus-secondary-to-primary-frond-wavenumber-ratio-k-2-k-1-reference> a schema:PropertyValue ;
        dct:source "Moulton, Goriely & Chirat (2015) J. Theor. Biol. 364:420-430 hierarchical fractal frond serration ratio k2/k1 ≈ 3.8" ;
        schema:value "3.8" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-episodic-triradiate-varix-angular-phase-spacing-across-3-whorls> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Episodic triradiate varix angular phase spacing across 3 whorls = 119.99 deg" ;
        dct:description "inter-varix smooth whorl amplitude = 0.000000 mm" ;
        schema:measurementTechnique "Mean angular spacing across 9 episodic varix spine bursts over 3 helicospiral whorls" ;
        schema:name "Episodic triradiate varix angular phase spacing across 3 whorls" ;
        schema:unitText "deg" ;
        schema:value "119.99" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-episodic-triradiate-varix-angular-phase-spacing-across-3-whorls-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-episodic-triradiate-varix-angular-phase-spacing-across-3-whorls-reference> a schema:PropertyValue ;
        dct:source "Chirat et al. (2013) PNAS & Moulton et al. (2012) J. Theor. Biol. triradiate varix phase locking (120 deg)" ;
        schema:value "120.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-graded-thickness-comb-emergent-inter-spine-spacing-cv-vs-murex-pecten-specimen-spacing-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Graded-thickness comb emergent inter-spine spacing CV vs Murex pecten specimen spacing CV = 0.1121 CV (std/mean)" ;
        dct:description "Specimen CV is a direct observable; the smooth two-harmonic h(s) fit cannot reproduce unresolved spacing noise, so the simulated CV is a lower bound. No micro-CT h(s) data vendored (Pass 4 residual)." ;
        schema:measurementTechnique "Coefficient of variation of the emergent spine spacing along the canal in the graded h(s) comb (two-harmonic periodic fit of the inverse-WKB thickness profile, R^2 = 0.29) vs the raw specimen spacing CV" ;
        schema:name "Graded-thickness comb emergent inter-spine spacing CV vs Murex pecten specimen spacing CV" ;
        schema:unitText "CV (std/mean)" ;
        schema:value "0.1121" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-graded-thickness-comb-emergent-inter-spine-spacing-cv-vs-murex-pecten-specimen-spacing-cv-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-graded-thickness-comb-emergent-inter-spine-spacing-cv-vs-murex-pecten-specimen-spacing-cv-reference> a schema:PropertyValue ;
        dct:source "SHA-256-locked Murex pecten specimen (murex_pecten_aperture_specimen.jpg), Difference-of-Gaussians comb segmentation (this script, Sec. 6)" ;
        schema:value "0.2092" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-graded-thickness-comb-pearson-r-between-emergent-inter-spine-spacing-and-local-wkb-wavelength-lambda-s-h-s-3-4> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Graded-thickness comb: Pearson r between emergent inter-spine spacing and local WKB wavelength lambda(s) ∝ h(s)^(3/4) = 0.9907 Pearson r" ;
        dct:description "uniform-h control: N = 16, spacing CV = 0.0000; graded CV = 0.1121" ;
        schema:measurementTechnique "Variable-rigidity D(s) = (h(s)/h_bar)^3 unilateral comb relaxed from noise with h(s) inferred from the specimen (N = 16 emergent spines); spacing at each inter-spine midpoint correlated with lambda_1 h_rel^(3/4)" ;
        schema:name "Graded-thickness comb: Pearson r between emergent inter-spine spacing and local WKB wavelength lambda(s) ∝ h(s)^(3/4)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9907" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-graded-thickness-comb-pearson-r-between-emergent-inter-spine-spacing-and-local-wkb-wavelength-lambda-s-h-s-3-4-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-graded-thickness-comb-pearson-r-between-emergent-inter-spine-spacing-and-local-wkb-wavelength-lambda-s-h-s-3-4-reference> a schema:PropertyValue ;
        dct:source "Moulton, Goriely & Chirat (2015) J. Theor. Biol. 364:420-430 local wavenumber law k^*(s) = (3 K_s / (E h(s)^3))^(1/4) (WKB limit of slowly varying thickness)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-inverse-wkb-implied-mantle-edge-thickness-ratio-h-max-h-min-along-the-specimen-siphonal-canal> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Inverse-WKB implied mantle-edge thickness ratio h_max / h_min along the specimen siphonal canal = 1.7128 ratio" ;
        dct:description "fit R^2 = 0.294; deviation from 1.0 quantifies the thickness gradient implied by the spacing profile" ;
        schema:measurementTechnique "h(u)/h_bar = (lambda(u)/lambda_bar)^(4/3) from the specimen inter-spine spacing profile, two-harmonic periodic least-squares fit, max/min of the fit" ;
        schema:name "Inverse-WKB implied mantle-edge thickness ratio h_max / h_min along the specimen siphonal canal" ;
        schema:unitText "ratio" ;
        schema:value "1.7128" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-inverse-wkb-implied-mantle-edge-thickness-ratio-h-max-h-min-along-the-specimen-siphonal-canal-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-inverse-wkb-implied-mantle-edge-thickness-ratio-h-max-h-min-along-the-specimen-siphonal-canal-reference> a schema:PropertyValue ;
        dct:source "Uniform-thickness null hypothesis (h constant along the canal => lambda constant); micro-CT cross-sections of Chicoreus ramosus instars requested by the Pass 2 audit were not obtainable offline — inferred, not measured" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-l-bfgs-b-relaxed-murex-pecten-siphonal-canal-primary-spine-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "L-BFGS-B relaxed Murex pecten siphonal canal primary spine count = 16.0 spines" ;
        dct:description "simulated wavelength = 4.2000 mm vs theory 4.0813 mm" ;
        schema:measurementTechnique "Sub-bin parabolic FFT interpolation of L-BFGS-B relaxed fourth-order mantle margin along L=67.2 mm siphonal canal" ;
        schema:name "L-BFGS-B relaxed Murex pecten siphonal canal primary spine count" ;
        schema:unitText "spines" ;
        schema:value "16.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-l-bfgs-b-relaxed-murex-pecten-siphonal-canal-primary-spine-count-reference> .

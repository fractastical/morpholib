sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-moulton-mollusc-aperture-spine-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Moulton, Goriely & Chirat (2015) & Chirat et al. (2013) hierarchical mollusc aperture spine folding and fractal frond serration — Parameter expressivity: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credit: Pass 3 adds five live CLI flags `--cord-angle`, `--eps-cord`, `--n-cords`, `--beta`, `--skip-pass3-media` (L1988-1992) threaded through `compute_pass3_bundle` (L1193-1238, L2015); the locking-tongue sweep spans n_cords 12-20 x eps in {0, 0.01, 0.04, 0.15} with the eps = 0 control recovering the free mode (`sweep_cord_locking`, L902-938); the obliquity sweep covers realised psi in {0, 9.9, 19.3, 27.7, 35.0} deg with registration, tilt and the rigid-spine sinc(delta phi) prediction (`sweep_cord_obliquity`, L941-990); the beta sweep {0.75, 1, 4/3, 1.5} gives slopes {+0.44, +0.25, 0, -0.125}; the Pass 2 gamma sweep (0.96 / 1.26 / 1.42 / 1.68) and 3 frond generations remain. Deductions: `--K-s` reaches only the frond synthesiser (L1263, `K_s_MPa_per_mm`) while the comb, Koiter and graded solvers use the separate default `K_s_eff = 1.98` (L213, L677, L907, L947, L1052) — so the flag does not move the headline spine counts (-5); `--gamma-varix` changes only the Koiter height scale, never the wavelength (frozen at onset by design, L721-725), and `--E` does not reach the elastica/varix modules (-3); the obliquity is quantised to integer m_t for bi-periodicity so the requested psi is only approximately realised (L737-740) (-2); the `--self-test` help string still says \"8-check\" (L1981) (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "models/2015-moulton-mollusc-aperture-spine-buckling.py L1259–L1263: --K-s is passed only to synthesize_chicoreus_fractal_frond; comb/Koiter/graded solvers use K_s_eff = 1.98 defaults (L213, L677, L1052) <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L1259-L1263>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-parameter-expressivity-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2015-moulton-mollusc-aperture-spine-buckling.py L1981–L1992" ;
        dct:description "CLI: --self-test (help text stale: '8-check'), --E, --K-s, --gamma-varix, --seed, plus Pass 3 --cord-angle, --eps-cord, --n-cords, --beta, --skip-pass3-media" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L1981-L1992> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2015-moulton-mollusc-aperture-spine-buckling.py L902–L990" ;
        dct:description "Locking-tongue sweep (n_cords x eps_cord, eps = 0 control) and obliquity sweep with sinc(phase drift) rigid-spine prediction" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L902-L990> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "models/2015-moulton-mollusc-aperture-spine-buckling.py L1151–L1190" ;
        dct:description "beta sweep {0.75, 1, 4/3, 1.5} and Brent root for the spine-count-conserving exponent" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L1151-L1190> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediated assessment, Phase B audit agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


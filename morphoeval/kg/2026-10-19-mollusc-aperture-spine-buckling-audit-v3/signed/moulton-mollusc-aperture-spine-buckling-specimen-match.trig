sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-moulton-mollusc-aperture-spine-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Moulton, Goriely & Chirat (2015) & Chirat et al. (2013) hierarchical mollusc aperture spine folding and fractal frond serration — Morphological realism / specimen match: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credit: the SHA-256-locked *Murex pecten* specimen is now used quantitatively twice — DoG comb segmentation (n = 16, CV = 0.2092; `segment_murex_specimen`, L559-634) and, new in Pass 3, its 15 inter-spine spacings drive the inverse-WKB thickness profile h(u)/h_bar = (lambda/lambda_bar)^(4/3) that is then tested against the graded comb (panel I, L1486-1517; CV 0.112 emergent vs 0.209 specimen); the specimen is visible in panels F and I of the 3x3 figure and the Koiter surface in panel G shows cord-registered spines in 3-D (`render_pass3_koiter_figure`, L1573-1649). Deductions: every *Chicoreus ramosus* claim (frond cascade, h(s) across instars) has no specimen — the Pass 2 item explicitly asked for Chicoreus thickness data and the closure uses a Murex photograph (-6); the two-harmonic thickness fit has R^2 = 0.29 and is floored at 0.35 (L1031), so the inferred h_max/h_min = 1.71 is weakly constrained, and the first segmented spacing (find_peaks distance = 26 px, L585) is plausibly a spurious peak that inflates the gradient (-4); the emergent graded-comb CV (0.112) reaches only about half the specimen CV (-2); the cord-locking GIF and Koiter surface are compared with no muricid varix photograph (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match-6> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "models/2015-moulton-mollusc-aperture-spine-buckling.py L559–L634" ;
        dcterms:description "DoG comb-spine segmentation on the SHA-256-locked Murex pecten specimen (find_peaks distance 26 px at L585)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L559-L634> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "models/2015-moulton-mollusc-aperture-spine-buckling.py L1008–L1044" ;
        dcterms:description "Inverse-WKB thickness profile from the specimen's 15 spacings; two-harmonic periodic fit R^2 = 0.29 with a 0.35 floor (L1031) — quantitative specimen use but weakly constrained" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L1008-L1044> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "models/2015-moulton-mollusc-aperture-spine-buckling.py L1486–L1517" ;
        dcterms:description "Panel I: specimen spacing vs WKB fit vs emergent graded spacing vs uniform control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L1486-L1517> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/mollusc_aperture_spine_buckling_comparison.png (generated output)" ;
        dcterms:description "3x3 synthesis figure: Murex comb, elastica closure, Chicoreus frond, varix cycle, 10-species scaling, specimen segmentation, Koiter surface (G), locking tongue (H), thickness gradient (I); no Chicoreus specimen anywhere — docs/media/mollusc_aperture_spine_buckling_comparison.png: rendered output of models/2015-moulton-mollusc-aperture-spine-buckling.py at 9987db7d, image/png, 1194417 B, 2640×2400 px, artifact_sha256 1982f3f9822d1bbcf1b1f7746300e631c3f6c1877a192d1178f7c2019f4ea327 (sha256 1982f3f9822d1bbcf1b1f7746300e631c3f6c1877a192d1178f7c2019f4ea327), spec_fingerprint 7e0a58a2882e57518d985e4253c9b131677e4c5f4943a638d01e321b11b48932" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match-5> a pk:EvidenceItem ;
        rdfs:label "docs/media/mollusc_aperture_spine_buckling_koiter_cord_ontogeny.png (generated output)" ;
        dcterms:description "Standalone Pass 3 figure: 3-D Koiter surface with cord-registered spines, obliquity de-registration + tilt, graded comb with h(s), instar series; compared with no varix photograph — docs/media/mollusc_aperture_spine_buckling_koiter_cord_ontogeny.png: rendered output of models/2015-moulton-mollusc-aperture-spine-buckling.py at 9987db7d, image/png, 611963 B, 2175×1500 px, artifact_sha256 937d8a3eb366292a2b462e999da3113a52582ba2961c6a57d3ad997e4b7b1fd1 (sha256 937d8a3eb366292a2b462e999da3113a52582ba2961c6a57d3ad997e4b7b1fd1), spec_fingerprint 7e0a58a2882e57518d985e4253c9b131677e4c5f4943a638d01e321b11b48932" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match-6> a pk:EvidenceItem ;
        rdfs:label "datasets/mollusc_aperture_spine_buckling/README.md L37–L49" ;
        dcterms:description "Pass 3 section states the h(s) is inferred from the Murex specimen, not measured, and that no Chicoreus specimen is vendored" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/datasets/mollusc_aperture_spine_buckling/README.md#L37-L49> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediated assessment, Phase B audit agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


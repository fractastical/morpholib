sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-moulton-mollusc-aperture-spine-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2015-moulton-mollusc-aperture-spine-buckling.py L1–L72" ;
        dcterms:description "Header: laws 1-5 mapped to Moulton 2015 / Chirat 2013 / Lean theorems; Law 4 Pass 3 entry at L58-62; still presents the elastica as an ODE solution (L43-44)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L1-L72> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "models/2015-moulton-mollusc-aperture-spine-buckling.py L627–L748" ;
        dcterms:description "Pass 3 section banner + Koiter docstring: energy functional, varix window, cord forcing and the Mathieu argument against stiffness modulation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L627-L748> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/moulton-mollusc-aperture-spine-buckling.yaml L1–L130" ;
        dcterms:description "Equations 1-5 with single-range code_locus pins (L160-332, L335-437, L440-494, L670-900, L1008-1190) and Lean theorem names" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/math_kg_loops/moulton-mollusc-aperture-spine-buckling.yaml#L1-L130> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediated assessment, Phase B audit agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Moulton, Goriely & Chirat (2015) & Chirat et al. (2013) hierarchical mollusc aperture spine folding and fractal frond serration — Code-to-model traceability: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credit: the header docstring (L1-72) maps each law to its source and now adds Law 4 (cord/varix intersection registration, L58-62) with the explicit statement that the Koiter module is reduced; the Pass 3 section banner (L627-634) and `solve_koiter_shell_cord_spine_coupling`'s docstring state the energy functional, the varix window, the forcing choice and why stiffness modulation was rejected (L691-748); `infer_specimen_thickness_gradient` states the inverse-WKB law; every new function's variables carry units in their names; the math-KG YAML registers equations 4-5 with single-range `code_locus` pins refreshed for the Pass 3 line shifts, and each Lean theorem names the law it encodes. Deductions: the `--self-test` help text still says \"8-check\" although the suite has 13 (L1981) (-2); `EI_eff`, `P_load`, `kappa_3` and D = 1 are nondimensional while the returned fields are suffixed `_mm` (L255-260, L670-900) (-3); the L-BFGS-B `converged` flag silently falls back to a gradient-norm test when maxiter is hit (L817) and the comb solver reports `converged = True` on the trivial branch (L247) (-2); the parametric nature of the elastica and frond modules is not stated in their docstrings while the module header still calls them Kirchhoff-Clebsch solutions (L43-44, L335-437) (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "models/2015-moulton-mollusc-aperture-spine-buckling.py L812–L817: converged = opt.success or grad_inf < 1e-5: silent fallback when L-BFGS-B stops at maxiter <https://github.com/fractastical/morpholib/blob/9987db7d/models/2015-moulton-mollusc-aperture-spine-buckling.py#L812-L817>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-code-traceability-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


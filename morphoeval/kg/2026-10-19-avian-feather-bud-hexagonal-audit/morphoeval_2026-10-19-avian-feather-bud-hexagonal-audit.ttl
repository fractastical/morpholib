        <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-avian-feather-bud-hexagonal-audit-glimm-avian-feather-bud-hexagonal-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-avian-feather-bud-hexagonal-audit-glimm-avian-feather-bud-hexagonal-2>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-avian-feather-bud-hexagonal-audit-glimm-avian-feather-bud-hexagonal-3> ;
    pk:hypothesisType "Coupled Keller-Segel Dermal Chemotaxis + FGF20/BMP4 Lateral Inhibition + EDA Traveling Competence Wave (Glimm et al. 2014 & Ho et al. 2019)" ;

<https://w3id.org/probknow/resource/claim/morphoeval-glimm-avian-feather-bud-hexagonal> a pk:Claim ;
    rdfs:label "Glimm et al. (2014) & Ho et al. (2019) avian feather bud hexagonal array & traveling competence wave (Embryonic chick (Gallus gallus) dorsal skin feather tract E6.5-E9.5 hexagonal feather primordia array)",
        "Glimm et al. (2014) & Ho et al. (2019) avian feather bud hexagonal array & traveling competence wave faithfully reproduces Embryonic chick (Gallus gallus) dorsal skin feather tract E6.5-E9.5 hexagonal feather primordia array morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/glimm-avian-feather-bud-hexagonal-1>,
        <https://w3id.org/probknow/resource/math-law/glimm-avian-feather-bud-hexagonal-2>,
        <https://w3id.org/probknow/resource/math-law/glimm-avian-feather-bud-hexagonal-3> ;
    dct:description "The simulation script(s) 2018-glimm-avian-feather-bud-hexagonal.py implement the cited source model as published and produce forms that match real Embryonic chick (Gallus gallus) dorsal skin feather tract E6.5-E9.5 hexagonal feather primordia array specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 52.9/100, audit 2026-10-19-avian-feather-bud-hexagonal-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py> ;
    schema:about "Embryonic chick (Gallus gallus) dorsal skin feather tract E6.5-E9.5 hexagonal feather primordia array" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py; output: docs/media/avian_feather_bud_hexagonal_comparison.png; organism: Embryonic chick (Gallus gallus) dorsal skin feather tract E6.5-E9.5 hexagonal feather primordia array; checkpoint commit: https://github.com/fractastical/morpholib/commit/3cb5ea9; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 97f8b6d41437bf22798c0eb2f411aef0516b204ccaeaa4edce5a129ec128b370; artifact_sha256: 664c2117a860f19f7f99ed8d09c4cb5a082a7fafb17dd93b9deb26564682392e; input_dataset_sha256: {datasets/avian_feather_bud_hexagonal/avian_feather_bud_hexagonal_reference.json=06d930a05c4f2cee..., datasets/avian_feather_bud_hexagonal/chick_feather_bud_hexagonal_specimen.jpg=ce18b1c0e01ecb20..., datasets/avian_feather_bud_hexagonal/paper_citations.bib=9d17147a43097e6e..., datasets/avian_feather_bud_hexagonal/scout_manifest.json=1ff38c1e609c69ea...}" ;
    pk:derivedFromPaper <https://doi.org/10.1016/j.ydbio.2014.08.030>,
        <https://doi.org/10.1371/journal.pbio.3000132>,
        <https://doi.org/10.1371/journal.pbio.3000448>,
        <https://doi.org/10.1371/journal.pone.0001942> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity>,

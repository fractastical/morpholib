sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-glimm-avian-feather-bud-hexagonal> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-critical-fgf20-chemotactic-sensitivity-threshold-chi-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical FGF20 chemotactic sensitivity threshold chi_c = 0.054 chemotactic sensitivity" ;
        schema:measurementTechnique "Keller-Segel / FGF20 linear instability threshold ((sqrt(D_n*mu_c)+sqrt(D_c*r_n))^2)/(n_0*f_c)" ;
        schema:name "critical FGF20 chemotactic sensitivity threshold chi_c" ;
        schema:unitText "chemotactic sensitivity" ;
        schema:value "0.054" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-critical-fgf20-chemotactic-sensitivity-threshold-chi-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-critical-fgf20-chemotactic-sensitivity-threshold-chi-c-reference> a schema:PropertyValue ;
        dcterms:source "Ho et al. (2019) PLoS Biol. 17:e3000132" ;
        schema:value "0.0545" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-hexagonal-inter-row-to-intra-row-spacing-ratio-delta-x-lambda-y> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "hexagonal inter-row to intra-row spacing ratio Delta_x / lambda_y = 0.866 dimensionless ratio" ;
        schema:measurementTechnique "Equilateral half-phase row offset ratio sqrt(3)/2" ;
        schema:name "hexagonal inter-row to intra-row spacing ratio Delta_x / lambda_y" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "0.866" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-hexagonal-inter-row-to-intra-row-spacing-ratio-delta-x-lambda-y-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-hexagonal-inter-row-to-intra-row-spacing-ratio-delta-x-lambda-y-reference> a schema:PropertyValue ;
        dcterms:source "Glimm, Bhat & Newman (2014) Dev. Biol. 395:139-149" ;
        schema:value "0.866" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-simulated-dorsal-tract-feather-bud-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated dorsal tract feather bud count = 102.0 buds" ;
        schema:measurementTechnique "2D local maxima count on dermal density field n(x,y)" ;
        schema:name "simulated dorsal tract feather bud count" ;
        schema:unitText "buds" ;
        schema:value "102.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-simulated-dorsal-tract-feather-bud-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-simulated-dorsal-tract-feather-bud-count-reference> a schema:PropertyValue ;
        dcterms:source "Ho et al. (2019) PLoS Biol. 17:e3000132 Fig. 3B" ;
        schema:value "24.0" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Glimm et al. (2014) & Ho et al. (2019) avian feather bud hexagonal array & traveling competence wave — Morphometric validation: 46/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` reports only 3 basic scalars (sqrt(3)/2 ratio, chi_c, and raw peak count, L136-158) without Voronoi hexagonal fraction P_6, bond-orientational order |psi_6|, nearest-neighbor spacing CV, or specimen morphometrics." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2018-glimm-avian-feather-bud-hexagonal.py L136–L158: Only 3 basic scalars without Voronoi P_6, |psi_6|, or specimen validation <https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py#L136-L158>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-critical-fgf20-chemotactic-sensitivity-threshold-chi-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-hexagonal-inter-row-to-intra-row-spacing-ratio-delta-x-lambda-y>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-simulated-dorsal-tract-feather-bud-count> ;
        pk:hasScore "0.46"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


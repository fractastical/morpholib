sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-glimm-avian-feather-bud-hexagonal> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2018-glimm-avian-feather-bud-hexagonal.py L27–L49" ;
        dcterms:description "Linear Keller-Segel + FGF20 dispersion curve and critical chi_c" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py#L27-L49> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Glimm et al. (2014) & Ho et al. (2019) avian feather bud hexagonal array & traveling competence wave — Model fidelity to source: 62/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the linear Keller-Segel + FGF20 dispersion relation (L27-49) and a single 2D dermal chemotaxis + FGF20/BMP4 PDE integration (L52-97), but omits sequential row-by-row phase pinning metrics, simultaneous global competence (v_w -> inf), *scaleless* FGF20-null (chi = 0), and Latrunculin mechanical blockade controls." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2018-glimm-avian-feather-bud-hexagonal.py L52–L97: Single-regime 2D solver without v_w sweep, simultaneous competence, or scaleless/Latrunculin controls <https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py#L52-L97>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity-1> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;

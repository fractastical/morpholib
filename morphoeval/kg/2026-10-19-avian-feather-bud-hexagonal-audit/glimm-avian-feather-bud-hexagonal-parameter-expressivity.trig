sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-glimm-avian-feather-bud-hexagonal> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Glimm et al. (2014) & Ho et al. (2019) avian feather bud hexagonal array & traveling competence wave — Parameter expressivity: 44/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Simulates only one parameter point (v_w = 0.22, chi = 0.24) without sweeping wave speed v_w from row-by-row propagation to simultaneous competence (v_w -> inf), without sweeping chemotactic sensitivity chi across chi_c, and without CLI flags beyond `--self-test` (L169-177)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2018-glimm-avian-feather-bud-hexagonal.py L169–L177: CLI exposes only --self-test without v_w, chi, or perturbation flags <https://github.com/fractastical/morpholib/blob/3cb5ea9/2018-glimm-avian-feather-bud-hexagonal.py#L169-L177>" ;
        pk:hasScore "0.44"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


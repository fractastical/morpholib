    <https://doi.org/10.1016/0092-8674(93)90626-2> dcterms:date "1993"^^xsd:gYear ;
        dcterms:title "Sonic hedgehog mediates the polarizing activity of the ZPA" .

    <https://doi.org/10.1016/S0022-5193(69)80016-0> dcterms:date "1969"^^xsd:gYear ;
        dcterms:title "Positional information and the spatial pattern of cellular differentiation" .


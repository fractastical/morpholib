sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolpert-french-flag-morphogen> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Wolpert (1969) French Flag positional information, Tickle-Wolpert (1975) chick limb ZPA digit duplication & Ben-Zvi-Barkai (2010) scaling — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Sweeps 6 ontogenetic chick limb growth stages (`L = 180..660 um`, HH18-HH28) comparing linear, unscaled SDD, and Expansion-Repression scaled regimes (L214-278); evaluates 4 ZPA experimental regimes including attenuated graft and ZPA ablation negative control (L285-351); sweeps 5 threshold levels `T_i` in a 400-trial Monte Carlo noise ensemble (L358-386); and exposes `--D`, `--k`, `--L`, `--c0`, `--seed`, `--output-png`, and `--output-gif` CLI arguments (L831-855)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L214–L386" ;
        dcterms:description "6-stage growth scaling sweep, 4-regime ZPA experimental suite, and 5-threshold Monte Carlo precision sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1969-wolpert-french-flag-morphogen.py#L214-L386> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L831–L855" ;
        dcterms:description "Full CLI parameter interface wired into render_outputs()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1969-wolpert-french-flag-morphogen.py#L831-L855> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolpert-french-flag-morphogen> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Wolpert (1969) French Flag positional information, Tickle-Wolpert (1975) chick limb ZPA digit duplication & Ben-Zvi-Barkai (2010) scaling — Morphometric validation: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L691-791) computes 8 reference-anchored quantitative morphometrics: (1) SDD decay length `lambda = 63.2456 um` (`RMSE = 7.6e-6`), (2) Expansion-Repression scaled Blue-zone fraction `0.3333` (`CV = 0.0000` vs unscaled `CV = 0.4567`), (3) wild-type chick wing digit count `3` (`4-3-2`), (4) anterior ZPA graft mirror-duplication digit count `6` (`4-3-2-2-3-4`, reflection asymmetry `0.0`), (5) ZPA ablation negative control digit count `0`, (6) positional boundary error Monte Carlo correlation `r = 0.9990`, (7) specimen radial SDD decay length `37.03 px`, and (8) specimen radial SDD goodness-of-fit `r = 0.9963` (`RMSE = 0.0219`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-expansion-repression-scaled-blue-zone-fraction-across-hh18-hh28-l-180-660-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-gallus-gallus-72h-embryo-specimen-radial-sdd-decay-length-lambda-px>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-gallus-gallus-72h-embryo-specimen-radial-sdd-goodness-of-fit-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-positional-boundary-precision-monte-carlo-vs-analytical-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-sdd-characteristic-decay-length-lambda-sqrt-d-k>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-tickle-et-al-1975-anterior-zpa-graft-mirror-duplication-digit-count-4-3-2-2-3-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-tickle-et-al-1975-wild-type-posterior-zpa-chick-wing-digit-count-4-3-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-zpa-ablation-cyclopamine-negative-control-digit-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-morphometric-validation-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-expansion-repression-scaled-blue-zone-fraction-across-hh18-hh28-l-180-660-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Expansion-Repression scaled Blue-zone fraction across HH18-HH28 (L=180..660 um) = 0.3339 fraction" ;
        dcterms:description "ER scaling CV = 0.00000 vs unscaled SDD CV = 0.4470" ;
        schema:measurementTechnique "Mean fractional width x1/L of proximal Blue zone across 6 limb stages under Ben-Zvi & Barkai (2010) expander feedback" ;
        schema:name "Expansion-Repression scaled Blue-zone fraction across HH18-HH28 (L=180..660 um)" ;
        schema:unitText "fraction" ;
        schema:value "0.3339" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-expansion-repression-scaled-blue-zone-fraction-across-hh18-hh28-l-180-660-um-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-expansion-repression-scaled-blue-zone-fraction-across-hh18-hh28-l-180-660-um-reference> a schema:PropertyValue ;
        dcterms:source "Wolpert (1969) J. Theor. Biol. 25:1-47 & Ben-Zvi & Barkai (2010) PNAS 107:6924-6929" ;
        schema:value "0.3333" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-gallus-gallus-72h-embryo-specimen-radial-sdd-decay-length-lambda-px> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gallus gallus 72h embryo specimen radial SDD decay length lambda_px = 37.03 px" ;
        dcterms:description "r1(Blue/White) = 29.6 px, r2(White/Red) = 69.7 px" ;
        schema:measurementTechnique "Nonlinear least-squares fit of c0*exp(-r/lambda)+bg to radial area vasculosa profile around organizer (268, 388)" ;
        schema:name "Gallus gallus 72h embryo specimen radial SDD decay length lambda_px" ;
        schema:unitText "px" ;
        schema:value "37.03" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-gallus-gallus-72h-embryo-specimen-radial-sdd-decay-length-lambda-px-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-gallus-gallus-72h-embryo-specimen-radial-sdd-decay-length-lambda-px-reference> a schema:PropertyValue ;
        dcterms:source "datasets/french_flag_morphogen/french_flag_specimen.jpg (72h HH18-20 Gallus gallus embryo)" ;
        schema:value "37.03" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-gallus-gallus-72h-embryo-specimen-radial-sdd-goodness-of-fit-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gallus gallus 72h embryo specimen radial SDD goodness-of-fit r = 0.9963 r" ;
        dcterms:description "SDD RMSE = 0.0219 (vs linear decay RMSE = 0.1485)" ;
        schema:measurementTechnique "Pearson correlation between measured radial vascular/morphogen profile I(r) and fitted SDD exponential decay" ;
        schema:name "Gallus gallus 72h embryo specimen radial SDD goodness-of-fit r" ;
        schema:unitText "r" ;
        schema:value "0.9963" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-gallus-gallus-72h-embryo-specimen-radial-sdd-goodness-of-fit-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-gallus-gallus-72h-embryo-specimen-radial-sdd-goodness-of-fit-r-reference> a schema:PropertyValue ;
        dcterms:source "datasets/french_flag_morphogen/french_flag_morphogen_reference.json" ;
        schema:value "0.9963" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-positional-boundary-precision-monte-carlo-vs-analytical-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Positional boundary precision Monte Carlo vs analytical correlation r = 0.999 r" ;
        dcterms:description "Mean relative error across 5 thresholds = 2.81%" ;
        schema:measurementTechnique "Pearson correlation between Monte Carlo boundary SD (N=400) and sigma_x = (lambda/T_i)*sigma_c" ;
        schema:name "Positional boundary precision Monte Carlo vs analytical correlation r" ;
        schema:unitText "r" ;
        schema:value "0.999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-positional-boundary-precision-monte-carlo-vs-analytical-correlation-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-positional-boundary-precision-monte-carlo-vs-analytical-correlation-r-reference> a schema:PropertyValue ;
        dcterms:source "Wolpert (1969) J. Theor. Biol. 25:1-47 & Crick (1970) Nature 225:420-422" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-sdd-characteristic-decay-length-lambda-sqrt-d-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "SDD characteristic decay length lambda = sqrt(D/k) = 63.2456 um" ;
        dcterms:description "1D SDD PDE vs analytical cosh steady-state RMSE = 0.000008" ;
        schema:measurementTechnique "Analytical & PDE characteristic decay length sqrt(D/k) for D=10 um^2/s, k=0.0025 s^-1" ;
        schema:name "SDD characteristic decay length lambda = sqrt(D/k)" ;
        schema:unitText "um" ;
        schema:value "63.2456" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-sdd-characteristic-decay-length-lambda-sqrt-d-k-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-sdd-characteristic-decay-length-lambda-sqrt-d-k-reference> a schema:PropertyValue ;
        dcterms:source "Wolpert (1969) J. Theor. Biol. 25:1-47 & Crick (1970) Nature 225:420-422" ;
        schema:value "63.2456" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-tickle-et-al-1975-anterior-zpa-graft-mirror-duplication-digit-count-4-3-2-2-3-4> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Tickle et al. (1975) anterior ZPA graft mirror-duplication digit count (4-3-2-2-3-4) = 6 digits" ;
        dcterms:description "Duplicated sequence: 4-3-2-2-3-4 (symmetry error = 0.0e+00)" ;
        schema:measurementTechnique "Contiguous suprathreshold Shh digit zones under bilateral posterior + anterior ZPA superposition" ;
        schema:name "Tickle et al. (1975) anterior ZPA graft mirror-duplication digit count (4-3-2-2-3-4)" ;
        schema:unitText "digits" ;
        schema:value "6" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-tickle-et-al-1975-anterior-zpa-graft-mirror-duplication-digit-count-4-3-2-2-3-4-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-tickle-et-al-1975-anterior-zpa-graft-mirror-duplication-digit-count-4-3-2-2-3-4-reference> a schema:PropertyValue ;
        dcterms:source "Tickle, Summerbell & Wolpert (1975) Nature 254:199-202 & Riddle et al. (1993) Cell 75:1401-1416" ;
        schema:value "6" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-tickle-et-al-1975-wild-type-posterior-zpa-chick-wing-digit-count-4-3-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Tickle et al. (1975) wild-type posterior ZPA chick wing digit count (4-3-2) = 3 digits" ;
        dcterms:description "Wild-type sequence: 4-3-2" ;
        schema:measurementTechnique "Contiguous suprathreshold Shh digit zones along anteroposterior axis for single posterior ZPA" ;
        schema:name "Tickle et al. (1975) wild-type posterior ZPA chick wing digit count (4-3-2)" ;
        schema:unitText "digits" ;
        schema:value "3" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-tickle-et-al-1975-wild-type-posterior-zpa-chick-wing-digit-count-4-3-2-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-tickle-et-al-1975-wild-type-posterior-zpa-chick-wing-digit-count-4-3-2-reference> a schema:PropertyValue ;
        dcterms:source "Tickle, Summerbell & Wolpert (1975) Nature 254:199-202 Fig. 1" ;
        schema:value "3" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-zpa-ablation-cyclopamine-negative-control-digit-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ZPA ablation / cyclopamine negative control digit count = 0 digits" ;
        dcterms:description "Verifies zero false-positive digit specification in absence of ZPA morphogen" ;
        schema:measurementTechnique "Suprathreshold digit territories when posterior and anterior Shh sources are ablated (c=0)" ;
        schema:name "ZPA ablation / cyclopamine negative control digit count" ;
        schema:unitText "digits" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-zpa-ablation-cyclopamine-negative-control-digit-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-zpa-ablation-cyclopamine-negative-control-digit-count-reference> a schema:PropertyValue ;
        dcterms:source "Tickle, Summerbell & Wolpert (1975) Nature 254:199-202 ZPA excision control" ;
        schema:value "0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L691–L791" ;

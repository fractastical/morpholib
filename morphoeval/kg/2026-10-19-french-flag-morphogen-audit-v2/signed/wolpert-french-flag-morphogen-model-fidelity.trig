sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolpert-french-flag-morphogen> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L110–L210" ;
        dcterms:description "Linear source-sink, analytical SDD, and 1D SDD PDE solver with zero-flux and bilateral Dirichlet BCs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1969-wolpert-french-flag-morphogen.py#L110-L210> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L214–L351" ;
        dcterms:description "Ben-Zvi & Barkai (2010) Expansion-Repression scaling and Tickle et al. (1975) 4-regime ZPA digit duplication" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1969-wolpert-french-flag-morphogen.py#L214-L351> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_011_french_flag_morphogen.lean L21–L130" ;
        dcterms:description "5 machine-checked Lean 4 theorems for linear scaling, SDD balance, ablation quiescence, ZPA mirror symmetry, and ER invariance" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/morphoeval/lean/loops/Loop_011_french_flag_morphogen.lean#L21-L130> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Wolpert (1969) French Flag positional information, Tickle-Wolpert (1975) chick limb ZPA digit duplication & Ben-Zvi-Barkai (2010) scaling — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements Wolpert's (1969) linear source-sink diffusion `c_lin(x) = c0*(1 - x/L)` (L110-114), semi-infinite and finite-domain no-flux SDD analytical solutions plus explicit time-dependent SDD PDE relaxation `dc/dt = D d^2c/dx^2 - k c` (L117-189, RMSE = 7.6e-6), Ben-Zvi & Barkai (2010) Expansion-Repression dynamic scaling feedback across growing domains (L214-278), Tickle et al. (1975) ZPA graft superposition and ablation control (L285-351), and Crick (1970) positional noise propagation (L358-386), backed by 5 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_011_french_flag_morphogen.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


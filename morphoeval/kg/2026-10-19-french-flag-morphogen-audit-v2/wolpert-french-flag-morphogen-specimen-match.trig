    <https://doi.org/10.1016/0092-8674(93)90626-2> dct:date "1993"^^xsd:gYear ;
        dct:title "Sonic hedgehog mediates the polarizing activity of the ZPA" .
    <https://doi.org/10.1016/S0022-5193(69)80016-0> dct:date "1969"^^xsd:gYear ;
        dct:title "Positional information and the spatial pattern of cellular differentiation" .
    <https://doi.org/10.1038/225420a0> dct:date "1970"^^xsd:gYear ;
        dct:title "Diffusion in embryogenesis" .
    <https://doi.org/10.1038/254199a0> dct:date "1975"^^xsd:gYear ;

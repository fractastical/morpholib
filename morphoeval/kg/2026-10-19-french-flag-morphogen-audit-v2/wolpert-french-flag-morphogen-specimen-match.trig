sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolpert-french-flag-morphogen> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Wolpert (1969) French Flag positional information, Tickle-Wolpert (1975) chick limb ZPA digit duplication & Ben-Zvi-Barkai (2010) scaling — Morphological realism / specimen match: 88/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Segments the SHA-256-verified 72h HH18-20 `Gallus gallus domesticus` embryo specimen (`datasets/french_flag_morphogen/french_flag_specimen.jpg`, CC BY 4.0) in `segment_gallus_embryo_specimen` (L393-471), detecting the embryonic organizer center `(268, 388)`, extracting the radial vascular/morphogen-response optical density profile `I(r)` across `r in [0, 220] px`, fitting the SDD exponential decay (`lambda = 37.03 px, r = 0.9963, RMSE = 0.0219` vs linear decay `RMSE = 0.1485`), and mapping concentric Blue/White/Red French-Flag rings onto the specimen (Panels E-F). Also matches empirical chick wing digit counts (`3` wild-type `4-3-2`, `6` duplicated `4-3-2-2-3-4`, `4` attenuated `4-3-2-3`, `0` ZPA-ablated)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-specimen-match-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L393–L471" ;
        dct:description "Automated blastoderm ROI, organizer detection, radial SDD curve fit (r=0.9963), and 3-zone French-Flag segmentation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1969-wolpert-french-flag-morphogen.py#L393-L471> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/french_flag_morphogen_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure including specimen segmentation (Panel E) and radial SDD vs linear fit (Panel F) — docs/media/french_flag_morphogen_comparison.png: rendered output of 1969-wolpert-french-flag-morphogen.py at b9976f8, image/png, 1006934 B, 2880×1792 px, artifact_sha256 672a47196c76f705489d6663b7854c345234f2bc41470fbf74c72f65c28c8b6d (sha256 672a47196c76f705489d6663b7854c345234f2bc41470fbf74c72f65c28c8b6d), spec_fingerprint 8c772d71b75bec8f158cb37c09ad0b582febd6312d060c187ac44cf5cbb1bf84" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


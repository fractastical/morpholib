sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-douady-magnetic-drop-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Douady & Couder (1992, 1996) self-organized magnetic-drop phyllotaxis & imperfect pitchfork cascade — Code-to-model traceability: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring (L1-93) maps every section, including the Pass 3 additions, to PRL 1992 Eqs. (1)-(3) and Fig. 3, JTB 1996 Part I Secs. 2-4, Levitov (1991) and Lean 4 Theorems 1-5; each new function documents its equation and the v2 defect it replaces (`measure_emergent_pitchfork_threshold`, `extract_contact_parastichy_pair`, `log_polar_spiral_spectrum`, `invert_reciprocal_lattice_peaks`), and the inline comments at the remediated sites name the removed clamps and the clipped g_vis. Deductions: the dynamical discriminant S_dyn is attributed to 'JTB 1996 Part I Sec. 3.1' without an equation number, and the k-weighting is derived in-house rather than quoted (L283-297) (-4); the reciprocal-lattice relation is attributed to 'Sec. 4 van Iterson lattice' generically (L902-915) (-2); Row B's log-radial projection is justified in a comment but not tied to a specific D&C figure convention (L672-676) (-2); panel-building code (L1215-1575) cites figures only in titles (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1992-douady-magnetic-drop-phyllotaxis.py L283–L297: dynamical_pitchfork_discriminant_sum docstring cites JTB 1996 Part I Sec. 3.1 but the derivation is in-house (no equation number) <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L283-L297>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-code-traceability-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L1–L93" ;
        dct:description "Module docstring: sections 1-5 with equations, thresholds, Lean theorem names and the Pass 3 remediation list" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L1-L93> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L539–L548" ;
        dct:description "Contact-pair docstring cites PRL 1992 Fig. 2 caption and JTB 1996 Part I Sec. 4 nearest-neighbour definition" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L539-L548> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L665–L676" ;
        dct:description "Inline comments naming the removed v2 clipping and the rho = 1 + ln(r/R0) = 1 + kG identity with PRL 1992 Eq. (1)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L665-L676> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


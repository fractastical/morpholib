sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-douady-magnetic-drop-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "datasets/magnetic_drop_phyllotaxis/README.md L22–L47" ;
        dcterms:description "Pass 3 errata for the pinned table, specimen inversion table and van Iterson (1907) reference" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/magnetic_drop_phyllotaxis/README.md#L22-L47> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/magnetic_drop_phyllotaxis/paper_citations.bib L1–L43" ;
        dcterms:description "BibTeX with DOIs for the four primary sources (SHA-pinned; van Iterson not yet included)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/magnetic_drop_phyllotaxis/paper_citations.bib#L1-L43> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/douady-magnetic-drop-phyllotaxis.yaml L1–L107" ;
        dcterms:description "Five equations with Lean declarations, theorem names, loci, renamed G_fold / G_c1 constants and pass3 block" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/douady-magnetic-drop-phyllotaxis.yaml#L1-L107> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Douady & Couder (1992, 1996) self-organized magnetic-drop phyllotaxis & imperfect pitchfork cascade — Source and data traceability: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "DOIs for Douady & Couder (1992, 1996a, 1996b) and Levitov (1991) are in the script docstring, the dataset README, the SHA-pinned `paper_citations.bib` and the reference JSON; the specimen is vendored with Wikimedia URL, author, licence and SHA-256; the math KG entry maps five equations to five Lean theorems with line loci. Deductions exposed by Pass 3: the SHA-pinned reference JSON names the static fold roots `two_drop_exponential_G_c1` / `full_chain_exponential_G_c1` (0.7735 / 0.7725) although they are not the dynamical pitchfork threshold, and this could only be corrected in the README errata, not in the pinned file (-4); its `experimental_regimes[].mean_divergence_deg` and `detected_scale_umbos_count: 123` have no quantified provenance (figure readings; detections not scales) (-3); van Iterson (1907), now relied on for Theorem 5 and the inversion's winding integers, is cited in the README, the math KG and this audit but not in the pinned .bib (-2); the (5,8) regime G range 0.04-0.10 used as the specimen reference comes from the Pass-2-authored table rather than from a page/figure pinpoint in the papers (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/magnetic_drop_phyllotaxis/magnetic_drop_phyllotaxis_reference.json L109–L125: experimental_regimes rows with G_exp, observed pairs and mean divergence: figure-level readings of PRL Figs. 1-2, no uncertainties <https://github.com/fractastical/morpholib/blob/d58a084/datasets/magnetic_drop_phyllotaxis/magnetic_drop_phyllotaxis_reference.json#L109-L125>",
            "datasets/magnetic_drop_phyllotaxis/magnetic_drop_phyllotaxis_reference.json L65–L86: Keys two_drop_exponential_G_c1 / full_chain_*_G_c1 hold the STATIC fold roots (0.7735, 0.7725, 2.5146, 2.5142), not G_c1 — mislabel in the pinned table <https://github.com/fractastical/morpholib/blob/d58a084/datasets/magnetic_drop_phyllotaxis/magnetic_drop_phyllotaxis_reference.json#L65-L86>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-source-traceability-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


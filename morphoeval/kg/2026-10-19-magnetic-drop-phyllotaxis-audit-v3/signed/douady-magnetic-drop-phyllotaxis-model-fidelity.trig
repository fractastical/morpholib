sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-douady-magnetic-drop-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L172–L256" ;
        dcterms:description "advected_radii, dipole_energy_grid and step_magnetic_drop: PRL 1992 Eqs. (1)-(3) with bounded Brent refinement" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L172-L256> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L263–L344" ;
        dcterms:description "Static C(r1,r2) and dynamical D(r1,r2) integer discriminants, full-chain S_dyn(G), and the eight fold / pitchfork roots" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L263-L344> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L347–L398" ;
        dcterms:description "measure_emergent_pitchfork_threshold: bisection on the unclamped iterated map; no imposed 180-deg state" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L347-L398> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L539–L577" ;
        dcterms:description "extract_contact_parastichy_pair: Douady & Couder nearest-neighbour definition on true simulated positions, modal pair + frequency" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L539-L577> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L665–L689" ;
        dcterms:description "True radii r_k = exp(kG) triangulated (v2 clipped g_vis removed); opposition classified from the emergent divergence" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L665-L689> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-6> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_031_magnetic_drop_phyllotaxis.lean L138–L160" ;
        dcterms:description "Theorem 4 dynamical_pitchfork_discriminant: D(4,7) = -12646 < 0, D(5,9) = 23872 > 0 with C(4,7) > 0 (lean: 0 errors, 0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_031_magnetic_drop_phyllotaxis.lean#L138-L160> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Douady & Couder (1992, 1996) self-organized magnetic-drop phyllotaxis & imperfect pitchfork cascade — Model fidelity to source: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The iterated rule phi_n = argmin E(phi) with E = sum_k d_k^{-gamma}, both advection laws, and the exact chord distance (L172-256) are Douady & Couder's Eqs. (1)-(3). Pass 3 removed the three hard-coded 180-deg short-circuits so the bifurcation is emergent (L347-398, L446-454, L722-742) and the measured threshold agrees with the analytic root of S_dyn(G) to 4.5e-4 (self-test 3); the two-drop integer form of S_dyn is machine-checked (Lean 4 Theorem 4, D(4,7) = -12646 < 0 < C(4,7) = 27687) and proves the static-fold / dynamical-threshold gap that v2 conflated in its measurement names. Contact parastichies now follow the authors' nearest-neighbour definition on the true radii (L539-577, L665-689). Deductions: the spiral branches of the equilibrium diagram are still labelled stable/unstable by the static Hessian sign while the 180-deg branch uses the dynamical criterion, a mixed criterion (L446-476) (-3); the memory depth N_mem = 45 is an ad-hoc truncation rather than the dish exit radius R_max/R_0 = 8 of the experiment (L610-620) (-2); the emergent threshold carries a +4.5e-4 finite-iteration bias (160 iterations, 0.5 deg criterion) that is tolerated rather than extrapolated (L347-398) (-1); the Delaunay census is kept as a secondary extractor although it disagrees with the contact pair at four transition rows (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1992-douady-magnetic-drop-phyllotaxis.py L446–L476: Equilibrium diagram: 180-deg branch stability from sign of S_dyn (computed), spiral branches still from the static Hessian sign — mixed criterion <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L446-L476>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-model-fidelity-6> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-douady-magnetic-drop-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Douady & Couder (1992, 1996) self-organized magnetic-drop phyllotaxis & imperfect pitchfork cascade — Morphological realism / specimen match: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Row B now shows four visually distinct lattices in the dish geometry rho = 1 + kG with the contact parastichy families drawn from the true-geometry triangulation (L1338-1367): a distichous row, a (2,3) star, a (5,8) cone-top web and a (4,7) Lucas web, instead of the v2 panels that collapsed to a line or to a few outer drops. The specimen comparison is quantitative at the lattice level: the (5,8) FFT pair (C3), the inverted alpha_emp = 138.03 deg / G_emp = 0.031 lattice overlaid on the log-polar unwrapping (C2, L1382-1411) and placed in (G, alpha) space against the model branch (D4, L1491-1510), with the inversion validated on the simulated lattice (L1011-1034). Deductions: no overlay of the inverted lattice or of a synthetic cone on the photograph itself — C1 and B3 are compared across panels, not side by side in image coordinates (-4); the DoG detections drawn in C1 over-count scales by ~2x and are now labelled 'detections' but still read as a segmentation to a viewer (-3); Douady & Couder's own dish photographs (PRL Fig. 2) and bifurcation diagram (Fig. 3) are not vendored or digitised, so the Row B lattices are not judged against the authors' figures (-3); a single specimen photograph of a single species (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1992-douady-magnetic-drop-phyllotaxis.py L1491–L1510: Panel D4: specimen (G, alpha) point vs model Fibonacci branch, benchmark table and inversion check — comparison is in parameter space, not overlaid on the photograph <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L1491-L1510>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match-4> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L1338–L1367" ;
        dct:description "Row B dish panels in rho = 1 + ln(r/R0) geometry with contact-pair edges from the true triangulation; four distinct morphologies visible" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L1338-L1367> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L1037–L1161" ;
        dct:description "segment_conifer_cone_specimen: DoG detections, log-polar unwrapping, padded spectrum, (5,8) inversion, closure residual, rank-sequence and radial-law diagnostics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L1037-L1161> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L1382–L1411" ;
        dct:description "Panel C2 overlays the parastichy lines of the FITTED (alpha_emp, G_emp) lattice on the specimen's log-polar image" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L1382-L1411> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "datasets/magnetic_drop_phyllotaxis/README.md L22–L47" ;
        dct:description "Pass 3 errata: N=123 are detections (~48 lattice-consistent scales), specimen inversion table, chirality and radial-law caveats" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/magnetic_drop_phyllotaxis/README.md#L22-L47> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-douady-magnetic-drop-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Douady & Couder (1992, 1996) self-organized magnetic-drop phyllotaxis & imperfect pitchfork cascade — Morphometric validation: 89/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Eighteen measurements (L1581-1738) now carry provenance-tagged references: Fibonacci branch r = 0.99999 / RMSE 0.065 deg against the 10 benchmark rows with 9/10 contact pairs; Lucas 101.43 deg at the G = 0.10 table row (v2 compared G = 0.11 to the asymptote); static fold and dynamical G_c1 separated, with the analytic root checked against the emergent threshold; dish-regime RMSE 0.141 deg and 6/6 pairs; N_mem convergence index; and three specimen-level morphometrics — alpha_emp = 138.03 deg vs 137.508, G_emp = 0.0308 vs the 0.06 model regime, and the linear-vs-exponential radial-law R^2 gap — plus the disclosed negative result that radius-ranked detections give resultant R = 0.137. Deductions: the dish-regime 'observed' divergences are regime-level readings of PRL Figs. 1-2 with no uncertainties, so that RMSE is a weak validation (-4); the reference for the specimen's G is the model's own (5,8) regime value, and the measured 0.031 differs from it by 2x because the cone's radial law is linear, which is explained but not resolved (-3); the Voronoi CV reference is the theoretical 0 of a perfect lattice, not a measured value (-2); only one specimen contributes empirical morphometrics (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1992-douady-magnetic-drop-phyllotaxis.py L1668–L1674: ferrofluid_experiment_divergence_rmse_deg compares against table values whose provenance is a figure reading without uncertainties <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L1668-L1674>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-lattice-divergence-angle-deg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-lattice-plastochron-ratio-g>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-radial-law-r2-linear-minus-exponential>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-rank-sequence-resultant-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-specimen-ccw-parastichy-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-specimen-cw-parastichy-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-dynamical-pitchfork-g-c1-exponential-full-chain>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-ferrofluid-experiment-divergence-rmse-deg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-bifurcation-branch-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-branch-parastichy-pair-matches-of-10>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-divergence-angle-g006-exp>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-fibonacci-divergence-angle-g006-linear-dish>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-lucas-branch-divergence-angle-g010>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-memory-ablation-control-nmem1-divergence-deg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-memory-depth-nmem-for-convergence-within-0p5deg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-static-fold-threshold-g-fold-exponential-2drop>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-static-fold-threshold-g-fold-linear-2drop>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-voronoi-area-cv-dipole-vs-random-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-morphometric-validation-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-morphometric-validation-4> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-lattice-divergence-angle-deg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "conifer_cone_lattice_divergence_angle_deg = 138.031 deg" ;
        schema:measurementTechnique "Reciprocal-lattice inversion of the sub-bin (5,8) log-polar FFT peaks omega_5=-16.93, omega_8=13.75 rad/u (5a+w5 G=4pi, 8a+w8 G=6pi); inversion recovers the simulated G=0.06 lattice to 0.014 deg; Lean 4 Theorem 5 window 135-138.46 deg" ;
        schema:name "conifer_cone_lattice_divergence_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "138.031" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-lattice-divergence-angle-deg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-lattice-divergence-angle-deg-reference> a schema:PropertyValue ;
        schema:value "137.5078" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-lattice-plastochron-ratio-g> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "conifer_cone_lattice_plastochron_ratio_G = 0.0308 dimensionless" ;
        schema:measurementTechnique "Plastochron ratio of the specimen from the same (5,8) inversion (chirality -1); reference = model (5,8) regime G=0.06 (table spans 0.04-0.10 for (5,8)); rank-count estimate Delta_u/N_det = 0.0142 is biased low by DoG over-detection; inversion recovers sim G=0.06 to 0.06%" ;
        schema:name "conifer_cone_lattice_plastochron_ratio_G" ;
        schema:unitText "dimensionless" ;
        schema:value "0.0308" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-lattice-plastochron-ratio-g-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-lattice-plastochron-ratio-g-reference> a schema:PropertyValue ;
        schema:value "0.06" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-radial-law-r2-linear-minus-exponential> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "conifer_cone_radial_law_R2_linear_minus_exponential = 0.0781 delta_R2" ;
        schema:measurementTechnique "R^2(linear r vs rank) - R^2(ln r vs rank) over 104 annulus detections = 0.977 - 0.899; > 0 means the mature cone's apparent radial law is closer to the dish's linear advection than to exponential meristem growth (transfer-boundary diagnostic; reference 0 = indifferent)" ;
        schema:name "conifer_cone_radial_law_R2_linear_minus_exponential" ;
        schema:unitText "delta_R2" ;
        schema:value "0.0781" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-radial-law-r2-linear-minus-exponential-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-radial-law-r2-linear-minus-exponential-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-rank-sequence-resultant-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "conifer_cone_rank_sequence_resultant_R = 0.1369 R" ;
        schema:measurementTechnique "Circular mean resultant length of successive azimuth differences of radius-ranked DoG detections; 1 = clean 137.5 deg generative sequence. Disclosed negative result: rank ordering of a mature cone photo does not recover the divergence sequence, so the lattice claim rests on the FFT inversion" ;
        schema:name "conifer_cone_rank_sequence_resultant_R" ;
        schema:unitText "R" ;
        schema:value "0.1369" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-rank-sequence-resultant-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-conifer-cone-rank-sequence-resultant-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-dynamical-pitchfork-g-c1-exponential-full-chain> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dynamical_pitchfork_G_c1_exponential_full_chain = 0.859019 dimensionless" ;
        schema:measurementTechnique "Root of S_dyn(G) = sum_k (-1)^(k-1) k r_k/(r_k-(-1)^k)^5 (M=60) vs the EMERGENT threshold of the unclamped iterated map (bisection bracket [0.85941, 0.85953], |error|=4.54e-04); linear-advection 2-drop analogue bracketed by Lean 4 Theorem 4 (D(4,7) < 0 < D(5,9))" ;
        schema:name "dynamical_pitchfork_G_c1_exponential_full_chain" ;
        schema:unitText "dimensionless" ;
        schema:value "0.859019" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-measurement-dynamical-pitchfork-g-c1-exponential-full-chain-reference> .

    <https://doi.org/10.1006/jtbi.1996.0024> dct:date "1996"^^xsd:gYear ;
        dct:title "Phyllotaxis as a Dynamical Self Organizing Process Part I: The Spiral Modes Resulting from Time-Periodic Iterations" .
    <https://doi.org/10.1006/jtbi.1996.0025> dct:date "1996"^^xsd:gYear ;
        dct:title "Phyllotaxis as a Dynamical Self Organizing Process Part II: The Spontaneous Formation of a Periodicity and the Coexistence of Spiral and Whorled Modes" .
    <https://doi.org/10.1103/PhysRevLett.68.2098> dct:date "1992"^^xsd:gYear ;

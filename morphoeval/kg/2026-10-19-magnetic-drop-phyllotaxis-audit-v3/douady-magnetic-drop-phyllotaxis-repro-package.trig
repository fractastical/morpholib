sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-douady-magnetic-drop-phyllotaxis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-douady-magnetic-drop-phyllotaxis-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Douady & Couder (1992, 1996) self-organized magnetic-drop phyllotaxis & imperfect pitchfork cascade — Reproducibility package: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "All three dataset files are SHA-256 verified at every run (L123-158); the 14-check `--self-test` (L1745-1844) covers Lean parity for Theorems 2 and 4, the emergent threshold, unclamped ramps, contact pairs, sweeps, dish regimes, specimen FFT, inversion validation, the disclosed negative result and a bitwise two-run determinism check; runtime is 6.9 s (self-test) / 15 s (full render) on the recorded environment; seeds are fixed (1992) and the GIF is produced by the default invocation. Deductions: no script-level requirements lock (the audit records versions, the repo has only a shared requirements.txt) (-3); the matplotlib font-cache warning when MPLCONFIGDIR is unwritable is not handled or documented (-2); the rendered PNG/GIF are not pinned by SHA in the script or README, only by the measurements file (-2); the bisection's run-to-run determinism is covered by the fixed-G determinism check only indirectly (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-repro-package-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L123–L158" ;
        dct:description "EXPECTED_SHA256 and verify_dataset_integrity() locking all 3 dataset files at runtime" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L123-L158> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L1745–L1844" ;
        dct:description "run_self_test: 14 checks including emergent-threshold, true-radius pairs, inversion validation and bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L1745-L1844> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-douady-magnetic-drop-phyllotaxis-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "1992-douady-magnetic-drop-phyllotaxis.py L1847–L1885" ;
        dct:description "CLI entrypoint; default invocation renders PNG + GIF after running the self-test" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1992-douady-magnetic-drop-phyllotaxis.py#L1847-L1885> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1996.0024>,
            <https://doi.org/10.1006/jtbi.1996.0025>,
            <https://doi.org/10.1103/PhysRevLett.68.2098>,
            <https://doi.org/10.1209/0295-5075/14/6/006>,
            <https://www.biodiversitylibrary.org/bibliography/9466> .
    <https://doi.org/10.1006/jtbi.1996.0024> dct:date "1996"^^xsd:gYear ;
        dct:title "Phyllotaxis as a Dynamical Self Organizing Process Part I: The Spiral Modes Resulting from Time-Periodic Iterations" .
    <https://doi.org/10.1006/jtbi.1996.0025> dct:date "1996"^^xsd:gYear ;
        dct:title "Phyllotaxis as a Dynamical Self Organizing Process Part II: The Spontaneous Formation of a Periodicity and the Coexistence of Spiral and Whorled Modes" .
    <https://doi.org/10.1103/PhysRevLett.68.2098> dct:date "1992"^^xsd:gYear ;
        dct:title "Phyllotaxis as a physical self-organized growth process" .
    <https://doi.org/10.1209/0295-5075/14/6/006> dct:date "1991"^^xsd:gYear ;
        dct:title "Energetic Approach to Phyllotaxis" .
    <https://www.biodiversitylibrary.org/bibliography/9466> dct:date "1907"^^xsd:gYear ;
        dct:title "Mathematische und mikroskopisch-anatomische Studien über Blattstellungen, nebst Betrachtungen über den Schalenbau der Miliolinen" .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tozluoglu-wing-disc-dome-folding> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Tozluoglu et al. (2019) Dev. Cell & Sui et al. (2018) Nat. Commun. Drosophila wing imaginal disc planar differential growth, basal ECM dome & H/N, H/H, H/P hinge folding — Morphological realism / specimen match: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 2.5 third-instar Drosophila wing imaginal disc micrograph `datasets/wing_disc_dome_folding/drosophila_wing_disc_specimen.jpg`, segments all 3 wing discs and the proximal-distal reporter axis (`segment_wing_disc_specimen`, L563-654) to extract empirical fold boundary coordinates s_HN = 0.2664, s_HH = 0.3910 (ref 0.39), s_HP = 0.5190 (mean error = 0.0028), and wing pouch dome zone fraction = 0.4810 (ref 0.48)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-specimen-match-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2020-tozluoglu-wing-disc-dome-folding.py L563–L654" ;
        dct:description "CV segmentation of 3 Drosophila wing discs, pouch/hinge/notum zones, and H/N, H/H, H/P fold loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2020-tozluoglu-wing-disc-dome-folding.py#L563-L654> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/wing_disc_dome_folding_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing growth profile g(s), sagittal bilayer cross-sections, 64-96h timecourse, perturbations, and wing disc specimen CV segmentation — docs/media/wing_disc_dome_folding_comparison.png: rendered output of 2020-tozluoglu-wing-disc-dome-folding.py at e93f00e, image/png, 605395 B, 2141×1432 px, artifact_sha256 e116a8b585784bc50754c7764a7cb4b05e079f5194b2ef268a9c9e4041730861 (sha256 e116a8b585784bc50754c7764a7cb4b05e079f5194b2ef268a9c9e4041730861), spec_fingerprint bcd73f8cd05a798cd28d5d8699091decf2998046dc76356ac2ad3f948db43ac8" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 049 Pass 2 Assessor)" ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tozluoglu-wing-disc-dome-folding> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Tozluoglu et al. (2019) Dev. Cell & Sui et al. (2018) Nat. Commun. Drosophila wing imaginal disc planar differential growth, basal ECM dome & H/N, H/H, H/P hinge folding — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements Tozluoglu et al.'s (2019) Dev. Cell and Sui et al.'s (2018) Nat. Commun. bilayer pouch dome curvature law (L118-137), heterogeneous vs uniform planar differential growth rate profile g(s) and second derivative g''(s) > 0 at H/N, H/H, and H/P troughs (L140-180), L-BFGS-B 2D sagittal apico-basal bilayer morphoelastic energy minimization (L184-386), and all 5 perturbations (L487-557), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_049_wing_disc_dome_folding.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2020-tozluoglu-wing-disc-dome-folding.py L118–L180" ;
        dct:description "Bilayer pouch dome curvature law and planar differential growth profile g(s) with H/N, H/H, and H/P troughs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2020-tozluoglu-wing-disc-dome-folding.py#L118-L180> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2020-tozluoglu-wing-disc-dome-folding.py L184–L386" ;
        dct:description "L-BFGS-B 2D sagittal apico-basal bilayer morphoelastic solver across 64h-96h AEL and perturbations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2020-tozluoglu-wing-disc-dome-folding.py#L184-L386> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_049_wing_disc_dome_folding.lean L14–L157" ;
        dct:description "3 machine-checked Lean 4 theorems for bilayer dome curvature, fold trough pinning vs uniform buckling, and Collagenase ECM ablation collapse (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_049_wing_disc_dome_folding.lean#L14-L157> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 049 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


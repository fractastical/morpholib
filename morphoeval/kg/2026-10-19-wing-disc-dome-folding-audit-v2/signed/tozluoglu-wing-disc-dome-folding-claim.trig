sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tozluoglu-wing-disc-dome-folding> a pk:Claim ;
        rdfs:label "Tozluoglu et al. (2019) Dev. Cell & Sui et al. (2018) Nat. Commun. Drosophila wing imaginal disc planar differential growth, basal ECM dome & H/N, H/H, H/P hinge folding faithfully reproduces Drosophila melanogaster (third-instar larval wing imaginal disc, 64h-96h AEL) morphology" ;
        dcterms:description "The simulation script(s) 2020-tozluoglu-wing-disc-dome-folding.py implement the cited source model as published and produce forms that match real Drosophila melanogaster (third-instar larval wing imaginal disc, 64h-96h AEL) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 93.7/100, audit 2026-10-19-wing-disc-dome-folding-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/e93f00e/2020-tozluoglu-wing-disc-dome-folding.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/e93f00e/2020-tozluoglu-wing-disc-dome-folding.py; output: docs/media/wing_disc_dome_folding_comparison.png; organism: Drosophila melanogaster (third-instar larval wing imaginal disc, 64h-96h AEL); checkpoint commit: https://github.com/fractastical/morpholib/commit/e93f00e; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: bcd73f8cd05a798cd28d5d8699091decf2998046dc76356ac2ad3f948db43ac8; artifact_sha256: e116a8b585784bc50754c7764a7cb4b05e079f5194b2ef268a9c9e4041730861; input_dataset_sha256: {datasets/wing_disc_dome_folding/drosophila_wing_disc_specimen.jpg=b523296d0ee292e1..., datasets/wing_disc_dome_folding/scout_manifest.json=0f2a2d1d54a8d262..., datasets/wing_disc_dome_folding/wing_disc_dome_folding_reference.json=c4c99a6cca181df7...}; supersedes_audit_id: 2026-10-19-wing-disc-dome-folding-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.devcel.2019.09.009>,

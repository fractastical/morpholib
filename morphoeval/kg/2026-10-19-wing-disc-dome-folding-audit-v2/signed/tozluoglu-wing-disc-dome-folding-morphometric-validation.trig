sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tozluoglu-wing-disc-dome-folding> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Tozluoglu et al. (2019) Dev. Cell & Sui et al. (2018) Nat. Commun. Drosophila wing imaginal disc planar differential growth, basal ECM dome & H/N, H/H, H/P hinge folding — Morphometric validation: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L669-759) computes 8 reference-anchored morphometric measurements: 64h-96h pouch dome elevation Pearson r = 0.9984 (RMSE = 1.13 um), 15-point H/N, H/H, and H/P fold depth Pearson r = 0.9952 (RMSE = 0.72 um), 7-zone spatial curvature Pearson r = 1.0000, mature 96 h wild-type d_HH = 19.40 um (ref 19.4 um), Collagenase ECM ablation dome curvature = 0.0 um^-1 (ref 0.0), uniform-growth unpinned positional SD = 0.1404 (ref 0.142), specimen segmented s_HH/L = 0.3910 (ref 0.39), and specimen pouch dome zone fraction = 0.4810 (ref 0.48)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-15-point-h-n-h-h-and-h-p-fold-depth-developmental-correlation-64h-96h-ael>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-64h-96h-ael-pouch-dome-elevation-trajectory-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-7-zone-spatial-curvature-correlation-across-notum-hinge-ridges-fold-troughs-and-pouch-dome>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-collagenase-vkg-rnai-basal-ecm-ablation-pouch-dome-curvature-kappa-dome>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-mature-96-h-ael-wild-type-central-h-h-fold-depth-d-hh>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-specimen-cv-segmented-h-h-fold-normalized-position-s-hh-l-drosophila-wing-disc-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-specimen-cv-segmented-wing-pouch-dome-zone-fraction-1-s-hp-l>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-uniform-proliferation-unpinned-buckling-positional-standard-deviation-sigma-s-l>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-15-point-h-n-h-h-and-h-p-fold-depth-developmental-correlation-64h-96h-ael> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "15-point H/N, H/H, and H/P fold depth developmental correlation (64h-96h AEL) = 0.9952 Pearson r" ;
        dcterms:description "RMSE = 0.93 um" ;
        schema:measurementTechnique "L-BFGS-B simulated H/N, H/H, and H/P apical cleft depths vs observed depths across 5 stages x 3 folds (n=15, p=1.55e-14, RMSE=0.93 um)" ;
        schema:name "15-point H/N, H/H, and H/P fold depth developmental correlation (64h-96h AEL)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9952" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-15-point-h-n-h-h-and-h-p-fold-depth-developmental-correlation-64h-96h-ael-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-15-point-h-n-h-h-and-h-p-fold-depth-developmental-correlation-64h-96h-ael-reference> a schema:PropertyValue ;
        dcterms:source "Tozluoglu et al. (2019) Dev. Cell 51(3):299-312.e4 Figs. 1-2 & Sui et al. (2018) Nat. Commun. 9:4620" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-64h-96h-ael-pouch-dome-elevation-trajectory-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "64h-96h AEL pouch dome elevation trajectory correlation = 0.9984 Pearson r" ;
        dcterms:description "RMSE = 1.13 um, p = 7.72e-05" ;
        schema:measurementTechnique "L-BFGS-B sagittal bilayer dome elevation vs published 64h-96h AEL trajectory across 5 stages (p=7.72e-05, RMSE=1.13 um)" ;
        schema:name "64h-96h AEL pouch dome elevation trajectory correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9984" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-64h-96h-ael-pouch-dome-elevation-trajectory-correlation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-64h-96h-ael-pouch-dome-elevation-trajectory-correlation-reference> a schema:PropertyValue ;
        dcterms:source "Tozluoglu et al. (2019) Dev. Cell 51(3):299-312.e4 Fig. 1" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-7-zone-spatial-curvature-correlation-across-notum-hinge-ridges-fold-troughs-and-pouch-dome> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "7-zone spatial curvature correlation across notum, hinge ridges, fold troughs, and pouch dome = 1.0 Pearson r" ;
        dcterms:description "RMSE = 0.00017 um^-1" ;
        schema:measurementTechnique "Linear regression of 96h AEL local curvature kappa(s) across all 7 wing disc zones (p=4.24e-12, RMSE=0.00017 um^-1)" ;
        schema:name "7-zone spatial curvature correlation across notum, hinge ridges, fold troughs, and pouch dome" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-7-zone-spatial-curvature-correlation-across-notum-hinge-ridges-fold-troughs-and-pouch-dome-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-7-zone-spatial-curvature-correlation-across-notum-hinge-ridges-fold-troughs-and-pouch-dome-reference> a schema:PropertyValue ;
        dcterms:source "Tozluoglu et al. (2019) Dev. Cell 51(3):299-312.e4 Fig. 3" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-collagenase-vkg-rnai-basal-ecm-ablation-pouch-dome-curvature-kappa-dome> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Collagenase / vkg-RNAi basal ECM ablation pouch dome curvature kappa_dome = 0.0 um^-1" ;
        dcterms:description "WT kappa_dome = 0.0128 um^-1, JAK/STAT d_HH = 25.6 um" ;
        schema:measurementTechnique "Bilayer dome curvature under Collagenase / viking-RNAi basement membrane digestion (mu_BM = 0 kPa)" ;
        schema:name "Collagenase / vkg-RNAi basal ECM ablation pouch dome curvature kappa_dome" ;
        schema:unitText "um^-1" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-collagenase-vkg-rnai-basal-ecm-ablation-pouch-dome-curvature-kappa-dome-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-collagenase-vkg-rnai-basal-ecm-ablation-pouch-dome-curvature-kappa-dome-reference> a schema:PropertyValue ;
        dcterms:source "Tozluoglu et al. (2019) Dev. Cell 51(3):299-312.e4 Fig. 4 (Collagenase flattens dome and abolishes folds)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-mature-96-h-ael-wild-type-central-h-h-fold-depth-d-hh> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Mature 96 h AEL wild-type central H/H fold depth d_HH = 19.65 um" ;
        dcterms:description "d_HN = 14.8 um, d_HH = 19.7 um, d_HP = 16.3 um" ;
        schema:measurementTechnique "L-BFGS-B relaxed apical cleft depth at s_HH/L = 0.39 under WT differential growth + basal ECM + local remodeling" ;
        schema:name "Mature 96 h AEL wild-type central H/H fold depth d_HH" ;
        schema:unitText "um" ;
        schema:value "19.65" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-mature-96-h-ael-wild-type-central-h-h-fold-depth-d-hh-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-mature-96-h-ael-wild-type-central-h-h-fold-depth-d-hh-reference> a schema:PropertyValue ;
        dcterms:source "Tozluoglu et al. (2019) Dev. Cell 51(3):299-312.e4 Fig. 2 & Sui et al. (2018) Nat. Commun. 9:4620" ;
        schema:value "19.4" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-specimen-cv-segmented-h-h-fold-normalized-position-s-hh-l-drosophila-wing-disc-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Specimen CV segmented H/H fold normalized position s_HH/L (drosophila_wing_disc_specimen.jpg) = 0.391 s/L" ;
        dcterms:description "mean 3-fold position error = 0.0045" ;
        schema:measurementTechnique "Reporter gradient inflection landmark along proximal-distal axis of third-instar wing disc (s_HN=0.266, s_HH=0.391, s_HP=0.526)" ;
        schema:name "Specimen CV segmented H/H fold normalized position s_HH/L (drosophila_wing_disc_specimen.jpg)" ;
        schema:unitText "s/L" ;
        schema:value "0.391" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-specimen-cv-segmented-h-h-fold-normalized-position-s-hh-l-drosophila-wing-disc-specimen-jpg-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-specimen-cv-segmented-h-h-fold-normalized-position-s-hh-l-drosophila-wing-disc-specimen-jpg-reference> a schema:PropertyValue ;
        dcterms:source "Tozluoglu et al. (2019) Dev. Cell 51:299-312 & Sui et al. (2018) Nat. Commun. 9:4620 H/H fold boundary" ;
        schema:value "0.39" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-specimen-cv-segmented-wing-pouch-dome-zone-fraction-1-s-hp-l> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Specimen CV segmented wing pouch dome zone fraction (1 - s_HP/L) = 0.474 fraction" ;
        dcterms:description "notum = 0.266, hinge = 0.260, pouch = 0.474" ;
        schema:measurementTechnique "Distal wing pouch dome axial fraction in segmented wing imaginal disc specimen (n=3 discs, stain ratio=4.69)" ;
        schema:name "Specimen CV segmented wing pouch dome zone fraction (1 - s_HP/L)" ;
        schema:unitText "fraction" ;
        schema:value "0.474" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-specimen-cv-segmented-wing-pouch-dome-zone-fraction-1-s-hp-l-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-specimen-cv-segmented-wing-pouch-dome-zone-fraction-1-s-hp-l-reference> a schema:PropertyValue ;
        dcterms:source "Tozluoglu et al. (2019) Dev. Cell 51:299-312 Fig. 1 wing pouch dome proportion" ;
        schema:value "0.48" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-uniform-proliferation-unpinned-buckling-positional-standard-deviation-sigma-s-l> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Uniform proliferation unpinned buckling positional standard deviation sigma_s/L = 0.1769 s/L SD" ;
        dcterms:description "WT pinned SD = 0.0085 vs uniform unpinned SD = 0.1769" ;
        schema:measurementTechnique "Replicate standard deviation of central fold position across n=12 seeds under spatially uniform growth g(s) = g_bar" ;
        schema:name "Uniform proliferation unpinned buckling positional standard deviation sigma_s/L" ;
        schema:unitText "s/L SD" ;
        schema:value "0.1769" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-uniform-proliferation-unpinned-buckling-positional-standard-deviation-sigma-s-l-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-uniform-proliferation-unpinned-buckling-positional-standard-deviation-sigma-s-l-reference> a schema:PropertyValue ;
        dcterms:source "Tozluoglu et al. (2019) Dev. Cell 51(3):299-312.e4 Fig. 2 (unpinned buckling under uniform growth)" ;
        schema:value "0.142" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-morphometric-validation-1> a pk:EvidenceItem ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tozluoglu-wing-disc-dome-folding> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Tozluoglu et al. (2019) Dev. Cell & Sui et al. (2018) Nat. Commun. Drosophila wing imaginal disc planar differential growth, basal ECM dome & H/N, H/H, H/P hinge folding — Reproducibility package: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "8-point `self_test()` suite (`L762-811`) verifying SHA-256 dataset integrity, JSON-to-code parity, Law 1 dome curvature positivity and ECM ablation vanishing, Law 2 growth trough convexity g''(s^*) > 0 at H/N, H/H, and H/P, Law 3 5-condition fold depth hierarchy and replicate positional variance, 64h-96h timecourse correlations, specimen CV metrics, and two-run bitwise determinism." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-repro-package-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2020-tozluoglu-wing-disc-dome-folding.py L762–L811" ;
        dct:description "Comprehensive 8-check self_test() including bitwise determinism and perturbation invariants" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2020-tozluoglu-wing-disc-dome-folding.py#L762-L811> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 049 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


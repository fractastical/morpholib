sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-richman-cortical-gyrification-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Richman et al. (1975) & Tallinen et al. (2014, 2016) neo-Hookean constrained cortical expansion and sulcal creasing instability — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements Tallinen et al.'s (2014) multiplicative growth excess Delta_g = max(0, g - g_c), Richman et al.'s (1975) cube-root sulcal wavelength scaling lambda = 2*pi*h*(mu_c/(3*mu_s))^(1/3), Zilles et al.'s (1988) Gyrification Index GI = P_pial / P_hull (L130-158), and an L-BFGS-B energy minimizer of a growing 2D coronal neo-Hookean cortical shell + subcortical white-matter foundation (`relax_neohookean_cortical_shell`, L164-327) with zero-growth (g=1.00), lissencephaly (h=6.50 mm, g=1.14), and polymicrogyria (h=0.85 mm) controls (L449-484), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_061_cortical_gyrification_folding.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py L130–L158" ;
        dcterms:description "Exact multiplicative growth excess, cube-root sulcal wavelength scaling, and Gyrification Index laws" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1975-richman-cortical-gyrification-buckling.py#L130-L158> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py L164–L327" ;
        dcterms:description "2D coronal neo-Hookean cortical shell + white-matter core L-BFGS-B energy minimizer and g <= g_c lissencephalic threshold" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1975-richman-cortical-gyrification-buckling.py#L164-L327> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_061_cortical_gyrification_folding.lean L11–L86" ;
        dcterms:description "3 machine-checked Lean 4 theorems for critical growth threshold, cube-law wavelength stationarity, and GI sulcal perimeter excess (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_061_cortical_gyrification_folding.lean#L11-L86> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 061 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


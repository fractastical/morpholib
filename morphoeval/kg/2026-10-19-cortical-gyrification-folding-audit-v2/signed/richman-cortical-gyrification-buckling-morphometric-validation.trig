        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-zero-growth-lissencephaly-negative-control-gyrification-index-g-g-c-vs-gw38-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-zero-growth-lissencephaly-negative-control-gyrification-index-g-g-c-vs-gw38-reference> a schema:PropertyValue ;
        dcterms:source "Tallinen et al. (2014) PNAS Fig. 2 & Richman et al. (1975) Science lissencephalic unfolded baseline (GI = 1.0)" ;

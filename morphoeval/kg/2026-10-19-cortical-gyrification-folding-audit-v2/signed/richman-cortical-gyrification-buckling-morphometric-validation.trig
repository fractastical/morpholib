sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-richman-cortical-gyrification-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-11-species-mammalian-gyrification-index-scaling-correlation-tallinen-2014-mota-2015> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "11-species mammalian gyrification index scaling correlation (Tallinen 2014 / Mota 2015) = 0.9985 Pearson r" ;
        dcterms:description "RMSE = 0.0511, p=1.30e-12" ;
        schema:measurementTechnique "Linear correlation of relaxed neo-Hookean shell GI_sim vs empirical GI_obs across 11 mammalian species (p=1.30e-12, RMSE=0.0511)" ;
        schema:name "11-species mammalian gyrification index scaling correlation (Tallinen 2014 / Mota 2015)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9985" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-11-species-mammalian-gyrification-index-scaling-correlation-tallinen-2014-mota-2015-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-11-species-mammalian-gyrification-index-scaling-correlation-tallinen-2014-mota-2015-reference> a schema:PropertyValue ;
        dcterms:source "Tallinen et al. (2014) PNAS 111:12667-12672 & Mota & Herculano-Houzel (2015) Science 349:74-77" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-11-species-mammalian-sulcal-wavelength-scaling-correlation-richman-1975-tallinen-2014> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "11-species mammalian sulcal wavelength scaling correlation (Richman 1975 / Tallinen 2014) = 1.0 Pearson r" ;
        dcterms:description "RMSE = 0.0130 mm, p=1.25e-25" ;
        schema:measurementTechnique "Linear regression of predicted 2*pi*h*(mu_c/(3*mu_s))^(1/3) vs measured wavelength across 11 mammalian species (p=1.25e-25, RMSE=0.0130 mm)" ;
        schema:name "11-species mammalian sulcal wavelength scaling correlation (Richman 1975 / Tallinen 2014)" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-11-species-mammalian-sulcal-wavelength-scaling-correlation-richman-1975-tallinen-2014-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-11-species-mammalian-sulcal-wavelength-scaling-correlation-richman-1975-tallinen-2014-reference> a schema:PropertyValue ;
        dcterms:source "Richman et al. (1975) Science 189:18-21 & Tallinen et al. (2014) PNAS 111:12667-12672 Fig. 3-4" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-coronal-human-brain-specimen-segmented-gyrification-index-gi-specimen-cerebral-cortex-gyri-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Coronal human brain specimen segmented Gyrification Index GI_specimen (cerebral_cortex_gyri_specimen.jpg) = 2.8115 P_pial / P_hull" ;
        dcterms:description "specimen inter-sulcal spacing = 28.32 ± 9.16 px (CV=0.3236)" ;
        schema:measurementTechnique "Segmented pial + sulcal cleft perimeter P_pial (4923.0 px) over convex hull P_hull (1751.0 px) across n=52 sulci in ROI" ;
        schema:name "Coronal human brain specimen segmented Gyrification Index GI_specimen (cerebral_cortex_gyri_specimen.jpg)" ;
        schema:unitText "P_pial / P_hull" ;
        schema:value "2.8115" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-coronal-human-brain-specimen-segmented-gyrification-index-gi-specimen-cerebral-cortex-gyri-specimen-jpg-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-coronal-human-brain-specimen-segmented-gyrification-index-gi-specimen-cerebral-cortex-gyri-specimen-jpg-reference> a schema:PropertyValue ;
        dcterms:source "Zilles et al. (1988) Anat. Embryol. 179:173-179 human coronal section GI (2.56 ± 0.08)" ;
        schema:value "2.56" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-cross-species-log-log-power-law-exponent-alpha-lambda-h-alpha> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cross-species log-log power-law exponent alpha (lambda ~ h^alpha) = 0.9991 exponent" ;
        dcterms:description "dimensionless ratio lambda/h = 4.3639 (CV=0.0007)" ;
        schema:measurementTechnique "Log-log OLS slope of log(lambda_obs) vs log(h_cortex) across 11 mammalian species (SE ± 0.0007)" ;
        schema:name "Cross-species log-log power-law exponent alpha (lambda ~ h^alpha)" ;
        schema:unitText "exponent" ;
        schema:value "0.9991" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-cross-species-log-log-power-law-exponent-alpha-lambda-h-alpha-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-cross-species-log-log-power-law-exponent-alpha-lambda-h-alpha-reference> a schema:PropertyValue ;
        dcterms:source "Richman et al. (1975) Science 189:18-21 Eq. 1 (lambda ~ h^1.0 at constant stiffness ratio)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-human-gw38-l-bfgs-b-relaxed-neo-hookean-shell-gyrification-index-gi-sim> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Human GW38 L-BFGS-B relaxed neo-Hookean shell gyrification index GI_sim = 2.5606 P_pial / P_hull" ;
        dcterms:description "mean sulcal depth = 8.769 mm across 28 sulci" ;
        schema:measurementTechnique "Ratio of relaxed pial perimeter P_pial to outer convex hull perimeter P_hull at GW38 (g=2.15, h=2.60 mm)" ;
        schema:name "Human GW38 L-BFGS-B relaxed neo-Hookean shell gyrification index GI_sim" ;
        schema:unitText "P_pial / P_hull" ;
        schema:value "2.5606" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-human-gw38-l-bfgs-b-relaxed-neo-hookean-shell-gyrification-index-gi-sim-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-human-gw38-l-bfgs-b-relaxed-neo-hookean-shell-gyrification-index-gi-sim-reference> a schema:PropertyValue ;
        dcterms:source "Zilles et al. (1988) Anat. Embryol. 179:173-179 & Tallinen et al. (2016) Nature Physics Fig. 3 (GI=2.56)" ;
        schema:value "2.56" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-human-gw38-l-bfgs-b-relaxed-neo-hookean-shell-sulcal-wavelength-lambda-sim> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Human GW38 L-BFGS-B relaxed neo-Hookean shell sulcal wavelength lambda_sim = 11.2376 mm" ;
        dcterms:description "energy drop ratio = 1.0000" ;
        schema:measurementTechnique "Emergent sulcal spacing P_hull / N_sulci of 240-node L-BFGS-B relaxed neo-Hookean cortical shell at GW38 (h=2.60 mm, g=2.15)" ;
        schema:name "Human GW38 L-BFGS-B relaxed neo-Hookean shell sulcal wavelength lambda_sim" ;
        schema:unitText "mm" ;
        schema:value "11.2376" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-human-gw38-l-bfgs-b-relaxed-neo-hookean-shell-sulcal-wavelength-lambda-sim-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-human-gw38-l-bfgs-b-relaxed-neo-hookean-shell-sulcal-wavelength-lambda-sim-reference> a schema:PropertyValue ;
        dcterms:source "Tallinen et al. (2016) Nature Physics 12:588-593 & Richman et al. (1975) Science Table 1 (11.34 mm)" ;
        schema:value "11.34" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-polymicrogyria-vs-normogyria-sulcus-frequency-modulation-ratio-richman-et-al-1975> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Polymicrogyria vs Normogyria sulcus frequency modulation ratio (Richman et al. 1975) = 3.0357 ratio (N_poly / N_norm)" ;
        dcterms:description "polymicrogyria sulci=85 (lambda=3.70 mm) vs normal sulci=28 (lambda=11.24 mm)" ;
        schema:measurementTechnique "Ratio of simulated coronal sulcus counts in thin-cortex polymicrogyria (h=0.85 mm) vs normal human cortex (h=2.60 mm)" ;
        schema:name "Polymicrogyria vs Normogyria sulcus frequency modulation ratio (Richman et al. 1975)" ;
        schema:unitText "ratio (N_poly / N_norm)" ;
        schema:value "3.0357" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-polymicrogyria-vs-normogyria-sulcus-frequency-modulation-ratio-richman-et-al-1975-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-polymicrogyria-vs-normogyria-sulcus-frequency-modulation-ratio-richman-et-al-1975-reference> a schema:PropertyValue ;
        dcterms:source "Richman et al. (1975) Science 189:18-21 Table 1 (microgyric h=0.85 mm vs normal h=2.60 mm)" ;
        schema:value "3.0357" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-universal-dimensionless-sulcal-wavelength-to-thickness-invariant-lambda-h-across-11-mammals> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Universal dimensionless sulcal wavelength-to-thickness invariant lambda / h across 11 mammals = 4.3639 dimensionless ratio" ;
        dcterms:description "specimen sulcal spacing CV = 0.3236" ;
        schema:measurementTechnique "Mean observed lambda / h across 11 mammalian species at mu_c/mu_s = 1.0 (CV = 0.0007)" ;
        schema:name "Universal dimensionless sulcal wavelength-to-thickness invariant lambda / h across 11 mammals" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "4.3639" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-universal-dimensionless-sulcal-wavelength-to-thickness-invariant-lambda-h-across-11-mammals-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-universal-dimensionless-sulcal-wavelength-to-thickness-invariant-lambda-h-across-11-mammals-reference> a schema:PropertyValue ;
        dcterms:source "Richman et al. (1975) Science Eq. 1 & Tallinen et al. (2014) PNAS (2*pi*(1/3)^(1/3) = 4.3633)" ;
        schema:value "4.3565" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-measurement-zero-growth-lissencephaly-negative-control-gyrification-index-g-g-c-vs-gw38> a schema:PropertyValue,

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-richman-cortical-gyrification-buckling> a pk:Claim ;
        rdfs:label "Richman et al. (1975) & Tallinen et al. (2014, 2016) neo-Hookean constrained cortical expansion and sulcal creasing instability faithfully reproduces Mammalian cerebral cortex & subcortical white matter (Homo sapiens, Pan troglodytes, Macaca mulatta, Tursiops truncatus, Felis catus, Mus musculus) morphology" ;
        dcterms:description "The simulation script(s) 1975-richman-cortical-gyrification-buckling.py implement the cited source model as published and produce forms that match real Mammalian cerebral cortex & subcortical white matter (Homo sapiens, Pan troglodytes, Macaca mulatta, Tursiops truncatus, Felis catus, Mus musculus) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 93.0/100, audit 2026-10-19-cortical-gyrification-folding-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/8871db0/1975-richman-cortical-gyrification-buckling.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/1975-richman-cortical-gyrification-buckling.py; output: docs/media/cortical_gyrification_folding_comparison.png; organism: Mammalian cerebral cortex & subcortical white matter (Homo sapiens, Pan troglodytes, Macaca mulatta, Tursiops truncatus, Felis catus, Mus musculus); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 90353ad40be0c49263b8cded1ab4fed2933fe58ce57cedb91cc5cc5a4ac29ad0; artifact_sha256: b39586ccf22a61152ce3e5d36ae5410c69d36efd3669d69ad5675ae5dd5a0519; input_dataset_sha256: {datasets/cortical_gyrification_folding/cerebral_cortex_gyri_specimen.jpg=ff9a25e993fd5aad..., datasets/cortical_gyrification_folding/cortical_gyrification_folding_reference.json=94947373ac49d97d..., datasets/cortical_gyrification_folding/paper_citations.bib=56bc1d0beedebe37..., datasets/cortical_gyrification_folding/scout_manifest.json=7f5410ff8ad2c1ee...}; supersedes_audit_id: 2026-10-19-cortical-gyrification-folding-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00304699>,
            <https://doi.org/10.1038/nphys3632>,
            <https://doi.org/10.1073/pnas.1406015111>,
            <https://doi.org/10.1126/science.1145181>,
            <https://doi.org/10.1126/science.aaa9101> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-specimen-match> ;
        pk:weightOfEvidence "0.93"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/8871db0/1975-richman-cortical-gyrification-buckling.py> a schema:SoftwareSourceCode ;

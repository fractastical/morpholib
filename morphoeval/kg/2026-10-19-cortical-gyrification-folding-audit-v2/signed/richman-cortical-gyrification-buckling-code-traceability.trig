sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-richman-cortical-gyrification-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Richman et al. (1975) & Tallinen et al. (2014, 2016) neo-Hookean constrained cortical expansion and sulcal creasing instability — Code-to-model traceability: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Module and function docstrings map every equation to Richman et al. (1975) Eq. 1 & Table 1, Tallinen et al. (2014) Eq. 1-3 & Fig. 1-4, Tallinen et al. (2016) Fig. 2-4, Mota & Herculano-Houzel (2015), Zilles et al. (1988), and the 3 formal Lean 4 theorems in `morphoeval/lean/loops/Loop_061_cortical_gyrification_folding.lean` (L1-53, L130-163)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-code-traceability-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py L1–L53" ;
        dcterms:description "Explicit equation-to-paper and Lean 4 theorem traceability in module header" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1975-richman-cortical-gyrification-buckling.py#L1-L53> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 061 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


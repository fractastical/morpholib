sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-richman-cortical-gyrification-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Richman et al. (1975) & Tallinen et al. (2014, 2016) neo-Hookean constrained cortical expansion and sulcal creasing instability — Morphological realism / specimen match: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY 2.5 coronal human cerebral cortex specimen `datasets/cortical_gyrification_folding/cerebral_cortex_gyri_specimen.jpg`, segments the cortical gray-matter ribbon, subcortical white-matter core, outer convex hull perimeter P_hull, and 52 sulcal cleft troughs (`segment_cerebral_cortex_specimen`, L490-585; GI_specimen = 2.8115, CV = 0.3243), and matches all 11 mammalian species (r = 1.0000 for wavelength, r = 0.9985 for GI) plus 5 human fetal stages (GW22-GW38)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py L490–L585" ;
        dct:description "Coronal brain slice segmentation isolating gray/white matter, convex hull P_hull, and 52 sulcal troughs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1975-richman-cortical-gyrification-buckling.py#L490-L585> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/cortical_gyrification_folding_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing L-BFGS-B coronal shell, 11-species collapse, pathology controls, and specimen segmentation — docs/media/cortical_gyrification_folding_comparison.png: rendered output of 1975-richman-cortical-gyrification-buckling.py at 8871db0, image/png, 821237 B, 2104×1452 px, artifact_sha256 b39586ccf22a61152ce3e5d36ae5410c69d36efd3669d69ad5675ae5dd5a0519 (sha256 b39586ccf22a61152ce3e5d36ae5410c69d36efd3669d69ad5675ae5dd5a0519), spec_fingerprint 90353ad40be0c49263b8cded1ab4fed2933fe58ce57cedb91cc5cc5a4ac29ad0" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 061 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


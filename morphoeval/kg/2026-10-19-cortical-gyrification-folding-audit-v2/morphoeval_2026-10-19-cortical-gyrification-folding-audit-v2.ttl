<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/richman-cortical-gyrification-buckling-1>,
        <https://w3id.org/probknow/resource/math-law/richman-cortical-gyrification-buckling-2>,
        <https://w3id.org/probknow/resource/math-law/richman-cortical-gyrification-buckling-3> .

<https://w3id.org/probknow/resource/math-law/richman-cortical-gyrification-buckling-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Tallinen et al. (2014) Multiplicative Cortical Growth Decomposition & Critical Buckling Threshold" ;
    dct:description "Establishes the multiplicative growth decomposition of tangential cortical expansion relative to the subcortical white-matter core and the critical threshold separating lissencephaly (g <= g_c) from gyrencephaly (g > g_c) | Variables: F: total deformation gradient; F_e: elastic deformation gradient; G: tangential cortical growth tensor with linear factor g; g_c = 1.18: critical sulcal creasing threshold" ;
    dct:source "Tallinen et al. (2014) PNAS 111:12667-12672 Eq. (1) & Fig. 1-2; Tallinen et al. (2016) Nature Physics 12:588-593" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/1975-richman-cortical-gyrification-buckling.py#L120-L185>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_061_cortical_gyrification_folding.lean#L24-L35> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def cortical_growth_excess (g g_c : Int) : Int :=
  g - g_c
theorem tallinen_critical_growth_threshold (g_c : Int) :
    cortical_growth_excess g_c g_c = 0 ∧
    ∀ dg : Nat, cortical_growth_excess (g_c + Int.ofNat (dg + 1)) g_c = Int.ofNat (dg + 1)
"""^^pk:lean4 ;
    skos:notation "F = F_e G,  G = diag(g, 1);  Δg = g - g_c = 0 ⇔ g = g_c (lissencephalic threshold)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00304699>,
        <https://doi.org/10.1038/nphys3632>,
        <https://doi.org/10.1073/pnas.1406015111>,
        <https://doi.org/10.1126/science.1145181>,
        <https://doi.org/10.1126/science.aaa9101> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Neo-Hookean Multiplicative Cortical Growth & Elastic Subcortical Buckling / Sulcal Creasing" ;
    pk:leanDeclaration "MathOfBiology.Loop_061.cortical_growth_excess" ;
    pk:leanTheorem "MathOfBiology.Loop_061.tallinen_critical_growth_threshold" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/richman-cortical-gyrification-buckling-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Richman et al. (1975) & Tallinen et al. (2014) Cube-Law Sulcal Wavelength Scaling" ;
    dct:description "Predicts linear scaling of gyral/sulcal wavelength with cortical thickness h and cube-root scaling with cortical-to-subcortical stiffness ratio across normal, polymicrogyric, and comparative mammalian brains | Variables: λ: sulcal folding wavelength (mm); h: cortical gray-matter thickness (mm); μ_c: cortical shear modulus (kPa); μ_s: subcortical white-matter shear modulus (kPa)" ;
    dct:source "Richman et al. (1975) Science 189:18-21 Eq. (1) & Table 1; Tallinen et al. (2014) PNAS 111:12667-12672 Fig. 3-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/1975-richman-cortical-gyrification-buckling.py#L140-L240>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_061_cortical_gyrification_folding.lean#L51-L60> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def richman_wavelength_residual (lam h mu_c mu_s : Int) : Int :=
  3 * mu_s * (lam * lam * lam) - 2 * mu_c * (h * h * h)
theorem richman_cube_law_wavelength_stationarity (h mu_s : Int) :
    richman_wavelength_residual h h (3 * mu_s) (2 * mu_s) = 0 ∧
    richman_wavelength_residual (2 * h) h (24 * mu_s) (2 * mu_s) = 0
"""^^pk:lean4 ;
    skos:notation "U_tot(λ) ~ μ_c h^3 / λ^2 + 3 μ_s λ  ⇒  ∂U_tot/∂λ = 0  ⇔  λ = 2π h (μ_c / (3 μ_s))^(1/3)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00304699>,
        <https://doi.org/10.1038/nphys3632>,
        <https://doi.org/10.1073/pnas.1406015111>,
        <https://doi.org/10.1126/science.1145181>,
        <https://doi.org/10.1126/science.aaa9101> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Neo-Hookean Multiplicative Cortical Growth & Elastic Subcortical Buckling / Sulcal Creasing" ;
    pk:leanDeclaration "MathOfBiology.Loop_061.richman_wavelength_residual" ;
    pk:leanTheorem "MathOfBiology.Loop_061.richman_cube_law_wavelength_stationarity" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/richman-cortical-gyrification-buckling-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Zilles et al. (1988) & Tallinen et al. (2016) Gyrification Index Buried Sulcal Perimeter Law" ;
    dct:description "Quantifies the ratio of total pial surface contour to outer convex hull perimeter across human fetal gestation (GW22-GW38) and across 11 mammalian species | Variables: GI: coronal gyrification index; P_pial: total pial contour perimeter (mm); P_hull: outer convex hull perimeter (mm); N_sulci: number of sulcal infoldings; d_sulcus: mean sulcal depth (mm)" ;
    dct:source "Zilles et al. (1988) Anat. Embryol. 179:173-179; Tallinen et al. (2016) Nature Physics 12:588-593 Fig. 3-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/1975-richman-cortical-gyrification-buckling.py#L245-L345>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_061_cortical_gyrification_folding.lean#L74-L83> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def gyrification_perimeter_excess (P_hull n_sulci d_sulcus : Int) : Int :=
  (P_hull + 2 * n_sulci * d_sulcus) - P_hull
theorem gyrification_index_sulcal_excess (P_hull n_sulci d_sulcus : Int) :
    gyrification_perimeter_excess P_hull 0 d_sulcus = 0 ∧
    gyrification_perimeter_excess P_hull n_sulci d_sulcus = 2 * n_sulci * d_sulcus
"""^^pk:lean4 ;
    skos:notation "GI = P_pial / P_hull = 1 + (2 N_sulci d_sulcus) / P_hull ≥ 1.0  (GI = 1.0 ⇔ N_sulci = 0)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00304699>,
        <https://doi.org/10.1038/nphys3632>,
        <https://doi.org/10.1073/pnas.1406015111>,
        <https://doi.org/10.1126/science.1145181>,
        <https://doi.org/10.1126/science.aaa9101> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Neo-Hookean Multiplicative Cortical Growth & Elastic Subcortical Buckling / Sulcal Creasing" ;
    pk:leanDeclaration "MathOfBiology.Loop_061.gyrification_perimeter_excess" ;
    pk:leanTheorem "MathOfBiology.Loop_061.gyrification_index_sulcal_excess" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


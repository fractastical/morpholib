        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-richman-cortical-gyrification-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-richman-cortical-gyrification-buckling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Richman et al. (1975) & Tallinen et al. (2014, 2016) neo-Hookean constrained cortical expansion and sulcal creasing instability — Parameter expressivity: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Spans 5 human fetal stages (GW22-GW38, g in [1.12, 2.15], L333-374), 11 mammalian species spanning Rodentia, Carnivora, Artiodactyla, Cetacea, and Primates (h in [0.88, 2.60] mm, R_brain in [4.2, 62.0] mm, g in [1.06, 2.65], L377-446), 4 pathological/ablation conditions (zero-growth, lissencephaly, normogyria, polymicrogyria, L449-484), and exposes `--growth-g`, `--h-cortex`, `--mu-ratio`, `--R-brain`, and `--seed` CLI overrides (L796-822)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-parameter-expressivity-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py L377–L484" ;
        dct:description "11-species mammalian morphospace evaluation and 4-condition lissencephaly/polymicrogyria/ablation sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1975-richman-cortical-gyrification-buckling.py#L377-L484> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-richman-cortical-gyrification-buckling-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1975-richman-cortical-gyrification-buckling.py L796–L822" ;
        dct:description "CLI physical parameter overrides wired into fetal evaluation and figure rendering" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1975-richman-cortical-gyrification-buckling.py#L796-L822> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 061 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


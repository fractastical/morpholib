sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-santella-wormguides-celegans> a pk:Claim ;
        rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome faithfully reproduces Caenorhabditis elegans embryo, 4-cell stage to ~580 nuclei (strain JIM113, diSPIM series DISPIM_061416) morphology" ;
        dct:description "The simulation script(s) 2015-santella-wormguides-celegans.py implement the cited source model as published and produce forms that match real Caenorhabditis elegans embryo, 4-cell stage to ~580 nuclei (strain JIM113, diSPIM series DISPIM_061416) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 70.2/100, audit 2026-10-16-celegans-audit) and the assessments." ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py; output: celegans_four_views.png; organism: Caenorhabditis elegans embryo, 4-cell stage to ~580 nuclei (strain JIM113, diSPIM series DISPIM_061416); checkpoint commit: https://github.com/fractastical/morpholib/commit/303a87e; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, matplotlib 3.10.7, Pillow 12.0.0; other sources: WormGUIDES atlas and application source, commit 17be611f10cdc8ea438e67dc9ca3de859487a05e <https://github.com/zhirongbaolab/WormGUIDES/tree/17be611f10cdc8ea438e67dc9ca3de859487a05e>, c302: NeuroML-based C. elegans nervous-system models, commit f54d92d7e9d2410ff6c47d9ae866649f1a419ee8 <https://github.com/openworm/c302/tree/f54d92d7e9d2410ff6c47d9ae866649f1a419ee8>" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0012-1606(83)90201-4>,
            <https://doi.org/10.1038/s41586-019-1352-7>,
            <https://doi.org/10.1083/jcb.144.5.927>,
            <https://doi.org/10.1098/rstb.2017.0382>,
            <https://doi.org/10.1186/s12859-015-0627-8> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-16-celegans-audit-santella-wormguides-celegans-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-16-celegans-audit-santella-wormguides-celegans-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-16-celegans-audit-santella-wormguides-celegans-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/2026-10-16-celegans-audit-santella-wormguides-celegans-overall>,
            <https://w3id.org/probknow/resource/assessment/2026-10-16-celegans-audit-santella-wormguides-celegans-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-16-celegans-audit-santella-wormguides-celegans-repro-package>,
            <https://w3id.org/probknow/resource/assessment/2026-10-16-celegans-audit-santella-wormguides-celegans-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-16-celegans-audit-santella-wormguides-celegans-specimen-match> ;
        pk:weightOfEvidence "0.702"^^xsd:double .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(83)90201-4>,
            <https://doi.org/10.1038/s41586-019-1352-7>,
            <https://doi.org/10.1083/jcb.144.5.927>,
            <https://doi.org/10.1098/rstb.2017.0382>,
            <https://doi.org/10.1186/s12859-015-0627-8> .
    <https://doi.org/10.1016/0012-1606(83)90201-4> dct:date "1983"^^xsd:gYear ;
        dct:title "The embryonic cell lineage of the nematode Caenorhabditis elegans" .
    <https://doi.org/10.1038/s41586-019-1352-7> dct:date "2019"^^xsd:gYear ;
        dct:title "Whole-animal connectomes of both Caenorhabditis elegans sexes" .
    <https://doi.org/10.1083/jcb.144.5.927> dct:date "1999"^^xsd:gYear ;
        dct:title "Dissection of cell division processes in the one cell stage Caenorhabditis elegans embryo by mutational analysis" .
    <https://doi.org/10.1098/rstb.2017.0382> dct:date "2018"^^xsd:gYear ;
        dct:title "OpenWorm: overview and recent advances in integrative biological simulation of Caenorhabditis elegans" .
    <https://doi.org/10.1186/s12859-015-0627-8> dct:date "2015"^^xsd:gYear ;
        dct:title "WormGUIDES: an interactive single cell developmental atlas and tool for collaborative multidimensional data exploration" .
}


            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(83)90201-4>,
            <https://doi.org/10.1038/s41586-019-1352-7>,
            <https://doi.org/10.1083/jcb.144.5.927>,
            <https://doi.org/10.1098/rstb.2017.0382>,
            <https://doi.org/10.1186/s12859-015-0627-8> .

    <https://doi.org/10.1016/0012-1606(83)90201-4> dcterms:date "1983"^^xsd:gYear ;
        dcterms:title "The embryonic cell lineage of the nematode Caenorhabditis elegans" .

    <https://doi.org/10.1038/s41586-019-1352-7> dcterms:date "2019"^^xsd:gYear ;
        dcterms:title "Whole-animal connectomes of both Caenorhabditis elegans sexes" .

    <https://doi.org/10.1083/jcb.144.5.927> dcterms:date "1999"^^xsd:gYear ;
        dcterms:title "Dissection of cell division processes in the one cell stage Caenorhabditis elegans embryo by mutational analysis" .

    <https://doi.org/10.1098/rstb.2017.0382> dcterms:date "2018"^^xsd:gYear ;
        dcterms:title "OpenWorm: overview and recent advances in integrative biological simulation of Caenorhabditis elegans" .

    <https://doi.org/10.1186/s12859-015-0627-8> dcterms:date "2015"^^xsd:gYear ;
        dcterms:title "WormGUIDES: an interactive single cell developmental atlas and tool for collaborative multidimensional data exploration" .
}


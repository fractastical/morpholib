sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-16-celegans-audit-santella-wormguides-celegans-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome — Code-to-model traceability: 75/100" ;
        rdfs:comment "The docstring names the loader whose column semantics are followed, the ProductionInfo fields used, the source of every literature constant and the calibration reference; each check prints the value and the literature anchor it is compared with. The nuclei-file format itself (StarryNite/AceTree) is documented only by the WormGUIDES loader source, not by a paper section, so the trace stops at code rather than at a publication. Evidence: 2015-santella-wormguides-celegans.py L1–L22: the four layers and what is decoded <https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py#L1-L22>; 2015-santella-wormguides-celegans.py L113–L124: LIT constants and the Sulston grammar <https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py#L113-L124>; 2015-santella-wormguides-celegans.py L266–L275: movie_offset(): the ProductionInfo field read <https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py#L266-L275>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans-code-traceability> ;
        pk:hasProbability "0.75"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans-code-traceability> rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome (2015-santella-wormguides-celegans.py) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Caenorhabditis elegans embryo, 4-cell stage to ~580 nuclei (strain JIM113, diSPIM series DISPIM_061416)" ;
        dct:identifier "morphoeval/0.1.0/code-traceability" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(83)90201-4>,
            <https://doi.org/10.1038/s41586-019-1352-7>,
            <https://doi.org/10.1083/jcb.144.5.927>,
            <https://doi.org/10.1098/rstb.2017.0382>,
            <https://doi.org/10.1186/s12859-015-0627-8> .
    <https://doi.org/10.1016/0012-1606(83)90201-4> dct:date "1983"^^xsd:gYear ;
        dct:title "The embryonic cell lineage of the nematode Caenorhabditis elegans" .
    <https://doi.org/10.1038/s41586-019-1352-7> dct:date "2019"^^xsd:gYear ;
        dct:title "Whole-animal connectomes of both Caenorhabditis elegans sexes" .
    <https://doi.org/10.1083/jcb.144.5.927> dct:date "1999"^^xsd:gYear ;
        dct:title "Dissection of cell division processes in the one cell stage Caenorhabditis elegans embryo by mutational analysis" .
    <https://doi.org/10.1098/rstb.2017.0382> dct:date "2018"^^xsd:gYear ;
        dct:title "OpenWorm: overview and recent advances in integrative biological simulation of Caenorhabditis elegans" .
    <https://doi.org/10.1186/s12859-015-0627-8> dct:date "2015"^^xsd:gYear ;
        dct:title "WormGUIDES: an interactive single cell developmental atlas and tool for collaborative multidimensional data exploration" .
}


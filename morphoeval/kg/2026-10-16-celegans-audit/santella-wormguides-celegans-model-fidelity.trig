sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-santella-wormguides-celegans> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-santella-wormguides-celegans-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-santella-wormguides-celegans-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome — Model fidelity to source: 80/100" ;
        dct:date "2026-10-16"^^xsd:date ;
        dct:description "Re-scored from 75. The atlas is decoded as the WormGUIDES application decodes it: the column positions follow AceTreeTableLineageDataLoader, the time offset and unit scale are read from ProductionInfo.csv, mesh cells and the eggshell outline are taken from CellShapesConfig.csv. The Sulston naming grammar and parent-of relation are implemented explicitly and tested on every name. The physical scale is now anchored to the atlas's own segmentation of the eggshell rather than to the nuclear cloud, so the one remaining assumption is that this egg has the typical 50 um length; the choice of the frame-330 shell over the static early mesh is justified in the code by the measured nuclear overrun. Not higher because that assumption remains, because the 3D atlas is shown as a 2D projection (back-to-front by z) rather than the application's 3D rendering, and because the connectome layer is a summed adjacency matrix that drops the chemical/electrical distinction and Cook et al.'s muscle and end-organ nodes." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-model-fidelity-5> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2015-santella-wormguides-celegans.py L254–L275" ;
        dct:description "read_nuclei()/movie_offset(): loader columns, ProductionInfo offset" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py#L254-L275> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2015-santella-wormguides-celegans.py L277–L319" ;
        dct:description "founder()/parent_of()/check_encoding(): Sulston grammar and tree" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py#L277-L319> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2015-santella-wormguides-celegans.py L102–L113" ;
        dct:description "WG_SHELL, SHELL_FRAMES, CALIB_FRAME, EMBRYO_LENGTH_UM" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py#L102-L113> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2015-santella-wormguides-celegans.py L335–L368" ;
        dct:description "calibrate()/shell_report()/nuclear_cloud_scale(): the shell-based scale, why frame 330, the cross-check" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py#L335-L368> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "2015-santella-wormguides-celegans.py L564–L595" ;
        dct:description "canonical_cell()/draw_connectome(): neuron set and matrix" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py#L564-L595> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


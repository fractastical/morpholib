sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-16-celegans-audit-santella-wormguides-celegans-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome — Model fidelity to source: 80/100" ;
        rdfs:comment "Re-scored from 75. The atlas is decoded as the WormGUIDES application decodes it: the column positions follow AceTreeTableLineageDataLoader, the time offset and unit scale are read from ProductionInfo.csv, mesh cells and the eggshell outline are taken from CellShapesConfig.csv. The Sulston naming grammar and parent-of relation are implemented explicitly and tested on every name. The physical scale is now anchored to the atlas's own segmentation of the eggshell rather than to the nuclear cloud, so the one remaining assumption is that this egg has the typical 50 um length; the choice of the frame-330 shell over the static early mesh is justified in the code by the measured nuclear overrun. Not higher because that assumption remains, because the 3D atlas is shown as a 2D projection (back-to-front by z) rather than the application's 3D rendering, and because the connectome layer is a summed adjacency matrix that drops the chemical/electrical distinction and Cook et al.'s muscle and end-organ nodes. Evidence: 2015-santella-wormguides-celegans.py L254–L275: read_nuclei()/movie_offset(): loader columns, ProductionInfo offset <https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py#L254-L275>; 2015-santella-wormguides-celegans.py L277–L319: founder()/parent_of()/check_encoding(): Sulston grammar and tree <https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py#L277-L319>; 2015-santella-wormguides-celegans.py L102–L113: WG_SHELL, SHELL_FRAMES, CALIB_FRAME, EMBRYO_LENGTH_UM <https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py#L102-L113>; 2015-santella-wormguides-celegans.py L335–L368: calibrate()/shell_report()/nuclear_cloud_scale(): the shell-based scale, why frame 330, the cross-check <https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py#L335-L368>; 2015-santella-wormguides-celegans.py L564–L595: canonical_cell()/draw_connectome(): neuron set and matrix <https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py#L564-L595>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans-model-fidelity> ;
        pk:hasProbability "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans-model-fidelity> rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome (2015-santella-wormguides-celegans.py) satisfies the MorphoEval 0.1.0 criterion 'Model fidelity to source' for Caenorhabditis elegans embryo, 4-cell stage to ~580 nuclei (strain JIM113, diSPIM series DISPIM_061416)" ;
        dct:identifier "morphoeval/0.1.0/model-fidelity" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(83)90201-4>,
            <https://doi.org/10.1038/s41586-019-1352-7>,
            <https://doi.org/10.1083/jcb.144.5.927>,
            <https://doi.org/10.1098/rstb.2017.0382>,
            <https://doi.org/10.1186/s12859-015-0627-8> .
    <https://doi.org/10.1016/0012-1606(83)90201-4> dct:date "1983"^^xsd:gYear ;
        dct:title "The embryonic cell lineage of the nematode Caenorhabditis elegans" .
    <https://doi.org/10.1038/s41586-019-1352-7> dct:date "2019"^^xsd:gYear ;
        dct:title "Whole-animal connectomes of both Caenorhabditis elegans sexes" .
    <https://doi.org/10.1083/jcb.144.5.927> dct:date "1999"^^xsd:gYear ;
        dct:title "Dissection of cell division processes in the one cell stage Caenorhabditis elegans embryo by mutational analysis" .
    <https://doi.org/10.1098/rstb.2017.0382> dct:date "2018"^^xsd:gYear ;
        dct:title "OpenWorm: overview and recent advances in integrative biological simulation of Caenorhabditis elegans" .
    <https://doi.org/10.1186/s12859-015-0627-8> dct:date "2015"^^xsd:gYear ;
        dct:title "WormGUIDES: an interactive single cell developmental atlas and tool for collaborative multidimensional data exploration" .
}


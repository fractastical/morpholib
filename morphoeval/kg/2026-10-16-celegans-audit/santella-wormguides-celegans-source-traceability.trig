sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-santella-wormguides-celegans> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-santella-wormguides-celegans-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-santella-wormguides-celegans-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome — Source and data traceability: 85/100" ;
        dct:date "2026-10-16"^^xsd:date ;
        dct:description "Both repositories are pinned to a commit and licence, every input file has a SHA-256 in datasets/celegans/pinned_inputs.sha256 that is checked on every run, the papers are cited with DOIs, the acquisition metadata (image series, strain, frame interval, movie start) is read from the atlas's own ProductionInfo.csv, and the WormAtlas pages are cited with URL and access date. The Sulston counts and timings are quoted second-hand via WormAtlas rather than from the 1983 paper." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-source-traceability-4> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2015-santella-wormguides-celegans.py L24–L49" ;
        dct:description "references, commits, licences, what each is used for" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py#L24-L49> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2015-santella-wormguides-celegans.py L92–L111" ;
        dct:description "pinned commits and paths, including the shell meshes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py#L92-L111> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "2015-santella-wormguides-celegans.py L163–L199" ;
        dct:description "fetch_inputs(): manifest verification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/303a87e/2015-santella-wormguides-celegans.py#L163-L199> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/celegans/pinned_inputs.sha256 L1–L3" ;
        dct:description "manifest header: commits and retrieval date" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/303a87e/datasets/celegans/pinned_inputs.sha256#L1-L3> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(83)90201-4>,
            <https://doi.org/10.1038/s41586-019-1352-7>,
            <https://doi.org/10.1083/jcb.144.5.927>,
            <https://doi.org/10.1098/rstb.2017.0382>,
            <https://doi.org/10.1186/s12859-015-0627-8>,
            <https://github.com/openworm/c302/tree/f54d92d7e9d2410ff6c47d9ae866649f1a419ee8>,
            <https://github.com/zhirongbaolab/WormGUIDES/tree/17be611f10cdc8ea438e67dc9ca3de859487a05e> .
    <https://doi.org/10.1016/0012-1606(83)90201-4> dct:date "1983"^^xsd:gYear ;
        dct:title "The embryonic cell lineage of the nematode Caenorhabditis elegans" .
    <https://doi.org/10.1038/s41586-019-1352-7> dct:date "2019"^^xsd:gYear ;
        dct:title "Whole-animal connectomes of both Caenorhabditis elegans sexes" .
    <https://doi.org/10.1083/jcb.144.5.927> dct:date "1999"^^xsd:gYear ;
        dct:title "Dissection of cell division processes in the one cell stage Caenorhabditis elegans embryo by mutational analysis" .
    <https://doi.org/10.1098/rstb.2017.0382> dct:date "2018"^^xsd:gYear ;
        dct:title "OpenWorm: overview and recent advances in integrative biological simulation of Caenorhabditis elegans" .
    <https://doi.org/10.1186/s12859-015-0627-8> dct:date "2015"^^xsd:gYear ;
        dct:title "WormGUIDES: an interactive single cell developmental atlas and tool for collaborative multidimensional data exploration" .
    <https://github.com/openworm/c302/tree/f54d92d7e9d2410ff6c47d9ae866649f1a419ee8> dct:title "c302: NeuroML-based C. elegans nervous-system models, commit f54d92d7e9d2410ff6c47d9ae866649f1a419ee8" .
    <https://github.com/zhirongbaolab/WormGUIDES/tree/17be611f10cdc8ea438e67dc9ca3de859487a05e> dct:title "WormGUIDES atlas and application source, commit 17be611f10cdc8ea438e67dc9ca3de859487a05e" .
}


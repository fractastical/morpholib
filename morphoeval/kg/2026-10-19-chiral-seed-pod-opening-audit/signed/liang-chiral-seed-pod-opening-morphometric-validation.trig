sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-liang-chiral-seed-pod-opening> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Armon et al. (2011) Science / Efrati et al. (2009) JMPS Incompatible Shell Elasticity & Chiral Seed Pod Opening — Morphometric validation: 54/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L124-147) returns only 2 basic analytical checks without pitch P(w_tilde) and radius R(w_tilde) transition correlations, cutting-angle chirality validation, or specimen image segmentation metrics." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2007-liang-chiral-seed-pod-opening.py L124–L147: Only 2 baseline analytical measurements returned <https://github.com/fractastical/morpholib/blob/8871db0/2007-liang-chiral-seed-pod-opening.py#L124-L147>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-critical-f-ppl-von-k-rm-n-pitchfork-width-w-tilde-c-nu-0-30>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-wide-valve-mean-curvature-ratio-h-kappa-0-w-1-80-cm> ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-critical-f-ppl-von-k-rm-n-pitchfork-width-w-tilde-c-nu-0-30> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Critical Föppl-von Kármán pitchfork width w_tilde_c (nu=0.30) = 2.1609 dimensionless" ;
        schema:measurementTechnique "Analytical threshold w_tilde_c = (16*(1+nu)/sqrt(1-nu^2))^(1/4)" ;
        schema:name "Critical Föppl-von Kármán pitchfork width w_tilde_c (nu=0.30)" ;
        schema:unitText "dimensionless" ;
        schema:value "2.1609" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-critical-f-ppl-von-k-rm-n-pitchfork-width-w-tilde-c-nu-0-30-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-critical-f-ppl-von-k-rm-n-pitchfork-width-w-tilde-c-nu-0-30-reference> a schema:PropertyValue ;
        dcterms:source "Armon et al. (2011) Science 333:1726-1730" ;
        schema:value "2.1609" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-wide-valve-mean-curvature-ratio-h-kappa-0-w-1-80-cm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wide valve mean curvature ratio H/kappa_0 (W=1.80 cm) = 0.3309 dimensionless" ;
        schema:measurementTechnique "Analytical pitchfork branch evaluation" ;
        schema:name "Wide valve mean curvature ratio H/kappa_0 (W=1.80 cm)" ;
        schema:unitText "dimensionless" ;
        schema:value "0.3309" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-wide-valve-mean-curvature-ratio-h-kappa-0-w-1-80-cm-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-liang-chiral-seed-pod-opening-measurement-wide-valve-mean-curvature-ratio-h-kappa-0-w-1-80-cm-reference> a schema:PropertyValue ;
        dcterms:source "Armon et al. (2011) Science 333:1726-1730" ;
        schema:value "0.3304" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 065 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


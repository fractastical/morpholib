<https://w3id.org/probknow/resource/claim/morphoeval-liang-chiral-seed-pod-opening> a pk:Claim ;
    rdfs:label "Armon et al. (2011) Science / Efrati et al. (2009) JMPS Incompatible Shell Elasticity & Chiral Seed Pod Opening (Bauhinia variegata (Orchid tree chiral seed pod valves) & Erythrina corallodendron)",
        "Armon et al. (2011) Science / Efrati et al. (2009) JMPS Incompatible Shell Elasticity & Chiral Seed Pod Opening faithfully reproduces Bauhinia variegata (Orchid tree chiral seed pod valves) & Erythrina corallodendron morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/liang-chiral-seed-pod-opening-1>,
        <https://w3id.org/probknow/resource/math-law/liang-chiral-seed-pod-opening-2>,
        <https://w3id.org/probknow/resource/math-law/liang-chiral-seed-pod-opening-3> ;
    dct:description "The simulation script(s) 2007-liang-chiral-seed-pod-opening.py implement the cited source model as published and produce forms that match real Bauhinia variegata (Orchid tree chiral seed pod valves) & Erythrina corallodendron specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 54.9/100, audit 2026-10-19-chiral-seed-pod-opening-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/2007-liang-chiral-seed-pod-opening.py> ;
    schema:about "Bauhinia variegata (Orchid tree chiral seed pod valves) & Erythrina corallodendron" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2007-liang-chiral-seed-pod-opening.py; output: docs/media/chiral_seed_pod_opening_comparison.png; organism: Bauhinia variegata (Orchid tree chiral seed pod valves) & Erythrina corallodendron; checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 0721ebc9afa69617d711a2d91c13ef54394e8e1f4a186543c993ead8f2e0eebf; artifact_sha256: 565a347e18f3d082b61da91bc7b13667076ca7f24f96f31257d7638fb572b2a9; input_dataset_sha256: {datasets/chiral_seed_pod_opening/bauhinia_chiral_seed_pod_specimen.jpg=047f357961bc58c5..., datasets/chiral_seed_pod_opening/chiral_seed_pod_opening_reference.json=9ba8847c46f708bb..., datasets/chiral_seed_pod_opening/paper_citations.bib=b3a693ac6a538b04..., datasets/chiral_seed_pod_opening/scout_manifest.json=05711e5e7df6cb17...}" ;
    pk:derivedFromPaper <https://doi.org/10.1016/j.jmps.2008.12.004>,
        <https://doi.org/10.1038/nature03185>,
        <https://doi.org/10.1039/c3sm52313f>,
        <https://doi.org/10.1126/science.1203874> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-model-fidelity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-morphometric-validation>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-overall>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-parameter-expressivity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-liang-chiral-seed-pod-opening-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-chiral-seed-pod-opening-audit-liang-chiral-seed-pod-opening-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-chiral-seed-pod-opening-audit-liang-chiral-seed-pod-opening-2> ;
    pk:hypothesisType "Non-Euclidean Incompatible Shell Elasticity, Gauss Incompatibility (det b_0 = -κ_0^2 < 0) & Föppl–von Kármán Helicoid-to-Helical-Ribbon Pitchfork Bifurcation" ;
    pk:weightOfEvidence 5.49e-01 .


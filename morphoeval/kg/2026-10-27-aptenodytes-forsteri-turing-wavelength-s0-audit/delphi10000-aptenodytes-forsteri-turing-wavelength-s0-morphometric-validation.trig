sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg wavelength at the 1.178 mm shell-thickness tier of Aptenodytes forsteri — Morphometric validation: 80/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Self-test on this run: dispersion lambda 1.1767 mm, PDE lambda 1.1685 mm, Pearson r 0.9979, RMSE 0.0301 mm, KS 0.143, pore FFT 0.663 mm against shell thickness 1.11 mm. n=7 for the KS sample is small. Values are not copied onto their references. Pass 1 holds the score at 80 until those numbers are the measurement record." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-specimen-pore-wavelength-mm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-specimen-segment-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-specimen-shell-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-specimen-shell-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-turing-wavelength-pde-mm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-wavelength-sweep-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-wavelength-sweep-rmse-mm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_diffusion_ablation_amplitude_ratio = 0.0039 1" ;
        dct:description "control vs Turing δ=42" ;
        schema:measurementTechnique "negative control: D_u = D_v, amplitude ratio versus the Turing run (ratio baseline 1)" ;
        schema:name "equal_diffusion_ablation_amplitude_ratio" ;
        schema:unitText "1" ;
        schema:value "0.0039" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "ablation null: no growth when the diffusion ratio is removed" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-specimen-pore-wavelength-mm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_pore_wavelength_mm = 0.6628 mm" ;
        dct:description "Photograph pore spacing is not set equal to the model wavelength." ;
        schema:measurementTechnique "radial FFT of high-pass shell texture; scale bar from egg length 121.3 mm; CV of wavelength vs shell thickness" ;
        schema:name "specimen_pore_wavelength_mm" ;
        schema:unitText "mm" ;
        schema:value "0.6628" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-specimen-pore-wavelength-mm-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-specimen-pore-wavelength-mm-reference> a schema:PropertyValue ;
        dct:source "Chinese Journal of Polar Research 20(4):320-328 (2008), mean shell thickness" ;
        schema:value "1.11" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-specimen-segment-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_segment_foreground_fraction = 0.45 1" ;
        schema:measurementTechnique "Otsu-style percentile segmentation of the activator field versus specimen foreground" ;
        schema:name "specimen_segment_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.45" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-specimen-segment-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-specimen-segment-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "MHNT specimen segmentation" ;
        schema:value "0.5347" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-specimen-shell-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_shell_circularity = 0.0299 1" ;
        schema:measurementTechnique "4πA/P² on the simulated spot mask versus the egg silhouette" ;
        schema:name "specimen_shell_circularity" ;
        schema:unitText "1" ;
        schema:value "0.0299" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-specimen-shell-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-specimen-shell-circularity-reference> a schema:PropertyValue ;
        dct:source "MHNT specimen contour" ;
        schema:value "0.7323" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-specimen-shell-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_shell_coherency = 0.3878 1" ;
        schema:measurementTechnique "structure-tensor coherency on the simulated patch versus the segmented specimen" ;
        schema:name "specimen_shell_coherency" ;
        schema:unitText "1" ;
        schema:value "0.3878" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-specimen-shell-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-specimen-shell-coherency-reference> a schema:PropertyValue ;
        dct:source "MHNT Aptenodytes forsteri egg, CC BY-SA 4.0" ;
        schema:value "0.3841" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-turing-wavelength-pde-mm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "turing_wavelength_pde_mm = 1.1685 mm" ;
        schema:measurementTechnique "Fourier peak of the s=1 PDE field; RMSE against the dispersion law" ;
        schema:name "turing_wavelength_pde_mm" ;
        schema:unitText "mm" ;
        schema:value "1.1685" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-turing-wavelength-pde-mm-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-turing-wavelength-pde-mm-reference> a schema:PropertyValue ;
        dct:source "linear dispersion σ(k) fastest mode at δ=42" ;
        schema:value "1.1767" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-wavelength-sweep-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength_sweep_ks_statistic = 0.1429 1" ;
        schema:measurementTechnique "two-sample KS statistic between the law series and the PDE series" ;
        schema:name "wavelength_sweep_ks_statistic" ;
        schema:unitText "1" ;
        schema:value "0.1429" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-wavelength-sweep-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-wavelength-sweep-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "KS critical-value scale; the statistic itself is computed, not copied" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength_sweep_pearson_r = 0.9979 1" ;
        schema:measurementTechnique "Pearson r between dispersion λ(s) and PDE λ(s); RMSE reported alongside" ;
        schema:name "wavelength_sweep_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.9979" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-reference> a schema:PropertyValue ;
        dct:source "MorphoEval gate Pearson r > 0.98" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-wavelength-sweep-rmse-mm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength_sweep_rmse_mm = 0.0301 mm" ;
        schema:measurementTechnique "RMSE of PDE wavelength against the dispersion prediction across commensurate scales" ;
        schema:name "wavelength_sweep_rmse_mm" ;
        schema:unitText "mm" ;
        schema:value "0.0301" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-wavelength-sweep-rmse-mm-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-measurement-wavelength-sweep-rmse-mm-reference> a schema:PropertyValue ;
        dct:source "acceptance ceiling used as a reference, not a fitted target" ;
        schema:value "0.15" .

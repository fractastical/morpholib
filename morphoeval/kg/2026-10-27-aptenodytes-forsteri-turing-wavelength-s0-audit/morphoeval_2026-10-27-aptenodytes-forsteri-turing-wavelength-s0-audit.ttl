<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg wavelength at the 1.178 mm shell-thickness tier of Aptenodytes forsteri — Morphological realism / specimen match: 72/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The growth GIF is 16 frames at 640x480 and ends on the MHNT egg (CV similarity 84.7 against that photograph). The generative panel is a labyrinth at about 1.18 mm, while the egg texture measures 0.66 mm. Those are different patterns. Pass 1 does not treat the terminal frame as proof that the PDE drew the pores." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-specimen-match-1>,

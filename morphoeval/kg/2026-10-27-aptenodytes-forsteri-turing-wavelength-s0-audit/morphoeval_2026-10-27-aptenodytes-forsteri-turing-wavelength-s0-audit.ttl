<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aptenodytes-forsteri-turing-wavelength-s0-source-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg wavelength at the 1.178 mm shell-thickness tier of Aptenodytes forsteri — Source and data traceability: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Turing, Prum and Williamson, Kondo and Miura, and Schnakenberg have DOIs. The egg dimensions are tied to the 2008 Polar Research URL; that page does not name authors, and none were invented. The specimen is Descouens CC BY-SA 4.0 with a SHA-256 pin. The species-gallery spiral was rejected." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability> ;

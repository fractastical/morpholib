        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Diplomystus dentatus detail-tier Turing wavelength (184.3 µm, 51.5 Ma) faithfully reproduces Diplomystus dentatus (Green River Eocene armored herring) morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-diplomystus-dentatus-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Diplomystus dentatus (Green River Eocene armored herring) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-diplomystus-dentatus-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-diplomystus-dentatus-turing-wavelength-s0.py; output: docs/media/diplomystus_dentatus_turing_wavelength_s0_comparison.png; organism: Diplomystus dentatus (Green River Eocene armored herring); environment: n/a; claim_boundary: [reported_in_source: Turing (1952) onset wavenumber k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c. | Schnakenberg (1979) kinetics du/dt = a - u + u^2 v, dv/dt = b - u^2 v. | Grande (1982) redescribes Diplomystus dentatus from the Fossil Butte Member: dorsal scutes usually 22-36, maximum length about 65 cm, ellimmichthyid rather than a clupeid. | Kondo & Asai (1995) and Nakamasu et al. (2009) show teleost skin can select a Turing pigment wavelength. | Smith, Carroll & Singer (2008) reconstruct the Eocene Green River lake system. Descouens' CC BY-SA 4.0 photograph is a Fossil Lake specimen with caption size 48 cm.; reconstructed_in_script: a=0.128, b=0.764, D_v/D_u=9.17, with D_u solved so the onset wavelength is 184.3 µm. Neumann explicit Euler on a flank window. These constants belong to slot 3170, not to the 7.56 mm sibling. | Discrete-Laplacian growth rates versus the analytic eigenvalue (Pearson r = 1.000, RMSE = 0.00033) and a diffusivity sweep of expressed wavelength (Pearson r = 0.997). | Equal-diffusion ablation (linearised std ratio 0.031) and a 20 µm predecessor mode with negative growth rate. | Segmentation of the Descouens photograph: aspect ratio, circularity, and a high-pass major-axis spacing used as an organ-scale contrast to 0.1843 mm.; transfer_boundary: Pigment kinetics are transferred from the teleost Turing literature onto a Diplomystus flank. The 184.3 µm value is the catalogued detail tier, not a melanophore count on the slab. | 51.5 Ma is the Ypresian chronoseries datum. The series contains one Diplomystus age (1/1); the predecessor and successor compared here are scales, not other chronospecies.; does_not_claim: That the fossil photograph resolves 184 µm ocelli, or that a, b, and D were measured in Diplomystus tissue. | That dorsal scute counts (22-36) are the same pattern as the detail-tier wave. | A new radiometric date for Fossil Lake.]; other sources: Grande 1982, American Museum Novitates 2728, revision of Diplomystus <http://hdl.handle.net/2246/5342>; phenomenon_size: 151 µm (0.0001512 m, log10=-3.82 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 151 µm to 34.0 cm): 151 µm:diplomystus-dentatus-bioelectric-polarity, 472 µm:diplomystus-dentatus-vertex-packing, 7.6 mm:diplomystus-dentatus-turing-wavelength, 1.5 cm:diplomystus-dentatus-clock-wavefront, 3.4 cm:diplomystus-dentatus-morphogen-condensation, 4.2 cm:diplomystus-dentatus-elastic-buckling, 4.7 cm:diplomystus-dentatus-flux-canalization, 6.6 cm:diplomystus-dentatus-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1130/B26073.1> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-diplomystus-dentatus-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-diplomystus-dentatus-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


<https://w3id.org/delphi/resource/math-law/delphi10000-diplomystus-dentatus-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Sub-wavelength predecessor" ;
    dct:description "A chromatophore-sized predecessor domain cannot hold a half-wave of this mode. | Variables: L_cell = 20 µm, lambda_c = 184.3 µm" ;
    dct:source "Murray (1981) 10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-diplomystus-dentatus-turing-wavelength-s0.py#L294-L297>,

        pk:Concept ;
    rdfs:label "Flank window mode count" ;
    dct:description "The detail window fits sixteen onset waves and zero organ-tier waves. | Variables: L = 2.9488 mm" ;
    dct:source "Turing (1952) 10.1098/rstb.1952.0012" ;

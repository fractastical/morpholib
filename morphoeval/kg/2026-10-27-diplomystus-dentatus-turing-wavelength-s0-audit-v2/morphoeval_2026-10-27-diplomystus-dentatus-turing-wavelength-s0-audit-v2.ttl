<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Diplomystus dentatus detail-tier Turing wavelength (184.3 µm, 51.5 Ma) — Model fidelity to source: 90/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script integrates the Schnakenberg system and the onset formula, and the discrete Laplacian reproduces analytic growth rates at r=1.000. Kinetics are a transfer, not a Diplomystus measurement, so this is not a perfect source identity." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 9e-01 ;
    pk:hasVerdict "faithful" .


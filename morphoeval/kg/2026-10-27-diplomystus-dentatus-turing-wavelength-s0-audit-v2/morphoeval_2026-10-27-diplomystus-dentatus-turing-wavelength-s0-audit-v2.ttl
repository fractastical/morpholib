<https://w3id.org/delphi/resource/math-law/delphi10000-diplomystus-dentatus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Onset wavenumber" ;
    dct:description "Detail-tier wavelength. Shorter than the 7.56 mm organ-tier successor of the same chronospecies. | Variables: D_u and D_v solved so lambda_c = 184.3 µm at D_v/D_u = 9.17" ;
    dct:source "Turing (1952) 10.1098/rstb.1952.0012; Schnakenberg (1979) 10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-diplomystus-dentatus-turing-wavelength-s0.py#L62-L82>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3170_diplomystus_dentatus_turing_wavelength_s0.lean#L13-L24> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v),  lambda_c = 2 pi / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1130/B26073.1> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3170.lambdaDetailUmX10" ;
    pk:leanTheorem "MathOfBiology.Loop_3170.detail_wavelength_shorter_than_organ_successor" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-diplomystus-dentatus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Wavenumber ratio against the organ-tier successor" ;
    dct:description "What changes at this scale versus the 7.56 mm sibling, not versus another chronospecies (series is 1/1). | Variables: lambda_organ = 7.56 mm, lambda_detail = 184.3 µm" ;
    dct:source "Murray (1981) 10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-diplomystus-dentatus-turing-wavelength-s0.py#L66-L67>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3170_diplomystus_dentatus_turing_wavelength_s0.lean#L27-L29> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_detail / k_organ = lambda_organ / lambda_detail > 41" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1130/B26073.1> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3170.lambdaOrganUmX10" ;
    pk:leanTheorem "MathOfBiology.Loop_3170.detail_wavenumber_exceeds_organ_successor_fortyfold" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-diplomystus-dentatus-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diffusivity-ratio threshold" ;
    dct:description "Inhibitor must diffuse fast enough for a finite-k instability. | Variables: ratio 9.17, f_u ≈ 0.713, g_v ≈ -0.796" ;
    dct:source "Turing (1952) 10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-diplomystus-dentatus-turing-wavelength-s0.py#L74-L81>,

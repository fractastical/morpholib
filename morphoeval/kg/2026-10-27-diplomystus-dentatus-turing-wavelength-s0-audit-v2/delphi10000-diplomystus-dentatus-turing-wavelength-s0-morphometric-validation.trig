sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Diplomystus dentatus detail-tier Turing wavelength (184.3 µm, 51.5 Ma) — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Wavelength 186.0 versus 184.3 µm, dispersion RMSE 0.00033, sweep r=0.997, KS 0.135, flank spacing 6.33 mm versus 0.1843 mm, and a five-transect placement std of 11.7 mm. The anisotropy trial (212 µm) is reported as a failed alternative, not folded into the fit." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-20-m-predecessor-mode-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-diffusivity-sweep-wavelength-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-discrete-laplacian-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-dispersion-growth-rate-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-flank-radial-fft-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-nonlinear-equal-diffusion-ablation-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-rejected-dorsoventral-anisotropy-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-specimen-flank-spacing-resample-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-specimen-flank-vertical-element-spacing>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-specimen-mask-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-specimen-versus-field-orientation-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-20-m-predecessor-mode-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "20 µm predecessor-mode growth rate = -5.958628 1/time" ;
        dct:description "negative σ: the cell-scale predecessor cannot carry the 184.3 µm wave" ;
        schema:measurementTechnique "analytic σ at the lowest Neumann wavenumber k=π/L on a 20 µm chromatophore" ;
        schema:name "20 µm predecessor-mode growth rate" ;
        schema:unitText "1/time" ;
        schema:value "-5.958628" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-20-m-predecessor-mode-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-20-m-predecessor-mode-growth-rate-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-diffusivity-sweep-wavelength-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffusivity-sweep wavelength Pearson r = 0.997235 1" ;
        dct:description "sweep RMSE 5.67 µm" ;
        schema:measurementTechnique "Pearson r of predicted s*184.3 µm versus measured λ when both diffusivities scale by s^2, s in {0.72,0.88,1,1.18,1.46}" ;
        schema:name "diffusivity-sweep wavelength Pearson r" ;
        schema:unitText "1" ;
        schema:value "0.997235" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-diffusivity-sweep-wavelength-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-diffusivity-sweep-wavelength-pearson-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-discrete-laplacian-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "discrete-Laplacian dispersion Pearson r = 1.0 1" ;
        dct:description "n=11 modes, RMSE=0.00033 per time unit" ;
        schema:measurementTechnique "Pearson r between analytic σ(k) using k^2=(2-2cos q)/dx^2 and growth of pure modes in the explicit periodic scheme" ;
        schema:name "discrete-Laplacian dispersion Pearson r" ;
        schema:unitText "1" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-discrete-laplacian-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-discrete-laplacian-dispersion-pearson-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-dispersion-growth-rate-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion growth-rate RMSE = 0.00033 1/time" ;
        dct:description "nonzero because of the explicit Euler transient and the quadratic term at finite amplitude" ;
        schema:measurementTechnique "RMSE of measured versus analytic σ on the same discrete modes" ;
        schema:name "dispersion growth-rate RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.00033" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-dispersion-growth-rate-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-dispersion-growth-rate-rmse-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation std ratio = 0.031474 1" ;
        dct:description "control: ratio near 0 means the homogeneous state is restored; ratio 1 would be a failed ablation" ;
        schema:measurementTechnique "final/initial std of a linearised perturbation when D_v is set equal to D_u (Turing band removed)" ;
        schema:name "equal-diffusion ablation std ratio" ;
        schema:unitText "1" ;
        schema:value "0.031474" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-flank-radial-fft-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "flank radial-FFT wavelength = 186.0387 µm" ;
        dct:description "relative error 0.0094; D_u=2.694010e-10 m^2/s, D_v/D_u=9.17" ;
        schema:measurementTechnique "power-weighted radial FFT peak of the Neumann Schnakenberg field; D_u solved so onset λ_c=184.3 µm" ;
        schema:name "flank radial-FFT wavelength" ;
        schema:unitText "µm" ;
        schema:value "186.0387" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-flank-radial-fft-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-flank-radial-fft-wavelength-reference> a schema:PropertyValue ;
        schema:value "184.3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-nonlinear-equal-diffusion-ablation-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nonlinear equal-diffusion ablation std ratio = 0.118462 1" ;
        dct:description "stays inside the fixed-point basin; distinct from the linearised ablation" ;
        schema:measurementTechnique "final/initial std of a 1e-5 cubic perturbation with D_v = D_u and dt=0.02" ;
        schema:name "nonlinear equal-diffusion ablation std ratio" ;
        schema:unitText "1" ;
        schema:value "0.118462" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-nonlinear-equal-diffusion-ablation-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-nonlinear-equal-diffusion-ablation-std-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-rejected-dorsoventral-anisotropy-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "rejected dorsoventral anisotropy wavelength = 212.413 µm" ;
        dct:description "accepted=False. The isotropic field is kept because the trial leaves the onset wavelength." ;
        schema:measurementTechnique "radial FFT after Dy/Dx = 1.8; accepted only if relative error < 0.08" ;
        schema:name "rejected dorsoventral anisotropy wavelength" ;
        schema:unitText "µm" ;
        schema:value "212.413" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-rejected-dorsoventral-anisotropy-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-rejected-dorsoventral-anisotropy-wavelength-reference> a schema:PropertyValue ;
        schema:value "184.3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-specimen-flank-spacing-resample-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen flank spacing resample std = 11.6676 mm" ;
        dct:description "placement uncertainty on the 48 cm caption calibration; not a second copy of the mean spacing" ;
        schema:measurementTechnique "std of high-pass spacing across five transects offset along the minor axis (±0, 4, 8 px)" ;
        schema:name "specimen flank spacing resample std" ;
        schema:unitText "mm" ;
        schema:value "11.6676" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-specimen-flank-spacing-resample-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-specimen-flank-spacing-resample-std-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-specimen-flank-vertical-element-spacing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen flank vertical-element spacing = 6.329 mm" ;
        dct:description "reference is the 184.3 µm detail wave expressed in mm. The fossil transect resolves organ-scale ribs/scutes, not the primordium wave. Value differs from the reference on purpose." ;
        schema:measurementTechnique "high-pass FFT along the PCA major axis of the segmented Descouens fish; 48 cm caption length calibrates the axis" ;
        schema:name "specimen flank vertical-element spacing" ;
        schema:unitText "mm" ;
        schema:value "6.329" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-specimen-flank-vertical-element-spacing-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-specimen-flank-vertical-element-spacing-reference> a schema:PropertyValue ;
        schema:value "0.1843" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-specimen-mask-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen mask aspect ratio = 1.4743 1" ;
        dct:description "foreground fraction 0.934, circularity 0.119" ;
        schema:measurementTechnique "major/minor PCA extents of the segmented fossil versus a circular null" ;
        schema:name "specimen mask aspect ratio" ;
        schema:unitText "1" ;
        schema:value "1.4743" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-specimen-mask-aspect-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-specimen-mask-aspect-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-specimen-versus-field-orientation-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen-versus-field orientation KS statistic = 0.135 1" ;
        dct:description "p=1.45e-30. The fossil is dominated by sub-vertical ribs; the ocellus field is not a copy of that histogram." ;
        schema:measurementTechnique "two-sample KS on Sobel orientation of the fossil versus the simulated flank field" ;
        schema:name "specimen-versus-field orientation KS statistic" ;
        schema:unitText "1" ;
        schema:value "0.135" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-specimen-versus-field-orientation-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-measurement-specimen-versus-field-orientation-ks-statistic-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-diplomystus-dentatus-turing-wavelength-s0.py L373–L401" ;
        dct:description "Transect spacing and offsets" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-diplomystus-dentatus-turing-wavelength-s0.py#L373-L401> .

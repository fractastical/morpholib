sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Anolis carolinensis Schnakenberg wavelength at 101.1 µm (Holocene, 0 Ma) — Parameter expressivity: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Six targets from 72 to 168 µm, D_u rescaled so the onset wavelength equals the target, produce measured peaks 69.91, 83.50, 98.17, 114.57, 135.94, 163.12 µm. The map is monotone and linear (r = 1.0) with a stable 0.971 factor." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

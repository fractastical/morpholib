    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_foreground_fraction = 0.6012 1" ;

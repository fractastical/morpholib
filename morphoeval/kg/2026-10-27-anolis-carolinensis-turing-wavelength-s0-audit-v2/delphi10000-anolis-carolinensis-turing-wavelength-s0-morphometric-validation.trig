        schema:unitText "µm" ;
        schema:value "99.8204" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-specimen-melanophore-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-specimen-melanophore-wavelength-reference> a schema:PropertyValue ;

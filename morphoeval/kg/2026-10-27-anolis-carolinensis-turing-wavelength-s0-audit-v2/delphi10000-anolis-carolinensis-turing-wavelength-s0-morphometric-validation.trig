sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Anolis carolinensis Schnakenberg wavelength at 101.1 µm (Holocene, 0 Ma) — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Headline error is RMSE 3.45 µm, the proportional 0.971 bias, not the Pearson coefficient. KS = 0.167 (p ≈ 1 at n = 6) does not separately detect that small shift. Ablation ratio 1219.9 with h < 0. Specimen coherency 0.6275 versus rendered-field coherency 0.5308. Cellular predecessor mode count 0 versus 8 on the primordium patch. Values are not copies of their references." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-ablation-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-cellular-predecessor-mode-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-dispersion-curve-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-neumann-patch-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-specimen-melanophore-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-wavelength-sweep-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-wavelength-sweep-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-ablation-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_amplitude_ratio = 1219.8542 1" ;
        schema:measurementTechnique "std(patterned)/std(ablation control) at equal D_u; ablation h = D(f_u+g_v) < 0" ;
        schema:name "ablation_amplitude_ratio" ;
        schema:unitText "1" ;
        schema:value "1219.8542" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-ablation-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-ablation-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "null control D_v = D_u (no Turing instability) would match the patterned amplitude" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-cellular-predecessor-mode-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cellular_predecessor_mode_count = 0 1" ;
        schema:measurementTechnique "integer mode count on a 40 µm cellular predecessor domain versus this 101.1 µm wavelength" ;
        schema:name "cellular_predecessor_mode_count" ;
        schema:unitText "1" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-cellular-predecessor-mode-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-cellular-predecessor-mode-count-reference> a schema:PropertyValue ;
        dct:source "eight modes in the 808.8 µm primordium patch (L/λ_c)" ;
        schema:value "8" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-dispersion-curve-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_curve_pearson_r = 0.994149 1" ;
        schema:measurementTechnique "Pearson r of analytical dispersion against early Fourier growth of a 10^-4 perturbation" ;
        schema:name "dispersion_curve_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.994149" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-reference> a schema:PropertyValue ;
        dct:source "linear σ(k) of J-k^2 D" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-neumann-patch-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "neumann_patch_wavelength = 103.9581 µm" ;
        schema:measurementTechnique "reflect-padded Laplacian control vs periodic hero run" ;
        schema:name "neumann_patch_wavelength" ;
        schema:unitText "µm" ;
        schema:value "103.9581" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-neumann-patch-wavelength-reference> .

        schema:name "specimen_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.6012" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "neutral fill; the photograph is not a half-empty mask" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0-measurement-specimen-melanophore-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_melanophore_wavelength = 99.8204 µm" ;

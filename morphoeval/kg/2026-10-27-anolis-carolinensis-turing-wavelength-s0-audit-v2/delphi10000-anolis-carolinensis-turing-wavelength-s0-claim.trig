sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-anolis-carolinensis-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Anolis carolinensis Schnakenberg wavelength at 101.1 µm (Holocene, 0 Ma) faithfully reproduces Anolis carolinensis (green anole) morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-anolis-carolinensis-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Anolis carolinensis (green anole) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-anolis-carolinensis-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-anolis-carolinensis-turing-wavelength-s0.py; output: docs/media/anolis_carolinensis_turing_wavelength_s0_comparison.png; organism: Anolis carolinensis (green anole); environment: n/a; claim_boundary: [reported_in_source: Turing 1952: diffusion-driven instability and a critical wavenumber. | Schnakenberg 1979: du/dt = a - u + u^2 v, dv/dt = b - u^2 v. | Alexander & Fahrenbach 1969: xanthophore, iridophore and basal melanophore layers in A. carolinensis; melanin in the processes turns the skin from green toward brown. | Taylor & Hadley 1970: physiological melanosome migration, not a new wavelength, is the colour-change mechanism inside one melanophore.; reconstructed_in_script: D_u and D_v are chosen so k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v) equals (2π/101.1 µm)^2. | Eight wavelengths on an 808.8 µm patch; a 40 µm cellular predecessor holds zero critical modes. | The nonlinear FFT peak sits at 0.971 of the onset wavelength on every swept target. That factor is the reported residual.; transfer_boundary: Fofonjka & Milinkovitch 2021 (Timon scale borders quantising RD into a cellular automaton) is the organ-scale successor, not this intra-scale 101.1 µm patch.; does_not_claim: That Alexander & Fahrenbach measured 101.1 µm as a Turing wavelength. | That the rendered spot field is a photograph of the animal. CV similarity 88.9 is a texture score, not an identity claim. | A fossil chronospecies. The series is Holocene only (1/1, 0 Ma).]; phenomenon_size: 146 µm (0.0001459 m, log10=-3.836 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 146 µm to 22.8 cm): 146 µm:anolis-carolinensis-bioelectric-polarity, 512 µm:anolis-carolinensis-vertex-packing, 5.1 mm:anolis-carolinensis-turing-wavelength, 9.2 mm:anolis-carolinensis-clock-wavefront, 3.1 cm:anolis-carolinensis-morphogen-condensation, 4.0 cm:anolis-carolinensis-flux-canalization, 4.3 cm:anolis-carolinensis-elastic-buckling, 5.2 cm:anolis-carolinensis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1002/aja.1001260105>,
            <https://doi.org/10.1007/BF00309737>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/s41467-021-22525-1>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-anolis-carolinensis-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-anolis-carolinensis-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/aja.1001260105>,
            <https://doi.org/10.1007/BF00309737>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/s41467-021-22525-1>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://doi.org/10.1002/aja.1001260105> dct:title "Alexander & Fahrenbach 1969, The dermal chromatophores of Anolis carolinensis" .
    <https://doi.org/10.1007/BF00309737> dct:title "Taylor & Hadley 1970, Chromatophores and color change in Anolis carolinensis" .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:title "Schnakenberg 1979, Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1038/s41467-021-22525-1> dct:title "Fofonjka & Milinkovitch 2021, Reaction-diffusion on growing skin scales" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "Turing 1952, The chemical basis of morphogenesis" .
}


<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-anolis-carolinensis-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-anolis-carolinensis-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-anolis-carolinensis-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-anolis-carolinensis-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homogeneous stability of the Schnakenberg fixed point" ;
    dct:description "Without diffusion the 101.1 µm dermal patch stays uniform. A wavelength is not selected by the reaction alone. | Variables: f_u = 0.89, g_v = -1, det J = 1, trace J = -0.11" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-anolis-carolinensis-turing-wavelength-s0.py#L92-L110>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3112_anolis_carolinensis_turing_wavelength_s0.lean#L26-L30> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "trace(J) = f_u + g_v < 0 and det(J) = f_u g_v - f_v g_u > 0 at (a, b) = (0.055, 0.945)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/aja.1001260105>,
        <https://doi.org/10.1007/BF00309737>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/s41467-021-22525-1>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3112.traceMilli" ;
    pk:leanTheorem "MathOfBiology.Loop_3112.homogeneous_stable_without_diffusion" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-anolis-carolinensis-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber at 101.1 µm" ;
    dct:description "Places the onset wavelength on the assigned tier-5 detail scale, inside one dorsal scale rather than on the whole animal. | Variables: ratio 8.2 above onset (~7.12); discriminant (r f_u + g_v)^2 - 4 r det > 0" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-anolis-carolinensis-turing-wavelength-s0.py#L104-L118>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3112_anolis_carolinensis_turing_wavelength_s0.lean#L33-L42> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c = 101.1 µm, with D_v/D_u = 8.2" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/aja.1001260105>,
        <https://doi.org/10.1007/BF00309737>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/s41467-021-22525-1>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3112.ratioTenths" ;
    pk:leanTheorem "MathOfBiology.Loop_3112.diffusion_driven_instability" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-anolis-carolinensis-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Mode count versus the cellular predecessor" ;
    dct:description "At 0 Ma the chronoseries has no fossil predecessor. The scale predecessor cannot fit k_c; this patch can. | Variables: primordium patch 808 µm; cellular predecessor 40 µm; Holocene age 0 Ma" ;
    dct:source "Alexander and Fahrenbach (1969) DOI:10.1002/aja.1001260105" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-anolis-carolinensis-turing-wavelength-s0.py#L544-L556>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3112_anolis_carolinensis_turing_wavelength_s0.lean#L48-L56> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = floor(L / lambda_c); N(808 µm) = 8 and N(40 µm) = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/aja.1001260105>,
        <https://doi.org/10.1007/BF00309737>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/s41467-021-22525-1>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3112.modeCount" ;
    pk:leanTheorem "MathOfBiology.Loop_3112.cellular_predecessor_fits_no_critical_mode" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


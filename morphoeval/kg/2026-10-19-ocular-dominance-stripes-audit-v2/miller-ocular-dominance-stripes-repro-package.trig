sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-miller-ocular-dominance-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Miller, Keller & Stryker (1989) & Hubel, Wiesel & LeVay (1977) ocular dominance column development & plasticity — Reproducibility package: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Deterministic execution (`seed=1989`), standalone 8-check `--self-test` suite verifying SHA-256 dataset locks, Lean 4 algebraic invariants, all 5 experimental regimes, 6-point `sigma_I` wavelength scaling, dual-specimen CV segmentation, and bitwise two-run determinism (`atol=0.0`), plus rendered 9-panel PNG and 24-frame GIF in `docs/media/`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-repro-package-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1989-miller-ocular-dominance-stripes.py L546–L615" ;
        dct:description "8-check deterministic --self-test suite verifying SHA-256 locks, Lean 4 invariants, 5 regimes, CV segmentation, and bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L546-L615> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/ocular_dominance_stripes_growth.gif (generated output)" ;
        dct:description "24-frame animated GIF comparing Normal Binocular 50/50 stripe emergence vs Monocular Deprivation island shrinkage — docs/media/ocular_dominance_stripes_growth.gif: rendered output of 1989-miller-ocular-dominance-stripes.py at 317bc3c, image/gif, 1847372 B, 864×387 px, 24 frames, artifact_sha256 1ef27c3ba5ecadd079a30a90ead83a0856a4a24e5d2082244ba1f03e0060e85f (sha256 1ef27c3ba5ecadd079a30a90ead83a0856a4a24e5d2082244ba1f03e0060e85f), spec_fingerprint 819128bbec5b994d73c8b186f4a86b2d2df6149663f61bdaf866cb36447d290f" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


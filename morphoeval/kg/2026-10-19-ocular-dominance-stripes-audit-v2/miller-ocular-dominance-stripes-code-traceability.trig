sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-miller-ocular-dominance-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Miller, Keller & Stryker (1989) & Hubel, Wiesel & LeVay (1977) ocular dominance column development & plasticity — Code-to-model traceability: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Every computational function and docstring maps directly to Miller, Keller & Stryker (1989) Eqs. 1-6, Swindale (1980), Hubel, Wiesel & LeVay (1977), and the 3 Lean 4 theorems in `Loop_087_ocular_dominance_stripes.lean` and `morphoeval/math_kg_loops/miller-ocular-dominance-stripes.yaml`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-code-traceability-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1989-miller-ocular-dominance-stripes.py L1–L31" ;
        dct:description "Module docstring mapping ocular dominance equations and plasticity regimes to Lean 4 theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L1-L31> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/miller-ocular-dominance-stripes.yaml L1–L127" ;
        dct:description "Math KG loop registration linking equations, Lean 4 theorems, and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/math_kg_loops/miller-ocular-dominance-stripes.yaml#L1-L127> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


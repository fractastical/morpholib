sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-miller-ocular-dominance-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Miller, Keller & Stryker (1989) & Hubel, Wiesel & LeVay (1977) ocular dominance column development & plasticity — Morphometric validation: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Extracts 6 reference-anchored quantitative measurements via `measure_morphoeval()` (L469-540): normal binocular 2D FFT stripe wavelength (`806.19 um` vs `800.26 um` analytical reference), normal binocular left-eye fraction (`0.5036` vs `0.50` reference), Hubel-Wiesel monocular deprivation deprived-eye fraction (`0.2533` vs `0.24` reference), strabismus broadened wavelength (`883.82 um` vs `895.0 um` reference), inhibition range `sigma_I` wavelength scaling correlation (`r = 0.9970`, `RMSE = 13.36 um`), and specimen CV stripe fraction (`0.5000`, `71` branchpoints)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-hubel-wiesel-critical-period-monocular-deprivation-md-deprived-eye-territory-fraction-f-l>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-intracortical-inhibition-range-sigma-i-vs-simulated-column-wavelength-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-normal-binocular-2d-fft-characteristic-ocular-dominance-stripe-wavelength-lambda-emp>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-normal-binocular-left-eye-cortical-territory-fraction-f-l>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-strabismus-interocular-decorrelation-broadened-stripe-wavelength-lambda-strab>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-tangential-odc-specimen-cv-stripe-territory-fraction-f-l-and-branchpoint-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-morphometric-validation-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-hubel-wiesel-critical-period-monocular-deprivation-md-deprived-eye-territory-fraction-f-l> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hubel-Wiesel critical-period monocular deprivation (MD) deprived-eye territory fraction f_L = 0.2533 area fraction" ;
        dcterms:description "Deprived eye f_L = 0.2533 vs expanded open eye f_R = 0.7467 (reverse suture rescue restores f_L = 0.6963)" ;
        schema:measurementTechnique "Fraction of V1 Layer IVC occupied by deprived Left-eye stripes (S_Delta > 0) under monocular lid suture (b_MD = -0.36)" ;
        schema:name "Hubel-Wiesel critical-period monocular deprivation (MD) deprived-eye territory fraction f_L" ;
        schema:unitText "area fraction" ;
        schema:value "0.2533" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-hubel-wiesel-critical-period-monocular-deprivation-md-deprived-eye-territory-fraction-f-l-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-hubel-wiesel-critical-period-monocular-deprivation-md-deprived-eye-territory-fraction-f-l-reference> a schema:PropertyValue ;
        dcterms:source "Hubel, Wiesel & LeVay (1977) Phil. Trans. R. Soc. B 278:377-409 Figs. 14-22 (Lean 4 hubel_wiesel_md_and_ttx_blockade)" ;
        schema:value "0.24" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-intracortical-inhibition-range-sigma-i-vs-simulated-column-wavelength-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Intracortical inhibition range sigma_I vs simulated column wavelength Pearson correlation r = 0.997 Pearson r" ;
        dcterms:description "6-point sigma_I sweep Pearson r = 0.9970 (RMSE = 13.67 um across 622-1077 um)" ;
        schema:measurementTechnique "Linear correlation between analytical Mexican-hat wavelength lambda_c(sigma_I) and 2D FFT simulated wavelength across 6-point sigma_I sweep (170-290 um)" ;
        schema:name "Intracortical inhibition range sigma_I vs simulated column wavelength Pearson correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.997" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-intracortical-inhibition-range-sigma-i-vs-simulated-column-wavelength-pearson-correlation-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-intracortical-inhibition-range-sigma-i-vs-simulated-column-wavelength-pearson-correlation-r-reference> a schema:PropertyValue ;
        dcterms:source "Miller, Keller & Stryker (1989) Science 245:605-615 Fig. 4 (linear scaling of column width with lateral interaction range)" ;
        schema:value "0.995" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-normal-binocular-2d-fft-characteristic-ocular-dominance-stripe-wavelength-lambda-emp> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Normal binocular 2D FFT characteristic ocular dominance stripe wavelength lambda_emp = 806.21 um" ;
        dcterms:description "Simulated lambda_emp = 806.21 um vs analytical lambda_c = 800.26 um (single-eye column width = 403.1 um, S_Sigma conservation error = 2.00e-15)" ;
        schema:measurementTechnique "Power-weighted dominant 2D FFT wavelength 2*pi / k_dom of normal binocular S_Delta(x,y) on 6400x6400 um V1 sheet" ;
        schema:name "Normal binocular 2D FFT characteristic ocular dominance stripe wavelength lambda_emp" ;
        schema:unitText "um" ;
        schema:value "806.21" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-normal-binocular-2d-fft-characteristic-ocular-dominance-stripe-wavelength-lambda-emp-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-normal-binocular-2d-fft-characteristic-ocular-dominance-stripe-wavelength-lambda-emp-reference> a schema:PropertyValue ;
        dcterms:source "Miller, Keller & Stryker (1989) Science 245:605-615; Hubel, Wiesel & LeVay (1977) Phil. Trans. R. Soc. B 278:377-409 (Lean 4 swindale_miller_bandpass_wavelength)" ;
        schema:value "800.26" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-normal-binocular-left-eye-cortical-territory-fraction-f-l> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Normal binocular left-eye cortical territory fraction f_L = 0.5036 area fraction" ;
        dcterms:description "Normal f_L = 0.5036 (f_R = 0.4964, segregation index = 0.7521)" ;
        schema:measurementTechnique "Fraction of V1 Layer IVC grid points with S_Delta(x,y) > 0 under symmetric binocular input (C_Delta = 0.80, b_MD = 0)" ;
        schema:name "Normal binocular left-eye cortical territory fraction f_L" ;
        schema:unitText "area fraction" ;
        schema:value "0.5036" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-normal-binocular-left-eye-cortical-territory-fraction-f-l-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-normal-binocular-left-eye-cortical-territory-fraction-f-l-reference> a schema:PropertyValue ;
        dcterms:source "Hubel, Wiesel & LeVay (1977) Phil. Trans. R. Soc. B 278:377-409; Swindale (1980) Proc. R. Soc. B 208:243-264" ;
        schema:value "0.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-strabismus-interocular-decorrelation-broadened-stripe-wavelength-lambda-strab> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Strabismus interocular decorrelation broadened stripe wavelength lambda_strab = 883.85 um" ;
        dcterms:description "Strabismic wavelength = 883.85 um (sharpened segregation index = 0.9785 vs TTX blockade unsegregated SI = 0.0029)" ;
        schema:measurementTechnique "2D FFT dominant wavelength under strabismic interocular decorrelation (C_Delta = 1.25, sigma_I = 244 um)" ;
        schema:name "Strabismus interocular decorrelation broadened stripe wavelength lambda_strab" ;
        schema:unitText "um" ;
        schema:value "883.85" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-strabismus-interocular-decorrelation-broadened-stripe-wavelength-lambda-strab-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-strabismus-interocular-decorrelation-broadened-stripe-wavelength-lambda-strab-reference> a schema:PropertyValue ;
        dcterms:source "Miller, Keller & Stryker (1989) Science 245:605-615; Lowel (1994) J. Neurosci. 14:7451-7468 (broadened strabismic columns)" ;
        schema:value "895.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-tangential-odc-specimen-cv-stripe-territory-fraction-f-l-and-branchpoint-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Tangential ODC specimen CV stripe territory fraction f_L and branchpoint count = 0.5 area fraction" ;
        dcterms:description "Specimen f_L = 0.5000, spectral peak = 16 cycles (22.75 px/cycle = 800.0 um), N = 71 Y-branchpoints, V1 Layer 4C peak depth s* = 0.35" ;
        schema:measurementTechnique "Automated CV median thresholding, 2D Hanning FFT radial spectrum, and medial-ridge branchpoint extraction on odc_tangential_pattern_specimen.png" ;
        schema:name "Tangential ODC specimen CV stripe territory fraction f_L and branchpoint count" ;
        schema:unitText "area fraction" ;
        schema:value "0.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-tangential-odc-specimen-cv-stripe-territory-fraction-f-l-and-branchpoint-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-tangential-odc-specimen-cv-stripe-territory-fraction-f-l-and-branchpoint-count-reference> a schema:PropertyValue ;
        dcterms:source "Tangential V1 ODC stripe pattern (Wikimedia Commons File:ODCsim.png, CC BY-SA 3.0) & Macaca mulatta V1 Nissl section (CC0)" ;
        schema:value "0.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1989-miller-ocular-dominance-stripes.py L469–L540" ;
        dcterms:description "6 quantitative MorphoEval measurements with references, S_Sigma conservation check, and TTX/reverse-suture deltas" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L469-L540> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


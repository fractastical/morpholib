sub1:provenance {
    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1098/rspb.1980.0051>,
            <https://doi.org/10.1098/rstb.1977.0050>,
            <https://doi.org/10.1126/science.2762813>,
            <https://doi.org/10.1523/JNEUROSCI.06-08-02117.1986> .

    <https://doi.org/10.1098/rspb.1980.0051> dcterms:date "1980"^^xsd:gYear ;
        dcterms:title "A model for the formation of ocular dominance stripes" .

    <https://doi.org/10.1098/rstb.1977.0050> dcterms:date "1977"^^xsd:gYear ;
        dcterms:title "Plasticity of ocular dominance columns in monkey striate cortex" .

    <https://doi.org/10.1126/science.2762813> dcterms:date "1989"^^xsd:gYear ;
        dcterms:title "Ocular dominance column development: analysis and simulation" .

    <https://doi.org/10.1523/JNEUROSCI.06-08-02117.1986> dcterms:date "1986"^^xsd:gYear ;
        dcterms:title "Binocular impulse blockade prevents the formation of ocular dominance columns in cat visual cortex" .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-miller-ocular-dominance-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Miller, Keller & Stryker (1989) & Hubel, Wiesel & LeVay (1977) ocular dominance column development & plasticity — Code-to-model traceability: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Every computational function and docstring maps directly to Miller, Keller & Stryker (1989) Eqs. 1-6, Swindale (1980), Hubel, Wiesel & LeVay (1977), and the 3 Lean 4 theorems in `Loop_087_ocular_dominance_stripes.lean` and `morphoeval/math_kg_loops/miller-ocular-dominance-stripes.yaml`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-code-traceability-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1989-miller-ocular-dominance-stripes.py L1–L31" ;
        dcterms:description "Module docstring mapping ocular dominance equations and plasticity regimes to Lean 4 theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L1-L31> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/miller-ocular-dominance-stripes.yaml L1–L127" ;
        dcterms:description "Math KG loop registration linking equations, Lean 4 theorems, and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/math_kg_loops/miller-ocular-dominance-stripes.yaml#L1-L127> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


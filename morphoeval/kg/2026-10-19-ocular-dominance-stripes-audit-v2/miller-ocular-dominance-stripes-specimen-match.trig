sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-miller-ocular-dominance-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Miller, Keller & Stryker (1989) & Hubel, Wiesel & LeVay (1977) ocular dominance column development & plasticity — Morphological realism / specimen match: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies both the tangential V1 ocular dominance pattern (`odc_tangential_pattern_specimen.png`, CC BY-SA 3.0) and the *Macaca mulatta* V1 striate cortex Nissl section (`macaque_striate_cortex_specimen.jpg`, CC0 BrainMaps.org), automatically segmenting left/right stripe territories (`f_L = 0.5000`), 2D Hanning FFT spectral peak (`16` cycles, `22.75 px/cycle = 800.0 um`), `N = 71` Y-shaped labyrinthine branchpoints, and the V1 Layer IVC granular optical density peak (`s* = 0.35`, `segment_odc_and_v1_specimens`, L253-325)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-specimen-match-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1989-miller-ocular-dominance-stripes.py L253–L325" ;
        dct:description "Dual-specimen CV pipeline segmenting ODC stripe territories, 2D FFT wavelength, 71 branchpoints, and V1 Layer 4C laminar profile" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L253-L325> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/ocular_dominance_stripes_comparison.png (generated output)" ;
        dct:description "9-panel dark-mode comparison figure with tangential ODC branchpoint overlay and macaque V1 Layer IVC laminar profile — docs/media/ocular_dominance_stripes_comparison.png: rendered output of 1989-miller-ocular-dominance-stripes.py at 317bc3c, image/png, 1765310 B, 2227×1863 px, artifact_sha256 d9836de9bccac0673460f380c616ad3321ffc7b4d515cc99a0a2314c303799eb (sha256 d9836de9bccac0673460f380c616ad3321ffc7b4d515cc99a0a2314c303799eb), spec_fingerprint 819128bbec5b994d73c8b186f4a86b2d2df6149663f61bdaf866cb36447d290f" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


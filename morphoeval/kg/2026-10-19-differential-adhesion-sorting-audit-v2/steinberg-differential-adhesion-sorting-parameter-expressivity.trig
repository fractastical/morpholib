sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-steinberg-differential-adhesion-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Steinberg (1963, 1970) & Graner-Glazier (1992) differential adhesion cell sorting — Parameter expressivity: 89/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Simulates all 5 distinct thermodynamic regimes (Panels A1-A5), executes a 7-point continuous parameter sweep (`run_gamma_ab_sweep`, L448-482) across J_AB in {4, 7, 9, 11, 13, 15, 17} spanning gamma_AB in [-4, +9] across both phase boundaries (Panel B2), and exposes full CLI flags (`--J-AA`, `--J-BB`, `--J-AB`, `--J-AM`, `--J-BM`, `--A0`, `--lam`, `--T`, `--mcs`, `--seed`, L1007-1040)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1964-steinberg-differential-adhesion-sorting.py L448–L482" ;
        dct:description "7-point continuous J_AB / gamma_AB sweep across mixing, complete engulfment, and partial engulfment boundaries" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1964-steinberg-differential-adhesion-sorting.py#L448-L482> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1964-steinberg-differential-adhesion-sorting.py L1007–L1040" ;
        dct:description "Full CLI parameter interface wired into run_all_regimes_and_render" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1964-steinberg-differential-adhesion-sorting.py#L1007-L1040> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


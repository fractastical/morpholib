sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-steinberg-differential-adhesion-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1964-steinberg-differential-adhesion-sorting.py L947–L1004" ;
        dcterms:description "8-check self_test() suite including SHA-256 check and two-run bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1964-steinberg-differential-adhesion-sorting.py#L947-L1004> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Steinberg (1963, 1970) & Graner-Glazier (1992) differential adhesion cell sorting — Reproducibility package: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Deterministic RNG (`seed=1963`), fast execution (<10s full render, <2s `--self-test`), 8-check `self_test()` suite (L947-1004) verifying SHA-256 integrity, exact Lean 4 tension parity, sorting vs. equal-adhesion negative control, logarithmic decay fit, specimen segmentation correlation, Foty 1996 transitivity, and two-run bitwise determinism (`np.array_equal`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-repro-package-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-steinberg-differential-adhesion-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Steinberg (1963, 1970) & Graner-Glazier (1992) differential adhesion cell sorting — Morphological realism / specimen match: 88/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the confocal fluorescence embryoid body specimen (`datasets/differential_adhesion_sorting/cell_sorting_specimen.jpg`, CC BY 3.0), segments the GFP-positive inner sorted cell bolus (r_B/R = 0.49) and RFP-stained outer embryonic tissue shell (r_A/R = 0.77, empirical Δr = +0.2793 vs simulated Δr = +0.3672, L487-586), and overlays empirical vs. simulated radial density profiles across 12 concentric annuli (Pearson r = 0.9252, RMSE = 0.210, Panel B4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-specimen-match-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1964-steinberg-differential-adhesion-sorting.py L487–L586" ;
        dct:description "Confocal embryoid body GFP core and RFP shell segmentation and radial profile comparison" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1964-steinberg-differential-adhesion-sorting.py#L487-L586> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/differential_adhesion_sorting_comparison.png (generated output)" ;
        dct:description "10-panel synthesis figure displaying all 5 Potts regimes, specimen segmentation (B3), and radial profile match (B4) — docs/media/differential_adhesion_sorting_comparison.png: rendered output of 1964-steinberg-differential-adhesion-sorting.py at b9976f8, image/png, 503094 B, 3000×1260 px, artifact_sha256 755cf4ee94bc2b8c291aaf3de87bc50d9a6d08ca0c35af27bb8e340856cc1c90 (sha256 755cf4ee94bc2b8c291aaf3de87bc50d9a6d08ca0c35af27bb8e340856cc1c90), spec_fingerprint 439c3a9015bc8fdc9014e2aa3a89cd71cffc876fcd81d0cb0b2f88bbf798d5a9" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


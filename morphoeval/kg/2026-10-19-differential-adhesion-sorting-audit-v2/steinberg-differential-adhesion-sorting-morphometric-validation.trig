sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-steinberg-differential-adhesion-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Steinberg (1963, 1970) & Graner-Glazier (1992) differential adhesion cell sorting — Morphometric validation: 89/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Computes 8 quantitative morphometrics in `measure_morphoeval()` (L877-944), including normalized radial core-shell separation Δr = (r_A - r_B)/R_agg, fractional heterotypic boundary length L_AB/L_total with logarithmic decay fit (`r = -0.8770, p < 1e-40`, Graner & Glazier 1992 Fig. 3), 12-annulus radial occupancy profile correlation against the segmented confocal specimen (`r = 0.9252`, `RMSE = 0.210`), and 100% concordance (10/10 binary tissue pairs, `r = 0.9959`) against Foty & Steinberg's (1996) empirical Gallus gallus surface tension hierarchy." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-checkerboard-mixing-heterotypic-boundary-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-complete-engulfment-heterotypic-boundary-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-complete-engulfment-radial-core-shell-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-equal-adhesion-control-radial-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-foty-1996-chick-embryo-hierarchy-concordance>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-gamma-ab-sorting>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-spreading-tension-diff>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-specimen-vs-potts-radial-profile-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-morphometric-validation-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-checkerboard-mixing-heterotypic-boundary-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "checkerboard_mixing_heterotypic_boundary_fraction = 0.7235 fraction" ;
        schema:measurementTechnique "Final heterotypic boundary fraction L_AB/L_total in checkerboard mixing regime (gamma_AB = -10 < 0)" ;
        schema:name "checkerboard_mixing_heterotypic_boundary_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.7235" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-checkerboard-mixing-heterotypic-boundary-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-checkerboard-mixing-heterotypic-boundary-fraction-reference> a schema:PropertyValue ;
        schema:value "0.72" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-complete-engulfment-heterotypic-boundary-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "complete_engulfment_heterotypic_boundary_fraction = 0.1812 fraction" ;
        schema:measurementTechnique "Final heterotypic boundary fraction L_AB/L_total after 150 MCS with logarithmic decay r=-0.8770 (p=2.81e-49)" ;
        schema:name "complete_engulfment_heterotypic_boundary_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.1812" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-complete-engulfment-heterotypic-boundary-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-complete-engulfment-heterotypic-boundary-fraction-reference> a schema:PropertyValue ;
        schema:value "0.14" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-complete-engulfment-radial-core-shell-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "complete_engulfment_radial_core_shell_separation = 0.3672 normalized_radius" ;
        schema:measurementTechnique "Normalized radial separation (r_A - r_B)/R_agg in complete engulfment regime vs segmented confocal embryoid body specimen (r=0.9252, p=0.0001)" ;
        schema:name "complete_engulfment_radial_core_shell_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.3672" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-complete-engulfment-radial-core-shell-separation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-complete-engulfment-radial-core-shell-separation-reference> a schema:PropertyValue ;
        schema:value "0.2793" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-equal-adhesion-control-radial-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_adhesion_control_radial_separation = 0.0168 normalized_radius" ;
        schema:measurementTechnique "Null radial core-shell separation |r_A - r_B|/R_agg in equal-adhesion negative control (J_AA=J_BB=J_AB=10, gamma_AB=0)" ;
        schema:name "equal_adhesion_control_radial_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.0168" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-equal-adhesion-control-radial-separation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-equal-adhesion-control-radial-separation-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-foty-1996-chick-embryo-hierarchy-concordance> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "foty_1996_chick_embryo_hierarchy_concordance = 1.0 fraction" ;
        schema:measurementTechnique "Transitive pairwise envelopment concordance across all 10 binary pairings of 5 Gallus gallus embryonic tissues from Foty et al. (1996) Table 1 (r=0.9961, p=0.0012)" ;
        schema:name "foty_1996_chick_embryo_hierarchy_concordance" ;
        schema:unitText "fraction" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-foty-1996-chick-embryo-hierarchy-concordance-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-foty-1996-chick-embryo-hierarchy-concordance-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-gamma-ab-sorting> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "graner_glazier_gamma_AB_sorting = 3.0 bond_energy_units" ;
        schema:measurementTechnique "Exact Steinberg/Graner-Glazier interfacial tension gamma_AB = J_AB - (J_AA + J_BB)/2 for J_AA=14, J_BB=2, J_AB=11 (Graner & Glazier 1992 PRL Eq. 2)" ;
        schema:name "graner_glazier_gamma_AB_sorting" ;
        schema:unitText "bond_energy_units" ;
        schema:value "3.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-gamma-ab-sorting-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-gamma-ab-sorting-reference> a schema:PropertyValue ;
        schema:value "3.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-spreading-tension-diff> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "graner_glazier_spreading_tension_diff = 6.0 bond_energy_units" ;
        schema:measurementTechnique "Spreading tension difference gamma_BM - gamma_AM = (J_BM - J_BB/2) - (J_AM - J_AA/2) = 15 - 9 = 6 (Graner & Glazier 1992 PRL Eq. 3)" ;
        schema:name "graner_glazier_spreading_tension_diff" ;
        schema:unitText "bond_energy_units" ;
        schema:value "6.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-spreading-tension-diff-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-spreading-tension-diff-reference> a schema:PropertyValue ;
        schema:value "6.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-specimen-vs-potts-radial-profile-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_vs_potts_radial_profile_pearson_r = 0.9252 r" ;
        schema:measurementTechnique "Pearson correlation between Potts radial core-shell profile and confocal embryoid body GFP/RFP profile across 12 radial annuli (RMSE=0.2102, p=0.0001)" ;
        schema:name "specimen_vs_potts_radial_profile_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9252" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-specimen-vs-potts-radial-profile-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-specimen-vs-potts-radial-profile-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.95" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1964-steinberg-differential-adhesion-sorting.py L148–L241" ;
        dct:description "8-neighbor heterotypic boundary fraction, outer envelopment fraction, and 12-annulus radial density profiles" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1964-steinberg-differential-adhesion-sorting.py#L148-L241> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "1964-steinberg-differential-adhesion-sorting.py L589–L627" ;
        dct:description "Validation of Foty et al. (1996) 5-tissue Gallus gallus surface tension hierarchy (10/10 pairs)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1964-steinberg-differential-adhesion-sorting.py#L589-L627> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/jez.1401730406>,
            <https://doi.org/10.1103/PhysRevE.47.2128>,
            <https://doi.org/10.1103/PhysRevLett.69.2013>,
            <https://doi.org/10.1126/science.141.3579.401>,
            <https://doi.org/10.1242/dev.122.5.1611> .
    <https://doi.org/10.1002/jez.1401730406> dct:date "1970"^^xsd:gYear ;
        dct:title "Does differential adhesion govern self-assembly processes in histogenesis? Equilibrium configurations and the emergence of a hierarchy among populations of embryonic cells" .
    <https://doi.org/10.1103/PhysRevE.47.2128> dct:date "1993"^^xsd:gYear ;
        dct:title "Simulation of the differential adhesion driven rearrangement of biological cells" .
    <https://doi.org/10.1103/PhysRevLett.69.2013> dct:date "1992"^^xsd:gYear ;
        dct:title "Simulation of biological cell sorting using a two-dimensional extended Potts model" .
    <https://doi.org/10.1126/science.141.3579.401> dct:date "1963"^^xsd:gYear ;
        dct:title "Reconstruction of tissues by dissociated cells" .
    <https://doi.org/10.1242/dev.122.5.1611> dct:date "1996"^^xsd:gYear ;
        dct:title "Surface tensions of embryonic tissues predict their mutual envelopment behavior" .
}


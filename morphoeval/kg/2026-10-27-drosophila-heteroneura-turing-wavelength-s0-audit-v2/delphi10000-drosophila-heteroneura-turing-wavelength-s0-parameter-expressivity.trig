sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-heteroneura-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-heteroneura-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-heteroneura-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila heteroneura detail-scale Turing wavelength (5.222 µm, Holocene 0 Ma), pass 2 — Parameter expressivity: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Raising gamma shortens lambda. Raising Dv/Du shortens lambda. Setting Dv/Du to 1 flips the growth rate from +7.38 to -5.11 and collapses the PDE variance amplification. The carrier amplitude is fixed and reported, not silently tuned after the CV score." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-heteroneura-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-heteroneura-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-heteroneura-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-heteroneura-turing-wavelength-s0.py L189–L226" ;
        dct:description "both sweeps and the spectral PDE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1fc59ceabb8ad3bc2b65011b9e189d8de99889cf/models/2026-delphi10000-drosophila-heteroneura-turing-wavelength-s0.py#L189-L226> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-heteroneura-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "datasets/drosophila_heteroneura_turing_wavelength_s0/fit_metrics.json L4–L12" ;
        dct:description "h(k_c) negative, ablation growth rate negative, PDE amplification large only when patterned" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1fc59ceabb8ad3bc2b65011b9e189d8de99889cf/datasets/drosophila_heteroneura_turing_wavelength_s0/fit_metrics.json#L4-L12> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; R3 still open)" ;
        dct:identifier "grok-4.7" ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-023> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-023 — calcospherites grow by radial deposition about a centre (Harting 1872 artificial CaCO3 concretions in egg albumen) — Code-to-model traceability: 70/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Module docstring (L1-33) and section headers map E1-E6 to Thompson page numbers and to the Lean module; function docstrings cite Zener / Mullins-Sekerka, Keller-Rubinow/Ostwald, Niemeyer et al. Figure numbers (195-197, 208) are pinned to pixel boxes (L55-61) but the link from each measured number back to a specific Thompson sentence is not yet explicit." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-code-traceability-2> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L1–L33" ;
        dct:description "equation-to-page and Lean traceability in module docstring" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ae9bb0083/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L1-L33> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L55–L61" ;
        dct:description "plate crops pinned to IA page pixel coordinates" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ae9bb0083/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L55-L61> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Cloud Loop Slot 218 Pass 1 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


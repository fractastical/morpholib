sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-023> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-morphometric-validation> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e1-lamella-thickness-cv-interface-controlled-law> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "E1 lamella-thickness CV, interface-controlled law = 0.0" ;
        schema:measurementTechnique "std/mean of successive R_{n+1}-R_n" ;
        schema:name "E1 lamella-thickness CV, interface-controlled law" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e1-lamella-thickness-cv-interface-controlled-law-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e1-lamella-thickness-cv-interface-controlled-law-reference> a schema:PropertyValue ;
        dcterms:source "Lean lamella_thickness_constant" ;
        schema:value "0.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e3-asphericity-decay-exponent-d-ln-a-d-ln-r-square-nucleus-uniform-normal-deposition> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "E3 asphericity decay exponent d ln A / d ln R (square nucleus, uniform normal deposition) = -0.9727" ;
        schema:measurementTechnique "log-log slope of (max rho - min rho)/mean rho vs mean R over distance-transform level sets" ;
        schema:name "E3 asphericity decay exponent d ln A / d ln R (square nucleus, uniform normal deposition)" ;
        schema:value "-0.9727" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e3-asphericity-decay-exponent-d-ln-a-d-ln-r-square-nucleus-uniform-normal-deposition-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e3-asphericity-decay-exponent-d-ln-a-d-ln-r-square-nucleus-uniform-normal-deposition-reference> a schema:PropertyValue ;
        dcterms:source "Lean asphericity_nonincreasing; A = const / R" ;
        schema:value "-1.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e4-cell-area-cv-equal-rate-voronoi-mosaic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "E4 cell-area CV, equal-rate Voronoi mosaic = 0.5609" ;
        schema:measurementTechnique "std/mean of interior cell areas" ;
        schema:name "E4 cell-area CV, equal-rate Voronoi mosaic" ;
        schema:value "0.5609" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e4-cell-area-cv-equal-rate-voronoi-mosaic-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e4-cell-area-cv-equal-rate-voronoi-mosaic-reference> a schema:PropertyValue ;
        dcterms:source "Ferenc & Neda 2007 Poisson-Voronoi" ;
        schema:value "0.529" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e4-mean-neighbour-count-equal-rate-voronoi-mosaic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "E4 mean neighbour count, equal-rate Voronoi mosaic = 5.7778 neighbours" ;
        schema:measurementTechnique "interior cells of 60-centre Voronoi map" ;
        schema:name "E4 mean neighbour count, equal-rate Voronoi mosaic" ;
        schema:unitText "neighbours" ;
        schema:value "5.7778" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e4-mean-neighbour-count-equal-rate-voronoi-mosaic-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e4-mean-neighbour-count-equal-rate-voronoi-mosaic-reference> a schema:PropertyValue ;
        dcterms:source "Euler characteristic (Thompson 1917 Ch. VII)" ;
        schema:value "6.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e5-liesegang-band-count-3-d-spherical-a0-100> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "E5 Liesegang band count (3-D spherical, a0=100) = 7.0 bands" ;
        schema:measurementTechnique "precipitate maxima above 10% of peak" ;
        schema:name "E5 Liesegang band count (3-D spherical, a0=100)" ;
        schema:unitText "bands" ;
        schema:value "7.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e5-liesegang-spacing-coefficient-p-2-d-a0-50-b0-0-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "E5 Liesegang spacing coefficient P (2-D, a0=50, b0=0.1) = 1.2197" ;
        dcterms:description "11 bands" ;
        schema:measurementTechnique "mean r_{n+1}/r_n over precipitate band centres" ;
        schema:name "E5 Liesegang spacing coefficient P (2-D, a0=50, b0=0.1)" ;
        schema:value "1.2197" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e5-liesegang-spacing-coefficient-p-2-d-a0-50-b0-0-1-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e5-liesegang-spacing-coefficient-p-2-d-a0-50-b0-0-1-reference> a schema:PropertyValue ;
        dcterms:source "Jablczynski 1923 (1.05-1.4)" ;
        schema:value "1.15" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e6-dla-eta-1-mass-radius-exponent> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "E6 DLA (eta=1) mass-radius exponent = 1.6347" ;
        schema:measurementTechnique "log N(r) vs log r fit, r <= 0.75 R_max" ;
        schema:name "E6 DLA (eta=1) mass-radius exponent" ;
        schema:value "1.6347" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e6-dla-eta-1-mass-radius-exponent-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e6-dla-eta-1-mass-radius-exponent-reference> a schema:PropertyValue ;
        dcterms:source "Witten & Sander 1981" ;
        schema:value "1.71" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e6-eden-eta-0-envelope-radius-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "E6 Eden (eta=0) envelope radius CV = 0.1346" ;
        schema:measurementTechnique "36-sector outer envelope std/mean" ;
        schema:name "E6 Eden (eta=0) envelope radius CV" ;
        schema:value "0.1346" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L308–L342" ;
        dcterms:description "8 simulation-side metrics, 6 with reference values" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ae9bb0083/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L308-L342> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-023 — calcospherites grow by radial deposition about a centre (Harting 1872 artificial CaCO3 concretions in egg albumen) — Morphometric validation: 45/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "`measure_morphoeval` (L308-342) returns 8 metrics, 6 with literature/analytic reference values (asphericity exponent, lamella CV, Voronoi neighbours and area CV, Jablczynski P, DLA exponent). All are simulation-side; none is measured on a specimen, and there is no r / RMSE / KS / CV statistic comparing model to plate." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L308–L342: no specimen-derived measurement and no goodness-of-fit statistic <https://github.com/fractastical/morpholib/blob/ae9bb0083/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L308-L342>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e1-lamella-thickness-cv-interface-controlled-law>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e3-asphericity-decay-exponent-d-ln-a-d-ln-r-square-nucleus-uniform-normal-deposition>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e4-cell-area-cv-equal-rate-voronoi-mosaic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e4-mean-neighbour-count-equal-rate-voronoi-mosaic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e5-liesegang-band-count-3-d-spherical-a0-100>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e5-liesegang-spacing-coefficient-p-2-d-a0-50-b0-0-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e6-dla-eta-1-mass-radius-exponent>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e6-eden-eta-0-envelope-radius-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-morphometric-validation-1> ;
        pk:hasScore "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .


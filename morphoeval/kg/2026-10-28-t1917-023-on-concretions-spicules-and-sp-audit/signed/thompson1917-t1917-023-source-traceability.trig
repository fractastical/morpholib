sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-023> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-source-traceability> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-023 — calcospherites grow by radial deposition about a centre (Harting 1872 artificial CaCO3 concretions in egg albumen) — Source and data traceability: 80/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "`datasets/thompson_1917/t1917-023/` holds the scout manifest (IA SHA-1/SHA-256 digests, leaf-to-page rule, OCR quotes with page numbers), the reference JSON with every vendored file's SHA-256, a 21-entry BibTeX, and the Commons licence/author records for both analogue specimens; the script verifies the digests at runtime. Harting (1872) itself is cited through Thompson, not fetched." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-source-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-source-traceability-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L88–L99" ;
        dcterms:description "runtime SHA-256 verification of all 5 vendored files" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ae9bb0083/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L88-L99> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-023/scout_manifest.json L1–L120" ;
        dcterms:description "IA item digests, leaf/page mapping, 7 OCR quotes, Commons provenance" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ae9bb0083/datasets/thompson_1917/t1917-023/scout_manifest.json#L1-L120> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;

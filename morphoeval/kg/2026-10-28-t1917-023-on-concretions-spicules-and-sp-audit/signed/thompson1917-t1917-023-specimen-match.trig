sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-023> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-specimen-match> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-023 — calcospherites grow by radial deposition about a centre (Harting 1872 artificial CaCO3 concretions in egg albumen) — Morphological realism / specimen match: 42/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "The five vendored files are SHA-256-verified (`verify_dataset_integrity` L88-99) and the Thompson plates (Figs. 195, 196, 197, 208) are cropped and rendered side by side with the model panels (`render_comparison_png` L363-405), so the qualitative correspondence (nucleus + radial fibres + concentric bands; polygonal mosaic when crowded) is visible. Nothing is measured on the plates, the Carmel ooid and Liesegang specimens are vendored but not shown or analysed, and the synthetic spherite texture (`_spherite_texture` L346-360) is a drawing, not a model output." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L102–L106: load_plate crops exist but no segmentation of spherites, ooids or Liesegang rings <https://github.com/fractastical/morpholib/blob/ae9bb0083/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L102-L106>",
            "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L346–L360: synthetic spherite texture is illustrative, not derived from the growth model <https://github.com/fractastical/morpholib/blob/ae9bb0083/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L346-L360>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-specimen-match-2> ;
        pk:hasScore "0.42"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L363–L405" ;
        dcterms:description "plates vs model 2x4 comparison figure" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ae9bb0083/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L363-L405> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_023_on_concretions_spicules_and_sp_comparison.png (generated output)" ;
        dcterms:description "rendered Pass 1 comparison — docs/media/t1917_023_on_concretions_spicules_and_sp_comparison.png: rendered output of thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py at ae9bb0083, image/png, 1067896 B, 2200×1100 px, artifact_sha256 99d274958a29f4bd87f9aaff461949ff9ec5963481105a8e0847935d5196621b (sha256 99d274958a29f4bd87f9aaff461949ff9ec5963481105a8e0847935d5196621b), spec_fingerprint 09c3115074722edd88f58e645bafec8f465e6fa5a4c47f5f66ece6a0c71a3acd" .


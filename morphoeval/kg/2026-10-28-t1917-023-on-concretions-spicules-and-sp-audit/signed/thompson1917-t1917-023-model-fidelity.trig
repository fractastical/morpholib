sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-023> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-model-fidelity> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L110–L153" ;
        dcterms:description "E1/E2 growth-law tables and E3 distance-transform front rounding (decay exponent -0.97)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ae9bb0083/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L110-L153> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L184–L232" ;
        dcterms:description "E5 d-dimensional radial supersaturation precipitation with nucleation threshold K_ss and growth threshold K_sp" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ae9bb0083/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L184-L232> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_023.lean L32–L195" ;
        dcterms:description "11 machine-checked theorems for laws 1-5 (Lean 4.35.0, 0 sorry)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ae9bb0083/morphoeval/lean/loops/Thompson1917_T1917_023.lean#L32-L195> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Cloud Loop Slot 218 Pass 1 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-023 — calcospherites grow by radial deposition about a centre (Harting 1872 artificial CaCO3 concretions in egg albumen) — Model fidelity to source: 66/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "E1-E5 are implemented as stated in the reference JSON and match the Lean theorems (`radial_growth_laws` L110-121, `simulate_front_rounding` L125-153, `simulate_voronoi_impingement` L157-180, `simulate_liesegang_radial` L184-232, `simulate_dbm_cluster` L236-288). The Liesegang solver is the Ostwald supersaturation form with explicit nucleation / growth thresholds and d-dimensional radial Laplacian. However the sphericity-stability law is only exercised for uniform (isotropic) deposition; the anisotropic crystalline alternative that Thompson contrasts (calcium oxalate stays crystalline, p. 434) is not implemented, and the Mullins-Sekerka regime boundary is not swept." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L66–L72: no anisotropic-deposition alternative and no threshold-free Liesegang control in PARAMS <https://github.com/fractastical/morpholib/blob/ae9bb0083/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L66-L72>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-model-fidelity-3> ;
        pk:hasScore "0.66"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
}


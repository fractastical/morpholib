sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-runions-leaf-venation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-runions-leaf-venation-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-runions-leaf-venation-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Runions et al. (2005) Leaf Venation Space-Colonization & Murray's Law — Morphological realism / specimen match: 89/100" ;
        dct:date "2026-10-18"^^xsd:date ;
        dct:description "Both vendored CC BY-SA 3.0 photographs (reticulate_vein_skeleton_specimen.jpg and ginkgo_open_venation_specimen.jpg) are segmented in segment_empirical_specimens(), extracting 168 enclosed planar areoles, vein caliber distributions, and Katifori loop nesting (i_u = 0.6134) from the cleared leaf skeleton and 1,651,010 lamina pixels + parallel vein ridge density (0.4383) from the Ginkgo specimen, alongside Price et al.'s (2013) 349-leaf (1,514,771-junction) empirical Strahler curves." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-specimen-match-3> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2005-runions-leaf-venation.py L715–L767" ;
        dct:description "segment_empirical_specimens(): pixel segmentation of both leaf specimens" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L715-L767> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2005-runions-leaf-venation.py L811–L825" ;
        dct:description "Panel C renders segmented reticulate specimen with Ginkgo inset and measured metrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L811-L825> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "runions_leaf_venation_comparison.png (generated output)" ;
        dct:description "6-panel comparison figure — runions_leaf_venation_comparison.png: rendered output of 2005-runions-leaf-venation.py at c89d18d, image/png, 1138697 B, 2475×1530 px, artifact_sha256 d7f0922fe27597dd1757a5525cd01c5a03356d817ba67aec405a918bfb794e34 (sha256 d7f0922fe27597dd1757a5525cd01c5a03356d817ba67aec405a918bfb794e34), spec_fingerprint 9c51f0ee1bb18dac15303bbc28f21b848e721403f4cfc6f6459cd6e7325c2ab9" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;

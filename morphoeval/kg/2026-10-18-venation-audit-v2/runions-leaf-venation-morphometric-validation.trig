sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-runions-leaf-venation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-runions-leaf-venation-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-runions-leaf-venation-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Runions et al. (2005) Leaf Venation Space-Colonization & Murray's Law — Morphometric validation: 91/100" ;
        dct:date "2026-10-18"^^xsd:date ;
        dct:description "Validates 12 quantitative metrics across open/closed Euler loop counts (L = 0 vs L = 409), exact Murray root-to-tip cubic conductance conservation (r_root^3 = 371.0 = N_tips * r_tip^3), binary junction area ratios across 8 Strahler orders on an explicit 2,175-node tree (r = 0.9679, MAE = 0.0208 vs Price et al. 2013), and planar dual areole loop nesting on both simulated (358 areoles, i_u = 0.4462) and segmented specimen (168 areoles, i_u = 0.6134) networks." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-closed-reticulate-venation-anastomosing-loop-count-l-e-v-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-horton-strahler-order-1-vs-order-8-median-area-ratio-shift>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-katifori-magnasco-2012-unweighted-hierarchical-loop-nesting-number-i-u>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-murray-s-cube-law-root-to-tip-conservation-ratio-r-root-3-n-tips-r-tip-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-open-ginkgo-venation-anastomosing-cycle-count-l-e-v-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-open-venation-binary-junction-median-daughter-parent-area-ratio-a-1-a-2-a-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-segmented-reticulate-leaf-skeleton-specimen-areole-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-morphometric-validation-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-closed-reticulate-venation-anastomosing-loop-count-l-e-v-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "closed reticulate venation anastomosing loop count L = E - V + 1 = 409 areole loops" ;
        dct:description "V = 1099, E = 1507" ;
        schema:measurementTechnique "Euler cycle rank E - V + 1 of closed Relative Neighborhood Graph (RNG) space-colonization network" ;
        schema:name "closed reticulate venation anastomosing loop count L = E - V + 1" ;
        schema:unitText "areole loops" ;
        schema:value "409" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-closed-reticulate-venation-anastomosing-loop-count-l-e-v-1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-closed-reticulate-venation-anastomosing-loop-count-l-e-v-1-reference> a schema:PropertyValue ;
        dct:source "Runions et al. 2005 ACM Trans. Graph. 24(3):702-711 Sec. 4 Eq. (2)-(3)" ;
        schema:value "150" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-horton-strahler-order-1-vs-order-8-median-area-ratio-shift> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Horton-Strahler order 1 vs order 8 median area-ratio shift = 0.1835 delta area ratio" ;
        dct:description "Pearson r across Strahler orders = 0.9679" ;
        schema:measurementTechnique "decrease in median daughter/parent cross-sectional area ratio from terminal minor veins (order 1) to major midveins (order 8)" ;
        schema:name "Horton-Strahler order 1 vs order 8 median area-ratio shift" ;
        schema:unitText "delta area ratio" ;
        schema:value "0.1835" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-horton-strahler-order-1-vs-order-8-median-area-ratio-shift-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-horton-strahler-order-1-vs-order-8-median-area-ratio-shift-reference> a schema:PropertyValue ;
        dct:source "Price, Knox & Brodribb 2013 PLoS ONE 8(12):e85420 Fig. 4 (order 1 median 1.25 -> order 8 median 1.01)" ;
        schema:value "0.24" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-katifori-magnasco-2012-unweighted-hierarchical-loop-nesting-number-i-u> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Katifori & Magnasco (2012) unweighted hierarchical loop nesting number i_u = 0.4462 nesting index i_u" ;
        dct:description "high-noise / additive control i_u = 0.6134" ;
        schema:measurementTechnique "mean subtree partition balance q_j = 1 - |r_j - s_j|/(r_j + s_j - 1) under iterative minimum-width vein removal" ;
        schema:name "Katifori & Magnasco (2012) unweighted hierarchical loop nesting number i_u" ;
        schema:unitText "nesting index i_u" ;
        schema:value "0.4462" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-katifori-magnasco-2012-unweighted-hierarchical-loop-nesting-number-i-u-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-katifori-magnasco-2012-unweighted-hierarchical-loop-nesting-number-i-u-reference> a schema:PropertyValue ;
        dct:source "Katifori & Magnasco 2012 PLoS ONE e37994 / Ronellenfitsch et al. 2015 PLoS Comput. Biol. e1004680 Fig. 3b" ;
        schema:value "0.68" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-murray-s-cube-law-root-to-tip-conservation-ratio-r-root-3-n-tips-r-tip-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Murray's cube law root-to-tip conservation ratio r_root^3 / (N_tips * r_tip^3) = 1.0 ratio" ;
        dct:description "r_root^3 = 371.0, N_tips = 371" ;
        schema:measurementTechnique "ratio of petiole root cubic radius r_root^3 to sum of terminal veinlet cubic radii sum r_tip^3" ;
        schema:name "Murray's cube law root-to-tip conservation ratio r_root^3 / (N_tips * r_tip^3)" ;
        schema:unitText "ratio" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-murray-s-cube-law-root-to-tip-conservation-ratio-r-root-3-n-tips-r-tip-3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-murray-s-cube-law-root-to-tip-conservation-ratio-r-root-3-n-tips-r-tip-3-reference> a schema:PropertyValue ;
        dct:source "Murray 1926 PNAS 12:207 / Runions et al. 2005 Sec. 3.5 / Lean 4 theorem murray_1926_tree_conservation" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-open-ginkgo-venation-anastomosing-cycle-count-l-e-v-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "open Ginkgo venation anastomosing cycle count L = E - V + 1 = 0 loops" ;
        schema:measurementTechnique "Euler-Poincaré independent cycle rank E - V + 1 on open Voronoi space-colonization tree" ;
        schema:name "open Ginkgo venation anastomosing cycle count L = E - V + 1" ;
        schema:unitText "loops" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-open-ginkgo-venation-anastomosing-cycle-count-l-e-v-1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-open-ginkgo-venation-anastomosing-cycle-count-l-e-v-1-reference> a schema:PropertyValue ;
        dct:source "Runions et al. 2005 ACM Trans. Graph. 24(3):702-711 Sec. 3 (open venation tree)" ;
        schema:value "0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-open-venation-binary-junction-median-daughter-parent-area-ratio-a-1-a-2-a-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "open venation binary junction median daughter/parent area ratio (A_1 + A_2)/A_0 = 1.2439 area ratio" ;
        schema:measurementTechnique "median (r_1^2 + r_2^2) / r_0^2 across binary bifurcations of the grown open venation tree" ;
        schema:name "open venation binary junction median daughter/parent area ratio (A_1 + A_2)/A_0" ;
        schema:unitText "area ratio" ;
        schema:value "1.2439" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-open-venation-binary-junction-median-daughter-parent-area-ratio-a-1-a-2-a-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-open-venation-binary-junction-median-daughter-parent-area-ratio-a-1-a-2-a-0-reference> a schema:PropertyValue ;
        dct:source "Murray 1926 symmetric bifurcation 2^{1/3} = 1.2599 / Price et al. 2013 PLoS ONE e85420 Fig. 3" ;
        schema:value "1.2599" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-segmented-reticulate-leaf-skeleton-specimen-areole-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented reticulate leaf skeleton specimen areole count = 168 areoles" ;
        dct:description "segmented specimen nesting index i_u = 0.6134, Ginkgo open specimen loops = 0" ;
        schema:measurementTechnique "connected enclosed areole faces segmented directly from datasets/venation/reticulate_vein_skeleton_specimen.jpg" ;
        schema:name "segmented reticulate leaf skeleton specimen areole count" ;
        schema:unitText "areoles" ;
        schema:value "168" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-segmented-reticulate-leaf-skeleton-specimen-areole-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-measurement-segmented-reticulate-leaf-skeleton-specimen-areole-count-reference> a schema:PropertyValue ;
        dct:source "Wikimedia Commons File:Vein skeleton of a leaf (de-ghosted).jpg (CC BY-SA 3.0)" ;
        schema:value "180" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2005-runions-leaf-venation.py L548–L628" ;
        dct:description "build_and_measure_multiscale_strahler_tree(): explicit 8-order tree measured via analyze_junction_scaling()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L548-L628> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "2005-runions-leaf-venation.py L634–L712" ;
        dct:description "compute_planar_areole_nesting_from_raster() and compute_simulated_network_areole_nesting()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L634-L712> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "runions_leaf_venation_metrics.csv (generated output)" ;
        dct:description "12-row quantitative metrics CSV — runions_leaf_venation_metrics.csv: rendered output of 2005-runions-leaf-venation.py at c89d18d, text/csv, 1360 B, artifact_sha256 6b1d640aaa78f2183c4bff360c7af745f55a6d7c076c4d80435966b6aeaad4fa (sha256 6b1d640aaa78f2183c4bff360c7af745f55a6d7c076c4d80435966b6aeaad4fa), spec_fingerprint 9c51f0ee1bb18dac15303bbc28f21b848e721403f4cfc6f6459cd6e7325c2ab9" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

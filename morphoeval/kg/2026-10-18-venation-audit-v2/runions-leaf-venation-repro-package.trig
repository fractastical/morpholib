            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-repro-package-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2005-runions-leaf-venation.py L965–L987" ;
        dct:description "run_self_test() end-to-end verification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L965-L987> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-leaf-venation-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/runions_leaf_venation_growth.gif (generated output)" ;
        dct:description "Animated venation growth GIF — docs/media/runions_leaf_venation_growth.gif: rendered output of 2005-runions-leaf-venation.py at c89d18d, image/gif, 975797 B, 520×560 px, 30 frames, artifact_sha256 247168ed9d8bb10001be248b08bb2bebaa286f8bc8336109af93814fc043d318 (sha256 247168ed9d8bb10001be248b08bb2bebaa286f8bc8336109af93814fc043d318), spec_fingerprint 9c51f0ee1bb18dac15303bbc28f21b848e721403f4cfc6f6459cd6e7325c2ab9" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-runions-leaf-venation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-runions-leaf-venation-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-runions-leaf-venation-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Runions et al. (2005) Leaf Venation Space-Colonization & Murray's Law — Reproducibility package: 93/100" ;
        dct:date "2026-10-18"^^xsd:date ;
        dct:description "Self-contained deterministic execution (--self-test verifies SHA-256 specimen digests, open tree L=0, Murray conservation, closed loops, specimen areole segmentation, Ginkgo lamina segmentation, and Strahler r >= 0.95) with zero unused dependencies." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;

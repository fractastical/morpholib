sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-18-venation-audit-v2-runions-leaf-venation-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Runions et al. (2005) Leaf Venation Space-Colonization & Murray's Law — Parameter expressivity: 88/100" ;
        rdfs:comment "Reads Runions et al. (2005) Table 1 regimes directly via load_table1_regime() from venation_reference.json (15 canonical regimes), contrasting open dichotomous marginal growth (Fig. 10) vs closed reticulate isogonic growth (Fig. 15) and sweeping Horton-Strahler orders 1-8 across the hydraulic-to-mechanical gamma transition. Evidence: 2005-runions-leaf-venation.py L80–L88: load_table1_regime() reads Table 1 parameters from venation_reference.json <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L80-L88>; 2005-runions-leaf-venation.py L243–L275: Table 1 Fig. 10 and Fig. 15 parameter mapping <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L243-L275>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-runions-leaf-venation-parameter-expressivity> ;
        pk:hasProbability "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-runions-leaf-venation-parameter-expressivity> rdfs:label "Runions et al. (2005) Leaf Venation Space-Colonization & Murray's Law (2005-runions-leaf-venation.py, docs/media/runions_leaf_venation_growth.gif, runions_leaf_venation_metrics.csv) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Ginkgo biloba (open dichotomous venation) & angiosperm dicot lamina (reticulate venation)" ;
        dcterms:identifier "morphoeval/0.1.0/parameter-expressivity" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" .
}


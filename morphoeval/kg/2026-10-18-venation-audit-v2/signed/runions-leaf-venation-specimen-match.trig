sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-18-venation-audit-v2-runions-leaf-venation-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Runions et al. (2005) Leaf Venation Space-Colonization & Murray's Law — Morphological realism / specimen match: 89/100" ;
        rdfs:comment "Both vendored CC BY-SA 3.0 photographs (reticulate_vein_skeleton_specimen.jpg and ginkgo_open_venation_specimen.jpg) are segmented in segment_empirical_specimens(), extracting 168 enclosed planar areoles, vein caliber distributions, and Katifori loop nesting (i_u = 0.6134) from the cleared leaf skeleton and 1,651,010 lamina pixels + parallel vein ridge density (0.4383) from the Ginkgo specimen, alongside Price et al.'s (2013) 349-leaf (1,514,771-junction) empirical Strahler curves. Evidence: 2005-runions-leaf-venation.py L715–L767: segment_empirical_specimens(): pixel segmentation of both leaf specimens <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L715-L767>; 2005-runions-leaf-venation.py L811–L825: Panel C renders segmented reticulate specimen with Ginkgo inset and measured metrics <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L811-L825>; runions_leaf_venation_comparison.png (generated output, not in repo): 6-panel comparison figure — runions_leaf_venation_comparison.png: rendered output of 2005-runions-leaf-venation.py at c89d18d, image/png, 1138697 B, 2475×1530 px, artifact_sha256 d7f0922fe27597dd1757a5525cd01c5a03356d817ba67aec405a918bfb794e34 (sha256 d7f0922fe27597dd1757a5525cd01c5a03356d817ba67aec405a918bfb794e34), spec_fingerprint 9c51f0ee1bb18dac15303bbc28f21b848e721403f4cfc6f6459cd6e7325c2ab9." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-runions-leaf-venation-specimen-match> ;
        pk:hasProbability "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-runions-leaf-venation-specimen-match> rdfs:label "Runions et al. (2005) Leaf Venation Space-Colonization & Murray's Law (2005-runions-leaf-venation.py, docs/media/runions_leaf_venation_growth.gif, runions_leaf_venation_metrics.csv) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Ginkgo biloba (open dichotomous venation) & angiosperm dicot lamina (reticulate venation)" ;
        dcterms:identifier "morphoeval/0.1.0/specimen-match" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" .
}


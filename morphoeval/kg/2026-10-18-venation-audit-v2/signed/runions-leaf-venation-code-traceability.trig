sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-18-venation-audit-v2-runions-leaf-venation-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Runions et al. (2005) Leaf Venation Space-Colonization & Murray's Law — Code-to-model traceability: 94/100" ;
        rdfs:comment "Every equation is linked to both Python implementation lines and non-vacuous machine-checked Lean 4 theorems in morphoeval/lean/MathOfBiology.lean (Section 13: parameterized ObeysMurrayLaw gamma induction, strict RNG lune equivalence, and planar cycle/edge-deletion theorems, 0 sorrys, 0 warnings). Evidence: morphoeval/lean/MathOfBiology.lean L361–L443: Section 13 formal Lean 4 theorems (murray_1926_tree_conservation, runions_2005_rng_lune_iff, katifori_2012_edge_deletion_merges_areoles) <https://github.com/fractastical/morpholib/blob/c89d18d/morphoeval/lean/MathOfBiology.lean#L361-L443>; 2005-runions-leaf-venation.py L1–L52: Module docstring mapping equations to code and Lean 4 theorems <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L1-L52>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-runions-leaf-venation-code-traceability> ;
        pk:hasProbability "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-runions-leaf-venation-code-traceability> rdfs:label "Runions et al. (2005) Leaf Venation Space-Colonization & Murray's Law (2005-runions-leaf-venation.py, docs/media/runions_leaf_venation_growth.gif, runions_leaf_venation_metrics.csv) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Ginkgo biloba (open dichotomous venation) & angiosperm dicot lamina (reticulate venation)" ;
        dcterms:identifier "morphoeval/0.1.0/code-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" .
}


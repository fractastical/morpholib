sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength on Archaeopteryx lithographica at 75 µm (Tithonian, 150.0 Ma) — Morphological realism / specimen match: 83/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 2 paints the critical mode into the wing window at alpha 0.78. The wing crop of the GIF shows broad vertical light and dark bars on the fossil texture, and the comparison figure's overlay panel shows the same patch. The rest of the Berlin slab is unchanged, so the animal remains recognizable (cv_sim_similarity 96.0). This is still a slab-scale photograph, not a 75 µm micrograph." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.83"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/archaeopteryx_lithographica_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "overlay panel and wing-mask fraction 0.080 — docs/media/archaeopteryx_lithographica_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0.py at 0c76d15d, image/png, 752917 B, 1496×924 px, artifact_sha256 4417000cdfb1483e9fba10d4ef922723b45a0827e244ce8785b4e1c6876757cb (sha256 4417000cdfb1483e9fba10d4ef922723b45a0827e244ce8785b4e1c6876757cb), spec_fingerprint 6913098e47054812a2f1cf896b7e10fbf923735b2080ce927a3087eecb641c84" .

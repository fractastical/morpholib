<https://w3id.org/delphi/resource/math-law/delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Differential diffusion required for a finite k_c on the Archaeopteryx vane | Variables: Du=0.052, Dv=1.48, gamma=0.039 at L=74.78 µm" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0.py#L63-L93>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3120_archaeopteryx_lithographica_turing_wavelength_s0.lean#L32-L36> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J - k^2 D) = Du Dv k^4 - (Dv fu + Du gv) k^2 + (fu gv - fv gu)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature13467>,
        <https://doi.org/10.1038/ncomms1642>,
        <https://doi.org/10.1039/c3ja50077b>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1186290>,
        <https://doi.org/10.1126/science.1213780> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3120.duMilli" ;
    pk:leanTheorem "MathOfBiology.Loop_3120.differential_diffusivity_ratio" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength" ;
    dct:description "Selects the 75 µm pigment-stripe wavelength, distinct from the 2.919 mm organ-scale sibling | Variables: lambda_c = 74.78 µm = 7.478e-05 m" ;
    dct:source "Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0.py#L63-L93>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3120_archaeopteryx_lithographica_turing_wavelength_s0.lean#L38-L41> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 2 pi / k_c, k_c^2 = (Dv fu + Du gv) / (2 Du Dv)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature13467>,
        <https://doi.org/10.1038/ncomms1642>,
        <https://doi.org/10.1039/c3ja50077b>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1186290>,
        <https://doi.org/10.1126/science.1213780> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3120.lambdaArchUmX100" ;
    pk:leanTheorem "MathOfBiology.Loop_3120.eight_wavelengths_fit_in_vane_patch" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Feather-series wavelength order at fixed cellular dx" ;
    dct:description "What changes at 150.0 Ma versus the 160.8 Ma predecessor and the 120 Ma successor | Variables: 57.05 µm < 74.78 µm < 95.33 µm" ;
    dct:source "Li et al. (2010) DOI:10.1126/science.1186290; Li et al. (2012) DOI:10.1126/science.1213780" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0.py#L156-L176>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3120_archaeopteryx_lithographica_turing_wavelength_s0.lean#L20-L28> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda(Microraptor, gamma=0.067) < lambda(Archaeopteryx, gamma=0.039) < lambda(Anchiornis, gamma=0.024)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature13467>,
        <https://doi.org/10.1038/ncomms1642>,
        <https://doi.org/10.1039/c3ja50077b>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1186290>,
        <https://doi.org/10.1126/science.1213780> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3120.lambdaMicroUmX100" ;
    pk:leanTheorem "MathOfBiology.Loop_3120.successor_shorter_than_archaeopteryx" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


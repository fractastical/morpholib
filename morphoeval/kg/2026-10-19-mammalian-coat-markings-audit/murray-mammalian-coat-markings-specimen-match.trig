sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-mammalian-coat-markings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1981) Thomas substrate-inhibition reaction-diffusion pre-pattern & conical tail spot-to-ring transition — Morphological realism / specimen match: 28/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Although `datasets/mammalian_coat_markings/panthera_pardus_specimen.jpg` is vendored in the repository, the v1 script never loads, segments, or displays the biological specimen photograph (`docs/media/mammalian_coat_markings_comparison.png` shows only 2 synthetic heatmaps), and performs no quantitative comparison against leopard flank rosette spacing or tail banding anisotropy." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1981-murray-mammalian-coat-markings.py L94–L118: 2-panel synthetic plot without biological specimen panel or segmentation <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py#L94-L118>",
            "docs/media/mammalian_coat_markings_comparison.png (generated output, not in repo): 2-panel synthetic figure lacking Panthera pardus specimen comparison — docs/media/mammalian_coat_markings_comparison.png: rendered output of 1981-murray-mammalian-coat-markings.py at 8871db0, image/png, 39199 B, 1540×630 px, artifact_sha256 14cc11c7b1fa12eb1a72b65c3c0f413058f5e546252a64d303be9f03a27847b7 (sha256 14cc11c7b1fa12eb1a72b65c3c0f413058f5e546252a64d303be9f03a27847b7), spec_fingerprint 525df88cbbed5362e036470fa7d127c713eb89280f82aab38da743ea194e4397" ;
        pk:hasScore "0.28"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 003 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


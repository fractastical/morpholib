        "1981-murray-mammalian-coat-markings.py L94–L110: Only 2 gamma values rendered in static figure without negative controls <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py#L94-L110>" ;
    pk:hasScore 4.4e-01 ;
    pk:hasVerdict "partially faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-repro-package> a pk:LLMClaimAssessment ;
    rdfs:label "Murray (1981) Thomas substrate-inhibition reaction-diffusion pre-pattern & conical tail spot-to-ring transition — Reproducibility package: 68/100" ;

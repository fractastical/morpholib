        <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-mammalian-coat-markings-audit-murray-mammalian-coat-markings-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-mammalian-coat-markings-audit-murray-mammalian-coat-markings-2> ;
    pk:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
    pk:weightOfEvidence 4.71e-01 .


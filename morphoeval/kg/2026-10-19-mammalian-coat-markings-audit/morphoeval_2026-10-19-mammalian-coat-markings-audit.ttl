<https://w3id.org/probknow/resource/claim/morphoeval-murray-mammalian-coat-markings> a pk:Claim ;
    rdfs:label "Murray (1981) Thomas substrate-inhibition reaction-diffusion pre-pattern & conical tail spot-to-ring transition (African leopard (Panthera pardus) coat rosettes and tapered tail markings)",
        "Murray (1981) Thomas substrate-inhibition reaction-diffusion pre-pattern & conical tail spot-to-ring transition faithfully reproduces African leopard (Panthera pardus) coat rosettes and tapered tail markings morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/murray-mammalian-coat-markings-1>,
        <https://w3id.org/probknow/resource/math-law/murray-mammalian-coat-markings-2>,
        <https://w3id.org/probknow/resource/math-law/murray-mammalian-coat-markings-3> ;
    dct:description "The simulation script(s) 1981-murray-mammalian-coat-markings.py implement the cited source model as published and produce forms that match real African leopard (Panthera pardus) coat rosettes and tapered tail markings specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 47.1/100, audit 2026-10-19-mammalian-coat-markings-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py> ;
    schema:about "African leopard (Panthera pardus) coat rosettes and tapered tail markings" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py; output: docs/media/mammalian_coat_markings_comparison.png; organism: African leopard (Panthera pardus) coat rosettes and tapered tail markings; checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 525df88cbbed5362e036470fa7d127c713eb89280f82aab38da743ea194e4397; artifact_sha256: 14cc11c7b1fa12eb1a72b65c3c0f413058f5e546252a64d303be9f03a27847b7; input_dataset_sha256: {datasets/mammalian_coat_markings/mammalian_coat_markings_reference.json=6d8170232f54ccce..., datasets/mammalian_coat_markings/panthera_pardus_specimen.jpg=86533a5dcf9cfee6..., datasets/mammalian_coat_markings/scout_manifest.json=28eabc9cf247b03e...}" ;
    pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/S0300-9084(75)80312-9>,
        <https://doi.org/10.1038/scientificamerican0388-80>,
        <https://doi.org/10.1103/PhysRevE.74.011914> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-model-fidelity>,

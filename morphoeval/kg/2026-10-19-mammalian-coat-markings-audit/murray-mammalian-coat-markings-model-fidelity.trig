            <https://doi.org/10.1103/PhysRevE.74.011914> .
    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:date "1981"^^xsd:gYear ;
        dct:title "A pre-pattern formation mechanism for animal coat markings" .
    <https://doi.org/10.1016/S0300-9084(75)80312-9> dct:date "1975"^^xsd:gYear ;
        dct:title "Artificial enzyme membranes: transport, memory, and oscillations" .
    <https://doi.org/10.1038/scientificamerican0388-80> dct:date "1988"^^xsd:gYear ;
        dct:title "How the leopard gets its spots" .
    <https://doi.org/10.1103/PhysRevE.74.011914> dct:date "2006"^^xsd:gYear ;
        dct:title "Two-stage Turing model for generating pigment patterns on the leopard and the jaguar" .

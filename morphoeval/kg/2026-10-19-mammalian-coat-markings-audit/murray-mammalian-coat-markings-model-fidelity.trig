        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-mammalian-coat-markings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1981) Thomas substrate-inhibition reaction-diffusion pre-pattern & conical tail spot-to-ring transition — Model fidelity to source: 52/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Computes the exact Thomas (1975) / Murray (1981) homogeneous steady state (u0, v0) = (9.9338, 9.2892), Jacobian J0, and unstable wavenumber interval gamma*k^2 in [0.5236, 0.9648] (L24-62), but `simulate_cylinder_eigenmodes` (L65-91) synthesizes patterns using a Gaussian-weighted linear cosine sum rather than numerically integrating the nonlinear Thomas reaction-diffusion PDE du/dt = gamma*f(u,v) + Lap(u), dv/dt = gamma*g(u,v) + d*Lap(v) on a tapered conical cylinder with curvilinear Laplace-Beltrami operator and Neumann boundary conditions, and omits Liu, Liaw & Maini (2006) two-stage spot-to-rosette maturation." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1981-murray-mammalian-coat-markings.py L65–L91: Linear cosine superposition instead of nonlinear Thomas PDE + curvilinear conical tail Laplace-Beltrami solver <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py#L65-L91>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-1> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L24–L62" ;
        dct:description "Exact Thomas steady state and linear Turing band [k_-^2, k_+^2]" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py#L24-L62> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 003 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


    <https://doi.org/10.1038/scientificamerican0388-80> dct:date "1988"^^xsd:gYear ;
        dct:title "How the leopard gets its spots" .
    <https://doi.org/10.1103/PhysRevE.74.011914> dct:date "2006"^^xsd:gYear ;
        dct:title "Two-stage Turing model for generating pigment patterns on the leopard and the jaguar" .

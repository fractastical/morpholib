sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-mammalian-coat-markings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1981) Thomas substrate-inhibition reaction-diffusion pre-pattern & conical tail spot-to-ring transition — Parameter expressivity: 44/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Simulates only 2 static gamma values (8.0 and 25.0) in the comparison figure without Murray's full 5-regime scale morphospace sweep (gamma from subcritical 0.4 uniform mouse coat to 120.0 large mammal high-mode crowding), without equal-diffusion (d=1.0) or non-inhibitory (K=0.0) negative controls, and without CLI flags for a, b, alpha, rho, K, d, or gamma (L133-141)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1981-murray-mammalian-coat-markings.py L133–L141: CLI exposes only --self-test <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py#L133-L141>",
            "1981-murray-mammalian-coat-markings.py L94–L110: Only 2 gamma values rendered in static figure without negative controls <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py#L94-L110>" ;
        pk:hasScore "0.44"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 003 autonomous loop assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Daphnia magna ocellus-pigment Turing wavelength at 2.736 µm (Holocene, detail scale) — Model fidelity to source: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script integrates Schnakenberg kinetics with a spectral Laplacian and compares growth rates to the larger eigenvalue of J − k²D. The length unit is imposed so λ_c equals the assigned 2.736 µm; it is not fitted to a published stripe period. The strongly damped mode is excluded from the scored band after a burn-in, which is disclosed." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Daphnia magna ocellus-pigment Turing wavelength at 2.736 µm (Holocene, detail scale) — Morphological realism / specimen match: 74/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The comparison figure places the Corgosinho head SEM beside the Otsu mask and the activator. The GIF's last frame is that SEM, so the registration image is the animal. The activator is a subcellular field, and the cuticle peak at 20.17 µm shows the polygons are a coarser structure. Specimen-match is the anatomical registration plus that disclosed mismatch, not a claim that the spots reproduce the mesh." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/daphnia_magna_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "SEM, mask, activator, dispersion, sweep, ablation — docs/media/daphnia_magna_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-daphnia-magna-turing-wavelength-s0.py at 86cc0374f85f7f6fea93d271291a5192c8f44eb3, image/png, 343840 B, 1512×960 px, artifact_sha256 2ca968226229d47131b1597ba5722a3d2a086597c356cd8a4332a6c3e42ae30c (sha256 2ca968226229d47131b1597ba5722a3d2a086597c356cd8a4332a6c3e42ae30c), spec_fingerprint 5cc7a733d6eb0f2c8ca309d68942c0dd30e27b59c80a745c4958e462d76f9c31" .

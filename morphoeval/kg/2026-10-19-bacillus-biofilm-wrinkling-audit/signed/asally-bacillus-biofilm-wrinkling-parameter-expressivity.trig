sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-asally-bacillus-biofilm-wrinkling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Asally et al. (2012) PNAS & Yan et al. (2019) Nature Physics osmotic matrix swelling, localized cell-death delamination, and Föppl–von Kármán radial wrinkle spokes in Bacillus subtilis biofilms — Parameter expressivity: 49/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates 7 agar stiffnesses E_s in [0.5, 10.0] kPa (L76-94), but omits the 6-point biofilm thickness scaling sweep h in [40, 140] um, omits the 5 genetic and mechanical-score controls (WT, Delta eps/tasA mutant, FeCl3 cell-death suppression, artificial m=6 and m=8 spoke templates), and exposes no CLI parameter overrides." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2013-asally-bacillus-biofilm-wrinkling.py L76–L94: Single 7-point agar sweep without biofilm thickness scaling, mutant controls, or CLI overrides <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py#L76-L94>" ;
        pk:hasScore "0.49"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 094 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


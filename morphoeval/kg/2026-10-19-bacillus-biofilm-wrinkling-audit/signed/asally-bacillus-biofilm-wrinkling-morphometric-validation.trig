sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-asally-bacillus-biofilm-wrinkling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Asally et al. (2012) PNAS & Yan et al. (2019) Nature Physics osmotic matrix swelling, localized cell-death delamination, and Föppl–von Kármán radial wrinkle spokes in Bacillus subtilis biofilms — Morphometric validation: 52/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L152-181) reports only 4 analytic numbers (standard, stiff, and soft agar wavelengths plus spoke count) without Pearson r, p-value, RMSE, log-log cube-root scaling slope, thickness scaling correlation, mutant negative-control amplitude delta, or specimen image radial spoke morphometrics." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2013-asally-bacillus-biofilm-wrinkling.py L152–L181: Only 4 analytic metrics without statistical tests, mutant controls, or specimen segmentation <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py#L152-L181>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-soft-agar-e-s-0-5-kpa-wrinkle-wavelength>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-standard-1-5-agar-e-s-2-5-kpa-f-ppl-von-k-rm-n-wrinkle-wavelength>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-standard-1-5-agar-e-s-2-5-kpa-radial-wrinkle-spoke-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-stiff-agar-e-s-10-0-kpa-wrinkle-wavelength> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-soft-agar-e-s-0-5-kpa-wrinkle-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Soft agar (E_s = 0.5 kPa) wrinkle wavelength = 1283.96 um" ;
        dcterms:description "Longer wavelength on compliant soft agar" ;
        schema:measurementTechnique "Föppl-von Kármán bilayer formula at E_s = 0.5 kPa" ;
        schema:name "Soft agar (E_s = 0.5 kPa) wrinkle wavelength" ;
        schema:unitText "um" ;
        schema:value "1283.96" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-soft-agar-e-s-0-5-kpa-wrinkle-wavelength-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-soft-agar-e-s-0-5-kpa-wrinkle-wavelength-reference> a schema:PropertyValue ;
        dcterms:source "Yan et al. (2019) Nature Physics 15:456-462" ;
        schema:value "1280.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-standard-1-5-agar-e-s-2-5-kpa-f-ppl-von-k-rm-n-wrinkle-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Standard 1.5% agar (E_s = 2.5 kPa) Föppl-von Kármán wrinkle wavelength = 750.87 um" ;
        dcterms:description "Baseline analytic wavelength at E_s = 2.5 kPa, h = 80 um" ;
        schema:measurementTechnique "Föppl-von Kármán bilayer formula lambda_c = 2*pi*h*(E_bar_f/(3*E_bar_s))^(1/3)" ;
        schema:name "Standard 1.5% agar (E_s = 2.5 kPa) Föppl-von Kármán wrinkle wavelength" ;
        schema:unitText "um" ;
        schema:value "750.87" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-standard-1-5-agar-e-s-2-5-kpa-f-ppl-von-k-rm-n-wrinkle-wavelength-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-standard-1-5-agar-e-s-2-5-kpa-f-ppl-von-k-rm-n-wrinkle-wavelength-reference> a schema:PropertyValue ;
        dcterms:source "Asally et al. (2012) PNAS 109:18891-18896 & Yan et al. (2019) Nature Physics 15:456-462" ;
        schema:value "750.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-standard-1-5-agar-e-s-2-5-kpa-radial-wrinkle-spoke-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Standard 1.5% agar (E_s = 2.5 kPa) radial wrinkle spoke count = 13 count" ;
        dcterms:description "Baseline spoke count around R_ring = 1600 um" ;
        schema:measurementTechnique "Circumferential mode selection N_spokes = round(2*pi*R_ring/lambda_c)" ;
        schema:name "Standard 1.5% agar (E_s = 2.5 kPa) radial wrinkle spoke count" ;
        schema:unitText "count" ;
        schema:value "13" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-standard-1-5-agar-e-s-2-5-kpa-radial-wrinkle-spoke-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-standard-1-5-agar-e-s-2-5-kpa-radial-wrinkle-spoke-count-reference> a schema:PropertyValue ;
        dcterms:source "Asally et al. (2012) PNAS Fig. 1 & Yan et al. (2019) Nature Physics Fig. 3" ;
        schema:value "13" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-stiff-agar-e-s-10-0-kpa-wrinkle-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Stiff agar (E_s = 10.0 kPa) wrinkle wavelength = 473.02 um" ;
        dcterms:description "Shortened wavelength on stiff agar" ;
        schema:measurementTechnique "Föppl-von Kármán bilayer formula at E_s = 10.0 kPa" ;
        schema:name "Stiff agar (E_s = 10.0 kPa) wrinkle wavelength" ;
        schema:unitText "um" ;
        schema:value "473.02" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-stiff-agar-e-s-10-0-kpa-wrinkle-wavelength-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-stiff-agar-e-s-10-0-kpa-wrinkle-wavelength-reference> a schema:PropertyValue ;
        dcterms:source "Yan et al. (2019) Nature Physics 15:456-462" ;
        schema:value "472.0" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 094 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


    <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Asally et al. (2012) PNAS & Yan et al. (2019) Nature Physics osmotic matrix swelling, localized cell-death delamination, and Föppl–von Kármán radial wrinkle spokes in Bacillus subtilis biofilms — Code-to-model traceability: 68/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Links module docstrings to Asally et al. (2012) PNAS, Yan et al. (2019) Nature Physics, and the 3 Lean 4 theorems in `Loop_094_bacillus_biofilm_wrinkling.lean` (L1-11), but lacks trace links for 2D Föppl–von Kármán energy relaxation, localized cell-death delamination, and artificial score-guided spoke selection." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-code-traceability-1> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

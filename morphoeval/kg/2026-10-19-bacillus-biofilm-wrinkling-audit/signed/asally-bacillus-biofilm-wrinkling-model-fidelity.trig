sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-asally-bacillus-biofilm-wrinkling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Asally et al. (2012) PNAS & Yan et al. (2019) Nature Physics osmotic matrix swelling, localized cell-death delamination, and Föppl–von Kármán radial wrinkle spokes in Bacillus subtilis biofilms — Model fidelity to source: 58/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes plane-strain moduli E_bar_f and E_bar_s, characteristic Föppl–von Kármán wavelength lambda_c = 2*pi*h*(E_bar_f/(3*E_bar_s))^(1/3), critical strain epsilon_c, and radial spoke count N_spokes (L34-53), backed by 3 Lean 4 theorems in `Loop_094_bacillus_biofilm_wrinkling.lean`. However, `generate_parametric_biofilm_surface` (L56-73) uses a hardcoded polar ansatz rather than minimizing a 2D circular Föppl–von Kármán + localized cell-death delamination free-energy functional, and lacks Delta eps/tasA mutant and artificial cell-death score controls." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2013-asally-bacillus-biofilm-wrinkling.py L56–L73: Closed-form polar cosine ansatz instead of 2D Föppl-von Kármán + cell-death delamination energy relaxation <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py#L56-L73>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-model-fidelity-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2013-asally-bacillus-biofilm-wrinkling.py L34–L53" ;
        dcterms:description "Exact Föppl-von Kármán bilayer wavelength lambda_c, critical strain epsilon_c, and spoke count N_spokes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py#L34-L53> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 094 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


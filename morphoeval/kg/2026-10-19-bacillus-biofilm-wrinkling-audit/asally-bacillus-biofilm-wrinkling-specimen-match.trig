sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-asally-bacillus-biofilm-wrinkling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Asally et al. (2012) PNAS & Yan et al. (2019) Nature Physics osmotic matrix swelling, localized cell-death delamination, and Föppl–von Kármán radial wrinkle spokes in Bacillus subtilis biofilms — Morphological realism / specimen match: 35/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Although `datasets/bacillus_biofilm_wrinkling/bacillus_biofilm_specimen.jpg` is vendored on disk, the v1 script never loads, segments, or extracts macrocolony count and radial spoke ridge profiles from the biological specimen image." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2013-asally-bacillus-biofilm-wrinkling.py L76–L94: Evaluates only 7-point agar stiffness table without loading or segmenting bacillus_biofilm_specimen.jpg <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py#L76-L94>",
            "docs/media/bacillus_biofilm_wrinkling_comparison.png (generated output, not in repo): 4-panel v1 plot lacks biofilm specimen segmentation, mutant controls, and thickness scaling — docs/media/bacillus_biofilm_wrinkling_comparison.png: rendered output of 2013-asally-bacillus-biofilm-wrinkling.py at e93f00e, image/png, 212694 B, 1680×1400 px, artifact_sha256 9799ba47f741b45ebe1677a6ea2ccf5fca372bdb8723754e0f55739d0a798926 (sha256 9799ba47f741b45ebe1677a6ea2ccf5fca372bdb8723754e0f55739d0a798926), spec_fingerprint 80d4742b3055639fafb02a0909f223313e723e53cf52d4df159742cd92171fba" ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 094 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


    <https://doi.org/10.1038/s41567-018-0392-9> dct:date "2019"^^xsd:gYear ;
        dct:title "Mechanical instability and interfacial energy drive biofilm morphogenesis" .
    <https://doi.org/10.1073/pnas.1102300108> dct:date "2012"^^xsd:gYear ;
        dct:title "Osmotic spreading of Bacillus subtilis biofilms driven by an extracellular matrix" .
    <https://doi.org/10.1073/pnas.1212429109> dct:date "2012"^^xsd:gYear ;
        dct:title "Localized cell death focuses mechanical forces during 3D patterning in a biofilm" .
    <https://doi.org/10.1073/pnas.1217178110> dct:date "2013"^^xsd:gYear ;
        dct:title "Elasticity and wrinkled morphology of Bacillus subtilis pellicles" .

<https://w3id.org/probknow/resource/claim/morphoeval-asally-bacillus-biofilm-wrinkling> a pk:Claim ;
    rdfs:label "Asally et al. (2012) PNAS & Yan et al. (2019) Nature Physics osmotic matrix swelling, localized cell-death delamination, and Föppl–von Kármán radial wrinkle spokes in Bacillus subtilis biofilms (Bacillus subtilis (NCIB 3610 wild-type and matrix/cell-death mutant biofilm macrocolonies))",
        "Asally et al. (2012) PNAS & Yan et al. (2019) Nature Physics osmotic matrix swelling, localized cell-death delamination, and Föppl–von Kármán radial wrinkle spokes in Bacillus subtilis biofilms faithfully reproduces Bacillus subtilis (NCIB 3610 wild-type and matrix/cell-death mutant biofilm macrocolonies) morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/asally-bacillus-biofilm-wrinkling-1>,
        <https://w3id.org/probknow/resource/math-law/asally-bacillus-biofilm-wrinkling-2>,
        <https://w3id.org/probknow/resource/math-law/asally-bacillus-biofilm-wrinkling-3> ;
    dct:description "The simulation script(s) 2013-asally-bacillus-biofilm-wrinkling.py implement the cited source model as published and produce forms that match real Bacillus subtilis (NCIB 3610 wild-type and matrix/cell-death mutant biofilm macrocolonies) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 53.5/100, audit 2026-10-19-bacillus-biofilm-wrinkling-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py> ;
    schema:about "Bacillus subtilis (NCIB 3610 wild-type and matrix/cell-death mutant biofilm macrocolonies)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py; output: docs/media/bacillus_biofilm_wrinkling_comparison.png; organism: Bacillus subtilis (NCIB 3610 wild-type and matrix/cell-death mutant biofilm macrocolonies); checkpoint commit: https://github.com/fractastical/morpholib/commit/e93f00e; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 80d4742b3055639fafb02a0909f223313e723e53cf52d4df159742cd92171fba; artifact_sha256: 9799ba47f741b45ebe1677a6ea2ccf5fca372bdb8723754e0f55739d0a798926; input_dataset_sha256: {datasets/bacillus_biofilm_wrinkling/bacillus_biofilm_specimen.jpg=0ab531dfc2ded692..., datasets/bacillus_biofilm_wrinkling/bacillus_biofilm_wrinkling_reference.json=7d866d4d5136d397..., datasets/bacillus_biofilm_wrinkling/paper_citations.bib=ae278450d6851340..., datasets/bacillus_biofilm_wrinkling/scout_manifest.json=d546628168a39289...}" ;
    pk:derivedFromPaper <https://doi.org/10.1038/s41567-018-0392-9>,
        <https://doi.org/10.1073/pnas.1102300108>,
        <https://doi.org/10.1073/pnas.1212429109>,
        <https://doi.org/10.1073/pnas.1217178110> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-model-fidelity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-morphometric-validation>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-overall>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-parameter-expressivity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-bacillus-biofilm-wrinkling-audit-asally-bacillus-biofilm-wrinkling-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-bacillus-biofilm-wrinkling-audit-asally-bacillus-biofilm-wrinkling-2>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-bacillus-biofilm-wrinkling-audit-asally-bacillus-biofilm-wrinkling-3>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-bacillus-biofilm-wrinkling-audit-asally-bacillus-biofilm-wrinkling-4> ;
    pk:hypothesisType "Föppl–von Kármán Bilayer Delamination Buckling & Circumferential Wavenumber m* = 2πR/λ_c Selection on a Compliant Agar Substrate" ;
    pk:weightOfEvidence 5.35e-01 .


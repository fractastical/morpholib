    pk:hasVerdict "mostly faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Asally et al. (2012) PNAS & Yan et al. (2019) Nature Physics osmotic matrix swelling, localized cell-death delamination, and Föppl–von Kármán radial wrinkle spokes in Bacillus subtilis biofilms — Model fidelity to source: 58/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Computes plane-strain moduli E_bar_f and E_bar_s, characteristic Föppl–von Kármán wavelength lambda_c = 2*pi*h*(E_bar_f/(3*E_bar_s))^(1/3), critical strain epsilon_c, and radial spoke count N_spokes (L34-53), backed by 3 Lean 4 theorems in `Loop_094_bacillus_biofilm_wrinkling.lean`. However, `generate_parametric_biofilm_surface` (L56-73) uses a hardcoded polar ansatz rather than minimizing a 2D circular Föppl–von Kármán + localized cell-death delamination free-energy functional, and lacks Delta eps/tasA mutant and artificial cell-death score controls." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "2013-asally-bacillus-biofilm-wrinkling.py L56–L73: Closed-form polar cosine ansatz instead of 2D Föppl-von Kármán + cell-death delamination energy relaxation <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py#L56-L73>" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-model-fidelity-1> ;
    pk:hasScore 5.8e-01 ;
    pk:hasVerdict "partially faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Asally et al. (2012) PNAS & Yan et al. (2019) Nature Physics osmotic matrix swelling, localized cell-death delamination, and Föppl–von Kármán radial wrinkle spokes in Bacillus subtilis biofilms — Morphometric validation: 52/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "`measure_morphoeval()` (L152-181) reports only 4 analytic numbers (standard, stiff, and soft agar wavelengths plus spoke count) without Pearson r, p-value, RMSE, log-log cube-root scaling slope, thickness scaling correlation, mutant negative-control amplitude delta, or specimen image radial spoke morphometrics." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
    pk:evidenceAgainst "2013-asally-bacillus-biofilm-wrinkling.py L152–L181: Only 4 analytic metrics without statistical tests, mutant controls, or specimen segmentation <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py#L152-L181>" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-soft-agar-e-s-0-5-kpa-wrinkle-wavelength>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-standard-1-5-agar-e-s-2-5-kpa-f-ppl-von-k-rm-n-wrinkle-wavelength>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-standard-1-5-agar-e-s-2-5-kpa-radial-wrinkle-spoke-count>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-stiff-agar-e-s-10-0-kpa-wrinkle-wavelength> ;

<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/asally-bacillus-biofilm-wrinkling-1>,
        <https://w3id.org/probknow/resource/math-law/asally-bacillus-biofilm-wrinkling-2>,
        <https://w3id.org/probknow/resource/math-law/asally-bacillus-biofilm-wrinkling-3> .

<https://w3id.org/probknow/resource/math-law/asally-bacillus-biofilm-wrinkling-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Föppl–von Kármán Bilayer Cube-Root Modulus & Thickness Wavelength Scaling Law" ;
    dct:description "Governs the characteristic wrinkle wavelength λ_c and critical buckling threshold ε_c across agar stiffnesses E_s ∈ [0.5, 10] kPa and biofilm thicknesses h ∈ [40, 140] μm | Variables: h: biofilm thickness; Ē_f = E_f/(1-ν_f^2): biofilm plane-strain modulus; Ē_s = E_s/(1-ν_s^2): compliant agar substrate plane-strain modulus; λ_c: characteristic wrinkle wavelength; ε_c: critical compressive buckling strain" ;
    dct:source "Yan et al. (2019) Nature Physics 15:456-462 Eqs. (1)-(3); Trejo et al. (2013) PNAS 110:2011-2016 Eqs. (2)-(4)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py#L140-L215>,
        <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_094_bacillus_biofilm_wrinkling.lean#L27-L56> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def fvk_wavelength_cubed_residual (lam_scaled h E_f E_s : Int) : Int :=
  3 * E_s * (lam_scaled * lam_scaled * lam_scaled) - E_f * (h * h * h)
def fvk_wavelength_cubed_rhs (h E_f : Nat) : Nat :=
  E_f * (h * h * h)
theorem fvk_cubed_wavelength_stationarity_and_scaling (q h E_s : Int) (h0 dh ef : Nat) :
    fvk_wavelength_cubed_residual (q * h) h (3 * E_s * (q * q * q)) E_s = 0 ∧
    fvk_wavelength_cubed_rhs (h0 + 1) (ef + 1) <
      fvk_wavelength_cubed_rhs (h0 + 1 + (dh + 1)) (ef + 1)
"""^^pk:lean4 ;
    skos:notation "λ_c = 2π h (Ē_f / (3 Ē_s))^(1/3),  ε_c = (1/4)(3 Ē_s / Ē_f)^(2/3)  ⇒  3 Ē_s (λ_c / 2π)^3 = Ē_f h^3" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/s41567-018-0392-9>,
        <https://doi.org/10.1073/pnas.1102300108>,
        <https://doi.org/10.1073/pnas.1212429109>,
        <https://doi.org/10.1073/pnas.1217178110> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Föppl–von Kármán Bilayer Delamination Buckling & Circumferential Wavenumber m* = 2πR/λ_c Selection on a Compliant Agar Substrate" ;
    pk:leanDeclaration "MathOfBiology.Loop_094.fvk_wavelength_cubed_residual" ;
    pk:leanTheorem "MathOfBiology.Loop_094.fvk_cubed_wavelength_stationarity_and_scaling" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/asally-bacillus-biofilm-wrinkling-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Asally et al. (2012) Localized Cell-Death Delamination Buckling Focusing Law" ;
    dct:description "Explains how spatiotemporal basal cell death focuses compressive stresses into 3D delaminated buckles along the central ring and radial spokes, whereas Δeps/ΔtasA matrix mutants and cell-death-suppressed colonies remain unwrinkled | Variables: ε_g: osmotic EPS/TasA matrix-swelling strain; φ_dead(x,y): basal cell-death fraction; γ_d: interfacial adhesion degradation factor; ε_{c,eff}: local delamination strain threshold" ;
    dct:source "Asally et al. (2012) PNAS 109:18891-18896 Figs. 1-4 & SI Text" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py#L218-L355>,
        <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_094_bacillus_biofilm_wrinkling.lean#L68-L78> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def biofilm_buckling_excess (eps_g eps_c_eff : Nat) : Nat :=
  eps_g - eps_c_eff
theorem asally_cell_death_delamination_focusing (eps_c_dead gap_to_intact extra_dead : Nat) :
    let eps_g := eps_c_dead + (extra_dead + 1)
    let eps_c0 := eps_g + gap_to_intact
    biofilm_buckling_excess eps_g eps_c_dead = extra_dead + 1 ∧
    biofilm_buckling_excess eps_g eps_c0 = 0 ∧
    biofilm_buckling_excess 0 eps_c_dead = 0 ∧
    biofilm_buckling_excess eps_g eps_c0 < biofilm_buckling_excess eps_g eps_c_dead
"""^^pk:lean4 ;
    skos:notation "ε_{c,eff}(φ_dead) = ε_c (1 - γ_d φ_dead) < ε_g ≤ ε_c  ⇒  Δε_dead = ε_g - ε_{c,eff} > 0,  Δε_intact = 0,  Δε_{Δeps} = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/s41567-018-0392-9>,
        <https://doi.org/10.1073/pnas.1102300108>,
        <https://doi.org/10.1073/pnas.1212429109>,
        <https://doi.org/10.1073/pnas.1217178110> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Föppl–von Kármán Bilayer Delamination Buckling & Circumferential Wavenumber m* = 2πR/λ_c Selection on a Compliant Agar Substrate" ;
    pk:leanDeclaration "MathOfBiology.Loop_094.biofilm_buckling_excess" ;
    pk:leanTheorem "MathOfBiology.Loop_094.asally_cell_death_delamination_focusing" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/asally-bacillus-biofilm-wrinkling-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Radial Spoke Count Linear Ring-Radius & Inverse Thickness Scaling Law" ;
    dct:description "Determines the number of radial wrinkle spokes N_spokes emerging from the central ring as a function of colony ring radius R_ring, biofilm thickness h, and agar stiffness E_s | Variables: N_spokes: circumferential radial spoke count; R_ring: central concentric ring radius; h: biofilm thickness; m_modulus = (3 Ē_s / Ē_f)^(1/3): cube-root substrate-to-film stiffness ratio" ;
    dct:source "Yan et al. (2019) Nature Physics 15:456-462 Fig. 3; Asally et al. (2012) PNAS 109:18891-18896 Fig. 4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py#L170-L240>,
        <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_094_bacillus_biofilm_wrinkling.lean#L87-L106> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def radial_spoke_cross_residual (N_spokes h R_ring m_modulus : Int) : Int :=
  N_spokes * h - R_ring * m_modulus
def radial_spoke_count_scaled (R_ring m_modulus : Nat) : Nat :=
  R_ring * m_modulus
theorem radial_spoke_ring_and_thickness_scaling (k h m_modulus : Int) (r0 dr m0 : Nat) :
    radial_spoke_cross_residual (k * m_modulus) h (k * h) m_modulus = 0 ∧
    radial_spoke_count_scaled (r0 + 1) (m0 + 1) <
      radial_spoke_count_scaled (r0 + 1 + (dr + 1)) (m0 + 1)
"""^^pk:lean4 ;
    skos:notation "N_spokes = 2π R_ring / λ_c = (R_ring / h) (3 Ē_s / Ē_f)^(1/3)  ⇒  N_spokes h = R_ring (3 Ē_s / Ē_f)^(1/3)" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/s41567-018-0392-9>,
        <https://doi.org/10.1073/pnas.1102300108>,
        <https://doi.org/10.1073/pnas.1212429109>,
        <https://doi.org/10.1073/pnas.1217178110> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Föppl–von Kármán Bilayer Delamination Buckling & Circumferential Wavenumber m* = 2πR/λ_c Selection on a Compliant Agar Substrate" ;
    pk:leanDeclaration "MathOfBiology.Loop_094.radial_spoke_cross_residual" ;
    pk:leanTheorem "MathOfBiology.Loop_094.radial_spoke_ring_and_thickness_scaling" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,

<https://w3id.org/delphi/resource/math-law/delphi10000-gallus-gallus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing onset wavenumber" ;
    dct:description "Critical wavenumber of the Holocene Gallus pigment ocellus at 319.2 µm | Variables: Du=1, Dv=16, b=0.7995, γ solved so λ_c = 319.2 µm" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Prum & Williamson 2002 DOI:10.1098/rspb.2001.1896" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d996d1f6820869dd1e2694a6d36819f4719a6704/models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py#L89-L109>,
        <https://github.com/fractastical/morpholib/blob/d996d1f6820869dd1e2694a6d36819f4719a6704/morphoeval/lean/loops/Loop_3228_gallus_gallus_turing_wavelength_s0.lean#L47-L51> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v),  λ_c = 2π / k_c = 319.2 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0500781102>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pbio.1001028> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3228.turing_onset_gap" ;
    pk:leanTheorem "MathOfBiology.Loop_3228.turing_onset_gap" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gallus-gallus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Singleton chronoseries" ;
    dct:description "Nothing in λ_c is inherited from a predecessor or passed to a successor Gallus chronospecies | Variables: chronoseries index and length" ;
    dct:source "Slot 3228 assignment: Gallus chronoseries 1/1, Holocene 0 Ma" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d996d1f6820869dd1e2694a6d36819f4719a6704/models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py#L42-L48>,
        <https://github.com/fractastical/morpholib/blob/d996d1f6820869dd1e2694a6d36819f4719a6704/morphoeval/lean/loops/Loop_3228_gallus_gallus_turing_wavelength_s0.lean#L39-L45> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "index = 1, length = 1, age = 0 Ma, predecessor = successor = none" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0500781102>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pbio.1001028> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3228.no_predecessor_chronospecies" ;
    pk:leanTheorem "MathOfBiology.Loop_3228.no_successor_chronospecies" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gallus-gallus-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control for Turing wavelength selection at this scale | Variables: Du, Dv" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d996d1f6820869dd1e2694a6d36819f4719a6704/models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py#L79-L87>,
        <https://github.com/fractastical/morpholib/blob/d996d1f6820869dd1e2694a6d36819f4719a6704/morphoeval/lean/loops/Loop_3228_gallus_gallus_turing_wavelength_s0.lean#L53-L57> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "Dv = Du implies h = Dv fu + Du gv < 0, so R = 0 and the homogeneous state is stable" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0500781102>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pbio.1001028> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3228.equal_diffusion_ablation_is_stable" ;
    pk:leanTheorem "MathOfBiology.Loop_3228.equal_diffusion_ablation_is_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gallus-gallus-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Six-wavelength dorsal patch" ;
    dct:description "Field-size change versus a subcritical embryonic domain, not versus another chronospecies | Variables: N_wavelengths = 6, λ_c = 319.2 µm" ;
    dct:source "Harris et al. 2005 DOI:10.1073/pnas.0500781102" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d996d1f6820869dd1e2694a6d36819f4719a6704/models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py#L49-L50>,
        <https://github.com/fractastical/morpholib/blob/d996d1f6820869dd1e2694a6d36819f4719a6704/morphoeval/lean/loops/Loop_3228_gallus_gallus_turing_wavelength_s0.lean#L59-L62> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "L = 6 λ_c = 1915.2 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0500781102>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pbio.1001028> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3228.six_wavelength_domain" ;
    pk:leanTheorem "MathOfBiology.Loop_3228.six_wavelength_domain" ;
    pk:leanVerified true .


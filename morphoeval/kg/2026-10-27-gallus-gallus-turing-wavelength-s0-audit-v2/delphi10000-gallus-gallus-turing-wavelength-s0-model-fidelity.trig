sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Gallus gallus Holocene Turing pigment-ocellus wavelength, 319.2 µm (pass 2) — Model fidelity to source: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The onset formula is solved for λ_c = 319.2 µm and the same Jacobian is integrated: the critical cosine grows at Dv = 16 and decays when Dv = Du. This is Schnakenberg wavelength selection, not a transcription of the Prum & Williamson feather-growth coordinate system." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py L89–L109" ;
        dct:description "gamma_for_wavelength and critical_wavelength_um" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d996d1f6820869dd1e2694a6d36819f4719a6704/models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py#L89-L109> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py L249–L270" ;
        dct:description "integrate_schnakenberg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d996d1f6820869dd1e2694a6d36819f4719a6704/models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py#L249-L270> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3228_gallus_gallus_turing_wavelength_s0.lean L47–L57" ;
        dct:description "onset gap and equal-diffusion ablation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d996d1f6820869dd1e2694a6d36819f4719a6704/morphoeval/lean/loops/Loop_3228_gallus_gallus_turing_wavelength_s0.lean#L47-L57> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; pass-2 rescore after remediation)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0500781102>,
            <https://doi.org/10.1098/rspb.2001.1896>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1371/journal.pbio.1001028> .
    <https://doi.org/10.1073/pnas.0500781102> dct:title "Molecular evidence for an activator-inhibitor mechanism in development of embryonic feather branching" .
    <https://doi.org/10.1098/rspb.2001.1896> dct:title "Reaction-diffusion models of within-feather pigmentation patterning" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1371/journal.pbio.1001028> dct:title "Cryptic patterning of avian skin confers a developmental facility for loss of neck feathering" .
}


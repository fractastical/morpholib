}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Gallus gallus Holocene Turing pigment-ocellus wavelength, 319.2 µm (pass 2) faithfully reproduces Gallus gallus morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py, morphoeval/lean/loops/Loop_3228_gallus_gallus_turing_wavelength_s0.lean implement the cited source model as published and produce forms that match real Gallus gallus specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py>,
            <https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3228_gallus_gallus_turing_wavelength_s0.lean> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py, https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3228_gallus_gallus_turing_wavelength_s0.lean; output: docs/media/gallus_gallus_turing_wavelength_s0_comparison.png; organism: Gallus gallus; environment: python 3.12.3, note numpy, scipy, pillow, matplotlib, pyyaml, rdflib; claim_boundary: [reported_in_source: Turing (1952) derived a finite-wavenumber instability of a homogeneous reaction-diffusion state. | Prum & Williamson (2002) reproduced within-feather bars, spots, and ocelli with reaction-diffusion on a growing feather germ. | Harris et al. (2005) reported Shh/Bmp2 activator-inhibitor interactions during barb-ridge formation in embryonic Gallus gallus.; reconstructed_in_script: Schnakenberg onset at (a, b, Du, Dv) = (0.2005, 0.7995, 1, 16) with γ solved so λ_c = 319.2 µm. | Dv sweep, equal-diffusion ablation, and a short periodic integration of the same kinetics. | Held-out three-harmonic radial fit and computer-vision segmentation of the gallery ocellus plate. | Singleton Holocene chronoseries: age 0 Ma, no predecessor and no successor.; transfer_boundary: 319.2 µm is the slot wavelength. The painted bar measures a 66.4 µm ring pitch on this plate and is not used as λ_c. | The radial reconstruction is a weakly nonlinear reduction of the critical circle, not Prum & Williamson's full growing-feather geometry.; does_not_claim: A blinded test on a second feather. | That the painted 100 µm bar equals 319.2 µm. | An independent second assessor.]; phenomenon_size: 358 µm (0.0003584 m, log10=-3.446 m, tier=5_primordium_100um); species_scale_ladder (22 runs from 358 µm to 80.6 cm): 358 µm:gallus-gallus-bioelectric-polarity, 691 µm:gallus-gallus-vertex-packing, 752 µm:differential-adhesion-sorting, 752 µm:gastrulation-streak-attractor, 1.3 cm:gallus-gallus-turing-wavelength, 2.2 cm:fgf-wnt-bistable-wavefront, 2.4 cm:gallus-gallus-clock-wavefront, 4.5 cm:joint-interzone-clefting" ;
        pk:derivedFromPaper <https://doi.org/10.1073/pnas.0500781102>,
            <https://doi.org/10.1098/rspb.2001.1896>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1371/journal.pbio.1001028> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
    <https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3228_gallus_gallus_turing_wavelength_s0.lean> a schema:SoftwareSourceCode ;
        rdfs:label "morphoeval/lean/loops/Loop_3228_gallus_gallus_turing_wavelength_s0.lean" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Lean 4" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0500781102>,
            <https://doi.org/10.1098/rspb.2001.1896>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1371/journal.pbio.1001028> .
    <https://doi.org/10.1073/pnas.0500781102> dct:title "Molecular evidence for an activator-inhibitor mechanism in development of embryonic feather branching" .
    <https://doi.org/10.1098/rspb.2001.1896> dct:title "Reaction-diffusion models of within-feather pigmentation patterning" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1371/journal.pbio.1001028> dct:title "Cryptic patterning of avian skin confers a developmental facility for loss of neck feathering" .
}


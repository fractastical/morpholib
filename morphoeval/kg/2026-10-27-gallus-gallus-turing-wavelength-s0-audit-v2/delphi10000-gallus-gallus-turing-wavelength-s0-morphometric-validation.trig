sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Gallus gallus Holocene Turing pigment-ocellus wavelength, 319.2 µm (pass 2) — Morphometric validation: 87/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Held-out Pearson r = 0.9855 versus a detuned null, held-out RMSE = 5.50 versus the null RMSE, KS = 0.084 versus a 0.5 reference, and structure-tensor coherency 0.958 on the render versus 0.846 on the plate. The painted pitch is 66.4 µm against the model wavelength 319.2 µm. All of these references differ from the measured values. The fit is still one plate." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-ablation-control-activator-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-dv-sweep-wavelength-span>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-plate-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-held-out-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-held-out-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-turing-onset-wavelength-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-ablation-control-activator-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation control activator std ratio = 10.3945 std(Dv=16) / std(Dv=Du)" ;
        dct:description "Turing std 0.02583 vs ablation std 0.00248" ;
        schema:measurementTechnique "1800-step periodic Schnakenberg integration, seed cos(2π x / 24)" ;
        schema:name "ablation control activator std ratio" ;
        schema:unitText "std(Dv=16) / std(Dv=Du)" ;
        schema:value "10.3945" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-ablation-control-activator-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-ablation-control-activator-std-ratio-reference> a schema:PropertyValue ;
        dct:source "Ratio expected if the equal-diffusion ablation did not decay" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-dv-sweep-wavelength-span> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Dv sweep wavelength span = 9.8535 µm" ;
        dct:description "Positive span means λ_c falls as Dv rises above onset" ;
        schema:measurementTechnique "λ_c(Dv) at fixed γ on the unstable branch; span is first minus last" ;
        schema:name "Dv sweep wavelength span" ;
        schema:unitText "µm" ;
        schema:value "9.8535" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-dv-sweep-wavelength-span-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-dv-sweep-wavelength-span-reference> a schema:PropertyValue ;
        dct:source "Zero span would mean Dv does not move the wavelength" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-plate-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen plate structure-tensor coherency = 0.9584 coherency" ;
        dct:description "plate foreground=0.4448 circularity=0.0719; model foreground=0.7762 circularity=0.1467" ;
        schema:measurementTechnique "verify_image_fitness.compute_specimen_cv_signature on the rendered steady frame" ;
        schema:name "specimen plate structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.9584" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-plate-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-plate-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "Same segmenter on gallus_gallus_ocellus_specimen.jpg" ;
        schema:value "0.8463" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-held-out-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial profile held-out Pearson r = 0.9855 correlation" ;
        dct:description "in-sample r = 0.9855; RMSE = 5.5030" ;
        schema:measurementTechnique "3-harmonic critical mode fit on even radii, Pearson r on odd radii" ;
        schema:name "specimen radial profile held-out Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.9855" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-held-out-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-held-out-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Same design at wavenumber 1.45 k_c (detuned null)" ;
        schema:value "0.7704" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-held-out-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial profile held-out RMSE = 5.503 gray levels" ;
        dct:description "lower residual than the null" ;
        schema:measurementTechnique "RMSE of odd-radius residuals of the 3-harmonic reconstruction" ;
        schema:name "specimen radial profile held-out RMSE" ;
        schema:unitText "gray levels" ;
        schema:value "5.503" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-held-out-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-held-out-rmse-reference> a schema:PropertyValue ;
        dct:source "RMSE of the detuned-wavenumber null" ;
        schema:value "20.6863" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial profile KS statistic = 0.084 KS distance" ;
        dct:description "p = 0.7971" ;
        schema:measurementTechnique "two-sample KS between held-out specimen radii and the reconstruction" ;
        schema:name "specimen radial profile KS statistic" ;
        schema:unitText "KS distance" ;
        schema:value "0.084" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-specimen-radial-profile-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "Conventional large-discrepancy reference, not the measured statistic" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-turing-onset-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing onset wavelength lambda_c = 319.2 µm" ;
        dct:description "Model wavelength and painted-bar pitch are different lengths" ;
        schema:measurementTechnique "k_c^2 = (Dv fu + Du gv) / (2 Du Dv) with γ solved for 319.2 µm" ;
        schema:name "Turing onset wavelength lambda_c" ;
        schema:unitText "µm" ;
        schema:value "319.2" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-turing-onset-wavelength-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-measurement-turing-onset-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Gallery plate: ring pitch times the contiguous painted 100 µm bar" ;
        schema:value "66.3636" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py L192–L237" ;
        dct:description "multi_harmonic_fit held-out Pearson, RMSE, KS" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d996d1f6820869dd1e2694a6d36819f4719a6704/models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py#L192-L237> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py L139–L160" ;
        dct:description "contiguous scale-bar measurement" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d996d1f6820869dd1e2694a6d36819f4719a6704/models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py#L139-L160> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gallus-gallus-turing-wavelength-s0-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py L560–L653" ;
        dct:description "measure_morphoeval non-circular specimen metrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d996d1f6820869dd1e2694a6d36819f4719a6704/models/2026-delphi10000-gallus-gallus-turing-wavelength-s0.py#L560-L653> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; pass-2 rescore after remediation)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.0500781102>,
            <https://doi.org/10.1098/rspb.2001.1896>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1371/journal.pbio.1001028> .
    <https://doi.org/10.1073/pnas.0500781102> dct:title "Molecular evidence for an activator-inhibitor mechanism in development of embryonic feather branching" .
    <https://doi.org/10.1098/rspb.2001.1896> dct:title "Reaction-diffusion models of within-feather pigmentation patterning" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1371/journal.pbio.1001028> dct:title "Cryptic patterning of avian skin confers a developmental facility for loss of neck feathering" .
}


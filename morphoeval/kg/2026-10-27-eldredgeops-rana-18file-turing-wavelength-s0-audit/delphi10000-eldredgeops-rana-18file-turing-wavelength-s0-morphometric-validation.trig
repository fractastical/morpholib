sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Turing k_c at 492 nm for the 18-file Eldredgeops eye (Cazenovian, 387 Ma) — Morphometric validation: 78/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 1.0 with RMSE 3.15e-12 on real-eigenvalue modes (spectral mode plus RK4). Nonlinear FFT wavelength is 574 nm against the linear reference 492 nm. Specimen structure-tensor coherency is 0.479 against 0.746 on the simulated field. KS, Otsu foreground, and multi-seed CV are not in the Pass-1 measurement set." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-conserved-arc-wavelengths-per-file-ratio-versus-17-file-successor>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-real-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-nonlinear-fft-wavelength-of-the-saturated-u-field>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-rk4-vs-eigenvalue-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-specimen-eye-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-conserved-arc-wavelengths-per-file-ratio-versus-17-file-successor> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "conserved-arc wavelengths-per-file ratio versus 17-file successor = 1.058824 ratio" ;
        dct:description "The 492 nm wavenumber is held fixed; file loss changes wavelengths per file" ;
        schema:measurementTechnique "n_files(387 Ma) / n_files(384 Ma) = 18/17 at fixed 492 nm" ;
        schema:name "conserved-arc wavelengths-per-file ratio versus 17-file successor" ;
        schema:unitText "ratio" ;
        schema:value "1.058824" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-conserved-arc-wavelengths-per-file-ratio-versus-17-file-successor-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-conserved-arc-wavelengths-per-file-ratio-versus-17-file-successor-reference> a schema:PropertyValue ;
        dct:source "Null of no file-count change" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-real-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation max real growth rate = -0.811874 1/time" ;
        dct:description "Negative value: removing the diffusivity contrast kills the Turing band" ;
        schema:measurementTechnique "max Re(σ(k)) with Du = Dv on k/k_c in [0.2, 3]" ;
        schema:name "equal-diffusion ablation max real growth rate" ;
        schema:unitText "1/time" ;
        schema:value "-0.811874" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-real-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-real-growth-rate-reference> a schema:PropertyValue ;
        dct:source "Marginal stability of the homogeneous state" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-nonlinear-fft-wavelength-of-the-saturated-u-field> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nonlinear FFT wavelength of the saturated u field = 574.0 nm" ;
        dct:description "Saturated spots shift off the linear k_c; the two numbers are not forced equal" ;
        schema:measurementTechnique "radial peak of |FFT(u)|^2 times 492 nm per model unit" ;
        schema:name "nonlinear FFT wavelength of the saturated u field" ;
        schema:unitText "nm" ;
        schema:value "574.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-nonlinear-fft-wavelength-of-the-saturated-u-field-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-nonlinear-fft-wavelength-of-the-saturated-u-field-reference> a schema:PropertyValue ;
        dct:source "Linear critical wavelength assigned to this 492 nm slot" ;
        schema:value "492.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-rk4-vs-eigenvalue-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "RK4 vs eigenvalue dispersion Pearson r = 1.0 Pearson r" ;
        dct:description "RMSE = 0.000000 on n = 16 real-eigenvalue modes" ;
        schema:measurementTechnique "corrcoef of RK4 Fourier-mode growth rates against the leading real eigenvalue of J - k^2 D" ;
        schema:name "RK4 vs eigenvalue dispersion Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-rk4-vs-eigenvalue-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-rk4-vs-eigenvalue-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Exact eigenvalue of the linear Turing dispersion matrix" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-specimen-eye-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen eye structure-tensor coherency = 0.4788 coherency" ;
        dct:description "Photograph versus simulation; a self-copy would have been rejected" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) on Sobel structure tensor of the Commons eye photograph" ;
        schema:name "specimen eye structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.4788" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-specimen-eye-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-measurement-specimen-eye-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "Same coherency operator on the saturated Schnakenberg field" ;
        schema:value "0.7456" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0.py L130–L162" ;
        dct:description "dispersion_fit Pearson r and RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/332efe5138233530509bf80322afc73c77f98255/models/2026-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0.py#L130-L162> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0.py L235–L247" ;
        dct:description "Specimen structure-tensor coherency" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/332efe5138233530509bf80322afc73c77f98255/models/2026-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0.py#L235-L247> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, loop 3215)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0002-1267-0234> .
}


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Turing k_c at 492 nm for the 18-file Eldredgeops eye (Cazenovian, 387 Ma) — Code-to-model traceability: 84/100" ;

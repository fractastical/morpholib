<https://w3id.org/delphi/resource/math-law/delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg activator-inhibitor kinetics" ;
    dct:description "Reaction terms whose Jacobian supplies f_u, f_v, g_u, g_v at 387 Ma | Variables: a=0.146, b=1.038, gamma=2.40; u0=a+b" ;
    dct:source "Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/332efe5138233530509bf80322afc73c77f98255/models/2026-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/332efe5138233530509bf80322afc73c77f98255/morphoeval/lean/loops/Loop_3215_eldredgeops_rana_18file_turing_wavelength_s0.lean#L11-L20> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "du/dt = Du lap(u) + gamma (a - u + u^2 v); dv/dt = Dv lap(v) + gamma (b - u^2 v)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.asd.2006.08.002>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.5531/sd.paleo.7> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3215.lambdaNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3215.lambda_nm_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing critical wavenumber" ;
    dct:description "Wavelength selection at the 492 nm detail scale, distinct from the 18 µm sibling | Variables: Du_prescale=0.018, Dv_prescale=0.492, then space rescaled so lambda_c is one model unit" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/332efe5138233530509bf80322afc73c77f98255/models/2026-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/332efe5138233530509bf80322afc73c77f98255/morphoeval/lean/loops/Loop_3215_eldredgeops_rana_18file_turing_wavelength_s0.lean#L41-L45> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (Dv f_u + Du g_v) / (2 Du Dv); lambda_c = 2 pi / k_c = 4.915e-07 m" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.asd.2006.08.002>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.5531/sd.paleo.7> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3215.inhibitor_diffuses_faster" ;
    pk:leanTheorem "MathOfBiology.Loop_3215.inhibitor_diffuses_faster" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-eldredgeops-rana-18file-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Conserved-arc file-count step" ;
    dct:description "What changes versus the 17-file successor at this wavelength | Variables: n_files=18 at 387 Ma; successor n_files=17 at 384 Ma" ;
    dct:source "Eldredge (1972) Bull. AMNH 147(2), https://digitallibrary.amnh.org/handle/2246/1095" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/332efe5138233530509bf80322afc73c77f98255/models/2026-delphi10000-eldredgeops-rana-18file-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/332efe5138233530509bf80322afc73c77f98255/morphoeval/lean/loops/Loop_3215_eldredgeops_rana_18file_turing_wavelength_s0.lean#L22-L24> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "n_waves_per_file(17) / n_waves_per_file(18) = 18/17 at fixed lambda_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.asd.2006.08.002>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.5531/sd.paleo.7> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3215.file_count_drops_by_one" ;
    pk:leanTheorem "MathOfBiology.Loop_3215.file_count_drops_by_one" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


    pk:hasProbability 4e-01 ;
    pk:hasVerdict "partially faithful" .

<https://w3id.org/probknow/resource/assessment/2026-10-18-venation-audit-runions-leaf-venation-repro-package> a pk:LLMClaimAssessment ;
    rdfs:label "Runions et al. (2005) Leaf Venation Space-Colonization & Murray's Law — Reproducibility package: 55/100" ;
    rdfs:comment "Deterministic RNG seeds, SHA-256 checks, and --self-test are provided, but the unused scipy.spatial.Delaunay import and incomplete 8-row CSV limit standalone verification. Evidence: 2005-runions-leaf-venation.py L67–L67: Unused scipy.spatial.Delaunay import <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L67-L67>; 2005-runions-leaf-venation.py L885–L902: run_self_test() in v1 <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L885-L902>." ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-runions-leaf-venation-repro-package> ;
    pk:hasProbability 5.5e-01 ;
    pk:hasVerdict "partially faithful" .


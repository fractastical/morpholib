sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-18-venation-audit-runions-leaf-venation-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Runions et al. (2005) Leaf Venation Space-Colonization & Murray's Law — Morphological realism / specimen match: 20/100" ;
        rdfs:comment "Both specimen photographs have verified SHA-256 locks, but ginkgo_open_venation_specimen.jpg is never loaded or displayed and reticulate_vein_skeleton_specimen.jpg is only shown via imshow() with zero pixel segmentation, skeletonization, or empirical graph extraction. Evidence: 2005-runions-leaf-venation.py L72–L74: GINKGO_IMG_PATH defined but unused in v1 <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L72-L74>; 2005-runions-leaf-venation.py L708–L718: Panel C only calls imshow(img) on SKELETON_IMG_PATH <https://github.com/fractastical/morpholib/blob/c89d18d/2005-runions-leaf-venation.py#L708-L718>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-runions-leaf-venation-specimen-match> ;
        pk:hasProbability "0.2"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-runions-leaf-venation-specimen-match> rdfs:label "Runions et al. (2005) Leaf Venation Space-Colonization & Murray's Law (2005-runions-leaf-venation.py, docs/media/runions_leaf_venation_growth.gif, runions_leaf_venation_metrics.csv) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Ginkgo biloba (open dichotomous venation) & angiosperm dicot lamina (reticulate venation)" ;
        dct:identifier "morphoeval/0.1.0/specimen-match" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1145/1073204.1073251>,
            <https://doi.org/10.1371/journal.pcbi.1004680>,
            <https://doi.org/10.1371/journal.pone.0037994>,
            <https://doi.org/10.1371/journal.pone.0085420> .
    <https://doi.org/10.1073/pnas.12.3.207> dct:date "1926"^^xsd:gYear ;
        dct:title "The physiological principle of minimum work. I. The vascular system and the cost of blood volume" .
    <https://doi.org/10.1145/1073204.1073251> dct:date "2005"^^xsd:gYear ;
        dct:title "Modeling and visualization of leaf venation patterns" .
    <https://doi.org/10.1371/journal.pcbi.1004680> dct:date "2015"^^xsd:gYear ;
        dct:title "Topological Phenotypes Constitute a New Dimension in the Phenotypic Space of Leaf Venation Networks" .
    <https://doi.org/10.1371/journal.pone.0037994> dct:date "2012"^^xsd:gYear ;
        dct:title "Quantifying Loopy Network Architectures" .
    <https://doi.org/10.1371/journal.pone.0085420> dct:date "2013"^^xsd:gYear ;
        dct:title "The Influence of Branch Order on Optimal Leaf Vein Geometries: Murray's Law and Area Preserving Branching" .
}


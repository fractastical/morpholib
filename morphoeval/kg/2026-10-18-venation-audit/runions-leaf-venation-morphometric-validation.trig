            <https://doi.org/10.1371/journal.pone.0037994>,
            <https://doi.org/10.1371/journal.pone.0085420> .
    <https://doi.org/10.1073/pnas.12.3.207> dct:date "1926"^^xsd:gYear ;
        dct:title "The physiological principle of minimum work. I. The vascular system and the cost of blood volume" .
    <https://doi.org/10.1145/1073204.1073251> dct:date "2005"^^xsd:gYear ;
        dct:title "Modeling and visualization of leaf venation patterns" .
    <https://doi.org/10.1371/journal.pcbi.1004680> dct:date "2015"^^xsd:gYear ;

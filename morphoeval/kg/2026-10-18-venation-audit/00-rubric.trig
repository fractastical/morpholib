    sub: rdfs:label "MorphoEval rubric v0.1.0" ;
        dct:created "2026-10-19T16:30:05Z"^^xsd:dateTime ;
        dct:creator <https://orcid.org/0009-0007-4948-9192> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType pk:Concept ;
        npx:introduces <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU> ;
        nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8>,
            <https://w3id.org/np/RAtKj9bCnB4gUe0E9k-WhffQFSEWd9Ve2hrVllYoLuOB0>,
            <https://w3id.org/np/RAukAcWHRDlkqxk7H2XNSegc1WnHI569INvNr-xdptDGI> ;
        pk:domain <https://w3id.org/probknow/resource/domain/morphogenesis> .
    <https://w3id.org/probknow/resource/domain/morphogenesis> rdfs:label "morphogenesis" .
}

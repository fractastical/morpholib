sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-18-venation-audit-runions-leaf-venation-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Runions et al. (2005) Leaf Venation Space-Colonization & Murray's Law — Source and data traceability: 68/100" ;
        rdfs:comment "DOIs, BibTeX entries, and SHA-256 digests are complete for Runions (2005), Murray (1926), Price (2013), Katifori (2012), and Ronellenfitsch (2015), though venation_reference.json says '14 canonical regimes' in the role description while listing 15 regimes. Evidence: datasets/venation/venation_reference.json L1–L165: DOIs, Table 1 regimes, and specimen SHA-256 locks <https://github.com/fractastical/morpholib/blob/c89d18d/datasets/venation/venation_reference.json#L1-L165>; datasets/venation/paper_citations.bib L1–L55: BibTeX citations <https://github.com/fractastical/morpholib/blob/c89d18d/datasets/venation/paper_citations.bib#L1-L55>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-runions-leaf-venation-source-traceability> ;
        pk:hasProbability "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-runions-leaf-venation-source-traceability> rdfs:label "Runions et al. (2005) Leaf Venation Space-Colonization & Murray's Law (2005-runions-leaf-venation.py, docs/media/runions_leaf_venation_growth.gif, runions_leaf_venation_metrics.csv) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Ginkgo biloba (open dichotomous venation) & angiosperm dicot lamina (reticulate venation)" ;
        dcterms:identifier "morphoeval/0.1.0/source-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" .
}

sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.12.3.207>,
            <https://doi.org/10.1145/1073204.1073251>,
            <https://doi.org/10.1371/journal.pcbi.1004680>,
            <https://doi.org/10.1371/journal.pone.0037994>,
            <https://doi.org/10.1371/journal.pone.0085420> .

    <https://doi.org/10.1073/pnas.12.3.207> dcterms:date "1926"^^xsd:gYear ;
        dcterms:title "The physiological principle of minimum work. I. The vascular system and the cost of blood volume" .

    <https://doi.org/10.1145/1073204.1073251> dcterms:date "2005"^^xsd:gYear ;
        dcterms:title "Modeling and visualization of leaf venation patterns" .

    <https://doi.org/10.1371/journal.pcbi.1004680> dcterms:date "2015"^^xsd:gYear ;
        dcterms:title "Topological Phenotypes Constitute a New Dimension in the Phenotypic Space of Leaf Venation Networks" .

    <https://doi.org/10.1371/journal.pone.0037994> dcterms:date "2012"^^xsd:gYear ;
        dcterms:title "Quantifying Loopy Network Architectures" .

    <https://doi.org/10.1371/journal.pone.0085420> dcterms:date "2013"^^xsd:gYear ;
        dcterms:title "The Influence of Branch Order on Optimal Leaf Vein Geometries: Murray's Law and Area Preserving Branching" .
}


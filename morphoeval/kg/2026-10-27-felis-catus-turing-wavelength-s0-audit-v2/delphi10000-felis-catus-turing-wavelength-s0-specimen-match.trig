sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-felis-catus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 436 µm on Holocene Felis catus (pass 2) — Morphological realism / specimen match: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The growth GIF ends on the real tabby, and the comparison figure places that photograph beside the 431 µm ocellus lattice and a stripe-biased field. The phenotype panel is a registration, not a reconstruction of fetal epidermis, and the isotropic law does not by itself reproduce mackerel stripes. Those limits are why this is not a mid-90s score." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/felis_catus_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "specimen, ocelli, stripe bias, registration, dispersion, Dv sweep — docs/media/felis_catus_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-felis-catus-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/png, 614649 B, 1496×902 px, artifact_sha256 23f064546c3b921273e0aa9cc1fc8f324dfd31182e4201d1c8c83a3e4dc15fe7 (sha256 23f064546c3b921273e0aa9cc1fc8f324dfd31182e4201d1c8c83a3e4dc15fe7), spec_fingerprint dc73277e26df9e4f2f17850cccebf7acc56dadcc0fc11952482db451621788f3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/felis_catus_turing_wavelength_s0_growth.gif (generated output)" ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-felis-catus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 436 µm on Holocene Felis catus (pass 2) — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The dispersion relation is both analytic and numerically integrated (Pearson r 0.990). Ablating autocatalysis and equalising diffusion both remove the instability, which is the Turing mechanism rather than a plotted template. Kinetics remain a Schnakenberg stand-in for the Dkk4 circuit, so the score stays short of a direct molecular implementation." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-felis-catus-turing-wavelength-s0.py L89–L105" ;
        dct:description "analytic leading eigenvalue" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-felis-catus-turing-wavelength-s0.py#L89-L105> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-felis-catus-turing-wavelength-s0.py L453–L513" ;
        dct:description "dispersion_fit numeric growth rates" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-felis-catus-turing-wavelength-s0.py#L453-L513> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-felis-catus-turing-wavelength-s0.py L411–L440" ;
        dct:description "ablation integrator switches off u^2 v and can equalise Du and Dv" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-felis-catus-turing-wavelength-s0.py#L411-L440> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


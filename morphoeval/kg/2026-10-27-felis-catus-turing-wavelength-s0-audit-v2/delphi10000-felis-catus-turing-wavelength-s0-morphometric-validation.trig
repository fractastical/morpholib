sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-felis-catus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 436 µm on Holocene Felis catus (pass 2) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Wavelength 431.3 µm versus 436 µm, dispersion Pearson r 0.990, RMSE 0.370, KS 0.111, and four specimen-segmentation statistics whose references are not copies of the measured values. The wavelength reference is the slot scale, not a published caliper measurement on this cat, and n = 1 photograph." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-ablation-equal-diffusion-amplitude>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-ablation-no-autocatalysis-amplitude>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-cellular-predecessor-fundamental-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-dispersion-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-dv-sweep-lambda-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-selected-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-specimen-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-stripe-anisotropy-index>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-turing-sigma-star>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-wavelength-sweep-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-ablation-equal-diffusion-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_equal_diffusion_amplitude = 0.0 concentration" ;
        dct:description "reference is the patterned nominal amplitude, not the control" ;
        schema:measurementTechnique "simulated negative control with Du = Dv; pattern amplitude after 140 steps" ;
        schema:name "ablation_equal_diffusion_amplitude" ;
        schema:unitText "concentration" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-ablation-equal-diffusion-amplitude-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-ablation-equal-diffusion-amplitude-reference> a schema:PropertyValue ;
        schema:value "9.2496" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-ablation-no-autocatalysis-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_no_autocatalysis_amplitude = 0.0 concentration" ;
        dct:description "control versus nominal; values differ" ;
        schema:measurementTechnique "ablation that drops the u^2 v term; amplitude versus the intact model" ;
        schema:name "ablation_no_autocatalysis_amplitude" ;
        schema:unitText "concentration" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-ablation-no-autocatalysis-amplitude-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-ablation-no-autocatalysis-amplitude-reference> a schema:PropertyValue ;
        schema:value "9.2496" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-cellular-predecessor-fundamental-sigma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cellular_predecessor_fundamental_sigma = -29.405 1/time" ;
        dct:description "reference is σ* of the 436 µm pattern; the cellular predecessor is stable" ;
        schema:measurementTechnique "σ(k_fund) on an 80 µm cellular-tier domain; Felis chronoseries has no earlier species" ;
        schema:name "cellular_predecessor_fundamental_sigma" ;
        schema:unitText "1/time" ;
        schema:value "-29.405" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-cellular-predecessor-fundamental-sigma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-cellular-predecessor-fundamental-sigma-reference> a schema:PropertyValue ;
        schema:value "2.7561" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-dispersion-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_ks_statistic = 0.1111 1" ;
        dct:description "reference 0 would mean identical distributions" ;
        schema:measurementTechnique "two-sample KS statistic between the analytic and numeric sigma samples" ;
        schema:name "dispersion_ks_statistic" ;
        schema:unitText "1" ;
        schema:value "0.1111" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r = 0.9901 1" ;
        dct:description "reference 1 would be a perfect match; the value is the measured correlation and is not copied from it" ;
        schema:measurementTechnique "Pearson r between analytic sigma(k) and a linearised spectral integration across 18 wavenumbers" ;
        schema:name "dispersion_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.9901" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_rmse = 0.3695 1/time" ;
        dct:description "reference 0 is the zero-error line" ;
        schema:measurementTechnique "RMSE of numeric versus analytic growth rates; damped modes dominate the residual" ;
        schema:name "dispersion_rmse" ;
        schema:unitText "1/time" ;
        schema:value "0.3695" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-dv-sweep-lambda-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dv_sweep_lambda_pearson_r = 0.9841 1" ;
        dct:description "reference 0 is no relationship; the sweep is monotonically positive" ;
        schema:measurementTechnique "Pearson r of selected wavelength against inhibitor diffusivity Dv" ;
        schema:name "dv_sweep_lambda_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.9841" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-dv-sweep-lambda-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-dv-sweep-lambda-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-selected-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "selected_stripe_wavelength = 431.251 µm" ;
        dct:description "reference is the slot scale, not a Kaelin measurement; value is the simulated dominant wavelength" ;
        schema:measurementTechnique "radial FFT peak of the Schnakenberg activator on a 5-wave periodic patch, scaled so λ(k*) = 436 µm" ;
        schema:name "selected_stripe_wavelength" ;
        schema:unitText "µm" ;
        schema:value "431.251" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-selected-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-selected-stripe-wavelength-reference> a schema:PropertyValue ;
        schema:value "436.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-specimen-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_aspect_ratio = 1.3723 1" ;
        dct:description "reference 1 is a square box" ;
        schema:measurementTechnique "bounding-box width/height of the segmented cat" ;
        schema:name "specimen_aspect_ratio" ;
        schema:unitText "1" ;
        schema:value "1.3723" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-specimen-aspect-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-specimen-aspect-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_circularity = 0.146 1" ;
        dct:description "reference 1 is a circle; the standing cat is far from circular" ;
        schema:measurementTechnique "4*pi*area/perimeter^2 of the segmented cat contour" ;
        schema:name "specimen_contour_circularity" ;
        schema:unitText "1" ;
        schema:value "0.146" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_foreground_fraction = 0.3023 1" ;
        dct:description "reference 0.5 is an uninformative prior, not the measured fraction" ;
        schema:measurementTechnique "body-mask area fraction on the CC BY-SA Felis catus photograph (snow is background)" ;
        schema:name "specimen_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.3023" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_structure_tensor_coherency = 0.4812 1" ;
        dct:description "reference 0 is an isotropic null" ;
        schema:measurementTechnique "mean structure-tensor coherency inside the segmented specimen" ;
        schema:name "specimen_structure_tensor_coherency" ;
        schema:unitText "1" ;
        schema:value "0.4812" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-stripe-anisotropy-index> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stripe_anisotropy_index = 0.5863 1" ;
        dct:description "reference is the isotropic spot lattice; the value is the stripe-biased run" ;
        schema:measurementTechnique "structure-tensor (Jxx-Jyy)/(Jxx+Jyy) after Dy/Dx = 4; isotropic spots sit near 0" ;
        schema:name "stripe_anisotropy_index" ;
        schema:unitText "1" ;
        schema:value "0.5863" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-stripe-anisotropy-index-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-stripe-anisotropy-index-reference> a schema:PropertyValue ;
        schema:value "0.0213" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-turing-sigma-star> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "turing_sigma_star = 2.7561 1/time" ;
        dct:description "reference 0 is the marginal stability boundary; a positive value is the unstable Holocene point" ;
        schema:measurementTechnique "max real eigenvalue of J - k^2 D over k in (0.15, 18)" ;
        schema:name "turing_sigma_star" ;
        schema:unitText "1/time" ;
        schema:value "2.7561" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-turing-sigma-star-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-turing-sigma-star-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-wavelength-sweep-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength_sweep_cv = 0.1132 1" ;
        dct:description "a zero CV would mean Dv does not move the wavelength" ;
        schema:measurementTechnique "CV (std/mean) of lambda across the Dv sweep from 0.55 to 3.20" ;
        schema:name "wavelength_sweep_cv" ;
        schema:unitText "1" ;
        schema:value "0.1132" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-wavelength-sweep-cv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-measurement-wavelength-sweep-cv-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-felis-catus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-felis-catus-turing-wavelength-s0.py L604–L718" ;
        dct:description "pass2_measurements: Pearson, RMSE, KS, CV, segmentation, ablation amplitudes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-felis-catus-turing-wavelength-s0.py#L604-L718> .

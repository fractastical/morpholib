        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-trushko-epithelioid-cyst-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán / 3D triangulated-shell spherical epithelial cyst buckling under alginate confinement — Reproducibility package: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credit: `--self-test` passes in ~15 s with ~37 assertions (Zoelly, regimes, scaling, specimen, Euler characteristic, Law 4 minimiser, Law 5 penalties, 3D regimes, pressure monotonicity, dGamma sweep signs, two-run bitwise determinism of both solvers with the memo cleared); all four dataset files SHA-256 verified; full render 28 s; the 3D solver is memoised per argument tuple; new figure and GIF regenerate from the default invocation. Deductions: `docs/media/*.png` is git-ignored repo-wide so the new 3D PNG needs a forced add and is not tracked (-3); hard-coded p-values/stddevs mean the measurement YAML is partly not reproducible from data (-3); the self-test clears the memo cache so a second evaluate_* call in the same process recomputes (~5 s) (-1); no pinned requirements lock for this script (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2019-trushko-epithelioid-cyst-buckling.py L1378–L1384: Hard-coded stddev 0.045 and p_value 1.2e-6 in a 'measured' entry <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L1378-L1384>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-repro-package-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2019-trushko-epithelioid-cyst-buckling.py L1465–L1555" ;
        dct:description "self_test(): sections 1-5 incl. Pass 3 3D shell assertions (lines 1505-1543) and two-run determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L1465-L1555> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2019-trushko-epithelioid-cyst-buckling.py L1601–L1608" ;
        dct:description "Default invocation runs self_test, renders comparison PNG + GIF and the 3D figure + GIF unless --skip-3d-media" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L1601-L1608> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "2019-trushko-epithelioid-cyst-buckling.py L1537–L1543" ;
        dct:description "Determinism check bypasses the memo (_SHELL3D_CACHE.clear()) and compares vertex arrays bitwise" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L1537-L1543> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 069 Pass 3 Phase B Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-blebbistatin-25-um-myosin-ii-inhibited-capsule-inward-fold-depth-delta-r0-reference> a schema:PropertyValue ;

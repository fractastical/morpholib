    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-large-thin-walled-capsule-e-alg-7-5-kpa-r0-140-um-h-r0-0-070-n-2-bilateral-fold-depth-delta-r0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Large thin-walled capsule (E_alg=7.5 kPa, R0=140 um, h/R0=0.070, n=2) bilateral fold depth delta/R0 = 0.5403 dimensionless (delta / R_0)" ;

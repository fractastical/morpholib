        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-trushko-epithelioid-cyst-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán / 3D triangulated-shell spherical epithelial cyst buckling under alginate confinement — Morphometric validation: 68/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credit: measurements now computed from the free 3D solver and compared with transcribed Fig. 2E data - P(t) from capsule dilation r = 0.939 (RMSE 0.089 kPa; P_3D = 0.506 kPa vs 0.485 at g = 1.527), delta(t) r = 0.799 (RMSE 0.27), Blebbistatin r = 0.813, ring-vs-shell r = 0.827 - with their Pearson p-values computed, not typed; the 12-point Zoelly scaling (r = 1.0000, slope 1.990) is an exact law check. Deductions: the ring trajectory r = 0.9927 / r = 0.998 that v2 scored is circular because the ring depth is a fitted law (-10); the free solver's headline morphometrics miss - fold depth 0.30 vs 0.64, fold count 12 vs 1, wall dilation 21 % vs a few % (-8); the H0 R0 = 0.9994 \"measurement\" is a calibration target (self-referential) (-3); p-values and stddevs of the ring and specimen measurements are hard-coded literals (1.2e-6, 2.4e-6, 4.8e-6, 1.5e-8, 2.1e-8; stddev 0.045 / 0.038 / 0.032) rather than computed (-4); the circularity reference 0.650 vs measured 0.848 is a miss not flagged in the measurement (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2019-trushko-epithelioid-cyst-buckling.py L1306–L1316: H0 R0 = 0.9994 vs reference 1.0: dGamma_WT was calibrated to hit this value <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L1306-L1316>",
            "2019-trushko-epithelioid-cyst-buckling.py L1368–L1420: Ring measurements with hard-coded p_value / stddev literals (1.0e-12, 1.2e-6, 2.4e-6, 4.8e-6; 0.045, 0.038, 0.032) <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L1368-L1420>",
            "2019-trushko-epithelioid-cyst-buckling.py L1424–L1432: Post-confluence trajectory r against Fig. 2E computed from the prescribed ring depth law - circular <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L1424-L1432>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-2d-fvk-ring-vs-3d-shell-wt-fold-depth-trajectory-agreement-pearson-r-over-6-g-values>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-icosphere-shell-wt-e-alg-5-kpa-g-n-n-c-1-527-inward-fold-depth-delta-r0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-shell-wt-capsule-pressure-p-t-k-alg-r-wall-r0-1-correlation-with-fig-2e-pressure>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-shell-wt-fold-depth-trajectory-delta-t-r0-correlation-with-fig-2e-g-n-n-c-reading>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-shell-wt-number-of-inward-folds-at-g-1-527-g-n-n-c-reading>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-shell-wt-number-of-inward-folds-at-g-1-527-g-read-as-linear-stretch-ring-convention>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-apical-basal-spontaneous-curvature-h0-r0-of-the-wt-shell-hannezo-2014-dgamma-calibrated>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-apical-basal-tension-sweep-d-delta-r0-d-dgamma-at-g-1-52-across-5-dgamma-values>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-apical-basal-tension-sweep-d-onset-g-d-dgamma-across-5-dgamma-values>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-blebbistatin-25-um-myosin-ii-inhibited-capsule-inward-fold-depth-delta-r0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-large-thin-walled-capsule-e-alg-7-5-kpa-r0-140-um-h-r0-0-070-n-2-bilateral-fold-depth-delta-r0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-log-log-thickness-to-radius-scaling-exponent-alpha-in-pc-e-epi-h-r0-alpha>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-post-confluence-invagination-trajectory-delta-t-r0-correlation-0-to-11-h-post-confluence>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-segmented-epithelial-cyst-histology-specimen-lumen-contour-circularity>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-segmented-epithelial-cyst-histology-specimen-thickness-to-radius-ratio-h-r0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-standard-stiff-alginate-capsule-e-alg-5-kpa-r0-100-um-n-1-inward-fold-depth-delta-r0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-unconfined-ultra-soft-alginate-negative-control-e-alg-0-4-kpa-p-pc-fold-depth-delta-r0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-zoelly-12-capsule-critical-buckling-pressure-pc-correlation-mdck-ii-caco-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-morphometric-validation-2> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-2d-fvk-ring-vs-3d-shell-wt-fold-depth-trajectory-agreement-pearson-r-over-6-g-values> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D FvK ring vs 3D shell WT fold-depth trajectory agreement (Pearson r over 6 g values) = 0.8272 Pearson r" ;
        schema:measurementTechnique "Cross-model consistency of the prescribed-profile 2D ring against the free 3D shell (g=N/N_c reading); stddev = RMSE" ;
        schema:name "2D FvK ring vs 3D shell WT fold-depth trajectory agreement (Pearson r over 6 g values)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.8272" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-2d-fvk-ring-vs-3d-shell-wt-fold-depth-trajectory-agreement-pearson-r-over-6-g-values-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-2d-fvk-ring-vs-3d-shell-wt-fold-depth-trajectory-agreement-pearson-r-over-6-g-values-reference> a schema:PropertyValue ;
        dct:source "internal cross-model check (2D ring Pass 2 vs 3D shell Pass 3)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-icosphere-shell-wt-e-alg-5-kpa-g-n-n-c-1-527-inward-fold-depth-delta-r0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D icosphere shell WT (E_alg=5 kPa, g=N/N_c=1.527) inward fold depth delta/R0 = 0.3011 dimensionless (delta / R_0)" ;
        schema:measurementTechnique "L-BFGS-B relaxation of a 642-vertex triangulated shell (springs + discrete Helfrich bending with apical-basal spontaneous curvature + unilateral Winkler capsule + self-contact), g read as the post-confluence cell-number (area) ratio" ;
        schema:name "3D icosphere shell WT (E_alg=5 kPa, g=N/N_c=1.527) inward fold depth delta/R0" ;
        schema:unitText "dimensionless (delta / R_0)" ;
        schema:value "0.3011" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-icosphere-shell-wt-e-alg-5-kpa-g-n-n-c-1-527-inward-fold-depth-delta-r0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-icosphere-shell-wt-e-alg-5-kpa-g-n-n-c-1-527-inward-fold-depth-delta-r0-reference> a schema:PropertyValue ;
        dct:source "Trushko et al. (2020) Dev. Cell 54:655-668 Fig. 2E" ;
        schema:value "0.642" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-shell-wt-capsule-pressure-p-t-k-alg-r-wall-r0-1-correlation-with-fig-2e-pressure> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D shell WT capsule pressure P(t) = K_alg (r_wall/R0 - 1) correlation with Fig. 2E pressure = 0.9386 Pearson r" ;
        schema:measurementTechnique "Pressure inferred from the Winkler wall dilation of the 3D shell (same read-out as the alginate capsule dilation used experimentally) vs the transcribed standard_P_kPa trajectory; stddev = RMSE in kPa" ;
        schema:name "3D shell WT capsule pressure P(t) = K_alg (r_wall/R0 - 1) correlation with Fig. 2E pressure" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9386" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-shell-wt-capsule-pressure-p-t-k-alg-r-wall-r0-1-correlation-with-fig-2e-pressure-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-shell-wt-capsule-pressure-p-t-k-alg-r-wall-r0-1-correlation-with-fig-2e-pressure-reference> a schema:PropertyValue ;
        dct:source "Trushko et al. (2020) Dev. Cell 54:655-668 Fig. 2E" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-shell-wt-fold-depth-trajectory-delta-t-r0-correlation-with-fig-2e-g-n-n-c-reading> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D shell WT fold depth trajectory delta(t)/R0 correlation with Fig. 2E (g=N/N_c reading) = 0.7993 Pearson r" ;
        schema:measurementTechnique "Pearson correlation of the 3D shell delta(g) continuation against the 6-point WT trajectory; stddev field carries the RMSE" ;
        schema:name "3D shell WT fold depth trajectory delta(t)/R0 correlation with Fig. 2E (g=N/N_c reading)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.7993" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-shell-wt-fold-depth-trajectory-delta-t-r0-correlation-with-fig-2e-g-n-n-c-reading-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-shell-wt-fold-depth-trajectory-delta-t-r0-correlation-with-fig-2e-g-n-n-c-reading-reference> a schema:PropertyValue ;
        dct:source "Trushko et al. (2020) Dev. Cell 54:655-668 Fig. 2E" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-shell-wt-number-of-inward-folds-at-g-1-527-g-n-n-c-reading> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D shell WT number of inward folds at g=1.527 (g=N/N_c reading) = 12.0 count of connected deep-deflection regions" ;
        schema:measurementTechnique "Connected components of vertices with u_in > max(0.35 u_max, 0.04 R_0) on the final 3D mesh; 12 coincides with the icosphere's five-valent vertices (mesh-templated wrinkling)" ;
        schema:name "3D shell WT number of inward folds at g=1.527 (g=N/N_c reading)" ;
        schema:unitText "count of connected deep-deflection regions" ;
        schema:value "12.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-shell-wt-number-of-inward-folds-at-g-1-527-g-n-n-c-reading-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-shell-wt-number-of-inward-folds-at-g-1-527-g-n-n-c-reading-reference> a schema:PropertyValue ;
        dct:source "Trushko et al. (2020) Dev. Cell 54:655-668 Fig. 2 (single fold in ~75% of standard capsules)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-shell-wt-number-of-inward-folds-at-g-1-527-g-read-as-linear-stretch-ring-convention> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D shell WT number of inward folds at g=1.527 (g read as linear stretch, ring convention) = 2.0 count of connected deep-deflection regions" ;
        schema:measurementTechnique "Same mesh/energy with rest edge length g*l0 (area excess g^2): wrinkles coarsen 12 -> 6 -> 3 -> 1 along the continuation; stddev field carries the final delta/R_0" ;
        schema:name "3D shell WT number of inward folds at g=1.527 (g read as linear stretch, ring convention)" ;
        schema:unitText "count of connected deep-deflection regions" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-shell-wt-number-of-inward-folds-at-g-1-527-g-read-as-linear-stretch-ring-convention-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-3d-shell-wt-number-of-inward-folds-at-g-1-527-g-read-as-linear-stretch-ring-convention-reference> a schema:PropertyValue ;
        dct:source "Trushko et al. (2020) Dev. Cell 54:655-668 Fig. 2" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-apical-basal-spontaneous-curvature-h0-r0-of-the-wt-shell-hannezo-2014-dgamma-calibrated> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Apical-basal spontaneous curvature H0*R0 of the WT shell (Hannezo 2014, dGamma calibrated) = 0.9994 dimensionless (H_0 R_0)" ;
        schema:measurementTechnique "H_0 R_0 = 6 (1 - nu^2) dGamma R_0 / (E_epi h^2) with dGamma = 4.26 mN/m CALIBRATED so that the confluent sphere is the spontaneous shape (self-referential; Lean Law 4)" ;
        schema:name "Apical-basal spontaneous curvature H0*R0 of the WT shell (Hannezo 2014, dGamma calibrated)" ;
        schema:unitText "dimensionless (H_0 R_0)" ;
        schema:value "0.9994" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-apical-basal-spontaneous-curvature-h0-r0-of-the-wt-shell-hannezo-2014-dgamma-calibrated-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-apical-basal-spontaneous-curvature-h0-r0-of-the-wt-shell-hannezo-2014-dgamma-calibrated-reference> a schema:PropertyValue ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS 111:27-32 Eqs. 1-3 (calibration target, not a measurement)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-apical-basal-tension-sweep-d-delta-r0-d-dgamma-at-g-1-52-across-5-dgamma-values> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Apical-basal tension sweep: d(delta/R0)/d(dGamma) at g=1.52 across 5 dGamma values = -0.0058 per mN/m" ;
        schema:measurementTechnique "OLS slope of final fold depth versus dGamma in [-4.26, 8.52] mN/m (H_0 R_0 in [-1, 2]); negative slope = apical-dominant tension stabilises the lumen-concave sphere (Lean Law 5)" ;
        schema:name "Apical-basal tension sweep: d(delta/R0)/d(dGamma) at g=1.52 across 5 dGamma values" ;
        schema:unitText "per mN/m" ;
        schema:value "-0.0058" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-apical-basal-tension-sweep-d-delta-r0-d-dgamma-at-g-1-52-across-5-dgamma-values-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-apical-basal-tension-sweep-d-delta-r0-d-dgamma-at-g-1-52-across-5-dgamma-values-reference> a schema:PropertyValue ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS (qualitative: apical constriction favours lumen-concave curvature); no quantitative dGamma data in Trushko et al. (2020)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-apical-basal-tension-sweep-d-onset-g-d-dgamma-across-5-dgamma-values> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Apical-basal tension sweep: d(onset g)/d(dGamma) across 5 dGamma values = 0.00939 per mN/m" ;
        schema:measurementTechnique "OLS slope of the first continuation g at which delta/R_0 > 0.05 versus dGamma" ;
        schema:name "Apical-basal tension sweep: d(onset g)/d(dGamma) across 5 dGamma values" ;
        schema:unitText "per mN/m" ;
        schema:value "0.00939" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-apical-basal-tension-sweep-d-onset-g-d-dgamma-across-5-dgamma-values-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-apical-basal-tension-sweep-d-onset-g-d-dgamma-across-5-dgamma-values-reference> a schema:PropertyValue ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS (qualitative); no quantitative dGamma data in Trushko et al. (2020)" ;
        schema:value "0.0" .

<https://w3id.org/probknow/resource/math-law/trushko-epithelioid-cyst-buckling-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Zoelly / Föppl–von Kármán Spherical Shell Critical Buckling Pressure Scaling Law" ;
    dct:description "Predicts the quadratic thickness-to-radius scaling P_c ∝ (h/R_0)^2 of critical inward invagination pressure across MDCK and Caco-2 epithelial cysts | Variables: P_c: critical buckling pressure (kPa); E_epi: epithelial monolayer Young's modulus (kPa); ν: Poisson ratio; h: epithelial monolayer thickness (μm); R_0: spherical alginate capsule inner radius (μm)" ;
    dct:source "Trushko et al. (2020) Dev. Cell 54(5):655-668 Figs. 3-4 & STAR Methods; Zoelly (1915) ETH Zürich" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L145-L215>,
        <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_069_epithelioid_cyst_buckling.lean#L27-L58> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def zoelly_pressure_scaled (c_e h : Nat) : Nat :=
  c_e * (h * h)
def zoelly_radius_doubling_lhs (c_e r : Nat) : Nat :=
  c_e * ((2 * r) * (2 * r))
def zoelly_radius_doubling_rhs (c_e r : Nat) : Nat :=
  4 * (c_e * (r * r))
theorem zoelly_quadratic_shell_buckling_scaling (c_e h r : Nat) :
    zoelly_pressure_scaled c_e (2 * h) = 4 * zoelly_pressure_scaled c_e h ∧
    zoelly_radius_doubling_lhs c_e r = zoelly_radius_doubling_rhs c_e r ∧
    zoelly_pressure_scaled 1 2 = 4 * zoelly_pressure_scaled 1 1
"""^^pk:lean4 ;
    skos:notation "P_c = (2 E_epi / √(3(1 - ν^2))) (h / R_0)^2  ⇒  P_c(2h, R_0) = 4 P_c(h, R_0)  ∧  P_c(h, 2R_0) = (1/4) P_c(h, R_0)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2020.07.019>,
        <https://doi.org/10.1073/pnas.1309482110>,
        <https://doi.org/10.1073/pnas.1312076111>,
        <https://doi.org/10.1103/PhysRevA.38.1005>,
        <https://doi.org/10.1515/znc-1973-11-1209>,
        <https://doi.org/10.3929/ethz-a-000096658> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Föppl–von Kármán & Zoelly Spherical Shell Buckling of Proliferating Epithelial Monolayers Under Elastic Alginate Confinement" ;
    pk:leanDeclaration "MathOfBiology.Loop_069.zoelly_pressure_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_069.zoelly_quadratic_shell_buckling_scaling" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/trushko-epithelioid-cyst-buckling-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Proliferative Confluent Laplace Stress Accumulation & Alginate Confinement Threshold Law" ;
    dct:description "Explains why unconfined or ultra-soft alginate capsules (E_alg ≪ E_crit, P_alg < P_c) remain spherical without buckling whereas stiff capsules (E_alg ∈ [2, 10] kPa) buckle at time t_b | Variables: g(t) = 2^((t - t_c)/τ_d): post-confluence proliferative growth stretch; K_alg = 2 E_alg H_alg / ((1 - ν_alg) R_0): spherical capsule radial stiffness; g_c: critical buckling stretch" ;
    dct:source "Trushko et al. (2020) Dev. Cell 54(5):655-668 Figs. 1-3 & pp. 657-661" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L175-L265>,
        <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_069_epithelioid_cyst_buckling.lean#L78-L94> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def laplace_confinement_stress (e_alg g g0 : Nat) : Nat :=
  e_alg * (g - g0)
theorem proliferative_confinement_buckling_threshold (e0 g0 gc dg : Nat) :
    laplace_confinement_stress (e0 + 1) g0 g0 = 0 ∧
    laplace_confinement_stress 0 (g0 + dg + 1) g0 = 0 ∧
    laplace_confinement_stress (e0 + 1) (g0 + dg + 1) g0 > 0 ∧
    laplace_confinement_stress (e0 + 1) (gc + dg + 1) gc > 0
"""^^pk:lean4 ;
    skos:notation "P_alg(g) = K_alg (g - 1) > 0  for g > 1;  buckling onset at g > g_c = 1 + P_c / K_alg  (t_b = t_c + τ_d log_2(g_c))" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2020.07.019>,
        <https://doi.org/10.1073/pnas.1309482110>,
        <https://doi.org/10.1073/pnas.1312076111>,
        <https://doi.org/10.1103/PhysRevA.38.1005>,
        <https://doi.org/10.1515/znc-1973-11-1209>,
        <https://doi.org/10.3929/ethz-a-000096658> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Föppl–von Kármán & Zoelly Spherical Shell Buckling of Proliferating Epithelial Monolayers Under Elastic Alginate Confinement" ;
    pk:leanDeclaration "MathOfBiology.Loop_069.laplace_confinement_stress" ;
    pk:leanTheorem "MathOfBiology.Loop_069.proliferative_confinement_buckling_threshold" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/trushko-epithelioid-cyst-buckling-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Inward Invagination Volume Conservation & Blebbistatin Actomyosin Contractility Shift Law" ;
    dct:description "Proves capsule volume partitioning during inward invagination and predicts the experimentally observed attenuation of fold depth and buckling pressure under Blebbistatin myosin-II inhibition | Variables: V_caps, V_lumen, V_fold: capsule, lumen, and invaginated cap volumes; δ/R_0: normalized inward fold depth; Γ_myo: active myosin-II contractility (reduced by Blebbistatin / Y-27632)" ;
    dct:source "Trushko et al. (2020) Dev. Cell 54(5):655-668 Figs. 5-6; Hannezo, Prost & Joanny (2014) PNAS 111(1):27-32" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L156-L377>,
        <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_069_epithelioid_cyst_buckling.lean#L108-L127> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def invaginated_lumen_volume (v_caps v_fold : Int) : Int :=
  v_caps - v_fold
def active_invagination_depth_scaled (delta_base c0 gamma_myo : Nat) : Nat :=
  (delta_base + 1) * (c0 + gamma_myo + 1)
theorem invagination_volume_conservation_and_blebbistatin_shift
    (v_caps v_fold : Int) (delta_base c0 g0 d_myo : Nat) :
    invaginated_lumen_volume v_caps v_fold + v_fold = v_caps ∧
    active_invagination_depth_scaled delta_base c0 g0 <
      active_invagination_depth_scaled delta_base c0 (g0 + d_myo + 1)
"""^^pk:lean4 ;
    skos:notation "V_lumen + V_fold = V_caps;  δ(g)/R_0 = c_δ √(g - g_c) (1 + β_myo Γ_myo)  ⇒  Γ_blebb < Γ_WT ⟹ δ_blebb < δ_WT" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2020.07.019>,
        <https://doi.org/10.1073/pnas.1309482110>,
        <https://doi.org/10.1073/pnas.1312076111>,
        <https://doi.org/10.1103/PhysRevA.38.1005>,
        <https://doi.org/10.1515/znc-1973-11-1209>,
        <https://doi.org/10.3929/ethz-a-000096658> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Föppl–von Kármán & Zoelly Spherical Shell Buckling of Proliferating Epithelial Monolayers Under Elastic Alginate Confinement" ;
    pk:leanDeclaration "MathOfBiology.Loop_069.active_invagination_depth_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_069.invagination_volume_conservation_and_blebbistatin_shift" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/trushko-epithelioid-cyst-buckling-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Apical-Basal Differential Tension Spontaneous Curvature Law (Pass 3, 3D triangulated vertex shell)" ;
    dct:description "Fixes the spontaneous curvature of the discrete Helfrich bending term (κ/2) Σ_v A_v (2H_v − 2H₀)² of the 3D icosphere shell from the apical-basal tension difference; ΔΓ_WT = 4.26 mN/m is calibrated so that H₀ R₀ = 1 (confluent sphere is the spontaneous shape) | Variables: κ: monolayer bending modulus; h: monolayer thickness; ΔΓ = Γ_apical − Γ_basal: apical-basal tension difference (mN/m); c = 2H: twice the mean curvature; c₀ = 2H₀: spontaneous curvature; ν: Poisson ratio; E_epi: monolayer Young's modulus; R₀: capsule radius" ;
    dct:source "Hannezo, Prost & Joanny (2014) PNAS 111(1):27-32 Eqs. 1-3; Helfrich (1973) Z. Naturforsch. C 28:693-703" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L476-L484>,
        <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_069_epithelioid_cyst_buckling.lean#L145-L177> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def apicobasal_bending_energy_scaled (k t c : Int) : Int :=
  k * (k * c * c - 2 * t * c)
theorem apicobasal_bending_completed_square (k t c : Int) :
    apicobasal_bending_energy_scaled k t c + t * t = (k * c - t) * (k * c - t)
theorem apicobasal_spontaneous_curvature_minimizer (k t c : Int) :
    apicobasal_bending_energy_scaled k t c ≥ -(t * t) ∧
    apicobasal_bending_energy_scaled 1 t t = -(t * t)
"""^^pk:lean4 ;
    skos:notation "f(c) = (κ/2) c² − ΔΓ h c,  c = 2H  ⇒  argmin f = c₀ = 2H₀ = ΔΓ h / κ;  with κ = E_epi h³ / (12(1 − ν²)):  H₀ R₀ = 6 (1 − ν²) ΔΓ R₀ / (E_epi h²);  integer form κ(κc² − 2tc) + t² = (κc − t)² ≥ 0, t = ΔΓ h" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2020.07.019>,
        <https://doi.org/10.1073/pnas.1309482110>,
        <https://doi.org/10.1073/pnas.1312076111>,
        <https://doi.org/10.1103/PhysRevA.38.1005>,
        <https://doi.org/10.1515/znc-1973-11-1209>,
        <https://doi.org/10.3929/ethz-a-000096658> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Föppl–von Kármán & Zoelly Spherical Shell Buckling of Proliferating Epithelial Monolayers Under Elastic Alginate Confinement" ;
    pk:leanDeclaration "MathOfBiology.Loop_069.apicobasal_bending_energy_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_069.apicobasal_spontaneous_curvature_minimizer" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/trushko-epithelioid-cyst-buckling-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Inverted-Cap Penalty & Unilateral Capsule Wall Contact Law (Pass 3, 3D triangulated vertex shell)" ;
    dct:description "Explains why apical-dominant tension (ΔΓ > 0) reduces fold depth and delays buckling onset in the ΔΓ sweep (slope −0.0058 R₀ per mN/m, onset +0.0094 per mN/m) and justifies reading the confinement pressure from the Winkler wall dilation exactly as Trushko et al. read it from alginate capsule dilation (Fig. 2E, r = 0.94) | Variables: h_m = |2H|: magnitude of the local mean curvature; c₀ = 2H₀ ≥ 0: apical-dominant spontaneous curvature; r: vertex radius; R₀: capsule inner radius; K_alg: capsule radial stiffness; P_3D: pressure read from capsule dilation" ;
    dct:source "Trushko et al. (2020) Dev. Cell 54(5):655-668 Fig. 2E & STAR Methods; Hannezo, Prost & Joanny (2014) PNAS 111(1):27-32; Alessandri et al. (2013) PNAS 110(37):14843-14848" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L591-L631>,
        <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_069_epithelioid_cyst_buckling.lean#L196-L221> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def inverted_cap_bending_penalty (hm c0 : Int) : Int := (hm + c0) * (hm + c0)
def aligned_cap_bending_penalty (hm c0 : Int) : Int := (hm - c0) * (hm - c0)
def capsule_wall_winkler_penalty (r R : Int) : Int :=
  if r ≤ R then 0 else (r - R) * (r - R)
theorem inverted_cap_penalty_and_capsule_wall_contact
    (hm c0 r R : Int) (hh : 0 ≤ hm) (hc : 0 ≤ c0) :
    inverted_cap_bending_penalty hm c0 = aligned_cap_bending_penalty hm c0 + 4 * (hm * c0) ∧
    aligned_cap_bending_penalty hm c0 ≤ inverted_cap_bending_penalty hm c0 ∧
    (r ≤ R → capsule_wall_winkler_penalty r R = 0) ∧
    (R < r → capsule_wall_winkler_penalty r R > 0)
"""^^pk:lean4 ;
    skos:notation "(h_m + c₀)² = (h_m − c₀)² + 4 h_m c₀ ≥ (h_m − c₀)²  for h_m, c₀ ≥ 0  (inverted Pogorelov cap never cheaper than lumen-concave cap);  W(r) = max(0, r − R₀)² : W = 0 for r ≤ R₀, W > 0 for r > R₀  (Winkler capsule, P_3D = K_alg (r_wall/R₀ − 1))" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2020.07.019>,
        <https://doi.org/10.1073/pnas.1309482110>,
        <https://doi.org/10.1073/pnas.1312076111>,
        <https://doi.org/10.1103/PhysRevA.38.1005>,
        <https://doi.org/10.1515/znc-1973-11-1209>,
        <https://doi.org/10.3929/ethz-a-000096658> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Föppl–von Kármán & Zoelly Spherical Shell Buckling of Proliferating Epithelial Monolayers Under Elastic Alginate Confinement" ;
    pk:leanDeclaration "MathOfBiology.Loop_069.inverted_cap_bending_penalty" ;
    pk:leanTheorem "MathOfBiology.Loop_069.inverted_cap_penalty_and_capsule_wall_contact" ;
    pk:leanVerified true .


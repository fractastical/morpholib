sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-trushko-epithelioid-cyst-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/trushko-epithelioid-cyst-buckling.yaml L1–L119" ;
        dcterms:description "Per-loop Math KG: 5 equations mapped to 7 Lean theorems and single-range Python code_locus pins (Laws 4-5 added in Pass 3)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/math_kg_loops/trushko-epithelioid-cyst-buckling.yaml#L1-L119> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2019-trushko-epithelioid-cyst-buckling.py L570–L584" ;
        dcterms:description "Comment block deriving the discrete mean-curvature scale m_v = mean(l^2)/4 and the lagged update" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L570-L584> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "2019-trushko-epithelioid-cyst-buckling.py L650–L656" ;
        dcterms:description "Comment explaining why the radial imperfection is re-seeded at every growth increment" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L650-L656> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán / 3D triangulated-shell spherical epithelial cyst buckling under alginate confinement — Code-to-model traceability: 84/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credit: section banners name the Lean law each solver implements; the per-loop math KG now registers 5 equations (Laws 1-5) each with a single `file#La-Lb` `code_locus` (secondary ranges in `code_locus_secondary`) and the Law 3 locus was corrected to the current ring/regime range; in-code comments explain the umbrella-Laplacian curvature normalisation, the sqrt(g) growth convention and the per-step imperfection re-seeding. Deductions: the ring's fitted constants (lines 205-212, 268), the 0.08 / 0.695 / 0.9985 literals and the panel-D closed form carry no derivation or citation (-6); the `seed` parameter of the ring and the `Gamma_myo` dependence of the fold-depth law are undocumented (-3); the fold-detection thresholds and contact stiffness are documented only in the dataset JSON, not at the code site (-3); measurement `method` strings for the ring still describe it as an FvK minimiser (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2019-trushko-epithelioid-cyst-buckling.py L174–L199: Ring pre-buckling branch: literals 0.08, 0.695, 0.9985 without derivation <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L174-L199>",
            "2019-trushko-epithelioid-cyst-buckling.py L266–L270: p_conf = P_c + 0.365 K_alg excess (0.55 + 0.45 Gamma_myo): fitted, uncited <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L266-L270>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-code-traceability-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 069 Pass 3 Phase B Assessor)" ;

    <https://w3id.org/probknow/resource/claim/morphoeval-trushko-epithelioid-cyst-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2019-trushko-epithelioid-cyst-buckling.py L1107–L1206" ;
        dcterms:description "render_shell3d_figure: 6 panels incl. 3D trisurfs, delta(t) and P(t) vs Fig. 2E, dGamma sweep, fold multiplicity vs experiment (12 vs 1 shown honestly)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L1107-L1206> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2019-trushko-epithelioid-cyst-buckling.py L1209–L1229" ;
        dcterms:description "render_shell3d_gif: 19 frames of the linear-g shell (wrinkle -> coarsening to 2 folds)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L1209-L1229> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/epithelioid_cyst_buckling_shell3d_growth.gif (generated output)" ;
        dcterms:description "Rendered 3D growth GIF (19 frames): wrinkle onset and coarsening of the linear-g shell inside the capsule — docs/media/epithelioid_cyst_buckling_shell3d_growth.gif: rendered output of 2019-trushko-epithelioid-cyst-buckling.py at 8a7928d7, image/gif, 591341 B, 468×468 px, 19 frames, artifact_sha256 5ddb1d7417d51fa15beea976f792a00a0f528be4e18d98ed6232796790aaad39 (sha256 5ddb1d7417d51fa15beea976f792a00a0f528be4e18d98ed6232796790aaad39), spec_fingerprint 8c51faae6711c461b674cf68b978bc7ce168e67b48347c008c6f0f5cae0506b9" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/epithelioid_cyst_buckling_growth.gif (generated output)" ;
        dcterms:description "Rendered 2D ring growth GIF: prescribed single-fold invagination deepening along the g schedule — docs/media/epithelioid_cyst_buckling_growth.gif: rendered output of 2019-trushko-epithelioid-cyst-buckling.py at 8a7928d7, image/gif, 94433 B, 475×475 px, 8 frames, artifact_sha256 0bb858405f329db48eb62ca3be367294eeab8ce8e1aa9d947d6bef39746343f5 (sha256 0bb858405f329db48eb62ca3be367294eeab8ce8e1aa9d947d6bef39746343f5), spec_fingerprint 8c51faae6711c461b674cf68b978bc7ce168e67b48347c008c6f0f5cae0506b9" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 069 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán / 3D triangulated-shell spherical epithelial cyst buckling under alginate confinement — Morphological realism / specimen match: 62/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credit: the 3D figure renders the WT shell as a trisurf coloured by inward deflection beside the ring and the Fig. 2E data, the GIF shows wrinkle-to-coarsening, the unconfined control stays spherical, and the segmentation of the SHA-256-locked micrograph (19 cysts, h/R0 = 0.106 vs reference 0.105) is reproducible. Deductions: the specimen is a thyroid-follicle H&E (Wikimedia), not an MDCK cyst in an alginate capsule, and its 0.105 / 0.650 reference values are attributed loosely to Trushko Fig. 1-2 (-12); the segmented mean circularity is 0.848 (printed in panel F) whereas the v2 audit reported 0.654, i.e. the v2 specimen-match claim rested on a misreported number and the 0.650 reference is not matched (-8); the free 3D WT shell shows 12 shallow folds at delta/R0 = 0.30 instead of the single 0.64 R0 fold seen in the experiment, and the linear-g ablation overshoots to 1.18 R0 (-10); segmentation uses uncited calibration factors x1.12 (perimeter) and x1.65 (thickness) (-4); the ring's lumen circularity in the unbuckled branch is a constant 0.9985 (-2); honest display of the miss in panel F of the 3D figure (sim vs experimental fold count) is credited." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2019-trushko-epithelioid-cyst-buckling.py L1285–L1294: Measurement: 3D shell WT fold count 12 vs reference 1 - a genuine miss recorded as a measurement <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L1285-L1294>",
            "2019-trushko-epithelioid-cyst-buckling.py L1449–L1460: Circularity measurement with reference 0.650 attributed to Trushko Fig. 2 and Wikimedia File:Thyroid_follicle.jpg; script prints 0.848 (panel F title, line 1017) <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L1449-L1460>",
            "2019-trushko-epithelioid-cyst-buckling.py L840–L899: segment_epithelioid_cyst_specimen: 19 contours, h/R0 = 0.106; calibration factors x1.12 (line 870) and x1.65 (line 874) are uncited <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L840-L899>",
            "docs/media/epithelioid_cyst_buckling_shell3d_apicobasal.png (generated output, not in repo): Rendered 3D figure: panels A/B trisurfs show 12 shallow wrinkles (g = N/N_c) vs 2 deep folds (g linear); panel F fold count 12 vs experimental 1 — docs/media/epithelioid_cyst_buckling_shell3d_apicobasal.png: rendered output of 2019-trushko-epithelioid-cyst-buckling.py at 8a7928d7, image/png, 449778 B, 2080×1274 px, artifact_sha256 870ef6c83c86a525e904ca51806af9f9a1b8dc63566584fbcfbb363b28917881 (sha256 870ef6c83c86a525e904ca51806af9f9a1b8dc63566584fbcfbb363b28917881), spec_fingerprint 8c51faae6711c461b674cf68b978bc7ce168e67b48347c008c6f0f5cae0506b9" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-specimen-match-4> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
}


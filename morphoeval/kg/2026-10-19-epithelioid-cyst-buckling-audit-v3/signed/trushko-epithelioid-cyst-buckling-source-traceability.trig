sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-trushko-epithelioid-cyst-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-source-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2019-trushko-epithelioid-cyst-buckling.py L60–L82" ;
        dcterms:description "EXPECTED_SHA256 for 4 dataset files incl. shell3d_apicobasal_reference.json; verify_dataset_sha256() fail-closed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L60-L82> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/epithelioid_cyst_buckling/shell3d_apicobasal_reference.json L1–L10" ;
        dcterms:description "Pass 3 reference table: mesh counts, dGamma_WT (flagged calibrated), expected H0 R0, Blebbistatin Gamma_myo" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/datasets/epithelioid_cyst_buckling/shell3d_apicobasal_reference.json#L1-L10> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán / 3D triangulated-shell spherical epithelial cyst buckling under alginate confinement — Source and data traceability: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credit: six primary sources with DOIs (Helfrich 1973 and Seung & Nelson 1988 added for the discrete bending energy and the 12-disclination icosphere; both DOIs kept unverified offline per the loop rule); the new `shell3d_apicobasal_reference.json` is SHA-256 pinned in `EXPECTED_SHA256` and verified at every run alongside the v2 JSON, BibTeX and specimen; `pass3_citations.bib` and the dataset README document the new constants. Deductions: dGamma_WT = 4.26 mN/m is calibrated, not sourced (-4); E_alg = 5 kPa in the pinned regime table vs Alessandri 2013's ~68 kPa alginate modulus has unclear provenance and could not be verified offline (-3); `SHELL3D_PERTURBATION`, the contact stiffness 2.0 Y_2D and the fold thresholds 0.35 / 0.04 are modelling choices without a literature source (-3); the ring's constants 0.98, alpha_myo = 0.24, 0.08, 0.695, 0.365 are unsourced (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "2019-trushko-epithelioid-cyst-buckling.py L124–L149: Unsourced constants 0.98 (capsule stiffness prefactor) and alpha_myo = 0.24 <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L124-L149>",
            "2019-trushko-epithelioid-cyst-buckling.py L415–L418: SHELL3D_SUBDIVISIONS / SHELL3D_PERTURBATION = 1e-3 / SHELL3D_CONTACT_STIFFNESS = 2.0 - modelling choices without citation <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L415-L418>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-source-traceability-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 069 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


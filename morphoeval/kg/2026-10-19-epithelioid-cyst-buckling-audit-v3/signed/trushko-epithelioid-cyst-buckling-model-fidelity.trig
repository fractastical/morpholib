sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-trushko-epithelioid-cyst-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2019-trushko-epithelioid-cyst-buckling.py L506–L718" ;
        dcterms:description "3D shell solver: cache, icosphere, umbrella Laplacian, material constants, lagged curvature scale, energy + analytic gradient, continuation loop, wall/depth/fold/volume read-outs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L506-L718> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2019-trushko-epithelioid-cyst-buckling.py L591–L631" ;
        dcterms:description "energy_and_grad: springs, Helfrich bending with spontaneous curvature 2 c0 m_v n_hat, Winkler wall, self-contact penalty" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L591-L631> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2019-trushko-epithelioid-cyst-buckling.py L476–L484" ;
        dcterms:description "compute_apicobasal_spontaneous_curvature: H0 R0 = 6 (1 - nu^2) dGamma R0 / (E_epi h^2) (Hannezo 2014; Lean Law 4)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L476-L484> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_069_epithelioid_cyst_buckling.lean L148–L177" ;
        dcterms:description "Law 4: completed-square proof that the apical-basal bending energy is minimised at kappa c = t (spontaneous curvature)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_069_epithelioid_cyst_buckling.lean#L148-L177> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_069_epithelioid_cyst_buckling.lean L203–L221" ;
        dcterms:description "Law 5: inverted-cap penalty (h + c0)^2 >= (h - c0)^2 and Winkler penalty zero inside the capsule wall" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_069_epithelioid_cyst_buckling.lean#L203-L221> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 069 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán / 3D triangulated-shell spherical epithelial cyst buckling under alginate confinement — Model fidelity to source: 76/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credit: `solve_confined_cyst_shell3d` is a genuine free energy minimiser (harmonic springs with rest length sqrt(g) l0, discrete Helfrich bending (kappa/2) A_v (2H - 2H0)^2 via an umbrella Laplacian with a lagged curvature normalisation, spontaneous curvature from the Hannezo formula along the radial axis, unilateral Winkler wall, cKDTree self-contact, analytic gradients, L-BFGS-B continuation in g with re-seeded 1e-3 imperfections) on a closed icosphere (Euler chi = 2 asserted); Laws 4-5 are machine checked. Deductions: the 2D ring that still produces every regime/trajectory panel is prescribed - mode hard-wired from h/R0 (line 205), depth a fitted power law (lines 207-212), L-BFGS-B result rescaled back to the target (lines 248-251) - so it is not a Föppl-von Kármán solve as v2 scored it (-10); the 3D solver gives 12 shallow folds that coincide with the 12 five-valent vertices, i.e. a mesh-templated pattern, not the single Pogorelov fold of the experiment (-6); the capsule is as soft as the sheet (k_conf ~ 1.2 Y_2D/R0) and a stiff 68 kPa capsule does not fold by g = 1.527, so the displacement-controlled confinement physics is unresolved (-4); the apical-basal axis is the radial direction and there is no cell-level apical/basal/lateral structure, lumen pressure or division topology (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2019-trushko-epithelioid-cyst-buckling.py L201–L212: 2D ring: fold mode hard-wired from h/R0 < 0.082 and target fold depth from fitted constants 0.818 / 0.685 / 0.575 / 0.68 / 0.22 - prescribed, not solved <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L201-L212>",
            "2019-trushko-epithelioid-cyst-buckling.py L248–L251: 2D ring: optimised profile rescaled so that its peak equals target_delta, making the minimisation a smoothing step <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L248-L251>",
            "2019-trushko-epithelioid-cyst-buckling.py L421–L460: build_icosphere: subdivision 3 icosahedron carries 12 five-valent vertices; the WT 12-fold pattern coincides with them (mesh-templated) <https://github.com/fractastical/morpholib/blob/8a7928d7/2019-trushko-epithelioid-cyst-buckling.py#L421-L460>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity-5> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
}


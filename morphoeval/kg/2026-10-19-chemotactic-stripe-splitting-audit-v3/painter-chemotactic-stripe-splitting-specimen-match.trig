sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-painter-chemotactic-stripe-splitting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Painter, Maini & Othmer (1999) Pomacanthus Turing-chemotaxis stripe doubling on a growing curved flank & Keller-Segel rippling with slime-trail tensor — Morphological realism / specimen match: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The Myxococcus xanthus specimen is still SHA-256-verified and segmented (`segment_chemotactic_specimen`, L1023-1120: 4 fruiting bodies, 362 ridge spacings, 74.10 um mean wavelength, Panels E-F). The new Pomacanthus model is matched to Kondo & Asai's vendored stripe-count table (3 / 6 / 12 at 2 / 6 / 12 months, `pomacanthus_stripe_doubling_reference.json`) and the flat-flank run reproduces all three counts (Panel G annotations), which is a genuine new quantitative specimen match. Deductions: no Pomacanthus photograph is vendored, so curvature-dependent stripe geometry (Panel H) is not validated against a fish; the spindle reaches 8 not 12 stripes." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-specimen-match-4> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1999-painter-chemotactic-stripe-splitting.py L1023–L1120" ;
        dct:description "Automated CV segmentation of 500 um scale bar, 4 fruiting-body spot aggregates and rippling stripe spacings" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L1023-L1120> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "datasets/chemotactic_stripe_splitting/pomacanthus_stripe_doubling_reference.json L1–L112" ;
        dct:description "Kondo & Asai (1995) 3 -> 6 -> 12 stripe-doubling table, PNAS 1999 Fig. 3/4/5/8 parameters and Pass 3 curved-surface expectations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/datasets/chemotactic_stripe_splitting/pomacanthus_stripe_doubling_reference.json#L1-L112> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "1999-painter-chemotactic-stripe-splitting.py L1521–L1596" ;
        dct:description "Panels G-H: iridophore kymograph with Kondo-Asai stripe-count annotations and cylinder-vs-spindle unrolled surfaces" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L1521-L1596> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/chemotactic_stripe_splitting_comparison.png (generated output)" ;
        dct:description "9-panel synthesis figure: specimen segmentation (E-F), Pomacanthus growing-flank stripe doubling (G-H), slime-trail hysteresis (I) — docs/media/chemotactic_stripe_splitting_comparison.png: rendered output of 1999-painter-chemotactic-stripe-splitting.py at 4d5512d, image/png, 1522010 B, 2310×2044 px, artifact_sha256 084966237a0de263e455d7da45279aad1290fd9d3bb43f31c32478fbcd15423e (sha256 084966237a0de263e455d7da45279aad1290fd9d3bb43f31c32478fbcd15423e), spec_fingerprint 61dda0c23fef2f0f55c7da992a8bddf50bfafc949a3445d76feebcc32dbff90f" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


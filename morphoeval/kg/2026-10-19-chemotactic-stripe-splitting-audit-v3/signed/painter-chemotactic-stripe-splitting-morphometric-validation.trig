sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-painter-chemotactic-stripe-splitting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-2d-chemotactic-spot-vs-stripe-connected-component-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D chemotactic spot-vs-stripe connected component ratio = 3.5 N_spots / N_stripes ratio" ;
        dcterms:description "spot components = 21, stripe components = 6; reference 1.0 is the null (no selection) value, not a literature count" ;
        schema:measurementTechnique "2D Keller-Segel PDE quadratic (spot) regime (21 isolated aggregates) vs cubic-symmetric (stripe) regime (6 connected ridges); ratio > 1 is the qualitative Ermentrout (1991) prediction" ;
        schema:name "2D chemotactic spot-vs-stripe connected component ratio" ;
        schema:unitText "N_spots / N_stripes ratio" ;
        schema:value "3.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-2d-chemotactic-spot-vs-stripe-connected-component-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-2d-chemotactic-spot-vs-stripe-connected-component-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Ermentrout (1991) Proc. R. Soc. A 434:413 (quadratic terms -> spots, none -> stripes; PNAS 1999 refs. 26-28). The stripe regime imposes a 6.2/3.8 x/y chemotactic anisotropy (disclosed; open item)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-body-length-scale-ratio-between-successive-stripe-doublings-s-6-12-s-3-6-on-the-growing-cylinder> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "body-length scale ratio between successive stripe doublings s(6->12) / s(3->6) on the growing cylinder = 2.0348 ratio of domain scale factors" ;
        dcterms:description "transitions lag the linear band-exit prediction (s = 1.46) because the clipped Kondo-Asai pattern is strongly nonlinear (peaks split only once stretched to ~2.2 lambda_c); the doubling RATIO is the tested quantity" ;
        schema:measurementTechnique "first kymograph scale at which the theta-mean iridophore stripe count reaches 6 (s = 2.184) and 12 (s = 4.444)" ;
        schema:name "body-length scale ratio between successive stripe doublings s(6->12) / s(3->6) on the growing cylinder" ;
        schema:unitText "ratio of domain scale factors" ;
        schema:value "2.0348" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-body-length-scale-ratio-between-successive-stripe-doublings-s-6-12-s-3-6-on-the-growing-cylinder-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-body-length-scale-ratio-between-successive-stripe-doublings-s-6-12-s-3-6-on-the-growing-cylinder-reference> a schema:PropertyValue ;
        dcterms:source "Kondo & Asai (1995): stripe number doubles each time body length doubles (spacing conserved); Lean kondo_asai_stripe_doubling_mode_selection (m^2 = 9 s^2 <=> m = 3 s)" ;
        schema:value "2.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-chi-0-sensitivity-sweep-1e-5-1e-4-1e-3-spearman-monotonicity-of-stripe-contrast-with-chi-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chi_0 sensitivity sweep (-1e-5, -1e-4, -1e-3): Spearman monotonicity of stripe contrast with |chi_0| = 1.0 Spearman rho" ;
        dcterms:description "p = 0.000 (n = 3); stripe count robust across the sweep: [12.0, 12.0, 12.0]" ;
        schema:measurementTechnique "chi_0=-1e-05: contrast=0.0184 (bound 0.0111), stripes=12.0; chi_0=-1e-04: contrast=0.2014 (bound 0.1166), stripes=12.0; chi_0=-1e-03: contrast=5.8636 (bound 2.0121), stripes=12.0" ;
        schema:name "chi_0 sensitivity sweep (-1e-5, -1e-4, -1e-3): Spearman monotonicity of stripe contrast with |chi_0|" ;
        schema:unitText "Spearman rho" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-chi-0-sensitivity-sweep-1e-5-1e-4-1e-3-spearman-monotonicity-of-stripe-contrast-with-chi-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-chi-0-sensitivity-sweep-1e-5-1e-4-1e-3-spearman-monotonicity-of-stripe-contrast-with-chi-0-reference> a schema:PropertyValue ;
        dcterms:source "PNAS 1999 sensitivity statement: chi_0 varied by an order of magnitude up or down gives qualitatively similar stripes; stronger sensitivities give sharp aggregations, weaker ones faint broad stripes" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-curved-surface-spindle-k-0-final-stripe-count-at-s-5-2-vs-kondo-asai-doubling-law> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "curved-surface (spindle, K != 0) final stripe count at s = 5.2 vs Kondo-Asai doubling law = 8.0 iridophore stripes" ;
        dcterms:description "theta-variance fraction = 0.0000; the metric gradient rho'/rho breaks translational symmetry so insertion becomes sequential rather than synchronous on the curved flank (deviation from the flat doubling law is a genuine curvature effect, reported not hidden)" ;
        schema:measurementTechnique "same system on a tapered surface of revolution rho(X) = rho_max[0.3 + 0.7 sin(pi X)] (max Gaussian curvature K = 0.0571 at s=1, K lambda_c^2 = 0.689); theta-mean counts at s = [1.3, 2.6, 5.2]: [3.0, 6.0, 8.0], RMSE vs Kondo-Asai = 2.309; cylinder control RMSE = 0.000" ;
        schema:name "curved-surface (spindle, K != 0) final stripe count at s = 5.2 vs Kondo-Asai doubling law" ;
        schema:unitText "iridophore stripes" ;
        schema:value "8.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-curved-surface-spindle-k-0-final-stripe-count-at-s-5-2-vs-kondo-asai-doubling-law-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-curved-surface-spindle-k-0-final-stripe-count-at-s-5-2-vs-kondo-asai-doubling-law-reference> a schema:PropertyValue ;
        dcterms:source "Kondo & Asai (1995) / PNAS 1999 Fig. 1 (12 stripes after two body-length doublings)" ;
        schema:value "12.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-equal-diffusivity-critical-chemotactic-sensitivity-chi-c-d-n-d-c-1-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusivity critical chemotactic sensitivity chi_c (D_n = D_c = 1.0) = 4.5 dimensionless" ;
        dcterms:description "at chi=6.0 > chi_c=4.5, unstable band k^2 in [0.6277, 6.3723], lambda_max(k_c^2)=0.6235" ;
        schema:measurementTechnique "Keller-Segel chemotaxis-logistic linear stability threshold chi_c = (sqrt(r*D_c)+sqrt(gamma*D_n))^2 / (n_0*s*) at D_n=D_c=1 (det M(k_c^2)=-6.00 at chi=6.0)" ;
        schema:name "equal-diffusivity critical chemotactic sensitivity chi_c (D_n = D_c = 1.0)" ;
        schema:unitText "dimensionless" ;
        schema:value "4.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-equal-diffusivity-critical-chemotactic-sensitivity-chi-c-d-n-d-c-1-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-equal-diffusivity-critical-chemotactic-sensitivity-chi-c-d-n-d-c-1-0-reference> a schema:PropertyValue ;
        dcterms:source "Keller & Segel (1970) J. Theor. Biol. 26:399 linearisation applied to the Painter & Hillen (2011) Physica D 240:363 chemotaxis-logistic model (generic KS law; not a PNAS 1999 result)" ;
        schema:value "4.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-iridophore-stripe-contrast-n-max-n-min-1-at-chi-0-1e-4-vs-quasi-static-flux-balance-boltzmann-estimate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "iridophore stripe contrast n_max/n_min - 1 at chi_0 = -1e-4 vs quasi-static flux-balance (Boltzmann) estimate = 0.2014 dimensionless density contrast" ;
        dcterms:description "observed/quasi-static = 1.727; iridophores accumulate at u minima because chi_0 < 0 (repellent). The ratio exceeds 1 because the slow cells (D_n = 5e-4) are swept by the moving u peaks during the 6 -> 12 splitting at s = 4.44, so n is not quasi-static at s = 5.2; same-order agreement is the tested quantity" ;
        schema:measurementTechnique "1D Fig. 3 run at s = 5.2; bound exp(-(chi_0/D_n)(1/(k+u_min) - 1/(k+u_max))) - 1 with u in [0.402, 5.177]" ;
        schema:name "iridophore stripe contrast n_max/n_min - 1 at chi_0 = -1e-4 vs quasi-static flux-balance (Boltzmann) estimate" ;
        schema:unitText "dimensionless density contrast" ;
        schema:value "0.2014" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-iridophore-stripe-contrast-n-max-n-min-1-at-chi-0-1e-4-vs-quasi-static-flux-balance-boltzmann-estimate-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-iridophore-stripe-contrast-n-max-n-min-1-at-chi-0-1e-4-vs-quasi-static-flux-balance-boltzmann-estimate-reference> a schema:PropertyValue ;
        dcterms:source "flux balance D_n n' = n chi(u) u' integrated with chi(u) = chi_0/(k+u)^2 (PNAS 1999 Eq. 3 with Othmer & Stevens 1997 sensitivity) for a STATIC morphogen pattern; PNAS 1999: 'movement of the cells is much slower than diffusion of molecules'" ;
        schema:value "0.1166" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-kondo-asai-stripe-doubling-3-6-12-on-the-growing-flat-flank-cylinder-k-0-final-stripe-count-at-s-5-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Kondo-Asai stripe doubling 3 -> 6 -> 12 on the growing flat flank (cylinder, K = 0): final stripe count at s = 5.2 = 12.0 iridophore stripes" ;
        dcterms:description "stripes stay one-dimensional: theta-variance fraction of n = 0.0000; final L = 57.2 = 16.47 lambda_c, meridional spacing 4.760 vs lambda_c 3.474" ;
        schema:measurementTechnique "PNAS 1999 system on a uniformly growing cylinder (C_0 = 1.9, Laplace-Beltrami IMEX eigenbasis solver, dilution 2r on morphogens); theta-mean stripe counts at s = [1.3, 2.6, 5.2]: [3.0, 6.0, 12.0] (1D line control: [3.0, 6.0, 12.0]); RMSE vs Kondo-Asai [3.0, 6.0, 12.0] = 0.000" ;
        schema:name "Kondo-Asai stripe doubling 3 -> 6 -> 12 on the growing flat flank (cylinder, K = 0): final stripe count at s = 5.2" ;
        schema:unitText "iridophore stripes" ;
        schema:value "12.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-kondo-asai-stripe-doubling-3-6-12-on-the-growing-flat-flank-cylinder-k-0-final-stripe-count-at-s-5-2-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-kondo-asai-stripe-doubling-3-6-12-on-the-growing-flat-flank-cylinder-k-0-final-stripe-count-at-s-5-2-reference> a schema:PropertyValue ;
        dcterms:source "Kondo & Asai (1995) Nature 376:765-768 / PNAS 1999 Fig. 1 (3 -> 6 -> 12 vertical stripes at 2, 6, 12 months with conserved spacing)" ;
        schema:value "12.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-myxococcus-xanthus-specimen-chemotactic-rippling-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Myxococcus xanthus specimen chemotactic rippling stripe wavelength = 74.1 um" ;
        dcterms:description "detected 4 yellow fruiting-body spot aggregates (mean diameter 263.2 um); transect waveform correlation r = 0.5083 (p=6.82e-12)" ;
        schema:measurementTechnique "2D DoG bandpass ridge peak segmentation across right-hand rippling zone of chemotactic_pattern_specimen.jpg (n=362 inter-ridge spacings, mean=18.52 px, std=6.41 px, CV=0.3459, calibrated via 500 um = 125 px scale bar)" ;
        schema:name "Myxococcus xanthus specimen chemotactic rippling stripe wavelength" ;
        schema:unitText "um" ;
        schema:value "74.1" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-myxococcus-xanthus-specimen-chemotactic-rippling-stripe-wavelength-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-myxococcus-xanthus-specimen-chemotactic-rippling-stripe-wavelength-reference> a schema:PropertyValue ;
        dcterms:source "Vendored CC BY-SA 4.0 Myxococcus xanthus specimen (datasets/chemotactic_stripe_splitting/chemotactic_pattern_specimen.jpg)" ;
        schema:value "74.1" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-pnas-1999-fig-3-initial-juvenile-stripe-count-on-l-0-11-kondo-asai-turing-chemotactic-iridophores-1d> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "PNAS 1999 Fig. 3 initial juvenile stripe count on L(0) = 11 (Kondo-Asai Turing + chemotactic iridophores, 1D) = 3.0 iridophore stripes" ;
        dcterms:description "Turing conditions: tr J=-0.010<0, det J=0.0050>0, h=0.00458>0, disc=6.976e-06>0 (Lean painter_1999_pomacanthus_turing_instability); growth rate at k_c = 0.0068" ;
        schema:measurementTechnique "1D zero-flux growing-domain solver at s = 1.3 (Fig. 3 parameters D_u=0.007, D_v=0.1, D_n=5e-4, chi_0=-1e-4, k=1, L(t)=11 exp(1e-4 t)); linear analysis: k_c^2=3.2714, lambda_c=3.4739, L_0/lambda_c=3.167, Neumann modes in band [5, 6, 7], selected half-wave mode 6" ;
        schema:name "PNAS 1999 Fig. 3 initial juvenile stripe count on L(0) = 11 (Kondo-Asai Turing + chemotactic iridophores, 1D)" ;
        schema:unitText "iridophore stripes" ;
        schema:value "3.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-pnas-1999-fig-3-initial-juvenile-stripe-count-on-l-0-11-kondo-asai-turing-chemotactic-iridophores-1d-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-pnas-1999-fig-3-initial-juvenile-stripe-count-on-l-0-11-kondo-asai-turing-chemotactic-iridophores-1d-reference> a schema:PropertyValue ;
        dcterms:source "Painter, Maini & Othmer (1999) PNAS 96(10):5549 Fig. 3 caption ('parameters selected to give rise to the three-peak pattern, corresponding to the number of stripes on the angelfish, Fig. 1a'); Kondo & Asai (1995) Nature 376:765" ;
        schema:value "3.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-simulated-1d-keller-segel-chemotactic-stripe-wavelength-vs-analytical-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated 1D Keller-Segel chemotactic stripe wavelength vs analytical lambda_c = 4.4429 dimensionless length" ;
        dcterms:description "relative wavelength error = 0.0000%, spacing CV = 0.0000" ;
        schema:measurementTechnique "1D IMEX pseudospectral Keller-Segel PDE solver on L = 4*lambda_c (N=4 peaks, CV=0.0000)" ;
        schema:name "simulated 1D Keller-Segel chemotactic stripe wavelength vs analytical lambda_c" ;
        schema:unitText "dimensionless length" ;
        schema:value "4.4429" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-simulated-1d-keller-segel-chemotactic-stripe-wavelength-vs-analytical-lambda-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-simulated-1d-keller-segel-chemotactic-stripe-wavelength-vs-analytical-lambda-c-reference> a schema:PropertyValue ;
        dcterms:source "Keller-Segel linear analysis of the Painter & Hillen (2011) model: k_c^2 = sqrt(r*gamma/(D_n*D_c)) = 2.0 => lambda_c = pi*sqrt(2) = 4.4429" ;
        schema:value "4.4429" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-slime-trail-shifted-chemotactic-threshold-chi-c-m-predicted-by-law-6-vs-simulated-onset-bracket> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "slime-trail-shifted chemotactic threshold chi_c(m) predicted by Law 6 vs simulated onset bracket = 4.2171 dimensionless chi" ;
        dcterms:description "sustained_with_trails = {4.0: False, 4.4: True}, decays_without_trails = {4.0: True, 4.4: True}; Lean slime_trail_anisotropic_mobility_lowers_chemotactic_threshold" ;

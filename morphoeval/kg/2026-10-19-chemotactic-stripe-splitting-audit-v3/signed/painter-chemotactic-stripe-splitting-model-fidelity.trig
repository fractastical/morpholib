sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-painter-chemotactic-stripe-splitting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1999-painter-chemotactic-stripe-splitting.py L546–L615" ;
        dcterms:description "PNAS 1999 Fig. 3 parameters, clipped Kondo-Asai kinetics and Turing linear analysis (tr, det, h, k_c^2, lambda_c, Neumann band, mode 6 -> 3 stripes)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L546-L615> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1999-painter-chemotactic-stripe-splitting.py L703–L856" ;
        dcterms:description "Growing surface-of-revolution solver: eigenbasis fully implicit diffusion + Jacobian + dilution, explicit clip nonlinearity and chemotactic flux, stripe counting and doubling-scale detection" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L703-L856> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "1999-painter-chemotactic-stripe-splitting.py L880–L1022" ;
        dcterms:description "Slime-trail nematic tensor Q, mobility M = I + aQ, Law-6 threshold chi_c(m) and chi-drop hysteresis protocol" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L880-L1022> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_005_chemotactic_stripe_splitting.lean L119–L224" ;
        dcterms:description "Laws 4-6: painter_1999_pomacanthus_turing_instability, pomacanthus_three_stripe_mode_selection, kondo_asai_stripe_doubling_mode_selection, slime_trail_anisotropic_mobility_lowers_chemotactic_threshold (lean OK, 0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/morphoeval/lean/loops/Loop_005_chemotactic_stripe_splitting.lean#L119-L224> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Painter, Maini & Othmer (1999) Pomacanthus Turing-chemotaxis stripe doubling on a growing curved flank & Keller-Segel rippling with slime-trail tensor — Model fidelity to source: 95/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "For the first time implements the actual PNAS 1999 model: `PMO_PARAMS`/`pmo_kinetics` (L546-574, clipped Kondo-Asai kinetics with (u*, v*) = (3, 2.5) verified in the self-test), `pmo_turing_stability` (L575-615) reproducing the Turing conditions and three-stripe mode selection, and `simulate_pomacanthus_growing_surface` (L703-856) on a growing surface of revolution with metric g = s^2 g_0, Laplace-Beltrami eigenbasis (`_surface_eigenbasis`, L639-665), conservative chemotactic divergence (L666-683) and 2r morphogen dilution. The slime-trail tensor (`simulate_slime_trail_ks`, L891-997) adds a nematic closure with mobility on both D_n and chi. 7 Lean theorems (0 sorrys) cover Laws 1-6. Deductions: the 2D KS stripe regime (`simulate_2d_stripe_vs_spot`, L466-541) still imposes a 6.2/3.8 x/y chemotactic anisotropy to obtain stripes (disclosed in the docstring L478-483 and Panel D label) rather than deriving it from the trail tensor; the Fig. 4 anisotropic RC/DV growth and Fig. 8 Lengyel-Epstein transition are not implemented." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1999-painter-chemotactic-stripe-splitting.py L478–L483: Docstring discloses that the 2D stripe regime imposes a 6.2/3.8 x/y chemotactic anisotropy (not derived from the trail tensor) <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L478-L483>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-model-fidelity-4> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


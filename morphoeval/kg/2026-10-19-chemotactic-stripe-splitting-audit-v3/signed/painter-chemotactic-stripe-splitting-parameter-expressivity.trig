        dcterms:title "Reaction and diffusion on growing domains: Scenarios for robust pattern formation" .

    <https://doi.org/10.1007/BF02458621> dcterms:date "1992"^^xsd:gYear ;
        dcterms:title "Analysis of propagating pattern in a chemotaxis system" .

    <https://doi.org/10.1016/0022-5193(70)90092-5> dcterms:date "1970"^^xsd:gYear ;
        dcterms:title "Initiation of slime mold aggregation viewed as an instability" .

    <https://doi.org/10.1016/j.physd.2010.09.011> dcterms:date "2011"^^xsd:gYear ;
        dcterms:title "Spatio-temporal chaos in a chemotaxis model" .

    <https://doi.org/10.1038/376765a0> dcterms:date "1995"^^xsd:gYear ;
        dcterms:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .

    <https://doi.org/10.1073/pnas.96.10.5549> dcterms:date "1999"^^xsd:gYear ;
        dcterms:title "Stripe formation in juvenile Pomacanthus explained by a generalized Turing mechanism with chemotaxis" .

    <https://doi.org/10.1098/rspa.1991.0100> dcterms:date "1891"^^xsd:gYear ;
        dcterms:title "Stripes or spots? Nonlinear effects in bifurcation of reaction-diffusion equations on the square" .

    <https://doi.org/10.1371/journal.pcbi.1004474> dcterms:date "2015"^^xsd:gYear ;

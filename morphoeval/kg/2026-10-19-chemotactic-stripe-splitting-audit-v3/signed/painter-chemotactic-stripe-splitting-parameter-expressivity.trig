sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-painter-chemotactic-stripe-splitting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Painter, Maini & Othmer (1999) Pomacanthus Turing-chemotaxis stripe doubling on a growing curved flank & Keller-Segel rippling with slime-trail tensor — Parameter expressivity: 93/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Beyond the Pass 2 regimes (s in {1, 2, 4, 8}, chi in {0, 3, 4.5, 6}, 2D stripes vs spots), Pass 3 adds three surface profiles (`_surface_profile`, L616-638: line, cylinder, spindle with tunable taper), a chi_0 sweep over two orders of magnitude (`pomacanthus_chi0_sweep`, L857-879: contrast 0.018 / 0.201 / 5.86), and a 2 x 2 trail-strength x hold-chi hysteresis grid (`evaluate_slime_trail_hysteresis`, L998-1022). Deduction: anisotropic RC/DV growth rates (PNAS 1999 Fig. 4) are stored in the dataset but not exposed as a solver parameter." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-parameter-expressivity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1999-painter-chemotactic-stripe-splitting.py L616–L638" ;
        dcterms:description "Surface-of-revolution profiles (cylinder K = 0, spindle K != 0) with taper parameter and Gaussian curvature" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L616-L638> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1999-painter-chemotactic-stripe-splitting.py L857–L879" ;
        dcterms:description "chi_0 sensitivity sweep (-1e-5, -1e-4, -1e-3)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L857-L879> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "1999-painter-chemotactic-stripe-splitting.py L998–L1022" ;
        dcterms:description "Trail-strength x hold-chi hysteresis grid with Law-6 predicted threshold" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L998-L1022> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


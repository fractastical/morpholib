sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-painter-chemotactic-stripe-splitting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Painter, Maini & Othmer (1999) Pomacanthus Turing-chemotaxis stripe doubling on a growing curved flank & Keller-Segel rippling with slime-trail tensor — Reproducibility package: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Deterministic RNG (`seed=1999`), memoised simulations (`_memo`, L119-123) so the self-test and render share runs, and an extended `--self-test` (`run_self_test`, L1744-1849) that checks 4 SHA-256 digests, the corrected title, Turing quantities to 1e-12, exact stripe sequences 3 -> 6 -> 12 on line and cylinder, bitwise determinism of the surface solver (`atol=0.0`), contrast ratio bounds, chi_0 monotonicity, Law-6 threshold inside the hysteresis bracket and 13 measurements. Deductions: default render (92 s) and self-test (108 s) are within the 3-minute budget but the cylinder/spindle runs (~30 s each at nx = 256) make the suite slow, and nx = 128 silently degrades the second doubling (documented in the solver docstring L729-733) so resolution is a hidden correctness parameter." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "1999-painter-chemotactic-stripe-splitting.py L729–L733: Solver docstring: nx = 256 required, nx = 128 degrades the second doubling to 6 -> 8 (resolution-sensitive result) <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L729-L733>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-repro-package-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1999-painter-chemotactic-stripe-splitting.py L1744–L1849" ;
        dct:description "Deterministic --self-test suite: digests, Turing analysis, 3 -> 6 -> 12 sequences, determinism, trail hysteresis, 13 measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L1744-L1849> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/chemotactic_stripe_splitting_growth.gif (generated output)" ;
        dct:description "24-frame GIF with new third row: Pomacanthus iridophores on the growing spindle flank — docs/media/chemotactic_stripe_splitting_growth.gif: rendered output of 1999-painter-chemotactic-stripe-splitting.py at 4d5512d, image/gif, 1270709 B, 900×720 px, 24 frames, artifact_sha256 5601295a5b98645d227961d8da9f982c33621c851825733000406806c465da7a (sha256 5601295a5b98645d227961d8da9f982c33621c851825733000406806c465da7a), spec_fingerprint 61dda0c23fef2f0f55c7da992a8bddf50bfafc949a3445d76feebcc32dbff90f" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


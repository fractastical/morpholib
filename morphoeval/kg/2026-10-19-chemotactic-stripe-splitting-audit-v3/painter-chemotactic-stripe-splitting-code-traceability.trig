sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-painter-chemotactic-stripe-splitting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Painter, Maini & Othmer (1999) Pomacanthus Turing-chemotaxis stripe doubling on a growing curved flank & Keller-Segel rippling with slime-trail tensor — Code-to-model traceability: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Module docstring (L1-100) maps model families (A: PNAS 1999 Sections 5-6; B: generic Keller-Segel Sections 2-4, 7) to Laws 1-6 and the 7 Lean theorems; the math KG loop YAML registers 6 equations with current `lean_locus` and `code_locus` line ranges and a `source_correction` field. Deduction: two Lean theorem names retain their Pass 1 `painter_1999_` prefix although the laws are now attributed to Keller-Segel (kept for KG continuity, documented in the YAML)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "morphoeval/math_kg_loops/painter-chemotactic-stripe-splitting.yaml L57–L69: Law 2 theorem keeps the legacy 'painter_1999' prefix despite re-attribution to Keller-Segel <https://github.com/fractastical/morpholib/blob/4d5512d/morphoeval/math_kg_loops/painter-chemotactic-stripe-splitting.yaml#L57-L69>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-code-traceability-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1999-painter-chemotactic-stripe-splitting.py L1–L100" ;
        dct:description "Module docstring: corrected citation, Pass 3 correction note, model families A/B and Laws 1-6 with Lean theorem names" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L1-L100> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/painter-chemotactic-stripe-splitting.yaml L1–L160" ;
        dct:description "6 registered equations with Lean declarations, theorem names, line loci, code loci and source re-attribution" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/morphoeval/math_kg_loops/painter-chemotactic-stripe-splitting.yaml#L1-L160> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


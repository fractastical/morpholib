sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-painter-chemotactic-stripe-splitting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Painter, Maini & Othmer (1999) Pomacanthus Turing-chemotaxis stripe doubling on a growing curved flank & Keller-Segel rippling with slime-trail tensor — Source and data traceability: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The seed-paper title is corrected to the real PNAS 1999 title (PMID 10318921) in the module docstring (L1-100), `paper_citations.bib` (now 8 DOIs incl. Kondo & Asai 1995, Crampin et al. 1999, Ermentrout 1991, Balagam & Igoshin 2015), the dataset README and both reference JSONs; the new `pomacanthus_stripe_doubling_reference.json` is SHA-256-verified at runtime (`verify_dataset_integrity`, L137-156, 4 digests). Deduction: the SHA-pinned `scout_manifest.json` (pinned in the reference JSON) still carries the non-existent title and cannot be corrected without breaking its pin; this is disclosed but remains a traceability defect inherited from Pass 1." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/chemotactic_stripe_splitting/README.md L5–L14: Disclosure that the SHA-pinned scout_manifest.json still carries the superseded title <https://github.com/fractastical/morpholib/blob/4d5512d/datasets/chemotactic_stripe_splitting/README.md#L5-L14>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-source-traceability-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1999-painter-chemotactic-stripe-splitting.py L137–L172" ;
        dct:description "Runtime SHA-256 verification of 4 dataset artifacts and loader for the new Pomacanthus reference JSON" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/1999-painter-chemotactic-stripe-splitting.py#L137-L172> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/chemotactic_stripe_splitting/paper_citations.bib L1–L91" ;
        dct:description "Corrected PNAS 1999 title with PMID/PMCID plus Kondo & Asai 1995, Crampin et al. 1999, Ermentrout 1991, Balagam & Igoshin 2015" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/4d5512d/datasets/chemotactic_stripe_splitting/paper_citations.bib#L1-L91> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/chemotactic_stripe_splitting/chemotactic_stripe_splitting_reference.json L1–L12" ;

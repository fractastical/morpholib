<https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-2d-chemotactic-spot-vs-stripe-connected-component-ratio-reference> a schema:PropertyValue ;
    dct:source "Ermentrout (1991) Proc. R. Soc. A 434:413 (quadratic terms -> spots, none -> stripes; PNAS 1999 refs. 26-28). The stripe regime imposes a 6.2/3.8 x/y chemotactic anisotropy (disclosed; open item)" ;
    schema:value "1.0" .


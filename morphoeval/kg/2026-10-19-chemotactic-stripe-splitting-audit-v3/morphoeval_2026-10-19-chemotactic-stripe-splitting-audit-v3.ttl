        <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-specimen-match> ;
    pk1:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-chemotactic-stripe-splitting-audit-v3-painter-chemotactic-stripe-splitting-1>,

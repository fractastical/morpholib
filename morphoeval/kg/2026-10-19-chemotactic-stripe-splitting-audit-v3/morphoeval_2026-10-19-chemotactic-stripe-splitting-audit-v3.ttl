<https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-iridophore-stripe-contrast-n-max-n-min-1-at-chi-0-1e-4-vs-quasi-static-flux-balance-boltzmann-estimate> a schema:PropertyValue,
        pk1:EvidenceItem ;
    rdfs:label "iridophore stripe contrast n_max/n_min - 1 at chi_0 = -1e-4 vs quasi-static flux-balance (Boltzmann) estimate = 0.2014 dimensionless density contrast" ;
    dct:description "observed/quasi-static = 1.727; iridophores accumulate at u minima because chi_0 < 0 (repellent). The ratio exceeds 1 because the slow cells (D_n = 5e-4) are swept by the moving u peaks during the 6 -> 12 splitting at s = 4.44, so n is not quasi-static at s = 5.2; same-order agreement is the tested quantity" ;
    schema:measurementTechnique "1D Fig. 3 run at s = 5.2; bound exp(-(chi_0/D_n)(1/(k+u_min) - 1/(k+u_max))) - 1 with u in [0.402, 5.177]" ;
    schema:name "iridophore stripe contrast n_max/n_min - 1 at chi_0 = -1e-4 vs quasi-static flux-balance (Boltzmann) estimate" ;
    schema:unitText "dimensionless density contrast" ;
    schema:value "0.2014" ;
    schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-iridophore-stripe-contrast-n-max-n-min-1-at-chi-0-1e-4-vs-quasi-static-flux-balance-boltzmann-estimate-reference> .

<https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-iridophore-stripe-contrast-n-max-n-min-1-at-chi-0-1e-4-vs-quasi-static-flux-balance-boltzmann-estimate-reference> a schema:PropertyValue ;
    dct:source "flux balance D_n n' = n chi(u) u' integrated with chi(u) = chi_0/(k+u)^2 (PNAS 1999 Eq. 3 with Othmer & Stevens 1997 sensitivity) for a STATIC morphogen pattern; PNAS 1999: 'movement of the cells is much slower than diffusion of molecules'" ;
    schema:value "0.1166" .

<https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-kondo-asai-stripe-doubling-3-6-12-on-the-growing-flat-flank-cylinder-k-0-final-stripe-count-at-s-5-2> a schema:PropertyValue,

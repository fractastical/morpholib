        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-parameter-expressivity-2> ;
    pk:hasScore 8.2e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-repro-package> a pk:LLMClaimAssessment ;
    rdfs:label "Anchiornis huxleyi Turing wavenumber at 2.0 nm (Late Jurassic, 160.0 Ma) — Reproducibility package: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Seed 3111, explicit Euler with dt=0.004 below the diffusion stability bound dx^2/(4 Dv)=0.0079, --self-test asserts the Turing conditions, the 2.0 nm calibration, equal-diffusion stability, Pearson r>0.98, and the monotonic Dv sweep. Default invocation writes the PNG, the 12-frame GIF, and the metrics JSON. Dependencies are the repo scientific stack. Deduction: the audit checkpoint commit does not yet contain these files." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/repro-package" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-repro-package-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-repro-package-2> ;
    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .


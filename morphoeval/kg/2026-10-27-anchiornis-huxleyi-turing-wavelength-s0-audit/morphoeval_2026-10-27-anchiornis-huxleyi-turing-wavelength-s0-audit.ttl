        <https://doi.org/10.1126/science.1186290> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3111.detSquare" ;
    pk:leanTheorem "MathOfBiology.Loop_3111.schnakenberg_det_positive" ;
    pk:leanVerified true .


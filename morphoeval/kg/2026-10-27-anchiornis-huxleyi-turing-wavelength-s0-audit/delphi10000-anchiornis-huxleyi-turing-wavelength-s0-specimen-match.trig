sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Anchiornis huxleyi Turing wavenumber at 2.0 nm (Late Jurassic, 160.0 Ma) — Morphological realism / specimen match: 78/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The comparison figure places the CC BY-SA holotype photograph beside the ROI mask and the simulated field. The 12-frame GIF (640x480) develops the molecular field and ends on the holotype with a 0.90+0.20*(field-0.5) modulation. Computer-vision similarity of that last frame to the photograph is 96.0 (orientation, radial FFT, coherency, occupancy). Deduction: one ROI only, and the developing frames are a periodic patch, not the slab." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

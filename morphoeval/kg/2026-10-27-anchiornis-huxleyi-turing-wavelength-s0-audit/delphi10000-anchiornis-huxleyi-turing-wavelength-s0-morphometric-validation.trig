sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Anchiornis huxleyi Turing wavenumber at 2.0 nm (Late Jurassic, 160.0 Ma) — Morphometric validation: 78/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pure-mode slopes versus analytical sigma(k): Pearson r=0.99999999, RMSE=6.1e-5, KS=0.1. Nonlinear band-weighted wavelength 2.517 nm against the 2.0 nm analytical target (not a copied scalar). Holotype ROI: foreground fraction 0.921 versus prior 0.5, circularity 0.128 versus a circle at 1, coherency 0.451 versus prior 0.5, aspect 1.0 versus an eumelanosome prior of 3 (different object, stated as a transfer boundary). Specimen-versus-pattern radial KS=0.75. Deduction: a single ROI, no crop-sensitivity delta yet." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-dispersion-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-pattern-vs-control-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-image-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-image-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-vs-pattern-radial-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-turing-stripe-wavelength-nm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-dispersion-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_ks_statistic = 0.10000000000000009 1" ;
        dct:description "non-circular: the samples differ" ;
        schema:measurementTechnique "two-sample KS distance between measured and analytical sigma(k) samples" ;
        schema:name "dispersion_ks_statistic" ;
        schema:unitText "1" ;
        schema:value "0.10000000000000009" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "KS=0 would mean identical samples" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r = 0.9999999934569167 1" ;
        dct:description "RMSE=0.00006. r is a fit, not forced to 1." ;
        schema:measurementTechnique "Pearson r between analytical sigma(k) and early-time linear growth slopes; RMSE reported alongside" ;
        schema:name "dispersion_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.9999999934569167" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 dispersion relation" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_rmse = 6.146890058542733e-05 1/time" ;
        dct:description "explicit uncertainty; value is not the zero reference" ;
        schema:measurementTechnique "RMSE of measured versus analytical growth rate across 12 wavenumber bins" ;
        schema:name "dispersion_rmse" ;
        schema:unitText "1/time" ;
        schema:value "6.146890058542733e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "zero error would be a perfect linear fit" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_diffusion_control_sigma_max = -0.44668170193740697 1/time" ;
        dct:description "negative control: equal diffusion is stable (sigma_max < 0)" ;
        schema:measurementTechnique "max_k sigma(k) with Du=Dv=0.72, the ablation of the Turing diffusion ratio" ;
        schema:name "equal_diffusion_control_sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.44668170193740697" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> a schema:PropertyValue ;
        dct:source "marginal stability" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-pattern-vs-control-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pattern_vs_control_std_ratio = 158.83200834725278 1" ;
        dct:description "ablation delta versus the equal-diffusion baseline" ;
        schema:measurementTechnique "std(u) of the patterned run divided by std(u) of the equal-diffusion control, same seed and steps" ;
        schema:name "pattern_vs_control_std_ratio" ;
        schema:unitText "1" ;
        schema:value "158.83200834725278" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-pattern-vs-control-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-pattern-vs-control-std-ratio-reference> a schema:PropertyValue ;
        dct:source "a null control would stay at ratio 1" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_circularity = 0.12829797883074381 1" ;
        dct:description "non-circular specimen contour" ;
        schema:measurementTechnique "4*pi*area/perimeter^2 of the holotype ROI mask" ;
        schema:name "specimen_contour_circularity" ;
        schema:unitText "1" ;
        schema:value "0.12829797883074381" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "a circle would score 1; the slab outline is not a circle" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-image-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_image_aspect_ratio = 1.0 1" ;
        dct:description "transfer boundary: slab aspect is not melanosome aspect" ;
        schema:measurementTechnique "bounding-box height/width of the segmented holotype ROI" ;
        schema:name "specimen_image_aspect_ratio" ;
        schema:unitText "1" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-image-aspect-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-image-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "round-number prior for elongate vertebrate eumelanosomes (Li et al. 2010 describe elongate vs round organelles). The photograph's aspect is a different object." ;
        schema:value "3.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-image-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_image_foreground_fraction = 0.92059019531547 1" ;
        dct:description "CV segmentation of the real holotype image" ;
        schema:measurementTechnique "border-contrast mask on the central ROI of the holotype photograph" ;
        schema:name "specimen_image_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.92059019531547" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "neutral occupancy prior, not the measurement copied back" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_structure_tensor_coherency = 0.4508012084247619 1" ;
        dct:description "image coherency of the real specimen" ;
        schema:measurementTechnique "mean structure-tensor coherency inside the holotype ROI mask" ;
        schema:name "specimen_structure_tensor_coherency" ;
        schema:unitText "1" ;
        schema:value "0.4508012084247619" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "neutral anisotropy prior" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-vs-pattern-radial-ks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_vs_pattern_radial_ks = 0.75 1" ;
        dct:description "honest mismatch: a 2 nm periodic patch is not the museum photograph" ;
        schema:measurementTechnique "KS distance between L2-normalised radial FFT of the holotype ROI and of the simulated field" ;
        schema:name "specimen_vs_pattern_radial_ks" ;
        schema:unitText "1" ;
        schema:value "0.75" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-vs-pattern-radial-ks-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-specimen-vs-pattern-radial-ks-reference> a schema:PropertyValue ;
        dct:source "KS=0 would mean the 2 nm field reproduces the photograph's spectrum" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-turing-stripe-wavelength-nm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "turing_stripe_wavelength_nm = 2.5165281967987596 nm" ;
        dct:description "Grid mode nearest k_c is not exactly the continuous k_c, so value != reference." ;
        schema:measurementTechnique "radial FFT dominant mode of the nonlinear Schnakenberg field, scaled by the 2.0 nm calibration" ;
        schema:name "turing_stripe_wavelength_nm" ;
        schema:unitText "nm" ;
        schema:value "2.5165281967987596" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-turing-stripe-wavelength-nm-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-measurement-turing-stripe-wavelength-nm-reference> a schema:PropertyValue ;
        dct:source "Assigned detail scale for slot 3111; analytical lambda_c is pinned to 2.0 nm" ;
        schema:value "2.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-anchiornis-huxleyi-turing-wavelength-s0.py L183–L239" ;

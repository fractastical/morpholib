        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-anchiornis-huxleyi-turing-wavelength-s0.py#L183-L239> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-anchiornis-huxleyi-turing-wavelength-s0.py L256–L307" ;
        dct:description "holotype ROI segmentation, circularity, coherency, aspect" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-anchiornis-huxleyi-turing-wavelength-s0.py#L256-L307> .

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Anchiornis huxleyi Turing wavenumber at 2.0 nm (Late Jurassic, 160.0 Ma) — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The script implements the Schnakenberg steady state, Jacobian, dispersion eigenvalue, critical wavenumber, and unstable band, and checks det=(a+b)^2. Five Lean theorems (0 sorry) fix the trace sign, the positive determinant, Dv/Du>40, k_c inside the rounded band, and the 29 nm versus 2 nm scale step. Deduction: Li et al. 2010 do not contain this PDE; the kinetics are a reconstruction pinned to Turing 1952 and Schnakenberg 1979." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-anchiornis-huxleyi-turing-wavelength-s0.py L62–L115" ;
        dct:description "steady state, Jacobian, sigma(k), k_c and the unstable band" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-anchiornis-huxleyi-turing-wavelength-s0.py#L62-L115> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3111_anchiornis_huxleyi_turing_wavelength_s0.lean L8–L37" ;
        dct:description "five decide theorems, namespace MathOfBiology.Loop_3111, no sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3111_anchiornis_huxleyi_turing_wavelength_s0.lean#L8-L37> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "datasets/anchiornis_huxleyi_turing_wavelength_s0/anchiornis_huxleyi_turing_wavelength_s0_reference.json (generated output)" ;
        dct:description "claim boundary states the PDE is reconstructed, not printed by Li 2010 — datasets/anchiornis_huxleyi_turing_wavelength_s0/anchiornis_huxleyi_turing_wavelength_s0_reference.json: rendered output of models/2026-delphi10000-anchiornis-huxleyi-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, application/json, 8111 B, artifact_sha256 9dda20f76473581c3cd5bd1ab0620b2cdf75a4fd347dc61d8d50087f6caad157 (sha256 9dda20f76473581c3cd5bd1ab0620b2cdf75a4fd347dc61d8d50087f6caad157), spec_fingerprint 285152f97d4c2953160d26c2ea513d3fd2c627cb2df9135750b22cabfa010529" .

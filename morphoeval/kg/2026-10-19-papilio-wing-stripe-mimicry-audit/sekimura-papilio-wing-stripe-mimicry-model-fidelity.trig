sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sekimura-papilio-wing-stripe-mimicry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Sekimura et al. (2000) Proc. R. Soc. B, Madzvamuse et al. (2002) J. Math. Biol. & Thompson et al. (2014) Nature anisotropic Gierer–Meinhardt butterfly wing pattern formation and Batesian mimicry polymorphism in Papilio dardanus — Model fidelity to source: 56/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Computes the exact Gierer–Meinhardt homogeneous steady state (u0, v0), Jacobian entries, and critical Turing diffusivity ratio d_c = 8.2384 (`compute_gm_steady_state`, L37-65), backed by 3 Lean 4 theorems in `Loop_099_papilio_wing_stripe_mimicry.lean`. However, `synthesize_planar_eigenmode_field` (L68-86) substitutes a static planar cosine formula for time-stepping the nonlinear 2D anisotropic Gierer–Meinhardt PDE on the curved Papilio dardanus forewing domain with vein-aligned diffusivity tensor D = diag(1, epsilon) and boundary margin source gradients." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2016-sekimura-papilio-wing-stripe-mimicry.py L68–L86: Static planar cosine proxy instead of 2D anisotropic Gierer-Meinhardt PDE solver on curved butterfly forewing domain <https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py#L68-L86>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-model-fidelity-1> ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2016-sekimura-papilio-wing-stripe-mimicry.py L37–L65" ;
        dct:description "Exact Gierer-Meinhardt steady state (u0=1.1, v0=1.21), Jacobian J0, and critical diffusivity ratio d_c=8.2384" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py#L37-L65> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 099 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


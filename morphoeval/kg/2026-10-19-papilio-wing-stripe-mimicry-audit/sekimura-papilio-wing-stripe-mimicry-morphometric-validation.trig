sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sekimura-papilio-wing-stripe-mimicry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Sekimura et al. (2000) Proc. R. Soc. B, Madzvamuse et al. (2002) J. Math. Biol. & Thompson et al. (2014) Nature anisotropic Gierer–Meinhardt butterfly wing pattern formation and Batesian mimicry polymorphism in Papilio dardanus — Morphometric validation: 52/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L149-186) reports only 4 scalar metrics without Pearson r, p-value, RMSE, anisotropic stripe orientation angle, negative-control amplitude suppression, or empirical specimen wing segmentation metrics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2016-sekimura-papilio-wing-stripe-mimicry.py L149–L186: Only 4 baseline metrics without statistical correlations, negative controls, or specimen CV validation <https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py#L149-L186>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-cenea-melanic-wing-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-hippocoonides-melanic-wing-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-gierer-meinhardt-homogeneous-steady-state-u0> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-cenea-melanic-wing-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "f. cenea melanic wing fraction = 0.9477 area fraction" ;
        dct:description "Pass 1 planar approximation" ;
        schema:measurementTechnique "planar proxy fraction u(x,y) > u_th (u_th = 0.94)" ;
        schema:name "f. cenea melanic wing fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.9477" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-cenea-melanic-wing-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-cenea-melanic-wing-fraction-reference> a schema:PropertyValue ;
        dct:source "Sekimura et al. (2000) Proc. R. Soc. B 267:851-859 Fig. 5" ;
        schema:value "0.72" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-hippocoonides-melanic-wing-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "f. hippocoonides melanic wing fraction = 0.4688 area fraction" ;
        dct:description "Pass 1 planar approximation without curved wing mesh or PDE time stepping" ;
        schema:measurementTechnique "planar proxy fraction u(x,y) > u_th (u_th = 1.12)" ;
        schema:name "f. hippocoonides melanic wing fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.4688" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-hippocoonides-melanic-wing-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-f-hippocoonides-melanic-wing-fraction-reference> a schema:PropertyValue ;
        dct:source "Sekimura et al. (2000) Proc. R. Soc. B 267:851-859 Fig. 3" ;
        schema:value "0.48" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gierer-Meinhardt critical diffusivity ratio d_c = 8.2384 Dv/Du" ;
        dct:description "supercritical at d = 40.0 > d_c = 8.2384" ;
        schema:measurementTechnique "((fu*gv - 2*fv*gu) + 2*sqrt(fv*gu*(fv*gu - fu*gv))) / fu^2" ;
        schema:name "Gierer-Meinhardt critical diffusivity ratio d_c" ;
        schema:unitText "Dv/Du" ;
        schema:value "8.2384" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c-reference> a schema:PropertyValue ;
        dct:source "Sekimura et al. (2000) Proc. R. Soc. B 267:851-859 Section 2" ;
        schema:value "8.2384" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-gierer-meinhardt-homogeneous-steady-state-u0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gierer-Meinhardt homogeneous steady state u0 = 1.1 dimensionless" ;
        dct:description "v0 = u0^2 = 1.2100" ;
        schema:measurementTechnique "u0 = (a + 1) / b at a = 0.1, b = 1.0" ;
        schema:name "Gierer-Meinhardt homogeneous steady state u0" ;
        schema:unitText "dimensionless" ;
        schema:value "1.1" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-gierer-meinhardt-homogeneous-steady-state-u0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sekimura-papilio-wing-stripe-mimicry-measurement-gierer-meinhardt-homogeneous-steady-state-u0-reference> a schema:PropertyValue ;
        dct:source "Sekimura et al. (2000) Proc. R. Soc. B 267:851-859 Eq. (2.2)" ;
        schema:value "1.1" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 099 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sekimura-papilio-wing-stripe-mimicry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Sekimura et al. (2000) Proc. R. Soc. B, Madzvamuse et al. (2002) J. Math. Biol. & Thompson et al. (2014) Nature anisotropic Gierer–Meinhardt butterfly wing pattern formation and Batesian mimicry polymorphism in Papilio dardanus — Morphological realism / specimen match: 36/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Although `datasets/papilio_wing_stripe_mimicry/papilio_dardanus_cenea_specimen.jpg` is vendored on disk, the v1 script never loads, segments, or quantifies wing contour, melanic vs light patch area fractions, or band orientation from the biological specimen photograph." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2016-sekimura-papilio-wing-stripe-mimicry.py L89–L113: Evaluates planar morph proxies without loading or segmenting papilio_dardanus_cenea_specimen.jpg <https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py#L89-L113>",
            "docs/media/papilio_wing_stripe_mimicry_comparison.png (generated output, not in repo): 4-panel v1 plot shows rectangular cosine proxies without curved wing geometry or biological specimen segmentation — docs/media/papilio_wing_stripe_mimicry_comparison.png: rendered output of 2016-sekimura-papilio-wing-stripe-mimicry.py at e93f00e, image/png, 146813 B, 1452×1025 px, artifact_sha256 f5be8034a0620d3ff22cbd37a4c6710ae88afd4fa4ace7734733c66d5c4d0b2c (sha256 f5be8034a0620d3ff22cbd37a4c6710ae88afd4fa4ace7734733c66d5c4d0b2c), spec_fingerprint 4665cc66775193c7139c46f7c95f9ab09ed994d1e45070ba26abef03de22b1f3" ;
        pk:hasScore "0.36"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 099 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


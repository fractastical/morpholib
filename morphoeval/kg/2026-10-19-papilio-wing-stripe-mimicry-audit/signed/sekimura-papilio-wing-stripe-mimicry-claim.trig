sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sekimura-papilio-wing-stripe-mimicry> a pk:Claim ;
        rdfs:label "Sekimura et al. (2000) Proc. R. Soc. B, Madzvamuse et al. (2002) J. Math. Biol. & Thompson et al. (2014) Nature anisotropic Gierer–Meinhardt butterfly wing pattern formation and Batesian mimicry polymorphism in Papilio dardanus faithfully reproduces Papilio dardanus (African mocker swallowtail female mimetic morphs: hippocoonides, trophonius, cenea, planemoides) morphology" ;
        dcterms:description "The simulation script(s) 2016-sekimura-papilio-wing-stripe-mimicry.py implement the cited source model as published and produce forms that match real Papilio dardanus (African mocker swallowtail female mimetic morphs: hippocoonides, trophonius, cenea, planemoides) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 53.7/100, audit 2026-10-19-papilio-wing-stripe-mimicry-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py; output: docs/media/papilio_wing_stripe_mimicry_comparison.png; organism: Papilio dardanus (African mocker swallowtail female mimetic morphs: hippocoonides, trophonius, cenea, planemoides); checkpoint commit: https://github.com/fractastical/morpholib/commit/e93f00e; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 4665cc66775193c7139c46f7c95f9ab09ed994d1e45070ba26abef03de22b1f3; artifact_sha256: f5be8034a0620d3ff22cbd37a4c6710ae88afd4fa4ace7734733c66d5c4d0b2c; input_dataset_sha256: {datasets/papilio_wing_stripe_mimicry/paper_citations.bib=d673f37a5fa300ac..., datasets/papilio_wing_stripe_mimicry/papilio_dardanus_cenea_specimen.jpg=7ba68b77406f8fbc..., datasets/papilio_wing_stripe_mimicry/papilio_wing_stripe_mimicry_reference.json=153621f2eb2935a0..., datasets/papilio_wing_stripe_mimicry/scout_manifest.json=f5962e37bffeb86e...}" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1007/s002850100133>,
            <https://doi.org/10.1038/nature12979>,
            <https://doi.org/10.1098/rspb.2000.1081>,
            <https://doi.org/10.5962/bhl.title.119515> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-specimen-match> ;
        pk:weightOfEvidence "0.537"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py> a schema:SoftwareSourceCode ;
        rdfs:label "2016-sekimura-papilio-wing-stripe-mimicry.py" ;

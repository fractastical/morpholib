sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sekimura-papilio-wing-stripe-mimicry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sekimura-papilio-wing-stripe-mimicry-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Sekimura et al. (2000) Proc. R. Soc. B, Madzvamuse et al. (2002) J. Math. Biol. & Thompson et al. (2014) Nature anisotropic Gierer–Meinhardt butterfly wing pattern formation and Batesian mimicry polymorphism in Papilio dardanus — Reproducibility package: 64/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Provides `--self-test` (`L189-197`) checking steady state and threshold ordering, but lacks SHA-256 asset verification, two-run bitwise determinism checks on the nonlinear PDE solver, and specimen segmentation assertions." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2016-sekimura-papilio-wing-stripe-mimicry.py L189–L197: Minimal 3-assertion self_test() without SHA-256 or PDE determinism checks <https://github.com/fractastical/morpholib/blob/e93f00e/2016-sekimura-papilio-wing-stripe-mimicry.py#L189-L197>" ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 099 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


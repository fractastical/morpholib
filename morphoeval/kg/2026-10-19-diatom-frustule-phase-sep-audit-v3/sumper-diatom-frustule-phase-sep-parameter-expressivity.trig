sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sumper-diatom-frustule-phase-sep> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Sumper (2002) & Lenoci-Camp (2008) hierarchical Cahn-Hilliard diatom biosilica phase separation (Pass 3: centrifugal precipitation front + 3-stage single-domain quench) — Parameter expressivity: 89/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Pass 3 adds a real control axis with a morphological transition: the 5-speed front ablation v in {0.05, 0.10, 0.20, 0.40, 0.80} px/t sweeps A from +0.65 (radial) through -0.94 (concentric) toward the isotropic null (panel C4), and `bulk_control=True` is a clean null (+2); the 3-stage model exposes grid size and physical scale (`--N3`, `--nm-per-px`) and `--v-front` drives panel C3 and the costae GIF (+1); the Pass 2 eps sweep, phi0 regimes and CLI flags remain. Deductions: `measure_morphoeval()` ignores every CLI parameter (fixed N = 128/160/512, seed 2002, v = 0.10/0.40) so the measurement block is not re-parameterisable from the command line (-2); the C4 sweep and the isotropic null use a fixed 5-speed list and the null's step count is the median-speed count, not the slow-speed count (-1); the costae parameters (lag 1.0, noise 0.005, width 2.0, R0 8) are exposed as function kwargs but not as CLI flags (-1). Net 86 -> 89." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "models/2002-sumper-diatom-frustule-phase-sep.py L1297–L1318: measure_morphoeval() hard-codes N=128/160/512, seed 2002 and v=0.10/0.40; CLI parameters are not honoured by the measurement block <https://github.com/fractastical/morpholib/blob/a69596cc/models/2002-sumper-diatom-frustule-phase-sep.py#L1297-L1318>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-parameter-expressivity-3> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2002-sumper-diatom-frustule-phase-sep.py L540–L580" ;
        dct:description "run_front_velocity_sweep: 5-speed ablation + 3-seed isotropic null; null uses the median-speed step count (L564-L566)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2002-sumper-diatom-frustule-phase-sep.py#L540-L580> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2002-sumper-diatom-frustule-phase-sep.py L1569–L1607" ;
        dct:description "CLI: --N --phi0 --epsilon --steps --seed --skip-gif plus Pass 3 --v-front --N3 --nm-per-px (L1578-L1580); --self-test help still says '8-check'" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2002-sumper-diatom-frustule-phase-sep.py#L1569-L1607> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "models/2002-sumper-diatom-frustule-phase-sep.py L837–L878" ;
        dct:description "Pass 2 5-point epsilon sweep (unchanged)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2002-sumper-diatom-frustule-phase-sep.py#L837-L878> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 Phase B primary assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


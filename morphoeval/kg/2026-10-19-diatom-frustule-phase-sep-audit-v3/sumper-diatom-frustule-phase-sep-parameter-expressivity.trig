    <https://doi.org/10.1063/1.1744102> dct:date "1958"^^xsd:gYear ;
        dct:title "Free energy of a nonuniform system. I. Interfacial free energy" .
    <https://doi.org/10.1111/j.0022-3646.1983.00387.x> dct:date "1983"^^xsd:gYear ;

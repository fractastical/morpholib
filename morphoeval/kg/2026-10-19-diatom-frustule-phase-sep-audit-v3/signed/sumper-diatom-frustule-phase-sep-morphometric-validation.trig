    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2002-sumper-diatom-frustule-phase-sep.py L346–L360" ;
        dcterms:description "radial_anisotropy_index: A = <|d_theta phi|^2 - |d_r phi|^2> / <|grad phi|^2> in the margin annulus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2002-sumper-diatom-frustule-phase-sep.py#L346-L360> .

